var v_barriers: usize = 0;
var v_kinds: usize = 0;
var v_fail: usize = 0;
var v_invalid: bool = false;
var v_seen: [5]Identity;
fun v_sync(fd: i32) i64 {
    var st: os.stat_t;
    var identity: Identity;
    if (os.stat(fd, ?st) < 0 || os.file_identity(fd, ?identity) < 0 || v_barriers >= 5) {
        v_invalid = true;
        ret os.EBADF;
    }
    var i: usize = 0;
    for (i < v_barriers) {
        if (identity_equal(v_seen[i], identity)) { v_invalid = true; }
        i = i + 1;
    }
    v_seen[v_barriers] = identity;
    val directory: bool = (os.stat_mode(?st) & os.S_IFMT) == os.S_IFDIR;
    if (directory != (v_barriers > 0)) { v_invalid = true; }
    v_kinds = v_kinds * 2;
    if (directory) { v_kinds = v_kinds + 1; }
    v_barriers = v_barriers + 1;
    if (v_barriers == v_fail) { ret os.sync_fd(-1); }
    ret os.sync_fd(fd);
}
test "std.filesystem.transaction.verification: subtree barriers own every object and preserve aggregate failures" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (O.is_some[Error](t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var inv: Inventory = inventory_init(?alloc);
    fin { inventory_dnit(?inv); }
    if (O.is_some[Error](inventory_push(?inv, entry_file("a/data", "data", 4, 0o000)))) { ret 6; }
    if (O.is_some[Error](inventory_push(?inv, entry_dir("a", 0o700)))) { ret 7; }
    if (O.is_some[Error](inventory_push(?inv, entry_dir("empty", 0o700)))) { ret 8; }
    var strict: usize = 0;
    for (strict < 2) {
        var failure: usize = 0;
        for (failure <= 5) {
            v_barriers = 0;
            v_kinds = 0;
            v_fail = failure;
            v_invalid = false;
            var transaction: Transaction;
            val options: PrepareOptions = PrepareOptions{precondition: PRE_ABSENT, durability: durability_full(strict == 1)};
            val built: O.Option[Error] = prepare_subtree(?transaction, ?alloc, destination, ?inv, 0o700, options);
            if (strict == 1 && failure > 0 && failure < 5) {
                if (O.is_none[Error](built)) { abort(?transaction); ret 20; }
                val e: Error = O.unwrap[Error](built);
                if (e.kind != DURABILITY || e.op != OP_PREPARE) { ret 21; }
                if (v_barriers != failure || v_invalid || destination.active || transaction.state != STATE_SPENT) { ret 22; }
                if (payload_entry_count(?alloc, base) != 0) { ret 23; }
            }
            or {
                if (O.is_some[Error](built)) { ret 24; }
                if (v_barriers != 4 || v_kinds != 7 || v_invalid) { abort(?transaction); ret 25; }
                val published: R.Result[Outcome, Error] = commit(?transaction);
                if (strict == 1 && failure == 5) {
                    if (R.is_ok[Outcome, Error](published)) { ret 26; }
                    val e: Error = R.unwrap_err[Outcome, Error](published);
                    if (e.kind != DURABILITY || e.op != OP_COMMIT) { ret 27; }
                }
                or {
                    if (R.is_err[Outcome, Error](published)) { ret 28; }
                    val outcome: Outcome = R.unwrap_ok[Outcome, Error](published);
                    if (failure == 0) {
                        if (!outcome.committed || outcome.shortfall || outcome.achieved != DUR_FULL) { ret 29; }
                    }
                    or {
                        if (!outcome.committed || !outcome.shortfall) { ret 30; }
                        if (failure < 5 && outcome.achieved != DUR_NONE) { ret 31; }
                        if (failure == 5 && outcome.achieved != DUR_FILE) { ret 32; }
                    }
                }
                var count: usize = 5;
                if (failure > 0 && failure < 5) { count = 4; }
                if (v_barriers != count || v_invalid || destination.active || transaction.state != STATE_SPENT) { ret 33; }
                if (payload_entry_count(?alloc, base) != 1) { ret 34; }
                if (R.is_err[usize, Error](root_remove_tree(destination, ""))) { ret 35; }
            }
            failure = failure + 1;
        }
        strict = strict + 1;
    }
    ret 0;
}
