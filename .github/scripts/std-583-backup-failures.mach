
fun t_verified_backup_failure(first: bool) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (O.is_some[Error](t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    val backup: *Claim = t_reserve(?session, "saved");
    if (destination == nil || backup == nil) { ret 5; }
    if (first && t_fixture_write(?root, "out", "prior") != 0) { ret 6; }
    var t: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_SAME_OBJECT,
        prior_access: READ_AUTHORIZED, durability: durability_full(true)};
    if (O.is_some[Error](prepare_bytes(?t, ?alloc, destination, "next", 4, 0o600, false, options))) { ret 7; }
    fin { if (prepared(?t)) { abort(?t); } }
    val out: BackupOutcome = commit_with_backup(?t, backup);
    fin { str_free(?alloc, out.staging_residue); }
    if (!out.consumed || O.is_none[Error](out.failure) || O.is_some[Error](out.cleanup_failure)
        || out.staging_residue != nil || destination.active || backup.active) { ret 8; }
    if (first) {
        if (out.prior_moved || out.published || out.achieved != DUR_NONE
            || O.unwrap[Error](out.failure).code != os.EACCES) { ret 9; }
        if (!t_backup_contents(?root, "out", "prior") || !entry_absent(root.dirfd, "saved")) { ret 10; }
    }
    or {
        if (!out.published || out.prior_moved || out.achieved != DUR_FILE || !out.shortfall
            || O.unwrap[Error](out.failure).kind != DURABILITY) { ret 11; }
        if (!t_backup_contents(?root, "out", "next") || !entry_absent(root.dirfd, "saved")) { ret 12; }
    }
    ret 0;
}

test "verification.backup: first rename error has no namespace effects" {
    ret t_verified_backup_failure(true);
}

test "verification.backup: required parent barrier error retains published effect" {
    ret t_verified_backup_failure(false);
}
