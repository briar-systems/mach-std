# every function here must fail to compile. each pins one line of the
# sha256.SecretState and sha512.SecretState384 contract, and
# test/sha256/refusals.sh checks the diagnostics one by one

use std.crypto.hash.sha256;
use std.crypto.hash.sha512;
use std.types.size.usize;

# 1. update_secret takes *^u8 only: public bytes are lifted at the call site,
#    never inside
fun feed_public(s: *sha256.SecretState, data: *u8, len: usize) {
    sha256.update_secret(s, data, len);
}

# 2. the digest goes to *^u8, never *u8: declassifying is the caller's decision
fun public_digest(s: *sha256.SecretState, digest: *u8) {
    sha256.final_secret(s, digest);
}

# 3. SecretState never aliases State: no cast between them
fun alias_state(s: *sha256.State) *sha256.SecretState {
    ret s::*sha256.SecretState;
}

# 4. a record embedding SecretState is welded: it does not erase to ptr
rec Holder {
    tag:   u64;
    state: sha256.SecretState;
}

fun erase_holder(h: *Holder) ptr {
    ret h::ptr;
}

# 5. the same for sha-384
fun feed_public384(s: *sha512.SecretState384, data: *u8, len: usize) {
    sha512.update_secret384(s, data, len);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret 0;
}
