# the function here must fail to compile in codegen. each proves the
# constant-time checker sees an `#[oblivious]` asm body over a welded
# pointer, which is what lets sha256.sha_ni_block and sha2_block carry
# `#[oblivious]` at their secret instances. test/sha256/refusals.sh checks
# the diagnostics. this project is separate from ../refusals because type
# errors there stop the build before codegen runs

# 2. and so is an address that rides a loaded secret word
#[oblivious]
fun index_by_word(state: *^u32, table: *u32) u32 {
    var r: u32 = 0;
    val p: *u32 = ?r;
    asm x86_64 {
        mov rax, {state}
        mov rcx, {table}
        mov rdx, {p}
        mov esi, [rax]
        mov edi, [rcx + rsi * 4]
        mov [rdx], edi
    }
    ret r;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret 0;
}
