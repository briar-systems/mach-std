# imports the top-level os and filesystem surfaces so target-gated backend
# modules are instantiated for cross-builds and native artifact checks.
use std.runtime;
use std.system.os;
use std.filesystem;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var c: u8 = 'k'::u8;
    os.write(1, ?c, 1);
    ret 0;
}
