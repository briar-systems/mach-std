# darwin runtime and process probe (#415)
#
# everything here is observed from OUTSIDE the process that does it: verify.sh
# reads the exit status the kernel reports, the bytes that reached stderr and
# stdout, and the argument and environment blocks a child received. that is
# the only vantage point from which the runtime's entry and exit paths can be
# checked at all - a test block inside the process cannot observe its own exit
# status - and it is how the libSystem `_exit`, `write`, `fork`, `execve`,
# `wait4`, `dup2` and `kill` bindings are proven on the real kernel rather than
# by cross-compiling.
#
# subcommands, each an observable contract:
#   exit <n>        main returns n; the LC_MAIN / LC_UNIXTHREAD entry ends the
#                   process through _rt_exit -> _exit with that status
#   terminate <n>   os.terminate(n) ends the process with status n
#   abort           os.abort() ends the process by SIGABRT
#   panic           std.system.panic writes its message to stderr and exits 255
#   args ...        prints argc, every argv entry and MACH_STD_415 from envp,
#                   proving the entry captured the argument block correctly
#   child           spawns this same executable through the OS layer: an exit
#                   status, a panic status, a signal death and a redirected
#                   stdout are each observed by the parent through wait4 and a
#                   pipe; a missing program and a missing cwd exit 127 and 126

use std.runtime;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;
use std.system.panic;
use os: std.system.os;

fun out(s: str) {
    os.write(os.STDOUT_FD, s, str_len(s));
}

fun out_number(n: i64) {
    var digits: [24]u8;
    var d: usize = 0;
    var v: i64 = n;
    if (v < 0) { out("-"); v = -v; }
    if (v == 0) { digits[0] = '0'; d = 1; }
    for (v > 0) { digits[d] = '0' + (v % 10)::u8; v = v / 10; d = d + 1; }
    var line: [25]u8;
    var i: usize = 0;
    for (d > 0) { d = d - 1; line[i] = digits[d]; i = i + 1; }
    line[i] = 0;
    out(?line[0]);
}

fun parse(s: *u8) i64 {
    var v: i64 = 0;
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] < '0' || s[i] > '9') { ret -1; }
        v = v * 10 + (s[i] - '0')::i64;
        i = i + 1;
    }
    ret v;
}

fun args(argc: i64, argv: **u8) i64 {
    out("argc="); out_number(argc); out("\n");
    var i: i64 = 0;
    for (i < argc) {
        out("argv["); out_number(i); out("]="); out(argv[i::usize]); out("\n");
        i = i + 1;
    }
    if (argv[argc::usize]::usize != 0) { out("argv terminator missing\n"); ret 3; }
    var value: [64]u8;
    val n: i64 = os.getenv("MACH_STD_415", ?value[0], 64);
    if (n < 0) { out("MACH_STD_415 unset\n"); ret 0; }
    out("MACH_STD_415="); out(?value[0]); out("\n");
    ret 0;
}

fun reap(pid: i64, status: *os.ProcessStatus) i64 {
    var waited: os.WaitResult = os.wait_pid(pid, status, 0);
    for (waited.error.code == os.EINTR) { waited = os.wait_pid(pid, status, 0); }
    if (waited.error.code < 0) { ret waited.error.code; }
    if (waited.pid != pid) { ret os.EIO; }
    ret 0;
}

fun spawn_self(self: *u8, verb: str, value: str, stdout_fd: i32, cwd: *u8) i64 {
    var argv: [4]usize;
    argv[0] = self::usize;
    argv[1] = verb::usize;
    argv[2] = value::usize;
    argv[3] = 0;
    var envp: [2]usize;
    envp[0] = ("MACH_STD_415=from-parent")::usize;
    envp[1] = 0;
    ret os.spawn_redirected_in(self, (?argv[0])::**u8, (?envp[0])::**u8, cwd, -1, stdout_fd, -1);
}

fun child(self: *u8) i64 {
    var status: os.ProcessStatus;

    # an exit status chosen by the child's main return
    var pid: i64 = spawn_self(self, "exit", "42", -1, nil);
    if (pid <= 0) { ret 10; }
    if (reap(pid, ?status) < 0) { ret 11; }
    if (!os.has_exited(status) || os.exit_code(status) != 42) { ret 12; }

    # os.terminate from a child
    pid = spawn_self(self, "terminate", "7", -1, nil);
    if (pid <= 0) { ret 13; }
    if (reap(pid, ?status) < 0) { ret 14; }
    if (!os.has_exited(status) || os.exit_code(status) != 7) { ret 15; }

    # a panic's exit status
    pid = spawn_self(self, "panic", nil, -1, nil);
    if (pid <= 0) { ret 16; }
    if (reap(pid, ?status) < 0) { ret 17; }
    if (!os.has_exited(status) || os.exit_code(status) != 255) { ret 18; }

    # abort is a signal death, not an exit status
    pid = spawn_self(self, "abort", nil, -1, nil);
    if (pid <= 0) { ret 19; }
    if (reap(pid, ?status) < 0) { ret 20; }
    if (!os.was_signaled(status) || os.term_signal(status) != 6) { ret 21; }

    # a redirected stdout carries the child's argument and environment report
    var fds: [2]i32;
    if (os.pipe(?fds[0]) != 0) { ret 22; }
    pid = spawn_self(self, "args", "child-argument", fds[1], nil);
    os.close(fds[1]);
    if (pid <= 0) { os.close(fds[0]); ret 23; }
    var buf: [512]u8;
    var got: usize = 0;
    var n: i64 = os.read(fds[0], ?buf[0], 511);
    for (n > 0) {
        got = got + n::usize;
        if (got >= 511) { n = 0; }
        or { n = os.read(fds[0], ?buf[got], 511 - got); }
    }
    os.close(fds[0]);
    buf[got] = 0;
    if (reap(pid, ?status) < 0) { ret 24; }
    if (!os.has_exited(status) || os.exit_code(status) != 0) { ret 25; }
    var expected: [600]u8;
    var e: usize = 0;
    val head: str = "argc=3\nargv[0]=";
    var i: usize = 0;
    for (i < str_len(head)) { expected[e] = head[i]; e = e + 1; i = i + 1; }
    i = 0;
    for (self[i] != 0) { expected[e] = self[i]; e = e + 1; i = i + 1; }
    val tail: str = "\nargv[1]=args\nargv[2]=child-argument\nMACH_STD_415=from-parent\n";
    i = 0;
    for (i < str_len(tail)) { expected[e] = tail[i]; e = e + 1; i = i + 1; }
    expected[e] = 0;
    if (got != e) { out(?buf[0]); ret 26; }
    i = 0;
    for (i < e) {
        if (buf[i] != expected[i]) { out(?buf[0]); ret 27; }
        i = i + 1;
    }

    # execve of a missing program: the child exits 127
    pid = spawn_self("/tmp/mach-std-415-definitely-absent/probe", "exit", "0", -1, nil);
    if (pid <= 0) { ret 28; }
    if (reap(pid, ?status) < 0) { ret 29; }
    if (!os.has_exited(status) || os.exit_code(status) != 127) { ret 30; }

    # chdir into a missing directory: the child exits 126
    pid = spawn_self(self, "exit", "0", -1, "/tmp/mach-std-415-definitely-absent");
    if (pid <= 0) { ret 31; }
    if (reap(pid, ?status) < 0) { ret 32; }
    if (!os.has_exited(status) || os.exit_code(status) != 126) { ret 33; }

    # a foreign pid is not ours to wait for
    if (os.wait_pid(1, ?status, 0).error.code != os.ECHILD) { ret 34; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc < 2) { ret 2; }
    val verb: *u8 = argv[1];
    if (str_equals(verb, "exit")) {
        if (argc != 3) { ret 2; }
        ret parse(argv[2]);
    }
    if (str_equals(verb, "terminate")) {
        if (argc != 3) { ret 2; }
        os.terminate(parse(argv[2]));
        ret 99;
    }
    if (str_equals(verb, "abort")) {
        os.abort();
        ret 99;
    }
    if (str_equals(verb, "panic")) {
        panic.panic("mach-std-415 panic reached stderr\n");
        ret 99;
    }
    if (str_equals(verb, "args")) { ret args(argc, argv); }
    if (str_equals(verb, "child")) { ret child(argv[0]); }
    ret 2;
}
