use std.runtime;
use std.types.size.usize;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.print;
use os: std.system.os;
use terminal: std.terminal.darwin;
use ls: std.system.os.darwin.libsystem;
use key: std.terminal.key;
use terr: std.terminal.error;

fun emit(message: str) bool {
    ret os.write(1, message, str_len(message)) == str_len(message)::i64;
}

fun command(fd: i32, expected: u8) bool {
    var byte: u8 = 0;
    ret os.read(fd, ?byte, 1) == 1 && byte == expected;
}

fun poll(expected: u8) bool {
    val result: terr.Poll = terminal.poll_key();
    if (sel result.err) { ret false; }
    if (!sel result.ok.some) { ret false; }
    val got: key.Key = result.ok.some;
    ret got.kind == key.KIND_BYTE && got.byte == expected;
}

fun empty() bool {
    val result: terr.Poll = terminal.poll_key();
    if (sel result.err) { ret false; }
    ret sel result.ok.none;
}

fun refused(op: terr.Operation) bool {
    ret sel op.err;
}

fun refused_with(op: terr.Operation, code: i64) bool {
    if (sel op.ok) { ret false; }
    ret terr.code(op.err) == code;
}

fun nonterminal() i64 {
    var settings: ls.Termios;
    val got: i32 = ls.tcgetattr(0, ?settings);
    val get_error: i32 = ls.errno();
    val dropped: i32 = ls.tcflush(0, ls.TCIFLUSH);
    val flush_error: i32 = ls.errno();
    if (got != -1 || dropped != -1 || get_error <= 0 || flush_error <= 0) { ret 30; }
    val enabled: terr.Operation = terminal.enable_raw();
    if (!refused(enabled) || terminal.is_raw()) { ret 31; }
    if (!refused_with(enabled, -(get_error::i64))) { ret 32; }
    val flushed: terr.Operation = terminal.flush_input();
    if (!refused(flushed)) { ret 33; }
    if (!refused_with(flushed, -(flush_error::i64))) { ret 34; }
    if (!empty() || refused(terminal.disable_raw())) { ret 35; }
    if (os.close(0) < 0) { ret 36; }
    val closed: terr.Poll = terminal.poll_key();
    if (sel closed.ok) { ret 37; }
    if (terr.code(closed.err) != os.EBADF) { ret 38; }
    print.printlnf("{} {} {} {}", got, get_error, dropped, flush_error);
    ret 0;
}

fun pty(control: i32) i64 {
    if (refused(terminal.enable_raw()) || !terminal.is_raw()) { ret 10; }
    fin { terminal.disable_raw(); }
    if (refused(terminal.enable_raw()) || !empty()) { ret 11; }
    if (!emit("raw\n") || !command(control, 'a')) { ret 12; }
    if (!poll('A') || !empty()) { ret 13; }
    if (!emit("empty\n") || !command(control, 'f')) { ret 14; }
    if (refused(terminal.flush_input())) { ret 15; }
    if (!empty()) { ret 16; }
    if (!emit("flushed\n") || !command(control, 'z')) { ret 17; }
    if (!poll('Z') || !empty()) { ret 18; }
    if (!emit("post\n") || !command(control, 'r')) { ret 19; }
    if (refused(terminal.disable_raw()) || terminal.is_raw()) { ret 20; }
    if (refused(terminal.disable_raw())) { ret 21; }
    if (!emit("restored\n") || !command(control, 'q')) { ret 22; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc < 2) { ret 1; }
    if (str_equals(argv[1], "layout")) {
        print.printlnf("{} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}",
            $size_of(ls.Termios), $align_of(ls.Termios),
            $offset_of(ls.Termios, iflag), $offset_of(ls.Termios, oflag),
            $offset_of(ls.Termios, cflag), $offset_of(ls.Termios, lflag),
            $offset_of(ls.Termios, cc), $offset_of(ls.Termios, ispeed),
            $offset_of(ls.Termios, ospeed), $size_of([20]u8), $size_of(u64),
            $size_of(u64), ls.TCSAFLUSH, ls.TCIFLUSH, ls.ICANON, ls.ECHO,
            ls.VMIN, ls.VTIME, 25::i32);
        ret 0;
    }
    if (str_equals(argv[1], "nonterminal")) { ret nonterminal(); }
    if (argc != 3 || !str_equals(argv[1], "pty")) { ret 2; }
    var fd: i32 = 0;
    var i: usize = 0;
    for (argv[2][i] != 0) {
        val c: u8 = argv[2][i];
        if (c < '0' || c > '9' || fd > 214748364) { ret 3; }
        if (fd == 214748364 && c > '7') { ret 3; }
        fd = fd * 10 + (c - '0')::i32;
        i = i + 1;
    }
    if (i == 0 || fd < 3) { ret 4; }
    ret pty(fd);
}
