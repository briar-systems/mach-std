# the dynamic image: a loader starts the process and owns the main thread's
# thread pointer, and C code creates threads that call back into mach
#
# the cell to run is the first argument: main, spawn or cthread

use std.runtime;
use std.sync.thread;
use std.types.string.str_equals;
use thread_pointer.cells;

#[library("probe")]
ext fun probe_c_tls() i64;
#[library("probe")]
ext fun probe_c_threads(callback: fun(*u8), args: **u8, count: i32) i32;

# an import's address is not taken: mach 5.12 cannot bind one on aarch64 or riscv64
fun launch(callback: fun(*u8), args: **u8, count: i32) i32 {
    ret probe_c_threads(callback, args, count);
}

# the main thread calls C that reads its thread control block, around token reads
fun main_cell() i64 {
    val before: thread.Token = thread.current_token();
    if (before <= 0 || (before & (1 << 62)) != 0) { ret 30; }
    if (probe_c_tls() != 1)                        { ret 31; }
    if (probe_c_tls() != 2)                        { ret 32; }
    if (thread.current_token() != before)          { ret 33; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc < 2) { ret 2; }
    if (str_equals(argv[1], "main"))    { ret main_cell(); }
    if (str_equals(argv[1], "spawn"))   { ret cells.tokens(4, 0, nil); }
    if (str_equals(argv[1], "cthread")) { ret cells.tokens(4, 4, launch); }
    ret 2;
}
