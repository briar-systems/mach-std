# the probe cells, shared by the static and the dynamic image

use std.sync.atomic;
use std.sync.thread;
use std.types.bool.bool;
use std.types.size.usize;

# a thread's reading, published once it has read
pub rec Probe {
    token:    i64;
    stable:   i64;
    arrived:  *i64;
    wait_for: i64;
}

# starts count C threads that each run callback(args[i]), returns 0 once all are joined
pub def CLauncher: fun(fun(*u8), **u8, i32) i32;

val TOKEN_FROM_ID: i64 = 1 << 62;

# read the token repeatedly, publish it, then stay live until every reader has
# published, so all the tokens compared belong to threads live at the same time
pub fun reader(arg: *u8) {
    val probe: *Probe        = arg::*Probe;
    val first: thread.Token  = thread.current_token();
    var same:  i64           = 1;
    var i:     usize         = 0;
    for (i < 1000) {
        if (thread.current_token() != first) { same = 0; }
        i = i + 1;
    }
    probe.token  = first;
    probe.stable = same;
    atomic.fetch_add(probe.arrived, 1);
    for (atomic.load(probe.arrived) < probe.wait_for) { atomic.spin_hint(); }
}

# a token read from the thread pointer: positive and not the thread-id fallback
fun direct(token: i64) bool {
    ret token > 0 && (token & TOKEN_FROM_ID) == 0;
}

# the main thread and std_count std threads, with c_count threads C creates
# through launch, all live at once: every token direct, stable and distinct
# ---
# ret: 0, or the first check that failed
pub fun tokens(std_count: usize, c_count: usize, launch: CLauncher) i64 {
    val main_token: thread.Token = thread.current_token();
    if (!direct(main_token)) { ret 10; }

    val total:   usize = std_count + c_count;
    var arrived: i64   = 0;
    var probes:  [16]Probe;
    var threads: [8]thread.Thread;
    var i:       usize = 0;
    for (i < total) {
        probes[i] = Probe{token: 0, stable: 0, arrived: ?arrived, wait_for: total::i64};
        i = i + 1;
    }
    i = 0;
    for (i < std_count) {
        val spawned: thread.Operation = thread.spawn_with(reader, (?probes[i])::*u8, ?threads[i]);
        if (!(sel spawned.ok)) { ret 11; }
        i = i + 1;
    }
    if (c_count > 0) {
        var args: [8]*u8;
        var j:    usize = 0;
        for (j < c_count) {
            args[j] = (?probes[std_count + j])::*u8;
            j = j + 1;
        }
        val launched: i32 = launch(reader, ?args[0], c_count::i32);
        if (launched != 0) { ret 20 + launched::i64; }
    }
    for (atomic.load(?arrived) < total::i64) { atomic.spin_hint(); }
    i = 0;
    for (i < std_count) {
        val joined: thread.Operation = thread.join(?threads[i]);
        if (!(sel joined.ok)) { ret 12; }
        i = i + 1;
    }

    i = 0;
    for (i < total) {
        if (probes[i].stable != 1)          { ret 13; }
        if (!direct(probes[i].token))       { ret 14; }
        if (probes[i].token == main_token)  { ret 15; }
        var k: usize = i + 1;
        for (k < total) {
            if (probes[i].token == probes[k].token) { ret 16; }
            k = k + 1;
        }
        i = i + 1;
    }
    if (thread.current_token() != main_token) { ret 17; }
    ret 0;
}
