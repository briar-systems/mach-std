# spawned-thread stack overflow probe (#977)
#
# a thread std spawns recurses past the bottom of its stack. the OS must stop it
# with a fault, never let it write the memory below. on linux the probe maps a
# victim region directly under the stack's guard, so a stack with no guard would
# run into the victim, finish the recursion and exit 0, which verify.sh fails.
use std.runtime;
use std.sync.thread;
use std.system.os;
use std.types.size.isize;
use std.types.size.usize;

$if ($mach.build.os == $mach.os.linux) {
    use linux: std.system.os.linux.shared;
}

val RESERVE: usize = 262144;
val VICTIM:  usize = 262144;

# the frames' pads escape here, so each frame keeps its pad on the stack
var pad_sink: usize = 0;

# 1 when the thread ran past the stack without faulting, 3 when the victim could not be mapped
var outcome: i64 = 0;

# map VICTIM bytes ending at end, at exactly that address
# ---
# ret: 0 once mapped, -17 (EEXIST) where a mapping already sits there, else a failure
fun map_victim(end: usize) i64 {
    $if ($mach.build.os == $mach.os.linux) {
        $if ($mach.build.arch == $mach.arch.x86_64) {
            val sys_mmap: usize = 9;
        }
        $or {
            val sys_mmap: usize = 222;
        }
        # PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE
        val want:   usize = end - VICTIM;
        val mapped: i64   = linux.syscall6(sys_mmap, want, VICTIM, 3, 0x100022, (-1)::isize::usize, 0);
        if (mapped < 0)            { ret mapped; }
        if (mapped::usize != want) { ret -22; }
        ret 0;
    }
    $or {
        ret 0;
    }
}

# recurse until the frame lies below stop
fun descend(stop: usize) usize {
    var pad: [1024]u8;
    pad[0]   = 1;
    pad_sink = (?pad[0])::usize;
    var below: usize = 0;
    if ((?pad[0])::usize > stop) { below = descend(stop); }
    ret below + pad[0]::usize;
}

fun overflow(arg: *u8) {
    var low:  usize = 0;
    var high: usize = 0;
    if (!os.stack_bounds(?low, ?high)) {
        outcome = 4;
        ret;
    }
    # below the usable stack sit the guard, then, on linux, the victim
    var floor: usize = low;
    $if ($mach.build.os == $mach.os.linux) {
        floor = low - linux.THREAD_STACK_GUARD;
        # a mapping already below the guard serves as the victim: qemu-user
        # places mappings bottom-up, so there it is the one made before the stack
        val victim: i64 = map_victim(floor);
        if (victim != 0 && victim != -17) {
            outcome = 3;
            ret;
        }
    }
    descend(floor - VICTIM / 2);
    outcome = 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var c: thread.Config;
    thread.config_default(?c);
    c.stack_reserve = RESERVE;
    var t:       thread.Thread;
    val spawned: thread.Operation = thread.spawn_with_config(overflow, nil, ?c, ?t);
    if (sel spawned.err) { ret 2; }
    val joined: thread.Operation = thread.join(?t);
    if (sel joined.err) { ret 2; }
    ret outcome;
}
