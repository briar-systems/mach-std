use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.system.os;
use std.process.exec;
use A: std.allocator;
use page: std.allocator.page;
use vector: std.collections.vector;
use R: std.types.result;

$if ($mach.build.os == $mach.os.linux) { use host: std.system.os.linux; }
$or ($mach.build.os == $mach.os.darwin) { use host: std.system.os.darwin; }

fun expected(value: u32) u32 {
    $if ($mach.build.os == $mach.os.windows) { ret value; }
    $or { ret value & 255; }
}

fun matches(status: exec.ExitStatus, value: u32) bool {
    ret exec.exited(status) && exec.code(status) == expected(value)
        && !exec.signaled(status) && !status.core_dumped;
}

fun arguments(program: str, value: str) [3]str {
    ret [3]str{program, value, nil};
}

fun cleanup(child: exec.Child) {
    if (child.pid <= 0) { ret; }
    exec.terminate_child(child);
    exec.wait(child);
}

fun exit_values(program: str) i64 {
    val values: [7]u32 = [7]u32{0, 1, 255, 256, 259, 0x10000, 0xc0000005};
    val text: [7]str = [7]str{"0", "1", "255", "256", "259", "0x10000", "0xc0000005"};
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: usize = 0;
    for (i < 7) {
        var argv: [3]str = arguments(program, text[i]);
        val ran: R.Result[exec.ExitStatus, exec.Error] = exec.run(program, (?argv[0])::**u8, nil);
        if (R.is_err[exec.ExitStatus, exec.Error](ran)) {
            cleanup(R.unwrap_err[exec.ExitStatus, exec.Error](ran).child); ret 10;
        }
        if (!matches(R.unwrap_ok[exec.ExitStatus, exec.Error](ran), values[i])) { ret 11; }
        val captured: R.Result[exec.Output, exec.Error] = exec.output(?alloc, program, (?argv[0])::**u8, nil);
        if (R.is_err[exec.Output, exec.Error](captured)) {
            cleanup(R.unwrap_err[exec.Output, exec.Error](captured).child); ret 12;
        }
        var output: exec.Output = R.unwrap_ok[exec.Output, exec.Error](captured);
        val good: bool = matches(output.status, values[i]) && output.bytes.len == 0;
        if (!vector.dnit[u8](?output.bytes)) { ret 13; }
        if (!good) { ret 14; }
        i = i + 1;
    }
    var first_argv: [3]str = arguments(program, "256");
    var second_argv: [3]str = arguments(program, "0xc0000005");
    val first: i64 = os.spawn(program, (?first_argv[0])::**u8, nil);
    if (first <= 0) { ret 15; }
    val second: i64 = os.spawn(program, (?second_argv[0])::**u8, nil);
    if (second <= 0) { cleanup(exec.Child{pid: first}); ret 16; }
    var seen_first: bool = false;
    var seen_second: bool = false;
    i = 0;
    for (i < 2) {
        val waited: R.Result[exec.Reaped, exec.Error] = exec.wait_any();
        if (R.is_err[exec.Reaped, exec.Error](waited)) {
            cleanup(exec.Child{pid: first}); cleanup(exec.Child{pid: second}); ret 17;
        }
        val reaped: exec.Reaped = R.unwrap_ok[exec.Reaped, exec.Error](waited);
        if (reaped.child.pid == first && !seen_first && matches(reaped.status, 256)) { seen_first = !seen_first; }
        or (reaped.child.pid == second && !seen_second && matches(reaped.status, 0xc0000005)) { seen_second = !seen_second; }
        or { cleanup(exec.Child{pid: first}); cleanup(exec.Child{pid: second}); ret 18; }
        i = i + 1;
    }
    var status: os.ProcessStatus = os.ProcessStatus{kind: 99, code: 77};
    val consumed: os.WaitResult = os.wait_pid(-1, ?status, os.WNOHANG);
    if (!seen_first || !seen_second || consumed.pid != 0 || consumed.error.code != os.ECHILD
        || status.kind != 99 || status.code != 77) { ret 19; }
    ret 0;
}

fun posix_states(program: str) i64 {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    $or {
        var argv: [3]str = arguments(program, "signal");
        val ran: R.Result[exec.ExitStatus, exec.Error] = exec.run(program, (?argv[0])::**u8, nil);
        if (R.is_err[exec.ExitStatus, exec.Error](ran)) {
            cleanup(R.unwrap_err[exec.ExitStatus, exec.Error](ran).child); ret 20;
        }
        val signaled: exec.ExitStatus = R.unwrap_ok[exec.ExitStatus, exec.Error](ran);
        if (!exec.signaled(signaled) || exec.signal(signaled) != 15 || exec.exited(signaled)) { ret 21; }
        argv = arguments(program, "stop");
        val pid: i64 = os.spawn(program, (?argv[0])::**u8, nil);
        if (pid <= 0) { ret 22; }
        val child: exec.Child = exec.Child{pid: pid};
        var status: os.ProcessStatus;
        val stopped: os.WaitResult = host.wait_pid(pid, ?status, host.WUNTRACED);
        if (stopped.pid != pid || stopped.error.code != 0 || !os.was_stopped(status) || os.has_exited(status)) {
            cleanup(child); ret 23;
        }
        var wanted: i32 = 19;
        $if ($mach.build.os == $mach.os.darwin) { wanted = 17; }
        if (os.stop_signal(status) != wanted) { cleanup(child); ret 24; }
        status = os.ProcessStatus{kind: 99, code: 77};
        val pending: os.WaitResult = os.wait_pid(pid, ?status, os.WNOHANG);
        if (pending.pid != 0 || pending.error.code != 0 || status.kind != 99 || status.code != 77) {
            cleanup(child); ret 25;
        }
        val killed: R.Result[bool, str] = exec.terminate_child(child);
        if (R.is_err[bool, str](killed)) { cleanup(child); ret 26; }
        val reaped: R.Result[exec.ExitStatus, exec.Error] = exec.wait(child);
        if (R.is_err[exec.ExitStatus, exec.Error](reaped)) {
            cleanup(R.unwrap_err[exec.ExitStatus, exec.Error](reaped).child); ret 27;
        }
        val final: exec.ExitStatus = R.unwrap_ok[exec.ExitStatus, exec.Error](reaped);
        if (!exec.signaled(final) || exec.signal(final) != 9) { ret 28; }
        ret 0;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc != 2) { ret 2; }
    val codes: i64 = exit_values(argv[1]);
    if (codes != 0) { ret codes; }
    ret posix_states(argv[1]);
}
