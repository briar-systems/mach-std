# tracked-child force-termination probe (#470)
#
# the parent kills and reaps several blocking children, checks an unrelated
# child remains alive, and verifies stale and unknown PIDs are rejected.
use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.res;
use std.types.canonical.err;
use std.system.os;
use std.process.exec;

fun spawn_blocker(program: *u8) i64 {
    $if ($mach.build.os == $mach.os.windows) {
        var argv: [3]usize;
        argv[0] = program::usize;
        argv[1] = ("--child")::usize;
        argv[2] = 0;
        ret os.spawn(program, (?argv[0])::**u8, nil);
    }
    $or {
        # exec keeps the shell's PID while replacing it with the blocking
        # program. this also runs under qemu-user, where the guest parent can
        # launch the host's /bin/sh and /bin/sleep.
        ret os.spawn_shell("exec sleep 3600", nil, nil);
    }
}

fun cleanup(pid: i64) {
    if (pid <= 0) { ret; }
    os.terminate_child(pid);
    var status: os.ProcessStatus;
    os.wait_pid(pid, ?status, 0);
}

fun status_ok(status: exec.ExitStatus) i64 {
    $if ($mach.build.os == $mach.os.windows) {
        if (!exec.exited(status) || exec.code(status) != 137) { ret 0; }
    }
    $or {
        if (!exec.signaled(status) || exec.signal(status) != 9) { ret 0; }
    }
    ret 1;
}

fun terminated(child: exec.Child) bool {
    val tr: err[exec.Error] = exec.terminate_child(child);
    ret sel tr.ok;
}

# 1 when the child reaped with the force-stop status, 0 otherwise
fun waited_ok(child: exec.Child) i64 {
    val wr: res[exec.ExitStatus, exec.Error] = exec.wait(child);
    if (!sel wr.ok) { ret 0; }
    ret status_ok(wr.ok);
}

fun terminate_and_wait(pid: i64) i64 {
    val child: exec.Child = exec.Child{pid: pid};
    if (!terminated(child)) { ret 0; }
    ret waited_ok(child);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc > 1) {
        for (true) { os.sleep(1000000000); }
        ret 0;
    }

    val first: i64 = spawn_blocker(argv[0]);
    if (first < 0) { ret 10; }
    val second: i64 = spawn_blocker(argv[0]);
    if (second < 0) { cleanup(first); ret 11; }

    if (!terminated(exec.Child{pid: first})) {
        cleanup(first); cleanup(second); ret 20;
    }

    # force-stopping one child must not disturb a different tracked child.
    var status: os.ProcessStatus;
    val second_probe: os.WaitResult = os.wait_pid(second, ?status, os.WNOHANG);
    if (second_probe.pid != 0 || second_probe.error.code != 0) {
        cleanup(first); cleanup(second); ret 21;
    }

    val first_wait: res[exec.ExitStatus, exec.Error] = exec.wait(exec.Child{pid: first});
    if (sel first_wait.err) {
        cleanup(second); ret 22;
    }
    if (status_ok(first_wait.ok) == 0) {
        cleanup(second); ret 23;
    }

    # reaped and never-spawned PIDs both fail as ECHILD; neither lookup can
    # fall through to a raw PID-directed termination. the typed surface
    # reports the same refusal as the native failure that keeps the child.
    if (os.terminate_child(first) != os.ECHILD) {
        cleanup(second); ret 24;
    }
    val stale: err[exec.Error] = exec.terminate_child(exec.Child{pid: first});
    if (!sel stale.err) { cleanup(second); ret 33; }
    if (!sel stale.err.native) { cleanup(second); ret 34; }
    if (stale.err.native.code != os.ECHILD || stale.err.native.operation != os.PROCESS_OP_TERMINATE
        || exec.retained(stale.err).pid != first) {
        cleanup(second); ret 35;
    }
    if (os.terminate_child(2147483647) != os.ECHILD) {
        cleanup(second); ret 25;
    }
    if (os.terminate_child(0) != os.EINVAL) {
        cleanup(second); ret 32;
    }
    val still_alive: os.WaitResult = os.wait_pid(second, ?status, os.WNOHANG);
    if (still_alive.pid != 0 || still_alive.error.code != 0) {
        cleanup(second); ret 26;
    }

    if (os.terminate_child(second) != 0) { cleanup(second); ret 27; }
    val second_wait: res[exec.ExitStatus, exec.Error] = exec.wait(exec.Child{pid: second});
    if (sel second_wait.err) { ret 28; }
    if (status_ok(second_wait.ok) == 0) { ret 29; }

    # a fresh slot/child still terminates and reaps after the earlier cycles.
    val third: i64 = spawn_blocker(argv[0]);
    if (third < 0) { ret 30; }
    if (terminate_and_wait(third) == 0) { cleanup(third); ret 31; }
    ret 0;
}
