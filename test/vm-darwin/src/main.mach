use std.runtime;
use std.types.size.usize;
use std.types.size.isize;
use std.types.string.str_equals;
use std.print;
use os: std.system.os.darwin;
use ls: std.system.os.darwin.libsystem;
use common: std.system.os.shared;
use A: std.allocator;
use page_allocator: std.allocator.page;
use bump: std.allocator.bump;
use std.types.canonical.res;
use std.types.canonical.err;

fun basic() i64 {
    val page: usize = os.page_size();
    if (os.allocate(0) != nil || os.allocate((-1)::isize::usize) != nil) { ret 10; }
    if (os.deallocate(nil, page) != 0 || os.deallocate(1::ptr, 0) != 0 || os.sync_file(nil, page) != 0 || os.sync_file(1::ptr, 0) != 0) { ret 11; }
    val first: ptr = os.allocate(page * 2);
    if (first == nil) { ret 12; }
    var i: usize = 0;
    for (i < page * 2) {
        if (@((first::usize + i)::*u8) != 0) { os.deallocate(first, page * 2); ret 13; }
        @((first::usize + i)::*u8) = (i % 251)::u8;
        i = i + 1;
    }
    val grown: ptr = os.reallocate(first, page * 2, page * 3);
    if (grown == nil) { os.deallocate(first, page * 2); ret 14; }
    if (ls.mprotect(first, page, 1) != -1) { os.deallocate(grown, page * 3); ret 15; }
    i = 0;
    for (i < page * 3) {
        var expected: u8 = 0;
        if (i < page * 2) { expected = (i % 251)::u8; }
        if (@((grown::usize + i)::*u8) != expected) { os.deallocate(grown, page * 3); ret 16; }
        i = i + 1;
    }
    if (os.deallocate(grown, page * 3) != 0 || ls.mprotect(grown, page, 1) != -1) { ret 17; }
    ret 0;
}

fun errors() i64 {
    val page: usize = os.page_size();
    val data: ptr = os.allocate(page);
    if (data == nil) { ret 20; }
    fin { os.deallocate(data, page); }
    val protect: i64 = os.protect(1::ptr, page, 1);
    val unmap: i64 = os.deallocate(1::ptr, page);
    val lock: i64 = os.lock(data, (-1)::isize::usize - page);
    val unlock: i64 = os.unlock(data, (-1)::isize::usize - page);
    val advice: i64 = os.advise(data, page, 0xffffffff);
    val sync: i64 = os.sync_file(1::ptr, page);
    print.printlnf("errors protect={} unmap={} lock={} unlock={} advice={} sync={}", protect, unmap, lock, unlock, advice, sync);
    if (protect >= 0 || unmap >= 0 || lock >= 0 || unlock >= 0 || advice >= 0 || sync >= 0) { ret 21; }
    ret 0;
}

fun access() i64 {
    val page: usize = os.page_size();
    val data: ptr = os.allocate(page);
    if (data == nil) { ret 30; }
    fin { os.deallocate(data, page); }
    @(data::*u8) = 31;
    if (os.protect(data, page, 1) != 0 || @(data::*u8) != 31) { ret 31; }
    if (os.protect(data, page, 3) != 0) { ret 32; }
    @(data::*u8) = 73;
    if (@(data::*u8) != 73) { ret 33; }
    val locked: i64 = os.lock(data, page);
    if (locked != 0) { print.printlnf("lock-failure={}", locked); ret 34; }
    val unlocked: i64 = os.unlock(data, page);
    val advised: i64 = os.advise(data, page, 0);
    print.printlnf("access lock={} unlock={} advice={}", locked, unlocked, advised);
    if (unlocked != 0 || advised != 0) { ret 35; }
    ret 0;
}

fun denied() i64 {
    val page: usize = os.page_size();
    val data: ptr = os.allocate(page);
    if (data == nil) { ret 40; }
    if (os.protect(data, page, 1) != 0) { os.deallocate(data, page); ret 41; }
    if (os.write(1, "fault-ready\n", 12) != 12) { ret 42; }
    @(data::*u8) = 99;
    os.deallocate(data, page);
    ret 43;
}

fun heap(refusal: u8) i64 {
    val base: usize = os.heap_region_base();
    if (base == 0) { ret 50; }
    val page: usize = os.page_size();
    val end: usize = os.heap_region_extend(base + page);
    if (refusal != 0) {
        if (end != base || os.heap_region_base() != base) { ret 51; }
        ret 0;
    }
    if (end != base + page || os.heap_region_base() != end) { ret 52; }
    @(base::*u8) = 13;
    @((end - 1)::*u8) = 29;
    if (@(base::*u8) != 13 || @((end - 1)::*u8) != 29) { ret 53; }
    if (os.heap_region_extend(base) != end || os.heap_region_extend(base + common.HEAP_RESERVE + page) != end || os.heap_region_base() != end) { ret 54; }
    ret 0;
}

fun heap_refused() i64 {
    if (os.heap_region_base() != 0 || os.heap_region_base() != 0) { ret 55; }
    ret 0;
}

fun adapters() i64 {
    var page: A.Allocator;
    val page_made: err[A.Error] = page_allocator.make(?page);
    if (!sel page_made.ok) { ret 70; }
    val paged: res[ptr, A.Error] = A.allocate_raw(?page, 8192, 8);
    if (!sel paged.ok) { ret 71; }
    val data: ptr = paged.ok;
    @(data::*u8) = 81;
    if (@(data::*u8) != 81) { ret 72; }
    val page_released: err[A.Error] = A.deallocate_raw(?page, data, 8192, 8);
    if (!sel page_released.ok) { ret 72; }
    var allocator: A.Allocator;
    var state: bump.BumpState;
    val bump_made: err[A.Error] = bump.make(?allocator, ?state);
    if (!sel bump_made.ok) { ret 73; }
    val small: res[ptr, A.Error] = A.allocate_raw(?allocator, 32, 8);
    if (!sel small.ok) { ret 74; }
    val first: ptr = small.ok;
    @(first::*u8) = 91;
    val large: res[ptr, A.Error] = A.allocate_raw(?allocator, 131072, 8);
    if (!sel large.ok) { ret 75; }
    val second: ptr = large.ok;
    @(second::*u8) = 92;
    if (@(first::*u8) != 91 || @(second::*u8) != 92) { A.deallocate_raw(?allocator, second, 131072, 8); ret 76; }
    val second_released: err[A.Error] = A.deallocate_raw(?allocator, second, 131072, 8);
    if (!sel second_released.ok) { ret 77; }
    val first_released: err[A.Error] = A.deallocate_raw(?allocator, first, 32, 8);
    if (!sel first_released.ok) { ret 77; }
    ret 0;
}

fun mapping(path: *u8) i64 {
    val page: usize = os.page_size();
    val fd: i32 = ls.openat(-2, path, 2);
    if (fd < 0) { ret 60; }
    fin { os.close(fd); }
    if (os.map_file(-1, 0, page, 1) != nil || os.map_file(fd, 1, page, 1) != nil || os.map_file(fd, 0x8000000000000000, page, 1) != nil || os.map_file(fd, 0, 0, 1) != nil) { ret 61; }
    val data: ptr = os.map_file(fd, 0x140000000, page, 3);
    if (data == nil) { ret 62; }
    if (@(data::*u8) != 'B') { os.deallocate(data, page); ret 63; }
    @(data::*u8) = 'Z';
    val synced: i64 = os.sync_file(data, page);
    val unmapped: i64 = os.deallocate(data, page);
    if (synced != 0 || unmapped != 0) { ret 64; }
    var byte: u8 = 0;
    if (ls.pread(fd, ?byte, 1, 0x140000000) != 1 || byte != 'Z') { ret 65; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc < 2) { ret 2; }
    if (str_equals(argv[1], "layout")) { print.printlnf("{} {} {} {}", $size_of(usize), $size_of(i64), $size_of(i32), $size_of(ptr)); ret 0; }
    if (str_equals(argv[1], "basic")) { ret basic(); }
    if (str_equals(argv[1], "errors")) { ret errors(); }
    if (str_equals(argv[1], "access")) { ret access(); }
    if (str_equals(argv[1], "denied")) { ret denied(); }
    if (str_equals(argv[1], "heap")) { ret heap(0); }
    if (str_equals(argv[1], "heap-refusal")) { ret heap(1); }
    if (str_equals(argv[1], "heap-refused")) { ret heap_refused(); }
    if (str_equals(argv[1], "adapters")) { ret adapters(); }
    if (str_equals(argv[1], "mapping") && argc == 3) { ret mapping(argv[2]); }
    ret 3;
}
