use std.types.size.usize;
use std.print;
use os: std.system.os.darwin;
use native: std.system.os.darwin.shared;
use common: std.system.os.shared;
use ls: std.system.os.darwin.libsystem;

#[library("libSystem")]
ext fun getdtablesize() i32;

fun count_fds() i32 {
    val limit: i32 = getdtablesize();
    if (limit <= 0) { ret -1; }
    var count: i32 = 0;
    var fd: i32 = 0;
    for (fd < limit) {
        if (ls.fcntl(fd, native.F_GETFD) >= 0) { count = count + 1; }
        fd = fd + 1;
    }
    ret count;
}

pub fun creation(mode: i32) i64 {
    val before: i32 = count_fds();
    if (before < 0) { ret 40; }
    native.event_probe_reset(mode);
    var queue: common.IoQueue = common.IoQueue{handle: 99, wake: 99};
    val result: i64 = os.io_queue_create(?queue);
    if (result != os.EBADF) { ret 41; }
    if (queue.handle != (-1)::usize || queue.wake != 0) { ret 42; }
    if (count_fds() != before) { ret 43; }
    if (native.event_probe_state() != 0) { ret 44; }
    print.printlnf("creation mode={} error={} no descriptor retained", mode, result);
    ret 0;
}

pub fun translation() i64 {
    native.event_probe_reset(5);
    var queue: common.IoQueue = common.IoQueue{handle: 123, wake: 0};
    var output: [3]os.IoCompletion;
    val count: i64 = os.io_queue_poll(?queue, ?output[0], 3, 1234);
    if (count != 3 || native.event_probe_state() != 0) { ret 50; }
    if (output[0].context != 0x1122334455667788 || output[1].context != 0x7766554433221100 || output[2].context != 0) { ret 51; }
    if (output[0].events != (os.IO_EVENT_READ | os.IO_EVENT_ERROR | os.IO_EVENT_HANGUP) || output[1].events != os.IO_EVENT_WRITE || output[2].events != os.IO_EVENT_WAKE) { ret 52; }
    if (output[0].status != -17 || output[1].status != 0x100000002 || output[2].status != 0) { ret 53; }
    if (output[0].flags != (0xabcd1234::u64 << 16 | 0xc000) || output[1].flags != (9::u64 << 16 | 0x10) || output[2].flags != (0x01000000::u64 << 16 | 0x20)) { ret 54; }
    native.event_probe_reset(6);
    if (os.io_queue_poll(?queue, ?output[0], 3, -1) != 0 || native.event_probe_state() != 0) { ret 55; }
    native.event_probe_reset(7);
    if (os.io_queue_poll(?queue, ?output[0], 3, 0) != 0 || native.event_probe_state() != 0) { ret 56; }
    if (output[0].context != 0x1122334455667788 || output[0].status != -17) { ret 57; }
    print.println("scripted translation contexts filters flags signed data timeout zero progress");
    ret 0;
}
