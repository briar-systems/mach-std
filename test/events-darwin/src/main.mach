use std.runtime;
use std.types.size.usize;
use std.types.string.str_equals;
use std.print;
use thread: std.sync.thread;
use os: std.system.os.darwin;
use ls: std.system.os.darwin.libsystem;
use native: std.system.os.darwin.shared;
use common: std.system.os.shared;

#[library("libSystem")]
ext fun socketpair(domain: i32, kind: i32, protocol: i32, pair: *i32) i32;
#[library("libSystem")]
ext fun getdtablesize() i32;

fun count_fds() i32 {
    val limit: i32 = getdtablesize();
    if (limit <= 0) { ret -1; }
    var count: i32 = 0;
    var fd: i32 = 0;
    for (fd < limit) {
        if (ls.fcntl(fd, native.F_GETFD) >= 0) { count = count + 1; }
        fd = fd + 1;
    }
    ret count;
}

fun layout() i64 {
    print.printlnf("layout size={} ident={} filter={} flags={} fflags={} data={} udata={} alignment={}", $size_of(ls.Kevent), $offset_of(ls.Kevent, ident), $offset_of(ls.Kevent, filter), $offset_of(ls.Kevent, flags), $offset_of(ls.Kevent, fflags), $offset_of(ls.Kevent, data), $offset_of(ls.Kevent, udata), $align_of(ls.Kevent));
    print.printlnf("timeout size={} sec={} nsec={} alignment={}", $size_of(common.Timespec), $offset_of(common.Timespec, sec), $offset_of(common.Timespec, nsec), $align_of(common.Timespec));
    ret 0;
}

fun errors() i64 {
    var queue: common.IoQueue = common.IoQueue{handle: (-1)::usize, wake: 0};
    var completion: os.IoCompletion = os.IoCompletion{context: 111, events: 222, status: 333, flags: 444};
    val polled: i64 = os.io_queue_poll(?queue, ?completion, 1, 0);
    val watched: i64 = os.io_queue_watch(?queue, 0, 1, os.IO_EVENT_READ);
    val removed: i64 = os.io_queue_unwatch(?queue, 0);
    val woken: i64 = os.io_queue_wake(?queue);
    print.printlnf("errors poll={} watch={} unwatch={} wake={}", polled, watched, removed, woken);
    if (polled != os.EBADF || watched != os.EBADF || removed != os.EBADF || woken != os.EBADF) { ret 10; }
    if (completion.context != 111 || completion.events != 222 || completion.status != 333 || completion.flags != 444) { ret 11; }
    if (os.io_queue_poll(?queue, ?completion, 0, 0) != os.EINVAL || os.io_queue_poll(?queue, ?completion, 0x80000000, 0) != os.EINVAL || os.io_queue_poll(?queue, nil, 1, 0) != os.EINVAL) { ret 12; }
    if (os.io_queue_watch(?queue, 0, 0, os.IO_EVENT_READ) != os.EINVAL || os.io_queue_watch(?queue, 0, 1, 0) != os.EINVAL) { ret 13; }
    ret 0;
}

fun nil_queues() i64 {
    var completion: os.IoCompletion;
    if (os.io_queue_create(nil) != os.EINVAL || os.io_queue_watch(nil, 0, 1, os.IO_EVENT_READ) != os.EINVAL || os.io_queue_unwatch(nil, 0) != os.EINVAL || os.io_queue_poll(nil, ?completion, 1, 0) != os.EINVAL || os.io_queue_wait(nil, 0) != os.EINVAL || os.io_queue_wake(nil) != os.EINVAL || os.io_queue_close(nil) != os.EINVAL) { ret 14; }
    print.println("nil queues rejected");
    ret 0;
}

fun events() i64 {
    val before: i32 = count_fds();
    if (before < 0) { ret 19; }
    var queue: common.IoQueue;
    if (os.io_queue_create(?queue) != 0) { ret 20; }
    val descriptor: i32 = queue.handle::i32;
    if ((ls.fcntl(descriptor, native.F_GETFD) & native.FD_CLOEXEC) == 0) { ret 21; }
    var pair: [2]i32;
    var second: [2]i32;
    if (socketpair(1, os.SOCK_STREAM, 0, ?pair[0]) != 0 || socketpair(1, os.SOCK_STREAM, 0, ?second[0]) != 0) { ret 22; }
    var output: [4]os.IoCompletion;
    if (os.io_queue_poll(?queue, ?output[0], 4, 0) != 0) { ret 23; }
    if (os.io_queue_watch(?queue, pair[0]::usize, 101, os.IO_EVENT_READ | os.IO_EVENT_WRITE) != 0 || os.io_queue_watch(?queue, second[0]::usize, 202, os.IO_EVENT_READ) != 0) { ret 24; }
    var byte: u8 = 42;
    if (ls.write(pair[1], ?byte, 1) != 1 || ls.write(second[1], ?byte, 1) != 1) { ret 25; }
    val count: i64 = os.io_queue_poll(?queue, ?output[0], 4, 0);
    if (count != 3) { ret 26; }
    var seen: u32 = 0;
    var i: usize = 0;
    for (i < count::usize) {
        val event: os.IoCompletion = output[i];
        if (event.context == 101 && event.events == os.IO_EVENT_READ && event.status >= 1) { seen = seen | 1; }
        or (event.context == 101 && event.events == os.IO_EVENT_WRITE && event.status >= 0) { seen = seen | 2; }
        or (event.context == 202 && event.events == os.IO_EVENT_READ && event.status >= 1) { seen = seen | 4; }
        or { ret 27; }
        i = i + 1;
    }
    if (seen != 7) { ret 28; }
    if (os.io_queue_poll(?queue, ?output[0], 4, 0) != 0) { ret 29; }
    if (os.io_queue_watch(?queue, pair[0]::usize, 303, os.IO_EVENT_READ) != 0 || os.io_queue_poll(?queue, ?output[0], 4, 0) != 1 || output[0].context != 303) { ret 30; }
    if (ls.read(pair[0], ?byte, 1) != 1 || ls.read(second[0], ?byte, 1) != 1) { ret 31; }
    if (os.io_queue_watch(?queue, pair[0]::usize, 404, os.IO_EVENT_READ) != 0 || os.io_queue_unwatch(?queue, pair[0]::usize) != 0 || os.io_queue_unwatch(?queue, pair[0]::usize) != 0) { ret 32; }
    if (ls.write(pair[1], ?byte, 1) != 1 || os.io_queue_poll(?queue, ?output[0], 4, 0) != 0 || ls.read(pair[0], ?byte, 1) != 1) { ret 33; }
    if (ls.close(pair[1]) != 0 || os.io_queue_watch(?queue, pair[0]::usize, 505, os.IO_EVENT_READ) != 0) { ret 34; }
    if (os.io_queue_poll(?queue, ?output[0], 4, 0) != 1 || output[0].context != 505 || output[0].events != (os.IO_EVENT_READ | os.IO_EVENT_HANGUP) || output[0].status != 0) { ret 35; }
    if (os.io_queue_wake(?queue) != 0 || os.io_queue_poll(?queue, ?output[0], 4, 0) != 1 || output[0].context != 0 || output[0].events != os.IO_EVENT_WAKE) { ret 36; }
    if (os.io_queue_poll(?queue, ?output[0], 4, 0) != 0) { ret 37; }
    if (ls.close(pair[0]) != 0 || ls.close(second[0]) != 0 || ls.close(second[1]) != 0 || os.io_queue_close(?queue) != 0 || os.io_queue_close(?queue) != 0) { ret 38; }
    if (queue.handle != (-1)::usize || queue.wake != 0 || ls.fcntl(descriptor, native.F_GETFD) != -1 || ls.fail_errno() != os.EBADF || count_fds() != before) { ret 39; }
    print.println("events read write contexts oneshot rearm delete eof wake close");
    ret 0;
}

rec WakeContext {
    queue: *common.IoQueue;
    result: i64;
}

fun wake_worker(raw: *u8) {
    val context: *WakeContext = raw::*WakeContext;
    var command: u8 = 0;
    if (ls.read(0, ?command, 1) != 1 || command != 103) { context.result = -1; ret; }
    context.result = os.io_queue_wake(context.queue);
}

fun handshake() i64 {
    var queue: common.IoQueue;
    if (os.io_queue_create(?queue) != 0) { ret 60; }
    var context: WakeContext = WakeContext{queue: ?queue, result: -1};
    var worker: thread.Thread;
    thread.spawn_with(wake_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 61; }
    print.println("ready");
    var completion: os.IoCompletion;
    val result: i64 = os.io_queue_poll(?queue, ?completion, 1, -1);
    val joined: thread.Operation = thread.join(?worker);
    if (sel joined.err || result != 1 || context.result != 0 || completion.context != 0 || completion.events != os.IO_EVENT_WAKE) { ret 62; }
    if (os.io_queue_close(?queue) != 0) { ret 63; }
    print.println("handshake wake passed");
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc != 2) { ret 2; }
    if (str_equals(argv[1], "layout")) { ret layout(); }
    if (str_equals(argv[1], "errors")) { ret errors(); }
    if (str_equals(argv[1], "nil")) { ret nil_queues(); }
    if (str_equals(argv[1], "handshake")) { ret handshake(); }
    if (str_equals(argv[1], "events")) { ret events(); }
    ret 3;
}
