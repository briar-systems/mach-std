# appended only to the verification snapshot of the backend
var event_probe_mode: i32 = 0;
var event_probe_calls: i32 = 0;
var event_probe_bad: i32 = 0;

pub fun event_probe_reset(mode: i32) {
    event_probe_mode = mode;
    event_probe_calls = 0;
    event_probe_bad = 0;
}

pub fun event_probe_state() i32 {
    if (event_probe_bad != 0 || event_probe_calls != 1) { ret 1; }
    ret 0;
}

fun event_probe_kqueue() i32 {
    if (event_probe_mode == 1) {
        event_probe_calls = event_probe_calls + 1;
        ret ls.kevent(-1, nil, 0, nil, 0, nil);
    }
    ret ls.kqueue();
}

fun event_probe_fd_flags(fd: i32) i64 {
    if (event_probe_mode == 2) {
        event_probe_calls = event_probe_calls + 1;
        ret fd_flags(-1);
    }
    ret fd_flags(fd);
}

fun event_probe_set_fd_flags(fd: i32, flags: i32) i64 {
    if (event_probe_mode == 3) {
        event_probe_calls = event_probe_calls + 1;
        ret set_fd_flags(-1, flags);
    }
    ret set_fd_flags(fd, flags);
}

fun event_probe_close(fd: i32) i64 {
    val result: i64 = close(fd);
    ls.getentropy(nil, 257);
    ret result;
}

fun event_probe_kevent(queue: i32, changes: *ls.Kevent, change_count: i32, events: *ls.Kevent, capacity: i32, timeout: *os_shared.Timespec) i32 {
    if (event_probe_mode == 4) {
        event_probe_calls = event_probe_calls + 1;
        if (queue < 0 || changes == nil || change_count != 1 || events != nil || capacity != 0 || timeout != nil) { event_probe_bad = 1; }
        ret ls.kevent(-1, changes, change_count, nil, 0, nil);
    }
    if (event_probe_mode >= 5) {
        event_probe_calls = event_probe_calls + 1;
        if (queue != 123 || changes != nil || change_count != 0 || events == nil || capacity != 3) { event_probe_bad = 1; ret 0; }
        if (event_probe_mode == 6) {
            if (timeout != nil) { event_probe_bad = 1; }
            ret 0;
        }
        if (timeout == nil) { event_probe_bad = 1; ret 0; }
        if (event_probe_mode == 7) {
            if (timeout.sec != 0 || timeout.nsec != 0) { event_probe_bad = 1; }
            ret 0;
        }
        if (timeout.sec != 1 || timeout.nsec != 234000000) { event_probe_bad = 1; }
        events[0] = ls.Kevent{ident: 7, filter: -1, flags: 0xc000, fflags: 0xabcd1234, data: 17, udata: 0x1122334455667788::ptr};
        events[1] = ls.Kevent{ident: 8, filter: -2, flags: 0x10, fflags: 9, data: 0x100000002, udata: 0x7766554433221100::ptr};
        events[2] = ls.Kevent{ident: 1, filter: -10, flags: 0x20, fflags: 0x01000000, data: 0, udata: nil};
        ret 3;
    }
    ret ls.kevent(queue, changes, change_count, events, capacity, timeout);
}
