# a program without a constant-time function: nothing switches the mode, so
# it is off on every thread, and the availability byte still answers from the
# processor

use ditprobe.check;
use std.runtime;
use std.system.dit;
use std.system.os;
use std.system.timing;
use std.types.bool.false;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (dit.available() != (os.cpu_dit() == 1))                 { ret 10; }
    if ((timing.mode() == timing.AVAILABLE) != dit.available()) { ret 12; }
    ret check.both_threads(false);
}
