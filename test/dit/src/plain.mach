# the same program without a secret multiply: the byte is 0 and the mode is
# left alone on every thread

use std.runtime;
use std.system.dit;
use ditprobe.check;
use std.types.bool.false;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (dit.required()) { ret 10; }
    ret check.both_threads(false);
}
