# the same program without a secret multiply: the byte is 0 and the mode is
# left alone on every thread

use ditprobe.check;
use std.runtime;
use std.system.dit;
use std.system.timing;
use std.types.bool.false;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (dit.wanted() || dit.required())   { ret 10; }
    if (timing.mode() != timing.UNNEEDED) { ret 12; }
    ret check.both_threads(false);
}
