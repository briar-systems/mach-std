# a program with a soft constant-time function: the function switches the
# mode for itself where the availability byte allows it and clears it on
# return, so the mode is off outside it on every thread, and nothing turns it
# on at start

use ditprobe.check;
use std.runtime;
use std.system.dit;
use std.system.os;
use std.system.timing;
use std.types.bool.false;

#[constant_time("soft")]
fun f(a: ^u64, b: ^u64) ^u64 {
    ret a * b;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (dit.available() != (os.cpu_dit() == 1)) { ret 10; }
    val x: ^u64 = argc::u64;
    if (f(x, x):>u64 != (argc * argc)::u64)                     { ret 11; }
    if ((timing.mode() == timing.AVAILABLE) != dit.available()) { ret 12; }
    ret check.both_threads(false);
}
