# a program with a secret multiply: the linker sets `__mach_dit_required`, so
# `_rt_init` turns PSTATE.DIT on before main and every std thread sets it too,
# or the process refuses to start on a processor without the mode

use std.runtime;
use std.system.dit;
use ditprobe.check;
use std.types.bool.true;

#[oblivious]
fun f(a: ^u64, b: ^u64) ^u64 {
    ret a * b;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (!dit.required()) { ret 10; }
    val x: ^u64 = argc::u64;
    if (f(x, x):>u64 != (argc * argc)::u64) { ret 11; }
    ret check.both_threads(true);
}
