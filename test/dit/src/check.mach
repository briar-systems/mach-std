# what both probes share: the calling thread's PSTATE.DIT, and the same
# reading from a thread std spawned

use std.sync.thread;
use std.system.dit;
use std.types.bool.bool;

var seen: u64 = 0;

fun worker(arg: *u8) {
    seen = dit.read();
}

# ret: 0 when the main thread and a spawned thread both show `on`, else a code
pub fun both_threads(on: bool) i64 {
    # a processor without the mode has no register to read, and the mode is off
    if (!dit.available()) {
        if (on) { ret 1; }
        ret 0;
    }
    if (((dit.read() & dit.DIT_BIT) != 0) != on) { ret 1; }
    var t:           thread.Thread;
    val err_spawned: thread.Operation = thread.spawn_with(worker, nil, ?t);
    if (!sel err_spawned.ok) { ret 2; }
    val err_joined: thread.Operation = thread.join(?t);
    if (!sel err_joined.ok)                { ret 3; }
    if (((seen & dit.DIT_BIT) != 0) != on) { ret 4; }
    ret 0;
}
