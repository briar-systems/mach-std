use std.print;
use backend: std.system.os.darwin.shared;

pub fun check(mode: i32) i64 {
    backend.cpu_probe_mode = mode;
    backend.cpu_probe_calls = 0;
    backend.cpu_probe_bad = 0;
    val result: i64 = backend.cpu_count();
    var expected: i64 = 1;
    if (mode == 0) { expected = 7; }
    if (mode == 6) { expected = 0x7fffffff; }
    if (backend.cpu_probe_calls != 1 || backend.cpu_probe_bad != 0 || result != expected) { ret 21 + mode::i64; }
    print.printlnf("scripted mode={} count={} calls=1 shape=exact", mode, result);
    ret 0;
}
