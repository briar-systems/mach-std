pub var cpu_probe_mode: i32 = 0;
pub var cpu_probe_calls: usize = 0;
pub var cpu_probe_bad: u8 = 0;

fun cpu_probe_query(name: *u8, old: ptr, old_len: *usize, new: ptr, new_len: usize) i32 {
    cpu_probe_calls = cpu_probe_calls + 1;
    if (old == nil || old_len == nil || new != nil || new_len != 0) {
        cpu_probe_bad = 1;
        ret -1;
    }
    if (@old_len != $size_of(i32)) { cpu_probe_bad = 1; ret -1; }
    val expected: *u8 = "hw.activecpu";
    var i: usize = 0;
    for (i < 13) {
        if (name[i] != expected[i]) { cpu_probe_bad = 1; ret -1; }
        i = i + 1;
    }
    @(old::*i32) = 7;
    if (cpu_probe_mode == 1) {
        val result: i32 = ls.sysctlbyname("mach.audit.nonexistent_cpu_key", old, old_len, nil, 0);
        @(old::*i32) = 7;
        @old_len = $size_of(i32);
        ret result;
    }
    if (cpu_probe_mode == 2) { @(old::*i32) = 0; }
    if (cpu_probe_mode == 3) { @(old::*i32) = -3; }
    if (cpu_probe_mode == 4) { @old_len = 3; }
    if (cpu_probe_mode == 5) { @old_len = 8; }
    if (cpu_probe_mode == 6) { @(old::*i32) = 0x7fffffff; }
    ret 0;
}
