use std.runtime;
use std.types.size.usize;
use std.types.string.str_equals;
use std.print;
use os: std.system.os.darwin;
use ls: std.system.os.darwin.libsystem;

fun query(name: *u8) i64 {
    var count: i32 = 0;
    var length: usize = $size_of(i32);
    if (ls.sysctlbyname(name, ?count, ?length, nil, 0) != 0 || length != $size_of(i32) || count < 1) { ret -1; }
    ret count::i64;
}

fun observe() i64 {
    val before: i64 = query("hw.activecpu");
    val wrapper: i64 = os.cpu_count();
    val after: i64 = query("hw.activecpu");
    val maximum: i64 = query("hw.ncpu");
    print.printlnf("observed before={} wrapper={} after={} maximum={}", before, wrapper, after, maximum);
    if (before < 1 || wrapper < 1 || after < 1 || maximum < 1) { ret 10; }
    ret 0;
}

fun errors() i64 {
    var count: i32 = 17;
    var length: usize = $size_of(i32);
    val result: i32 = ls.sysctlbyname("mach.audit.nonexistent_cpu_key", ?count, ?length, nil, 0);
    val error: i64 = ls.fail_errno();
    print.printlnf("error result={} errno={} length={} count={}", result, error, length, count);
    if (result != -1 || error >= 0) { ret 11; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc != 2) { ret 2; }
    if (str_equals(argv[1], "observe")) { ret observe(); }
    if (str_equals(argv[1], "errors")) { ret errors(); }
    ret 3;
}
