use std.chrono.time;
use std.io.runtime;
use std.sync.cancel;
use std.system.os;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use io_error: std.io.error;

# a wall-clock reading is never a deadline, so each of these is a type error
fun wall_scope(scope: *cancel.Scope, wall: time.Time) cancel.Operation {
    ret cancel.make_root(scope, opt[time.Time].some{wall});
}

fun wall_expiry(scope: *cancel.Scope, wall: time.Time) cancel.Transition {
    ret cancel.expire(scope, wall);
}

fun wall_timer(r: *runtime.Runtime, wall: time.Time) res[runtime.Token, io_error.Error] {
    ret runtime.submit_timer(r, wall, 0);
}

fun wall_remaining(wall: time.Time) time.Elapsed {
    ret time.remaining(wall);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret 0;
}
