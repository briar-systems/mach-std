use std.runtime;
use std.types.size.usize;
use std.types.string.str_equals;
use std.print;
use os: std.system.os.darwin;
use ls: std.system.os.darwin.libsystem;
use random: std.crypto.rand;

fun fill_span(len: usize) i64 {
    var storage: [1027]u8;
    var i: usize = 0;
    for (i < 1027) { storage[i] = 0xA5; i = i + 1; }
    if (random.fill(?storage[1], len) != 0) { ret 10; }
    if (storage[0] != 0xA5) { ret 11; }
    i = len + 1;
    for (i < 1027) {
        if (storage[i] != 0xA5) { ret 11; }
        i = i + 1;
    }
    ret 0;
}

fun smoke() i64 {
    if (os.random_fill(nil, 0) != 0) { ret 12; }
    val sizes: [7]usize = [7]usize{0, 1, 255, 256, 257, 512, 1025};
    var i: usize = 0;
    for (i < 7) {
        val result: i64 = fill_span(sizes[i]);
        if (result != 0) { ret result; }
        i = i + 1;
    }
    print.println("smoke spans=7 guards=exact");
    ret 0;
}

fun errors() i64 {
    var storage: [257]u8;
    var i: usize = 0;
    for (i < 257) { storage[i] = 0xA5; i = i + 1; }
    val native_large: i32 = ls.getentropy(?storage[0], 257);
    val oversized: i64 = ls.fail_errno();
    val native_invalid: i32 = ls.getentropy(1::ptr, 1);
    val invalid: i64 = ls.fail_errno();
    val wrapper: i64 = os.random_fill(1::*u8, 1);
    print.printlnf("errors oversized={} invalid={} wrapper={}", oversized, invalid, wrapper);
    if (native_large != -1 || native_invalid != -1 || oversized >= 0 || invalid >= 0 || wrapper != invalid) { ret 13; }
    i = 0;
    for (i < 257) {
        if (storage[i] != 0xA5) { ret 14; }
        i = i + 1;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc != 2) { ret 2; }
    if (str_equals(argv[1], "smoke")) { ret smoke(); }
    if (str_equals(argv[1], "errors")) { ret errors(); }
    ret 3;
}
