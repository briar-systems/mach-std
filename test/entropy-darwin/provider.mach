pub var entropy_probe_base: usize = 0;
pub var entropy_probe_size: usize = 0;
pub var entropy_probe_next: usize = 0;
pub var entropy_probe_calls: usize = 0;
pub var entropy_probe_fail_on: usize = 0;
pub var entropy_probe_bad: u8 = 0;

fun entropy_probe_fill(data: ptr, len: usize) i32 {
    entropy_probe_calls = entropy_probe_calls + 1;
    if (entropy_probe_calls > 16 || entropy_probe_next > entropy_probe_size) {
        entropy_probe_bad = 1;
        ret -1;
    }
    var expected: usize = entropy_probe_size - entropy_probe_next;
    if (expected > 256) { expected = 256; }
    if (data::usize != entropy_probe_base + entropy_probe_next || len != expected || len == 0) {
        entropy_probe_bad = 1;
        ret 0;
    }
    if (entropy_probe_calls == entropy_probe_fail_on) {
        ret ls.getentropy(data, 257);
    }
    var i: usize = 0;
    for (i < len) {
        @((data::usize + i)::*u8) = (0x31 + (entropy_probe_next + i) % 97)::u8;
        i = i + 1;
    }
    entropy_probe_next = entropy_probe_next + len;
    ret 0;
}
