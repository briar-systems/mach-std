use std.types.size.usize;
use std.print;
use backend: std.system.os.darwin.shared;
use ls: std.system.os.darwin.libsystem;

fun reset(data: *u8, size: usize, fail_on: usize) {
    backend.entropy_probe_base = data::usize;
    backend.entropy_probe_size = size;
    backend.entropy_probe_next = 0;
    backend.entropy_probe_calls = 0;
    backend.entropy_probe_fail_on = fail_on;
    backend.entropy_probe_bad = 0;
}

pub fun geometry() i64 {
    val sizes: [7]usize = [7]usize{0, 1, 255, 256, 257, 512, 1025};
    var n: usize = 0;
    for (n < 7) {
        var storage: [1027]u8;
        var i: usize = 0;
        for (i < 1027) { storage[i] = 0xA5; i = i + 1; }
        val len: usize = sizes[n];
        reset(?storage[1], len, 0);
        val result: i64 = backend.random_fill(?storage[1], len);
        if (result != 0 || backend.entropy_probe_bad != 0 || backend.entropy_probe_next != len || backend.entropy_probe_calls != (len + 255) / 256) { ret 21; }
        if (storage[0] != 0xA5) { ret 21; }
        i = 0;
        for (i < len) {
            if (storage[i + 1] != (0x31 + i % 97)::u8) { ret 21; }
            i = i + 1;
        }
        i = len + 1;
        for (i < 1027) {
            if (storage[i] != 0xA5) { ret 21; }
            i = i + 1;
        }
        n = n + 1;
    }
    print.println("geometry spans=7 pointers=exact lengths=exact");
    ret 0;
}

pub fun partial() i64 {
    var storage: [1027]u8;
    var i: usize = 0;
    for (i < 1027) { storage[i] = 0xA5; i = i + 1; }
    if (ls.getentropy(?storage[1], 257) != -1) { ret 22; }
    val expected: i64 = ls.fail_errno();
    reset(?storage[1], 1025, 2);
    val result: i64 = backend.random_fill(?storage[1], 1025);
    if (result != expected || expected >= 0 || backend.entropy_probe_bad != 0 || backend.entropy_probe_calls != 2 || backend.entropy_probe_next != 256) { ret 22; }
    if (storage[0] != 0xA5) { ret 22; }
    i = 0;
    for (i < 256) {
        if (storage[i + 1] != (0x31 + i % 97)::u8) { ret 22; }
        i = i + 1;
    }
    i = 257;
    for (i < 1027) {
        if (storage[i] != 0xA5) { ret 22; }
        i = i + 1;
    }
    print.printlnf("partial error={} calls=2 prefix=256 suffix=unchanged", result);
    ret 0;
}
