use std.net.local;
use local_async: std.net.async.local;
use std.system.os;
use std.chrono.time;
use std.sync.cancel;
use std.io.lifecycle;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.size.isize;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use io_error: std.io.error;
use io_runtime: std.io.runtime;

$if ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}

test "local socket contract modules are present" {
    val capabilities: local.Capabilities = local.capabilities();
    if (!capabilities.stream || !capabilities.filesystem || $size_of(local_async.Driver) == 0) { ret 1; }
    ret 0;
}

fun saturation_endpoint_name(output: *u8) usize {
    var prefix: *u8 = "mach-std-local-saturation-";
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        prefix = "/tmp/mach-std-local-saturation-";
    }
    var length: usize = 0;
    for (prefix[length] != 0) {
        output[length] = prefix[length];
        length = length + 1;
    }
    var process: u64 = os.getpid()::u64;
    var digits: [20]u8;
    var count: usize = 0;
    if (process == 0) {
        digits[0] = '0';
        count = 1;
    }
    for (process != 0) {
        digits[count] = '0' + (process % 10)::u8;
        process = process / 10;
        count = count + 1;
    }
    var i: usize = 0;
    for (i < count) {
        output[length] = digits[count - i - 1];
        length = length + 1;
        i = i + 1;
    }
    output[length] = '.';
    output[length + 1] = 's';
    output[length + 2] = 'o';
    output[length + 3] = 'c';
    output[length + 4] = 'k';
    output[length + 5] = 0;
    ret length + 5;
}

fun managed_listen(
    driver: *local_async.Driver,
    endpoint: local.Endpoint,
    listener: *local_async.Listener,
) bool {
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret false; }
    var options: local.BindOptions = local.default_bind_options();
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        options.stale = local.REMOVE_STALE_SOCKET;
    }
    if (is_err[io_runtime.Token, io_error.Error](local_async.submit_bind(driver, ?scope, endpoint, options, 0xff00))) { ret false; }
    var output: [2]io_runtime.Completion;
    var waited: Result[usize, io_error.Error] = local_async.wait(driver, ?output[0], 2, 1000);
    if (is_err[usize, io_error.Error](waited) || unwrap_ok[usize, io_error.Error](waited) != 1) { ret false; }
    val bound: Result[local_async.Listener, io_error.Error] = local_async.bound_listener(driver, output[0]);
    if (is_err[local_async.Listener, io_error.Error](bound)) { ret false; }
    @listener = unwrap_ok[local_async.Listener, io_error.Error](bound);
    if (is_err[io_runtime.Token, io_error.Error](local_async.submit_listen(driver, ?scope, listener, 128, 0xff01))) { ret false; }
    waited = local_async.wait(driver, ?output[0], 2, 1000);
    if (is_err[usize, io_error.Error](waited)
        || unwrap_ok[usize, io_error.Error](waited) != 1
        || is_err[bool, io_error.Error](local_async.listening(driver, output[0]))) {
        ret false;
    }
    ret cancel.destroy(?scope);
}

fun endpoint_absent(value: local.Endpoint) bool {
    var path: [108]u8;
    var i: usize = 0;
    for (i < value.length) { path[i] = value.name[i]; i = i + 1; }
    path[value.length] = 0;
    var status: os.stat_t;
    ret os.stat_path(os.AT_FDCWD, ?path[0], ?status, os.AT_SYMLINK_NOFOLLOW) == os.ENOENT;
}

test "async local stale listener token is rejected after driver recreation" {
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name: [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    name[length - 1] = 'a';
    val endpoint_result: Result[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (is_err[local.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
    val endpoint: local.Endpoint = unwrap_ok[local.Endpoint, io_error.Error](endpoint_result);
    var runtime: io_runtime.Runtime;
    if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 4))) { ret 2; }
    var driver: local_async.Driver;
    if (is_err[bool, io_error.Error](local_async.make(?driver, ?runtime))) { ret 3; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, endpoint, ?listener)) { ret 4; }
    val stale: local_async.Listener = listener;
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_listener_close(?driver, ?scope, ?listener, 0xaa01))) {
        ret 5;
    }
    var output: [4]io_runtime.Completion;
    var waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 4, 1000);
    if (is_err[usize, io_error.Error](waited)
        || unwrap_ok[usize, io_error.Error](waited) != 1
        || output[0].has_error
        || !cancel.destroy(?scope)
        || is_err[bool, io_error.Error](local_async.destroy(?driver))
        || is_err[bool, io_error.Error](io_runtime.close(?runtime))
        || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) {
        ret 6;
    }

    if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 4))) { ret 7; }
    if (is_err[bool, io_error.Error](local_async.make(?driver, ?runtime))) { ret 8; }
    if (!managed_listen(?driver, endpoint, ?listener)) { ret 9; }
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 10; }
    val rejected: Result[io_runtime.Token, io_error.Error] = local_async.submit_accept(?driver, ?scope, ?stale, 0xaa02);
    if (!is_err[io_runtime.Token, io_error.Error](rejected)
        || unwrap_err[io_runtime.Token, io_error.Error](rejected).code != os.EBADF
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_listener_close(?driver, ?scope, ?listener, 0xaa03))) {
        ret 11;
    }
    waited = local_async.wait(?driver, ?output[0], 4, 1000);
    if (is_err[usize, io_error.Error](waited)
        || unwrap_ok[usize, io_error.Error](waited) != 1
        || output[0].has_error
        || !cancel.destroy(?scope)
        || is_err[bool, io_error.Error](local_async.destroy(?driver))
        || is_err[bool, io_error.Error](io_runtime.close(?runtime))
        || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))
        || !endpoint_absent(endpoint)) {
        ret 12;
    }
    ret 0;
}

test "async local saturation settles every operation once" {
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name: [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    val endpoint_result: Result[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (is_err[local.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
    val bound: local.Endpoint = unwrap_ok[local.Endpoint, io_error.Error](endpoint_result);
    var runtime: io_runtime.Runtime;
    if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 2))) { ret 3; }
    var driver: local_async.Driver;
    if (is_err[bool, io_error.Error](local_async.make(?driver, ?runtime))) { ret 4; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, bound, ?listener)) { ret 2; }
    var connection_scope: cancel.Scope;
    if (!cancel.make_root(?connection_scope, false, time.Time{sec: 0, nsec: 0})
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_accept(?driver, ?connection_scope, ?listener, 197))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_connect(?driver, ?connection_scope, bound, 198))) {
        ret 5;
    }
    var output: [2]io_runtime.Completion;
    var client: local_async.Stream;
    var server: local_async.Stream;
    var connected: bool = false;
    var accepted: bool = false;
    var attempt: usize = 0;
    for (attempt < 8 && (!connected || !accepted)) {
        val waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (is_err[usize, io_error.Error](waited)) { ret 6; }
        val count: usize = unwrap_ok[usize, io_error.Error](waited);
        var i: usize = 0;
        for (i < count) {
            if (output[i].context == 197) {
                val made: Result[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                if (is_err[local_async.Stream, io_error.Error](made)) { ret 7; }
                server = unwrap_ok[local_async.Stream, io_error.Error](made);
                accepted = true;
            } or (output[i].context == 198) {
                val made: Result[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                if (is_err[local_async.Stream, io_error.Error](made)) { ret 8; }
                client = unwrap_ok[local_async.Stream, io_error.Error](made);
                connected = true;
            } or {
                ret 9;
            }
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    if (!connected || !accepted || !cancel.destroy(?connection_scope)) { ret 10; }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 11; }
    var client_input: u8 = 0xa5;
    var server_input: u8 = 0x5a;
    var extra: u8 = 0xff;
    if (is_err[io_runtime.Token, io_error.Error](local_async.submit_read(?driver, ?scope, ?client, ?client_input, 1, 201))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_read(?driver, ?scope, ?server, ?server_input, 1, 202))) {
        ret 12;
    }
    if (!is_err[io_runtime.Token, io_error.Error](local_async.submit_write(?driver, ?scope, ?client, ?extra, 1, 203))) { ret 13; }
    if (!cancel.cancel(?scope)) { ret 14; }
    var settled: usize = 0;
    attempt = 0;
    for (attempt < 8 && settled < 2) {
        val waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (is_err[usize, io_error.Error](waited)) { ret 15; }
        val count: usize = unwrap_ok[usize, io_error.Error](waited);
        var i: usize = 0;
        for (i < count) {
            if (!output[i].has_error || output[i].error.kind != io_error.CANCELLED
                || output[i].context < 201 || output[i].context > 202) {
                ret 16;
            }
            settled = settled + 1;
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    if (settled != 2 || client_input != 0xa5 || server_input != 0x5a || !cancel.destroy(?scope)) { ret 17; }
    val duplicate: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 0);
    if (is_err[usize, io_error.Error](duplicate) || unwrap_ok[usize, io_error.Error](duplicate) != 0) { ret 18; }

    var close_scope: cancel.Scope;
    if (!cancel.make_root(?close_scope, false, time.Time{sec: 0, nsec: 0})
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_stream_close(?driver, ?close_scope, ?client, lifecycle.ABORTIVE, 204))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_stream_close(?driver, ?close_scope, ?server, lifecycle.ABORTIVE, 205))) {
        ret 15;
    }
    settled = 0;
    attempt = 0;
    for (attempt < 8 && settled < 2) {
        val waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (is_err[usize, io_error.Error](waited)) { ret 16; }
        val count: usize = unwrap_ok[usize, io_error.Error](waited);
        var i: usize = 0;
        for (i < count) {
            if (output[i].has_error || output[i].kind != io_runtime.CLOSE
                || output[i].context < 204 || output[i].context > 205) {
                ret 17;
            }
            settled = settled + 1;
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    if (settled != 2
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_listener_close(?driver, ?close_scope, ?listener, 206))) {
        ret 18;
    }
    val listener_closed: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
    if (is_err[usize, io_error.Error](listener_closed)
        || unwrap_ok[usize, io_error.Error](listener_closed) != 1
        || output[0].context != 206
        || output[0].has_error
        || !cancel.destroy(?close_scope)) {
        ret 19;
    }
    if (is_err[bool, io_error.Error](local_async.destroy(?driver))) { ret 20; }
    if (is_err[bool, io_error.Error](io_runtime.close(?runtime))) { ret 21; }
    if (is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 22; }
    ret 0;
}

test "async local runtime close settles every operation exactly once" {
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name: [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    name[length - 1] = 'r';
    val endpoint_result: Result[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (is_err[local.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
    val endpoint: local.Endpoint = unwrap_ok[local.Endpoint, io_error.Error](endpoint_result);
    var runtime: io_runtime.Runtime;
    if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 16))) { ret 2; }
    var driver: local_async.Driver;
    if (is_err[bool, io_error.Error](local_async.make(?driver, ?runtime))) { ret 3; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, endpoint, ?listener)) { ret 4; }

    var setup_scope: cancel.Scope;
    if (!cancel.make_root(?setup_scope, false, time.Time{sec: 0, nsec: 0})
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_accept(?driver, ?setup_scope, ?listener, 490))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_connect(?driver, ?setup_scope, endpoint, 491))) {
        ret 5;
    }
    var output: [16]io_runtime.Completion;
    var server: local_async.Stream;
    var client: local_async.Stream;
    var made_server: bool = false;
    var made_client: bool = false;
    var rounds: usize = 0;
    for (rounds < 16 && (!made_server || !made_client)) {
        val waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
        if (is_err[usize, io_error.Error](waited)) { ret 6; }
        val count: usize = unwrap_ok[usize, io_error.Error](waited);
        var i: usize = 0;
        for (i < count) {
            if (output[i].context == 490) {
                val accepted: Result[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                if (is_err[local_async.Stream, io_error.Error](accepted)) { ret 7; }
                server = unwrap_ok[local_async.Stream, io_error.Error](accepted);
                made_server = true;
            } or (output[i].context == 491) {
                val connected: Result[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                if (is_err[local_async.Stream, io_error.Error](connected)) { ret 8; }
                client = unwrap_ok[local_async.Stream, io_error.Error](connected);
                made_client = true;
            }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if (!made_server || !made_client || !cancel.destroy(?setup_scope)) { ret 9; }

    var race_scope: cancel.Scope;
    if (!cancel.make_root(?race_scope, false, time.Time{sec: 0, nsec: 0})) { ret 10; }
    var input: u8 = 0xa5;
    var byte: u8 = 0x5a;
    if (is_err[io_runtime.Token, io_error.Error](local_async.submit_accept(?driver, ?race_scope, ?listener, 501))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_connect(?driver, ?race_scope, endpoint, 502))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_read(?driver, ?race_scope, ?server, ?input, 1, 503))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_write(?driver, ?race_scope, ?client, ?byte, 1, 504))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_shutdown_write(?driver, ?race_scope, ?server, 505))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_stream_close(?driver, ?race_scope, ?client, lifecycle.ABORTIVE, 506))
        || is_err[io_runtime.Token, io_error.Error](local_async.submit_listener_close(?driver, ?race_scope, ?listener, 507))) {
        ret 11;
    }
    if (is_err[bool, io_error.Error](io_runtime.close(?runtime))) { ret 12; }
    var seen: [7]bool;
    var settled: usize = 0;
    rounds = 0;
    for (rounds < 32 && settled < 7) {
        val waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
        if (is_err[usize, io_error.Error](waited)) { ret 13; }
        val count: usize = unwrap_ok[usize, io_error.Error](waited);
        var i: usize = 0;
        for (i < count) {
            if (output[i].context < 501 || output[i].context > 507) { ret 14; }
            val index: usize = output[i].context - 501;
            if (seen[index]) { ret 15; }
            seen[index] = true;
            settled = settled + 1;
            if (!output[i].has_error && output[i].context == 501) {
                val accepted: Result[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                if (is_err[local_async.Stream, io_error.Error](accepted)) { ret 16; }
            }
            if (!output[i].has_error && output[i].context == 502) {
                val connected: Result[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                if (is_err[local_async.Stream, io_error.Error](connected)) { ret 17; }
            }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if (settled != 7 || !cancel.destroy(?race_scope)) { ret 18; }
    val duplicate: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 0);
    if (is_err[usize, io_error.Error](duplicate) || unwrap_ok[usize, io_error.Error](duplicate) != 0) { ret 19; }
    if (is_err[bool, io_error.Error](local_async.destroy(?driver)) || !endpoint_absent(endpoint)) { ret 20; }
    if (io_runtime.snapshot(?runtime).state != lifecycle.CLOSED || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 21; }
    ret 0;
}

$if ($mach.build.os == $mach.os.windows) {
    #[library("kernel32.dll")]
    ext fun GetCurrentProcess() isize;
    #[library("kernel32.dll")]
    ext fun GetProcessHandleCount(process: isize, count: *u32) i32;

    fun endpoint_name(output: *u8) usize {
        val prefix: *u8 = "mach-std-async-local-502-";
        var length: usize = 0;
        for (prefix[length] != 0) {
            output[length] = prefix[length];
            length = length + 1;
        }
        var process: u64 = os.getpid()::u64;
        var digits: [20]u8;
        var count: usize = 0;
        if (process == 0) {
            digits[0] = '0';
            count = 1;
        }
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process = process / 10;
            count = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            output[length] = digits[count - i - 1];
            length = length + 1;
            i = i + 1;
        }
        output[length] = '.';
        output[length + 1] = 's';
        output[length + 2] = 'o';
        output[length + 3] = 'c';
        output[length + 4] = 'k';
        output[length + 5] = 0;
        ret length + 5;
    }

    fun handle_count(count: *u32) bool {
        ret count != nil && GetProcessHandleCount(GetCurrentProcess(), count) != 0;
    }

    fun wait_one(driver: *local_async.Driver, context: usize, completion: *io_runtime.Completion) bool {
        var output: [16]io_runtime.Completion;
        var attempt: usize = 0;
        for (attempt < 16) {
            val waited: Result[usize, io_error.Error] = local_async.wait(driver, ?output[0], 16, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret false; }
            val count: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < count) {
                if (output[i].context == context) {
                    @completion = output[i];
                    ret true;
                }
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        ret false;
    }

    test "async local windows: iocp lifecycle cancellation and ownership" {
        if (windows.running_under_wine()) { ret 0; }
        var name: [108]u8;
        val length: usize = endpoint_name(?name[0]);
        val endpoint_result: Result[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
        if (is_err[local.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
        val bound: local.Endpoint = unwrap_ok[local.Endpoint, io_error.Error](endpoint_result);
        var runtime: io_runtime.Runtime;
        if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 16))) { ret 2; }
        var driver: local_async.Driver;
        if (is_err[bool, io_error.Error](local_async.make(?driver, ?runtime))) { ret 3; }
        var listener: local_async.Listener;
        if (!managed_listen(?driver, bound, ?listener)) { ret 4; }

        var connection_scope: cancel.Scope;
        if (!cancel.make_root(?connection_scope, false, time.Time{sec: 0, nsec: 0})) { ret 5; }
        if (is_err[io_runtime.Token, io_error.Error](local_async.submit_accept(?driver, ?connection_scope, ?listener, 101))
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_connect(?driver, ?connection_scope, bound, 102))) {
            ret 6;
        }
        var server: local_async.Stream;
        var client: local_async.Stream;
        var saw_accept: bool = false;
        var saw_connect: bool = false;
        var output: [16]io_runtime.Completion;
        var attempt: usize = 0;
        for (attempt < 16 && (!saw_accept || !saw_connect)) {
            val waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 7; }
            val count: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < count) {
                if (output[i].context == 101) {
                    val accepted: Result[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                    if (is_err[local_async.Stream, io_error.Error](accepted)) { ret 8; }
                    server = unwrap_ok[local_async.Stream, io_error.Error](accepted);
                    saw_accept = true;
                } or (output[i].context == 102) {
                    val connected: Result[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                    if (is_err[local_async.Stream, io_error.Error](connected)) { ret 9; }
                    client = unwrap_ok[local_async.Stream, io_error.Error](connected);
                    saw_connect = true;
                }
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        if (!saw_accept || !saw_connect || !cancel.destroy(?connection_scope)) { ret 10; }
        val identity: Result[local.PeerIdentity, io_error.Error] = local_async.peer_identity(?driver, ?server);
        if (!is_err[local.PeerIdentity, io_error.Error](identity)
            || unwrap_err[local.PeerIdentity, io_error.Error](identity).code != os.ENOTSUP) {
            ret 11;
        }

        var transfer_scope: cancel.Scope;
        if (!cancel.make_root(?transfer_scope, false, time.Time{sec: 0, nsec: 0})) { ret 12; }
        var first_input: u8 = 0;
        var second_input: u8 = 0;
        var first_output: u8 = 'a';
        var second_output: u8 = 'b';
        if (is_err[io_runtime.Token, io_error.Error](local_async.submit_read(?driver, ?transfer_scope, ?server, ?first_input, 1, 103))
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_read(?driver, ?transfer_scope, ?server, ?second_input, 1, 104))
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_write(?driver, ?transfer_scope, ?client, ?first_output, 1, 105))
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_write(?driver, ?transfer_scope, ?client, ?second_output, 1, 106))) {
            ret 13;
        }
        var completed: usize = 0;
        attempt = 0;
        for (attempt < 16 && completed < 4) {
            val waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 14; }
            val count: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < count) {
                if (output[i].has_error || output[i].bytes != 1
                    || output[i].context < 103 || output[i].context > 106) {
                    ret 15;
                }
                completed = completed + 1;
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        if (completed != 4 || first_input != 'a' || second_input != 'b') { ret 16; }
        first_input = 0;
        first_output = 'z';
        if (is_err[io_runtime.Token, io_error.Error](local_async.submit_read(?driver, ?transfer_scope, ?client, ?first_input, 1, 115))
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_write(?driver, ?transfer_scope, ?server, ?first_output, 1, 116))) {
            ret 17;
        }
        completed = 0;
        attempt = 0;
        for (attempt < 16 && completed < 2) {
            val waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 18; }
            val count: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < count) {
                if (output[i].has_error || output[i].bytes != 1
                    || output[i].context < 115 || output[i].context > 116) {
                    ret 19;
                }
                completed = completed + 1;
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        if (completed != 2 || first_input != 'z' || !cancel.destroy(?transfer_scope)) { ret 20; }

        var before_accept: u32 = 0;
        if (!handle_count(?before_accept)) { ret 21; }
        var accept_scope: cancel.Scope;
        if (!cancel.make_root(?accept_scope, false, time.Time{sec: 0, nsec: 0})
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_accept(?driver, ?accept_scope, ?listener, 107))
            || !cancel.cancel(?accept_scope)) {
            ret 18;
        }
        var completion: io_runtime.Completion;
        if (!wait_one(?driver, 107, ?completion)
            || !completion.has_error
            || completion.error.kind != io_error.CANCELLED
            || !cancel.destroy(?accept_scope)) {
            ret 19;
        }
        var after_accept: u32 = 0;
        if (!handle_count(?after_accept) || after_accept != before_accept) { ret 20; }

        var read_scope: cancel.Scope;
        var untouched: u8 = 0xa5;
        if (!cancel.make_root(?read_scope, false, time.Time{sec: 0, nsec: 0})
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_read(?driver, ?read_scope, ?server, ?untouched, 1, 108))
            || !cancel.cancel(?read_scope)) {
            ret 21;
        }
        if (!wait_one(?driver, 108, ?completion)
            || !completion.has_error
            || completion.error.kind != io_error.CANCELLED
            || untouched != 0xa5
            || !cancel.destroy(?read_scope)) {
            ret 22;
        }

        var shutdown_scope: cancel.Scope;
        if (!cancel.make_root(?shutdown_scope, false, time.Time{sec: 0, nsec: 0})
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_shutdown_write(?driver, ?shutdown_scope, ?server, 109))
            || !wait_one(?driver, 109, ?completion)
            || completion.has_error
            || !cancel.destroy(?shutdown_scope)) {
            ret 23;
        }
        var eof_scope: cancel.Scope;
        if (!cancel.make_root(?eof_scope, false, time.Time{sec: 0, nsec: 0})
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_read(?driver, ?eof_scope, ?client, ?untouched, 1, 110))
            || !wait_one(?driver, 110, ?completion)
            || completion.has_error
            || !completion.end_of_stream
            || !cancel.destroy(?eof_scope)) {
            ret 24;
        }

        var ordered_close_scope: cancel.Scope;
        if (!cancel.make_root(?ordered_close_scope, false, time.Time{sec: 0, nsec: 0})
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_read(?driver, ?ordered_close_scope, ?server, ?untouched, 1, 111))
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_stream_close(?driver, ?ordered_close_scope, ?server, lifecycle.ABORTIVE, 112))) {
            ret 25;
        }
        var closed: usize = 0;
        var canceled_read: usize = 0;
        attempt = 0;
        for (attempt < 16 && (closed == 0 || canceled_read == 0)) {
            val waited: Result[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 26; }
            val count: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < count) {
                if (output[i].context == 111) {
                    if (!output[i].has_error || output[i].error.kind != io_error.CANCELLED) { ret 27; }
                    canceled_read = canceled_read + 1;
                } or (output[i].context == 112) {
                    if (output[i].has_error || output[i].kind != io_runtime.CLOSE) { ret 28; }
                    closed = closed + 1;
                } or {
                    ret 29;
                }
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        if (closed != 1 || canceled_read != 1 || !cancel.destroy(?ordered_close_scope)) { ret 30; }

        var close_cancel_scope: cancel.Scope;
        if (!cancel.make_root(?close_cancel_scope, false, time.Time{sec: 0, nsec: 0})
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_stream_close(?driver, ?close_cancel_scope, ?client, lifecycle.ABORTIVE, 113))
            || !cancel.cancel(?close_cancel_scope)
            || !wait_one(?driver, 113, ?completion)
            || !completion.has_error
            || completion.error.kind != io_error.CANCELLED
            || !cancel.destroy(?close_cancel_scope)) {
            ret 31;
        }

        var listener_close_scope: cancel.Scope;
        if (!cancel.make_root(?listener_close_scope, false, time.Time{sec: 0, nsec: 0})
            || is_err[io_runtime.Token, io_error.Error](local_async.submit_listener_close(?driver, ?listener_close_scope, ?listener, 114))
            || !wait_one(?driver, 114, ?completion)
            || completion.has_error
            || !cancel.destroy(?listener_close_scope)) {
            ret 32;
        }
        if (is_err[bool, io_error.Error](local_async.destroy(?driver))) { ret 33; }
        if (is_err[bool, io_error.Error](io_runtime.close(?runtime))) { ret 34; }
        if (is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 35; }
        ret 0;
    }
}
