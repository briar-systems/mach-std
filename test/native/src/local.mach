use std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error: std.io.error;
use std.io.lifecycle;
use io_runtime:  std.io.runtime;
use local_async: std.net.async.local;
use std.net.local;
use std.sync.cancel;
use std.sync.thread;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.isize;
use std.types.size.usize;

# test predicates: `sel` takes a place, so an inline call is tested through these
fun refused(r: err[io_error.Error]) bool {
    ret sel r.err;
}

fun failed[T](r: res[T, io_error.Error]) bool {
    ret sel r.err;
}

fun ok_err(r: err[io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_bool(r: res[bool, io_error.Error]) bool {
    ret sel r.ok;
}

fun scope_ok(r: cancel.Operation) bool {
    ret sel r.ok;
}

fun scope_changed(r: cancel.Transition) bool {
    if (sel r.ok) { ret r.ok; }
    ret false;
}

$if ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}

fun saturation_endpoint_name(output: *u8) usize {
    var prefix: *u8 = "mach-std-local-saturation-";
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        prefix = "/tmp/mach-std-local-saturation-";
    }
    var length: usize = 0;
    for (prefix[length] != 0) {
        output[length] = prefix[length];
        length         = length + 1;
    }
    var process: u64   = os.getpid()::u64;
    var digits:  [20]u8;
    var count:   usize = 0;
    if (process == 0) {
        digits[0] = '0';
        count     = 1;
    }
    for (process != 0) {
        digits[count] = '0' + (process % 10)::u8;
        process       = process / 10;
        count         = count + 1;
    }
    var i: usize = 0;
    for (i < count) {
        output[length] = digits[count - i - 1];
        length         = length + 1;
        i              = i + 1;
    }
    output[length]     = '.';
    output[length + 1] = 's';
    output[length + 2] = 'o';
    output[length + 3] = 'c';
    output[length + 4] = 'k';
    output[length + 5] = 0;
    ret length + 5;
}

fun managed_listen(
    driver: *local_async.Driver,
    endpoint: local.Endpoint,
    listener: *local_async.Listener,
) bool {
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret false; }
    var options: local.BindOptions = local.default_bind_options();
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        options.stale = local.REMOVE_STALE_SOCKET;
    }
    val submit_bind_result: res[io_runtime.Token, io_error.Error] = local_async.submit_bind(driver, ?scope, endpoint, options, 0xff00);
    if (sel submit_bind_result.err) { ret false; }
    var output: [2]io_runtime.Completion;
    var waited: res[usize, io_error.Error] = local_async.wait(driver, ?output[0], 2, 1000);
    if (!(sel waited.ok && waited.ok == 1)) { ret false; }
    val bound: res[local_async.Listener, io_error.Error] = local_async.bound_listener(driver, output[0]);
    if (sel bound.err) { ret false; }
    @listener = bound.ok;
    val submit_listen_result: res[io_runtime.Token, io_error.Error] = local_async.submit_listen(driver, ?scope, listener, 128, 0xff01);
    if (sel submit_listen_result.err) { ret false; }
    waited = local_async.wait(driver, ?output[0], 2, 1000);
    if (!(sel waited.ok && waited.ok == 1)
        || refused(local_async.listening(driver, output[0]))) {
        ret false;
    }
    ret scope_ok(cancel.destroy(?scope));
}

fun endpoint_absent(value: local.Endpoint) bool {
    var path: [108]u8;
    var i:    usize = 0;
    for (i < value.length) {
        path[i] = value.name[i];
        i       = i + 1;
    }
    path[value.length] = 0;
    var status: os.stat_t;
    ret os.error_kind(os.stat_path(os.working_dir(), ?path[0], ?status, os.AT_SYMLINK_NOFOLLOW)) == io_error.NOT_FOUND;
}

test async_local__stale_listener_token_is_rejected_after_driver_recreation {
    var pa: allocator.Allocator;
    page.make(?pa);
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name:   [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    name[length - 1] = 'a';
    val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (sel endpoint_result.err) { ret 1; }
    val endpoint: local.Endpoint = endpoint_result.ok;
    var runtime:  io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, ?pa, 4))) { ret 2; }
    var driver:      local_async.Driver;
    val make_result: err[io_error.Error] = local_async.make(?driver, ?runtime);
    if (sel make_result.err) { ret 3; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, endpoint, ?listener)) { ret 4; }
    val stale: local_async.Listener = listener;
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?scope, ?listener, 0xaa01))) {
        ret 5;
    }
    var output: [4]io_runtime.Completion;
    var waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 4, 1000);
    if (!(sel waited.ok && waited.ok == 1)
        || output[0].has_error
        || !scope_ok(cancel.destroy(?scope))
        || refused(local_async.destroy(?driver))
        || !ok_bool(io_runtime.close(?runtime))
        || !ok_err(io_runtime.destroy(?runtime))) {
        ret 6;
    }

    if (!ok_err(io_runtime.make(?runtime, ?pa, 4))) { ret 7; }
    val make_result2: err[io_error.Error] = local_async.make(?driver, ?runtime);
    if (sel make_result2.err)                                          { ret 8; }
    if (!managed_listen(?driver, endpoint, ?listener))                 { ret 9; }
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 10; }
    val rejected: res[io_runtime.Token, io_error.Error] = local_async.submit_accept(?driver, ?scope, ?stale, 0xaa02);
    if (!(sel rejected.err && rejected.err.kind == io_error.CLOSED)
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?scope, ?listener, 0xaa03))) {
        ret 11;
    }
    waited = local_async.wait(?driver, ?output[0], 4, 1000);
    if (!(sel waited.ok && waited.ok == 1)
        || output[0].has_error
        || !scope_ok(cancel.destroy(?scope))
        || refused(local_async.destroy(?driver))
        || !ok_bool(io_runtime.close(?runtime))
        || !ok_err(io_runtime.destroy(?runtime))
        || !endpoint_absent(endpoint)) {
        ret 12;
    }
    ret 0;
}

test async_local__growth_past_the_initial_size_settles_every_operation_once {
    var pa: allocator.Allocator;
    page.make(?pa);
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name:            [108]u8;
    val length:          usize                               = saturation_endpoint_name(?name[0]);
    val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (sel endpoint_result.err) { ret 1; }
    val bound:   local.Endpoint = endpoint_result.ok;
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, ?pa, 2))) { ret 3; }
    var driver:      local_async.Driver;
    val make_result: err[io_error.Error] = local_async.make(?driver, ?runtime);
    if (sel make_result.err) { ret 4; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, bound, ?listener)) { ret 2; }
    var connection_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?connection_scope, opt[time.Instant].none{}))
        || failed[io_runtime.Token](local_async.submit_accept(?driver, ?connection_scope, ?listener, 197))
        || failed[io_runtime.Token](local_async.submit_connect(?driver, ?connection_scope, bound, 198))) {
        ret 5;
    }
    var output:    [2]io_runtime.Completion;
    var client:    local_async.Stream;
    var server:    local_async.Stream;
    var connected: bool  = false;
    var accepted:  bool  = false;
    var attempt:   usize = 0;
    for (attempt < 8 && (!connected || !accepted)) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 6; }
        val count: usize = waited.ok;
        var i:     usize = 0;
        for (i < count) {
            if (output[i].context == 197) {
                val made: res[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                if (sel made.err) { ret 7; }
                server   = made.ok;
                accepted = true;
            }
            or (output[i].context == 198) {
                val made: res[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                if (sel made.err) { ret 8; }
                client    = made.ok;
                connected = true;
            }
            or {
                ret 9;
            }
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    if (!connected || !accepted || !scope_ok(cancel.destroy(?connection_scope))) { ret 10; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 11; }
    var client_input: u8 = 0xa5;
    var server_input: u8 = 0x5a;
    if (failed[io_runtime.Token](local_async.submit_read(?driver, ?scope, ?client, ?client_input, 1, 201))
        || failed[io_runtime.Token](local_async.submit_read(?driver, ?scope, ?server, ?server_input, 1, 202))) {
        ret 12;
    }
    # the initial slots are full, so this submission is the one that grows the runtime
    if (failed[io_runtime.Token](local_async.submit_accept(?driver, ?scope, ?listener, 203))
        || io_runtime.capacity(?runtime) < 3) {
        ret 13;
    }
    if (!scope_changed(cancel.cancel(?scope))) { ret 14; }
    var seen:    [3]bool;
    var settled: usize = 0;
    seen[0] = false;
    seen[1] = false;
    seen[2] = false;
    attempt = 0;
    for (attempt < 8 && settled < 3) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 15; }
        val count: usize = waited.ok;
        var i:     usize = 0;
        for (i < count) {
            if (!output[i].has_error || output[i].error.kind != io_error.CANCELLED
                || output[i].context < 201 || output[i].context > 203
                || seen[output[i].context - 201]) {
                ret 16;
            }
            seen[output[i].context - 201] = true;
            settled                       = settled + 1;
            i                             = i + 1;
        }
        attempt = attempt + 1;
    }
    if (settled != 3 || client_input != 0xa5 || server_input != 0x5a || !scope_ok(cancel.destroy(?scope))) { ret 17; }
    val duplicate: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 0);
    if (!(sel duplicate.ok && duplicate.ok == 0)) { ret 18; }

    var close_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?close_scope, opt[time.Instant].none{}))
        || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?close_scope, ?client, lifecycle.ABORTIVE, 204))
        || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?close_scope, ?server, lifecycle.ABORTIVE, 205))) {
        ret 15;
    }
    settled = 0;
    attempt = 0;
    for (attempt < 8 && settled < 2) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 16; }
        val count: usize = waited.ok;
        var i:     usize = 0;
        for (i < count) {
            if (output[i].has_error || output[i].kind != io_runtime.CLOSE
                || output[i].context < 204 || output[i].context > 205) {
                ret 17;
            }
            settled = settled + 1;
            i       = i + 1;
        }
        attempt = attempt + 1;
    }
    if (settled != 2
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?close_scope, ?listener, 206))) {
        ret 18;
    }
    val listener_closed: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
    if (!(sel listener_closed.ok && listener_closed.ok == 1)
        || output[0].context != 206
        || output[0].has_error
        || !scope_ok(cancel.destroy(?close_scope))) {
        ret 19;
    }
    val destroy_result: err[io_error.Error] = local_async.destroy(?driver);
    if (sel destroy_result.err)                { ret 20; }
    if (!ok_bool(io_runtime.close(?runtime)))  { ret 21; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 22; }
    ret 0;
}

test async_local__runtime_close_settles_every_operation_exactly_once {
    var pa: allocator.Allocator;
    page.make(?pa);
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name:   [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    name[length - 1] = 'r';
    val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (sel endpoint_result.err) { ret 1; }
    val endpoint: local.Endpoint = endpoint_result.ok;
    var runtime:  io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, ?pa, 16))) { ret 2; }
    var driver:      local_async.Driver;
    val make_result: err[io_error.Error] = local_async.make(?driver, ?runtime);
    if (sel make_result.err) { ret 3; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, endpoint, ?listener)) { ret 4; }

    var setup_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?setup_scope, opt[time.Instant].none{}))
        || failed[io_runtime.Token](local_async.submit_accept(?driver, ?setup_scope, ?listener, 490))
        || failed[io_runtime.Token](local_async.submit_connect(?driver, ?setup_scope, endpoint, 491))) {
        ret 5;
    }
    var output:      [16]io_runtime.Completion;
    var server:      local_async.Stream;
    var client:      local_async.Stream;
    var made_server: bool  = false;
    var made_client: bool  = false;
    var rounds:      usize = 0;
    for (rounds < 16 && (!made_server || !made_client)) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
        if (sel waited.err) { ret 6; }
        val count: usize = waited.ok;
        var i:     usize = 0;
        for (i < count) {
            if (output[i].context == 490) {
                val accepted: res[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                if (sel accepted.err) { ret 7; }
                server      = accepted.ok;
                made_server = true;
            }
            or (output[i].context == 491) {
                val connected: res[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                if (sel connected.err) { ret 8; }
                client      = connected.ok;
                made_client = true;
            }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if (!made_server || !made_client || !scope_ok(cancel.destroy(?setup_scope))) { ret 9; }

    var race_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?race_scope, opt[time.Instant].none{}))) { ret 10; }
    var input: u8 = 0xa5;
    var byte:  u8 = 0x5a;
    if (failed[io_runtime.Token](local_async.submit_accept(?driver, ?race_scope, ?listener, 501))
        || failed[io_runtime.Token](local_async.submit_connect(?driver, ?race_scope, endpoint, 502))
        || failed[io_runtime.Token](local_async.submit_read(?driver, ?race_scope, ?server, ?input, 1, 503))
        || failed[io_runtime.Token](local_async.submit_write(?driver, ?race_scope, ?client, ?byte, 1, 504))
        || failed[io_runtime.Token](local_async.submit_shutdown_write(?driver, ?race_scope, ?server, 505))
        || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?race_scope, ?client, lifecycle.ABORTIVE, 506))
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?race_scope, ?listener, 507))) {
        ret 11;
    }
    if (!ok_bool(io_runtime.close(?runtime))) { ret 12; }
    var seen:    [7]bool;
    var settled: usize = 0;
    rounds = 0;
    for (rounds < 32 && settled < 7) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
        if (sel waited.err) { ret 13; }
        val count: usize = waited.ok;
        var i:     usize = 0;
        for (i < count) {
            if (output[i].context < 501 || output[i].context > 507) { ret 14; }
            val index: usize = output[i].context - 501;
            if (seen[index]) { ret 15; }
            seen[index] = true;
            settled     = settled + 1;
            if (!output[i].has_error && output[i].context == 501) {
                val accepted: res[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                if (sel accepted.err) { ret 16; }
            }
            if (!output[i].has_error && output[i].context == 502) {
                val connected: res[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                if (sel connected.err) { ret 17; }
            }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if (settled != 7 || !scope_ok(cancel.destroy(?race_scope))) { ret 18; }
    val duplicate: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 0);
    if (!(sel duplicate.ok && duplicate.ok == 0))                                                         { ret 19; }
    if (refused(local_async.destroy(?driver)) || !endpoint_absent(endpoint))                              { ret 20; }
    if (io_runtime.snapshot(?runtime).state != lifecycle.CLOSED || !ok_err(io_runtime.destroy(?runtime))) { ret 21; }
    ret 0;
}

$if ($mach.build.os == $mach.os.windows) {
    #[library("kernel32.dll")]
    ext fun GetCurrentProcess() isize;
    #[library("kernel32.dll")]
    ext fun GetProcessHandleCount(process: isize, count: *u32) i32;

    fun endpoint_name(output: *u8) usize {
        val prefix: *u8   = "mach-std-async-local-502-";
        var length: usize = 0;
        for (prefix[length] != 0) {
            output[length] = prefix[length];
            length         = length + 1;
        }
        var process: u64   = os.getpid()::u64;
        var digits:  [20]u8;
        var count:   usize = 0;
        if (process == 0) {
            digits[0] = '0';
            count     = 1;
        }
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process       = process / 10;
            count         = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            output[length] = digits[count - i - 1];
            length         = length + 1;
            i              = i + 1;
        }
        output[length]     = '.';
        output[length + 1] = 's';
        output[length + 2] = 'o';
        output[length + 3] = 'c';
        output[length + 4] = 'k';
        output[length + 5] = 0;
        ret length + 5;
    }

    fun handle_count(count: *u32) bool {
        ret count != nil && GetProcessHandleCount(GetCurrentProcess(), count) != 0;
    }

    fun wait_one(driver: *local_async.Driver, context: usize, completion: *io_runtime.Completion) bool {
        var output:  [16]io_runtime.Completion;
        var attempt: usize = 0;
        for (attempt < 16) {
            val waited: res[usize, io_error.Error] = local_async.wait(driver, ?output[0], 16, 1000);
            if (sel waited.err) { ret false; }
            val count: usize = waited.ok;
            var i:     usize = 0;
            for (i < count) {
                if (output[i].context == context) {
                    @completion = output[i];
                    ret true;
                }
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        ret false;
    }

    test async_local__windows_iocp_lifecycle_cancellation_and_ownership {
        var pa: allocator.Allocator;
        page.make(?pa);
        if (windows.running_under_wine()) { ret 0; }
        var name:            [108]u8;
        val length:          usize                               = endpoint_name(?name[0]);
        val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
        if (sel endpoint_result.err) { ret 1; }
        val bound:   local.Endpoint = endpoint_result.ok;
        var runtime: io_runtime.Runtime;
        if (!ok_err(io_runtime.make(?runtime, ?pa, 16))) { ret 2; }
        var driver:      local_async.Driver;
        val make_result: err[io_error.Error] = local_async.make(?driver, ?runtime);
        if (sel make_result.err) { ret 3; }
        var listener: local_async.Listener;
        if (!managed_listen(?driver, bound, ?listener)) { ret 4; }

        var connection_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?connection_scope, opt[time.Instant].none{}))) { ret 5; }
        if (failed[io_runtime.Token](local_async.submit_accept(?driver, ?connection_scope, ?listener, 101))
            || failed[io_runtime.Token](local_async.submit_connect(?driver, ?connection_scope, bound, 102))) {
            ret 6;
        }
        var server:      local_async.Stream;
        var client:      local_async.Stream;
        var saw_accept:  bool  = false;
        var saw_connect: bool  = false;
        var output:      [16]io_runtime.Completion;
        var attempt:     usize = 0;
        for (attempt < 16 && (!saw_accept || !saw_connect)) {
            val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (sel waited.err) { ret 7; }
            val count: usize = waited.ok;
            var i:     usize = 0;
            for (i < count) {
                if (output[i].context == 101) {
                    val accepted: res[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                    if (sel accepted.err) { ret 8; }
                    server     = accepted.ok;
                    saw_accept = true;
                }
                or (output[i].context == 102) {
                    val connected: res[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                    if (sel connected.err) { ret 9; }
                    client      = connected.ok;
                    saw_connect = true;
                }
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        if (!saw_accept || !saw_connect || !scope_ok(cancel.destroy(?connection_scope))) { ret 10; }
        val identity: res[local.PeerIdentity, io_error.Error] = local_async.peer_identity(?driver, ?server);
        if (sel identity.ok)                           { ret 11; }
        if (identity.err.kind != io_error.UNSUPPORTED) { ret 11; }

        var transfer_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?transfer_scope, opt[time.Instant].none{}))) { ret 12; }
        var first_input:   u8 = 0;
        var second_input:  u8 = 0;
        var first_output:  u8 = 'a';
        var second_output: u8 = 'b';
        if (failed[io_runtime.Token](local_async.submit_read(?driver, ?transfer_scope, ?server, ?first_input, 1, 103))
            || failed[io_runtime.Token](local_async.submit_read(?driver, ?transfer_scope, ?server, ?second_input, 1, 104))
            || failed[io_runtime.Token](local_async.submit_write(?driver, ?transfer_scope, ?client, ?first_output, 1, 105))
            || failed[io_runtime.Token](local_async.submit_write(?driver, ?transfer_scope, ?client, ?second_output, 1, 106))) {
            ret 13;
        }
        var completed: usize = 0;
        attempt = 0;
        for (attempt < 16 && completed < 4) {
            val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (sel waited.err) { ret 14; }
            val count: usize = waited.ok;
            var i:     usize = 0;
            for (i < count) {
                if (output[i].has_error || output[i].bytes != 1
                    || output[i].context < 103 || output[i].context > 106) {
                    ret 15;
                }
                completed = completed + 1;
                i         = i + 1;
            }
            attempt = attempt + 1;
        }
        if (completed != 4 || first_input != 'a' || second_input != 'b') { ret 16; }
        first_input  = 0;
        first_output = 'z';
        if (failed[io_runtime.Token](local_async.submit_read(?driver, ?transfer_scope, ?client, ?first_input, 1, 115))
            || failed[io_runtime.Token](local_async.submit_write(?driver, ?transfer_scope, ?server, ?first_output, 1, 116))) {
            ret 17;
        }
        completed = 0;
        attempt   = 0;
        for (attempt < 16 && completed < 2) {
            val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (sel waited.err) { ret 18; }
            val count: usize = waited.ok;
            var i:     usize = 0;
            for (i < count) {
                if (output[i].has_error || output[i].bytes != 1
                    || output[i].context < 115 || output[i].context > 116) {
                    ret 19;
                }
                completed = completed + 1;
                i         = i + 1;
            }
            attempt = attempt + 1;
        }
        if (completed != 2 || first_input != 'z' || !scope_ok(cancel.destroy(?transfer_scope))) { ret 20; }

        var before_accept: u32 = 0;
        if (!handle_count(?before_accept)) { ret 21; }
        var accept_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?accept_scope, opt[time.Instant].none{}))
            || failed[io_runtime.Token](local_async.submit_accept(?driver, ?accept_scope, ?listener, 107))
            || !scope_changed(cancel.cancel(?accept_scope))) {
            ret 18;
        }
        var completion: io_runtime.Completion;
        if (!wait_one(?driver, 107, ?completion)
            || !completion.has_error
            || completion.error.kind != io_error.CANCELLED
            || !scope_ok(cancel.destroy(?accept_scope))) {
            ret 19;
        }
        var after_accept: u32 = 0;
        if (!handle_count(?after_accept) || after_accept != before_accept) { ret 20; }

        var read_scope: cancel.Scope;
        var untouched:  u8 = 0xa5;
        if (!scope_ok(cancel.make_root(?read_scope, opt[time.Instant].none{}))
            || failed[io_runtime.Token](local_async.submit_read(?driver, ?read_scope, ?server, ?untouched, 1, 108))
            || !scope_changed(cancel.cancel(?read_scope))) {
            ret 21;
        }
        if (!wait_one(?driver, 108, ?completion)
            || !completion.has_error
            || completion.error.kind != io_error.CANCELLED
            || untouched != 0xa5
            || !scope_ok(cancel.destroy(?read_scope))) {
            ret 22;
        }

        var shutdown_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?shutdown_scope, opt[time.Instant].none{}))
            || failed[io_runtime.Token](local_async.submit_shutdown_write(?driver, ?shutdown_scope, ?server, 109))
            || !wait_one(?driver, 109, ?completion)
            || completion.has_error
            || !scope_ok(cancel.destroy(?shutdown_scope))) {
            ret 23;
        }
        var eof_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?eof_scope, opt[time.Instant].none{}))
            || failed[io_runtime.Token](local_async.submit_read(?driver, ?eof_scope, ?client, ?untouched, 1, 110))
            || !wait_one(?driver, 110, ?completion)
            || completion.has_error
            || !completion.end_of_stream
            || !scope_ok(cancel.destroy(?eof_scope))) {
            ret 24;
        }

        var ordered_close_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?ordered_close_scope, opt[time.Instant].none{}))
            || failed[io_runtime.Token](local_async.submit_read(?driver, ?ordered_close_scope, ?server, ?untouched, 1, 111))
            || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?ordered_close_scope, ?server, lifecycle.ABORTIVE, 112))) {
            ret 25;
        }
        var closed:        usize = 0;
        var canceled_read: usize = 0;
        attempt = 0;
        for (attempt < 16 && (closed == 0 || canceled_read == 0)) {
            val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (sel waited.err) { ret 26; }
            val count: usize = waited.ok;
            var i:     usize = 0;
            for (i < count) {
                if (output[i].context == 111) {
                    if (!output[i].has_error || output[i].error.kind != io_error.CANCELLED) { ret 27; }
                    canceled_read = canceled_read + 1;
                }
                or (output[i].context == 112) {
                    if (output[i].has_error || output[i].kind != io_runtime.CLOSE) { ret 28; }
                    closed = closed + 1;
                }
                or {
                    ret 29;
                }
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        if (closed != 1 || canceled_read != 1 || !scope_ok(cancel.destroy(?ordered_close_scope))) { ret 30; }

        var close_cancel_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?close_cancel_scope, opt[time.Instant].none{}))
            || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?close_cancel_scope, ?client, lifecycle.ABORTIVE, 113))
            || !scope_changed(cancel.cancel(?close_cancel_scope))
            || !wait_one(?driver, 113, ?completion)
            || !completion.has_error
            || completion.error.kind != io_error.CANCELLED
            || !scope_ok(cancel.destroy(?close_cancel_scope))) {
            ret 31;
        }

        var listener_close_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?listener_close_scope, opt[time.Instant].none{}))
            || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?listener_close_scope, ?listener, 114))
            || !wait_one(?driver, 114, ?completion)
            || completion.has_error
            || !scope_ok(cancel.destroy(?listener_close_scope))) {
            ret 32;
        }
        val destroy_result: err[io_error.Error] = local_async.destroy(?driver);
        if (sel destroy_result.err)                { ret 33; }
        if (!ok_bool(io_runtime.close(?runtime)))  { ret 34; }
        if (!ok_err(io_runtime.destroy(?runtime))) { ret 35; }
        ret 0;
    }
}

# connect one local stream pair through the driver
fun readable_local_pair(driver: *local_async.Driver, listener: *local_async.Listener, bound: local.Endpoint, server: *local_async.Stream, client: *local_async.Stream) i32 {
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))
        || failed[io_runtime.Token](local_async.submit_accept(driver, ?scope, listener, 597))
        || failed[io_runtime.Token](local_async.submit_connect(driver, ?scope, bound, 598))) {
        ret 1;
    }
    var output:    [2]io_runtime.Completion;
    var connected: bool  = false;
    var accepted:  bool  = false;
    var attempt:   usize = 0;
    for (attempt < 8 && (!connected || !accepted)) {
        val waited: res[usize, io_error.Error] = local_async.wait(driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 2; }
        var i: usize = 0;
        for (i < waited.ok) {
            if (output[i].context == 597) {
                val made: res[local_async.Stream, io_error.Error] = local_async.accepted(driver, output[i]);
                if (sel made.err) { ret 3; }
                @server  = made.ok;
                accepted = true;
            }
            or (output[i].context == 598) {
                val made: res[local_async.Stream, io_error.Error] = local_async.connected(driver, output[i]);
                if (sel made.err) { ret 4; }
                @client   = made.ok;
                connected = true;
            }
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    if (!connected || !accepted || !scope_ok(cancel.destroy(?scope))) { ret 5; }
    ret 0;
}

# a local readiness wait completes on data before a later read, reports end of
# stream after the peer's shutdown, and cancels through its scope (#759)
test async_local__readiness_waits_hold_no_buffer_and_settle_like_reads {
    var pa: allocator.Allocator;
    page.make(?pa);
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name:   [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    name[length - 1] = 'y';
    val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (sel endpoint_result.err) { ret 1; }
    val bound:   local.Endpoint = endpoint_result.ok;
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, ?pa, 8))) { ret 2; }
    var driver: local_async.Driver;
    if (refused(local_async.make(?driver, ?runtime))) { ret 3; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, bound, ?listener)) { ret 4; }
    var server: local_async.Stream;
    var client: local_async.Stream;
    if (readable_local_pair(?driver, ?listener, bound, ?server, ?client) != 0) { ret 5; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 6; }
    var output: [2]io_runtime.Completion;

    # data: the wait settles first, then the read gets the byte
    var input: u8 = 0;
    if (failed[io_runtime.Token](local_async.submit_readable(?driver, ?scope, ?server, 610))
        || failed[io_runtime.Token](local_async.submit_read(?driver, ?scope, ?server, ?input, 1, 611))) {
        ret 7;
    }
    var payload: u8 = 0x42;
    if (failed[io_runtime.Token](local_async.submit_write(?driver, ?scope, ?client, ?payload, 1, 612))) { ret 8; }
    var saw: [3]bool;
    saw[0] = false;
    saw[1] = false;
    saw[2] = false;
    var attempt: usize = 0;
    for (attempt < 8 && (!saw[0] || !saw[1] || !saw[2])) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 9; }
        var i: usize = 0;
        for (i < waited.ok) {
            if (output[i].has_error || output[i].context < 610 || output[i].context > 612)                                              { ret 10; }
            if (output[i].context == 610 && (output[i].kind != io_runtime.READABLE || output[i].bytes != 0 || output[i].end_of_stream)) { ret 11; }
            if (output[i].context == 611 && (!saw[0] || output[i].bytes != 1))                                                          { ret 12; }
            saw[output[i].context - 610] = true;
            i                            = i + 1;
        }
        attempt = attempt + 1;
    }
    if (!saw[0] || !saw[1] || !saw[2] || input != 0x42) { ret 13; }

    # end of stream after the peer shuts its write side
    if (failed[io_runtime.Token](local_async.submit_shutdown_write(?driver, ?scope, ?client, 613))
        || failed[io_runtime.Token](local_async.submit_readable(?driver, ?scope, ?server, 614))) {
        ret 14;
    }
    var shut:  bool = false;
    var ended: bool = false;
    attempt = 0;
    for (attempt < 8 && (!shut || !ended)) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 15; }
        var i: usize = 0;
        for (i < waited.ok) {
            if (output[i].context == 613 && !output[i].has_error)                                                                     { shut = true; }
            or (output[i].context == 614 && !output[i].has_error && output[i].kind == io_runtime.READABLE && output[i].end_of_stream) { ended = true; }
            or                                                                                                                        { ret 16; }
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    if (!shut || !ended) { ret 17; }

    # cancellation through the scope
    if (failed[io_runtime.Token](local_async.submit_readable(?driver, ?scope, ?client, 615))) { ret 18; }
    if (!scope_changed(cancel.cancel(?scope)))                                                { ret 19; }
    val cancelled: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
    if (!(sel cancelled.ok && cancelled.ok == 1)
        || output[0].context != 615 || !output[0].has_error || output[0].error.kind != io_error.CANCELLED) {
        ret 20;
    }
    if (!scope_ok(cancel.destroy(?scope))) { ret 21; }

    var close_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?close_scope, opt[time.Instant].none{}))
        || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?close_scope, ?client, lifecycle.ABORTIVE, 616))
        || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?close_scope, ?server, lifecycle.ABORTIVE, 617))
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?close_scope, ?listener, 618))) {
        ret 22;
    }
    var closed: usize = 0;
    attempt = 0;
    for (attempt < 8 && closed < 3) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 23; }
        closed  = closed + waited.ok;
        attempt = attempt + 1;
    }
    if (closed != 3 || !scope_ok(cancel.destroy(?close_scope))) { ret 24; }
    if (refused(local_async.destroy(?driver))
        || !ok_bool(io_runtime.close(?runtime))
        || !ok_err(io_runtime.destroy(?runtime))) {
        ret 25;
    }
    ret 0;
}

# the completion with context from driver, waiting a bounded number of rounds.
# any other completion fails the wait
fun await_local(driver: *local_async.Driver, context: usize, out: *io_runtime.Completion) bool {
    var output:  [1]io_runtime.Completion;
    var attempt: usize = 0;
    for (attempt < 8) {
        val waited: res[usize, io_error.Error] = local_async.wait(driver, ?output[0], 1, 1000);
        if (sel waited.err) { ret false; }
        if (waited.ok == 1) {
            if (output[0].context != context) { ret false; }
            @out = output[0];
            ret true;
        }
        attempt = attempt + 1;
    }
    ret false;
}

# exactly length bytes into buffer from stream, or false at an error, end of
# stream or timeout
fun read_exact_local(driver: *local_async.Driver, scope: *cancel.Scope, stream: *local_async.Stream, buffer: *u8, length: usize, context: usize) bool {
    var got: usize = 0;
    for (got < length) {
        if (failed[io_runtime.Token](local_async.submit_read(driver, scope, stream, ?buffer[got], length - got, context))) { ret false; }
        var done: io_runtime.Completion;
        if (!await_local(driver, context, ?done) || done.has_error || done.bytes == 0) { ret false; }
        got = got + done.bytes;
    }
    ret true;
}

fun write_all_local(driver: *local_async.Driver, scope: *cancel.Scope, stream: *local_async.Stream, buffer: *u8, length: usize, context: usize) bool {
    var sent: usize = 0;
    for (sent < length) {
        if (failed[io_runtime.Token](local_async.submit_write(driver, scope, stream, ?buffer[sent], length - sent, context))) { ret false; }
        var done: io_runtime.Completion;
        if (!await_local(driver, context, ?done) || done.has_error || done.bytes == 0) { ret false; }
        sent = sent + done.bytes;
    }
    ret true;
}

rec AdoptWorker {
    detached: local_async.Detached;
    stale:    local_async.Stream;
    result:   i32;
}

# thread 2: a driver of its own adopts the stream, refuses driver A's token,
# reads what the peer sent before and after the move, answers, and closes once
# the peer has
fun adopt_and_serve(context: *AdoptWorker) i32 {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, ?pa, 4))) { ret 1; }
    var driver: local_async.Driver;
    if (refused(local_async.make(?driver, ?runtime))) { ret 2; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 3; }
    var byte:  u8                                    = 0;
    val early: res[io_runtime.Token, io_error.Error] = local_async.submit_read(?driver, ?scope, ?context.stale, ?byte, 1, 0xb100);
    if (!(sel early.err && early.err.kind == io_error.CLOSED)) { ret 4; }
    val adopted: res[local_async.Stream, io_error.Error] = local_async.adopt(?driver, ?context.detached);
    if (sel adopted.err) { ret 5; }
    var stream: local_async.Stream = adopted.ok;
    # the detached value gave its socket up, so a second adopt is refused
    if (!failed[local_async.Stream](local_async.adopt(?driver, ?context.detached))) { ret 6; }
    val late: res[io_runtime.Token, io_error.Error] = local_async.submit_read(?driver, ?scope, ?context.stale, ?byte, 1, 0xb101);
    if (!(sel late.err && late.err.kind == io_error.CLOSED)) { ret 7; }
    var input: [4]u8;
    if (!read_exact_local(?driver, ?scope, ?stream, ?input[0], 4, 0xb102))        { ret 8; }
    if (input[0] != 'p' || input[1] != 'i' || input[2] != 'n' || input[3] != 'g') { ret 9; }
    var reply: [4]u8 = [4]u8{'p', 'o', 'n', 'g'};
    if (!write_all_local(?driver, ?scope, ?stream, ?reply[0], 4, 0xb103)) { ret 10; }
    # the peer closes once it has the reply
    if (failed[io_runtime.Token](local_async.submit_read(?driver, ?scope, ?stream, ?byte, 1, 0xb104))) { ret 11; }
    var done: io_runtime.Completion;
    if (!await_local(?driver, 0xb104, ?done) || (!done.has_error && done.bytes != 0))                                    { ret 12; }
    if (failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?scope, ?stream, lifecycle.ABORTIVE, 0xb105))) { ret 13; }
    if (!await_local(?driver, 0xb105, ?done) || done.has_error)                                                          { ret 14; }
    if (!scope_ok(cancel.destroy(?scope))
        || refused(local_async.destroy(?driver))
        || !ok_bool(io_runtime.close(?runtime))
        || !ok_err(io_runtime.destroy(?runtime))) {
        ret 15;
    }
    ret 0;
}

fun adopt_worker(arg: *u8) {
    val context: *AdoptWorker = arg::*AdoptWorker;
    context.result = adopt_and_serve(context);
}

# #891: a stream accepted on driver A in one thread is detached, adopted by
# driver B in another, and carries data both ways. a detach with an operation
# in flight is refused and changes nothing, and driver A's token is refused by
# A and by B once the stream has moved
test async_local__a_detached_stream_is_adopted_and_served_by_a_driver_on_another_thread {
    var pa: allocator.Allocator;
    page.make(?pa);
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name:   [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    name[length - 1] = 'd';
    val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (sel endpoint_result.err) { ret 1; }
    val bound:   local.Endpoint = endpoint_result.ok;
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, ?pa, 8))) { ret 2; }
    var driver: local_async.Driver;
    if (refused(local_async.make(?driver, ?runtime))) { ret 3; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, bound, ?listener)) { ret 4; }
    var server: local_async.Stream;
    var client: local_async.Stream;
    if (readable_local_pair(?driver, ?listener, bound, ?server, ?client) != 0) { ret 5; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 6; }

    # a cancelled wait whose completion the driver has not yet returned still
    # holds the stream, though the platform has let the socket go
    var held: cancel.Scope;
    if (!scope_ok(cancel.make_root(?held, opt[time.Instant].none{})))                           { ret 50; }
    if (failed[io_runtime.Token](local_async.submit_readable(?driver, ?held, ?server, 0xb006))) { ret 51; }
    if (!scope_changed(cancel.cancel(?held)))                                                   { ret 52; }
    val queued: res[local_async.Detached, io_error.Error] = local_async.detach(?driver, ?server);
    if (!(sel queued.err && queued.err.kind == io_error.BUSY) || server.generation == 0) { ret 53; }
    var cancelled: io_runtime.Completion;
    if (!await_local(?driver, 0xb006, ?cancelled) || !cancelled.has_error || cancelled.error.kind != io_error.CANCELLED) { ret 54; }
    if (!scope_ok(cancel.destroy(?held)))                                                                                { ret 55; }

    # a pending readiness wait keeps the stream in driver A
    if (failed[io_runtime.Token](local_async.submit_readable(?driver, ?scope, ?server, 0xb000))) { ret 7; }
    val busy: res[local_async.Detached, io_error.Error] = local_async.detach(?driver, ?server);
    if (!(sel busy.err && busy.err.kind == io_error.BUSY) || server.generation == 0) { ret 8; }
    var payload: [4]u8 = [4]u8{'p', 'i', 'n', 'g'};
    if (failed[io_runtime.Token](local_async.submit_write(?driver, ?scope, ?client, ?payload[0], 4, 0xb001))) { ret 9; }
    var output:  [2]io_runtime.Completion;
    var settled: usize = 0;
    var attempt: usize = 0;
    for (attempt < 8 && settled < 2) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 10; }
        var i: usize = 0;
        for (i < waited.ok) {
            if (output[i].has_error || (output[i].context != 0xb000 && output[i].context != 0xb001)) { ret 11; }
            if (output[i].context == 0xb001 && output[i].bytes != 4)                                 { ret 11; }
            settled = settled + 1;
            i       = i + 1;
        }
        attempt = attempt + 1;
    }
    if (settled != 2) { ret 12; }

    # idle now, so the stream leaves A, and every copy of its token is refused
    val stale:    local_async.Stream                        = server;
    val detached: res[local_async.Detached, io_error.Error] = local_async.detach(?driver, ?server);
    if (sel detached.err)       { ret 13; }
    if (server.generation != 0) { ret 13; }
    var byte:         u8                                    = 0;
    var copy:         local_async.Stream                    = stale;
    val refused_read: res[io_runtime.Token, io_error.Error] = local_async.submit_read(?driver, ?scope, ?copy, ?byte, 1, 0xb002);
    if (!(sel refused_read.err && refused_read.err.kind == io_error.CLOSED)) { ret 14; }
    val refused_detach: res[local_async.Detached, io_error.Error] = local_async.detach(?driver, ?copy);
    if (!(sel refused_detach.err && refused_detach.err.kind == io_error.CLOSED)) { ret 15; }

    var context: AdoptWorker      = AdoptWorker{detached: detached.ok, stale: stale, result: -1};
    var worker:  thread.Thread;
    val spawned: thread.Operation = thread.spawn_with(adopt_worker, (?context)::*u8, ?worker);
    if (sel spawned.err) { ret 16; }
    var reply:    [4]u8;
    val answered: bool = read_exact_local(?driver, ?scope, ?client, ?reply[0], 4, 0xb003);
    var closed:   bool = false;
    if (!failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?scope, ?client, lifecycle.ABORTIVE, 0xb004))) {
        var done: io_runtime.Completion;
        closed = await_local(?driver, 0xb004, ?done) && !done.has_error;
    }
    val joined: thread.Operation = thread.join(?worker);
    if (sel joined.err)                                                                        { ret 17; }
    if (context.result != 0)                                                                   { ret 20 + context.result; }
    if (!answered || reply[0] != 'p' || reply[1] != 'o' || reply[2] != 'n' || reply[3] != 'g') { ret 18; }
    if (!closed)                                                                               { ret 19; }

    var close_scope: cancel.Scope;
    var done:        io_runtime.Completion;
    if (!scope_ok(cancel.make_root(?close_scope, opt[time.Instant].none{}))
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?close_scope, ?listener, 0xb005))
        || !await_local(?driver, 0xb005, ?done) || done.has_error
        || !scope_ok(cancel.destroy(?close_scope))
        || !scope_ok(cancel.destroy(?scope))
        || refused(local_async.destroy(?driver))
        || !ok_bool(io_runtime.close(?runtime))
        || !ok_err(io_runtime.destroy(?runtime))) {
        ret 40;
    }
    ret 0;
}
