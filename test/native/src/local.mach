use std.net.local;
use local_async: std.net.async.local;
use std.system.os;
use std.chrono.time;
use std.sync.cancel;
use std.io.lifecycle;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.size.isize;
use std.types.canonical.res;
use std.types.canonical.err;
use io_error: std.io.error;
use io_runtime: std.io.runtime;


# test predicates: `sel` takes a place, so an inline call is tested through these
fun refused(r: err[io_error.Error]) bool { ret sel r.err; }
fun failed[T](r: res[T, io_error.Error]) bool { ret sel r.err; }
fun ok_err(r: err[io_error.Error]) bool { ret sel r.ok; }
fun ok_bool(r: res[bool, io_error.Error]) bool { ret sel r.ok; }
fun scope_ok(r: cancel.Operation) bool { ret sel r.ok; }
fun scope_changed(r: cancel.Transition) bool { if (sel r.ok) { ret r.ok; } ret false; }

$if ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}

test "local socket contract modules are present" {
    val capabilities: local.Capabilities = local.capabilities();
    if (!capabilities.stream || !capabilities.filesystem || $size_of(local_async.Driver) == 0) { ret 1; }
    ret 0;
}

fun saturation_endpoint_name(output: *u8) usize {
    var prefix: *u8 = "mach-std-local-saturation-";
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        prefix = "/tmp/mach-std-local-saturation-";
    }
    var length: usize = 0;
    for (prefix[length] != 0) {
        output[length] = prefix[length];
        length = length + 1;
    }
    var process: u64 = os.getpid()::u64;
    var digits: [20]u8;
    var count: usize = 0;
    if (process == 0) {
        digits[0] = '0';
        count = 1;
    }
    for (process != 0) {
        digits[count] = '0' + (process % 10)::u8;
        process = process / 10;
        count = count + 1;
    }
    var i: usize = 0;
    for (i < count) {
        output[length] = digits[count - i - 1];
        length = length + 1;
        i = i + 1;
    }
    output[length] = '.';
    output[length + 1] = 's';
    output[length + 2] = 'o';
    output[length + 3] = 'c';
    output[length + 4] = 'k';
    output[length + 5] = 0;
    ret length + 5;
}

fun managed_listen(
    driver: *local_async.Driver,
    endpoint: local.Endpoint,
    listener: *local_async.Listener,
) bool {
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret false; }
    var options: local.BindOptions = local.default_bind_options();
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        options.stale = local.REMOVE_STALE_SOCKET;
    }
    val submit_bind_result: res[io_runtime.Token, io_error.Error] = local_async.submit_bind(driver, ?scope, endpoint, options, 0xff00);
    if (sel submit_bind_result.err) { ret false; }
    var output: [2]io_runtime.Completion;
    var waited: res[usize, io_error.Error] = local_async.wait(driver, ?output[0], 2, 1000);
    if (!(sel waited.ok && waited.ok == 1)) { ret false; }
    val bound: res[local_async.Listener, io_error.Error] = local_async.bound_listener(driver, output[0]);
    if (sel bound.err) { ret false; }
    @listener = bound.ok;
    val submit_listen_result: res[io_runtime.Token, io_error.Error] = local_async.submit_listen(driver, ?scope, listener, 128, 0xff01);
    if (sel submit_listen_result.err) { ret false; }
    waited = local_async.wait(driver, ?output[0], 2, 1000);
    if (!(sel waited.ok && waited.ok == 1)
        || refused(local_async.listening(driver, output[0]))) {
        ret false;
    }
    ret scope_ok(cancel.destroy(?scope));
}

fun endpoint_absent(value: local.Endpoint) bool {
    var path: [108]u8;
    var i: usize = 0;
    for (i < value.length) { path[i] = value.name[i]; i = i + 1; }
    path[value.length] = 0;
    var status: os.stat_t;
    ret os.stat_path(os.AT_FDCWD, ?path[0], ?status, os.AT_SYMLINK_NOFOLLOW) == os.ENOENT;
}

test "async local stale listener token is rejected after driver recreation" {
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name: [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    name[length - 1] = 'a';
    val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (sel endpoint_result.err) { ret 1; }
    val endpoint: local.Endpoint = endpoint_result.ok;
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 4))) { ret 2; }
    var driver: local_async.Driver;
    val make_result: err[io_error.Error] = local_async.make(?driver, ?runtime);
    if (sel make_result.err) { ret 3; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, endpoint, ?listener)) { ret 4; }
    val stale: local_async.Listener = listener;
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?scope, ?listener, 0xaa01))) {
        ret 5;
    }
    var output: [4]io_runtime.Completion;
    var waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 4, 1000);
    if (!(sel waited.ok && waited.ok == 1)
        || output[0].has_error
        || !scope_ok(cancel.destroy(?scope))
        || refused(local_async.destroy(?driver))
        || !ok_bool(io_runtime.close(?runtime))
        || !ok_err(io_runtime.destroy(?runtime))) {
        ret 6;
    }

    if (!ok_err(io_runtime.make(?runtime, 4))) { ret 7; }
    val make_result2: err[io_error.Error] = local_async.make(?driver, ?runtime);
    if (sel make_result2.err) { ret 8; }
    if (!managed_listen(?driver, endpoint, ?listener)) { ret 9; }
    if (!scope_ok(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 10; }
    val rejected: res[io_runtime.Token, io_error.Error] = local_async.submit_accept(?driver, ?scope, ?stale, 0xaa02);
    if (!(sel rejected.err && rejected.err.code == os.EBADF)
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?scope, ?listener, 0xaa03))) {
        ret 11;
    }
    waited = local_async.wait(?driver, ?output[0], 4, 1000);
    if (!(sel waited.ok && waited.ok == 1)
        || output[0].has_error
        || !scope_ok(cancel.destroy(?scope))
        || refused(local_async.destroy(?driver))
        || !ok_bool(io_runtime.close(?runtime))
        || !ok_err(io_runtime.destroy(?runtime))
        || !endpoint_absent(endpoint)) {
        ret 12;
    }
    ret 0;
}

test "async local saturation settles every operation once" {
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name: [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (sel endpoint_result.err) { ret 1; }
    val bound: local.Endpoint = endpoint_result.ok;
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 2))) { ret 3; }
    var driver: local_async.Driver;
    val make_result: err[io_error.Error] = local_async.make(?driver, ?runtime);
    if (sel make_result.err) { ret 4; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, bound, ?listener)) { ret 2; }
    var connection_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?connection_scope, false, time.Time{sec: 0, nsec: 0}))
        || failed[io_runtime.Token](local_async.submit_accept(?driver, ?connection_scope, ?listener, 197))
        || failed[io_runtime.Token](local_async.submit_connect(?driver, ?connection_scope, bound, 198))) {
        ret 5;
    }
    var output: [2]io_runtime.Completion;
    var client: local_async.Stream;
    var server: local_async.Stream;
    var connected: bool = false;
    var accepted: bool = false;
    var attempt: usize = 0;
    for (attempt < 8 && (!connected || !accepted)) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 6; }
        val count: usize = waited.ok;
        var i: usize = 0;
        for (i < count) {
            if (output[i].context == 197) {
                val made: res[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                if (sel made.err) { ret 7; }
                server = made.ok;
                accepted = true;
            } or (output[i].context == 198) {
                val made: res[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                if (sel made.err) { ret 8; }
                client = made.ok;
                connected = true;
            } or {
                ret 9;
            }
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    if (!connected || !accepted || !scope_ok(cancel.destroy(?connection_scope))) { ret 10; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 11; }
    var client_input: u8 = 0xa5;
    var server_input: u8 = 0x5a;
    var extra: u8 = 0xff;
    if (failed[io_runtime.Token](local_async.submit_read(?driver, ?scope, ?client, ?client_input, 1, 201))
        || failed[io_runtime.Token](local_async.submit_read(?driver, ?scope, ?server, ?server_input, 1, 202))) {
        ret 12;
    }
    val submit_write_result: res[io_runtime.Token, io_error.Error] = local_async.submit_write(?driver, ?scope, ?client, ?extra, 1, 203);
    if (sel submit_write_result.ok) { ret 13; }
    if (!scope_changed(cancel.cancel(?scope))) { ret 14; }
    var settled: usize = 0;
    attempt = 0;
    for (attempt < 8 && settled < 2) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 15; }
        val count: usize = waited.ok;
        var i: usize = 0;
        for (i < count) {
            if (!output[i].has_error || output[i].error.kind != io_error.CANCELLED
                || output[i].context < 201 || output[i].context > 202) {
                ret 16;
            }
            settled = settled + 1;
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    if (settled != 2 || client_input != 0xa5 || server_input != 0x5a || !scope_ok(cancel.destroy(?scope))) { ret 17; }
    val duplicate: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 0);
    if (!(sel duplicate.ok && duplicate.ok == 0)) { ret 18; }

    var close_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?close_scope, false, time.Time{sec: 0, nsec: 0}))
        || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?close_scope, ?client, lifecycle.ABORTIVE, 204))
        || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?close_scope, ?server, lifecycle.ABORTIVE, 205))) {
        ret 15;
    }
    settled = 0;
    attempt = 0;
    for (attempt < 8 && settled < 2) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
        if (sel waited.err) { ret 16; }
        val count: usize = waited.ok;
        var i: usize = 0;
        for (i < count) {
            if (output[i].has_error || output[i].kind != io_runtime.CLOSE
                || output[i].context < 204 || output[i].context > 205) {
                ret 17;
            }
            settled = settled + 1;
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    if (settled != 2
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?close_scope, ?listener, 206))) {
        ret 18;
    }
    val listener_closed: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 2, 1000);
    if (!(sel listener_closed.ok && listener_closed.ok == 1)
        || output[0].context != 206
        || output[0].has_error
        || !scope_ok(cancel.destroy(?close_scope))) {
        ret 19;
    }
    val destroy_result: err[io_error.Error] = local_async.destroy(?driver);
    if (sel destroy_result.err) { ret 20; }
    if (!ok_bool(io_runtime.close(?runtime))) { ret 21; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 22; }
    ret 0;
}

test "async local runtime close settles every operation exactly once" {
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var name: [108]u8;
    val length: usize = saturation_endpoint_name(?name[0]);
    name[length - 1] = 'r';
    val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (sel endpoint_result.err) { ret 1; }
    val endpoint: local.Endpoint = endpoint_result.ok;
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 16))) { ret 2; }
    var driver: local_async.Driver;
    val make_result: err[io_error.Error] = local_async.make(?driver, ?runtime);
    if (sel make_result.err) { ret 3; }
    var listener: local_async.Listener;
    if (!managed_listen(?driver, endpoint, ?listener)) { ret 4; }

    var setup_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?setup_scope, false, time.Time{sec: 0, nsec: 0}))
        || failed[io_runtime.Token](local_async.submit_accept(?driver, ?setup_scope, ?listener, 490))
        || failed[io_runtime.Token](local_async.submit_connect(?driver, ?setup_scope, endpoint, 491))) {
        ret 5;
    }
    var output: [16]io_runtime.Completion;
    var server: local_async.Stream;
    var client: local_async.Stream;
    var made_server: bool = false;
    var made_client: bool = false;
    var rounds: usize = 0;
    for (rounds < 16 && (!made_server || !made_client)) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
        if (sel waited.err) { ret 6; }
        val count: usize = waited.ok;
        var i: usize = 0;
        for (i < count) {
            if (output[i].context == 490) {
                val accepted: res[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                if (sel accepted.err) { ret 7; }
                server = accepted.ok;
                made_server = true;
            } or (output[i].context == 491) {
                val connected: res[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                if (sel connected.err) { ret 8; }
                client = connected.ok;
                made_client = true;
            }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if (!made_server || !made_client || !scope_ok(cancel.destroy(?setup_scope))) { ret 9; }

    var race_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?race_scope, false, time.Time{sec: 0, nsec: 0}))) { ret 10; }
    var input: u8 = 0xa5;
    var byte: u8 = 0x5a;
    if (failed[io_runtime.Token](local_async.submit_accept(?driver, ?race_scope, ?listener, 501))
        || failed[io_runtime.Token](local_async.submit_connect(?driver, ?race_scope, endpoint, 502))
        || failed[io_runtime.Token](local_async.submit_read(?driver, ?race_scope, ?server, ?input, 1, 503))
        || failed[io_runtime.Token](local_async.submit_write(?driver, ?race_scope, ?client, ?byte, 1, 504))
        || failed[io_runtime.Token](local_async.submit_shutdown_write(?driver, ?race_scope, ?server, 505))
        || failed[io_runtime.Token](local_async.submit_stream_close(?driver, ?race_scope, ?client, lifecycle.ABORTIVE, 506))
        || failed[io_runtime.Token](local_async.submit_listener_close(?driver, ?race_scope, ?listener, 507))) {
        ret 11;
    }
    if (!ok_bool(io_runtime.close(?runtime))) { ret 12; }
    var seen: [7]bool;
    var settled: usize = 0;
    rounds = 0;
    for (rounds < 32 && settled < 7) {
        val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
        if (sel waited.err) { ret 13; }
        val count: usize = waited.ok;
        var i: usize = 0;
        for (i < count) {
            if (output[i].context < 501 || output[i].context > 507) { ret 14; }
            val index: usize = output[i].context - 501;
            if (seen[index]) { ret 15; }
            seen[index] = true;
            settled = settled + 1;
            if (!output[i].has_error && output[i].context == 501) {
                val accepted: res[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                if (sel accepted.err) { ret 16; }
            }
            if (!output[i].has_error && output[i].context == 502) {
                val connected: res[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                if (sel connected.err) { ret 17; }
            }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if (settled != 7 || !scope_ok(cancel.destroy(?race_scope))) { ret 18; }
    val duplicate: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 0);
    if (!(sel duplicate.ok && duplicate.ok == 0)) { ret 19; }
    if (refused(local_async.destroy(?driver)) || !endpoint_absent(endpoint)) { ret 20; }
    if (io_runtime.snapshot(?runtime).state != lifecycle.CLOSED || !ok_err(io_runtime.destroy(?runtime))) { ret 21; }
    ret 0;
}

$if ($mach.build.os == $mach.os.windows) {
    #[library("kernel32.dll")]
    ext fun GetCurrentProcess() isize;
    #[library("kernel32.dll")]
    ext fun GetProcessHandleCount(process: isize, count: *u32) i32;

    fun endpoint_name(output: *u8) usize {
        val prefix: *u8 = "mach-std-async-local-502-";
        var length: usize = 0;
        for (prefix[length] != 0) {
            output[length] = prefix[length];
            length = length + 1;
        }
        var process: u64 = os.getpid()::u64;
        var digits: [20]u8;
        var count: usize = 0;
        if (process == 0) {
            digits[0] = '0';
            count = 1;
        }
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process = process / 10;
            count = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            output[length] = digits[count - i - 1];
            length = length + 1;
            i = i + 1;
        }
        output[length] = '.';
        output[length + 1] = 's';
        output[length + 2] = 'o';
        output[length + 3] = 'c';
        output[length + 4] = 'k';
        output[length + 5] = 0;
        ret length + 5;
    }

    fun handle_count(count: *u32) bool {
        ret count != nil && GetProcessHandleCount(GetCurrentProcess(), count) != 0;
    }

    fun wait_one(driver: *local_async.Driver, context: usize, completion: *io_runtime.Completion) bool {
        var output: [16]io_runtime.Completion;
        var attempt: usize = 0;
        for (attempt < 16) {
            val waited: res[usize, io_error.Error] = local_async.wait(driver, ?output[0], 16, 1000);
            if (sel waited.err) { ret false; }
            val count: usize = waited.ok;
            var i: usize = 0;
            for (i < count) {
                if (output[i].context == context) {
                    @completion = output[i];
                    ret true;
                }
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        ret false;
    }

    test "async local windows: iocp lifecycle cancellation and ownership" {
        if (windows.running_under_wine()) { ret 0; }
        var name: [108]u8;
        val length: usize = endpoint_name(?name[0]);
        val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
        if (sel endpoint_result.err) { ret 1; }
        val bound: local.Endpoint = endpoint_result.ok;
        var runtime: io_runtime.Runtime;
        if (!ok_err(io_runtime.make(?runtime, 16))) { ret 2; }
        var driver: local_async.Driver;
        val make_result: err[io_error.Error] = local_async.make(?driver, ?runtime);
        if (sel make_result.err) { ret 3; }
        var listener: local_async.Listener;
        if (!managed_listen(?driver, bound, ?listener)) { ret 4; }

        var connection_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?connection_scope, false, time.Time{sec: 0, nsec: 0}))) { ret 5; }
        if (failed[io_runtime.Token](local_async.submit_accept(?driver, ?connection_scope, ?listener, 101))
            || failed[io_runtime.Token](local_async.submit_connect(?driver, ?connection_scope, bound, 102))) {
            ret 6;
        }
        var server: local_async.Stream;
        var client: local_async.Stream;
        var saw_accept: bool = false;
        var saw_connect: bool = false;
        var output: [16]io_runtime.Completion;
        var attempt: usize = 0;
        for (attempt < 16 && (!saw_accept || !saw_connect)) {
            val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (sel waited.err) { ret 7; }
            val count: usize = waited.ok;
            var i: usize = 0;
            for (i < count) {
                if (output[i].context == 101) {
                    val accepted: res[local_async.Stream, io_error.Error] = local_async.accepted(?driver, output[i]);
                    if (sel accepted.err) { ret 8; }
                    server = accepted.ok;
                    saw_accept = true;
                } or (output[i].context == 102) {
                    val connected: res[local_async.Stream, io_error.Error] = local_async.connected(?driver, output[i]);
                    if (sel connected.err) { ret 9; }
                    client = connected.ok;
                    saw_connect = true;
                }
                i = i + 1;
            }
            attempt = attempt + 1;
        }
        if (!saw_accept || !saw_connect || !scope_ok(cancel.destroy(?connection_scope))) { ret 10; }
        val identity: res[local.PeerIdentity, io_error.Error] = local_async.peer_identity(?driver, ?server);
        if (sel identity.ok) { ret 11; }
        if (identity.err.code != os.ENOTSUP) { ret 11; }

        var transfer_scope: cancel.Scope;
        if (!scope_ok(cancel.make_root(?transfer_scope, false, time.Time{sec: 0, nsec: 0}))) { ret 12; }
        var first_input: u8 = 0;
        var second_input: u8 = 0;
        var first_output: u8 = 'a';
        var second_output: u8 = 'b';
        if (failed[io_runtime.Token](local_async.submit_read(?driver, ?transfer_scope, ?server, ?first_input, 1, 103))
            || failed[io_runtime.Token](local_async.submit_read(?driver, ?transfer_scope, ?server, ?second_input, 1, 104))
            || failed[io_runtime.Token](local_async.submit_write(?driver, ?transfer_scope, ?client, ?first_output, 1, 105))
            || failed[io_runtime.Token](local_async.submit_write(?driver, ?transfer_scope, ?client, ?second_output, 1, 106))) {
            ret 13;
        }
        var completed: usize = 0;
        attempt = 0;
        for (attempt < 16 && completed < 4) {
            val waited: res[usize, io_error.Error] = local_async.wait(?driver, ?output[0], 16, 1000);
            if (sel waited.err) { ret 14; }
            val count: usize = waited.ok;
            var i: usize = 0;
            for (i < count) {
                if (output[i].has_error || output[i].bytes != 1
                    || output[i].context < 103 || output[i].context > 106) {
                    ret 15;
                }
