# relative-target directory symlink probe (#454)
#
# builds a tree in the cwd, links a directory through a relative, `/`-separated
# target, and then reads a file *through* the link. reading through is the whole
# point: `fs.symlink` reports success on windows even when the link it produced
# cannot be traversed, so a probe that only creates the link passes on the bug.
#
# exit codes are decoded by verify.sh.
use std.runtime;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;
use std.types.path.Path;

use std.types.canonical.res;
use std.types.canonical.err;
use io_error: std.io.error;

# sel takes a place, so the yes/no of a call passes through one of these
fun refused(r: err[io_error.Error]) bool { ret sel r.err; }
fun refused_fs(r: err[fs.FsError]) bool { ret sel r.err; }
fun answered(r: res[bool, io_error.Error]) bool { ret sel r.ok && r.ok; }

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (refused(fs.create_dir("probe", 0o755)))       { ret 10; }
    if (refused(fs.create_dir("probe/inner", 0o755))) { ret 11; }
    if (refused(fs.create_dir("probe/sub", 0o755)))   { ret 12; }
    if (refused_fs(fs.write_bytes("probe/inner/data.txt", "linked", 6, 0o644))) { ret 13; }

    val a: i64 = probe("../inner", "probe/sub/link_a", "probe/sub/link_a/data.txt", 20);
    if (a != 0) { ret a; }

    # the spelling a path dependency actually produces, with a `.` component
    val b: i64 = probe(".././inner", "probe/sub/link_b", "probe/sub/link_b/data.txt", 30);
    if (b != 0) { ret b; }

    ret 0;
}

# create the link and traverse it. returns 0, or base+n naming the failed step.
fun probe(target: Path, link: Path, through: Path, base: i64) i64 {
    if (refused(fs.symlink(target, link))) { ret base; }
    if (!answered(fs.is_symlink(link)))           { ret base + 1; }
    if (!answered(fs.is_dir(link)))               { ret base + 2; }

    val ro: res[fs.File, io_error.Error] = fs.open(through);
    if (sel ro.err)                               { ret base + 3; }
    var f: fs.File = ro.ok;

    var buf: [8]u8;
    val rd: res[usize, io_error.Error] = fs.read(f, ?buf[0], 6);
    fs.close(?f);
    if (sel rd.err)                               { ret base + 4; }
    if (rd.ok != 6)                               { ret base + 5; }
    if (buf[0] != 'l'::u8 || buf[5] != 'd'::u8)   { ret base + 6; }
    ret 0;
}
