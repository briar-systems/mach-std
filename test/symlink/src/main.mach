# relative-target directory symlink probe (#454)
#
# builds a tree in the cwd, links a directory through a relative, `/`-separated
# target, and then reads a file *through* the link. reading through is the whole
# point: `fs.symlink` reports success on windows even when the link it produced
# cannot be traversed, so a probe that only creates the link passes on the bug.
#
# exit codes are decoded by verify.sh.
use std.runtime;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;
use std.types.path.Path;

use R: std.types.result;
use O: std.types.option;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (O.is_some[str](fs.create_dir("probe", 0o755)))       { ret 10; }
    if (O.is_some[str](fs.create_dir("probe/inner", 0o755))) { ret 11; }
    if (O.is_some[str](fs.create_dir("probe/sub", 0o755)))   { ret 12; }
    if (O.is_some[str](fs.write_bytes("probe/inner/data.txt", "linked", 6, 0o644))) { ret 13; }

    val a: i64 = probe("../inner", "probe/sub/link_a", "probe/sub/link_a/data.txt", 20);
    if (a != 0) { ret a; }

    # the spelling a path dependency actually produces, with a `.` component
    val b: i64 = probe(".././inner", "probe/sub/link_b", "probe/sub/link_b/data.txt", 30);
    if (b != 0) { ret b; }

    ret 0;
}

# create the link and traverse it. returns 0, or base+n naming the failed step.
fun probe(target: Path, link: Path, through: Path, base: i64) i64 {
    if (O.is_some[str](fs.symlink(target, link))) { ret base; }
    if (!fs.is_symlink(link))                     { ret base + 1; }
    if (!fs.is_dir(link))                         { ret base + 2; }

    val ro: R.Result[fs.File, str] = fs.open(through);
    if (R.is_err[fs.File, str](ro))               { ret base + 3; }
    val f: fs.File = R.unwrap_ok[fs.File, str](ro);

    var buf: [8]u8;
    val rd: R.Result[usize, str] = fs.read(f, ?buf[0], 6);
    fs.close(f);
    if (R.is_err[usize, str](rd))                 { ret base + 4; }
    if (R.unwrap_ok[usize, str](rd) != 6)         { ret base + 5; }
    if (buf[0] != 'l'::u8 || buf[5] != 'd'::u8)   { ret base + 6; }
    ret 0;
}
