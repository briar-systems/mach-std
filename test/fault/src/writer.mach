# deterministic writer adapter

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.size.usize;
use std.types.string.str;
use std.system.os;
use std.io.writer;
use std.io.writer.WriteError;
use io_error: std.io.error;
use std.memory;
use fault.script;

pub val BYTES: u8 = 1;
pub val ZERO:  u8 = 2;
pub val ERROR: u8 = 3;

# a scripted failure is EIO, an exhausted script or full capture ENOSPC, a
# malformed script EINVAL
pub val SCRIPTED_WRITE_CODE:   i64 = os.EIO;
pub val SCRIPT_EXHAUSTED_CODE: i64 = os.ENOSPC;
pub val CAPTURE_FULL_CODE:     i64 = os.ENOSPC;
pub val INVALID_STEP_CODE:     i64 = os.EINVAL;

pub rec ScriptedWriter {
    capture:  *u8;
    cap:      usize;
    len:      usize;
    steps:    *script.Step;
    step_len: usize;
    step_pos: usize;
    calls:    usize;
}

pub fun make(s: *ScriptedWriter, capture: *u8, cap: usize, replay: *script.Script) writer.Writer {
    s.capture = capture;
    s.cap = cap;
    s.len = 0;
    s.steps = replay.steps;
    s.step_len = replay.len;
    s.step_pos = 0;
    s.calls = 0;
    ret writer.Writer{ctx: s::ptr, f_write: write};
}

fun failure(code: i64) res[usize, WriteError] {
    ret res[usize, WriteError].err{writer.native_failure(0, io_error.from_code(code, io_error.OP_WRITE))};
}

# each callback consumes exactly one scripted operation; a ZERO step accepts
# nothing and the writer classifies it as a stall
fun write(ctx: ptr, src: *u8, len: usize) res[usize, WriteError] {
    val s: *ScriptedWriter = ctx::*ScriptedWriter;
    s.calls = s.calls + 1;
    if (s.step_pos >= s.step_len) { ret failure(SCRIPT_EXHAUSTED_CODE); }

    val step: script.Step = s.steps[s.step_pos];
    s.step_pos = s.step_pos + 1;
    if (step.kind == ZERO) { ret res[usize, WriteError].ok{0}; }
    if (step.kind == ERROR) { ret failure(SCRIPTED_WRITE_CODE); }
    if (step.kind != BYTES) { ret failure(INVALID_STEP_CODE); }

    var amount: usize = step.value0::usize;
    if (step.value0 != amount::u64) { ret failure(INVALID_STEP_CODE); }
    if (amount > len) { amount = len; }
    if (amount > s.cap - s.len) { ret failure(CAPTURE_FULL_CODE); }
    if (amount > 0) {
        memory.copy[u8](?s.capture[s.len], src, amount);
        s.len = s.len + amount;
    }
    ret res[usize, WriteError].ok{amount};
}

test "fault writer: short writes preserve the exact byte sequence" {
    var steps: [3]script.Step;
    steps[0] = script.Step{kind: BYTES, flags: 0, value0: 1, value1: 0, value2: 0, value3: 0, value4: 0};
    steps[1] = script.Step{kind: BYTES, flags: 0, value0: 2, value1: 0, value2: 0, value3: 0, value4: 0};
    steps[2] = script.Step{kind: BYTES, flags: 0, value0: 3, value1: 0, value2: 0, value3: 0, value4: 0};
    var replay: script.Script = script.Script{seed: 8, steps: ?steps[0], len: 3};
    var state: ScriptedWriter;
    var capture: [6]u8;
    var w: writer.Writer = make(?state, ?capture[0], 6, ?replay);
    val all: err[WriteError] = writer.write_all(?w, "abcdef", 6);
    if (sel all.err) { ret 1; }
    if (state.calls != 3 || state.len != 6) { ret 1; }
    if (capture[0] != 'a'::u8 || capture[1] != 'b'::u8 || capture[5] != 'f'::u8) { ret 1; }
    ret 0;
}

test "fault writer: zero and error outcomes stay distinct" {
    var steps: [2]script.Step;
    steps[0] = script.Step{kind: ZERO, flags: 0, value0: 0, value1: 0, value2: 0, value3: 0, value4: 0};
    steps[1] = script.Step{kind: ERROR, flags: 0, value0: 0, value1: 0, value2: 0, value3: 0, value4: 0};
    var replay: script.Script = script.Script{seed: 0, steps: ?steps[0], len: 2};
    var state: ScriptedWriter;
    var capture: [4]u8;
    var w: writer.Writer = make(?state, ?capture[0], 4, ?replay);
    val stalled: res[usize, WriteError] = writer.write(?w, "x", 1);
    if (!sel stalled.err) { ret 1; }
    if (!sel stalled.err.stalled) { ret 1; }
    if (stalled.err.stalled != 0) { ret 1; }
    val failed: res[usize, WriteError] = writer.write(?w, "x", 1);
    if (!sel failed.err) { ret 1; }
    if (!sel failed.err.native) { ret 1; }
    if (failed.err.native.written != 0 || failed.err.native.error.code != SCRIPTED_WRITE_CODE) { ret 1; }
    ret 0;
}
