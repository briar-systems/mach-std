# deterministic reader adapter

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.size.usize;
use std.types.string.str;
use std.system.os;
use std.io.reader;
use std.io.reader.ReadError;
use io_error: std.io.error;
use std.memory;
use fault.script;

pub val BYTES: u8 = 1;
pub val EOF:   u8 = 2;
pub val ERROR: u8 = 3;

# a scripted failure is EIO; a malformed script is EINVAL
pub val SCRIPTED_READ_CODE: i64 = os.EIO;
pub val INVALID_STEP_CODE:  i64 = os.EINVAL;

pub rec ScriptedReader {
    data:     *u8;
    len:      usize;
    pos:      usize;
    steps:    *script.Step;
    step_len: usize;
    step_pos: usize;
    calls:    usize;
}

pub fun make(s: *ScriptedReader, data: *u8, len: usize, replay: *script.Script) reader.Reader {
    s.data = data;
    s.len = len;
    s.pos = 0;
    s.steps = replay.steps;
    s.step_len = replay.len;
    s.step_pos = 0;
    s.calls = 0;
    ret reader.Reader{ctx: s::ptr, f_read: read};
}

fun failure(code: i64) res[usize, ReadError] {
    ret res[usize, ReadError].err{reader.native_failure(0, io_error.from_code(code, io_error.OP_READ))};
}

# each callback consumes exactly one scripted operation; the end of the
# stream is zero bytes and the reader classifies it
fun read(ctx: ptr, dst: *u8, len: usize) res[usize, ReadError] {
    val s: *ScriptedReader = ctx::*ScriptedReader;
    s.calls = s.calls + 1;
    if (s.step_pos >= s.step_len) { ret res[usize, ReadError].ok{0}; }

    val step: script.Step = s.steps[s.step_pos];
    s.step_pos = s.step_pos + 1;
    if (step.kind == EOF) { ret res[usize, ReadError].ok{0}; }
    if (step.kind == ERROR) { ret failure(SCRIPTED_READ_CODE); }
    if (step.kind != BYTES) { ret failure(INVALID_STEP_CODE); }

    var amount: usize = step.value0::usize;
    if (step.value0 != amount::u64) { ret failure(INVALID_STEP_CODE); }
    if (amount > len) { amount = len; }
    if (amount > s.len - s.pos) { amount = s.len - s.pos; }
    if (amount > 0) {
        memory.copy[u8](dst, ?s.data[s.pos], amount);
        s.pos = s.pos + amount;
    }
    ret res[usize, ReadError].ok{amount};
}

test "fault reader: fragmentation and eof follow the saved script" {
    var steps: [4]script.Step;
    steps[0] = script.Step{kind: BYTES, flags: 0, value0: 1, value1: 0, value2: 0, value3: 0, value4: 0};
    steps[1] = script.Step{kind: BYTES, flags: 0, value0: 2, value1: 0, value2: 0, value3: 0, value4: 0};
    steps[2] = script.Step{kind: BYTES, flags: 0, value0: 3, value1: 0, value2: 0, value3: 0, value4: 0};
    steps[3] = script.Step{kind: EOF, flags: 0, value0: 0, value1: 0, value2: 0, value3: 0, value4: 0};
    var replay: script.Script = script.Script{seed: 7, steps: ?steps[0], len: 4};
    var state: ScriptedReader;
    var source: [6]u8;
    source[0] = 'a'::u8; source[1] = 'b'::u8; source[2] = 'c'::u8;
    source[3] = 'd'::u8; source[4] = 'e'::u8; source[5] = 'f'::u8;
    var r: reader.Reader = make(?state, ?source[0], 6, ?replay);
    var dst: [6]u8;
    val exact: err[ReadError] = reader.read_exact(?r, ?dst[0], 6);
    if (sel exact.err) { ret 1; }
    if (state.calls != 3 || state.pos != 6 || dst[0] != 'a'::u8 || dst[5] != 'f'::u8) { ret 1; }
    val eof: res[usize, ReadError] = reader.read(?r, ?dst[0], 6);
    if (!sel eof.err) { ret 1; }
    if (!sel eof.err.eof) { ret 1; }
    if (eof.err.eof != 0) { ret 1; }
    ret 0;
}

test "fault reader: selected failure is normalized" {
    var steps: [2]script.Step;
    steps[0] = script.Step{kind: BYTES, flags: 0, value0: 2, value1: 0, value2: 0, value3: 0, value4: 0};
    steps[1] = script.Step{kind: ERROR, flags: 0, value0: 0, value1: 0, value2: 0, value3: 0, value4: 0};
    var replay: script.Script = script.Script{seed: 0, steps: ?steps[0], len: 2};
    var state: ScriptedReader;
    var source: [4]u8;
    var r: reader.Reader = make(?state, ?source[0], 4, ?replay);
    var dst: [4]u8;
    val first: res[usize, ReadError] = reader.read(?r, ?dst[0], 4);
    if (!sel first.ok) { ret 1; }
    if (first.ok != 2) { ret 1; }
    val failed: res[usize, ReadError] = reader.read(?r, ?dst[0], 2);
    if (!sel failed.err) { ret 1; }
    if (!sel failed.err.native) { ret 1; }
    if (failed.err.native.delivered != 0 || failed.err.native.error.code != SCRIPTED_READ_CODE) { ret 1; }
    ret 0;
}
