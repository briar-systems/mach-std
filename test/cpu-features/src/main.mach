# prints the extensions std.system.cpu.features() reports, then the OS's own
# answer through os.cpu_features, one line each, for test/cpu-features/verify.sh

use std.print;
use std.runtime;
use std.system.cpu;
use isa: std.system.cpu.features;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;

fun bit(b: bool) i64 {
    if (b) { ret 1; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val have: isa.Features = cpu.features();
    $if ($mach.build.arch == $mach.arch.x86_64) {
        var probed: isa.Features = isa.Features{sha: false, ssse3: false, sse41: false, aes: false, pclmul: false};
        # a feature the processor lacks reads false, never an error
        if (os.cpu_features(?probed) < 0) { ret 10; }
        print.printlnf("features aes={} pclmul={} sha={}", bit(have.aes), bit(have.pclmul), bit(have.sha));
        print.printlnf("probed aes={} pclmul={} sha={}", bit(probed.aes), bit(probed.pclmul), bit(probed.sha));
    }
    $or {
        var probed: isa.Features = isa.Features{sha2: false, aes: false, pmull: false};
        if (os.cpu_features(?probed) < 0) { ret 10; }
        print.printlnf("features aes={} pmull={} sha2={}", bit(have.aes), bit(have.pmull), bit(have.sha2));
        print.printlnf("probed aes={} pmull={} sha2={}", bit(probed.aes), bit(probed.pmull), bit(probed.sha2));
    }
    ret 0;
}
