# test predicates: `sel` takes a place, so an inline call is tested through these
fun refused(r: err[io_error.Error]) bool { ret sel r.err; }

use std.net.local;
use local_async: std.net.async.local;
use std.io.lifecycle;
use std.runtime;
use std.system.os;
use std.types.bool.bool;
use std.types.size.usize;
use std.types.canonical.res;
use std.types.canonical.err;
use io_error: std.io.error;

fun endpoint_name(output: *u8) usize {
    val prefix: *u8 = "mach-std-local-502-";
    var length: usize = 0;
    for (prefix[length] != 0) {
        output[length] = prefix[length];
        length = length + 1;
    }
    var process: u64 = os.getpid()::u64;
    var digits: [20]u8;
    var count: usize = 0;
    for (process != 0) {
        digits[count] = '0' + (process % 10)::u8;
        process = process / 10;
        count = count + 1;
    }
    var i: usize = 0;
    for (i < count) {
        output[length] = digits[count - i - 1];
        length = length + 1;
        i = i + 1;
    }
    output[length] = '.';
    output[length + 1] = 's';
    output[length + 2] = 'o';
    output[length + 3] = 'c';
    output[length + 4] = 'k';
    output[length + 5] = 0;
    ret length + 5;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val capabilities: local.Capabilities = local.capabilities();
    if (!capabilities.stream) { ret 1; }
    var name: [108]u8;
    val length: usize = endpoint_name(?name[0]);
    val endpoint_result: res[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (sel endpoint_result.err) { ret 2; }
    val endpoint: local.Endpoint = endpoint_result.ok;
    val listener_result: res[local.Listener, io_error.Error] = local.listen(endpoint, local.default_listen_options());
    if (sel listener_result.err) {
        val failure: io_error.Error = listener_result.err;
        ret -failure.code;
    }
    var listener: local.Listener = listener_result.ok;
    val client_result: res[local.Stream, io_error.Error] = local.connect(endpoint);
    if (sel client_result.err) { ret 4; }
    var client: local.Stream = client_result.ok;
    val server_result: res[local.Stream, io_error.Error] = local.accept(?listener);
    if (sel server_result.err) { ret 5; }
    var server: local.Stream = server_result.ok;
    var byte: u8 = 0x5a;
    val sent: res[usize, io_error.Error] = local.stream_write(?client, ?byte, 1);
    if (!(sel sent.ok && sent.ok == 1)) { ret 6; }
    byte = 0;
    val received: res[usize, io_error.Error] = local.stream_read(?server, ?byte, 1);
    if (!(sel received.ok && received.ok == 1) || byte != 0x5a) { ret 7; }
    val stream_shutdown_write_result: err[io_error.Error] = local.stream_shutdown_write(?client);
    if (sel stream_shutdown_write_result.err) { ret 8; }
    val ended: res[usize, io_error.Error] = local.stream_read(?server, ?byte, 1);
    if (!(sel ended.ok && ended.ok == 0)) { ret 9; }
    val stream_close_result: err[io_error.Error] = local.stream_close(?client, lifecycle.ABORTIVE);
    if (sel stream_close_result.err) { ret 10; }
    val stream_close_result2: err[io_error.Error] = local.stream_close(?server, lifecycle.ABORTIVE);
    if (sel stream_close_result2.err) { ret 11; }
    val listener_close_result: err[io_error.Error] = local.listener_close(?listener);
    if (sel listener_close_result.err) { ret 12; }
    ret 0;
}
