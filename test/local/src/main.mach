use std.net.local;
use std.runtime;
use std.system.os;
use std.types.bool.bool;
use std.types.size.usize;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use io_error: std.io.error;

fun endpoint_name(output: *u8) usize {
    val prefix: *u8 = "mach-std-local-502-";
    var length: usize = 0;
    for (prefix[length] != 0) {
        output[length] = prefix[length];
        length = length + 1;
    }
    var process: u64 = os.getpid()::u64;
    var digits: [20]u8;
    var count: usize = 0;
    for (process != 0) {
        digits[count] = '0' + (process % 10)::u8;
        process = process / 10;
        count = count + 1;
    }
    var i: usize = 0;
    for (i < count) {
        output[length] = digits[count - i - 1];
        length = length + 1;
        i = i + 1;
    }
    output[length] = '.';
    output[length + 1] = 's';
    output[length + 2] = 'o';
    output[length + 3] = 'c';
    output[length + 4] = 'k';
    output[length + 5] = 0;
    ret length + 5;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val capabilities: local.Capabilities = local.capabilities();
    if (!capabilities.stream) { ret 1; }
    var name: [108]u8;
    val length: usize = endpoint_name(?name[0]);
    val endpoint_result: Result[local.Endpoint, io_error.Error] = local.filesystem_bytes(?name[0], length);
    if (is_err[local.Endpoint, io_error.Error](endpoint_result)) { ret 2; }
    val endpoint: local.Endpoint = unwrap_ok[local.Endpoint, io_error.Error](endpoint_result);
    val listener_result: Result[local.Listener, io_error.Error] = local.listen(endpoint, local.default_listen_options());
    if (is_err[local.Listener, io_error.Error](listener_result)) {
        val failure: io_error.Error = unwrap_err[local.Listener, io_error.Error](listener_result);
        ret -failure.code;
    }
    var listener: local.Listener = unwrap_ok[local.Listener, io_error.Error](listener_result);
    val client_result: Result[local.Stream, io_error.Error] = local.connect(endpoint);
    if (is_err[local.Stream, io_error.Error](client_result)) { ret 4; }
    var client: local.Stream = unwrap_ok[local.Stream, io_error.Error](client_result);
    val server_result: Result[local.Stream, io_error.Error] = local.accept(?listener);
    if (is_err[local.Stream, io_error.Error](server_result)) { ret 5; }
    var server: local.Stream = unwrap_ok[local.Stream, io_error.Error](server_result);
    var byte: u8 = 0x5a;
    val sent: Result[usize, io_error.Error] = local.stream_write(?client, ?byte, 1);
    if (is_err[usize, io_error.Error](sent) || unwrap_ok[usize, io_error.Error](sent) != 1) { ret 6; }
    byte = 0;
    val received: Result[usize, io_error.Error] = local.stream_read(?server, ?byte, 1);
    if (is_err[usize, io_error.Error](received) || unwrap_ok[usize, io_error.Error](received) != 1 || byte != 0x5a) { ret 7; }
    if (is_err[bool, io_error.Error](local.stream_shutdown_write(?client))) { ret 8; }
    val ended: Result[usize, io_error.Error] = local.stream_read(?server, ?byte, 1);
    if (is_err[usize, io_error.Error](ended) || unwrap_ok[usize, io_error.Error](ended) != 0) { ret 9; }
    if (is_err[bool, io_error.Error](local.stream_close(?client))) { ret 10; }
    if (is_err[bool, io_error.Error](local.stream_close(?server))) { ret 11; }
    if (is_err[bool, io_error.Error](local.listener_close(?listener))) { ret 12; }
    ret 0;
}
