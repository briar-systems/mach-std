use std.runtime;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.print;
use os: std.system.os.darwin;
use native: std.system.os.darwin.shared;
use ls: std.system.os.darwin.libsystem;

#[library("libSystem")]
ext fun getdtablesize() i32;

pub fun count_fds() i32 {
    val limit: i32 = getdtablesize();
    if (limit <= 0) { ret -1; }
    var count: i32 = 0;
    var fd: i32 = 0;
    for (fd < limit) {
        if (ls.fcntl(fd, native.F_GETFD) >= 0) { count = count + 1; }
        or { if (ls.errno() != 9) { ret -1; } }
        fd = fd + 1;
    }
    ret count;
}

fun layout() i64 {
    print.printlnf("layout inode={} seek={} record={} length={} type={} name={} alignment={}",
        $offset_of(ls.DirectoryRecord, inode), $offset_of(ls.DirectoryRecord, seek_offset),
        $offset_of(ls.DirectoryRecord, record_length), $offset_of(ls.DirectoryRecord, name_length),
        $offset_of(ls.DirectoryRecord, type_hint), $offset_of(ls.DirectoryRecord, name), $align_of(ls.DirectoryRecord));
    if ($offset_of(ls.DirectoryRecord, inode) != 0 || $offset_of(ls.DirectoryRecord, seek_offset) != 8
        || $offset_of(ls.DirectoryRecord, record_length) != 16 || $offset_of(ls.DirectoryRecord, name_length) != 18
        || $offset_of(ls.DirectoryRecord, type_hint) != 20 || $offset_of(ls.DirectoryRecord, name) != 21) { ret 10; }
    ret 0;
}

fun errors() i64 {
    val before: i32 = count_fds();
    if (before < 0) { ret 20; }
    val fd: i64 = os.open(os.AT_FDCWD, "directory-mach-file", os.O_CREAT | os.O_EXCL | os.O_RDWR, 0o600);
    if (fd < 0) { ret 21; }
    val flags: i32 = ls.fcntl(fd::i32, native.F_GETFD);
    var cursor: os.DirectoryCursor = os.DirectoryCursor{};
    val opened: os.DirectoryInitResult = os.directory_init(?cursor, fd::i32);
    val still_owned: i32 = ls.fcntl(fd::i32, native.F_GETFD);
    val closed: i64 = os.directory_close(?cursor);
    val fd_closed: i64 = os.close(fd::i32);
    if (os.unlink(os.AT_FDCWD, "directory-mach-file", 0) != 0) { ret 22; }
    print.printlnf("errors regular={} cleanup={} original_owned={} descriptor_delta={}", opened.code, opened.cleanup_code, still_owned >= 0, count_fds() - before);
    if (opened.code != os.ENOTDIR || opened.cleanup_code != 0 || closed != 0 || fd_closed != 0
        || flags < 0 || still_owned != flags || count_fds() != before) { ret 23; }
    ret 0;
}

fun borrowed() i64 {
    val before: i32 = count_fds();
    if (before < 0) { ret 30; }
    val base: str = "directory-mach-root";
    val moved: str = "directory-mach-moved";
    if (os.make_dir(os.AT_FDCWD, base, 0o700) != 0) { ret 31; }
    val fd: i64 = os.open(os.AT_FDCWD, base, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (fd < 0) { ret 32; }
    val file: i64 = os.open(fd::i32, "item", os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600);
    if (file < 0 || os.close(file::i32) != 0) { ret 33; }
    var cursor: os.DirectoryCursor = os.DirectoryCursor{};
    if (os.directory_init(?cursor, fd::i32).code != 0) { ret 34; }
    if (count_fds() != before + 2) { ret 35; }
    if (os.rename(os.AT_FDCWD, base, os.AT_FDCWD, moved) != 0) { ret 36; }
    var seen: usize = 0;
    var calls: usize = 0;
    var entry: os.DirectoryEntry;
    for (calls < 8) {
        calls = calls + 1;
        ls.fcntl(-1, native.F_GETFD);
        val next: i64 = os.directory_next(?cursor, ?entry);
        if (next < 0) { ret 37; }
        if (next == 0) { brk; }
        if (str_equals(entry.name, ".") || str_equals(entry.name, "..")) { cnt; }
        if (!str_equals(entry.name, "item") || entry.length != 4 || seen != 0) { ret 38; }
        var st: os.stat_t;
        if (os.stat_path(fd::i32, entry.name, ?st, os.AT_SYMLINK_NOFOLLOW) != 0) { ret 39; }
        seen = seen + 1;
    }
    if (seen != 1 || calls == 8 || os.directory_next(?cursor, ?entry) != 0) { ret 40; }
    if (os.directory_close(?cursor) != 0 || os.directory_close(?cursor) != 0 || count_fds() != before + 1) { ret 41; }
    if (os.unlink(fd::i32, "item", 0) != 0 || os.close(fd::i32) != 0 || os.unlink(os.AT_FDCWD, moved, os.AT_REMOVEDIR) != 0) { ret 42; }
    if (count_fds() != before) { ret 43; }
    print.println("borrowed rename=held eof=stable descriptor_delta=0");
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc != 2) { ret 2; }
    if (str_equals(argv[1], "layout")) { ret layout(); }
    if (str_equals(argv[1], "errors")) { ret errors(); }
    if (str_equals(argv[1], "borrowed")) { ret borrowed(); }
    ret 3;
}
