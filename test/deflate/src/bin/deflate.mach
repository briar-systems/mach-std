# compress stdin to stdout with std.compress.deflate, streaming
#
# usage: deflate <level 0-9> <raw|zlib|gzip>

use std.runtime;
use std.system.os;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.allocator.page;
use D: std.compress.deflate;

var src: [65536]u8;
var dst: [65536]u8;

fun out(n: usize) i64 {
    var off: usize = 0;
    for (off < n) {
        val w: i64 = os.write(os.stdout(), ?dst[off], n - off);
        if (w <= 0) { ret 1; }
        off = off + w::usize;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc != 3) { ret 2; }
    val level:     u8          = argv[1][0] - '0';
    var container: D.Container = D.RAW;
    if (argv[2][0] == 'z') { container = D.ZLIB; }
    if (argv[2][0] == 'g') { container = D.GZIP; }

    var a: A.Allocator;
    page.make(?a);
    val ri: res[D.Deflater, D.DeflateError] = D.init(?a, level, container);
    if (sel ri.err) { ret 3; }
    var z: D.Deflater = ri.ok;

    for {
        val n: i64 = os.read(os.stdin(), ?src[0], 65536);
        if (n < 0)  { ret 4; }
        if (n == 0) { brk; }
        var off: usize = 0;
        for (off < n::usize) {
            val r: res[D.Progress, D.DeflateError] = D.compress(?z, ?src[off], n::usize - off, ?dst[0], 65536);
            if (sel r.err) { ret 5; }
            off = off + r.ok.consumed;
            if (out(r.ok.written) != 0) { ret 6; }
        }
    }
    for (!D.is_done(?z)) {
        val r: res[D.Progress, D.DeflateError] = D.finish(?z, ?dst[0], 65536);
        if (sel r.err)              { ret 7; }
        if (out(r.ok.written) != 0) { ret 6; }
    }
    D.dnit(?z);
    ret 0;
}
