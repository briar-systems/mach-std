use std.runtime;
use std.types.size.usize;
use std.types.bool.bool;
use std.types.string.str_equals;
use std.print;
use os: std.system.os.darwin;
use ls: std.system.os.darwin.libsystem;
use native: std.system.os.darwin.shared;

#[library("libSystem")]
ext fun socketpair(domain: i32, kind: i32, protocol: i32, pair: *i32) i32;
#[library("libSystem")]
ext fun getdtablesize() i32;

rec Rights {
    length: u32;
    level: i32;
    kind: i32;
    fd: i32;
}

var payload: [65536]u8;

fun count_fds() i32 {
    val limit: i32 = getdtablesize();
    if (limit <= 0) { ret -1; }
    var count: i32 = 0;
    var fd: i32 = 0;
    for (fd < limit) {
        if (ls.fcntl(fd, native.F_GETFD) >= 0) { count = count + 1; }
        fd = fd + 1;
    }
    ret count;
}

fun errors() i64 {
    val invalid: usize = (-1)::usize;
    var byte: u8 = 0;
    var length: u32 = 16;
    var control_length: usize = 16;
    var flags: i32 = 12345;
    var address: [128]u8;
    var vector: ls.IoVector = ls.IoVector{data: ?byte, length: 1};
    var out: usize = 17;
    if (os.sock_create_flags(-1, os.SOCK_STREAM, 0, 0, 1, ?out) >= 0 || out != invalid) { ret 10; }
    if (os.sock_accept_flags(invalid, nil, nil, 0, 1, ?out) != os.EBADF || out != invalid) { ret 11; }
    if (os.sock_bind(invalid, ?address[0], 16) != os.EBADF) { ret 12; }
    if (os.sock_listen(invalid, 1) != os.EBADF) { ret 13; }
    if (os.sock_connect(invalid, ?address[0], 16) != os.EBADF) { ret 14; }
    if (os.sock_sendto(invalid, ?byte, 1, 0, nil, 0) != os.EBADF) { ret 15; }
    if (os.sock_recvfrom(invalid, ?byte, 1, 0, nil, nil) != os.EBADF) { ret 16; }
    if (os.sock_shutdown(invalid, os.SHUT_RDWR) != os.EBADF) { ret 17; }
    if (os.sock_setopt(invalid, os.SOL_SOCKET, os.SO_REUSEADDR, ?byte, 1) != os.EBADF) { ret 18; }
    if (os.sock_getopt(invalid, os.SOL_SOCKET, os.SO_REUSEADDR, ?byte, ?length) != os.EBADF) { ret 19; }
    if (os.sock_local_addr(invalid, ?address[0], ?length) != os.EBADF) { ret 20; }
    if (os.sock_remote_addr(invalid, ?address[0], ?length) != os.EBADF) { ret 21; }
    if (os.sock_write_vector(invalid, ?vector, 1) != os.EBADF) { ret 22; }
    if (os.sock_send_message(invalid, ?vector, 1, nil, 0, nil, 0) != os.EBADF) { ret 23; }
    if (os.sock_receive_message(invalid, ?vector, 1, ?address[0], ?length, ?address[0], ?control_length, ?flags) != os.EBADF) { ret 24; }
    if (length != 16 || control_length != 16 || flags != 12345) { ret 25; }
    if (os.sock_write_vector(invalid, ?vector, 1025) != os.EINVAL) { ret 26; }
    if (os.sock_send_message(invalid, ?vector, 1, nil, 0, nil, 0x100000000) != os.EINVAL) { ret 27; }
    control_length = 0x100000000;
    if (os.sock_receive_message(invalid, ?vector, 1, nil, ?length, nil, ?control_length, ?flags) != os.EINVAL) { ret 32; }
    if (control_length != 0x100000000 || flags != 12345) { ret 33; }
    if (os.sock_write_vector(invalid, ?vector, 0) != os.EINVAL) { ret 34; }
    if (os.sock_bind(invalid, nil, 0x100000000) != os.EINVAL) { ret 28; }
    if (os.sock_connect(invalid, nil, 0x100000000) != os.EINVAL) { ret 29; }
    if (os.sock_sendto(invalid, nil, 0, 0, nil, 0x100000000) != os.EINVAL) { ret 30; }
    if (os.sock_setopt(invalid, os.SOL_SOCKET, os.SO_REUSEADDR, nil, 0x100000000) != os.EINVAL) { ret 31; }
    ret 0;
}

fun listener(out: *usize, address: *u8, length: *u32) i64 {
    if (os.sock_create_flags(os.AF_INET, os.SOCK_STREAM, 0, 0, 1, out) < 0) { ret 1; }
    var ip: [4]u8 = [4]u8{127, 0, 0, 1};
    os.sock_addr_init(address, 0, ?ip[0]);
    if (os.sock_bind(@out, address, 16) < 0 || os.sock_listen(@out, 2) < 0) { os.sock_close(@out); ret 2; }
    @length = 128;
    if (os.sock_local_addr(@out, address, length) < 0) { os.sock_close(@out); ret 3; }
    ret 0;
}

fun stream(accept_refusal: bool) i64 {
    var address: [128]u8;
    var length: u32 = 128;
    var server: usize;
    if (listener(?server, ?address[0], ?length) != 0) { ret 40; }
    fin { os.sock_close(server); }
    var client: usize;
    if (os.sock_create(os.AF_INET, os.SOCK_STREAM, 0, ?client) < 0) { ret 41; }
    fin { os.sock_close(client); }
    if (os.sock_connect(client, ?address[0], length::usize) < 0) { ret 42; }
    if (os.sock_connect_status(client) != 0) { ret 43; }
    val before: i32 = count_fds();
    var accepted: usize = (-1)::usize;
    val code: i64 = os.sock_accept_flags(server, nil, nil, 1, 1, ?accepted);
    if (accept_refusal) {
        if (code != os.EIO || accepted != (-1)::usize) {
            if (code == 0) { os.sock_close(accepted); }
            ret 44;
        }
        if (before < 0 || count_fds() != before) { ret 45; }
        ret 0;
    }
    if (code < 0) { ret 46; }
    fin { os.sock_close(accepted); }
    if ((native.fd_flags(accepted::i32) & native.FD_CLOEXEC::i64) == 0 || (native.file_flags(accepted::i32) & native.O_NONBLOCK::i64) == 0) { ret 47; }
    var peer: [128]u8;
    var peer_length: u32 = 128;
    if (os.sock_remote_addr(client, ?peer[0], ?peer_length) < 0 || peer_length != length) { ret 48; }
    var i: usize = 0;
    for (i < 8) { if (peer[i] != address[i]) { ret 49; } i = i + 1; }
    var enabled: i32 = 1;
    if (os.sock_setopt(client, os.SOL_SOCKET, os.SO_KEEPALIVE, (?enabled)::*u8, 4) != 0) { ret 50; }
    enabled = 0;
    var option_length: u32 = 4;
    if (os.sock_getopt(client, os.SOL_SOCKET, os.SO_KEEPALIVE, (?enabled)::*u8, ?option_length) != 0 || enabled == 0 || option_length != 4) { ret 51; }
    print.printlnf("keepalive={} length={}", enabled, option_length);
    if (os.sock_setopt(client, os.SOL_SOCKET, -1, (?enabled)::*u8, 4) != os.ENOTSUP) { ret 52; }
    if (os.sock_getopt(client, os.SOL_SOCKET, -1, (?enabled)::*u8, ?option_length) != os.ENOTSUP) { ret 53; }
    var byte: u8 = 0;
    if (os.sock_recv(accepted, ?byte, 1) != os.EAGAIN) { ret 54; }
    if (native.set_file_flags(accepted::i32, native.file_flags(accepted::i32)::i32 & ~native.O_NONBLOCK) != 0 || os.sock_set_rcvtimeo(accepted, 2000) != 0) { ret 57; }
    if (os.sock_send(client, "S", 1) != 1 || os.sock_recv(accepted, ?byte, 1) != 1 || byte != 'S') { ret 55; }
    if (os.sock_shutdown(client, os.SHUT_WR) != 0) { ret 56; }
    if (os.sock_recv(accepted, ?byte, 1) != 0) { ret 58; }
    ret 0;
}

fun vectors() i64 {
    var pair: [2]i32;
    if (socketpair(1, os.SOCK_STREAM, 0, ?pair[0]) != 0) { ret 60; }
    fin { os.close(pair[0]); os.close(pair[1]); }
    var limit: i32 = 4096;
    if (os.sock_setopt(pair[0]::usize, os.SOL_SOCKET, os.SO_SNDBUF, (?limit)::*u8, 4) != 0) { ret 61; }
    if (os.sock_setopt(pair[1]::usize, os.SOL_SOCKET, os.SO_RCVBUF, (?limit)::*u8, 4) != 0) { ret 62; }
    if (native.set_file_flags(pair[0], native.file_flags(pair[0])::i32 | native.O_NONBLOCK) != 0) { ret 63; }
    var i: usize = 0;
    for (i < 65536) { payload[i] = (i % 251)::u8; i = i + 1; }
    var vector: [2]os.IoVector;
    vector[0] = os.IoVector{data: ?payload[0], length: 32768};
    vector[1] = os.IoVector{data: ?payload[32768], length: 32768};
    val count: i64 = os.sock_write_vector(pair[0]::usize, ?vector[0], 2);
    if (count <= 0 || count >= 65536) { ret 64; }
    if (os.sock_write_vector(pair[0]::usize, ?vector[0], 2) != os.EAGAIN) { ret 65; }
    var data: [4096]u8;
    var total: usize = 0;
    for (total < count::usize) {
        var take: usize = count::usize - total;
        if (take > 4096) { take = 4096; }
        val received: i64 = os.sock_recv(pair[1]::usize, ?data[0], take);
        if (received <= 0) { ret 66; }
        i = 0;
        for (i < received::usize) { if (data[i] != payload[total + i]) { ret 67; } i = i + 1; }
        total = total + received::usize;
    }
    print.printlnf("partial={}", count);
    ret 0;
}

fun messages() i64 {
    var pair: [2]i32;
    if (socketpair(1, os.SOCK_DGRAM, 0, ?pair[0]) != 0) { ret 70; }
    fin { os.close(pair[0]); os.close(pair[1]); }
    var pipe: [2]i32;
    if (ls.pipe(?pipe[0]) != 0) { ret 71; }
    fin { os.close(pipe[0]); os.close(pipe[1]); }
    var send: [2]os.IoVector;
    send[0] = os.IoVector{data: "abc", length: 3};
    send[1] = os.IoVector{data: "defg", length: 4};
    var rights: Rights = Rights{length: 16, level: os.SOL_SOCKET, kind: 1, fd: pipe[0]};
    if (os.sock_send_message(pair[0]::usize, ?send[0], 2, nil, 0, (?rights)::*u8, 16) != 7) { ret 72; }
    var a: [2]u8;
    var b: [5]u8;
    var receive: [2]os.IoVector;
    receive[0] = os.IoVector{data: ?a[0], length: 2};
    receive[1] = os.IoVector{data: ?b[0], length: 5};
    var received_control: [4]Rights;
    received_control[0] = Rights{length: 0, level: 0, kind: 0, fd: -1};
    var address_length: u32 = 0;
    var control_length: usize = 64;
    var flags: i32 = 12345;
    if (os.sock_receive_message(pair[1]::usize, ?receive[0], 2, nil, ?address_length, (?received_control[0])::*u8, ?control_length, ?flags) != 7) { ret 73; }
    val received_rights: Rights = received_control[0];
    if (received_rights.fd < 0) { ret 74; }
    fin { os.close(received_rights.fd); }
    if (address_length != 0 || control_length != 16 || flags == 12345 || (flags & 0x30) != 0 || received_rights.length != 16 || received_rights.level != os.SOL_SOCKET || received_rights.kind != 1) { ret 75; }
    if (a[0] != 'a' || a[1] != 'b' || b[0] != 'c' || b[4] != 'g') { ret 76; }
    var byte: u8 = 0;
    if (os.write(pipe[1], "R", 1) != 1 || os.read(received_rights.fd, ?byte, 1) != 1 || byte != 'R') { ret 77; }
    val before: i32 = count_fds();
    if (os.sock_send_message(pair[0]::usize, ?send[0], 2, nil, 0, nil, 0) != 7) { ret 78; }
    receive[0].length = 1;
    control_length = 0;
    flags = 0;
    if (os.sock_receive_message(pair[1]::usize, ?receive[0], 1, nil, ?address_length, nil, ?control_length, ?flags) != 1) { ret 79; }
    if ((flags & 0x10) == 0 || control_length != 0) { ret 80; }
    val after: i32 = count_fds();
    if (before < 0 || after != before) { ret 81; }
    print.printlnf("ignored-control count=1 flags={} length={} fd-delta={}", flags, control_length, after - before);
    ret 0;
}

fun datagrams() i64 {
    var receiver: usize;
    if (os.sock_create(os.AF_INET, os.SOCK_DGRAM, 0, ?receiver) < 0) { ret 90; }
    fin { os.sock_close(receiver); }
    if (os.sock_set_rcvtimeo(receiver, 2000) != 0) { ret 91; }
    var address: [128]u8;
    var ip: [4]u8 = [4]u8{127, 0, 0, 1};
    os.sock_addr_init(?address[0], 0, ?ip[0]);
    if (os.sock_bind(receiver, ?address[0], 16) != 0) { ret 92; }
    var length: u32 = 128;
    if (os.sock_local_addr(receiver, ?address[0], ?length) != 0 || length != 16) { ret 93; }
    var sender: usize;
    if (os.sock_create(os.AF_INET, os.SOCK_DGRAM, 0, ?sender) < 0) { ret 94; }
    fin { os.sock_close(sender); }
    if (os.sock_sendto(sender, "udp", 3, 0, ?address[0], length::usize) != 3) { ret 95; }
    var peer: [128]u8;
    var peer_length: u32 = 128;
    var data: [8]u8;
    if (os.sock_recvfrom(receiver, ?data[0], 8, 0, ?peer[0], ?peer_length) != 3 || peer_length != 16 || data[0] != 'u' || data[2] != 'p') { ret 96; }
    var vector: os.IoVector = os.IoVector{data: "message", length: 7};
    if (os.sock_send_message(sender, ?vector, 1, ?address[0], length, nil, 0) != 7) { ret 97; }
    vector = os.IoVector{data: ?data[0], length: 8};
    peer_length = 128;
    var control_length: usize = 0;
    var flags: i32 = 12345;
    if (os.sock_receive_message(receiver, ?vector, 1, ?peer[0], ?peer_length, nil, ?control_length, ?flags) != 7 || peer_length != 16 || flags == 12345 || (flags & 0x30) != 0 || control_length != 0 || data[0] != 'm' || data[6] != 'e') { ret 98; }
    if (os.sock_sendto(sender, nil, 0, 0, ?address[0], length::usize) != 0) { ret 99; }
    peer_length = 128;
    if (os.sock_recvfrom(receiver, ?data[0], 8, 0, ?peer[0], ?peer_length) != 0 || peer_length != 16) { ret 100; }
    vector = os.IoVector{data: nil, length: 0};
    if (os.sock_send_message(sender, ?vector, 1, ?address[0], length, nil, 0) != 0) { ret 101; }
    vector = os.IoVector{data: ?data[0], length: 8};
    peer_length = 128;
    flags = 12345;
    if (os.sock_receive_message(receiver, ?vector, 1, ?peer[0], ?peer_length, nil, ?control_length, ?flags) != 0 || peer_length != 16 || flags == 12345 || (flags & 0x30) != 0) { ret 102; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc != 2) { ret 1; }
    if (str_equals(argv[1], "layout")) {
        print.printlnf("{} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}",
            $size_of(ls.IoVector), $align_of(ls.IoVector), $offset_of(ls.IoVector, data), $offset_of(ls.IoVector, length),
            $size_of(ls.MessageHeader), $align_of(ls.MessageHeader), $offset_of(ls.MessageHeader, address),
            $offset_of(ls.MessageHeader, address_length), $offset_of(ls.MessageHeader, vectors), $offset_of(ls.MessageHeader, vector_count),
            $offset_of(ls.MessageHeader, control), $offset_of(ls.MessageHeader, control_length), $offset_of(ls.MessageHeader, flags),
            $size_of(u32), $size_of(i32), $size_of(i64), $size_of(Rights), $offset_of(Rights, fd));
        ret 0;
    }
    if (str_equals(argv[1], "errors")) { ret errors(); }
    if (str_equals(argv[1], "stream")) { ret stream(0); }
    if (str_equals(argv[1], "vectors")) { ret vectors(); }
    if (str_equals(argv[1], "messages")) { ret messages(); }
    if (str_equals(argv[1], "datagrams")) { ret datagrams(); }
    if (str_equals(argv[1], "accept-refusal")) { ret stream(1); }
    if (str_equals(argv[1], "create-refusal")) {
        val before: i32 = count_fds();
        var fd: usize = (-1)::usize;
        val code: i64 = os.sock_create_flags(os.AF_INET, os.SOCK_STREAM, 0, 1, 1, ?fd);
        if (code != os.EIO || fd != (-1)::usize) {
            if (code == 0) { os.sock_close(fd); }
            ret 110;
        }
        if (before < 0 || count_fds() != before) { ret 111; }
        ret 0;
    }
    ret 2;
}
