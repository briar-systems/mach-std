use std.memory.secret;
use std.types.size.usize;

rec SecretLeaf {
    value: ^u64;
}

rec SecretRecord {
    public: u64;
    secret: SecretLeaf;
}

fun erase_pointer() ptr {
    var data: *^u8 = nil;
    secret.allocate(1, ?data);
    ret data;
}

fun erase_integer() usize {
    var data: *^u8 = nil;
    secret.allocate(1, ?data);
    ret data::usize;
}

fun erase_typed_pointer() ptr {
    var data: *SecretRecord = nil;
    secret.allocate_typed[SecretRecord](1, ?data);
    ret data;
}

# a caller holding the welded borrow the file lane takes cannot mint a public
# view of it, so no staging copy can exist on the caller's side
fun alias_borrow(key: *^u8) *u8 {
    ret key::*u8;
}

rec BorrowHolder {
    key: *^u8;
}

# nor can a record carrying the borrow be handed to a ptr context
fun erase_holder(holder: *BorrowHolder) ptr {
    ret holder::ptr;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret 0;
}
