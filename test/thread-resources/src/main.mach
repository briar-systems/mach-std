# native thread resource lifecycle probe

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.size.isize;
use std.lib.libstd;
use std.runtime;
use std.sync.atomic;
use std.sync.thread;
use std.system.os;

rec Snapshot {
    allocations: u64;
    handles:     u64;
}

$if ($mach.build.os == $mach.os.windows) {
    rec MemoryBasicInformation {
        base:               ptr;
        allocation_base:    ptr;
        allocation_protect: u32;
        padding0:           u32;
        region_size:        usize;
        state:              u32;
        protect:            u32;
        typ:                u32;
        padding1:           u32;
    }

    #[library("kernel32.dll")]
    ext fun VirtualQuery(address: ptr, info: *MemoryBasicInformation, length: usize) usize;
    #[library("kernel32.dll")]
    ext fun GetCurrentProcess() isize;
    #[library("kernel32.dll")]
    ext fun GetProcessHandleCount(process: isize, count: *u32) i32;
}
$or ($mach.build.os == $mach.os.darwin) {
    rec ProcTaskInfo {
        virtual_size:      u64;
        resident_size:     u64;
        total_user:        u64;
        total_system:      u64;
        threads_user:      u64;
        threads_system:    u64;
        policy:            i32;
        faults:            i32;
        pageins:           i32;
        cow_faults:        i32;
        messages_sent:     i32;
        messages_received: i32;
        syscalls_mach:     i32;
        syscalls_unix:     i32;
        context_switches:  i32;
        thread_count:      i32;
        running_count:     i32;
        priority:          i32;
    }

    #[library("libproc")]
    ext fun proc_pidinfo(pid: i32, flavor: i32, arg: u64, buffer: ptr, size: i32) i32;
}

fun hex_digit(ch: u8) i64 {
    if (ch >= 48 && ch <= 57) { ret (ch - 48)::i64; }
    if (ch >= 97 && ch <= 102) { ret (ch - 87)::i64; }
    ret -1;
}

fun linux_mapped_bytes(total: *u64) bool {
    val fd: i64 = os.open(os.AT_FDCWD, "/proc/self/maps", os.O_RDONLY, 0);
    if (fd < 0) { ret false; }
    var buf: [4096]u8;
    var mapped: usize = 0;
    var start: usize = 0;
    var end: usize = 0;
    var field: i32 = 0;
    var n: i64 = 1;
    for (n > 0) {
        n = os.read(fd::i32, ?buf[0], 4096);
        if (n < 0) { os.close(fd::i32); ret false; }
        var i: usize = 0;
        for (i < n::usize) {
            val ch: u8 = buf[i];
            if (field == 0 && ch == 45) {
                field = 1;
            }
            or (field == 1 && ch == 32) {
                if (end < start || mapped > (-1)::usize - (end - start)) {
                    os.close(fd::i32);
                    ret false;
                }
                mapped = mapped + end - start;
                field = 2;
            }
            or (field == 2 && ch == 10) {
                start = 0;
                end = 0;
                field = 0;
            }
            or (field < 2) {
                val digit: i64 = hex_digit(ch);
                if (digit < 0) { os.close(fd::i32); ret false; }
                if (field == 0) { start = start * 16 + digit::usize; }
                or { end = end * 16 + digit::usize; }
            }
            i = i + 1;
        }
    }
    if (os.close(fd::i32) < 0) { ret false; }
    @total = mapped::u64;
    ret true;
}

fun snapshot(out: *Snapshot) bool {
    $if ($mach.build.os == $mach.os.linux) {
        out.handles = 0;
        ret linux_mapped_bytes(?out.allocations);
    }
    $or ($mach.build.os == $mach.os.windows) {
        var address: usize = 0;
        var total: u64 = 0;
        for (address < (-1)::usize - 65535) {
            var info: MemoryBasicInformation;
            if (VirtualQuery(address::ptr, ?info, 48) == 0) { address = (-1)::usize; cnt; }
            if (info.typ == 0x20000) { total = total + info.region_size::u64; }
            val next: usize = info.base::usize + info.region_size;
            if (next <= address) { ret false; }
            address = next;
        }
        var count: u32 = 0;
        if (GetProcessHandleCount(GetCurrentProcess(), ?count) == 0) { ret false; }
        out.allocations = total;
        out.handles = count::u64;
        ret true;
    }
    $or {
        var info: ProcTaskInfo;
        if (proc_pidinfo(os.getpid()::i32, 2, 0, (?info)::ptr, 96) != 96) { ret false; }
        out.allocations = info.virtual_size;
        out.handles = info.thread_count::u64;
        ret true;
    }
}

fun same(a: Snapshot, b: Snapshot) bool {
    ret a.allocations == b.allocations && a.handles == b.handles;
}

fun report_value(label: *u8, label_len: usize, value: u64) {
    var digits: [32]u8;
    var n: usize = 0;
    if (value == 0) {
        digits[0] = 48;
        n = 1;
    }
    or {
        var remaining: u64 = value;
        for (remaining != 0) {
            digits[n] = (remaining % 10)::u8 + 48;
            remaining = remaining / 10;
            n = n + 1;
        }
        var i: usize = 0;
        for (i < n / 2) {
            val swap: u8 = digits[i];
            digits[i] = digits[n - i - 1];
            digits[n - i - 1] = swap;
            i = i + 1;
        }
    }
    os.write(2, label, label_len);
    os.write(2, ?digits[0], n);
    os.write(2, "\n", 1);
}

fun report_mismatch(expected: Snapshot, current: Snapshot) {
    report_value("expected allocations: ", 22, expected.allocations);
    report_value("current allocations: ", 21, current.allocations);
    report_value("expected handles: ", 18, expected.handles);
    report_value("current handles: ", 17, current.handles);
}

fun await_snapshot(expected: Snapshot) bool {
    var attempts: usize = 0;
    var current: Snapshot;
    for (attempts < 1000) {
        if (!snapshot(?current)) { ret false; }
        if (same(expected, current)) { ret true; }
        os.sleep(1000000);
        attempts = attempts + 1;
    }
    report_mismatch(expected, current);
    ret false;
}

var destroyed: i64 = 0;
var setup_body_ran: i64 = 0;

fun empty_worker() {}

fun owned_worker(arg: *u8) {}

fun destroy_worker(arg: *u8) {
    atomic.fetch_add(?destroyed, 1);
}

fun setup_worker(arg: *u8) {
    atomic.store(?setup_body_ran, 1);
}

fun await_stable_resources() bool {
    var prior: Snapshot;
    if (!snapshot(?prior)) { ret false; }
    var stable: usize = 0;
    var attempts: usize = 0;
    for (attempts < 1000) {
        os.sleep(1000000);
        var current: Snapshot;
        if (!snapshot(?current)) { ret false; }
        if (same(prior, current)) { stable = stable + 1; }
        or {
            prior = current;
            stable = 0;
        }
        if (stable == 10) { ret true; }
        attempts = attempts + 1;
    }
    ret false;
}

fun warm_resources() bool {
    var i: usize = 0;
    for (i < 16) {
        var t: thread.Thread;
        thread.spawn(empty_worker, ?t);
        if (t.tid < 0 || thread.join_result(?t) != 0) { ret false; }
        i = i + 1;
    }
    atomic.store(?destroyed, 0);
    var values: [16]i64;
    i = 0;
    for (i < 16) {
        var t: thread.Thread;
        if (thread.spawn_owned(owned_worker, (?values[i])::*u8, destroy_worker, ?t) != 0) { ret false; }
        if (thread.detach(?t) != 0) { ret false; }
        i = i + 1;
    }
    for (atomic.load(?destroyed) != 16) { atomic.spin_hint(); }
    ret await_stable_resources();
}

test "thread resources: repeated join returns native resources to baseline" {
    if (!warm_resources()) { ret 1; }
    var baseline: Snapshot;
    if (!snapshot(?baseline)) { ret 1; }
    var i: usize = 0;
    for (i < 64) {
        var t: thread.Thread;
        thread.spawn(empty_worker, ?t);
        if (t.tid < 0 || thread.join_result(?t) != 0) { ret 1; }
        i = i + 1;
    }
    if (!await_snapshot(baseline)) { ret 1; }
    ret 0;
}

test "thread resources: repeated detach returns native resources to baseline" {
    if (!warm_resources()) { ret 1; }
    var baseline: Snapshot;
    if (!snapshot(?baseline)) { ret 1; }
    atomic.store(?destroyed, 0);
    var values: [64]i64;
    var i: usize = 0;
    for (i < 64) {
        var t: thread.Thread;
        if (thread.spawn_owned(owned_worker, (?values[i])::*u8, destroy_worker, ?t) != 0) { ret 1; }
        if (thread.detach(?t) != 0) { ret 1; }
        i = i + 1;
    }
    for (atomic.load(?destroyed) != 64) { atomic.spin_hint(); }
    if (!await_snapshot(baseline)) { ret 1; }
    ret 0;
}

test "thread resources: native setup failure returns resources to baseline" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var baseline: Snapshot;
    if (!snapshot(?baseline)) { ret 1; }
    atomic.store(?setup_body_ran, 0);
    var state: i64 = 0;
    var reclaimable: i64 = 0;
    var native: usize = 0;
    val owner: ptr = os.allocate(4096);
    if (owner == nil) { ret 1; }
    var name: *u8 = "this-name-is-deliberately-longer-than-darwin-pthread-name-storage";
    var name_mem: ptr = nil;
    $if ($mach.build.os == $mach.os.linux) {
        name_mem = os.allocate(8192);
        if (name_mem == nil) { os.deallocate(owner, 4096); ret 1; }
        if (os.deallocate((name_mem::usize + 4096)::ptr, 4096) != 0) {
            os.deallocate(name_mem, 4096);
            os.deallocate(owner, 4096);
            ret 1;
        }
        name = (name_mem::usize + 4095)::*u8;
        @name = 65;
    }
    val result: i64 = os.thread_spawn(
        setup_worker, nil, ?state, ?reclaimable,
        owner, 4096, name, 2097152, 0, ?native,
    );
    $if ($mach.build.os == $mach.os.linux) { os.deallocate(name_mem, 4096); }
    os.deallocate(owner, 4096);
    if (result >= 0 || atomic.load(?setup_body_ran) != 0 || atomic.load(?reclaimable) != 1) { ret 1; }
    if (!await_snapshot(baseline)) { ret 1; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    ret 0;
}
