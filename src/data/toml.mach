# TOML 1.0 parser and accessor API
#
# parses TOML documents into a tree of tables, arrays, and values.
# all memory is owned by the provided allocator (typically an arena).
#
# a parse reports a TomlError: syntax, an integer that does not fit, nesting
# past the bound and a key that collides with a value of another shape are
# distinct, each positioned at the byte offset in the document, and a refused
# allocation is the allocator's own error. a parse that fails part way
# releases everything it acquired before reporting.

use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.allocator.Allocator;
use std.allocator.Error;
use std.allocator.allocate;
use std.allocator.deallocate;

$if (capability.HOSTED) {
    use std.allocator.page;
}

use std.memory;

pub val TYPE_STRING:  u8 = 0;
pub val TYPE_INTEGER: u8 = 1;
pub val TYPE_FLOAT:   u8 = 2;
pub val TYPE_BOOL:    u8 = 3;
pub val TYPE_ARRAY:   u8 = 4;
pub val TYPE_TABLE:   u8 = 5;

val VALUE_SIZE: usize = $size_of(Value);
val SPAN_SIZE:  usize = $size_of(Span);

# every way a parse can fail
# ---
# syntax:   the byte at the payload offset is not valid TOML
# overflow: an integer literal at the payload offset does not fit i64
# depth:    a value at the payload offset nests deeper than MAX_VALUE_DEPTH
# conflict: the key at the payload offset collides with an existing value of
#           another shape (a table where a scalar was set, an array of tables
#           over a table, and the like)
# alloc:    an acquisition was refused; nothing the parse built survives
pub tag TomlError: u8 {
    syntax:   usize;
    overflow: usize;
    depth:    usize;
    conflict: usize;
    alloc:    Error;
}

# a byte range of the document handed to `parse`
# ---
# at:  offset of the first byte, as `TomlError` positions its failures
# len: byte count; a span of length 0 at offset 0 means "not parsed"
pub rec Span {
    at:  usize;
    len: usize;
}

# tagged TOML value
#
# a parsed value records where it came from. `span` is the literal as written:
# the quotes of a string, the brackets of an array or inline table, the whole
# `[header]` or `[[header]]` line for a table a header defined, or the key token
# that created a table implicitly (a dotted key's inner segment, a header's
# inner segment). `key` is the key token that maps to this value in its table,
# the last segment of a dotted key as written, quotes included. an array
# element has no key of its own and carries the `[[header]]`'s final segment
# when a header appended it, else the zero span. a value not produced by
# `parse` carries the zero span in both.
# ---
# tag:  type discriminator (TYPE_*)
# span: the value's literal in the source
# key:  the key token that maps to it
pub rec Value {
    tag:  u8;
    span: Span;
    key:  Span;
    data: uni {
        string: str;
        integer: i64;
        float: f64;
        boolean: bool;
        array: Array;
        table: Table;
    };
}

# ordered list of TOML values
# ---
# items: pointer to Value array (ptr to break recursion)
# len:   number of elements
# cap:   allocated capacity
pub rec Array {
    items: ptr;
    len:   usize;
    cap:   usize;
}

# ordered map of string keys to TOML values
#
# a key's source position lives on the value it maps to (`Value.key`), so one
# `get` answers both where the key and where its value were written.
# ---
# keys:   pointer to str array (parallel with values)
# values: pointer to Value array
# len:    number of entries
# cap:    allocated capacity
pub rec Table {
    keys:   ptr;
    values: ptr;
    len:    usize;
    cap:    usize;
}

# key path segments for dotted key navigation
rec KeySegs {
    segs:  *str;
    spans: *Span;
    len:   usize;
    cap:   usize;
}

# keep the first refusal a release walk meets
fun keep_first(first: *err[Error], next: err[Error]) {
    if (sel next.err) {
        if (sel first.ok) { @first = next; }
    }
}

# release a string this module allocated with `alloc_str`
#
# `alloc_str` reserves `len + 1` bytes and null-terminates, so the length the
# free needs is recoverable from the string itself. Written here rather than
# reached for from `std.text.string` because the allocation is `u8`-typed and the
# pairing must be visible beside the code that made it.
# ---
# a: allocator the string was allocated from
# s: string to release; nil is a no-op
fun free_str(a: *Allocator, s: str) err[Error] {
    if (s == nil) { ret err[Error].ok{}; }
    ret deallocate[u8](a, s::*u8, str_len(s) + 1);
}

# release everything a value owns, leaving the value itself untouched
#
# Only the three payload-bearing tags own storage. The scalars carry their value
# inline and have nothing to release, which is why this is a dispatch rather than
# a table.
# ---
# a: allocator the value was parsed with
# v: value whose payload to release
fun value_dnit(a: *Allocator, v: *Value) err[Error] {
    if (v.tag == TYPE_STRING) { ret free_str(a, v.data.string); }
    if (v.tag == TYPE_TABLE)  { ret dnit(a, ?v.data.table); }
    if (v.tag == TYPE_ARRAY)  { ret array_dnit(a, ?v.data.array); }
    ret err[Error].ok{};
}

# release an array's elements and its backing storage
# ---
# a:   allocator the array was parsed with
# arr: array to tear down; reset to empty
fun array_dnit(a: *Allocator, arr: *Array) err[Error] {
    var first: err[Error] = err[Error].ok{};
    val items: *Value     = arr.items::*Value;
    var i:     usize      = 0;
    for (i < arr.len) {
        keep_first(?first, value_dnit(a, ?items[i]));
        i = i + 1;
    }
    if (arr.items != nil && arr.cap > 0) {
        keep_first(?first, deallocate[u8](a, arr.items::*u8, arr.cap * VALUE_SIZE));
    }
    arr.items = nil;
    arr.len   = 0;
    arr.cap   = 0;
    ret first;
}

# release a key-segment list: every segment string, then the segment array
#
# A segment is never adopted by a table - `table_set` stores its own copy - so
# the list owns every segment it parsed and frees all of them, whether or not the
# key they spell was already present.
# ---
# a:  allocator the segments were parsed with
# ks: segment list to tear down; reset to empty
fun keysegs_dnit(a: *Allocator, ks: *KeySegs) err[Error] {
    var first: err[Error] = err[Error].ok{};
    var i:     usize      = 0;
    for (i < ks.len) {
        keep_first(?first, free_str(a, ks.segs[i]));
        i = i + 1;
    }
    if (ks.segs != nil && ks.cap > 0) {
        keep_first(?first, deallocate[u8](a, ks.segs::*u8, ks.cap * 8));
        keep_first(?first, deallocate[u8](a, ks.spans::*u8, ks.cap * SPAN_SIZE));
    }
    ks.segs  = nil;
    ks.spans = nil;
    ks.len   = 0;
    ks.cap   = 0;
    ret first;
}

# release a parsed table and everything under it
#
# The teardown `parse` has always needed and never had. A `Table` owns its key
# copies, its value payloads, and its two parallel arrays, all from the allocator
# `parse` was handed, so one recursive walk returns the whole tree. Callers that
# outlive a single parse - anything holding a Session across reloads - must call
# this or the parse is a permanent allocation.
#
# The table is reset to the empty state rather than left dangling, so a
# double-dnit is a no-op rather than a double free. every buffer is released
# even when one refusal is reported; the first refusal is the outcome.
# ---
# a:   allocator the table was parsed with
# t:   table to tear down
# ret: ok, or the first refusal the allocator reported
pub fun dnit(a: *Allocator, t: *Table) err[Error] {
    var first: err[Error] = err[Error].ok{};
    val keys:  *str       = t.keys::*str;
    val vals:  *Value     = t.values::*Value;
    var i:     usize      = 0;
    for (i < t.len) {
        keep_first(?first, free_str(a, keys[i]));
        keep_first(?first, value_dnit(a, ?vals[i]));
        i = i + 1;
    }
    if (t.keys != nil && t.cap > 0) {
        keep_first(?first, deallocate[u8](a, t.keys::*u8, t.cap * 8));
    }
    if (t.values != nil && t.cap > 0) {
        keep_first(?first, deallocate[u8](a, t.values::*u8, t.cap * VALUE_SIZE));
    }
    t.keys   = nil;
    t.values = nil;
    t.len    = 0;
    t.cap    = 0;
    ret first;
}

# create an empty table with nil backing storage
fun table_make() Table {
    var t: Table;
    t.keys   = nil;
    t.values = nil;
    t.len    = 0;
    t.cap    = 0;
    ret t;
}

# insert or overwrite a key-value pair in a table
#
# a refused acquisition leaves the table exactly as it was and the value the
# caller's; a growth refused part way releases the buffer it acquired first.
# ---
# a:    allocator for growth
# t:    target table
# key:  key string
# val_: value to store
# ret:  ok, or the allocator's refusal
fun table_set(a: *Allocator, t: *Table, key: str, val_: Value) err[Error] {
    # overwrite existing key: the table keeps the key copy it already owns and
    # releases the value being displaced, so a re-set never strands the old one
    val keys: *str   = t.keys::*str;
    val vals: *Value = t.values::*Value;
    var i:    usize  = 0;
    for (i < t.len) {
        if (str_equals(keys[i], key)) {
            value_dnit(a, ?vals[i]);
            vals[i] = val_;
            ret err[Error].ok{};
        }
        i = i + 1;
    }

    # the table owns its keys, so it stores a copy rather than adopting the
    # caller's string. one rule for every insert path: the caller frees what it
    # passed, whether or not the key was already present
    val kd: res[str, Error] = alloc_str(a, key, 0, str_len(key));
    if (sel kd.err) { ret err[Error].err{kd.err}; }
    val owned_key: str = kd.ok;

    # grow parallel arrays if at capacity
    if (t.len >= t.cap) {
        var new_cap: usize = t.cap * 2;
        if (t.cap == 0) { new_cap = 8; }
        or (new_cap < t.cap) {
            free_str(a, owned_key);
            ret err[Error].err{Error.overflow{}};
        }

        val kr: res[*u8, Error] = allocate[u8](a, new_cap * 8);
        if (sel kr.err) {
            free_str(a, owned_key);
            ret err[Error].err{kr.err};
        }
        val new_keys: *str = kr.ok::*str;

        val vr: res[*u8, Error] = allocate[u8](a, new_cap * VALUE_SIZE);
        if (sel vr.err) {
            deallocate[u8](a, new_keys::*u8, new_cap * 8);
            free_str(a, owned_key);
            ret err[Error].err{vr.err};
        }
        val new_vals: *Value = vr.ok::*Value;

        if (t.len > 0) {
            memory.raw_copy(new_keys::ptr, t.keys, t.len * 8);
            memory.raw_copy(new_vals::ptr, t.values, t.len * VALUE_SIZE);
        }
        if (t.keys != nil && t.cap > 0) {
            deallocate[u8](a, t.keys::*u8, t.cap * 8);
        }
        if (t.values != nil && t.cap > 0) {
            deallocate[u8](a, t.values::*u8, t.cap * VALUE_SIZE);
        }

        t.keys   = new_keys::ptr;
        t.values = new_vals::ptr;
        t.cap    = new_cap;
    }

    val keys2: *str   = t.keys::*str;
    val vals2: *Value = t.values::*Value;
    keys2[t.len] = owned_key;
    vals2[t.len] = val_;
    t.len        = t.len + 1;
    ret err[Error].ok{};
}

# find a value by key in a table
# ---
# t:   table to search
# key: key string to match
# ret: pointer to the value, or nil if not found
fun table_find(t: *Table, key: str) *Value {
    if (t == nil || t.len == 0) { ret nil; }
    val keys: *str   = t.keys::*str;
    val vals: *Value = t.values::*Value;
    var i:    usize  = 0;
    for (i < t.len) {
        if (str_equals(keys[i], key)) {
            ret ?vals[i];
        }
        i = i + 1;
    }
    ret nil;
}

# find or create a sub-table under a key
#
# a conflict is reported without a position; the caller that knows the key's
# offset places it with `at`.
# ---
# a:   allocator for new table storage
# t:   parent table
# key: key for the sub-table
# tok: the key token creating it, recorded as its span and key when it is new
# ret: the table-typed value, or the failure
fun table_ensure_subtable(a: *Allocator, t: *Table, key: str, tok: Span) res[*Value, TomlError] {
    val existing: *Value = table_find(t, key);
    if (existing != nil) {
        if (existing.tag != TYPE_TABLE) {
            ret res[*Value, TomlError].err{TomlError.conflict{0}};
        }
        ret res[*Value, TomlError].ok{existing};
    }

    var empty: Value = value_table(table_make());
    empty.span = tok;
    empty.key  = tok;
    val sr: err[Error] = table_set(a, t, key, empty);
    if (sel sr.err) { ret res[*Value, TomlError].err{TomlError.alloc{sr.err}}; }
    ret res[*Value, TomlError].ok{table_find(t, key)};
}

# place an unpositioned conflict at the key it was raised for
fun at(e: TomlError, pos: usize) TomlError {
    if (sel e.conflict) { ret TomlError.conflict{pos}; }
    ret e;
}

# create an empty array with nil backing storage
fun array_make() Array {
    var a: Array;
    a.items = nil;
    a.len   = 0;
    a.cap   = 0;
    ret a;
}

# append a value to an array
#
# a refused growth leaves the array as it was and the value the caller's.
# ---
# a:    allocator for growth
# arr:  target array
# val_: value to append
# ret:  ok, or the allocator's refusal
fun array_push(a: *Allocator, arr: *Array, val_: Value) err[Error] {
    if (arr.len >= arr.cap) {
        var new_cap: usize = arr.cap * 2;
        if (arr.cap == 0)      { new_cap = 4; }
        or (new_cap < arr.cap) { ret err[Error].err{Error.overflow{}}; }

        val r: res[*u8, Error] = allocate[u8](a, new_cap * VALUE_SIZE);
        if (sel r.err) { ret err[Error].err{r.err}; }
        val new_items: *Value = r.ok::*Value;

        if (arr.len > 0) {
            memory.raw_copy(new_items::ptr, arr.items, arr.len * VALUE_SIZE);
        }
        if (arr.items != nil && arr.cap > 0) {
            deallocate[u8](a, arr.items::*u8, arr.cap * VALUE_SIZE);
        }

        arr.items = new_items::ptr;
        arr.cap   = new_cap;
    }

    val items: *Value = arr.items::*Value;
    items[arr.len] = val_;
    arr.len        = arr.len + 1;
    ret err[Error].ok{};
}

# create an empty key segment list
fun keysegs_make() KeySegs {
    var ks: KeySegs;
    ks.segs  = nil;
    ks.spans = nil;
    ks.len   = 0;
    ks.cap   = 0;
    ret ks;
}

# append a segment to a key path
# ---
# a:    allocator for growth
# ks:   target key segments
# seg:  segment string to append
# span: the segment token as written
# ret:  ok, or the allocator's refusal; the segment stays the caller's
fun keysegs_push(a: *Allocator, ks: *KeySegs, seg: str, span: Span) err[Error] {
    if (ks.len >= ks.cap) {
        var new_cap: usize = ks.cap * 2;
        if (ks.cap == 0)      { new_cap = 4; }
        or (new_cap < ks.cap) { ret err[Error].err{Error.overflow{}}; }

        val r: res[*u8, Error] = allocate[u8](a, new_cap * 8);
        if (sel r.err) { ret err[Error].err{r.err}; }
        val new_segs: *str = r.ok::*str;

        val sr: res[*u8, Error] = allocate[u8](a, new_cap * SPAN_SIZE);
        if (sel sr.err) {
            deallocate[u8](a, new_segs::*u8, new_cap * 8);
            ret err[Error].err{sr.err};
        }
        val new_spans: *Span = sr.ok::*Span;

        if (ks.len > 0) {
            memory.raw_copy(new_segs::ptr, ks.segs::ptr, ks.len * 8);
            memory.raw_copy(new_spans::ptr, ks.spans::ptr, ks.len * SPAN_SIZE);
        }
        if (ks.segs != nil && ks.cap > 0) {
            deallocate[u8](a, ks.segs::*u8, ks.cap * 8);
            deallocate[u8](a, ks.spans::*u8, ks.cap * SPAN_SIZE);
        }
        ks.segs  = new_segs;
        ks.spans = new_spans;
        ks.cap   = new_cap;
    }
    ks.segs[ks.len]  = seg;
    ks.spans[ks.len] = span;
    ks.len           = ks.len + 1;
    ret err[Error].ok{};
}

# the zero span: not parsed
fun span_none() Span {
    var sp: Span;
    sp.at  = 0;
    sp.len = 0;
    ret sp;
}

# the bytes from `start` to the cursor
fun span_from(start: usize, end: usize) Span {
    var sp: Span;
    sp.at  = start;
    sp.len = end - start;
    ret sp;
}

fun value_string(s: str) Value {
    var v: Value;
    v.tag         = TYPE_STRING;
    v.span        = span_none();
    v.key         = span_none();
    v.data.string = s;
    ret v;
}

fun value_int(n: i64) Value {
    var v: Value;
    v.tag          = TYPE_INTEGER;
    v.span         = span_none();
    v.key          = span_none();
    v.data.integer = n;
    ret v;
}

fun value_float(f: f64) Value {
    var v: Value;
    v.tag        = TYPE_FLOAT;
    v.span       = span_none();
    v.key        = span_none();
    v.data.float = f;
    ret v;
}

fun value_bool(b: bool) Value {
    var v: Value;
    v.tag          = TYPE_BOOL;
    v.span         = span_none();
    v.key          = span_none();
    v.data.boolean = b;
    ret v;
}

fun value_table(t: Table) Value {
    var v: Value;
    v.tag        = TYPE_TABLE;
    v.span       = span_none();
    v.key        = span_none();
    v.data.table = t;
    ret v;
}

fun value_array(a: Array) Value {
    var v: Value;
    v.tag        = TYPE_ARRAY;
    v.span       = span_none();
    v.key        = span_none();
    v.data.array = a;
    ret v;
}

# look up a value by dotted path in a table
#
# walks nested tables for each dot-separated segment. for keys that
# contain literal dots, use get_table() then iterate with table_key().
# the pointer borrows the table and expires with dnit.
# ---
# t:    root table
# path: dotted key path (e.g. "project.name")
# ret:  the value, or none when a segment of the path is not present or an
#       inner segment is not a table
pub fun get(t: *Table, path: str) opt[*Value] {
    if (path == nil) { ret opt[*Value].none{}; }

    var current: *Table = t;
    var start:   usize  = 0;
    var i:       usize  = 0;

    for (path[i] != 0) {
        if (path[i] == '.') {
            val v: *Value = find_by_seg(current, (path::usize + start)::str, i - start);
            if (v == nil || v.tag != TYPE_TABLE) { ret opt[*Value].none{}; }
            current = ?v.data.table;
            start   = i + 1;
        }
        i = i + 1;
    }

    val found: *Value = find_by_seg(current, (path::usize + start)::str, i - start);
    if (found == nil) { ret opt[*Value].none{}; }
    ret opt[*Value].some{found};
}

# the value at a path when it has the wanted shape
fun get_typed(t: *Table, path: str, tag: u8) *Value {
    val v: opt[*Value] = get(t, path);
    if (sel v.none)        { ret nil; }
    if (v.some.tag != tag) { ret nil; }
    ret v.some;
}

# find a value by key prefix and length
# ---
# t:       table to search
# seg:     start of the key segment (not null-terminated)
# seg_len: length of the segment
# ret:     pointer to the value, or nil
fun find_by_seg(t: *Table, seg: str, seg_len: usize) *Value {
    if (t.len == 0) { ret nil; }
    val keys: *str   = t.keys::*str;
    val vals: *Value = t.values::*Value;
    var i:    usize  = 0;
    for (i < t.len) {
        if (str_len(keys[i]) == seg_len && memory.raw_equal(keys[i]::ptr, seg::ptr, seg_len)) {
            ret ?vals[i];
        }
        i = i + 1;
    }
    ret nil;
}

# look up a string value by dotted path
# ---
# t:    root table
# path: dotted key path
# ret:  the string value, or none if not found or wrong type
pub fun get_str(t: *Table, path: str) opt[str] {
    val v: *Value = get_typed(t, path, TYPE_STRING);
    if (v == nil) { ret opt[str].none{}; }
    ret opt[str].some{v.data.string};
}

# look up an integer value by dotted path
# ---
# t:    root table
# path: dotted key path
# ret:  the integer value, or none if not found or wrong type
pub fun get_int(t: *Table, path: str) opt[i64] {
    val v: *Value = get_typed(t, path, TYPE_INTEGER);
    if (v == nil) { ret opt[i64].none{}; }
    ret opt[i64].some{v.data.integer};
}

# look up a float value by dotted path
# ---
# t:    root table
# path: dotted key path
# ret:  the float value, or none if not found or wrong type
pub fun get_float(t: *Table, path: str) opt[f64] {
    val v: *Value = get_typed(t, path, TYPE_FLOAT);
    if (v == nil) { ret opt[f64].none{}; }
    ret opt[f64].some{v.data.float};
}

# look up a boolean value by dotted path
# ---
# t:    root table
# path: dotted key path
# ret:  the boolean value, or none if not found or wrong type
pub fun get_bool(t: *Table, path: str) opt[bool] {
    val v: *Value = get_typed(t, path, TYPE_BOOL);
    if (v == nil) { ret opt[bool].none{}; }
    ret opt[bool].some{v.data.boolean};
}

# look up a sub-table by dotted path
# ---
# t:    root table
# path: dotted key path
# ret:  the sub-table, or none if not found or wrong type
pub fun get_table(t: *Table, path: str) opt[*Table] {
    val v: *Value = get_typed(t, path, TYPE_TABLE);
    if (v == nil) { ret opt[*Table].none{}; }
    ret opt[*Table].some{?v.data.table};
}

# look up an array by dotted path
# ---
# t:    root table
# path: dotted key path
# ret:  the array, or none if not found or wrong type
pub fun get_array(t: *Table, path: str) opt[*Array] {
    val v: *Value = get_typed(t, path, TYPE_ARRAY);
    if (v == nil) { ret opt[*Array].none{}; }
    ret opt[*Array].some{?v.data.array};
}

# get a value from an array by index
# ---
# arr:   array to index
# index: element index
# ret:   the element, or none past the last element
pub fun array_get(arr: *Array, index: usize) opt[*Value] {
    if (index >= arr.len) { ret opt[*Value].none{}; }
    val items: *Value = arr.items::*Value;
    ret opt[*Value].some{?items[index]};
}

# get the number of entries in a table
# ---
# t:   table to query
# ret: number of key-value pairs
pub fun table_len(t: *Table) usize {
    ret t.len;
}

# get a key by positional index
# ---
# t:     table to query
# index: position (0-based)
# ret:   the key, or none past the last entry
pub fun table_key(t: *Table, index: usize) opt[str] {
    if (index >= t.len) { ret opt[str].none{}; }
    val keys: *str = t.keys::*str;
    ret opt[str].some{keys[index]};
}

# get a value by positional index
# ---
# t:     table to query
# index: position (0-based)
# ret:   the value, or none past the last entry
pub fun table_value(t: *Table, index: usize) opt[*Value] {
    if (index >= t.len) { ret opt[*Value].none{}; }
    val vals: *Value = t.values::*Value;
    ret opt[*Value].some{?vals[index]};
}

# get the number of elements in an array
# ---
# arr: array to query
# ret: number of elements
pub fun array_len(arr: *Array) usize {
    ret arr.len;
}

fun is_ws(b: u8) bool {
    ret b == ' ' || b == '\t';
}

fun is_ws_or_newline(b: u8) bool {
    ret b == ' ' || b == '\t' || b == '\n' || b == '\r';
}

fun is_bare_key_char(b: u8) bool {
    ret (b >= 'A' && b <= 'Z')
        || (b >= 'a' && b <= 'z')
        || (b >= '0' && b <= '9')
        || b == '_' || b == '-';
}

fun skip_ws(src: str, i: *usize) {
    for (is_ws(src[@i])) {
        @i = @i + 1;
    }
}

fun skip_ws_and_newlines(src: str, i: *usize) {
    for (is_ws_or_newline(src[@i])) {
        @i = @i + 1;
    }
}

fun skip_comment(src: str, i: *usize) {
    if (src[@i] == '#') {
        for (src[@i] != 0 && src[@i] != '\n') {
            @i = @i + 1;
        }
    }
}

fun skip_ws_comments_newlines(src: str, i: *usize) {
    for {
        skip_ws_and_newlines(src, i);
        if (src[@i] == '#') {
            skip_comment(src, i);
            cnt;
        }
        brk;
    }
}

fun skip_to_newline(src: str, i: *usize) {
    skip_ws(src, i);
    skip_comment(src, i);
    if (src[@i] == '\r') { @i = @i + 1; }
    if (src[@i] == '\n') { @i = @i + 1; }
}

# allocate a copy of a substring
# ---
# a:     allocator
# src:   source string
# start: byte offset into src
# len:   number of bytes to copy
# ret:   null-terminated copy, or the allocator's refusal
fun alloc_str(a: *Allocator, src: str, start: usize, len: usize) res[str, Error] {
    val r: res[*u8, Error] = allocate[u8](a, len + 1);
    if (sel r.err) { ret res[str, Error].err{r.err}; }
    val buf: *u8 = r.ok;
    memory.raw_copy(buf::ptr, (src::usize + start)::ptr, len);
    buf[len] = 0;
    ret res[str, Error].ok{buf::*u8};
}

fun text_fail(e: TomlError) res[str, TomlError] {
    ret res[str, TomlError].err{e};
}

fun text_alloc(e: Error) res[str, TomlError] {
    ret res[str, TomlError].err{TomlError.alloc{e}};
}

fun value_fail(e: TomlError) res[Value, TomlError] {
    ret res[Value, TomlError].err{e};
}

fun value_ok(v: Value) res[Value, TomlError] {
    ret res[Value, TomlError].ok{v};
}

# return the numeric value of a hex character, or -1
fun hex_digit(c: u8) i32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::u32::i32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::u32::i32 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::u32::i32 + 10; }
    ret -1;
}

# write an escape sequence into buf starting at di
# advances si past the escape. returns 0 on invalid escape, otherwise
# the number of bytes written (1 for simple escapes, 1-4 for unicode).
fun decode_escape(src: str, si: *usize, buf: *u8, di: usize) usize {
    val e: u8 = src[@si];

    if (e == 'n') {
        buf[di] = '\n';
        @si     = @si + 1;
        ret 1;
    }
    if (e == 't') {
        buf[di] = '\t';
        @si     = @si + 1;
        ret 1;
    }
    if (e == 'r') {
        buf[di] = '\r';
        @si     = @si + 1;
        ret 1;
    }
    if (e == '"') {
        buf[di] = '"';
        @si     = @si + 1;
        ret 1;
    }
    if (e == '\\') {
        buf[di] = '\\';
        @si     = @si + 1;
        ret 1;
    }
    if (e == 'b') {
        buf[di] = 8;
        @si     = @si + 1;
        ret 1;
    }
    if (e == 'f') {
        buf[di] = 12;
        @si     = @si + 1;
        ret 1;
    }

    if (e == 'u' || e == 'U') {
        var ndig: usize = 4;
        if (e == 'U') { ndig = 8; }

        var code: u32   = 0;
        var k:    usize = 0;
        for (k < ndig) {
            val d: i32 = hex_digit(src[@si + 1 + k]);
            if (d < 0) { ret 0; }
            code = (code << 4) | d::u32;
            k    = k + 1;
        }

        if (code >= 0xD800 && code <= 0xDFFF) { ret 0; }

        @si = @si + ndig + 1;
        ret encode_utf8(buf, di, code);
    }

    ret 0;
}

# count output bytes for an escape at src[@i]
# advances i past the escape sequence.
fun count_escape_len(src: str, i: *usize) usize {
    val e: u8 = src[@i];
    if (e == 'u' || e == 'U') {
        var ndig: usize = 4;
        if (e == 'U') { ndig = 8; }
        var code: u32   = 0;
        var k:    usize = 0;
        for (k < ndig) {
            val d: i32 = hex_digit(src[@i + 1 + k]);
            if (d >= 0) { code = (code << 4) | d::u32; }
            k = k + 1;
        }
        @i = @i + ndig + 1;
        ret utf8_len(code);
    }
    @i = @i + 1;
    ret 1;
}

# return the number of bytes needed to encode a codepoint as UTF-8
fun utf8_len(code: u32) usize {
    if (code <= 0x7F)   { ret 1; }
    if (code <= 0x7FF)  { ret 2; }
    if (code <= 0xFFFF) { ret 3; }
    ret 4;
}

# write a unicode codepoint as UTF-8 into buf at offset di
# returns the number of bytes written (1-4).
fun encode_utf8(buf: *u8, di: usize, code: u32) usize {
    if (code <= 0x7F) {
        buf[di] = code::u8;
        ret 1;
    }
    if (code <= 0x7FF) {
        buf[di]     = (0xC0 | (code >> 6))::u8;
        buf[di + 1] = (0x80 | (code & 0x3F))::u8;
        ret 2;
    }
    if (code <= 0xFFFF) {
        buf[di]     = (0xE0 | (code >> 12))::u8;
        buf[di + 1] = (0x80 | ((code >> 6) & 0x3F))::u8;
        buf[di + 2] = (0x80 | (code & 0x3F))::u8;
        ret 3;
    }
    buf[di]     = (0xF0 | (code >> 18))::u8;
    buf[di + 1] = (0x80 | ((code >> 12) & 0x3F))::u8;
    buf[di + 2] = (0x80 | ((code >> 6) & 0x3F))::u8;
    buf[di + 3] = (0x80 | (code & 0x3F))::u8;
    ret 4;
}

# parse a double-quoted string with escape processing
# expects the cursor on the opening '"'.
# ---
# a:   allocator for the output buffer
# src: source text
# i:   cursor position (updated past closing '"')
# ret: the parsed string, or the failure
fun parse_basic_string(a: *Allocator, src: str, i: *usize) res[str, TomlError] {
    @i = @i + 1;

    if (src[@i] == '"' && src[@i + 1] == '"') {
        @i = @i + 2;
        ret parse_ml_basic_string(a, src, i);
    }

    val start: usize = @i;

    # pass 1: compute output length
    var out_len: usize = 0;
    for {
        val b: u8 = src[@i];
        if (b == 0 || b == '\n') { ret text_fail(TomlError.syntax{@i}); }
        if (b == '"')            { brk; }
        if (b == '\\') {
            @i = @i + 1;
            if (src[@i] == 0) { ret text_fail(TomlError.syntax{@i}); }
            out_len = out_len + count_escape_len(src, i);
            cnt;
        }
        out_len = out_len + 1;
        @i      = @i + 1;
    }

    val r: res[*u8, Error] = allocate[u8](a, out_len + 1);
    if (sel r.err) { ret text_alloc(r.err); }
    val buf: *u8 = r.ok;

    # pass 2: copy with escape processing
    var si: usize = start;
    var di: usize = 0;
    for {
        if (src[si] == '"') { brk; }
        if (src[si] == '\\') {
            si = si + 1;
            val esc_at:  usize = si;
            val esc_len: usize = decode_escape(src, ?si, buf, di);
            if (esc_len == 0) {
                deallocate[u8](a, buf, out_len + 1);
                ret text_fail(TomlError.syntax{esc_at});
            }
            di = di + esc_len;
            cnt;
        }
        buf[di] = src[si];
        di      = di + 1;
        si      = si + 1;
    }

    buf[out_len] = 0;
    @i           = @i + 1;
    ret res[str, TomlError].ok{buf::*u8};
}

# parse a triple-quoted basic string
# expects the cursor immediately after the opening """.
# ---
# a:   allocator
# src: source text
# i:   cursor position
# ret: the parsed string, or the failure
fun parse_ml_basic_string(a: *Allocator, src: str, i: *usize) res[str, TomlError] {
    # skip immediate newline after opening """
    if (src[@i] == '\n')                        { @i = @i + 1; }
    or (src[@i] == '\r' && src[@i + 1] == '\n') { @i = @i + 2; }

    val start:   usize = @i;
    var out_len: usize = 0;

    # pass 1: compute output length
    for {
        if (src[@i] == 0)                                               { ret text_fail(TomlError.syntax{@i}); }
        if (src[@i] == '"' && src[@i + 1] == '"' && src[@i + 2] == '"') { brk; }
        if (src[@i] == '\\') {
            @i = @i + 1;
            # line-ending backslash: skip trailing whitespace
            if (is_ws_or_newline(src[@i])) {
                for (is_ws_or_newline(src[@i])) { @i = @i + 1; }
                cnt;
            }
            out_len = out_len + count_escape_len(src, i);
            cnt;
        }
        out_len = out_len + 1;
        @i      = @i + 1;
    }

    val r: res[*u8, Error] = allocate[u8](a, out_len + 1);
    if (sel r.err) { ret text_alloc(r.err); }
    val buf: *u8 = r.ok;

    # pass 2: copy with escape processing
    var si: usize = start;
    var di: usize = 0;
    for {
        if (src[si] == '"' && src[si + 1] == '"' && src[si + 2] == '"') { brk; }
        if (src[si] == '\\') {
            si = si + 1;
            if (is_ws_or_newline(src[si])) {
                for (is_ws_or_newline(src[si])) { si = si + 1; }
                cnt;
            }
            val esc_at:  usize = si;
            val esc_len: usize = decode_escape(src, ?si, buf, di);
            if (esc_len == 0) {
                deallocate[u8](a, buf, out_len + 1);
                ret text_fail(TomlError.syntax{esc_at});
            }
            di = di + esc_len;
            cnt;
        }
        buf[di] = src[si];
        di      = di + 1;
        si      = si + 1;
    }

    buf[out_len] = 0;
    @i           = @i + 3;
    ret res[str, TomlError].ok{buf::*u8};
}

# parse a single-quoted string (no escapes)
# expects the cursor on the opening "'".
# ---
# a:   allocator
# src: source text
# i:   cursor position
# ret: the parsed string, or the failure
fun parse_literal_string(a: *Allocator, src: str, i: *usize) res[str, TomlError] {
    @i = @i + 1;

    if (src[@i] == '\'' && src[@i + 1] == '\'') {
        @i = @i + 2;
        ret parse_ml_literal_string(a, src, i);
    }

    val start: usize = @i;
    for (src[@i] != 0 && src[@i] != '\'' && src[@i] != '\n') {
        @i = @i + 1;
    }
    if (src[@i] != '\'') { ret text_fail(TomlError.syntax{@i}); }

    val len: usize = @i - start;
    @i = @i + 1;
    val copied: res[str, Error] = alloc_str(a, src, start, len);
    if (sel copied.err) { ret text_alloc(copied.err); }
    ret res[str, TomlError].ok{copied.ok};
}

# parse a triple-quoted literal string
# expects the cursor immediately after the opening '''.
# ---
# a:   allocator
# src: source text
# i:   cursor position
# ret: the parsed string, or the failure
fun parse_ml_literal_string(a: *Allocator, src: str, i: *usize) res[str, TomlError] {
    if (src[@i] == '\n')                        { @i = @i + 1; }
    or (src[@i] == '\r' && src[@i + 1] == '\n') { @i = @i + 2; }

    val start: usize = @i;
    for {
        if (src[@i] == 0)                                                  { ret text_fail(TomlError.syntax{@i}); }
        if (src[@i] == '\'' && src[@i + 1] == '\'' && src[@i + 2] == '\'') { brk; }
        @i = @i + 1;
    }

    val len: usize = @i - start;
    @i = @i + 3;
    val copied: res[str, Error] = alloc_str(a, src, start, len);
    if (sel copied.err) { ret text_alloc(copied.err); }
    ret res[str, TomlError].ok{copied.ok};
}

# parse an integer or float value
# handles decimal, hex, octal, binary integers, decimal floats with
# optional exponent, and special values inf/nan.
# ---
# src: source text
# i:   cursor position
# ret: parsed Value, or the failure
fun parse_number(src: str, i: *usize) res[Value, TomlError] {
    val at_:  usize = @i;
    var sign: i64   = 1;
    if (src[@i] == '+') { @i = @i + 1; }
    or (src[@i] == '-') {
        sign = -1;
        @i   = @i + 1;
    }

    # inf
    if (src[@i] == 'i' && src[@i + 1] == 'n' && src[@i + 2] == 'f') {
        @i = @i + 3;
        var bits: u64 = 0x7FF0000000000000;
        if (sign < 0) { bits = 0xFFF0000000000000; }
        var inf_val: f64;
        memory.raw_copy(?inf_val, ?bits, 8);
        ret value_ok(value_float(inf_val));
    }

    # nan
    if (src[@i] == 'n' && src[@i + 1] == 'a' && src[@i + 2] == 'n') {
        @i = @i + 3;
        var bits: u64 = 0x7FF8000000000000;
        if (sign < 0) { bits = 0xFFF8000000000000; }
        var nan_val: f64;
        memory.raw_copy(?nan_val, ?bits, 8);
        ret value_ok(value_float(nan_val));
    }

    # hex, octal, binary prefixes
    if (src[@i] == '0') {
        val next: u8 = src[@i + 1];
        if (next == 'x' || next == 'X') {
            @i = @i + 2;
            ret parse_hex_int(src, i, sign, at_);
        }
        if (next == 'o' || next == 'O') {
            @i = @i + 2;
            ret parse_oct_int(src, i, sign, at_);
        }
        if (next == 'b' || next == 'B') {
            @i = @i + 2;
            ret parse_bin_int(src, i, sign, at_);
        }
    }

    # decimal integer or float
    var x:   u64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b < '0' || b > '9') { brk; }
        any = true;
        val digit:          u64 = (b - '0')::u64;
        val max_before_mul: u64 = 18446744073709551615 / 10;
        if (x > max_before_mul) { ret value_fail(TomlError.overflow{at_}); }
        val nx: u64 = x * 10;
        if (digit > 18446744073709551615 - nx) { ret value_fail(TomlError.overflow{at_}); }
        x  = nx + digit;
        @i = @i + 1;
    }

    if (!any) { ret value_fail(TomlError.syntax{@i}); }

    # fractional part
    if (src[@i] == '.' && src[@i + 1] >= '0' && src[@i + 1] <= '9') {
        ret parse_float_frac(src, i, x::i64, sign);
    }

    # exponent without fraction
    if (src[@i] == 'e' || src[@i] == 'E') {
        ret parse_float_exp(src, i, x::f64 * sign::f64);
    }

    ret value_ok(value_int(x::i64 * sign));
}

# parse the fractional part of a float after the '.'
# ---
# src:      source text
# i:        cursor position (on the '.')
# int_part: integer digits already parsed
# sign:     1 or -1
# ret:      parsed float Value, or the failure
fun parse_float_frac(src: str, i: *usize, int_part: i64, sign: i64) res[Value, TomlError] {
    @i = @i + 1;
    var frac:    f64 = 0.0;
    var divisor: f64 = 1.0;

    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b < '0' || b > '9') { brk; }
        frac    = frac * 10.0 + (b - '0')::u64::f64;
        divisor = divisor * 10.0;
        @i      = @i + 1;
    }

    var result: f64 = (int_part::f64 + frac / divisor) * sign::f64;

    if (src[@i] == 'e' || src[@i] == 'E') {
        ret parse_float_exp(src, i, result);
    }

    ret value_ok(value_float(result));
}

# parse the exponent part of a float after 'e'/'E'
# ---
# src:      source text
# i:        cursor position (on the 'e' or 'E')
# mantissa: value accumulated so far
# ret:      parsed float Value, or the failure
fun parse_float_exp(src: str, i: *usize, mantissa: f64) res[Value, TomlError] {
    @i = @i + 1;
    var exp_sign: i64 = 1;
    if (src[@i] == '+') { @i = @i + 1; }
    or (src[@i] == '-') {
        exp_sign = -1;
        @i       = @i + 1;
    }

    var exp: i64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b < '0' || b > '9') { brk; }
        any = true;
        exp = exp * 10 + (b - '0')::u64::i64;
        @i  = @i + 1;
    }
    if (!any) { ret value_fail(TomlError.syntax{@i}); }

    var result: f64 = mantissa;
    result = apply_pow10(result, exp, exp_sign);

    ret value_ok(value_float(result));
}

# multiply or divide value by 10^exp using a lookup table
fun apply_pow10(value: f64, exp: i64, exp_sign: i64) f64 {
    var pow10: [20]f64;
    pow10[0]  = 1.0;
    pow10[1]  = 10.0;
    pow10[2]  = 100.0;
    pow10[3]  = 1000.0;
    pow10[4]  = 10000.0;
    pow10[5]  = 100000.0;
    pow10[6]  = 1000000.0;
    pow10[7]  = 10000000.0;
    pow10[8]  = 100000000.0;
    pow10[9]  = 1000000000.0;
    pow10[10] = 10000000000.0;
    pow10[11] = 100000000000.0;
    pow10[12] = 1000000000000.0;
    pow10[13] = 10000000000000.0;
    pow10[14] = 100000000000000.0;
    pow10[15] = 1000000000000000.0;
    pow10[16] = 10000000000000000.0;
    pow10[17] = 100000000000000000.0;
    pow10[18] = 1000000000000000000.0;
    pow10[19] = 10000000000000000000.0;

    var result:    f64 = value;
    var remaining: i64 = exp;
    for (remaining > 0) {
        var chunk: i64 = remaining;
        if (chunk > 19) { chunk = 19; }
        if (exp_sign > 0) {
            result = result * pow10[chunk::usize];
        }
        or {
            result = result / pow10[chunk::usize];
        }
        remaining = remaining - chunk;
    }
    ret result;
}

# parse hexadecimal digits into an integer value
fun parse_hex_int(src: str, i: *usize, sign: i64, at_: usize) res[Value, TomlError] {
    var x:   u64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        val d: i32 = hex_digit(b);
        if (d < 0) { brk; }
        any = true;
        if (x > 0x0FFFFFFFFFFFFFFF) { ret value_fail(TomlError.overflow{at_}); }
        x  = (x << 4) | d::u32::u64;
        @i = @i + 1;
    }
    if (!any) { ret value_fail(TomlError.syntax{@i}); }
    ret value_ok(value_int(x::i64 * sign));
}

# parse octal digits into an integer value
fun parse_oct_int(src: str, i: *usize, sign: i64, at_: usize) res[Value, TomlError] {
    var x:   u64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b < '0' || b > '7') { brk; }
        any = true;
        if (x > 0x1FFFFFFFFFFFFFFF) { ret value_fail(TomlError.overflow{at_}); }
        x  = (x << 3) | (b - '0')::u64;
        @i = @i + 1;
    }
    if (!any) { ret value_fail(TomlError.syntax{@i}); }
    ret value_ok(value_int(x::i64 * sign));
}

# parse binary digits into an integer value
fun parse_bin_int(src: str, i: *usize, sign: i64, at_: usize) res[Value, TomlError] {
    var x:   u64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b != '0' && b != '1') { brk; }
        any = true;
        if (x > 0x7FFFFFFFFFFFFFFF) { ret value_fail(TomlError.overflow{at_}); }
        x  = (x << 1) | (b - '0')::u64;
        @i = @i + 1;
    }
    if (!any) { ret value_fail(TomlError.syntax{@i}); }
    ret value_ok(value_int(x::i64 * sign));
}

# check if a byte terminates a bare value
fun is_value_term(b: u8) bool {
    ret b == 0 || b == ' ' || b == '\t' || b == '\n' || b == '\r'
        || b == ',' || b == ']' || b == '}' || b == '#';
}

# parse "true" or "false"
fun parse_bool_val(src: str, i: *usize) res[Value, TomlError] {
    if (src[@i] == 't' && src[@i + 1] == 'r' && src[@i + 2] == 'u' && src[@i + 3] == 'e') {
        if (!is_value_term(src[@i + 4])) { ret value_fail(TomlError.syntax{@i + 4}); }
        @i = @i + 4;
        ret value_ok(value_bool(true));
    }
    if (src[@i] == 'f' && src[@i + 1] == 'a' && src[@i + 2] == 'l' && src[@i + 3] == 's' && src[@i + 4] == 'e') {
        if (!is_value_term(src[@i + 5])) { ret value_fail(TomlError.syntax{@i + 5}); }
        @i = @i + 5;
        ret value_ok(value_bool(false));
    }
    ret value_fail(TomlError.syntax{@i});
}

# parse a single key segment (bare, quoted, or literal)
# ---
# a:   allocator
# src: source text
# i:   cursor position
# ret: the key string, or the failure
fun parse_key_segment(a: *Allocator, src: str, i: *usize) res[str, TomlError] {
    if (src[@i] == '"') {
        ret parse_basic_string(a, src, i);
    }
    if (src[@i] == '\'') {
        ret parse_literal_string(a, src, i);
    }

    val start: usize = @i;
    for (is_bare_key_char(src[@i])) {
        @i = @i + 1;
    }
    if (@i == start) { ret text_fail(TomlError.syntax{@i}); }
    val copied: res[str, Error] = alloc_str(a, src, start, @i - start);
    if (sel copied.err) { ret text_alloc(copied.err); }
    ret res[str, TomlError].ok{copied.ok};
}

# parse a possibly-dotted key into segments
#
# handles bare keys, quoted keys, and mixed dotted keys like a."b".c.
# each segment is stored independently, preserving literal dots in
# quoted keys. the caller owns `ks` and releases it however this returns, so
# a segment parsed before a failure is never stranded.
# ---
# a:   allocator
# src: source text
# i:   cursor position
# ks:  the segment list to fill, empty on entry
# ret: ok, or the failure
fun parse_key_path(a: *Allocator, src: str, i: *usize, ks: *KeySegs) err[TomlError] {
    val first_at: usize               = @i;
    val first:    res[str, TomlError] = parse_key_segment(a, src, i);
    if (sel first.err) { ret err[TomlError].err{first.err}; }

    val pr: err[Error] = keysegs_push(a, ks, first.ok, span_from(first_at, @i));
    if (sel pr.err) {
        free_str(a, first.ok);
        ret err[TomlError].err{TomlError.alloc{pr.err}};
    }

    for (src[@i] == '.') {
        @i = @i + 1;
        val seg_at: usize               = @i;
        val seg:    res[str, TomlError] = parse_key_segment(a, src, i);
        if (sel seg.err) { ret err[TomlError].err{seg.err}; }

        val pr2: err[Error] = keysegs_push(a, ks, seg.ok, span_from(seg_at, @i));
        if (sel pr2.err) {
            free_str(a, seg.ok);
            ret err[TomlError].err{TomlError.alloc{pr2.err}};
        }
    }

    ret err[TomlError].ok{};
}

# walk key segments, creating intermediate tables
# returns the table that should receive the final segment's value.
# ---
# a:   allocator for new tables
# t:   starting table
# ks:  key segments (navigates all but the last)
# ret: target table, or the failure (a conflict unpositioned)
fun navigate_segs(a: *Allocator, t: *Table, ks: *KeySegs) res[*Table, TomlError] {
    var current: *Table = t;
    var i:       usize  = 0;
    for (i < ks.len - 1) {
        val tr: res[*Value, TomlError] = table_ensure_subtable(a, current, ks.segs[i], ks.spans[i]);
        if (sel tr.err) { ret res[*Table, TomlError].err{tr.err}; }
        current = ?tr.ok.data.table;
        i       = i + 1;
    }
    ret res[*Table, TomlError].ok{current};
}

# how many containers a value may nest inside before the reader refuses
#
# arrays and inline tables descend through parse_value, so nesting depth is a
# count taken straight from the document: without a stated bound the only limit
# is whatever stack the process happens to have, and a document deep enough to
# exhaust it kills the reader rather than being rejected by it. sixty-four is
# far past anything a hand-written document reaches and far short of any stack
# the reader runs on.
pub val MAX_VALUE_DEPTH: usize = 64;

# parse a TOML value at the current position, recording its literal's span
# ---
# a:     allocator
# src:   source text
# i:     cursor position
# depth: how many arrays and inline tables enclose this value
# ret:   parsed Value, or the failure
fun parse_value(a: *Allocator, src: str, i: *usize, depth: usize) res[Value, TomlError] {
    skip_ws(src, i);
    val start: usize                 = @i;
    val r:     res[Value, TomlError] = parse_value_literal(a, src, i, depth);
    if (sel r.err) { ret r; }
    var v: Value = r.ok;
    v.span = span_from(start, @i);
    ret value_ok(v);
}

# the value dispatch, cursor on the literal's first byte
fun parse_value_literal(a: *Allocator, src: str, i: *usize, depth: usize) res[Value, TomlError] {
    if (depth > MAX_VALUE_DEPTH) { ret value_fail(TomlError.depth{@i}); }

    val b: u8 = src[@i];

    if (b == '"') {
        val r: res[str, TomlError] = parse_basic_string(a, src, i);
        if (sel r.err) { ret value_fail(r.err); }
        ret value_ok(value_string(r.ok));
    }

    if (b == '\'') {
        val r: res[str, TomlError] = parse_literal_string(a, src, i);
        if (sel r.err) { ret value_fail(r.err); }
        ret value_ok(value_string(r.ok));
    }

    if (b == 't' || b == 'f') {
        ret parse_bool_val(src, i);
    }

    if (b == '[') {
        ret parse_array_value(a, src, i, depth + 1);
    }

    if (b == '{') {
        ret parse_inline_table(a, src, i, depth + 1);
    }

    if (b == '+' || b == '-' || (b >= '0' && b <= '9') || b == 'i' || b == 'n') {
        ret parse_number(src, i);
    }

    ret value_fail(TomlError.syntax{@i});
}

# parse a TOML array [...]
#
# the array under construction is released on every failure inside it.
# ---
# a:     allocator
# src:   source text
# i:     cursor position (on the '[')
# depth: how many containers enclose this array, itself included
# ret:   parsed array Value, or the failure
fun parse_array_value(a: *Allocator, src: str, i: *usize, depth: usize) res[Value, TomlError] {
    @i = @i + 1;
    var arr: Array = array_make();

    for {
        skip_ws_comments_newlines(src, i);
        if (src[@i] == ']') {
            @i = @i + 1;
            brk;
        }

        val vr: res[Value, TomlError] = parse_value(a, src, i, depth);
        if (sel vr.err) {
            array_dnit(a, ?arr);
            ret vr;
        }

        val pr: err[Error] = array_push(a, ?arr, vr.ok);
        if (sel pr.err) {
            var parsed: Value = vr.ok;
            value_dnit(a, ?parsed);
            array_dnit(a, ?arr);
            ret value_fail(TomlError.alloc{pr.err});
        }

        skip_ws_comments_newlines(src, i);
        if (src[@i] == ',') {
            @i = @i + 1;
            cnt;
        }
    }

    ret value_ok(value_array(arr));
}

# parse a TOML inline table {...}
# ---
# a:     allocator
# src:   source text
# i:     cursor position (on the '{')
# depth: how many containers enclose this table, itself included
# ret:   parsed table Value, or the failure
fun parse_inline_table(a: *Allocator, src: str, i: *usize, depth: usize) res[Value, TomlError] {
    @i = @i + 1;
    var t:  Table   = table_make();
    var ks: KeySegs = keysegs_make();

    skip_ws(src, i);
    if (src[@i] == '}') {
        @i = @i + 1;
        ret value_ok(value_table(t));
    }

    val r: err[TomlError] = parse_inline_entries(a, src, i, ?t, ?ks, depth);
    keysegs_dnit(a, ?ks);
    if (sel r.err) {
        dnit(a, ?t);
        ret value_fail(r.err);
    }
    ret value_ok(value_table(t));
}

# the inline table's entry loop, split out for the same reason `parse_walk` is:
# `t` and `ks` are owned by the caller, so an error return here cannot strand the
# partially built table or the key path in flight
# ---
# a:   allocator for parsed storage
# src: document text
# i:   cursor, positioned after the opening brace
# t:   the inline table being built
# ks:  scratch key-path segments, owned by the caller
# ret: ok when the closing brace was consumed, or the parse failure
fun parse_inline_entries(a: *Allocator, src: str, i: *usize, t: *Table, ks: *KeySegs, depth: usize) err[TomlError] {
    for {
        skip_ws(src, i);

        keysegs_dnit(a, ks);
        val key_at: usize          = @i;
        val ksr:    err[TomlError] = parse_key_path(a, src, i, ks);
        if (sel ksr.err) { ret ksr; }

        skip_ws(src, i);
        if (src[@i] != '=') { ret err[TomlError].err{TomlError.syntax{@i}}; }
        @i = @i + 1;

        val vr: res[Value, TomlError] = parse_value(a, src, i, depth);
        if (sel vr.err) { ret err[TomlError].err{vr.err}; }

        var parsed: Value = vr.ok;
        parsed.key = ks.spans[ks.len - 1];

        val nr: res[*Table, TomlError] = navigate_segs(a, t, ks);
        if (sel nr.err) {
            value_dnit(a, ?parsed);
            ret err[TomlError].err{at(nr.err, key_at)};
        }

        val sr: err[Error] = table_set(a, nr.ok, ks.segs[ks.len - 1], parsed);
        if (sel sr.err) {
            value_dnit(a, ?parsed);
            ret err[TomlError].err{TomlError.alloc{sr.err}};
        }

        skip_ws(src, i);
        if (src[@i] == ',') {
            @i = @i + 1;
            cnt;
        }
        if (src[@i] == '}') {
            @i = @i + 1;
            brk;
        }

        ret err[TomlError].err{TomlError.syntax{@i}};
    }

    ret err[TomlError].ok{};
}

# resolve a [[key]] header
#
# navigates parent segments (creating tables or following existing
# array-of-tables entries), then appends a new table to the array
# at the final segment.
# ---
# a:    allocator
# root: document root table
# ks:   key segments from the [[...]] header
# ret:  the newly appended table's value, its span still the caller's to
#       stamp, or the failure (a conflict unpositioned)
fun navigate_for_array_table(a: *Allocator, root: *Table, ks: *KeySegs) res[*Value, TomlError] {
    var parent: *Table = root;
    var i:      usize  = 0;

    # navigate parent segments
    for (i < ks.len - 1) {
        val existing: *Value = table_find(parent, ks.segs[i]);
        if (existing != nil) {
            if (existing.tag == TYPE_TABLE) {
                parent = ?existing.data.table;
            }
            or (existing.tag == TYPE_ARRAY && existing.data.array.len > 0) {
                # navigate into last element of array (per TOML spec)
                val items: *Value = existing.data.array.items::*Value;
                val last:  *Value = ?items[existing.data.array.len - 1];
                if (last.tag != TYPE_TABLE) {
                    ret res[*Value, TomlError].err{TomlError.conflict{0}};
                }
                parent = ?last.data.table;
            }
            or {
                ret res[*Value, TomlError].err{TomlError.conflict{0}};
            }
        }
        or {
            val tr: res[*Value, TomlError] = table_ensure_subtable(a, parent, ks.segs[i], ks.spans[i]);
            if (sel tr.err) { ret tr; }
            parent = ?tr.ok.data.table;
        }
        i = i + 1;
    }

    # append new table to the array at the final segment
    val final_key: str    = ks.segs[ks.len - 1];
    val existing:  *Value = table_find(parent, final_key);

    if (existing != nil) {
        if (existing.tag != TYPE_ARRAY) {
            ret res[*Value, TomlError].err{TomlError.conflict{0}};
        }
        var new_table: Table      = table_make();
        val new_val:   Value      = value_table(new_table);
        val pr:        err[Error] = array_push(a, ?existing.data.array, new_val);
        if (sel pr.err) { ret res[*Value, TomlError].err{TomlError.alloc{pr.err}}; }

        val items: *Value = existing.data.array.items::*Value;
        ret res[*Value, TomlError].ok{?items[existing.data.array.len - 1]};
    }

    # first occurrence: create the array with one empty table
    var arr:       Array      = array_make();
    var new_table: Table      = table_make();
    val new_val:   Value      = value_table(new_table);
    val pr:        err[Error] = array_push(a, ?arr, new_val);
    if (sel pr.err) { ret res[*Value, TomlError].err{TomlError.alloc{pr.err}}; }

    # the array itself is positioned at the header that first named it
    var arr_val: Value = value_array(arr);
    arr_val.span = ks.spans[ks.len - 1];
    arr_val.key  = ks.spans[ks.len - 1];
    val sr: err[Error] = table_set(a, parent, final_key, arr_val);
    if (sel sr.err) {
        array_dnit(a, ?arr);
        ret res[*Value, TomlError].err{TomlError.alloc{sr.err}};
    }

    val added: *Value = table_find(parent, final_key);
    val items: *Value = added.data.array.items::*Value;
    ret res[*Value, TomlError].ok{?items[0]};
}

# parse a TOML document into a table tree
#
# supports TOML 1.0: basic and literal strings (single and multi-line),
# integers (decimal, hex, octal, binary), floats, booleans, arrays,
# tables, inline tables, array of tables, and dotted keys.
# ---
# a:   allocator for all internal allocations
# src: null-terminated TOML source string
# ret: the root table, or the failure; a failed parse strands nothing
pub fun parse(a: *Allocator, src: str) res[Table, TomlError] {
    # the two owned values the walk builds are held HERE, so every failure inside
    # it releases them on the way out. the walk itself only reports the failure -
    # it never has to unwind, and a new error return cannot forget to (#3001)
    var root: Table          = table_make();
    var ks:   KeySegs        = keysegs_make();
    val r:    err[TomlError] = parse_walk(a, src, ?root, ?ks);
    keysegs_dnit(a, ?ks);
    if (sel r.err) {
        dnit(a, ?root);
        ret res[Table, TomlError].err{r.err};
    }
    ret res[Table, TomlError].ok{root};
}

# the document walk: table headers, arrays of tables, and key/value lines
#
# `root` and `ks` are borrowed from `parse`, which owns and releases them however
# this returns. `ks` is reused across every key path rather than being created
# per line, and each reuse releases the previous path first.
# ---
# a:    allocator for parsed storage
# src:  document text
# root: the table being built
# ks:   scratch key-path segments, owned by the caller
# ret:  ok when the document was consumed, or the parse failure
fun parse_walk(a: *Allocator, src: str, root: *Table, ks: *KeySegs) err[TomlError] {
    var current: *Table = root;
    var i:       usize  = 0;

    for {
        skip_ws_comments_newlines(src, ?i);
        if (src[i] == 0) { brk; }

        # array of tables: [[key]]
        if (src[i] == '[' && src[i + 1] == '[') {
            val header_at: usize = i;
            i = i + 2;
            skip_ws(src, ?i);

            keysegs_dnit(a, ks);
            val key_at: usize          = i;
            val ksr:    err[TomlError] = parse_key_path(a, src, ?i, ks);
            if (sel ksr.err) { ret ksr; }

            skip_ws(src, ?i);
            if (src[i] != ']' || src[i + 1] != ']') {
                ret err[TomlError].err{TomlError.syntax{i}};
            }
            i = i + 2;

            val tr: res[*Value, TomlError] = navigate_for_array_table(a, root, ks);
            if (sel tr.err) { ret err[TomlError].err{at(tr.err, key_at)}; }
            tr.ok.span = span_from(header_at, i);
            tr.ok.key  = ks.spans[ks.len - 1];
            current    = ?tr.ok.data.table;

            skip_to_newline(src, ?i);
            cnt;
        }

        # table header: [key]
        if (src[i] == '[') {
            val header_at: usize = i;
            i = i + 1;
            skip_ws(src, ?i);

            keysegs_dnit(a, ks);
            val key_at: usize          = i;
            val ksr:    err[TomlError] = parse_key_path(a, src, ?i, ks);
            if (sel ksr.err) { ret ksr; }

            skip_ws(src, ?i);
            if (src[i] != ']') {
                ret err[TomlError].err{TomlError.syntax{i}};
            }
            i = i + 1;

            # inner segments record the token that created them; the table the
            # header defines records the header, whether the header created it
            # or a dotted key or deeper header reached it first
            var target: *Table = root;
            var si:     usize  = 0;
            for (si < ks.len) {
                val tr: res[*Value, TomlError] = table_ensure_subtable(a, target, ks.segs[si], ks.spans[si]);
                if (sel tr.err) { ret err[TomlError].err{at(tr.err, key_at)}; }
                if (si == ks.len - 1) {
                    tr.ok.span = span_from(header_at, i);
                    tr.ok.key  = ks.spans[si];
                }
                target = ?tr.ok.data.table;
                si     = si + 1;
            }
            current = target;

            skip_to_newline(src, ?i);
            cnt;
        }

        # key = value
        keysegs_dnit(a, ks);
        val key_at: usize          = i;
        val ksr:    err[TomlError] = parse_key_path(a, src, ?i, ks);
        if (sel ksr.err) { ret ksr; }

        skip_ws(src, ?i);
        if (src[i] != '=') {
            ret err[TomlError].err{TomlError.syntax{i}};
        }
        i = i + 1;

        val vr: res[Value, TomlError] = parse_value(a, src, ?i, 0);
        if (sel vr.err) { ret err[TomlError].err{vr.err}; }

        var parsed: Value = vr.ok;
        parsed.key = ks.spans[ks.len - 1];

        val nr: res[*Table, TomlError] = navigate_segs(a, current, ks);
        if (sel nr.err) {
            value_dnit(a, ?parsed);
            ret err[TomlError].err{at(nr.err, key_at)};
        }

        val sr: err[Error] = table_set(a, nr.ok, ks.segs[ks.len - 1], parsed);
        if (sel sr.err) {
            value_dnit(a, ?parsed);
            ret err[TomlError].err{TomlError.alloc{sr.err}};
        }

        skip_to_newline(src, ?i);
    }

    ret err[TomlError].ok{};
}

$if (capability.HOSTED) {
    # whether document `doc` sets x to a float within tol of want
    fun float_is(a: *Allocator, doc: str, want: f64, tol: f64) bool {
        val r: res[Table, TomlError] = parse(a, doc);
        if (sel r.err) { ret false; }
        var t: Table    = r.ok;
        val o: opt[f64] = get_float(?t, "x");
        dnit(a, ?t);
        if (!sel o.some) { ret false; }
        val v: f64 = o.some;
        ret v > want - tol && v < want + tol;
    }

    # a plain fraction, and exponents that scale up, past one pow10 chunk, and down
    test toml__floats {
        var a: Allocator;
        page.make(?a);
        if (!float_is(?a, "x = 3.14", 3.14, 0.01))             { ret 1; }
        if (!float_is(?a, "x = 1.5e3", 1500.0, 1.0))           { ret 2; }
        if (!float_is(?a, "x = 2e10", 20000000000.0, 10000.0)) { ret 3; }
        if (!float_is(?a, "x = 1.5e-2", 0.015, 0.0001))        { ret 4; }
        ret 0;
    }

    # teardown tests (#474). `parse` allocates the whole tree from the caller's
    # allocator and `dnit` is its pairing, so the property worth asserting is a
    # BALANCE rather than any particular call: a parse followed by a teardown must
    # leave the allocator exactly where it started. Measured through a counting
    # allocator, since nothing about a leak is visible from the returned value.

    rec CountingAlloc {
        backing: Allocator;
        live:    i64;
    }

    fun counting_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
        val c: *CountingAlloc = ctx::*CountingAlloc;
        val r: opt[ptr]       = c.backing.fn_allocate(c.backing.ctx, size, align);
        if (sel r.some) { c.live = c.live + size::i64; }
        ret r;
    }

    fun counting_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
        val c: *CountingAlloc = ctx::*CountingAlloc;
        val r: opt[ptr]       = c.backing.fn_reallocate(c.backing.ctx, p, old_size, new_size, align);
        if (sel r.some) { c.live = c.live - old_size::i64 + new_size::i64; }
        ret r;
    }

    fun counting_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
        val c: *CountingAlloc = ctx::*CountingAlloc;
        c.live = c.live - size::i64;
        ret c.backing.fn_deallocate(c.backing.ctx, p, size, align);
    }

    fun counting_make(c: *CountingAlloc, a: *Allocator) bool {
        val pm: err[Error] = page.make(?c.backing);
        if (sel pm.err) { ret false; }
        c.live          = 0;
        a.ctx           = c::ptr;
        a.fn_allocate   = counting_allocate;
        a.fn_reallocate = counting_reallocate;
        a.fn_deallocate = counting_deallocate;
        ret true;
    }

    # a document covering every construct that owns storage: nested tables through a
    # dotted key, an array of tables, an inline table, arrays of each scalar type, and
    # enough keys in one table to force the parallel arrays to grow past their initial
    # capacity (which is where the old code stranded the buffer it replaced)
    fun teardown_doc() str {
        ret "title = \"demo\"\nk1 = 1\nk2 = 2\nk3 = 3\nk4 = 4\nk5 = 5\nk6 = 6\nk7 = 7\nk8 = 8\nk9 = 9\nk10 = 10\n\n[owner]\nname = \"someone\"\nnums = [1, 2, 3, 4, 5, 6, 7, 8]\nstrs = [\"a\", \"bb\", \"ccc\"]\nflag = true\nratio = 1.5\n\n[deep.nested.table]\nx = \"y\"\n\n[[items]]\nid = 1\ntag = \"first\"\n\n[[items]]\nid = 2\ntag = \"second\"\n\n[inline]\npair = { a = 1, b = \"two\", c = [3, 4] }\n";
    }

    # every lookup answers none for what is not there: a missing key, a path
    # whose inner segment is a scalar, a value of another shape, an index past the
    # end of an array or a table
    test toml__lookups {
        var a: Allocator;
        page.make(?a);
        val r: res[Table, TomlError] = parse(?a, teardown_doc());
        if (sel r.err) { ret 1; }
        var t: Table = r.ok;
        fin { dnit(?a, ?t); }

        val title: opt[str] = get_str(?t, "title");
        if (sel title.none)                  { ret 2; }
        if (!str_equals(title.some, "demo")) { ret 3; }
        val deep: opt[str] = get_str(?t, "deep.nested.table.x");
        if (sel deep.none)               { ret 4; }
        if (!str_equals(deep.some, "y")) { ret 5; }
        val missing: opt[str] = get_str(?t, "owner.missing");
        if (sel missing.some) { ret 6; }
        val through_scalar: opt[*Value] = get(?t, "title.inner");
        if (sel through_scalar.some) { ret 7; }
        val wrong_shape: opt[str] = get_str(?t, "k1");
        if (sel wrong_shape.some) { ret 8; }
        val as_int: opt[i64] = get_int(?t, "k1");
        if (sel as_int.none)  { ret 9; }
        if (as_int.some != 1) { ret 10; }

        val owner: opt[*Table] = get_table(?t, "owner");
        if (sel owner.none) { ret 11; }
        val not_table: opt[*Table] = get_table(?t, "title");
        if (sel not_table.some) { ret 12; }
        val nums: opt[*Array] = get_array(owner.some, "nums");
        if (sel nums.none)             { ret 13; }
        if (array_len(nums.some) != 8) { ret 14; }
        val last: opt[*Value] = array_get(nums.some, 7);
        if (sel last.none)                                                { ret 15; }
        if (last.some.tag != TYPE_INTEGER || last.some.data.integer != 8) { ret 16; }
        val past: opt[*Value] = array_get(nums.some, 8);
        if (sel past.some) { ret 17; }
        val not_array: opt[*Array] = get_array(?t, "owner");
        if (sel not_array.some) { ret 18; }

        val n: usize = table_len(owner.some);
        if (n == 0) { ret 19; }
        val first_key: opt[str] = table_key(owner.some, 0);
        if (sel first_key.none)                  { ret 20; }
        if (!str_equals(first_key.some, "name")) { ret 21; }
        val first_value: opt[*Value] = table_value(owner.some, 0);
        if (sel first_value.none)                { ret 22; }
        if (first_value.some.tag != TYPE_STRING) { ret 23; }
        val no_key: opt[str] = table_key(owner.some, n);
        if (sel no_key.some) { ret 24; }
        val no_value: opt[*Value] = table_value(owner.some, n);
        if (sel no_value.some) { ret 25; }
        ret 0;
    }

    test toml__parse_then_dnit_returns_every_byte {
        var c: CountingAlloc;
        var a: Allocator;
        if (!counting_make(?c, ?a)) { ret 1; }

        val r: res[Table, TomlError] = parse(?a, teardown_doc());
        if (sel r.err) { ret 2; }
        var t: Table = r.ok;
        if (c.live == 0) { ret 3; } # the parse must actually have allocated

        dnit(?a, ?t);
        if (c.live != 0)                                    { ret 4; }
        if (t.len != 0 || t.keys != nil || t.values != nil) { ret 5; }

        # a second teardown is a no-op, not a double free
        dnit(?a, ?t);
        if (c.live != 0) { ret 6; }
        ret 0;
    }

    # the key a caller hands to the parser is never adopted, so a document that sets
    # the same key twice releases the loser rather than keeping both
    test toml__overwritten_key_is_released {
        var c: CountingAlloc;
        var a: Allocator;
        if (!counting_make(?c, ?a)) { ret 1; }

        val r: res[Table, TomlError] = parse(?a,
            "dup = \"first value here\"\ndup = \"second value here\"\ndup = [1, 2, 3]\ndup = { x = \"y\" }\n");
        if (sel r.err) { ret 2; }
        var t: Table = r.ok;
        if (table_len(?t) != 1) { ret 3; }

        dnit(?a, ?t);
        if (c.live != 0) { ret 4; }
        ret 0;
    }

    # build "k = " followed by `n` open brackets, the shape that used to recurse
    # once per bracket until the stack ran out
    fun t_nest_open(a: *Allocator, n: usize) str {
        val total: usize           = 4 + n;
        val r:     res[*u8, Error] = allocate[u8](a, total + 1);
        if (sel r.err) { ret nil; }
        val buf: *u8 = r.ok;
        buf[0] = 'k';
        buf[1] = ' ';
        buf[2] = '=';
        buf[3] = ' ';
        var i: usize = 0;
        for (i < n) {
            buf[4 + i] = '[';
            i          = i + 1;
        }
        buf[total] = 0;
        ret buf::str;
    }

    # close a "k = [[[..." prefix into a whole document, with a scalar at the bottom
    #
    # the scalar matters: an empty innermost array is closed without ever asking for
    # a value, so it costs one descent less. with it, `n` brackets is exactly `n`
    # levels deep, which is what makes the boundary below mean what it says.
    fun t_close(a: *Allocator, open_: str, n: usize) str {
        val head:  usize           = str_len(open_);
        val total: usize           = head + 1 + n;
        val r:     res[*u8, Error] = allocate[u8](a, total + 1);
        if (sel r.err) { ret nil; }
        val buf: *u8   = r.ok;
        var i:   usize = 0;
        for (i < head) {
            buf[i] = open_[i];
            i      = i + 1;
        }
        buf[head] = '1';
        i         = 0;
        for (i < n) {
            buf[head + 1 + i] = ']';
            i                 = i + 1;
        }
        buf[total] = 0;
        ret buf::str;
    }

    # the bound is where it says it is: one under is accepted, one over is refused,
    # so the constant cannot drift from the behaviour without this failing
    test toml__nesting_bound {
        var c: CountingAlloc;
        var a: Allocator;
        if (!counting_make(?c, ?a)) { ret 1; }

        var bad: i32 = 0;

        # MAX_VALUE_DEPTH open brackets, each closed: the deepest accepted document
        val n_ok:    usize = MAX_VALUE_DEPTH;
        val open_ok: str   = t_nest_open(?a, n_ok);
        if (open_ok == nil) { ret 2; }
        val doc_ok: str = t_close(?a, open_ok, n_ok);
        if (doc_ok == nil) { ret 3; }
        val r_ok: res[Table, TomlError] = parse(?a, doc_ok);
        if (sel r_ok.err) { bad = 4; }
        if (sel r_ok.ok) {
            var t: Table = r_ok.ok;
            dnit(?a, ?t);
        }
        deallocate[u8](?a, open_ok, 4 + n_ok + 1);
        deallocate[u8](?a, doc_ok, 4 + n_ok + 1 + n_ok + 1);

        # one deeper is refused
        if (bad == 0) {
            val n_no:    usize = MAX_VALUE_DEPTH + 1;
            val open_no: str   = t_nest_open(?a, n_no);
            if (open_no == nil) { ret 5; }
            val doc_no: str = t_close(?a, open_no, n_no);
            if (doc_no == nil) { ret 6; }
            val r_no: res[Table, TomlError] = parse(?a, doc_no);
            if (!sel r_no.err) { bad = 7; }
            if (sel r_no.err) {
                if (!sel r_no.err.depth) { bad = 8; }
            }
            deallocate[u8](?a, open_no, 4 + n_no + 1);
            deallocate[u8](?a, doc_no, 4 + n_no + 1 + n_no + 1);
        }

        if (bad == 0 && c.live != 0) { bad = 9; }
        ret bad;
    }

    # a key path that collides with a non-table value releases the value already
    # parsed for it
    #
    # this is the one path in the inline-table loop that parses a value and then
    # throws it away, and it had no coverage: the value must be a string, because
    # an integer owns no heap and freeing it proves nothing.
    test toml__inline_key_conflict_releases_its_value {
        var c: CountingAlloc;
        var a: Allocator;
        if (!counting_make(?c, ?a)) { ret 1; }

        # `k` holds an integer, then `k.deeper` asks to descend through it
        val r: res[Table, TomlError] = parse(?a, "x = { k = 1, k.deeper = \"a heap allocated string\" }\n");
        if (!sel r.err)  { ret 2; }
        if (c.live != 0) { ret 3; }
        ret 0;
    }

    use std.allocator.testing;

    # each failure is classified and positioned: syntax at the offending byte,
    # overflow and conflict at the literal or key they were raised for
    test toml__failures_carry_offsets {
        var c: CountingAlloc;
        var a: Allocator;
        if (!counting_make(?c, ?a)) { ret 1; }

        val eq_: res[Table, TomlError] = parse(?a, "a = 1\nb 2\n");
        if (!sel eq_.err)        { ret 2; }
        if (!sel eq_.err.syntax) { ret 3; }
        if (eq_.err.syntax != 8) { ret 3; }

        val big: res[Table, TomlError] = parse(?a, "x = 1\ny = 99999999999999999999\n");
        if (!sel big.err)           { ret 4; }
        if (!sel big.err.overflow)  { ret 5; }
        if (big.err.overflow != 10) { ret 5; }

        val clash: res[Table, TomlError] = parse(?a, "k = 1\nk.deeper = 2\n");
        if (!sel clash.err)          { ret 6; }
        if (!sel clash.err.conflict) { ret 7; }
        if (clash.err.conflict != 6) { ret 7; }

        val header: res[Table, TomlError] = parse(?a, "n = 1\n[[n]]\n");
        if (!sel header.err)          { ret 8; }
        if (!sel header.err.conflict) { ret 9; }
        if (header.err.conflict != 8) { ret 9; }

        val esc: res[Table, TomlError] = parse(?a, "s = \"ab\\qcd\"\n");
        if (!sel esc.err)        { ret 10; }
        if (!sel esc.err.syntax) { ret 11; }
        if (esc.err.syntax != 8) { ret 11; }

        val open_: res[Table, TomlError] = parse(?a, "s = 'abc\n");
        if (!sel open_.err)        { ret 12; }
        if (!sel open_.err.syntax) { ret 13; }
        if (open_.err.syntax != 8) { ret 13; }

        if (c.live != 0) { ret 14; }
        ret 0;
    }

    # each acquisition refused in turn: the parse reports the allocator's error,
    # nothing is stranded, and the tree released afterwards balances
    test toml__refused_acquisition_strands_nothing {
        var ordinal: usize = 1;
        for (ordinal <= 512) {
            var tracker: testing.Testing;
            val made:    err[Error] = testing.make(?tracker);
            if (sel made.err) { ret 1; }
            testing.fail_at_ordinal(?tracker, ordinal);
            val a: *Allocator = testing.allocator_of(?tracker);

            val r:        res[Table, TomlError] = parse(a, teardown_doc());
            var accepted: bool                  = false;
            if (sel r.err) {
                if (!sel r.err.alloc) {
                    testing.dnit(?tracker);
                    ret 2;
                }
                if (!sel r.err.alloc.exhausted) {
                    testing.dnit(?tracker);
                    ret 3;
                }
            }
            if (sel r.ok) {
                var t: Table = r.ok;
                accepted = true;
                val released: err[Error] = dnit(a, ?t);
                if (sel released.err) {
                    testing.dnit(?tracker);
                    ret 4;
                }
            }
            val leaked:   bool  = testing.live_count(?tracker) != 0 || testing.double_free_count(?tracker) != 0;
            val attempts: usize = testing.attempt_count(?tracker);
            testing.dnit(?tracker);
            if (leaked) { ret 5; }
            if (accepted) {
                if (attempts >= ordinal) { ret 6; }
                if (ordinal < 8)         { ret 7; }
                ret 0;
            }
            if (attempts != ordinal) { ret 8; }
            ordinal = ordinal + 1;
        }
        ret 9;
    }

    # source positions (#811). every span is checked against a fixed document by
    # its byte offset and length, so a drift in what a token "as written" means
    # (quotes, brackets, the header line) is a number and not an opinion
    fun span_is(sp: Span, at_: usize, len: usize) bool {
        ret sp.at == at_ && sp.len == len;
    }

    test toml__source_spans {
        var c: CountingAlloc;
        var a: Allocator;
        if (!counting_make(?c, ?a)) { ret 1; }

        val doc: str                   = "# manifest\n[project]\nname = \"std\"\nmach = \"^5.8\"\ndeps.core.version = 2\ntargets = [ \"linux\", 'win' ]\n[project.\"quoted key\"]\nx = { y = true }\n[[artifact]]\nkind = \"lib\"\n[[artifact]]\nkind = \"bin\"\n";
        val r:   res[Table, TomlError] = parse(?a, doc);
        if (sel r.err) { ret 2; }
        var t: Table = r.ok;

        # a header-defined table: the header line is its span, the last segment its key
        val project: opt[*Value] = get(?t, "project");
        if (!sel project.some)                  { ret 3; }
        if (!span_is(project.some.span, 11, 9)) { ret 4; }
        if (!span_is(project.some.key, 12, 7))  { ret 5; }

        # a nested key and its string literal, quotes included
        val name: opt[*Value] = get(?t, "project.name");
        if (!sel name.some)                  { ret 6; }
        if (!span_is(name.some.key, 21, 4))  { ret 7; }
        if (!span_is(name.some.span, 28, 5)) { ret 8; }
        val mach: opt[*Value] = get(?t, "project.mach");
        if (!sel mach.some)                  { ret 9; }
        if (!span_is(mach.some.span, 41, 6)) { ret 10; }

        # a dotted key: the implicit tables record the segment that created them,
        # the leaf its last segment and its literal
        val deps: opt[*Value] = get(?t, "project.deps");
        if (!sel deps.some)                  { ret 11; }
        if (!span_is(deps.some.span, 48, 4)) { ret 12; }
        if (!span_is(deps.some.key, 48, 4))  { ret 13; }
        val core: opt[*Value] = get(?t, "project.deps.core");
        if (!sel core.some)                 { ret 14; }
        if (!span_is(core.some.key, 53, 4)) { ret 15; }
        val version: opt[*Value] = get(?t, "project.deps.core.version");
        if (!sel version.some)                  { ret 16; }
        if (!span_is(version.some.key, 58, 7))  { ret 17; }
        if (!span_is(version.some.span, 68, 1)) { ret 18; }

        # an array literal and its elements: elements have no key
        val targets: opt[*Value] = get(?t, "project.targets");
        if (!sel targets.some)                   { ret 19; }
        if (!span_is(targets.some.span, 80, 18)) { ret 20; }
        val linux: opt[*Value] = array_get(?targets.some.data.array, 0);
        if (!sel linux.some)                  { ret 21; }
        if (!span_is(linux.some.span, 82, 7)) { ret 22; }
        if (!span_is(linux.some.key, 0, 0))   { ret 23; }
        val win: opt[*Value] = array_get(?targets.some.data.array, 1);
        if (!sel win.some)                  { ret 24; }
        if (!span_is(win.some.span, 91, 5)) { ret 25; }

        # a quoted header segment keeps its quotes; the outer table an earlier
        # header defined is not re-stamped by being passed through
        val quoted: *Value = find_by_seg(?project.some.data.table, "quoted key", 10);
        if (quoted == nil)                      { ret 26; }
        if (!span_is(quoted.span, 99, 22))      { ret 27; }
        if (!span_is(quoted.key, 108, 12))      { ret 28; }
        if (!span_is(project.some.span, 11, 9)) { ret 29; }

        # an inline table is the braces; its entries are positioned like any other
        val x: opt[*Value] = get(?quoted.data.table, "x");
        if (!sel x.some)                    { ret 30; }
        if (!span_is(x.some.span, 126, 12)) { ret 31; }
        val y: opt[*Value] = get(?quoted.data.table, "x.y");
        if (!sel y.some)                   { ret 32; }
        if (!span_is(y.some.key, 128, 1))  { ret 33; }
        if (!span_is(y.some.span, 132, 4)) { ret 34; }

        # an array of tables: the array is positioned at the segment that first
        # named it, each element at the header that appended it
        val artifact: opt[*Value] = get(?t, "artifact");
        if (!sel artifact.some)                   { ret 35; }
        if (!span_is(artifact.some.span, 141, 8)) { ret 36; }
        if (!span_is(artifact.some.key, 141, 8))  { ret 37; }
        val first: opt[*Value] = array_get(?artifact.some.data.array, 0);
        if (!sel first.some)                    { ret 38; }
        if (!span_is(first.some.span, 139, 12)) { ret 39; }
        val second: opt[*Value] = array_get(?artifact.some.data.array, 1);
        if (!sel second.some)                    { ret 40; }
        if (!span_is(second.some.span, 165, 12)) { ret 41; }
        if (!span_is(second.some.key, 167, 8))   { ret 42; }
        val kind: opt[*Value] = get(?second.some.data.table, "kind");
        if (!sel kind.some)                   { ret 43; }
        if (!span_is(kind.some.key, 178, 4))  { ret 44; }
        if (!span_is(kind.some.span, 185, 5)) { ret 45; }

        dnit(?a, ?t);
        if (c.live != 0) { ret 46; }
        ret 0;
    }

    # a header that names a table a dotted key created first re-positions it at
    # the header, so a missing key is reported against the definition
    test toml__header_restamps_dotted_table {
        var c: CountingAlloc;
        var a: Allocator;
        if (!counting_make(?c, ?a)) { ret 1; }

        val r: res[Table, TomlError] = parse(?a, "a.b = 1\n[a]\nc = 2\n");
        if (sel r.err) { ret 2; }
        var t:  Table       = r.ok;
        val av: opt[*Value] = get(?t, "a");
        if (!sel av.some)                 { ret 3; }
        if (!span_is(av.some.span, 8, 3)) { ret 4; }
        if (!span_is(av.some.key, 9, 1))  { ret 5; }
        val bv: opt[*Value] = get(?t, "a.b");
        if (!sel bv.some)                 { ret 6; }
        if (!span_is(bv.some.key, 2, 1))  { ret 7; }
        if (!span_is(bv.some.span, 6, 1)) { ret 8; }

        dnit(?a, ?t);
        if (c.live != 0) { ret 9; }
        ret 0;
    }
}
