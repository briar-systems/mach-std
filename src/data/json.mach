# JSON parser and emitter
#
# this module hosts two emission surfaces over one escape core:
#
#   - the tree emitter (parse/emit/write_value): parses JSON text into a tree
#     of Value nodes and emits a Value back to JSON text. strings are zero-copy
#     pointers into the original input buffer (escape sequences are not
#     unescaped: str_val holds the raw on-wire bytes); the caller must keep the
#     input alive while values are in use, and releases the tree with dnit.
#   - the streaming NDJSON emitter (Object/Array/field_*/write_json_string):
#     writes JSON objects one-per-line through a caller-owned writer, for
#     machine-consumed output streams. objects nest: a member value or an array
#     element may itself be an object (field_object_begin / array_object_begin,
#     closed with object_end_value), and only the top-level object_end writes
#     the line terminator, so a whole nested object still lands on one line.
#     every helper reports the writer's outcome, a WriteError whose payload is
#     the prefix that call persisted before the failure.
#
# both surfaces escape string bodies through one escaper (escape_unit) with an
# explicit policy:
#
#   - ESCAPE_VERBATIM (structural-utf8-verbatim): escapes '"', '\', and the C0
#     controls only; every other byte, including UTF-8 lead/continuation bytes,
#     passes through verbatim. the tree emitter uses this so valid UTF-8 input
#     round-trips as UTF-8.
#   - ESCAPE_ENSURE_ASCII: as above for bytes < 0x80, but each byte >= 0x80 is
#     UTF-8 decoded (RFC 3629) and emitted as a \uXXXX escape (astral code
#     points as a surrogate pair); invalid UTF-8 emits the U+FFFD replacement
#     escape. every emitted byte is printable ASCII on every platform. the
#     streaming emitter uses this so a machine consumer reads a stable, valid
#     stream regardless of the bytes a test label or path carries.
#
# string bytes have two representations. parse stores the RAW on-wire bytes
# between the quotes with escapes intact (value_string returns these, zero-copy);
# emit treats str_val as LOGICAL bytes and escapes '"', '\', and control bytes.
# the two meanings are bridged by value_string_decode, which resolves the wire
# escapes of a parsed string into logical bytes at the point of consumption --
# the inverse of the emit escaper, so decode(parse(emit(v))) recovers v's logical
# bytes. a parsed tree must therefore be decoded before its strings are treated
# as logical text: emitting a parsed str_val verbatim double-escapes any wire
# escapes it held (parse "a\nb" -> raw a\nb -> emit "a\\nb"), so build trees with
# make_string from already-logical bytes for emission. see mach-std#340.

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.memory.raw_copy;
use std.allocator;
use std.io.writer;
use std.io.writer.WriteError;
use std.format;
use std.text.utf8;
use std.text.parse.parse_f64_len;
use std.text.parse.ParseError;

pub def Kind: u8;
pub val NULL:   Kind = 0;
pub val BOOL:   Kind = 1;
pub val NUMBER: Kind = 2;
pub val STRING: Kind = 3;
pub val ARRAY:  Kind = 4;
pub val OBJECT: Kind = 5;

# how many arrays and objects a value may nest inside before the parser
# refuses
#
# every container descends through parse_value, so the depth is a count taken
# straight from the document; without a bound the only limit is the stack the
# process happens to have. this is far past any hand-written document and far
# short of any stack the parser runs on.
pub val MAX_DEPTH: usize = 128;

# every way a parse or a string decode can fail
# ---
# syntax: the byte at the payload offset is not valid JSON (or, from
#         value_string_decode, not a valid escape); the offset is into the
#         source given to parse, or into the raw string bytes being decoded
# depth:  a container at the payload offset nests deeper than MAX_DEPTH
# alloc:  growing a container's storage was refused; everything the parse had
#         acquired is released before it reports
pub tag JsonError: u8 {
    syntax: usize;
    depth:  usize;
    alloc:  allocator.Error;
}

# a parsed JSON value
# ---
# kind:      type discriminator (NULL, BOOL, NUMBER, STRING, ARRAY, OBJECT)
# bool_val:  boolean value (1 = true, 0 = false) when kind == BOOL
# is_float:  for a NUMBER, 1 if parsed as a float (had a fraction or exponent),
#            else 0 (an integer); selects num_val vs float_val
# num_val:   integer value when kind == NUMBER and is_float == 0
# float_val: float value when kind == NUMBER and is_float == 1
# str_val:   pointer into original input when kind == STRING; the RAW on-wire
#            bytes with escapes intact (use value_string_decode for logical bytes)
# str_len:   byte length of string (not null-terminated)
# children:  heap-allocated array of child Values (ARRAY or OBJECT)
# keys:      heap-allocated array of key strings (OBJECT only, parallel with children;
#            pointers into the original input, not null-terminated)
# keys_len:  heap-allocated array of key byte lengths (parallel with keys)
# count:     number of children/keys
# cap:       allocated capacity of children/keys arrays
pub rec Value {
    kind:      Kind;
    bool_val:  u8;
    is_float:  u8;
    num_val:   i64;
    float_val: f64;
    str_val:   str;
    str_len:   usize;
    children:  *Value;
    keys:      *str;
    keys_len:  *usize;
    count:     usize;
    cap:       usize;
}

rec Parser {
    src:   *u8;
    len:   usize;
    pos:   usize;
    alloc: *allocator.Allocator;
}

# parse JSON text into a Value tree
#
# the tree's container storage comes from `alloc`; release it with dnit. a
# parse that fails part way releases everything it acquired before reporting.
# ---
# src:     pointer to JSON source bytes
# src_len: length of source in bytes
# alloc:   allocator for array/object storage
# ret:     root Value on success, or the failure
pub fun parse(src: *u8, src_len: usize, alloc: *allocator.Allocator) res[Value, JsonError] {
    var p: Parser;
    p.src = src;
    p.len = src_len;
    p.pos = 0;
    p.alloc = alloc;

    skip_ws(?p);
    val r: res[Value, JsonError] = parse_value(?p, 0);
    if (sel r.err) { ret r; }

    skip_ws(?p);
    if (p.pos < p.len) {
        var root: Value = r.ok;
        dnit(alloc, ?root);
        ret res[Value, JsonError].err{JsonError.syntax{p.pos}};
    }

    ret r;
}

# release the container storage under a value, leaving the value empty
#
# walks arrays and objects to any depth and returns every children, keys and
# keys_len buffer to the allocator the tree was parsed with. scalars and
# strings own nothing (a string points into the caller's input). every buffer
# is released even when one refusal is reported; the first refusal is the
# outcome. a released value is empty, so a second dnit is a no-op.
# ---
# alloc: the allocator the tree was parsed with
# v:     the value whose storage to release
# ret:   ok, or the first refusal the allocator reported
pub fun dnit(alloc: *allocator.Allocator, v: *Value) err[allocator.Error] {
    var failed: bool = false;
    var cause: allocator.Error;

    var i: usize = 0;
    for (i < v.count) {
        val child: err[allocator.Error] = dnit(alloc, ?v.children[i]);
        if (sel child.err) { if (!failed) { failed = true; cause = child.err; } }
        i = i + 1;
    }

    if (v.cap > 0) {
        val c: err[allocator.Error] = allocator.deallocate[Value](alloc, v.children, v.cap);
        if (sel c.err) { if (!failed) { failed = true; cause = c.err; } }
        if (v.keys != nil) {
            val k: err[allocator.Error] = allocator.deallocate[str](alloc, v.keys, v.cap);
            if (sel k.err) { if (!failed) { failed = true; cause = k.err; } }
            val l: err[allocator.Error] = allocator.deallocate[usize](alloc, v.keys_len, v.cap);
            if (sel l.err) { if (!failed) { failed = true; cause = l.err; } }
        }
    }

    v.children = nil;
    v.keys = nil;
    v.keys_len = nil;
    v.count = 0;
    v.cap = 0;
    if (failed) { ret err[allocator.Error].err{cause}; }
    ret err[allocator.Error].ok{};
}

# check if a value is null
pub fun value_is_null(v: *Value) bool {
    ret v.kind == NULL;
}

# check if a value is a boolean
pub fun value_is_bool(v: *Value) bool {
    ret v.kind == BOOL;
}

# check if a value is a number
pub fun value_is_number(v: *Value) bool {
    ret v.kind == NUMBER;
}

# check if a value is a string
pub fun value_is_string(v: *Value) bool {
    ret v.kind == STRING;
}

# check if a value is an array
pub fun value_is_array(v: *Value) bool {
    ret v.kind == ARRAY;
}

# check if a value is an object
pub fun value_is_object(v: *Value) bool {
    ret v.kind == OBJECT;
}

# get the boolean value
# ---
# ret: true if bool_val is nonzero
pub fun value_bool(v: *Value) bool {
    ret v.bool_val != 0;
}

# whether a NUMBER value was parsed as a float
#
# true for a number with a fraction or exponent, false for an integer-looking
# number; selects whether to read it with value_float or value_number.
pub fun value_is_float(v: *Value) bool {
    ret v.kind == NUMBER && v.is_float != 0;
}

# get the integer value of an integer NUMBER
#
# meaningful when the number was parsed as an integer (value_is_float is false);
# read a float number with value_float.
pub fun value_number(v: *Value) i64 {
    ret v.num_val;
}

# get the value of a NUMBER as a 64-bit float
#
# returns the float value for a number parsed as a float, or the integer value
# widened to f64 for an integer number, so it is defined for any NUMBER.
pub fun value_float(v: *Value) f64 {
    if (v.is_float != 0) { ret v.float_val; }
    ret v.num_val::f64;
}

# get the raw string pointer and length
#
# for a parsed value these are the RAW on-wire bytes between the quotes, escapes
# intact and zero-copy into the input (parse "a\nb" yields the 4 bytes a \ n b);
# use value_string_decode to resolve the escapes into logical bytes.
# ---
# len: receives the byte length of the string
# ret: pointer to the first byte of the raw string content
pub fun value_string(v: *Value, len: *usize) *u8 {
    @len = v.str_len;
    ret v.str_val::*u8;
}

# decode the raw wire bytes of a string value into logical
# bytes, resolving JSON escapes into a caller buffer.
#
# the inverse of the emit escaper: '\"' '\\' '\/' become '"' '\' '/', '\b' '\f'
# '\n' '\r' '\t' become their control bytes, and '\uXXXX' decodes to UTF-8 (a
# high+low surrogate pair combines into one astral code point). unescaped bytes,
# including raw UTF-8, pass through verbatim. the parser stores raw wire bytes
# (see value_string), so this is where a parsed string becomes logical text.
#
# bytes are written into `buf` up to `len`; the full decoded length is always
# returned, so a caller can size the buffer by passing len 0 (or a short buffer)
# and calling again once `buf` is large enough (as with emit).
# ---
# v:   the value whose raw string bytes to decode (str_val/str_len)
# buf: destination buffer for the decoded bytes
# len: capacity of buf in bytes
# ret: the decoded byte length on success (may exceed len), or syntax at the
#      offset of a malformed escape (unknown escape, a '\u' without four hex
#      digits, or an ill-formed surrogate pair)
pub fun value_string_decode(v: *Value, buf: *u8, len: usize) res[usize, JsonError] {
    var b: BufWriter;
    b.data = buf;
    b.cap  = len;
    b.pos  = 0;
    val dr: err[JsonError] = decode_bytes(?b, v.str_val::*u8, v.str_len);
    if (sel dr.err) { ret res[usize, JsonError].err{dr.err}; }
    ret res[usize, JsonError].ok{b.pos};
}

# get the number of children (array elements or object entries)
pub fun value_count(v: *Value) usize {
    ret v.count;
}

# get an array element or object value by index
#
# the pointer borrows the tree and expires with dnit.
# ---
# index: zero-based index
# ret:   the child Value, or none past the last child
pub fun value_get(v: *Value, index: usize) opt[*Value] {
    if (index >= v.count) { ret opt[*Value].none{}; }
    ret opt[*Value].some{?v.children[index]};
}

# get an object key by index
#
# the key points into the original input and is NOT null-terminated;
# its byte length comes from value_key_len.
# ---
# index: zero-based index
# ret:   the key, or none past the last entry or when v is not an object
pub fun value_key(v: *Value, index: usize) opt[str] {
    if (v.kind != OBJECT || index >= v.count) { ret opt[str].none{}; }
    ret opt[str].some{v.keys[index]};
}

# get the byte length of an object key by index
# ---
# index: zero-based index
# ret:   key length in bytes, or 0 if out of bounds
pub fun value_key_len(v: *Value, index: usize) usize {
    if (v.kind != OBJECT || index >= v.count) { ret 0; }
    ret v.keys_len[index];
}

# length-bounded comparison of a stored key slice against a
# null-terminated needle.
fun key_equals(k: str, klen: usize, key: str) bool {
    var i: usize = 0;
    for (i < klen) {
        if (key[i] == 0 || k[i] != key[i]) { ret false; }
        i = i + 1;
    }
    ret key[klen] == 0;
}

# find an object value by key name (linear search)
#
# the pointer borrows the tree and expires with dnit.
# ---
# key: null-terminated key to search for
# ret: the Value, or none when no entry has that key or v is not an object
pub fun value_find(v: *Value, key: str) opt[*Value] {
    if (v.kind != OBJECT || key == nil) { ret opt[*Value].none{}; }
    var i: usize = 0;
    for (i < v.count) {
        if (key_equals(v.keys[i], v.keys_len[i], key)) {
            ret opt[*Value].some{?v.children[i]};
        }
        i = i + 1;
    }
    ret opt[*Value].none{};
}

# emit a Value as JSON text into a buffer
#
# strings and object keys are escaped under ESCAPE_VERBATIM: '"', '\', and
# control bytes 0x00-0x1F are escaped (short escapes \b \t \n \f \r, else
# \u00xx); other bytes, including valid UTF-8, are written verbatim. str_val
# and keys are treated as logical bytes, so emitting a PARSED tree double-
# escapes any escapes the source contained -- see the file header (mach-std#340).
# ---
# v:   value to emit
# buf: destination buffer
# len: size of destination buffer in bytes
# ret: number of bytes written (may exceed len if buffer too small)
pub fun emit(v: *Value, buf: *u8, len: usize) usize {
    var b: BufWriter;
    b.data = buf;
    b.cap  = len;
    b.pos  = 0;
    var w: writer.Writer;
    w.ctx      = (?b)::ptr;
    w.f_write = bufw_write;
    # the counting sink accepts every byte, so the outcome is always ok
    write_value(?w, v);
    ret b.pos;
}

# emit a Value as JSON text through a writer
#
# the same rendering as emit, to any sink. the outcome is the writer's, with
# the bytes persisted before a failure in its payload.
# ---
# w:   the writer to emit through
# v:   value to emit
# ret: ok, or the writer's failure with the persisted prefix
pub fun write_value(w: *writer.Writer, v: *Value) err[WriteError] {
    var e: Emit = Emit{w: w, total: 0};
    ret emit_value(?e, v);
}

fun make_null() Value {
    var v: Value;
    v.kind = NULL;
    v.bool_val = 0;
    v.is_float = 0;
    v.num_val = 0;
    v.float_val = 0.0;
    v.str_val = nil;
    v.str_len = 0;
    v.children = nil;
    v.keys = nil;
    v.keys_len = nil;
    v.count = 0;
    v.cap = 0;
    ret v;
}

fun make_bool(b: u8) Value {
    var v: Value = make_null();
    v.kind = BOOL;
    v.bool_val = b;
    ret v;
}

fun make_number(n: i64) Value {
    var v: Value = make_null();
    v.kind = NUMBER;
    v.num_val = n;
    ret v;
}

fun make_float(f: f64) Value {
    var v: Value = make_null();
    v.kind = NUMBER;
    v.is_float = 1;
    v.float_val = f;
    ret v;
}

fun make_string(s: str, slen: usize) Value {
    var v: Value = make_null();
    v.kind = STRING;
    v.str_val = s;
    v.str_len = slen;
    ret v;
}

fun make_array() Value {
    var v: Value = make_null();
    v.kind = ARRAY;
    ret v;
}

fun make_object() Value {
    var v: Value = make_null();
    v.kind = OBJECT;
    ret v;
}

fun skip_ws(p: *Parser) {
    for (p.pos < p.len) {
        val c: u8 = p.src[p.pos];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
            p.pos = p.pos + 1;
        } or {
            ret;
        }
    }
}

fun syntax_at(pos: usize) res[Value, JsonError] {
    ret res[Value, JsonError].err{JsonError.syntax{pos}};
}

fun parse_value(p: *Parser, depth: usize) res[Value, JsonError] {
    skip_ws(p);
    if (p.pos >= p.len) { ret syntax_at(p.pos); }

    val c: u8 = p.src[p.pos];

    if (c == 'n') { ret parse_null(p); }
    if (c == 't' || c == 'f') { ret parse_bool(p); }
    if (c == '"') { ret parse_string(p); }
    if (c == '[') { ret parse_array(p, depth + 1); }
    if (c == '{') { ret parse_object(p, depth + 1); }
    if (c == '-' || (c >= '0' && c <= '9')) { ret parse_number(p); }

    ret syntax_at(p.pos);
}

fun parse_null(p: *Parser) res[Value, JsonError] {
    if (p.pos + 4 > p.len) { ret syntax_at(p.len); }
    if (p.src[p.pos] != 'n' || p.src[p.pos + 1] != 'u' || p.src[p.pos + 2] != 'l' || p.src[p.pos + 3] != 'l') {
        ret syntax_at(p.pos);
    }
    p.pos = p.pos + 4;
    ret res[Value, JsonError].ok{make_null()};
}

fun parse_bool(p: *Parser) res[Value, JsonError] {
    if (p.src[p.pos] == 't') {
        if (p.pos + 4 > p.len) { ret syntax_at(p.len); }
        if (p.src[p.pos + 1] != 'r' || p.src[p.pos + 2] != 'u' || p.src[p.pos + 3] != 'e') {
            ret syntax_at(p.pos);
        }
        p.pos = p.pos + 4;
        ret res[Value, JsonError].ok{make_bool(1)};
    }

    if (p.pos + 5 > p.len) { ret syntax_at(p.len); }
    if (p.src[p.pos + 1] != 'a' || p.src[p.pos + 2] != 'l' || p.src[p.pos + 3] != 's' || p.src[p.pos + 4] != 'e') {
        ret syntax_at(p.pos);
    }
    p.pos = p.pos + 5;
    ret res[Value, JsonError].ok{make_bool(0)};
}

# parse a JSON number (RFC 8259): optional minus, integer part, optional fraction
# and optional exponent. a number with a fraction or exponent yields a float
# value (parsed with correct rounding via parse_f64_len over the zero-copy span);
# an integer-looking number keeps yielding an i64, unchanged.
fun parse_number(p: *Parser) res[Value, JsonError] {
    val start: usize = p.pos;
    var neg: bool = false;
    var is_float: bool = false;

    if (p.src[p.pos] == '-') {
        neg = true;
        p.pos = p.pos + 1;
        if (p.pos >= p.len || p.src[p.pos] < '0' || p.src[p.pos] > '9') {
            ret syntax_at(p.pos);
        }
    }

    var n: i64 = 0;
    var has_digit: bool = false;
    for (p.pos < p.len && p.src[p.pos] >= '0' && p.src[p.pos] <= '9') {
        n = n * 10 + (p.src[p.pos] - '0')::i64;
        has_digit = true;
        p.pos = p.pos + 1;
    }

    if (!has_digit) { ret syntax_at(p.pos); }

    if (p.pos < p.len && p.src[p.pos] == '.') {
        is_float = true;
        p.pos = p.pos + 1;
        var frac_digit: bool = false;
        for (p.pos < p.len && p.src[p.pos] >= '0' && p.src[p.pos] <= '9') {
            frac_digit = true;
            p.pos = p.pos + 1;
        }
        if (!frac_digit) { ret syntax_at(p.pos); }
    }

    if (p.pos < p.len && (p.src[p.pos] == 'e' || p.src[p.pos] == 'E')) {
        is_float = true;
        p.pos = p.pos + 1;
        if (p.pos < p.len && (p.src[p.pos] == '+' || p.src[p.pos] == '-')) {
            p.pos = p.pos + 1;
        }
        var exp_digit: bool = false;
        for (p.pos < p.len && p.src[p.pos] >= '0' && p.src[p.pos] <= '9') {
            exp_digit = true;
            p.pos = p.pos + 1;
        }
        if (!exp_digit) { ret syntax_at(p.pos); }
    }

    if (is_float) {
        val span: str = (p.src::usize + start)::str;
        val fr: res[f64, ParseError] = parse_f64_len(span, p.pos - start);
        if (sel fr.err) {
            # the grammar above admits only what parse_f64_len accepts, so a
            # refusal here names the span it could not read
            ret syntax_at(start);
        }
        ret res[Value, JsonError].ok{make_float(fr.ok)};
    }

    if (neg) { n = 0 - n; }

    ret res[Value, JsonError].ok{make_number(n)};
}

fun parse_string(p: *Parser) res[Value, JsonError] {
    p.pos = p.pos + 1;
    val start: usize = p.pos;

    for (p.pos < p.len) {
        val c: u8 = p.src[p.pos];
        if (c == '\\') {
            if (p.pos + 1 >= p.len) { ret syntax_at(p.pos); }
            p.pos = p.pos + 2;
            cnt;
        }
        if (c == '"') {
            val slen: usize = p.pos - start;
            val sptr: str = (p.src::usize + start)::str;
            p.pos = p.pos + 1;
            ret res[Value, JsonError].ok{make_string(sptr, slen)};
        }
        p.pos = p.pos + 1;
    }

    ret syntax_at(p.len);
}

# double the children array (and, for an object, the parallel key arrays)
#
# a refused acquisition leaves the value exactly as it was; a growth that is
# refused part way releases what it acquired first.
fun grow(p: *Parser, v: *Value) err[JsonError] {
    var new_cap: usize = v.cap * 2;
    if (v.cap == 0) { new_cap = 4; }
    or (new_cap < v.cap) { ret err[JsonError].err{JsonError.alloc{allocator.Error.overflow{}}}; }

    val cr: res[*Value, allocator.Error] = allocator.allocate[Value](p.alloc, new_cap);
    if (sel cr.err) { ret err[JsonError].err{JsonError.alloc{cr.err}}; }
    val new_children: *Value = cr.ok;

    var new_keys: *str = nil;
    var new_lens: *usize = nil;
    if (v.kind == OBJECT) {
        val kr: res[*str, allocator.Error] = allocator.allocate[str](p.alloc, new_cap);
        if (sel kr.err) {
            allocator.deallocate[Value](p.alloc, new_children, new_cap);
            ret err[JsonError].err{JsonError.alloc{kr.err}};
        }
        new_keys = kr.ok;

        val lr: res[*usize, allocator.Error] = allocator.allocate[usize](p.alloc, new_cap);
        if (sel lr.err) {
            allocator.deallocate[str](p.alloc, new_keys, new_cap);
            allocator.deallocate[Value](p.alloc, new_children, new_cap);
            ret err[JsonError].err{JsonError.alloc{lr.err}};
        }
        new_lens = lr.ok;
    }

    if (v.count > 0) {
        raw_copy(new_children::ptr, v.children::ptr, v.count * $size_of(Value));
        if (v.kind == OBJECT) {
            raw_copy(new_keys::ptr, v.keys::ptr, v.count * $size_of(str));
            raw_copy(new_lens::ptr, v.keys_len::ptr, v.count * $size_of(usize));
        }
    }
    if (v.cap > 0) {
        allocator.deallocate[Value](p.alloc, v.children, v.cap);
        if (v.kind == OBJECT) {
            allocator.deallocate[str](p.alloc, v.keys, v.cap);
            allocator.deallocate[usize](p.alloc, v.keys_len, v.cap);
        }
    }

    v.children = new_children;
    v.keys = new_keys;
    v.keys_len = new_lens;
    v.cap = new_cap;
    ret err[JsonError].ok{};
}

# release a container built part way and report the failure
fun abandon(p: *Parser, v: *Value, e: JsonError) res[Value, JsonError] {
    dnit(p.alloc, v);
    ret res[Value, JsonError].err{e};
}

fun parse_array(p: *Parser, depth: usize) res[Value, JsonError] {
    if (depth > MAX_DEPTH) { ret res[Value, JsonError].err{JsonError.depth{p.pos}}; }
    p.pos = p.pos + 1;
    var v: Value = make_array();

    skip_ws(p);
    if (p.pos < p.len && p.src[p.pos] == ']') {
        p.pos = p.pos + 1;
        ret res[Value, JsonError].ok{v};
    }

    for (p.pos < p.len) {
        val elem: res[Value, JsonError] = parse_value(p, depth);
        if (sel elem.err) { ret abandon(p, ?v, elem.err); }

        if (v.count >= v.cap) {
            val gr: err[JsonError] = grow(p, ?v);
            if (sel gr.err) {
                var orphan: Value = elem.ok;
                dnit(p.alloc, ?orphan);
                ret abandon(p, ?v, gr.err);
            }
        }
        v.children[v.count] = elem.ok;
        v.count = v.count + 1;

        skip_ws(p);
        if (p.pos >= p.len) { ret abandon(p, ?v, JsonError.syntax{p.pos}); }
        if (p.src[p.pos] == ']') {
            p.pos = p.pos + 1;
            ret res[Value, JsonError].ok{v};
        }
        if (p.src[p.pos] != ',') { ret abandon(p, ?v, JsonError.syntax{p.pos}); }
        p.pos = p.pos + 1;
    }

    ret abandon(p, ?v, JsonError.syntax{p.pos});
}

fun parse_object(p: *Parser, depth: usize) res[Value, JsonError] {
    if (depth > MAX_DEPTH) { ret res[Value, JsonError].err{JsonError.depth{p.pos}}; }
    p.pos = p.pos + 1;
    var v: Value = make_object();

    skip_ws(p);
    if (p.pos < p.len && p.src[p.pos] == '}') {
        p.pos = p.pos + 1;
        ret res[Value, JsonError].ok{v};
    }

    for (p.pos < p.len) {
        skip_ws(p);
        if (p.pos >= p.len || p.src[p.pos] != '"') { ret abandon(p, ?v, JsonError.syntax{p.pos}); }

        val key_res: res[Value, JsonError] = parse_string(p);
        if (sel key_res.err) { ret abandon(p, ?v, key_res.err); }
        val key_val: Value = key_res.ok;

        skip_ws(p);
        if (p.pos >= p.len || p.src[p.pos] != ':') { ret abandon(p, ?v, JsonError.syntax{p.pos}); }
        p.pos = p.pos + 1;

        val val_res: res[Value, JsonError] = parse_value(p, depth);
        if (sel val_res.err) { ret abandon(p, ?v, val_res.err); }

        if (v.count >= v.cap) {
            val gr: err[JsonError] = grow(p, ?v);
            if (sel gr.err) {
                var orphan: Value = val_res.ok;
                dnit(p.alloc, ?orphan);
                ret abandon(p, ?v, gr.err);
            }
        }

        v.keys[v.count] = key_val.str_val;
        v.keys_len[v.count] = key_val.str_len;
        v.children[v.count] = val_res.ok;
        v.count = v.count + 1;

        skip_ws(p);
        if (p.pos >= p.len) { ret abandon(p, ?v, JsonError.syntax{p.pos}); }
        if (p.src[p.pos] == '}') {
            p.pos = p.pos + 1;
            ret res[Value, JsonError].ok{v};
        }
        if (p.src[p.pos] != ',') { ret abandon(p, ?v, JsonError.syntax{p.pos}); }
        p.pos = p.pos + 1;
    }

    ret abandon(p, ?v, JsonError.syntax{p.pos});
}

# a counting writer over a fixed buffer: copies the bytes that fit and counts
# every requested byte, so emit() can report the length a full render needs even
# when the buffer is too small.
# ---
# data: destination buffer
# cap:  buffer capacity
# pos:  bytes requested so far (the render length; may exceed cap)
rec BufWriter {
    data: *u8;
    cap:  usize;
    pos:  usize;
}

# append one byte to a BufWriter, counting it whether or not it fits
fun bufw_put(b: *BufWriter, c: u8) {
    if (b.pos < b.cap) { b.data[b.pos] = c; }
    b.pos = b.pos + 1;
}

# writer callback for BufWriter: copies the bytes that fit and advances pos by
# the full request, always reporting a complete write.
fun bufw_write(ctx: ptr, buf: *u8, len: usize) res[usize, WriteError] {
    val s: *BufWriter = ctx::*BufWriter;
    var i: usize = 0;
    for (i < len) {
        bufw_put(s, buf[i]);
        i = i + 1;
    }
    ret res[usize, WriteError].ok{len};
}

# a writer and the bytes this emission has persisted through it so far
#
# every emitting function writes through one of these, so a failure anywhere
# in a call reports the whole prefix that call persisted, however deep the
# write that failed.
rec Emit {
    w:     *writer.Writer;
    total: usize;
}

# write bytes, adding to the running total or rebasing the failure onto it
fun put(e: *Emit, buf: *u8, len: usize) err[WriteError] {
    val r: res[usize, WriteError] = format.write_bytes(e.w, buf, len);
    if (sel r.err) { ret err[WriteError].err{writer.advance(r.err, e.total)}; }
    e.total = e.total + r.ok;
    ret err[WriteError].ok{};
}

fun put_str(e: *Emit, s: str) err[WriteError] {
    val r: res[usize, WriteError] = format.write_str(e.w, s);
    if (sel r.err) { ret err[WriteError].err{writer.advance(r.err, e.total)}; }
    e.total = e.total + r.ok;
    ret err[WriteError].ok{};
}

fun put_byte(e: *Emit, c: u8) err[WriteError] {
    val x: u8 = c;
    ret put(e, ?x, 1);
}

fun put_i64(e: *Emit, v: i64) err[WriteError] {
    val r: res[usize, WriteError] = format.write_i64(e.w, v);
    if (sel r.err) { ret err[WriteError].err{writer.advance(r.err, e.total)}; }
    e.total = e.total + r.ok;
    ret err[WriteError].ok{};
}

fun put_f64(e: *Emit, v: f64) err[WriteError] {
    val r: res[usize, WriteError] = format.write_f64(e.w, v);
    if (sel r.err) { ret err[WriteError].err{writer.advance(r.err, e.total)}; }
    e.total = e.total + r.ok;
    ret err[WriteError].ok{};
}

# the escape policy for a JSON string body: how bytes >= 0x80 are rendered
def EscapePolicy: u8;

# structural-utf8-verbatim: escape '"', '\', and the C0 controls only; every
# other byte, including UTF-8 lead/continuation bytes, passes through verbatim.
val ESCAPE_VERBATIM: EscapePolicy = 0;

# ensure-ascii: as ESCAPE_VERBATIM for bytes < 0x80, but each byte >= 0x80 is
# UTF-8 decoded and emitted as a \uXXXX escape (U+FFFD on invalid input), so
# every emitted byte is printable ASCII.
val ESCAPE_ENSURE_ASCII: EscapePolicy = 1;

# escape one code unit of `s` starting at `i` as a JSON string body, returning
# the next byte index.
#
# '"', '\', and the C0 controls become their short or \u00XX escapes; printable
# ASCII passes through verbatim. a byte >= 0x80 passes through verbatim under
# ESCAPE_VERBATIM, or begins a UTF-8 sequence decoded to a \uXXXX escape under
# ESCAPE_ENSURE_ASCII. under ESCAPE_ENSURE_ASCII `s` must be null-terminated or
# hold its continuation bytes within bounds, since a multi-byte decode reads
# past `i`; a NUL or bad byte resynchronizes as one U+FFFD escape.
# ---
# e:      the emission to write through
# policy: the escape policy
# s:      the source bytes
# i:      the byte index to escape
# ret:    the index of the next byte to process, or the writer's failure
fun escape_unit(e: *Emit, policy: EscapePolicy, s: *u8, i: usize) res[usize, WriteError] {
    val c: u8 = s[i];
    var wr: err[WriteError];
    var next: usize = i + 1;
    if (c == '"')  { wr = put_str(e, "\\\""); }
    or (c == '\\') { wr = put_str(e, "\\\\"); }
    or (c == 0x08) { wr = put_str(e, "\\b"); }
    or (c == 0x09) { wr = put_str(e, "\\t"); }
    or (c == 0x0a) { wr = put_str(e, "\\n"); }
    or (c == 0x0c) { wr = put_str(e, "\\f"); }
    or (c == 0x0d) { wr = put_str(e, "\\r"); }
    or (c < 0x20)  { wr = write_u_hex(e, c::u32); }
    or (c < 0x80)  { wr = put_byte(e, c); }
    or (policy == ESCAPE_VERBATIM) { wr = put_byte(e, c); }
    or { ret write_utf8_escape(e, s, i); }
    if (sel wr.err) { ret res[usize, WriteError].err{wr.err}; }
    ret res[usize, WriteError].ok{next};
}

# escape s[0..slen) as a JSON string body (no surrounding quotes) under policy
fun escape_bytes(e: *Emit, policy: EscapePolicy, s: *u8, slen: usize) err[WriteError] {
    var i: usize = 0;
    for (i < slen) {
        val r: res[usize, WriteError] = escape_unit(e, policy, s, i);
        if (sel r.err) { ret err[WriteError].err{r.err}; }
        i = r.ok;
    }
    ret err[WriteError].ok{};
}

# decode the UTF-8 sequence at `i` and emit it as a \uXXXX escape, returning the
# index past the sequence.
#
# Full RFC 3629 validation: the lead byte fixes the length and the first
# continuation byte's allowed range, which together reject overlong encodings
# (0xC0/0xC1, 0xE0 80-9F, 0xF0 80-8F), the UTF-16 surrogate range (0xED A0-BF),
# and code points above U+10FFFF (0xF4 90-BF); invalid lead bytes (0x80-0xBF,
# 0xF5-0xFF) and any bad or truncated continuation are rejected too. A rejected
# sequence emits the U+FFFD replacement escape and consumes exactly one byte, so
# the scan resynchronizes on the next byte.
# ---
# e: the emission to write through
# s: the source (a NUL terminates any truncated sequence)
# i: the index of the sequence's lead byte (>= 0x80)
# ret: the index of the next byte to process, or the writer's failure
fun write_utf8_escape(e: *Emit, s: *u8, i: usize) res[usize, WriteError] {
    val b0: u8 = s[i];

    # length, plus the tightened [lo, hi] range for the first continuation byte
    # that pins overlong / surrogate / out-of-range sequences to their lead.
    var len: usize = 0;
    var lo:  u8    = 0x80;
    var hi:  u8    = 0xBF;
    var cp:  u32   = 0;
    if (b0 >= 0xC2 && b0 <= 0xDF) { len = 2; cp = (b0 & 0x1F)::u32; }
    or (b0 == 0xE0)               { len = 3; lo = 0xA0; cp = (b0 & 0x0F)::u32; }
    or (b0 >= 0xE1 && b0 <= 0xEC) { len = 3; cp = (b0 & 0x0F)::u32; }
    or (b0 == 0xED)               { len = 3; hi = 0x9F; cp = (b0 & 0x0F)::u32; }
    or (b0 >= 0xEE && b0 <= 0xEF) { len = 3; cp = (b0 & 0x0F)::u32; }
    or (b0 == 0xF0)               { len = 4; lo = 0x90; cp = (b0 & 0x07)::u32; }
    or (b0 >= 0xF1 && b0 <= 0xF3) { len = 4; cp = (b0 & 0x07)::u32; }
    or (b0 == 0xF4)               { len = 4; hi = 0x8F; cp = (b0 & 0x07)::u32; }
    or {
        val bad: err[WriteError] = write_u_hex(e, 0xFFFD);
        if (sel bad.err) { ret res[usize, WriteError].err{bad.err}; }
        ret res[usize, WriteError].ok{i + 1};
    }

    var k: usize = 1;
    var j: usize = i + 1;
    for (k < len) {
        val cb: u8 = s[j];
        # the first continuation byte carries the tightened range; the rest span
        # the full 0x80-0xBF. a NUL (truncated sequence) fails the lower bound.
        var clo: u8 = 0x80;
        var chi: u8 = 0xBF;
        if (k == 1) { clo = lo; chi = hi; }
        if (cb < clo || cb > chi) {
            val bad: err[WriteError] = write_u_hex(e, 0xFFFD);
            if (sel bad.err) { ret res[usize, WriteError].err{bad.err}; }
            ret res[usize, WriteError].ok{i + 1};
        }
        cp = (cp << 6) | (cb & 0x3F)::u32;
        j  = j + 1;
        k  = k + 1;
    }

    val wr: err[WriteError] = write_codepoint(e, cp);
    if (sel wr.err) { ret res[usize, WriteError].err{wr.err}; }
    ret res[usize, WriteError].ok{i + len};
}

# emit a valid Unicode scalar as a \uXXXX escape, or a surrogate pair when
# astral.
#
# `cp` is a validated scalar (U+0000-U+10FFFF, never a surrogate), so the astral
# branch always yields a well-formed high/low surrogate pair.
# ---
# e:  the emission to write through
# cp: the Unicode scalar value
fun write_codepoint(e: *Emit, cp: u32) err[WriteError] {
    if (cp <= 0xFFFF) { ret write_u_hex(e, cp); }
    val v:  u32 = cp - 0x10000;
    val hi: u32 = 0xD800 + (v >> 10);
    val lo: u32 = 0xDC00 + (v & 0x3FF);
    val first: err[WriteError] = write_u_hex(e, hi);
    if (sel first.err) { ret first; }
    ret write_u_hex(e, lo);
}

# emit a \u escape for a 16-bit value
# ---
# e:    the emission to write through
# code: the 16-bit value (only the low 16 bits are used)
fun write_u_hex(e: *Emit, code: u32) err[WriteError] {
    var esc: [6]u8;
    esc[0] = '\\';
    esc[1] = 'u';
    esc[2] = hex_digit((code >> 12) & 0xF);
    esc[3] = hex_digit((code >> 8) & 0xF);
    esc[4] = hex_digit((code >> 4) & 0xF);
    esc[5] = hex_digit(code & 0xF);
    ret put(e, ?esc[0], 6);
}

# map a nibble (0-15) to its lowercase hexadecimal ASCII digit
# ---
# n:   the nibble value
# ret: the ASCII digit byte
fun hex_digit(n: u32) u8 {
    if (n < 10) { ret n::u8 + '0'; }
    ret n::u8 - 10 + 'a';
}

# decode s[0..slen) -- the raw wire bytes of a JSON string body, escapes intact
# -- into logical bytes written into b. See value_string_decode for the escape
# matrix and the malformed-escape contract.
# ---
# b:    the counting buffer to decode into
# s:    the raw string bytes
# slen: the byte length of s
# ret:  ok, or syntax at the offset of a malformed escape
fun decode_bytes(b: *BufWriter, s: *u8, slen: usize) err[JsonError] {
    var i: usize = 0;
    for (i < slen) {
        val ir: res[usize, JsonError] = decode_unit(b, s, i, slen);
        if (sel ir.err) { ret err[JsonError].err{ir.err}; }
        i = ir.ok;
    }
    ret err[JsonError].ok{};
}

fun malformed(at: usize) res[usize, JsonError] {
    ret res[usize, JsonError].err{JsonError.syntax{at}};
}

# decode one unit of `s` starting at `i` -- a verbatim byte or an escape sequence
# -- writing the logical bytes into b and returning the next byte index.
# ---
# b:    the counting buffer to decode into
# s:    the raw string bytes
# i:    the byte index to decode
# slen: the byte length of s
# ret:  the index of the next byte, or syntax at the malformed escape
fun decode_unit(b: *BufWriter, s: *u8, i: usize, slen: usize) res[usize, JsonError] {
    val c: u8 = s[i];
    if (c != '\\') {
        bufw_put(b, c);
        ret res[usize, JsonError].ok{i + 1};
    }
    if (i + 1 >= slen) { ret malformed(i); }
    val e: u8 = s[i + 1];
    if (e == '"')  { bufw_put(b, '"');  ret res[usize, JsonError].ok{i + 2}; }
    if (e == '\\') { bufw_put(b, '\\'); ret res[usize, JsonError].ok{i + 2}; }
    if (e == '/')  { bufw_put(b, '/');  ret res[usize, JsonError].ok{i + 2}; }
    if (e == 'b')  { bufw_put(b, 0x08); ret res[usize, JsonError].ok{i + 2}; }
    if (e == 'f')  { bufw_put(b, 0x0c); ret res[usize, JsonError].ok{i + 2}; }
    if (e == 'n')  { bufw_put(b, 0x0a); ret res[usize, JsonError].ok{i + 2}; }
    if (e == 'r')  { bufw_put(b, 0x0d); ret res[usize, JsonError].ok{i + 2}; }
    if (e == 't')  { bufw_put(b, 0x09); ret res[usize, JsonError].ok{i + 2}; }
    if (e == 'u')  { ret decode_u_escape(b, s, i, slen); }
    ret malformed(i + 1);
}

# decode a '\uXXXX' escape at `i` (the backslash) into UTF-8 written into b,
# combining a high+low surrogate pair into one astral code point. Returns the
# index past the escape (or the pair), or syntax on truncated/non-hex digits or
# an ill-formed surrogate pair.
# ---
# b:    the counting buffer to decode into
# s:    the raw string bytes
# i:    the index of the escape's backslash
# slen: the byte length of s
# ret:  the index of the next byte, or syntax at the malformed escape
fun decode_u_escape(b: *BufWriter, s: *u8, i: usize, slen: usize) res[usize, JsonError] {
    val hr: res[u32, JsonError] = read_hex4(s, i + 2, slen);
    if (sel hr.err) { ret res[usize, JsonError].err{hr.err}; }
    val u: u32 = hr.ok;

    if (u >= 0xD800 && u <= 0xDBFF) {
        val j: usize = i + 6;
        if (j + 1 >= slen || s[j] != '\\' || s[j + 1] != 'u') { ret malformed(j); }
        val lr: res[u32, JsonError] = read_hex4(s, j + 2, slen);
        if (sel lr.err) { ret res[usize, JsonError].err{lr.err}; }
        val lo: u32 = lr.ok;
        if (lo < 0xDC00 || lo > 0xDFFF) { ret malformed(j); }
        val cp: u32 = 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00);
        write_utf8_bytes(b, cp);
        ret res[usize, JsonError].ok{j + 6};
    }

    if (u >= 0xDC00 && u <= 0xDFFF) { ret malformed(i); }

    write_utf8_bytes(b, u);
    ret res[usize, JsonError].ok{i + 6};
}

# read the four hex digits of a '\uXXXX' escape starting at `i` (the first digit),
# returning the 16-bit value.
# ---
# s:    the raw string bytes
# i:    the index of the first hex digit
# slen: the byte length of s
# ret:  the decoded 16-bit value, or syntax at the truncation or non-hex digit
fun read_hex4(s: *u8, i: usize, slen: usize) res[u32, JsonError] {
    if (i + 4 > slen) { ret res[u32, JsonError].err{JsonError.syntax{slen}}; }
    var v: u32 = 0;
    var k: usize = 0;
    for (k < 4) {
        val d: u32 = hex_nibble(s[i + k]);
        if (d > 0xF) { ret res[u32, JsonError].err{JsonError.syntax{i + k}}; }
        v = (v << 4) | d;
        k = k + 1;
    }
    ret res[u32, JsonError].ok{v};
}

# map a hex ASCII digit to its 0-15 value, or 0x100 if the byte is not hex
# ---
# c:   the candidate hex digit byte
# ret: the nibble value, or 0x100 for a non-hex byte
fun hex_nibble(c: u8) u32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::u32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a' + 10)::u32; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A' + 10)::u32; }
    ret 0x100;
}

# encode a validated scalar (never a surrogate, <= U+10FFFF) as UTF-8 bytes
# written into b.
# ---
# b:  the counting buffer to write into
# cp: the Unicode scalar value
fun write_utf8_bytes(b: *BufWriter, cp: u32) {
    var tmp: [4]u8;
    val n: usize = utf8.encode(cp::utf8.Codepoint, ?tmp[0], 4);
    var i: usize = 0;
    for (i < n) {
        bufw_put(b, tmp[i]);
        i = i + 1;
    }
}

fun emit_value(e: *Emit, v: *Value) err[WriteError] {
    if (v.kind == NULL) { ret put_str(e, "null"); }

    if (v.kind == BOOL) {
        if (v.bool_val != 0) { ret put_str(e, "true"); }
        ret put_str(e, "false");
    }

    if (v.kind == NUMBER) {
        if (v.is_float != 0) { ret put_f64(e, v.float_val); }
        ret put_i64(e, v.num_val);
    }

    if (v.kind == STRING) {
        val open: err[WriteError] = put_byte(e, '"');
        if (sel open.err) { ret open; }
        val body: err[WriteError] = escape_bytes(e, ESCAPE_VERBATIM, v.str_val::*u8, v.str_len);
        if (sel body.err) { ret body; }
        ret put_byte(e, '"');
    }

    if (v.kind == ARRAY) {
        val open: err[WriteError] = put_byte(e, '[');
        if (sel open.err) { ret open; }
        var i: usize = 0;
        for (i < v.count) {
            if (i > 0) {
                val sep: err[WriteError] = put_byte(e, ',');
                if (sel sep.err) { ret sep; }
            }
            val elem: err[WriteError] = emit_value(e, ?v.children[i]);
            if (sel elem.err) { ret elem; }
            i = i + 1;
        }
        ret put_byte(e, ']');
    }

    if (v.kind == OBJECT) {
        val open: err[WriteError] = put_byte(e, '{');
        if (sel open.err) { ret open; }
        var i: usize = 0;
        for (i < v.count) {
            if (i > 0) {
                val sep: err[WriteError] = put_byte(e, ',');
                if (sel sep.err) { ret sep; }
            }
            val q1: err[WriteError] = put_byte(e, '"');
            if (sel q1.err) { ret q1; }
            val key: err[WriteError] = escape_bytes(e, ESCAPE_VERBATIM, v.keys[i]::*u8, v.keys_len[i]);
            if (sel key.err) { ret key; }
            val q2: err[WriteError] = put_str(e, "\":");
            if (sel q2.err) { ret q2; }
            val elem: err[WriteError] = emit_value(e, ?v.children[i]);
            if (sel elem.err) { ret elem; }
            i = i + 1;
        }
        ret put_byte(e, '}');
    }

    ret err[WriteError].ok{};
}

# an open JSON object in the streaming NDJSON emitter, tracking the comma
# boundary between its members.
# ---
# w:     the writer the object is emitted through (borrowed)
# first: no member has been emitted into the object yet
pub rec Object {
    w:     *writer.Writer;
    first: bool;
}

# an open JSON array in the streaming NDJSON emitter, tracking the comma
# boundary between its elements.
# ---
# w:     the writer the array is emitted through (borrowed)
# first: no element has been emitted into the array yet
pub rec Array {
    w:     *writer.Writer;
    first: bool;
}

# begin a JSON object, writing `{` and arming the first-member
# state.
# ---
# w:   the writer to emit through (must outlive the object)
# o:   the object state to initialise
# ret: ok, or the writer's failure with the persisted prefix
pub fun object_begin(w: *writer.Writer, o: *Object) err[WriteError] {
    o.w     = w;
    o.first = true;
    var e: Emit = Emit{w: w, total: 0};
    ret put_byte(?e, '{');
}

# end a JSON object, writing `}` and the newline that terminates the
# NDJSON line.
# ---
# o:   the object to close
# ret: ok, or the writer's failure with the persisted prefix
pub fun object_end(o: *Object) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    ret put_str(?e, "}\n");
}

# close a nested object, writing `}` without the NDJSON line
# terminator.
#
# Used for an object that is a member value or an array element, where the
# enclosing container - not this object - owns the line boundary.
# ---
# o:   the object to close
# ret: ok, or the writer's failure with the persisted prefix
pub fun object_end_value(o: *Object) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    ret put_byte(?e, '}');
}

# open an object-valued member: the key lead-in, then `{`,
# arming `child` over the parent's writer.
#
# Fill `child` with the field_* helpers and close it with object_end_value; the
# parent stays open and takes further members afterwards.
# ---
# o:     the open parent object
# key:   the member key
# child: the nested object state to initialise
# ret:   ok, or the writer's failure with the persisted prefix
pub fun field_object_begin(o: *Object, key: *u8, child: *Object) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    child.w     = o.w;
    child.first = true;
    ret put_byte(?e, '{');
}

# open an array-valued member: the key lead-in, then `[`,
# arming `arr` over the parent's writer. Close it with array_end.
# ---
# o:   the open parent object
# key: the member key
# arr: the array state to initialise
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_array_begin(o: *Object, key: *u8, arr: *Array) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    arr.w     = o.w;
    arr.first = true;
    ret put_byte(?e, '[');
}

# close an array, writing `]`
# ---
# arr: the array to close
# ret: ok, or the writer's failure with the persisted prefix
pub fun array_end(arr: *Array) err[WriteError] {
    var e: Emit = Emit{w: arr.w, total: 0};
    ret put_byte(?e, ']');
}

# open an object element of `arr`: the element separator,
# then `{`, arming `child` over the array's writer.
#
# Fill `child` with the field_* helpers and close it with object_end_value.
# ---
# arr:   the open array
# child: the element object state to initialise
# ret:   ok, or the writer's failure with the persisted prefix
pub fun array_object_begin(arr: *Array, child: *Object) err[WriteError] {
    var e: Emit = Emit{w: arr.w, total: 0};
    if (!arr.first) {
        val sep: err[WriteError] = put_byte(?e, ',');
        if (sel sep.err) { ret sep; }
    }
    arr.first = false;
    child.w     = arr.w;
    child.first = true;
    ret put_byte(?e, '{');
}

# emit a string-valued member (the value quoted and ASCII-escaped)
# ---
# o:   the open object
# key: the member key (ASCII, emitted verbatim between quotes)
# v:   the null-terminated value, escaped; nil emits an empty string
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_str(o: *Object, key: *u8, v: *u8) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    ret json_string(?e, v);
}

# emit a string-or-null member: the escaped value, or JSON
# `null` when `v` is nil.
# ---
# o:   the open object
# key: the member key
# v:   the null-terminated value, or nil for a JSON null
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_str_or_null(o: *Object, key: *u8, v: *u8) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    if (v == nil) { ret put_str(?e, "null"); }
    ret json_string(?e, v);
}

# emit a JSON `null`-valued member
# ---
# o:   the open object
# key: the member key
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_null(o: *Object, key: *u8) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    ret put_str(?e, "null");
}

# emit an integer-valued member
# ---
# o:   the open object
# key: the member key
# v:   the integer value
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_i64(o: *Object, key: *u8, v: i64) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    ret put_i64(?e, v);
}

# emit a float-valued member
#
# the value is written as the shortest decimal that round-trips through the
# parser (value_float). an integer-valued float emits without a fractional part,
# so the parser reads it back as an integer number (value_is_float false); read
# it with value_number in that case.
# ---
# o:   the open object
# key: the member key
# v:   the float value
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_f64(o: *Object, key: *u8, v: f64) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    ret put_f64(?e, v);
}

# emit a boolean-valued member
# ---
# o:   the open object
# key: the member key
# v:   the boolean value
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_bool(o: *Object, key: *u8, v: bool) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    if (v) { ret put_str(?e, "true"); }
    ret put_str(?e, "false");
}

# write a bare JSON float number through the writer
#
# emits the shortest decimal that round-trips through the parser (value_float),
# with no key or surrounding container - the value equivalent of
# write_json_string for a float, for use as an array element or standalone
# value. an integer-valued float emits without a fractional part.
# ---
# w:   the writer to emit through
# v:   the float value
# ret: ok, or the writer's failure with the persisted prefix
pub fun value_f64(w: *writer.Writer, v: f64) err[WriteError] {
    var e: Emit = Emit{w: w, total: 0};
    ret put_f64(?e, v);
}

# write a JSON string literal under ESCAPE_ENSURE_ASCII: the
# value quoted, every byte escaped to printable ASCII.
# ---
# w:   the writer to emit through
# s:   the null-terminated value, or nil for an empty string
# ret: ok, or the writer's failure with the persisted prefix
pub fun write_json_string(w: *writer.Writer, s: *u8) err[WriteError] {
    var e: Emit = Emit{w: w, total: 0};
    ret json_string(?e, s);
}

fun json_string(e: *Emit, s: *u8) err[WriteError] {
    val open: err[WriteError] = put_byte(e, '"');
    if (sel open.err) { ret open; }
    if (s != nil) {
        var i: usize = 0;
        for (s[i] != 0) {
            val r: res[usize, WriteError] = escape_unit(e, ESCAPE_ENSURE_ASCII, s, i);
            if (sel r.err) { ret err[WriteError].err{r.err}; }
            i = r.ok;
        }
    }
    ret put_byte(e, '"');
}

# write the key/colon lead-in of a member, prefixing a comma after the first
# ---
# e:   the emission to write through
# o:   the open object
# key: the member key (ASCII, emitted verbatim)
fun member(e: *Emit, o: *Object, key: *u8) err[WriteError] {
    if (!o.first) {
        val sep: err[WriteError] = put_byte(e, ',');
        if (sel sep.err) { ret sep; }
    }
    o.first = false;
    val q1: err[WriteError] = put_byte(e, '"');
    if (sel q1.err) { ret q1; }
    val k: err[WriteError] = put_str(e, key::str);
    if (sel k.err) { ret k; }
    ret put_str(e, "\":");
}

use std.allocator.page;

test "json: parse null" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "null";
    val r: res[Value, JsonError] = parse(src::*u8, 4, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != NULL) { ret 1; }
    ret 0;
}

test "json: parse true" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "true";
    val r: res[Value, JsonError] = parse(src::*u8, 4, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != BOOL) { ret 1; }
    if (v.bool_val != 1) { ret 1; }
    ret 0;
}

test "json: parse false" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "false";
    val r: res[Value, JsonError] = parse(src::*u8, 5, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != BOOL) { ret 1; }
    if (v.bool_val != 0) { ret 1; }
    ret 0;
}

