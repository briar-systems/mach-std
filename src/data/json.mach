    val v: Value = r.ok;
    if (v.kind != NUMBER) { ret 1; }
    if (v.num_val != -7) { ret 1; }
    ret 0;
}

test "json: parse zero" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "0";
    val r: res[Value, JsonError] = parse(src::*u8, 1, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != NUMBER) { ret 1; }
    if (v.num_val != 0) { ret 1; }
    ret 0;
}

test "json: parse string" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "\"hello\"";
    val r: res[Value, JsonError] = parse(src::*u8, 7, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != STRING) { ret 1; }
    if (v.str_len != 5) { ret 1; }
    val sp: *u8 = v.str_val::*u8;
    if (sp[0] != 'h') { ret 1; }
    if (sp[4] != 'o') { ret 1; }
    ret 0;
}

test "json: parse empty array" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "[]";
    val r: res[Value, JsonError] = parse(src::*u8, 2, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != ARRAY) { ret 1; }
    if (v.count != 0) { ret 1; }
    ret 0;
}

test "json: parse array with elements" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "[1,2,3]";
    val r: res[Value, JsonError] = parse(src::*u8, 7, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != ARRAY) { ret 1; }
    if (v.count != 3) { ret 1; }
    if (v.children[0].num_val != 1) { ret 1; }
    if (v.children[1].num_val != 2) { ret 1; }
    if (v.children[2].num_val != 3) { ret 1; }
    ret 0;
}

test "json: parse empty object" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "{}";
    val r: res[Value, JsonError] = parse(src::*u8, 2, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != OBJECT) { ret 1; }
    if (v.count != 0) { ret 1; }
    ret 0;
}

test "json: parse object with entry" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "{\"a\":1}";
    val r: res[Value, JsonError] = parse(src::*u8, 7, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != OBJECT) { ret 1; }
    if (v.count != 1) { ret 1; }
    if (v.children[0].num_val != 1) { ret 1; }
    ret 0;
}

test "json: parse nested object with array" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "{\"x\":[1,2]}";
    val r: res[Value, JsonError] = parse(src::*u8, 11, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != OBJECT) { ret 1; }
    if (v.count != 1) { ret 1; }
    val arr: *Value = ?v.children[0];
    if (arr.kind != ARRAY) { ret 1; }
    if (arr.count != 2) { ret 1; }
    if (arr.children[0].num_val != 1) { ret 1; }
    if (arr.children[1].num_val != 2) { ret 1; }
    ret 0;
}

test "json: value_find on object" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "{\"a\":1,\"b\":2}";
    val r: res[Value, JsonError] = parse(src::*u8, 13, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    val found: opt[*Value] = value_find(?v, "b");
    if (sel found.none) { ret 1; }
    if (found.some.num_val != 2) { ret 1; }
    val missing: opt[*Value] = value_find(?v, "z");
    if (sel missing.some) { ret 1; }
    ret 0;
}

# an index past the last child, a key past the last entry, and a lookup on a
# value that is not an object are all absence
test "json: value_get, value_key and value_find answer none for absence" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "{\"a\":[1,2],\"b\":2}";
    val r: res[Value, JsonError] = parse(src::*u8, 17, ?a);
    if (sel r.err) { ret 1; }
    var v: Value = r.ok;
    fin { dnit(?a, ?v); }

    val first: opt[*Value] = value_get(?v, 0);
    if (sel first.none) { ret 2; }
    if (!value_is_array(first.some)) { ret 3; }
    val past: opt[*Value] = value_get(?v, 2);
    if (sel past.some) { ret 4; }

    val key: opt[str] = value_key(?v, 1);
    if (sel key.none) { ret 5; }
    if (key.some[0] != 'b' || value_key_len(?v, 1) != 1) { ret 6; }
    val no_key: opt[str] = value_key(?v, 2);
    if (sel no_key.some) { ret 7; }

    val arr: opt[*Value] = value_get(?v, 0);
    if (sel arr.none) { ret 8; }
    val elem: opt[*Value] = value_get(arr.some, 1);
    if (sel elem.none) { ret 9; }
    if (value_number(elem.some) != 2) { ret 10; }
    val no_elem: opt[*Value] = value_get(arr.some, 2);
    if (sel no_elem.some) { ret 11; }
    val array_key: opt[str] = value_key(arr.some, 0);
    if (sel array_key.some) { ret 12; }
    val array_find: opt[*Value] = value_find(arr.some, "a");
    if (sel array_find.some) { ret 13; }
    ret 0;
}

test "json: emit null" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "null";
    val r: res[Value, JsonError] = parse(src::*u8, 4, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    var buf: [16]u8;
    val n: usize = emit(?v, ?buf[0], 16);
    if (n != 4) { ret 1; }
    if (buf[0] != 'n') { ret 1; }
    if (buf[1] != 'u') { ret 1; }
    if (buf[2] != 'l') { ret 1; }
    if (buf[3] != 'l') { ret 1; }
    ret 0;
}

test "json: emit number" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "123";
    val r: res[Value, JsonError] = parse(src::*u8, 3, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    var buf: [16]u8;
    val n: usize = emit(?v, ?buf[0], 16);
    if (n != 3) { ret 1; }
    if (buf[0] != '1') { ret 1; }
    if (buf[1] != '2') { ret 1; }
    if (buf[2] != '3') { ret 1; }
    ret 0;
}

test "json: emit true" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "true";
    val r: res[Value, JsonError] = parse(src::*u8, 4, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    var buf: [16]u8;
    val n: usize = emit(?v, ?buf[0], 16);
    if (n != 4) { ret 1; }
    if (buf[0] != 't') { ret 1; }
    if (buf[3] != 'e') { ret 1; }
    ret 0;
}

test "json: roundtrip array" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "[1,2,3]";
    val r: res[Value, JsonError] = parse(src::*u8, 7, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    var buf: [32]u8;
    val n: usize = emit(?v, ?buf[0], 32);
    if (n != 7) { ret 1; }
    if (buf[0] != '[') { ret 1; }
    if (buf[1] != '1') { ret 1; }
    if (buf[2] != ',') { ret 1; }
    if (buf[3] != '2') { ret 1; }
    if (buf[6] != ']') { ret 1; }
    ret 0;
}

test "json: roundtrip object keys" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "{\"a\":1,\"b\":2}";
    val r: res[Value, JsonError] = parse(src::*u8, 13, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    var buf: [32]u8;
    val n: usize = emit(?v, ?buf[0], 32);
    if (n != 13) { ret 1; }
    var i: usize = 0;
    for (i < 13) {
        if (buf[i] != src[i]::u8) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "json: whitespace tolerance" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "  { \"a\" : 1 } ";
    val r: res[Value, JsonError] = parse(src::*u8, 14, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != OBJECT) { ret 1; }
    if (v.count != 1) { ret 1; }
    ret 0;
}

test "json: emit escapes quotes and backslashes" {
    # logical string: a"b\c
    var raw: [5]u8 = [5]u8{'a', '"', 'b', '\\', 'c'};
    val v: Value = make_string(((?raw[0])::usize)::str, 5);
    var buf: [16]u8;
    val n: usize = emit(?v, ?buf[0], 16);
    # expected: "a\"b\\c" (9 bytes)
    if (n != 9) { ret 1; }
    if (buf[0] != '"')  { ret 1; }
    if (buf[1] != 'a')  { ret 1; }
    if (buf[2] != '\\') { ret 1; }
    if (buf[3] != '"')  { ret 1; }
    if (buf[4] != 'b')  { ret 1; }
    if (buf[5] != '\\') { ret 1; }
    if (buf[6] != '\\') { ret 1; }
    if (buf[7] != 'c')  { ret 1; }
    if (buf[8] != '"')  { ret 1; }
    ret 0;
}

test "json: emit escapes control bytes" {
    # logical: 0x08 0x09 0x0a 0x0c 0x0d 0x01
    var raw: [6]u8 = [6]u8{0x08, 0x09, 0x0a, 0x0c, 0x0d, 0x01};
    val v: Value = make_string(((?raw[0])::usize)::str, 6);
    var buf: [32]u8;
    val n: usize = emit(?v, ?buf[0], 32);
    # expected: "\b\t\n\f\r" (18 bytes)
    if (n != 18) { ret 1; }
    if (buf[0]  != '"')  { ret 1; }
    if (buf[1]  != '\\') { ret 1; }
    if (buf[2]  != 'b')  { ret 1; }
    if (buf[3]  != '\\') { ret 1; }
    if (buf[4]  != 't')  { ret 1; }
    if (buf[5]  != '\\') { ret 1; }
    if (buf[6]  != 'n')  { ret 1; }
    if (buf[7]  != '\\') { ret 1; }
    if (buf[8]  != 'f')  { ret 1; }
    if (buf[9]  != '\\') { ret 1; }
    if (buf[10] != 'r')  { ret 1; }
    if (buf[11] != '\\') { ret 1; }
    if (buf[12] != 'u')  { ret 1; }
    if (buf[13] != '0')  { ret 1; }
    if (buf[14] != '0')  { ret 1; }
    if (buf[15] != '0')  { ret 1; }
    if (buf[16] != '1')  { ret 1; }
    if (buf[17] != '"')  { ret 1; }
    ret 0;
}

test "json: emit escaped output reparses" {
    var a: allocator.Allocator;
    page.make(?a);
    # logical: x " \ 0x01 y
    var raw: [5]u8 = [5]u8{'x', '"', '\\', 0x01, 'y'};
    val v: Value = make_string(((?raw[0])::usize)::str, 5);
    var buf: [32]u8;
    val n: usize = emit(?v, ?buf[0], 32);
    # the emitted document must parse cleanly through the module's own parser
    val r: res[Value, JsonError] = parse(?buf[0], n, ?a);
    if (sel r.err) { ret 1; }
    val rv: Value = r.ok;
    if (rv.kind != STRING) { ret 1; }
    ret 0;
}

test "json: emit escapes object keys" {
    var a: allocator.Allocator;
    page.make(?a);
    # key: a"b   value: 1
    var keyraw: [3]u8 = [3]u8{'a', '"', 'b'};
    var keys: [1]str = [1]str{((?keyraw[0])::usize)::str};
    var klens: [1]usize = [1]usize{3};
    var children: [1]Value;
    children[0] = make_number(1);
    var o: Value = make_object();
    o.keys = ?keys[0];
    o.keys_len = ?klens[0];
    o.children = ?children[0];
    o.count = 1;
    var buf: [32]u8;
    val n: usize = emit(?o, ?buf[0], 32);
    # expected: {"a\"b":1} (10 bytes)
    if (n != 10) { ret 1; }
    if (buf[0] != '{')  { ret 1; }
    if (buf[1] != '"')  { ret 1; }
    if (buf[2] != 'a')  { ret 1; }
    if (buf[3] != '\\') { ret 1; }
    if (buf[4] != '"')  { ret 1; }
    if (buf[5] != 'b')  { ret 1; }
    if (buf[6] != '"')  { ret 1; }
    if (buf[7] != ':')  { ret 1; }
    if (buf[8] != '1')  { ret 1; }
    if (buf[9] != '}')  { ret 1; }
    # and the emitted object re-parses cleanly
    val r: res[Value, JsonError] = parse(?buf[0], n, ?a);
    if (sel r.err) { ret 1; }
    val rv: Value = r.ok;
    if (rv.kind != OBJECT) { ret 1; }
    if (rv.count != 1) { ret 1; }
    ret 0;
}

# a fixed-capacity byte sink used to capture streaming emitter output in tests
# ---
# buf: destination buffer
# cap: buffer capacity
# len: bytes written so far
rec TestSink {
    buf: *u8;
    cap: usize;
    len: usize;
}

# writer callback appending to a TestSink, dropping bytes past its capacity
fun test_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, WriteError] {
    val s: *TestSink = ctx::*TestSink;
    var i: usize = 0;
    for (i < len && s.len < s.cap) {
        s.buf[s.len] = buf[i];
        s.len = s.len + 1;
        i = i + 1;
    }
    ret res[usize, WriteError].ok{len};
}

# whether the sink's captured bytes equal the first `wlen` bytes of `want`
fun sink_is(s: *TestSink, want: *u8, wlen: usize) bool {
    if (s.len != wlen) { ret false; }
    var i: usize = 0;
    for (i < wlen) {
        if (s.buf[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# wire a Writer over a TestSink backed by `buf`
fun test_writer(w: *writer.Writer, s: *TestSink, buf: *u8, cap: usize) {
    s.buf = buf;
    s.cap = cap;
    s.len = 0;
    w.ctx      = s::ptr;
    w.f_write = test_sink_write;
}

# printable ASCII passes through verbatim, wrapped in quotes.
test "json: write_json_string plain_ascii" {
    var out:  [64]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 64);

    write_json_string(?w, "mach.cli.json");

    var want: [15]u8;
    want[0] = '"';
    val src: *u8 = "mach.cli.json";
    var i: usize = 0;
    for (src[i] != 0) { want[i + 1] = src[i]; i = i + 1; }
    want[i + 1] = '"';
    if (!sink_is(?sink, ?want[0], i + 2)) { ret 1; }
    ret 0;
}

# quotes and backslashes get their short escapes.
test "json: write_json_string quote_and_backslash" {
    var out:  [32]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 32);

    var input: [5]u8;
    input[0] = 'x'; input[1] = '"'; input[2] = '\\'; input[3] = 'y'; input[4] = 0;
    write_json_string(?w, ?input[0]);

    var want: [8]u8;
    want[0] = '"'; want[1] = 'x'; want[2] = '\\'; want[3] = '"';
    want[4] = '\\'; want[5] = '\\'; want[6] = 'y'; want[7] = '"';
    if (!sink_is(?sink, ?want[0], 8)) { ret 1; }
    ret 0;
}

# a newline is the short `\n` escape; a bare control byte is a `\u00XX` escape.
test "json: write_json_string control_escapes" {
    var out:  [32]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 32);

    var nl: [2]u8;
    nl[0] = 10; nl[1] = 0;
    write_json_string(?w, ?nl[0]);
    var want_nl: [4]u8;
    want_nl[0] = '"'; want_nl[1] = '\\'; want_nl[2] = 'n'; want_nl[3] = '"';
    if (!sink_is(?sink, ?want_nl[0], 4)) { ret 1; }

    test_writer(?w, ?sink, ?out[0], 32);
    var c1: [2]u8;
    c1[0] = 1; c1[1] = 0;
    write_json_string(?w, ?c1[0]);
    var want_c1: [8]u8;
    want_c1[0] = '"'; want_c1[1] = '\\'; want_c1[2] = 'u'; want_c1[3] = '0';
    want_c1[4] = '0'; want_c1[5] = '0'; want_c1[6] = '1'; want_c1[7] = '"';
    if (!sink_is(?sink, ?want_c1[0], 8)) { ret 1; }
    ret 0;
}

# a two-byte UTF-8 sequence is decoded to a single `\uXXXX` escape.
test "json: write_json_string utf8_bmp" {
    var out:  [32]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 32);

    # U+00E9 (e-acute) encodes as 0xC3 0xA9.
    var input: [3]u8;
    input[0] = 0xC3; input[1] = 0xA9; input[2] = 0;
    write_json_string(?w, ?input[0]);

    var want: [8]u8;
    want[0] = '"'; want[1] = '\\'; want[2] = 'u'; want[3] = '0';
    want[4] = '0'; want[5] = 'e'; want[6] = '9'; want[7] = '"';
    if (!sink_is(?sink, ?want[0], 8)) { ret 1; }
    ret 0;
}

# an astral code point is decoded to a UTF-16 surrogate pair.
test "json: write_json_string utf8_astral" {
    var out:  [32]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 32);

    # U+1F600 (grinning face) encodes as 0xF0 0x9F 0x98 0x80.
    var input: [5]u8;
    input[0] = 0xF0; input[1] = 0x9F; input[2] = 0x98; input[3] = 0x80; input[4] = 0;
    write_json_string(?w, ?input[0]);

    var want: [14]u8;
    want[0]  = '"'; want[1]  = '\\'; want[2]  = 'u'; want[3]  = 'd';
    want[4]  = '8'; want[5]  = '3'; want[6]  = 'd'; want[7]  = '\\';
    want[8]  = 'u'; want[9]  = 'd'; want[10] = 'e'; want[11] = '0';
    want[12] = '0'; want[13] = '"';
    if (!sink_is(?sink, ?want[0], 14)) { ret 1; }
    ret 0;
}

# whether the sink holds exactly `count` U+FFFD replacement escapes, quoted
#
# A pure run of the replacement escape proves the decoder rejected the input
# entirely: any accepted (overlong, surrogate, or out-of-range) decode would
# emit different bytes, and a lone surrogate would emit `\ud...` instead.
fun sink_is_replacements(s: *TestSink, count: usize) bool {
    if (s.len != count * 6 + 2) { ret false; }
    if (s.buf[0] != '"' || s.buf[s.len - 1] != '"') { ret false; }
    var k: usize = 0;
    for (k < count) {
        val b: usize = 1 + k * 6;
        if (s.buf[b] != '\\' || s.buf[b + 1] != 'u') { ret false; }
        if (s.buf[b + 2] != 'f' || s.buf[b + 3] != 'f') { ret false; }
        if (s.buf[b + 4] != 'f' || s.buf[b + 5] != 'd') { ret false; }
        k = k + 1;
    }
    ret true;
}

# a UTF-16 surrogate encoded as UTF-8 (CESU-8) is rejected, never emitted as a
# lone `\ud...` escape.
test "json: write_json_string utf8_surrogate_rejected" {
    var out:  [64]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 64);

    # U+D800 CESU-8 encodes as 0xED 0xA0 0x80; each byte resyncs to a replacement.
    var input: [4]u8;
    input[0] = 0xED; input[1] = 0xA0; input[2] = 0x80; input[3] = 0;
    write_json_string(?w, ?input[0]);
    if (!sink_is_replacements(?sink, 3)) { ret 1; }
    ret 0;
}

# an overlong 2-byte encoding is rejected.
test "json: write_json_string utf8_overlong_rejected" {
    var out:  [64]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 64);

    # 0xC0 0x80 is an overlong NUL; the lead and the stray byte each resync.
    var input: [3]u8;
    input[0] = 0xC0; input[1] = 0x80; input[2] = 0;
    write_json_string(?w, ?input[0]);
    if (!sink_is_replacements(?sink, 2)) { ret 1; }
    ret 0;
}

# a lead byte above the UTF-8 range is rejected.
test "json: write_json_string utf8_bad_lead_rejected" {
    var out:  [32]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 32);

    # 0xF5 begins no valid sequence (max lead is 0xF4).
    var input: [2]u8;
    input[0] = 0xF5; input[1] = 0;
    write_json_string(?w, ?input[0]);
    if (!sink_is_replacements(?sink, 1)) { ret 1; }
    ret 0;
}

# a 4-byte sequence decoding above U+10FFFF is rejected.
test "json: write_json_string utf8_above_max_rejected" {
    var out:  [64]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 64);

    # 0xF4 0x90 ... would be U+110000; 0x90 is out of 0xF4's [0x80,0x8F] range.
    var input: [5]u8;
    input[0] = 0xF4; input[1] = 0x90; input[2] = 0x80; input[3] = 0x80; input[4] = 0;
    write_json_string(?w, ?input[0]);
    if (!sink_is_replacements(?sink, 4)) { ret 1; }
    ret 0;
}

# a truncated multi-byte sequence (valid prefix, missing tail) is rejected.
test "json: write_json_string utf8_truncated_rejected" {
    var out:  [32]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 32);

    # 0xE2 0x82 starts a 3-byte sequence that the NUL terminates early.
    var input: [3]u8;
    input[0] = 0xE2; input[1] = 0x82; input[2] = 0;
    write_json_string(?w, ?input[0]);
    if (!sink_is_replacements(?sink, 2)) { ret 1; }
    ret 0;
}

# a full NDJSON object call sequence renders exact bytes, terminated by a
# newline; the members carry every field kind and comma boundary.
test "json: ndjson object exact bytes" {
    var out:  [64]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 64);

    var o: Object;
    object_begin(?w, ?o);
    field_i64(?o, "n", 7);
    field_str(?o, "s", "a\"b");
    field_bool(?o, "b", true);
    field_str_or_null(?o, "o", nil);
    field_null(?o, "z");
    object_end(?o);

    # {"n":7,"s":"a\"b","b":true,"o":null,"z":null}\n
    val want: str = "{\"n\":7,\"s\":\"a\\\"b\",\"b\":true,\"o\":null,\"z\":null}\n";
    var wlen: usize = 0;
    for (want[wlen] != 0) { wlen = wlen + 1; }
    if (!sink_is(?sink, want::*u8, wlen)) { ret 1; }
    ret 0;
}

# nested object and array members compose into one valid NDJSON line.
test "json: ndjson nested object and array" {
    var out:  [128]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 128);

    var root: Object;
    object_begin(?w, ?root);
    field_i64(?root, "a", 1);

    var loc: Object;
    field_object_begin(?root, "loc", ?loc);
    field_i64(?loc, "line", 2);
    field_i64(?loc, "col", 3);
    object_end_value(?loc);

    var rel: Array;
    field_array_begin(?root, "rel", ?rel);
    var e0: Object;
    array_object_begin(?rel, ?e0);
    field_str(?e0, "label", "x");
    object_end_value(?e0);
    var e1: Object;
    array_object_begin(?rel, ?e1);
    field_str(?e1, "label", "y");
    object_end_value(?e1);
    array_end(?rel);

    object_end(?root);

    val want: *u8 = "{\"a\":1,\"loc\":{\"line\":2,\"col\":3},\"rel\":[{\"label\":\"x\"},{\"label\":\"y\"}]}\n";
    var wl: usize = 0;
    for (want[wl] != 0) { wl = wl + 1; }
    if (!sink_is(?sink, want, wl)) { ret 1; }
    ret 0;
}

# an empty array member emits `[]`.
test "json: ndjson empty array" {
    var out:  [32]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 32);

    var root: Object;
    object_begin(?w, ?root);
    var rel: Array;
    field_array_begin(?root, "rel", ?rel);
    array_end(?rel);
    object_end(?root);

    val want: *u8 = "{\"rel\":[]}\n";
    var wl: usize = 0;
    for (want[wl] != 0) { wl = wl + 1; }
    if (!sink_is(?sink, want, wl)) { ret 1; }
    ret 0;
}

# emit v through value_f64, parse it back, and report whether the recovered
# number equals v. an integer-valued float emits with no fractional part and
# parses as an integer number, so the read-back selects value_number there.
fun f64_round_trips(v: f64) bool {
    var out:  [48]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 48);
    value_f64(?w, v);

    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Value, JsonError] = parse(sink.buf, sink.len, ?a);
    if (sel r.err) { ret false; }
    val pv: Value = r.ok;
    if (pv.kind != NUMBER) { ret false; }
    var got: f64 = 0.0;
    if (value_is_float(?pv)) { got = value_float(?pv); }
    or                       { got = value_number(?pv)::f64; }
    ret got == v;
}

# value_f64 emits a decimal the parser reads back to the same f64 across
# fractional, negative, and integer-valued spreads.
test "json: value_f64 round trips" {
    if (!f64_round_trips(21.5))      { ret 1; }
    if (!f64_round_trips(-21.5))     { ret 1; }
    if (!f64_round_trips(3.0))       { ret 1; }
    if (!f64_round_trips(-7.0))      { ret 1; }
    if (!f64_round_trips(0.125))     { ret 1; }
    if (!f64_round_trips(1234.5678)) { ret 1; }
    ret 0;
}

# field_f64 emits a float object member the parser recovers as a float value.
test "json: field_f64 member round trips" {
    var out:  [48]u8;
    var sink: TestSink;
    var w:    writer.Writer;
    test_writer(?w, ?sink, ?out[0], 48);

    var o: Object;
    object_begin(?w, ?o);
    field_f64(?o, "v", 21.5);
    object_end_value(?o);

    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Value, JsonError] = parse(sink.buf, sink.len, ?a);
    if (sel r.err) { ret 1; }
    val pv: Value = r.ok;
    val fv: opt[*Value] = value_find(?pv, "v");
    if (sel fv.none) { ret 1; }
    if (!value_is_float(fv.some)) { ret 1; }
    if (value_float(fv.some) != 21.5) { ret 1; }
    ret 0;
}

# decode a raw string body through value_string_decode and compare the result to
# `want`.
fun decode_check(raw: *u8, rawlen: usize, want: *u8, wantlen: usize) bool {
    val v: Value = make_string((raw::usize)::str, rawlen);
    var buf: [64]u8;
    val dr: res[usize, JsonError] = value_string_decode(?v, ?buf[0], 64);
    if (sel dr.err) { ret false; }
    val n: usize = dr.ok;
    if (n != wantlen) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (buf[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether value_string_decode rejects the given raw string body
fun decode_rejects(raw: *u8, rawlen: usize) bool {
    val v: Value = make_string((raw::usize)::str, rawlen);
    var buf: [64]u8;
    val dr: res[usize, JsonError] = value_string_decode(?v, ?buf[0], 64);
    ret sel dr.err;
}

# a body with no escapes decodes to itself, raw UTF-8 included.
test "json: decode verbatim" {
    var raw:  [5]u8 = [5]u8{'a', 0xC3, 0xA9, 'z', '!'};
    var want: [5]u8 = [5]u8{'a', 0xC3, 0xA9, 'z', '!'};
    if (!decode_check(?raw[0], 5, ?want[0], 5)) { ret 1; }
    ret 0;
}

# the short escapes decode to their literal bytes.
test "json: decode short escapes" {
    # \" \\ \/ \b \f \n \r \t
    var raw:  [16]u8 = [16]u8{'\\', '"', '\\', '\\', '\\', '/', '\\', 'b', '\\', 'f', '\\', 'n', '\\', 'r', '\\', 't'};
    var want: [8]u8 = [8]u8{'"', '\\', '/', 0x08, 0x0c, 0x0a, 0x0d, 0x09};
    if (!decode_check(?raw[0], 16, ?want[0], 8)) { ret 1; }
    ret 0;
}

# a \uXXXX BMP escape decodes to its UTF-8 bytes.
test "json: decode unicode bmp" {
    # é -> U+00E9 -> 0xC3 0xA9
    var raw:  [6]u8 = [6]u8{'\\', 'u', '0', '0', 'e', '9'};
    var want: [2]u8 = [2]u8{0xC3, 0xA9};
    if (!decode_check(?raw[0], 6, ?want[0], 2)) { ret 1; }
    ret 0;
}

# a \uXXXX escape in the ASCII range decodes to one byte.
test "json: decode unicode ascii" {
    # A -> 'A'
    var raw:  [6]u8 = [6]u8{'\\', 'u', '0', '0', '4', '1'};
    var want: [1]u8 = [1]u8{'A'};
    if (!decode_check(?raw[0], 6, ?want[0], 1)) { ret 1; }
    ret 0;
}

# uppercase hex digits decode identically to lowercase.
test "json: decode unicode uppercase hex" {
    # é -> U+00E9 -> 0xC3 0xA9
    var raw:  [6]u8 = [6]u8{'\\', 'u', '0', '0', 'E', '9'};
    var want: [2]u8 = [2]u8{0xC3, 0xA9};
    if (!decode_check(?raw[0], 6, ?want[0], 2)) { ret 1; }
    ret 0;
}

# a high+low surrogate pair decodes to one astral code point in UTF-8.
test "json: decode surrogate pair" {
    # 😀 -> U+1F600 -> 0xF0 0x9F 0x98 0x80
    var raw:  [12]u8 = [12]u8{'\\', 'u', 'd', '8', '3', 'd', '\\', 'u', 'd', 'e', '0', '0'};
    var want: [4]u8 = [4]u8{0xF0, 0x9F, 0x98, 0x80};
    if (!decode_check(?raw[0], 12, ?want[0], 4)) { ret 1; }
    ret 0;
}

# value_string_decode reports the full decoded length even when the buffer is too
# small, so a caller can size then fill (as with emit).
test "json: decode buffer sizing" {
    # 😀 decodes to 4 bytes
    var raw: [12]u8 = [12]u8{'\\', 'u', 'd', '8', '3', 'd', '\\', 'u', 'd', 'e', '0', '0'};
    val v: Value = make_string(((?raw[0])::usize)::str, 12);

    var probe: [1]u8;
    val sr: res[usize, JsonError] = value_string_decode(?v, ?probe[0], 0);
    if (sel sr.err) { ret 1; }
    if (sr.ok != 4) { ret 1; }

    var buf: [4]u8;
    val dr: res[usize, JsonError] = value_string_decode(?v, ?buf[0], 4);
    if (sel dr.err) { ret 1; }
    if (dr.ok != 4) { ret 1; }
    if (buf[0] != 0xF0 || buf[1] != 0x9F || buf[2] != 0x98 || buf[3] != 0x80) { ret 1; }
    ret 0;
}

# an unknown escape character is rejected.
test "json: decode rejects bad escape" {
    var raw: [2]u8 = [2]u8{'\\', 'x'};
    if (!decode_rejects(?raw[0], 2)) { ret 1; }
    ret 0;
}

# a \u escape without four hex digits is rejected.
test "json: decode rejects truncated unicode" {
    var raw: [4]u8 = [4]u8{'\\', 'u', '1', '2'};
    if (!decode_rejects(?raw[0], 4)) { ret 1; }
    ret 0;
}

# a non-hex digit in a \u escape is rejected.
test "json: decode rejects non-hex unicode" {
    var raw: [6]u8 = [6]u8{'\\', 'u', '1', '2', 'g', '4'};
    if (!decode_rejects(?raw[0], 6)) { ret 1; }
    ret 0;
}

# a high surrogate with no following escape is rejected.
test "json: decode rejects unpaired high surrogate" {
    var raw: [6]u8 = [6]u8{'\\', 'u', 'd', '8', '3', 'd'};
    if (!decode_rejects(?raw[0], 6)) { ret 1; }
    ret 0;
}

# a high surrogate followed by a non-low-surrogate escape is rejected.
test "json: decode rejects bad surrogate pair" {
    # \ud83dA
    var raw: [12]u8 = [12]u8{'\\', 'u', 'd', '8', '3', 'd', '\\', 'u', '0', '0', '4', '1'};
    if (!decode_rejects(?raw[0], 12)) { ret 1; }
    ret 0;
}

# a lone low surrogate is rejected.
test "json: decode rejects lone low surrogate" {
    var raw: [6]u8 = [6]u8{'\\', 'u', 'd', 'c', '0', '0'};
    if (!decode_rejects(?raw[0], 6)) { ret 1; }
    ret 0;
}

# a trailing backslash is rejected.
test "json: decode rejects trailing backslash" {
    var raw: [1]u8 = [1]u8{'\\'};
    if (!decode_rejects(?raw[0], 1)) { ret 1; }
    ret 0;
}

# the reframed round-trip: emit escapes logical bytes to wire, parse stores the
# wire bytes raw, and value_string_decode recovers the original logical bytes.
test "json: decode roundtrip emit then parse" {
    var a: allocator.Allocator;
    page.make(?a);

    # logical bytes: a <newline> " \ b
    var logical: [5]u8 = [5]u8{'a', 0x0a, '"', '\\', 'b'};
    val src: Value = make_string(((?logical[0])::usize)::str, 5);

    var wire: [32]u8;
    val wn: usize = emit(?src, ?wire[0], 32);

    val r: res[Value, JsonError] = parse(?wire[0], wn, ?a);
    if (sel r.err) { ret 1; }
    val pv: Value = r.ok;
    if (pv.kind != STRING) { ret 1; }

    var buf: [16]u8;
    val dr: res[usize, JsonError] = value_string_decode(?pv, ?buf[0], 16);
    if (sel dr.err) { ret 1; }
    if (dr.ok != 5) { ret 1; }
    var i: usize = 0;
    for (i < 5) {
        if (buf[i] != logical[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# a string parsed straight from source text decodes its wire escapes to logical
# bytes (the hazard the raw representation posed for consumers).
test "json: decode parsed string" {
    var a: allocator.Allocator;
    page.make(?a);
    # source document "a\nb" (a backslash-n between a and b)
    val src: str = "\"a\\nb\"";
    val r: res[Value, JsonError] = parse(src::*u8, 6, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != STRING) { ret 1; }
    # raw bytes are a \ n b (4); decoded are a <newline> b (3)
    if (v.str_len != 4) { ret 1; }
    var buf: [8]u8;
    val dr: res[usize, JsonError] = value_string_decode(?v, ?buf[0], 8);
    if (sel dr.err) { ret 1; }
    if (dr.ok != 3) { ret 1; }
    if (buf[0] != 'a' || buf[1] != 0x0a || buf[2] != 'b') { ret 1; }
    ret 0;
}

# a fraction makes the number a float, read with value_float.
test "json: parse float" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "3.14";
    val r: res[Value, JsonError] = parse(src::*u8, 4, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != NUMBER) { ret 1; }
    if (!value_is_float(?v)) { ret 1; }
    val f: f64 = value_float(?v);
    if (f < 3.139 || f > 3.141) { ret 1; }
    ret 0;
}

# a negative float carries its sign.
test "json: parse negative float" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "-2.5";
    val r: res[Value, JsonError] = parse(src::*u8, 4, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (!value_is_float(?v)) { ret 1; }
    val f: f64 = value_float(?v);
    if (f < -2.51 || f > -2.49) { ret 1; }
    ret 0;
}

# an exponent with no fraction still makes the number a float.
test "json: parse float exponent" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "1e3";
    val r: res[Value, JsonError] = parse(src::*u8, 3, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (!value_is_float(?v)) { ret 1; }
    val f: f64 = value_float(?v);
    if (f < 999.0 || f > 1001.0) { ret 1; }
    ret 0;
}

# fraction and a signed uppercase exponent together.
test "json: parse float frac and exponent" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "6.022E2";
    val r: res[Value, JsonError] = parse(src::*u8, 7, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (!value_is_float(?v)) { ret 1; }
    val f: f64 = value_float(?v);
    if (f < 602.1 || f > 602.3) { ret 1; }
    ret 0;
}

# a negative exponent.
test "json: parse float negative exponent" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "5e-2";
    val r: res[Value, JsonError] = parse(src::*u8, 4, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (!value_is_float(?v)) { ret 1; }
    val f: f64 = value_float(?v);
    if (f < 0.049 || f > 0.051) { ret 1; }
    ret 0;
}

# an integer-looking number stays an integer: value_number works, value_is_float
# is false, and value_float widens it.
test "json: parse integer unchanged" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "42";
    val r: res[Value, JsonError] = parse(src::*u8, 2, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (value_is_float(?v)) { ret 1; }
    if (value_number(?v) != 42) { ret 1; }
    val f: f64 = value_float(?v);
    if (f < 41.9 || f > 42.1) { ret 1; }
    ret 0;
}

# a mixed array keeps integers as integers and floats as floats.
test "json: parse mixed number array" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "[1,2.5,3]";
    val r: res[Value, JsonError] = parse(src::*u8, 9, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != ARRAY || v.count != 3) { ret 1; }
    if (value_is_float(?v.children[0])) { ret 1; }
    if (value_number(?v.children[0]) != 1) { ret 1; }
    if (!value_is_float(?v.children[1])) { ret 1; }
    val f: f64 = value_float(?v.children[1]);
    if (f < 2.49 || f > 2.51) { ret 1; }
    if (value_is_float(?v.children[2])) { ret 1; }
    if (value_number(?v.children[2]) != 3) { ret 1; }
    ret 0;
}

# a float value inside an object.
test "json: parse float in object" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "{\"x\":1.5}";
    val r: res[Value, JsonError] = parse(src::*u8, 9, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    val x: opt[*Value] = value_find(?v, "x");
    if (sel x.none) { ret 1; }
    if (!value_is_float(x.some)) { ret 1; }
    val f: f64 = value_float(x.some);
    if (f < 1.49 || f > 1.51) { ret 1; }
    ret 0;
}

# a bare decimal point with no fraction digits is rejected.
test "json: parse float rejects empty fraction" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "1.";
    val r: res[Value, JsonError] = parse(src::*u8, 2, ?a);
    if (!sel r.err) { ret 1; }
    ret 0;
}

# an exponent marker with no digits is rejected.
test "json: parse float rejects empty exponent" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "1e";
    val r: res[Value, JsonError] = parse(src::*u8, 2, ?a);
    if (!sel r.err) { ret 1; }
    ret 0;
}

# a fraction followed by an empty exponent is rejected.
test "json: parse float rejects frac empty exponent" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "1.5e";
    val r: res[Value, JsonError] = parse(src::*u8, 4, ?a);
    if (!sel r.err) { ret 1; }
    ret 0;
}

# a float emits in shortest round-trippable form.
test "json: emit float" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "1.5";
    val r: res[Value, JsonError] = parse(src::*u8, 3, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    var buf: [16]u8;
    val n: usize = emit(?v, ?buf[0], 16);
    if (n != 3) { ret 1; }
    if (buf[0] != '1' || buf[1] != '.' || buf[2] != '5') { ret 1; }
    ret 0;
}

# a programmatically built float emits and re-parses as a float.
test "json: emit built float" {
    var a: allocator.Allocator;
    page.make(?a);
    val v: Value = make_float(2.5);
    var buf: [16]u8;
    val n: usize = emit(?v, ?buf[0], 16);
    if (buf[0] != '2' || buf[1] != '.' || buf[2] != '5') { ret 1; }
    val r: res[Value, JsonError] = parse(?buf[0], n, ?a);
    if (sel r.err) { ret 1; }
    val rv: Value = r.ok;
    if (!value_is_float(?rv)) { ret 1; }
    ret 0;
}

# a parsed float round-trips through emit and parse back to the same value.
test "json: float roundtrip parse emit parse" {
    var a: allocator.Allocator;
    page.make(?a);
    val src: str = "3.14159";
    val r: res[Value, JsonError] = parse(src::*u8, 7, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    var buf: [32]u8;
    val n: usize = emit(?v, ?buf[0], 32);
    val r2: res[Value, JsonError] = parse(?buf[0], n, ?a);
    if (sel r2.err) { ret 1; }
    val v2: Value = r2.ok;
    if (!value_is_float(?v2)) { ret 1; }
    val f: f64 = value_float(?v2);
    if (f < 3.14158 || f > 3.14160) { ret 1; }
    ret 0;
}

use std.allocator.testing;
use std.system.os;
use io_error: std.io.error;

# a document whose containers all grow past their first capacity, so every
# acquisition site (children, keys, key lengths, and their regrowth) is hit
fun growth_doc() str {
    ret "{\"a\":[1,2,3,4,5,6],\"b\":{\"x\":1,\"y\":2,\"z\":3,\"w\":4,\"v\":5},\"c\":\"s\",\"d\":null,\"e\":true}";
}

# a parse followed by dnit leaves the allocator exactly where it started, and
# a second dnit of the released tree is a no-op
test "json: parse then dnit returns every byte" {
    var tracker: testing.Testing;
    val made: err[allocator.Error] = testing.make(?tracker);
    if (sel made.err) { ret 1; }
    fin { testing.dnit(?tracker); }
    val a: *allocator.Allocator = testing.allocator_of(?tracker);

    val src: str = growth_doc();
    var n: usize = 0;
    for (src[n] != 0) { n = n + 1; }
    val r: res[Value, JsonError] = parse(src::*u8, n, a);
    if (sel r.err) { ret 2; }
    var v: Value = r.ok;
    if (v.count != 5) { ret 3; }
    if (testing.live_count(?tracker) == 0) { ret 4; }

    val released: err[allocator.Error] = dnit(a, ?v);
    if (sel released.err) { ret 5; }
    if (testing.live_count(?tracker) != 0) { ret 6; }
    if (v.count != 0 || v.cap != 0 || v.children != nil) { ret 7; }
    val again: err[allocator.Error] = dnit(a, ?v);
    if (sel again.err) { ret 8; }
    if (testing.live_count(?tracker) != 0) { ret 9; }
    ret 0;
}

# a document that fails part way releases what it acquired before reporting
test "json: a failed parse strands nothing and names the offset" {
    var tracker: testing.Testing;
    val made: err[allocator.Error] = testing.make(?tracker);
    if (sel made.err) { ret 1; }
    fin { testing.dnit(?tracker); }
    val a: *allocator.Allocator = testing.allocator_of(?tracker);

    # the array and the nested object both allocated before the `x` is met
    val src: str = "{\"a\":[1,2,3,4,5,{\"k\":1,\"j\":2}],\"b\":x}";
    var n: usize = 0;
    for (src[n] != 0) { n = n + 1; }
    val r: res[Value, JsonError] = parse(src::*u8, n, a);
    if (!sel r.err) { ret 2; }
    if (!sel r.err.syntax) { ret 3; }
    if (r.err.syntax != 35) { ret 4; }
    if (testing.live_count(?tracker) != 0) { ret 5; }

    # trailing content after a complete value releases the value
    val src2: str = "[1,2] x";
    val r2: res[Value, JsonError] = parse(src2::*u8, 7, a);
    if (!sel r2.err) { ret 6; }
    if (!sel r2.err.syntax) { ret 7; }
    if (r2.err.syntax != 6) { ret 8; }
    if (testing.live_count(?tracker) != 0) { ret 9; }
    ret 0;
}

# each acquisition site refused in turn: the parse reports alloc, nothing is
# leaked, and the allocator's refusal is the one reported
test "json: growth refused at any acquisition releases everything" {
    val src: str = growth_doc();
    var n: usize = 0;
    for (src[n] != 0) { n = n + 1; }

    var ordinal: usize = 1;
    for (ordinal <= 32) {
        var tracker: testing.Testing;
        val made: err[allocator.Error] = testing.make(?tracker);
        if (sel made.err) { ret 1; }
        testing.fail_at_ordinal(?tracker, ordinal);
        val a: *allocator.Allocator = testing.allocator_of(?tracker);

        val r: res[Value, JsonError] = parse(src::*u8, n, a);
        var accepted: bool = false;
        if (sel r.err) {
            if (!sel r.err.alloc) { testing.dnit(?tracker); ret 2; }
            if (!sel r.err.alloc.exhausted) { testing.dnit(?tracker); ret 3; }
        }
        if (sel r.ok) {
            var v: Value = r.ok;
            accepted = true;
            dnit(a, ?v);
        }
        val leaked: bool = testing.live_count(?tracker) != 0 || testing.double_free_count(?tracker) != 0;
        val attempts: usize = testing.attempt_count(?tracker);
        testing.dnit(?tracker);
        if (leaked) { ret 4; }
        if (accepted) {
            # the refusal never fired: every acquisition succeeded before it
            if (attempts >= ordinal) { ret 5; }
            if (ordinal < 4) { ret 6; }
            ret 0;
        }
        if (attempts != ordinal) { ret 7; }
        ordinal = ordinal + 1;
    }
    ret 8;
}

# build n open brackets followed by n close brackets
fun nest_doc(buf: *u8, n: usize) usize {
    var i: usize = 0;
    for (i < n) { buf[i] = '['; i = i + 1; }
    i = 0;
    for (i < n) { buf[n + i] = ']'; i = i + 1; }
    ret n + n;
}

# the bound is where it says it is: MAX_DEPTH nested arrays are accepted and
# one more is refused as depth, with nothing stranded
test "json: nesting past MAX_DEPTH is refused" {
    var tracker: testing.Testing;
    val made: err[allocator.Error] = testing.make(?tracker);
    if (sel made.err) { ret 1; }
    fin { testing.dnit(?tracker); }
    val a: *allocator.Allocator = testing.allocator_of(?tracker);

    var buf: [512]u8;
    val ok_len: usize = nest_doc(?buf[0], MAX_DEPTH);
    val fine: res[Value, JsonError] = parse(?buf[0], ok_len, a);
    if (sel fine.err) { ret 2; }
    var v: Value = fine.ok;
    dnit(a, ?v);
    if (testing.live_count(?tracker) != 0) { ret 3; }

    val deep_len: usize = nest_doc(?buf[0], MAX_DEPTH + 1);
    val deep: res[Value, JsonError] = parse(?buf[0], deep_len, a);
    if (!sel deep.err) { ret 4; }
    if (!sel deep.err.depth) { ret 5; }
    if (deep.err.depth != MAX_DEPTH) { ret 6; }
    if (testing.live_count(?tracker) != 0) { ret 7; }
    ret 0;
}

# a scalar document's failures name the offending byte
test "json: syntax failures carry the offset" {
    var a: allocator.Allocator;
    page.make(?a);

    val cut: res[Value, JsonError] = parse("[1,2", 4, ?a);
    if (!sel cut.err) { ret 1; }
    if (!sel cut.err.syntax) { ret 1; }
    if (cut.err.syntax != 4) { ret 1; }

    val lit: res[Value, JsonError] = parse("trux", 4, ?a);
    if (!sel lit.err) { ret 2; }
    if (!sel lit.err.syntax) { ret 2; }
    if (lit.err.syntax != 0) { ret 2; }

    val colon: res[Value, JsonError] = parse("{\"a\" 1}", 7, ?a);
    if (!sel colon.err) { ret 3; }
    if (!sel colon.err.syntax) { ret 3; }
    if (colon.err.syntax != 5) { ret 3; }

    val empty: res[Value, JsonError] = parse("  ", 2, ?a);
    if (!sel empty.err) { ret 4; }
    if (!sel empty.err.syntax) { ret 4; }
    if (empty.err.syntax != 2) { ret 4; }

    val bad: Value = make_string("ab\\q", 4);
    val esc: res[usize, JsonError] = value_string_decode(?bad, nil, 0);
    if (!sel esc.err) { ret 5; }
    if (!sel esc.err.syntax) { ret 5; }
    if (esc.err.syntax != 3) { ret 5; }
    ret 0;
}

# a sink that persists `cap` bytes and then fails natively
rec FailSink {
    buf: *u8;
    cap: usize;
    len: usize;
}

fun fail_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, WriteError] {
    val s: *FailSink = ctx::*FailSink;
    var i: usize = 0;
    for (i < len) {
        if (s.len >= s.cap) {
            ret res[usize, WriteError].err{writer.native_failure(i, io_error.from_code(os.ENOSPC, io_error.OP_WRITE))};
        }
        s.buf[s.len] = buf[i];
        s.len = s.len + 1;
        i = i + 1;
    }
    ret res[usize, WriteError].ok{len};
}

# every streaming helper reports the bytes it persisted before the sink
# failed, however many writes deep the failure was
test "json: a streaming failure carries the persisted prefix" {
    var out: [64]u8;
    var s: FailSink;
    s.buf = ?out[0];
    s.cap = 12;
    s.len = 0;
    var w: writer.Writer;
    w.ctx = (?s)::ptr;
    w.f_write = fail_sink_write;

    var o: Object;
    val began: err[WriteError] = object_begin(?w, ?o);
    if (sel began.err) { ret 1; }
    val first: err[WriteError] = field_i64(?o, "n", 7);
    if (sel first.err) { ret 2; }
    # `{"n":7` is 6 bytes; `,"s":"a\"b"` needs 11 and the sink takes 6 more
    val second: err[WriteError] = field_str(?o, "s", "a\"b");
    if (!sel second.err) { ret 3; }
    if (!sel second.err.native) { ret 4; }
    if (writer.persisted(second.err) != 6) { ret 5; }
    if (s.len != 12) { ret 6; }
    if (out[6] != ',' || out[11] != '"') { ret 7; }

    # a tree emission through write_value reports the same way
    s.len = 0;
    s.cap = 3;
    var arr: Value = make_array();
    var items: [2]Value;
    items[0] = make_number(12);
    items[1] = make_number(34);
    arr.children = ?items[0];
    arr.count = 2;
    val tree: err[WriteError] = write_value(?w, ?arr);
    if (!sel tree.err) { ret 8; }
    if (writer.persisted(tree.err) != 3) { ret 9; }
    if (out[0] != '[' || out[1] != '1' || out[2] != '2') { ret 10; }
    ret 0;
}
