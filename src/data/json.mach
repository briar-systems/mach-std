    val r: res[Value, JsonError] = parse(src::*u8, 2, ?a);
    if (sel r.err) { ret 1; }
    val v: Value = r.ok;
    if (v.kind != NUMBER) { ret 1; }
    if (v.num_val != 42) { ret 1; }
    ret 0;
}

test "json: parse negative number" {
    var a: allocator.Allocator;
