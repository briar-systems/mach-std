# the pages of a wasm linear memory, which only grows
#
# `memory.size` reads how many 64 KiB pages the memory holds and `memory.grow`
# adds pages past its end, zero filled by the host. nothing gives a page back
# to the host, so pages a caller gives back stay here, in address order and
# merged, and the next allocation takes them first. the heap region is the run
# of pages from the first one past what was handed out when it was first asked
# for. this is the machine's own memory, the same on every wasm target with or
# without a system, so the wasi layer and std's heap on a freestanding module
# both draw on it.

use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

$if ($mach.build.arch != $mach.arch.wasm32) {
    $error("std.memory.linear needs a wasm target");
}

val PAGE: usize = 65536;

# a run of whole pages given back, its header in its own first bytes
rec Span {
    next: *Span;
    size: usize;
}

var kept: *Span = nil;

# how far the heap region reaches
var region_end: usize = 0;

fun whole_pages(size: usize, out: *usize) bool {
    if (size > ~(0::usize) - (PAGE - 1)) { ret false; }
    @out = (size + PAGE - 1) & ~(PAGE - 1);
    ret true;
}

# the first address past linear memory, which only grows, so nothing past it
# was ever handed out
fun memory_end() usize {
    var pages: i32 = 0;
    asm mvp {
        local.get {pages}
        memory.size
        i32.store
    }
    ret pages::usize * PAGE;
}

# the pages past linear memory, zero filled by the host
#
# this is the one place new linear memory is reached
# ---
# size: bytes wanted, whole pages
# ret:  the pages, or nil when the host has no more
fun extend(size: usize) ptr {
    var pages: i32 = (size / PAGE)::i32;
    var old:   i32 = 0;
    asm mvp {
        local.get {old}
        local.get {pages}
        i32.load
        memory.grow
        i32.store
    }
    if (old < 0) { ret nil; }
    ret (old::usize * PAGE)::ptr;
}

# the wasm page size, 64 KiB, which every allocation here is counted in
# ---
# ret: page size in bytes
pub fun page_size() usize {
    ret PAGE;
}

# whole zero-filled pages, kept ones first
# ---
# size: bytes wanted
# ret:  the pages, or nil when memory is exhausted
pub fun allocate(size: usize) ptr {
    if (size == 0) { ret nil; }
    var wanted: usize = 0;
    if (!whole_pages(size, ?wanted)) { ret nil; }
    var link: **Span = ?kept;
    for (@link != nil) {
        val span: *Span = @link;
        if (span.size >= wanted) {
            if (span.size == wanted) { @link = span.next; }
            or {
                val rest: *Span = (span::usize + wanted)::*Span;
                rest.next = span.next;
                rest.size = span.size - wanted;
                @link     = rest;
            }
            memory.raw_zero(span::ptr, wanted);
            ret span::ptr;
        }
        link = ?span.next;
    }
    ret extend(wanted);
}

# keep pages for the next allocate, merged with their neighbours
# ---
# p:    the pages, on a page boundary
# size: their size in bytes
# ret:  false for an address off a page, which is kept nowhere
pub fun deallocate(p: ptr, size: usize) bool {
    if (p == nil || size == 0) { ret true; }
    var whole: usize = 0;
    if ((p::usize & (PAGE - 1)) != 0 || !whole_pages(size, ?whole)) { ret false; }
    val span: *Span  = p::*Span;
    var link: **Span = ?kept;
    var last: *Span  = nil;
    for (@link != nil && (@link)::usize < p::usize) {
        last = @link;
        link = ?last.next;
    }
    span.next = @link;
    span.size = whole;
    @link     = span;
    if (span.next != nil && span::usize + span.size == span.next::usize) {
        span.size = span.size + span.next.size;
        span.next = span.next.next;
    }
    if (last != nil && last::usize + last.size == span::usize) {
        last.size = last.size + span.size;
        last.next = span.next;
    }
    ret true;
}

# resize a page allocation, in place when its pages still hold it
pub fun reallocate(p: ptr, old_size: usize, new_size: usize) ptr {
    if (p == nil) { ret allocate(new_size); }
    if (new_size == 0) {
        deallocate(p, old_size);
        ret nil;
    }
    var held:   usize = 0;
    var wanted: usize = 0;
    if (!whole_pages(old_size, ?held) || !whole_pages(new_size, ?wanted)) { ret nil; }
    if (wanted <= held) {
        deallocate((p::usize + wanted)::ptr, held - wanted);
        ret p;
    }
    val moved: ptr = allocate(new_size);
    if (moved == nil) { ret nil; }
    memory.raw_copy(moved, p, old_size);
    deallocate(p, old_size);
    ret moved;
}

# the first address past what has been handed out
pub fun heap_region_base() usize {
    region_end = memory_end();
    ret region_end;
}

# move the region's end up to addr
#
# the region is contiguous: it takes kept pages that start where it ends, then
# new memory once it reaches the end of linear memory, so it stops growing
# while pages `allocate` handed out lie past it
# ---
# addr: the address wanted
# ret:  the address reached, on a page and at least addr, which stays put when
#       addr is out of reach
pub fun heap_region_extend(addr: usize) usize {
    if (region_end == 0)    { heap_region_base(); }
    if (addr <= region_end) { ret region_end; }
    var wanted: usize = 0;
    if (!whole_pages(addr - region_end, ?wanted)) { ret region_end; }
    var link: **Span = ?kept;
    for (@link != nil && (@link)::usize < region_end) {
        val passed: *Span = @link;
        link = ?passed.next;
    }
    var adjacent: usize = 0;
    if (@link != nil && (@link)::usize == region_end) {
        val next: *Span = @link;
        adjacent = next.size;
    }
    if (adjacent < wanted) {
        if (region_end + adjacent != memory_end() || extend(wanted - adjacent) == nil) { ret region_end; }
    }
    if (adjacent > wanted) {
        val span: *Span = @link;
        val rest: *Span = (region_end + wanted)::*Span;
        rest.next = span.next;
        rest.size = adjacent - wanted;
        @link     = rest;
        adjacent  = wanted;
    }
    or (adjacent != 0) {
        val span: *Span = @link;
        @link = span.next;
    }
    memory.raw_zero(region_end::ptr, adjacent);
    region_end = region_end + wanted;
    ret region_end;
}
