# on-demand buffers with caller-declared size classes, byte budgets and wake-ups
#
# a `Source` hands out address-stable chunks to accounts. `Pool` is std's source:
# the caller declares up to MAX_CLASSES size classes, a request is served from
# the smallest class that fits its bytes, alignment and secrecy, and a request
# larger than every class takes the oversize path, one contiguous block from the
# backing that is returned to it at release.
#
# budgets are bytes. every account has a budget per lane (the pool declares how
# many lanes there are) and may reserve bytes at open; growth past a reservation
# competes for the global budget less every reservation. a refusal is a result,
# never a crash:
#   budget     the account's own lane limit. never registered, since the
#              account's own releases end it
#   exhausted  the shared remainder is gone
#   memory     a backing refused
#   misuse     a stale ref, a foreign chunk, a held or in-flight violation, or
#              a concurrent entry
# an account refused as exhausted or memory is registered, when it asks, at most
# once and in FIFO order. each release wakes the oldest waiter: it moves to the
# ready list, `ready` drains ready handles oldest first, and the optional notify
# callback runs once per account woken. without notify a release makes no
# callbacks and never allocates.
#
# a secret class is backed by welded storage from std.memory.secret, held as a
# borrow so the pool itself carries no welded pointer: its chunks carry no plain
# data pointer, `secret` gives the welded view, and release wipes the whole
# chunk. `secret_typed[T]` views a held secret chunk as T values instead, with
# T's own secrecy shape, so a record with secret fields lives in the chunk with
# no cast. a hold sees its chunk one way only: once as bytes, the typed view is
# refused, and once as T, the byte view and every other type are refused, so no
# byte or field of one view aliases a byte of different secrecy in another. the
# next hold starts over on wiped storage. secret chunks are served through
# `SecretSource`, never through `Source`, so only a holder of a `SecretSource`
# is welded. welded storage needs the pages capability (HAS_PAGES), so a secret
# class or request is refused on a target without it (WELDED is false). a
# bring-your-own-OS implementation gets secret classes by providing the os
# contract's secret primitives.
#
# acquire is O(1) when a class serves it from a retained chunk; otherwise it costs
# one backing allocation. `backing_allocations` in the snapshot counts them, so a
# host can size each class's high_water for a steady state that never touches the
# backing.
#
# chunks never move while held. payloads are separate backing allocations and a
# class keeps up to its high_water released chunks for reuse; only the slot
# metadata lives in a growable table, and nothing hands its addresses out.
# opening an account reserves slot metadata for its reservation, so an acquire
# inside the reservation never fails on metadata. a reserved slot costs address
# space until it is first taken, and is written then. the table gives back what a
# peak grew: a chunk of it goes once it and the chunk below it hold no slot in
# use and no reservation needs them, so one empty chunk stays as slack. a held
# slot never moves, and a ref from a released chunk is refused once the table
# grows again.
#
# a pool is serialized-use: it is never entered concurrently. it is not tied to
# a thread, so work may hand a pool between threads as long as the hand-off is
# serialized. every call claims an entrant flag and a concurrent call is refused
# as misuse with no effect, a refused release leaving the chunk owned by its
# caller. one pool per worker is the intended deployment. callbacks (notify,
# trap, backings) must not call back into the pool.

use A: std.allocator;
use std.memory;
use std.memory.table;
use std.sync.atomic;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

$if (capability.HOSTED) {
    use std.allocator.fixed;
    use std.allocator.heap;
    use std.allocator.page;
}

$if (capability.HAS_PAGES) {
    use io_error: std.io.error;
}

pub val MAX_CLASSES: usize = 32;
pub val MAX_LANES:   usize = 8;
pub val OVERSIZE:    u16   = 0xffff;

val NONE:          u32   = 0xffffffff;
val SLOT_EMPTY:    u8    = 0;
val SLOT_HELD:     u8    = 1;
val SLOT_RETAINED: u8    = 2;
val DEFAULT_ALIGN: usize = 16;
val VIEW_NONE:     u8    = 0;
val VIEW_BYTES:    u8    = 1;
val VIEW_TYPED:    u8    = 2;

# what a caller asks for
# ---
# bytes:  the bytes needed, served rounded up to a class or exactly by oversize
# align:  the alignment needed, 0 for the default of 16
# lane:   the budget lane the bytes are charged to
# secret: whether the chunk must be secret-welded
pub rec Request {
    bytes:  usize;
    align:  usize;
    lane:   u8;
    secret: bool;
}

# a chunk's identity: an index and a generation, stale once released
pub rec Ref {
    index:      u32;
    generation: u32;
}

# a held chunk
# ---
# ref:   identity for release, data, retain and settle
# class: the class index, or OVERSIZE
# bytes: usable bytes, at least what was requested
# data:  the address, nil for a secret chunk (see `secret`)
pub rec Chunk {
    ref:   Ref;
    class: u16;
    bytes: usize;
    data:  *u8;
}

pub tag Status: u8 {
    ok;
    blocked;
    error;
}

pub tag Reason: u8 {
    none;
    budget;
    exhausted;
    memory;
    misuse;
}

pub rec Acquired {
    status: Status;
    reason: Reason;
    chunk:  Chunk;
}

# the per-lane byte budgets an account opens with
#
# the count travels inside the value: `lanes` says how many of `bytes` are
# filled, and `open_account` refuses as misuse unless it equals the pool's
# lane count. a caller cannot supply fewer budgets than the pool reads,
# because there is no pointer to read past. `bytes` is `MAX_LANES` long, as
# `Account.budgets` is.
# ---
# lanes: how many budgets are filled, which must equal the pool's lanes
# bytes: the budget per lane, in bytes
pub rec Budgets {
    lanes: usize;
    bytes: [8]usize;
}

# an owner of chunks and budgets, embedded by the caller
#
# the fields belong to the source that opened it. it must not move while open.
pub rec Account {
    pool:           *Pool;
    handle:         u64;
    budgets:        [8]usize;
    used:           [8]usize;
    reserve:        usize;
    reserved_slots: usize;
    held:           usize;
    chunks:         usize;
    open:           bool;
    waiting:        bool;
    is_ready:       bool;
    prev:           *Account;
    next:           *Account;
}

# the typed shape a held secret chunk is viewed as, built by the typed views
# ---
# kind:  the element type's identity, from `$type_id`
# size:  bytes per element
# align: the element alignment
# count: elements in the view
pub rec Shape {
    kind:  u64;
    size:  usize;
    align: usize;
    count: usize;
}

# the interface every plain buffer source implements
#
# a consumer drives a source only through these members, through the `source_*`
# functions below, so a host may supply its own source in place of `Pool`. a
# source serves plain chunks only and refuses a secret request as misuse. its
# type holds nothing welded, so a record holding a source passes through `ptr`
# ---
# ctx:              opaque context passed to every callback
# fn_open_account:  open (account, handle, budgets, reserve)
# fn_close_account: close an account, giving up its registration
# fn_acquire:       one chunk for (account, request, register on refusal)
# fn_acquire_n:     a set of chunks, all or nothing, written to the output array
# fn_release:       give a chunk back, `none` on success
# fn_data:          the address of a held plain chunk, nil when stale
# fn_retain:        count one more in-flight user of a held chunk
# fn_settle:        count one in-flight user finished
# fn_in_flight:     whether a held chunk has in-flight users
# fn_ready:         drain woken account handles, oldest first, returning the count
# fn_lanes:         budget lanes per account, 0 when undeclared
# fn_measure:       the bytes an acquisition would charge, 0 when refused
pub rec Source {
    ctx:              ptr;
    fn_open_account:  fun(ptr, *Account, u64, Budgets, usize) Reason;
    fn_close_account: fun(ptr, *Account) Reason;
    fn_acquire:       fun(ptr, *Account, Request, bool) Acquired;
    fn_acquire_n:     fun(ptr, *Account, *Request, usize, *Chunk, bool) Acquired;
    fn_release:       fun(ptr, *Account, Chunk) Reason;
    fn_data:          fun(ptr, Ref) *u8;
    fn_retain:        fun(ptr, Ref) Reason;
    fn_settle:        fun(ptr, Ref) Reason;
    fn_in_flight:     fun(ptr, Ref) bool;
    fn_ready:         fun(ptr, *u64, usize) usize;
    fn_lanes:         fun(ptr) usize;
    fn_measure:       fun(ptr, Request) usize;
}

# the interface for secret-welded chunks
#
# a secret consumer drives it through the `secret_source_*` functions below. it
# serves secret chunks only and refuses a plain request as misuse. `fn_view`
# returns a welded pointer, so a record holding a secret source is welded
# ---
# ctx:              opaque context passed to every callback
# fn_open_account:  open (account, handle, budgets, reserve)
# fn_close_account: close an account, giving up its registration
# fn_acquire:       one secret chunk for (account, request, register on refusal)
# fn_release:       give a secret chunk back, wiped in full, `none` on success
# fn_view:          the welded view of a held secret chunk, nil when stale
# fn_lanes:         budget lanes per account, 0 when undeclared
# fn_measure:       the bytes an acquisition would charge, 0 when refused
# fn_bind:          bind a held secret chunk to a typed shape, as `secret_bind`
pub rec SecretSource {
    ctx:              ptr;
    fn_open_account:  fun(ptr, *Account, u64, Budgets, usize) Reason;
    fn_close_account: fun(ptr, *Account) Reason;
    fn_acquire:       fun(ptr, *Account, Request, bool) Acquired;
    fn_release:       fun(ptr, *Account, Chunk) Reason;
    fn_view:          fun(ptr, Chunk) *^u8;
    fn_lanes:         fun(ptr) usize;
    fn_measure:       fun(ptr, Request) usize;
    fn_bind:          fun(ptr, Chunk, Shape) *^u8;
}

# one declared size class
# ---
# size:       usable bytes per chunk
# align:      chunk alignment, 0 for the default of 16
# secret:     whether chunks are secret-welded
# high_water: released chunks kept for reuse, the rest go back to the backing
pub rec ClassConfig {
    size:       usize;
    align:      usize;
    secret:     bool;
    high_water: usize;
}

# pool configuration
# ---
# classes:        the class declarations, copied at make
# class_count:    how many, at most MAX_CLASSES
# lanes:          budget lanes per account, 1 to MAX_LANES
# global_budget:  total bytes the pool may hand out
# initial_slots:  slot metadata to create up front, 0 for a small default
# notify:         optional, called once per account woken with its handle
# notify_context: first argument to notify
# trap:           optional, called on every misuse refusal
# trap_context:   first argument to trap
pub rec Config {
    classes:        *ClassConfig;
    class_count:    usize;
    lanes:          u8;
    global_budget:  usize;
    initial_slots:  usize;
    notify:         fun(ptr, u64);
    notify_context: ptr;
    trap:           fun(ptr);
    trap_context:   ptr;
}

rec ClassState {
    size:          usize;
    align:         usize;
    secret:        bool;
    high_water:    usize;
    retained_head: u32;
    retained:      usize;
    live:          usize;
    peak:          usize;
    acquisitions:  u64;
    releases:      u64;
    refusals:      u64;
    backing:       u64;
}

rec Slot {
    generation: u32;
    next:       u32;
    inflight:   u32;
    class:      u16;
    lane:       u8;
    state:      u8;
    secret:     bool;
    align:      usize;
    bytes:      usize;
    address:    usize;
    welded:     u32;
    welded_gen: u32;
    view:       u8;
    view_kind:  u64;
    account:    *Account;
    link:       usize;
}

pub rec ClassCounters {
    size:                usize;
    live:                usize;
    peak:                usize;
    retained:            usize;
    held_bytes:          usize;
    acquisitions:        u64;
    releases:            u64;
    refusals:            u64;
    backing_allocations: u64;
}

# a point-in-time view of a pool
pub rec Snapshot {
    classes:             [32]ClassCounters;
    class_count:         usize;
    bytes_live:          usize;
    bytes_peak:          usize;
    reserved:            usize;
    overflow:            usize;
    accounts:            usize;
    waiters:             usize;
    ready:               usize;
    misuse:              u64;
    oversize_live:       usize;
    oversize_bytes:      usize;
    acquisitions:        u64;
    oversize_acquired:   u64;
    oversize_returned:   u64;
    refusals:            u64;
    budget_refusals:     u64;
    backing_allocations: u64;
    release_failures:    u64;
    steps:               u64;
}

# std's buffer source
pub rec Pool {
    entrant:             i64;
    misuse:              i64;
    made:                bool;
    classes:             [32]ClassState;
    class_count:         usize;
    lanes:               usize;
    global_budget:       usize;
    reserved_total:      usize;
    overflow_used:       usize;
    bytes_live:          usize;
    bytes_peak:          usize;
    slots:               table.Table;
    slot_pool:           table.Pool;
    retained_in:         [table.DIRECTORY]usize;
    slots_in_use:        usize;
    slots_retained:      usize;
    slots_reserved:      usize;
    plain:               A.Allocator;
    notify:              fun(ptr, u64);
    notify_context:      ptr;
    trap:                fun(ptr);
    trap_context:        ptr;
    wait_head:           *Account;
    wait_tail:           *Account;
    ready_head:          *Account;
    ready_tail:          *Account;
    accounts:            usize;
    waiters:             usize;
    ready_count:         usize;
    oversize_live:       usize;
    oversize_bytes:      usize;
    acquisitions:        u64;
    oversize_acquired:   u64;
    oversize_returned:   u64;
    refusals:            u64;
    budget_refusals:     u64;
    backing_allocations: u64;
    # backing releases the backing refused
    release_failures: u64;
    steps:            u64;
}

fun enter(pool: *Pool) bool {
    var expected: i64 = 0;
    if (atomic.cas(?pool.entrant, ?expected, 1)) { ret true; }
    atomic.fetch_add(?pool.misuse, 1);
    if (pool.trap != nil) { pool.trap(pool.trap_context); }
    ret false;
}

fun leave(pool: *Pool) {
    atomic.store(?pool.entrant, 0);
}

fun misused(pool: *Pool) Reason {
    atomic.fetch_add(?pool.misuse, 1);
    if (pool.trap != nil) { pool.trap(pool.trap_context); }
    ret Reason.misuse{};
}

fun refusal(status: Status, reason: Reason) Acquired {
    var out: Acquired;
    out.status = status;
    out.reason = reason;
    ret out;
}

fun power_of_two(value: usize) bool {
    ret value != 0 && (value & (value - 1)) == 0;
}

fun effective_align(align: usize) usize {
    if (align == 0) { ret DEFAULT_ALIGN; }
    ret align;
}

fun round_up(value: usize, align: usize, output: *usize) bool {
    val mask: usize = align - 1;
    if (value > ~(0::usize) - mask) { ret false; }
    @output = (value + mask) & ~mask;
    ret true;
}

fun slot_at(pool: *Pool, index: u32) *Slot {
    ret table.at(?pool.slots, index::usize)::*Slot;
}

# every slot already owned or promised: held chunks, retained chunks and unused
# reservations. a retained chunk keeps its slot while it waits for reuse, so
# leaving it out undercounts the table and a fresh chunk finds no slot (#775)
fun slots_committed(pool: *Pool) usize {
    ret pool.slots_in_use + pool.slots_retained + pool.slots_reserved;
}

# keep demand slots backed. a slot index is a u32 below NONE, so the table
# never grows past that
fun ensure_slots(pool: *Pool, demand: usize) bool {
    if (demand > 0xfffffffe) { ret false; }
    for (pool.slots.capacity < demand) {
        val chunk: usize = pool.slots.chunk_count;
        if (chunk >= table.DIRECTORY) { ret false; }
        val grown: usize = pool.slots.capacity + table.chunk_capacity(?pool.slots, chunk);
        if (grown - 1 >= NONE::usize || !table.grow(?pool.slots)) { ret false; }
        table.pool_adopt(?pool.slot_pool, ?pool.slots);
    }
    ret true;
}

# a slot is written first when it is first taken, empty and starting from the
# pool's generation floor, so a reserved slot never taken costs no resident
# memory (#886)
fun take_slot(pool: *Pool) u32 {
    val index: usize = table.pool_peek(?pool.slot_pool, ?pool.slots);
    if (index == table.NO_INDEX) { ret NONE; }
    if (table.pool_untouched(?pool.slot_pool, ?pool.slots, index)) {
        val slot:  *Slot = slot_at(pool, index::u32);
        var blank: Slot;
        @slot           = blank;
        slot.generation = pool.slot_pool.floor;
        slot.next       = NONE;
    }
    table.pool_take(?pool.slot_pool, ?pool.slots);
    ret index::u32;
}

fun put_slot(pool: *Pool, index: u32) {
    val slot: *Slot = slot_at(pool, index);
    slot.state      = SLOT_EMPTY;
    slot.account    = nil;
    slot.address    = 0;
    slot.welded     = 0;
    slot.welded_gen = 0;
    slot.inflight   = 0;
    slot.next       = NONE;
    table.pool_put(?pool.slot_pool, ?pool.slots, index::usize);
}

# slots of chunk that are held, neither empty nor retained
fun held_in(pool: *Pool, chunk: usize) usize {
    ret pool.slot_pool.live[chunk] - pool.retained_in[chunk];
}

# move every retained chunk that sits above the lowest empty slot down into it.
# a retained slot carries no ref, since its generation moved on at release, so
# its payload may change slots while nothing held moves
# ---
# ret: how many retained chunks moved
fun lower_retained(pool: *Pool) usize {
    var moved: usize = 0;
    var c:     usize = 0;
    for (c < pool.class_count) {
        val cls:    *ClassState = ?pool.classes[c];
        var prev:   u32         = NONE;
        var cursor: u32         = cls.retained_head;
        for (cursor != NONE) {
            val free: usize = table.pool_peek(?pool.slot_pool, ?pool.slots);
            if (free == table.NO_INDEX) { ret moved; }
            val from: usize = table.chunk_of(?pool.slots, cursor::usize);
            val to:   usize = table.chunk_of(?pool.slots, free);
            var kept: u32   = cursor;
            if (to < from) {
                kept = take_slot(pool);
                val old:  *Slot = slot_at(pool, cursor);
                val slot: *Slot = slot_at(pool, kept);
                slot.state      = SLOT_RETAINED;
                slot.class      = old.class;
                slot.lane       = old.lane;
                slot.secret     = old.secret;
                slot.align      = old.align;
                slot.bytes      = old.bytes;
                slot.address    = old.address;
                slot.welded     = old.welded;
                slot.welded_gen = old.welded_gen;
                slot.next       = old.next;
                if (prev == NONE) { cls.retained_head = kept; }
                or                { slot_at(pool, prev).next = kept; }
                pool.retained_in[from] = pool.retained_in[from] - 1;
                pool.retained_in[to]   = pool.retained_in[to] + 1;
                put_slot(pool, cursor);
                moved = moved + 1;
            }
            prev   = kept;
            cursor = slot_at(pool, kept).next;
        }
        c = c + 1;
    }
    ret moved;
}

# give back what a peak grew, at the end of every entry that may have freed a
# slot or a reservation. a chunk goes once it and the chunk below it hold
# nothing and no reservation needs them. retained chunks pinning the top
# chunks move down first when there is room below
fun trim_locked(pool: *Pool) {
    val generation: usize = $offset_of(Slot, generation);
    for (true) {
        table.pool_trim_backed(?pool.slot_pool, ?pool.slots, generation, slots_committed(pool));
        if (pool.slots.chunk_count <= 1) { ret; }
        val top: usize = pool.slots.chunk_count - 1;
        if (held_in(pool, top) != 0 || held_in(pool, top - 1) != 0 ||
            pool.retained_in[top] + pool.retained_in[top - 1] == 0 ||
            slots_committed(pool) > table.chunk_start(?pool.slots, top - 1)) { ret; }
        val free: usize = table.pool_peek(?pool.slot_pool, ?pool.slots);
        if (free == table.NO_INDEX || table.chunk_of(?pool.slots, free) >= top - 1) { ret; }
        if (lower_retained(pool) == 0)                                              { ret; }
    }
}

fun plain_allocate(pool: *Pool, bytes: usize, align: usize) usize {
    val got: res[ptr, A.Error] = A.allocate_raw(?pool.plain, bytes, align);
    if (sel got.err) { ret 0; }
    ret got.ok::usize;
}

# the backing keeps the memory it refused, which the pool can only report
fun plain_release(pool: *Pool, address: usize, bytes: usize, align: usize) {
    val released: err[A.Error] = A.deallocate_raw(?pool.plain, address::ptr, bytes, align);
    if (sel released.err) { pool.release_failures = pool.release_failures + 1; }
}

fun secret_release(pool: *Pool, index: u32, generation: u32, bytes: usize) {
    if (!welded_release(index, generation, bytes)) { pool.release_failures = pool.release_failures + 1; }
}

fun slot_release(pool: *Pool, slot: *Slot, bytes: usize, align: usize) {
    if (slot.secret) {
        secret_release(pool, slot.welded, slot.welded_gen, bytes);
        slot.welded     = 0;
        slot.welded_gen = 0;
        ret;
    }
    plain_release(pool, slot.address, bytes, align);
    slot.address = 0;
}

# the smallest class serving the request, OVERSIZE when none does
fun select_class(pool: *Pool, request: Request) u16 {
    val align: usize = effective_align(request.align);
    var best:  u16   = OVERSIZE;
    var i:     usize = 0;
    for (i < pool.class_count) {
        pool.steps = pool.steps + 1;
        val cls: *ClassState = ?pool.classes[i];
        if (cls.secret == request.secret && cls.size >= request.bytes && cls.align >= align) {
            if (best == OVERSIZE || cls.size < pool.classes[best::usize].size) { best = i::u16; }
        }
        i = i + 1;
    }
    ret best;
}

# whether a request is well formed for this pool, the misuse half of acquire
fun request_valid(pool: *Pool, request: Request) bool {
    val align: usize = effective_align(request.align);
    ret request.bytes != 0 && request.lane::usize < pool.lanes && power_of_two(align) &&
        align <= table.ELEMENT_ALIGN * 4096 && (!request.secret || WELDED);
}

# the bytes an acquisition charges: the serving class size, or the request
# rounded up to its alignment when it is oversize. false when the rounding
# overflows, the one refusal that is not misuse
fun charge_of(pool: *Pool, class_index: u16, request: Request, out: *usize) bool {
    if (class_index == OVERSIZE) { ret round_up(request.bytes, effective_align(request.align), out); }
    @out = pool.classes[class_index::usize].size;
    ret true;
}

fun account_over(account: *Account, held: usize) usize {
    if (held > account.reserve) { ret held - account.reserve; }
    ret 0;
}

fun unlink_wait(pool: *Pool, account: *Account) {
    if (account.prev != nil) { account.prev.next = account.next; }
    or                       { pool.wait_head = account.next; }
    if (account.next != nil) { account.next.prev = account.prev; }
    or                       { pool.wait_tail = account.prev; }
    account.prev    = nil;
    account.next    = nil;
    account.waiting = false;
    pool.waiters    = pool.waiters - 1;
}

fun unlink_ready(pool: *Pool, account: *Account) {
    if (account.prev != nil) { account.prev.next = account.next; }
    or                       { pool.ready_head = account.next; }
    if (account.next != nil) { account.next.prev = account.prev; }
    or                       { pool.ready_tail = account.prev; }
    account.prev     = nil;
    account.next     = nil;
    account.is_ready = false;
    pool.ready_count = pool.ready_count - 1;
}

fun register_waiter(pool: *Pool, account: *Account) {
    if (account.waiting || account.is_ready) { ret; }
    account.prev = pool.wait_tail;
    account.next = nil;
    if (pool.wait_tail != nil) { pool.wait_tail.next = account; }
    or                         { pool.wait_head = account; }
    pool.wait_tail  = account;
    account.waiting = true;
    pool.waiters    = pool.waiters + 1;
}

fun wake_one(pool: *Pool) {
    val account: *Account = pool.wait_head;
    if (account == nil) { ret; }
    unlink_wait(pool, account);
    account.prev = pool.ready_tail;
    account.next = nil;
    if (pool.ready_tail != nil) { pool.ready_tail.next = account; }
    or                          { pool.ready_head = account; }
    pool.ready_tail  = account;
    account.is_ready = true;
    pool.ready_count = pool.ready_count + 1;
    if (pool.notify != nil) { pool.notify(pool.notify_context, account.handle); }
}

fun charge_fits(pool: *Pool, account: *Account, lane: usize, bytes: usize, reason: *Reason) bool {
    if (account.used[lane] > account.budgets[lane] || bytes > account.budgets[lane] - account.used[lane]) {
        @reason = Reason.budget{};
        ret false;
    }
    if (bytes > ~(0::usize) - account.held) {
        @reason = Reason.budget{};
        ret false;
    }
    val delta: usize = account_over(account, account.held + bytes) - account_over(account, account.held);
    val room:  usize = pool.global_budget - pool.reserved_total;
    if (pool.overflow_used > room || delta > room - pool.overflow_used) {
        @reason = Reason.exhausted{};
        ret false;
    }
    ret true;
}

fun charge(pool: *Pool, account: *Account, lane: usize, bytes: usize) {
    val delta: usize = account_over(account, account.held + bytes) - account_over(account, account.held);
    account.used[lane] = account.used[lane] + bytes;
    account.held       = account.held + bytes;
    pool.overflow_used = pool.overflow_used + delta;
    pool.bytes_live    = pool.bytes_live + bytes;
    if (pool.bytes_live > pool.bytes_peak) { pool.bytes_peak = pool.bytes_live; }
}

fun uncharge(pool: *Pool, account: *Account, lane: usize, bytes: usize) {
    val delta: usize = account_over(account, account.held) - account_over(account, account.held - bytes);
    account.used[lane] = account.used[lane] - bytes;
    account.held       = account.held - bytes;
    pool.overflow_used = pool.overflow_used - delta;
    pool.bytes_live    = pool.bytes_live - bytes;
}

# acquire with the entrant already claimed
fun acquire_locked(pool: *Pool, account: *Account, request: Request, register: bool) Acquired {
    if (account == nil || account.pool != pool || !account.open || !request_valid(pool, request)) {
        ret refusal(Status.error{}, misused(pool));
    }
    val class_index: u16   = select_class(pool, request);
    val align:       usize = effective_align(request.align);
    var bytes:       usize = 0;
    if (!charge_of(pool, class_index, request, ?bytes)) { ret refusal(Status.blocked{}, Reason.budget{}); }
    val lane:   usize = request.lane::usize;
    var reason: Reason;
    if (!charge_fits(pool, account, lane, bytes, ?reason)) {
        pool.refusals = pool.refusals + 1;
        if (class_index != OVERSIZE) {
            pool.classes[class_index::usize].refusals = pool.classes[class_index::usize].refusals + 1;
        }
        if (sel reason.budget) { pool.budget_refusals = pool.budget_refusals + 1; }
        or (register)          { register_waiter(pool, account); }
        ret refusal(Status.blocked{}, reason);
    }
    # a slot inside the reservation is already backed; past it the table may grow
    val inside:       bool  = account.chunks < account.reserved_slots;
    var secret_chunk: bool  = request.secret;
    var chunk_align:  usize = align;
    if (class_index != OVERSIZE) {
        secret_chunk = pool.classes[class_index::usize].secret;
        chunk_align  = pool.classes[class_index::usize].align;
    }
    var index:   u32   = NONE;
    var address: usize = 0;
    var welded:  u32   = 0;
    var wgen:    u32   = 0;
    if (class_index != OVERSIZE && pool.classes[class_index::usize].retained_head != NONE) {
        val cls: *ClassState = ?pool.classes[class_index::usize];
        index = cls.retained_head;
        val kept: *Slot = slot_at(pool, index);
        cls.retained_head   = kept.next;
        cls.retained        = cls.retained - 1;
        pool.slots_retained = pool.slots_retained - 1;
        val home: usize = table.chunk_of(?pool.slots, index::usize);
        pool.retained_in[home] = pool.retained_in[home] - 1;
        address                = kept.address;
        welded                 = kept.welded;
        wgen                   = kept.welded_gen;
    }
    or {
        # a retained chunk brings its own slot, a fresh one needs one more
        if (!inside && !ensure_slots(pool, slots_committed(pool) + 1)) {
            pool.refusals = pool.refusals + 1;
            if (register) { register_waiter(pool, account); }
            ret refusal(Status.blocked{}, Reason.memory{});
        }
        var backed: bool = false;
        if (secret_chunk) {
            backed = welded_allocate(pool, bytes, ?welded, ?wgen);
        }
        or {
            address = plain_allocate(pool, bytes, chunk_align);
            backed  = address != 0;
        }
        if (backed) {
            index = take_slot(pool);
            # the demand above keeps a slot free, but a missing one is still a
            # refusal that gives the backing back, never a write through nil
            if (index == NONE) {
                if (secret_chunk) { secret_release(pool, welded, wgen, bytes); }
                or                { plain_release(pool, address, bytes, chunk_align); }
                backed = false;
            }
        }
        if (!backed) {
            pool.refusals = pool.refusals + 1;
            if (class_index != OVERSIZE) {
                pool.classes[class_index::usize].refusals = pool.classes[class_index::usize].refusals + 1;
            }
            if (register) { register_waiter(pool, account); }
            ret refusal(Status.blocked{}, Reason.memory{});
        }
        pool.backing_allocations = pool.backing_allocations + 1;
        if (class_index != OVERSIZE) {
            pool.classes[class_index::usize].backing = pool.classes[class_index::usize].backing + 1;
        }
    }
    pool.steps = pool.steps + 1;
    val slot: *Slot = slot_at(pool, index);
    slot.generation = slot.generation + 1;
    if (slot.generation == 0) { slot.generation = 1; }
    slot.state      = SLOT_HELD;
    slot.class      = class_index;
    slot.lane       = request.lane;
    slot.bytes      = bytes;
    slot.address    = address;
    slot.welded     = welded;
    slot.welded_gen = wgen;
    slot.align      = chunk_align;
    slot.account    = account;
    slot.inflight   = 0;
    slot.next       = NONE;
    slot.secret     = secret_chunk;
    slot.view       = VIEW_NONE;
    slot.view_kind  = 0;
    charge(pool, account, lane, bytes);
    account.chunks = account.chunks + 1;
    if (!inside) { pool.slots_in_use = pool.slots_in_use + 1; }
    or {
        pool.slots_reserved = pool.slots_reserved - 1;
        pool.slots_in_use   = pool.slots_in_use + 1;
    }
    pool.acquisitions = pool.acquisitions + 1;
    if (class_index == OVERSIZE) {
        pool.oversize_live     = pool.oversize_live + 1;
        pool.oversize_bytes    = pool.oversize_bytes + bytes;
        pool.oversize_acquired = pool.oversize_acquired + 1;
    }
    or {
        val cls: *ClassState = ?pool.classes[class_index::usize];
        cls.live         = cls.live + 1;
        cls.acquisitions = cls.acquisitions + 1;
        if (cls.live > cls.peak) { cls.peak = cls.live; }
    }
    var out: Acquired;
    out.status      = Status.ok{};
    out.reason      = Reason.none{};
    out.chunk.ref   = Ref{index: index, generation: slot.generation};
    out.chunk.class = class_index;
    out.chunk.bytes = bytes;
    out.chunk.data  = nil;
    if (!secret_chunk) { out.chunk.data = address::*u8; }
    ret out;
}

fun held_slot(pool: *Pool, ref: Ref) *Slot {
    if (table.pool_untouched(?pool.slot_pool, ?pool.slots, ref.index::usize)) { ret nil; }
    val slot: *Slot = slot_at(pool, ref.index);
    if (slot.state != SLOT_HELD || slot.generation != ref.generation) { ret nil; }
    ret slot;
}

fun release_locked(pool: *Pool, account: *Account, chunk: Chunk, wake: bool) Reason {
    if (account == nil || account.pool != pool) { ret misused(pool); }
    val slot: *Slot = held_slot(pool, chunk.ref);
    if (slot == nil || slot.account != account || slot.class != chunk.class || slot.inflight != 0) {
        ret misused(pool);
    }
    pool.steps = pool.steps + 1;
    val bytes: usize = slot.bytes;
    uncharge(pool, account, slot.lane::usize, bytes);
    account.chunks    = account.chunks - 1;
    pool.slots_in_use = pool.slots_in_use - 1;
    if (account.chunks < account.reserved_slots) { pool.slots_reserved = pool.slots_reserved + 1; }
    slot.generation = slot.generation + 1;
    if (slot.generation == 0) { slot.generation = 1; }
    slot.account = nil;
    if (slot.class == OVERSIZE) {
        # oversize blocks go straight back to the backing
        slot_release(pool, slot, bytes, slot.align);
        pool.oversize_live     = pool.oversize_live - 1;
        pool.oversize_bytes    = pool.oversize_bytes - bytes;
        pool.oversize_returned = pool.oversize_returned + 1;
        put_slot(pool, chunk.ref.index);
    }
    or {
        val cls: *ClassState = ?pool.classes[slot.class::usize];
        cls.live     = cls.live - 1;
        cls.releases = cls.releases + 1;
        if (cls.secret) { welded_wipe(slot.welded, slot.welded_gen, cls.size); }
        if (cls.retained < cls.high_water) {
            slot.state          = SLOT_RETAINED;
            slot.next           = cls.retained_head;
            cls.retained_head   = chunk.ref.index;
            cls.retained        = cls.retained + 1;
            pool.slots_retained = pool.slots_retained + 1;
            val home: usize = table.chunk_of(?pool.slots, chunk.ref.index::usize);
            pool.retained_in[home] = pool.retained_in[home] + 1;
        }
        or {
            slot_release(pool, slot, cls.size, cls.align);
            put_slot(pool, chunk.ref.index);
        }
    }
    if (wake) { wake_one(pool); }
    ret Reason.none{};
}

# make a pool
# ---
# pool:   the pool to initialize
# config: the classes and budgets, copied
# plain:  the backing for plain chunks and slot metadata, copied, whose context
#         must outlive the pool
# ret:    whether the pool was made, refused when a class is secret on a target
#         without welded storage
pub fun make(pool: *Pool, config: Config, plain: *A.Allocator) bool {
    if (pool == nil || plain == nil || config.class_count > MAX_CLASSES ||
        (config.class_count != 0 && config.classes == nil) ||
        config.lanes == 0 || config.lanes::usize > MAX_LANES) { ret false; }
    var i: usize = 0;
    for (i < config.class_count) {
        val c:     ClassConfig = config.classes[i];
        val align: usize       = effective_align(c.align);
        if (c.size == 0 || !power_of_two(align) || align > table.ELEMENT_ALIGN * 4096) { ret false; }
        if (c.secret && !WELDED)                                                       { ret false; }
        i = i + 1;
    }
    var blank: Pool;
    @pool      = blank;
    pool.plain = @plain;
    i          = 0;
    for (i < config.class_count) {
        val c:   ClassConfig = config.classes[i];
        val cls: *ClassState = ?pool.classes[i];
        cls.size          = c.size;
        cls.align         = effective_align(c.align);
        cls.secret        = c.secret;
        cls.high_water    = c.high_water;
        cls.retained_head = NONE;
        i                 = i + 1;
    }
    var initial: usize = config.initial_slots;
    if (initial == 0)                                             { initial = 16; }
    if (!table.make(?pool.slots, plain, $size_of(Slot), initial)) { ret false; }
    table.pool_make(?pool.slot_pool, $offset_of(Slot, link));
    table.pool_adopt(?pool.slot_pool, ?pool.slots);
    pool.class_count    = config.class_count;
    pool.lanes          = config.lanes::usize;
    pool.global_budget  = config.global_budget;
    pool.notify         = config.notify;
    pool.notify_context = config.notify_context;
    pool.trap           = config.trap;
    pool.trap_context   = config.trap_context;
    pool.made           = true;
    ret true;
}

# release every retained chunk and the slot metadata
#
# refused while any account is open, so no held chunk is ever leaked or freed
# under its owner
pub fun destroy(pool: *Pool) bool {
    if (pool == nil || !pool.made || !enter(pool)) { ret false; }
    if (pool.accounts != 0) {
        misused(pool);
        leave(pool);
        ret false;
    }
    var c: usize = 0;
    for (c < pool.class_count) {
        val cls:   *ClassState = ?pool.classes[c];
        var index: u32         = cls.retained_head;
        for (index != NONE) {
            val slot: *Slot = slot_at(pool, index);
            slot_release(pool, slot, cls.size, cls.align);
            index = slot.next;
        }
        pool.slots_retained = pool.slots_retained - cls.retained;
        cls.retained_head   = NONE;
        cls.retained        = 0;
        c                   = c + 1;
    }
    table.destroy(?pool.slots);
    pool.made = false;
    leave(pool);
    ret true;
}

# open an account
# ---
# pool:    the pool
# account: caller-embedded storage that must not move while open
# handle:  the caller's identity, reported by ready and notify
# budgets: one byte budget per lane, with `budgets.lanes` equal to `lanes(pool)`
# reserve: bytes reserved out of the global budget for this account
# ret:     none, exhausted when the reservation cannot be granted, memory when
#          its metadata cannot be backed, or misuse, which a lane count that
#          differs from the pool's is
pub fun open_account(pool: *Pool, account: *Account, handle: u64, budgets: Budgets, reserve: usize) Reason {
    if (pool == nil || !pool.made) { ret Reason.misuse{}; }
    if (!enter(pool))              { ret Reason.misuse{}; }
    if (account == nil || budgets.lanes != pool.lanes || (account.open && account.pool == pool)) {
        val r: Reason = misused(pool);
        leave(pool);
        ret r;
    }
    if (reserve > pool.global_budget - pool.reserved_total) {
        leave(pool);
        ret Reason.exhausted{};
    }
    if (pool.global_budget - pool.reserved_total - reserve < pool.overflow_used) {
        leave(pool);
        ret Reason.exhausted{};
    }
    # the smallest chunk bounds how many chunks the reservation can hold
    var slots: usize = 0;
    if (reserve != 0) {
        var smallest: usize = reserve;
        var c:        usize = 0;
        for (c < pool.class_count) {
            if (pool.classes[c].size < smallest) { smallest = pool.classes[c].size; }
            c = c + 1;
        }
        slots = (reserve + smallest - 1) / smallest;
    }
    if (!ensure_slots(pool, slots_committed(pool) + slots)) {
        trim_locked(pool);
        leave(pool);
        ret Reason.memory{};
    }
    var blank: Account;
    @account               = blank;
    account.pool           = pool;
    account.handle         = handle;
    account.reserve        = reserve;
    account.reserved_slots = slots;
    account.open           = true;
    var lane: usize = 0;
    for (lane < pool.lanes) {
        account.budgets[lane] = budgets.bytes[lane];
        lane                  = lane + 1;
    }
    pool.reserved_total = pool.reserved_total + reserve;
    pool.slots_reserved = pool.slots_reserved + slots;
    pool.accounts       = pool.accounts + 1;
    leave(pool);
    ret Reason.none{};
}

# close an account holding no chunks, unlinking any registration
pub fun close_account(pool: *Pool, account: *Account) Reason {
    if (pool == nil || !enter(pool)) { ret Reason.misuse{}; }
    if (account == nil || account.pool != pool || !account.open || account.chunks != 0) {
        val r: Reason = misused(pool);
        leave(pool);
        ret r;
    }
    if (account.waiting)  { unlink_wait(pool, account); }
    if (account.is_ready) { unlink_ready(pool, account); }
    pool.reserved_total = pool.reserved_total - account.reserve;
    pool.slots_reserved = pool.slots_reserved - account.reserved_slots;
    pool.accounts       = pool.accounts - 1;
    account.open        = false;
    account.pool        = nil;
    trim_locked(pool);
    leave(pool);
    ret Reason.none{};
}

# acquire one chunk
# ---
# register: on exhausted or memory, register the account for one wake-up
pub fun acquire(pool: *Pool, account: *Account, request: Request, register: bool) Acquired {
    if (pool == nil || !pool.made) { ret refusal(Status.error{}, Reason.misuse{}); }
    if (!enter(pool))              { ret refusal(Status.error{}, Reason.misuse{}); }
    val out: Acquired = acquire_locked(pool, account, request, register);
    trim_locked(pool);
    leave(pool);
    ret out;
}

# acquire every requested chunk or none
#
# a partial set is released inside the pool, without waking anyone, before the
# refusal is reported. `out` holds count chunks on success
pub fun acquire_n(pool: *Pool, account: *Account, requests: *Request, count: usize, out: *Chunk, register: bool) Acquired {
    if (pool == nil || !pool.made) { ret refusal(Status.error{}, Reason.misuse{}); }
    if (!enter(pool))              { ret refusal(Status.error{}, Reason.misuse{}); }
    if ((count != 0 && (requests == nil || out == nil))) {
        val r: Reason = misused(pool);
        leave(pool);
        ret refusal(Status.error{}, r);
    }
    var i: usize = 0;
    for (i < count) {
        val got: Acquired = acquire_locked(pool, account, requests[i], false);
        if (!sel got.status.ok) {
            var j: usize = 0;
            for (j < i) {
                release_locked(pool, account, out[j], false);
                j = j + 1;
            }
            if (register && (sel got.reason.exhausted || sel got.reason.memory)) { register_waiter(pool, account); }
            trim_locked(pool);
            leave(pool);
            ret got;
        }
        out[i] = got.chunk;
        i      = i + 1;
    }
    leave(pool);
    var done: Acquired;
    done.status = Status.ok{};
    done.reason = Reason.none{};
    if (count != 0) { done.chunk = out[0]; }
    ret done;
}

# give a chunk back
#
# a secret chunk is wiped in full. the oldest waiter, if any, is woken. a
# refused release leaves the chunk held by its caller
pub fun release(pool: *Pool, account: *Account, chunk: Chunk) Reason {
    if (pool == nil || !pool.made) { ret Reason.misuse{}; }
    if (!enter(pool))              { ret Reason.misuse{}; }
    val r: Reason = release_locked(pool, account, chunk, true);
    trim_locked(pool);
    leave(pool);
    ret r;
}

# the welded view of a held secret chunk, nil for a plain or stale one, or one
# this hold already views as a type
pub fun secret(pool: *Pool, chunk: Chunk) *^u8 {
    if (pool == nil || !pool.made || chunk.data != nil) { ret nil; }
    if (!enter(pool))                                   { ret nil; }
    val slot: *Slot = held_slot(pool, chunk.ref);
    var view: *^u8  = nil;
    if (slot != nil && slot.secret && slot.view != VIEW_TYPED) {
        view = welded_view(slot.welded, slot.welded_gen);
        if (view != nil) { slot.view = VIEW_BYTES; }
    }
    leave(pool);
    ret view;
}

# whether a shape fits a held secret chunk: its whole span inside the usable
# bytes, and its alignment one the chunk's class or request guarantees
fun shape_fits(slot: *Slot, shape: Shape) bool {
    if (shape.size == 0 || shape.count == 0)    { ret false; }
    if (shape.count > ~(0::usize) / shape.size) { ret false; }
    ret shape.size * shape.count <= slot.bytes && power_of_two(shape.align) && shape.align <= slot.align;
}

# bind a held secret chunk to a typed shape for the rest of its hold
#
# this is the pool's side of the typed views. it returns the chunk's storage for
# `secret_typed` or `secret_source_view_typed` to retype, and a source's
# `fn_bind` forwards here. it is not a byte view: reading or writing the result
# as bytes breaks the one-way rule the binding exists for. nil for a plain, stale
# or foreign chunk, a shape that does not fit, storage not aligned for the
# shape, a chunk this hold already views as bytes, or one bound to another type
# ---
# shape: the element type's identity, size and alignment, and the count
pub fun secret_bind(pool: *Pool, chunk: Chunk, shape: Shape) *^u8 {
    if (pool == nil || !pool.made || chunk.data != nil) { ret nil; }
    if (!enter(pool))                                   { ret nil; }
    val slot: *Slot = held_slot(pool, chunk.ref);
    var view: *^u8  = nil;
    if (slot != nil && slot.secret && slot.view != VIEW_BYTES && shape_fits(slot, shape) &&
        (slot.view == VIEW_NONE || slot.view_kind == shape.kind)) {
        view = welded_view(slot.welded, slot.welded_gen);
        if (view != nil && !welded_aligned(view, shape.align)) { view = nil; }
        if (view != nil) {
            slot.view      = VIEW_TYPED;
            slot.view_kind = shape.kind;
        }
    }
    leave(pool);
    ret view;
}

fun shape_of[T](count: usize) Shape {
    ret Shape{kind: $type_id(T), size: $size_of(T), align: $align_of(T), count: count};
}

# a held secret chunk viewed as count values of T, with T's secrecy shape
#
# T may be any record, secret fields, nested records and secret arrays
# included. the chunk's storage is used as is: it is zero at the first view of
# a fresh hold, and release wipes every byte of it. the view binds the hold to
# T, so later calls with T give the same address for any count that fits, and
# `secret` and a view as any other type are refused until the chunk is released
# ---
# count: T values the view holds
# ret:   the view, or nil for a plain, stale or foreign chunk, a zero or
#        overflowing count, `count * $size_of(T)` past the chunk's bytes, a
#        class or request alignment below `$align_of(T)`, a chunk this hold
#        already views as bytes, or one it views as another type
pub fun secret_typed[T](pool: *Pool, chunk: Chunk, count: usize) *T {
    ret welded_as[T](secret_bind(pool, chunk, shape_of[T](count)));
}

# the address of a held plain chunk, nil when the ref is stale or secret
pub fun data(pool: *Pool, ref: Ref) *u8 {
    if (pool == nil || !pool.made || !enter(pool)) { ret nil; }
    val slot:    *Slot = held_slot(pool, ref);
    var address: *u8   = nil;
    if (slot != nil) {
        if (!slot.secret) { address = slot.address::*u8; }
    }
    leave(pool);
    ret address;
}

# count an in-flight user, such as an operation the chunk was handed to
pub fun retain(pool: *Pool, ref: Ref) Reason {
    if (pool == nil || !pool.made || !enter(pool)) { ret Reason.misuse{}; }
    val slot: *Slot = held_slot(pool, ref);
    if (slot == nil || slot.inflight == 0xffffffff) {
        val r: Reason = misused(pool);
        leave(pool);
        ret r;
    }
    slot.inflight = slot.inflight + 1;
    leave(pool);
    ret Reason.none{};
}

# end one in-flight use
pub fun settle(pool: *Pool, ref: Ref) Reason {
    if (pool == nil || !pool.made || !enter(pool)) { ret Reason.misuse{}; }
    val slot: *Slot = held_slot(pool, ref);
    if (slot == nil || slot.inflight == 0) {
        val r: Reason = misused(pool);
        leave(pool);
        ret r;
    }
    slot.inflight = slot.inflight - 1;
    leave(pool);
    ret Reason.none{};
}

# whether a held chunk has in-flight users
pub fun in_flight(pool: *Pool, ref: Ref) bool {
    if (pool == nil || !pool.made || !enter(pool)) { ret false; }
    val slot:   *Slot = held_slot(pool, ref);
    var flight: bool  = false;
    if (slot != nil) { flight = slot.inflight != 0; }
    leave(pool);
    ret flight;
}

# budget lanes per account, fixed at make
# ---
# ret: the configured count, 0 for a nil or unmade pool
pub fun lanes(pool: *Pool) usize {
    if (pool == nil || !pool.made) { ret 0; }
    ret pool.lanes;
}

# the bytes `acquire` would charge for a request, without acquiring
#
# the same class selection and rounding as `acquire`: the smallest fitting
# class's size, or the request rounded up to its alignment when no class fits
# ---
# ret: the charge, 0 for a nil or unmade pool, a request `acquire` would refuse
#      as misuse, or a rounding that overflows
pub fun measure(pool: *Pool, request: Request) usize {
    if (pool == nil || !pool.made || !enter(pool)) { ret 0; }
    var bytes: usize = 0;
    if (request_valid(pool, request) && !charge_of(pool, select_class(pool, request), request, ?bytes)) { bytes = 0; }
    leave(pool);
    ret bytes;
}

# drain the handles of woken accounts, oldest first
# ---
# ret: handles written, at most capacity
pub fun ready(pool: *Pool, output: *u64, capacity: usize) usize {
    if (pool == nil || !pool.made || (capacity != 0 && output == nil) || !enter(pool)) { ret 0; }
    var written: usize = 0;
    for (written < capacity && pool.ready_head != nil) {
        val account: *Account = pool.ready_head;
        output[written] = account.handle;
        unlink_ready(pool, account);
        written = written + 1;
    }
    leave(pool);
    ret written;
}

# a point-in-time view of the pool's counters
pub fun snapshot(pool: *Pool, output: *Snapshot) bool {
    if (pool == nil || output == nil || !pool.made || !enter(pool)) { ret false; }
    var blank: Snapshot;
    @output = blank;
    var c: usize = 0;
    for (c < pool.class_count) {
        val cls: *ClassState = ?pool.classes[c];
        output.classes[c] = ClassCounters{
            size:                cls.size,
            live:                cls.live,
            peak:                cls.peak,
            retained:            cls.retained,
            held_bytes:          cls.live * cls.size,
            acquisitions:        cls.acquisitions,
            releases:            cls.releases,
            refusals:            cls.refusals,
            backing_allocations: cls.backing,
        };
        c = c + 1;
    }
    output.class_count         = pool.class_count;
    output.bytes_live          = pool.bytes_live;
    output.bytes_peak          = pool.bytes_peak;
    output.reserved            = pool.reserved_total;
    output.overflow            = pool.overflow_used;
    output.accounts            = pool.accounts;
    output.waiters             = pool.waiters;
    output.ready               = pool.ready_count;
    output.misuse              = atomic.load(?pool.misuse)::u64;
    output.oversize_live       = pool.oversize_live;
    output.oversize_bytes      = pool.oversize_bytes;
    output.acquisitions        = pool.acquisitions;
    output.oversize_acquired   = pool.oversize_acquired;
    output.oversize_returned   = pool.oversize_returned;
    output.refusals            = pool.refusals;
    output.budget_refusals     = pool.budget_refusals;
    output.backing_allocations = pool.backing_allocations;
    output.release_failures    = pool.release_failures;
    output.steps               = pool.steps;
    leave(pool);
    ret true;
}

fun pool_open_account(context: ptr, account: *Account, handle: u64, budgets: Budgets, reserve: usize) Reason {
    ret open_account(context::*Pool, account, handle, budgets, reserve);
}

fun pool_close_account(context: ptr, account: *Account) Reason {
    ret close_account(context::*Pool, account);
}

# a request on the wrong surface: counted as misuse with no other effect
fun wrong_surface(pool: *Pool) Acquired {
    if (pool == nil || !pool.made) { ret refusal(Status.error{}, Reason.misuse{}); }
    if (!enter(pool))              { ret refusal(Status.error{}, Reason.misuse{}); }
    val r: Reason = misused(pool);
    leave(pool);
    ret refusal(Status.error{}, r);
}

fun pool_acquire(context: ptr, account: *Account, request: Request, register: bool) Acquired {
    if (request.secret) { ret wrong_surface(context::*Pool); }
    ret acquire(context::*Pool, account, request, register);
}

fun pool_acquire_n(context: ptr, account: *Account, requests: *Request, count: usize, out: *Chunk, register: bool) Acquired {
    var i: usize = 0;
    for (requests != nil && i < count) {
        if (requests[i].secret) { ret wrong_surface(context::*Pool); }
        i = i + 1;
    }
    ret acquire_n(context::*Pool, account, requests, count, out, register);
}

fun pool_release(context: ptr, account: *Account, chunk: Chunk) Reason {
    ret release(context::*Pool, account, chunk);
}

fun pool_secret_acquire(context: ptr, account: *Account, request: Request, register: bool) Acquired {
    if (!request.secret) { ret wrong_surface(context::*Pool); }
    ret acquire(context::*Pool, account, request, register);
}

fun pool_secret_release(context: ptr, account: *Account, chunk: Chunk) Reason {
    if (chunk.data != nil) { ret wrong_surface(context::*Pool).reason; }
    ret release(context::*Pool, account, chunk);
}

fun pool_secret_view(context: ptr, chunk: Chunk) *^u8 {
    ret secret(context::*Pool, chunk);
}

fun pool_secret_bind(context: ptr, chunk: Chunk, shape: Shape) *^u8 {
    ret secret_bind(context::*Pool, chunk, shape);
}

fun pool_data(context: ptr, ref: Ref) *u8 {
    ret data(context::*Pool, ref);
}

fun pool_retain(context: ptr, ref: Ref) Reason {
    ret retain(context::*Pool, ref);
}

fun pool_settle(context: ptr, ref: Ref) Reason {
    ret settle(context::*Pool, ref);
}

fun pool_in_flight(context: ptr, ref: Ref) bool {
    ret in_flight(context::*Pool, ref);
}

fun pool_ready(context: ptr, output: *u64, capacity: usize) usize {
    ret ready(context::*Pool, output, capacity);
}

fun pool_lanes(context: ptr) usize {
    ret lanes(context::*Pool);
}

fun pool_measure(context: ptr, request: Request) usize {
    ret measure(context::*Pool, request);
}

# the pool as a Source, borrowing the pool
pub fun source(pool: *Pool) Source {
    ret Source{
        ctx:              pool::ptr,
        fn_open_account:  pool_open_account,
        fn_close_account: pool_close_account,
        fn_acquire:       pool_acquire,
        fn_acquire_n:     pool_acquire_n,
        fn_release:       pool_release,
        fn_data:          pool_data,
        fn_retain:        pool_retain,
        fn_settle:        pool_settle,
        fn_in_flight:     pool_in_flight,
        fn_ready:         pool_ready,
        fn_lanes:         pool_lanes,
        fn_measure:       pool_measure,
    };
}

# the pool as a SecretSource, borrowing the pool
pub fun secret_source(pool: *Pool) SecretSource {
    ret SecretSource{
        ctx:              pool::ptr,
        fn_open_account:  pool_open_account,
        fn_close_account: pool_close_account,
        fn_acquire:       pool_secret_acquire,
        fn_release:       pool_secret_release,
        fn_view:          pool_secret_view,
        fn_lanes:         pool_lanes,
        fn_measure:       pool_measure,
        fn_bind:          pool_secret_bind,
    };
}

# open an account on a source
# ---
# s:       the source
# account: caller-embedded account, which must not move while open
# handle:  the value `source_ready` reports when the account is woken
# budgets: one byte budget per lane the source declares, `budgets.lanes` equal to `source_lanes`
# reserve: bytes reserved for the account at open
# ret:     `none` on success, or the refusal
pub fun source_open_account(s: *Source, account: *Account, handle: u64, budgets: Budgets, reserve: usize) Reason {
    if (s == nil || s.fn_open_account == nil) { ret Reason.misuse{}; }
    ret s.fn_open_account(s.ctx, account, handle, budgets, reserve);
}

# close an account, dropping any registration it holds
pub fun source_close_account(s: *Source, account: *Account) Reason {
    if (s == nil || s.fn_close_account == nil) { ret Reason.misuse{}; }
    ret s.fn_close_account(s.ctx, account);
}

# acquire one chunk from a source
# ---
# register: whether an exhausted or memory refusal registers the account
pub fun source_acquire(s: *Source, account: *Account, request: Request, register: bool) Acquired {
    if (s == nil || s.fn_acquire == nil) { ret refusal(Status.error{}, Reason.misuse{}); }
    ret s.fn_acquire(s.ctx, account, request, register);
}

# acquire every requested chunk, or none of them
pub fun source_acquire_n(s: *Source, account: *Account, requests: *Request, count: usize, out: *Chunk, register: bool) Acquired {
    if (s == nil || s.fn_acquire_n == nil) { ret refusal(Status.error{}, Reason.misuse{}); }
    ret s.fn_acquire_n(s.ctx, account, requests, count, out, register);
}

# release a chunk to its source
pub fun source_release(s: *Source, account: *Account, chunk: Chunk) Reason {
    if (s == nil || s.fn_release == nil) { ret Reason.misuse{}; }
    ret s.fn_release(s.ctx, account, chunk);
}

# the address of a held plain chunk, nil when the ref is stale
pub fun source_data(s: *Source, ref: Ref) *u8 {
    if (s == nil || s.fn_data == nil) { ret nil; }
    ret s.fn_data(s.ctx, ref);
}

# count one more in-flight user of a held chunk
pub fun source_retain(s: *Source, ref: Ref) Reason {
    if (s == nil || s.fn_retain == nil) { ret Reason.misuse{}; }
    ret s.fn_retain(s.ctx, ref);
}

# count one in-flight user of a held chunk finished
pub fun source_settle(s: *Source, ref: Ref) Reason {
    if (s == nil || s.fn_settle == nil) { ret Reason.misuse{}; }
    ret s.fn_settle(s.ctx, ref);
}

# whether a held chunk has in-flight users
pub fun source_in_flight(s: *Source, ref: Ref) bool {
    if (s == nil || s.fn_in_flight == nil) { ret false; }
    ret s.fn_in_flight(s.ctx, ref);
}

# drain woken account handles into output, oldest first
# ---
# ret: how many handles were written, at most capacity
pub fun source_ready(s: *Source, output: *u64, capacity: usize) usize {
    if (s == nil || s.fn_ready == nil) { ret 0; }
    ret s.fn_ready(s.ctx, output, capacity);
}

# budget lanes per account the source declares
#
# `source_open_account` refuses a `Budgets` whose `lanes` differs from this
# ---
# ret: the lane count, 0 when the source declares none
pub fun source_lanes(s: *Source) usize {
    if (s == nil || s.fn_lanes == nil) { ret 0; }
    ret s.fn_lanes(s.ctx);
}

# the bytes an acquisition of `request` would charge on a source
#
# what `source_acquire` charges the account's lane for this request, so a
# borrower can size a budget before acquiring
# ---
# ret: the charge, 0 when the source declines to measure or would refuse
pub fun source_measure(s: *Source, request: Request) usize {
    if (s == nil || s.fn_measure == nil) { ret 0; }
    ret s.fn_measure(s.ctx, request);
}

# budget lanes per account a secret source declares, as `source_lanes`
pub fun secret_source_lanes(s: *SecretSource) usize {
    if (s == nil || s.fn_lanes == nil) { ret 0; }
    ret s.fn_lanes(s.ctx);
}

# the bytes an acquisition would charge on a secret source, as `source_measure`
pub fun secret_source_measure(s: *SecretSource, request: Request) usize {
    if (s == nil || s.fn_measure == nil) { ret 0; }
    ret s.fn_measure(s.ctx, request);
}

# open an account on a secret source, as `source_open_account`
pub fun secret_source_open_account(s: *SecretSource, account: *Account, handle: u64, budgets: Budgets, reserve: usize) Reason {
    if (s == nil || s.fn_open_account == nil) { ret Reason.misuse{}; }
    ret s.fn_open_account(s.ctx, account, handle, budgets, reserve);
}

# close an account on a secret source
pub fun secret_source_close_account(s: *SecretSource, account: *Account) Reason {
    if (s == nil || s.fn_close_account == nil) { ret Reason.misuse{}; }
    ret s.fn_close_account(s.ctx, account);
}

# acquire one secret chunk, `request.secret` must be set
# ---
# register: whether an exhausted or memory refusal registers the account
pub fun secret_source_acquire(s: *SecretSource, account: *Account, request: Request, register: bool) Acquired {
    if (s == nil || s.fn_acquire == nil) { ret refusal(Status.error{}, Reason.misuse{}); }
    ret s.fn_acquire(s.ctx, account, request, register);
}

# release a secret chunk, wiping it in full
pub fun secret_source_release(s: *SecretSource, account: *Account, chunk: Chunk) Reason {
    if (s == nil || s.fn_release == nil) { ret Reason.misuse{}; }
    ret s.fn_release(s.ctx, account, chunk);
}

# the welded view of a held secret chunk, nil when stale, as `secret`
pub fun secret_source_view(s: *SecretSource, chunk: Chunk) *^u8 {
    if (s == nil || s.fn_view == nil) { ret nil; }
    ret s.fn_view(s.ctx, chunk);
}

# a held secret chunk viewed as count values of T, as `secret_typed`
#
# nil as well for a source without `fn_bind`, or storage it returns that is not
# aligned for T
pub fun secret_source_view_typed[T](s: *SecretSource, chunk: Chunk, count: usize) *T {
    if (s == nil || s.fn_bind == nil) { ret nil; }
    ret welded_as[T](s.fn_bind(s.ctx, chunk, shape_of[T](count)));
}

# bytes an allocator.fixed arena needs to hold a pool's slot metadata and the
# given number of plain chunks of every class, for embedded use
#
# a fixed arena does not reclaim, so the slot table never gives back what a
# peak grew and the metadata part of the bound holds however often a peak
# returns. a chunk given back past its class high_water still goes to the
# arena, which never reuses it, so the chunk part holds only while every class
# keeps its chunks with a high_water that covers them
# ---
# config: the pool configuration
# chunks: chunks per class, one entry per class
# ret:    the byte count, or the overflow refusal
pub fun arena_bytes(config: Config, chunks: *usize) res[usize, A.Error] {
    if ((config.class_count != 0 && (config.classes == nil || chunks == nil)) ||
        config.class_count > MAX_CLASSES) { ret res[usize, A.Error].err{A.Error.invalid{}}; }
    var total: usize = 0;
    var slots: usize = 0;
    var c:     usize = 0;
    for (c < config.class_count) {
        var bytes: usize = 0;
        var round: usize = 0;
        if (!round_up(config.classes[c].size, table.ELEMENT_ALIGN, ?round) ||
            !memory.range_scaled(chunks[c], round + table.ELEMENT_ALIGN, ?bytes) ||
            bytes > ~(0::usize) - total) { ret res[usize, A.Error].err{A.Error.overflow{}}; }
        total = total + bytes;
        if (chunks[c] > ~(0::usize) - slots) { ret res[usize, A.Error].err{A.Error.overflow{}}; }
        slots = slots + chunks[c];
        c     = c + 1;
    }
    # the slot table doubles, so twice the slots bounds every chunk it grows to
    var meta: usize = 0;
    if (!memory.range_scaled(slots * 2 + 32, $size_of(Slot) + table.ELEMENT_ALIGN, ?meta) ||
        meta > ~(0::usize) - total) { ret res[usize, A.Error].err{A.Error.overflow{}}; }
    ret res[usize, A.Error].ok{total + meta};
}

# welded storage goes through std.memory.secret borrows, so no welded pointer is
# ever held behind the pool's untyped context
$if (capability.HAS_PAGES) {
    use secret_memory: std.memory.secret;

    pub val WELDED: bool = true;

    fun welded_allocate(pool: *Pool, size: usize, index: *u32, generation: *u32) bool {
        val data: *^u8 = secret_memory.allocate(size);
        if (data == nil) { ret false; }
        var borrow: secret_memory.Borrow;
        val opened: err[io_error.Error] = secret_memory.borrow_open(data, size, ?borrow);
        if (sel opened.err) {
            val freed: err[io_error.Error] = secret_memory.deallocate(data, size);
            if (sel freed.err) { pool.release_failures = pool.release_failures + 1; }
            ret false;
        }
        @index      = borrow.index;
        @generation = borrow.generation;
        ret true;
    }

    fun welded_view(index: u32, generation: u32) *^u8 {
        ret secret_memory.borrow_data(secret_memory.Borrow{index: index, generation: generation});
    }

    fun welded_wipe(index: u32, generation: u32, size: usize) {
        secret_memory.borrow_wipe(secret_memory.Borrow{index: index, generation: generation}, 0, size);
    }

    fun welded_aligned(data: *^u8, alignment: usize) bool {
        ret secret_memory.typed_aligned[^u8](data, alignment);
    }

    # welded storage bound to T, retyped with T's own secrecy shape. only the
    # typed views call this, on storage `secret_bind` bound to T, so no byte
    # view of it exists this hold. nil for nil or storage not aligned for T
    fun welded_as[T](data: *^u8) *T {
        if (data == nil) { ret nil; }
        var out: *T = nil;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {data}
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x0, {data}
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld t0, {data}
                sd t0, {out}
            }
        }
        if (!secret_memory.typed_aligned[T](out, $align_of(T))) { ret nil; }
        ret out;
    }

    # whether the borrow closed and the storage went back
    fun welded_release(index: u32, generation: u32, size: usize) bool {
        val borrow: secret_memory.Borrow = secret_memory.Borrow{index: index, generation: generation};
        val data:   *^u8                 = secret_memory.borrow_data(borrow);
        val closed: err[io_error.Error]  = secret_memory.borrow_close(borrow);
        var clean:  bool                 = !sel closed.err && data != nil;
        if (data != nil) {
            val freed: err[io_error.Error] = secret_memory.deallocate(data, size);
            if (sel freed.err) { clean = false; }
        }
        ret clean;
    }
}
$or {
    pub val WELDED: bool = false;

    fun welded_allocate(pool: *Pool, size: usize, index: *u32, generation: *u32) bool {
        ret false;
    }

    fun welded_view(index: u32, generation: u32) *^u8 {
        ret nil;
    }

    fun welded_wipe(index: u32, generation: u32, size: usize) {}

    fun welded_aligned(data: *^u8, alignment: usize) bool {
        ret false;
    }

    fun welded_as[T](data: *^u8) *T {
        ret nil;
    }

    fun welded_release(index: u32, generation: u32, size: usize) bool {
        ret false;
    }
}

$if (capability.HOSTED) {
    fun status_ok(a: Acquired) bool {
        ret sel a.status.ok;
    }
    fun status_error(a: Acquired) bool {
        ret sel a.status.error;
    }
    fun status_blocked(a: Acquired) bool {
        ret sel a.status.blocked;
    }
    fun reason_budget(a: Acquired) bool {
        ret sel a.reason.budget;
    }
    fun reason_exhausted(a: Acquired) bool {
        ret sel a.reason.exhausted;
    }
    fun reason_memory(a: Acquired) bool {
        ret sel a.reason.memory;
    }
    fun reason_misuse(a: Acquired) bool {
        ret sel a.reason.misuse;
    }
    fun is_none(r: Reason) bool {
        ret sel r.none;
    }
    fun is_misuse(r: Reason) bool {
        ret sel r.misuse;
    }
    fun failed(r: err[A.Error]) bool {
        ret sel r.err;
    }

    # live: bytes allocated and not yet released
    rec Counting {
        inner:        A.Allocator;
        allocs:       usize;
        frees:        usize;
        live:         usize;
        refuse:       bool;
        refuse_align: usize;
        refuse_free:  bool;
    }

    fun counting_allocate(context: ptr, size: usize, align: usize) opt[ptr] {
        val c: *Counting = context::*Counting;
        if (c.refuse || (c.refuse_align != 0 && align == c.refuse_align)) { ret opt[ptr].none{}; }
        c.allocs = c.allocs + 1;
        val got: opt[ptr] = c.inner.fn_allocate(c.inner.ctx, size, align);
        if (sel got.some) { c.live = c.live + size; }
        ret got;
    }

    fun counting_reallocate(context: ptr, p: ptr, old: usize, size: usize, align: usize) opt[ptr] {
        ret opt[ptr].none{};
    }

    fun counting_deallocate(context: ptr, p: ptr, size: usize, align: usize) i64 {
        val c: *Counting = context::*Counting;
        if (c.refuse_free) { ret -5; }
        c.frees = c.frees + 1;
        c.live  = c.live - size;
        ret c.inner.fn_deallocate(c.inner.ctx, p, size, align);
    }

    # a counted bump arena over one page region, so a test's memory is bounded.
    # a reclaiming arena puts a heap between the count and the bump arena, so
    # what the pool gives back is reused
    rec Arena {
        page:    A.Allocator;
        state:   fixed.FixedState;
        fixed:   A.Allocator;
        source:  heap.Source;
        heap:    heap.Heap;
        heaped:  bool;
        count:   Counting;
        counted: A.Allocator;
        base:    ptr;
        bytes:   usize;
    }

    fun arena_make(arena: *Arena, bytes: usize) bool {
        page.make(?arena.page);
        val got: res[ptr, A.Error] = A.allocate_raw(?arena.page, bytes, 16);
        if (sel got.err) { ret false; }
        arena.base  = got.ok;
        arena.bytes = bytes;
        if (failed(fixed.make(?arena.count.inner, ?arena.state, got.ok::*u8, bytes))) { ret false; }
        arena.counted = A.Allocator{
            ctx:           (?arena.count)::ptr,
            fn_allocate:   counting_allocate,
            fn_reallocate: counting_reallocate,
            fn_deallocate: counting_deallocate,
            retains:       arena.count.inner.retains,
        };
        ret true;
    }

    fun arena_reclaiming_make(arena: *Arena, bytes: usize) bool {
        if (!arena_make(arena, bytes)) { ret false; }
        arena.fixed = arena.count.inner;
        heap.allocator_source(?arena.source, ?arena.fixed);
        if (failed(heap.init(?arena.heap, ?arena.source, 0))) { ret false; }
        arena.heaped = true;
        if (failed(heap.make(?arena.count.inner, ?arena.heap))) { ret false; }
        arena.counted.retains = arena.count.inner.retains;
        ret true;
    }

    fun arena_free(arena: *Arena) {
        if (arena.heaped) { heap.dnit(?arena.heap); }
        A.deallocate_raw(?arena.page, arena.base, arena.bytes, 16);
    }

    fun no_notify(context: ptr, handle: u64) {}

    fun no_trap(context: ptr) {}

    fun test_config(classes: *ClassConfig, count: usize, global: usize) Config {
        var config: Config;
        config.classes       = classes;
        config.class_count   = count;
        config.lanes         = 2;
        config.global_budget = global;
        config.initial_slots = 4;
        ret config;
    }

    fun ask(bytes: usize) Request {
        ret Request{bytes: bytes, align: 0, lane: 0, secret: false};
    }

    # the same budget on both of a test pool's lanes
    fun budgets_of(value: usize) Budgets {
        var b: Budgets;
        b.lanes    = 2;
        b.bytes[0] = value;
        b.bytes[1] = value;
        ret b;
    }

    test buffers__a_pool_and_its_sources_report_the_configured_lane_count {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 1},
        };
        var pool: Pool;
        if (lanes(nil) != 0 || lanes(?pool) != 0) { ret 2; }
        var config: Config = test_config(?classes[0], 1, 1 << 16);
        config.lanes = MAX_LANES::u8;
        if (!make(?pool, config, ?arena.counted)) { ret 3; }
        var plain:   Source       = source(?pool);
        var secrets: SecretSource = secret_source(?pool);
        if (lanes(?pool) != MAX_LANES || source_lanes(?plain) != MAX_LANES)       { ret 4; }
        if (secret_source_lanes(?secrets) != MAX_LANES || source_lanes(nil) != 0) { ret 5; }
        if (!destroy(?pool))                                                      { ret 6; }
        if (lanes(?pool) != 0 || source_lanes(?plain) != 0)                       { ret 7; }
        ret 0;
    }

    test buffers__measure_reports_exactly_what_acquire_charges {
        var arena: Arena;
        if (!arena_make(?arena, 16 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [3]ClassConfig = [3]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: false, high_water: 4},
            ClassConfig{size: 4096, align: 0, secret: false, high_water: 4},
            ClassConfig{size: 16384, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (measure(nil, ask(100)) != 0 || measure(?pool, ask(100)) != 0)       { ret 2; }
        if (!make(?pool, test_config(?classes[0], 3, 1 << 22), ?arena.counted)) { ret 3; }
        fin { destroy(?pool); }
        var plain:   Source = source(?pool);
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 7, budgets_of(1 << 21), 0))) { ret 4; }
        fin { close_account(?pool, ?account); }
        # every class boundary from both sides, one oversize by alignment and one by size
        var requests: [8]Request = [8]Request{
            ask(1), ask(512), ask(513), ask(4096), ask(4097), ask(16384), ask(16385), ask(100),
        };
        requests[7].align = 64;
        var i: usize = 0;
        for (i < 8) {
            val before:   usize    = account.held;
            val expected: usize    = measure(?pool, requests[i]);
            val got:      Acquired = acquire(?pool, ?account, requests[i], false);
            if (!sel got.status.ok)                                 { ret 10 + i::i32; }
            if (expected == 0 || account.held - before != expected) { ret 20 + i::i32; }
            if (source_measure(?plain, requests[i]) != expected)    { ret 30 + i::i32; }
            if (!is_none(release(?pool, ?account, got.chunk)))      { ret 40 + i::i32; }
            i = i + 1;
        }
        # what acquire refuses as misuse measures as 0
        var bad: Request = ask(0);
        if (measure(?pool, bad) != 0) { ret 50; }
        bad      = ask(100);
        bad.lane = MAX_LANES::u8;
        if (measure(?pool, bad) != 0) { ret 51; }
        bad       = ask(100);
        bad.align = 48;
        if (measure(?pool, bad) != 0) { ret 52; }
        # a rounding that overflows is refused, not charged
        bad       = ask(~(0::usize));
        bad.align = 64;
        if (measure(?pool, bad) != 0) { ret 53; }
        val huge: Acquired = acquire(?pool, ?account, bad, false);
        if (sel huge.status.ok)                 { ret 54; }
        if (source_measure(nil, ask(100)) != 0) { ret 55; }
        ret 0;
    }

    test buffers__a_request_takes_the_smallest_fitting_class_and_oversize_takes_the_rest {
        var arena: Arena;
        if (!arena_make(?arena, 16 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [3]ClassConfig = [3]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: false, high_water: 4},
            ClassConfig{size: 4096, align: 0, secret: false, high_water: 4},
            ClassConfig{size: 16384, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 3, 1 << 22), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 7, budgets_of(1 << 21), 0))) { ret 3; }
        fin { close_account(?pool, ?account); }
        val small: Acquired = acquire(?pool, ?account, ask(100), false);
        val mid:   Acquired = acquire(?pool, ?account, ask(600), false);
        val big:   Acquired = acquire(?pool, ?account, ask(5000), false);
        if (!sel small.status.ok || small.chunk.class != 0 || small.chunk.bytes != 512) { ret 4; }
        if (!sel mid.status.ok || mid.chunk.class != 1 || mid.chunk.bytes != 4096)      { ret 5; }
        if (!sel big.status.ok || big.chunk.class != 2 || big.chunk.bytes != 16384)     { ret 6; }
        var wide: Request = ask(100);
        wide.align = 64;
        val aligned: Acquired = acquire(?pool, ?account, wide, false);
        if (!sel aligned.status.ok || aligned.chunk.class != OVERSIZE || aligned.chunk.bytes != 128) { ret 7; }
        if ((aligned.chunk.data::usize & 63) != 0)                                                   { ret 8; }
        val frees: usize    = arena.count.frees;
        val large: Acquired = acquire(?pool, ?account, ask(100000), false);
        var snap:  Snapshot;
        if (!sel large.status.ok || large.chunk.class != OVERSIZE || large.chunk.bytes != 100000) { ret 9; }
        snapshot(?pool, ?snap);
        if (snap.oversize_live != 2 || snap.oversize_bytes != 100128) { ret 10; }
        if (account.used[0] != 512 + 4096 + 16384 + 128 + 100000)     { ret 11; }
        if (!is_none(release(?pool, ?account, large.chunk)))          { ret 12; }
        if (arena.count.frees != frees + 1)                           { ret 13; }
        snapshot(?pool, ?snap);
        if (snap.oversize_live != 1 || snap.oversize_returned != 1) { ret 14; }
        if (!is_none(release(?pool, ?account, aligned.chunk)) || !is_none(release(?pool, ?account, small.chunk)) ||
            !is_none(release(?pool, ?account, mid.chunk)) || !is_none(release(?pool, ?account, big.chunk))) { ret 15; }
        if (account.held != 0 || pool.bytes_live != 0) { ret 16; }
        ret 0;
    }

    test buffers__a_secret_chunk_has_no_plain_view_and_is_wiped_in_full_on_release {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: true, high_water: 1},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 20), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 20), 0))) { ret 3; }
        fin { close_account(?pool, ?account); }
        # a plain request finds no plain class and takes the oversize path
        var request: Request  = ask(512);
        val plain:   Acquired = acquire(?pool, ?account, request, false);
        if (!status_ok(plain) || plain.chunk.class != OVERSIZE || plain.chunk.data == nil) { ret 4; }
        if (!is_none(release(?pool, ?account, plain.chunk)))                               { ret 40; }
        request.secret = true;
        val got: Acquired = acquire(?pool, ?account, request, false);
        if (!sel got.status.ok || got.chunk.data != nil) { ret 5; }
        if (data(?pool, got.chunk.ref) != nil)           { ret 6; }
        val view: *^u8 = secret(?pool, got.chunk);
        if (view == nil) { ret 7; }
        var i: usize = 0;
        for (i < 512) {
            view[i] = 0xa5;
            i       = i + 1;
        }
        if (!is_none(release(?pool, ?account, got.chunk))) { ret 8; }
        # the retained region is still backed, so it can be read after release
        i = 0;
        for (i < 512) {
            if (view[i]:>u8 != 0) { ret 9; }
            i = i + 1;
        }
        request.bytes = 4000;
        val large: Acquired = acquire(?pool, ?account, request, false);
        if (!sel large.status.ok || large.chunk.class != OVERSIZE || large.chunk.data != nil) { ret 10; }
        if (secret(?pool, large.chunk) == nil)                                                { ret 11; }
        if (!is_none(release(?pool, ?account, large.chunk)))                                  { ret 12; }
        ret 0;
    }

    # the shape of mach-crypto's aes_gcm.Context: an expanded AES schedule and a
    # GHASH key held as secret arrays in nested records, beside public state
    rec TestSchedule {
        round_planes: [120]^u64;
        rounds:       usize;
    }

    rec TestCipher {
        software: TestSchedule;
        backend:  u8;
        active:   bool;
    }

    rec TestGhash {
        h:      [2]^u64;
        powers: [8][2]^u64;
    }

    rec TestAeadContext {
        cipher: TestCipher;
        hash:   TestGhash;
        state:  u8;
    }

    rec TestKey {
        key: [4]^u64;
    }

    # TestKey's size and layout under another name, a distinct type all the same
    rec TestTwinKey {
        key: [4]^u64;
    }

    #[align(64)]
    rec TestWideKey {
        lanes: [8]^u64;
    }

    fun fill_context(context: *TestAeadContext, seed: u64) {
        var i: usize = 0;
        for (i < 120) {
            val plane: u64 = seed + i;
            context.cipher.software.round_planes[i] = plane;
            i                                       = i + 1;
        }
        context.cipher.software.rounds = 14;
        context.cipher.backend         = 1;
        context.cipher.active          = true;
        context.hash.h[1]              = seed;
        val power: u64 = seed + 7;
        context.hash.powers[7][1] = power;
        context.state             = 1;
    }

    fun context_holds(context: *TestAeadContext, seed: u64) bool {
        var i: usize = 0;
        for (i < 120) {
            if (context.cipher.software.round_planes[i]:>u64 != seed + i) { ret false; }
            i = i + 1;
        }
        ret context.cipher.software.rounds == 14 && context.cipher.backend == 1 && context.cipher.active &&
            context.hash.h[1]:>u64 == seed && context.hash.powers[7][1]:>u64 == seed + 7 && context.state == 1;
    }

    test buffers__a_secret_chunk_holds_a_typed_secret_record_through_the_typed_view {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 22)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [2]ClassConfig = [2]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 1},
            ClassConfig{size: 4096, align: 0, secret: true, high_water: 1},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 2, 1 << 20), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 20), 0))) { ret 3; }
        fin { close_account(?pool, ?account); }
        val plain: Acquired = acquire(?pool, ?account, ask(64), false);
        if (!status_ok(plain) || plain.chunk.data == nil) { ret 4; }
        var request: Request = ask(4096);
        request.secret = true;
        val got: Acquired = acquire(?pool, ?account, request, false);
        if (!status_ok(got) || got.chunk.class != 1) { ret 5; }

        # every refusal leaves the chunk unbound
        val size: usize = $size_of(TestAeadContext);
        val fits: usize = 4096 / size;
        if (secret_typed[TestAeadContext](nil, got.chunk, 1) != nil)                        { ret 6; }
        if (secret_typed[TestAeadContext](?pool, plain.chunk, 1) != nil)                    { ret 7; }
        if (secret_typed[TestAeadContext](?pool, got.chunk, 0) != nil)                      { ret 8; }
        if (secret_typed[TestAeadContext](?pool, got.chunk, ~(0::usize) / size + 1) != nil) { ret 9; }
        if (secret_typed[TestAeadContext](?pool, got.chunk, fits + 1) != nil)               { ret 10; }
        if (secret_typed[TestWideKey](?pool, got.chunk, 1) != nil)                          { ret 11; }

        val context: *TestAeadContext = secret_typed[TestAeadContext](?pool, got.chunk, fits);
        if (context == nil) { ret 12; }
        fill_context(?context[0], 3);
        fill_context(?context[fits - 1], 5);
        val again: *TestAeadContext = secret_typed[TestAeadContext](?pool, got.chunk, 1);
        if (again != context || !context_holds(?again[0], 3) || !context_holds(?again[fits - 1], 5)) { ret 13; }
        # bound to TestAeadContext: no byte view and no other type this hold
        if (secret(?pool, got.chunk) != nil)                           { ret 14; }
        if (secret_typed[TestKey](?pool, got.chunk, 1) != nil)         { ret 15; }
        if (!is_none(release(?pool, ?account, got.chunk)))             { ret 16; }
        if (secret_typed[TestAeadContext](?pool, got.chunk, 1) != nil) { ret 17; }

        # the next hold takes the retained chunk, wiped in full, padding included
        val backed: u64      = pool.backing_allocations;
        val next:   Acquired = acquire(?pool, ?account, request, false);
        if (!status_ok(next) || pool.backing_allocations != backed) { ret 18; }
        val bytes: *^u8 = secret(?pool, next.chunk);
        if (bytes == nil) { ret 19; }
        var i: usize = 0;
        for (i < 4096) {
            if (bytes[i]:>u8 != 0) { ret 20; }
            i = i + 1;
        }
        # seen as bytes, the hold refuses the typed view
        if (secret_typed[TestAeadContext](?pool, next.chunk, 1) != nil) { ret 21; }
        if (!is_none(release(?pool, ?account, next.chunk)))             { ret 22; }

        # an oversize secret chunk holds what its rounded bytes fit
        request.bytes = 5000;
        val large: Acquired = acquire(?pool, ?account, request, false);
        if (!status_ok(large) || large.chunk.class != OVERSIZE)                        { ret 23; }
        if (secret_typed[TestAeadContext](?pool, large.chunk, 5000 / size + 1) != nil) { ret 24; }
        val wide: *TestAeadContext = secret_typed[TestAeadContext](?pool, large.chunk, 5000 / size);
        if (wide == nil) { ret 25; }
        fill_context(?wide[5000 / size - 1], 9);
        if (!context_holds(?wide[5000 / size - 1], 9))       { ret 26; }
        if (!is_none(release(?pool, ?account, large.chunk))) { ret 27; }
        if (!is_none(release(?pool, ?account, plain.chunk))) { ret 28; }

        # identity is the type, not its size: a same-size twin is another type
        request.bytes = 4096;
        val keyed: Acquired = acquire(?pool, ?account, request, false);
        if (!status_ok(keyed))                                       { ret 29; }
        if ($size_of(TestTwinKey) != $size_of(TestKey))              { ret 30; }
        if (secret_typed[TestKey](?pool, keyed.chunk, 1) == nil)     { ret 31; }
        if (secret_typed[TestTwinKey](?pool, keyed.chunk, 1) != nil) { ret 32; }
        if (secret_typed[TestKey](?pool, keyed.chunk, 2) == nil)     { ret 33; }
        if (!is_none(release(?pool, ?account, keyed.chunk)))         { ret 34; }
        ret 0;
    }

    # retained chunks keep their slots, so a fresh chunk after a full retain
    # must still find one (#775, from mach-tls's interop harness)
    test buffers__a_fresh_chunk_after_retained_releases_takes_a_new_slot {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 22)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [6]ClassConfig = [6]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: false, high_water: 4},
            ClassConfig{size: 4096, align: 0, secret: false, high_water: 4},
            ClassConfig{size: 17408, align: 0, secret: false, high_water: 4},
            ClassConfig{size: 512, align: 0, secret: true, high_water: 4},
            ClassConfig{size: 4096, align: 0, secret: true, high_water: 4},
            ClassConfig{size: 17408, align: 0, secret: true, high_water: 4},
        };
        var config: Config = test_config(?classes[0], 6, 1 << 21);
        config.initial_slots = 8;
        var pool: Pool;
        if (!make(?pool, config, ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 20), 0))) { ret 3; }
        fin { close_account(?pool, ?account); }
        var held: [8]Chunk;
        var i:    usize = 0;
        for (i < 8) {
            var size: usize = 100;
            if (i >= 4) { size = 1000; }
            val got: Acquired = acquire(?pool, ?account, ask(size), false);
            if (!sel got.status.ok) { ret 4; }
            held[i] = got.chunk;
            i       = i + 1;
        }
        i = 0;
        for (i < 8) {
            if (!is_none(release(?pool, ?account, held[i]))) { ret 5; }
            i = i + 1;
        }
        var snap: Snapshot;
        snapshot(?pool, ?snap);
        if (snap.classes[0].retained != 4 || snap.classes[1].retained != 4) { ret 6; }
        val fresh: Acquired = acquire(?pool, ?account, ask(10000), false);
        if (!sel fresh.status.ok || fresh.chunk.class != 2)  { ret 7; }
        if (!is_none(release(?pool, ?account, fresh.chunk))) { ret 8; }
        # a slot table the demand undercounts refuses, and gives the backing back
        val allocs: usize = arena.count.allocs;
        val frees:  usize = arena.count.frees;
        for (take_slot(?pool) != NONE) {}
        val refused: Acquired = acquire(?pool, ?account, ask(100000), false);
        if (!sel refused.reason.memory)                                         { ret 9; }
        if (arena.count.allocs != allocs + 1 || arena.count.frees != frees + 1) { ret 10; }
        if (account.held != 0 || account.chunks != 0 || pool.slots_in_use != 0) { ret 11; }
        ret 0;
    }

    test buffers__budget_exhausted_and_memory_refusals_are_told_apart {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1024), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var first: Account;
        var other: Account;
        if (!is_none(open_account(?pool, ?first, 1, budgets_of(512), 0)))  { ret 3; }
        if (!is_none(open_account(?pool, ?other, 2, budgets_of(4096), 0))) { ret 4; }
        val one: Acquired = acquire(?pool, ?first, ask(1), true);
        if (!sel one.status.ok) { ret 5; }
        val over: Acquired = acquire(?pool, ?first, ask(1), true);
        if (!sel over.status.blocked || !sel over.reason.budget || pool.waiters != 0) { ret 6; }
        val two: Acquired = acquire(?pool, ?other, ask(1), true);
        if (!sel two.status.ok) { ret 7; }
        val gone: Acquired = acquire(?pool, ?other, ask(1), true);
        if (!sel gone.status.blocked || !sel gone.reason.exhausted || pool.waiters != 1) { ret 8; }
        if (!is_none(release(?pool, ?other, two.chunk)))                                 { ret 9; }
        if (pool.waiters != 0 || pool.ready_count != 1)                                  { ret 10; }
        arena.count.refuse = true;
        val refused: Acquired = acquire(?pool, ?other, ask(1), false);
        if (!sel refused.status.blocked || !sel refused.reason.memory) { ret 11; }
        arena.count.refuse = false;
        var handles: [4]u64;
        if (ready(?pool, ?handles[0], 4) != 1 || handles[0] != 2)                             { ret 12; }
        if (!is_none(release(?pool, ?first, one.chunk)))                                      { ret 13; }
        if (!is_none(close_account(?pool, ?first)) || !is_none(close_account(?pool, ?other))) { ret 14; }
        ret 0;
    }

    test buffers__an_acquire_inside_a_reservation_never_fails_on_metadata {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        # payloads align at 32 and slot metadata at 16, so metadata alone can be refused
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 512, align: 32, secret: false, high_water: 0},
        };
        var config: Config = test_config(?classes[0], 1, 1 << 16);
        config.initial_slots = 1;
        var pool: Pool;
        if (!make(?pool, config, ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var reserved: Account;
        var plain:    Account;
        if (!is_none(open_account(?pool, ?reserved, 1, budgets_of(1 << 16), 3 * 512))) { ret 3; }
        if (!is_none(open_account(?pool, ?plain, 2, budgets_of(1 << 16), 0)))          { ret 4; }
        arena.count.refuse_align = 16;
        var held:  [3]Chunk;
        var extra: [2]Chunk;
        var count: usize = 0;
        for (count < 2) {
            val got: Acquired = acquire(?pool, ?plain, ask(1), false);
            if (!sel got.status.ok) { brk; }
            extra[count] = got.chunk;
            count        = count + 1;
        }
        if (count != 1) { ret 5; }
        var i: usize = 0;
        for (i < 3) {
            val got: Acquired = acquire(?pool, ?reserved, ask(1), false);
            if (!sel got.status.ok) { ret 10 + i::i32; }
            held[i] = got.chunk;
            i       = i + 1;
        }
        val refused: Acquired = acquire(?pool, ?plain, ask(1), false);
        if (!sel refused.reason.memory) { ret 6; }
        arena.count.refuse_align = 0;
        i                        = 0;
        for (i < 3) {
            release(?pool, ?reserved, held[i]);
            i = i + 1;
        }
        release(?pool, ?plain, extra[0]);
        close_account(?pool, ?reserved);
        close_account(?pool, ?plain);
        ret 0;
    }

    test buffers__acquire_n_gets_every_chunk_or_none {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: false, high_water: 8},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 20), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1024), 0))) { ret 3; }
        fin { close_account(?pool, ?account); }
        var requests: [3]Request = [3]Request{ask(1), ask(1), ask(1)};
        var out:      [3]Chunk;
        val refused:  Acquired   = acquire_n(?pool, ?account, ?requests[0], 3, ?out[0], false);
        if (!sel refused.reason.budget)                { ret 4; }
        if (account.chunks != 0 || account.held != 0)  { ret 5; }
        if (pool.bytes_live != 0 || pool.waiters != 0) { ret 6; }
        val got: Acquired = acquire_n(?pool, ?account, ?requests[0], 2, ?out[0], false);
        if (!sel got.status.ok || account.chunks != 2)                              { ret 7; }
        if (out[0].data == nil || out[1].data == nil || out[0].data == out[1].data) { ret 8; }
        release(?pool, ?account, out[0]);
        release(?pool, ?account, out[1]);
        ret 0;
    }

    test buffers__in_flight_and_stale_chunks_are_refused_as_misuse_and_stay_put {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: false, high_water: 0},
        };
        var config: Config = test_config(?classes[0], 1, 1 << 20);
        config.trap = no_trap;
        var pool: Pool;
        if (!make(?pool, config, ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account:  Account;
        var stranger: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 20), 0)))  { ret 3; }
        if (!is_none(open_account(?pool, ?stranger, 2, budgets_of(1 << 20), 0))) { ret 4; }
        val got: Acquired = acquire(?pool, ?account, ask(8), false);
        if (!sel got.status.ok)                                                         { ret 5; }
        if (!is_none(retain(?pool, got.chunk.ref)) || !in_flight(?pool, got.chunk.ref)) { ret 6; }
        if (!is_misuse(release(?pool, ?account, got.chunk)))                            { ret 7; }
        if (data(?pool, got.chunk.ref) != got.chunk.data)                               { ret 8; }
        if (!is_misuse(release(?pool, ?stranger, got.chunk)))                           { ret 9; }
        if (!is_none(settle(?pool, got.chunk.ref)) || in_flight(?pool, got.chunk.ref))  { ret 10; }
        if (!is_misuse(settle(?pool, got.chunk.ref)))                                   { ret 11; }
        if (!is_none(release(?pool, ?account, got.chunk)))                              { ret 12; }
        if (data(?pool, got.chunk.ref) != nil)                                          { ret 13; }
        if (!is_misuse(release(?pool, ?account, got.chunk)))                            { ret 14; }
        if (!is_misuse(retain(?pool, got.chunk.ref)))                                   { ret 15; }
        var snap: Snapshot;
        snapshot(?pool, ?snap);
        if (snap.misuse != 5) { ret 16; }
        close_account(?pool, ?account);
        close_account(?pool, ?stranger);
        ret 0;
    }

    fun count_trap(context: ptr) {
        val hits: *usize = context::*usize;
        @hits = @hits + 1;
    }

    test buffers__budgets_with_the_wrong_lane_count_are_refused_as_counted_misuse {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 0},
        };
        var hits:   usize  = 0;
        var config: Config = test_config(?classes[0], 1, 1 << 16);
        config.trap         = count_trap;
        config.trap_context = (?hits)::ptr;
        var pool: Pool;
        if (!make(?pool, config, ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;

        var short: Budgets = budgets_of(1 << 16);
        short.lanes = 1;
        if (!is_misuse(open_account(?pool, ?account, 1, short, 0))) { ret 3; }
        if (account.open || hits != 1)                              { ret 4; }

        var long: Budgets = budgets_of(1 << 16);
        long.lanes = 3;
        if (!is_misuse(open_account(?pool, ?account, 1, long, 0))) { ret 5; }
        if (account.open || hits != 2)                             { ret 6; }

        var none: Budgets = budgets_of(1 << 16);
        none.lanes = 0;
        var plain: Source = source(?pool);
        if (!is_misuse(source_open_account(?plain, ?account, 1, none, 0))) { ret 7; }
        if (hits != 3)                                                     { ret 8; }

        var snap: Snapshot;
        snapshot(?pool, ?snap);
        if (snap.misuse != 3 || snap.accounts != 0) { ret 9; }

        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 16), 0))) { ret 10; }
        if (!account.open || account.budgets[1] != 1 << 16 || hits != 3)        { ret 11; }
        close_account(?pool, ?account);
        ret 0;
    }

    test buffers__held_chunks_keep_their_address_while_the_pool_grows {
        var arena: Arena;
        if (!arena_make(?arena, 4 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 22), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 22), 0))) { ret 3; }
        val first: Acquired = acquire(?pool, ?account, ask(64), false);
        if (!sel first.status.ok) { ret 4; }
        first.chunk.data[0] = 0x5a;
        var i: usize = 0;
        for (i < 1000) {
            if (!status_ok(acquire(?pool, ?account, ask(64), false))) { ret 5; }
            i = i + 1;
        }
        if (first.chunk.data[0] != 0x5a || data(?pool, first.chunk.ref) != first.chunk.data) { ret 6; }
        ret 0;
    }

    rec Reentry {
        pool:    *Pool;
        account: *Account;
        chunk:   Chunk;
        result:  Reason;
        calls:   usize;
    }

    fun reenter(context: ptr, handle: u64) {
        val r: *Reentry = context::*Reentry;
        r.calls  = r.calls + 1;
        r.result = release(r.pool, r.account, r.chunk);
    }

    test buffers__a_concurrent_entry_is_refused_as_misuse_with_the_chunk_still_held {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: false, high_water: 0},
        };
        var entry:  Reentry;
        var config: Config = test_config(?classes[0], 1, 1024);
        config.notify         = reenter;
        config.notify_context = (?entry)::ptr;
        var pool: Pool;
        if (!make(?pool, config, ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var holder: Account;
        var waiter: Account;
        if (!is_none(open_account(?pool, ?holder, 1, budgets_of(4096), 0))) { ret 3; }
        if (!is_none(open_account(?pool, ?waiter, 2, budgets_of(4096), 0))) { ret 4; }
        val one: Acquired = acquire(?pool, ?holder, ask(1), false);
        val two: Acquired = acquire(?pool, ?holder, ask(1), false);
        if (!sel one.status.ok || !sel two.status.ok)                 { ret 5; }
        if (!reason_exhausted(acquire(?pool, ?waiter, ask(1), true))) { ret 6; }
        entry.pool    = ?pool;
        entry.account = ?holder;
        entry.chunk   = two.chunk;
        # releasing one wakes the waiter, and its notify tries to release two
        if (!is_none(release(?pool, ?holder, one.chunk))) { ret 7; }
        if (entry.calls != 1 || !sel entry.result.misuse) { ret 8; }
        if (data(?pool, two.chunk.ref) != two.chunk.data) { ret 9; }
        if (holder.chunks != 1 || holder.held != 512)     { ret 10; }
        var snap: Snapshot;
        snapshot(?pool, ?snap);
        if (snap.misuse != 1)                             { ret 11; }
        if (!is_none(release(?pool, ?holder, two.chunk))) { ret 12; }
        close_account(?pool, ?holder);
        close_account(?pool, ?waiter);
        ret 0;
    }

    test buffers__one_release_wakes_exactly_the_oldest_waiter_and_allocates_nothing {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: false, high_water: 4},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 512), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var holder:  Account;
        var waiters: [16]Account;
        if (!is_none(open_account(?pool, ?holder, 100, budgets_of(4096), 0))) { ret 3; }
        val held: Acquired = acquire(?pool, ?holder, ask(1), false);
        if (!sel held.status.ok) { ret 4; }
        var i: usize = 0;
        for (i < 16) {
            if (!is_none(open_account(?pool, ?waiters[i], i::u64, budgets_of(4096), 0))) { ret 5; }
            val refused: Acquired = acquire(?pool, ?waiters[i], ask(1), true);
            if (!sel refused.reason.exhausted) { ret 6; }
            # registering twice keeps one place in line
            acquire(?pool, ?waiters[i], ask(1), true);
            i = i + 1;
        }
        if (pool.waiters != 16) { ret 7; }
        val allocs: usize = arena.count.allocs;
        if (!is_none(release(?pool, ?holder, held.chunk))) { ret 8; }
        if (arena.count.allocs != allocs)                  { ret 9; }
        if (pool.waiters != 15 || pool.ready_count != 1)   { ret 10; }
        var handles: [4]u64;
        if (ready(?pool, ?handles[0], 4) != 1 || handles[0] != 0) { ret 11; }
        if (ready(?pool, ?handles[0], 4) != 0)                    { ret 12; }
        i = 0;
        for (i < 16) {
            if (!is_none(close_account(?pool, ?waiters[i]))) { ret 13; }
            i = i + 1;
        }
        if (pool.waiters != 0) { ret 14; }
        close_account(?pool, ?holder);
        ret 0;
    }

    test buffers__steady_state_under_high_water_never_touches_the_backing {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 512, align: 0, secret: false, high_water: 4},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 20), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 20), 0))) { ret 3; }
        fin { close_account(?pool, ?account); }
        var held: [4]Chunk;
        var i:    usize = 0;
        for (i < 4) {
            val got: Acquired = acquire(?pool, ?account, ask(64), false);
            if (!status_ok(got)) { ret 4; }
            held[i] = got.chunk;
            i       = i + 1;
        }
        i = 0;
        for (i < 4) {
            release(?pool, ?account, held[i]);
            i = i + 1;
        }
        var snap: Snapshot;
        snapshot(?pool, ?snap);
        val warm:   u64   = snap.backing_allocations;
        val allocs: usize = arena.count.allocs;
        if (warm != 4 || snap.classes[0].backing_allocations != 4) { ret 5; }
        var round: usize = 0;
        for (round < 1000) {
            i = 0;
            for (i < 4) {
                val got: Acquired = acquire(?pool, ?account, ask(64), false);
                if (!status_ok(got)) { ret 6; }
                held[i] = got.chunk;
                i       = i + 1;
            }
            i = 0;
            for (i < 4) {
                release(?pool, ?account, held[i]);
                i = i + 1;
            }
            round = round + 1;
        }
        snapshot(?pool, ?snap);
        if (snap.backing_allocations != warm || arena.count.allocs != allocs) { ret 7; }
        ret 0;
    }

    rec Cost {
        acquire: u64;
        release: u64;
        wake:    u64;
    }

    # deterministic steps per operation, independent of how many chunks exist
    fun measure_steps(n: usize, cost: *Cost) bool {
        var arena: Arena;
        if (!arena_make(?arena, n * 256 + (8 << 20))) { ret false; }
        fin { arena_free(?arena); }
        var classes: [4]ClassConfig = [4]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 0},
            ClassConfig{size: 128, align: 0, secret: false, high_water: 0},
            ClassConfig{size: 512, align: 0, secret: false, high_water: 0},
            ClassConfig{size: 4096, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 4, n * 64 + 64), ?arena.counted)) { ret false; }
        fin { destroy(?pool); }
        var account: Account;
        var waiter:  Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(~(0::usize)), 0))) { ret false; }
        if (!is_none(open_account(?pool, ?waiter, 2, budgets_of(~(0::usize)), 0)))  { ret false; }
        var first: Chunk;
        var last:  Chunk;
        var i:     usize = 0;
        for (i < n) {
            val got: Acquired = acquire(?pool, ?account, ask(64), false);
            if (!sel got.status.ok) { ret false; }
            if (i == 0)             { first = got.chunk; }
            last = got.chunk;
            i    = i + 1;
        }
        val before_acquire: u64      = pool.steps;
        val one:            Acquired = acquire(?pool, ?account, ask(64), false);
        if (!sel one.status.ok) { ret false; }
        cost.acquire = pool.steps - before_acquire;
        # the pool is now full, so the waiter registers
        if (!reason_exhausted(acquire(?pool, ?waiter, ask(64), true))) { ret false; }
        val before_wake: u64 = pool.steps;
        release(?pool, ?account, one.chunk);
        cost.wake = pool.steps - before_wake;
        var handles: [1]u64;
        if (ready(?pool, ?handles[0], 1) != 1) { ret false; }
        val before_release: u64 = pool.steps;
        release(?pool, ?account, last);
        cost.release = pool.steps - before_release;
        release(?pool, ?account, first);
        ret true;
    }

    # a consumer written only against Source: two accounts share one chunk of
    # capacity, the second is refused and registered, and the first's release
    # wakes it
    fun consume(s: *Source) i32 {
        var first:  Account;
        var second: Account;
        if (source_lanes(s) != 2)                                              { ret 19; }
        if (!is_none(source_open_account(s, ?first, 7, budgets_of(4096), 0)))  { ret 1; }
        if (!is_none(source_open_account(s, ?second, 9, budgets_of(4096), 0))) { ret 2; }
        val held: Acquired = source_acquire(s, ?first, ask(16), false);
        if (!sel held.status.ok) { ret 3; }
        val address: *u8 = source_data(s, held.chunk.ref);
        if (address == nil || address != held.chunk.data) { ret 4; }
        address[0] = 42;
        val refused: Acquired = source_acquire(s, ?second, ask(16), true);
        if (!sel refused.reason.exhausted)                     { ret 5; }
        if (!is_none(source_retain(s, held.chunk.ref)))        { ret 6; }
        if (!source_in_flight(s, held.chunk.ref))              { ret 7; }
        if (!is_misuse(source_release(s, ?first, held.chunk))) { ret 8; }
        if (!is_none(source_settle(s, held.chunk.ref)))        { ret 9; }
        if (source_in_flight(s, held.chunk.ref))               { ret 10; }
        var handles: [2]u64;
        if (source_ready(s, ?handles[0], 2) != 0)                    { ret 11; }
        if (!is_none(source_release(s, ?first, held.chunk)))         { ret 12; }
        if (source_data(s, held.chunk.ref) != nil)                   { ret 13; }
        if (source_ready(s, ?handles[0], 2) != 1 || handles[0] != 9) { ret 14; }
        val woken: Acquired = source_acquire(s, ?second, ask(16), false);
        if (!sel woken.status.ok)                              { ret 15; }
        if (!is_none(source_release(s, ?second, woken.chunk))) { ret 16; }
        if (!is_none(source_close_account(s, ?first)))         { ret 17; }
        if (!is_none(source_close_account(s, ?second)))        { ret 18; }
        ret 0;
    }

    # the smallest source: one 64-byte chunk and one waiter
    rec Stub {
        store:      [64]u8;
        held:       bool;
        generation: u32;
        flight:     usize;
        waiter:     *Account;
        woken:      bool;
    }

    fun stub_open(context: ptr, account: *Account, handle: u64, budgets: Budgets, reserve: usize) Reason {
        account.handle = handle;
        account.open   = true;
        ret Reason.none{};
    }

    fun stub_close(context: ptr, account: *Account) Reason {
        val stub: *Stub = context::*Stub;
        if (stub.waiter == account) { stub.waiter = nil; }
        account.open = false;
        ret Reason.none{};
    }

    fun stub_acquire(context: ptr, account: *Account, request: Request, register: bool) Acquired {
        val stub: *Stub = context::*Stub;
        var out:  Acquired;
        if (request.bytes > 64 || request.secret) {
            out.status = Status.error{};
            out.reason = Reason.misuse{};
            ret out;
        }
        if (stub.held) {
            if (register) { stub.waiter = account; }
            out.status = Status.blocked{};
            out.reason = Reason.exhausted{};
            ret out;
        }
        stub.held       = true;
        stub.generation = stub.generation + 1;
        out.status      = Status.ok{};
        out.reason      = Reason.none{};
        out.chunk       = Chunk{ref: Ref{index: 0, generation: stub.generation}, class: 0, bytes: 64, data: ?stub.store[0]};
        ret out;
    }

    fun stub_acquire_n(context: ptr, account: *Account, requests: *Request, count: usize, out: *Chunk, register: bool) Acquired {
        if (count != 1) {
            var refused: Acquired;
            refused.status = Status.blocked{};
            refused.reason = Reason.exhausted{};
            ret refused;
        }
        val got: Acquired = stub_acquire(context, account, requests[0], register);
        if (sel got.status.ok) { out[0] = got.chunk; }
        ret got;
    }

    fun stub_live(stub: *Stub, ref: Ref) bool {
        ret stub.held && ref.index == 0 && ref.generation == stub.generation;
    }

    fun stub_release(context: ptr, account: *Account, chunk: Chunk) Reason {
        val stub: *Stub = context::*Stub;
        if (!stub_live(stub, chunk.ref) || stub.flight != 0) { ret Reason.misuse{}; }
        stub.held = false;
        if (stub.waiter != nil) { stub.woken = true; }
        ret Reason.none{};
    }

    fun stub_data(context: ptr, ref: Ref) *u8 {
        val stub: *Stub = context::*Stub;
        if (!stub_live(stub, ref)) { ret nil; }
        ret ?stub.store[0];
    }

    fun stub_retain(context: ptr, ref: Ref) Reason {
        val stub: *Stub = context::*Stub;
        if (!stub_live(stub, ref)) { ret Reason.misuse{}; }
        stub.flight = stub.flight + 1;
        ret Reason.none{};
    }

    fun stub_lanes(context: ptr) usize {
        ret 2;
    }

    fun stub_settle(context: ptr, ref: Ref) Reason {
        val stub: *Stub = context::*Stub;
        if (!stub_live(stub, ref) || stub.flight == 0) { ret Reason.misuse{}; }
        stub.flight = stub.flight - 1;
        ret Reason.none{};
    }

    fun stub_in_flight(context: ptr, ref: Ref) bool {
        val stub: *Stub = context::*Stub;
        ret stub_live(stub, ref) && stub.flight != 0;
    }

    fun stub_ready(context: ptr, output: *u64, capacity: usize) usize {
        val stub: *Stub = context::*Stub;
        if (!stub.woken || stub.waiter == nil || capacity == 0) { ret 0; }
        output[0]   = stub.waiter.handle;
        stub.woken  = false;
        stub.waiter = nil;
        ret 1;
    }

    test buffers__a_consumer_runs_through_source_alone_over_a_pool_and_over_its_own_source {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 1},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 64), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var over_pool: Source = source(?pool);
        val pooled:    i32    = consume(?over_pool);
        if (pooled != 0) { ret 10 + pooled; }
        # a plain source refuses a secret request as misuse
        var account: Account;
        if (!is_none(source_open_account(?over_pool, ?account, 1, budgets_of(64), 0))) { ret 30; }
        var hidden: Request = ask(16);
        hidden.secret = true;
        val misuse_before: i64      = pool.misuse;
        val refused:       Acquired = source_acquire(?over_pool, ?account, hidden, false);
        if (!sel refused.reason.misuse || pool.misuse != misuse_before + 1) { ret 31; }
        var spare: Chunk;
        val set:   Acquired = source_acquire_n(?over_pool, ?account, ?hidden, 1, ?spare, false);
        if (!sel set.reason.misuse)                                                    { ret 32; }
        if (account.held != 0 || !is_none(source_close_account(?over_pool, ?account))) { ret 33; }
        var stub: Stub;
        var own:  Source = Source{
            ctx:              (?stub)::ptr,
            fn_open_account:  stub_open,
            fn_close_account: stub_close,
            fn_acquire:       stub_acquire,
            fn_acquire_n:     stub_acquire_n,
            fn_release:       stub_release,
            fn_data:          stub_data,
            fn_retain:        stub_retain,
            fn_settle:        stub_settle,
            fn_in_flight:     stub_in_flight,
            fn_ready:         stub_ready,
            fn_lanes:         stub_lanes,
        };
        val stubbed: i32 = consume(?own);
        if (stubbed != 0) { ret 40 + stubbed; }
        ret 0;
    }

    # records carrying a plain source, by value and by pointer, as a completion,
    # thread argument or cancel callback context would
    rec Driver {
        s:     Source;
        count: u32;
    }

    rec Connection {
        s:     *Source;
        owner: *Driver;
    }

    test buffers__a_record_holding_a_source_passes_through_ptr {
        var stub:   Stub;
        var driver: Driver;
        driver.s = Source{
            ctx:              (?stub)::ptr,
            fn_open_account:  stub_open,
            fn_close_account: stub_close,
            fn_acquire:       stub_acquire,
            fn_acquire_n:     stub_acquire_n,
            fn_release:       stub_release,
            fn_data:          stub_data,
            fn_retain:        stub_retain,
            fn_settle:        stub_settle,
            fn_in_flight:     stub_in_flight,
            fn_ready:         stub_ready,
            fn_lanes:         stub_lanes,
        };
        driver.count = 3;
        val carried: ptr     = (?driver)::ptr;
        val back:    *Driver = carried::*Driver;
        if (back != ?driver || back.count != 3) { ret 1; }
        var connection: Connection  = Connection{s: ?back.s, owner: back};
        val passed:     ptr         = (?connection)::ptr;
        val again:      *Connection = passed::*Connection;
        if (again.owner != ?driver || again.s.ctx != (?stub)::ptr) { ret 2; }
        val result: i32 = consume(again.s);
        if (result != 0) { ret 10 + result; }
        ret 0;
    }

    # a secret consumer written only against SecretSource
    fun consume_secret(s: *SecretSource) i32 {
        var account: Account;
        if (!is_none(secret_source_open_account(s, ?account, 5, budgets_of(4096), 0))) { ret 1; }
        fin { secret_source_close_account(s, ?account); }
        var request: Request  = ask(64);
        val plain:   Acquired = secret_source_acquire(s, ?account, request, false);
        if (!sel plain.reason.misuse) { ret 2; }
        request.secret = true;
        val got: Acquired = secret_source_acquire(s, ?account, request, false);
        if (!sel got.status.ok || got.chunk.data != nil) { ret 3; }
        val view: *^u8 = secret_source_view(s, got.chunk);
        if (view == nil) { ret 4; }
        var i: usize = 0;
        for (i < 64) {
            view[i] = 0x5a;
            i       = i + 1;
        }
        if (secret_source_view_typed[TestKey](s, got.chunk, 1) != nil) { ret 8; }
        if (!is_none(secret_source_release(s, ?account, got.chunk)))   { ret 5; }
        if (secret_source_view(s, got.chunk) != nil)                   { ret 6; }
        i = 0;
        for (i < 64) {
            if (view[i]:>u8 != 0) { ret 7; }
            i = i + 1;
        }
        # the same chunk again, seen as two keys through the source alone
        val typed: Acquired = secret_source_acquire(s, ?account, request, false);
        if (!sel typed.status.ok) { ret 9; }
        val keys: *TestKey = secret_source_view_typed[TestKey](s, typed.chunk, 2);
        if (keys == nil || secret_source_view_typed[TestKey](s, typed.chunk, 3) != nil) { ret 10; }
        keys[1].key[3] = 0x77;
        if (secret_source_view_typed[TestKey](s, typed.chunk, 2)[1].key[3]:>u64 != 0x77) { ret 11; }
        if (secret_source_view(s, typed.chunk) != nil)                                   { ret 12; }
        if (!is_none(secret_source_release(s, ?account, typed.chunk)))                   { ret 13; }
        if (secret_source_view_typed[TestKey](s, typed.chunk, 2) != nil)                 { ret 14; }
        if (keys[1].key[3]:>u64 != 0)                                                    { ret 15; }
        ret 0;
    }

    test buffers__a_secret_consumer_runs_through_secretsource_alone {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [2]ClassConfig = [2]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 1},
            ClassConfig{size: 64, align: 0, secret: true, high_water: 1},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 2, 1 << 16), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var secrets: SecretSource = secret_source(?pool);
        if (secret_source_lanes(?secrets) != 2) { ret 8; }
        val result: i32 = consume_secret(?secrets);
        if (result != 0) { ret 10 + result; }
        # a plain chunk is not released through the secret surface
        var plain:   Source = source(?pool);
        var account: Account;
        if (!is_none(source_open_account(?plain, ?account, 1, budgets_of(4096), 0))) { ret 3; }
        val held: Acquired = source_acquire(?plain, ?account, ask(16), false);
        if (!sel held.status.ok)                                               { ret 4; }
        if (!is_misuse(secret_source_release(?secrets, ?account, held.chunk))) { ret 5; }
        if (!is_none(source_release(?plain, ?account, held.chunk)))            { ret 6; }
        if (!is_none(source_close_account(?plain, ?account)))                  { ret 7; }
        ret 0;
    }

    # a backing that refuses to take memory back is counted, and the chunk is
    # still given up by its account (#779)
    test buffers__a_refused_backing_release_is_counted_in_the_snapshot {
        var arena: Arena;
        if (!arena_make(?arena, 1 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 16), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 15), 0))) { ret 3; }
        fin { close_account(?pool, ?account); }
        val sized: Acquired = acquire(?pool, ?account, ask(16), false);
        val large: Acquired = acquire(?pool, ?account, ask(8192), false);
        if (!sel sized.status.ok || !sel large.status.ok) { ret 4; }
        var snap: Snapshot;
        snapshot(?pool, ?snap);
        if (snap.release_failures != 0) { ret 5; }
        arena.count.refuse_free = true;
        if (!is_none(release(?pool, ?account, sized.chunk)) || !is_none(release(?pool, ?account, large.chunk))) { ret 6; }
        arena.count.refuse_free = false;
        snapshot(?pool, ?snap);
        if (snap.release_failures != 2 || account.held != 0 || account.chunks != 0) { ret 7; }
        ret 0;
    }

    # a nil source or one with a member left unset refuses through its own
    # surface instead of crashing (#778)
    test buffers__the_source_wrappers_refuse_a_nil_or_partial_source {
        var account: Account;
        var handles: [1]u64;
        var chunk:   Chunk;
        val ref:     Ref     = Ref{index: 0, generation: 1};
        var request: Request = ask(16);
        var partial: Source  = Source{
            ctx:              nil,
            fn_open_account:  nil,
            fn_close_account: nil,
            fn_acquire:       nil,
            fn_acquire_n:     nil,
            fn_release:       nil,
            fn_data:          nil,
            fn_retain:        nil,
            fn_settle:        nil,
            fn_in_flight:     nil,
            fn_ready:         nil,
        };
        var round: usize = 0;
        for (round < 2) {
            var s: *Source = nil;
            if (round == 1)                                                         { s = ?partial; }
            if (!is_misuse(source_open_account(s, ?account, 1, budgets_of(64), 0))) { ret 10; }
            if (!is_misuse(source_close_account(s, ?account)))                      { ret 11; }
            val one: Acquired = source_acquire(s, ?account, request, false);
            val set: Acquired = source_acquire_n(s, ?account, ?request, 1, ?chunk, false);
            if (!sel one.reason.misuse || !sel one.status.error)                        { ret 12; }
            if (!sel set.reason.misuse || !sel set.status.error)                        { ret 13; }
            if (!is_misuse(source_release(s, ?account, chunk)))                         { ret 14; }
            if (source_data(s, ref) != nil)                                             { ret 15; }
            if (!is_misuse(source_retain(s, ref)) || !is_misuse(source_settle(s, ref))) { ret 16; }
            if (source_in_flight(s, ref) || source_ready(s, ?handles[0], 1) != 0)       { ret 17; }
            if (source_lanes(s) != 0)                                                   { ret 18; }
            round = round + 1;
        }
        var secret: SecretSource = SecretSource{
            ctx: nil, fn_open_account: nil, fn_close_account: nil, fn_acquire: nil, fn_release: nil, fn_view: nil,
        };
        round = 0;
        for (round < 2) {
            var s: *SecretSource = nil;
            if (round == 1)                                                                { s = ?secret; }
            if (!is_misuse(secret_source_open_account(s, ?account, 1, budgets_of(64), 0))) { ret 20; }
            if (!is_misuse(secret_source_close_account(s, ?account)))                      { ret 21; }
            val one: Acquired = secret_source_acquire(s, ?account, request, false);
            if (!sel one.reason.misuse || !sel one.status.error)       { ret 22; }
            if (!is_misuse(secret_source_release(s, ?account, chunk))) { ret 23; }
            if (secret_source_view(s, chunk) != nil)                   { ret 24; }
            if (secret_source_lanes(s) != 0)                           { ret 25; }
            if (secret_source_view_typed[TestKey](s, chunk, 1) != nil) { ret 26; }
            round = round + 1;
        }
        ret 0;
    }

    test buffers__acquire_release_and_wake_cost_stays_flat_from_1k_to_100k_chunks {
        var small: Cost;
        var mid:   Cost;
        var large: Cost;
        if (!measure_steps(1000, ?small))                                 { ret 1; }
        if (!measure_steps(10000, ?mid))                                  { ret 2; }
        if (!measure_steps(100000, ?large))                               { ret 3; }
        if (small.acquire != mid.acquire || mid.acquire != large.acquire) { ret 4; }
        if (small.release != mid.release || mid.release != large.release) { ret 5; }
        if (small.wake != mid.wake || mid.wake != large.wake)             { ret 6; }
        if (large.acquire > 8 || large.release > 2 || large.wake > 2)     { ret 7; }
        ret 0;
    }

    # n accounts each reserve one chunk and hold it, then give their chunks back
    # newest first and close: the bytes held idle, at the peak, with every chunk
    # back but the reservations still open, and once every account closed
    fun footprint_peak(n: usize, idle: *usize, peak: *usize, after: *usize, chunks: *usize) i64 {
        var arena: Arena;
        if (!arena_reclaiming_make(?arena, n * 512 + (1 << 20))) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 4},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 30), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var pa: A.Allocator;
        page.make(?pa);
        val accounts: res[*Account, A.Error] = A.allocate[Account](?pa, n);
        if (sel accounts.err) { ret 3; }
        fin { A.deallocate[Account](?pa, accounts.ok, n); }
        val held: res[*Chunk, A.Error] = A.allocate[Chunk](?pa, n);
        if (sel held.err) { ret 3; }
        fin { A.deallocate[Chunk](?pa, held.ok, n); }
        @idle = arena.count.live;
        var i: usize = 0;
        for (i < n) {
            if (!is_none(open_account(?pool, ?accounts.ok[i], i::u64, budgets_of(64), 64))) { ret 4; }
            val got: Acquired = acquire(?pool, ?accounts.ok[i], ask(64), false);
            if (!status_ok(got)) { ret 5; }
            held.ok[i] = got.chunk;
            i          = i + 1;
        }
        @peak = arena.count.live;
        i     = n;
        for (i > 0) {
            i = i - 1;
            if (!is_none(release(?pool, ?accounts.ok[i], held.ok[i]))) { ret 6; }
        }
        # the reservations are still open, so their slots stay backed
        if (pool.slots.capacity < n) { ret 7; }
        i = 0;
        for (i < n) {
            if (!is_none(close_account(?pool, ?accounts.ok[i]))) { ret 8; }
            i = i + 1;
        }
        @after  = arena.count.live;
        @chunks = pool.slots.chunk_count;
        ret 0;
    }

    # #878: after a peak of accounts drains, the slot table is back at its idle
    # size plus the one chunk of slack above the four retained chunks, which
    # moved down out of the released chunks
    test buffers__a_drained_peak_returns_the_slot_table_to_idle_at_1k_10k_and_100k_accounts {
        val sizes: [3]usize = [3]usize{1000, 10000, 100000};
        var i:     usize    = 0;
        for (i < 3) {
            var idle:   usize = 0;
            var peak:   usize = 0;
            var after:  usize = 0;
            var chunks: usize = 0;
            val ran:    i64   = footprint_peak(sizes[i], ?idle, ?peak, ?after, ?chunks);
            if (ran != 0)                                       { ret 10 * (i::i32 + 1) + ran::i32; }
            if (peak < idle + sizes[i] * (64 + $size_of(Slot))) { ret 40 + i::i32; }
            if (after != idle + 4 * 64 + 4 * $size_of(Slot))    { ret 50 + i::i32; }
            if (chunks != 2)                                    { ret 60 + i::i32; }
            i = i + 1;
        }
        ret 0;
    }

    # #878: a trim releases only empty chunks, so a held chunk keeps its slot
    # and its data, one held high keeps its chunk, and a ref from a released
    # chunk is refused once the table grows again
    test buffers__held_slots_survive_a_shrink_and_stale_refs_stay_refused_after_regrowth {
        var arena: Arena;
        if (!arena_reclaiming_make(?arena, 4 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 22), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 22), 0))) { ret 3; }
        fin { close_account(?pool, ?account); }
        var held: [64]Chunk;
        var i:    usize = 0;
        for (i < 64) {
            val got: Acquired = acquire(?pool, ?account, ask(64), false);
            if (!status_ok(got) || got.chunk.ref.index::usize != i) { ret 4; }
            held[i] = got.chunk;
            i       = i + 1;
        }
        if (pool.slots.chunk_count != 5) { ret 5; }
        val low:  Chunk = held[0];
        val high: Chunk = held[63];
        low.data[0] = 0x5a;
        i           = 1;
        for (i < 63) {
            if (!is_none(release(?pool, ?account, held[i]))) { ret 6; }
            i = i + 1;
        }
        # the high chunk pins its slot's chunk, so nothing goes
        if (pool.slots.chunk_count != 5 || data(?pool, high.ref) != high.data) { ret 7; }
        if (!is_none(release(?pool, ?account, high)))                          { ret 8; }
        # chunk 0 holds the low chunk and chunk 1 stays as slack
        if (pool.slots.chunk_count != 2)                                { ret 9; }
        if (data(?pool, low.ref) != low.data || low.data[0] != 0x5a)    { ret 10; }
        if (data(?pool, high.ref) != nil || in_flight(?pool, high.ref)) { ret 11; }
        # regrown, the released slots come back under generations no old ref has
        i = 1;
        for (i < 64) {
            val got: Acquired = acquire(?pool, ?account, ask(64), false);
            if (!status_ok(got)) { ret 12; }
            held[i] = got.chunk;
            i       = i + 1;
        }
        if (held[63].ref.index != high.ref.index || held[63].ref.generation == high.ref.generation) { ret 13; }
        if (data(?pool, high.ref) != nil || in_flight(?pool, high.ref))                             { ret 14; }
        if (!is_misuse(retain(?pool, high.ref)) || !is_misuse(release(?pool, ?account, high)))      { ret 15; }
        if (data(?pool, held[63].ref) != held[63].data || data(?pool, low.ref) != low.data)         { ret 16; }
        i = 0;
        for (i < 64) {
            if (!is_none(release(?pool, ?account, held[i]))) { ret 17; }
            i = i + 1;
        }
        if (pool.slots.chunk_count != 1) { ret 18; }
        ret 0;
    }

    # #878: retained chunks left high by a drain move down into free slots, so
    # the table shrinks under them, and they are still reused without touching
    # the backing
    test buffers__retained_chunks_move_below_a_drained_peak_and_are_reused {
        var arena: Arena;
        if (!arena_reclaiming_make(?arena, 4 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 4},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 22), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 22), 0))) { ret 3; }
        fin { close_account(?pool, ?account); }
        var held: [64]Chunk;
        var i:    usize = 0;
        for (i < 64) {
            val got: Acquired = acquire(?pool, ?account, ask(64), false);
            if (!status_ok(got)) { ret 4; }
            held[i] = got.chunk;
            i       = i + 1;
        }
        # newest first, so the four retained chunks sit in the top slot chunk
        i = 64;
        for (i > 0) {
            i = i - 1;
            if (!is_none(release(?pool, ?account, held[i]))) { ret 5; }
        }
        if (pool.slots.chunk_count != 2 || pool.retained_in[0] != 4) { ret 6; }
        var snap: Snapshot;
        snapshot(?pool, ?snap);
        val backing: u64 = snap.backing_allocations;
        if (snap.classes[0].retained != 4) { ret 7; }
        var again: [4]Chunk;
        i = 0;
        for (i < 4) {
            val got: Acquired = acquire(?pool, ?account, ask(64), false);
            if (!status_ok(got)) { ret 8; }
            again[i] = got.chunk;
            var found: bool  = false;
            var j:     usize = 60;
            for (j < 64) {
                if (held[j].data == got.chunk.data) { found = true; }
                j = j + 1;
            }
            if (!found) { ret 9; }
            i = i + 1;
        }
        snapshot(?pool, ?snap);
        if (snap.backing_allocations != backing || snap.classes[0].retained != 0) { ret 10; }
        i = 0;
        for (i < 4) {
            if (!is_none(release(?pool, ?account, again[i]))) { ret 11; }
            i = i + 1;
        }
        ret 0;
    }

    # #878: a load crossing a slot chunk boundary back and forth keeps the empty
    # chunk above it as slack, so only the first crossing grows the table, and
    # the same holds for a reservation crossing it
    test buffers__a_load_oscillating_across_a_slot_chunk_boundary_grows_the_table_once {
        var arena: Arena;
        if (!arena_reclaiming_make(?arena, 4 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 22), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(1 << 22), 0))) { ret 3; }
        var held: [5]Chunk;
        var i:    usize = 0;
        for (i < 4) {
            val got: Acquired = acquire(?pool, ?account, ask(64), false);
            if (!status_ok(got)) { ret 4; }
            held[i] = got.chunk;
            i       = i + 1;
        }
        if (pool.slots.capacity != 4) { ret 5; }
        # each crossing costs one payload allocation and nothing more
        var allocs: usize = 0;
        var round:  usize = 0;
        for (round < 100) {
            val got: Acquired = acquire(?pool, ?account, ask(64), false);
            if (!status_ok(got)) { ret 6; }
            if (round == 0)      { allocs = arena.count.allocs; }
            or {
                allocs = allocs + 1;
                if (arena.count.allocs != allocs) { ret 7; }
            }
            if (!is_none(release(?pool, ?account, got.chunk))) { ret 8; }
            if (pool.slots.chunk_count != 2)                   { ret 9; }
            round = round + 1;
        }
        var other: Account;
        round = 0;
        for (round < 100) {
            if (!is_none(open_account(?pool, ?other, 2, budgets_of(64), 64))) { ret 10; }
            if (!is_none(close_account(?pool, ?other)))                       { ret 11; }
            if (arena.count.allocs != allocs || pool.slots.chunk_count != 2)  { ret 12; }
            round = round + 1;
        }
        i = 0;
        for (i < 4) {
            if (!is_none(release(?pool, ?account, held[i]))) { ret 13; }
            i = i + 1;
        }
        if (!is_none(close_account(?pool, ?account)) || pool.slots.chunk_count != 1) { ret 14; }
        ret 0;
    }

    # n accounts each open with a reservation of one chunk and then close,
    # rounds times over one pool on a bump arena of the given bytes. the
    # reservations keep their slots backed, so each peak grows the slot table,
    # and nothing else the pool allocates is given back. a held chunk is left
    # out: past its class high_water it goes back to the arena, which never
    # reuses it, and under it the retained chunk pins its slot. used is what the
    # arena gave out by the first peak
    fun fixed_peaks(bytes: usize, n: usize, rounds: usize, used: *usize) i64 {
        var arena: Arena;
        if (!arena_make(?arena, bytes)) { ret 1; }
        fin { arena_free(?arena); }
        if (A.reclaims(?arena.counted)) { ret 1; }
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 30), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        var pa: A.Allocator;
        page.make(?pa);
        val accounts: res[*Account, A.Error] = A.allocate[Account](?pa, n);
        if (sel accounts.err) { ret 3; }
        fin { A.deallocate[Account](?pa, accounts.ok, n); }
        var remaining: usize = 0;
        var round:     usize = 0;
        for (round < rounds) {
            var i: usize = 0;
            for (i < n) {
                if (!is_none(open_account(?pool, ?accounts.ok[i], i::u64, budgets_of(64), 64))) { ret 4; }
                i = i + 1;
            }
            if (pool.slots.capacity < n) { ret 5; }
            i = 0;
            for (i < n) {
                if (!is_none(close_account(?pool, ?accounts.ok[i]))) { ret 6; }
                i = i + 1;
            }
            if (round == 0)                                 { remaining = fixed.remaining(?arena.state); }
            or (fixed.remaining(?arena.state) != remaining) { ret 8; }
            round = round + 1;
        }
        @used = bytes - remaining;
        ret 0;
    }

    # #880: a bump arena never reuses what the pool gives back, so the slot
    # table keeps its peak over one, and a peak of 10k accounts that drains and
    # returns many times fits an arena sized for a single peak
    test buffers__a_repeated_peak_over_a_fixed_arena_sized_for_one_peak_never_grows_it {
        var used:  usize = 0;
        val probe: i64   = fixed_peaks(10000 * 512 + (1 << 20), 10000, 1, ?used);
        if (probe != 0) { ret 10 + probe::i32; }
        var again: usize = 0;
        val ran:   i64   = fixed_peaks(used + used / 2, 10000, 16, ?again);
        if (ran != 0)      { ret 20 + ran::i32; }
        if (again != used) { ret 30; }
        ret 0;
    }

    # bytes of the slot table no longer holding the paint
    fun slots_written(pool: *Pool, paint: u8) usize {
        var written: usize = 0;
        var chunk:   usize = 0;
        for (chunk < pool.slots.chunk_count) {
            val bytes: *u8   = pool.slots.chunks[chunk]::*u8;
            var i:     usize = 0;
            for (i < table.chunk_capacity(?pool.slots, chunk) * $size_of(Slot)) {
                if (bytes[i] != paint) { written = written + 1; }
                i = i + 1;
            }
            chunk = chunk + 1;
        }
        ret written;
    }

    # #886: an account's reservation grows the slot table without writing it,
    # so the reserved slots cost address space and not resident memory, and a
    # slot is written first when a chunk takes it
    test buffers__a_reservation_s_slots_are_written_only_once_taken {
        var arena: Arena;
        if (!arena_make(?arena, 4 << 20)) { ret 1; }
        fin { arena_free(?arena); }
        val paint: u8 = 0xa5;
        memory.raw_fill(arena.base, paint, arena.bytes);
        var classes: [1]ClassConfig = [1]ClassConfig{
            ClassConfig{size: 64, align: 0, secret: false, high_water: 0},
        };
        var pool: Pool;
        if (!make(?pool, test_config(?classes[0], 1, 1 << 30), ?arena.counted)) { ret 2; }
        fin { destroy(?pool); }
        if (slots_written(?pool, paint) != 0) { ret 3; }
        var account: Account;
        if (!is_none(open_account(?pool, ?account, 1, budgets_of(64 * 4096), 64 * 4096))) { ret 4; }
        if (pool.slots.capacity < 4096)                                                   { ret 5; }
        if (slots_written(?pool, paint) != 0)                                             { ret 6; }
        var held: [3]Chunk;
        var i:    usize = 0;
        for (i < 3) {
            val got: Acquired = acquire(?pool, ?account, ask(64), false);
            if (!status_ok(got)) { ret 7; }
            held[i] = got.chunk;
            i       = i + 1;
        }
        val written: usize = slots_written(?pool, paint);
        if (written == 0 || written > 3 * $size_of(Slot)) { ret 8; }
        # a ref naming a slot never taken is refused, even when its bytes hold
        # a copy of a held slot
        @slot_at(?pool, 100) = @slot_at(?pool, held[0].ref.index);
        var forged: Chunk = held[0];
        forged.ref.index = 100;
        val refused: Reason = release(?pool, ?account, forged);
        if (!sel refused.misuse) { ret 9; }
        i = 0;
        for (i < 3) {
            if (!is_none(release(?pool, ?account, held[i]))) { ret 10; }
            i = i + 1;
        }
        if (!is_none(close_account(?pool, ?account))) { ret 11; }
        ret 0;
    }
}
