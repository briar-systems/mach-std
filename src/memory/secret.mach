# secret-welded storage: allocation, csprng fill and borrows
#
# every pointer here keeps its welded shape. this is secrecy-typed ownership,
# not memory locking or protection from process dumps. the native work is the
# os contract's secret primitives: this module adds the wipe before release,
# complete fills with a bounded interruption budget, typed geometry, and the
# borrow table.
#
# storage stays typed *^u8 (or the exact *T for typed regions) across the whole
# native boundary, with no public pointer or integer alias to the bytes. linux
# uses direct syscalls, darwin libSystem, and windows the virtual-memory and
# system-entropy apis (BCRYPT_USE_SYSTEM_PREFERRED_RNG needs vista sp2 or
# later).
#
# allocation returns zero-filled storage, or nil for zero bytes or failure.
# release wipes the whole logical span before the native release and reports
# success only once the original allocation is gone. (nil, 0) is a successful
# no-op, and a failed release leaves zeroed storage owned by the caller. a fill
# succeeds only after the whole range is initialized, and wipes the whole range
# before returning any error.
#
# typed allocation checks the complete count * $size_of(T) geometry and honours
# $align_of(T), over-aligned records included. typed release needs the original
# count, validates the stored geometry, and wipes every byte of every element,
# padding included.
#
# the ^ qualifier enforces secret data flow. none of this locks pages, keeps
# them out of swap or dumps, isolates them across process creation, adds guard
# pages, or resists a debugger with process access.

use io_error: std.io.error;
use std.sync.atomic;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.isize;
use std.types.size.usize;

$if (capability.HAS_ENTROPY && capability.HAS_FILES && capability.HAS_PAGES) {
    use std.system.os;
}
$or {
    $error("std.memory.secret needs the entropy, files and pages capabilities (std.system.capability.HAS_ENTROPY, HAS_FILES, HAS_PAGES)");
}

val INTERRUPT_MAX_RETRIES: usize = 8;
val TYPED_HEADER_WORDS:    usize = 3;
val TYPED_HEADER_SIZE:     usize = TYPED_HEADER_WORDS * $size_of(usize);

# providers return a count or a negative native code
def FillFun:    fun(ptr, *^u8, usize) i64;
def ReleaseFun: fun(ptr, *^u8, usize) i64;

rec TypedAllocation[T] {
    base:  *T;
    total: usize;
    count: usize;
}

fun refused(kind: io_error.Kind, operation: io_error.Operation) err[io_error.Error] {
    ret err[io_error.Error].err{io_error.make(kind, operation)};
}

fun native(code: i64, operation: io_error.Operation) err[io_error.Error] {
    ret err[io_error.Error].err{os.error(code, operation)};
}

fun interrupted(code: i64) bool {
    ret code < 0 && os.error_kind(code) == io_error.INTERRUPTED;
}

#[oblivious]
fun wipe(data: *^u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        data[i] = 0;
        i       = i + 1;
    }
}

fun fill_all(context: ptr, data: *^u8, len: usize, max_chunk: usize,
    fill_fn: FillFun) err[io_error.Error] {
    if (len == 0)    { ret err[io_error.Error].ok{}; }
    if (data == nil) { ret refused(io_error.INVALID, io_error.OP_READ); }
    if (max_chunk == 0) {
        wipe(data, len);
        ret refused(io_error.INVALID, io_error.OP_READ);
    }

    var filled:        usize = 0;
    var interruptions: usize = 0;
    for (filled < len) {
        var chunk: usize = len - filled;
        if (chunk > max_chunk) { chunk = max_chunk; }
        val count: i64 = fill_fn(context, ?data[filled], chunk);
        if (interrupted(count)) {
            interruptions = interruptions + 1;
            if (interruptions >= INTERRUPT_MAX_RETRIES) {
                wipe(data, len);
                ret native(count, io_error.OP_READ);
            }
        }
        or {
            if (count < 0) {
                wipe(data, len);
                ret native(count, io_error.OP_READ);
            }
            if (count == 0 || count::usize > chunk) {
                wipe(data, len);
                ret refused(io_error.IO, io_error.OP_READ);
            }
            filled        = filled + count::usize;
            interruptions = 0;
        }
    }
    ret err[io_error.Error].ok{};
}

fun release_all(context: ptr, data: *^u8, size: usize, release_fn: ReleaseFun) err[io_error.Error] {
    if (data == nil && size == 0) { ret err[io_error.Error].ok{}; }
    if (data == nil || size == 0) { ret refused(io_error.INVALID, io_error.OP_CLOSE); }
    wipe(data, size);
    val released: i64 = release_fn(context, data, size);
    if (released < 0) { ret native(released, io_error.OP_CLOSE); }
    ret err[io_error.Error].ok{};
}

fun wipe_typed[T](data: *T, count: usize) {
    val bytes: usize = $size_of(T) * count;
    var i:     usize = 0;
    for (i < bytes) {
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {data}
                mov rcx, {i}
                add rax, rcx
                mov byte [rax], 0
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x0, {data}
                ldr x1, {i}
                add x0, x0, x1
                strb wzr, [x0]
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld t0, {data}
                ld t1, {i}
                add t0, t0, t1
                sb zero, 0(t0)
            }
        }
        i = i + 1;
    }
}

fun typed_total[T](count: usize, total: *usize, alignment: *usize) bool {
    if (count == 0 || $size_of(T) == 0)    { ret false; }
    if (count > ~(0::usize) / $size_of(T)) { ret false; }

    var align: usize = $align_of(T);
    if (align < $size_of(usize)) { align = $size_of(usize); }
    val bytes: usize = $size_of(T) * count;
    if (bytes > ~(0::usize) - TYPED_HEADER_SIZE) { ret false; }
    val with_header: usize = bytes + TYPED_HEADER_SIZE;
    if (with_header > ~(0::usize) - (align - 1)) { ret false; }
    @total     = with_header + align - 1;
    @alignment = align;
    ret true;
}

fun typed_aligned[T](data: *T, alignment: usize) bool {
    var remainder: usize = 1;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {data}
            mov rcx, {alignment}
            dec rcx
            and rax, rcx
            mov {remainder}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x0, {data}
            ldr x1, {alignment}
            sub x1, x1, 1
            and x0, x0, x1
            str x0, {remainder}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {data}
            ld t1, {alignment}
            addi t1, t1, -1
            and t0, t0, t1
            sd t0, {remainder}
        }
    }
    ret remainder == 0;
}

fun align_typed[T](base: *T, total: usize, alignment: usize, count: usize) *T {
    var out:    *T    = nil;
    val header: usize = TYPED_HEADER_SIZE;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {base}
            mov rcx, {alignment}
            mov rdx, {header}
            add rax, rdx
            mov r8, rcx
            dec r8
            add rax, r8
            neg rcx
            and rax, rcx
            mov r8, rax
            sub r8, rdx
            mov r9, {base}
            mov [r8], r9
            mov r9, {total}
            mov [r8 + 8], r9
            mov r9, {count}
            mov [r8 + 16], r9
            mov {out}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x0, {base}
            ldr x1, {alignment}
            ldr x2, {header}
            add x3, x0, x2
            sub x4, x1, 1
            add x3, x3, x4
            sub x4, xzr, x1
            and x3, x3, x4
            sub x4, x3, x2
            str x0, [x4]
            ldr x5, {total}
            str x5, [x4, 8]
            ldr x5, {count}
            str x5, [x4, 16]
            str x3, {out}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {base}
            ld t1, {alignment}
            ld t2, {header}
            add t3, t0, t2
            addi t4, t1, -1
            add t3, t3, t4
            sub t4, zero, t1
            and t3, t3, t4
            sub t4, t3, t2
            sd t0, 0(t4)
            ld t5, {total}
            sd t5, 8(t4)
            ld t5, {count}
            sd t5, 16(t4)
            sd t3, {out}
        }
    }
    ret out;
}

fun typed_allocation[T](data: *T) TypedAllocation[T] {
    var base:   *T    = nil;
    var total:  usize = 0;
    var count:  usize = 0;
    val header: usize = TYPED_HEADER_SIZE;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {data}
            sub rax, {header}
            mov rcx, [rax]
            mov {base}, rcx
            mov rcx, [rax + 8]
            mov {total}, rcx
            mov rcx, [rax + 16]
            mov {count}, rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x0, {data}
            ldr x1, {header}
            sub x0, x0, x1
            ldr x1, [x0]
            str x1, {base}
            ldr x1, [x0, 8]
            str x1, {total}
            ldr x1, [x0, 16]
            str x1, {count}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {data}
            ld t1, {header}
            sub t0, t0, t1
            ld t1, 0(t0)
            sd t1, {base}
            ld t1, 8(t0)
            sd t1, {total}
            ld t1, 16(t0)
            sd t1, {count}
        }
    }
    ret TypedAllocation[T]{base: base, total: total, count: count};
}

fun release_typed[T](context: ptr, data: *T, count: usize,
    release_fn: fun(ptr, *T, *T, usize) i64) err[io_error.Error] {
    if (data == nil && count == 0)                     { ret err[io_error.Error].ok{}; }
    if (data == nil || count == 0 || $size_of(T) == 0) { ret refused(io_error.INVALID, io_error.OP_CLOSE); }
    var expected_total: usize = 0;
    var alignment:      usize = 0;
    if (!typed_total[T](count, ?expected_total, ?alignment) ||
        !typed_aligned[T](data, alignment)) { ret refused(io_error.INVALID, io_error.OP_CLOSE); }
    val allocation: TypedAllocation[T] = typed_allocation[T](data);
    if (allocation.base == nil || allocation.total != expected_total ||
        allocation.count != count) { ret refused(io_error.INVALID, io_error.OP_CLOSE); }
    wipe_typed[T](data, count);
    val released: i64 = release_fn(context, data, allocation.base, allocation.total);
    if (released < 0) { ret native(released, io_error.OP_CLOSE); }
    ret err[io_error.Error].ok{};
}

fun native_release(context: ptr, data: *^u8, size: usize) i64 {
    ret os.release_secret(data, size);
}

fun native_release_typed[T](context: ptr, data: *T, base: *T, size: usize) i64 {
    ret os.release_secret_typed[T](base, size);
}

fun native_fill(context: ptr, data: *^u8, len: usize) i64 {
    ret os.random_fill_secret(data, len);
}

# allocate one zero-initialized secret-welded byte region
# ---
# size: number of addressable bytes
# ret:  logical span owner, or nil for zero size or failure
pub fun allocate(size: usize) *^u8 {
    ret os.allocate_secret(size);
}

# wipe and release one secret-welded byte region
# ---
# data: allocation returned by allocate
# size: original nonzero allocation size
# ret:  ok after the wipe and release, or the error with zeroed ownership retained
pub fun deallocate(data: *^u8, size: usize) err[io_error.Error] {
    ret release_all(nil, data, size, native_release);
}

# allocate a zero-initialized typed region without changing T's secrecy shape
# ---
# count: number of T values
# ret:   aligned typed owner, or nil for zero count, overflow, or failure
pub fun allocate_typed[T](count: usize) *T {
    var total:     usize = 0;
    var alignment: usize = 0;
    if (!typed_total[T](count, ?total, ?alignment)) { ret nil; }
    val base: *T = os.allocate_secret_typed[T](total);
    if (base == nil) { ret nil; }
    ret align_typed[T](base, total, alignment, count);
}

# wipe and release a typed region without changing T's secrecy shape
# ---
# data:  allocation returned by allocate_typed[T]
# count: original element count
# ret:   ok after the release, or the error with wiped ownership retained
pub fun deallocate_typed[T](data: *T, count: usize) err[io_error.Error] {
    ret release_typed[T](nil, data, count, native_release_typed[T]);
}

# initialize every requested byte from the operating-system csprng
# ---
# data: destination secret storage
# len:  number of bytes to initialize
# ret:  ok after complete initialization, or the error after a complete wipe
pub fun random_fill(data: *^u8, len: usize) err[io_error.Error] {
    ret fill_all(nil, data, len, os.RANDOM_FILL_SECRET_MAX, native_fill);
}

# borrows: welded storage lent to a public integer handle
#
# a `*^u8` can never be erased to `ptr`, so no worker task, runtime source or
# cancellation registration (all `ptr` contexts) can carry one. a borrow is the
# boundary's answer: the owner lends its welded storage to this table and gets
# back an index-and-generation handle that is not an address, cannot be
# dereferenced, and unlocks only secret-to-secret copies, wipes and positioned
# kernel transfers. the native pointer leaves the process exactly once, in
# `borrow_read_at` and `borrow_write_at`, as the argument of the contract's
# secret positioned transfer. nothing here yields a `*u8`.
#
# the table is process-wide and typed: its entries hold `*^u8`, so it lives in
# its own secret-typed allocation and grows by doubling. the lock guards the
# table only; a handle's owner serializes its use against its close, the same
# way a descriptor's owner does.

pub rec Borrow {
    index:      u32;
    generation: u32;
}

rec BorrowEntry {
    data:       *^u8;
    size:       usize;
    generation: u32;
    used:       bool;
}

def PositionedFun: fun(ptr, usize, *^u8, usize, u64) i64;

val BORROW_INITIAL_CAPACITY: usize = 16;

var _borrow_entries:  *BorrowEntry = nil;
var _borrow_capacity: usize        = 0;
var _borrow_lock:     i64          = 0;

fun borrow_lock() {
    var expected: i64 = 0;
    for (!atomic.cas(?_borrow_lock, ?expected, 1)) { expected = 0; }
}

fun borrow_unlock() {
    atomic.store(?_borrow_lock, 0);
}

#[oblivious]
fun copy_secret(destination: *^u8, source: *^u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        destination[i] = source[i];
        i              = i + 1;
    }
}

fun borrow_grow() bool {
    var next: usize = BORROW_INITIAL_CAPACITY;
    if (_borrow_capacity != 0) {
        if (_borrow_capacity > ~(0::usize) / 2) { ret false; }
        next = _borrow_capacity * 2;
    }
    val fresh: *BorrowEntry = allocate_typed[BorrowEntry](next);
    if (fresh == nil) { ret false; }
    var i: usize = 0;
    for (i < _borrow_capacity) {
        fresh[i] = _borrow_entries[i];
        i        = i + 1;
    }
    val previous:          *BorrowEntry = _borrow_entries;
    val previous_capacity: usize        = _borrow_capacity;
    _borrow_entries  = fresh;
    _borrow_capacity = next;
    if (previous != nil) { deallocate_typed[BorrowEntry](previous, previous_capacity); }
    ret true;
}

fun borrow_entry_locked(borrow: Borrow) *BorrowEntry {
    if (borrow.index::usize >= _borrow_capacity) { ret nil; }
    val entry: *BorrowEntry = ?_borrow_entries[borrow.index::usize];
    if (!entry.used || entry.generation != borrow.generation) { ret nil; }
    ret entry;
}

# resolve a span inside a live borrow; the pointer is valid until the owner closes it
fun borrow_span(borrow: Borrow, offset: usize, len: usize, data: **^u8, operation: io_error.Operation) err[io_error.Error] {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    if (entry == nil) {
        borrow_unlock();
        ret refused(io_error.CLOSED, operation);
    }
    if (offset > entry.size || len > entry.size - offset) {
        borrow_unlock();
        ret refused(io_error.INVALID, operation);
    }
    @data = ?entry.data[offset];
    borrow_unlock();
    ret err[io_error.Error].ok{};
}

# lend welded storage to a handle
# ---
# data: the storage, which stays owned by and valid for the caller until close
# size: nonzero span length
# out:  the handle
# ret:  ok, INVALID for nil or empty storage or a nil out, RESOURCE_EXHAUSTED
#       when the table cannot grow
pub fun borrow_open(data: *^u8, size: usize, out: *Borrow) err[io_error.Error] {
    if (out == nil || data == nil || size == 0) { ret refused(io_error.INVALID, io_error.OP_OPEN); }
    borrow_lock();
    var index: usize = 0;
    for (index < _borrow_capacity && _borrow_entries[index].used) { index = index + 1; }
    if (index == _borrow_capacity) {
        if (!borrow_grow()) {
            borrow_unlock();
            ret refused(io_error.RESOURCE_EXHAUSTED, io_error.OP_OPEN);
        }
    }
    val entry:      *BorrowEntry = ?_borrow_entries[index];
    var generation: u32          = entry.generation + 1;
    if (generation == 0) { generation = 1; }
    entry.data       = data;
    entry.size       = size;
    entry.generation = generation;
    entry.used       = true;
    borrow_unlock();
    @out = Borrow{index: index::u32, generation: generation};
    ret err[io_error.Error].ok{};
}

# return a borrow; the storage is neither wiped nor released, it was never owned
# ---
# ret: ok, or CLOSED for a handle that is not live
pub fun borrow_close(borrow: Borrow) err[io_error.Error] {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    if (entry == nil) {
        borrow_unlock();
        ret refused(io_error.CLOSED, io_error.OP_CLOSE);
    }
    entry.data = nil;
    entry.size = 0;
    entry.used = false;
    borrow_unlock();
    ret err[io_error.Error].ok{};
}

# the span length of a live borrow, or zero
pub fun borrow_size(borrow: Borrow) usize {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    var size:  usize        = 0;
    if (entry != nil) { size = entry.size; }
    borrow_unlock();
    ret size;
}

# the welded storage of a live borrow, or nil
#
# the pointer stays valid until the owner closes the borrow, the same lifetime
# the positioned transfers rely on
pub fun borrow_data(borrow: Borrow) *^u8 {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    var data:  *^u8         = nil;
    if (entry != nil) { data = entry.data; }
    borrow_unlock();
    ret data;
}

# zero a span of a borrow
# ---
# ret: ok, CLOSED for a dead handle, INVALID for a span outside the borrow
pub fun borrow_wipe(borrow: Borrow, offset: usize, len: usize) err[io_error.Error] {
    var data:     *^u8                = nil;
    val resolved: err[io_error.Error] = borrow_span(borrow, offset, len, ?data, io_error.OP_WRITE);
    if (sel resolved.err) { ret resolved; }
    wipe(data, len);
    ret err[io_error.Error].ok{};
}

# copy welded bytes into a span of a borrow
# ---
# source: welded storage the caller can read
# ret:    ok, CLOSED, or INVALID for a span outside the borrow or a nil source
pub fun borrow_fill(borrow: Borrow, offset: usize, source: *^u8, len: usize) err[io_error.Error] {
    if (len == 0)      { ret err[io_error.Error].ok{}; }
    if (source == nil) { ret refused(io_error.INVALID, io_error.OP_WRITE); }
    var data:     *^u8                = nil;
    val resolved: err[io_error.Error] = borrow_span(borrow, offset, len, ?data, io_error.OP_WRITE);
    if (sel resolved.err) { ret resolved; }
    copy_secret(data, source, len);
    ret err[io_error.Error].ok{};
}

# copy welded bytes out of a span of a borrow
# ---
# destination: welded storage the caller owns
# ret:         ok, CLOSED, or INVALID for a span outside the borrow or a nil destination
pub fun borrow_drain(borrow: Borrow, offset: usize, destination: *^u8, len: usize) err[io_error.Error] {
    if (len == 0)           { ret err[io_error.Error].ok{}; }
    if (destination == nil) { ret refused(io_error.INVALID, io_error.OP_READ); }
    var data:     *^u8                = nil;
    val resolved: err[io_error.Error] = borrow_span(borrow, offset, len, ?data, io_error.OP_READ);
    if (sel resolved.err) { ret resolved; }
    copy_secret(destination, data, len);
    ret err[io_error.Error].ok{};
}

# copy between two borrows without either pointer leaving the boundary
# ---
# ret: ok, CLOSED for a dead handle, INVALID for a span outside either borrow
pub fun borrow_copy(destination: Borrow, destination_offset: usize, source: Borrow, source_offset: usize, len: usize) err[io_error.Error] {
    if (len == 0) { ret err[io_error.Error].ok{}; }
    var to:          *^u8                = nil;
    val to_resolved: err[io_error.Error] = borrow_span(destination, destination_offset, len, ?to, io_error.OP_WRITE);
    if (sel to_resolved.err) { ret to_resolved; }
    var from:          *^u8                = nil;
    val from_resolved: err[io_error.Error] = borrow_span(source, source_offset, len, ?from, io_error.OP_READ);
    if (sel from_resolved.err) { ret from_resolved; }
    copy_secret(to, from, len);
    ret err[io_error.Error].ok{};
}

# one positioned transfer with the interruption budget the fill path uses; the
# provider is the native call, and the storage stays untouched by this layer
# before, during and after it
fun positioned_all(context: ptr, file: usize, data: *^u8, len: usize, offset: u64,
    native_fn: PositionedFun, operation: io_error.Operation) res[usize, io_error.Error] {
    var interruptions: usize = 0;
    var result:        i64   = 0;
    for (interruptions < INTERRUPT_MAX_RETRIES) {
        result = native_fn(context, file, data, len, offset);
        if (!interrupted(result)) {
            if (result < 0) { ret res[usize, io_error.Error].err{os.error(result, operation)}; }
            ret res[usize, io_error.Error].ok{result::usize};
        }
        interruptions = interruptions + 1;
    }
    ret res[usize, io_error.Error].err{os.error(result, operation)};
}

fun positioned_span(borrow: Borrow, offset: usize, len: usize, file_offset: u64, data: **^u8,
    operation: io_error.Operation) err[io_error.Error] {
    if (file_offset > 0x7fffffffffffffff) { ret refused(io_error.INVALID, operation); }
    ret borrow_span(borrow, offset, len, data, operation);
}

fun native_read_at(context: ptr, file: usize, data: *^u8, len: usize, offset: u64) i64 {
    ret os.read_at_secret(file, data, len, offset);
}

fun native_write_at(context: ptr, file: usize, data: *^u8, len: usize, offset: u64) i64 {
    ret os.write_at_secret(file, data, len, offset);
}

# read from a file into a span of a borrow: the kernel writes the welded
# storage through this call and nothing else
# ---
# ret: bytes delivered (zero at end of file), or the error with the span unspecified
pub fun borrow_read_at(file: usize, borrow: Borrow, offset: usize, len: usize, file_offset: u64) res[usize, io_error.Error] {
    var data:     *^u8                = nil;
    val resolved: err[io_error.Error] = positioned_span(borrow, offset, len, file_offset, ?data, io_error.OP_READ);
    if (sel resolved.err) { ret res[usize, io_error.Error].err{resolved.err}; }
    if (len == 0)         { ret res[usize, io_error.Error].ok{0}; }
    ret positioned_all(nil, file, data, len, file_offset, native_read_at, io_error.OP_READ);
}

# write a span of a borrow to a file: the kernel reads the welded storage
# through this call and nothing else
# ---
# ret: bytes persisted, or the error with nothing about the span changed
pub fun borrow_write_at(file: usize, borrow: Borrow, offset: usize, len: usize, file_offset: u64) res[usize, io_error.Error] {
    var data:     *^u8                = nil;
    val resolved: err[io_error.Error] = positioned_span(borrow, offset, len, file_offset, ?data, io_error.OP_WRITE);
    if (sel resolved.err) { ret res[usize, io_error.Error].err{resolved.err}; }
    if (len == 0)         { ret res[usize, io_error.Error].ok{0}; }
    ret positioned_all(nil, file, data, len, file_offset, native_write_at, io_error.OP_WRITE);
}

$if ($mach.build.os == $mach.os.linux) {
    use native_os: std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use native_os: std.system.os.darwin;
}
$or ($mach.build.os == $mach.os.windows) {
    use native_os: std.system.os.windows;
}

# generic fixtures instantiate only in test builds
fun is_ok[T](result: err[io_error.Error]) bool {
    ret sel result.ok;
}

fun refused_as[T](result: err[io_error.Error], kind: io_error.Kind) bool {
    if (sel result.err) { ret result.err.kind == kind && result.err.code == 0; }
    ret false;
}

fun failed_natively[T](result: err[io_error.Error], code: i64) bool {
    ret sel result.err && result.err.code == code;
}

fun count_is[T](result: res[usize, io_error.Error], count: usize) bool {
    ret sel result.ok && result.ok == count;
}

fun count_refused[T](result: res[usize, io_error.Error], kind: io_error.Kind) bool {
    if (sel result.err) { ret result.err.kind == kind && result.err.code == 0; }
    ret false;
}

fun count_failed[T](result: res[usize, io_error.Error], code: i64) bool {
    ret sel result.err && result.err.code == code;
}

# generic fixtures instantiate only in test builds
rec FillScript {
    results: [4]i64;
    len:     usize;
    next:    usize;
    byte:    u8;
}

fun scripted_fill[T](context: ptr, data: *^u8, len: usize) i64 {
    val script: *FillScript = context::*FillScript;
    if (script.next >= script.len) { ret native_os.EIO; }
    val result: i64 = script.results[script.next];
    script.next = script.next + 1;
    if (result > 0) {
        var count: usize = result::usize;
        if (count > len) { count = len; }
        var i: usize = 0;
        for (i < count) {
            data[i] = script.byte;
            i       = i + 1;
        }
    }
    ret result;
}

fun all_zero[T](data: *^u8, len: usize) i64 {
    var i: usize = 0;
    for (i < len) {
        if (data[i]:>u8 != 0) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

rec InterruptProbe {
    calls: usize;
    byte:  u8;
}

fun reset_probe_fill[T](context: ptr, data: *^u8, len: usize) i64 {
    val probe: *InterruptProbe = context::*InterruptProbe;
    probe.calls = probe.calls + 1;
    if (probe.calls == INTERRUPT_MAX_RETRIES ||
        probe.calls == INTERRUPT_MAX_RETRIES * 2) {
        data[0] = probe.byte;
        ret 1;
    }
    ret native_os.EINTR;
}

fun interrupted_fill[T](context: ptr, data: *^u8, len: usize) i64 {
    val probe: *InterruptProbe = context::*InterruptProbe;
    probe.calls = probe.calls + 1;
    ret native_os.EINTR;
}

rec ReleaseProbe {
    calls:    usize;
    saw_zero: i64;
    result:   i64;
}

fun probe_release[T](context: ptr, data: *^u8, size: usize) i64 {
    val probe: *ReleaseProbe = context::*ReleaseProbe;
    probe.calls    = probe.calls + 1;
    probe.saw_zero = all_zero[T](data, size);
    ret probe.result;
}

test "std.memory.secret: lifecycle preserves welded storage" {
    if (allocate(0) != nil)                                     { ret 1; }
    if (!is_ok[u8](deallocate(nil, 0)))                         { ret 1; }
    if (!refused_as[u8](deallocate(nil, 1), io_error.INVALID))  { ret 1; }
    if (!is_ok[u8](random_fill(nil, 0)))                        { ret 1; }
    if (!refused_as[u8](random_fill(nil, 1), io_error.INVALID)) { ret 1; }

    val size: usize = 513;
    val data: *^u8  = allocate(size);
    if (data == nil) { ret 1; }
    var failed: i64 = 0;
    if (all_zero[u8](data, size) == 0) { failed = 1; }
    if (!refused_as[u8](deallocate(data, 0), io_error.INVALID)) {
        failed = 1;
    }
    data[0]        = 0xA5;
    data[size - 1] = 0x5A;
    if (data[0]:>u8 != 0xA5 || data[size - 1]:>u8 != 0x5A) {
        failed = 1;
    }
    if (!is_ok[u8](random_fill(data, size))) {
        failed = 1;
    }
    if (!is_ok[u8](deallocate(data, size))) { ret 1; }
    ret failed::i32;
}

test "std.memory.secret: fill retries partial and interrupted providers" {
    var data:   [4]^u8     = [4]^u8{0, 0, 0, 0};
    var script: FillScript = FillScript{
        results: [4]i64{native_os.EINTR, 2, 2, 0}, len: 3, next: 0, byte: 0xA5,
    };
    if (!is_ok[u8](fill_all(?script, ?data[0], 4, 4, scripted_fill[u8]))) { ret 1; }
    if (script.next != 3)                                                 { ret 1; }
    var i: usize = 0;
    for (i < 4) {
        if (data[i]:>u8 != 0xA5) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "std.memory.secret: fill resets its interruption budget after progress" {
    var data:  [2]^u8         = [2]^u8{0, 0};
    var probe: InterruptProbe = InterruptProbe{calls: 0, byte: 0xA5};
    if (!is_ok[u8](fill_all(?probe, ?data[0], 2, 2, reset_probe_fill[u8]))) { ret 1; }
    if (probe.calls != INTERRUPT_MAX_RETRIES * 2)                           { ret 1; }
    if (data[0]:>u8 != 0xA5 || data[1]:>u8 != 0xA5)                         { ret 1; }
    ret 0;
}

test "std.memory.secret: fill bounds repeated interruptions and wipes" {
    var data:      [4]^u8              = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var probe:     InterruptProbe      = InterruptProbe{calls: 0, byte: 0};
    val exhausted: err[io_error.Error] = fill_all(?probe, ?data[0], 4, 4, interrupted_fill[u8]);
    if (!failed_natively[u8](exhausted, native_os.EINTR))                { ret 1; }
    if (sel exhausted.err && exhausted.err.kind != io_error.INTERRUPTED) { ret 1; }
    if (probe.calls != INTERRUPT_MAX_RETRIES)                            { ret 1; }
    if (all_zero[u8](?data[0], 4) == 0)                                  { ret 1; }
    ret 0;
}

test "std.memory.secret: fill failures wipe the complete destination" {
    var data:   [4]^u8     = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var failed: FillScript = FillScript{
        results: [4]i64{2, native_os.EIO, 0, 0}, len: 2, next: 0, byte: 0x5A,
    };
    if (!failed_natively[u8](fill_all(?failed, ?data[0], 4, 4, scripted_fill[u8]), native_os.EIO) ||
        all_zero[u8](?data[0], 4) == 0) { ret 1; }

    data = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var stalled: FillScript = FillScript{
        results: [4]i64{0, 0, 0, 0}, len: 1, next: 0, byte: 0x5A,
    };
    if (!refused_as[u8](fill_all(?stalled, ?data[0], 4, 4, scripted_fill[u8]), io_error.IO) ||
        all_zero[u8](?data[0], 4) == 0) { ret 1; }

    data = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var oversized: FillScript = FillScript{
        results: [4]i64{5, 0, 0, 0}, len: 1, next: 0, byte: 0x5A,
    };
    if (!refused_as[u8](fill_all(?oversized, ?data[0], 4, 4, scripted_fill[u8]), io_error.IO) ||
        all_zero[u8](?data[0], 4) == 0) { ret 1; }
    ret 0;
}

test "std.memory.secret: release wipes before success or failure" {
    var data:   [4]^u8       = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var failed: ReleaseProbe = ReleaseProbe{calls: 0, saw_zero: 0, result: native_os.EIO};
    if (!failed_natively[u8](release_all(?failed, ?data[0], 4, probe_release[u8]), native_os.EIO) ||
        failed.calls != 1 || failed.saw_zero == 0 || all_zero[u8](?data[0], 4) == 0) {
        ret 1;
    }

    data = [4]^u8{0x5A, 0x5A, 0x5A, 0x5A};
    var succeeded: ReleaseProbe = ReleaseProbe{calls: 0, saw_zero: 0, result: 0};
    if (!is_ok[u8](release_all(?succeeded, ?data[0], 4, probe_release[u8])) ||
        succeeded.calls != 1 || succeeded.saw_zero == 0) { ret 1; }
    ret 0;
}

# generic fixtures instantiate only in test builds
rec TypedSecretLeaf {
    value: ^u64;
}

rec TypedSecretRecord {
    public: u64;
    nested: TypedSecretLeaf;
}

#[align(8192)]
rec OverAlignedSecretRecord {
    public: u64;
    secret: ^u64;
}

rec TypedReleaseProbe {
    calls:    usize;
    saw_zero: bool;
    result:   i64;
}

fun probe_typed_release[T](context: ptr, data: *TypedSecretRecord,
    base: *TypedSecretRecord, size: usize) i64 {
    val probe: *TypedReleaseProbe = context::*TypedReleaseProbe;
    probe.calls    = probe.calls + 1;
    probe.saw_zero = data[0].public == 0 && data[0].nested.value:>u64 == 0 &&
        data[1].public == 0 && data[1].nested.value:>u64 == 0;
    ret probe.result;
}

test "std.memory.secret: typed allocation preserves public and direct secret shapes" {
    val public: *u64 = allocate_typed[u64](3);
    if (public == nil) { ret 1; }
    var failed: i64   = 0;
    var i:      usize = 0;
    for (i < 3) {
        if (public[i] != 0) { failed = 1; }
        public[i] = i + 1;
        i         = i + 1;
    }
    if (!is_ok[u8](deallocate_typed[u64](public, 3))) { ret 1; }

    val direct: *^u64 = allocate_typed[^u64](3);
    if (direct == nil) { ret 1; }
    i = 0;
    for (i < 3) {
        if (direct[i]:>u64 != 0) { failed = 1; }
        direct[i] = 12;
        i         = i + 1;
    }
    if (!is_ok[u8](deallocate_typed[^u64](direct, 3))) { ret 1; }
    ret failed::i32;
}

test "std.memory.secret: deeply secret typed allocation is aligned and zeroed" {
    val data: *TypedSecretRecord = allocate_typed[TypedSecretRecord](2);
    if (data == nil || !typed_aligned[TypedSecretRecord](data,
        $align_of(TypedSecretRecord))) { ret 1; }
    var i: usize = 0;
    for (i < 2) {
        if (data[i].public != 0 || data[i].nested.value:>u64 != 0) { ret 1; }
        data[i].public       = i + 21;
        data[i].nested.value = 32;
        i                    = i + 1;
    }
    if (!is_ok[u8](deallocate_typed[TypedSecretRecord](data, 2))) { ret 2; }
    ret 0;
}

test "std.memory.secret: explicit typed alignment is honored" {
    val data: *OverAlignedSecretRecord =
        allocate_typed[OverAlignedSecretRecord](2);
    if (data == nil || !typed_aligned[OverAlignedSecretRecord](data, 8192)) {
        ret 1;
    }
    if (data[0].public != 0 || data[0].secret:>u64 != 0 ||
        data[1].public != 0 || data[1].secret:>u64 != 0) { ret 1; }
    data[1].public = 41;
    data[1].secret = 42;
    if (!is_ok[u8](deallocate_typed[OverAlignedSecretRecord](data, 2))) { ret 2; }
    ret 0;
}

test "std.memory.secret: typed geometry rejects empty and overflowing owners" {
    if (allocate_typed[u64](0) != nil)                                    { ret 1; }
    if (!is_ok[u8](deallocate_typed[u64](nil, 0)))                        { ret 1; }
    if (!refused_as[u8](deallocate_typed[u64](nil, 1), io_error.INVALID)) { ret 1; }
    if (allocate_typed[u64](~(0::usize) / $size_of(u64) + 1) != nil) {
        ret 1;
    }
    if (allocate_typed[u8](~(0::usize)) != nil) { ret 1; }
    ret 0;
}

test "std.memory.secret: typed release validates count and retains wiped failures" {
    val data: *TypedSecretRecord = allocate_typed[TypedSecretRecord](2);
    if (data == nil) { ret 1; }
    data[0].public       = 51;
    data[0].nested.value = 52;
    data[1].public       = 53;
    data[1].nested.value = 54;

    if (!refused_as[u8](deallocate_typed[TypedSecretRecord](data, 1), io_error.INVALID)) { ret 2; }
    if (data[0].public != 51 || data[0].nested.value:>u64 != 52 ||
        data[1].public != 53 || data[1].nested.value:>u64 != 54) { ret 3; }

    var probe: TypedReleaseProbe = TypedReleaseProbe{
        calls: 0, saw_zero: false, result: native_os.EIO,
    };
    if (!failed_natively[u8](release_typed[TypedSecretRecord](?probe, data, 2,
        probe_typed_release[u8]), native_os.EIO)) { ret 4; }
    if (probe.calls != 1) { ret 5; }
    if (!probe.saw_zero)  { ret 6; }
    if (data[0].public != 0 || data[0].nested.value:>u64 != 0 ||
        data[1].public != 0 || data[1].nested.value:>u64 != 0) { ret 7; }
    if (!is_ok[u8](deallocate_typed[TypedSecretRecord](data, 2))) { ret 8; }
    ret 0;
}

# generic fixtures instantiate only in test builds
rec PositionedProbe {
    calls:       usize;
    file:        usize;
    len:         usize;
    offset:      u64;
    saw_pattern: bool;
    byte:        u8;
    result:      i64;
    interrupt:   usize;
}

fun probe_positioned[T](context: ptr, file: usize, data: *^u8, len: usize, offset: u64) i64 {
    val probe: *PositionedProbe = context::*PositionedProbe;
    probe.calls  = probe.calls + 1;
    probe.file   = file;
    probe.len    = len;
    probe.offset = offset;
    if (probe.calls <= probe.interrupt) { ret native_os.EINTR; }
    var i: usize = 0;
    probe.saw_pattern = true;
    for (i < len) {
        if (data[i]:>u8 != probe.byte) { probe.saw_pattern = false; }
        i = i + 1;
    }
    ret probe.result;
}

fun borrow_all_zero[T](borrow: Borrow, offset: usize, len: usize) i64 {
    var data: *^u8 = nil;
    if (!is_ok[u8](borrow_span(borrow, offset, len, ?data, io_error.OP_READ))) { ret -1; }
    ret all_zero[T](data, len);
}

fun fill_pattern[T](data: *^u8, len: usize, byte: u8) {
    var i: usize = 0;
    for (i < len) {
        data[i] = byte;
        i       = i + 1;
    }
}

test "std.memory.secret: borrows lend welded storage to handles that are not addresses" {
    var handle: Borrow;
    if (!refused_as[u8](borrow_open(nil, 8, ?handle), io_error.INVALID)) { ret 1; }
    var storage: [8]^u8;
    if (!refused_as[u8](borrow_open(?storage[0], 0, ?handle), io_error.INVALID)) { ret 2; }
    if (!refused_as[u8](borrow_open(?storage[0], 8, nil), io_error.INVALID))     { ret 3; }
    if (!is_ok[u8](borrow_open(?storage[0], 8, ?handle)))                        { ret 4; }
    if (borrow_size(handle) != 8)                                                { ret 5; }
    fill_pattern[u8](?storage[0], 8, 0x5a);
    var mirror: [8]^u8;
    if (!is_ok[u8](borrow_drain(handle, 0, ?mirror[0], 8))) { ret 6; }
    var i: usize = 0;
    for (i < 8) {
        if (mirror[i]:>u8 != 0x5a) { ret 7; }
        i = i + 1;
    }
    fill_pattern[u8](?mirror[0], 8, 0xa5);
    if (!is_ok[u8](borrow_fill(handle, 2, ?mirror[0], 4)))                                                    { ret 8; }
    if (storage[1]:>u8 != 0x5a || storage[2]:>u8 != 0xa5 || storage[5]:>u8 != 0xa5 || storage[6]:>u8 != 0x5a) { ret 9; }
    if (!refused_as[u8](borrow_fill(handle, 6, ?mirror[0], 4), io_error.INVALID))                             { ret 10; }
    if (!is_ok[u8](borrow_drain(handle, 9, ?mirror[0], 0)))                                                   { ret 11; }
    if (!refused_as[u8](borrow_wipe(handle, 8, 1), io_error.INVALID))                                         { ret 12; }
    if (!is_ok[u8](borrow_wipe(handle, 2, 4)))                                                                { ret 13; }
    if (borrow_all_zero[u8](handle, 2, 4) != 1)                                                               { ret 14; }
    if (borrow_all_zero[u8](handle, 0, 8) != 0)                                                               { ret 15; }
    if (!is_ok[u8](borrow_close(handle)))                                                                     { ret 16; }
    if (!refused_as[u8](borrow_close(handle), io_error.CLOSED))                                               { ret 17; }
    if (borrow_size(handle) != 0)                                                                             { ret 18; }
    if (!refused_as[u8](borrow_wipe(handle, 0, 1), io_error.CLOSED))                                          { ret 19; }
    if (!refused_as[u8](borrow_fill(handle, 0, ?mirror[0], 1), io_error.CLOSED))                              { ret 20; }
    if (storage[0]:>u8 != 0x5a || storage[7]:>u8 != 0x5a)                                                     { ret 21; }
    ret 0;
}

test "std.memory.secret: a returned borrow handle does not revive with its slot" {
    var first:  [4]^u8;
    var second: [4]^u8;
    var stale:  Borrow;
    if (!is_ok[u8](borrow_open(?first[0], 4, ?stale))) { ret 1; }
    if (!is_ok[u8](borrow_close(stale)))               { ret 2; }
    var fresh: Borrow;
    if (!is_ok[u8](borrow_open(?second[0], 4, ?fresh)))                     { ret 3; }
    if (fresh.index == stale.index && fresh.generation == stale.generation) { ret 4; }
    if (!refused_as[u8](borrow_wipe(stale, 0, 4), io_error.CLOSED))         { ret 5; }
    fill_pattern[u8](?second[0], 4, 3);
    var mirror: [4]^u8;
    if (!refused_as[u8](borrow_drain(stale, 0, ?mirror[0], 4), io_error.CLOSED)) { ret 6; }
    if (!is_ok[u8](borrow_drain(fresh, 0, ?mirror[0], 4)))                       { ret 7; }
    if (mirror[3]:>u8 != 3)                                                      { ret 8; }
    if (!is_ok[u8](borrow_close(fresh)))                                         { ret 9; }
    ret 0;
}

test "std.memory.secret: the borrow table grows past its first extent" {
    val count:   usize = BORROW_INITIAL_CAPACITY * 2 + 3;
    val storage: *^u8  = allocate(count);
    if (storage == nil) { ret 1; }
    var handles: [64]Borrow;
    if (count > 64) {
        deallocate(storage, count);
        ret 2;
    }
    var i: usize = 0;
    for (i < count) {
        storage[i] = (i + 1)::u8;
        if (!is_ok[u8](borrow_open(?storage[i], 1, ?handles[i]))) {
            deallocate(storage, count);
            ret 3;
        }
        i = i + 1;
    }
    var mirror: [1]^u8;
    i = 0;
    for (i < count) {
        if (!is_ok[u8](borrow_drain(handles[i], 0, ?mirror[0], 1))) {
            deallocate(storage, count);
            ret 4;
        }
        if (mirror[0]:>u8 != (i + 1)::u8) {
            deallocate(storage, count);
            ret 5;
        }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        if (!is_ok[u8](borrow_close(handles[i]))) {
            deallocate(storage, count);
            ret 6;
        }
        i = i + 1;
    }
    if (!is_ok[u8](deallocate(storage, count))) { ret 7; }
    ret 0;
}

test "std.memory.secret: borrow copies move bytes between handles without a pointer" {
    var from_storage: [6]^u8;
    var to_storage:   [6]^u8;
    fill_pattern[u8](?from_storage[0], 6, 0x11);
    fill_pattern[u8](?to_storage[0], 6, 0x22);
    var from: Borrow;
    var to:   Borrow;
    if (!is_ok[u8](borrow_open(?from_storage[0], 6, ?from)))                                                              { ret 1; }
    if (!is_ok[u8](borrow_open(?to_storage[0], 6, ?to)))                                                                  { ret 2; }
    if (!is_ok[u8](borrow_copy(to, 1, from, 0, 3)))                                                                       { ret 3; }
    if (to_storage[0]:>u8 != 0x22 || to_storage[1]:>u8 != 0x11 || to_storage[3]:>u8 != 0x11 || to_storage[4]:>u8 != 0x22) { ret 4; }
    if (!refused_as[u8](borrow_copy(to, 4, from, 0, 3), io_error.INVALID))                                                { ret 5; }
    if (!refused_as[u8](borrow_copy(to, 0, from, 4, 3), io_error.INVALID))                                                { ret 6; }
    if (!is_ok[u8](borrow_copy(to, 0, from, 0, 0)))                                                                       { ret 7; }
    if (!is_ok[u8](borrow_close(from)))                                                                                   { ret 8; }
    if (!refused_as[u8](borrow_copy(to, 0, from, 0, 1), io_error.CLOSED))                                                 { ret 9; }
    if (!is_ok[u8](borrow_close(to)))                                                                                     { ret 10; }
    ret 0;
}

test "std.memory.secret: positioned transfers retry interruptions and never touch the span" {
    var storage: [16]^u8;
    fill_pattern[u8](?storage[0], 16, 0x3c);
    var probe: PositionedProbe = PositionedProbe{
        calls: 0, file: 0, len: 0, offset: 0, saw_pattern: false, byte: 0x3c, result: 5, interrupt: 3,
    };
    if (!count_is[u8](positioned_all(?probe, 7, ?storage[4], 9, 1024, probe_positioned[u8], io_error.OP_READ), 5)) { ret 1; }
    if (probe.calls != 4 || probe.file != 7 || probe.len != 9 || probe.offset != 1024)                             { ret 2; }
    if (!probe.saw_pattern)                                                                                        { ret 3; }
    var i: usize = 0;
    for (i < 16) {
        if (storage[i]:>u8 != 0x3c) { ret 4; }
        i = i + 1;
    }

    var exhausted: PositionedProbe = PositionedProbe{
        calls: 0, file: 0, len: 0, offset: 0, saw_pattern: false, byte: 0x3c, result: 5, interrupt: INTERRUPT_MAX_RETRIES * 2,
    };
    if (!count_failed[u8](positioned_all(?exhausted, 7, ?storage[0], 16, 0, probe_positioned[u8], io_error.OP_READ), native_os.EINTR)) { ret 5; }
    if (exhausted.calls != INTERRUPT_MAX_RETRIES)                                                                                      { ret 6; }
    i = 0;
    for (i < 16) {
        if (storage[i]:>u8 != 0x3c) { ret 7; }
        i = i + 1;
    }

    var failing: PositionedProbe = PositionedProbe{
        calls: 0, file: 0, len: 0, offset: 0, saw_pattern: false, byte: 0x3c, result: native_os.EBADF, interrupt: 0,
    };
    if (!count_failed[u8](positioned_all(?failing, 7, ?storage[0], 16, 0, probe_positioned[u8], io_error.OP_WRITE), native_os.EBADF)) { ret 8; }
    if (failing.calls != 1 || !failing.saw_pattern)                                                                                   { ret 9; }
    i = 0;
    for (i < 16) {
        if (storage[i]:>u8 != 0x3c) { ret 10; }
        i = i + 1;
    }
    ret 0;
}

test "std.memory.secret: positioned transfers refuse dead handles and bad spans before the kernel" {
    var storage: [8]^u8;
    var handle:  Borrow;
    if (!is_ok[u8](borrow_open(?storage[0], 8, ?handle)))                                                          { ret 1; }
    if (!count_refused[u8](borrow_read_at(os.INVALID_HANDLE, handle, 4, 8, 0), io_error.INVALID))                  { ret 2; }
    if (!count_refused[u8](borrow_write_at(os.INVALID_HANDLE, handle, 0, 9, 0), io_error.INVALID))                 { ret 3; }
    if (!count_refused[u8](borrow_read_at(os.INVALID_HANDLE, handle, 0, 8, 0x8000000000000000), io_error.INVALID)) { ret 4; }
    if (!count_is[u8](borrow_read_at(os.INVALID_HANDLE, handle, 0, 0, 0), 0))                                      { ret 5; }
    if (!count_is[u8](borrow_write_at(os.INVALID_HANDLE, handle, 8, 0, 0), 0))                                     { ret 6; }
    if (!is_ok[u8](borrow_close(handle)))                                                                          { ret 7; }
    if (!count_refused[u8](borrow_read_at(os.INVALID_HANDLE, handle, 0, 8, 0), io_error.CLOSED))                   { ret 8; }
    if (!count_refused[u8](borrow_write_at(os.INVALID_HANDLE, handle, 0, 8, 0), io_error.CLOSED))                  { ret 9; }
    ret 0;
}

# a fill larger than one native chunk is delivered in full and is not all
# zero, through the same chunking the native bound imposes
test "std.memory.secret: multi-chunk fill delivers every byte" {
    val size: usize = 700;
    val data: *^u8  = allocate(size);
    if (data == nil) { ret 1; }
    if (all_zero[u8](data, size) == 0) {
        deallocate(data, size);
        ret 2;
    }
    if (!is_ok[u8](random_fill(data, size))) {
        deallocate(data, size);
        ret 3;
    }
    var nonzero: usize = 0;
    var i:       usize = 0;
    for (i < size) {
        if (data[i]:>u8 != 0) { nonzero = nonzero + 1; }
        i = i + 1;
    }
    val released: err[io_error.Error] = deallocate(data, size);
    if (nonzero < size / 2)   { ret 4; }
    if (!is_ok[u8](released)) { ret 5; }
    ret 0;
}
