# secret-welded storage: allocation and borrows
#
# every pointer here keeps its welded shape. the native work is the os
# contract's secret primitives: this module adds the wipe before release,
# typed geometry, the borrow table, and the policy for a host that cannot lock
# pages. it needs the pages capability alone. filling welded storage from the
# system's entropy is std.crypto.rand.fill_secret, and positioned file
# transfers into and out of it are std.io.file.secret.
#
# storage stays typed *^u8 (or the exact *T for typed regions) across the whole
# native boundary, with no public pointer or integer alias to the bytes. linux
# uses direct syscalls, darwin libSystem, windows the virtual-memory apis, and
# wasi fresh pages of linear memory.
#
# every allocation is locked against paging, sits between two inaccessible
# guard pages, and is kept out of core dumps where the host can say so (linux
# does, through memfd_secret or MADV_DONTDUMP. darwin and windows have no
# per-allocation exclusion). a host that refuses the lock fails the allocation
# with io_error.OP_LOCK as its operation, never a silent unlocked fallback. a
# host whose contract cannot lock at all (std.system.os.SECRET_LOCKS false)
# serves secret storage only after the program calls accept_unlocked.
#
# allocation returns zero-filled storage aligned to at least ALIGN. release
# wipes the whole logical span before the native release and reports success
# only once the original allocation is gone. (nil, 0) is a successful no-op,
# and a failed release leaves zeroed storage owned by the caller. a refused
# release writes nothing, since the span it was given is exactly what failed
# validation, and the caller keeps live, unwiped storage.
#
# typed allocation checks the complete count * $size_of(T) geometry and honours
# $align_of(T), over-aligned records included. typed release needs the original
# count, validates the stored geometry, and wipes every byte of every element,
# padding included. the header is found through the caller's pointer, so a
# refusal cannot prove any span is std's and wipes none of it.
#
# the ^ qualifier enforces secret data flow. none of this isolates storage
# across process creation or resists a debugger with process access.

use std.crypto.ct;
use io_error: std.io.error;
use std.sync.atomic;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

$if (capability.HAS_PAGES) {
    use std.system.os;
}
$or {
    $error("std.memory.secret needs the pages capability (std.system.capability.HAS_PAGES)");
}

val TYPED_HEADER_WORDS: usize = 3;
val TYPED_HEADER_SIZE:  usize = TYPED_HEADER_WORDS * $size_of(usize);

# providers return zero or a negative native code
def ReleaseFun: fun(ptr, *^u8, usize) i64;

rec TypedAllocation[T] {
    base:  *T;
    total: usize;
    count: usize;
}

fun refused(kind: io_error.Kind, operation: io_error.Operation) err[io_error.Error] {
    ret err[io_error.Error].err{io_error.make(kind, operation)};
}

fun native(code: i64, operation: io_error.Operation) err[io_error.Error] {
    ret err[io_error.Error].err{os.error(code, operation)};
}

fun free_all(context: ptr, data: *^u8, size: usize, release_fn: ReleaseFun) err[io_error.Error] {
    if (data == nil && size == 0) { ret err[io_error.Error].ok{}; }
    if (data == nil || size == 0) { ret refused(io_error.INVALID, io_error.OP_CLOSE); }
    ct.zeroize(data, size);
    val released: i64 = release_fn(context, data, size);
    if (released < 0) { ret native(released, io_error.OP_CLOSE); }
    ret err[io_error.Error].ok{};
}

# every byte of every element, padding included
fun wipe_typed[T](data: *T, count: usize) {
    $zeroize(data, count);
}

fun typed_total[T](count: usize, total: *usize, alignment: *usize) bool {
    if (count == 0 || $size_of(T) == 0)    { ret false; }
    if (count > ~(0::usize) / $size_of(T)) { ret false; }

    var align: usize = $align_of(T);
    if (align < $size_of(usize)) { align = $size_of(usize); }
    val bytes: usize = $size_of(T) * count;
    if (bytes > ~(0::usize) - TYPED_HEADER_SIZE) { ret false; }
    val with_header: usize = bytes + TYPED_HEADER_SIZE;
    if (with_header > ~(0::usize) - (align - 1)) { ret false; }
    @total     = with_header + align - 1;
    @alignment = align;
    ret true;
}

# whether a typed pointer sits on an alignment boundary, read without turning
# the address into an integer the secrecy rules would refuse
# ---
# alignment: a power of two
pub fun typed_aligned[T](data: *T, alignment: usize) bool {
    var remainder: usize = 1;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {data}
            mov rcx, {alignment}
            dec rcx
            and rax, rcx
            mov {remainder}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x0, {data}
            ldr x1, {alignment}
            sub x1, x1, 1
            and x0, x0, x1
            str x0, {remainder}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            ld t0, {data}
            ld t1, {alignment}
            addi t1, t1, -1
            and t0, t0, t1
            sd t0, {remainder}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        asm rv32i {
            lw t0, {data}
            lw t1, {alignment}
            addi t1, t1, -1
            and t0, t0, t1
            sw t0, {remainder}
        }
    }
    $or ($mach.build.arch == $mach.arch.wasm32) {
        asm mvp {
            local.get {remainder}
            local.get {data}
            i32.load
            local.get {alignment}
            i32.load
            i32.const 1
            i32.sub
            i32.and
            i32.store
        }
    }
    ret remainder == 0;
}

fun align_typed[T](base: *T, total: usize, alignment: usize, count: usize) *T {
    var out:    *T    = nil;
    val header: usize = TYPED_HEADER_SIZE;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {base}
            mov rcx, {alignment}
            mov rdx, {header}
            add rax, rdx
            mov r8, rcx
            dec r8
            add rax, r8
            neg rcx
            and rax, rcx
            mov r8, rax
            sub r8, rdx
            mov r9, {base}
            mov [r8], r9
            mov r9, {total}
            mov [r8 + 8], r9
            mov r9, {count}
            mov [r8 + 16], r9
            mov {out}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x0, {base}
            ldr x1, {alignment}
            ldr x2, {header}
            add x3, x0, x2
            sub x4, x1, 1
            add x3, x3, x4
            sub x4, xzr, x1
            and x3, x3, x4
            sub x4, x3, x2
            str x0, [x4]
            ldr x5, {total}
            str x5, [x4, 8]
            ldr x5, {count}
            str x5, [x4, 16]
            str x3, {out}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            ld t0, {base}
            ld t1, {alignment}
            ld t2, {header}
            add t3, t0, t2
            addi t4, t1, -1
            add t3, t3, t4
            sub t4, zero, t1
            and t3, t3, t4
            sub t4, t3, t2
            sd t0, 0(t4)
            ld t5, {total}
            sd t5, 8(t4)
            ld t5, {count}
            sd t5, 16(t4)
            sd t3, {out}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        asm rv32i {
            lw t0, {base}
            lw t1, {alignment}
            lw t2, {header}
            add t3, t0, t2
            addi t4, t1, -1
            add t3, t3, t4
            sub t4, zero, t1
            and t3, t3, t4
            sub t4, t3, t2
            sw t0, 0(t4)
            lw t5, {total}
            sw t5, 4(t4)
            lw t5, {count}
            sw t5, 8(t4)
            sw t3, {out}
        }
    }
    $or ($mach.build.arch == $mach.arch.wasm32) {
        asm mvp {
            local.get {out}
            local.get {base}
            i32.load
            local.get {header}
            i32.load
            i32.add
            local.get {alignment}
            i32.load
            i32.const 1
            i32.sub
            i32.add
            i32.const 0
            local.get {alignment}
            i32.load
            i32.sub
            i32.and
            i32.store
            local.get {out}
            i32.load
            local.get {header}
            i32.load
            i32.sub
            local.get {base}
            i32.load
            i32.store
            local.get {out}
            i32.load
            local.get {header}
            i32.load
            i32.sub
            i32.const 4
            i32.add
            local.get {total}
            i32.load
            i32.store
            local.get {out}
            i32.load
            local.get {header}
            i32.load
            i32.sub
            i32.const 8
            i32.add
            local.get {count}
            i32.load
            i32.store
        }
    }
    ret out;
}

fun typed_allocation[T](data: *T) TypedAllocation[T] {
    var base:   *T    = nil;
    var total:  usize = 0;
    var count:  usize = 0;
    val header: usize = TYPED_HEADER_SIZE;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64 {
            mov rax, {data}
            sub rax, {header}
            mov rcx, [rax]
            mov {base}, rcx
            mov rcx, [rax + 8]
            mov {total}, rcx
            mov rcx, [rax + 16]
            mov {count}, rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm armv8-a {
            ldr x0, {data}
            ldr x1, {header}
            sub x0, x0, x1
            ldr x1, [x0]
            str x1, {base}
            ldr x1, [x0, 8]
            str x1, {total}
            ldr x1, [x0, 16]
            str x1, {count}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm rv64i {
            ld t0, {data}
            ld t1, {header}
            sub t0, t0, t1
            ld t1, 0(t0)
            sd t1, {base}
            ld t1, 8(t0)
            sd t1, {total}
            ld t1, 16(t0)
            sd t1, {count}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        asm rv32i {
            lw t0, {data}
            lw t1, {header}
            sub t0, t0, t1
            lw t1, 0(t0)
            sw t1, {base}
            lw t1, 4(t0)
            sw t1, {total}
            lw t1, 8(t0)
            sw t1, {count}
        }
    }
    $or ($mach.build.arch == $mach.arch.wasm32) {
        asm mvp {
            local.get {base}
            local.get {data}
            i32.load
            local.get {header}
            i32.load
            i32.sub
            i32.load
            i32.store
            local.get {total}
            local.get {data}
            i32.load
            local.get {header}
            i32.load
            i32.sub
            i32.const 4
            i32.add
            i32.load
            i32.store
            local.get {count}
            local.get {data}
            i32.load
            local.get {header}
            i32.load
            i32.sub
            i32.const 8
            i32.add
            i32.load
            i32.store
        }
    }
    ret TypedAllocation[T]{base: base, total: total, count: count};
}

fun free_typed[T](context: ptr, data: *T, count: usize,
    release_fn: fun(ptr, *T, *T, usize) i64) err[io_error.Error] {
    if (data == nil && count == 0)                     { ret err[io_error.Error].ok{}; }
    if (data == nil || count == 0 || $size_of(T) == 0) { ret refused(io_error.INVALID, io_error.OP_CLOSE); }
    var expected_total: usize = 0;
    var alignment:      usize = 0;
    if (!typed_total[T](count, ?expected_total, ?alignment) ||
        !typed_aligned[T](data, alignment)) { ret refused(io_error.INVALID, io_error.OP_CLOSE); }
    val allocation: TypedAllocation[T] = typed_allocation[T](data);
    if (allocation.base == nil || allocation.total != expected_total ||
        allocation.count != count) { ret refused(io_error.INVALID, io_error.OP_CLOSE); }
    wipe_typed[T](data, count);
    val released: i64 = release_fn(context, data, allocation.base, allocation.total);
    if (released < 0) { ret native(released, io_error.OP_CLOSE); }
    ret err[io_error.Error].ok{};
}

fun native_free(context: ptr, data: *^u8, size: usize) i64 {
    ret os.free_secret(data, size);
}

fun native_free_typed[T](context: ptr, data: *T, base: *T, size: usize) i64 {
    ret os.free_secret_typed[T](base, size);
}

# the alignment every allocation starts on, whatever its size
pub val ALIGN: usize = os.SECRET_ALIGN;

var _accept_unlocked: i64 = 0;

# accept secret storage the host cannot lock, on a host whose contract says it
# cannot (std.system.os.SECRET_LOCKS false). until a program calls this, such a
# host refuses every allocation as UNSUPPORTED with operation OP_LOCK. on a host
# that locks, a refused lock still fails the allocation: this never downgrades
# it
pub fun accept_unlocked() {
    atomic.store(?_accept_unlocked, 1);
}

# whether this host may serve secret storage under the program's policy
fun policy_allows() bool {
    $if (os.SECRET_LOCKS) {
        ret true;
    }
    $or {
        ret atomic.load(?_accept_unlocked) != 0;
    }
}

# the error for a failed native allocation. a refused lock keeps its native
# code but reads as the refusal it is, never as a retryable WOULD_BLOCK
fun allocation_failed(status: os.SecretStatus) err[io_error.Error] {
    if (!status.lock) { ret native(status.code, io_error.OP_CREATE); }
    var kind: io_error.Kind = io_error.RESOURCE_EXHAUSTED;
    if (os.error_kind(status.code) == io_error.PERMISSION) { kind = io_error.PERMISSION; }
    ret err[io_error.Error].err{io_error.Error{kind: kind, code: status.code, operation: io_error.OP_LOCK, cleanup_code: 0}};
}

# allocate one zero-initialized secret-welded byte region
# ---
# size: number of addressable bytes
# out:  receives the logical span owner, nil for zero size, untouched on
#       failure
# ret:  ok, or the refusal: INVALID for a nil out, UNSUPPORTED with OP_LOCK on
#       a host that cannot lock before accept_unlocked, the host's lock refusal
#       with OP_LOCK, or the native mapping error
pub fun allocate(size: usize, out: **^u8) err[io_error.Error] {
    if (out == nil) { ret refused(io_error.INVALID, io_error.OP_CREATE); }
    if (size == 0) {
        @out = nil;
        ret err[io_error.Error].ok{};
    }
    if (!policy_allows()) { ret refused(io_error.UNSUPPORTED, io_error.OP_LOCK); }
    val status: os.SecretStatus = os.allocate_secret(size, out);
    if (status.code < 0) { ret allocation_failed(status); }
    ret err[io_error.Error].ok{};
}

# wipe and release one secret-welded byte region
# ---
# data: allocation returned by allocate
# size: original nonzero allocation size
# ret:  ok after the wipe and release. INVALID for a nil data or zero size
#       (not both), with nothing written and the caller still owning any
#       storage unwiped. otherwise the native error, with the storage wiped
#       and still owned by the caller
pub fun deallocate(data: *^u8, size: usize) err[io_error.Error] {
    ret free_all(nil, data, size, native_free);
}

# allocate a zero-initialized typed region without changing T's secrecy shape
# ---
# count: number of T values
# out:   receives the aligned typed owner, nil for zero count, untouched on
#        failure
# ret:   ok, or the refusal: INVALID for a nil out or a zero-sized T, RANGE
#        for a count whose geometry overflows, and otherwise as allocate
pub fun allocate_typed[T](count: usize, out: **T) err[io_error.Error] {
    if (out == nil) { ret refused(io_error.INVALID, io_error.OP_CREATE); }
    if (count == 0) {
        @out = nil;
        ret err[io_error.Error].ok{};
    }
    if ($size_of(T) == 0) { ret refused(io_error.INVALID, io_error.OP_CREATE); }
    var total:     usize = 0;
    var alignment: usize = 0;
    if (!typed_total[T](count, ?total, ?alignment)) { ret refused(io_error.RANGE, io_error.OP_CREATE); }
    if (!policy_allows())                           { ret refused(io_error.UNSUPPORTED, io_error.OP_LOCK); }
    ret map_typed[T](total, alignment, count, out);
}

# map a typed region of a geometry typed_total accepted, whatever the policy
fun map_typed[T](total: usize, alignment: usize, count: usize, out: **T) err[io_error.Error] {
    var base:   *T              = nil;
    val status: os.SecretStatus = os.allocate_secret_typed[T](total, ?base);
    if (status.code < 0) { ret allocation_failed(status); }
    @out = align_typed[T](base, total, alignment, count);
    ret err[io_error.Error].ok{};
}

# wipe and release a typed region without changing T's secrecy shape
# ---
# data:  allocation returned by allocate_typed[T]
# count: original element count
# ret:   ok after the wipe and release. INVALID for a nil data or zero count
#        (not both), a zero-sized T, an overflowing count, a misaligned data,
#        or a header that does not match count, with nothing written and the
#        caller still owning live, unwiped storage to release with the correct
#        count. otherwise the native error, with every element wiped and the
#        storage still owned by the caller
pub fun deallocate_typed[T](data: *T, count: usize) err[io_error.Error] {
    ret free_typed[T](nil, data, count, native_free_typed[T]);
}

# borrows: welded storage lent to a public integer handle
#
# a `*^u8` can never be erased to `ptr`, so no worker task, runtime source or
# cancellation registration (all `ptr` contexts) can carry one. a borrow is the
# boundary's answer: the owner lends its welded storage to this table and gets
# back an index-and-generation handle that is not an address, cannot be
# dereferenced, and unlocks only secret-to-secret copies, wipes and positioned
# kernel transfers. the native pointer leaves the process exactly once, in
# std.io.file.secret's positioned borrow transfers, as the argument of the
# contract's secret positioned transfer. nothing here yields a `*u8`.
#
# the table is process-wide and typed: its entries hold `*^u8`, so it lives in
# its own secret-typed allocation and grows by doubling. a closed entry joins
# a free list linked through its public `next_free`, and entries never handed
# out sit above a high-water mark, so an open finds its entry in constant time.
# a handle carries its index in a u32, so the table stops growing at the last
# index a u32 holds: past it a truncated index would name another live entry.
# the lock guards the table only; a handle's owner serializes its use against
# its close, the same way a descriptor's owner does.

pub rec Borrow {
    index:      u32;
    generation: u32;
}

rec BorrowEntry {
    data:       *^u8;
    size:       usize;
    next_free:  usize;
    generation: u32;
    used:       bool;
}

val BORROW_INITIAL_CAPACITY: usize = 16;
val BORROW_NO_FREE:          usize = ~(0::usize);
val BORROW_CAPACITY_MAX:     usize = (~(0::u32))::usize;

var _borrow_entries:  *BorrowEntry = nil;
var _borrow_capacity: usize        = 0;
var _borrow_fresh:    usize        = 0;
var _borrow_free:     usize        = BORROW_NO_FREE;
var _borrow_lock:     i64          = 0;

fun borrow_lock() {
    var expected: i64 = 0;
    for (!atomic.cas(?_borrow_lock, ?expected, 1)) { expected = 0; }
}

fun borrow_unlock() {
    atomic.store(?_borrow_lock, 0);
}

#[constant_time("soft")]
fun copy_secret(destination: *^u8, source: *^u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        destination[i] = source[i];
        i              = i + 1;
    }
}

fun borrow_grow() bool {
    if (_borrow_capacity >= BORROW_CAPACITY_MAX) { ret false; }
    var next: usize = BORROW_INITIAL_CAPACITY;
    if (_borrow_capacity != 0) {
        next = BORROW_CAPACITY_MAX;
        if (_borrow_capacity <= BORROW_CAPACITY_MAX / 2) { next = _borrow_capacity * 2; }
    }
    var total:     usize = 0;
    var alignment: usize = 0;
    if (!typed_total[BorrowEntry](next, ?total, ?alignment)) { ret false; }
    # entries hold addresses and sizes, never a secret, so a host that cannot
    # lock serves the table without the program's acceptance
    var fresh:    *BorrowEntry        = nil;
    val err_made: err[io_error.Error] = map_typed[BorrowEntry](total, alignment, next, ?fresh);
    if (sel err_made.err) { ret false; }
    var i: usize = 0;
    for (i < _borrow_capacity) {
        fresh[i] = _borrow_entries[i];
        i        = i + 1;
    }
    val previous:          *BorrowEntry = _borrow_entries;
    val previous_capacity: usize        = _borrow_capacity;
    _borrow_entries  = fresh;
    _borrow_capacity = next;
    if (previous != nil) { deallocate_typed[BorrowEntry](previous, previous_capacity); }
    ret true;
}

fun borrow_entry_locked(borrow: Borrow) *BorrowEntry {
    if (borrow.index::usize >= _borrow_capacity) { ret nil; }
    val entry: *BorrowEntry = ?_borrow_entries[borrow.index::usize];
    if (!entry.used || entry.generation != borrow.generation) { ret nil; }
    ret entry;
}

# resolve a span inside a live borrow
#
# the pointer stays valid until the owner closes the borrow, the same lifetime
# borrow_data has
# ---
# data:      receives the span's first byte, untouched on failure
# operation: the operation an error names
# ret:       ok, CLOSED for a handle that is not live, INVALID for a span
#            outside the borrow
pub fun borrow_span(borrow: Borrow, offset: usize, len: usize, data: **^u8, operation: io_error.Operation) err[io_error.Error] {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    if (entry == nil) {
        borrow_unlock();
        ret refused(io_error.CLOSED, operation);
    }
    if (offset > entry.size || len > entry.size - offset) {
        borrow_unlock();
        ret refused(io_error.INVALID, operation);
    }
    @data = ?entry.data[offset];
    borrow_unlock();
    ret err[io_error.Error].ok{};
}

# lend welded storage to a handle
# ---
# data: the storage, which stays owned by and valid for the caller until close
# size: nonzero span length
# out:  the handle
# ret:  ok, INVALID for nil or empty storage or a nil out, RESOURCE_EXHAUSTED
#       when the table cannot grow, at the latest once every u32 index is live
pub fun borrow_acquire(data: *^u8, size: usize, out: *Borrow) err[io_error.Error] {
    if (out == nil || data == nil || size == 0) { ret refused(io_error.INVALID, io_error.OP_OPEN); }
    borrow_lock();
    var index: usize = _borrow_free;
    if (index != BORROW_NO_FREE) {
        _borrow_free = _borrow_entries[index].next_free;
    }
    or {
        if (_borrow_fresh == _borrow_capacity && !borrow_grow()) {
            borrow_unlock();
            ret refused(io_error.RESOURCE_EXHAUSTED, io_error.OP_OPEN);
        }
        index         = _borrow_fresh;
        _borrow_fresh = _borrow_fresh + 1;
    }
    val entry:      *BorrowEntry = ?_borrow_entries[index];
    var generation: u32          = entry.generation + 1;
    if (generation == 0) { generation = 1; }
    entry.data       = data;
    entry.size       = size;
    entry.generation = generation;
    entry.used       = true;
    borrow_unlock();
    @out = Borrow{index: index::u32, generation: generation};
    ret err[io_error.Error].ok{};
}

# return a borrow; the storage is neither wiped nor released, it was never owned
# ---
# ret: ok, or CLOSED for a handle that is not live
pub fun borrow_release(borrow: Borrow) err[io_error.Error] {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    if (entry == nil) {
        borrow_unlock();
        ret refused(io_error.CLOSED, io_error.OP_CLOSE);
    }
    entry.data      = nil;
    entry.size      = 0;
    entry.used      = false;
    entry.next_free = _borrow_free;
    _borrow_free    = borrow.index::usize;
    borrow_unlock();
    ret err[io_error.Error].ok{};
}

# the span length of a live borrow, or zero
pub fun borrow_size(borrow: Borrow) usize {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    var size:  usize        = 0;
    if (entry != nil) { size = entry.size; }
    borrow_unlock();
    ret size;
}

# the welded storage of a live borrow, or nil
#
# the pointer stays valid until the owner closes the borrow, the same lifetime
# the positioned transfers rely on
pub fun borrow_data(borrow: Borrow) *^u8 {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    var data:  *^u8         = nil;
    if (entry != nil) { data = entry.data; }
    borrow_unlock();
    ret data;
}

# zero a span of a borrow
# ---
# ret: ok, CLOSED for a dead handle, INVALID for a span outside the borrow
pub fun borrow_wipe(borrow: Borrow, offset: usize, len: usize) err[io_error.Error] {
    var data:         *^u8                = nil;
    val err_resolved: err[io_error.Error] = borrow_span(borrow, offset, len, ?data, io_error.OP_WRITE);
    if (sel err_resolved.err) { ret err_resolved; }
    ct.zeroize(data, len);
    ret err[io_error.Error].ok{};
}

# copy welded bytes into a span of a borrow
# ---
# source: welded storage the caller can read
# ret:    ok, CLOSED, or INVALID for a span outside the borrow or a nil source
pub fun borrow_fill(borrow: Borrow, offset: usize, source: *^u8, len: usize) err[io_error.Error] {
    if (len == 0)      { ret err[io_error.Error].ok{}; }
    if (source == nil) { ret refused(io_error.INVALID, io_error.OP_WRITE); }
    var data:         *^u8                = nil;
    val err_resolved: err[io_error.Error] = borrow_span(borrow, offset, len, ?data, io_error.OP_WRITE);
    if (sel err_resolved.err) { ret err_resolved; }
    copy_secret(data, source, len);
    ret err[io_error.Error].ok{};
}

# copy welded bytes out of a span of a borrow
# ---
# destination: welded storage the caller owns
# ret:         ok, CLOSED, or INVALID for a span outside the borrow or a nil destination
pub fun borrow_drain(borrow: Borrow, offset: usize, destination: *^u8, len: usize) err[io_error.Error] {
    if (len == 0)           { ret err[io_error.Error].ok{}; }
    if (destination == nil) { ret refused(io_error.INVALID, io_error.OP_READ); }
    var data:         *^u8                = nil;
    val err_resolved: err[io_error.Error] = borrow_span(borrow, offset, len, ?data, io_error.OP_READ);
    if (sel err_resolved.err) { ret err_resolved; }
    copy_secret(destination, data, len);
    ret err[io_error.Error].ok{};
}

# copy between two borrows without either pointer leaving the boundary
# ---
# ret: ok, CLOSED for a dead handle, INVALID for a span outside either borrow
pub fun borrow_copy(destination: Borrow, destination_offset: usize, source: Borrow, source_offset: usize, len: usize) err[io_error.Error] {
    if (len == 0) { ret err[io_error.Error].ok{}; }
    var to:              *^u8                = nil;
    val err_to_resolved: err[io_error.Error] = borrow_span(destination, destination_offset, len, ?to, io_error.OP_WRITE);
    if (sel err_to_resolved.err) { ret err_to_resolved; }
    var from:              *^u8                = nil;
    val err_from_resolved: err[io_error.Error] = borrow_span(source, source_offset, len, ?from, io_error.OP_READ);
    if (sel err_from_resolved.err) { ret err_from_resolved; }
    copy_secret(to, from, len);
    ret err[io_error.Error].ok{};
}

$if ($mach.build.sys == $mach.sys.linux) {
    use native_os: std.system.os.linux;
}
$or ($mach.build.sys == $mach.sys.darwin) {
    use native_os: std.system.os.darwin;
}
$or ($mach.build.sys == $mach.sys.windows) {
    use native_os: std.system.os.windows;
}
$or ($mach.build.sys == $mach.sys.wasi) {
    use native_os: std.system.os.wasi;
}

# generic fixtures instantiate only in test builds
#[testing]
fun is_ok[T](result: err[io_error.Error]) bool {
    ret sel result.ok;
}

#[testing]
fun refused_as[T](result: err[io_error.Error], kind: io_error.Kind) bool {
    if (sel result.err) { ret result.err.kind == kind && result.err.code == 0; }
    ret false;
}

#[testing]
fun failed_natively[T](result: err[io_error.Error], code: i64) bool {
    ret sel result.err && result.err.code == code;
}

#[testing]
fun all_zero[T](data: *^u8, len: usize) i64 {
    var i: usize = 0;
    for (i < len) {
        if (data[i]:>u8 != 0) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

#[testing]
rec ReleaseProbe {
    calls:    usize;
    saw_zero: i64;
    result:   i64;
}

#[testing]
fun probe_free[T](context: ptr, data: *^u8, size: usize) i64 {
    val probe: *ReleaseProbe = context::*ReleaseProbe;
    probe.calls    = probe.calls + 1;
    probe.saw_zero = all_zero[T](data, size);
    ret probe.result;
}

# an allocation's storage for a test, nil on any refusal
#[testing]
fun allocated(size: usize) *^u8 {
    var data:     *^u8                = nil;
    val err_made: err[io_error.Error] = allocate(size, ?data);
    if (sel err_made.err) { ret nil; }
    ret data;
}

#[testing]
fun allocated_typed[T](count: usize) *T {
    var data:     *T                  = nil;
    val err_made: err[io_error.Error] = allocate_typed[T](count, ?data);
    if (sel err_made.err) { ret nil; }
    ret data;
}

# nil and empty requests are guarded, and allocation is zeroed
test lifecycle__guards_and_zeroed_allocation {
    # a host that cannot lock serves secret storage only once accepted, and locking is not what this checks
    accept_unlocked();
    if (allocated(0) != nil)                                   { ret 1; }
    if (!is_ok[u8](deallocate(nil, 0)))                        { ret 1; }
    if (!refused_as[u8](deallocate(nil, 1), io_error.INVALID)) { ret 1; }

    val size: usize = 700;
    val data: *^u8  = allocated(size);
    if (data == nil) { ret 2; }
    var failed: i32 = 0;
    if (all_zero[u8](data, size) == 0)                          { failed = 3; }
    if (!refused_as[u8](deallocate(data, 0), io_error.INVALID)) { failed = 4; }
    if (!is_ok[u8](deallocate(data, size)))                     { ret 5; }
    ret failed;
}

test release__wipes_before_success_or_failure {
    var data:   [4]^u8       = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var failed: ReleaseProbe = ReleaseProbe{calls: 0, saw_zero: 0, result: native_os.EIO};
    if (!failed_natively[u8](free_all(?failed, ?data[0], 4, probe_free[u8]), native_os.EIO) ||
        failed.calls != 1 || failed.saw_zero == 0 || all_zero[u8](?data[0], 4) == 0) {
        ret 1;
    }

    data = [4]^u8{0x5A, 0x5A, 0x5A, 0x5A};
    var succeeded: ReleaseProbe = ReleaseProbe{calls: 0, saw_zero: 0, result: 0};
    if (!is_ok[u8](free_all(?succeeded, ?data[0], 4, probe_free[u8])) ||
        succeeded.calls != 1 || succeeded.saw_zero == 0) { ret 1; }
    ret 0;
}

# generic fixtures instantiate only in test builds
rec TypedSecretLeaf {
    value: ^u64;
}

#[testing]
rec TypedSecretRecord {
    public: u64;
    nested: TypedSecretLeaf;
}

#[align(8192)]
#[testing]
rec OverAlignedSecretRecord {
    public: u64;
    secret: ^u64;
}

#[testing]
rec TypedReleaseProbe {
    calls:    usize;
    saw_zero: bool;
    result:   i64;
}

#[testing]
fun probe_typed_free[T](context: ptr, data: *TypedSecretRecord,
    base: *TypedSecretRecord, size: usize) i64 {
    val probe: *TypedReleaseProbe = context::*TypedReleaseProbe;
    probe.calls    = probe.calls + 1;
    probe.saw_zero = data[0].public == 0 && data[0].nested.value:>u64 == 0 &&
        data[1].public == 0 && data[1].nested.value:>u64 == 0;
    ret probe.result;
}

# a deeply secret record comes back zeroed at its natural alignment, and an
# explicit over-alignment is honoured
test allocate_typed__zeroed_and_aligned {
    # a host that cannot lock serves secret storage only once accepted, and locking is not what this checks
    accept_unlocked();
    val data: *TypedSecretRecord = allocated_typed[TypedSecretRecord](2);
    if (data == nil || !typed_aligned[TypedSecretRecord](data,
        $align_of(TypedSecretRecord))) { ret 1; }
    var i: usize = 0;
    for (i < 2) {
        if (data[i].public != 0 || data[i].nested.value:>u64 != 0) { ret 2; }
        data[i].public       = (i + 21)::u64;
        data[i].nested.value = 32;
        i                    = i + 1;
    }
    if (!is_ok[u8](deallocate_typed[TypedSecretRecord](data, 2))) { ret 3; }

    val wide: *OverAlignedSecretRecord = allocated_typed[OverAlignedSecretRecord](2);
    if (wide == nil || !typed_aligned[OverAlignedSecretRecord](wide, 8192)) { ret 4; }
    if (wide[0].public != 0 || wide[0].secret:>u64 != 0 ||
        wide[1].public != 0 || wide[1].secret:>u64 != 0) { ret 5; }
    wide[1].public = 41;
    wide[1].secret = 42;
    if (!is_ok[u8](deallocate_typed[OverAlignedSecretRecord](wide, 2))) { ret 6; }
    ret 0;
}

test allocate_typed__rejects_empty_and_overflowing_counts {
    if (allocated_typed[u64](0) != nil)                                   { ret 1; }
    if (!is_ok[u8](deallocate_typed[u64](nil, 0)))                        { ret 1; }
    if (!refused_as[u8](deallocate_typed[u64](nil, 1), io_error.INVALID)) { ret 1; }
    if (allocated_typed[u64](~(0::usize) / $size_of(u64) + 1) != nil) {
        ret 1;
    }
    if (allocated_typed[u8](~(0::usize)) != nil) { ret 1; }
    ret 0;
}

test release_typed__validates_count_and_retains_wiped_failures {
    # a host that cannot lock serves secret storage only once accepted, and locking is not what this checks
    accept_unlocked();
    val data: *TypedSecretRecord = allocated_typed[TypedSecretRecord](2);
    if (data == nil) { ret 1; }
    data[0].public       = 51;
    data[0].nested.value = 52;
    data[1].public       = 53;
    data[1].nested.value = 54;

    if (!refused_as[u8](deallocate_typed[TypedSecretRecord](data, 1), io_error.INVALID)) { ret 2; }
    if (data[0].public != 51 || data[0].nested.value:>u64 != 52 ||
        data[1].public != 53 || data[1].nested.value:>u64 != 54) { ret 3; }

    var probe: TypedReleaseProbe = TypedReleaseProbe{
        calls: 0, saw_zero: false, result: native_os.EIO,
    };
    if (!failed_natively[u8](free_typed[TypedSecretRecord](?probe, data, 2,
        probe_typed_free[u8]), native_os.EIO)) { ret 4; }
    if (probe.calls != 1) { ret 5; }
    if (!probe.saw_zero)  { ret 6; }
    if (data[0].public != 0 || data[0].nested.value:>u64 != 0 ||
        data[1].public != 0 || data[1].nested.value:>u64 != 0) { ret 7; }
    if (!is_ok[u8](deallocate_typed[TypedSecretRecord](data, 2))) { ret 8; }
    ret 0;
}

#[testing]
fun borrow_all_zero[T](borrow: Borrow, offset: usize, len: usize) i64 {
    var data: *^u8 = nil;
    if (!is_ok[u8](borrow_span(borrow, offset, len, ?data, io_error.OP_READ))) { ret -1; }
    ret all_zero[T](data, len);
}

#[testing]
fun fill_pattern[T](data: *^u8, len: usize, byte: u8) {
    var i: usize = 0;
    for (i < len) {
        data[i] = byte;
        i       = i + 1;
    }
}

test borrow__lends_welded_storage_to_handles {
    var handle: Borrow;
    if (!refused_as[u8](borrow_acquire(nil, 8, ?handle), io_error.INVALID)) { ret 1; }
    var storage: [8]^u8;
    if (!refused_as[u8](borrow_acquire(?storage[0], 0, ?handle), io_error.INVALID)) { ret 2; }
    if (!refused_as[u8](borrow_acquire(?storage[0], 8, nil), io_error.INVALID))     { ret 3; }
    if (!is_ok[u8](borrow_acquire(?storage[0], 8, ?handle)))                        { ret 4; }
    if (borrow_size(handle) != 8)                                                   { ret 5; }
    fill_pattern[u8](?storage[0], 8, 0x5a);
    var mirror: [8]^u8;
    if (!is_ok[u8](borrow_drain(handle, 0, ?mirror[0], 8))) { ret 6; }
    var i: usize = 0;
    for (i < 8) {
        if (mirror[i]:>u8 != 0x5a) { ret 7; }
        i = i + 1;
    }
    fill_pattern[u8](?mirror[0], 8, 0xa5);
    if (!is_ok[u8](borrow_fill(handle, 2, ?mirror[0], 4)))                                                    { ret 8; }
    if (storage[1]:>u8 != 0x5a || storage[2]:>u8 != 0xa5 || storage[5]:>u8 != 0xa5 || storage[6]:>u8 != 0x5a) { ret 9; }
    if (!refused_as[u8](borrow_fill(handle, 6, ?mirror[0], 4), io_error.INVALID))                             { ret 10; }
    if (!is_ok[u8](borrow_drain(handle, 9, ?mirror[0], 0)))                                                   { ret 11; }
    if (!refused_as[u8](borrow_wipe(handle, 8, 1), io_error.INVALID))                                         { ret 12; }
    if (!is_ok[u8](borrow_wipe(handle, 2, 4)))                                                                { ret 13; }
    if (borrow_all_zero[u8](handle, 2, 4) != 1)                                                               { ret 14; }
    if (borrow_all_zero[u8](handle, 0, 8) != 0)                                                               { ret 15; }
    if (!is_ok[u8](borrow_release(handle)))                                                                   { ret 16; }
    if (!refused_as[u8](borrow_release(handle), io_error.CLOSED))                                             { ret 17; }
    if (borrow_size(handle) != 0)                                                                             { ret 18; }
    if (!refused_as[u8](borrow_wipe(handle, 0, 1), io_error.CLOSED))                                          { ret 19; }
    if (!refused_as[u8](borrow_fill(handle, 0, ?mirror[0], 1), io_error.CLOSED))                              { ret 20; }
    if (storage[0]:>u8 != 0x5a || storage[7]:>u8 != 0x5a)                                                     { ret 21; }
    ret 0;
}

test borrow__a_closed_handle_does_not_revive_with_its_slot {
    var first:  [4]^u8;
    var second: [4]^u8;
    var stale:  Borrow;
    if (!is_ok[u8](borrow_acquire(?first[0], 4, ?stale))) { ret 1; }
    if (!is_ok[u8](borrow_release(stale)))                { ret 2; }
    var fresh: Borrow;
    if (!is_ok[u8](borrow_acquire(?second[0], 4, ?fresh)))                  { ret 3; }
    if (fresh.index == stale.index && fresh.generation == stale.generation) { ret 4; }
    if (!refused_as[u8](borrow_wipe(stale, 0, 4), io_error.CLOSED))         { ret 5; }
    fill_pattern[u8](?second[0], 4, 3);
    var mirror: [4]^u8;
    if (!refused_as[u8](borrow_drain(stale, 0, ?mirror[0], 4), io_error.CLOSED)) { ret 6; }
    if (!is_ok[u8](borrow_drain(fresh, 0, ?mirror[0], 4)))                       { ret 7; }
    if (mirror[3]:>u8 != 3)                                                      { ret 8; }
    if (!is_ok[u8](borrow_release(fresh)))                                       { ret 9; }
    ret 0;
}

test borrow__table_grows_past_its_first_extent {
    # a host that cannot lock serves secret storage only once accepted, and locking is not what this checks
    accept_unlocked();
    val count:   usize = BORROW_INITIAL_CAPACITY * 2 + 3;
    val storage: *^u8  = allocated(count);
    if (storage == nil) { ret 1; }
    var handles: [64]Borrow;
    if (count > 64) {
        deallocate(storage, count);
        ret 2;
    }
    var i: usize = 0;
    for (i < count) {
        storage[i] = (i + 1)::u8;
        if (!is_ok[u8](borrow_acquire(?storage[i], 1, ?handles[i]))) {
            deallocate(storage, count);
            ret 3;
        }
        i = i + 1;
    }
    var mirror: [1]^u8;
    i = 0;
    for (i < count) {
        if (!is_ok[u8](borrow_drain(handles[i], 0, ?mirror[0], 1))) {
            deallocate(storage, count);
            ret 4;
        }
        if (mirror[0]:>u8 != (i + 1)::u8) {
            deallocate(storage, count);
            ret 5;
        }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        if (!is_ok[u8](borrow_release(handles[i]))) {
            deallocate(storage, count);
            ret 6;
        }
        i = i + 1;
    }
    if (!is_ok[u8](deallocate(storage, count))) { ret 7; }
    ret 0;
}

test borrow__copy_between_handles {
    var from_storage: [6]^u8;
    var to_storage:   [6]^u8;
    fill_pattern[u8](?from_storage[0], 6, 0x11);
    fill_pattern[u8](?to_storage[0], 6, 0x22);
    var from: Borrow;
    var to:   Borrow;
    if (!is_ok[u8](borrow_acquire(?from_storage[0], 6, ?from)))                                                           { ret 1; }
    if (!is_ok[u8](borrow_acquire(?to_storage[0], 6, ?to)))                                                               { ret 2; }
    if (!is_ok[u8](borrow_copy(to, 1, from, 0, 3)))                                                                       { ret 3; }
    if (to_storage[0]:>u8 != 0x22 || to_storage[1]:>u8 != 0x11 || to_storage[3]:>u8 != 0x11 || to_storage[4]:>u8 != 0x22) { ret 4; }
    if (!refused_as[u8](borrow_copy(to, 4, from, 0, 3), io_error.INVALID))                                                { ret 5; }
    if (!refused_as[u8](borrow_copy(to, 0, from, 4, 3), io_error.INVALID))                                                { ret 6; }
    if (!is_ok[u8](borrow_copy(to, 0, from, 0, 0)))                                                                       { ret 7; }
    if (!is_ok[u8](borrow_release(from)))                                                                                 { ret 8; }
    if (!refused_as[u8](borrow_copy(to, 0, from, 0, 1), io_error.CLOSED))                                                 { ret 9; }
    if (!is_ok[u8](borrow_release(to)))                                                                                   { ret 10; }
    ret 0;
}
