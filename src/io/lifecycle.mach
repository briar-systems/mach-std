# shared resource close and drain state

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.sync.mutex;

# every way a state transition can be refused
#
# the domain error tag for state machines: lifecycles and their attachments
# here, and the queued sinks, channels, pools and resolvers that later lanes
# migrate. a case names the fact that refused the transition; the receiver is
# left exactly as it was.
# ---
# invalid:   a nil receiver or an argument outside the closed set
# closed:    the owner has left the open state and admits no new work
# exhausted: a bounded counter or table is full
# active:    the object is already attached, registered or open
# inactive:  the object is not attached, registered or open
# stale:     the object belongs to an earlier generation of its owner
# busy:      outstanding work forbids the transition
pub tag StateError: u8 {
    invalid;
    closed;
    exhausted;
    active;
    inactive;
    stale;
    busy;
}

pub def State: u8;
pub val OPEN: State = 0;
pub val CLOSING: State = 1;
pub val CLOSED: State = 2;

pub def Mode: u8;
pub val GRACEFUL: Mode = 0;
pub val ABORTIVE: Mode = 1;

pub def Cause: u8;
pub val EXPLICIT: Cause = 0;
pub val PROCESS_TERMINATION: Cause = 1;
pub val DEADLINE: Cause = 2;
pub val CANCELLATION: Cause = 3;
pub val FAILURE: Cause = 4;

pub rec Lifecycle {
    state: State;
    mode: Mode;
    cause: Cause;
    terminal_cause: Cause;
    generation: u32;
    submitted: u64;
    settled: u64;
    lock: mutex.Mutex;
}

pub rec Attachment {
    owner: *Lifecycle;
    generation: u32;
    sequence: u64;
    active: bool;
}

pub rec Snapshot {
    state: State;
    mode: Mode;
    cause: Cause;
    terminal_cause: Cause;
    outstanding: usize;
}

pub rec CloseResult {
    started: bool;
    escalated: bool;
    complete: bool;
    snapshot: Snapshot;
}

fun snapshot_locked(lifecycle: *Lifecycle) Snapshot {
    ret Snapshot{
        state: lifecycle.state,
        mode: lifecycle.mode,
        cause: lifecycle.cause,
        terminal_cause: lifecycle.terminal_cause,
        outstanding: (lifecycle.submitted - lifecycle.settled)::usize,
    };
}

# initializes a lifecycle in place; the storage is address-bound from here on
pub fun make(lifecycle: *Lifecycle) err[StateError] {
    if (lifecycle == nil) { ret err[StateError].err{StateError.invalid{}}; }
    var generation: u32 = lifecycle.generation + 1;
    if (generation == 0) { generation = 1; }
    lifecycle.state = OPEN;
    lifecycle.mode = GRACEFUL;
    lifecycle.cause = EXPLICIT;
    lifecycle.terminal_cause = EXPLICIT;
    lifecycle.generation = generation;
    lifecycle.submitted = 0;
    lifecycle.settled = 0;
    lifecycle.lock = mutex.make();
    ret err[StateError].ok{};
}

# initializes an attachment in place against an open lifecycle; the attachment
# is address-bound until it settles
pub fun attach(lifecycle: *Lifecycle, attachment: *Attachment) err[StateError] {
    if (lifecycle == nil || attachment == nil) { ret err[StateError].err{StateError.invalid{}}; }
    if (attachment.active) { ret err[StateError].err{StateError.active{}}; }
    mutex.lock(?lifecycle.lock);
    if (lifecycle.state != OPEN) {
        mutex.unlock(?lifecycle.lock);
        ret err[StateError].err{StateError.closed{}};
    }
    if (lifecycle.submitted == (-1)::u64) {
        mutex.unlock(?lifecycle.lock);
        ret err[StateError].err{StateError.exhausted{}};
    }
    lifecycle.submitted = lifecycle.submitted + 1;
    attachment.owner = lifecycle;
    attachment.generation = lifecycle.generation;
    attachment.sequence = lifecycle.submitted;
    attachment.active = true;
    mutex.unlock(?lifecycle.lock);
    ret err[StateError].ok{};
}

# settles an attachment; true when this settlement completed the owner's close
pub fun settle(attachment: *Attachment) res[bool, StateError] {
    if (attachment == nil) { ret res[bool, StateError].err{StateError.invalid{}}; }
    if (!attachment.active || attachment.owner == nil) { ret res[bool, StateError].err{StateError.inactive{}}; }
    val lifecycle: *Lifecycle = attachment.owner;
    mutex.lock(?lifecycle.lock);
    if (!attachment.active) {
        mutex.unlock(?lifecycle.lock);
        ret res[bool, StateError].err{StateError.inactive{}};
    }
    if (attachment.generation != lifecycle.generation) {
        mutex.unlock(?lifecycle.lock);
        ret res[bool, StateError].err{StateError.stale{}};
    }
    attachment.active = false;
    attachment.owner = nil;
    lifecycle.settled = lifecycle.settled + 1;
    val complete: bool = lifecycle.state == CLOSING && lifecycle.settled == lifecycle.submitted;
    if (complete) { lifecycle.state = CLOSED; }
    mutex.unlock(?lifecycle.lock);
    ret res[bool, StateError].ok{complete};
}

pub fun begin_close(lifecycle: *Lifecycle, mode: Mode, cause: Cause) CloseResult {
    if (lifecycle == nil || mode > ABORTIVE || cause > FAILURE) {
        ret CloseResult{
            started: false,
            escalated: false,
            complete: false,
            snapshot: Snapshot{state: CLOSED, mode: ABORTIVE, cause: FAILURE, terminal_cause: FAILURE, outstanding: 0},
        };
    }
    mutex.lock(?lifecycle.lock);
    var started: bool = false;
    var escalated: bool = false;
    if (lifecycle.state == OPEN) {
        lifecycle.state = CLOSING;
        lifecycle.mode = mode;
        lifecycle.cause = cause;
        lifecycle.terminal_cause = cause;
        started = true;
    } or (lifecycle.state == CLOSING && lifecycle.mode == GRACEFUL && mode == ABORTIVE) {
        lifecycle.mode = ABORTIVE;
        lifecycle.terminal_cause = cause;
        escalated = true;
    }
    if (lifecycle.state == CLOSING && lifecycle.settled == lifecycle.submitted) {
        lifecycle.state = CLOSED;
    }
    val current: Snapshot = snapshot_locked(lifecycle);
    mutex.unlock(?lifecycle.lock);
    ret CloseResult{
        started: started,
        escalated: escalated,
        complete: current.state == CLOSED,
        snapshot: current,
    };
}

pub fun begin_process_drain(lifecycle: *Lifecycle) CloseResult {
    ret begin_close(lifecycle, GRACEFUL, PROCESS_TERMINATION);
}

pub fun fail(lifecycle: *Lifecycle) CloseResult {
    ret begin_close(lifecycle, ABORTIVE, FAILURE);
}

pub fun snapshot(lifecycle: *Lifecycle) Snapshot {
    if (lifecycle == nil) {
        ret Snapshot{state: CLOSED, mode: ABORTIVE, cause: FAILURE, terminal_cause: FAILURE, outstanding: 0};
    }
    mutex.lock(?lifecycle.lock);
    val current: Snapshot = snapshot_locked(lifecycle);
    mutex.unlock(?lifecycle.lock);
    ret current;
}

# settles the parent's attachment for a child that has fully closed; a child
# still open or draining is busy and the attachment stays active
pub fun settle_closed_child(attachment: *Attachment, child: *Lifecycle) res[bool, StateError] {
    if (attachment == nil || child == nil) { ret res[bool, StateError].err{StateError.invalid{}}; }
    if (snapshot(child).state != CLOSED) { ret res[bool, StateError].err{StateError.busy{}}; }
    ret settle(attachment);
}

fun attached(lifecycle: *Lifecycle, attachment: *Attachment) bool {
    val r: err[StateError] = attach(lifecycle, attachment);
    ret sel r.ok;
}

fun completed(attachment: *Attachment) bool {
    val r: res[bool, StateError] = settle(attachment);
    ret sel r.ok && r.ok;
}

test "lifecycle: close rejects attachment and completes after exact settlement" {
    var lifecycle: Lifecycle;
    val made: err[StateError] = make(?lifecycle);
    if (sel made.err) { ret 1; }
    var first: Attachment;
    var second: Attachment;
    if (!attached(?lifecycle, ?first) || !attached(?lifecycle, ?second)) { ret 2; }
    val closing: CloseResult = begin_close(?lifecycle, GRACEFUL, EXPLICIT);
    var rejected: Attachment;
    if (!closing.started || closing.complete || closing.snapshot.outstanding != 2) { ret 3; }
    val refused: err[StateError] = attach(?lifecycle, ?rejected);
    if (!sel refused.err) { ret 30; }
    if (!sel refused.err.closed) { ret 31; }
    if (rejected.active) { ret 31; }
    val partial: res[bool, StateError] = settle(?first);
    if (!sel partial.ok) { ret 4; }
    if (partial.ok) { ret 4; }
    val twice: res[bool, StateError] = settle(?first);
    if (!sel twice.err) { ret 40; }
    if (!sel twice.err.inactive) { ret 41; }
    val last: res[bool, StateError] = settle(?second);
    if (!sel last.ok) { ret 5; }
    if (!last.ok) { ret 5; }
    val duplicate: CloseResult = begin_close(?lifecycle, GRACEFUL, EXPLICIT);
    if (duplicate.started || duplicate.escalated || !duplicate.complete || duplicate.snapshot.state != CLOSED) { ret 6; }
    ret 0;
}

test "lifecycle: abortive escalation retains initiation and terminal causes" {
    var lifecycle: Lifecycle;
    make(?lifecycle);
    var operation: Attachment;
    if (!attached(?lifecycle, ?operation)) { ret 1; }
    val graceful: CloseResult = begin_close(?lifecycle, GRACEFUL, PROCESS_TERMINATION);
    val abortive: CloseResult = begin_close(?lifecycle, ABORTIVE, CANCELLATION);
    val duplicate: CloseResult = begin_close(?lifecycle, ABORTIVE, DEADLINE);
    if (!graceful.started || !abortive.escalated || duplicate.escalated) { ret 2; }
    if (abortive.snapshot.mode != ABORTIVE || abortive.snapshot.cause != PROCESS_TERMINATION || abortive.snapshot.terminal_cause != CANCELLATION) { ret 3; }
    if (!completed(?operation) || snapshot(?lifecycle).state != CLOSED) { ret 4; }
    ret 0;
}

test "lifecycle: the first abortive cause wins deadline and cancellation races" {
    var lifecycle: Lifecycle;
    make(?lifecycle);
    var operation: Attachment;
    if (!attached(?lifecycle, ?operation)) { ret 1; }
    if (!begin_close(?lifecycle, GRACEFUL, EXPLICIT).started) { ret 2; }
    val deadline: CloseResult = begin_close(?lifecycle, ABORTIVE, DEADLINE);
    val cancellation: CloseResult = begin_close(?lifecycle, ABORTIVE, CANCELLATION);
    if (!deadline.escalated || cancellation.escalated) { ret 3; }
    if (cancellation.snapshot.cause != EXPLICIT || cancellation.snapshot.terminal_cause != DEADLINE) { ret 4; }
    if (!completed(?operation)) { ret 5; }
    ret 0;
}

test "lifecycle: close after failure preserves the terminal state" {
    var lifecycle: Lifecycle;
    make(?lifecycle);
    val failed: CloseResult = fail(?lifecycle);
    val duplicate: CloseResult = begin_close(?lifecycle, GRACEFUL, EXPLICIT);
    if (!failed.started || !failed.complete || failed.snapshot.mode != ABORTIVE) { ret 1; }
    if (duplicate.started || duplicate.escalated || !duplicate.complete) { ret 2; }
    if (duplicate.snapshot.cause != FAILURE || duplicate.snapshot.terminal_cause != FAILURE) { ret 3; }
    ret 0;
}

test "lifecycle: a closed child settles its parent drain" {
    var parent: Lifecycle;
    var child: Lifecycle;
    make(?parent);
    make(?child);
    var child_link: Attachment;
    var child_operation: Attachment;
    if (!attached(?parent, ?child_link) || !attached(?child, ?child_operation)) { ret 1; }
    if (!begin_process_drain(?parent).started) { ret 2; }
    if (!begin_process_drain(?child).started) { ret 3; }
    val early: res[bool, StateError] = settle_closed_child(?child_link, ?child);
    if (!sel early.err) { ret 40; }
    if (!sel early.err.busy) { ret 41; }
    if (!child_link.active) { ret 41; }
    if (!completed(?child_operation)) { ret 4; }
    val drained: res[bool, StateError] = settle_closed_child(?child_link, ?child);
    if (!sel drained.ok) { ret 5; }
    if (!drained.ok) { ret 5; }
    if (snapshot(?parent).state != CLOSED) { ret 6; }
    ret 0;
}

test "lifecycle: refused transitions name their cause and change nothing" {
    val nil_made: err[StateError] = make(nil);
    if (!sel nil_made.err) { ret 1; }
    if (!sel nil_made.err.invalid) { ret 2; }
    var lifecycle: Lifecycle;
    make(?lifecycle);
    var attachment: Attachment;
    val nil_attach: err[StateError] = attach(?lifecycle, nil);
    if (!sel nil_attach.err) { ret 3; }
    if (!sel nil_attach.err.invalid) { ret 4; }
    if (!attached(?lifecycle, ?attachment)) { ret 5; }
    val again: err[StateError] = attach(?lifecycle, ?attachment);
    if (!sel again.err) { ret 6; }
    if (!sel again.err.active) { ret 7; }
    if (snapshot(?lifecycle).outstanding != 1) { ret 7; }
    var stale: Attachment;
    if (!attached(?lifecycle, ?stale)) { ret 8; }
    make(?lifecycle);
    val regenerated: res[bool, StateError] = settle(?stale);
    if (!sel regenerated.err) { ret 9; }
    if (!sel regenerated.err.stale) { ret 10; }
    if (!stale.active) { ret 10; }
    val nil_settle: res[bool, StateError] = settle(nil);
    if (!sel nil_settle.err) { ret 11; }
    if (!sel nil_settle.err.invalid) { ret 12; }
    var never: Attachment;
    val unattached: res[bool, StateError] = settle(?never);
    if (!sel unattached.err) { ret 13; }
    if (!sel unattached.err.inactive) { ret 14; }
    val nil_child: res[bool, StateError] = settle_closed_child(?stale, nil);
    if (!sel nil_child.err) { ret 15; }
    if (!sel nil_child.err.invalid) { ret 16; }
    ret 0;
}
