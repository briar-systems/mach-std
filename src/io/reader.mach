# generic reader interface
#
# backend-agnostic read interface using ctx + fn_ptr dispatch. concrete
# sources (fd, buffer, etc.) wire themselves via make().
#
# a source hands over what it knows: the bytes it delivered, or the native
# failure it hit. this module classifies the outcome once, in read(): zero
# bytes for a nonzero request is the end of the stream, and a native failure
# whose kind is WOULD_BLOCK is a stall. a source may also spell those cases
# itself; read() passes them through unchanged. the composite operations
# (read_exact, read_all, read_str) carry the bytes delivered before the outcome
# in the error payload, so a caller always knows how far the stream advanced.

use std.types.canonical.res;
use std.types.canonical.err;
use A: std.allocator;

use std.collections.vector;
use std.collections.vector.Vector;

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.OwnedString;
use std.types.string.owned_adopt;
use std.types.string.owned_release;
use std.system.os;
use io_error: std.io.error;

# chunk size for read_all in bytes
val CHUNK_SIZE: usize = 8192;

# a native failure and the bytes delivered before it
pub rec ReadFailure {
    delivered: usize;
    error:     io_error.Error;
}

# every way a read can fail
# ---
# eof:         the stream ended; payload is the bytes delivered before the end
# would_block: the source stalled (EAGAIN); payload is the bytes delivered first
# native:      the source failed; payload carries the failure and the bytes
#              delivered before it
# alloc:       growth was refused (read_all, read_str); nothing is delivered
#              and the caller's allocator is exactly as it was
pub tag ReadError: u8 {
    eof:         usize;
    would_block: usize;
    native:      ReadFailure;
    alloc:       A.Error;
}

# read callback type
# ---
# ptr: opaque context passed to the read callback
# buf: buffer to read into
# len: maximum number of bytes to read, never zero
# ret: bytes delivered (zero at the end of the stream) or the failure
pub def ReadFun: fun(ptr, *u8, usize) res[usize, ReadError];

# generic read interface
# ---
# ctx:    opaque context passed to the read callback
# f_read: read callback (ctx, buf, len) -> res[usize, ReadError]
pub rec Reader {
    ctx:    ptr;
    f_read: ReadFun;
}

pub fun native_failure(delivered: usize, error: io_error.Error) ReadError {
    ret ReadError.native{ReadFailure{delivered: delivered, error: error}};
}

# a stall reported as a native error is the would_block case
fun classify(error: ReadError) ReadError {
    if (sel error.native) {
        if (error.native.error.kind == io_error.WOULD_BLOCK) { ret ReadError.would_block{error.native.delivered}; }
    }
    ret error;
}

# add the bytes delivered by earlier calls to the error's progress
pub fun advance(error: ReadError, delivered: usize) ReadError {
    if (sel error.eof)         { ret ReadError.eof{error.eof + delivered}; }
    if (sel error.would_block) { ret ReadError.would_block{error.would_block + delivered}; }
    if (sel error.native) {
        ret native_failure(error.native.delivered + delivered, error.native.error);
    }
    ret error;
}

# read up to len bytes into buf
# ---
# r:   reader to read from
# buf: buffer to read into
# len: maximum number of bytes to read
# ret: bytes delivered, or eof, would_block or the native failure; ok{0}
#      only for a zero-length request
pub fun read(r: *Reader, buf: *u8, len: usize) res[usize, ReadError] {
    if (len == 0) { ret res[usize, ReadError].ok{0}; }
    val outcome: res[usize, ReadError] = r.f_read(r.ctx, buf, len);
    if (sel outcome.ok) {
        if (outcome.ok == 0) { ret res[usize, ReadError].err{ReadError.eof{0}}; }
        ret outcome;
    }
    ret res[usize, ReadError].err{classify(outcome.err)};
}

# read exactly len bytes into buf
# ---
# r:   reader to read from
# buf: buffer to fill
# len: number of bytes to read
# ret: the failure with the bytes delivered before it, or ok
pub fun read_exact(r: *Reader, buf: *u8, len: usize) err[ReadError] {
    var total: usize = 0;
    for (total < len) {
        val outcome: res[usize, ReadError] = read(r, ?buf[total], len - total);
        if (sel outcome.err) { ret err[ReadError].err{advance(outcome.err, total)}; }
        total = total + outcome.ok;
    }
    ret err[ReadError].ok{};
}

# read until EOF into a fresh vector
#
# the caller owns the returned vector. on failure nothing is returned and the
# vector's storage has already been released; the error carries the bytes the
# source delivered before it failed.
# ---
# a:   allocator to use
# r:   reader to read from
# ret: the content, or the failure
pub fun read_all(a: *A.Allocator, r: *Reader) res[Vector[u8], ReadError] {
    var v: Vector[u8] = vector.init[u8](a);

    for {
        # reserve space for the next chunk
        # NOTE: vector.reserve ensures *additional* space, not a new total
        val reserved: res[usize, A.Error] = vector.reserve[u8](?v, CHUNK_SIZE);
        if (sel reserved.err) {
            vector.dnit[u8](?v);
            ret res[Vector[u8], ReadError].err{ReadError.alloc{reserved.err}};
        }

        val got: res[usize, ReadError] = read(r, ?v.data[v.len], CHUNK_SIZE);
        if (sel got.err) {
            if (sel got.err.eof) { ret res[Vector[u8], ReadError].ok{v}; }
            val delivered: usize = v.len;
            vector.dnit[u8](?v);
            ret res[Vector[u8], ReadError].err{advance(got.err, delivered)};
        }

        v.len = v.len + got.ok;
    }

    # NOTE: unreachable, the loop above exits by return
    ret res[Vector[u8], ReadError].ok{v};
}

# read until EOF and return the content as an owned, null-terminated string
#
# the vector's buffer is terminated in place and adopted whole: the string's
# extent is the buffer's capacity and owned_release returns it all at once.
# ---
# a:   allocator to use
# r:   reader to read from
# ret: the content as an owned string, or the failure
pub fun read_str(a: *A.Allocator, r: *Reader) res[OwnedString, ReadError] {
    val outcome: res[Vector[u8], ReadError] = read_all(a, r);
    if (sel outcome.err) { ret res[OwnedString, ReadError].err{outcome.err}; }

    var v: Vector[u8] = outcome.ok;
    val rr: res[usize, A.Error] = vector.reserve[u8](?v, 1);
    if (sel rr.err) {
        vector.dnit[u8](?v);
        ret res[OwnedString, ReadError].err{ReadError.alloc{rr.err}};
    }
    v.data[v.len] = 0;

    ret res[OwnedString, ReadError].ok{owned_adopt(a, v.data::str, v.len, v.cap)};
}

use testing: std.allocator.testing;

# a source over a byte range that delivers at most `step` bytes per call and
# can be scripted to stall or fail after `fail_after` bytes
rec MemSource {
    data:       *u8;
    len:        usize;
    pos:        usize;
    step:       usize;
    fail_after: usize;
    fail_code:  i64;
    calls:      usize;
}

fun mem_read(ctx: ptr, buf: *u8, n: usize) res[usize, ReadError] {
    val m: *MemSource = ctx::*MemSource;
    m.calls = m.calls + 1;
    if (m.fail_code != 0 && m.pos >= m.fail_after) {
        ret res[usize, ReadError].err{native_failure(0, io_error.from_code(m.fail_code, io_error.OP_READ))};
    }
    var amount: usize = n;
    if (amount > m.step) { amount = m.step; }
    if (amount > m.len - m.pos) { amount = m.len - m.pos; }
    var i: usize = 0;
    for (i < amount) {
        buf[i] = m.data[m.pos + i];
        i = i + 1;
    }
    m.pos = m.pos + amount;
    ret res[usize, ReadError].ok{amount};
}

fun mem_source(m: *MemSource, data: str, len: usize, step: usize) Reader {
    m.data = data;
    m.len = len;
    m.pos = 0;
    m.step = step;
    m.fail_after = 0;
    m.fail_code = 0;
    m.calls = 0;
    ret Reader{ctx: m::ptr, f_read: mem_read};
}

fun bytes_equal(data: *u8, expected: str, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "io.reader.read: bytes, end of stream and native failure are distinct" {
    var m: MemSource;
    var r: Reader = mem_source(?m, "abc", 3, 8);
    var buf: [8]u8;
    val empty: res[usize, ReadError] = read(?r, ?buf[0], 0);
    if (!sel empty.ok) { ret 1; }
    if (empty.ok != 0) { ret 1; }
    if (m.calls != 0) { ret 1; }
    val got: res[usize, ReadError] = read(?r, ?buf[0], 8);
    if (!sel got.ok) { ret 2; }
    if (got.ok != 3) { ret 2; }
    if (!bytes_equal(?buf[0], "abc", 3)) { ret 2; }
    val eof: res[usize, ReadError] = read(?r, ?buf[0], 8);
    if (!sel eof.err) { ret 3; }
    if (!sel eof.err.eof) { ret 4; }
    if (eof.err.eof != 0) { ret 4; }
    m.fail_code = os.EIO;
    val failed: res[usize, ReadError] = read(?r, ?buf[0], 8);
    if (!sel failed.err) { ret 5; }
    if (!sel failed.err.native) { ret 6; }
    if (failed.err.native.delivered != 0 || failed.err.native.error.code != os.EIO || failed.err.native.error.operation != io_error.OP_READ) { ret 7; }
    ret 0;
}

test "io.reader.read: a native would-block failure is the would_block case" {
    var m: MemSource;
    var r: Reader = mem_source(?m, "abc", 3, 8);
    m.fail_code = os.EAGAIN;
    var buf: [4]u8;
    val stalled: res[usize, ReadError] = read(?r, ?buf[0], 4);
    if (!sel stalled.err) { ret 1; }
    if (!sel stalled.err.would_block) { ret 2; }
    if (stalled.err.would_block != 0) { ret 2; }
    ret 0;
}

test "io.reader.read_exact: fragments assemble and a short stream reports its progress" {
    var m: MemSource;
    var r: Reader = mem_source(?m, "abcdef", 6, 2);
    var buf: [6]u8;
    val full: err[ReadError] = read_exact(?r, ?buf[0], 6);
    if (!sel full.ok) { ret 1; }
    if (m.calls != 3) { ret 1; }
    if (!bytes_equal(?buf[0], "abcdef", 6)) { ret 1; }
    val none: err[ReadError] = read_exact(?r, ?buf[0], 0);
    if (!sel none.ok) { ret 2; }
    if (m.calls != 3) { ret 2; }

    var short: MemSource;
    var s: Reader = mem_source(?short, "abcd", 4, 3);
    val truncated: err[ReadError] = read_exact(?s, ?buf[0], 6);
    if (!sel truncated.err) { ret 3; }
    if (!sel truncated.err.eof) { ret 4; }
    if (truncated.err.eof != 4) { ret 4; }
    if (!bytes_equal(?buf[0], "abcd", 4)) { ret 5; }
    ret 0;
}

test "io.reader.read_exact: a failure after progress carries the delivered count" {
    var m: MemSource;
    var r: Reader = mem_source(?m, "abcdef", 6, 2);
    m.fail_after = 4;
    m.fail_code = os.EIO;
    var buf: [6]u8;
    val failed: err[ReadError] = read_exact(?r, ?buf[0], 6);
    if (!sel failed.err) { ret 1; }
    if (!sel failed.err.native) { ret 2; }
    if (failed.err.native.delivered != 4 || failed.err.native.error.kind != io_error.OTHER || failed.err.native.error.code != os.EIO) { ret 3; }
    m.fail_code = os.EAGAIN;
    m.pos = 0;
    m.fail_after = 2;
    val stalled: err[ReadError] = read_exact(?r, ?buf[0], 6);
    if (!sel stalled.err) { ret 4; }
    if (!sel stalled.err.would_block) { ret 5; }
    if (stalled.err.would_block != 2) { ret 5; }
    ret 0;
}

test "io.reader.read_all: content beyond one chunk is assembled and owned by the caller" {
    var t: testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    var data: [20000]u8;
    var i: usize = 0;
    for (i < 20000) { data[i] = (i % 251)::u8; i = i + 1; }
    var m: MemSource;
    var r: Reader = mem_source(?m, (?data[0])::str, 20000, 5000);
    val all: res[Vector[u8], ReadError] = read_all(testing.allocator_of(?t), ?r);
    if (!sel all.ok) { testing.dnit(?t); ret 2; }
    var v: Vector[u8] = all.ok;
    if (v.len != 20000) { vector.dnit[u8](?v); testing.dnit(?t); ret 3; }
    i = 0;
    for (i < 20000) {
        if (v.data[i] != (i % 251)::u8) { vector.dnit[u8](?v); testing.dnit(?t); ret 4; }
        i = i + 1;
    }
    val released: err[A.Error] = vector.dnit[u8](?v);
    if (sel released.err) { testing.dnit(?t); ret 5; }
    if (testing.leaked(?t)) { testing.dnit(?t); ret 5; }
    testing.dnit(?t);
    ret 0;
}

test "io.reader.read_all: an empty stream is an empty vector, a failure releases the buffer" {
    var t: testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    var m: MemSource;
    var r: Reader = mem_source(?m, "", 0, 8);
    val empty: res[Vector[u8], ReadError] = read_all(testing.allocator_of(?t), ?r);
    if (!sel empty.ok) { testing.dnit(?t); ret 2; }
    var v: Vector[u8] = empty.ok;
    if (v.len != 0) { vector.dnit[u8](?v); testing.dnit(?t); ret 3; }
    vector.dnit[u8](?v);

    var f: MemSource;
    var failing: Reader = mem_source(?f, "abcdef", 6, 4);
    f.fail_after = 4;
    f.fail_code = os.EIO;
    val failed: res[Vector[u8], ReadError] = read_all(testing.allocator_of(?t), ?failing);
    if (!sel failed.err) { testing.dnit(?t); ret 4; }
    if (!sel failed.err.native) { testing.dnit(?t); ret 5; }
    if (failed.err.native.delivered != 4 || failed.err.native.error.code != os.EIO) { testing.dnit(?t); ret 6; }
    if (testing.live_count(?t) != 0) { testing.dnit(?t); ret 7; }
    testing.dnit(?t);
    ret 0;
}

test "io.reader.read_all: a refused growth mid-stream is the alloc case and leaks nothing" {
    var t: testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    var data: [20000]u8;
    var m: MemSource;
    var r: Reader = mem_source(?m, (?data[0])::str, 20000, 5000);
    # the first reserve allocates one chunk, one read delivers 5000 bytes into
    # it, and the next chunk's growth is the refused request
    testing.fail_at_ordinal(?t, testing.attempt_count(?t) + 2);
    val refused: res[Vector[u8], ReadError] = read_all(testing.allocator_of(?t), ?r);
    if (!sel refused.err) { testing.dnit(?t); ret 2; }
    if (!sel refused.err.alloc) { testing.dnit(?t); ret 3; }
    if (!sel refused.err.alloc.exhausted) { testing.dnit(?t); ret 4; }
    if (m.calls != 1 || m.pos != 5000) { testing.dnit(?t); ret 5; }
    if (testing.live_count(?t) != 0) { testing.dnit(?t); ret 6; }
    testing.clear_failure(?t);
    testing.dnit(?t);
    ret 0;
}

test "io.reader.read_str: the content is owned, terminated and released whole" {
    var t: testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    var m: MemSource;
    var r: Reader = mem_source(?m, "hello", 5, 2);
    val got: res[OwnedString, ReadError] = read_str(testing.allocator_of(?t), ?r);
    if (!sel got.ok) { testing.dnit(?t); ret 2; }
    var owned: OwnedString = got.ok;
    if (owned.len != 5 || owned.data[5] != 0 || !bytes_equal(owned.data, "hello", 5)) { testing.dnit(?t); ret 3; }
    if (owned.extent < 6 || owned.a != testing.allocator_of(?t)) { testing.dnit(?t); ret 4; }
    val released: err[A.Error] = owned_release(?owned);
    if (sel released.err) { testing.dnit(?t); ret 5; }
    if (testing.leaked(?t)) { testing.dnit(?t); ret 5; }

    var f: MemSource;
    var failing: Reader = mem_source(?f, "hello", 5, 2);
    f.fail_after = 2;
    f.fail_code = os.EPIPE;
    val failed: res[OwnedString, ReadError] = read_str(testing.allocator_of(?t), ?failing);
    if (!sel failed.err) { testing.dnit(?t); ret 6; }
    if (!sel failed.err.native) { testing.dnit(?t); ret 7; }
    if (failed.err.native.error.kind != io_error.CLOSED) { testing.dnit(?t); ret 7; }
    if (testing.live_count(?t) != 0) { testing.dnit(?t); ret 8; }
    testing.dnit(?t);
    ret 0;
}
