# generic writer interface
#
# backend-agnostic write interface using ctx + fn_ptr dispatch. concrete
# sinks (fd, buffer, etc.) build a Writer from their context and write callback.
#
# a sink hands over what it knows: the bytes it accepted, or the native
# failure it hit. this module classifies the outcome once, in write(): zero
# bytes accepted for a nonzero request is a stall, and a native failure whose
# kind is WOULD_BLOCK is a would_block. a sink may also spell those cases
# itself; write() passes them through unchanged. write_all and write_str carry
# the persisted prefix in the error payload, so a caller always knows how many
# bytes the sink accepted before the outcome.

use std_memory: std.memory;
use std.system.capability;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A:        std.allocator;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
#[testing]
use std.types.string.str_equals;
use std.types.string.str_len;

$if (capability.HOSTED) {
    #[testing]
    use T: std.allocator.testing;
}

# a native failure and the bytes persisted before it
pub rec WriteFailure {
    written: usize;
    error:   io_error.Error;
}

# every way a write can fail
# ---
# stalled:     the sink accepted nothing; payload is the persisted prefix
# would_block: the sink stalled natively (EAGAIN); payload is the prefix
# native:      the sink failed; payload carries the failure and the prefix
pub tag WriteError: u8 {
    stalled:     usize;
    would_block: usize;
    native:      WriteFailure;
}

# write callback type
# ---
# ptr: opaque context passed to the write callback
# buf: buffer to write from
# len: number of bytes to write, never zero
# ret: bytes accepted (zero when the sink stalls) or the failure
pub def WriteFun: fun(ptr, *u8, usize) res[usize, WriteError];

# generic write interface
# ---
# ctx:      opaque context passed to the write callback
# fn_write: write callback (ctx, buf, len) -> res[usize, WriteError]
pub rec Writer {
    ctx:      ptr;
    fn_write: WriteFun;
}

# a native failure as a write error
# ---
# written: bytes persisted before the failure
# error:   the native failure
# ret:     the native case carrying both
pub fun native_failure(written: usize, error: io_error.Error) WriteError {
    ret WriteError.native{WriteFailure{written: written, error: error}};
}

# the bytes the sink persisted before the failure
pub fun persisted(error: WriteError) usize {
    if (sel error.stalled)     { ret error.stalled; }
    if (sel error.would_block) { ret error.would_block; }
    if (sel error.native)      { ret error.native.written; }
    ret 0;
}

# a stall reported as a native error is the would_block case, which write()
# applies to every sink's failure and a caller that writes past a Writer applies
# to its own
pub fun classify(error: WriteError) WriteError {
    if (sel error.native) {
        if (error.native.error.kind == io_error.WOULD_BLOCK) { ret WriteError.would_block{error.native.written}; }
    }
    ret error;
}

# add the bytes persisted by earlier calls to the error's prefix
pub fun advance(error: WriteError, written: usize) WriteError {
    if (sel error.stalled)     { ret WriteError.stalled{error.stalled + written}; }
    if (sel error.would_block) { ret WriteError.would_block{error.would_block + written}; }
    if (sel error.native) {
        ret native_failure(error.native.written + written, error.native.error);
    }
    ret error;
}

# write up to len bytes from buf
# ---
# w:   writer to write to
# buf: buffer to write from
# len: maximum number of bytes to write
# ret: bytes accepted, or stalled, would_block or the native failure; ok{0}
#      only for a zero-length request
pub fun write(w: *Writer, buf: *u8, len: usize) res[usize, WriteError] {
    if (len == 0) { ret res[usize, WriteError].ok{0}; }
    val res_f_write: res[usize, WriteError] = w.fn_write(w.ctx, buf, len);
    if (sel res_f_write.ok) {
        if (res_f_write.ok == 0) { ret res[usize, WriteError].err{WriteError.stalled{0}}; }
        ret res_f_write;
    }
    ret res[usize, WriteError].err{classify(res_f_write.err)};
}

# write exactly len bytes from buf
# ---
# w:   writer to write to
# buf: buffer to write from
# len: number of bytes to write
# ret: the failure with the persisted prefix, or ok
pub fun write_all(w: *Writer, buf: *u8, len: usize) err[WriteError] {
    var total: usize = 0;
    for (total < len) {
        val res_write: res[usize, WriteError] = write(w, ?buf[total], len - total);
        if (sel res_write.err) { ret err[WriteError].err{advance(res_write.err, total)}; }
        total = total + res_write.ok;
    }
    ret err[WriteError].ok{};
}

# write a null-terminated string
# ---
# w:   writer to write to
# s:   string to write
# ret: the failure with the persisted prefix, or ok
pub fun write_str(w: *Writer, s: str) err[WriteError] {
    ret write_all(w, s, str_len(s));
}

# a writer that stages bytes in a caller-provided buffer
#
# ctx for a Writer whose sink batches into `buf` and forwards full buffers to
# `inner`. the caller owns the storage and the flush: nothing leaves the
# buffer until it fills, a request at least as large as the capacity goes
# straight through, or flush() is called.
#
# accounting. a byte count returned by the staging sink is provisional: the
# bytes are in the buffer, not at the inner writer. `pushed` is the
# authoritative count of bytes the inner writer took over this buffer's life,
# and a caller that must report a true total reads it after flush(). the
# staging sink still reports a per-call prefix the way an unbuffered sink
# does, measured against the bytes it had already handed back, so a failure
# that loses only bytes from the current call is exact; a failure that loses
# bytes acknowledged by an earlier call cannot be spelled as a negative prefix
# and reports zero, which is why `pushed` exists.
#
# a failure is sticky. the first refusal from the inner writer is retained,
# every later staging call and flush() replays it with a zero prefix, and the
# staged bytes are dropped, so a caller driving a long format stops at the
# failure instead of formatting into a buffer that will never reach the sink.
# ---
# inner:  the writer full buffers are forwarded to
# buf:    caller-owned staging storage
# cap:    capacity of buf in bytes
# len:    bytes currently staged
# taken:  bytes the staging sink has handed back as accepted
# pushed: bytes the inner writer has persisted over this buffer's life
# failed: true once the inner writer has refused
# error:  the first refusal, retained for replay
pub rec Buffered {
    inner:  *Writer;
    buf:    *u8;
    cap:    usize;
    len:    usize;
    taken:  usize;
    pushed: usize;
    failed: bool;
    error:  WriteError;
}

# the same failure with its persisted prefix replaced
pub fun reprefix(error: WriteError, written: usize) WriteError {
    if (sel error.stalled)     { ret WriteError.stalled{written}; }
    if (sel error.would_block) { ret WriteError.would_block{written}; }
    if (sel error.native)      { ret native_failure(written, error.native.error); }
    ret error;
}

# hand the staged bytes to the inner writer, retaining a refusal
fun push(b: *Buffered) bool {
    if (b.len == 0) { ret true; }
    val staged:   usize           = b.len;
    val err_done: err[WriteError] = write_all(b.inner, b.buf, staged);
    b.len = 0;
    if (sel err_done.err) {
        b.pushed = b.pushed + persisted(err_done.err);
        b.failed = true;
        b.error  = reprefix(err_done.err, 0);
        ret false;
    }
    b.pushed = b.pushed + staged;
    ret true;
}

# the prefix of the current call the inner writer ended up taking
fun call_prefix(b: *Buffered, base: usize) usize {
    if (b.pushed > base) { ret b.pushed - base; }
    ret 0;
}

fun buffered_write(ctx: ptr, p: *u8, n: usize) res[usize, WriteError] {
    val b: *Buffered = ctx::*Buffered;
    if (b.failed) { ret res[usize, WriteError].err{reprefix(b.error, 0)}; }

    val base: usize = b.taken;
    var off:  usize = 0;
    for (off < n) {
        if (b.len == b.cap) {
            if (!push(b)) { ret res[usize, WriteError].err{reprefix(b.error, call_prefix(b, base))}; }
        }
        # a remainder at least as large as the buffer would only be copied to be
        # pushed whole, so it goes straight through
        if (b.len == 0 && n - off >= b.cap) {
            val bulk:     usize           = n - off;
            val err_done: err[WriteError] = write_all(b.inner, ?p[off], bulk);
            if (sel err_done.err) {
                b.pushed = b.pushed + persisted(err_done.err);
                b.failed = true;
                b.error  = reprefix(err_done.err, 0);
                ret res[usize, WriteError].err{reprefix(b.error, call_prefix(b, base))};
            }
            b.pushed = b.pushed + bulk;
            off      = n;
            cnt;
        }
        var take: usize = n - off;
        val room: usize = b.cap - b.len;
        if (take > room) { take = room; }
        var i: usize = 0;
        for (i < take) {
            b.buf[b.len + i] = p[off + i];
            i                = i + 1;
        }
        b.len = b.len + take;
        off   = off + take;
    }
    b.taken = b.taken + n;
    ret res[usize, WriteError].ok{n};
}

# wire a buffered writer over inner
# ---
# b:     buffer state, owned by the caller for the writer's whole life
# inner: writer full buffers are forwarded to
# buf:   staging storage, owned by the caller
# cap:   capacity of buf in bytes; zero degrades to an unbuffered passthrough
# ret:   a Writer staging into b
pub fun buffered(b: *Buffered, inner: *Writer, buf: *u8, cap: usize) Writer {
    b.inner  = inner;
    b.buf    = buf;
    b.cap    = cap;
    b.len    = 0;
    b.taken  = 0;
    b.pushed = 0;
    b.failed = false;
    b.error  = WriteError.stalled{0};
    ret Writer{ctx: b::ptr, fn_write: buffered_write};
}

# hand every staged byte to the inner writer
# ---
# b:   buffer to drain
# ret: the refusal with the prefix of the staged bytes it took, or ok
pub fun flush(b: *Buffered) err[WriteError] {
    if (b.failed)   { ret err[WriteError].err{reprefix(b.error, 0)}; }
    if (b.len == 0) { ret err[WriteError].ok{}; }
    val before: usize = b.pushed;
    if (!push(b)) { ret err[WriteError].err{reprefix(b.error, b.pushed - before)}; }
    ret err[WriteError].ok{};
}

# bytes the inner writer has taken over this buffer's life
pub fun pushed(b: *Buffered) usize {
    ret b.pushed;
}

# a writer into memory
#
# ctx for a Writer whose sink appends to `buf`. a fixed memory writes into
# caller storage and accepts what fits, so a full one stalls; a growing memory
# owns `buf` and grows it through `alloc`, failing natively when the allocator
# refuses. either keeps one byte past the written bytes free, so text() can
# terminate them. a limit scripts a refusal: once `limit` bytes are held, every
# write fails natively, and a write that crosses it is cut at the limit.
# ---
# alloc: grows buf; nil for a fixed memory
# buf:   the written bytes
# cap:   capacity of buf in bytes
# len:   bytes written
# limit: the bytes held before every write is refused, or none
pub rec Memory {
    alloc: *A.Allocator;
    buf:   *u8;
    cap:   usize;
    len:   usize;
    limit: opt[usize];
}

fun memory_write(ctx: ptr, p: *u8, n: usize) res[usize, WriteError] {
    val m:    *Memory = ctx::*Memory;
    var take: usize   = n;
    if (sel m.limit.some) {
        if (m.len >= m.limit.some) {
            ret res[usize, WriteError].err{native_failure(0, io_error.make(io_error.IO, io_error.OP_WRITE))};
        }
        if (take > m.limit.some - m.len) { take = m.limit.some - m.len; }
    }
    if (m.alloc != nil && m.len + take + 1 > m.cap) {
        var grown: usize = m.cap * 2;
        if (grown < m.len + take + 1) { grown = m.len + take + 1; }
        if (grown < 64)               { grown = 64; }
        var res_moved: res[*u8, A.Error];
        if (m.buf == nil) { res_moved = A.allocate[u8](m.alloc, grown); }
        or                { res_moved = A.reallocate[u8](m.alloc, m.buf, m.cap, grown); }
        if (sel res_moved.err) {
            ret res[usize, WriteError].err{native_failure(0, io_error.make(io_error.RESOURCE_EXHAUSTED, io_error.OP_WRITE))};
        }
        m.buf = res_moved.ok;
        m.cap = grown;
    }
    var room: usize = 0;
    if (m.cap > m.len + 1) { room = m.cap - m.len - 1; }
    if (take > room)       { take = room; }
    if (take == 0)         { ret res[usize, WriteError].ok{0}; }
    std_memory.raw_copy(?m.buf[m.len], p, take);
    m.len = m.len + take;
    ret res[usize, WriteError].ok{take};
}

# wire a writer into caller storage
# ---
# m:   memory state, owned by the caller for the writer's whole life
# buf: storage, owned by the caller
# cap: capacity of buf in bytes; at most cap - 1 bytes are written
# ret: a Writer appending to m
pub fun memory(m: *Memory, buf: *u8, cap: usize) Writer {
    m.alloc = nil;
    m.buf   = buf;
    m.cap   = cap;
    m.len   = 0;
    m.limit = opt[usize].none{};
    ret Writer{ctx: m::ptr, fn_write: memory_write};
}

# wire a writer into storage it grows through alloc
# ---
# m:     memory state, owned by the caller for the writer's whole life
# alloc: grows the storage; released with memory_dnit
# ret:   a Writer appending to m
pub fun memory_growing(m: *Memory, alloc: *A.Allocator) Writer {
    m.alloc = alloc;
    m.buf   = nil;
    m.cap   = 0;
    m.len   = 0;
    m.limit = opt[usize].none{};
    ret Writer{ctx: m::ptr, fn_write: memory_write};
}

# release the storage a growing memory holds; a fixed memory holds none
pub fun memory_dnit(m: *Memory) {
    if (m.alloc != nil) {
        if (m.buf != nil) { A.deallocate[u8](m.alloc, m.buf, m.cap); }
        m.buf = nil;
        m.cap = 0;
    }
    m.len = 0;
}

# the written bytes as text, terminated in place; empty before any write
pub fun memory_text(m: *Memory) str {
    if (m.buf == nil || m.cap == 0) { ret ""; }
    m.buf[m.len] = 0;
    ret m.buf::str;
}

$if (capability.HOSTED) {
    # a sink over a byte range that accepts at most `step` bytes per call and can
    # be scripted to stall or fail once `fail_after` bytes are persisted
    #[testing]
    rec MemSink {
        data:       *u8;
        cap:        usize;
        len:        usize;
        step:       usize;
        fail_after: usize;
        failing:    bool;
        fail_kind:  io_error.Kind;
        stall:      bool;
        calls:      usize;
    }

    #[testing]
    fun mem_write(ctx: ptr, buf: *u8, n: usize) res[usize, WriteError] {
        val m: *MemSink = ctx::*MemSink;
        m.calls = m.calls + 1;
        if (m.len >= m.fail_after) {
            if (m.stall) { ret res[usize, WriteError].ok{0}; }
            if (m.failing) {
                ret res[usize, WriteError].err{native_failure(0, io_error.make(m.fail_kind, io_error.OP_WRITE))};
            }
        }
        var amount: usize = n;
        if (amount > m.step)        { amount = m.step; }
        if (amount > m.cap - m.len) { amount = m.cap - m.len; }
        var i: usize = 0;
        for (i < amount) {
            m.data[m.len + i] = buf[i];
            i                 = i + 1;
        }
        m.len = m.len + amount;
        ret res[usize, WriteError].ok{amount};
    }

    #[testing]
    fun mem_sink(m: *MemSink, data: *u8, cap: usize, step: usize) Writer {
        m.data       = data;
        m.cap        = cap;
        m.len        = 0;
        m.step       = step;
        m.fail_after = cap;
        m.failing    = false;
        m.stall      = false;
        m.calls      = 0;
        ret Writer{ctx: m::ptr, fn_write: mem_write};
    }

    #[testing]
    fun bytes_equal(data: *u8, expected: str, len: usize) bool {
        var i: usize = 0;
        for (i < len) {
            if (data[i] != expected[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }

    test write__accepted_stalled_blocked_and_failed_are_distinct {
        var out:       [8]u8;
        var m:         MemSink;
        var w:         Writer                 = mem_sink(?m, ?out[0], 8, 8);
        val res_empty: res[usize, WriteError] = write(?w, "x", 0);
        if (!sel res_empty.ok) { ret 1; }
        if (res_empty.ok != 0) { ret 1; }
        if (m.calls != 0)      { ret 1; }
        val res_put: res[usize, WriteError] = write(?w, "abc", 3);
        if (!sel res_put.ok)                 { ret 2; }
        if (res_put.ok != 3)                 { ret 2; }
        if (!bytes_equal(?out[0], "abc", 3)) { ret 2; }
        m.stall      = true;
        m.fail_after = 0;
        val res_stalled: res[usize, WriteError] = write(?w, "d", 1);
        if (!sel res_stalled.err)         { ret 3; }
        if (!sel res_stalled.err.stalled) { ret 4; }
        if (res_stalled.err.stalled != 0) { ret 4; }
        m.stall     = false;
        m.failing   = true;
        m.fail_kind = io_error.CLOSED;
        val res_failed: res[usize, WriteError] = write(?w, "d", 1);
        if (!sel res_failed.err)                                                                                                                                     { ret 5; }
        if (!sel res_failed.err.native)                                                                                                                              { ret 6; }
        if (res_failed.err.native.written != 0 || res_failed.err.native.error.kind != io_error.CLOSED || res_failed.err.native.error.operation != io_error.OP_WRITE) { ret 7; }
        m.failing   = true;
        m.fail_kind = io_error.WOULD_BLOCK;
        val res_blocked: res[usize, WriteError] = write(?w, "d", 1);
        if (!sel res_blocked.err)             { ret 8; }
        if (!sel res_blocked.err.would_block) { ret 9; }
        if (res_blocked.err.would_block != 0) { ret 9; }
        ret 0;
    }

    test write_all__short_writes_assemble_the_exact_bytes {
        var out:      [6]u8;
        var m:        MemSink;
        var w:        Writer          = mem_sink(?m, ?out[0], 6, 2);
        val err_done: err[WriteError] = write_all(?w, "abcdef", 6);
        if (!sel err_done.ok)                   { ret 1; }
        if (m.calls != 3)                       { ret 1; }
        if (m.len != 6)                         { ret 1; }
        if (!bytes_equal(?out[0], "abcdef", 6)) { ret 1; }
        val err_none: err[WriteError] = write_all(?w, "x", 0);
        if (!sel err_none.ok) { ret 2; }
        if (m.calls != 3)     { ret 2; }
        ret 0;
    }

    test write_all__a_refusal_after_progress_carries_the_prefix {
        var out: [8]u8;
        var m:   MemSink;
        var w:   Writer = mem_sink(?m, ?out[0], 8, 3);
        m.fail_after = 3;
        m.failing    = true;
        m.fail_kind  = io_error.RESOURCE_EXHAUSTED;
        val err_failed: err[WriteError] = write_all(?w, "abcdef", 6);
        if (!sel err_failed.err)                                                  { ret 1; }
        if (!sel err_failed.err.native)                                           { ret 2; }
        if (err_failed.err.native.written != 3 || persisted(err_failed.err) != 3) { ret 3; }
        if (err_failed.err.native.error.kind != io_error.RESOURCE_EXHAUSTED)      { ret 4; }
        if (!bytes_equal(?out[0], "abc", 3))                                      { ret 5; }
        m.failing    = true;
        m.fail_kind  = io_error.WOULD_BLOCK;
        m.len        = 0;
        m.fail_after = 3;
        val err_blocked: err[WriteError] = write_all(?w, "abcdef", 6);
        if (!sel err_blocked.err)             { ret 6; }
        if (!sel err_blocked.err.would_block) { ret 7; }
        if (err_blocked.err.would_block != 3) { ret 7; }
        m.failing = false;
        m.stall   = true;
        m.len     = 0;
        m.step    = 2;
        val err_stalled: err[WriteError] = write_all(?w, "abcdef", 6);
        if (!sel err_stalled.err)                                            { ret 8; }
        if (!sel err_stalled.err.stalled)                                    { ret 9; }
        if (err_stalled.err.stalled != 4 || persisted(err_stalled.err) != 4) { ret 10; }
        ret 0;
    }

    test buffered__bytes_stage_until_the_buffer_fills {
        var out:   [32]u8;
        var m:     MemSink;
        var inner: Writer = mem_sink(?m, ?out[0], 32, 64);
        var stage: [4]u8;
        var b:     Buffered;
        var bw:    Writer = buffered(?b, ?inner, ?stage[0], 4);

        val err_first: err[WriteError] = write_all(?bw, "abc", 3);
        if (!sel err_first.ok) { ret 1; }
        if (m.calls != 0)      { ret 1; }
        if (pushed(?b) != 0)   { ret 1; }

        # "def" fills the buffer at 'd' and pushes "abcd", staging "ef"
        val err_second: err[WriteError] = write_all(?bw, "def", 3);
        if (!sel err_second.ok)               { ret 2; }
        if (m.calls != 1)                     { ret 2; }
        if (m.len != 4)                       { ret 2; }
        if (pushed(?b) != 4)                  { ret 2; }
        if (!bytes_equal(?out[0], "abcd", 4)) { ret 2; }

        val err_done: err[WriteError] = flush(?b);
        if (!sel err_done.ok)                   { ret 3; }
        if (m.calls != 2)                       { ret 3; }
        if (pushed(?b) != 6)                    { ret 3; }
        if (!bytes_equal(?out[0], "abcdef", 6)) { ret 3; }

        # a flush with nothing staged costs no call
        val err_again: err[WriteError] = flush(?b);
        if (!sel err_again.ok) { ret 4; }
        if (m.calls != 2)      { ret 4; }
        ret 0;
    }

    test buffered__a_request_of_buffer_size_goes_straight_through {
        var out:   [32]u8;
        var m:     MemSink;
        var inner: Writer = mem_sink(?m, ?out[0], 32, 64);
        var stage: [4]u8;
        var b:     Buffered;
        var bw:    Writer = buffered(?b, ?inner, ?stage[0], 4);

        val err_bulk: err[WriteError] = write_all(?bw, "0123456789", 10);
        if (!sel err_bulk.ok)                        { ret 1; }
        if (m.calls != 1)                            { ret 1; }
        if (b.len != 0)                              { ret 1; }
        if (pushed(?b) != 10)                        { ret 1; }
        if (!bytes_equal(?out[0], "0123456789", 10)) { ret 1; }

        # staged bytes are pushed ahead of the passthrough, in order
        val err_head: err[WriteError] = write_all(?bw, "ab", 2);
        if (!sel err_head.ok) { ret 2; }
        if (m.calls != 1)     { ret 2; }

        val err_tail: err[WriteError] = write_all(?bw, "cdefghij", 8);
        if (!sel err_tail.ok)                         { ret 3; }
        if (m.calls != 3)                             { ret 3; }
        if (pushed(?b) != 20)                         { ret 3; }
        if (!bytes_equal(?out[10], "abcdefghij", 10)) { ret 3; }
        ret 0;
    }

    test buffered__a_refusal_reports_the_prefix_and_sticks {
        var out:   [32]u8;
        var m:     MemSink;
        var inner: Writer = mem_sink(?m, ?out[0], 32, 2);
        var stage: [8]u8;
        var b:     Buffered;
        var bw:    Writer = buffered(?b, ?inner, ?stage[0], 8);
        m.fail_after = 2;
        m.failing    = true;
        m.fail_kind  = io_error.RESOURCE_EXHAUSTED;

        # staging cannot fail: the inner writer has not been reached yet
        val err_staged: err[WriteError] = write_all(?bw, "abcd", 4);
        if (!sel err_staged.ok) { ret 1; }
        if (m.calls != 0)       { ret 1; }

        # the flush takes 2 of the 4 staged bytes and reports that prefix
        val err_failed: err[WriteError] = flush(?b);
        if (!sel err_failed.err)                                             { ret 2; }
        if (!sel err_failed.err.native)                                      { ret 3; }
        if (err_failed.err.native.written != 2)                              { ret 4; }
        if (persisted(err_failed.err) != 2)                                  { ret 4; }
        if (err_failed.err.native.error.kind != io_error.RESOURCE_EXHAUSTED) { ret 5; }
        if (pushed(?b) != 2)                                                 { ret 6; }
        if (!bytes_equal(?out[0], "ab", 2))                                  { ret 7; }

        # the refusal is sticky: later writes replay it with no prefix of their own
        # and reach no further into the inner writer
        val calls:     usize           = m.calls;
        val err_after: err[WriteError] = write_all(?bw, "efgh", 4);
        if (!sel err_after.err)                { ret 8; }
        if (!sel err_after.err.native)         { ret 9; }
        if (err_after.err.native.written != 0) { ret 10; }
        if (m.calls != calls)                  { ret 11; }
        if (pushed(?b) != 2)                   { ret 12; }

        val err_refused: err[WriteError] = flush(?b);
        if (!sel err_refused.err)            { ret 13; }
        if (persisted(err_refused.err) != 0) { ret 14; }
        if (m.calls != calls)                { ret 15; }
        ret 0;
    }

    test buffered__zero_capacity_is_a_passthrough {
        var out:   [16]u8;
        var m:     MemSink;
        var inner: Writer = mem_sink(?m, ?out[0], 16, 64);
        var b:     Buffered;
        var bw:    Writer = buffered(?b, ?inner, nil, 0);

        val err_done: err[WriteError] = write_all(?bw, "abc", 3);
        if (!sel err_done.ok)                { ret 1; }
        if (m.calls != 1)                    { ret 2; }
        if (b.len != 0)                      { ret 3; }
        if (pushed(?b) != 3)                 { ret 4; }
        if (!bytes_equal(?out[0], "abc", 3)) { ret 5; }

        val err_drained: err[WriteError] = flush(?b);
        if (!sel err_drained.ok) { ret 6; }
        if (m.calls != 1)        { ret 7; }
        ret 0;
    }

    test memory__a_fixed_memory_holds_what_fits_and_then_stalls {
        var out:      [6]u8;
        var m:        Memory;
        var w:        Writer          = memory(?m, ?out[0], 6);
        val err_done: err[WriteError] = write_str(?w, "abc");
        if (!sel err_done.ok)                    { ret 1; }
        if (m.len != 3)                          { ret 2; }
        if (!str_equals(memory_text(?m), "abc")) { ret 3; }
        val err_full: err[WriteError] = write_str(?w, "defg");
        if (!sel err_full.err)                     { ret 4; }
        if (!sel err_full.err.stalled)             { ret 5; }
        if (persisted(err_full.err) != 2)          { ret 6; }
        if (!str_equals(memory_text(?m), "abcde")) { ret 7; }
        ret 0;
    }

    test memory__a_growing_memory_takes_everything_and_releases_it {
        var tracker:  T.Testing;
        val err_made: err[A.Error] = T.init(?tracker);
        if (sel err_made.err) { ret 10; }
        var m: Memory;
        var w: Writer = memory_growing(?m, T.allocator_of(?tracker));
        var i: usize  = 0;
        for (i < 100) {
            val err_put: err[WriteError] = write_str(?w, "0123456789");
            if (sel err_put.err) {
                T.dnit(?tracker);
                ret 1;
            }
            i = i + 1;
        }
        val held: bool = m.len == 1000 && str_len(memory_text(?m)) == 1000 && m.buf[999] == '9';
        memory_dnit(?m);
        val leaked: bool = T.leaked(?tracker);
        T.dnit(?tracker);
        if (!held)  { ret 2; }
        if (leaked) { ret 3; }
        ret 0;
    }

    test memory__a_limit_cuts_the_crossing_write_and_refuses_the_next {
        var tracker:  T.Testing;
        val err_made: err[A.Error] = T.init(?tracker);
        if (sel err_made.err) { ret 10; }
        var m: Memory;
        var w: Writer = memory_growing(?m, T.allocator_of(?tracker));
        m.limit = opt[usize].some{4};
        val err_crossing: err[WriteError] = write_str(?w, "abcdef");
        val err_again:    err[WriteError] = write_str(?w, "g");
        val text_ok:      bool            = str_equals(memory_text(?m), "abcd");
        memory_dnit(?m);
        T.dnit(?tracker);
        if (!sel err_crossing.err)            { ret 1; }
        if (!sel err_crossing.err.native)     { ret 2; }
        if (persisted(err_crossing.err) != 4) { ret 3; }
        if (!sel err_again.err)               { ret 4; }
        if (!sel err_again.err.native)        { ret 4; }
        if (persisted(err_again.err) != 0)    { ret 5; }
        if (!text_ok)                         { ret 6; }
        ret 0;
    }

    # a passthrough the inner writer refuses part-way reports the bytes of this
    # call that reached it, counts what the inner writer took, and sticks
    test buffered__a_refused_passthrough_reports_the_call_prefix {
        var out:   [32]u8;
        var m:     MemSink;
        var inner: Writer = mem_sink(?m, ?out[0], 32, 2);
        var stage: [4]u8;
        var b:     Buffered;
        var bw:    Writer = buffered(?b, ?inner, ?stage[0], 4);
        m.fail_after = 6;
        m.failing    = true;
        m.fail_kind  = io_error.RESOURCE_EXHAUSTED;
        val err_head: err[WriteError] = write_all(?bw, "ab", 2);
        if (!sel err_head.ok) { ret 1; }

        # "cd" fills the buffer and "abcd" is pushed, then "efghij" goes straight
        # through and the sink takes "ef" before it refuses
        val res_tail: res[usize, WriteError] = write(?bw, "cdefghij", 8);
        if (!sel res_tail.err)                                             { ret 2; }
        if (!sel res_tail.err.native)                                      { ret 3; }
        if (res_tail.err.native.written != 4)                              { ret 4; }
        if (res_tail.err.native.error.kind != io_error.RESOURCE_EXHAUSTED) { ret 5; }
        if (pushed(?b) != 6 || !bytes_equal(?out[0], "abcdef", 6))         { ret 6; }
        if (!b.failed)                                                     { ret 7; }
        ret 0;
    }

    # a growing memory whose allocator refuses fails natively and keeps what it
    # held, at the first allocation and at a later growth alike
    test memory__a_refused_growth_keeps_the_memory_unchanged {
        var tracker:  T.Testing;
        val err_made: err[A.Error] = T.init(?tracker);
        if (sel err_made.err) { ret 10; }
        fin { T.dnit(?tracker); }
        var m: Memory;
        var w: Writer = memory_growing(?m, T.allocator_of(?tracker));
        T.fail_at_ordinal(?tracker, T.attempt_count(?tracker) + 1);
        val res_first: res[usize, WriteError] = write(?w, "abc", 3);
        if (!sel res_first.err)                                                                                         { ret 1; }
        if (!sel res_first.err.native)                                                                                  { ret 2; }
        if (res_first.err.native.error.kind != io_error.RESOURCE_EXHAUSTED || m.buf != nil || m.cap != 0 || m.len != 0) { ret 3; }
        T.clear_failure(?tracker);
        val err_held: err[WriteError] = write_str(?w, "abc");
        if (!sel err_held.ok) { ret 4; }
        val held:     *u8   = m.buf;
        val held_cap: usize = m.cap;
        T.fail_at_ordinal(?tracker, T.attempt_count(?tracker) + 1);
        var large:     [100]u8;
        val res_grown: res[usize, WriteError] = write(?w, ?large[0], 100);
        T.clear_failure(?tracker);
        if (!sel res_grown.err)                                                                                                 { ret 5; }
        if (!sel res_grown.err.native)                                                                                          { ret 6; }
        if (res_grown.err.native.error.kind != io_error.RESOURCE_EXHAUSTED || m.buf != held || m.cap != held_cap || m.len != 3) { ret 7; }
        if (!str_equals(memory_text(?m), "abc"))                                                                                { ret 8; }
        memory_dnit(?m);
        if (T.leaked(?tracker)) { ret 9; }
        ret 0;
    }
}
