# opaque native-width resource handles

use std.sync.atomic;
use std.types.bool.bool;
use std.types.size.isize;
use std.types.size.usize;

# file handle owned by the filesystem layer
pub rec FileHandle {
    value: usize;
}

# socket handle owned by the networking layer
#
# opening tells one socket from another that later reuses its native value.
# the networking layer stamps it once, when it opens or accepts the socket,
# and every copy of the handle carries the same stamp. an async driver keys
# its state by value and opening together, so a socket closed outside its
# driver is detected on the next submission rather than mistaken for the
# socket that took over its value
pub rec SocketHandle {
    value:   usize;
    opening: u64;
}

pub val INVALID_VALUE: usize = (-1)::isize::usize;

var next_opening: i64 = 0;

pub fun invalid_file() FileHandle {
    ret FileHandle{value: INVALID_VALUE};
}

pub fun invalid_socket() SocketHandle {
    ret SocketHandle{value: INVALID_VALUE, opening: 0};
}

# a handle for a native socket this process has just opened or accepted
#
# each call stamps a new opening, so wrap a native socket exactly once and pass
# the handle around. two handles made from one live socket look like two
# sockets, and an async driver treats the older one as closed
# ---
# value: the native socket
# ret:   the handle, with an opening no other handle in this process shares
pub fun socket(value: usize) SocketHandle {
    val opening: i64 = atomic.fetch_add(?next_opening, 1) + 1;
    ret SocketHandle{value: value, opening: opening::u64};
}

pub fun file_is_valid(handle: FileHandle) bool {
    ret handle.value != INVALID_VALUE;
}

pub fun socket_is_valid(handle: SocketHandle) bool {
    ret handle.value != INVALID_VALUE;
}

test "handle: native width preserves every bit" {
    val raw:    usize        = (-2)::isize::usize;
    val socket: SocketHandle = SocketHandle{value: raw, opening: 7};
    val file:   FileHandle   = FileHandle{value: raw};
    if (socket.value != raw) { ret 1; }
    if (file.value != raw)   { ret 1; }
    ret 0;
}

test "handle: invalid sentinels are explicit" {
    if (socket_is_valid(invalid_socket())) { ret 1; }
    if (invalid_socket().opening != 0)     { ret 2; }
    if (file_is_valid(invalid_file()))     { ret 3; }
    ret 0;
}

test "handle: each wrapped socket gets its own opening" {
    val first:  SocketHandle = socket(3);
    val second: SocketHandle = socket(3);
    val copy:   SocketHandle = first;
    if (first.opening == 0)                    { ret 1; }
    if (second.opening == first.opening)       { ret 2; }
    if (copy.opening != first.opening)         { ret 3; }
    if (first.value != 3 || second.value != 3) { ret 4; }
    ret 0;
}
