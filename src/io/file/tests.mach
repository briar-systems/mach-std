fun bytes_equal(data: *u8, expected: *u8, length: usize) bool {
    var i: usize = 0;
    for (i < length) {
        if (data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun cleanup_file(path: Path) {
    filesystem.remove_file(path);
}

fun cleanup_dir(path: Path) {
    filesystem.remove_dir(path);
}

rec RenameRace {
    source:  Path;
    moved:   Path;
    started: *i64;
    failed:  *i64;
}

fun rename_race_worker(arg: *u8) {
    val race: *RenameRace = arg::*RenameRace;
    atomic.store(race.started, 1);
    os.thread_wake(race.started);
    var i: usize = 0;
    for (i < 128) {
        if (O.is_some[str](filesystem.rename(race.source, race.moved)) || O.is_some[str](filesystem.rename(race.moved, race.source))) {
            atomic.store(race.failed, 1);
            ret;
        }
        i = i + 1;
    }
}

test "io.file: positioned reads preserve offset and distinguish eof" {
    val path: Path = "mach-std-io-file-positioned";
    cleanup_file(path);
    if (O.is_some[str](filesystem.write_bytes(path, "abcdef", 6, 0o600))) { ret 1; }
    val opened: R.Result[filesystem.File, io_error.Error] = filesystem.open(path);
    if (R.is_err[filesystem.File, io_error.Error](opened)) { cleanup_file(path); ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](opened);
    var data: [3]u8;
    val first: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 3, 2);
    if (R.is_err[usize, io_error.Error](first) || R.unwrap_ok[usize, io_error.Error](first) != 3 || !bytes_equal((?data)::*u8, "cde"::*u8, 3)) { ret 3; }
    if (R.is_err[i64, io_error.Error](filesystem.seek(file, 0, os.SEEK_CUR)) || R.unwrap_ok[i64, io_error.Error](filesystem.seek(file, 0, os.SEEK_CUR)) != 0) { ret 4; }
    var short_data: [4]u8;
    val short: R.Result[usize, io_error.Error] = read_at(file, (?short_data)::*u8, 4, 4);
    if (R.is_err[usize, io_error.Error](short) || R.unwrap_ok[usize, io_error.Error](short) != 2 || !bytes_equal((?short_data)::*u8, "ef"::*u8, 2)) { ret 5; }
    val eof: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 3, 20);
    filesystem.close(?file);
    if (R.is_err[usize, io_error.Error](eof) || R.unwrap_ok[usize, io_error.Error](eof) != 0) { ret 6; }
    val root_result: R.Result[Root, io_error.Error] = root_open(".");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 7; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var truncate_options: OpenOptions = read_options();
    truncate_options.access = READ_WRITE;
    truncate_options.truncate = true;
    val truncated: R.Result[filesystem.File, io_error.Error] = open_confined(?root, path, truncate_options);
    if (R.is_err[filesystem.File, io_error.Error](truncated)) { ret 8; }
    var truncated_file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](truncated);
    val metadata: R.Result[filesystem.Metadata, io_error.Error] = filesystem.stat_of_error(truncated_file);
    filesystem.close(?truncated_file);
    root_close(?root);
    cleanup_file(path);
    if (R.is_err[filesystem.Metadata, io_error.Error](metadata) || R.unwrap_ok[filesystem.Metadata, io_error.Error](metadata).size != 0) { ret 9; }
    ret 0;
}

test "io.file: confined roots reject traversal and links after rename" {
    val root_path: Path = "mach-std-io-file-root";
    val moved_path: Path = "mach-std-io-file-root-moved";
    val inside_path: Path = "mach-std-io-file-root/inside";
    val moved_inside: Path = "mach-std-io-file-root-moved/inside";
    val outside_path: Path = "mach-std-io-file-outside";
    val outside_dir: Path = "mach-std-io-file-outside-dir";
    val outside_secret: Path = "mach-std-io-file-outside-dir/secret";
    val link_path: Path = "mach-std-io-file-root/link";
    val link_dir: Path = "mach-std-io-file-root/link-dir";
    val moved_link: Path = "mach-std-io-file-root-moved/link";
    val moved_link_dir: Path = "mach-std-io-file-root-moved/link-dir";
    cleanup_file(link_path);
    cleanup_file(link_dir);
    cleanup_file(moved_link);
    cleanup_file(moved_link_dir);
    cleanup_file(inside_path);
    cleanup_file(moved_inside);
    cleanup_file(outside_path);
    cleanup_file(outside_secret);
    cleanup_dir(outside_dir);
    cleanup_dir(root_path);
    cleanup_dir(moved_path);
    if (O.is_some[str](filesystem.create_dir(root_path, 0o700)) || O.is_some[str](filesystem.create_dir(outside_dir, 0o700)) || O.is_some[str](filesystem.write_bytes(inside_path, "inside", 6, 0o600)) || O.is_some[str](filesystem.write_bytes(outside_path, "outside", 7, 0o600)) || O.is_some[str](filesystem.write_bytes(outside_secret, "secret", 6, 0o600))) { ret 1; }
    val root_result: R.Result[Root, io_error.Error] = root_open(root_path);
    if (R.is_err[Root, io_error.Error](root_result)) { ret 2; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    if (!R.is_err[filesystem.File, io_error.Error](open_confined(?root, "../mach-std-io-file-outside", read_options()))) { ret 3; }
    if (O.is_some[str](filesystem.symlink("../mach-std-io-file-outside", link_path))) { ret 4; }
    if (!R.is_err[filesystem.File, io_error.Error](open_confined(?root, "link", read_options()))) { ret 5; }
    if (O.is_some[str](filesystem.symlink("../mach-std-io-file-outside-dir", link_dir)) || !R.is_err[filesystem.File, io_error.Error](open_confined(?root, "link-dir/secret", read_options()))) { ret 6; }

    var started: i64 = 0;
    var failed: i64 = 0;
    var race: RenameRace = RenameRace{source: root_path, moved: moved_path, started: ?started, failed: ?failed};
    var race_thread: thread.Thread;
    thread.spawn_with(rename_race_worker, (?race)::*u8, ?race_thread);
    if (race_thread.tid < 0) { ret 7; }
    for (atomic.load(?started) == 0) { os.thread_wait(?started, 0); }
    var round: usize = 0;
    var observed_failure: i64 = 0;
    for (round < 128 && observed_failure == 0) {
        val raced: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "inside", read_options());
        if (R.is_err[filesystem.File, io_error.Error](raced)) { observed_failure = 8; }
        or {
            var raced_file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](raced);
            var raced_data: [6]u8;
            val raced_read: R.Result[usize, io_error.Error] = read_at(raced_file, (?raced_data)::*u8, 6, 0);
            filesystem.close(?raced_file);
            if (R.is_err[usize, io_error.Error](raced_read) || !bytes_equal((?raced_data)::*u8, "inside"::*u8, 6)) { observed_failure = 9; }
        }
        round = round + 1;
    }
    thread.join(?race_thread);
    if (observed_failure != 0) { ret observed_failure::i32; }
    if (atomic.load(?failed) != 0) { ret 10; }
    if (O.is_some[str](filesystem.rename(root_path, moved_path)) || O.is_some[str](filesystem.create_dir(root_path, 0o700)) || O.is_some[str](filesystem.write_bytes(inside_path, "wrong", 5, 0o600))) { ret 11; }
    val confined: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "inside", read_options());
    if (R.is_err[filesystem.File, io_error.Error](confined)) { ret 12; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](confined);
    val before: R.Result[filesystem.Metadata, io_error.Error] = filesystem.stat_of_error(file);
    cleanup_file(moved_inside);
    val after: R.Result[filesystem.Metadata, io_error.Error] = filesystem.stat_of_error(file);
    var data: [6]u8;
    val read_result: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 6, 0);
    filesystem.close(?file);
    if (R.is_err[filesystem.Metadata, io_error.Error](before) || R.is_err[filesystem.Metadata, io_error.Error](after) || !filesystem.identity_equal(R.unwrap_ok[filesystem.Metadata, io_error.Error](before).identity, R.unwrap_ok[filesystem.Metadata, io_error.Error](after).identity)) { ret 13; }
    if (R.is_err[usize, io_error.Error](read_result) || R.unwrap_ok[usize, io_error.Error](read_result) != 6 || !bytes_equal((?data)::*u8, "inside"::*u8, 6)) { ret 14; }
    root_close(?root);
    cleanup_file(link_path);
    cleanup_file(link_dir);
    cleanup_file(moved_link);
    cleanup_file(moved_link_dir);
    cleanup_file(inside_path);
    cleanup_file(outside_path);
    cleanup_file(outside_secret);
    cleanup_dir(outside_dir);
    cleanup_dir(root_path);
    cleanup_dir(moved_path);
    ret 0;
}

test "io.file: confined replacement is atomic and durable" {
    val root_path: Path = "mach-std-io-file-replace-root";
    val temporary_path: Path = "mach-std-io-file-replace-root/new";
    val destination_path: Path = "mach-std-io-file-replace-root/current";
    cleanup_file(temporary_path);
    cleanup_file(destination_path);
    cleanup_dir(root_path);
    if (O.is_some[str](filesystem.create_dir(root_path, 0o700)) || O.is_some[str](filesystem.write_bytes(temporary_path, "new", 3, 0o600)) || O.is_some[str](filesystem.write_bytes(destination_path, "old", 3, 0o600))) { ret 1; }
    val root_result: R.Result[Root, io_error.Error] = root_open(root_path);
    if (R.is_err[Root, io_error.Error](root_result)) { ret 2; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    if (R.is_err[bool, io_error.Error](replace_confined(?root, "new", "current"))) { ret 3; }
    if (!R.is_err[filesystem.File, io_error.Error](open_confined(?root, "new", read_options()))) { ret 4; }
    val opened: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "current", read_options());
    if (R.is_err[filesystem.File, io_error.Error](opened)) { ret 5; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](opened);
    var data: [3]u8;
    val result: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 3, 0);
    filesystem.close(?file);
    root_close(?root);
    cleanup_file(destination_path);
    cleanup_dir(root_path);
    if (R.is_err[usize, io_error.Error](result) || !bytes_equal((?data)::*u8, "new"::*u8, 3)) { ret 6; }
    ret 0;
}

test "io.file: portable watch scan reports create modify replace remove" {
    val path: Path = "mach-std-io-file-watch";
    val replacement: Path = "mach-std-io-file-watch-new";
    cleanup_file(path);
    cleanup_file(replacement);
    val root_result: R.Result[Root, io_error.Error] = root_open(".");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 1; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var watch: Watch;
    val opened: R.Result[bool, io_error.Error] = watch_open(?watch, ?root, path);
    if (R.is_err[bool, io_error.Error](opened) || R.unwrap_ok[bool, io_error.Error](opened)) { ret 2; }
    val unchanged: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](unchanged) || R.unwrap_ok[WatchEvent, io_error.Error](unchanged) != WATCH_UNCHANGED) { ret 3; }
    if (O.is_some[str](filesystem.write_bytes(path, "a", 1, 0o600))) { ret 4; }
    val created: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](created) || R.unwrap_ok[WatchEvent, io_error.Error](created) != WATCH_CREATED) { ret 5; }
    var append_options: OpenOptions = read_options();
    append_options.access = READ_WRITE;
    val appended: R.Result[filesystem.File, io_error.Error] = open_confined(?root, path, append_options);
    if (R.is_err[filesystem.File, io_error.Error](appended)) { ret 6; }
    var append_file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](appended);
    if (R.is_err[usize, io_error.Error](write_at(append_file, "b"::*u8, 1, 1))) { ret 7; }
    filesystem.close(?append_file);
    val modified: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](modified) || R.unwrap_ok[WatchEvent, io_error.Error](modified) != WATCH_MODIFIED) { ret 8; }
    if (O.is_some[str](filesystem.write_bytes(replacement, "z", 1, 0o600)) || O.is_some[str](filesystem.rename(replacement, path))) { ret 9; }
    val replaced: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](replaced) || R.unwrap_ok[WatchEvent, io_error.Error](replaced) != WATCH_REPLACED) { ret 10; }
    if (O.is_some[str](filesystem.remove_file(path))) { ret 11; }
    val removed: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](removed) || R.unwrap_ok[WatchEvent, io_error.Error](removed) != WATCH_REMOVED) { ret 12; }
    if (!watch_close(?watch) || R.is_err[bool, io_error.Error](root_close(?root))) { ret 13; }
    cleanup_file(path);
    cleanup_file(replacement);
    ret 0;
}

test "io.file: mapping sync persists mutations" {
    val path: Path = "mach-std-io-file-mapping";
    cleanup_file(path);
    if (O.is_some[str](filesystem.write_bytes(path, "old!", 4, 0o600))) { ret 1; }
    val root_result: R.Result[Root, io_error.Error] = root_open(".");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 2; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var options: OpenOptions = read_options();
    options.access = READ_WRITE;
    val opened: R.Result[filesystem.File, io_error.Error] = open_confined(?root, path, options);
    if (R.is_err[filesystem.File, io_error.Error](opened)) { ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](opened);
    val mapped: R.Result[Mapping, io_error.Error] = map(file, 0, 4, true);
    if (R.is_err[Mapping, io_error.Error](mapped)) { ret 3; }
    var region: Mapping = R.unwrap_ok[Mapping, io_error.Error](mapped);
    val bytes: *u8 = region.data::*u8;
    bytes[0] = 'n';
    bytes[1] = 'e';
    bytes[2] = 'w';
    bytes[3] = '!';
    if (R.is_err[bool, io_error.Error](mapping_sync(?region)) || R.is_err[bool, io_error.Error](mapping_close(?region))) { ret 4; }
    var data: [4]u8;
    val result: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 4, 0);
    filesystem.close(?file);
    root_close(?root);
    cleanup_file(path);
    if (R.is_err[usize, io_error.Error](result) || !bytes_equal((?data)::*u8, "new!"::*u8, 4)) { ret 5; }
    ret 0;
}

test "io.file: target disk-full errors remain resource exhaustion" {
    $if ($mach.build.os != $mach.os.linux) { ret 0; }
    val root_result: R.Result[Root, io_error.Error] = root_open("/dev");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 1; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var options: OpenOptions = read_options();
    options.access = WRITE_ONLY;
    val opened: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "full", options);
    if (R.is_err[filesystem.File, io_error.Error](opened)) { ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](opened);
    val result: R.Result[usize, io_error.Error] = write_at(file, "x"::*u8, 1, 0);
    filesystem.close(?file);
    root_close(?root);
    if (!R.is_err[usize, io_error.Error](result)) { ret 3; }
    val write_error: io_error.Error = R.unwrap_err[usize, io_error.Error](result);
    if (write_error.code != os.ENOSPC || write_error.kind != io_error.RESOURCE_EXHAUSTED) { ret 4; }
    ret 0;
}

test "io.file: portable transfer reports fallback and preserves offsets" {
    val target_capabilities: Capabilities = capabilities();
    if (!target_capabilities.positioned_io || !target_capabilities.bounded_workers || !target_capabilities.confined_open || target_capabilities.accelerated_transfer) { ret 1; }
    val source_path: Path = "mach-std-io-file-transfer-source";
    val destination_path: Path = "mach-std-io-file-transfer-destination";
    cleanup_file(source_path);
    cleanup_file(destination_path);
    if (O.is_some[str](filesystem.write_bytes(source_path, "abcdef", 6, 0o600)) || O.is_some[str](filesystem.write_bytes(destination_path, "______", 6, 0o600))) { ret 2; }
    val source_result: R.Result[filesystem.File, io_error.Error] = filesystem.open(source_path);
    if (R.is_err[filesystem.File, io_error.Error](source_result)) { ret 3; }
    var source: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](source_result);
    var options: OpenOptions = read_options();
    options.access = READ_WRITE;
    val root_result: R.Result[Root, io_error.Error] = root_open(".");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 4; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    val destination_result: R.Result[filesystem.File, io_error.Error] = open_confined(?root, destination_path, options);
    if (R.is_err[filesystem.File, io_error.Error](destination_result)) { ret 5; }
    var destination: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](destination_result);
    val copied: R.Result[TransferReport, io_error.Error] = transfer(source, destination, 1, 2, 3);
    var data: [6]u8;
    val result: R.Result[usize, io_error.Error] = read_at(destination, (?data)::*u8, 6, 0);
    filesystem.close(?source);
    filesystem.close(?destination);
    root_close(?root);
    cleanup_file(source_path);
    cleanup_file(destination_path);
    if (R.is_err[TransferReport, io_error.Error](copied) || R.unwrap_ok[TransferReport, io_error.Error](copied).bytes != 3 || R.unwrap_ok[TransferReport, io_error.Error](copied).accelerated) { ret 6; }
    if (R.is_err[usize, io_error.Error](result) || !bytes_equal((?data)::*u8, "__bcd_"::*u8, 6)) { ret 7; }
    ret 0;
}

rec BlockTask {
    entered: *i64;
    release: *i64;
}

fun block_worker(context: ptr) bool {
    val task: *BlockTask = context::*BlockTask;
    atomic.store(task.entered, 1);
    os.thread_wake(task.entered);
    for (atomic.load(task.release) == 0) { os.thread_wait(task.release, 0); }
    ret true;
}

fun wait_one(runtime: *io_runtime.Runtime, completion: *io_runtime.Completion) R.Result[usize, io_error.Error] {
    val deadline: time.Time = time.time_add(time.monotonic(), 10000000000);
    for (true) {
        val remaining: i64 = time.time_sub(deadline, time.monotonic());
        if (remaining <= 0) { ret R.ok[usize, io_error.Error](0); }
        var timeout_ms: i64 = (remaining + 999999) / 1000000;
        if (timeout_ms > 0x7fffffff) { timeout_ms = 0x7fffffff; }
        val result: R.Result[usize, io_error.Error] = io_runtime.wait(runtime, completion, 1, timeout_ms::i32);
        if (R.is_err[usize, io_error.Error](result) || R.unwrap_ok[usize, io_error.Error](result) != 0) { ret result; }
    }
    ret R.ok[usize, io_error.Error](0);
}

test "io.file: worker fallback copies writes and publishes positioned reads" {
    val root_path: Path = "mach-std-io-file-async-root";
    val file_path: Path = "mach-std-io-file-async-root/data";
    cleanup_file(file_path);
    cleanup_dir(root_path);
    if (O.is_some[str](filesystem.create_dir(root_path, 0o700))) { ret 1; }
    val root_result: R.Result[Root, io_error.Error] = root_open(root_path);
    if (R.is_err[Root, io_error.Error](root_result)) { ret 2; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var options: OpenOptions = write_options(0o600);
    options.access = READ_WRITE;
    options.truncate = true;
    val file_result: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "data", options);
    if (R.is_err[filesystem.File, io_error.Error](file_result)) { ret 3; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](file_result);
    var runtime: io_runtime.Runtime;
    if (R.is_err[bool, io_error.Error](io_runtime.make(?runtime, 4))) { ret 4; }
    var requests: [4]Request;
    var scratch: [64]u8;
    var tasks: [4]worker_pool.Task;
    var abort_tasks: [4]worker_pool.Task;
    var threads: [2]thread.Thread;
    var workers: [2]worker_pool.Worker;
    var adapter: Adapter;
    if (R.is_err[bool, io_error.Error](make(?adapter, ?runtime, (?requests)::*Request, 4, (?scratch)::*u8, 64, 16, (?tasks)::*worker_pool.Task, (?abort_tasks)::*worker_pool.Task, (?threads)::*thread.Thread, (?workers)::*worker_pool.Worker, 2))) { ret 5; }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 6; }
    var input: [5]u8;
    memory.raw_copy((?input)::ptr, "hello"::ptr, 5);
    if (R.is_err[io_runtime.Token, io_error.Error](submit_write(?adapter, ?scope, ?file, (?input)::*u8, 5, 3, 61))) { ret 7; }
    memory.raw_fill((?input)::ptr, 'x', 5);
    var completion: io_runtime.Completion;
    val written: R.Result[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (R.is_err[usize, io_error.Error](written)) { ret 20; }
    if (R.unwrap_ok[usize, io_error.Error](written) != 1) { ret 21; }
    if (completion.bytes != 5) { ret 22; }
    if (completion.context != 61) { ret 23; }
    if (completion.has_error) { ret 24; }
    var output: [8]u8;
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?scope, ?file, (?output)::*u8, 8, 0, 62))) { ret 9; }
    val read_result: R.Result[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (R.is_err[usize, io_error.Error](read_result) || R.unwrap_ok[usize, io_error.Error](read_result) != 1 || completion.bytes != 8 || completion.end_of_stream || completion.has_error) { ret 10; }
    if (output[0] != 0 || output[1] != 0 || output[2] != 0 || !bytes_equal(((?output)::usize + 3)::*u8, "hello"::*u8, 5)) { ret 11; }
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?scope, ?file, (?output)::*u8, 8, 100, 63))) { ret 12; }
    val eof: R.Result[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (R.is_err[usize, io_error.Error](eof)) { ret 13; }
    if (completion.bytes != 0) { ret 14; }
    if (!completion.end_of_stream) { ret 15; }
    if (completion.has_error) { ret 16; }
    if (R.is_err[bool, io_error.Error](shutdown_drain(?adapter)) || R.is_err[bool, io_error.Error](destroy(?adapter))) { ret 17; }
    if (!cancel.destroy(?scope)) { ret 18; }
    io_runtime.close(?runtime);
    if (R.is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 19; }
    filesystem.close(?file);
    root_close(?root);
    cleanup_file(file_path);
    cleanup_dir(root_path);
    ret 0;
}

test "io.file: queued cancellation and deadline leave read bytes untouched" {
    val path: Path = "mach-std-io-file-cancel";
    cleanup_file(path);
    if (O.is_some[str](filesystem.write_bytes(path, "secret", 6, 0o600))) { ret 1; }
    val file_result: R.Result[filesystem.File, io_error.Error] = filesystem.open(path);
    if (R.is_err[filesystem.File, io_error.Error](file_result)) { ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](file_result);
    var runtime: io_runtime.Runtime;
    if (R.is_err[bool, io_error.Error](io_runtime.make(?runtime, 1))) { ret 3; }
    var requests: [1]Request;
    var scratch: [8]u8;
    var tasks: [1]worker_pool.Task;
    var abort_tasks: [1]worker_pool.Task;
    var threads: [1]thread.Thread;
    var workers: [1]worker_pool.Worker;
    var adapter: Adapter;
    if (R.is_err[bool, io_error.Error](make(?adapter, ?runtime, (?requests)::*Request, 1, (?scratch)::*u8, 8, 8, (?tasks)::*worker_pool.Task, (?abort_tasks)::*worker_pool.Task, (?threads)::*thread.Thread, (?workers)::*worker_pool.Worker, 1))) { ret 4; }
    var entered: i64 = 0;
    var release: i64 = 0;
    var blocker: BlockTask = BlockTask{entered: ?entered, release: ?release};
    if (worker_pool.submit(?adapter.pool, worker_pool.Task{context: ?blocker, run: block_worker}) != worker_pool.ACCEPTED) { ret 5; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 6; }
    var output: [6]u8;
    memory.raw_fill((?output)::ptr, 9, 6);
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?scope, ?file, (?output)::*u8, 6, 0, 70)) || !cancel.cancel(?scope)) { ret 7; }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    var completion: io_runtime.Completion;
    val cancelled: R.Result[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (R.is_err[usize, io_error.Error](cancelled) || R.unwrap_ok[usize, io_error.Error](cancelled) != 1 || !completion.has_error || completion.error.kind != io_error.CANCELLED) { ret 8; }
    var i: usize = 0;
    for (i < 6) { if (output[i] != 9) { ret 9; } i = i + 1; }
    atomic.store(?entered, 0);
    atomic.store(?release, 0);
    if (worker_pool.submit(?adapter.pool, worker_pool.Task{context: ?blocker, run: block_worker}) != worker_pool.ACCEPTED) { ret 10; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    var deadline_scope: cancel.Scope;
    if (!cancel.make_root(?deadline_scope, true, time.monotonic())) { ret 11; }
    memory.raw_fill((?output)::ptr, 8, 6);
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?deadline_scope, ?file, (?output)::*u8, 6, 0, 71))) { ret 12; }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    val timed_out: R.Result[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (R.is_err[usize, io_error.Error](timed_out) || R.unwrap_ok[usize, io_error.Error](timed_out) != 1 || !completion.has_error || completion.error.kind != io_error.TIMEOUT) { ret 13; }
    i = 0;
    for (i < 6) { if (output[i] != 8) { ret 14; } i = i + 1; }
    if (R.is_err[bool, io_error.Error](shutdown_drain(?adapter)) || R.is_err[bool, io_error.Error](destroy(?adapter))) { ret 15; }
    if (!cancel.destroy(?scope) || !cancel.destroy(?deadline_scope)) { ret 16; }
    io_runtime.close(?runtime);
    if (R.is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 17; }
    filesystem.close(?file);
    cleanup_file(path);
    ret 0;
}

test "io.file: runtime close never exposes worker scratch" {
    val path: Path = "mach-std-io-file-race";
    cleanup_file(path);
    if (O.is_some[str](filesystem.write_bytes(path, "secret", 6, 0o600))) { ret 1; }
    val file_result: R.Result[filesystem.File, io_error.Error] = filesystem.open(path);
    if (R.is_err[filesystem.File, io_error.Error](file_result)) { ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](file_result);
    var runtime: io_runtime.Runtime;
    if (R.is_err[bool, io_error.Error](io_runtime.make(?runtime, 1))) { ret 3; }
    var requests: [1]Request;
    var scratch: [8]u8;
    var tasks: [1]worker_pool.Task;
    var abort_tasks: [1]worker_pool.Task;
    var threads: [1]thread.Thread;
    var workers: [1]worker_pool.Worker;
    var adapter: Adapter;
    if (R.is_err[bool, io_error.Error](make(?adapter, ?runtime, (?requests)::*Request, 1, (?scratch)::*u8, 8, 8, (?tasks)::*worker_pool.Task, (?abort_tasks)::*worker_pool.Task, (?threads)::*thread.Thread, (?workers)::*worker_pool.Worker, 1))) { ret 4; }
    var entered: i64 = 0;
    var release: i64 = 0;
    var blocker: BlockTask = BlockTask{entered: ?entered, release: ?release};
    if (worker_pool.submit(?adapter.pool, worker_pool.Task{context: ?blocker, run: block_worker}) != worker_pool.ACCEPTED) { ret 5; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 6; }
    var output: [6]u8;
    memory.raw_fill((?output)::ptr, 9, 6);
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?scope, ?file, (?output)::*u8, 6, 0, 71))) { ret 7; }
    if (R.is_err[bool, io_error.Error](io_runtime.close(?runtime))) { ret 8; }
    var completion: io_runtime.Completion;
    val closed: R.Result[usize, io_error.Error] = io_runtime.poll(?runtime, ?completion, 1);
    if (R.is_err[usize, io_error.Error](closed) || R.unwrap_ok[usize, io_error.Error](closed) != 1 || !completion.has_error || completion.error.kind != io_error.CLOSED) { ret 9; }
    memory.raw_fill((?output)::ptr, 7, 6);
    atomic.store(?release, 1);
    os.thread_wake(?release);
    if (R.is_err[bool, io_error.Error](shutdown_drain(?adapter)) || R.is_err[bool, io_error.Error](destroy(?adapter))) { ret 10; }
    var i: usize = 0;
    for (i < 6) { if (output[i] != 7) { ret 11; } i = i + 1; }
    val repeated: R.Result[usize, io_error.Error] = io_runtime.poll(?runtime, ?completion, 1);
    if (R.is_err[usize, io_error.Error](repeated) || R.unwrap_ok[usize, io_error.Error](repeated) != 0) { ret 12; }
    if (!cancel.destroy(?scope) || R.is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 13; }
    filesystem.close(?file);
    cleanup_file(path);
    ret 0;
}
