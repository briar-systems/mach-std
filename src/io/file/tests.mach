# native file contract tests

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.path.Path;
use std.chrono.time;
use std.filesystem;
use std.memory;
use std.system.os;
$if ($mach.build.os == $mach.os.windows) {
    use windows_os: std.system.os.windows;
}
use std.sync.atomic;
use std.sync.cancel;
use std.sync.thread;
use std.sync.worker_pool;
use io_error: std.io.error;
use io_runtime: std.io.runtime;
use file_api: std.io.file;
use std.io.file.Capabilities;
use std.io.file.Mapping;
use std.io.file.OpenOptions;
use std.io.file.READ_WRITE;
use std.io.file.Request;
use std.io.file.Root;
use std.io.file.TransferReport;
use std.io.file.WATCH_CREATED;
use std.io.file.WATCH_MODIFIED;
use std.io.file.WATCH_REMOVED;
use std.io.file.WATCH_REPLACED;
use std.io.file.WATCH_UNCHANGED;
use std.io.file.WRITE_ONLY;
use std.io.file.Watch;
use std.io.file.WatchEvent;
use std.io.file.destroy;
use std.io.file.capabilities;
use std.io.file.make;
use std.io.file.map;
use std.io.file.mapping_close;
use std.io.file.mapping_sync;
use std.io.file.open_confined;
use std.io.file.read_at;
use std.io.file.read_options;
use std.io.file.replace_confined;
use std.io.file.root_close;
use std.io.file.root_open;
use std.io.file.shutdown_drain;
use std.io.file.submit_read;
use std.io.file.submit_write;
use std.io.file.transfer;
use std.io.file.watch_close;
use std.io.file.watch_open;
use std.io.file.watch_scan;
use std.io.file.write_at;
use std.io.file.write_options;

fun ok_err(r: err[io_error.Error]) bool { ret sel r.ok; }
fun ok_bool(r: res[bool, io_error.Error]) bool { ret sel r.ok; }
fun ok_usize(r: res[usize, io_error.Error]) bool { ret sel r.ok; }
fun ok_file(r: res[filesystem.File, io_error.Error]) bool { ret sel r.ok; }
fun fs_refused(r: err[io_error.Error]) bool { ret sel r.err; }
fun fs_write_refused(r: err[filesystem.FsError]) bool { ret sel r.err; }
fun ok_mapping(r: res[Mapping, io_error.Error]) bool { ret sel r.ok; }
fun ok_transfer(r: res[TransferReport, io_error.Error]) bool { ret sel r.ok; }
fun ok_event(r: res[WatchEvent, io_error.Error]) bool { ret sel r.ok; }
fun ok_token(r: res[io_runtime.Token, io_error.Error]) bool { ret sel r.ok; }

fun bytes_equal(data: *u8, expected: *u8, length: usize) bool {
    var i: usize = 0;
    for (i < length) {
        if (data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun fill_utf8_name(output: *u8, units: usize) {
    var i: usize = 0;
    for (i < units) {
        output[i * 2] = 0xc3;
        output[i * 2 + 1] = 0xa9;
        i = i + 1;
    }
    output[units * 2] = 0;
}

fun cleanup_file(path: Path) {
    filesystem.remove_file(path);
}

fun cleanup_dir(path: Path) {
    filesystem.remove_dir(path);
}

rec RenameRace {
    source:  Path;
    moved:   Path;
    phase:   *i64;
    failed:  *i64;
}

fun rename_race_fail(race: *RenameRace) {
    atomic.store(race.failed, 1);
    atomic.store(race.phase, -1);
    os.thread_wake(race.phase);
}

fun rename_race_worker(arg: *u8) {
    val race: *RenameRace = arg::*RenameRace;
    var i: usize = 0;
    for (i < 128) {
        if (fs_refused(filesystem.rename(race.source, race.moved))) { rename_race_fail(race); ret; }
        atomic.store(race.phase, 1);
        os.thread_wake(race.phase);
        for (atomic.load(race.phase) == 1) { os.thread_wait(race.phase, 1); }
        if (fs_refused(filesystem.rename(race.moved, race.source))) { rename_race_fail(race); ret; }
        atomic.store(race.phase, 3);
        os.thread_wake(race.phase);
        for (atomic.load(race.phase) == 3) { os.thread_wait(race.phase, 3); }
        if (atomic.load(race.phase) < 0) { ret; }
        i = i + 1;
    }
}

test "io.file: positioned reads preserve offset and distinguish eof" {
    val path: Path = "mach-std-io-file-positioned";
    cleanup_file(path);
    if (fs_write_refused(filesystem.write_bytes(path, "abcdef", 6, 0o600))) { ret 1; }
    val opened: res[filesystem.File, io_error.Error] = filesystem.open(path);
    if (sel opened.err) { cleanup_file(path); ret 2; }
    var file: filesystem.File = opened.ok;
    var data: [3]u8;
    val first: res[usize, io_error.Error] = read_at(file, (?data)::*u8, 3, 2);
    if (sel first.err) { ret 3; }
    if (first.ok != 3) { ret 3; }
    if (!bytes_equal((?data)::*u8, "cde"::*u8, 3)) { ret 3; }
    val position: res[i64, io_error.Error] = filesystem.seek(file, 0, os.SEEK_CUR);
    if (sel position.err) { ret 4; }
    if (position.ok != 0) { ret 4; }
    var short_data: [4]u8;
    val short: res[usize, io_error.Error] = read_at(file, (?short_data)::*u8, 4, 4);
    if (sel short.err) { ret 5; }
    if (short.ok != 2) { ret 5; }
    if (!bytes_equal((?short_data)::*u8, "ef"::*u8, 2)) { ret 5; }
    val eof: res[usize, io_error.Error] = read_at(file, (?data)::*u8, 3, 20);
    filesystem.close(?file);
    if (sel eof.err) { ret 6; }
    if (eof.ok != 0) { ret 6; }
    var root: Root;
    val root_result: err[io_error.Error] = root_open(?root, ".");
    if (sel root_result.err) { ret 7; }
    var truncate_options: OpenOptions = read_options();
    truncate_options.access = READ_WRITE;
    truncate_options.truncate = true;
    val truncated: res[filesystem.File, io_error.Error] = open_confined(?root, path, truncate_options);
    if (sel truncated.err) { ret 8; }
    var truncated_file: filesystem.File = truncated.ok;
    val metadata: res[filesystem.Metadata, io_error.Error] = filesystem.stat_of(truncated_file);
    filesystem.close(?truncated_file);
    root_close(?root);
    cleanup_file(path);
    if (sel metadata.err) { ret 9; }
    if (metadata.ok.size != 0) { ret 9; }
    ret 0;
}

test "io.file: confined roots reject traversal and links after rename" {
    val root_path: Path = "mach-std-io-file-root";
    val moved_path: Path = "mach-std-io-file-root-moved";
    val inside_path: Path = "mach-std-io-file-root/inside";
    val moved_inside: Path = "mach-std-io-file-root-moved/inside";
    val outside_path: Path = "mach-std-io-file-outside";
    val outside_dir: Path = "mach-std-io-file-outside-dir";
    val outside_secret: Path = "mach-std-io-file-outside-dir/secret";
    val link_path: Path = "mach-std-io-file-root/link";
    val link_dir: Path = "mach-std-io-file-root/link-dir";
    val moved_link: Path = "mach-std-io-file-root-moved/link";
    val moved_link_dir: Path = "mach-std-io-file-root-moved/link-dir";
    cleanup_file(link_path);
    cleanup_file(link_dir);
    cleanup_file(moved_link);
    cleanup_file(moved_link_dir);
    cleanup_file(inside_path);
    cleanup_file(moved_inside);
    cleanup_file(outside_path);
    cleanup_file(outside_secret);
    cleanup_dir(outside_dir);
    cleanup_dir(root_path);
    cleanup_dir(moved_path);
    if (fs_refused(filesystem.create_dir(root_path, 0o700)) || fs_refused(filesystem.create_dir(outside_dir, 0o700)) || fs_write_refused(filesystem.write_bytes(inside_path, "inside", 6, 0o600)) || fs_write_refused(filesystem.write_bytes(outside_path, "outside", 7, 0o600)) || fs_write_refused(filesystem.write_bytes(outside_secret, "secret", 6, 0o600))) { ret 1; }
    var root: Root;
    val root_result: err[io_error.Error] = root_open(?root, root_path);
    if (sel root_result.err) { ret 2; }
    if (ok_file(open_confined(?root, "../mach-std-io-file-outside", read_options()))) { ret 3; }
    if (fs_refused(filesystem.symlink("../mach-std-io-file-outside", link_path))) { ret 4; }
    if (ok_file(open_confined(?root, "link", read_options()))) { ret 5; }
    if (fs_refused(filesystem.symlink("../mach-std-io-file-outside-dir", link_dir)) || ok_file(open_confined(?root, "link-dir/secret", read_options()))) { ret 6; }

    var phase: i64 = 0;
    var failed: i64 = 0;
    var race: RenameRace = RenameRace{source: root_path, moved: moved_path, phase: ?phase, failed: ?failed};
    var race_thread: thread.Thread;
    thread.spawn_with(rename_race_worker, (?race)::*u8, ?race_thread);
    if (race_thread.tid < 0) { ret 7; }
    var round: usize = 0;
    var observed_failure: i64 = 0;
    for (round < 128 && observed_failure == 0) {
        for (atomic.load(?phase) == 0) { os.thread_wait(?phase, 0); }
        if (atomic.load(?failed) != 0 || atomic.load(?phase) != 1) { observed_failure = 10; }
        or {
            val raced: res[filesystem.File, io_error.Error] = open_confined(?root, "inside", read_options());
            if (sel raced.ok) {
                var raced_file: filesystem.File = raced.ok;
                var raced_data: [6]u8;
                val raced_read: res[usize, io_error.Error] = read_at(raced_file, (?raced_data)::*u8, 6, 0);
                filesystem.close(?raced_file);
                if (sel raced_read.err || !bytes_equal((?raced_data)::*u8, "inside"::*u8, 6)) { observed_failure = 9; }
            }
            or { observed_failure = 8; }
            atomic.store(?phase, 2);
            os.thread_wake(?phase);
            for (atomic.load(?phase) == 2) { os.thread_wait(?phase, 2); }
            if (atomic.load(?failed) != 0 || atomic.load(?phase) != 3) { observed_failure = 10; }
            or {
                if (observed_failure != 0) { atomic.store(?phase, -2); }
                or { atomic.store(?phase, 0); }
                os.thread_wake(?phase);
            }
        }
        round = round + 1;
    }
    thread.join(?race_thread);
    if (observed_failure != 0) { ret observed_failure::i32; }
    if (atomic.load(?failed) != 0) { ret 10; }
    if (fs_refused(filesystem.rename(root_path, moved_path)) || fs_refused(filesystem.create_dir(root_path, 0o700)) || fs_write_refused(filesystem.write_bytes(inside_path, "wrong", 5, 0o600))) { ret 11; }
    val confined: res[filesystem.File, io_error.Error] = open_confined(?root, "inside", read_options());
    if (sel confined.err) { ret 12; }
    var file: filesystem.File = confined.ok;
    val before: res[filesystem.Identity, io_error.Error] = filesystem.identity_of(file);
    cleanup_file(moved_inside);
    val after: res[filesystem.Identity, io_error.Error] = filesystem.identity_of(file);
    var data: [6]u8;
    val read_result: res[usize, io_error.Error] = read_at(file, (?data)::*u8, 6, 0);
    filesystem.close(?file);
    if (sel before.err) { ret 13; }
    if (sel after.err) { ret 13; }
    if (!filesystem.identity_equal(before.ok, after.ok)) { ret 13; }
    if (sel read_result.err) { ret 14; }
    if (read_result.ok != 6) { ret 14; }
    if (!bytes_equal((?data)::*u8, "inside"::*u8, 6)) { ret 14; }
    root_close(?root);
    cleanup_file(link_path);
    cleanup_file(link_dir);
    cleanup_file(moved_link);
    cleanup_file(moved_link_dir);
    cleanup_file(inside_path);
    cleanup_file(outside_path);
    cleanup_file(outside_secret);
    cleanup_dir(outside_dir);
    cleanup_dir(root_path);
    cleanup_dir(moved_path);
    ret 0;
}

test "io.file: windows roots and components preserve utf-8 names" {
    $if ($mach.build.os != $mach.os.windows) { ret 0; }
    $or {
        val root_path: Path = "mach-std-io-file-racine-é";
        val leaf_path: Path = "données-雪";
        val cleanup_leaf: Path = "mach-std-io-file-racine-é/leaf-cleanup";
        val cleanup_long: Path = "mach-std-io-file-racine-é/long-cleanup";
        windows_os.remove_file_utf8(cleanup_leaf::*u8);
        windows_os.remove_file_utf8(cleanup_long::*u8);
        windows_os.remove_dir_utf8(root_path::*u8);
        if (windows_os.make_dir_utf8(root_path::*u8) < 0) { ret 1; }
        var root: Root;
        val root_result: err[io_error.Error] = root_open(?root, root_path);
        if (sel root_result.err) { ret 2; }
        val created: res[filesystem.File, io_error.Error] = open_confined(?root, leaf_path, write_options(0o600));
        if (sel created.err) { ret 3; }
        var file: filesystem.File = created.ok;
        val written: res[usize, io_error.Error] = write_at(file, "ok"::*u8, 2, 0);
        filesystem.close(?file);
        if (sel written.err) { ret 4; }
        if (written.ok != 2) { ret 4; }
        val opened: res[filesystem.File, io_error.Error] = open_confined(?root, leaf_path, read_options());
        if (sel opened.err) { ret 5; }
        file = opened.ok;
        var data: [2]u8;
        val read_result: res[usize, io_error.Error] = read_at(file, (?data)::*u8, 2, 0);
        filesystem.close(?file);
        if (sel read_result.err) { ret 6; }
        if (!bytes_equal((?data)::*u8, "ok"::*u8, 2)) { ret 6; }

        var long_name: [511]u8;
        fill_utf8_name((?long_name)::*u8, 255);
        val long_created: res[filesystem.File, io_error.Error] = open_confined(?root, (?long_name)::str, write_options(0o600));
        if (sel long_created.err) { ret 7; }
        file = long_created.ok;
        filesystem.close(?file);
        var overlong_name: [513]u8;
        fill_utf8_name((?overlong_name)::*u8, 256);
        if (ok_file(open_confined(?root, (?overlong_name)::str, write_options(0o600)))) { ret 8; }
        var malformed_name: [2]u8;
        malformed_name[0] = 0xc3;
        malformed_name[1] = 0;
        if (ok_file(open_confined(?root, (?malformed_name)::str, write_options(0o600)))) { ret 9; }
        if (!ok_err(replace_confined(?root, leaf_path, "leaf-cleanup")) || !ok_err(replace_confined(?root, (?long_name)::str, "long-cleanup"))) { ret 10; }
        if (!ok_err(root_close(?root))) { ret 11; }
        if (windows_os.remove_file_utf8(cleanup_leaf::*u8) < 0 || windows_os.remove_file_utf8(cleanup_long::*u8) < 0 || windows_os.remove_dir_utf8(root_path::*u8) < 0) { ret 12; }
        ret 0;
    }
}

test "io.file: confined replacement is atomic and requests durability" {
    val root_path: Path = "mach-std-io-file-replace-root";
    val temporary_path: Path = "mach-std-io-file-replace-root/new";
    val destination_path: Path = "mach-std-io-file-replace-root/current";
    cleanup_file(temporary_path);
    cleanup_file(destination_path);
    cleanup_dir(root_path);
    if (fs_refused(filesystem.create_dir(root_path, 0o700)) || fs_write_refused(filesystem.write_bytes(temporary_path, "new", 3, 0o600)) || fs_write_refused(filesystem.write_bytes(destination_path, "old", 3, 0o600))) { ret 1; }
    var root: Root;
    val root_result: err[io_error.Error] = root_open(?root, root_path);
    if (sel root_result.err) { ret 2; }
    val replaced: err[io_error.Error] = replace_confined(?root, "new", "current");
    if (sel replaced.err) {
        val error: io_error.Error = replaced.err;
        if (error.operation == io_error.OP_OPEN) { ret 31; }
        or (error.operation == io_error.OP_SYNC) { ret 32; }
        or (error.operation == io_error.OP_CLOSE) { ret 33; }
        or (error.code == os.EACCES) { ret 34; }
        or (error.code == os.EINVAL) { ret 35; }
        or (error.code == os.ENOTSUP) { ret 36; }
        or (error.code == os.ENOENT) { ret 37; }
        or { ret 38; }
    }
    if (ok_file(open_confined(?root, "new", read_options()))) { ret 4; }
    val opened: res[filesystem.File, io_error.Error] = open_confined(?root, "current", read_options());
    if (sel opened.err) { ret 5; }
    var file: filesystem.File = opened.ok;
    var data: [3]u8;
    val result: res[usize, io_error.Error] = read_at(file, (?data)::*u8, 3, 0);
    filesystem.close(?file);
    root_close(?root);
    cleanup_file(destination_path);
    cleanup_dir(root_path);
    if (sel result.err) { ret 6; }
    if (!bytes_equal((?data)::*u8, "new"::*u8, 3)) { ret 6; }
    ret 0;
}

test "io.file: portable watch scan reports create modify replace remove" {
    val path: Path = "mach-std-io-file-watch";
    val replacement: Path = "mach-std-io-file-watch-new";
    cleanup_file(path);
    cleanup_file(replacement);
    var root: Root;
    val root_result: err[io_error.Error] = root_open(?root, ".");
    if (sel root_result.err) { ret 1; }
    var watch: Watch;
    val opened: res[bool, io_error.Error] = watch_open(?watch, ?root, path);
    if (sel opened.err) { ret 2; }
    if (opened.ok) { ret 2; }
    val unchanged: res[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (sel unchanged.err) { ret 3; }
    if (unchanged.ok != WATCH_UNCHANGED) { ret 3; }
    if (fs_write_refused(filesystem.write_bytes(path, "a", 1, 0o600))) { ret 4; }
    val created: res[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (sel created.err) { ret 5; }
    if (created.ok != WATCH_CREATED) { ret 5; }
    var append_options: OpenOptions = read_options();
    append_options.access = READ_WRITE;
    val appended: res[filesystem.File, io_error.Error] = open_confined(?root, path, append_options);
    if (sel appended.err) { ret 6; }
    var append_file: filesystem.File = appended.ok;
    if (!ok_usize(write_at(append_file, "b"::*u8, 1, 1))) { ret 7; }
    filesystem.close(?append_file);
    val modified: res[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (sel modified.err) { ret 8; }
    if (modified.ok != WATCH_MODIFIED) { ret 8; }
    if (fs_write_refused(filesystem.write_bytes(replacement, "z", 1, 0o600)) || fs_refused(filesystem.rename(replacement, path))) { ret 9; }
    val replaced: res[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (sel replaced.err) { ret 10; }
    if (replaced.ok != WATCH_REPLACED) { ret 10; }
    if (fs_refused(filesystem.remove_file(path))) { ret 11; }
    val removed: res[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (sel removed.err) { ret 12; }
    if (removed.ok != WATCH_REMOVED) { ret 12; }
    if (!ok_err(watch_close(?watch)) || !ok_err(root_close(?root))) { ret 13; }
    cleanup_file(path);
    cleanup_file(replacement);
    ret 0;
}

test "io.file: mapping sync persists mutations" {
    val path: Path = "mach-std-io-file-mapping";
    cleanup_file(path);
    if (fs_write_refused(filesystem.write_bytes(path, "old!", 4, 0o600))) { ret 1; }
    var root: Root;
    val root_result: err[io_error.Error] = root_open(?root, ".");
    if (sel root_result.err) { ret 2; }
    var options: OpenOptions = read_options();
    options.access = READ_WRITE;
    val opened: res[filesystem.File, io_error.Error] = open_confined(?root, path, options);
    if (sel opened.err) { ret 2; }
    var file: filesystem.File = opened.ok;
    val mapped: res[Mapping, io_error.Error] = map(file, 0, 4, true);
    if (sel mapped.err) { ret 3; }
    var region: Mapping = mapped.ok;
    val bytes: *u8 = region.data::*u8;
    bytes[0] = 'n';
    bytes[1] = 'e';
    bytes[2] = 'w';
    bytes[3] = '!';
    if (!ok_err(mapping_sync(?region)) || !ok_err(mapping_close(?region))) { ret 4; }
    var data: [4]u8;
    val result: res[usize, io_error.Error] = read_at(file, (?data)::*u8, 4, 0);
    filesystem.close(?file);
    root_close(?root);
    cleanup_file(path);
    if (sel result.err) { ret 5; }
    if (!bytes_equal((?data)::*u8, "new!"::*u8, 4)) { ret 5; }
    ret 0;
}

test "io.file: positioned spans reject overflow before platform calls" {
    val path: Path = "mach-std-io-file-offset-boundary";
    cleanup_file(path);
    if (fs_write_refused(filesystem.write_bytes(path, "x", 1, 0o600))) { ret 1; }
    val opened: res[filesystem.File, io_error.Error] = filesystem.open(path);
    if (sel opened.err) { ret 2; }
    var file: filesystem.File = opened.ok;
    val past_max: u64 = 0x8000000000000000;
    if (ok_usize(read_at(file, nil, 0, past_max)) || ok_usize(write_at(file, nil, 0, past_max))) { ret 3; }
    var alignment: usize = os.page_size();
    $if ($mach.build.os == $mach.os.windows) { alignment = 65536; }
    val max_offset: u64 = 0x7fffffffffffffff;
    val aligned_offset: u64 = max_offset - (max_offset % alignment::u64);
    if (ok_mapping(map(file, aligned_offset, alignment, false))) { ret 4; }
    if (ok_transfer(transfer(file, file, max_offset, 0, 1))) { ret 5; }
    if (ok_transfer(transfer(file, file, 0, max_offset, 1))) { ret 6; }
    filesystem.close(?file);
    cleanup_file(path);
    ret 0;
}

test "io.file: failed mapping close retains ownership" {
    var region: Mapping = Mapping{data: 1::ptr, length: 4, offset: 0, writable: false, initialized: true};
    if (ok_err(mapping_close(?region))) { ret 1; }
    if (!region.initialized || region.data != 1::ptr || region.length != 4 || region.offset != 0) { ret 2; }
    ret 0;
}

test "io.file: target disk-full errors remain resource exhaustion" {
    $if ($mach.build.os != $mach.os.linux) { ret 0; }
    var root: Root;
    val root_result: err[io_error.Error] = root_open(?root, "/dev");
    if (sel root_result.err) { ret 1; }
    var options: OpenOptions = read_options();
    options.access = WRITE_ONLY;
    val opened: res[filesystem.File, io_error.Error] = open_confined(?root, "full", options);
    if (sel opened.err) { ret 2; }
    var file: filesystem.File = opened.ok;
    val result: res[usize, io_error.Error] = write_at(file, "x"::*u8, 1, 0);
    filesystem.close(?file);
    root_close(?root);
    if (!sel result.err) { ret 3; }
    val write_error: io_error.Error = result.err;
    if (write_error.code != os.ENOSPC || write_error.kind != io_error.RESOURCE_EXHAUSTED) { ret 4; }
    ret 0;
}

test "io.file: portable transfer reports fallback and preserves offsets" {
    val target_capabilities: Capabilities = capabilities();
    if (!target_capabilities.positioned_io || !target_capabilities.bounded_workers || !target_capabilities.confined_open || !target_capabilities.replacement_flush_request || target_capabilities.replacement_persistence_guaranteed || target_capabilities.accelerated_transfer) { ret 1; }
    val source_path: Path = "mach-std-io-file-transfer-source";
    val destination_path: Path = "mach-std-io-file-transfer-destination";
    cleanup_file(source_path);
    cleanup_file(destination_path);
    if (fs_write_refused(filesystem.write_bytes(source_path, "abcdef", 6, 0o600)) || fs_write_refused(filesystem.write_bytes(destination_path, "______", 6, 0o600))) { ret 2; }
    val source_result: res[filesystem.File, io_error.Error] = filesystem.open(source_path);
    if (sel source_result.err) { ret 3; }
    var source: filesystem.File = source_result.ok;
    var options: OpenOptions = read_options();
    options.access = READ_WRITE;
    var root: Root;
    val root_result: err[io_error.Error] = root_open(?root, ".");
    if (sel root_result.err) { ret 4; }
    val destination_result: res[filesystem.File, io_error.Error] = open_confined(?root, destination_path, options);
    if (sel destination_result.err) { ret 5; }
    var destination: filesystem.File = destination_result.ok;
    val copied: res[TransferReport, io_error.Error] = transfer(source, destination, 1, 2, 3);
    var data: [6]u8;
    val result: res[usize, io_error.Error] = read_at(destination, (?data)::*u8, 6, 0);
    filesystem.close(?source);
    filesystem.close(?destination);
    root_close(?root);
    cleanup_file(source_path);
    cleanup_file(destination_path);
    if (sel copied.err) { ret 6; }
    if (copied.ok.bytes != 3) { ret 6; }
    if (copied.ok.accelerated) { ret 6; }
    if (sel result.err) { ret 7; }
    if (!bytes_equal((?data)::*u8, "__bcd_"::*u8, 6)) { ret 7; }
    ret 0;
}

rec BlockTask {
    entered: *i64;
    release: *i64;
}

fun block_worker(context: ptr) bool {
    val task: *BlockTask = context::*BlockTask;
    atomic.store(task.entered, 1);
    os.thread_wake(task.entered);
    for (atomic.load(task.release) == 0) { os.thread_wait(task.release, 0); }
    ret true;
}

fun wait_one(runtime: *io_runtime.Runtime, completion: *io_runtime.Completion) res[usize, io_error.Error] {
    val deadline: time.Time = time.time_add(time.monotonic(), 10000000000);
    for (true) {
        val remaining: i64 = time.time_sub(deadline, time.monotonic());
        if (remaining <= 0) { ret res[usize, io_error.Error].ok{0}; }
        var timeout_ms: i64 = (remaining + 999999) / 1000000;
        if (timeout_ms > 0x7fffffff) { timeout_ms = 0x7fffffff; }
        val result: res[usize, io_error.Error] = io_runtime.wait(runtime, completion, 1, timeout_ms::i32);
        if (sel result.err) { ret result; }
        if (result.ok != 0) { ret result; }
    }
    ret res[usize, io_error.Error].ok{0};
}

test "io.file: worker fallback copies writes and publishes positioned reads" {
    val root_path: Path = "mach-std-io-file-async-root";
    val file_path: Path = "mach-std-io-file-async-root/data";
    cleanup_file(file_path);
    cleanup_dir(root_path);
    if (fs_refused(filesystem.create_dir(root_path, 0o700))) { ret 1; }
    var root: Root;
    val root_result: err[io_error.Error] = root_open(?root, root_path);
    if (sel root_result.err) { ret 2; }
    var options: OpenOptions = write_options(0o600);
    options.access = READ_WRITE;
    options.truncate = true;
    val file_result: res[filesystem.File, io_error.Error] = open_confined(?root, "data", options);
    if (sel file_result.err) { ret 3; }
    var file: filesystem.File = file_result.ok;
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 4))) { ret 4; }
    var requests: [4]Request;
    var scratch: [64]u8;
    var tasks: [4]worker_pool.Task;
    var abort_tasks: [4]worker_pool.Task;
    var threads: [2]thread.Thread;
    var workers: [2]worker_pool.Worker;
    var file_adapter: file_api.Adapter;
    if (!ok_err(make(?file_adapter, ?runtime, (?requests)::*Request, 4, (?scratch)::*u8, 64, 16, (?tasks)::*worker_pool.Task, (?abort_tasks)::*worker_pool.Task, (?threads)::*thread.Thread, (?workers)::*worker_pool.Worker, 2))) { ret 5; }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 6; }
    var input: [5]u8;
    memory.raw_copy((?input)::ptr, "hello"::ptr, 5);
    if (!ok_token(submit_write(?file_adapter, ?scope, ?file, (?input)::*u8, 5, 3, 61))) { ret 7; }
    memory.raw_fill((?input)::ptr, 'x', 5);
    var completion: io_runtime.Completion;
    val written: res[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (sel written.err) { ret 20; }
    if (written.ok != 1) { ret 21; }
    if (completion.bytes != 5) { ret 22; }
    if (completion.context != 61) { ret 23; }
    if (completion.has_error) { ret 24; }
    var output: [8]u8;
    if (!ok_token(submit_read(?file_adapter, ?scope, ?file, (?output)::*u8, 8, 0, 62))) { ret 9; }
    val read_result: res[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (sel read_result.err) { ret 10; }
    if (read_result.ok != 1) { ret 10; }
    if (completion.bytes != 8) { ret 10; }
    if (completion.end_of_stream) { ret 10; }
    if (completion.has_error) { ret 10; }
    if (output[0] != 0 || output[1] != 0 || output[2] != 0 || !bytes_equal(((?output)::usize + 3)::*u8, "hello"::*u8, 5)) { ret 11; }
    if (!ok_token(submit_read(?file_adapter, ?scope, ?file, (?output)::*u8, 8, 100, 63))) { ret 12; }
    val eof: res[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (sel eof.err) { ret 13; }
    if (completion.bytes != 0) { ret 14; }
    if (!completion.end_of_stream) { ret 15; }
    if (completion.has_error) { ret 16; }
    if (!ok_bool(shutdown_drain(?file_adapter)) || !ok_err(destroy(?file_adapter))) { ret 17; }
    if (!cancel.destroy(?scope)) { ret 18; }
    io_runtime.close(?runtime);
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 19; }
    filesystem.close(?file);
    root_close(?root);
    cleanup_file(file_path);
    cleanup_dir(root_path);
    ret 0;
}

test "io.file: queued cancellation and deadline leave read bytes untouched" {
    val path: Path = "mach-std-io-file-cancel";
    cleanup_file(path);
    if (fs_write_refused(filesystem.write_bytes(path, "secret", 6, 0o600))) { ret 1; }
    val file_result: res[filesystem.File, io_error.Error] = filesystem.open(path);
    if (sel file_result.err) { ret 2; }
    var file: filesystem.File = file_result.ok;
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 1))) { ret 3; }
    var requests: [1]Request;
    var scratch: [8]u8;
    var tasks: [1]worker_pool.Task;
    var abort_tasks: [1]worker_pool.Task;
    var threads: [1]thread.Thread;
    var workers: [1]worker_pool.Worker;
    var file_adapter: file_api.Adapter;
    if (!ok_err(make(?file_adapter, ?runtime, (?requests)::*Request, 1, (?scratch)::*u8, 8, 8, (?tasks)::*worker_pool.Task, (?abort_tasks)::*worker_pool.Task, (?threads)::*thread.Thread, (?workers)::*worker_pool.Worker, 1))) { ret 4; }
    var entered: i64 = 0;
    var release: i64 = 0;
    var blocker: BlockTask = BlockTask{entered: ?entered, release: ?release};
    if (worker_pool.submit(?file_adapter.pool, worker_pool.Task{context: ?blocker, run: block_worker}) != worker_pool.ACCEPTED) { ret 5; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 6; }
    var output: [6]u8;
    memory.raw_fill((?output)::ptr, 9, 6);
    if (!ok_token(submit_read(?file_adapter, ?scope, ?file, (?output)::*u8, 6, 0, 70)) || !cancel.cancel(?scope)) { ret 7; }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    var completion: io_runtime.Completion;
    val cancelled: res[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (sel cancelled.err) { ret 8; }
    if (cancelled.ok != 1) { ret 8; }
    if (!completion.has_error) { ret 8; }
    if (completion.error.kind != io_error.CANCELLED) { ret 8; }
    var i: usize = 0;
    for (i < 6) { if (output[i] != 9) { ret 9; } i = i + 1; }
    atomic.store(?entered, 0);
    atomic.store(?release, 0);
    if (worker_pool.submit(?file_adapter.pool, worker_pool.Task{context: ?blocker, run: block_worker}) != worker_pool.ACCEPTED) { ret 10; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    var deadline_scope: cancel.Scope;
    val deadline: time.Time = time.time_add(time.monotonic(), 10000000000);
    if (!cancel.make_root(?deadline_scope, true, deadline)) { ret 11; }
    memory.raw_fill((?output)::ptr, 8, 6);
    if (!ok_token(submit_read(?file_adapter, ?deadline_scope, ?file, (?output)::*u8, 6, 0, 71))) { ret 12; }
    if (!cancel.timeout(?deadline_scope)) { ret 18; }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    val timed_out: res[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (sel timed_out.err) { ret 13; }
    if (timed_out.ok != 1) { ret 13; }
    if (!completion.has_error) { ret 13; }
    if (completion.error.kind != io_error.TIMEOUT) { ret 13; }
    i = 0;
    for (i < 6) { if (output[i] != 8) { ret 14; } i = i + 1; }
    if (!ok_bool(shutdown_drain(?file_adapter)) || !ok_err(destroy(?file_adapter))) { ret 15; }
    if (!cancel.destroy(?scope) || !cancel.destroy(?deadline_scope)) { ret 16; }
    io_runtime.close(?runtime);
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 17; }
    filesystem.close(?file);
    cleanup_file(path);
    ret 0;
}

test "io.file: runtime close never exposes worker scratch" {
    val path: Path = "mach-std-io-file-race";
    cleanup_file(path);
    if (fs_write_refused(filesystem.write_bytes(path, "secret", 6, 0o600))) { ret 1; }
    val file_result: res[filesystem.File, io_error.Error] = filesystem.open(path);
    if (sel file_result.err) { ret 2; }
    var file: filesystem.File = file_result.ok;
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 1))) { ret 3; }
    var requests: [1]Request;
    var scratch: [8]u8;
    var tasks: [1]worker_pool.Task;
    var abort_tasks: [1]worker_pool.Task;
    var threads: [1]thread.Thread;
    var workers: [1]worker_pool.Worker;
    var file_adapter: file_api.Adapter;
    if (!ok_err(make(?file_adapter, ?runtime, (?requests)::*Request, 1, (?scratch)::*u8, 8, 8, (?tasks)::*worker_pool.Task, (?abort_tasks)::*worker_pool.Task, (?threads)::*thread.Thread, (?workers)::*worker_pool.Worker, 1))) { ret 4; }
    var entered: i64 = 0;
    var release: i64 = 0;
    var blocker: BlockTask = BlockTask{entered: ?entered, release: ?release};
    if (worker_pool.submit(?file_adapter.pool, worker_pool.Task{context: ?blocker, run: block_worker}) != worker_pool.ACCEPTED) { ret 5; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 6; }
    var output: [6]u8;
    memory.raw_fill((?output)::ptr, 7, 6);
    if (!ok_token(submit_read(?file_adapter, ?scope, ?file, (?output)::*u8, 6, 0, 71))) { ret 7; }
    if (!ok_bool(io_runtime.close(?runtime))) { ret 8; }
    var completion: io_runtime.Completion;
    val early: res[usize, io_error.Error] = io_runtime.poll(?runtime, ?completion, 1);
    if (sel early.err) { ret 9; }
    if (early.ok != 0) { ret 9; }
    var i: usize = 0;
    for (i < 6) { if (output[i] != 7) { ret 10; } i = i + 1; }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    if (!ok_bool(shutdown_drain(?file_adapter))) { ret 11; }
    if (ok_err(destroy(?file_adapter))) { ret 12; }
    val closed: res[usize, io_error.Error] = wait_one(?runtime, ?completion);
    if (sel closed.err) { ret 13; }
    if (closed.ok != 1) { ret 13; }
    if (!completion.has_error) { ret 13; }
    if (completion.error.kind != io_error.CLOSED) { ret 13; }
    i = 0;
    for (i < 6) { if (output[i] != 7) { ret 14; } i = i + 1; }
    if (!ok_err(destroy(?file_adapter))) { ret 15; }
    val repeated: res[usize, io_error.Error] = io_runtime.poll(?runtime, ?completion, 1);
    if (sel repeated.err) { ret 16; }
    if (repeated.ok != 0) { ret 16; }
    if (!cancel.destroy(?scope) || !ok_err(io_runtime.destroy(?runtime))) { ret 17; }
    filesystem.close(?file);
    cleanup_file(path);
    ret 0;
}
