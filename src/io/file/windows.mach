# handle-relative file primitives for windows

use std.system.os;
use platform: std.system.os.windows;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

$if ($mach.build.os != $mach.os.windows) {
    $error("std.io.file.windows: requires windows");
}

rec Parent {
    handle:      i32;
    owned:       bool;
    leaf:        *u16;
    leaf_length: usize;
}

fun separator(unit: u16) bool {
    ret unit == '/'::u16 || unit == '\\'::u16;
}

fun invalid_component(path: *u16, start: usize, length: usize) bool {
    if (length == 0)                                                           { ret true; }
    if (length == 1 && path[start] == '.'::u16)                                { ret true; }
    if (length == 2 && path[start] == '.'::u16 && path[start + 1] == '.'::u16) { ret true; }
    ret false;
}

fun relative(path: *u16) bool {
    ret path != nil && path[0] != 0 && !separator(path[0]);
}

fun close_owned(handle: i32, owned: bool) {
    if (owned) { platform.close(handle); }
}

# a UTF-8 path is converted once and then takes the native path
pub fun open_root(path: *u8) i64 {
    if (path == nil || path[0] == 0) { ret platform.EINVAL; }
    ret platform.open_root_utf8(path);
}

pub fun open_root_native(path: *u16) i64 {
    if (path == nil || path[0] == 0) { ret platform.EINVAL; }
    ret platform.open_root_native(path);
}

pub fun open_confined(root: i32, path: *u8, flags: i32, mode: i32) i64 {
    if (root < 0 || path == nil || path[0] == 0 || path[0] == '/' || path[0] == '\\') { ret platform.EINVAL; }
    var wide:      os.NativePath;
    val converted: i64 = os.native_path(path, ?wide);
    if (converted < 0) { ret converted; }
    val result: i64 = open_confined_native(root, wide.units, flags, mode);
    os.native_path_release(?wide);
    ret result;
}

# every component is resolved from a pinned directory handle
pub fun open_confined_native(root: i32, path: *u16, flags: i32, mode: i32) i64 {
    if (root < 0 || !relative(path)) { ret platform.EINVAL; }
    var length: usize = 0;
    for (path[length] != 0) { length = length + 1; }
    var current: i32   = root;
    var owned:   bool  = false;
    var start:   usize = 0;
    for (start < length) {
        var end: usize = start;
        for (end < length && !separator(path[end])) { end = end + 1; }
        val component_length: usize = end - start;
        if (invalid_component(path, start, component_length)) {
            close_owned(current, owned);
            ret platform.EINVAL;
        }
        val final:      bool = end == length;
        var open_flags: i32  = platform.O_RDONLY | platform.O_DIRECTORY;
        if (final) { open_flags = flags; }
        val next: i64 = platform.open_relative_native(current, ?path[start], component_length, open_flags, mode);
        if (next < 0) {
            close_owned(current, owned);
            ret next;
        }
        close_owned(current, owned);
        current = next::i32;
        owned   = true;
        if (final) { ret next; }
        start = end + 1;
    }
    close_owned(current, owned);
    ret platform.EINVAL;
}

fun open_parent(root: i32, path: *u16, output: *Parent) i64 {
    if (root < 0 || output == nil || !relative(path)) { ret platform.EINVAL; }
    var length: usize = 0;
    for (path[length] != 0) { length = length + 1; }
    var current: i32   = root;
    var owned:   bool  = false;
    var start:   usize = 0;
    for (start < length) {
        var end: usize = start;
        for (end < length && !separator(path[end])) { end = end + 1; }
        val component_length: usize = end - start;
        if (invalid_component(path, start, component_length)) {
            close_owned(current, owned);
            ret platform.EINVAL;
        }
        if (end == length) {
            output.handle      = current;
            output.owned       = owned;
            output.leaf        = ?path[start];
            output.leaf_length = component_length;
            ret 0;
        }
        val next: i64 = platform.open_relative_native(current, ?path[start], component_length, platform.O_RDONLY | platform.O_DIRECTORY, 0);
        if (next < 0) {
            close_owned(current, owned);
            ret next;
        }
        close_owned(current, owned);
        current = next::i32;
        owned   = true;
        start   = end + 1;
    }
    close_owned(current, owned);
    ret platform.EINVAL;
}

pub fun rename_confined(root: i32, source: *u8, destination: *u8) i64 {
    var from:      os.NativePath;
    val converted: i64 = os.native_path(source, ?from);
    if (converted < 0) { ret converted; }
    var to:                    os.NativePath;
    val destination_converted: i64 = os.native_path(destination, ?to);
    if (destination_converted < 0) {
        os.native_path_release(?from);
        ret destination_converted;
    }
    val result: i64 = rename_confined_native(root, from.units, to.units);
    os.native_path_release(?to);
    os.native_path_release(?from);
    ret result;
}

pub fun rename_confined_native(root: i32, source: *u16, destination: *u16) i64 {
    var from:        Parent;
    val from_result: i64 = open_parent(root, source, ?from);
    if (from_result < 0) { ret from_result; }
    var to:        Parent;
    val to_result: i64 = open_parent(root, destination, ?to);
    if (to_result < 0) {
        close_owned(from.handle, from.owned);
        ret to_result;
    }
    val result: i64 = platform.rename_relative_native(from.handle, from.leaf, from.leaf_length, to.handle, to.leaf, to.leaf_length);
    close_owned(from.handle, from.owned);
    close_owned(to.handle, to.owned);
    ret result;
}

pub fun read_at(handle: i32, buffer: *u8, length: usize, offset: u64) i64 {
    ret platform.read_at(handle, buffer, length, offset);
}

pub fun write_at(handle: i32, buffer: *u8, length: usize, offset: u64) i64 {
    ret platform.write_at(handle, buffer, length, offset);
}

pub fun unmap_file(data: ptr, length: usize) i64 {
    ret platform.unmap_file(data, length);
}
