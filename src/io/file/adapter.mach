# bounded worker-backed file completion adapter

use R: std.types.result;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.filesystem;
use std.memory;
use std.system.os;
use std.system.panic;
use std.sync.atomic;
use std.sync.cancel;
use std.sync.mutex;
use std.sync.thread;
use std.sync.worker_pool;
use io_error: std.io.error;
use io_handle: std.io.handle;
use io_runtime: std.io.runtime;

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    use platform: std.io.file.posix;
}
$or ($mach.build.os == $mach.os.windows) {
    use platform: std.io.file.windows;
}

fun failure(code: i64, operation: io_error.Operation) io_error.Error {
    ret io_error.from_code(code, operation);
}

val REQUEST_FREE:      i64 = 0;
val REQUEST_QUEUED:    i64 = 1;
val REQUEST_RUNNING:   i64 = 2;
val REQUEST_CANCELLED: i64 = 3;
val REQUEST_ABORTED:   i64 = 4;
val REQUEST_QUIESCED:  i64 = 5;

val ADAPTER_OPEN:     u8 = 0;
val ADAPTER_DRAINING: u8 = 1;
val ADAPTER_ABORTING: u8 = 2;
val ADAPTER_JOINED:   u8 = 3;
val ADAPTER_RETIRING:      u8 = 4;
val ADAPTER_RETIRED:       u8 = 5;
val ADAPTER_POOL_DESTROYED: u8 = 6;
val ADAPTER_RELEASING:     u8 = 7;

pub rec Request {
    adapter:             *Adapter;
    state:               i64;
    kind:                io_runtime.Kind;
    file:                filesystem.File;
    length:              usize;
    offset:              u64;
    scratch:             *u8;
    token:               io_runtime.Token;
}

# request, task, abort, worker, thread, and scratch storage are caller-owned
pub rec Adapter {
    runtime:          *io_runtime.Runtime;
    source:           io_runtime.SourceToken;
    requests:         *Request;
    request_capacity: usize;
    scratch:          *u8;
    scratch_length:   usize;
    max_transfer:     usize;
    tasks:            *worker_pool.Task;
    abort_tasks:      *worker_pool.Task;
    threads:          *thread.Thread;
    workers:          *worker_pool.Worker;
    worker_count:     usize;
    pool:             worker_pool.Pool;
    next_request:     usize;
    active:           usize;
    state:            u8;
    initialized:      bool;
    lock:             mutex.Mutex;
}

fun token_equal(a: io_runtime.Token, b: io_runtime.Token) bool {
    ret a.index == b.index && a.generation == b.generation;
}

fun source_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    ret false;
}

fun source_release(context: ptr, completion: *io_runtime.Completion) {
    ret;
}

fun source_cancel(context: ptr, token: io_runtime.Token, reason: io_error.Error) i64 {
    val adapter: *Adapter = context::*Adapter;
    mutex.lock(?adapter.lock);
    var i: usize = 0;
    for (i < adapter.request_capacity) {
        val request: *Request = ?adapter.requests[i];
        var current: i64 = atomic.load(?request.state);
        if (current != REQUEST_FREE && token_equal(request.token, token)) {
            for (current == REQUEST_QUEUED || current == REQUEST_RUNNING) {
                var expected: i64 = current;
                if (atomic.cas(?request.state, ?expected, REQUEST_CANCELLED)) {
                    mutex.unlock(?adapter.lock);
                    ret io_runtime.CANCELLATION_PENDING;
                }
                current = expected;
            }
            mutex.unlock(?adapter.lock);
            if (current == REQUEST_CANCELLED) { ret io_runtime.CANCELLATION_PENDING; }
            ret 0;
        }
        i = i + 1;
    }
    mutex.unlock(?adapter.lock);
    ret 0;
}

fun release_request(request: *Request) {
    val adapter: *Adapter = request.adapter;
    mutex.lock(?adapter.lock);
    atomic.store(?request.state, REQUEST_FREE);
    adapter.active = adapter.active - 1;
    mutex.unlock(?adapter.lock);
}

fun request_operation(request: *Request) io_error.Operation {
    if (request.kind == io_runtime.FILE_READ) { ret io_error.OP_READ; }
    ret io_error.OP_WRITE;
}

fun complete_pending_cancellation(request: *Request) {
    val completed: R.Result[bool, io_error.Error] = io_runtime.complete_cancellation(request.adapter.runtime, request.token);
    if (R.is_err[bool, io_error.Error](completed)) {
        panic.panic("std.io.file: cancellation completion lost ownership\n");
    }
}

fun settle_resolution(request: *Request, resolved: R.Result[bool, io_error.Error]) {
    if (R.is_err[bool, io_error.Error](resolved)) {
        var state: i64 = atomic.load(?request.state);
        for (state == REQUEST_RUNNING) {
            var expected: i64 = state;
            if (atomic.cas(?request.state, ?expected, REQUEST_QUIESCED)) {
                state = REQUEST_QUIESCED;
            }
            or { state = expected; }
        }
        if (state == REQUEST_CANCELLED) { complete_pending_cancellation(request); }
        or (state != REQUEST_ABORTED && state != REQUEST_QUIESCED) { panic.panic("std.io.file: runtime completion lost ownership\n"); }
    }
    release_request(request);
}

fun execute_request(context: ptr) bool {
    val request: *Request = context::*Request;
    var expected: i64 = REQUEST_QUEUED;
    if (!atomic.cas(?request.state, ?expected, REQUEST_RUNNING)) {
        if (expected == REQUEST_CANCELLED) { complete_pending_cancellation(request); }
        or {
            val resolved: R.Result[bool, io_error.Error] = io_runtime.fail(request.adapter.runtime, request.token, failure(os.ECANCELED, request_operation(request)));
            settle_resolution(request, resolved);
            ret true;
        }
        release_request(request);
        ret true;
    }

    var result: i64 = 0;
    if (request.kind == io_runtime.FILE_READ) {
        result = platform.read_at(request.file.handle.value::i32, request.scratch, request.length, request.offset);
    }
    or {
        result = platform.write_at(request.file.handle.value::i32, request.scratch, request.length, request.offset);
    }
    if (atomic.load(?request.state) == REQUEST_CANCELLED) {
        complete_pending_cancellation(request);
        release_request(request);
        ret true;
    }
    var resolved: R.Result[bool, io_error.Error];
    if (result < 0) {
        resolved = io_runtime.fail(request.adapter.runtime, request.token, failure(result, request_operation(request)));
    }
    or (request.kind == io_runtime.FILE_READ) {
        val count: usize = result::usize;
        resolved = io_runtime.complete_copy(request.adapter.runtime, request.token, request.scratch, count, request.file.handle.value, count == 0 && request.length != 0);
    }
    or {
        resolved = io_runtime.complete(request.adapter.runtime, request.token, result::usize, request.file.handle.value, false);
    }
    settle_resolution(request, resolved);
    ret true;
}

fun claim_request(adapter: *Adapter) *Request {
    if (adapter.active == adapter.request_capacity) { ret nil; }
    var scanned: usize = 0;
    var index: usize = adapter.next_request;
    for (scanned < adapter.request_capacity && atomic.load(?adapter.requests[index].state) != REQUEST_FREE) {
        index = (index + 1) % adapter.request_capacity;
        scanned = scanned + 1;
    }
    if (scanned == adapter.request_capacity) { ret nil; }
    adapter.next_request = (index + 1) % adapter.request_capacity;
    adapter.active = adapter.active + 1;
    ret ?adapter.requests[index];
}

pub fun make(
    adapter: *Adapter,
    runtime: *io_runtime.Runtime,
    requests: *Request,
    request_capacity: usize,
    scratch: *u8,
    scratch_length: usize,
    max_transfer: usize,
    tasks: *worker_pool.Task,
    abort_tasks: *worker_pool.Task,
    threads: *thread.Thread,
    workers: *worker_pool.Worker,
    worker_count: usize,
) R.Result[bool, io_error.Error] {
    if (adapter == nil || runtime == nil || requests == nil || request_capacity == 0 || scratch == nil || max_transfer == 0 || tasks == nil || abort_tasks == nil || threads == nil || workers == nil || worker_count == 0) {
        ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_CREATE));
    }
    val required: usize = request_capacity * max_transfer;
    if (required / request_capacity != max_transfer || scratch_length < required) {
        ret R.err[bool, io_error.Error](failure(os.ENOMEM, io_error.OP_CREATE));
    }
    adapter.runtime = runtime;
    adapter.requests = requests;
    adapter.request_capacity = request_capacity;
    adapter.scratch = scratch;
    adapter.scratch_length = scratch_length;
    adapter.max_transfer = max_transfer;
    adapter.tasks = tasks;
    adapter.abort_tasks = abort_tasks;
    adapter.threads = threads;
    adapter.workers = workers;
    adapter.worker_count = worker_count;
    adapter.next_request = 0;
    adapter.active = 0;
    adapter.state = ADAPTER_OPEN;
    adapter.initialized = false;
    adapter.lock = mutex.make();
    var i: usize = 0;
    for (i < request_capacity) {
        adapter.requests[i].adapter = adapter;
        adapter.requests[i].state = REQUEST_FREE;
        adapter.requests[i].scratch = (scratch::usize + i * max_transfer)::*u8;
        i = i + 1;
    }
    val registered: R.Result[io_runtime.SourceToken, io_error.Error] = io_runtime.register_source(
        runtime,
        adapter::ptr,
        source_dispatch,
        source_cancel,
        source_release,
    );
    if (R.is_err[io_runtime.SourceToken, io_error.Error](registered)) {
        ret R.err[bool, io_error.Error](R.unwrap_err[io_runtime.SourceToken, io_error.Error](registered));
    }
    adapter.source = R.unwrap_ok[io_runtime.SourceToken, io_error.Error](registered);
    val status: worker_pool.Status = worker_pool.make(?adapter.pool, tasks, request_capacity, threads, workers, worker_count);
    if (status != worker_pool.ACCEPTED) {
        if (worker_pool.state(?adapter.pool) == worker_pool.JOINED) { worker_pool.destroy(?adapter.pool); }
        io_runtime.unregister_source(runtime, adapter.source);
        ret R.err[bool, io_error.Error](failure(os.EAGAIN, io_error.OP_CREATE));
    }
    adapter.initialized = true;
    ret R.ok[bool, io_error.Error](true);
}

fun submit_operation(adapter: *Adapter, scope: *cancel.Scope, file: *filesystem.File, buffer: *u8, length: usize, offset: u64, context: usize, kind: io_runtime.Kind) R.Result[io_runtime.Token, io_error.Error] {
    val operation_kind: io_error.Operation = io_error.OP_READ;
    var normalized_kind: io_error.Operation = operation_kind;
    if (kind == io_runtime.FILE_WRITE) { normalized_kind = io_error.OP_WRITE; }
    if (adapter == nil || scope == nil || file == nil || !io_handle.file_is_valid(file.handle) || (buffer == nil && length != 0)) {
        ret R.err[io_runtime.Token, io_error.Error](failure(os.EINVAL, normalized_kind));
    }
    mutex.lock(?adapter.lock);
    if (!adapter.initialized || adapter.state != ADAPTER_OPEN || length > adapter.max_transfer) {
        mutex.unlock(?adapter.lock);
        var code: i64 = os.ENOMEM;
        if (adapter.initialized && adapter.state != ADAPTER_OPEN) { code = os.EBADF; }
        ret R.err[io_runtime.Token, io_error.Error](failure(code, normalized_kind));
    }
    val request: *Request = claim_request(adapter);
    if (request == nil) {
        mutex.unlock(?adapter.lock);
        ret R.err[io_runtime.Token, io_error.Error](failure(os.ENOMEM, normalized_kind));
    }
    request.kind = kind;
    request.file = @file;
    request.length = length;
    request.offset = offset;
    if (kind == io_runtime.FILE_WRITE && length > 0) { memory.raw_copy(request.scratch::ptr, buffer::ptr, length); }
    atomic.store(?request.state, REQUEST_QUEUED);
    var runtime_buffer: *u8 = buffer;
    if (kind == io_runtime.FILE_WRITE) { runtime_buffer = nil; }
    val operation: io_runtime.Operation = io_runtime.Operation{
        kind: kind,
        resource: file.handle.value,
        buffer: runtime_buffer,
        length: length,
        offset: offset,
        context: context,
    };
    val submitted: R.Result[io_runtime.Token, io_error.Error] = io_runtime.submit_scoped_owned(adapter.runtime, adapter.source, scope, operation);
    if (R.is_err[io_runtime.Token, io_error.Error](submitted)) {
        request.state = REQUEST_FREE;
        adapter.active = adapter.active - 1;
        mutex.unlock(?adapter.lock);
        ret R.err[io_runtime.Token, io_error.Error](R.unwrap_err[io_runtime.Token, io_error.Error](submitted));
    }
    request.token = R.unwrap_ok[io_runtime.Token, io_error.Error](submitted);
    val queued: worker_pool.Status = worker_pool.try_submit(?adapter.pool, worker_pool.Task{context: request::ptr, run: execute_request});
    if (queued != worker_pool.ACCEPTED) {
        atomic.store(?request.state, REQUEST_ABORTED);
        mutex.unlock(?adapter.lock);
        val resolved: R.Result[bool, io_error.Error] = io_runtime.fail(adapter.runtime, request.token, failure(os.EBUSY, io_error.OP_SUBMIT));
        settle_resolution(request, resolved);
        ret R.ok[io_runtime.Token, io_error.Error](request.token);
    }
    val token: io_runtime.Token = request.token;
    mutex.unlock(?adapter.lock);
    ret R.ok[io_runtime.Token, io_error.Error](token);
}

# file handles and cancellation scopes remain borrowed until the request retires
# read buffers remain borrowed until their runtime completion is dequeued
pub fun submit_read(adapter: *Adapter, scope: *cancel.Scope, file: *filesystem.File, buffer: *u8, length: usize, offset: u64, context: usize) R.Result[io_runtime.Token, io_error.Error] {
    ret submit_operation(adapter, scope, file, buffer, length, offset, context, io_runtime.FILE_READ);
}

# write bytes are copied into bounded adapter storage before this call succeeds
pub fun submit_write(adapter: *Adapter, scope: *cancel.Scope, file: *filesystem.File, buffer: *u8, length: usize, offset: u64, context: usize) R.Result[io_runtime.Token, io_error.Error] {
    ret submit_operation(adapter, scope, file, buffer, length, offset, context, io_runtime.FILE_WRITE);
}

fun publish_aborted(request: *Request) {
    val resolved: R.Result[bool, io_error.Error] = io_runtime.fail(request.adapter.runtime, request.token, failure(os.ECANCELED, io_error.OP_SHUTDOWN));
    settle_resolution(request, resolved);
}

pub fun shutdown_drain(adapter: *Adapter) R.Result[bool, io_error.Error] {
    if (adapter == nil) { ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_SHUTDOWN)); }
    mutex.lock(?adapter.lock);
    if (!adapter.initialized) {
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_SHUTDOWN));
    }
    if (adapter.state == ADAPTER_JOINED) {
        mutex.unlock(?adapter.lock);
        ret R.ok[bool, io_error.Error](false);
    }
    if (adapter.state != ADAPTER_OPEN) {
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](failure(os.EBUSY, io_error.OP_SHUTDOWN));
    }
    adapter.state = ADAPTER_DRAINING;
    val closing: worker_pool.Status = worker_pool.close_drain(?adapter.pool);
    mutex.unlock(?adapter.lock);
    if (closing != worker_pool.DRAINING) { ret R.err[bool, io_error.Error](failure(os.EIO, io_error.OP_SHUTDOWN)); }
    if (worker_pool.join(?adapter.pool) != worker_pool.JOINED) { ret R.err[bool, io_error.Error](failure(os.EIO, io_error.OP_SHUTDOWN)); }
    mutex.lock(?adapter.lock);
    adapter.state = ADAPTER_JOINED;
    mutex.unlock(?adapter.lock);
    ret R.ok[bool, io_error.Error](true);
}

pub fun shutdown_abort(adapter: *Adapter) R.Result[usize, io_error.Error] {
    if (adapter == nil) { ret R.err[usize, io_error.Error](failure(os.EINVAL, io_error.OP_SHUTDOWN)); }
    mutex.lock(?adapter.lock);
    if (!adapter.initialized) {
        mutex.unlock(?adapter.lock);
        ret R.err[usize, io_error.Error](failure(os.EINVAL, io_error.OP_SHUTDOWN));
    }
    if (adapter.state != ADAPTER_OPEN) {
        mutex.unlock(?adapter.lock);
        ret R.err[usize, io_error.Error](failure(os.EBUSY, io_error.OP_SHUTDOWN));
    }
    adapter.state = ADAPTER_ABORTING;
    var rejected: usize = 0;
    val closing: worker_pool.Status = worker_pool.close_abort(?adapter.pool, adapter.abort_tasks, adapter.request_capacity, ?rejected);
    if (closing != worker_pool.ABORTING) {
        mutex.unlock(?adapter.lock);
        ret R.err[usize, io_error.Error](failure(os.EIO, io_error.OP_SHUTDOWN));
    }
    var i: usize = 0;
    for (i < rejected) {
        val request: *Request = adapter.abort_tasks[i].context::*Request;
        var expected: i64 = REQUEST_QUEUED;
        atomic.cas(?request.state, ?expected, REQUEST_ABORTED);
        i = i + 1;
    }
    mutex.unlock(?adapter.lock);
    i = 0;
    for (i < rejected) {
        publish_aborted(adapter.abort_tasks[i].context::*Request);
        i = i + 1;
    }
    if (worker_pool.join(?adapter.pool) != worker_pool.JOINED) { ret R.err[usize, io_error.Error](failure(os.EIO, io_error.OP_SHUTDOWN)); }
    mutex.lock(?adapter.lock);
    adapter.state = ADAPTER_JOINED;
    mutex.unlock(?adapter.lock);
    ret R.ok[usize, io_error.Error](rejected);
}

pub fun active(adapter: *Adapter) usize {
    if (adapter == nil) { ret 0; }
    mutex.lock(?adapter.lock);
    var count: usize = 0;
    if (adapter.initialized) { count = adapter.active; }
    mutex.unlock(?adapter.lock);
    ret count;
}

pub fun destroy(adapter: *Adapter) R.Result[bool, io_error.Error] {
    if (adapter == nil) { ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_CLOSE)); }
    mutex.lock(?adapter.lock);
    if (!adapter.initialized) {
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_CLOSE));
    }
    var retire: bool = false;
    if (adapter.state == ADAPTER_JOINED && adapter.active == 0) {
        adapter.state = ADAPTER_RETIRING;
        retire = true;
    }
    or ((adapter.state != ADAPTER_RETIRED && adapter.state != ADAPTER_POOL_DESTROYED) || adapter.active != 0) {
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](failure(os.EBUSY, io_error.OP_CLOSE));
    }
    if (retire) {
        mutex.unlock(?adapter.lock);
        val retired: R.Result[bool, io_error.Error] = io_runtime.retire_source(adapter.runtime, adapter.source);
        if (R.is_err[bool, io_error.Error](retired)) {
            mutex.lock(?adapter.lock);
            adapter.state = ADAPTER_JOINED;
            mutex.unlock(?adapter.lock);
            ret R.err[bool, io_error.Error](R.unwrap_err[bool, io_error.Error](retired));
        }
        mutex.lock(?adapter.lock);
        adapter.state = ADAPTER_RETIRED;
    }
    if (adapter.state == ADAPTER_RETIRED) {
        if (!worker_pool.destroy(?adapter.pool)) {
            mutex.unlock(?adapter.lock);
            ret R.err[bool, io_error.Error](failure(os.EIO, io_error.OP_CLOSE));
        }
        adapter.state = ADAPTER_POOL_DESTROYED;
    }
    adapter.state = ADAPTER_RELEASING;
    mutex.unlock(?adapter.lock);
    val released: R.Result[bool, io_error.Error] = io_runtime.release_source(adapter.runtime, adapter.source);
    if (R.is_err[bool, io_error.Error](released)) {
        mutex.lock(?adapter.lock);
        adapter.state = ADAPTER_POOL_DESTROYED;
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](R.unwrap_err[bool, io_error.Error](released));
    }
    mutex.lock(?adapter.lock);
    adapter.runtime = nil;
    adapter.requests = nil;
    adapter.scratch = nil;
    adapter.tasks = nil;
    adapter.abort_tasks = nil;
    adapter.threads = nil;
    adapter.workers = nil;
    adapter.initialized = false;
    mutex.unlock(?adapter.lock);
    ret R.ok[bool, io_error.Error](true);
}
