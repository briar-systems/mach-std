# positioned file transfers into and out of secret-welded storage
#
# the file is the destination or source and welded storage the bytes, as in
# std.io.file's read_at and write_at, so the kernel reads or writes the welded
# bytes through one native call and nothing else and a secret never passes
# through public memory. the storage is the caller's, from std.memory.secret,
# held directly or lent to a borrow. an interrupted call is retried within a
# budget, and this layer leaves the storage untouched before, during and after
# the call.
#
# the direct transfers need the files capability. the borrow forms resolve a
# std.memory.secret borrow, so they exist only where the pages capability does.

use io_error:  std.io.error;
use io_handle: std.io.handle;
use std.system.capability;
use std.types.bool.bool;
#[testing]
use std.types.bool.false;
#[testing]
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

$if (capability.HAS_FILES) {
    use std.system.os;
}
$or {
    $error("std.io.file.secret needs the files capability (std.system.capability.HAS_FILES)");
}

val INTERRUPT_MAX_RETRIES: usize = 8;
val MAX_FILE_OFFSET:       u64   = 0x7fffffffffffffff;

# providers return a count or a negative native code
def PositionedFun: fun(ptr, usize, *^u8, usize, u64) i64;

fun interrupted(code: i64) bool {
    ret code < 0 && os.error_kind(code) == io_error.INTERRUPTED;
}

# one positioned transfer with the interruption budget; the provider is the
# native call, and the storage stays untouched by this layer before, during
# and after it
fun positioned_all(context: ptr, file: usize, data: *^u8, len: usize, offset: u64,
    native_fn: PositionedFun, operation: io_error.Operation) res[usize, io_error.Error] {
    var interruptions: usize = 0;
    var result:        i64   = 0;
    for (interruptions < INTERRUPT_MAX_RETRIES) {
        result = native_fn(context, file, data, len, offset);
        if (!interrupted(result)) {
            if (result < 0) { ret res[usize, io_error.Error].err{os.error(result, operation)}; }
            ret res[usize, io_error.Error].ok{result::usize};
        }
        interruptions = interruptions + 1;
    }
    ret res[usize, io_error.Error].err{os.error(result, operation)};
}

fun native_read_at(context: ptr, file: usize, data: *^u8, len: usize, offset: u64) i64 {
    ret os.read_at_secret(file, data, len, offset);
}

fun native_write_at(context: ptr, file: usize, data: *^u8, len: usize, offset: u64) i64 {
    ret os.write_at_secret(file, data, len, offset);
}

fun transfer(file: io_handle.FileHandle, data: *^u8, len: usize, file_offset: u64,
    native_fn: PositionedFun, operation: io_error.Operation) res[usize, io_error.Error] {
    if (len == 0) { ret res[usize, io_error.Error].ok{0}; }
    if (!io_handle.file_is_valid(file) || data == nil || file_offset > MAX_FILE_OFFSET) {
        ret res[usize, io_error.Error].err{io_error.make(io_error.INVALID, operation)};
    }
    ret positioned_all(nil, file.value, data, len, file_offset, native_fn, operation);
}

# read from a file straight into welded storage the caller owns: the kernel
# writes the storage through this call and nothing else
# ---
# file:        open file
# data:        destination secret storage
# len:         maximum bytes to read
# file_offset: file position to read from
# ret:         bytes delivered (zero at end of file), or the error with the span
#              unspecified. INVALID for an invalid file, a nil data or an offset
#              past the largest file position
pub fun read_at(file: io_handle.FileHandle, data: *^u8, len: usize, file_offset: u64) res[usize, io_error.Error] {
    ret transfer(file, data, len, file_offset, native_read_at, io_error.OP_READ);
}

# write welded storage the caller owns straight to a file: the kernel reads the
# storage through this call and nothing else
# ---
# file:        open file
# data:        source secret storage
# len:         maximum bytes to write
# file_offset: file position to write at
# ret:         bytes persisted, or the error with nothing about the storage
#              changed. INVALID as read_at
pub fun write_at(file: io_handle.FileHandle, data: *^u8, len: usize, file_offset: u64) res[usize, io_error.Error] {
    ret transfer(file, data, len, file_offset, native_write_at, io_error.OP_WRITE);
}

$if (capability.HAS_PAGES) {
    use secret_memory: std.memory.secret;
    use std.types.error.err;

    fun borrow_transfer(file: io_handle.FileHandle, borrow: secret_memory.Borrow, offset: usize, len: usize,
        file_offset: u64, native_fn: PositionedFun, operation: io_error.Operation) res[usize, io_error.Error] {
        if (file_offset > MAX_FILE_OFFSET) { ret res[usize, io_error.Error].err{io_error.make(io_error.INVALID, operation)}; }
        var data:         *^u8                = nil;
        val err_resolved: err[io_error.Error] = secret_memory.borrow_span(borrow, offset, len, ?data, operation);
        if (sel err_resolved.err) { ret res[usize, io_error.Error].err{err_resolved.err}; }
        ret transfer(file, data, len, file_offset, native_fn, operation);
    }

    # read from a file into a span of a borrow: the kernel writes the welded
    # storage through this call and nothing else
    # ---
    # ret: bytes delivered (zero at end of file), or the error with the span
    #      unspecified. CLOSED for a borrow that is not live, INVALID for a span
    #      outside it, and otherwise as read_at
    pub fun borrow_read_at(file: io_handle.FileHandle, borrow: secret_memory.Borrow, offset: usize, len: usize, file_offset: u64) res[usize, io_error.Error] {
        ret borrow_transfer(file, borrow, offset, len, file_offset, native_read_at, io_error.OP_READ);
    }

    # write a span of a borrow to a file: the kernel reads the welded storage
    # through this call and nothing else
    # ---
    # ret: bytes persisted, or the error with nothing about the span changed.
    #      CLOSED and INVALID as borrow_read_at
    pub fun borrow_write_at(file: io_handle.FileHandle, borrow: secret_memory.Borrow, offset: usize, len: usize, file_offset: u64) res[usize, io_error.Error] {
        ret borrow_transfer(file, borrow, offset, len, file_offset, native_write_at, io_error.OP_WRITE);
    }
}

$if ($mach.build.sys == $mach.sys.linux) {
    use native_os: std.system.os.linux;
}
$or ($mach.build.sys == $mach.sys.darwin) {
    use native_os: std.system.os.darwin;
}
$or ($mach.build.sys == $mach.sys.windows) {
    use native_os: std.system.os.windows;
}
$or ($mach.build.sys == $mach.sys.wasi) {
    use native_os: std.system.os.wasi;
}

# generic fixtures instantiate only in test builds
#[testing]
fun count_is[T](result: res[usize, io_error.Error], count: usize) bool {
    ret sel result.ok && result.ok == count;
}

#[testing]
fun count_refused[T](result: res[usize, io_error.Error], kind: io_error.Kind) bool {
    if (sel result.err) { ret result.err.kind == kind && result.err.code == 0; }
    ret false;
}

#[testing]
fun count_failed[T](result: res[usize, io_error.Error], code: i64) bool {
    ret sel result.err && result.err.code == code;
}

#[testing]
rec PositionedProbe {
    calls:       usize;
    file:        usize;
    len:         usize;
    offset:      u64;
    saw_pattern: bool;
    byte:        u8;
    result:      i64;
    interrupt:   usize;
}

#[testing]
fun probe_positioned[T](context: ptr, file: usize, data: *^u8, len: usize, offset: u64) i64 {
    val probe: *PositionedProbe = context::*PositionedProbe;
    probe.calls  = probe.calls + 1;
    probe.file   = file;
    probe.len    = len;
    probe.offset = offset;
    if (probe.calls <= probe.interrupt) { ret native_os.EINTR; }
    var i: usize = 0;
    probe.saw_pattern = true;
    for (i < len) {
        if (data[i]:>u8 != probe.byte) { probe.saw_pattern = false; }
        i = i + 1;
    }
    ret probe.result;
}

#[testing]
fun fill_pattern[T](data: *^u8, len: usize, byte: u8) {
    var i: usize = 0;
    for (i < len) {
        data[i] = byte;
        i       = i + 1;
    }
}

test positioned__retries_interruptions_and_never_touches_the_span {
    var storage: [16]^u8;
    fill_pattern[u8](?storage[0], 16, 0x3c);
    var probe: PositionedProbe = PositionedProbe{
        calls: 0, file: 0, len: 0, offset: 0, saw_pattern: false, byte: 0x3c, result: 5, interrupt: 3,
    };
    if (!count_is[u8](positioned_all(?probe, 7, ?storage[4], 9, 1024, probe_positioned[u8], io_error.OP_READ), 5)) { ret 1; }
    if (probe.calls != 4 || probe.file != 7 || probe.len != 9 || probe.offset != 1024)                             { ret 2; }
    if (!probe.saw_pattern)                                                                                        { ret 3; }
    var i: usize = 0;
    for (i < 16) {
        if (storage[i]:>u8 != 0x3c) { ret 4; }
        i = i + 1;
    }

    var exhausted: PositionedProbe = PositionedProbe{
        calls: 0, file: 0, len: 0, offset: 0, saw_pattern: false, byte: 0x3c, result: 5, interrupt: INTERRUPT_MAX_RETRIES * 2,
    };
    if (!count_failed[u8](positioned_all(?exhausted, 7, ?storage[0], 16, 0, probe_positioned[u8], io_error.OP_READ), native_os.EINTR)) { ret 5; }
    if (exhausted.calls != INTERRUPT_MAX_RETRIES)                                                                                      { ret 6; }
    i = 0;
    for (i < 16) {
        if (storage[i]:>u8 != 0x3c) { ret 7; }
        i = i + 1;
    }

    var failing: PositionedProbe = PositionedProbe{
        calls: 0, file: 0, len: 0, offset: 0, saw_pattern: false, byte: 0x3c, result: native_os.EBADF, interrupt: 0,
    };
    if (!count_failed[u8](positioned_all(?failing, 7, ?storage[0], 16, 0, probe_positioned[u8], io_error.OP_WRITE), native_os.EBADF)) { ret 8; }
    if (failing.calls != 1 || !failing.saw_pattern)                                                                                   { ret 9; }
    i = 0;
    for (i < 16) {
        if (storage[i]:>u8 != 0x3c) { ret 10; }
        i = i + 1;
    }
    ret 0;
}

$if (capability.HAS_PAGES) {
    #[testing]
    fun is_ok[T](result: err[io_error.Error]) bool {
        ret sel result.ok;
    }

    test positioned__refuses_dead_handles_and_bad_spans_before_the_kernel {
        val file:    io_handle.FileHandle = io_handle.invalid_file();
        var storage: [8]^u8;
        var handle:  secret_memory.Borrow;
        if (!is_ok[u8](secret_memory.borrow_acquire(?storage[0], 8, ?handle)))                            { ret 1; }
        if (!count_refused[u8](borrow_read_at(file, handle, 4, 8, 0), io_error.INVALID))                  { ret 2; }
        if (!count_refused[u8](borrow_write_at(file, handle, 0, 9, 0), io_error.INVALID))                 { ret 3; }
        if (!count_refused[u8](borrow_read_at(file, handle, 0, 8, 0x8000000000000000), io_error.INVALID)) { ret 4; }
        if (!count_is[u8](borrow_read_at(file, handle, 0, 0, 0), 0))                                      { ret 5; }
        if (!count_is[u8](borrow_write_at(file, handle, 8, 0, 0), 0))                                     { ret 6; }
        if (!count_refused[u8](borrow_read_at(file, handle, 0, 8, 0), io_error.INVALID))                  { ret 7; }
        if (!is_ok[u8](secret_memory.borrow_release(handle)))                                             { ret 8; }
        if (!count_refused[u8](borrow_read_at(file, handle, 0, 8, 0), io_error.CLOSED))                   { ret 9; }
        if (!count_refused[u8](borrow_write_at(file, handle, 0, 8, 0), io_error.CLOSED))                  { ret 10; }
        ret 0;
    }
}
