            if (!is_err[bool, io_error.Error](complete(?runtime, token, 0, 0, false))) { ret 1; }
        } or (pending(?runtime) != 0) {
            ret 1;
        }
        if (!cancel.destroy(?scope) || pending(?runtime) != 0) { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (is_err[bool, io_error.Error](destroy(?runtime))) { ret 1; }
    ret 0;
}

rec ScopeTransitionContext {
    scope: *cancel.Scope;
}

fun timeout_race_worker(arg: *u8) {
    val context: *ScopeTransitionContext = arg::*ScopeTransitionContext;
    cancel.timeout(context.scope);
}

test "runtime scope: deadline and cancellation races preserve the first reason" {
    var runtime: Runtime;
    if (is_err[bool, io_error.Error](make(?runtime, 1))) { ret 1; }
    var round: usize = 0;
    for (round < 32) {
        var scope: cancel.Scope;
        if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 1; }
        if (is_err[Token, io_error.Error](submit_scoped(?runtime, ?scope, test_operation(READ, 51)))) { ret 1; }
        var context: ScopeTransitionContext = ScopeTransitionContext{scope: ?scope};
        var worker: thread.Thread;
        thread.spawn_with(timeout_race_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        cancel.cancel(?scope);
        thread.join(?worker);
        var output: [1]Completion;
        val result: Result[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
        if (is_err[usize, io_error.Error](result) || unwrap_ok[usize, io_error.Error](result) != 1) { ret 1; }
        val scope_reason: cancel.Reason = cancel.reason(?scope);
        if (!output[0].has_error || output[0].context != 51) { ret 1; }
        if (scope_reason == cancel.CANCELLED && output[0].error.kind != io_error.CANCELLED) { ret 1; }
        if (scope_reason == cancel.TIMED_OUT && output[0].error.kind != io_error.TIMEOUT) { ret 1; }
        if ((scope_reason != cancel.CANCELLED && scope_reason != cancel.TIMED_OUT) || !cancel.destroy(?scope)) { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (is_err[bool, io_error.Error](destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime scope: close remains distinct from cancellation" {
    var runtime: Runtime;
    var scope: cancel.Scope;
    if (is_err[bool, io_error.Error](make(?runtime, 1))) { ret 1; }
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 1; }
    if (is_err[Token, io_error.Error](submit_scoped(?runtime, ?scope, test_operation(READ, 31)))) { ret 1; }
    if (cancel.destroy(?scope) || is_err[bool, io_error.Error](close(?runtime))) { ret 1; }
    if (!cancel.cancel(?scope) || cancel.reason(?scope) != cancel.CANCELLED) { ret 1; }
    if (!cancel.destroy(?scope)) { ret 1; }
    var output: [1]Completion;
    val result: Result[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (is_err[usize, io_error.Error](result) || unwrap_ok[usize, io_error.Error](result) != 1) { ret 1; }
    if (!output[0].has_error || output[0].error.kind != io_error.CLOSED) { ret 1; }
    if (is_err[bool, io_error.Error](destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime scope: failed submission wake rolls ownership back" {
    var runtime: Runtime;
    if (is_err[bool, io_error.Error](make(?runtime, 1))) { ret 1; }
    if (os.io_queue_close(?runtime.queue) < 0) { ret 1; }
    val timer_result: Result[Token, io_error.Error] = submit_timer(?runtime, time.time_add(time.monotonic(), 1000000000), 61);
    if (!is_err[Token, io_error.Error](timer_result) || pending(?runtime) != 0 || runtime.timer_count != 0) { ret 1; }

    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, true, time.time_add(time.monotonic(), 1000000000))) { ret 1; }
    val scoped_result: Result[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, 62));
    if (!is_err[Token, io_error.Error](scoped_result) || pending(?runtime) != 0 || runtime.timer_count != 0) { ret 1; }
    if (!cancel.destroy(?scope)) { ret 1; }

    if (!is_err[bool, io_error.Error](close(?runtime))) { ret 1; }
    if (is_err[bool, io_error.Error](destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime: batch completion separates bytes and items" {
    var runtime: Runtime;
    if (is_err[bool, io_error.Error](make(?runtime, 1))) { ret 1; }
    val submitted: Result[Token, io_error.Error] = submit(?runtime, test_operation(RECEIVE_FROM, 81));
    if (is_err[Token, io_error.Error](submitted)) { ret 2; }
    val token: Token = unwrap_ok[Token, io_error.Error](submitted);
    if (is_err[bool, io_error.Error](complete_batch(?runtime, token, 17, 3, 29))) { ret 3; }
    var output: [1]Completion;
    val result: Result[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (is_err[usize, io_error.Error](result)
        || unwrap_ok[usize, io_error.Error](result) != 1
        || output[0].bytes != 17
        || output[0].items != 3
        || output[0].resource != 29) {
        ret 4;
    }
    close(?runtime);
    if (is_err[bool, io_error.Error](destroy(?runtime))) { ret 5; }
    ret 0;
}

rec TestSource {
    released: usize;
    cancellation_pending: bool;
    cancelled: Token;
}

fun test_source_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    ret false;
}

fun test_source_cancel(context: ptr, token: Token, reason: io_error.Error) i64 {
    val source: *TestSource = context::*TestSource;
    source.cancelled = token;
    if (source.cancellation_pending) { ret CANCELLATION_PENDING; }
    ret 0;
}

fun test_source_release(context: ptr, completion: *Completion) {
    val source: *TestSource = context::*TestSource;
    source.released = source.released + 1;
}

test "runtime: retired source slots reject stale tokens and remain reusable" {
    var runtime: Runtime;
    if (is_err[bool, io_error.Error](make(?runtime, 1))) { ret 1; }
    var context: TestSource = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val first_result: Result[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (is_err[SourceToken, io_error.Error](first_result)) { ret 2; }
    val first: SourceToken = unwrap_ok[SourceToken, io_error.Error](first_result);
    if (is_err[bool, io_error.Error](retire_source(?runtime, first))) { ret 3; }
    val held_result: Result[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (!is_err[SourceToken, io_error.Error](held_result)) { ret 4; }
    if (is_err[bool, io_error.Error](release_source(?runtime, first))) { ret 5; }
    val second_result: Result[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (is_err[SourceToken, io_error.Error](second_result)) { ret 6; }
    val second: SourceToken = unwrap_ok[SourceToken, io_error.Error](second_result);
    if (first.index != second.index || first.generation == second.generation || source_id(first) == source_id(second)) { ret 7; }
    if (!is_err[Token, io_error.Error](submit_owned(?runtime, first, test_operation(READ, 90)))) { ret 8; }
    val submitted: Result[Token, io_error.Error] = submit_owned(?runtime, second, test_operation(READ, 91));
    if (is_err[Token, io_error.Error](submitted)) { ret 9; }
    val token: Token = unwrap_ok[Token, io_error.Error](submitted);
    if (is_err[bool, io_error.Error](complete(?runtime, token, 1, 0, false))) { ret 10; }
    var output: Completion;
    val polled: Result[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (is_err[usize, io_error.Error](polled)
        || unwrap_ok[usize, io_error.Error](polled) != 1
        || context.released != 1) {
        ret 11;
    }
    if (is_err[bool, io_error.Error](unregister_source(?runtime, second))) { ret 12; }
    close(?runtime);
    if (is_err[bool, io_error.Error](destroy(?runtime))) { ret 13; }
    ret 0;
}

test "runtime: source and operation ownership share one close lifecycle" {
    var runtime: Runtime;
    if (is_err[bool, io_error.Error](make(?runtime, 2))) { ret 1; }
    var context: TestSource = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val source_result: Result[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (is_err[SourceToken, io_error.Error](source_result)) { ret 2; }
    val source: SourceToken = unwrap_ok[SourceToken, io_error.Error](source_result);
    val operation_result: Result[Token, io_error.Error] = submit_owned(?runtime, source, test_operation(ACCEPT, 92));
    if (is_err[Token, io_error.Error](operation_result)) { ret 3; }
    val closing_result: Result[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
    if (is_err[lifecycle.CloseResult, io_error.Error](closing_result)) { ret 4; }
    val closing: lifecycle.CloseResult = unwrap_ok[lifecycle.CloseResult, io_error.Error](closing_result);
    if (!closing.started
        || closing.complete
        || closing.snapshot.mode != lifecycle.GRACEFUL
        || closing.snapshot.cause != lifecycle.PROCESS_TERMINATION
        || closing.snapshot.outstanding != 2) {
        ret 5;
    }
    var output: Completion;
    val polled: Result[usize, io_error.Error] = poll(?runtime, ?output, 1);
    val after_operation: lifecycle.Snapshot = snapshot(?runtime);
    if (is_err[usize, io_error.Error](polled)
        || unwrap_ok[usize, io_error.Error](polled) != 1
        || !output.has_error
        || output.error.kind != io_error.CLOSED
        || context.released != 1
        || after_operation.state != lifecycle.CLOSING
        || after_operation.outstanding != 1) {
        ret 6;
    }
    if (is_err[bool, io_error.Error](unregister_source(?runtime, source))) { ret 7; }
    val closed: lifecycle.Snapshot = snapshot(?runtime);
    if (closed.state != lifecycle.CLOSED || closed.outstanding != 0) { ret 8; }
    val duplicate_result: Result[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    if (is_err[lifecycle.CloseResult, io_error.Error](duplicate_result)) { ret 9; }
    val duplicate: lifecycle.CloseResult = unwrap_ok[lifecycle.CloseResult, io_error.Error](duplicate_result);
    if (duplicate.started || duplicate.escalated || !duplicate.complete
        || duplicate.snapshot.mode != lifecycle.GRACEFUL
        || duplicate.snapshot.terminal_cause != lifecycle.PROCESS_TERMINATION) {
        ret 10;
    }
    if (is_err[bool, io_error.Error](destroy(?runtime))) { ret 11; }
    ret 0;
}

test "runtime: asynchronous source cancellation publishes after quiescence" {
    var runtime: Runtime;
    if (is_err[bool, io_error.Error](make(?runtime, 2))) { ret 1; }
    var context: TestSource = TestSource{released: 0, cancellation_pending: true, cancelled: Token{index: 0, generation: 0}};
    val source_result: Result[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (is_err[SourceToken, io_error.Error](source_result)) { ret 2; }
    val source: SourceToken = unwrap_ok[SourceToken, io_error.Error](source_result);
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 3; }
    val submitted: Result[Token, io_error.Error] = submit_scoped_owned(?runtime, source, ?scope, test_operation(FILE_READ, 93));
    if (is_err[Token, io_error.Error](submitted)) { ret 4; }
    val token: Token = unwrap_ok[Token, io_error.Error](submitted);
    if (!cancel.cancel(?scope)
        || context.cancelled.index != token.index
        || context.cancelled.generation != token.generation) {
        ret 5;
    }
    var output: Completion;
    val early: Result[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (is_err[usize, io_error.Error](early) || unwrap_ok[usize, io_error.Error](early) != 0) { ret 6; }
    val draining: Result[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
    val deadline: Result[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    if (is_err[lifecycle.CloseResult, io_error.Error](draining)
        || is_err[lifecycle.CloseResult, io_error.Error](deadline)
        || is_err[bool, io_error.Error](complete_cancellation(?runtime, token))) {
        ret 7;
    }
    val settled: Result[usize, io_error.Error] = wait(?runtime, ?output, 1, 1000);
    if (is_err[usize, io_error.Error](settled)
        || unwrap_ok[usize, io_error.Error](settled) != 1
        || !output.has_error
        || output.error.kind != io_error.CANCELLED
        || context.released != 1) {
        ret 8;
    }
    if (!cancel.destroy(?scope)
        || is_err[bool, io_error.Error](unregister_source(?runtime, source))
        || is_err[bool, io_error.Error](close(?runtime))
        || is_err[bool, io_error.Error](destroy(?runtime))) {
        ret 9;
    }
    ret 0;
}

test "runtime: first abortive escalation updates unresolved source work" {
    var runtime: Runtime;
    if (is_err[bool, io_error.Error](make(?runtime, 2))) { ret 1; }
    var context: TestSource = TestSource{released: 0, cancellation_pending: true, cancelled: Token{index: 0, generation: 0}};
    val source_result: Result[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (is_err[SourceToken, io_error.Error](source_result)) { ret 2; }
    val source: SourceToken = unwrap_ok[SourceToken, io_error.Error](source_result);
    val submitted: Result[Token, io_error.Error] = submit_owned(?runtime, source, test_operation(RESOLVE, 94));
    if (is_err[Token, io_error.Error](submitted)) { ret 3; }
    val token: Token = unwrap_ok[Token, io_error.Error](submitted);
    val graceful: Result[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
    val deadline: Result[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    val cancelled: Result[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.CANCELLATION);
    if (is_err[lifecycle.CloseResult, io_error.Error](graceful)
        || is_err[lifecycle.CloseResult, io_error.Error](deadline)
        || is_err[lifecycle.CloseResult, io_error.Error](cancelled)
        || !unwrap_ok[lifecycle.CloseResult, io_error.Error](deadline).escalated
        || unwrap_ok[lifecycle.CloseResult, io_error.Error](cancelled).escalated) {
        ret 4;
    }
    var output: Completion;
    val early: Result[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (is_err[usize, io_error.Error](early) || unwrap_ok[usize, io_error.Error](early) != 0) { ret 5; }
    if (is_err[bool, io_error.Error](complete_cancellation(?runtime, token))) { ret 6; }
    val settled: Result[usize, io_error.Error] = wait(?runtime, ?output, 1, 1000);
    if (is_err[usize, io_error.Error](settled)
        || unwrap_ok[usize, io_error.Error](settled) != 1
        || !output.has_error
        || output.error.kind != io_error.TIMEOUT) {
        ret 7;
    }
    val state: lifecycle.Snapshot = snapshot(?runtime);
    if (state.terminal_cause != lifecycle.DEADLINE
        || is_err[bool, io_error.Error](unregister_source(?runtime, source))
        || is_err[bool, io_error.Error](destroy(?runtime))) {
        ret 8;
    }
    ret 0;
}
