# bounded portable operation-completion ownership

use std.allocator;
use std.chrono.time;
use io_error: std.io.error;
use std.memory;
use std.memory.table;
use std.sync.atomic;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

$if (capability.HAS_CLOCK && capability.HAS_IO_QUEUE && capability.HAS_PAGES) {
    use std.allocator.fixed;
    use std.allocator.page;
    use std.allocator.testing;
    use std.io.lifecycle;
    use std.sync.cancel;
    use std.sync.mutex;
    use std.sync.thread;
    use std.system.os;
    use os_shared: std.system.os.shared;
    use std.system.panic;

    $if ($mach.build.os == $mach.os.linux) {
        use native_os: std.system.os.linux;
    }
    $or ($mach.build.os == $mach.os.darwin) {
        use native_os: std.system.os.darwin;
    }
    $or ($mach.build.os == $mach.os.windows) {
        use native_os: std.system.os.windows;
    }
    $or {
        $error("std.io.runtime: unsupported target");
    }
}
$or {
    $error("std.io.runtime needs the clock, io queue and pages capabilities (std.system.capability.HAS_CLOCK, HAS_IO_QUEUE, HAS_PAGES)");
}

pub def Kind: u8;
pub val ACCEPT:       Kind = 0;
pub val CONNECT:      Kind = 1;
pub val READ:         Kind = 2;
pub val WRITE:        Kind = 3;
pub val RECEIVE_FROM: Kind = 4;
pub val SEND_TO:      Kind = 5;
pub val FILE_READ:    Kind = 6;
pub val FILE_WRITE:   Kind = 7;
pub val TIMER:        Kind = 8;
pub val PROCESS_WAIT: Kind = 9;
pub val USER_WAKE:    Kind = 10;
pub val SHUTDOWN:     Kind = 11;
pub val CLOSE:        Kind = 12;
pub val BIND:         Kind = 13;
pub val LISTEN:       Kind = 14;
pub val RESOLVE:      Kind = 15;
# a stream is readable, at EOF, or failed; nothing is read and no buffer is held
pub val READABLE: Kind = 16;

pub rec Token {
    index:      u32;
    generation: u32;
}

# buffer is borrowed from successful submission until its completion is dequeued
pub rec Operation {
    kind:     Kind;
    resource: usize;
    buffer:   *u8;
    length:   usize;
    offset:   u64;
    context:  usize;
}

# a terminal result. an error completion reports has_error and error, and a
# cancelled, timed-out or closed one still reports in bytes, items and
# end_of_stream the transfer that finished before the cancellation took
# effect: bytes a read placed in its buffer, bytes a write sent, datagrams a
# batch filled. those bytes belong to the stream, so a caller that cancels a
# read consumes them like any other read's. opening is nonzero exactly when the
# completion hands the caller a socket in resource: a successful accept or
# connect, or a cancelled accept that had already accepted, whose socket the
# caller owns and closes like any other
pub rec Completion {
    token:         Token;
    kind:          Kind;
    context:       usize;
    bytes:         usize;
    items:         usize;
    resource:      usize;
    opening:       u64;
    has_error:     bool;
    error:         io_error.Error;
    end_of_stream: bool;
}

# one native completion, laid out as the platform's IoCompletion
# ---
# source: the id of the source the event belongs to, 0 for a wake
pub rec NativeEvent {
    context: usize;
    events:  u32;
    source:  u16;
    status:  i64;
    flags:   u64;
}

pub rec SourceToken {
    index:      u32;
    generation: u32;
    tag:        u16;
}

# offered each native event carrying the source's id, and every wake (context
# 0). returns true when the source consumed the event
pub def DispatchFun: fun(ptr, usize, u32, i64, u64) bool;
pub def CancelFun:   fun(ptr, Token, io_error.Error) i64;
pub def ReleaseFun:  fun(ptr, *Completion);
pub val CANCELLATION_PENDING: i64 = 1;

# wait is false when the driver must not poll: the runtime is closed or a
# caller woke it, and woken says which
pub rec WaitPlan {
    wait:       bool;
    timeout_ms: i32;
    woken:      bool;
}

val SLOT_FREE:       u8 = 0;
val SLOT_ACTIVE:     u8 = 1;
val SLOT_QUEUED:     u8 = 2;
val SLOT_CANCELLING: u8 = 3;
val SLOT_RELEASING:  u8 = 4;

# a slot index sentinel for the free list and the completion queue
val NO_SLOT:   usize = ~(0::usize);
val NO_TIMER:  usize = ~(0::usize);
val NO_RECORD: usize = ~(0::usize);

# a source is a registered backend, so the table starts far below the slots
val SOURCE_INITIAL: usize = 4;

# readiness is harvested in fixed batches, so the batch is not a capacity
val NATIVE_BATCH: usize = 256;

val SOURCE_UNUSED:     u8  = 0;
val SOURCE_REGISTERED: u8  = 1;
val SOURCE_RETIRED:    u8  = 2;
val NO_SOURCE:         u32 = 0xffffffff;

# where a source id leads
# ---
# index:    the source slot holding the id while it is registered
# next:     the next free id of its chunk
# released: collections begun when the id was released
rec Route {
    index:    u32;
    next:     usize;
    released: u64;
}

rec Source {
    state:      u8;
    generation: u32;
    tag:        u16;
    context:    ptr;
    dispatch:   DispatchFun;
    cancel:     CancelFun;
    release:    ReleaseFun;
    live:       usize;
    busy:       usize;
    attachment: lifecycle.Attachment;
}

rec Slot {
    state:                  u8;
    generation:             u32;
    index:                  u32;
    runtime:                *Runtime;
    next:                   usize;
    completion:             Completion;
    operation_timer_index:  usize;
    deadline_record:        usize;
    cancellation_active:    bool;
    cancellation_pending:   bool;
    lifecycle_cancellation: bool;
    cancellation:           cancel.Registration;
    terminal_error:         io_error.Error;
    attachment:             lifecycle.Attachment;
    source_index:           u32;
    operation:              Operation;
    # the transfer a completion reported after the cancellation claimed the
    # slot, published with the cancellation
    settled_bytes: usize;
    settled_items: usize;
    settled_eof:   bool;
    # the socket an accept took before the cancellation claimed it, handed over
    # with the cancellation. settled_opening is zero when there is none
    settled_resource: usize;
    settled_opening:  u64;
}

val TIMER_OPERATION:      u8 = 0;
val TIMER_SCOPE_DEADLINE: u8 = 1;

# token names an operation entry's slot and record a scope entry's record
rec TimerEntry {
    deadline: time.Instant;
    token:    Token;
    purpose:  u8;
    record:   usize;
}

# every operation waiting on one owner's deadline shares one record and so one
# heap entry, however many operations the scope holds
rec DeadlineRecord {
    owner:       *cancel.Scope;
    at:          time.Instant;
    refs:        usize;
    timer_index: usize;
    next:        usize;
}

pub val OPEN:      u8 = lifecycle.OPEN;
pub val CLOSING:   u8 = lifecycle.CLOSING;
pub val CLOSED:    u8 = lifecycle.CLOSED;
pub val DESTROYED: u8 = 3;

# one thread owns wait and dequeue, while submission and resolution may be concurrent
pub rec Runtime {
    queue: os.IoQueue;
    # where every table's chunks come from
    allocator: allocator.Allocator;
    slots:     table.Table;
    timers:    table.Table;
    sources:   table.Table;
    # a Route per source id ever issued, indexed by id
    source_routes: table.Table;
    deadlines:     table.Table;
    # open addressed on (owner, at), a power of two at least twice the slots
    deadline_index: table.Table;
    deadline_pool:  table.Pool;
    deadline_live:  usize;
    native_events:  *NativeEvent;
    initial:        usize;
    # its floor is the generation a slot of a regrown chunk starts from
    slot_pool:    table.Pool;
    head:         usize;
    tail:         usize;
    count:        usize;
    live:         usize;
    timer_count:  usize;
    source_count: usize;
    # sources below this index have been initialised
    source_slots: usize;
    # registered sources per chunk of the source table
    source_live: [table.DIRECTORY]usize;
    # the source counterpart of the slot pool's floor
    source_floor: u32;
    # free source ids, each reused once no collection can still hold an event
    # harvested for it. id 0 is never issued
    route_pool: table.Pool;
    # native collections begun and ended, each a harvest and its dispatch
    collections_begun: u64;
    collections_ended: u64;
    # native events whose source id matched no registered source
    unrouted:        u64;
    native_controls: usize;
    lifecycle:       lifecycle.Lifecycle;
    destroyed:       bool;
    # a caller's wake, pending until a wait or a wait plan answers it
    woken:       bool;
    lock:        mutex.Mutex;
    native_lock: mutex.Mutex;
    # held for a whole native control, so a waiter can yield to one
    control_lock: mutex.Mutex;
}

# whether a byte range overlaps the runtime or any storage reachable through it
#
# read-only and allocation-free. the queried range must not change during the
# query. a caller may query while ordinary operations run, but must synchronize
# with initialization and destruction. ordinary operations grow the tables and
# release what a peak grew, so a query racing one can answer either way for a
# range in a chunk being added or released. any other range answers the same
# either way.
#
# a non-empty malformed range, or an uninitialized, partially initialized,
# partially torn-down or destroyed owner, reports overlap. an empty range owns
# no bytes and reports none. endpoints are inclusive: a one-byte range at
# usize::MAX is valid, and anything extending past it is malformed.
pub fun aliases(runtime: *Runtime, data: *u8, len: usize) bool {
    if (!memory.range_valid(data, len)) { ret true; }
    if (len == 0)                       { ret false; }
    if (!memory.range_valid(runtime::*u8, $size_of(Runtime)) ||
        runtime.slots.capacity == 0 || runtime.destroyed) { ret true; }
    if (memory.ranges_overlap(runtime::*u8, $size_of(Runtime), data, len)) {
        ret true;
    }
    var native_event_bytes: usize = 0;
    if (!memory.range_scaled(NATIVE_BATCH, $size_of(NativeEvent),
        ?native_event_bytes)) { ret true; }
    ret table.aliases(?runtime.slots, data, len) ||
        table.aliases(?runtime.timers, data, len) ||
        table.aliases(?runtime.sources, data, len) ||
        table.aliases(?runtime.source_routes, data, len) ||
        table.aliases(?runtime.deadlines, data, len) ||
        table.aliases(?runtime.deadline_index, data, len) ||
        memory.ranges_overlap(runtime.native_events::*u8, native_event_bytes,
        data, len);
}

fun slot_at(runtime: *Runtime, index: usize) *Slot {
    ret table.at(?runtime.slots, index)::*Slot;
}

fun source_at(runtime: *Runtime, index: usize) *Source {
    ret table.at(?runtime.sources, index)::*Source;
}

fun timer_at(runtime: *Runtime, index: usize) *TimerEntry {
    ret table.at(?runtime.timers, index)::*TimerEntry;
}

fun deadline_at(runtime: *Runtime, index: usize) *DeadlineRecord {
    ret table.at(?runtime.deadlines, index)::*DeadlineRecord;
}

fun bucket_at(runtime: *Runtime, index: usize) *usize {
    ret table.at(?runtime.deadline_index, index)::*usize;
}

# the slot table is the runtime's current size, not a limit it was given
# the slots the runtime holds now, which grow with load and fall back after it
pub fun capacity(runtime: *Runtime) usize {
    if (runtime == nil || runtime.destroyed) { ret 0; }
    ret runtime.slots.capacity;
}

# whether the live operation token names keeps capacity the runtime would
# otherwise give back
#
# the runtime gives back a chunk of its slot table only once that chunk and the
# one below it hold nothing live, and its timer, deadline and driver tables
# follow the slot table down. an operation submitted at a peak takes the lowest
# free slot, which is as high as the peak, so one that stays pending after the
# load leaves holds every chunk up to its own. this is true when the
# operation's slot lies above the slack chunk past where the live count would
# end if every live slot were packed from index 0, and the table holds a chunk
# past that slack: moving every such operation to the lowest free slots lets
# the runtime release it. an operation submitted now takes the lowest free
# slot, which never pins, so a caller that cancels and resubmits an operation
# that pins never has to do it twice for the same peak
# ---
# runtime: the runtime the operation was submitted to
# token:   the operation
# ret:     false for a stale token, an operation whose completion was taken,
#          or a runtime over an allocator that never reclaims, whose tables
#          keep their peak anyway
pub fun pins_capacity(runtime: *Runtime, token: Token) bool {
    if (runtime == nil || runtime.destroyed) { ret false; }
    mutex.lock(?runtime.lock);
    var pins: bool = false;
    if (token.index::usize < runtime.slots.capacity && runtime.live > 0 &&
        allocator.reclaims(?runtime.allocator)) {
        val slot: *Slot = slot_at(runtime, token.index::usize);
        if (slot.generation == token.generation && slot.state != SLOT_FREE) {
            val needed: usize = table.chunk_of(?runtime.slots, runtime.live - 1);
            pins = table.chunk_of(?runtime.slots, token.index::usize) >= needed + 2 &&
                runtime.slots.chunk_count > needed + 3;
        }
    }
    mutex.unlock(?runtime.lock);
    ret pins;
}

fun invalid(operation: io_error.Operation) io_error.Error {
    ret io_error.make(io_error.INVALID, operation);
}

fun exhausted(operation: io_error.Operation) io_error.Error {
    ret io_error.make(io_error.RESOURCE_EXHAUSTED, operation);
}

fun init_slot(runtime: *Runtime, index: usize) {
    val slot: *Slot = slot_at(runtime, index);
    slot.state                  = SLOT_FREE;
    slot.generation             = runtime.slot_pool.floor;
    slot.index                  = index::u32;
    slot.runtime                = runtime;
    slot.next                   = NO_SLOT;
    slot.operation_timer_index  = NO_TIMER;
    slot.deadline_record        = NO_RECORD;
    slot.cancellation_active    = false;
    slot.cancellation_pending   = false;
    slot.lifecycle_cancellation = false;
    slot.terminal_error         = io_error.make(io_error.OTHER, io_error.OP_UNKNOWN);
    settle_clear(slot);
    slot.attachment.owner      = nil;
    slot.attachment.generation = 0;
    slot.attachment.sequence   = 0;
    slot.attachment.active     = false;
    slot.source_index          = NO_SOURCE;
    cancel.init_registration(?slot.cancellation);
}

fun init_source(runtime: *Runtime, index: usize) {
    val source: *Source = source_at(runtime, index);
    source.state                 = SOURCE_UNUSED;
    source.generation            = runtime.source_floor;
    source.tag                   = 0;
    source.context               = nil;
    source.live                  = 0;
    source.busy                  = 0;
    source.attachment.owner      = nil;
    source.attachment.generation = 0;
    source.attachment.sequence   = 0;
    source.attachment.active     = false;
}

fun free_push(runtime: *Runtime, index: usize) {
    table.pool_put(?runtime.slot_pool, ?runtime.slots, index);
}

fun free_pop(runtime: *Runtime) usize {
    ret table.pool_take(?runtime.slot_pool, ?runtime.slots);
}

fun release_tables(runtime: *Runtime) {
    table.destroy(?runtime.deadline_index);
    table.destroy(?runtime.deadlines);
    table.destroy(?runtime.source_routes);
    table.destroy(?runtime.sources);
    table.destroy(?runtime.timers);
    table.destroy(?runtime.slots);
}

fun deadline_hash(owner: *cancel.Scope, at: time.Instant) usize {
    var h: u64 = owner::u64;
    h = (h ^ at.sec::u64) * 0x9e3779b97f4a7c15;
    h = (h ^ at.nsec::u64) * 0xbf58476d1ce4e5b9;
    ret (h ^ (h >> 31))::usize;
}

fun deadline_home(runtime: *Runtime, index: usize) usize {
    val record: *DeadlineRecord = deadline_at(runtime, index);
    ret deadline_hash(record.owner, record.at) & (runtime.deadline_index.capacity - 1);
}

# the index is at most half full, so a probe always reaches an empty bucket
fun deadline_index_insert(runtime: *Runtime, index: usize) {
    val mask:   usize = runtime.deadline_index.capacity - 1;
    var bucket: usize = deadline_home(runtime, index);
    for (@bucket_at(runtime, bucket) != 0) { bucket = (bucket + 1) & mask; }
    @bucket_at(runtime, bucket) = index + 1;
}

fun deadline_find(runtime: *Runtime, owner: *cancel.Scope, at: time.Instant) usize {
    val mask:   usize = runtime.deadline_index.capacity - 1;
    var bucket: usize = deadline_hash(owner, at) & mask;
    for (@bucket_at(runtime, bucket) != 0) {
        val index:  usize           = @bucket_at(runtime, bucket) - 1;
        val record: *DeadlineRecord = deadline_at(runtime, index);
        if (record.owner == owner && time.instant_equal(record.at, at)) { ret index; }
        bucket = (bucket + 1) & mask;
    }
    ret NO_RECORD;
}

# backward shift keeps every probe chain unbroken without tombstones
fun deadline_index_remove(runtime: *Runtime, index: usize) {
    val mask: usize = runtime.deadline_index.capacity - 1;
    var hole: usize = deadline_home(runtime, index);
    for (@bucket_at(runtime, hole) != index + 1) { hole = (hole + 1) & mask; }
    var next: usize = (hole + 1) & mask;
    for (@bucket_at(runtime, next) != 0) {
        val home: usize = deadline_home(runtime, @bucket_at(runtime, next) - 1);
        if (((next - home) & mask) >= ((next - hole) & mask)) {
            @bucket_at(runtime, hole) = @bucket_at(runtime, next);
            hole                      = next;
        }
        next = (next + 1) & mask;
    }
    @bucket_at(runtime, hole) = 0;
}

fun deadline_rebuild(runtime: *Runtime, buckets: usize) bool {
    var fresh: table.Table;
    if (!table.make(?fresh, ?runtime.allocator, $size_of(usize), buckets)) { ret false; }
    var stale: table.Table = runtime.deadline_index;
    runtime.deadline_index = fresh;
    memory.raw_zero(runtime.deadline_index.chunks[0], runtime.deadline_index.capacity * $size_of(usize));
    var index: usize = 0;
    for (index < runtime.deadlines.capacity) {
        if (deadline_at(runtime, index).refs > 0) { deadline_index_insert(runtime, index); }
        index = index + 1;
    }
    table.destroy(?stale);
    ret true;
}

fun adopt_deadlines(runtime: *Runtime) {
    val chunk: usize = runtime.deadlines.chunk_count - 1;
    val start: usize = table.chunk_start(?runtime.deadlines, chunk);
    val end:   usize = start + table.chunk_capacity(?runtime.deadlines, chunk);
    var index: usize = start;
    for (index < end) {
        @deadline_at(runtime, index) = DeadlineRecord{
            owner:       nil,
            at:          time.Instant{sec: 0, nsec: 0},
            refs:        0,
            timer_index: NO_TIMER,
            next:        NO_RECORD,
        };
        index = index + 1;
    }
    table.pool_adopt(?runtime.deadline_pool, ?runtime.deadlines);
}

# a live record holds at least one live slot, so records never outnumber slots
# and the index stays at most half full
fun reserve_deadlines(runtime: *Runtime, slots: usize) bool {
    for (runtime.deadlines.capacity < slots) {
        if (!table.grow(?runtime.deadlines)) { ret false; }
        adopt_deadlines(runtime);
    }
    if (runtime.deadline_index.capacity >= slots * 2) { ret true; }
    ret deadline_rebuild(runtime, slots * 2);
}

# every slot carries at most an operation timer and holds at most one deadline
# record, so a reserve of twice the slot table is a push that cannot fail. it
# is made for a slot capacity before the slot table reaches it
fun reserve_timers(runtime: *Runtime, slots: usize) bool {
    if (slots > ~(0::usize) / 4) { ret false; }
    ret table.reserve(?runtime.timers, slots * 2) && reserve_deadlines(runtime, slots);
}

# grow the slot table by one chunk, whose slots are initialised and join the
# pool. a token index is 32 bits wide on every backend
fun grow_slots(runtime: *Runtime) bool {
    if (runtime.slots.chunk_count >= table.DIRECTORY) { ret false; }
    val added: usize = table.chunk_capacity(?runtime.slots, runtime.slots.chunk_count);
    if (runtime.slots.capacity + added - 1 > 0xffffffff)          { ret false; }
    if (!reserve_timers(runtime, runtime.slots.capacity + added)) { ret false; }
    if (!table.grow(?runtime.slots))                              { ret false; }
    adopt_slots(runtime);
    ret true;
}

fun adopt_slots(runtime: *Runtime) {
    val chunk: usize = runtime.slots.chunk_count - 1;
    val start: usize = table.chunk_start(?runtime.slots, chunk);
    val end:   usize = start + table.chunk_capacity(?runtime.slots, chunk);
    var index: usize = start;
    for (index < end) {
        init_slot(runtime, index);
        index = index + 1;
    }
    table.pool_adopt(?runtime.slot_pool, ?runtime.slots);
}

# release the capacity a peak left behind. a slot chunk goes once it and the
# chunk below it are both empty, so one empty chunk always remains as slack
# and a load that crosses a chunk boundary back and forth never reallocates.
# the timer heap, deadline records and deadline index then follow the slot
# capacity down to the reserve it needs. only empty chunks are released, so
# nothing live moves
fun trim_locked(runtime: *Runtime) {
    table.pool_trim(?runtime.slot_pool, ?runtime.slots, $offset_of(Slot, generation));
    val slots: usize = runtime.slots.capacity;
    for (runtime.timers.chunk_count > 1) {
        val top: usize = runtime.timers.chunk_count - 1;
        if (runtime.timers.capacity - table.chunk_capacity(?runtime.timers, top) < slots * 2) { brk; }
        val released: err[allocator.Error] = table.shrink(?runtime.timers);
        if (sel released.err) { brk; }
    }
    for (runtime.deadlines.chunk_count > 1) {
        val top: usize = runtime.deadlines.chunk_count - 1;
        if (runtime.deadline_pool.live[top] != 0 ||
            runtime.deadlines.capacity - table.chunk_capacity(?runtime.deadlines, top) < slots) { brk; }
        if (!table.pool_shrink(?runtime.deadline_pool, ?runtime.deadlines)) { brk; }
    }
    # a refused rebuild keeps the larger index, which is still valid
    if (runtime.deadline_index.capacity > slots * 2) { deadline_rebuild(runtime, slots * 2); }
}

# the source table's counterpart of trim_locked, under the same slack rule
fun trim_sources_locked(runtime: *Runtime) {
    for (runtime.sources.chunk_count > 1) {
        val top: usize = runtime.sources.chunk_count - 1;
        if (runtime.source_live[top] != 0 || runtime.source_live[top - 1] != 0) { brk; }
        val start: usize = table.chunk_start(?runtime.sources, top);
        var end:   usize = start + table.chunk_capacity(?runtime.sources, top);
        if (end > runtime.source_slots) { end = runtime.source_slots; }
        var floor: u32   = runtime.source_floor;
        var index: usize = start;
        for (index < end) {
            val generation: u32 = source_at(runtime, index).generation;
            if (generation > floor) { floor = generation; }
            index = index + 1;
        }
        val released: err[allocator.Error] = table.shrink(?runtime.sources);
        if (sel released.err) { brk; }
        runtime.source_floor = floor;
        if (runtime.source_slots > start) { runtime.source_slots = start; }
    }
    # a chunk's newest free id is the last to become reusable
    for (runtime.source_routes.chunk_count > 1) {
        val top: usize = runtime.source_routes.chunk_count - 1;
        if (runtime.route_pool.live[top] != 0 || runtime.route_pool.live[top - 1] != 0 ||
            !route_reusable(runtime, table.pool_newest(?runtime.route_pool, ?runtime.source_routes, top))) { brk; }
        if (!table.pool_shrink(?runtime.route_pool, ?runtime.source_routes)) { brk; }
    }
}

# every byte the runtime owns comes from a: its tables, its native event
# batch, and the tables of every driver registered on it. the runtime keeps a
# copy of a, so a's context must outlive the runtime. a refusal from a is the
# only ceiling: initial is the size the runtime starts at, and the slot, timer
# and source tables grow on demand until a refuses. what a peak grew goes back
# to a once the load drains, keeping one chunk of slack above what is live, and
# nothing live moves when it does.
# ---
# runtime: the runtime to initialize
# a:       where every allocation is taken from and returned to
# initial: slots, timers and deadline records to start with, at least one
# ret:     ok, INVALID for a nil runtime or allocator or an initial size of
#          zero, RESOURCE_EXHAUSTED when a refuses
pub fun make(runtime: *Runtime, a: *allocator.Allocator, initial: usize) err[io_error.Error] {
    if (runtime == nil || a == nil || initial == 0 || initial > 0xffffffff) {
        ret err[io_error.Error].err{invalid(io_error.OP_CREATE)};
    }
    runtime.allocator = @a;
    if (!table.make(?runtime.slots, ?runtime.allocator, $size_of(Slot), initial)) {
        ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    runtime.source_floor  = 0;
    runtime.deadline_live = 0;
    table.pool_make(?runtime.slot_pool, $offset_of(Slot, next));
    table.pool_make(?runtime.deadline_pool, $offset_of(DeadlineRecord, next));
    adopt_slots(runtime);
    var chunk: usize = 0;
    for (chunk < table.DIRECTORY) {
        runtime.source_live[chunk] = 0;
        chunk                      = chunk + 1;
    }
    if (!table.make(?runtime.timers, ?runtime.allocator, $size_of(TimerEntry), initial) ||
        !table.make(?runtime.sources, ?runtime.allocator, $size_of(Source), SOURCE_INITIAL) ||
        !table.make(?runtime.source_routes, ?runtime.allocator, $size_of(Route), SOURCE_INITIAL) ||
        !table.make(?runtime.deadlines, ?runtime.allocator, $size_of(DeadlineRecord), initial)) {
        release_tables(runtime);
        ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    adopt_deadlines(runtime);
    if (!deadline_rebuild(runtime, initial * 2) || !reserve_timers(runtime, runtime.slots.capacity)) {
        release_tables(runtime);
        ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    val batch: res[*NativeEvent, allocator.Error] = allocator.zallocate[NativeEvent](?runtime.allocator, NATIVE_BATCH);
    if (sel batch.err) {
        release_tables(runtime);
        ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    runtime.native_events = batch.ok;

    runtime.initial      = initial;
    runtime.head         = NO_SLOT;
    runtime.tail         = NO_SLOT;
    runtime.count        = 0;
    runtime.live         = 0;
    runtime.timer_count  = 0;
    runtime.source_count = 0;
    runtime.source_slots = 0;
    table.pool_make(?runtime.route_pool, $offset_of(Route, next));
    adopt_routes(runtime);
    table.pool_take(?runtime.route_pool, ?runtime.source_routes);
    runtime.collections_begun = 0;
    runtime.collections_ended = 0;
    runtime.unrouted          = 0;
    runtime.native_controls   = 0;
    lifecycle.make(?runtime.lifecycle);
    runtime.destroyed    = false;
    runtime.woken        = false;
    runtime.lock         = mutex.make();
    runtime.native_lock  = mutex.make();
    runtime.control_lock = mutex.make();
    val code: i64 = os.io_queue_create(?runtime.queue);
    if (code < 0) {
        allocator.deallocate[NativeEvent](?runtime.allocator, runtime.native_events, NATIVE_BATCH);
        release_tables(runtime);
        runtime.native_events = nil;
        runtime.destroyed     = true;
        ret err[io_error.Error].err{os.error(code, io_error.OP_CREATE)};
    }
    ret err[io_error.Error].ok{};
}

fun route_at(runtime: *Runtime, id: u16) *Route {
    ret table.at(?runtime.source_routes, id::usize)::*Route;
}

fun route_reusable(runtime: *Runtime, id: usize) bool {
    ret route_at(runtime, id::u16).released <= runtime.collections_ended;
}

# the ids of a freshly grown last chunk of the route table join the pool
fun adopt_routes(runtime: *Runtime) {
    val chunk: usize = runtime.source_routes.chunk_count - 1;
    val start: usize = table.chunk_start(?runtime.source_routes, chunk);
    val end:   usize = start + table.chunk_capacity(?runtime.source_routes, chunk);
    var id:    usize = start;
    for (id < end) {
        val route: *Route = route_at(runtime, id::u16);
        route.index    = NO_SOURCE;
        route.released = 0;
        id             = id + 1;
    }
    table.pool_adopt(?runtime.route_pool, ?runtime.source_routes);
}

# the id a registration will take, 0 when every id is live or still held by a
# collection that began before its release. a chunk's ids are released in
# order, so its oldest free id is the first to become reusable, and the
# lowest chunk with a reusable one is taken so the high ids drain. nothing
# but growth changes until commit
fun take_source_id(runtime: *Runtime) u16 {
    var chunk: usize = 0;
    for (chunk < runtime.source_routes.chunk_count) {
        val head: usize = table.pool_oldest(?runtime.route_pool, ?runtime.source_routes, chunk);
        if (head != table.NO_INDEX && route_reusable(runtime, head)) { ret head::u16; }
        chunk = chunk + 1;
    }
    # ids are 16 bits wide
    if (runtime.source_routes.capacity > 0xffff || !table.grow(?runtime.source_routes)) { ret 0; }
    adopt_routes(runtime);
    ret table.pool_oldest(?runtime.route_pool, ?runtime.source_routes, runtime.source_routes.chunk_count - 1)::u16;
}

fun commit_source_id(runtime: *Runtime, id: u16, index: u32) {
    table.pool_take_head(?runtime.route_pool, ?runtime.source_routes, table.chunk_of(?runtime.source_routes, id::usize));
    route_at(runtime, id).index = index;
}

# an event harvested before this point may still name the id, so it waits for
# every collection already begun to end
fun release_source_id(runtime: *Runtime, id: u16) {
    route_at(runtime, id).released = runtime.collections_begun;
    table.pool_put(?runtime.route_pool, ?runtime.source_routes, id::usize);
}

fun collection_begin(runtime: *Runtime) {
    mutex.lock(?runtime.lock);
    runtime.collections_begun = runtime.collections_begun + 1;
    mutex.unlock(?runtime.lock);
}

fun collection_end(runtime: *Runtime) {
    mutex.lock(?runtime.lock);
    runtime.collections_ended = runtime.collections_ended + 1;
    # ids released during the collection may now free their chunk
    trim_sources_locked(runtime);
    mutex.unlock(?runtime.lock);
}

fun source_for(runtime: *Runtime, token: SourceToken) *Source {
    if (token.index::usize >= runtime.source_slots || token.tag == 0) { ret nil; }
    val source: *Source = source_at(runtime, token.index::usize);
    if (source.state != SOURCE_REGISTERED || source.generation != token.generation || source.tag != token.tag) { ret nil; }
    ret source;
}

fun source_for_retirement(runtime: *Runtime, token: SourceToken) *Source {
    if (token.index::usize >= runtime.source_slots || token.tag == 0) { ret nil; }
    val source: *Source = source_at(runtime, token.index::usize);
    if ((source.state != SOURCE_REGISTERED && source.state != SOURCE_RETIRED)
        || source.generation != token.generation
        || source.tag != token.tag) {
        ret nil;
    }
    ret source;
}

pub fun register_source(
    runtime: *Runtime,
    context: ptr,
    dispatch: DispatchFun,
    cancel_operation: CancelFun,
    release: ReleaseFun,
) res[SourceToken, io_error.Error] {
    if (runtime == nil || context == nil) {
        ret res[SourceToken, io_error.Error].err{invalid(io_error.OP_CREATE)};
    }
    mutex.lock(?runtime.lock);
    if (runtime.destroyed || lifecycle.snapshot(?runtime.lifecycle).state != lifecycle.OPEN) {
        mutex.unlock(?runtime.lock);
        ret res[SourceToken, io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_CREATE)};
    }
    val tag: u16 = take_source_id(runtime);
    if (tag == 0) {
        mutex.unlock(?runtime.lock);
        ret res[SourceToken, io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    var index: usize = 0;
    for (index < runtime.source_slots && source_at(runtime, index).state != SOURCE_UNUSED) { index = index + 1; }
    if (index == runtime.source_slots) {
        if (index == runtime.sources.capacity && !table.grow(?runtime.sources)) {
            mutex.unlock(?runtime.lock);
            ret res[SourceToken, io_error.Error].err{exhausted(io_error.OP_CREATE)};
        }
        init_source(runtime, index);
        runtime.source_slots = runtime.source_slots + 1;
    }
    val chunk:      usize   = table.chunk_of(?runtime.sources, index);
    val source:     *Source = source_at(runtime, index);
    var generation: u32     = source.generation + 1;
    if (generation == 0) { generation = 1; }
    source.state      = SOURCE_REGISTERED;
    source.generation = generation;
    source.tag        = tag;
    source.context    = context;
    source.dispatch   = dispatch;
    source.cancel     = cancel_operation;
    source.release    = release;
    source.live       = 0;
    source.busy       = 0;
    val attached: err[lifecycle.StateError] = lifecycle.attach(?runtime.lifecycle, ?source.attachment);
    if (sel attached.err) {
        # no token leaves, so the slot and the id go straight back
        source.state   = SOURCE_UNUSED;
        source.tag     = 0;
        source.context = nil;
        mutex.unlock(?runtime.lock);
        ret res[SourceToken, io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_CREATE)};
    }
    commit_source_id(runtime, tag, index::u32);
    runtime.source_count       = runtime.source_count + 1;
    runtime.source_live[chunk] = runtime.source_live[chunk] + 1;
    mutex.unlock(?runtime.lock);
    ret res[SourceToken, io_error.Error].ok{SourceToken{index: index::u32, generation: generation, tag: tag}};
}

pub fun retire_source(runtime: *Runtime, token: SourceToken) res[bool, io_error.Error] {
    if (runtime == nil) { ret res[bool, io_error.Error].err{invalid(io_error.OP_CLOSE)}; }
    mutex.lock(?runtime.lock);
    val source: *Source = source_for_retirement(runtime, token);
    if (source == nil) {
        mutex.unlock(?runtime.lock);
        ret res[bool, io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    if (source.state == SOURCE_RETIRED) {
        mutex.unlock(?runtime.lock);
        ret res[bool, io_error.Error].ok{false};
    }
    if (source.live != 0 || source.busy != 0) {
        mutex.unlock(?runtime.lock);
        ret res[bool, io_error.Error].err{io_error.make(io_error.BUSY, io_error.OP_CLOSE)};
    }
    source.state = SOURCE_RETIRED;
    mutex.unlock(?runtime.lock);
    ret res[bool, io_error.Error].ok{true};
}

pub fun release_source(runtime: *Runtime, token: SourceToken) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)}; }
    mutex.lock(?runtime.lock);
    val source: *Source = source_for_retirement(runtime, token);
    if (source == nil || source.state != SOURCE_RETIRED || source.live != 0 || source.busy != 0) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    release_source_id(runtime, source.tag);
    val chunk: usize = table.chunk_of(?runtime.sources, token.index::usize);
    source.state               = SOURCE_UNUSED;
    source.tag                 = 0;
    source.context             = nil;
    runtime.source_count       = runtime.source_count - 1;
    runtime.source_live[chunk] = runtime.source_live[chunk] - 1;
    val settled:     res[bool, lifecycle.StateError] = lifecycle.settle(?source.attachment);
    var wake_result: i64                             = 0;
    if (sel settled.ok && settled.ok) { wake_result = os.io_queue_wake(?runtime.queue); }
    trim_sources_locked(runtime);
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) {
        ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
    }
    ret err[io_error.Error].ok{};
}

pub fun unregister_source(runtime: *Runtime, token: SourceToken) err[io_error.Error] {
    val retired: res[bool, io_error.Error] = retire_source(runtime, token);
    if (sel retired.err) { ret err[io_error.Error].err{retired.err}; }
    ret release_source(runtime, token);
}

pub fun source_id(token: SourceToken) u16 {
    ret token.tag;
}

# native events whose source id matched no registered source since make
#
# a nonzero count is not by itself an error. a correct program raises it when a
# source is released between the harvest of a native batch and the dispatch of
# that source's event. a count that keeps rising with no releases points at a
# backend reporting a wrong id
pub fun unrouted_events(runtime: *Runtime) u64 {
    if (runtime == nil) { ret 0; }
    mutex.lock(?runtime.lock);
    val count: u64 = runtime.unrouted;
    mutex.unlock(?runtime.lock);
    ret count;
}

# the lowest free index is taken and an index is never recycled while it is
# live, so growth adds storage and moves nothing
fun claim_locked(runtime: *Runtime, operation: Operation, source_index: u32, token: *Token) err[io_error.Kind] {
    if (runtime.destroyed || lifecycle.snapshot(?runtime.lifecycle).state != lifecycle.OPEN) {
        ret err[io_error.Kind].err{io_error.CLOSED};
    }
    var index: usize = free_pop(runtime);
    if (index == NO_SLOT) {
        if (!grow_slots(runtime)) { ret err[io_error.Kind].err{io_error.RESOURCE_EXHAUSTED}; }
        index = free_pop(runtime);
    }
    val slot:       *Slot = slot_at(runtime, index);
    var generation: u32   = slot.generation + 1;
    if (generation == 0) { generation = 1; }
    slot.generation             = generation;
    slot.operation              = operation;
    slot.operation_timer_index  = NO_TIMER;
    slot.deadline_record        = NO_RECORD;
    slot.cancellation_active    = false;
    slot.cancellation_pending   = false;
    slot.lifecycle_cancellation = false;
    slot.terminal_error         = io_error.make(io_error.OTHER, io_error.OP_UNKNOWN);
    slot.source_index           = source_index;
    settle_clear(slot);
    cancel.init_registration(?slot.cancellation);
    val attached: err[lifecycle.StateError] = lifecycle.attach(?runtime.lifecycle, ?slot.attachment);
    if (sel attached.err) {
        free_push(runtime, index);
        ret err[io_error.Kind].err{io_error.CLOSED};
    }
    slot.state   = SLOT_ACTIVE;
    runtime.live = runtime.live + 1;
    if (source_index != NO_SOURCE) {
        val source: *Source = source_at(runtime, source_index::usize);
        source.live = source.live + 1;
    }
    @token = Token{index: index::u32, generation: generation};
    ret err[io_error.Kind].ok{};
}

pub fun submit(runtime: *Runtime, operation: Operation) res[Token, io_error.Error] {
    if (runtime == nil) { ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, NO_SOURCE, ?token);
    mutex.unlock(?runtime.lock);
    if (sel claimed.err) { ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)}; }
    ret res[Token, io_error.Error].ok{token};
}

pub fun submit_owned(runtime: *Runtime, source_token: SourceToken, operation: Operation) res[Token, io_error.Error] {
    if (runtime == nil) { ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    if (source_for(runtime, source_token) == nil) {
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)};
    }
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, source_token.index, ?token);
    mutex.unlock(?runtime.lock);
    if (sel claimed.err) { ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)}; }
    ret res[Token, io_error.Error].ok{token};
}

fun settle_clear(slot: *Slot) {
    slot.settled_bytes    = 0;
    slot.settled_items    = 0;
    slot.settled_eof      = false;
    slot.settled_resource = 0;
    slot.settled_opening  = 0;
}

# two reports of one operation's transfer describe the same native request, so
# the larger is kept: a sum could claim more than the buffer holds
fun settle_merge(slot: *Slot, bytes: usize, items: usize, eof: bool) {
    if (bytes > slot.settled_bytes) { slot.settled_bytes = bytes; }
    if (items > slot.settled_items) { slot.settled_items = items; }
    slot.settled_eof = slot.settled_eof || eof;
}

# a cancellation publishes whatever transfer settled before it
fun enqueue_cancellation(runtime: *Runtime, token: Token, slot: *Slot, failure: io_error.Error) {
    enqueue(runtime, token, slot, slot.settled_bytes, slot.settled_items, slot.settled_resource, slot.settled_opening, true, failure, slot.settled_eof);
}

fun slot_for(runtime: *Runtime, token: Token) *Slot {
    if (token.index::usize >= runtime.slots.capacity) { ret nil; }
    val slot: *Slot = slot_at(runtime, token.index::usize);
    if (slot.generation != token.generation || slot.state != SLOT_ACTIVE) { ret nil; }
    ret slot;
}

fun token_equal(a: Token, b: Token) bool {
    ret a.index == b.index && a.generation == b.generation;
}

fun timer_less(a: TimerEntry, b: TimerEntry) bool {
    if (time.instant_before(a.deadline, b.deadline)) { ret true; }
    if (time.instant_after(a.deadline, b.deadline))  { ret false; }
    if (a.purpose != b.purpose)                      { ret a.purpose == TIMER_SCOPE_DEADLINE; }
    if (a.purpose == TIMER_SCOPE_DEADLINE)           { ret a.record < b.record; }
    if (a.token.index < b.token.index)               { ret true; }
    if (a.token.index > b.token.index)               { ret false; }
    ret a.token.generation < b.token.generation;
}

fun timer_set_index(runtime: *Runtime, entry: TimerEntry, index: usize) {
    if (entry.purpose == TIMER_OPERATION) {
        slot_at(runtime, entry.token.index::usize).operation_timer_index = index;
    }
    or {
        deadline_at(runtime, entry.record).timer_index = index;
    }
}

fun timer_swap(runtime: *Runtime, a: usize, b: usize) {
    val first:  *TimerEntry = timer_at(runtime, a);
    val second: *TimerEntry = timer_at(runtime, b);
    val entry:  TimerEntry  = @first;
    @first  = @second;
    @second = entry;
    timer_set_index(runtime, @first, a);
    timer_set_index(runtime, @second, b);
}

fun timer_sift_up(runtime: *Runtime, start: usize) {
    var index: usize = start;
    for (index > 0) {
        val parent: usize = (index - 1) / 2;
        if (!timer_less(@timer_at(runtime, index), @timer_at(runtime, parent))) { ret; }
        timer_swap(runtime, index, parent);
        index = parent;
    }
}

fun timer_sift_down(runtime: *Runtime, start: usize) {
    var index: usize = start;
    for (true) {
        val left: usize = index * 2 + 1;
        if (left >= runtime.timer_count) { ret; }
        var child: usize = left;
        val right: usize = left + 1;
        if (right < runtime.timer_count && timer_less(@timer_at(runtime, right), @timer_at(runtime, left))) { child = right; }
        if (!timer_less(@timer_at(runtime, child), @timer_at(runtime, index)))                              { ret; }
        timer_swap(runtime, index, child);
        index = child;
    }
}

# the timer table is reserved at twice the slot table, so a push always fits
fun timer_push(runtime: *Runtime, entry: TimerEntry) {
    val index: usize = runtime.timer_count;
    @timer_at(runtime, index) = entry;
    timer_set_index(runtime, entry, index);
    runtime.timer_count = runtime.timer_count + 1;
    timer_sift_up(runtime, index);
}

fun timer_remove_at(runtime: *Runtime, index: usize) TimerEntry {
    val removed: TimerEntry = @timer_at(runtime, index);
    timer_set_index(runtime, removed, NO_TIMER);
    runtime.timer_count = runtime.timer_count - 1;
    if (index < runtime.timer_count) {
        @timer_at(runtime, index) = @timer_at(runtime, runtime.timer_count);
        timer_set_index(runtime, @timer_at(runtime, index), index);
        if (index > 0 && timer_less(@timer_at(runtime, index), @timer_at(runtime, (index - 1) / 2))) {
            timer_sift_up(runtime, index);
        }
        or {
            timer_sift_down(runtime, index);
        }
    }
    ret removed;
}

fun timer_remove_operation(runtime: *Runtime, token: Token) bool {
    val slot: *Slot = slot_for(runtime, token);
    if (slot == nil) { ret false; }
    val index: usize = slot.operation_timer_index;
    if (index >= runtime.timer_count || timer_at(runtime, index).purpose != TIMER_OPERATION || !token_equal(timer_at(runtime, index).token, token)) { ret false; }
    timer_remove_at(runtime, index);
    ret true;
}

fun deadline_push(runtime: *Runtime, index: usize) {
    timer_push(runtime, TimerEntry{
        deadline: deadline_at(runtime, index).at,
        token:    Token{index: 0, generation: 0},
        purpose:  TIMER_SCOPE_DEADLINE,
        record:   index,
    });
}

# a record whose entry already fired is armed again, so a late joiner still
# reaches expiry
fun deadline_acquire(runtime: *Runtime, owner: *cancel.Scope, at: time.Instant) usize {
    val found: usize = deadline_find(runtime, owner, at);
    if (found != NO_RECORD) {
        val shared: *DeadlineRecord = deadline_at(runtime, found);
        shared.refs = shared.refs + 1;
        if (shared.timer_index == NO_TIMER) { deadline_push(runtime, found); }
        ret found;
    }
    # the record table holds at least one record per slot, so one is free
    val index: usize = table.pool_take(?runtime.deadline_pool, ?runtime.deadlines);
    @deadline_at(runtime, index) = DeadlineRecord{
        owner:       owner,
        at:          at,
        refs:        1,
        timer_index: NO_TIMER,
        next:        NO_RECORD,
    };
    runtime.deadline_live = runtime.deadline_live + 1;
    deadline_index_insert(runtime, index);
    deadline_push(runtime, index);
    ret index;
}

fun deadline_release(runtime: *Runtime, slot: *Slot) {
    val index: usize = slot.deadline_record;
    if (index == NO_RECORD) { ret; }
    slot.deadline_record = NO_RECORD;
    val record: *DeadlineRecord = deadline_at(runtime, index);
    record.refs = record.refs - 1;
    if (record.refs > 0)                { ret; }
    if (record.timer_index != NO_TIMER) { timer_remove_at(runtime, record.timer_index); }
    deadline_index_remove(runtime, index);
    record.owner = nil;
    table.pool_put(?runtime.deadline_pool, ?runtime.deadlines, index);
    runtime.deadline_live = runtime.deadline_live - 1;
}

# a completion lives in its own slot and the queue links slots, so there is no
# second table to size and a slot holds at most one queued completion
fun enqueue(runtime: *Runtime, token: Token, slot: *Slot, bytes: usize, items: usize, resource: usize, opening: u64, has_error: bool, failure: io_error.Error, eof: bool) {
    slot.completion = Completion{
        token:         token,
        kind:          slot.operation.kind,
        context:       slot.operation.context,
        bytes:         bytes,
        items:         items,
        resource:      resource,
        opening:       opening,
        has_error:     has_error,
        error:         failure,
        end_of_stream: eof,
    };
    slot.next = NO_SLOT;
    if (runtime.tail == NO_SLOT) { runtime.head = token.index::usize; }
    or                           { slot_at(runtime, runtime.tail).next = token.index::usize; }
    runtime.tail  = token.index::usize;
    runtime.count = runtime.count + 1;
    slot.state    = SLOT_QUEUED;
}

fun cancellation_error(reason: cancel.Reason) io_error.Error {
    if (sel reason.timed_out) { ret io_error.make(io_error.TIMEOUT, io_error.OP_WAIT); }
    if (sel reason.cancelled) { ret io_error.make(io_error.CANCELLED, io_error.OP_WAIT); }
    ret io_error.make(io_error.CLOSED, io_error.OP_SUBMIT);
}

# a refused transition counts as not made, the same as the old false
fun transitioned(transition: cancel.Transition) bool {
    if (sel transition.ok) { ret transition.ok; }
    ret false;
}

fun close_error(cause: lifecycle.Cause) io_error.Error {
    if (cause == lifecycle.DEADLINE)     { ret io_error.make(io_error.TIMEOUT, io_error.OP_CLOSE); }
    if (cause == lifecycle.CANCELLATION) { ret io_error.make(io_error.CANCELLED, io_error.OP_CLOSE); }
    if (cause == lifecycle.FAILURE)      { ret io_error.make(io_error.IO, io_error.OP_CLOSE); }
    ret io_error.make(io_error.CLOSED, io_error.OP_CLOSE);
}

fun remove_slot_timers(runtime: *Runtime, token: Token) {
    timer_remove_operation(runtime, token);
    val slot: *Slot = slot_for(runtime, token);
    if (slot != nil) { deadline_release(runtime, slot); }
}

fun scope_cancel_callback(context: ptr, reason: cancel.Reason) {
    val slot:    *Slot    = context::*Slot;
    val runtime: *Runtime = slot.runtime;
    mutex.lock(?runtime.lock);
    if (slot.state != SLOT_ACTIVE) {
        panic.panic("std.io.runtime: cancellation lost operation ownership\n");
    }
    val token: Token = Token{index: slot.index, generation: slot.generation};
    remove_slot_timers(runtime, token);
    slot.state                  = SLOT_CANCELLING;
    slot.lifecycle_cancellation = false;
    slot.terminal_error         = cancellation_error(reason);
    val source_index:   u32            = slot.source_index;
    val terminal_error: io_error.Error = slot.terminal_error;
    slot.cancellation_pending = source_index != NO_SOURCE;
    var source: *Source = nil;
    if (source_index != NO_SOURCE) { source = source_at(runtime, source_index::usize); }
    mutex.unlock(?runtime.lock);
    var code: i64 = 0;
    if (source != nil) {
        code = source.cancel(source.context, token, terminal_error);
    }
    mutex.lock(?runtime.lock);
    if (code < 0) {
        mutex.unlock(?runtime.lock);
        panic.panic("std.io.runtime: source cancellation lost operation ownership\n");
    }
    if (slot.state == SLOT_CANCELLING && code != CANCELLATION_PENDING) {
        slot.cancellation_pending = false;
    }
    or (slot.state != SLOT_CANCELLING && slot.state != SLOT_QUEUED) {
        mutex.unlock(?runtime.lock);
        panic.panic("std.io.runtime: asynchronous cancellation lost operation ownership\n");
    }
    mutex.unlock(?runtime.lock);
}

fun scope_cancel_complete(context: ptr, reason: cancel.Reason) {
    val slot:    *Slot    = context::*Slot;
    val runtime: *Runtime = slot.runtime;
    mutex.lock(?runtime.lock);
    if (slot.state != SLOT_CANCELLING && slot.state != SLOT_QUEUED) {
        panic.panic("std.io.runtime: cancellation completion lost ownership\n");
    }
    val token:     Token = Token{index: slot.index, generation: slot.generation};
    var published: bool  = false;
    if (slot.state == SLOT_CANCELLING && !slot.cancellation_pending) {
        enqueue_cancellation(runtime, token, slot, slot.terminal_error);
        published = true;
    }
    slot.cancellation_active = false;
    if (!transitioned(cancel.finish(?slot.cancellation))) {
        panic.panic("std.io.runtime: cancellation completion was not owned\n");
    }
    if (published && os.io_queue_wake(?runtime.queue) < 0) {
        panic.panic("std.io.runtime: open queue wake failed\n");
    }
    mutex.unlock(?runtime.lock);
}

fun release_claim_locked(runtime: *Runtime, token: Token) {
    val slot: *Slot = slot_at(runtime, token.index::usize);
    if (slot.source_index != NO_SOURCE) {
        val source: *Source = source_at(runtime, slot.source_index::usize);
        source.live = source.live - 1;
    }
    slot.state                  = SLOT_FREE;
    slot.cancellation_active    = false;
    slot.cancellation_pending   = false;
    slot.lifecycle_cancellation = false;
    slot.source_index           = NO_SOURCE;
    settle_clear(slot);
    cancel.init_registration(?slot.cancellation);
    free_push(runtime, token.index::usize);
    runtime.live = runtime.live - 1;
    val settled: res[bool, lifecycle.StateError] = lifecycle.settle(?slot.attachment);
    if (sel settled.err) {
        val current: lifecycle.Snapshot = lifecycle.snapshot(?runtime.lifecycle);
        if (current.state != lifecycle.OPEN) {
            panic.panic("std.io.runtime: released claim did not settle open lifecycle\n");
        }
    }
    trim_locked(runtime);
}

fun attach_scope_locked(runtime: *Runtime, token: Token, scope: *cancel.Scope) cancel.Reason {
    val slot:     *Slot         = slot_at(runtime, token.index::usize);
    val attached: cancel.Reason = cancel.attach_with_completion(scope, ?slot.cancellation, scope_cancel_callback, scope_cancel_complete, slot::ptr);
    if (!sel attached.active) { ret attached; }
    slot.cancellation_active = true;
    val query: cancel.DeadlineQuery = cancel.get_deadline(scope);
    if (sel query.ok) {
        if (sel query.ok.some) {
            slot.deadline_record = deadline_acquire(runtime, query.ok.some.owner, query.ok.some.at);
        }
    }
    ret cancel.Reason.active{};
}

fun submit_scoped_with_source(
    runtime: *Runtime,
    source_token: SourceToken,
    owned: bool,
    scope: *cancel.Scope,
    operation: Operation,
) res[Token, io_error.Error] {
    if (runtime == nil || scope == nil) { ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret res[Token, io_error.Error].err{now.err}; }
    cancel.expire(scope, now.ok);
    val query:      cancel.DeadlineQuery = cancel.get_deadline(scope);
    var needs_wake: bool                 = false;
    if (sel query.ok) { needs_wake = sel query.ok.some; }
    mutex.lock(?runtime.lock);
    if (owned && source_for(runtime, source_token) == nil) {
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)};
    }
    var source_index: u32 = NO_SOURCE;
    if (owned) { source_index = source_token.index; }
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, source_index, ?token);
    if (sel claimed.err) {
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)};
    }
    if (needs_wake) {
        val wake_result: i64 = os.io_queue_wake(?runtime.queue);
        if (wake_result < 0) {
            release_claim_locked(runtime, token);
            mutex.unlock(?runtime.lock);
            ret res[Token, io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
        }
    }
    val attached: cancel.Reason = attach_scope_locked(runtime, token, scope);
    if (!sel attached.active) {
        release_claim_locked(runtime, token);
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{cancellation_error(attached)};
    }
    mutex.unlock(?runtime.lock);
    ret res[Token, io_error.Error].ok{token};
}

# prior cancellation is observed or the returned token is atomically scope-owned
pub fun submit_scoped(runtime: *Runtime, scope: *cancel.Scope, operation: Operation) res[Token, io_error.Error] {
    ret submit_scoped_with_source(runtime, SourceToken{index: 0, generation: 0, tag: 0}, false, scope, operation);
}

pub fun submit_scoped_owned(
    runtime: *Runtime,
    source_token: SourceToken,
    scope: *cancel.Scope,
    operation: Operation,
) res[Token, io_error.Error] {
    ret submit_scoped_with_source(runtime, source_token, true, scope, operation);
}

# the slot a completion for token may still settle: one not yet published,
# whether active or already cancelling
fun slot_unsettled(runtime: *Runtime, token: Token) *Slot {
    if (token.index::usize >= runtime.slots.capacity) { ret nil; }
    val slot: *Slot = slot_at(runtime, token.index::usize);
    if (slot.generation != token.generation)                        { ret nil; }
    if (slot.state != SLOT_ACTIVE && slot.state != SLOT_CANCELLING) { ret nil; }
    ret slot;
}

# a completion that loses to a cancellation already underway is not published
# itself. when transfer is set its bytes, items and end of stream (and a copy)
# are recorded for the cancellation to carry, and it succeeds. so is the socket
# an accept hands over (a nonzero opening), which nothing but the cancellation
# can give the caller. otherwise it is refused with CLOSED, so its caller still
# owns anything it would have handed over
fun resolve_with_copy(runtime: *Runtime, token: Token, source: *u8, copy: bool, transfer: bool, bytes: usize, items: usize, resource: usize, opening: u64, has_error: bool, failure: io_error.Error, eof: bool) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    val slot: *Slot = slot_unsettled(runtime, token);
    if (slot == nil) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    if (copy && (slot.operation.kind != FILE_READ || bytes > slot.operation.length || (bytes > 0 && (source == nil || slot.operation.buffer == nil)))) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{invalid(io_error.OP_READ)};
    }
    # a claimed registration means the cancel callback is about to run, and a
    # cancelling slot publishes its cancellation later: either way it has lost
    var lost: bool = slot.state == SLOT_CANCELLING;
    if (!lost && slot.cancellation_active && !transitioned(cancel.unregister(?slot.cancellation))) { lost = true; }
    if (lost) {
        if (opening != 0 && slot.operation.kind == ACCEPT && slot.settled_opening == 0) {
            slot.settled_resource = resource;
            slot.settled_opening  = opening;
            mutex.unlock(?runtime.lock);
            ret err[io_error.Error].ok{};
        }
        if (!transfer) {
            mutex.unlock(?runtime.lock);
            ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
        }
        # the buffer stays borrowed until the cancellation is published
        if (copy && bytes > 0) { memory.raw_copy(slot.operation.buffer::ptr, source::ptr, bytes); }
        settle_merge(slot, bytes, items, eof);
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].ok{};
    }
    slot.cancellation_active = false;
    remove_slot_timers(runtime, token);
    if (copy && bytes > 0) { memory.raw_copy(slot.operation.buffer::ptr, source::ptr, bytes); }
    enqueue(runtime, token, slot, bytes, items, resource, opening, has_error, failure, eof);
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) {
        ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
    }
    ret err[io_error.Error].ok{};
}

fun resolve(runtime: *Runtime, token: Token, transfer: bool, bytes: usize, items: usize, resource: usize, has_error: bool, failure: io_error.Error, eof: bool) err[io_error.Error] {
    ret resolve_with_copy(runtime, token, nil, false, transfer, bytes, items, resource, 0, has_error, failure, eof);
}

# a byte completion. one that finishes after a cancellation claimed the
# operation is carried by the cancelled completion instead, and still succeeds
pub fun complete(runtime: *Runtime, token: Token, bytes: usize, resource: usize, end_of_stream: bool) err[io_error.Error] {
    ret resolve(runtime, token, true, bytes, 0, resource, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), end_of_stream);
}

# copy is atomic with terminal publication. after a cancellation claimed the
# operation the copy still lands and the cancelled completion reports it
pub fun complete_copy(runtime: *Runtime, token: Token, source: *u8, bytes: usize, resource: usize, end_of_stream: bool) err[io_error.Error] {
    ret resolve_with_copy(runtime, token, source, true, true, bytes, 0, resource, 0, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), end_of_stream);
}

# a completion that hands the caller a socket it did not open itself, such as
# an accepted or a connected one, also carries that socket's opening, which is
# never zero. after a cancellation claimed an accept, the accepted socket rides
# on the cancelled completion and this succeeds: the caller of the accept owns
# it. after a cancellation claimed any other operation this is refused with
# CLOSED, and the caller of this keeps, and closes, the socket
# ---
# resource: the native socket
# opening:  the opening its handle was stamped with (std.io.handle)
pub fun complete_opened(runtime: *Runtime, token: Token, resource: usize, opening: u64) err[io_error.Error] {
    ret resolve_with_copy(runtime, token, nil, false, false, 0, 0, resource, opening, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), false);
}

# batch completions report byte progress and completed item count separately,
# and after a cancellation claimed the operation both ride on its completion
pub fun complete_batch(runtime: *Runtime, token: Token, bytes: usize, items: usize, resource: usize) err[io_error.Error] {
    ret resolve(runtime, token, true, bytes, items, resource, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), false);
}

# a failure after a cancellation claimed the operation is refused with CLOSED:
# the cancellation is reported in its place, with whatever transfer settled
pub fun fail(runtime: *Runtime, token: Token, failure: io_error.Error) err[io_error.Error] {
    ret resolve(runtime, token, false, 0, 0, 0, true, failure, false);
}

# asynchronous sources publish only after target ownership has quiesced
pub fun complete_cancellation(runtime: *Runtime, token: Token) err[io_error.Error] {
    ret complete_cancellation_transfer(runtime, token, 0, 0, false);
}

# publish an asynchronous cancellation together with the transfer its native
# request finished before the cancellation took effect. a transfer a
# completion already recorded for the operation describes the same request,
# so the larger of the two is published, never their sum
# ---
# bytes:         bytes the request moved
# items:         datagrams a batch filled
# end_of_stream: whether a read reached the end of its stream
pub fun complete_cancellation_transfer(runtime: *Runtime, token: Token, bytes: usize, items: usize, end_of_stream: bool) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    if (token.index::usize >= runtime.slots.capacity) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    val slot: *Slot = slot_at(runtime, token.index::usize);
    if (slot.generation != token.generation || slot.state != SLOT_CANCELLING || !slot.cancellation_pending) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    slot.cancellation_pending = false;
    settle_merge(slot, bytes, items, end_of_stream);
    # the scope's completion hook has yet to run and publishes the transfer
    if (slot.cancellation_active) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].ok{};
    }
    enqueue_cancellation(runtime, token, slot, slot.terminal_error);
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) { ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)}; }
    ret err[io_error.Error].ok{};
}

# deadlines are absolute monotonic instants and never expire early
# late delivery is limited only by native scheduling and runtime dequeue latency
pub fun submit_timer(runtime: *Runtime, deadline: time.Instant, context: usize) res[Token, io_error.Error] {
    if (runtime == nil || deadline.sec < 0 || deadline.nsec < 0 || deadline.nsec >= 1000000000) {
        ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)};
    }
    val operation: Operation = Operation{kind: TIMER, resource: 0, buffer: nil, length: 0, offset: 0, context: context};
    mutex.lock(?runtime.lock);
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, NO_SOURCE, ?token);
    if (sel claimed.ok) {
        val wake_result: i64 = os.io_queue_wake(?runtime.queue);
        if (wake_result < 0) {
            release_claim_locked(runtime, token);
            mutex.unlock(?runtime.lock);
            ret res[Token, io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
        }
        timer_push(runtime, TimerEntry{
            deadline: deadline,
            token:    token,
            purpose:  TIMER_OPERATION,
            record:   NO_RECORD,
        });
    }
    mutex.unlock(?runtime.lock);
    if (sel claimed.err) { ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)}; }
    ret res[Token, io_error.Error].ok{token};
}

pub fun submit_timer_scoped(runtime: *Runtime, scope: *cancel.Scope, deadline: time.Instant, context: usize) res[Token, io_error.Error] {
    if (runtime == nil || scope == nil || deadline.sec < 0 || deadline.nsec < 0 || deadline.nsec >= 1000000000) {
        ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)};
    }
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret res[Token, io_error.Error].err{now.err}; }
    cancel.expire(scope, now.ok);
    val operation: Operation = Operation{kind: TIMER, resource: 0, buffer: nil, length: 0, offset: 0, context: context};
    mutex.lock(?runtime.lock);
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, NO_SOURCE, ?token);
    if (sel claimed.err) {
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)};
    }
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    if (wake_result < 0) {
        release_claim_locked(runtime, token);
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
    }
    val attached: cancel.Reason = attach_scope_locked(runtime, token, scope);
    if (!sel attached.active) {
        release_claim_locked(runtime, token);
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{cancellation_error(attached)};
    }
    timer_push(runtime, TimerEntry{
        deadline: deadline,
        token:    token,
        purpose:  TIMER_OPERATION,
        record:   NO_RECORD,
    });
    mutex.unlock(?runtime.lock);
    ret res[Token, io_error.Error].ok{token};
}

# expiry and cancellation race under one lock and publish one terminal result
pub fun cancel_timer(runtime: *Runtime, token: Token) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    val slot: *Slot = slot_for(runtime, token);
    if (slot == nil || slot.operation.kind != TIMER || !timer_remove_operation(runtime, token)) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    if (slot.cancellation_active && !transitioned(cancel.unregister(?slot.cancellation))) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    slot.cancellation_active = false;
    deadline_release(runtime, slot);
    enqueue(runtime, token, slot, 0, 0, 0, 0, true, io_error.make(io_error.CANCELLED, io_error.OP_WAIT), false);
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) { ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)}; }
    ret err[io_error.Error].ok{};
}

# a fired scope entry leaves its record to the registrations that still hold it
fun timers_expire(runtime: *Runtime, now: time.Instant) *cancel.Scope {
    # all due timers enter the completion queue in deadline and token order
    for (runtime.timer_count > 0 && !time.instant_before(now, timer_at(runtime, 0).deadline)) {
        val entry: TimerEntry = timer_remove_at(runtime, 0);
        if (entry.purpose == TIMER_SCOPE_DEADLINE) { ret deadline_at(runtime, entry.record).owner; }
        val slot: *Slot = slot_for(runtime, entry.token);
        if (slot != nil) {
            if (!slot.cancellation_active || transitioned(cancel.unregister(?slot.cancellation))) {
                slot.cancellation_active = false;
                deadline_release(runtime, slot);
                enqueue(runtime, entry.token, slot, 0, 0, 0, 0, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), false);
            }
        }
    }
    ret nil;
}

fun timer_timeout(runtime: *Runtime, requested_ms: i32, now: time.Instant) i32 {
    if (runtime.timer_count == 0) { ret requested_ms; }
    val deadline: time.Instant = timer_at(runtime, 0).deadline;
    if (!time.instant_before(now, deadline)) { ret 0; }
    var sec:  i64 = deadline.sec - now.sec;
    var nsec: i64 = deadline.nsec - now.nsec;
    if (nsec < 0) {
        sec  = sec - 1;
        nsec = nsec + 1000000000;
    }
    var timer_ms: i32 = 0x7fffffff;
    if (sec < 2147483) {
        val rounded: i64 = sec * 1000 + (nsec + 999999) / 1000000;
        timer_ms = rounded::i32;
    }
    if (requested_ms >= 0 && requested_ms < timer_ms) { ret requested_ms; }
    ret timer_ms;
}

fun drain(runtime: *Runtime, output: *Completion, output_capacity: usize) usize {
    var written: usize = 0;
    for (written < output_capacity && runtime.count > 0) {
        val index: usize = runtime.head;
        val slot:  *Slot = slot_at(runtime, index);
        runtime.head = slot.next;
        if (runtime.head == NO_SLOT) { runtime.tail = NO_SLOT; }
        slot.next     = NO_SLOT;
        runtime.count = runtime.count - 1;
        val completion:   Completion = slot.completion;
        val source_index: u32        = slot.source_index;
        var source:       *Source    = nil;
        if (source_index != NO_SOURCE) { source = source_at(runtime, source_index::usize); }
        slot.state = SLOT_RELEASING;
        mutex.unlock(?runtime.lock);
        if (source != nil) {
            source.release(source.context, ?completion);
        }
        output[written] = completion;
        mutex.lock(?runtime.lock);
        slot.state                  = SLOT_FREE;
        slot.cancellation_active    = false;
        slot.cancellation_pending   = false;
        slot.lifecycle_cancellation = false;
        slot.source_index           = NO_SOURCE;
        cancel.init_registration(?slot.cancellation);
        free_push(runtime, index);
        runtime.live = runtime.live - 1;
        if (source != nil) {
            source.live = source.live - 1;
        }
        val settled: res[bool, lifecycle.StateError] = lifecycle.settle(?slot.attachment);
        if (sel settled.ok && settled.ok && os.io_queue_wake(?runtime.queue) < 0) {
            panic.panic("std.io.runtime: terminal lifecycle wake failed\n");
        }
        trim_locked(runtime);
        written = written + 1;
    }
    ret written;
}

# a failed clock stops expiry and is handed back, the last good read is the
# caller's now
fun settle_expired_locked(runtime: *Runtime) time.InstantClock {
    var now:           time.InstantClock = time.instant();
    var expired_scope: *cancel.Scope     = nil;
    if (sel now.ok) { expired_scope = timers_expire(runtime, now.ok); }
    for (expired_scope != nil) {
        mutex.unlock(?runtime.lock);
        cancel.timeout(expired_scope);
        mutex.lock(?runtime.lock);
        now           = time.instant();
        expired_scope = nil;
        if (sel now.ok) { expired_scope = timers_expire(runtime, now.ok); }
    }
    ret now;
}

# drains completions and expires due deadlines
# a wait's return answers a pending caller wake, which answer_wake takes and
# reports through woken
fun take(runtime: *Runtime, output: *Completion, output_capacity: usize, answer_wake: bool, woken: *bool) res[usize, io_error.Error] {
    mutex.lock(?runtime.lock);
    if (runtime.destroyed) {
        mutex.unlock(?runtime.lock);
        ret res[usize, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    val settled: time.InstantClock = settle_expired_locked(runtime);
    if (sel settled.err) {
        mutex.unlock(?runtime.lock);
        ret res[usize, io_error.Error].err{settled.err};
    }
    val written: usize = drain(runtime, output, output_capacity);
    if (answer_wake && (written > 0 || runtime.woken)) {
        @woken        = runtime.woken;
        runtime.woken = false;
    }
    mutex.unlock(?runtime.lock);
    ret res[usize, io_error.Error].ok{written};
}

# drains completions and expires due deadlines without entering the native wait
# a pending caller wake stays pending for the next wait or wait plan
pub fun poll(runtime: *Runtime, output: *Completion, output_capacity: usize) res[usize, io_error.Error] {
    if (runtime == nil || output == nil || output_capacity == 0) {
        ret res[usize, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    var woken: bool = false;
    ret take(runtime, output, output_capacity, false, ?woken);
}

# prepares another subsystem to wait on the runtime's native queue
#
# the driver polls the queue for at most timeout_ms and then drains with poll.
# the queue also carries the runtime's own wakes, so a poll that returns with
# nothing drained is not a reason to stop: the driver prepares again with the
# time it has left, and ends early only on a plan with woken set, which answers
# a caller's wake. a plan with wait unset must not be polled.
# ---
# timeout_ms: relative bound on the driver's poll, -1 for unbounded
# ret:        the plan, or the runtime's refusal
pub fun prepare_wait(runtime: *Runtime, timeout_ms: i32) res[WaitPlan, io_error.Error] {
    if (runtime == nil || timeout_ms < -1) {
        ret res[WaitPlan, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    mutex.lock(?runtime.lock);
    if (runtime.destroyed) {
        mutex.unlock(?runtime.lock);
        ret res[WaitPlan, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    val settled: time.InstantClock = settle_expired_locked(runtime);
    if (sel settled.err) {
        mutex.unlock(?runtime.lock);
        ret res[WaitPlan, io_error.Error].err{settled.err};
    }
    if (runtime.woken) {
        runtime.woken = false;
        mutex.unlock(?runtime.lock);
        ret res[WaitPlan, io_error.Error].ok{WaitPlan{wait: false, timeout_ms: 0, woken: true}};
    }
    if (lifecycle.snapshot(?runtime.lifecycle).state == lifecycle.CLOSED) {
        mutex.unlock(?runtime.lock);
        ret res[WaitPlan, io_error.Error].ok{WaitPlan{wait: false, timeout_ms: 0, woken: false}};
    }
    var native_timeout: i32 = timer_timeout(runtime, timeout_ms, settled.ok);
    # ready completions forbid blocking, not collecting readiness
    if (runtime.count != 0) { native_timeout = 0; }
    mutex.unlock(?runtime.lock);
    ret res[WaitPlan, io_error.Error].ok{WaitPlan{wait: true, timeout_ms: native_timeout, woken: false}};
}

pub fun begin_native_control(runtime: *Runtime) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_WAIT)}; }
    mutex.lock(?runtime.control_lock);
    mutex.lock(?runtime.lock);
    if (runtime.destroyed) {
        mutex.unlock(?runtime.lock);
        mutex.unlock(?runtime.control_lock);
        ret err[io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    runtime.native_controls = runtime.native_controls + 1;
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) {
        mutex.lock(?runtime.lock);
        runtime.native_controls = runtime.native_controls - 1;
        mutex.unlock(?runtime.lock);
        mutex.unlock(?runtime.control_lock);
        ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
    }
    mutex.lock(?runtime.native_lock);
    ret err[io_error.Error].ok{};
}

pub fun end_native_control(runtime: *Runtime) {
    mutex.lock(?runtime.lock);
    runtime.native_controls = runtime.native_controls - 1;
    mutex.unlock(?runtime.lock);
    mutex.unlock(?runtime.native_lock);
    mutex.unlock(?runtime.control_lock);
}

# the number of native events collected
# controlled reports a poll skipped for a pending native control
fun native_poll(runtime: *Runtime, timeout_ms: i32, controlled: *bool) res[usize, io_error.Error] {
    mutex.lock(?runtime.lock);
    val destroyed: bool = runtime.destroyed;
    @controlled = runtime.native_controls != 0;
    mutex.unlock(?runtime.lock);
    if (destroyed)   { ret res[usize, io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_WAIT)}; }
    if (@controlled) { ret res[usize, io_error.Error].ok{0}; }
    val polled: i64 = native_os.io_queue_poll(
        ?runtime.queue,
        runtime.native_events::*native_os.IoCompletion,
        NATIVE_BATCH,
        timeout_ms,
    );
    if (polled < 0) { ret res[usize, io_error.Error].err{os.error(polled, io_error.OP_WAIT)}; }
    ret res[usize, io_error.Error].ok{polled::usize};
}

# the caller holds the lock, which is released on return
fun offer_locked(runtime: *Runtime, source: *Source, event: NativeEvent) bool {
    source.busy = source.busy + 1;
    val context:  ptr         = source.context;
    val dispatch: DispatchFun = source.dispatch;
    mutex.unlock(?runtime.lock);
    val claimed: bool = dispatch(context, event.context, event.events, event.status, event.flags);
    mutex.lock(?runtime.lock);
    source.busy = source.busy - 1;
    mutex.unlock(?runtime.lock);
    ret claimed;
}

fun wake_source(runtime: *Runtime, index: usize, event: NativeEvent) {
    mutex.lock(?runtime.lock);
    if (runtime.destroyed || index >= runtime.source_slots || source_at(runtime, index).state != SOURCE_REGISTERED) {
        mutex.unlock(?runtime.lock);
        ret;
    }
    offer_locked(runtime, source_at(runtime, index), event);
}

# a wake reaches every source, any other event only the source its id names
fun dispatch_sources(runtime: *Runtime, event: NativeEvent) {
    if ((event.events & native_os.IO_EVENT_WAKE) != 0) {
        var i: usize = 0;
        for (i < runtime.source_slots) {
            wake_source(runtime, i, event);
            i = i + 1;
        }
        ret;
    }
    mutex.lock(?runtime.lock);
    if (runtime.destroyed) {
        mutex.unlock(?runtime.lock);
        ret;
    }
    var source: *Source = nil;
    if (event.source != 0 && event.source::usize < runtime.source_routes.capacity) {
        val index: usize = route_at(runtime, event.source).index::usize;
        if (index < runtime.source_slots) {
            val candidate: *Source = source_at(runtime, index);
            if (candidate.state == SOURCE_REGISTERED && candidate.tag == event.source) { source = candidate; }
        }
    }
    if (source == nil) {
        runtime.unrouted = runtime.unrouted + 1;
        mutex.unlock(?runtime.lock);
        ret;
    }
    offer_locked(runtime, source, event);
}

fun flush_sources(runtime: *Runtime) {
    dispatch_sources(runtime, NativeEvent{
        context: 0,
        events:  native_os.IO_EVENT_WAKE,
        status:  0,
        flags:   0,
        source:  0,
    });
}

# collects native readiness and publishes every source's queued completions
# controlled reports that a native control cut the collection short
# the caller owns native_lock
fun collect_native(runtime: *Runtime, timeout_ms: i32, controlled: *bool) res[usize, io_error.Error] {
    var total:   usize = 0;
    var timeout: i32   = timeout_ms;
    collection_begin(runtime);
    fin { collection_end(runtime); }
    for (true) {
        val polled: res[usize, io_error.Error] = native_poll(runtime, timeout, controlled);
        if (sel polled.err) { ret polled; }
        val waited: usize = polled.ok;
        var i:      usize = 0;
        for (i < waited) {
            val event: NativeEvent = runtime.native_events[i];
            dispatch_sources(runtime, event);
            i = i + 1;
        }
        total = total + waited;
        # a full batch may have left readiness behind, so drain without blocking
        if (waited < NATIVE_BATCH) { brk; }
        timeout = 0;
    }
    flush_sources(runtime);
    ret res[usize, io_error.Error].ok{total};
}

# the relative time left before deadline, rounded up so a wait never ends short
fun remaining_ms(timeout_ms: i32, deadline: time.Instant, now: time.Instant) i32 {
    if (timeout_ms <= 0)                     { ret timeout_ms; }
    if (!time.instant_before(now, deadline)) { ret 0; }
    val left: i64 = time.instant_sub(deadline, now);
    ret ((left + 999999) / 1000000)::i32;
}

# waits for completions
#
# returns 0 only when timeout_ms has passed, a caller called wake, or the
# runtime is closed with nothing left to return. the runtime's own wakes, such
# as the one a submission posts, never end a wait early: the wait keeps waiting
# for the time that remains. a return that carries completions also answers a
# pending wake.
# ---
# output:          completions are written here; the caller owns it and may
#                  reuse it after this call returns
# output_capacity: the most completions one call writes
# timeout_ms:      relative bound, 0 to collect without blocking, -1 for
#                  unbounded
# ret:             the number of completions written, or the refusal
pub fun wait(runtime: *Runtime, output: *Completion, output_capacity: usize, timeout_ms: i32) res[usize, io_error.Error] {
    if (runtime == nil || output == nil || output_capacity == 0 || timeout_ms < -1) {
        ret res[usize, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    var deadline: time.Instant;
    if (timeout_ms > 0) {
        val start: time.InstantClock = time.instant();
        if (sel start.err) { ret res[usize, io_error.Error].err{start.err}; }
        deadline = time.instant_add(start.ok, timeout_ms::i64 * 1000000);
    }
    # readiness is collected without blocking before completions are returned,
    # so a resource that completes at submission cannot keep the native queue
    # from being polled
    var native_timeout: i32  = 0;
    var controlled:     bool = false;
    for (true) {
        # a native control holds control_lock until it ends, so yielding to it
        # here keeps the unfair native_lock from starving it
        if (controlled) {
            mutex.lock(?runtime.control_lock);
            mutex.unlock(?runtime.control_lock);
        }
        mutex.lock(?runtime.native_lock);
        mutex.lock(?runtime.lock);
        val destroyed: bool = runtime.destroyed;
        mutex.unlock(?runtime.lock);
        if (destroyed) {
            mutex.unlock(?runtime.native_lock);
            ret res[usize, io_error.Error].err{invalid(io_error.OP_WAIT)};
        }
        controlled = false;
        val collected: res[usize, io_error.Error] = collect_native(runtime, native_timeout, ?controlled);
        mutex.unlock(?runtime.native_lock);
        if (sel collected.err) { ret res[usize, io_error.Error].err{collected.err}; }
        var woken:   bool                       = false;
        val drained: res[usize, io_error.Error] = take(runtime, output, output_capacity, true, ?woken);
        if (sel drained.err)         { ret drained; }
        if (drained.ok > 0 || woken) { ret drained; }
        var remaining: i32 = timeout_ms;
        if (timeout_ms > 0) {
            val now: time.InstantClock = time.instant();
            if (sel now.err) { ret res[usize, io_error.Error].err{now.err}; }
            remaining = remaining_ms(timeout_ms, deadline, now.ok);
        }
        # the first pass never blocked, so a zero timeout is answered here
        if (remaining == 0) { ret res[usize, io_error.Error].ok{0}; }
        val prepared: res[WaitPlan, io_error.Error] = prepare_wait(runtime, remaining);
        if (sel prepared.err)  { ret res[usize, io_error.Error].err{prepared.err}; }
        if (!prepared.ok.wait) { ret res[usize, io_error.Error].ok{0}; }
        native_timeout = prepared.ok.timeout_ms;
    }
    ret res[usize, io_error.Error].ok{0};
}

fun post_wake(runtime: *Runtime, caller: bool) err[io_error.Error] {
    if (runtime == nil) {
        ret err[io_error.Error].err{invalid(io_error.OP_WAKE)};
    }
    mutex.lock(?runtime.lock);
    val destroyed: bool = runtime.destroyed;
    var code:      i64;
    if (!destroyed) {
        if (caller) { runtime.woken = true; }
        code = os.io_queue_wake(?runtime.queue);
    }
    mutex.unlock(?runtime.lock);
    if (destroyed) { ret err[io_error.Error].err{invalid(io_error.OP_WAKE)}; }
    if (code < 0)  { ret err[io_error.Error].err{os.error(code, io_error.OP_WAKE)}; }
    ret err[io_error.Error].ok{};
}

# ends a blocked wait early, or the next wait if none is blocked
# wakes coalesce: one wait answers every wake that came before its return
pub fun wake(runtime: *Runtime) err[io_error.Error] {
    ret post_wake(runtime, true);
}

# makes a blocked wait collect every source again without ending it
# a source that queues completions off the native queue calls this, not wake
pub fun notify(runtime: *Runtime) err[io_error.Error] {
    ret post_wake(runtime, false);
}

# close rejects new work and queues one terminal completion for every active operation
pub fun begin_close(runtime: *Runtime, mode: lifecycle.Mode, cause: lifecycle.Cause) res[lifecycle.CloseResult, io_error.Error] {
    if (runtime == nil) { ret res[lifecycle.CloseResult, io_error.Error].err{invalid(io_error.OP_CLOSE)}; }
    mutex.lock(?runtime.lock);
    if (runtime.destroyed) {
        mutex.unlock(?runtime.lock);
        ret res[lifecycle.CloseResult, io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    val closing: lifecycle.CloseResult = lifecycle.begin_close(?runtime.lifecycle, mode, cause);
    if (!closing.started && !closing.escalated) {
        mutex.unlock(?runtime.lock);
        ret res[lifecycle.CloseResult, io_error.Error].ok{closing};
    }
    val closed_error: io_error.Error = close_error(closing.snapshot.terminal_cause);
    if (closing.escalated) {
        var i: usize = 0;
        for (i < runtime.slots.capacity) {
            val slot: *Slot = slot_at(runtime, i);
            if (slot.state == SLOT_CANCELLING && slot.cancellation_pending && slot.lifecycle_cancellation) {
                slot.terminal_error = closed_error;
            }
            i = i + 1;
        }
    }
    if (closing.started) {
        var i: usize = 0;
        for (i < runtime.slots.capacity) {
            val slot: *Slot = slot_at(runtime, i);
            if (slot.state == SLOT_ACTIVE) {
                val token: Token = Token{index: i::u32, generation: slot.generation};
                if (!slot.cancellation_active || transitioned(cancel.unregister(?slot.cancellation))) {
                    slot.cancellation_active = false;
                    remove_slot_timers(runtime, token);
                    slot.state                  = SLOT_CANCELLING;
                    slot.lifecycle_cancellation = true;
                    slot.terminal_error         = closed_error;
                    val source_index:   u32            = slot.source_index;
                    val terminal_error: io_error.Error = slot.terminal_error;
                    slot.cancellation_pending = source_index != NO_SOURCE;
                    var source: *Source = nil;
                    if (source_index != NO_SOURCE) { source = source_at(runtime, source_index::usize); }
                    mutex.unlock(?runtime.lock);
                    var cancel_code: i64 = 0;
                    if (source != nil) {
                        cancel_code = source.cancel(source.context, token, terminal_error);
                    }
                    mutex.lock(?runtime.lock);
                    if (cancel_code < 0) {
                        mutex.unlock(?runtime.lock);
                        panic.panic("std.io.runtime: close lost source operation ownership\n");
                    }
                    if (slot.state == SLOT_CANCELLING && cancel_code != CANCELLATION_PENDING) {
                        slot.cancellation_pending = false;
                        enqueue_cancellation(runtime, token, slot, closed_error);
                    }
                    or (slot.state != SLOT_CANCELLING && slot.state != SLOT_QUEUED) {
                        mutex.unlock(?runtime.lock);
                        panic.panic("std.io.runtime: asynchronous close lost operation ownership\n");
                    }
                }
            }
            i = i + 1;
        }
    }
    val code: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (code < 0) { ret res[lifecycle.CloseResult, io_error.Error].err{os.error(code, io_error.OP_CLOSE)}; }
    ret res[lifecycle.CloseResult, io_error.Error].ok{closing};
}

pub fun close(runtime: *Runtime) res[bool, io_error.Error] {
    val closed: res[lifecycle.CloseResult, io_error.Error] = begin_close(runtime, lifecycle.ABORTIVE, lifecycle.EXPLICIT);
    if (sel closed.err) { ret res[bool, io_error.Error].err{closed.err}; }
    ret res[bool, io_error.Error].ok{closed.ok.started};
}

fun destroy_with_native_ownership(runtime: *Runtime) err[io_error.Error] {
    mutex.lock(?runtime.lock);
    if (runtime.destroyed || lifecycle.snapshot(?runtime.lifecycle).state != lifecycle.CLOSED) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    if (runtime.live != 0 || runtime.count != 0 || runtime.native_controls != 0) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.BUSY, io_error.OP_CLOSE)};
    }
    var i: usize = 0;
    for (i < runtime.source_slots) {
        if (source_at(runtime, i).state != SOURCE_UNUSED) {
            mutex.unlock(?runtime.lock);
            ret err[io_error.Error].err{io_error.make(io_error.BUSY, io_error.OP_CLOSE)};
        }
        i = i + 1;
    }
    val native_events: *NativeEvent = runtime.native_events;
    runtime.destroyed = true;
    mutex.unlock(?runtime.lock);
    val queue_result:  i64                  = os.io_queue_close(?runtime.queue);
    val source_result: err[allocator.Error] = table.destroy(?runtime.sources);
    val route_result:  err[allocator.Error] = table.destroy(?runtime.source_routes);
    val timer_result:  err[allocator.Error] = table.destroy(?runtime.timers);
    val index_result:  err[allocator.Error] = table.destroy(?runtime.deadline_index);
    val record_result: err[allocator.Error] = table.destroy(?runtime.deadlines);
    val slot_result:   err[allocator.Error] = table.destroy(?runtime.slots);
    val native_result: err[allocator.Error] = allocator.deallocate[NativeEvent](?runtime.allocator, native_events, NATIVE_BATCH);
    runtime.native_events = nil;
    runtime.source_slots  = 0;
    table.pool_make(?runtime.slot_pool, $offset_of(Slot, next));
    table.pool_make(?runtime.deadline_pool, $offset_of(DeadlineRecord, next));
    table.pool_make(?runtime.route_pool, $offset_of(Route, next));
    runtime.head = NO_SLOT;
    runtime.tail = NO_SLOT;
    if (queue_result < 0)                                                                                                                                                       { ret err[io_error.Error].err{os.error(queue_result, io_error.OP_CLOSE)}; }
    if (sel timer_result.err || sel index_result.err || sel record_result.err || sel source_result.err || sel route_result.err || sel native_result.err || sel slot_result.err) { ret err[io_error.Error].err{io_error.make(io_error.IO, io_error.OP_CLOSE)}; }
    ret err[io_error.Error].ok{};
}

# destroy is valid only after close completions have been dequeued: a runtime
# that is not closed or already destroyed is INVALID, one with live operations,
# queued completions, a native controller or a registered source is EBUSY;
# a refused destroy keeps every allocation
pub fun destroy(runtime: *Runtime) err[io_error.Error] {
    if (runtime == nil) {
        ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    mutex.lock(?runtime.native_lock);
    val result: err[io_error.Error] = destroy_with_native_ownership(runtime);
    mutex.unlock(?runtime.native_lock);
    ret result;
}

pub fun pending(runtime: *Runtime) usize {
    if (runtime == nil || runtime.destroyed) { ret 0; }
    mutex.lock(?runtime.lock);
    val count: usize = runtime.live;
    mutex.unlock(?runtime.lock);
    ret count;
}

pub fun snapshot(runtime: *Runtime) lifecycle.Snapshot {
    if (runtime == nil || runtime.destroyed) {
        ret lifecycle.Snapshot{
            state:          lifecycle.CLOSED,
            mode:           lifecycle.ABORTIVE,
            cause:          lifecycle.FAILURE,
            terminal_cause: lifecycle.FAILURE,
            outstanding:    0,
        };
    }
    ret lifecycle.snapshot(?runtime.lifecycle);
}

fun ok_err(r: err[io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_bool(r: res[bool, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_token(r: res[Token, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_source(r: res[SourceToken, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_usize(r: res[usize, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_plan(r: res[WaitPlan, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_close(r: res[lifecycle.CloseResult, io_error.Error]) bool {
    ret sel r.ok;
}

fun test_operation(kind: Kind, context: usize) Operation {
    ret Operation{kind: kind, resource: 0, buffer: nil, length: 0, offset: 0, context: context};
}

fun succeeded(operation: cancel.Operation) bool {
    ret sel operation.ok;
}

test runtime__ownership_query_covers_every_backing_allocation {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime:  Runtime;
    var external: [8]u8;
    if (!aliases(?runtime, ?external[0], 1) || aliases(nil, nil, 0) ||
        !aliases((~(0::usize) - 1)::*Runtime, ?external[0], 1)) { ret 1; }
    if (!ok_err(make(?runtime, ?pa, 2))) { ret 2; }
    if (!aliases(?runtime, (?runtime)::*u8, $size_of(Runtime)) ||
        !aliases(?runtime, runtime.slots.chunks[0]::*u8, $size_of(Slot) * 2) ||
        !aliases(?runtime, runtime.timers.chunks[0]::*u8,
        $size_of(TimerEntry) * 4) ||
        !aliases(?runtime, runtime.sources.chunks[0]::*u8, $size_of(Source)) ||
        !aliases(?runtime, runtime.native_events::*u8,
        $size_of(NativeEvent) * 2) ||
        aliases(?runtime, ?external[0], 8) ||
        !aliases(?runtime, (~(0::usize) - 1)::*u8, 3)) { ret 3; }
    # every chunk a growth adds is owned as well: eight live operations fill
    # the chunks of 2, 2 and 4 slots, and the ninth grows a fourth
    var grown: usize = 0;
    for (grown < 9) {
        val token: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, grown));
        if (sel token.err) { ret 5; }
        grown = grown + 1;
    }
    if (runtime.slots.chunk_count != 4)                                   { ret 6; }
    if (!aliases(?runtime, runtime.slots.chunks[3]::*u8, $size_of(Slot))) { ret 7; }
    if (!ok_bool(close(?runtime)))                                        { ret 4; }
    var output:  [16]Completion;
    var settled: usize = 0;
    for (settled < 9) {
        val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 16, 0);
        if (sel waited.err) { ret 8; }
        settled = settled + waited.ok;
    }
    if (!ok_err(destroy(?runtime)) || !aliases(?runtime, ?external[0], 1)) { ret 4; }
    ret 0;
}

# a refused growth is the only ceiling the runtime has, and this is the one
# way to reach it on purpose: the allocator the runtime was made with refuses
test runtime__a_refused_growth_is_reported_and_disturbs_nothing_live {
    # the tracker is too large for the stack, so it lives on the mapper
    val t: *testing.Testing = os.allocate($size_of(testing.Testing))::*testing.Testing;
    if (t == nil) { ret 1; }
    fin { os.deallocate(t::ptr, $size_of(testing.Testing)); }
    val tr: err[allocator.Error] = testing.make(t);
    if (sel tr.err) { ret 1; }
    fin { testing.dnit(t); }

    var runtime: Runtime;
    if (!ok_err(make(?runtime, testing.allocator_of(t), 2))) { ret 2; }
    if (capacity(?runtime) != 2)                             { ret 2; }

    val first:  res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 1));
    val second: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, 2));
    if (sel first.err)  { ret 3; }
    if (sel second.err) { ret 3; }
    val first_slot:  *Slot     = slot_at(?runtime, first.ok.index::usize);
    val second_slot: *Slot     = slot_at(?runtime, second.ok.index::usize);
    val first_op:    Operation = first_slot.operation;
    val second_op:   Operation = second_slot.operation;

    # fail each allocation the growth makes in turn: every refusal is a clean
    # RESOURCE_EXHAUSTED with both live slots untouched, and the growth that
    # gets past them all succeeds
    var refused: usize                      = 0;
    var offset:  usize                      = 1;
    var third:   res[Token, io_error.Error] = res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)};
    for (offset <= 8) {
        # the ordinal counts refused attempts too, so it is re-based each time
        testing.fail_at_ordinal(t, testing.attempt_count(t) + offset);
        third = submit(?runtime, test_operation(TIMER, 3));
        if (sel third.ok) { brk; }
        if (sel third.err) {
            if (third.err.kind != io_error.RESOURCE_EXHAUSTED) { ret 4; }
            if (third.err.operation != io_error.OP_SUBMIT)     { ret 4; }
        }
        if (slot_at(?runtime, first.ok.index::usize) != first_slot)   { ret 5; }
        if (slot_at(?runtime, second.ok.index::usize) != second_slot) { ret 5; }
        if (first_slot.operation.context != first_op.context)         { ret 5; }
        if (second_slot.operation.context != second_op.context)       { ret 5; }
        if (first_slot.generation != first.ok.generation)             { ret 5; }
        if (second_slot.generation != second.ok.generation)           { ret 5; }
        if (capacity(?runtime) != 2)                                  { ret 5; }
        refused = refused + 1;
        offset  = offset + 1;
    }
    testing.clear_failure(t);
    if (refused == 0)           { ret 7; }
    if (!sel third.ok)          { ret 7; }
    if (capacity(?runtime) < 3) { ret 7; }
    var third_token: Token;
    if (sel third.ok) {
        if (third.ok.index != 2) { ret 7; }
        third_token = third.ok;
    }

    # every operation, including the ones outstanding across the refusals,
    # settles exactly once
    if (!ok_err(complete(?runtime, first.ok, 10, 0, false)))    { ret 8; }
    if (!ok_err(complete(?runtime, second.ok, 20, 0, false)))   { ret 8; }
    if (!ok_err(complete(?runtime, third_token, 30, 0, false))) { ret 8; }
    var output: [8]Completion;
    val polled: res[usize, io_error.Error] = poll(?runtime, ?output[0], 8);
    if (sel polled.err) { ret 9; }
    if (polled.ok != 3) { ret 9; }
    var seen: usize = 0;
    var i:    usize = 0;
    for (i < 3) {
        if (output[i].context < 1 || output[i].context > 3) { ret 9; }
        if ((seen & (1 << output[i].context)) != 0)         { ret 9; }
        seen = seen | (1 << output[i].context);
        if (output[i].bytes != output[i].context * 10) { ret 9; }
        i = i + 1;
    }
    val again: res[usize, io_error.Error] = poll(?runtime, ?output[0], 8);
    if (sel again.err) { ret 10; }
    if (again.ok != 0) { ret 10; }

    if (!ok_bool(close(?runtime)))         { ret 11; }
    if (!ok_err(destroy(?runtime)))        { ret 11; }
    if (testing.leaked(t))                 { ret 12; }
    if (testing.double_free_count(t) != 0) { ret 12; }
    ret 0;
}

# growth must not move a slot a completion context or a caller already holds
test runtime__a_slot_address_taken_before_a_growth_survives_it {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 2))) { ret 1; }
    val held: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 5));
    if (sel held.err) { ret 2; }
    val address:   *Slot    = slot_at(?runtime, held.ok.index::usize);
    val identity:  *Runtime = address.runtime;
    var submitted: usize    = 0;
    for (submitted < 4000) {
        val extra: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, submitted));
        if (sel extra.err) { ret 3; }
        submitted = submitted + 1;
    }
    if (capacity(?runtime) < 4001)                                  { ret 4; }
    if (slot_at(?runtime, held.ok.index::usize) != address)         { ret 5; }
    if (address.runtime != identity || address.runtime != ?runtime) { ret 6; }
    if (address.index != held.ok.index)                             { ret 7; }
    # the operation outstanding across every growth still completes and routes
    if (!ok_err(complete(?runtime, held.ok, 11, 3, false))) { ret 8; }
    var output: Completion;
    val polled: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel polled.err)                                              { ret 9; }
    if (polled.ok != 1 || output.context != 5 || output.bytes != 11) { ret 9; }
    if (output.token.index != held.ok.index)                         { ret 9; }
    close(?runtime);
    var drained: [64]Completion;
    var total:   usize = 0;
    for (total < 4000) {
        val waited: res[usize, io_error.Error] = wait(?runtime, ?drained[0], 64, 0);
        if (sel waited.err) { ret 10; }
        if (waited.ok == 0) { ret 10; }
        total = total + waited.ok;
    }
    if (!ok_err(destroy(?runtime))) { ret 11; }
    ret 0;
}

# a token is only ever reused after its generation has moved on
test runtime__stale_tokens_stay_refused_across_growth_and_reuse {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 2))) { ret 1; }
    val first: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 1));
    if (sel first.err) { ret 2; }
    val stale: Token = first.ok;
    if (!ok_err(complete(?runtime, stale, 1, 0, false))) { ret 3; }
    var output: Completion;
    if (!ok_usize(poll(?runtime, ?output, 1)))          { ret 4; }
    if (ok_err(complete(?runtime, stale, 1, 0, false))) { ret 5; }
    var submitted: usize = 0;
    var reused:    bool  = false;
    for (submitted < 64) {
        val extra: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, submitted));
        if (sel extra.err) { ret 6; }
        if (extra.ok.index == stale.index) {
            if (extra.ok.generation == stale.generation) { ret 7; }
            reused = true;
        }
        submitted = submitted + 1;
    }
    if (!reused)                                        { ret 8; }
    if (ok_err(complete(?runtime, stale, 1, 0, false))) { ret 9; }
    close(?runtime);
    var drained: [64]Completion;
    var total:   usize = 0;
    for (total < 64) {
        val waited: res[usize, io_error.Error] = wait(?runtime, ?drained[0], 64, 0);
        if (sel waited.err) { ret 10; }
        if (waited.ok == 0) { ret 10; }
        total = total + waited.ok;
    }
    if (!ok_err(destroy(?runtime))) { ret 11; }
    ret 0;
}

test runtime__external_wait_preparation_never_consumes_completions {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 41));
    if (sel submitted.err)                                      { ret 1; }
    if (!ok_err(complete(?runtime, submitted.ok, 3, 0, false))) { ret 1; }
    val blocked: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 7);
    if (sel blocked.err)            { ret 1; }
    if (!blocked.ok.wait)           { ret 1; }
    if (blocked.ok.timeout_ms != 0) { ret 1; }
    var output:  Completion;
    val drained: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel drained.err)      { ret 1; }
    if (drained.ok != 1)      { ret 1; }
    if (output.bytes != 3)    { ret 1; }
    if (output.context != 41) { ret 1; }
    val ready: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 7);
    if (sel ready.err)            { ret 1; }
    if (!ready.ok.wait)           { ret 1; }
    if (ready.ok.timeout_ms != 7) { ret 1; }
    close(?runtime);
    val closed: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, -1);
    if (sel closed.err)             { ret 1; }
    if (closed.ok.wait)             { ret 1; }
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test runtime__copy_completion_publishes_bytes_atomically {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var destination: [4]u8;
    var source:      [4]u8;
    source[0] = 1;
    source[1] = 2;
    source[2] = 3;
    source[3] = 4;
    val operation: Operation                  = Operation{kind: FILE_READ, resource: 7, buffer: (?destination)::*u8, length: 4, offset: 12, context: 31};
    val submitted: res[Token, io_error.Error] = submit(?runtime, operation);
    if (sel submitted.err)                                                           { ret 1; }
    if (!ok_err(complete_copy(?runtime, submitted.ok, (?source)::*u8, 4, 7, false))) { ret 1; }
    var output:    Completion;
    val completed: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel completed.err)                                                                        { ret 1; }
    if (completed.ok != 1)                                                                        { ret 1; }
    if (output.bytes != 4)                                                                        { ret 1; }
    if (output.has_error)                                                                         { ret 1; }
    if (destination[0] != 1 || destination[1] != 2 || destination[2] != 3 || destination[3] != 4) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test runtime__close_wins_copy_completion_without_touching_caller_bytes {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var destination: [2]u8;
    destination[0] = 9;
    destination[1] = 9;
    var source: [2]u8;
    source[0] = 1;
    source[1] = 2;
    val operation: Operation                  = Operation{kind: FILE_READ, resource: 7, buffer: (?destination)::*u8, length: 2, offset: 0, context: 41};
    val submitted: res[Token, io_error.Error] = submit(?runtime, operation);
    if (sel submitted.err) { ret 1; }
    val token: Token = submitted.ok;
    if (!ok_bool(close(?runtime)))                                           { ret 1; }
    if (ok_err(complete_copy(?runtime, token, (?source)::*u8, 2, 7, false))) { ret 1; }
    if (destination[0] != 9 || destination[1] != 9)                          { ret 1; }
    var output:    Completion;
    val completed: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel completed.err)                    { ret 1; }
    if (completed.ok != 1)                    { ret 1; }
    if (!output.has_error)                    { ret 1; }
    if (output.error.kind != io_error.CLOSED) { ret 1; }
    if (!ok_err(destroy(?runtime)))           { ret 1; }
    ret 0;
}

test runtime__cancellation_wins_copy_completion_without_touching_caller_bytes {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, ?pa, 1)) || !succeeded(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
    var destination: [2]u8;
    destination[0] = 8;
    destination[1] = 8;
    var source: [2]u8;
    source[0] = 3;
    source[1] = 4;
    val operation: Operation                  = Operation{kind: FILE_READ, resource: 7, buffer: (?destination)::*u8, length: 2, offset: 0, context: 51};
    val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, operation);
    if (sel submitted.err)                    { ret 1; }
    if (!transitioned(cancel.cancel(?scope))) { ret 1; }
    val token: Token = submitted.ok;
    if (ok_err(complete_copy(?runtime, token, (?source)::*u8, 2, 7, false))) { ret 1; }
    if (destination[0] != 8 || destination[1] != 8)                          { ret 1; }
    var output:    Completion;
    val completed: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel completed.err)                       { ret 1; }
    if (completed.ok != 1)                       { ret 1; }
    if (!output.has_error)                       { ret 1; }
    if (output.error.kind != io_error.CANCELLED) { ret 1; }
    if (!succeeded(cancel.destroy(?scope)))      { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test runtime__close_settles_every_operation_and_is_idempotent {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 32))) { ret 1; }
    var i: usize = 0;
    for (i < 32) {
        if (!ok_token(submit(?runtime, test_operation((i % 11)::Kind, i)))) { ret 1; }
        i = i + 1;
    }
    val first_close:  res[bool, io_error.Error] = close(?runtime);
    val second_close: res[bool, io_error.Error] = close(?runtime);
    if (sel first_close.err)  { ret 1; }
    if (!first_close.ok)      { ret 1; }
    if (sel second_close.err) { ret 1; }
    if (second_close.ok)      { ret 1; }
    var output: [7]Completion;
    var total:  usize = 0;
    for (total < 32) {
        val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 7, 0);
        if (sel waited.err) { ret 1; }
        val count: usize = waited.ok;
        if (count == 0) { ret 1; }
        i = 0;
        for (i < count) {
            if (!output[i].has_error || output[i].error.kind != io_error.CLOSED) { ret 1; }
            i = i + 1;
        }
        total = total + count;
    }
    if (pending(?runtime) != 0)     { ret 1; }
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec WakeContext {
    runtime:  *Runtime;
    started:  *i64;
    returned: *i64;
}

fun wait_worker(arg: *u8) {
    val context: *WakeContext = arg::*WakeContext;
    atomic.store(context.started, 1);
    var output: [1]Completion;
    val result: res[usize, io_error.Error] = wait(context.runtime, ?output[0], 1, -1);
    if (sel result.ok && result.ok == 0) {
        atomic.store(context.returned, 1);
    }
}

$if ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}

test runtime__wake_cannot_be_lost_before_a_blocked_wait {
    var pa: allocator.Allocator;
    page.make(?pa);
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var started:  i64         = 0;
    var returned: i64         = 0;
    var context:  WakeContext = WakeContext{runtime: ?runtime, started: ?started, returned: ?returned};
    var worker:   thread.Thread;
    thread.spawn_with(wait_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 1; }
    for (atomic.load(?started) == 0) { atomic.spin_hint(); }
    if (!ok_err(wake(?runtime))) { ret 1; }
    thread.join(?worker);
    if (atomic.load(?returned) != 1) { ret 1; }
    close(?runtime);
    destroy(?runtime);
    ret 0;
}

test runtime__wake_is_retained_until_the_next_wait {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    if (!ok_err(wake(?runtime)))         { ret 1; }
    var output: [1]Completion;
    val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
    if (sel waited.err) { ret 1; }
    if (waited.ok != 0) { ret 1; }
    close(?runtime);
    destroy(?runtime);
    ret 0;
}

fun elapsed_ms(start: time.Instant) i64 {
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret -1; }
    ret time.instant_sub(now.ok, start) / 1000000;
}

# a submission wake is the runtime's own and must not end a wait (#676)
test runtime__a_submission_wake_does_not_end_a_wait_early {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    val start: time.InstantClock = time.instant();
    if (sel start.err) { ret 2; }
    var scope: cancel.Scope;
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].some{time.instant_add(start.ok, 60000000000)}))) { ret 3; }
    # a deadline scope makes the submission post a wake on the native queue
    val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, 91));
    if (sel submitted.err) { ret 4; }
    var output: [1]Completion;
    val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 200);
    val took:   i64                        = elapsed_ms(start.ok);
    if (sel waited.err)                                         { ret 5; }
    if (waited.ok != 0)                                         { ret 6; }
    if (took < 200)                                             { ret 7; }
    if (!ok_err(complete(?runtime, submitted.ok, 0, 0, false))) { ret 8; }
    val drained: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (!(sel drained.ok && drained.ok == 1)) { ret 9; }
    if (!succeeded(cancel.destroy(?scope)))   { ret 10; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 11; }
    ret 0;
}

# native wakes posted while count operations are submitted and completed
# between two waits, then drained
fun wakes_between_waits(count: usize, posted: *i64) i32 {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, count))) { ret 1; }
    var output: [64]Completion;
    val before: i64   = runtime.queue.wakes_posted;
    var i:      usize = 0;
    for (i < count) {
        val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, i));
        if (sel submitted.err)                                      { ret 2; }
        if (!ok_err(complete(?runtime, submitted.ok, 1, 0, false))) { ret 3; }
        i = i + 1;
    }
    @posted = runtime.queue.wakes_posted - before;
    var drained: usize = 0;
    for (drained < count) {
        val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 64, 1000);
        if (sel waited.err) { ret 4; }
        if (waited.ok == 0) { ret 5; }
        drained = drained + waited.ok;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 6; }
    ret 0;
}

test runtime__native_wakes_stay_one_per_wait {
    var posted:  i64 = 0;
    val counted: i32 = wakes_between_waits(1000, ?posted);
    if (counted != 0) { ret counted; }
    if (posted != 1)  { ret 10; }
    ret 0;
}

rec RacingCompleter {
    runtime: *Runtime;
    started: *i64;
    count:   usize;
    failed:  i64;
}

fun racing_completer(arg: *u8) {
    val context: *RacingCompleter = arg::*RacingCompleter;
    for (atomic.load(context.started) == 0) { atomic.spin_hint(); }
    var i: usize = 0;
    for (i < context.count) {
        val submitted: res[Token, io_error.Error] = submit(context.runtime, test_operation(READ, i));
        if (sel submitted.err) {
            atomic.store(?context.failed, 1);
            ret;
        }
        if (!ok_err(complete(context.runtime, submitted.ok, 1, 0, false))) {
            atomic.store(?context.failed, 1);
            ret;
        }
        os.sleep(50000);
        i = i + 1;
    }
}

# every completion made while another thread waits reaches it promptly: a
# coalesced wake is never lost between a harvest and the next request
test runtime__coalesced_wakes_lose_no_completion_against_a_racing_waiter {
    var pa: allocator.Allocator;
    page.make(?pa);
    val total:   usize = 5000;
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 64))) { ret 1; }
    var started: i64             = 0;
    var context: RacingCompleter = RacingCompleter{runtime: ?runtime, started: ?started, count: total, failed: 0};
    var worker:  thread.Thread;
    thread.spawn_with(racing_completer, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 2; }
    atomic.store(?started, 1);
    var output:   [16]Completion;
    var received: usize = 0;
    var result:   i32   = 0;
    for (received < total && result == 0) {
        # a lost wake shows as a wait that sits out its timeout and returns nothing
        val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 16, 5000);
        if (sel waited.err) { result = 3; }
        if (sel waited.ok) {
            if (waited.ok == 0) { result = 4; }
            received = received + waited.ok;
        }
        if (result == 0 && atomic.load(?context.failed) != 0) { result = 5; }
    }
    thread.join(?worker);
    if (result != 0)       { ret result; }
    if (received != total) { ret 6; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 7; }
    ret 0;
}

test runtime__a_return_with_completions_answers_a_pending_wake {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 92));
    if (sel submitted.err)                                      { ret 2; }
    if (!ok_err(wake(?runtime)))                                { ret 3; }
    if (!ok_err(complete(?runtime, submitted.ok, 1, 0, false))) { ret 4; }
    var output: [1]Completion;
    val first:  res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
    if (!(sel first.ok && first.ok == 1)) { ret 5; }
    # the wake's native event is still queued, but it was already answered
    val start: time.InstantClock = time.instant();
    if (sel start.err) { ret 6; }
    val second: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 100);
    val took:   i64                        = elapsed_ms(start.ok);
    if (!(sel second.ok && second.ok == 0)) { ret 7; }
    if (took < 100)                         { ret 8; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 9; }
    ret 0;
}

test runtime__a_wait_plan_reports_and_answers_only_a_caller_wake {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    if (!ok_err(notify(?runtime)))       { ret 2; }
    val internal: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 5);
    if (sel internal.err)                       { ret 3; }
    if (!internal.ok.wait || internal.ok.woken) { ret 3; }
    if (!ok_err(wake(?runtime)))                { ret 4; }
    val woken: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 5);
    if (sel woken.err)                    { ret 5; }
    if (woken.ok.wait || !woken.ok.woken) { ret 5; }
    val after: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 5);
    if (sel after.err)                    { ret 6; }
    if (!after.ok.wait || after.ok.woken) { ret 6; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 7; }
    ret 0;
}

test runtime_timer__large_heaps_expire_in_deadline_order {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1024))) { ret 1; }
    val base: time.Instant = time.Instant{sec: 10, nsec: 0};
    var i:    usize        = 0;
    for (i < 1024) {
        val deadline: time.Instant = time.instant_add(base, ((1024 - i) * 1000000)::i64);
        if (!ok_token(submit_timer(?runtime, deadline, i))) { ret 1; }
        i = i + 1;
    }
    mutex.lock(?runtime.lock);
    timers_expire(?runtime, time.instant_add(base, 513000000));
    var output: [1024]Completion;
    val count:  usize = drain(?runtime, ?output[0], 1024);
    mutex.unlock(?runtime.lock);
    if (count != 513) { ret 1; }
    i = 0;
    for (i < 513) {
        if (output[i].context != 1023 - i || output[i].has_error) { ret 1; }
        i = i + 1;
    }
    if (runtime.timer_count != 511 || pending(?runtime) != 511) { ret 1; }
    close(?runtime);
    mutex.lock(?runtime.lock);
    val closed_count: usize = drain(?runtime, ?output[0], 1024);
    mutex.unlock(?runtime.lock);
    if (closed_count != 511)        { ret 1; }
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

# n operations under one deadline scope hold one heap entry, and expiry still
# ends every one still registered
fun scope_deadline_scale(n: usize) i32 {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 64))) { ret 1; }
    val clock: time.InstantClock = time.instant();
    if (sel clock.err) { ret 1; }
    var scope: cancel.Scope;
    val at:    time.Instant = time.instant_add(clock.ok, 3600000000000);
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].some{at}))) { ret 2; }
    var first: Token;
    var i:     usize = 0;
    for (i < n) {
        val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, i));
        if (sel submitted.err)                                      { ret 3; }
        if (i == 0)                                                 { first = submitted.ok; }
        if (runtime.timer_count != 1 || runtime.deadline_live != 1) { ret 4; }
        # completing every other operation releases its share and nothing else
        if (i % 2 == 1 && !ok_err(complete(?runtime, submitted.ok, 0, 0, false))) { ret 5; }
        i = i + 1;
    }
    if (runtime.timer_count != 1 || deadline_at(?runtime, 0).refs != n - n / 2) { ret 6; }
    if (timers_expire(?runtime, time.instant_add(at, -1)) != nil)               { ret 7; }
    if (timers_expire(?runtime, at) != ?scope)                                  { ret 8; }
    cancel.timeout(?scope);
    if (runtime.timer_count != 0 || runtime.deadline_live != 0) { ret 9; }
    var output:   [64]Completion;
    var drained:  usize = 0;
    var timeouts: usize = 0;
    for (drained < n) {
        val taken: res[usize, io_error.Error] = poll(?runtime, ?output[0], 64);
        if (sel taken.err) { ret 10; }
        if (taken.ok == 0) { ret 10; }
        var j: usize = 0;
        for (j < taken.ok) {
            if (output[j].has_error && output[j].error.kind == io_error.TIMEOUT) { timeouts = timeouts + 1; }
            j = j + 1;
        }
        drained = drained + taken.ok;
    }
    if (timeouts != n - n / 2)                                                                         { ret 11; }
    if (!succeeded(cancel.destroy(?scope)) || !ok_bool(close(?runtime)) || !ok_err(destroy(?runtime))) { ret 12; }
    ret 0;
}

test runtime_scope__one_deadline_entry_serves_every_operation {
    ret scope_deadline_scale(1000);
}

# owners sharing one index bucket chain stay findable as records come and go
test runtime_scope__deadline_records_recycle_across_distinct_scopes {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 4))) { ret 1; }
    val clock: time.InstantClock = time.instant();
    if (sel clock.err) { ret 1; }
    var scopes: [8]cancel.Scope;
    var tokens: [8]Token;
    var i:      usize = 0;
    for (i < 8) {
        val at: time.Instant = time.instant_add(clock.ok, (3600 + i % 3)::i64 * 1000000000);
        if (!succeeded(cancel.make_root(?scopes[i], opt[time.Instant].some{at}))) { ret 2; }
        val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scopes[i], test_operation(READ, i));
        if (sel submitted.err) { ret 3; }
        tokens[i] = submitted.ok;
        i         = i + 1;
    }
    if (runtime.timer_count != 8 || runtime.deadline_live != 8) { ret 4; }
    i = 0;
    for (i < 8) {
        if (i % 2 == 0 && !ok_err(complete(?runtime, tokens[i], 0, 0, false))) { ret 5; }
        i = i + 1;
    }
    if (runtime.timer_count != 4 || runtime.deadline_live != 4) { ret 6; }
    i = 1;
    for (i < 8) {
        if (deadline_find(?runtime, ?scopes[i], time.instant_add(clock.ok, (3600 + i % 3)::i64 * 1000000000)) == NO_RECORD) { ret 7; }
        i = i + 2;
    }
    val again: res[Token, io_error.Error] = submit_scoped(?runtime, ?scopes[0], test_operation(READ, 9));
    if (sel again.err)                                          { ret 8; }
    if (runtime.timer_count != 5 || runtime.deadline_live != 5) { ret 9; }
    close(?runtime);
    var output: [16]Completion;
    val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 16, 0);
    if (!ok_usize(waited) || runtime.timer_count != 0 || runtime.deadline_live != 0) { ret 10; }
    if (!ok_err(destroy(?runtime)))                                                  { ret 11; }
    ret 0;
}

test runtime_timer__cancellation_and_expiry_each_publish_once {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 2))) { ret 1; }
    val base:             time.Instant               = time.Instant{sec: 10, nsec: 0};
    val cancelled_result: res[Token, io_error.Error] = submit_timer(?runtime, time.instant_add(base, 1000000), 1);
    if (sel cancelled_result.err) { ret 1; }
    val cancelled: Token = cancelled_result.ok;
    if (!ok_err(cancel_timer(?runtime, cancelled))) { ret 1; }
    if (ok_err(cancel_timer(?runtime, cancelled)))  { ret 1; }
    mutex.lock(?runtime.lock);
    timers_expire(?runtime, time.instant_add(base, 2000000));
    mutex.unlock(?runtime.lock);

    val expired_result: res[Token, io_error.Error] = submit_timer(?runtime, time.instant_add(base, 3000000), 2);
    if (sel expired_result.err) { ret 1; }
    val expired: Token = expired_result.ok;
    mutex.lock(?runtime.lock);
    timers_expire(?runtime, time.instant_add(base, 4000000));
    mutex.unlock(?runtime.lock);
    if (ok_err(cancel_timer(?runtime, expired))) { ret 1; }

    var output: [2]Completion;
    val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 2, 0);
    if (sel result.err)                                                                               { ret 1; }
    if (result.ok != 2)                                                                               { ret 1; }
    if (!output[0].has_error || output[0].error.kind != io_error.CANCELLED || output[0].context != 1) { ret 1; }
    if (output[1].has_error || output[1].context != 2 || pending(?runtime) != 0)                      { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec TimerRaceContext {
    runtime:   *Runtime;
    token:     Token;
    cancelled: *i64;
}

fun timer_cancel_worker(arg: *u8) {
    val context: *TimerRaceContext   = arg::*TimerRaceContext;
    val result:  err[io_error.Error] = cancel_timer(context.runtime, context.token);
    if (sel result.err) {
        atomic.store(context.cancelled, 0);
    }
    or {
        atomic.store(context.cancelled, 1);
    }
}

test runtime_timer__concurrent_cancellation_and_expiry_have_one_winner {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var round: usize = 0;
    for (round < 32) {
        val now: time.InstantClock = time.instant();
        if (sel now.err) { ret 1; }
        val submitted: res[Token, io_error.Error] = submit_timer(?runtime, now.ok, round);
        if (sel submitted.err) { ret 1; }
        var cancelled: i64              = -1;
        var context:   TimerRaceContext = TimerRaceContext{
            runtime:   ?runtime,
            token:     submitted.ok,
            cancelled: ?cancelled,
        };
        var worker: thread.Thread;
        thread.spawn_with(timer_cancel_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        var output: [1]Completion;
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
        thread.join(?worker);
        if (sel result.err)                                                                                       { ret 1; }
        if (result.ok != 1)                                                                                       { ret 1; }
        if (output[0].context != round || pending(?runtime) != 0)                                                 { ret 1; }
        if (atomic.load(?cancelled) == 1 && (!output[0].has_error || output[0].error.kind != io_error.CANCELLED)) { ret 1; }
        if (atomic.load(?cancelled) == 0 && output[0].has_error)                                                  { ret 1; }
        if (ok_err(cancel_timer(?runtime, context.token)))                                                        { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec DestroyWaitContext {
    runtime:   *Runtime;
    closed:    *i64;
    destroyed: *i64;
}

rec NativeControlRaceContext {
    runtime:  *Runtime;
    acquired: *i64;
    release:  *i64;
}

fun close_destroy_worker(arg: *u8) {
    val context: *DestroyWaitContext       = arg::*DestroyWaitContext;
    val closed:  res[bool, io_error.Error] = close(context.runtime);
    if (sel closed.err) {
        atomic.store(context.closed, -1);
        atomic.store(context.destroyed, -1);
        ret;
    }
    atomic.store(context.closed, 1);
    val destroyed: err[io_error.Error] = destroy(context.runtime);
    if (sel destroyed.err) { atomic.store(context.destroyed, -1); }
    or                     { atomic.store(context.destroyed, 1); }
}

fun native_control_worker(arg: *u8) {
    val context:    *NativeControlRaceContext = arg::*NativeControlRaceContext;
    val controlled: err[io_error.Error]       = begin_native_control(context.runtime);
    if (sel controlled.err) {
        atomic.store(context.acquired, -1);
        ret;
    }
    atomic.store(context.acquired, 1);
    for (atomic.load(context.release) == 0) {}
    end_native_control(context.runtime);
}

test runtime__wait_and_destroy_serialize_native_ownership {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    val prepared: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, -1);
    if (sel prepared.err) { ret 2; }
    val plan: WaitPlan = prepared.ok;
    if (!plan.wait
        || !ok_bool(close(?runtime))
        || !ok_err(destroy(?runtime))) {
        ret 3;
    }
    mutex.lock(?runtime.native_lock);
    var stale_controlled: bool                       = false;
    val stale_wait:       res[usize, io_error.Error] = native_poll(?runtime, plan.timeout_ms, ?stale_controlled);
    mutex.unlock(?runtime.native_lock);
    if (!(sel stale_wait.err && stale_wait.err.kind == io_error.CLOSED)) { ret 4; }

    if (!ok_err(make(?runtime, ?pa, 1))) { ret 5; }
    val second_prepared: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, -1);
    if (sel second_prepared.err) { ret 6; }
    val second_plan: WaitPlan           = second_prepared.ok;
    var closed:      i64                = 0;
    var destroyed:   i64                = 0;
    var context:     DestroyWaitContext = DestroyWaitContext{
        runtime:   ?runtime,
        closed:    ?closed,
        destroyed: ?destroyed,
    };
    mutex.lock(?runtime.native_lock);
    var worker: thread.Thread;
    thread.spawn_with(close_destroy_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) {
        mutex.unlock(?runtime.native_lock);
        ret 7;
    }
    for (atomic.load(?closed) == 0) {}
    if (atomic.load(?closed) != 1 || atomic.load(?destroyed) != 0) {
        mutex.unlock(?runtime.native_lock);
        thread.join(?worker);
        ret 8;
    }
    var owned_controlled: bool                       = false;
    val owned_wait:       res[usize, io_error.Error] = native_poll(?runtime, second_plan.timeout_ms, ?owned_controlled);
    mutex.unlock(?runtime.native_lock);
    thread.join(?worker);
    if (sel owned_wait.err || atomic.load(?destroyed) != 1) { ret 9; }

    if (!ok_err(make(?runtime, ?pa, 1))
        || !ok_bool(close(?runtime))) {
        ret 10;
    }
    var acquired:        i64                      = 0;
    var release:         i64                      = 0;
    var control_context: NativeControlRaceContext = NativeControlRaceContext{
        runtime:  ?runtime,
        acquired: ?acquired,
        release:  ?release,
    };
    mutex.lock(?runtime.native_lock);
    thread.spawn_with(native_control_worker, (?control_context)::*u8, ?worker);
    if (worker.tid < 0) {
        mutex.unlock(?runtime.native_lock);
        ret 11;
    }
    var queued: bool = false;
    for (!queued) {
        mutex.lock(?runtime.lock);
        queued = runtime.native_controls == 1;
        mutex.unlock(?runtime.lock);
    }
    val rejected: err[io_error.Error] = destroy_with_native_ownership(?runtime);
    mutex.lock(?runtime.lock);
    val was_destroyed: bool = runtime.destroyed;
    mutex.unlock(?runtime.lock);
    if (!sel rejected.err || was_destroyed) {
        mutex.unlock(?runtime.native_lock);
        atomic.store(?release, 1);
        thread.join(?worker);
        ret 12;
    }
    mutex.unlock(?runtime.native_lock);
    for (atomic.load(?acquired) == 0) {}
    if (atomic.load(?acquired) != 1) {
        atomic.store(?release, 1);
        thread.join(?worker);
        ret 13;
    }
    atomic.store(?release, 1);
    thread.join(?worker);
    if (!ok_err(destroy(?runtime))) { ret 14; }
    ret 0;
}

test runtime_timer__native_wait_uses_monotonic_deadlines {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret 1; }
    val start:     time.Instant               = now.ok;
    val deadline:  time.Instant               = time.instant_add(start, 20000000);
    val submitted: res[Token, io_error.Error] = submit_timer(?runtime, deadline, 91);
    if (sel submitted.err) { ret 1; }
    var output:   [1]Completion;
    var count:    usize = 0;
    var attempts: usize = 0;
    for (count == 0 && attempts < 4) {
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
        if (sel result.err) { ret 1; }
        count    = result.ok;
        attempts = attempts + 1;
    }
    val finished: time.InstantClock = time.instant();
    if (sel finished.err)                                                                                   { ret 1; }
    if (count != 1 || output[0].context != 91 || output[0].has_error)                                       { ret 1; }
    if (time.instant_before(finished.ok, deadline) || time.instant_sub(finished.ok, deadline) > 5000000000) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test runtime_scope__prior_cancellation_rejects_submission {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, ?pa, 1)))                                                                        { ret 1; }
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].none{})) || !transitioned(cancel.cancel(?scope))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, 1));
    if (!sel submitted.err)                                           { ret 1; }
    if (submitted.err.kind != io_error.CANCELLED)                     { ret 1; }
    if (pending(?runtime) != 0 || !succeeded(cancel.destroy(?scope))) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test runtime_scope__parent_cancellation_settles_descendant_work_once {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    var root:    cancel.Scope;
    var child:   cancel.Scope;
    if (!ok_err(make(?runtime, ?pa, 3)))                                                                                                         { ret 1; }
    if (!succeeded(cancel.make_root(?root, opt[time.Instant].none{})) || !succeeded(cancel.make_child(?child, ?root, opt[time.Instant].none{}))) { ret 1; }
    var tokens: [3]Token;
    val first:  res[Token, io_error.Error] = submit_scoped(?runtime, ?root, test_operation(READ, 10));
    val second: res[Token, io_error.Error] = submit_scoped(?runtime, ?child, test_operation(WRITE, 11));
    val now:    time.InstantClock          = time.instant();
    if (sel now.err) { ret 1; }
    val third: res[Token, io_error.Error] = submit_timer_scoped(?runtime, ?child, time.instant_add(now.ok, 1000000000), 12);
    if (sel first.err)  { ret 1; }
    if (sel second.err) { ret 1; }
    if (sel third.err)  { ret 1; }
    tokens[0] = first.ok;
    tokens[1] = second.ok;
    tokens[2] = third.ok;
    if (!transitioned(cancel.cancel(?root)) || transitioned(cancel.cancel(?root))) { ret 1; }
    var output: [3]Completion;
    val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 3, 0);
    if (sel result.err) { ret 1; }
    if (result.ok != 3) { ret 1; }
    var i: usize = 0;
    for (i < 3) {
        if (!output[i].has_error || output[i].error.kind != io_error.CANCELLED) { ret 1; }
        if (ok_err(complete(?runtime, tokens[i], 0, 0, false)))                 { ret 1; }
        i = i + 1;
    }
    if (pending(?runtime) != 0 || !succeeded(cancel.destroy(?child)) || !succeeded(cancel.destroy(?root))) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test runtime_scope__completion_before_cancellation_remains_successful {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, ?pa, 1)))                                { ret 1; }
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, 15));
    if (sel submitted.err) { ret 1; }
    val token: Token = submitted.ok;
    if (!ok_err(complete(?runtime, token, 4, 0, false))) { ret 1; }
    if (!transitioned(cancel.cancel(?scope)))            { ret 1; }
    var output: [1]Completion;
    val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (sel result.err)                                                         { ret 1; }
    if (result.ok != 1)                                                         { ret 1; }
    if (output[0].has_error || output[0].bytes != 4 || output[0].context != 15) { ret 1; }
    if (!succeeded(cancel.destroy(?scope)))                                     { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test runtime_scope__equal_operation_and_scope_deadlines_prefer_timeout {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret 1; }
    val deadline: time.Instant = time.instant_add(now.ok, 20000000);
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].some{deadline}))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit_timer_scoped(?runtime, ?scope, deadline, 21);
    if (sel submitted.err) { ret 1; }
    var output:   [1]Completion;
    var count:    usize = 0;
    var attempts: usize = 0;
    for (count == 0 && attempts < 4) {
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
        if (sel result.err) { ret 1; }
        count    = result.ok;
        attempts = attempts + 1;
    }
    if (count != 1 || output[0].context != 21 || !output[0].has_error || output[0].error.kind != io_error.TIMEOUT) { ret 1; }
    val scope_reason: cancel.Reason = cancel.reason(?scope);
    if (!sel scope_reason.timed_out || !succeeded(cancel.destroy(?scope))) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec CompletionRaceContext {
    runtime:   *Runtime;
    token:     Token;
    completed: *i64;
}

fun completion_race_worker(arg: *u8) {
    val context: *CompletionRaceContext = arg::*CompletionRaceContext;
    val result:  err[io_error.Error]    = complete(context.runtime, context.token, 1, 0, false);
    if (sel result.err) {
        atomic.store(context.completed, 0);
    }
    or {
        atomic.store(context.completed, 1);
    }
}

test runtime_scope__completion_and_cancellation_races_report_one_transfer {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var round: usize = 0;
    for (round < 32) {
        var scope: cancel.Scope;
        if (!succeeded(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
        val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, round));
        if (sel submitted.err) { ret 1; }
        var completed: i64                   = -1;
        var context:   CompletionRaceContext = CompletionRaceContext{
            runtime:   ?runtime,
            token:     submitted.ok,
            completed: ?completed,
        };
        var worker: thread.Thread;
        thread.spawn_with(completion_race_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        cancel.cancel(?scope);
        thread.join(?worker);
        var output: [1]Completion;
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
        if (sel result.err)             { ret 1; }
        if (result.ok != 1)             { ret 1; }
        if (output[0].context != round) { ret 1; }
        # an accepted completion is published itself or rides on the cancellation,
        # and a refused one left the cancellation with nothing to carry (#793)
        if (atomic.load(?completed) == 1 && output[0].bytes != 1)                                                 { ret 1; }
        if (atomic.load(?completed) == 1 && output[0].has_error && output[0].error.kind != io_error.CANCELLED)    { ret 1; }
        if (atomic.load(?completed) == 0 && (!output[0].has_error || output[0].error.kind != io_error.CANCELLED)) { ret 1; }
        if (atomic.load(?completed) == 0 && output[0].bytes != 0)                                                 { ret 1; }
        if (!succeeded(cancel.destroy(?scope)) || pending(?runtime) != 0)                                         { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec SubmissionRaceContext {
    runtime:   *Runtime;
    scope:     *cancel.Scope;
    token:     *Token;
    submitted: *i64;
}

fun submission_race_worker(arg: *u8) {
    val context: *SubmissionRaceContext     = arg::*SubmissionRaceContext;
    val result:  res[Token, io_error.Error] = submit_scoped(context.runtime, context.scope, test_operation(READ, 41));
    if (sel result.ok) {
        @context.token = result.ok;
        atomic.store(context.submitted, 1);
    }
    or {
        atomic.store(context.submitted, 0);
    }
}

test runtime_scope__submission_and_cancellation_races_preserve_ownership {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var round: usize = 0;
    for (round < 32) {
        var scope: cancel.Scope;
        if (!succeeded(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
        var token:     Token;
        var submitted: i64                   = -1;
        var context:   SubmissionRaceContext = SubmissionRaceContext{
            runtime:   ?runtime,
            scope:     ?scope,
            token:     ?token,
            submitted: ?submitted,
        };
        var worker: thread.Thread;
        thread.spawn_with(submission_race_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        cancel.cancel(?scope);
        thread.join(?worker);
        if (atomic.load(?submitted) == 1) {
            var output: [1]Completion;
            val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
            if (sel result.err)                                                                                { ret 1; }
            if (result.ok != 1)                                                                                { ret 1; }
            if (!output[0].has_error || output[0].error.kind != io_error.CANCELLED || output[0].context != 41) { ret 1; }
            if (ok_err(complete(?runtime, token, 0, 0, false)))                                                { ret 1; }
        }
        or (pending(?runtime) != 0) {
            ret 1;
        }
        if (!succeeded(cancel.destroy(?scope)) || pending(?runtime) != 0) { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec ScopeTransitionContext {
    scope: *cancel.Scope;
}

fun timeout_race_worker(arg: *u8) {
    val context: *ScopeTransitionContext = arg::*ScopeTransitionContext;
    cancel.timeout(context.scope);
}

test runtime_scope__deadline_and_cancellation_races_preserve_the_first_reason {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var round: usize = 0;
    for (round < 32) {
        var scope: cancel.Scope;
        if (!succeeded(cancel.make_root(?scope, opt[time.Instant].none{})))       { ret 1; }
        if (!ok_token(submit_scoped(?runtime, ?scope, test_operation(READ, 51)))) { ret 1; }
        var context: ScopeTransitionContext = ScopeTransitionContext{scope: ?scope};
        var worker:  thread.Thread;
        thread.spawn_with(timeout_race_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        cancel.cancel(?scope);
        thread.join(?worker);
        var output: [1]Completion;
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
        if (sel result.err) { ret 1; }
        if (result.ok != 1) { ret 1; }
        val scope_reason: cancel.Reason = cancel.reason(?scope);
        if (!output[0].has_error || output[0].context != 51)                                                    { ret 1; }
        if (sel scope_reason.cancelled && output[0].error.kind != io_error.CANCELLED)                           { ret 1; }
        if (sel scope_reason.timed_out && output[0].error.kind != io_error.TIMEOUT)                             { ret 1; }
        if ((!sel scope_reason.cancelled && !sel scope_reason.timed_out) || !succeeded(cancel.destroy(?scope))) { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test runtime_scope__close_remains_distinct_from_cancellation {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, ?pa, 1)))                                      { ret 1; }
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].none{})))       { ret 1; }
    if (!ok_token(submit_scoped(?runtime, ?scope, test_operation(READ, 31)))) { ret 1; }
    if (succeeded(cancel.destroy(?scope)) || !ok_bool(close(?runtime)))       { ret 1; }
    if (!transitioned(cancel.cancel(?scope)))                                 { ret 1; }
    val scope_reason: cancel.Reason = cancel.reason(?scope);
    if (!sel scope_reason.cancelled)        { ret 1; }
    if (!succeeded(cancel.destroy(?scope))) { ret 1; }
    var output: [1]Completion;
    val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (sel result.err)                                                  { ret 1; }
    if (result.ok != 1)                                                  { ret 1; }
    if (!output[0].has_error || output[0].error.kind != io_error.CLOSED) { ret 1; }
    if (!ok_err(destroy(?runtime)))                                      { ret 1; }
    ret 0;
}

test runtime_scope__failed_submission_wake_rolls_ownership_back {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1)))       { ret 1; }
    if (os.io_queue_close(?runtime.queue) < 0) { ret 1; }
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret 1; }
    val timer_result: res[Token, io_error.Error] = submit_timer(?runtime, time.instant_add(now.ok, 1000000000), 61);
    if (!sel timer_result.err)    { ret 1; }
    if (pending(?runtime) != 0)   { ret 1; }
    if (runtime.timer_count != 0) { ret 1; }

    var scope: cancel.Scope;
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].some{time.instant_add(now.ok, 1000000000)}))) { ret 1; }
    val scoped_result: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, 62));
    if (!sel scoped_result.err)             { ret 1; }
    if (pending(?runtime) != 0)             { ret 1; }
    if (runtime.timer_count != 0)           { ret 1; }
    if (!succeeded(cancel.destroy(?scope))) { ret 1; }

    if (ok_bool(close(?runtime)))   { ret 1; }
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec TestSource {
    released:             usize;
    cancellation_pending: bool;
    cancelled:            Token;
}

fun test_source_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    ret false;
}

fun test_source_cancel(context: ptr, token: Token, reason: io_error.Error) i64 {
    val source: *TestSource = context::*TestSource;
    source.cancelled = token;
    if (source.cancellation_pending) { ret CANCELLATION_PENDING; }
    ret 0;
}

fun test_source_release(context: ptr, completion: *Completion) {
    val source: *TestSource = context::*TestSource;
    source.released = source.released + 1;
}

# a source that claims only contexts carrying its own id, counting every offer
rec RoutedSource {
    id:      u16;
    offers:  *usize;
    claimed: usize;
}

fun routed_source_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    val source: *RoutedSource = context::*RoutedSource;
    if ((events & native_os.IO_EVENT_WAKE) != 0) { ret false; }
    @source.offers = @source.offers + 1;
    if (os_shared.io_context_source(native_context) != source.id) { ret false; }
    source.claimed = source.claimed + 1;
    ret true;
}

# offers made to deliver one event to the last of count sources
fun routed_offers(count: usize, offers: *usize) i32 {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var sources: [100]RoutedSource;
    var tokens:  [100]SourceToken;
    var offered: usize = 0;
    var i:       usize = 0;
    for (i < count) {
        sources[i] = RoutedSource{id: 0, offers: ?offered, claimed: 0};
        val registered: res[SourceToken, io_error.Error] = register_source(?runtime, (?sources[i])::ptr, routed_source_dispatch, test_source_cancel, test_source_release);
        if (sel registered.err) { ret 2; }
        tokens[i]     = registered.ok;
        sources[i].id = source_id(registered.ok);
        i             = i + 1;
    }
    val last: usize = count - 1;
    dispatch_sources(?runtime, NativeEvent{
        context: os_shared.io_source_context(sources[last].id, 1),
        events:  native_os.IO_EVENT_READ,
        status:  0,
        flags:   0,
        source:  sources[last].id,
    });
    if (sources[last].claimed != 1) { ret 3; }
    @offers = offered;
    i       = 0;
    for (i < count) {
        if (!ok_err(unregister_source(?runtime, tokens[i]))) { ret 4; }
        i = i + 1;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 5; }
    ret 0;
}

test runtime__a_native_event_is_offered_only_to_its_source {
    var offers: usize = 0;
    val routed: i32   = routed_offers(100, ?offers);
    if (routed != 0) { ret routed; }
    if (offers != 1) { ret 10; }
    ret 0;
}

test runtime__an_event_for_a_released_source_is_counted_never_offered {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var offered: usize                            = 0;
    var gone:    RoutedSource                     = RoutedSource{id: 0, offers: ?offered, claimed: 0};
    val first:   res[SourceToken, io_error.Error] = register_source(?runtime, (?gone)::ptr, routed_source_dispatch, test_source_cancel, test_source_release);
    if (sel first.err) { ret 2; }
    gone.id = source_id(first.ok);
    # released while a collection holds a harvested batch, so its id is held
    collection_begin(?runtime);
    if (!ok_err(unregister_source(?runtime, first.ok))) { ret 3; }
    # the released index is reused under a new id
    var live:   RoutedSource                     = RoutedSource{id: 0, offers: ?offered, claimed: 0};
    val second: res[SourceToken, io_error.Error] = register_source(?runtime, (?live)::ptr, routed_source_dispatch, test_source_cancel, test_source_release);
    if (sel second.err)                    { ret 4; }
    if (second.ok.index != first.ok.index) { ret 4; }
    live.id = source_id(second.ok);
    if (unrouted_events(?runtime) != 0) { ret 5; }
    dispatch_sources(?runtime, NativeEvent{context: os_shared.io_source_context(gone.id, 1), events: native_os.IO_EVENT_READ, status: 0, flags: 0, source: gone.id});
    dispatch_sources(?runtime, NativeEvent{context: 1, events: native_os.IO_EVENT_READ, status: 0, flags: 0, source: 0});
    dispatch_sources(?runtime, NativeEvent{context: 1, events: native_os.IO_EVENT_READ, status: 0, flags: 0, source: 0xffff});
    if (unrouted_events(?runtime) != 3 || offered != 0) { ret 6; }
    collection_end(?runtime);
    if (live.id == gone.id) { ret 10; }
    dispatch_sources(?runtime, NativeEvent{context: os_shared.io_source_context(live.id, 1), events: native_os.IO_EVENT_READ, status: 0, flags: 0, source: live.id});
    if (unrouted_events(?runtime) != 3 || offered != 1 || live.claimed != 1) { ret 7; }
    if (!ok_err(unregister_source(?runtime, second.ok)))                     { ret 8; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 9; }
    ret 0;
}

test runtime__a_native_event_is_laid_out_as_the_platform_completion {
    if ($size_of(NativeEvent) != $size_of(native_os.IoCompletion) ||
        $offset_of(NativeEvent, context) != $offset_of(native_os.IoCompletion, context) ||
        $offset_of(NativeEvent, events) != $offset_of(native_os.IoCompletion, events) ||
        $offset_of(NativeEvent, status) != $offset_of(native_os.IoCompletion, status) ||
        $offset_of(NativeEvent, flags) != $offset_of(native_os.IoCompletion, flags) ||
        $offset_of(NativeEvent, source) != $offset_of(native_os.IoCompletion, source)) { ret 1; }
    ret 0;
}

# a batch harvested while a source was live is dispatched after the source is
# released and another registered, as a collection racing a release does
fun racing_cycle(runtime: *Runtime, old: *RoutedSource, fresh: *RoutedSource) i32 {
    val first: res[SourceToken, io_error.Error] = register_source(runtime, old::ptr, routed_source_dispatch, test_source_cancel, test_source_release);
    if (sel first.err) { ret 1; }
    old.id = source_id(first.ok);
    collection_begin(runtime);
    if (!ok_err(unregister_source(runtime, first.ok))) { ret 2; }
    val second: res[SourceToken, io_error.Error] = register_source(runtime, fresh::ptr, routed_source_dispatch, test_source_cancel, test_source_release);
    if (sel second.err) { ret 3; }
    fresh.id = source_id(second.ok);
    if (fresh.id == old.id) { ret 4; }
    dispatch_sources(runtime, NativeEvent{context: os_shared.io_source_context(old.id, 1), events: native_os.IO_EVENT_READ, status: 0, flags: 0, source: old.id});
    collection_end(runtime);
    if (!ok_err(unregister_source(runtime, second.ok))) { ret 5; }
    ret 0;
}

test runtime__reused_source_ids_never_reach_a_stale_source {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var offered: usize        = 0;
    var old:     RoutedSource = RoutedSource{id: 0, offers: ?offered, claimed: 0};
    var fresh:   RoutedSource = RoutedSource{id: 0, offers: ?offered, claimed: 0};
    var highest: u16          = 0;
    var cycle:   usize        = 0;
    for (cycle < 70000) {
        val raced: i32 = racing_cycle(?runtime, ?old, ?fresh);
        if (raced != 0)         { ret 10 + raced; }
        if (old.id > highest)   { highest = old.id; }
        if (fresh.id > highest) { highest = fresh.id; }
        cycle = cycle + 1;
    }
    # 140,000 registrations reuse a handful of ids, and no stale event landed
    if (offered != 0 || fresh.claimed != 0) { ret 2; }
    if (highest > 4)                        { ret 3; }
    if (unrouted_events(?runtime) != 70000) { ret 4; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 5; }
    ret 0;
}

# a source keeps its id while it owns an operation, so the runtime never reuses
# an id a pending native completion could still carry (#740)
test runtime__a_source_with_a_live_operation_cannot_be_released {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var context:    TestSource                       = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val registered: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel registered.err) { ret 2; }
    val source:    SourceToken                = registered.ok;
    val submitted: res[Token, io_error.Error] = submit_owned(?runtime, source, test_operation(READ, 93));
    if (sel submitted.err) { ret 3; }
    val retired: res[bool, io_error.Error] = retire_source(?runtime, source);
    if (sel retired.ok)                                         { ret 4; }
    if (retired.err.kind != io_error.BUSY)                      { ret 4; }
    if (ok_err(release_source(?runtime, source)))               { ret 5; }
    if (!ok_err(complete(?runtime, submitted.ok, 1, 0, false))) { ret 6; }
    var output: Completion;
    if (!ok_usize(poll(?runtime, ?output, 1)))        { ret 7; }
    if (!ok_err(unregister_source(?runtime, source))) { ret 8; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 9; }
    ret 0;
}

test runtime__retired_source_slots_reject_stale_tokens_and_remain_reusable {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var context:      TestSource                       = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val first_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel first_result.err) { ret 2; }
    val first: SourceToken = first_result.ok;
    if (!ok_bool(retire_source(?runtime, first))) { ret 3; }
    # a retired source holds its own index until it is released
    val held_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel held_result.err)                                  { ret 4; }
    if (held_result.ok.index == first.index)                  { ret 4; }
    if (!ok_err(unregister_source(?runtime, held_result.ok))) { ret 4; }
    if (!ok_err(release_source(?runtime, first)))             { ret 5; }
    val second_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel second_result.err) { ret 6; }
    val second: SourceToken = second_result.ok;
    if (first.index != second.index || first.generation == second.generation || source_id(first) == source_id(second)) { ret 7; }
    if (ok_token(submit_owned(?runtime, first, test_operation(READ, 90))))                                             { ret 8; }
    val submitted: res[Token, io_error.Error] = submit_owned(?runtime, second, test_operation(READ, 91));
    if (sel submitted.err) { ret 9; }
    val token: Token = submitted.ok;
    if (!ok_err(complete(?runtime, token, 1, 0, false))) { ret 10; }
    var output: Completion;
    val polled: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel polled.err)                               { ret 11; }
    if (polled.ok != 1)                               { ret 11; }
    if (context.released != 1)                        { ret 11; }
    if (!ok_err(unregister_source(?runtime, second))) { ret 12; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 13; }
    ret 0;
}

test runtime__source_and_operation_ownership_share_one_close_lifecycle {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 2))) { ret 1; }
    var context:       TestSource                       = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val source_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel source_result.err) { ret 2; }
    val source:           SourceToken                = source_result.ok;
    val operation_result: res[Token, io_error.Error] = submit_owned(?runtime, source, test_operation(ACCEPT, 92));
    if (sel operation_result.err) { ret 3; }
    val closing_result: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
    if (sel closing_result.err) { ret 4; }
    val closing: lifecycle.CloseResult = closing_result.ok;
    if (!closing.started
        || closing.complete
        || closing.snapshot.mode != lifecycle.GRACEFUL
        || closing.snapshot.cause != lifecycle.PROCESS_TERMINATION
        || closing.snapshot.outstanding != 2) {
        ret 5;
    }
    var output:          Completion;
    val polled:          res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    val after_operation: lifecycle.Snapshot         = snapshot(?runtime);
    if (sel polled.err)                               { ret 6; }
    if (polled.ok != 1)                               { ret 6; }
    if (!output.has_error)                            { ret 6; }
    if (output.error.kind != io_error.CLOSED)         { ret 6; }
    if (context.released != 1)                        { ret 6; }
    if (after_operation.state != lifecycle.CLOSING)   { ret 6; }
    if (after_operation.outstanding != 1)             { ret 6; }
    if (!ok_err(unregister_source(?runtime, source))) { ret 7; }
    val closed: lifecycle.Snapshot = snapshot(?runtime);
    if (closed.state != lifecycle.CLOSED || closed.outstanding != 0) { ret 8; }
    val duplicate_result: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    if (sel duplicate_result.err) { ret 9; }
    val duplicate: lifecycle.CloseResult = duplicate_result.ok;
    if (duplicate.started || duplicate.escalated || !duplicate.complete
        || duplicate.snapshot.mode != lifecycle.GRACEFUL
        || duplicate.snapshot.terminal_cause != lifecycle.PROCESS_TERMINATION) {
        ret 10;
    }
    if (!ok_err(destroy(?runtime))) { ret 11; }
    ret 0;
}

test runtime__asynchronous_source_cancellation_publishes_after_quiescence {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 2))) { ret 1; }
    var context:       TestSource                       = TestSource{released: 0, cancellation_pending: true, cancelled: Token{index: 0, generation: 0}};
    val source_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel source_result.err) { ret 2; }
    val source: SourceToken = source_result.ok;
    var scope:  cancel.Scope;
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 3; }
    val submitted: res[Token, io_error.Error] = submit_scoped_owned(?runtime, source, ?scope, test_operation(FILE_READ, 93));
    if (sel submitted.err) { ret 4; }
    val token: Token = submitted.ok;
    if (!transitioned(cancel.cancel(?scope))
        || context.cancelled.index != token.index
        || context.cancelled.generation != token.generation) {
        ret 5;
    }
    var output: Completion;
    val early:  res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel early.err) { ret 6; }
    if (early.ok != 0) { ret 6; }
    val draining: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
    val deadline: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    if (sel draining.err)                                { ret 7; }
    if (sel deadline.err)                                { ret 7; }
    if (!ok_err(complete_cancellation(?runtime, token))) { ret 7; }
    val settled: res[usize, io_error.Error] = wait(?runtime, ?output, 1, 1000);
    if (sel settled.err)                         { ret 8; }
    if (settled.ok != 1)                         { ret 8; }
    if (!output.has_error)                       { ret 8; }
    if (output.error.kind != io_error.CANCELLED) { ret 8; }
    if (context.released != 1)                   { ret 8; }
    if (!succeeded(cancel.destroy(?scope))
        || !ok_err(unregister_source(?runtime, source))
        || !ok_bool(close(?runtime))
        || !ok_err(destroy(?runtime))) {
        ret 9;
    }
    ret 0;
}

test runtime__first_abortive_escalation_updates_unresolved_source_work {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 2))) { ret 1; }
    var context:       TestSource                       = TestSource{released: 0, cancellation_pending: true, cancelled: Token{index: 0, generation: 0}};
    val source_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel source_result.err) { ret 2; }
    val source:    SourceToken                = source_result.ok;
    val submitted: res[Token, io_error.Error] = submit_owned(?runtime, source, test_operation(RESOLVE, 94));
    if (sel submitted.err) { ret 3; }
    val token:     Token                                      = submitted.ok;
    val graceful:  res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
    val deadline:  res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    val cancelled: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.CANCELLATION);
    if (sel graceful.err)       { ret 4; }
    if (sel deadline.err)       { ret 4; }
    if (sel cancelled.err)      { ret 4; }
    if (!deadline.ok.escalated) { ret 4; }
    if (cancelled.ok.escalated) { ret 4; }
    var output: Completion;
    val early:  res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel early.err)                                   { ret 5; }
    if (early.ok != 0)                                   { ret 5; }
    if (!ok_err(complete_cancellation(?runtime, token))) { ret 6; }
    val settled: res[usize, io_error.Error] = wait(?runtime, ?output, 1, 1000);
    if (sel settled.err)                       { ret 7; }
    if (settled.ok != 1)                       { ret 7; }
    if (!output.has_error)                     { ret 7; }
    if (output.error.kind != io_error.TIMEOUT) { ret 7; }
    val state: lifecycle.Snapshot = snapshot(?runtime);
    if (state.terminal_cause != lifecycle.DEADLINE
        || !ok_err(unregister_source(?runtime, source))
        || !ok_err(destroy(?runtime))) {
        ret 8;
    }
    ret 0;
}

val RACE_COMPLETE: u8 = 0;
val RACE_BATCH:    u8 = 1;
val RACE_COPY:     u8 = 2;
val RACE_OPENED:   u8 = 3;
val RACE_FAIL:     u8 = 4;

# a source whose cancel hook resolves the operation the way a poll thread does
# when its native request finishes while the cancellation is underway (#793)
rec RacingSource {
    runtime:  *Runtime;
    mode:     u8;
    bytes:    usize;
    items:    usize;
    eof:      bool;
    data:     *u8;
    called:   bool;
    accepted: bool;
}

fun racing_cancel(context: ptr, token: Token, reason: io_error.Error) i64 {
    val source: *RacingSource = context::*RacingSource;
    var result: err[io_error.Error];
    if (source.mode == RACE_COMPLETE) {
        result = complete(source.runtime, token, source.bytes, 0, source.eof);
    }
    or (source.mode == RACE_BATCH) {
        result = complete_batch(source.runtime, token, source.bytes, source.items, 0);
    }
    or (source.mode == RACE_COPY) {
        result = complete_copy(source.runtime, token, source.data, source.bytes, 0, source.eof);
    }
    or (source.mode == RACE_OPENED) {
        result = complete_opened(source.runtime, token, 77, 5);
    }
    or {
        result = fail(source.runtime, token, io_error.make(io_error.IO, io_error.OP_READ));
    }
    source.called   = true;
    source.accepted = sel result.ok;
    ret 0;
}

fun racing_release(context: ptr, completion: *Completion) {}

# submit one operation on a racing source, cancel or time out its scope, and
# return the terminal completion
fun raced_cancellation(source: *RacingSource, operation: Operation, timed_out: bool, output: *Completion) i32 {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 2))) { ret 1; }
    source.runtime = ?runtime;
    val registered: res[SourceToken, io_error.Error] = register_source(?runtime, source::ptr, test_source_dispatch, racing_cancel, racing_release);
    if (sel registered.err) { ret 2; }
    var scope: cancel.Scope;
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 3; }
    val submitted: res[Token, io_error.Error] = submit_scoped_owned(?runtime, registered.ok, ?scope, operation);
    if (sel submitted.err) { ret 4; }
    var fired: bool = false;
    if (timed_out)                { fired = transitioned(cancel.timeout(?scope)); }
    or                            { fired = transitioned(cancel.cancel(?scope)); }
    if (!fired || !source.called) { ret 5; }
    val waited: res[usize, io_error.Error] = wait(?runtime, output, 1, 1000);
    if (sel waited.err) { ret 6; }
    if (waited.ok != 1) { ret 6; }
    if (!succeeded(cancel.destroy(?scope))
        || !ok_err(unregister_source(?runtime, registered.ok))
        || !ok_bool(close(?runtime))
        || !ok_err(destroy(?runtime))) {
        ret 7;
    }
    ret 0;
}

fun racing_source(mode: u8, bytes: usize, items: usize, eof: bool, data: *u8) RacingSource {
    ret RacingSource{runtime: nil, mode: mode, bytes: bytes, items: items, eof: eof, data: data, called: false, accepted: false};
}

# every way a source can resolve an operation while its cancellation is
# underway: what finished rides on the cancellation, an accepted socket is
# handed over (#927), and a connect's socket or a failure is refused
test runtime__a_resolution_racing_a_cancellation {
    var output: Completion;

    var done:  RacingSource = racing_source(RACE_COMPLETE, 5, 0, false, nil);
    val raced: i32          = raced_cancellation(?done, test_operation(READ, 96), false, ?output);
    if (raced != 0)                                                     { ret raced; }
    if (!done.accepted)                                                 { ret 10; }
    if (!output.has_error || output.error.kind != io_error.CANCELLED)   { ret 11; }
    if (output.bytes != 5 || output.items != 0 || output.end_of_stream) { ret 12; }

    var eof:       RacingSource = racing_source(RACE_COMPLETE, 0, 0, true, nil);
    val timed_out: i32          = raced_cancellation(?eof, test_operation(READ, 97), true, ?output);
    if (timed_out != 0)                                             { ret 20 + timed_out; }
    if (!eof.accepted)                                              { ret 30; }
    if (!output.has_error || output.error.kind != io_error.TIMEOUT) { ret 31; }
    if (output.bytes != 0 || !output.end_of_stream)                 { ret 32; }

    var batch:   RacingSource = racing_source(RACE_BATCH, 9, 2, false, nil);
    val batched: i32          = raced_cancellation(?batch, test_operation(RECEIVE_FROM, 98), false, ?output);
    if (batched != 0)                                                                    { ret 40 + batched; }
    if (!batch.accepted || !output.has_error || output.error.kind != io_error.CANCELLED) { ret 50; }
    if (output.bytes != 9 || output.items != 2)                                          { ret 51; }

    var data:      [3]u8        = [3]u8{'x', 'y', 'z'};
    var buffer:    [8]u8;
    var copy:      RacingSource = racing_source(RACE_COPY, 3, 0, false, ?data[0]);
    val operation: Operation    = Operation{kind: FILE_READ, resource: 0, buffer: ?buffer[0], length: 8, offset: 0, context: 99};
    val copied:    i32          = raced_cancellation(?copy, operation, false, ?output);
    if (copied != 0)                                                                    { ret 60 + copied; }
    if (!copy.accepted || !output.has_error || output.error.kind != io_error.CANCELLED) { ret 70; }
    if (output.bytes != 3)                                                              { ret 71; }
    if (buffer[0] != 'x' || buffer[1] != 'y' || buffer[2] != 'z')                       { ret 72; }

    var accept:   RacingSource = racing_source(RACE_OPENED, 0, 0, false, nil);
    val accepted: i32          = raced_cancellation(?accept, test_operation(ACCEPT, 100), false, ?output);
    if (accepted != 0)                                                                    { ret 80 + accepted; }
    if (!accept.accepted || !output.has_error || output.error.kind != io_error.CANCELLED) { ret 90; }
    if (output.bytes != 0 || output.resource != 77 || output.opening != 5)                { ret 91; }

    var connect:   RacingSource = racing_source(RACE_OPENED, 0, 0, false, nil);
    val connected: i32          = raced_cancellation(?connect, test_operation(CONNECT, 100), false, ?output);
    if (connected != 0)                                                                   { ret 100 + connected; }
    if (connect.accepted || !output.has_error || output.error.kind != io_error.CANCELLED) { ret 110; }
    if (output.bytes != 0 || output.resource != 0 || output.opening != 0)                 { ret 111; }

    var failure: RacingSource = racing_source(RACE_FAIL, 0, 0, false, nil);
    val failed:  i32          = raced_cancellation(?failure, test_operation(READ, 101), false, ?output);
    if (failed != 0)                                                                       { ret 120 + failed; }
    if (failure.accepted)                                                                  { ret 130; }
    if (!output.has_error || output.error.kind != io_error.CANCELLED || output.bytes != 0) { ret 131; }
    ret 0;
}

# a page allocator that counts the bytes it has handed out and not taken back
rec Counting {
    inner:       allocator.Allocator;
    live:        usize;
    allocations: usize;
}

# a poll's completion count, 0 for a refused poll
fun polled_count(r: res[usize, io_error.Error]) usize {
    if (sel r.ok) { ret r.ok; }
    ret 0;
}

fun counting_allocate(context: ptr, size: usize, align: usize) opt[ptr] {
    val counting: *Counting = context::*Counting;
    val got:      opt[ptr]  = counting.inner.fn_allocate(counting.inner.ctx, size, align);
    if (sel got.some) {
        counting.live        = counting.live + size;
        counting.allocations = counting.allocations + 1;
    }
    ret got;
}

fun counting_reallocate(context: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val counting: *Counting = context::*Counting;
    val got:      opt[ptr]  = counting.inner.fn_reallocate(counting.inner.ctx, p, old_size, new_size, align);
    if (sel got.some) {
        counting.live        = counting.live - old_size + new_size;
        counting.allocations = counting.allocations + 1;
    }
    ret got;
}

fun counting_deallocate(context: ptr, p: ptr, size: usize, align: usize) i64 {
    val counting: *Counting = context::*Counting;
    val code:     i64       = counting.inner.fn_deallocate(counting.inner.ctx, p, size, align);
    if (code == 0) { counting.live = counting.live - size; }
    ret code;
}

fun counting_make(counting: *Counting, a: *allocator.Allocator) {
    page.make(?counting.inner);
    counting_wrap(counting, a);
}

# the count over whatever counting.inner already is, reclaiming as it does
fun counting_wrap(counting: *Counting, a: *allocator.Allocator) {
    counting.live        = 0;
    counting.allocations = 0;
    a.ctx                = counting::ptr;
    a.fn_allocate        = counting_allocate;
    a.fn_reallocate      = counting_reallocate;
    a.fn_deallocate      = counting_deallocate;
    a.retains            = counting.inner.retains;
}

val PEAK_OPERATIONS: usize = 3000;
val PEAK_SOURCES:    usize = 300;

val FIXED_PEAK_OPERATIONS: usize = 10000;
val FIXED_PEAK_SOURCES:    usize = 1000;

# the scopes and handles one peak holds, on the mapper since they outgrow a
# stack, sized for the largest peak a test drives
rec Peak {
    scopes:  [3334]cancel.Scope;
    tokens:  [10000]Token;
    sources: [1000]SourceToken;
}

# drive a runtime to a peak of operations, timers, scoped deadlines and
# sources, then settle every one. first_growth is the bytes the first growth
# of the slot table added, peak the bytes held at the peak
fun run_peak(runtime: *Runtime, counting: *Counting, peak: *Peak, host: *TestSource, operations: usize, sources: usize, first_growth: *usize, held: *usize) i32 {
    val clock: time.InstantClock = time.instant();
    if (sel clock.err) { ret 1; }
    val start:   usize = counting.live;
    val initial: usize = capacity(runtime);
    var i:       usize = 0;
    for (i < operations) {
        var submitted: res[Token, io_error.Error];
        if (i % 3 == 0) { submitted = submit(runtime, test_operation(READ, i)); }
        or (i % 3 == 1) { submitted = submit_timer(runtime, time.instant_add(clock.ok, 3600000000000), i); }
        or {
            val scope: *cancel.Scope = ?peak.scopes[i / 3];
            val at:    time.Instant  = time.instant_add(clock.ok, (3600 + i)::i64 * 1000000000);
            if (!succeeded(cancel.make_root(scope, opt[time.Instant].some{at}))) { ret 2; }
            submitted = submit_scoped(runtime, scope, test_operation(READ, i));
        }
        if (sel submitted.err) { ret 3; }
        peak.tokens[i] = submitted.ok;
        if (@first_growth == 0 && capacity(runtime) != initial) { @first_growth = counting.live - start; }
        i = i + 1;
    }
    i = 0;
    for (i < sources) {
        val registered: res[SourceToken, io_error.Error] = register_source(runtime, host::ptr, test_source_dispatch, test_source_cancel, test_source_release);
        if (sel registered.err) { ret 4; }
        peak.sources[i] = registered.ok;
        i               = i + 1;
    }
    @held = counting.live;
    i     = 0;
    for (i < operations) {
        if (i % 3 == 1) {
            if (!ok_err(cancel_timer(runtime, peak.tokens[i]))) { ret 5; }
        }
        or {
            if (!ok_err(complete(runtime, peak.tokens[i], i, 0, false))) { ret 5; }
        }
        i = i + 1;
    }
    var output:  [64]Completion;
    var drained: usize = 0;
    for (drained < operations) {
        val polled: res[usize, io_error.Error] = poll(runtime, ?output[0], 64);
        if (polled_count(polled) == 0) { ret 6; }
        drained = drained + polled_count(polled);
    }
    i = 0;
    for (i < sources) {
        if (!ok_err(unregister_source(runtime, peak.sources[i]))) { ret 7; }
        i = i + 1;
    }
    i = 0;
    for (i < operations / 3) {
        if (!succeeded(cancel.destroy(?peak.scopes[i]))) { ret 8; }
        i = i + 1;
    }
    ret 0;
}

# #868: the slot, timer, deadline and source tables give a peak's capacity back
test runtime__a_drained_peak_returns_the_tables_to_idle {
    val peak: *Peak = os.allocate($size_of(Peak))::*Peak;
    if (peak == nil) { ret 1; }
    fin { os.deallocate(peak::ptr, $size_of(Peak)); }
    var counting: Counting;
    var a:        allocator.Allocator;
    counting_make(?counting, ?a);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?a, 4))) { ret 2; }
    var host: TestSource = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val idle: usize      = counting.live;
    # two peaks, so a runtime that shrank grows and shrinks again
    var round: usize = 0;
    for (round < 2) {
        var first_growth: usize = 0;
        var held:         usize = 0;
        val ran:          i32   = run_peak(?runtime, ?counting, peak, ?host, PEAK_OPERATIONS, PEAK_SOURCES, ?first_growth, ?held);
        if (ran != 0)                         { ret 10 + ran; }
        if (first_growth == 0)                { ret 20; }
        if (held < idle + 100 * first_growth) { ret 21; }
        if (runtime.live != 0 || runtime.timer_count != 0 ||
            runtime.deadline_live != 0 || runtime.source_count != 0) { ret 22; }
        if (counting.live > idle + first_growth) { ret 23; }
        if (capacity(?runtime) > 8)              { ret 24; }
        round = round + 1;
    }
    if (!ok_bool(close(?runtime)) || !ok_err(destroy(?runtime))) { ret 3; }
    if (counting.live != 0)                                      { ret 4; }
    ret 0;
}

# #928: an operation left pending at a peak says it keeps the peak's chunks,
# and once it is resubmitted it takes the lowest free slot, says nothing, and
# the runtime shrinks to its slack
test runtime__an_operation_left_at_a_peak_pins_capacity_until_it_is_resubmitted {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 4))) { ret 1; }
    var ramp: [512]Token;
    var i:    usize = 0;
    for (i < 512) {
        val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, i));
        if (sel submitted.err) { ret 2; }
        ramp[i] = submitted.ok;
        i       = i + 1;
    }
    # at the peak nothing pins, since the live count needs every chunk
    if (pins_capacity(?runtime, ramp[511]) || pins_capacity(?runtime, ramp[0])) { ret 3; }
    val low:  Token = ramp[0];
    val high: Token = ramp[511];
    i = 1;
    for (i < 511) {
        if (!ok_err(complete(?runtime, ramp[i], 0, 0, false))) { ret 4; }
        i = i + 1;
    }
    var output: [64]Completion;
    var total:  usize = 0;
    for (total < 510) {
        val polled: res[usize, io_error.Error] = poll(?runtime, ?output[0], 64);
        if (polled_count(polled) == 0) { ret 5; }
        total = total + polled_count(polled);
    }
    val peak_slots: usize = capacity(?runtime);
    if (peak_slots <= high.index::usize) { ret 6; }
    if (!pins_capacity(?runtime, high))  { ret 7; }
    if (pins_capacity(?runtime, low))    { ret 8; }
    # resubmitted, the operation lands low and the peak's chunks go back
    if (!ok_err(complete(?runtime, high, 0, 0, false)))    { ret 9; }
    if (polled_count(poll(?runtime, ?output[0], 64)) != 1) { ret 9; }
    if (pins_capacity(?runtime, high))                     { ret 10; }
    val again: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, 600));
    if (sel again.err)                                                                                       { ret 11; }
    if (pins_capacity(?runtime, again.ok))                                                                   { ret 12; }
    if (capacity(?runtime) > 8)                                                                              { ret 13; }
    if (!ok_err(complete(?runtime, low, 0, 0, false)) || !ok_err(complete(?runtime, again.ok, 0, 0, false))) { ret 14; }
    if (polled_count(poll(?runtime, ?output[0], 64)) != 2)                                                   { ret 14; }
    if (!ok_bool(close(?runtime)) || !ok_err(destroy(?runtime)))                                             { ret 15; }
    ret 0;
}

# over an allocator that never reclaims the tables keep their peak whatever is
# live, so no operation pins anything
test runtime__nothing_pins_capacity_over_an_allocator_that_never_reclaims {
    val bytes:  usize = 1 << 20;
    val region: ptr   = os.allocate(bytes);
    if (region == nil) { ret 1; }
    fin { os.deallocate(region, bytes); }
    var state: fixed.FixedState;
    var a:     allocator.Allocator;
    val made:  err[allocator.Error] = fixed.make(?a, ?state, region::*u8, bytes);
    if (sel made.err || allocator.reclaims(?a)) { ret 2; }
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?a, 4))) { ret 3; }
    var ramp: [512]Token;
    var i:    usize = 0;
    for (i < 512) {
        val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, i));
        if (sel submitted.err) { ret 4; }
        ramp[i] = submitted.ok;
        i       = i + 1;
    }
    i = 0;
    for (i < 511) {
        if (!ok_err(complete(?runtime, ramp[i], 0, 0, false))) { ret 5; }
        i = i + 1;
    }
    var output: [64]Completion;
    var total:  usize = 0;
    for (total < 511) {
        val polled: res[usize, io_error.Error] = poll(?runtime, ?output[0], 64);
        if (polled_count(polled) == 0) { ret 6; }
        total = total + polled_count(polled);
    }
    if (pins_capacity(?runtime, ramp[511])) { ret 7; }
    # a stale token pins nothing either
    if (pins_capacity(?runtime, ramp[300]))                      { ret 8; }
    if (!ok_err(complete(?runtime, ramp[511], 0, 0, false)))     { ret 9; }
    if (polled_count(poll(?runtime, ?output[0], 64)) != 1)       { ret 9; }
    if (!ok_bool(close(?runtime)) || !ok_err(destroy(?runtime))) { ret 10; }
    ret 0;
}

# rounds peaks of 10k operations and 1k sources on one runtime over a bump
# arena of the given bytes. used is what the arena gave out by the first peak
fun fixed_peaks(bytes: usize, rounds: usize, used: *usize) i32 {
    val peak: *Peak = os.allocate($size_of(Peak))::*Peak;
    if (peak == nil) { ret 1; }
    fin { os.deallocate(peak::ptr, $size_of(Peak)); }
    val region: ptr = os.allocate(bytes);
    if (region == nil) { ret 1; }
    fin { os.deallocate(region, bytes); }
    var state:    fixed.FixedState;
    var counting: Counting;
    var a:        allocator.Allocator;
    val made:     err[allocator.Error] = fixed.make(?counting.inner, ?state, region::*u8, bytes);
    if (sel made.err) { ret 2; }
    counting_wrap(?counting, ?a);
    if (allocator.reclaims(?a)) { ret 2; }
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?a, 4))) { ret 3; }
    var host:      TestSource = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    var remaining: usize      = 0;
    var round:     usize      = 0;
    for (round < rounds) {
        var first_growth: usize = 0;
        var held:         usize = 0;
        val ran:          i32   = run_peak(?runtime, ?counting, peak, ?host, FIXED_PEAK_OPERATIONS, FIXED_PEAK_SOURCES, ?first_growth, ?held);
        if (ran != 0) { ret 10 + ran; }
        if (runtime.live != 0 || runtime.timer_count != 0 ||
            runtime.deadline_live != 0 || runtime.source_count != 0) { ret 4; }
        if (round == 0)                           { remaining = fixed.remaining(?state); }
        or (fixed.remaining(?state) != remaining) { ret 5; }
        round = round + 1;
    }
    @used = bytes - remaining;
    if (!ok_bool(close(?runtime)) || !ok_err(destroy(?runtime))) { ret 6; }
    ret 0;
}

# #880: a bump arena never reuses what the runtime gives back, so its tables
# keep their peak over one, and a peak of 10k that drains and returns fits an
# arena sized for a single peak
test runtime__a_repeated_peak_over_a_fixed_arena_never_grows_it {
    var used:  usize = 0;
    val probe: i32   = fixed_peaks(64 << 20, 1, ?used);
    if (probe != 0) { ret 20 + probe; }
    var again: usize = 0;
    val ran:   i32   = fixed_peaks(used + used / 2, 2, ?again);
    if (ran != 0)      { ret 40 + ran; }
    if (again != used) { ret 60; }
    ret 0;
}

# #868: shrinking releases only empty chunks, so nothing live moves or goes
# stale, a handle pinned high holds its chunk, and a token from a released
# chunk stays refused once the chunk is grown again
test runtime__live_handles_survive_a_shrink_and_stale_ones_stay_refused {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 4))) { ret 1; }
    var host:  TestSource        = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val clock: time.InstantClock = time.instant();
    if (sel clock.err) { ret 1; }
    var scope: cancel.Scope;
    if (!succeeded(cancel.make_root(?scope, opt[time.Instant].some{time.instant_add(clock.ok, 3600000000000)}))) { ret 1; }

    val held: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 7));
    if (sel held.err) { ret 2; }
    val source: res[SourceToken, io_error.Error] = register_source(?runtime, (?host)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel source.err) { ret 2; }
    val scoped: res[Token, io_error.Error] = submit_scoped_owned(?runtime, source.ok, ?scope, test_operation(READ, 8));
    if (sel scoped.err) { ret 2; }
    val held_slot:   *Slot   = slot_at(?runtime, held.ok.index::usize);
    val scoped_slot: *Slot   = slot_at(?runtime, scoped.ok.index::usize);
    val held_source: *Source = source_at(?runtime, source.ok.index::usize);

    var ramp: [512]Token;
    var i:    usize = 0;
    for (i < 512) {
        val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, 100 + i));
        if (sel submitted.err) { ret 3; }
        ramp[i] = submitted.ok;
        i       = i + 1;
    }
    var extra: [64]SourceToken;
    i = 0;
    for (i < 64) {
        val registered: res[SourceToken, io_error.Error] = register_source(?runtime, (?host)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
        if (sel registered.err) { ret 3; }
        extra[i] = registered.ok;
        i        = i + 1;
    }
    val pinned:      Token = ramp[511];
    val peak_slots:  usize = capacity(?runtime);
    val peak_chunks: usize = runtime.sources.chunk_count;

    # everything but the pinned operation and the held handles settles
    i = 0;
    for (i < 511) {
        if (!ok_err(complete(?runtime, ramp[i], 0, 0, false))) { ret 4; }
        i = i + 1;
    }
    var output: [64]Completion;
    var total:  usize = 0;
    for (total < 511) {
        val polled: res[usize, io_error.Error] = poll(?runtime, ?output[0], 64);
        if (polled_count(polled) == 0) { ret 5; }
        total = total + polled_count(polled);
    }
    i = 0;
    for (i < 64) {
        if (!ok_err(unregister_source(?runtime, extra[i]))) { ret 5; }
        i = i + 1;
    }
    # the pinned operation keeps the chunk holding it
    if (capacity(?runtime) <= pinned.index::usize)        { ret 6; }
    if (runtime.sources.chunk_count >= peak_chunks)       { ret 7; }
    if (!ok_err(complete(?runtime, pinned, 0, 0, false))) { ret 8; }
    val last: res[usize, io_error.Error] = poll(?runtime, ?output[0], 64);
    if (polled_count(last) != 1)                                    { ret 8; }
    if (capacity(?runtime) >= peak_slots || capacity(?runtime) > 8) { ret 9; }

    # the held handles never moved and still work
    if (slot_at(?runtime, held.ok.index::usize) != held_slot ||
        slot_at(?runtime, scoped.ok.index::usize) != scoped_slot ||
        source_at(?runtime, source.ok.index::usize) != held_source) { ret 10; }
    if (source_for(?runtime, source.ok) != held_source)                                                            { ret 10; }
    if (deadline_find(?runtime, ?scope, time.instant_add(clock.ok, 3600000000000)) != scoped_slot.deadline_record) { ret 10; }

    # a released chunk's token is refused, and still refused once regrown
    val stale:        Token       = ramp[300];
    val stale_source: SourceToken = extra[63];
    if (ok_err(complete(?runtime, stale, 0, 0, false))) { ret 11; }
    i = 0;
    for (i < 512) {
        val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, 1000 + i));
        if (sel submitted.err) { ret 12; }
        ramp[i] = submitted.ok;
        i       = i + 1;
    }
    i = 0;
    for (i < 64) {
        val registered: res[SourceToken, io_error.Error] = register_source(?runtime, (?host)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
        if (sel registered.err) { ret 12; }
        extra[i] = registered.ok;
        i        = i + 1;
    }
    if (capacity(?runtime) <= stale.index::usize)       { ret 13; }
    if (ok_err(complete(?runtime, stale, 0, 0, false))) { ret 14; }
    val owned: res[Token, io_error.Error] = submit_owned(?runtime, stale_source, test_operation(READ, 9));
    if (sel owned.ok) { ret 15; }

    # the held operations settle with their own contexts
    if (!ok_err(complete(?runtime, held.ok, 5, 0, false))) { ret 16; }
    if (!transitioned(cancel.cancel(?scope)))              { ret 16; }
    i = 0;
    for (i < 512) {
        if (!ok_err(complete(?runtime, ramp[i], 0, 0, false))) { ret 17; }
        i = i + 1;
    }
    var seen_held:   bool  = false;
    var seen_scoped: bool  = false;
    var settled:     usize = 0;
    for (settled < 514) {
        val polled: res[usize, io_error.Error] = poll(?runtime, ?output[0], 64);
        if (polled_count(polled) == 0) { ret 18; }
        var k: usize = 0;
        for (k < polled_count(polled)) {
            if (token_equal(output[k].token, held.ok)) {
                seen_held = output[k].context == 7 && output[k].bytes == 5 && !output[k].has_error;
            }
            if (token_equal(output[k].token, scoped.ok)) {
                seen_scoped = output[k].context == 8 && output[k].has_error && output[k].error.kind == io_error.CANCELLED;
            }
            k = k + 1;
        }
        settled = settled + polled_count(polled);
    }
    if (!seen_held || !seen_scoped) { ret 19; }
    i = 0;
    for (i < 64) {
        if (!ok_err(unregister_source(?runtime, extra[i]))) { ret 20; }
        i = i + 1;
    }
    if (!ok_err(unregister_source(?runtime, source.ok)))         { ret 20; }
    if (!succeeded(cancel.destroy(?scope)))                      { ret 21; }
    if (!ok_bool(close(?runtime)) || !ok_err(destroy(?runtime))) { ret 22; }
    ret 0;
}

# #868: one empty chunk of slack stays, so a load crossing a chunk boundary
# back and forth allocates only the first time it crosses
test runtime__a_load_oscillating_across_a_chunk_boundary_allocates_once {
    var counting: Counting;
    var a:        allocator.Allocator;
    counting_make(?counting, ?a);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?a, 4))) { ret 1; }
    var base: [4]Token;
    var i:    usize = 0;
    for (i < 4) {
        val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, i));
        if (sel submitted.err) { ret 2; }
        base[i] = submitted.ok;
        i       = i + 1;
    }
    if (capacity(?runtime) != 4) { ret 3; }
    var after_first: usize = 0;
    var round:       usize = 0;
    var output:      Completion;
    for (round < 100) {
        val crossing: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, round));
        if (sel crossing.err)                                      { ret 4; }
        if (!ok_err(complete(?runtime, crossing.ok, 0, 0, false))) { ret 5; }
        val polled: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
        if (polled_count(polled) != 1) { ret 6; }
        if (round == 0)                { after_first = counting.allocations; }
        round = round + 1;
    }
    if (counting.allocations != after_first) { ret 7; }
    if (capacity(?runtime) != 8)             { ret 8; }
    # once the base drains too, the slack chunk goes
    i = 0;
    for (i < 4) {
        if (!ok_err(complete(?runtime, base[i], 0, 0, false))) { ret 9; }
        i = i + 1;
    }
    var drained: [4]Completion;
    val polled:  res[usize, io_error.Error] = poll(?runtime, ?drained[0], 4);
    if (polled_count(polled) != 4)                               { ret 10; }
    if (capacity(?runtime) != 4)                                 { ret 11; }
    if (!ok_bool(close(?runtime)) || !ok_err(destroy(?runtime))) { ret 12; }
    if (counting.live != 0)                                      { ret 13; }
    ret 0;
}

# #868: an id released while a collection runs may still be named by an event
# that collection harvested, so its chunk waits for the collection to end
test runtime__source_ids_released_mid_collection_return_their_chunk_after_it {
    var pa: allocator.Allocator;
    page.make(?pa);
    var runtime: Runtime;
    if (!ok_err(make(?runtime, ?pa, 1))) { ret 1; }
    var host:    TestSource = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val idle:    usize      = runtime.source_routes.chunk_count;
    var sources: [64]SourceToken;
    var i:       usize      = 0;
    for (i < 64) {
        val registered: res[SourceToken, io_error.Error] = register_source(?runtime, (?host)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
        if (sel registered.err) { ret 2; }
        sources[i] = registered.ok;
        i          = i + 1;
    }
    val peak: usize = runtime.source_routes.chunk_count;
    if (peak <= idle + 1) { ret 3; }
    collection_begin(?runtime);
    i = 0;
    for (i < 64) {
        if (!ok_err(unregister_source(?runtime, sources[i]))) { ret 4; }
        i = i + 1;
    }
    # the source table shrank, the ids wait for the collection
    if (runtime.sources.chunk_count > 2)           { ret 5; }
    if (runtime.source_routes.chunk_count != peak) { ret 6; }
    collection_end(?runtime);
    if (runtime.source_routes.chunk_count > idle + 1)            { ret 7; }
    if (!ok_bool(close(?runtime)) || !ok_err(destroy(?runtime))) { ret 8; }
    ret 0;
}
