# bounded portable operation-completion ownership

use std.chrono.time;
use io_error: std.io.error;
use std.io.lifecycle;
use std.memory;
use std.memory.table;
use std.sync.atomic;
use std.sync.cancel;
use std.sync.mutex;
use std.sync.thread;
use std.system.os;
use std.system.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

$if ($mach.build.os == $mach.os.linux) {
    use native_os: std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use native_os: std.system.os.darwin;
}
$or ($mach.build.os == $mach.os.windows) {
    use native_os: std.system.os.windows;
}
$or {
    $error("std.io.runtime: unsupported target");
}

pub def Kind: u8;
pub val ACCEPT:       Kind = 0;
pub val CONNECT:      Kind = 1;
pub val READ:         Kind = 2;
pub val WRITE:        Kind = 3;
pub val RECEIVE_FROM: Kind = 4;
pub val SEND_TO:      Kind = 5;
pub val FILE_READ:    Kind = 6;
pub val FILE_WRITE:   Kind = 7;
pub val TIMER:        Kind = 8;
pub val PROCESS_WAIT: Kind = 9;
pub val USER_WAKE:    Kind = 10;
pub val SHUTDOWN:     Kind = 11;
pub val CLOSE:        Kind = 12;
pub val BIND:         Kind = 13;
pub val LISTEN:       Kind = 14;
pub val RESOLVE:      Kind = 15;

pub rec Token {
    index:      u32;
    generation: u32;
}

# buffer is borrowed from successful submission until its completion is dequeued
pub rec Operation {
    kind:     Kind;
    resource: usize;
    buffer:   *u8;
    length:   usize;
    offset:   u64;
    context:  usize;
}

pub rec Completion {
    token:         Token;
    kind:          Kind;
    context:       usize;
    bytes:         usize;
    items:         usize;
    resource:      usize;
    opening:       u64;
    has_error:     bool;
    error:         io_error.Error;
    end_of_stream: bool;
}

pub rec NativeEvent {
    context: usize;
    events:  u32;
    status:  i64;
    flags:   u64;
}

pub rec SourceToken {
    index:      u32;
    generation: u32;
    tag:        u16;
}

# offered every native event in registration order. returns true only for a
# native context the source itself registered, which ends the offer. a wake
# (context 0) is offered to every source regardless
pub def DispatchFun: fun(ptr, usize, u32, i64, u64) bool;
pub def CancelFun:   fun(ptr, Token, io_error.Error) i64;
pub def ReleaseFun:  fun(ptr, *Completion);
pub val CANCELLATION_PENDING: i64 = 1;

# wait is false when the driver must not poll: the runtime is closed or a
# caller woke it, and woken says which
pub rec WaitPlan {
    wait:       bool;
    timeout_ms: i32;
    woken:      bool;
}

val SLOT_FREE:       u8 = 0;
val SLOT_ACTIVE:     u8 = 1;
val SLOT_QUEUED:     u8 = 2;
val SLOT_CANCELLING: u8 = 3;
val SLOT_RELEASING:  u8 = 4;

# a slot index sentinel for the free list and the completion queue
val NO_SLOT:  usize = ~(0::usize);
val NO_TIMER: usize = ~(0::usize);

# a source is a registered backend, so the table starts far below the slots
val SOURCE_INITIAL: usize = 4;

# readiness is harvested in fixed batches, so the batch is not a capacity
val NATIVE_BATCH: usize = 256;

val SOURCE_UNUSED:     u8  = 0;
val SOURCE_REGISTERED: u8  = 1;
val SOURCE_RETIRED:    u8  = 2;
val NO_SOURCE:         u32 = 0xffffffff;

rec Source {
    state:      u8;
    generation: u32;
    tag:        u16;
    context:    ptr;
    dispatch:   DispatchFun;
    cancel:     CancelFun;
    release:    ReleaseFun;
    live:       usize;
    busy:       usize;
    attachment: lifecycle.Attachment;
}

rec Slot {
    state:                  u8;
    generation:             u32;
    index:                  u32;
    runtime:                *Runtime;
    next:                   usize;
    completion:             Completion;
    operation_timer_index:  usize;
    deadline_timer_index:   usize;
    cancellation_active:    bool;
    cancellation_pending:   bool;
    lifecycle_cancellation: bool;
    cancellation:           cancel.Registration;
    terminal_error:         io_error.Error;
    attachment:             lifecycle.Attachment;
    source_index:           u32;
    operation:              Operation;
}

val TIMER_OPERATION:      u8 = 0;
val TIMER_SCOPE_DEADLINE: u8 = 1;

rec TimerEntry {
    deadline: time.Time;
    token:    Token;
    purpose:  u8;
    scope:    *cancel.Scope;
}

pub val OPEN:      u8 = lifecycle.OPEN;
pub val CLOSING:   u8 = lifecycle.CLOSING;
pub val CLOSED:    u8 = lifecycle.CLOSED;
pub val DESTROYED: u8 = 3;

# one thread owns wait and dequeue, while submission and resolution may be concurrent
pub rec Runtime {
    queue:           os.IoQueue;
    slots:           table.Table;
    timers:          table.Table;
    sources:         table.Table;
    native_events:   *NativeEvent;
    initial:         usize;
    slot_count:      usize;
    free_head:       usize;
    free_tail:       usize;
    head:            usize;
    tail:            usize;
    count:           usize;
    live:            usize;
    timer_count:     usize;
    source_count:    usize;
    source_slots:    usize;
    next_source_tag: u32;
    native_controls: usize;
    lifecycle:       lifecycle.Lifecycle;
    destroyed:       bool;
    # a caller's wake, pending until a wait or a wait plan answers it
    woken:       bool;
    lock:        mutex.Mutex;
    native_lock: mutex.Mutex;
    # held for a whole native control, so a waiter can yield to one
    control_lock: mutex.Mutex;
}

# the caller excludes concurrent destruction while querying stable ownership
pub fun aliases(runtime: *Runtime, data: *u8, len: usize) bool {
    if (!memory.range_valid(data, len)) { ret true; }
    if (len == 0)                       { ret false; }
    if (!memory.range_valid(runtime::*u8, $size_of(Runtime)) ||
        runtime.slots.capacity == 0 || runtime.destroyed) { ret true; }
    if (memory.ranges_overlap(runtime::*u8, $size_of(Runtime), data, len)) {
        ret true;
    }
    var native_event_bytes: usize = 0;
    if (!memory.range_scaled(NATIVE_BATCH, $size_of(NativeEvent),
        ?native_event_bytes)) { ret true; }
    ret table.aliases(?runtime.slots, data, len) ||
        table.aliases(?runtime.timers, data, len) ||
        table.aliases(?runtime.sources, data, len) ||
        memory.ranges_overlap(runtime.native_events::*u8, native_event_bytes,
        data, len);
}

fun slot_at(runtime: *Runtime, index: usize) *Slot {
    ret table.at(?runtime.slots, index)::*Slot;
}

fun source_at(runtime: *Runtime, index: usize) *Source {
    ret table.at(?runtime.sources, index)::*Source;
}

fun timer_at(runtime: *Runtime, index: usize) *TimerEntry {
    ret table.at(?runtime.timers, index)::*TimerEntry;
}

# the slot table is the runtime's current size, not a limit it was given
pub fun capacity(runtime: *Runtime) usize {
    if (runtime == nil || runtime.destroyed) { ret 0; }
    ret runtime.slots.capacity;
}

fun invalid(operation: io_error.Operation) io_error.Error {
    ret io_error.make(io_error.INVALID, operation);
}

fun exhausted(operation: io_error.Operation) io_error.Error {
    ret io_error.make(io_error.RESOURCE_EXHAUSTED, operation);
}

fun init_slot(runtime: *Runtime, index: usize) {
    val slot: *Slot = slot_at(runtime, index);
    slot.state                  = SLOT_FREE;
    slot.generation             = 0;
    slot.index                  = index::u32;
    slot.runtime                = runtime;
    slot.next                   = NO_SLOT;
    slot.operation_timer_index  = NO_TIMER;
    slot.deadline_timer_index   = NO_TIMER;
    slot.cancellation_active    = false;
    slot.cancellation_pending   = false;
    slot.lifecycle_cancellation = false;
    slot.terminal_error         = io_error.make(io_error.OTHER, io_error.OP_UNKNOWN);
    slot.attachment.owner       = nil;
    slot.attachment.generation  = 0;
    slot.attachment.sequence    = 0;
    slot.attachment.active      = false;
    slot.source_index           = NO_SOURCE;
    cancel.init_registration(?slot.cancellation);
}

fun init_source(runtime: *Runtime, index: usize) {
    val source: *Source = source_at(runtime, index);
    source.state                 = SOURCE_UNUSED;
    source.generation            = 0;
    source.tag                   = 0;
    source.context               = nil;
    source.live                  = 0;
    source.busy                  = 0;
    source.attachment.owner      = nil;
    source.attachment.generation = 0;
    source.attachment.sequence   = 0;
    source.attachment.active     = false;
}

fun free_push(runtime: *Runtime, index: usize) {
    val slot: *Slot = slot_at(runtime, index);
    slot.next = NO_SLOT;
    if (runtime.free_tail == NO_SLOT) { runtime.free_head = index; }
    or                                { slot_at(runtime, runtime.free_tail).next = index; }
    runtime.free_tail = index;
}

# oldest first, so a released index waits behind every other free one
fun free_pop(runtime: *Runtime) usize {
    val index: usize = runtime.free_head;
    if (index == NO_SLOT) { ret NO_SLOT; }
    val slot: *Slot = slot_at(runtime, index);
    runtime.free_head = slot.next;
    if (runtime.free_head == NO_SLOT) { runtime.free_tail = NO_SLOT; }
    slot.next = NO_SLOT;
    ret index;
}

fun release_tables(runtime: *Runtime) {
    table.destroy(?runtime.sources);
    table.destroy(?runtime.timers);
    table.destroy(?runtime.slots);
}

# every slot carries at most an operation timer and a scope deadline, so a
# reserve of twice the slot table is a push that cannot fail
fun reserve_timers(runtime: *Runtime) bool {
    if (runtime.slots.capacity > ~(0::usize) / 2) { ret false; }
    ret table.reserve(?runtime.timers, runtime.slots.capacity * 2);
}

# initial is the size the runtime starts at, not a ceiling: the slot, timer and
# source tables grow on demand and only memory bounds them
pub fun make(runtime: *Runtime, initial: usize) err[io_error.Error] {
    if (runtime == nil || initial == 0 || initial > 0xffffffff) {
        ret err[io_error.Error].err{invalid(io_error.OP_CREATE)};
    }
    var native_event_bytes: usize = 0;
    if (!memory.range_scaled(NATIVE_BATCH, $size_of(NativeEvent),
        ?native_event_bytes)) {
        ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    if (!table.make(?runtime.slots, $size_of(Slot), initial)) {
        ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    if (!table.make(?runtime.timers, $size_of(TimerEntry), initial) ||
        !table.make(?runtime.sources, $size_of(Source), SOURCE_INITIAL) ||
        !reserve_timers(runtime)) {
        release_tables(runtime);
        ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    runtime.native_events = os.allocate(native_event_bytes)::*NativeEvent;
    if (runtime.native_events == nil) {
        release_tables(runtime);
        ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }

    runtime.initial         = initial;
    runtime.slot_count      = 0;
    runtime.free_head       = NO_SLOT;
    runtime.free_tail       = NO_SLOT;
    runtime.head            = NO_SLOT;
    runtime.tail            = NO_SLOT;
    runtime.count           = 0;
    runtime.live            = 0;
    runtime.timer_count     = 0;
    runtime.source_count    = 0;
    runtime.source_slots    = 0;
    runtime.next_source_tag = 1;
    runtime.native_controls = 0;
    lifecycle.make(?runtime.lifecycle);
    runtime.destroyed    = false;
    runtime.woken        = false;
    runtime.lock         = mutex.make();
    runtime.native_lock  = mutex.make();
    runtime.control_lock = mutex.make();
    val code: i64 = os.io_queue_create(?runtime.queue);
    if (code < 0) {
        os.deallocate(runtime.native_events::ptr, native_event_bytes);
        release_tables(runtime);
        runtime.native_events = nil;
        runtime.destroyed     = true;
        ret err[io_error.Error].err{os.error(code, io_error.OP_CREATE)};
    }
    ret err[io_error.Error].ok{};
}

fun source_for(runtime: *Runtime, token: SourceToken) *Source {
    if (token.index::usize >= runtime.source_slots || token.tag == 0) { ret nil; }
    val source: *Source = source_at(runtime, token.index::usize);
    if (source.state != SOURCE_REGISTERED || source.generation != token.generation || source.tag != token.tag) { ret nil; }
    ret source;
}

fun source_for_retirement(runtime: *Runtime, token: SourceToken) *Source {
    if (token.index::usize >= runtime.source_slots || token.tag == 0) { ret nil; }
    val source: *Source = source_at(runtime, token.index::usize);
    if ((source.state != SOURCE_REGISTERED && source.state != SOURCE_RETIRED)
        || source.generation != token.generation
        || source.tag != token.tag) {
        ret nil;
    }
    ret source;
}

pub fun register_source(
    runtime: *Runtime,
    context: ptr,
    dispatch: DispatchFun,
    cancel_operation: CancelFun,
    release: ReleaseFun,
) res[SourceToken, io_error.Error] {
    if (runtime == nil || context == nil) {
        ret res[SourceToken, io_error.Error].err{invalid(io_error.OP_CREATE)};
    }
    mutex.lock(?runtime.lock);
    if (runtime.destroyed || lifecycle.snapshot(?runtime.lifecycle).state != lifecycle.OPEN) {
        mutex.unlock(?runtime.lock);
        ret res[SourceToken, io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_CREATE)};
    }
    if (runtime.next_source_tag > 0xffff) {
        mutex.unlock(?runtime.lock);
        ret res[SourceToken, io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    var index: usize = 0;
    for (index < runtime.source_slots && source_at(runtime, index).state != SOURCE_UNUSED) { index = index + 1; }
    if (index == runtime.source_slots) {
        if (index == runtime.sources.capacity && !table.grow(?runtime.sources)) {
            mutex.unlock(?runtime.lock);
            ret res[SourceToken, io_error.Error].err{exhausted(io_error.OP_CREATE)};
        }
        init_source(runtime, index);
        runtime.source_slots = runtime.source_slots + 1;
    }
    val source:     *Source = source_at(runtime, index);
    var generation: u32     = source.generation + 1;
    if (generation == 0) { generation = 1; }
    val tag: u16 = runtime.next_source_tag::u16;
    source.state      = SOURCE_REGISTERED;
    source.generation = generation;
    source.tag        = tag;
    source.context    = context;
    source.dispatch   = dispatch;
    source.cancel     = cancel_operation;
    source.release    = release;
    source.live       = 0;
    source.busy       = 0;
    val attached: err[lifecycle.StateError] = lifecycle.attach(?runtime.lifecycle, ?source.attachment);
    if (sel attached.err) {
        source.state   = SOURCE_RETIRED;
        source.context = nil;
        mutex.unlock(?runtime.lock);
        ret res[SourceToken, io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_CREATE)};
    }
    runtime.source_count    = runtime.source_count + 1;
    runtime.next_source_tag = runtime.next_source_tag + 1;
    mutex.unlock(?runtime.lock);
    ret res[SourceToken, io_error.Error].ok{SourceToken{index: index::u32, generation: generation, tag: tag}};
}

pub fun retire_source(runtime: *Runtime, token: SourceToken) res[bool, io_error.Error] {
    if (runtime == nil) { ret res[bool, io_error.Error].err{invalid(io_error.OP_CLOSE)}; }
    mutex.lock(?runtime.lock);
    val source: *Source = source_for_retirement(runtime, token);
    if (source == nil) {
        mutex.unlock(?runtime.lock);
        ret res[bool, io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    if (source.state == SOURCE_RETIRED) {
        mutex.unlock(?runtime.lock);
        ret res[bool, io_error.Error].ok{false};
    }
    if (source.live != 0 || source.busy != 0) {
        mutex.unlock(?runtime.lock);
        ret res[bool, io_error.Error].err{io_error.make(io_error.BUSY, io_error.OP_CLOSE)};
    }
    source.state = SOURCE_RETIRED;
    mutex.unlock(?runtime.lock);
    ret res[bool, io_error.Error].ok{true};
}

pub fun release_source(runtime: *Runtime, token: SourceToken) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)}; }
    mutex.lock(?runtime.lock);
    val source: *Source = source_for_retirement(runtime, token);
    if (source == nil || source.state != SOURCE_RETIRED || source.live != 0 || source.busy != 0) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    source.state         = SOURCE_UNUSED;
    source.context       = nil;
    runtime.source_count = runtime.source_count - 1;
    val settled:     res[bool, lifecycle.StateError] = lifecycle.settle(?source.attachment);
    var wake_result: i64                             = 0;
    if (sel settled.ok && settled.ok) { wake_result = os.io_queue_wake(?runtime.queue); }
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) {
        ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
    }
    ret err[io_error.Error].ok{};
}

pub fun unregister_source(runtime: *Runtime, token: SourceToken) err[io_error.Error] {
    val retired: res[bool, io_error.Error] = retire_source(runtime, token);
    if (sel retired.err) { ret err[io_error.Error].err{retired.err}; }
    ret release_source(runtime, token);
}

pub fun source_id(token: SourceToken) u16 {
    ret token.tag;
}

# a fresh index is appended and an index is never recycled while it is live,
# so growth adds storage and moves nothing
fun claim_locked(runtime: *Runtime, operation: Operation, source_index: u32, token: *Token) err[io_error.Kind] {
    if (runtime.destroyed || lifecycle.snapshot(?runtime.lifecycle).state != lifecycle.OPEN) {
        ret err[io_error.Kind].err{io_error.CLOSED};
    }
    var index: usize = free_pop(runtime);
    if (index == NO_SLOT) {
        # a token index is 32 bits wide on every backend
        if (runtime.slot_count > 0xffffffff) { ret err[io_error.Kind].err{io_error.RESOURCE_EXHAUSTED}; }
        if (runtime.slot_count == runtime.slots.capacity &&
            !table.grow(?runtime.slots)) { ret err[io_error.Kind].err{io_error.RESOURCE_EXHAUSTED}; }
        if (!reserve_timers(runtime)) { ret err[io_error.Kind].err{io_error.RESOURCE_EXHAUSTED}; }
        index = runtime.slot_count;
        init_slot(runtime, index);
        runtime.slot_count = runtime.slot_count + 1;
    }
    val slot:       *Slot = slot_at(runtime, index);
    var generation: u32   = slot.generation + 1;
    if (generation == 0) { generation = 1; }
    slot.generation             = generation;
    slot.operation              = operation;
    slot.operation_timer_index  = NO_TIMER;
    slot.deadline_timer_index   = NO_TIMER;
    slot.cancellation_active    = false;
    slot.cancellation_pending   = false;
    slot.lifecycle_cancellation = false;
    slot.terminal_error         = io_error.make(io_error.OTHER, io_error.OP_UNKNOWN);
    slot.source_index           = source_index;
    cancel.init_registration(?slot.cancellation);
    val attached: err[lifecycle.StateError] = lifecycle.attach(?runtime.lifecycle, ?slot.attachment);
    if (sel attached.err) {
        free_push(runtime, index);
        ret err[io_error.Kind].err{io_error.CLOSED};
    }
    slot.state   = SLOT_ACTIVE;
    runtime.live = runtime.live + 1;
    if (source_index != NO_SOURCE) {
        val source: *Source = source_at(runtime, source_index::usize);
        source.live = source.live + 1;
    }
    @token = Token{index: index::u32, generation: generation};
    ret err[io_error.Kind].ok{};
}

pub fun submit(runtime: *Runtime, operation: Operation) res[Token, io_error.Error] {
    if (runtime == nil) { ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, NO_SOURCE, ?token);
    mutex.unlock(?runtime.lock);
    if (sel claimed.err) { ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)}; }
    ret res[Token, io_error.Error].ok{token};
}

pub fun submit_owned(runtime: *Runtime, source_token: SourceToken, operation: Operation) res[Token, io_error.Error] {
    if (runtime == nil) { ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    if (source_for(runtime, source_token) == nil) {
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)};
    }
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, source_token.index, ?token);
    mutex.unlock(?runtime.lock);
    if (sel claimed.err) { ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)}; }
    ret res[Token, io_error.Error].ok{token};
}

fun slot_for(runtime: *Runtime, token: Token) *Slot {
    if (token.index::usize >= runtime.slot_count) { ret nil; }
    val slot: *Slot = slot_at(runtime, token.index::usize);
    if (slot.generation != token.generation || slot.state != SLOT_ACTIVE) { ret nil; }
    ret slot;
}

fun token_equal(a: Token, b: Token) bool {
    ret a.index == b.index && a.generation == b.generation;
}

fun timer_less(a: TimerEntry, b: TimerEntry) bool {
    if (time.time_before(a.deadline, b.deadline)) { ret true; }
    if (time.time_after(a.deadline, b.deadline))  { ret false; }
    if (a.purpose != b.purpose)                   { ret a.purpose == TIMER_SCOPE_DEADLINE; }
    if (a.token.index < b.token.index)            { ret true; }
    if (a.token.index > b.token.index)            { ret false; }
    ret a.token.generation < b.token.generation;
}

fun timer_set_index(runtime: *Runtime, entry: TimerEntry, index: usize) {
    val slot: *Slot = slot_at(runtime, entry.token.index::usize);
    if (entry.purpose == TIMER_OPERATION) {
        slot.operation_timer_index = index;
    }
    or {
        slot.deadline_timer_index = index;
    }
}

fun timer_swap(runtime: *Runtime, a: usize, b: usize) {
    val first:  *TimerEntry = timer_at(runtime, a);
    val second: *TimerEntry = timer_at(runtime, b);
    val entry:  TimerEntry  = @first;
    @first  = @second;
    @second = entry;
    timer_set_index(runtime, @first, a);
    timer_set_index(runtime, @second, b);
}

fun timer_sift_up(runtime: *Runtime, start: usize) {
    var index: usize = start;
    for (index > 0) {
        val parent: usize = (index - 1) / 2;
        if (!timer_less(@timer_at(runtime, index), @timer_at(runtime, parent))) { ret; }
        timer_swap(runtime, index, parent);
        index = parent;
    }
}

fun timer_sift_down(runtime: *Runtime, start: usize) {
    var index: usize = start;
    for (true) {
        val left: usize = index * 2 + 1;
        if (left >= runtime.timer_count) { ret; }
        var child: usize = left;
        val right: usize = left + 1;
        if (right < runtime.timer_count && timer_less(@timer_at(runtime, right), @timer_at(runtime, left))) { child = right; }
        if (!timer_less(@timer_at(runtime, child), @timer_at(runtime, index)))                              { ret; }
        timer_swap(runtime, index, child);
        index = child;
    }
}

# the timer table is reserved at twice the slot table, so a push always fits
fun timer_push(runtime: *Runtime, entry: TimerEntry) {
    val index: usize = runtime.timer_count;
    @timer_at(runtime, index) = entry;
    timer_set_index(runtime, entry, index);
    runtime.timer_count = runtime.timer_count + 1;
    timer_sift_up(runtime, index);
}

fun timer_remove_at(runtime: *Runtime, index: usize) TimerEntry {
    val removed: TimerEntry = @timer_at(runtime, index);
    timer_set_index(runtime, removed, NO_TIMER);
    runtime.timer_count = runtime.timer_count - 1;
    if (index < runtime.timer_count) {
        @timer_at(runtime, index) = @timer_at(runtime, runtime.timer_count);
        timer_set_index(runtime, @timer_at(runtime, index), index);
        if (index > 0 && timer_less(@timer_at(runtime, index), @timer_at(runtime, (index - 1) / 2))) {
            timer_sift_up(runtime, index);
        }
        or {
            timer_sift_down(runtime, index);
        }
    }
    ret removed;
}

fun timer_remove_token(runtime: *Runtime, token: Token, purpose: u8) bool {
    val slot: *Slot = slot_for(runtime, token);
    if (slot == nil) { ret false; }
    var index: usize = slot.operation_timer_index;
    if (purpose == TIMER_SCOPE_DEADLINE)                                                                                                    { index = slot.deadline_timer_index; }
    if (index >= runtime.timer_count || timer_at(runtime, index).purpose != purpose || !token_equal(timer_at(runtime, index).token, token)) { ret false; }
    timer_remove_at(runtime, index);
    ret true;
}

# a completion lives in its own slot and the queue links slots, so there is no
# second table to size and a slot holds at most one queued completion
fun enqueue(runtime: *Runtime, token: Token, slot: *Slot, bytes: usize, items: usize, resource: usize, opening: u64, has_error: bool, failure: io_error.Error, eof: bool) {
    slot.completion = Completion{
        token:         token,
        kind:          slot.operation.kind,
        context:       slot.operation.context,
        bytes:         bytes,
        items:         items,
        resource:      resource,
        opening:       opening,
        has_error:     has_error,
        error:         failure,
        end_of_stream: eof,
    };
    slot.next = NO_SLOT;
    if (runtime.tail == NO_SLOT) { runtime.head = token.index::usize; }
    or                           { slot_at(runtime, runtime.tail).next = token.index::usize; }
    runtime.tail  = token.index::usize;
    runtime.count = runtime.count + 1;
    slot.state    = SLOT_QUEUED;
}

fun cancellation_error(reason: cancel.Reason) io_error.Error {
    if (sel reason.timed_out) { ret io_error.make(io_error.TIMEOUT, io_error.OP_WAIT); }
    if (sel reason.cancelled) { ret io_error.make(io_error.CANCELLED, io_error.OP_WAIT); }
    ret io_error.make(io_error.CLOSED, io_error.OP_SUBMIT);
}

# a refused transition counts as not made, the same as the old false
fun transitioned(transition: cancel.Transition) bool {
    if (sel transition.ok) { ret transition.ok; }
    ret false;
}

fun close_error(cause: lifecycle.Cause) io_error.Error {
    if (cause == lifecycle.DEADLINE)     { ret io_error.make(io_error.TIMEOUT, io_error.OP_CLOSE); }
    if (cause == lifecycle.CANCELLATION) { ret io_error.make(io_error.CANCELLED, io_error.OP_CLOSE); }
    if (cause == lifecycle.FAILURE)      { ret io_error.make(io_error.IO, io_error.OP_CLOSE); }
    ret io_error.make(io_error.CLOSED, io_error.OP_CLOSE);
}

fun remove_slot_timers(runtime: *Runtime, token: Token) {
    timer_remove_token(runtime, token, TIMER_OPERATION);
    timer_remove_token(runtime, token, TIMER_SCOPE_DEADLINE);
}

fun scope_cancel_callback(context: ptr, reason: cancel.Reason) {
    val slot:    *Slot    = context::*Slot;
    val runtime: *Runtime = slot.runtime;
    mutex.lock(?runtime.lock);
    if (slot.state != SLOT_ACTIVE) {
        panic.panic("std.io.runtime: cancellation lost operation ownership\n");
    }
    val token: Token = Token{index: slot.index, generation: slot.generation};
    remove_slot_timers(runtime, token);
    slot.state                  = SLOT_CANCELLING;
    slot.lifecycle_cancellation = false;
    slot.terminal_error         = cancellation_error(reason);
    val source_index:   u32            = slot.source_index;
    val terminal_error: io_error.Error = slot.terminal_error;
    slot.cancellation_pending = source_index != NO_SOURCE;
    var source: *Source = nil;
    if (source_index != NO_SOURCE) { source = source_at(runtime, source_index::usize); }
    mutex.unlock(?runtime.lock);
    var code: i64 = 0;
    if (source != nil) {
        code = source.cancel(source.context, token, terminal_error);
    }
    mutex.lock(?runtime.lock);
    if (code < 0) {
        mutex.unlock(?runtime.lock);
        panic.panic("std.io.runtime: source cancellation lost operation ownership\n");
    }
    if (slot.state == SLOT_CANCELLING && code != CANCELLATION_PENDING) {
        slot.cancellation_pending = false;
    }
    or (slot.state != SLOT_CANCELLING && slot.state != SLOT_QUEUED) {
        mutex.unlock(?runtime.lock);
        panic.panic("std.io.runtime: asynchronous cancellation lost operation ownership\n");
    }
    mutex.unlock(?runtime.lock);
}

fun scope_cancel_complete(context: ptr, reason: cancel.Reason) {
    val slot:    *Slot    = context::*Slot;
    val runtime: *Runtime = slot.runtime;
    mutex.lock(?runtime.lock);
    if (slot.state != SLOT_CANCELLING && slot.state != SLOT_QUEUED) {
        panic.panic("std.io.runtime: cancellation completion lost ownership\n");
    }
    val token:     Token = Token{index: slot.index, generation: slot.generation};
    var published: bool  = false;
    if (slot.state == SLOT_CANCELLING && !slot.cancellation_pending) {
        enqueue(runtime, token, slot, 0, 0, 0, 0, true, slot.terminal_error, false);
        published = true;
    }
    slot.cancellation_active = false;
    if (!transitioned(cancel.finish(?slot.cancellation))) {
        panic.panic("std.io.runtime: cancellation completion was not owned\n");
    }
    if (published && os.io_queue_wake(?runtime.queue) < 0) {
        panic.panic("std.io.runtime: open queue wake failed\n");
    }
    mutex.unlock(?runtime.lock);
}

fun release_claim_locked(runtime: *Runtime, token: Token) {
    val slot: *Slot = slot_at(runtime, token.index::usize);
    if (slot.source_index != NO_SOURCE) {
        val source: *Source = source_at(runtime, slot.source_index::usize);
        source.live = source.live - 1;
    }
    slot.state                  = SLOT_FREE;
    slot.cancellation_active    = false;
    slot.cancellation_pending   = false;
    slot.lifecycle_cancellation = false;
    slot.source_index           = NO_SOURCE;
    cancel.init_registration(?slot.cancellation);
    free_push(runtime, token.index::usize);
    runtime.live = runtime.live - 1;
    val settled: res[bool, lifecycle.StateError] = lifecycle.settle(?slot.attachment);
    if (sel settled.err) {
        val current: lifecycle.Snapshot = lifecycle.snapshot(?runtime.lifecycle);
        if (current.state != lifecycle.OPEN) {
            panic.panic("std.io.runtime: released claim did not settle open lifecycle\n");
        }
    }
}

fun attach_scope_locked(runtime: *Runtime, token: Token, scope: *cancel.Scope) cancel.Reason {
    val slot:     *Slot         = slot_at(runtime, token.index::usize);
    val attached: cancel.Reason = cancel.attach_with_completion(scope, ?slot.cancellation, scope_cancel_callback, scope_cancel_complete, slot::ptr);
    if (!sel attached.active) { ret attached; }
    slot.cancellation_active = true;
    val query: cancel.DeadlineQuery = cancel.get_deadline(scope);
    if (sel query.ok) {
        if (sel query.ok.some) {
            timer_push(runtime, TimerEntry{
                deadline: query.ok.some.at,
                token:    token,
                purpose:  TIMER_SCOPE_DEADLINE,
                scope:    query.ok.some.owner,
            });
        }
    }
    ret cancel.Reason.active{};
}

fun submit_scoped_with_source(
    runtime: *Runtime,
    source_token: SourceToken,
    owned: bool,
    scope: *cancel.Scope,
    operation: Operation,
) res[Token, io_error.Error] {
    if (runtime == nil || scope == nil) { ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    val now: time.Clock = time.monotonic();
    if (sel now.err) { ret res[Token, io_error.Error].err{now.err}; }
    cancel.expire(scope, now.ok);
    val query:      cancel.DeadlineQuery = cancel.get_deadline(scope);
    var needs_wake: bool                 = false;
    if (sel query.ok) { needs_wake = sel query.ok.some; }
    mutex.lock(?runtime.lock);
    if (owned && source_for(runtime, source_token) == nil) {
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)};
    }
    var source_index: u32 = NO_SOURCE;
    if (owned) { source_index = source_token.index; }
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, source_index, ?token);
    if (sel claimed.err) {
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)};
    }
    if (needs_wake) {
        val wake_result: i64 = os.io_queue_wake(?runtime.queue);
        if (wake_result < 0) {
            release_claim_locked(runtime, token);
            mutex.unlock(?runtime.lock);
            ret res[Token, io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
        }
    }
    val attached: cancel.Reason = attach_scope_locked(runtime, token, scope);
    if (!sel attached.active) {
        release_claim_locked(runtime, token);
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{cancellation_error(attached)};
    }
    mutex.unlock(?runtime.lock);
    ret res[Token, io_error.Error].ok{token};
}

# prior cancellation is observed or the returned token is atomically scope-owned
pub fun submit_scoped(runtime: *Runtime, scope: *cancel.Scope, operation: Operation) res[Token, io_error.Error] {
    ret submit_scoped_with_source(runtime, SourceToken{index: 0, generation: 0, tag: 0}, false, scope, operation);
}

pub fun submit_scoped_owned(
    runtime: *Runtime,
    source_token: SourceToken,
    scope: *cancel.Scope,
    operation: Operation,
) res[Token, io_error.Error] {
    ret submit_scoped_with_source(runtime, source_token, true, scope, operation);
}

fun resolve_with_copy(runtime: *Runtime, token: Token, source: *u8, copy: bool, bytes: usize, items: usize, resource: usize, opening: u64, has_error: bool, failure: io_error.Error, eof: bool) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    val slot: *Slot = slot_for(runtime, token);
    if (slot == nil) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    if (copy && (slot.operation.kind != FILE_READ || bytes > slot.operation.length || (bytes > 0 && (source == nil || slot.operation.buffer == nil)))) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{invalid(io_error.OP_READ)};
    }
    if (slot.cancellation_active && !transitioned(cancel.unregister(?slot.cancellation))) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    slot.cancellation_active = false;
    remove_slot_timers(runtime, token);
    if (copy && bytes > 0) { memory.raw_copy(slot.operation.buffer::ptr, source::ptr, bytes); }
    enqueue(runtime, token, slot, bytes, items, resource, opening, has_error, failure, eof);
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) {
        ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
    }
    ret err[io_error.Error].ok{};
}

fun resolve(runtime: *Runtime, token: Token, bytes: usize, items: usize, resource: usize, has_error: bool, failure: io_error.Error, eof: bool) err[io_error.Error] {
    ret resolve_with_copy(runtime, token, nil, false, bytes, items, resource, 0, has_error, failure, eof);
}

pub fun complete(runtime: *Runtime, token: Token, bytes: usize, resource: usize, end_of_stream: bool) err[io_error.Error] {
    ret resolve(runtime, token, bytes, 0, resource, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), end_of_stream);
}

# copy is atomic with terminal publication and loses cleanly to close or cancellation
pub fun complete_copy(runtime: *Runtime, token: Token, source: *u8, bytes: usize, resource: usize, end_of_stream: bool) err[io_error.Error] {
    ret resolve_with_copy(runtime, token, source, true, bytes, 0, resource, 0, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), end_of_stream);
}

# a completion that hands the caller a socket it did not open itself, such as
# an accepted or a connected one, also carries that socket's opening
# ---
# resource: the native socket
# opening:  the opening its handle was stamped with (std.io.handle)
pub fun complete_opened(runtime: *Runtime, token: Token, resource: usize, opening: u64) err[io_error.Error] {
    ret resolve_with_copy(runtime, token, nil, false, 0, 0, resource, opening, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), false);
}

# batch completions report byte progress and completed item count separately
pub fun complete_batch(runtime: *Runtime, token: Token, bytes: usize, items: usize, resource: usize) err[io_error.Error] {
    ret resolve(runtime, token, bytes, items, resource, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), false);
}

pub fun fail(runtime: *Runtime, token: Token, failure: io_error.Error) err[io_error.Error] {
    ret resolve(runtime, token, 0, 0, 0, true, failure, false);
}

# asynchronous sources publish only after target ownership has quiesced
pub fun complete_cancellation(runtime: *Runtime, token: Token) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    if (token.index::usize >= runtime.slot_count) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    val slot: *Slot = slot_at(runtime, token.index::usize);
    if (slot.generation != token.generation || slot.state != SLOT_CANCELLING || !slot.cancellation_pending) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    slot.cancellation_pending = false;
    if (slot.cancellation_active) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].ok{};
    }
    enqueue(runtime, token, slot, 0, 0, 0, 0, true, slot.terminal_error, false);
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) { ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)}; }
    ret err[io_error.Error].ok{};
}

# deadlines are absolute monotonic instants and never expire early
# late delivery is limited only by native scheduling and runtime dequeue latency
pub fun submit_timer(runtime: *Runtime, deadline: time.Time, context: usize) res[Token, io_error.Error] {
    if (runtime == nil || deadline.sec < 0 || deadline.nsec < 0 || deadline.nsec >= 1000000000) {
        ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)};
    }
    val operation: Operation = Operation{kind: TIMER, resource: 0, buffer: nil, length: 0, offset: 0, context: context};
    mutex.lock(?runtime.lock);
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, NO_SOURCE, ?token);
    if (sel claimed.ok) {
        val wake_result: i64 = os.io_queue_wake(?runtime.queue);
        if (wake_result < 0) {
            release_claim_locked(runtime, token);
            mutex.unlock(?runtime.lock);
            ret res[Token, io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
        }
        timer_push(runtime, TimerEntry{
            deadline: deadline,
            token:    token,
            purpose:  TIMER_OPERATION,
            scope:    nil,
        });
    }
    mutex.unlock(?runtime.lock);
    if (sel claimed.err) { ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)}; }
    ret res[Token, io_error.Error].ok{token};
}

pub fun submit_timer_scoped(runtime: *Runtime, scope: *cancel.Scope, deadline: time.Time, context: usize) res[Token, io_error.Error] {
    if (runtime == nil || scope == nil || deadline.sec < 0 || deadline.nsec < 0 || deadline.nsec >= 1000000000) {
        ret res[Token, io_error.Error].err{invalid(io_error.OP_SUBMIT)};
    }
    val now: time.Clock = time.monotonic();
    if (sel now.err) { ret res[Token, io_error.Error].err{now.err}; }
    cancel.expire(scope, now.ok);
    val operation: Operation = Operation{kind: TIMER, resource: 0, buffer: nil, length: 0, offset: 0, context: context};
    mutex.lock(?runtime.lock);
    var token:   Token;
    val claimed: err[io_error.Kind] = claim_locked(runtime, operation, NO_SOURCE, ?token);
    if (sel claimed.err) {
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{io_error.make(claimed.err, io_error.OP_SUBMIT)};
    }
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    if (wake_result < 0) {
        release_claim_locked(runtime, token);
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
    }
    val attached: cancel.Reason = attach_scope_locked(runtime, token, scope);
    if (!sel attached.active) {
        release_claim_locked(runtime, token);
        mutex.unlock(?runtime.lock);
        ret res[Token, io_error.Error].err{cancellation_error(attached)};
    }
    timer_push(runtime, TimerEntry{
        deadline: deadline,
        token:    token,
        purpose:  TIMER_OPERATION,
        scope:    nil,
    });
    mutex.unlock(?runtime.lock);
    ret res[Token, io_error.Error].ok{token};
}

# expiry and cancellation race under one lock and publish one terminal result
pub fun cancel_timer(runtime: *Runtime, token: Token) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_SUBMIT)}; }
    mutex.lock(?runtime.lock);
    val slot: *Slot = slot_for(runtime, token);
    if (slot == nil || slot.operation.kind != TIMER || !timer_remove_token(runtime, token, TIMER_OPERATION)) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    if (slot.cancellation_active && !transitioned(cancel.unregister(?slot.cancellation))) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_SUBMIT)};
    }
    slot.cancellation_active = false;
    timer_remove_token(runtime, token, TIMER_SCOPE_DEADLINE);
    enqueue(runtime, token, slot, 0, 0, 0, 0, true, io_error.make(io_error.CANCELLED, io_error.OP_WAIT), false);
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) { ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)}; }
    ret err[io_error.Error].ok{};
}

fun timers_expire(runtime: *Runtime, now: time.Time) *cancel.Scope {
    # all due timers enter the completion queue in deadline and token order
    for (runtime.timer_count > 0 && !time.time_before(now, timer_at(runtime, 0).deadline)) {
        val entry: TimerEntry = timer_remove_at(runtime, 0);
        val slot:  *Slot      = slot_for(runtime, entry.token);
        if (slot != nil && entry.purpose == TIMER_SCOPE_DEADLINE) { ret entry.scope; }
        if (slot != nil) {
            if (!slot.cancellation_active || transitioned(cancel.unregister(?slot.cancellation))) {
                slot.cancellation_active = false;
                timer_remove_token(runtime, entry.token, TIMER_SCOPE_DEADLINE);
                enqueue(runtime, entry.token, slot, 0, 0, 0, 0, false, io_error.make(io_error.OTHER, io_error.OP_UNKNOWN), false);
            }
        }
    }
    ret nil;
}

fun timer_timeout(runtime: *Runtime, requested_ms: i32, now: time.Time) i32 {
    if (runtime.timer_count == 0) { ret requested_ms; }
    val deadline: time.Time = timer_at(runtime, 0).deadline;
    if (!time.time_before(now, deadline)) { ret 0; }
    var sec:  i64 = deadline.sec - now.sec;
    var nsec: i64 = deadline.nsec - now.nsec;
    if (nsec < 0) {
        sec  = sec - 1;
        nsec = nsec + 1000000000;
    }
    var timer_ms: i32 = 0x7fffffff;
    if (sec < 2147483) {
        val rounded: i64 = sec * 1000 + (nsec + 999999) / 1000000;
        timer_ms = rounded::i32;
    }
    if (requested_ms >= 0 && requested_ms < timer_ms) { ret requested_ms; }
    ret timer_ms;
}

fun drain(runtime: *Runtime, output: *Completion, output_capacity: usize) usize {
    var written: usize = 0;
    for (written < output_capacity && runtime.count > 0) {
        val index: usize = runtime.head;
        val slot:  *Slot = slot_at(runtime, index);
        runtime.head = slot.next;
        if (runtime.head == NO_SLOT) { runtime.tail = NO_SLOT; }
        slot.next     = NO_SLOT;
        runtime.count = runtime.count - 1;
        val completion:   Completion = slot.completion;
        val source_index: u32        = slot.source_index;
        var source:       *Source    = nil;
        if (source_index != NO_SOURCE) { source = source_at(runtime, source_index::usize); }
        slot.state = SLOT_RELEASING;
        mutex.unlock(?runtime.lock);
        if (source != nil) {
            source.release(source.context, ?completion);
        }
        output[written] = completion;
        mutex.lock(?runtime.lock);
        slot.state                  = SLOT_FREE;
        slot.cancellation_active    = false;
        slot.cancellation_pending   = false;
        slot.lifecycle_cancellation = false;
        slot.source_index           = NO_SOURCE;
        cancel.init_registration(?slot.cancellation);
        free_push(runtime, index);
        runtime.live = runtime.live - 1;
        if (source != nil) {
            source.live = source.live - 1;
        }
        val settled: res[bool, lifecycle.StateError] = lifecycle.settle(?slot.attachment);
        if (sel settled.ok && settled.ok && os.io_queue_wake(?runtime.queue) < 0) {
            panic.panic("std.io.runtime: terminal lifecycle wake failed\n");
        }
        written = written + 1;
    }
    ret written;
}

# a failed clock stops expiry and is handed back, the last good read is the
# caller's now
fun settle_expired_locked(runtime: *Runtime) time.Clock {
    var now:           time.Clock    = time.monotonic();
    var expired_scope: *cancel.Scope = nil;
    if (sel now.ok) { expired_scope = timers_expire(runtime, now.ok); }
    for (expired_scope != nil) {
        mutex.unlock(?runtime.lock);
        cancel.timeout(expired_scope);
        mutex.lock(?runtime.lock);
        now           = time.monotonic();
        expired_scope = nil;
        if (sel now.ok) { expired_scope = timers_expire(runtime, now.ok); }
    }
    ret now;
}

# drains completions and expires due deadlines
# a wait's return answers a pending caller wake, which answer_wake takes and
# reports through woken
fun take(runtime: *Runtime, output: *Completion, output_capacity: usize, answer_wake: bool, woken: *bool) res[usize, io_error.Error] {
    mutex.lock(?runtime.lock);
    if (runtime.destroyed) {
        mutex.unlock(?runtime.lock);
        ret res[usize, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    val settled: time.Clock = settle_expired_locked(runtime);
    if (sel settled.err) {
        mutex.unlock(?runtime.lock);
        ret res[usize, io_error.Error].err{settled.err};
    }
    val written: usize = drain(runtime, output, output_capacity);
    if (answer_wake && (written > 0 || runtime.woken)) {
        @woken        = runtime.woken;
        runtime.woken = false;
    }
    mutex.unlock(?runtime.lock);
    ret res[usize, io_error.Error].ok{written};
}

# drains completions and expires due deadlines without entering the native wait
# a pending caller wake stays pending for the next wait or wait plan
pub fun poll(runtime: *Runtime, output: *Completion, output_capacity: usize) res[usize, io_error.Error] {
    if (runtime == nil || output == nil || output_capacity == 0) {
        ret res[usize, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    var woken: bool = false;
    ret take(runtime, output, output_capacity, false, ?woken);
}

# prepares another subsystem to wait on the runtime's native queue
#
# the driver polls the queue for at most timeout_ms and then drains with poll.
# the queue also carries the runtime's own wakes, so a poll that returns with
# nothing drained is not a reason to stop: the driver prepares again with the
# time it has left, and ends early only on a plan with woken set, which answers
# a caller's wake. a plan with wait unset must not be polled.
# ---
# timeout_ms: relative bound on the driver's poll, -1 for unbounded
# ret:        the plan, or the runtime's refusal
pub fun prepare_wait(runtime: *Runtime, timeout_ms: i32) res[WaitPlan, io_error.Error] {
    if (runtime == nil || timeout_ms < -1) {
        ret res[WaitPlan, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    mutex.lock(?runtime.lock);
    if (runtime.destroyed) {
        mutex.unlock(?runtime.lock);
        ret res[WaitPlan, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    val settled: time.Clock = settle_expired_locked(runtime);
    if (sel settled.err) {
        mutex.unlock(?runtime.lock);
        ret res[WaitPlan, io_error.Error].err{settled.err};
    }
    if (runtime.woken) {
        runtime.woken = false;
        mutex.unlock(?runtime.lock);
        ret res[WaitPlan, io_error.Error].ok{WaitPlan{wait: false, timeout_ms: 0, woken: true}};
    }
    if (lifecycle.snapshot(?runtime.lifecycle).state == lifecycle.CLOSED) {
        mutex.unlock(?runtime.lock);
        ret res[WaitPlan, io_error.Error].ok{WaitPlan{wait: false, timeout_ms: 0, woken: false}};
    }
    var native_timeout: i32 = timer_timeout(runtime, timeout_ms, settled.ok);
    # ready completions forbid blocking, not collecting readiness
    if (runtime.count != 0) { native_timeout = 0; }
    mutex.unlock(?runtime.lock);
    ret res[WaitPlan, io_error.Error].ok{WaitPlan{wait: true, timeout_ms: native_timeout, woken: false}};
}

pub fun begin_native_control(runtime: *Runtime) err[io_error.Error] {
    if (runtime == nil) { ret err[io_error.Error].err{invalid(io_error.OP_WAIT)}; }
    mutex.lock(?runtime.control_lock);
    mutex.lock(?runtime.lock);
    if (runtime.destroyed) {
        mutex.unlock(?runtime.lock);
        mutex.unlock(?runtime.control_lock);
        ret err[io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    runtime.native_controls = runtime.native_controls + 1;
    val wake_result: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (wake_result < 0) {
        mutex.lock(?runtime.lock);
        runtime.native_controls = runtime.native_controls - 1;
        mutex.unlock(?runtime.lock);
        mutex.unlock(?runtime.control_lock);
        ret err[io_error.Error].err{os.error(wake_result, io_error.OP_WAKE)};
    }
    mutex.lock(?runtime.native_lock);
    ret err[io_error.Error].ok{};
}

pub fun end_native_control(runtime: *Runtime) {
    mutex.lock(?runtime.lock);
    runtime.native_controls = runtime.native_controls - 1;
    mutex.unlock(?runtime.lock);
    mutex.unlock(?runtime.native_lock);
    mutex.unlock(?runtime.control_lock);
}

# the number of native events collected
# controlled reports a poll skipped for a pending native control
fun native_poll(runtime: *Runtime, timeout_ms: i32, controlled: *bool) res[usize, io_error.Error] {
    mutex.lock(?runtime.lock);
    val destroyed: bool = runtime.destroyed;
    @controlled = runtime.native_controls != 0;
    mutex.unlock(?runtime.lock);
    if (destroyed)   { ret res[usize, io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_WAIT)}; }
    if (@controlled) { ret res[usize, io_error.Error].ok{0}; }
    val polled: i64 = native_os.io_queue_poll(
        ?runtime.queue,
        runtime.native_events::*native_os.IoCompletion,
        NATIVE_BATCH,
        timeout_ms,
    );
    if (polled < 0) { ret res[usize, io_error.Error].err{os.error(polled, io_error.OP_WAIT)}; }
    ret res[usize, io_error.Error].ok{polled::usize};
}

fun dispatch_source(runtime: *Runtime, index: usize, event: NativeEvent) bool {
    mutex.lock(?runtime.lock);
    if (runtime.destroyed || index >= runtime.source_slots) {
        mutex.unlock(?runtime.lock);
        ret false;
    }
    val source: *Source = source_at(runtime, index);
    if (source.state != SOURCE_REGISTERED) {
        mutex.unlock(?runtime.lock);
        ret false;
    }
    source.busy = source.busy + 1;
    val context:  ptr         = source.context;
    val dispatch: DispatchFun = source.dispatch;
    mutex.unlock(?runtime.lock);
    val claimed: bool = dispatch(context, event.context, event.events, event.status, event.flags);
    mutex.lock(?runtime.lock);
    source.busy = source.busy - 1;
    mutex.unlock(?runtime.lock);
    ret claimed;
}

fun dispatch_sources(runtime: *Runtime, event: NativeEvent) {
    val wake: bool  = (event.events & native_os.IO_EVENT_WAKE) != 0;
    var i:    usize = 0;
    for (i < runtime.source_slots) {
        val claimed: bool = dispatch_source(runtime, i, event);
        if (claimed && !wake) { ret; }
        i = i + 1;
    }
}

fun flush_sources(runtime: *Runtime) {
    dispatch_sources(runtime, NativeEvent{
        context: 0,
        events:  native_os.IO_EVENT_WAKE,
        status:  0,
        flags:   0,
    });
}

# collects native readiness and publishes every source's queued completions
# controlled reports that a native control cut the collection short
# the caller owns native_lock
fun collect_native(runtime: *Runtime, timeout_ms: i32, controlled: *bool) res[usize, io_error.Error] {
    var total:   usize = 0;
    var timeout: i32   = timeout_ms;
    for (true) {
        val polled: res[usize, io_error.Error] = native_poll(runtime, timeout, controlled);
        if (sel polled.err) { ret polled; }
        val waited: usize = polled.ok;
        var i:      usize = 0;
        for (i < waited) {
            val event: NativeEvent = runtime.native_events[i];
            dispatch_sources(runtime, event);
            i = i + 1;
        }
        total = total + waited;
        # a full batch may have left readiness behind, so drain without blocking
        if (waited < NATIVE_BATCH) { brk; }
        timeout = 0;
    }
    flush_sources(runtime);
    ret res[usize, io_error.Error].ok{total};
}

# the relative time left before deadline, rounded up so a wait never ends short
fun remaining_ms(timeout_ms: i32, deadline: time.Time, now: time.Time) i32 {
    if (timeout_ms <= 0)                  { ret timeout_ms; }
    if (!time.time_before(now, deadline)) { ret 0; }
    val left: i64 = time.time_sub(deadline, now);
    ret ((left + 999999) / 1000000)::i32;
}

# waits for completions
#
# returns 0 only when timeout_ms has passed, a caller called wake, or the
# runtime is closed with nothing left to return. the runtime's own wakes, such
# as the one a submission posts, never end a wait early: the wait keeps waiting
# for the time that remains. a return that carries completions also answers a
# pending wake.
# ---
# output:          completions are written here; the caller owns it and may
#                  reuse it after this call returns
# output_capacity: the most completions one call writes
# timeout_ms:      relative bound, 0 to collect without blocking, -1 for
#                  unbounded
# ret:             the number of completions written, or the refusal
pub fun wait(runtime: *Runtime, output: *Completion, output_capacity: usize, timeout_ms: i32) res[usize, io_error.Error] {
    if (runtime == nil || output == nil || output_capacity == 0 || timeout_ms < -1) {
        ret res[usize, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    var deadline: time.Time;
    if (timeout_ms > 0) {
        val start: time.Clock = time.monotonic();
        if (sel start.err) { ret res[usize, io_error.Error].err{start.err}; }
        deadline = time.time_add(start.ok, timeout_ms::i64 * 1000000);
    }
    # readiness is collected without blocking before completions are returned,
    # so a resource that completes at submission cannot keep the native queue
    # from being polled
    var native_timeout: i32  = 0;
    var controlled:     bool = false;
    for (true) {
        # a native control holds control_lock until it ends, so yielding to it
        # here keeps the unfair native_lock from starving it
        if (controlled) {
            mutex.lock(?runtime.control_lock);
            mutex.unlock(?runtime.control_lock);
        }
        mutex.lock(?runtime.native_lock);
        mutex.lock(?runtime.lock);
        val destroyed: bool = runtime.destroyed;
        mutex.unlock(?runtime.lock);
        if (destroyed) {
            mutex.unlock(?runtime.native_lock);
            ret res[usize, io_error.Error].err{invalid(io_error.OP_WAIT)};
        }
        controlled = false;
        val collected: res[usize, io_error.Error] = collect_native(runtime, native_timeout, ?controlled);
        mutex.unlock(?runtime.native_lock);
        if (sel collected.err) { ret res[usize, io_error.Error].err{collected.err}; }
        var woken:   bool                       = false;
        val drained: res[usize, io_error.Error] = take(runtime, output, output_capacity, true, ?woken);
        if (sel drained.err)         { ret drained; }
        if (drained.ok > 0 || woken) { ret drained; }
        var remaining: i32 = timeout_ms;
        if (timeout_ms > 0) {
            val now: time.Clock = time.monotonic();
            if (sel now.err) { ret res[usize, io_error.Error].err{now.err}; }
            remaining = remaining_ms(timeout_ms, deadline, now.ok);
        }
        # the first pass never blocked, so a zero timeout is answered here
        if (remaining == 0) { ret res[usize, io_error.Error].ok{0}; }
        val prepared: res[WaitPlan, io_error.Error] = prepare_wait(runtime, remaining);
        if (sel prepared.err)  { ret res[usize, io_error.Error].err{prepared.err}; }
        if (!prepared.ok.wait) { ret res[usize, io_error.Error].ok{0}; }
        native_timeout = prepared.ok.timeout_ms;
    }
    ret res[usize, io_error.Error].ok{0};
}

fun post_wake(runtime: *Runtime, caller: bool) err[io_error.Error] {
    if (runtime == nil) {
        ret err[io_error.Error].err{invalid(io_error.OP_WAKE)};
    }
    mutex.lock(?runtime.lock);
    val destroyed: bool = runtime.destroyed;
    var code:      i64;
    if (!destroyed) {
        if (caller) { runtime.woken = true; }
        code = os.io_queue_wake(?runtime.queue);
    }
    mutex.unlock(?runtime.lock);
    if (destroyed) { ret err[io_error.Error].err{invalid(io_error.OP_WAKE)}; }
    if (code < 0)  { ret err[io_error.Error].err{os.error(code, io_error.OP_WAKE)}; }
    ret err[io_error.Error].ok{};
}

# ends a blocked wait early, or the next wait if none is blocked
# wakes coalesce: one wait answers every wake that came before its return
pub fun wake(runtime: *Runtime) err[io_error.Error] {
    ret post_wake(runtime, true);
}

# makes a blocked wait collect every source again without ending it
# a source that queues completions off the native queue calls this, not wake
pub fun notify(runtime: *Runtime) err[io_error.Error] {
    ret post_wake(runtime, false);
}

# close rejects new work and queues one terminal completion for every active operation
pub fun begin_close(runtime: *Runtime, mode: lifecycle.Mode, cause: lifecycle.Cause) res[lifecycle.CloseResult, io_error.Error] {
    if (runtime == nil) { ret res[lifecycle.CloseResult, io_error.Error].err{invalid(io_error.OP_CLOSE)}; }
    mutex.lock(?runtime.lock);
    if (runtime.destroyed) {
        mutex.unlock(?runtime.lock);
        ret res[lifecycle.CloseResult, io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    val closing: lifecycle.CloseResult = lifecycle.begin_close(?runtime.lifecycle, mode, cause);
    if (!closing.started && !closing.escalated) {
        mutex.unlock(?runtime.lock);
        ret res[lifecycle.CloseResult, io_error.Error].ok{closing};
    }
    val closed_error: io_error.Error = close_error(closing.snapshot.terminal_cause);
    if (closing.escalated) {
        var i: usize = 0;
        for (i < runtime.slot_count) {
            val slot: *Slot = slot_at(runtime, i);
            if (slot.state == SLOT_CANCELLING && slot.cancellation_pending && slot.lifecycle_cancellation) {
                slot.terminal_error = closed_error;
            }
            i = i + 1;
        }
    }
    if (closing.started) {
        var i: usize = 0;
        for (i < runtime.slot_count) {
            val slot: *Slot = slot_at(runtime, i);
            if (slot.state == SLOT_ACTIVE) {
                val token: Token = Token{index: i::u32, generation: slot.generation};
                if (!slot.cancellation_active || transitioned(cancel.unregister(?slot.cancellation))) {
                    slot.cancellation_active = false;
                    remove_slot_timers(runtime, token);
                    slot.state                  = SLOT_CANCELLING;
                    slot.lifecycle_cancellation = true;
                    slot.terminal_error         = closed_error;
                    val source_index:   u32            = slot.source_index;
                    val terminal_error: io_error.Error = slot.terminal_error;
                    slot.cancellation_pending = source_index != NO_SOURCE;
                    var source: *Source = nil;
                    if (source_index != NO_SOURCE) { source = source_at(runtime, source_index::usize); }
                    mutex.unlock(?runtime.lock);
                    var cancel_code: i64 = 0;
                    if (source != nil) {
                        cancel_code = source.cancel(source.context, token, terminal_error);
                    }
                    mutex.lock(?runtime.lock);
                    if (cancel_code < 0) {
                        mutex.unlock(?runtime.lock);
                        panic.panic("std.io.runtime: close lost source operation ownership\n");
                    }
                    if (slot.state == SLOT_CANCELLING && cancel_code != CANCELLATION_PENDING) {
                        slot.cancellation_pending = false;
                        enqueue(runtime, token, slot, 0, 0, 0, 0, true, closed_error, false);
                    }
                    or (slot.state != SLOT_CANCELLING && slot.state != SLOT_QUEUED) {
                        mutex.unlock(?runtime.lock);
                        panic.panic("std.io.runtime: asynchronous close lost operation ownership\n");
                    }
                }
            }
            i = i + 1;
        }
    }
    val code: i64 = os.io_queue_wake(?runtime.queue);
    mutex.unlock(?runtime.lock);
    if (code < 0) { ret res[lifecycle.CloseResult, io_error.Error].err{os.error(code, io_error.OP_CLOSE)}; }
    ret res[lifecycle.CloseResult, io_error.Error].ok{closing};
}

pub fun close(runtime: *Runtime) res[bool, io_error.Error] {
    val closed: res[lifecycle.CloseResult, io_error.Error] = begin_close(runtime, lifecycle.ABORTIVE, lifecycle.EXPLICIT);
    if (sel closed.err) { ret res[bool, io_error.Error].err{closed.err}; }
    ret res[bool, io_error.Error].ok{closed.ok.started};
}

fun destroy_with_native_ownership(runtime: *Runtime) err[io_error.Error] {
    mutex.lock(?runtime.lock);
    if (runtime.destroyed || lifecycle.snapshot(?runtime.lifecycle).state != lifecycle.CLOSED) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    if (runtime.live != 0 || runtime.count != 0 || runtime.native_controls != 0) {
        mutex.unlock(?runtime.lock);
        ret err[io_error.Error].err{io_error.make(io_error.BUSY, io_error.OP_CLOSE)};
    }
    var i: usize = 0;
    for (i < runtime.source_slots) {
        if (source_at(runtime, i).state != SOURCE_UNUSED) {
            mutex.unlock(?runtime.lock);
            ret err[io_error.Error].err{io_error.make(io_error.BUSY, io_error.OP_CLOSE)};
        }
        i = i + 1;
    }
    val native_events: *NativeEvent = runtime.native_events;
    runtime.destroyed = true;
    mutex.unlock(?runtime.lock);
    val queue_result:  i64 = os.io_queue_close(?runtime.queue);
    val source_result: i64 = table.destroy(?runtime.sources);
    val timer_result:  i64 = table.destroy(?runtime.timers);
    val slot_result:   i64 = table.destroy(?runtime.slots);
    val native_result: i64 = os.deallocate(native_events::ptr, $size_of(NativeEvent) * NATIVE_BATCH);
    runtime.native_events = nil;
    runtime.slot_count    = 0;
    runtime.source_slots  = 0;
    runtime.free_head     = NO_SLOT;
    runtime.free_tail     = NO_SLOT;
    runtime.head          = NO_SLOT;
    runtime.tail          = NO_SLOT;
    if (queue_result < 0)                                                              { ret err[io_error.Error].err{os.error(queue_result, io_error.OP_CLOSE)}; }
    if (timer_result < 0 || source_result < 0 || native_result < 0 || slot_result < 0) { ret err[io_error.Error].err{io_error.make(io_error.IO, io_error.OP_CLOSE)}; }
    ret err[io_error.Error].ok{};
}

# destroy is valid only after close completions have been dequeued: a runtime
# that is not closed or already destroyed is INVALID, one with live operations,
# queued completions, a native controller or a registered source is EBUSY;
# a refused destroy keeps every allocation
pub fun destroy(runtime: *Runtime) err[io_error.Error] {
    if (runtime == nil) {
        ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    mutex.lock(?runtime.native_lock);
    val result: err[io_error.Error] = destroy_with_native_ownership(runtime);
    mutex.unlock(?runtime.native_lock);
    ret result;
}

pub fun pending(runtime: *Runtime) usize {
    if (runtime == nil || runtime.destroyed) { ret 0; }
    mutex.lock(?runtime.lock);
    val count: usize = runtime.live;
    mutex.unlock(?runtime.lock);
    ret count;
}

pub fun snapshot(runtime: *Runtime) lifecycle.Snapshot {
    if (runtime == nil || runtime.destroyed) {
        ret lifecycle.Snapshot{
            state:          lifecycle.CLOSED,
            mode:           lifecycle.ABORTIVE,
            cause:          lifecycle.FAILURE,
            terminal_cause: lifecycle.FAILURE,
            outstanding:    0,
        };
    }
    ret lifecycle.snapshot(?runtime.lifecycle);
}

fun ok_err(r: err[io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_bool(r: res[bool, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_token(r: res[Token, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_source(r: res[SourceToken, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_usize(r: res[usize, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_plan(r: res[WaitPlan, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_close(r: res[lifecycle.CloseResult, io_error.Error]) bool {
    ret sel r.ok;
}

fun test_operation(kind: Kind, context: usize) Operation {
    ret Operation{kind: kind, resource: 0, buffer: nil, length: 0, offset: 0, context: context};
}

fun succeeded(operation: cancel.Operation) bool {
    ret sel operation.ok;
}

test "runtime: ownership query covers every backing allocation" {
    var runtime:  Runtime;
    var external: [8]u8;
    if (!aliases(?runtime, ?external[0], 1) || aliases(nil, nil, 0) ||
        !aliases((~(0::usize) - 1)::*Runtime, ?external[0], 1)) { ret 1; }
    if (!ok_err(make(?runtime, 2))) { ret 2; }
    if (!aliases(?runtime, (?runtime)::*u8, $size_of(Runtime)) ||
        !aliases(?runtime, runtime.slots.chunks[0]::*u8, $size_of(Slot) * 2) ||
        !aliases(?runtime, runtime.timers.chunks[0]::*u8,
        $size_of(TimerEntry) * 4) ||
        !aliases(?runtime, runtime.sources.chunks[0]::*u8, $size_of(Source)) ||
        !aliases(?runtime, runtime.native_events::*u8,
        $size_of(NativeEvent) * 2) ||
        aliases(?runtime, ?external[0], 8) ||
        !aliases(?runtime, (~(0::usize) - 1)::*u8, 3)) { ret 3; }
    # every chunk a growth adds is owned as well
    val token: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 1));
    if (sel token.err)                                                { ret 5; }
    if (!ok_err(fail(?runtime, token.ok, invalid(io_error.OP_READ)))) { ret 5; }
    var output: Completion;
    if (!ok_usize(poll(?runtime, ?output, 1))) { ret 5; }
    var grown: usize = 0;
    for (grown < 3) {
        if (!table.grow(?runtime.slots)) { ret 6; }
        grown = grown + 1;
    }
    if (!aliases(?runtime, runtime.slots.chunks[3]::*u8, $size_of(Slot))) { ret 7; }
    if (!ok_bool(close(?runtime)) ||
        !ok_err(destroy(?runtime)) ||
        !aliases(?runtime, ?external[0], 1)) { ret 4; }
    ret 0;
}

test "runtime: submission past the initial size grows the slot table" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 2))) { ret 1; }
    if (capacity(?runtime) != 2)    { ret 2; }
    val first:  res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 1));
    val second: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, 2));
    val third:  res[Token, io_error.Error] = submit(?runtime, test_operation(TIMER, 3));
    if (sel first.err)           { ret 3; }
    if (sel second.err)          { ret 3; }
    if (sel third.err)           { ret 3; }
    if (capacity(?runtime) != 4) { ret 4; }
    if (third.ok.index != 2)     { ret 5; }
    close(?runtime);
    var output: [3]Completion;
    val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 3, 0);
    if (sel waited.err)             { ret 6; }
    if (waited.ok != 3)             { ret 6; }
    if (!ok_err(destroy(?runtime))) { ret 7; }
    ret 0;
}

# growth must not move a slot a completion context or a caller already holds
test "runtime: a slot address taken before a growth survives it" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 2))) { ret 1; }
    val held: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 5));
    if (sel held.err) { ret 2; }
    val address:   *Slot    = slot_at(?runtime, held.ok.index::usize);
    val identity:  *Runtime = address.runtime;
    var submitted: usize    = 0;
    for (submitted < 4000) {
        val extra: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, submitted));
        if (sel extra.err) { ret 3; }
        submitted = submitted + 1;
    }
    if (capacity(?runtime) < 4001)                                  { ret 4; }
    if (slot_at(?runtime, held.ok.index::usize) != address)         { ret 5; }
    if (address.runtime != identity || address.runtime != ?runtime) { ret 6; }
    if (address.index != held.ok.index)                             { ret 7; }
    # the operation outstanding across every growth still completes and routes
    if (!ok_err(complete(?runtime, held.ok, 11, 3, false))) { ret 8; }
    var output: Completion;
    val polled: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel polled.err)                                              { ret 9; }
    if (polled.ok != 1 || output.context != 5 || output.bytes != 11) { ret 9; }
    if (output.token.index != held.ok.index)                         { ret 9; }
    close(?runtime);
    var drained: [64]Completion;
    var total:   usize = 0;
    for (total < 4000) {
        val waited: res[usize, io_error.Error] = wait(?runtime, ?drained[0], 64, 0);
        if (sel waited.err) { ret 10; }
        if (waited.ok == 0) { ret 10; }
        total = total + waited.ok;
    }
    if (!ok_err(destroy(?runtime))) { ret 11; }
    ret 0;
}

# a token is only ever reused after its generation has moved on
test "runtime: stale tokens stay refused across growth and reuse" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 2))) { ret 1; }
    val first: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 1));
    if (sel first.err) { ret 2; }
    val stale: Token = first.ok;
    if (!ok_err(complete(?runtime, stale, 1, 0, false))) { ret 3; }
    var output: Completion;
    if (!ok_usize(poll(?runtime, ?output, 1)))          { ret 4; }
    if (ok_err(complete(?runtime, stale, 1, 0, false))) { ret 5; }
    var submitted: usize = 0;
    var reused:    bool  = false;
    for (submitted < 64) {
        val extra: res[Token, io_error.Error] = submit(?runtime, test_operation(WRITE, submitted));
        if (sel extra.err) { ret 6; }
        if (extra.ok.index == stale.index) {
            if (extra.ok.generation == stale.generation) { ret 7; }
            reused = true;
        }
        submitted = submitted + 1;
    }
    if (!reused)                                        { ret 8; }
    if (ok_err(complete(?runtime, stale, 1, 0, false))) { ret 9; }
    close(?runtime);
    var drained: [64]Completion;
    var total:   usize = 0;
    for (total < 64) {
        val waited: res[usize, io_error.Error] = wait(?runtime, ?drained[0], 64, 0);
        if (sel waited.err) { ret 10; }
        if (waited.ok == 0) { ret 10; }
        total = total + waited.ok;
    }
    if (!ok_err(destroy(?runtime))) { ret 11; }
    ret 0;
}

test "runtime: external wait preparation never consumes completions" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 41));
    if (sel submitted.err)                                      { ret 1; }
    if (!ok_err(complete(?runtime, submitted.ok, 3, 0, false))) { ret 1; }
    val blocked: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 7);
    if (sel blocked.err)            { ret 1; }
    if (!blocked.ok.wait)           { ret 1; }
    if (blocked.ok.timeout_ms != 0) { ret 1; }
    var output:  Completion;
    val drained: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel drained.err)      { ret 1; }
    if (drained.ok != 1)      { ret 1; }
    if (output.bytes != 3)    { ret 1; }
    if (output.context != 41) { ret 1; }
    val ready: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 7);
    if (sel ready.err)            { ret 1; }
    if (!ready.ok.wait)           { ret 1; }
    if (ready.ok.timeout_ms != 7) { ret 1; }
    close(?runtime);
    val closed: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, -1);
    if (sel closed.err)             { ret 1; }
    if (closed.ok.wait)             { ret 1; }
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime: one token resolves exactly once" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 77));
    if (sel submitted.err) { ret 1; }
    val token: Token = submitted.ok;
    if (!ok_err(complete(?runtime, token, 9, 42, true)))  { ret 1; }
    if (ok_err(complete(?runtime, token, 10, 43, false))) { ret 1; }
    var output: [1]Completion;
    val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (sel waited.err)                                                                                          { ret 1; }
    if (waited.ok != 1)                                                                                          { ret 1; }
    if (output[0].context != 77 || output[0].bytes != 9 || output[0].resource != 42 || !output[0].end_of_stream) { ret 1; }
    close(?runtime);
    destroy(?runtime);
    ret 0;
}

test "runtime: copy completion publishes bytes atomically" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var destination: [4]u8;
    var source:      [4]u8;
    source[0] = 1;
    source[1] = 2;
    source[2] = 3;
    source[3] = 4;
    val operation: Operation                  = Operation{kind: FILE_READ, resource: 7, buffer: (?destination)::*u8, length: 4, offset: 12, context: 31};
    val submitted: res[Token, io_error.Error] = submit(?runtime, operation);
    if (sel submitted.err)                                                           { ret 1; }
    if (!ok_err(complete_copy(?runtime, submitted.ok, (?source)::*u8, 4, 7, false))) { ret 1; }
    var output:    Completion;
    val completed: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel completed.err)                                                                        { ret 1; }
    if (completed.ok != 1)                                                                        { ret 1; }
    if (output.bytes != 4)                                                                        { ret 1; }
    if (output.has_error)                                                                         { ret 1; }
    if (destination[0] != 1 || destination[1] != 2 || destination[2] != 3 || destination[3] != 4) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime: close wins copy completion without touching caller bytes" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var destination: [2]u8;
    destination[0] = 9;
    destination[1] = 9;
    var source: [2]u8;
    source[0] = 1;
    source[1] = 2;
    val operation: Operation                  = Operation{kind: FILE_READ, resource: 7, buffer: (?destination)::*u8, length: 2, offset: 0, context: 41};
    val submitted: res[Token, io_error.Error] = submit(?runtime, operation);
    if (sel submitted.err) { ret 1; }
    val token: Token = submitted.ok;
    if (!ok_bool(close(?runtime)))                                           { ret 1; }
    if (ok_err(complete_copy(?runtime, token, (?source)::*u8, 2, 7, false))) { ret 1; }
    if (destination[0] != 9 || destination[1] != 9)                          { ret 1; }
    var output:    Completion;
    val completed: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel completed.err)                    { ret 1; }
    if (completed.ok != 1)                    { ret 1; }
    if (!output.has_error)                    { ret 1; }
    if (output.error.kind != io_error.CLOSED) { ret 1; }
    if (!ok_err(destroy(?runtime)))           { ret 1; }
    ret 0;
}

test "runtime: cancellation wins copy completion without touching caller bytes" {
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, 1)) || !succeeded(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
    var destination: [2]u8;
    destination[0] = 8;
    destination[1] = 8;
    var source: [2]u8;
    source[0] = 3;
    source[1] = 4;
    val operation: Operation                  = Operation{kind: FILE_READ, resource: 7, buffer: (?destination)::*u8, length: 2, offset: 0, context: 51};
    val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, operation);
    if (sel submitted.err)                    { ret 1; }
    if (!transitioned(cancel.cancel(?scope))) { ret 1; }
    val token: Token = submitted.ok;
    if (ok_err(complete_copy(?runtime, token, (?source)::*u8, 2, 7, false))) { ret 1; }
    if (destination[0] != 8 || destination[1] != 8)                          { ret 1; }
    var output:    Completion;
    val completed: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel completed.err)                       { ret 1; }
    if (completed.ok != 1)                       { ret 1; }
    if (!output.has_error)                       { ret 1; }
    if (output.error.kind != io_error.CANCELLED) { ret 1; }
    if (!succeeded(cancel.destroy(?scope)))      { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime: close settles every operation and is idempotent" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 32))) { ret 1; }
    var i: usize = 0;
    for (i < 32) {
        if (!ok_token(submit(?runtime, test_operation((i % 11)::Kind, i)))) { ret 1; }
        i = i + 1;
    }
    val first_close:  res[bool, io_error.Error] = close(?runtime);
    val second_close: res[bool, io_error.Error] = close(?runtime);
    if (sel first_close.err)  { ret 1; }
    if (!first_close.ok)      { ret 1; }
    if (sel second_close.err) { ret 1; }
    if (second_close.ok)      { ret 1; }
    var output: [7]Completion;
    var total:  usize = 0;
    for (total < 32) {
        val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 7, 0);
        if (sel waited.err) { ret 1; }
        val count: usize = waited.ok;
        if (count == 0) { ret 1; }
        i = 0;
        for (i < count) {
            if (!output[i].has_error || output[i].error.kind != io_error.CLOSED) { ret 1; }
            i = i + 1;
        }
        total = total + count;
    }
    if (pending(?runtime) != 0)     { ret 1; }
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec WakeContext {
    runtime:  *Runtime;
    started:  *i64;
    returned: *i64;
}

fun wait_worker(arg: *u8) {
    val context: *WakeContext = arg::*WakeContext;
    atomic.store(context.started, 1);
    var output: [1]Completion;
    val result: res[usize, io_error.Error] = wait(context.runtime, ?output[0], 1, -1);
    if (sel result.ok && result.ok == 0) {
        atomic.store(context.returned, 1);
    }
}

$if ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}

test "runtime: wake cannot be lost before a blocked wait" {
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret 0; }
    }
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var started:  i64         = 0;
    var returned: i64         = 0;
    var context:  WakeContext = WakeContext{runtime: ?runtime, started: ?started, returned: ?returned};
    var worker:   thread.Thread;
    thread.spawn_with(wait_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 1; }
    for (atomic.load(?started) == 0) { atomic.spin_hint(); }
    if (!ok_err(wake(?runtime))) { ret 1; }
    thread.join(?worker);
    if (atomic.load(?returned) != 1) { ret 1; }
    close(?runtime);
    destroy(?runtime);
    ret 0;
}

test "runtime: wake is retained until the next wait" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    if (!ok_err(wake(?runtime)))    { ret 1; }
    var output: [1]Completion;
    val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
    if (sel waited.err) { ret 1; }
    if (waited.ok != 0) { ret 1; }
    close(?runtime);
    destroy(?runtime);
    ret 0;
}

fun elapsed_ms(start: time.Time) i64 {
    val now: time.Clock = time.monotonic();
    if (sel now.err) { ret -1; }
    ret time.time_sub(now.ok, start) / 1000000;
}

# a submission wake is the runtime's own and must not end a wait (#676)
test "runtime: a submission wake does not end a wait early" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    val start: time.Clock = time.monotonic();
    if (sel start.err) { ret 2; }
    var scope: cancel.Scope;
    if (!succeeded(cancel.make_root(?scope, true, time.time_add(start.ok, 60000000000)))) { ret 3; }
    # a deadline scope makes the submission post a wake on the native queue
    val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, 91));
    if (sel submitted.err) { ret 4; }
    var output: [1]Completion;
    val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 200);
    val took:   i64                        = elapsed_ms(start.ok);
    if (sel waited.err)                                         { ret 5; }
    if (waited.ok != 0)                                         { ret 6; }
    if (took < 200)                                             { ret 7; }
    if (!ok_err(complete(?runtime, submitted.ok, 0, 0, false))) { ret 8; }
    val drained: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (!(sel drained.ok && drained.ok == 1)) { ret 9; }
    if (!succeeded(cancel.destroy(?scope)))   { ret 10; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 11; }
    ret 0;
}

rec NotifyContext {
    runtime: *Runtime;
    started: *i64;
    delay:   i64;
    wake:    bool;
}

fun notify_worker(arg: *u8) {
    val context: *NotifyContext = arg::*NotifyContext;
    for (atomic.load(context.started) == 0) { atomic.spin_hint(); }
    os.sleep(context.delay);
    notify(context.runtime);
    if (context.wake) {
        os.sleep(context.delay);
        wake(context.runtime);
    }
}

# an internal wake mid-wait resumes with the time left, not the whole timeout
test "runtime: an internal wake keeps the wait's deadline" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var started: i64           = 0;
    var context: NotifyContext = NotifyContext{runtime: ?runtime, started: ?started, delay: 400000000, wake: false};
    var worker:  thread.Thread;
    thread.spawn_with(notify_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 2; }
    val start: time.Clock = time.monotonic();
    if (sel start.err) { ret 3; }
    atomic.store(?started, 1);
    var output: [1]Completion;
    val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 600);
    val took:   i64                        = elapsed_ms(start.ok);
    thread.join(?worker);
    if (sel waited.err) { ret 4; }
    if (waited.ok != 0) { ret 5; }
    if (took < 600)     { ret 6; }
    # restarting the full timeout after the wake would take at least 1000
    if (took >= 950) { ret 7; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 8; }
    ret 0;
}

test "runtime: a caller wake ends a wait that an internal wake did not" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var started: i64           = 0;
    var context: NotifyContext = NotifyContext{runtime: ?runtime, started: ?started, delay: 100000000, wake: true};
    var worker:  thread.Thread;
    thread.spawn_with(notify_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 2; }
    val start: time.Clock = time.monotonic();
    if (sel start.err) { ret 3; }
    atomic.store(?started, 1);
    var output: [1]Completion;
    val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 10000);
    val took:   i64                        = elapsed_ms(start.ok);
    thread.join(?worker);
    if (sel waited.err) { ret 4; }
    if (waited.ok != 0) { ret 5; }
    if (took < 200)     { ret 6; }
    if (took >= 9000)   { ret 7; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 8; }
    ret 0;
}

test "runtime: a return with completions answers a pending wake" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(READ, 92));
    if (sel submitted.err)                                      { ret 2; }
    if (!ok_err(wake(?runtime)))                                { ret 3; }
    if (!ok_err(complete(?runtime, submitted.ok, 1, 0, false))) { ret 4; }
    var output: [1]Completion;
    val first:  res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
    if (!(sel first.ok && first.ok == 1)) { ret 5; }
    # the wake's native event is still queued, but it was already answered
    val start: time.Clock = time.monotonic();
    if (sel start.err) { ret 6; }
    val second: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 100);
    val took:   i64                        = elapsed_ms(start.ok);
    if (!(sel second.ok && second.ok == 0)) { ret 7; }
    if (took < 100)                         { ret 8; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 9; }
    ret 0;
}

test "runtime: a wait plan reports and answers only a caller wake" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    if (!ok_err(notify(?runtime)))  { ret 2; }
    val internal: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 5);
    if (sel internal.err)                       { ret 3; }
    if (!internal.ok.wait || internal.ok.woken) { ret 3; }
    if (!ok_err(wake(?runtime)))                { ret 4; }
    val woken: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 5);
    if (sel woken.err)                    { ret 5; }
    if (woken.ok.wait || !woken.ok.woken) { ret 5; }
    val after: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, 5);
    if (sel after.err)                    { ret 6; }
    if (!after.ok.wait || after.ok.woken) { ret 6; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 7; }
    ret 0;
}

test "runtime: sustained mixed completions remain bounded and fair" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 16))) { ret 1; }
    var round: usize = 0;
    for (round < 100) {
        var tokens: [16]Token;
        var i:      usize = 0;
        for (i < 16) {
            val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation((i % 11)::Kind, round * 16 + i));
            if (sel submitted.err) { ret 1; }
            tokens[i] = submitted.ok;
            i         = i + 1;
        }
        i = 16;
        for (i > 0) {
            i = i - 1;
            if (!ok_err(complete(?runtime, tokens[i], i, 0, false))) { ret 1; }
        }
        var output: [16]Completion;
        val waited: res[usize, io_error.Error] = wait(?runtime, ?output[0], 16, 0);
        if (sel waited.err)         { ret 1; }
        if (waited.ok != 16)        { ret 1; }
        if (pending(?runtime) != 0) { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    destroy(?runtime);
    ret 0;
}

test "runtime timer: large heaps expire in deadline order" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1024))) { ret 1; }
    val base: time.Time = time.Time{sec: 10, nsec: 0};
    var i:    usize     = 0;
    for (i < 1024) {
        val deadline: time.Time = time.time_add(base, ((1024 - i) * 1000000)::i64);
        if (!ok_token(submit_timer(?runtime, deadline, i))) { ret 1; }
        i = i + 1;
    }
    mutex.lock(?runtime.lock);
    timers_expire(?runtime, time.time_add(base, 513000000));
    var output: [1024]Completion;
    val count:  usize = drain(?runtime, ?output[0], 1024);
    mutex.unlock(?runtime.lock);
    if (count != 513) { ret 1; }
    i = 0;
    for (i < 513) {
        if (output[i].context != 1023 - i || output[i].has_error) { ret 1; }
        i = i + 1;
    }
    if (runtime.timer_count != 511 || pending(?runtime) != 511) { ret 1; }
    close(?runtime);
    mutex.lock(?runtime.lock);
    val closed_count: usize = drain(?runtime, ?output[0], 1024);
    mutex.unlock(?runtime.lock);
    if (closed_count != 511)        { ret 1; }
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime timer: cancellation and expiry each publish once" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 2))) { ret 1; }
    val base:             time.Time                  = time.Time{sec: 10, nsec: 0};
    val cancelled_result: res[Token, io_error.Error] = submit_timer(?runtime, time.time_add(base, 1000000), 1);
    if (sel cancelled_result.err) { ret 1; }
    val cancelled: Token = cancelled_result.ok;
    if (!ok_err(cancel_timer(?runtime, cancelled))) { ret 1; }
    if (ok_err(cancel_timer(?runtime, cancelled)))  { ret 1; }
    mutex.lock(?runtime.lock);
    timers_expire(?runtime, time.time_add(base, 2000000));
    mutex.unlock(?runtime.lock);

    val expired_result: res[Token, io_error.Error] = submit_timer(?runtime, time.time_add(base, 3000000), 2);
    if (sel expired_result.err) { ret 1; }
    val expired: Token = expired_result.ok;
    mutex.lock(?runtime.lock);
    timers_expire(?runtime, time.time_add(base, 4000000));
    mutex.unlock(?runtime.lock);
    if (ok_err(cancel_timer(?runtime, expired))) { ret 1; }

    var output: [2]Completion;
    val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 2, 0);
    if (sel result.err)                                                                               { ret 1; }
    if (result.ok != 2)                                                                               { ret 1; }
    if (!output[0].has_error || output[0].error.kind != io_error.CANCELLED || output[0].context != 1) { ret 1; }
    if (output[1].has_error || output[1].context != 2 || pending(?runtime) != 0)                      { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime timer: wall clock adjustments cannot change ordering" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    val monotonic_base: time.Time                  = time.Time{sec: 50, nsec: 0};
    val submitted:      res[Token, io_error.Error] = submit_timer(?runtime, time.time_add(monotonic_base, 20000000), 7);
    if (sel submitted.err) { ret 1; }
    var wall_clock: time.Time = time.Time{sec: 2000000000, nsec: 0};
    wall_clock = time.Time{sec: 1000000000, nsec: 0};
    if (wall_clock.sec != 1000000000) { ret 1; }
    mutex.lock(?runtime.lock);
    timers_expire(?runtime, time.time_add(monotonic_base, 19000000));
    if (runtime.count != 0 || runtime.timer_count != 1) {
        mutex.unlock(?runtime.lock);
        ret 1;
    }
    wall_clock = time.Time{sec: 3000000000, nsec: 0};
    timers_expire(?runtime, time.time_add(monotonic_base, 20000000));
    if (wall_clock.sec != 3000000000 || runtime.count != 1 || runtime.timer_count != 0) {
        mutex.unlock(?runtime.lock);
        ret 1;
    }
    var output: [1]Completion;
    if (drain(?runtime, ?output[0], 1) != 1) {
        mutex.unlock(?runtime.lock);
        ret 1;
    }
    mutex.unlock(?runtime.lock);
    if (output[0].context != 7 || output[0].has_error) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec TimerRaceContext {
    runtime:   *Runtime;
    token:     Token;
    cancelled: *i64;
}

fun timer_cancel_worker(arg: *u8) {
    val context: *TimerRaceContext   = arg::*TimerRaceContext;
    val result:  err[io_error.Error] = cancel_timer(context.runtime, context.token);
    if (sel result.err) {
        atomic.store(context.cancelled, 0);
    }
    or {
        atomic.store(context.cancelled, 1);
    }
}

test "runtime timer: concurrent cancellation and expiry have one winner" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var round: usize = 0;
    for (round < 32) {
        val now: time.Clock = time.monotonic();
        if (sel now.err) { ret 1; }
        val submitted: res[Token, io_error.Error] = submit_timer(?runtime, now.ok, round);
        if (sel submitted.err) { ret 1; }
        var cancelled: i64              = -1;
        var context:   TimerRaceContext = TimerRaceContext{
            runtime:   ?runtime,
            token:     submitted.ok,
            cancelled: ?cancelled,
        };
        var worker: thread.Thread;
        thread.spawn_with(timer_cancel_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        var output: [1]Completion;
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
        thread.join(?worker);
        if (sel result.err)                                                                                       { ret 1; }
        if (result.ok != 1)                                                                                       { ret 1; }
        if (output[0].context != round || pending(?runtime) != 0)                                                 { ret 1; }
        if (atomic.load(?cancelled) == 1 && (!output[0].has_error || output[0].error.kind != io_error.CANCELLED)) { ret 1; }
        if (atomic.load(?cancelled) == 0 && output[0].has_error)                                                  { ret 1; }
        if (ok_err(cancel_timer(?runtime, context.token)))                                                        { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec DestroyWaitContext {
    runtime:   *Runtime;
    closed:    *i64;
    destroyed: *i64;
}

rec NativeControlRaceContext {
    runtime:  *Runtime;
    acquired: *i64;
    release:  *i64;
}

fun close_destroy_worker(arg: *u8) {
    val context: *DestroyWaitContext       = arg::*DestroyWaitContext;
    val closed:  res[bool, io_error.Error] = close(context.runtime);
    if (sel closed.err) {
        atomic.store(context.closed, -1);
        atomic.store(context.destroyed, -1);
        ret;
    }
    atomic.store(context.closed, 1);
    val destroyed: err[io_error.Error] = destroy(context.runtime);
    if (sel destroyed.err) { atomic.store(context.destroyed, -1); }
    or                     { atomic.store(context.destroyed, 1); }
}

fun native_control_worker(arg: *u8) {
    val context:    *NativeControlRaceContext = arg::*NativeControlRaceContext;
    val controlled: err[io_error.Error]       = begin_native_control(context.runtime);
    if (sel controlled.err) {
        atomic.store(context.acquired, -1);
        ret;
    }
    atomic.store(context.acquired, 1);
    for (atomic.load(context.release) == 0) {}
    end_native_control(context.runtime);
}

test "runtime wait and destroy serialize both native ownership interleavings" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    val prepared: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, -1);
    if (sel prepared.err) { ret 2; }
    val plan: WaitPlan = prepared.ok;
    if (!plan.wait
        || !ok_bool(close(?runtime))
        || !ok_err(destroy(?runtime))) {
        ret 3;
    }
    mutex.lock(?runtime.native_lock);
    var stale_controlled: bool                       = false;
    val stale_wait:       res[usize, io_error.Error] = native_poll(?runtime, plan.timeout_ms, ?stale_controlled);
    mutex.unlock(?runtime.native_lock);
    if (!(sel stale_wait.err && stale_wait.err.kind == io_error.CLOSED)) { ret 4; }

    if (!ok_err(make(?runtime, 1))) { ret 5; }
    val second_prepared: res[WaitPlan, io_error.Error] = prepare_wait(?runtime, -1);
    if (sel second_prepared.err) { ret 6; }
    val second_plan: WaitPlan           = second_prepared.ok;
    var closed:      i64                = 0;
    var destroyed:   i64                = 0;
    var context:     DestroyWaitContext = DestroyWaitContext{
        runtime:   ?runtime,
        closed:    ?closed,
        destroyed: ?destroyed,
    };
    mutex.lock(?runtime.native_lock);
    var worker: thread.Thread;
    thread.spawn_with(close_destroy_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) {
        mutex.unlock(?runtime.native_lock);
        ret 7;
    }
    for (atomic.load(?closed) == 0) {}
    if (atomic.load(?closed) != 1 || atomic.load(?destroyed) != 0) {
        mutex.unlock(?runtime.native_lock);
        thread.join(?worker);
        ret 8;
    }
    var owned_controlled: bool                       = false;
    val owned_wait:       res[usize, io_error.Error] = native_poll(?runtime, second_plan.timeout_ms, ?owned_controlled);
    mutex.unlock(?runtime.native_lock);
    thread.join(?worker);
    if (sel owned_wait.err || atomic.load(?destroyed) != 1) { ret 9; }

    if (!ok_err(make(?runtime, 1))
        || !ok_bool(close(?runtime))) {
        ret 10;
    }
    var acquired:        i64                      = 0;
    var release:         i64                      = 0;
    var control_context: NativeControlRaceContext = NativeControlRaceContext{
        runtime:  ?runtime,
        acquired: ?acquired,
        release:  ?release,
    };
    mutex.lock(?runtime.native_lock);
    thread.spawn_with(native_control_worker, (?control_context)::*u8, ?worker);
    if (worker.tid < 0) {
        mutex.unlock(?runtime.native_lock);
        ret 11;
    }
    var queued: bool = false;
    for (!queued) {
        mutex.lock(?runtime.lock);
        queued = runtime.native_controls == 1;
        mutex.unlock(?runtime.lock);
    }
    val rejected: err[io_error.Error] = destroy_with_native_ownership(?runtime);
    mutex.lock(?runtime.lock);
    val was_destroyed: bool = runtime.destroyed;
    mutex.unlock(?runtime.lock);
    if (!sel rejected.err || was_destroyed) {
        mutex.unlock(?runtime.native_lock);
        atomic.store(?release, 1);
        thread.join(?worker);
        ret 12;
    }
    mutex.unlock(?runtime.native_lock);
    for (atomic.load(?acquired) == 0) {}
    if (atomic.load(?acquired) != 1) {
        atomic.store(?release, 1);
        thread.join(?worker);
        ret 13;
    }
    atomic.store(?release, 1);
    thread.join(?worker);
    if (!ok_err(destroy(?runtime))) { ret 14; }
    ret 0;
}

test "runtime timer: native wait uses monotonic deadlines" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    val now: time.Clock = time.monotonic();
    if (sel now.err) { ret 1; }
    val start:     time.Time                  = now.ok;
    val deadline:  time.Time                  = time.time_add(start, 20000000);
    val submitted: res[Token, io_error.Error] = submit_timer(?runtime, deadline, 91);
    if (sel submitted.err) { ret 1; }
    var output:   [1]Completion;
    var count:    usize = 0;
    var attempts: usize = 0;
    for (count == 0 && attempts < 4) {
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
        if (sel result.err) { ret 1; }
        count    = result.ok;
        attempts = attempts + 1;
    }
    val finished: time.Clock = time.monotonic();
    if (sel finished.err)                                                                             { ret 1; }
    if (count != 1 || output[0].context != 91 || output[0].has_error)                                 { ret 1; }
    if (time.time_before(finished.ok, deadline) || time.time_sub(finished.ok, deadline) > 5000000000) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime scope: prior cancellation rejects submission" {
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, 1)))                                                                                      { ret 1; }
    if (!succeeded(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) || !transitioned(cancel.cancel(?scope))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, 1));
    if (!sel submitted.err)                                           { ret 1; }
    if (submitted.err.kind != io_error.CANCELLED)                     { ret 1; }
    if (pending(?runtime) != 0 || !succeeded(cancel.destroy(?scope))) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime scope: parent cancellation settles descendant work once" {
    var runtime: Runtime;
    var root:    cancel.Scope;
    var child:   cancel.Scope;
    val none:    time.Time = time.Time{sec: 0, nsec: 0};
    if (!ok_err(make(?runtime, 3)))                                                                                    { ret 1; }
    if (!succeeded(cancel.make_root(?root, false, none)) || !succeeded(cancel.make_child(?child, ?root, false, none))) { ret 1; }
    var tokens: [3]Token;
    val first:  res[Token, io_error.Error] = submit_scoped(?runtime, ?root, test_operation(READ, 10));
    val second: res[Token, io_error.Error] = submit_scoped(?runtime, ?child, test_operation(WRITE, 11));
    val now:    time.Clock                 = time.monotonic();
    if (sel now.err) { ret 1; }
    val third: res[Token, io_error.Error] = submit_timer_scoped(?runtime, ?child, time.time_add(now.ok, 1000000000), 12);
    if (sel first.err)  { ret 1; }
    if (sel second.err) { ret 1; }
    if (sel third.err)  { ret 1; }
    tokens[0] = first.ok;
    tokens[1] = second.ok;
    tokens[2] = third.ok;
    if (!transitioned(cancel.cancel(?root)) || transitioned(cancel.cancel(?root))) { ret 1; }
    var output: [3]Completion;
    val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 3, 0);
    if (sel result.err) { ret 1; }
    if (result.ok != 3) { ret 1; }
    var i: usize = 0;
    for (i < 3) {
        if (!output[i].has_error || output[i].error.kind != io_error.CANCELLED) { ret 1; }
        if (ok_err(complete(?runtime, tokens[i], 0, 0, false)))                 { ret 1; }
        i = i + 1;
    }
    if (pending(?runtime) != 0 || !succeeded(cancel.destroy(?child)) || !succeeded(cancel.destroy(?root))) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime scope: completion before cancellation remains successful" {
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, 1)))                                              { ret 1; }
    if (!succeeded(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, 15));
    if (sel submitted.err) { ret 1; }
    val token: Token = submitted.ok;
    if (!ok_err(complete(?runtime, token, 4, 0, false))) { ret 1; }
    if (!transitioned(cancel.cancel(?scope)))            { ret 1; }
    var output: [1]Completion;
    val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (sel result.err)                                                         { ret 1; }
    if (result.ok != 1)                                                         { ret 1; }
    if (output[0].has_error || output[0].bytes != 4 || output[0].context != 15) { ret 1; }
    if (!succeeded(cancel.destroy(?scope)))                                     { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime scope: equal operation and scope deadlines prefer timeout" {
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    val now: time.Clock = time.monotonic();
    if (sel now.err) { ret 1; }
    val deadline: time.Time = time.time_add(now.ok, 20000000);
    if (!succeeded(cancel.make_root(?scope, true, deadline))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit_timer_scoped(?runtime, ?scope, deadline, 21);
    if (sel submitted.err) { ret 1; }
    var output:   [1]Completion;
    var count:    usize = 0;
    var attempts: usize = 0;
    for (count == 0 && attempts < 4) {
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, -1);
        if (sel result.err) { ret 1; }
        count    = result.ok;
        attempts = attempts + 1;
    }
    if (count != 1 || output[0].context != 21 || !output[0].has_error || output[0].error.kind != io_error.TIMEOUT) { ret 1; }
    val scope_reason: cancel.Reason = cancel.reason(?scope);
    if (!sel scope_reason.timed_out || !succeeded(cancel.destroy(?scope))) { ret 1; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec CompletionRaceContext {
    runtime:   *Runtime;
    token:     Token;
    completed: *i64;
}

fun completion_race_worker(arg: *u8) {
    val context: *CompletionRaceContext = arg::*CompletionRaceContext;
    val result:  err[io_error.Error]    = complete(context.runtime, context.token, 1, 0, false);
    if (sel result.err) {
        atomic.store(context.completed, 0);
    }
    or {
        atomic.store(context.completed, 1);
    }
}

test "runtime scope: completion and cancellation races have one winner" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var round: usize = 0;
    for (round < 32) {
        var scope: cancel.Scope;
        if (!succeeded(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
        val submitted: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, round));
        if (sel submitted.err) { ret 1; }
        var completed: i64                   = -1;
        var context:   CompletionRaceContext = CompletionRaceContext{
            runtime:   ?runtime,
            token:     submitted.ok,
            completed: ?completed,
        };
        var worker: thread.Thread;
        thread.spawn_with(completion_race_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        cancel.cancel(?scope);
        thread.join(?worker);
        var output: [1]Completion;
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
        if (sel result.err)                                                                                       { ret 1; }
        if (result.ok != 1)                                                                                       { ret 1; }
        if (output[0].context != round)                                                                           { ret 1; }
        if (atomic.load(?completed) == 1 && output[0].has_error)                                                  { ret 1; }
        if (atomic.load(?completed) == 0 && (!output[0].has_error || output[0].error.kind != io_error.CANCELLED)) { ret 1; }
        if (!succeeded(cancel.destroy(?scope)) || pending(?runtime) != 0)                                         { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec SubmissionRaceContext {
    runtime:   *Runtime;
    scope:     *cancel.Scope;
    token:     *Token;
    submitted: *i64;
}

fun submission_race_worker(arg: *u8) {
    val context: *SubmissionRaceContext     = arg::*SubmissionRaceContext;
    val result:  res[Token, io_error.Error] = submit_scoped(context.runtime, context.scope, test_operation(READ, 41));
    if (sel result.ok) {
        @context.token = result.ok;
        atomic.store(context.submitted, 1);
    }
    or {
        atomic.store(context.submitted, 0);
    }
}

test "runtime scope: submission and cancellation races preserve ownership" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var round: usize = 0;
    for (round < 32) {
        var scope: cancel.Scope;
        if (!succeeded(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
        var token:     Token;
        var submitted: i64                   = -1;
        var context:   SubmissionRaceContext = SubmissionRaceContext{
            runtime:   ?runtime,
            scope:     ?scope,
            token:     ?token,
            submitted: ?submitted,
        };
        var worker: thread.Thread;
        thread.spawn_with(submission_race_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        cancel.cancel(?scope);
        thread.join(?worker);
        if (atomic.load(?submitted) == 1) {
            var output: [1]Completion;
            val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
            if (sel result.err)                                                                                { ret 1; }
            if (result.ok != 1)                                                                                { ret 1; }
            if (!output[0].has_error || output[0].error.kind != io_error.CANCELLED || output[0].context != 41) { ret 1; }
            if (ok_err(complete(?runtime, token, 0, 0, false)))                                                { ret 1; }
        }
        or (pending(?runtime) != 0) {
            ret 1;
        }
        if (!succeeded(cancel.destroy(?scope)) || pending(?runtime) != 0) { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

rec ScopeTransitionContext {
    scope: *cancel.Scope;
}

fun timeout_race_worker(arg: *u8) {
    val context: *ScopeTransitionContext = arg::*ScopeTransitionContext;
    cancel.timeout(context.scope);
}

test "runtime scope: deadline and cancellation races preserve the first reason" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var round: usize = 0;
    for (round < 32) {
        var scope: cancel.Scope;
        if (!succeeded(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
        if (!ok_token(submit_scoped(?runtime, ?scope, test_operation(READ, 51))))    { ret 1; }
        var context: ScopeTransitionContext = ScopeTransitionContext{scope: ?scope};
        var worker:  thread.Thread;
        thread.spawn_with(timeout_race_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        cancel.cancel(?scope);
        thread.join(?worker);
        var output: [1]Completion;
        val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
        if (sel result.err) { ret 1; }
        if (result.ok != 1) { ret 1; }
        val scope_reason: cancel.Reason = cancel.reason(?scope);
        if (!output[0].has_error || output[0].context != 51)                                                    { ret 1; }
        if (sel scope_reason.cancelled && output[0].error.kind != io_error.CANCELLED)                           { ret 1; }
        if (sel scope_reason.timed_out && output[0].error.kind != io_error.TIMEOUT)                             { ret 1; }
        if ((!sel scope_reason.cancelled && !sel scope_reason.timed_out) || !succeeded(cancel.destroy(?scope))) { ret 1; }
        round = round + 1;
    }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime scope: close remains distinct from cancellation" {
    var runtime: Runtime;
    var scope:   cancel.Scope;
    if (!ok_err(make(?runtime, 1)))                                              { ret 1; }
    if (!succeeded(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
    if (!ok_token(submit_scoped(?runtime, ?scope, test_operation(READ, 31))))    { ret 1; }
    if (succeeded(cancel.destroy(?scope)) || !ok_bool(close(?runtime)))          { ret 1; }
    if (!transitioned(cancel.cancel(?scope)))                                    { ret 1; }
    val scope_reason: cancel.Reason = cancel.reason(?scope);
    if (!sel scope_reason.cancelled)        { ret 1; }
    if (!succeeded(cancel.destroy(?scope))) { ret 1; }
    var output: [1]Completion;
    val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (sel result.err)                                                  { ret 1; }
    if (result.ok != 1)                                                  { ret 1; }
    if (!output[0].has_error || output[0].error.kind != io_error.CLOSED) { ret 1; }
    if (!ok_err(destroy(?runtime)))                                      { ret 1; }
    ret 0;
}

test "runtime scope: failed submission wake rolls ownership back" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1)))            { ret 1; }
    if (os.io_queue_close(?runtime.queue) < 0) { ret 1; }
    val now: time.Clock = time.monotonic();
    if (sel now.err) { ret 1; }
    val timer_result: res[Token, io_error.Error] = submit_timer(?runtime, time.time_add(now.ok, 1000000000), 61);
    if (!sel timer_result.err)    { ret 1; }
    if (pending(?runtime) != 0)   { ret 1; }
    if (runtime.timer_count != 0) { ret 1; }

    var scope: cancel.Scope;
    if (!succeeded(cancel.make_root(?scope, true, time.time_add(now.ok, 1000000000)))) { ret 1; }
    val scoped_result: res[Token, io_error.Error] = submit_scoped(?runtime, ?scope, test_operation(READ, 62));
    if (!sel scoped_result.err)             { ret 1; }
    if (pending(?runtime) != 0)             { ret 1; }
    if (runtime.timer_count != 0)           { ret 1; }
    if (!succeeded(cancel.destroy(?scope))) { ret 1; }

    if (ok_bool(close(?runtime)))   { ret 1; }
    if (!ok_err(destroy(?runtime))) { ret 1; }
    ret 0;
}

test "runtime: batch completion separates bytes and items" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    val submitted: res[Token, io_error.Error] = submit(?runtime, test_operation(RECEIVE_FROM, 81));
    if (sel submitted.err) { ret 2; }
    val token: Token = submitted.ok;
    if (!ok_err(complete_batch(?runtime, token, 17, 3, 29))) { ret 3; }
    var output: [1]Completion;
    val result: res[usize, io_error.Error] = wait(?runtime, ?output[0], 1, 0);
    if (sel result.err)           { ret 4; }
    if (result.ok != 1)           { ret 4; }
    if (output[0].bytes != 17)    { ret 4; }
    if (output[0].items != 3)     { ret 4; }
    if (output[0].resource != 29) { ret 4; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 5; }
    ret 0;
}

rec TestSource {
    released:             usize;
    cancellation_pending: bool;
    cancelled:            Token;
}

fun test_source_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    ret false;
}

fun test_source_cancel(context: ptr, token: Token, reason: io_error.Error) i64 {
    val source: *TestSource = context::*TestSource;
    source.cancelled = token;
    if (source.cancellation_pending) { ret CANCELLATION_PENDING; }
    ret 0;
}

fun test_source_release(context: ptr, completion: *Completion) {
    val source: *TestSource = context::*TestSource;
    source.released = source.released + 1;
}

test "runtime: retired source slots reject stale tokens and remain reusable" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 1))) { ret 1; }
    var context:      TestSource                       = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val first_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel first_result.err) { ret 2; }
    val first: SourceToken = first_result.ok;
    if (!ok_bool(retire_source(?runtime, first))) { ret 3; }
    # a retired source holds its own index until it is released
    val held_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel held_result.err)                                  { ret 4; }
    if (held_result.ok.index == first.index)                  { ret 4; }
    if (!ok_err(unregister_source(?runtime, held_result.ok))) { ret 4; }
    if (!ok_err(release_source(?runtime, first)))             { ret 5; }
    val second_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel second_result.err) { ret 6; }
    val second: SourceToken = second_result.ok;
    if (first.index != second.index || first.generation == second.generation || source_id(first) == source_id(second)) { ret 7; }
    if (ok_token(submit_owned(?runtime, first, test_operation(READ, 90))))                                             { ret 8; }
    val submitted: res[Token, io_error.Error] = submit_owned(?runtime, second, test_operation(READ, 91));
    if (sel submitted.err) { ret 9; }
    val token: Token = submitted.ok;
    if (!ok_err(complete(?runtime, token, 1, 0, false))) { ret 10; }
    var output: Completion;
    val polled: res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel polled.err)                               { ret 11; }
    if (polled.ok != 1)                               { ret 11; }
    if (context.released != 1)                        { ret 11; }
    if (!ok_err(unregister_source(?runtime, second))) { ret 12; }
    close(?runtime);
    if (!ok_err(destroy(?runtime))) { ret 13; }
    ret 0;
}

test "runtime: source and operation ownership share one close lifecycle" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 2))) { ret 1; }
    var context:       TestSource                       = TestSource{released: 0, cancellation_pending: false, cancelled: Token{index: 0, generation: 0}};
    val source_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel source_result.err) { ret 2; }
    val source:           SourceToken                = source_result.ok;
    val operation_result: res[Token, io_error.Error] = submit_owned(?runtime, source, test_operation(ACCEPT, 92));
    if (sel operation_result.err) { ret 3; }
    val closing_result: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
    if (sel closing_result.err) { ret 4; }
    val closing: lifecycle.CloseResult = closing_result.ok;
    if (!closing.started
        || closing.complete
        || closing.snapshot.mode != lifecycle.GRACEFUL
        || closing.snapshot.cause != lifecycle.PROCESS_TERMINATION
        || closing.snapshot.outstanding != 2) {
        ret 5;
    }
    var output:          Completion;
    val polled:          res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    val after_operation: lifecycle.Snapshot         = snapshot(?runtime);
    if (sel polled.err)                               { ret 6; }
    if (polled.ok != 1)                               { ret 6; }
    if (!output.has_error)                            { ret 6; }
    if (output.error.kind != io_error.CLOSED)         { ret 6; }
    if (context.released != 1)                        { ret 6; }
    if (after_operation.state != lifecycle.CLOSING)   { ret 6; }
    if (after_operation.outstanding != 1)             { ret 6; }
    if (!ok_err(unregister_source(?runtime, source))) { ret 7; }
    val closed: lifecycle.Snapshot = snapshot(?runtime);
    if (closed.state != lifecycle.CLOSED || closed.outstanding != 0) { ret 8; }
    val duplicate_result: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    if (sel duplicate_result.err) { ret 9; }
    val duplicate: lifecycle.CloseResult = duplicate_result.ok;
    if (duplicate.started || duplicate.escalated || !duplicate.complete
        || duplicate.snapshot.mode != lifecycle.GRACEFUL
        || duplicate.snapshot.terminal_cause != lifecycle.PROCESS_TERMINATION) {
        ret 10;
    }
    if (!ok_err(destroy(?runtime))) { ret 11; }
    ret 0;
}

test "runtime: asynchronous source cancellation publishes after quiescence" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 2))) { ret 1; }
    var context:       TestSource                       = TestSource{released: 0, cancellation_pending: true, cancelled: Token{index: 0, generation: 0}};
    val source_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel source_result.err) { ret 2; }
    val source: SourceToken = source_result.ok;
    var scope:  cancel.Scope;
    if (!succeeded(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 3; }
    val submitted: res[Token, io_error.Error] = submit_scoped_owned(?runtime, source, ?scope, test_operation(FILE_READ, 93));
    if (sel submitted.err) { ret 4; }
    val token: Token = submitted.ok;
    if (!transitioned(cancel.cancel(?scope))
        || context.cancelled.index != token.index
        || context.cancelled.generation != token.generation) {
        ret 5;
    }
    var output: Completion;
    val early:  res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel early.err) { ret 6; }
    if (early.ok != 0) { ret 6; }
    val draining: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
    val deadline: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    if (sel draining.err)                                { ret 7; }
    if (sel deadline.err)                                { ret 7; }
    if (!ok_err(complete_cancellation(?runtime, token))) { ret 7; }
    val settled: res[usize, io_error.Error] = wait(?runtime, ?output, 1, 1000);
    if (sel settled.err)                         { ret 8; }
    if (settled.ok != 1)                         { ret 8; }
    if (!output.has_error)                       { ret 8; }
    if (output.error.kind != io_error.CANCELLED) { ret 8; }
    if (context.released != 1)                   { ret 8; }
    if (!succeeded(cancel.destroy(?scope))
        || !ok_err(unregister_source(?runtime, source))
        || !ok_bool(close(?runtime))
        || !ok_err(destroy(?runtime))) {
        ret 9;
    }
    ret 0;
}

test "runtime: first abortive escalation updates unresolved source work" {
    var runtime: Runtime;
    if (!ok_err(make(?runtime, 2))) { ret 1; }
    var context:       TestSource                       = TestSource{released: 0, cancellation_pending: true, cancelled: Token{index: 0, generation: 0}};
    val source_result: res[SourceToken, io_error.Error] = register_source(?runtime, (?context)::ptr, test_source_dispatch, test_source_cancel, test_source_release);
    if (sel source_result.err) { ret 2; }
    val source:    SourceToken                = source_result.ok;
    val submitted: res[Token, io_error.Error] = submit_owned(?runtime, source, test_operation(RESOLVE, 94));
    if (sel submitted.err) { ret 3; }
    val token:     Token                                      = submitted.ok;
    val graceful:  res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
    val deadline:  res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    val cancelled: res[lifecycle.CloseResult, io_error.Error] = begin_close(?runtime, lifecycle.ABORTIVE, lifecycle.CANCELLATION);
    if (sel graceful.err)       { ret 4; }
    if (sel deadline.err)       { ret 4; }
    if (sel cancelled.err)      { ret 4; }
    if (!deadline.ok.escalated) { ret 4; }
    if (cancelled.ok.escalated) { ret 4; }
    var output: Completion;
    val early:  res[usize, io_error.Error] = poll(?runtime, ?output, 1);
    if (sel early.err)                                   { ret 5; }
    if (early.ok != 0)                                   { ret 5; }
    if (!ok_err(complete_cancellation(?runtime, token))) { ret 6; }
    val settled: res[usize, io_error.Error] = wait(?runtime, ?output, 1, 1000);
    if (sel settled.err)                       { ret 7; }
    if (settled.ok != 1)                       { ret 7; }
    if (!output.has_error)                     { ret 7; }
    if (output.error.kind != io_error.TIMEOUT) { ret 7; }
    val state: lifecycle.Snapshot = snapshot(?runtime);
    if (state.terminal_cause != lifecycle.DEADLINE
        || !ok_err(unregister_source(?runtime, source))
        || !ok_err(destroy(?runtime))) {
        ret 8;
    }
    ret 0;
}
