fwd adapter.destroy;
pub rec Mapping {
    data:        ptr;
    length:      usize;
    offset:      u64;
    writable:    bool;
    initialized: bool;
}

# mappings own their virtual region independently of the file handle
pub fun map(file: filesystem.File, offset: u64, length: usize, writable: bool) res[Mapping, io_error.Error] {
    var alignment: usize = os.page_size();
    $if ($mach.build.os == $mach.os.windows) { alignment = 65536; }
    if (!io_handle.file_is_valid(file.handle) || length == 0 || offset > (-1)::usize::u64 || !span_valid(offset, length) || offset::usize % alignment != 0) {
        ret res[Mapping, io_error.Error].err{failure(os.EINVAL, io_error.OP_OPTION)};
    }
    var protection: u32 = os.PROT_READ;
    if (writable) { protection = protection | os.PROT_WRITE; }
    val data: ptr = os.map_file(file.handle.value::i32, offset::usize, length, protection);
    if (data == nil) { ret res[Mapping, io_error.Error].err{failure(os.EIO, io_error.OP_OPTION)}; }
    ret res[Mapping, io_error.Error].ok{Mapping{data: data, length: length, offset: offset, writable: writable, initialized: true}};
}

pub fun mapping_sync(mapping: *Mapping) err[io_error.Error] {
    if (mapping == nil || !mapping.initialized || !mapping.writable) { ret err[io_error.Error].err{failure(os.EINVAL, io_error.OP_SYNC)}; }
    val result: i64 = os.sync_file(mapping.data, mapping.length);
    if (result < 0) { ret err[io_error.Error].err{failure(result, io_error.OP_SYNC)}; }
    ret err[io_error.Error].ok{};
}

pub fun mapping_close(mapping: *Mapping) err[io_error.Error] {
    if (mapping == nil || !mapping.initialized) { ret err[io_error.Error].err{failure(os.EINVAL, io_error.OP_CLOSE)}; }
    val result: i64 = platform.unmap_file(mapping.data, mapping.length);
    if (result < 0) { ret err[io_error.Error].err{failure(result, io_error.OP_CLOSE)}; }
    mapping.data = nil;
    mapping.length = 0;
    mapping.initialized = false;
    ret err[io_error.Error].ok{};
}

pub rec TransferReport {
    bytes:       usize;
    end_of_file: bool;
    accelerated: bool;
}

# the portable transfer uses fixed stack storage and preserves both file offsets
pub fun transfer(source: filesystem.File, destination: filesystem.File, source_offset: u64, destination_offset: u64, length: usize) res[TransferReport, io_error.Error] {
    if (!span_valid(source_offset, length) || !span_valid(destination_offset, length)) {
        ret res[TransferReport, io_error.Error].err{failure(os.EINVAL, io_error.OP_OPTION)};
    }
    var buffer: [16384]u8;
    var transferred: usize = 0;
    var eof: bool = false;
    for (transferred < length && !eof) {
        var chunk: usize = length - transferred;
        if (chunk > 16384) { chunk = 16384; }
        val read_result: res[usize, io_error.Error] = read_at(source, (?buffer)::*u8, chunk, source_offset + transferred::u64);
        if (sel read_result.err) { ret res[TransferReport, io_error.Error].err{read_result.err}; }
        val read_count: usize = read_result.ok;
        if (read_count == 0) { eof = true; }
        var written: usize = 0;
        for (written < read_count) {
            val write_result: res[usize, io_error.Error] = write_at(destination, ((?buffer)::usize + written)::*u8, read_count - written, destination_offset + transferred::u64 + written::u64);
            if (sel write_result.err) { ret res[TransferReport, io_error.Error].err{write_result.err}; }
            val count: usize = write_result.ok;
            if (count == 0) { ret res[TransferReport, io_error.Error].err{failure(os.EIO, io_error.OP_WRITE)}; }
            written = written + count;
        }
        transferred = transferred + read_count;
    }
    ret res[TransferReport, io_error.Error].ok{TransferReport{bytes: transferred, end_of_file: eof, accelerated: false}};
}

pub rec WatchCapabilities {
    supported:     bool;
    recursive:     bool;
    native:        bool;
    requires_scan: bool;
}

pub fun watch_capabilities() WatchCapabilities {
    ret WatchCapabilities{supported: true, recursive: false, native: false, requires_scan: true};
}

pub def WatchEvent: u8;
pub val WATCH_UNCHANGED: WatchEvent = 0;
pub val WATCH_CREATED:   WatchEvent = 1;
pub val WATCH_REMOVED:   WatchEvent = 2;
pub val WATCH_REPLACED:  WatchEvent = 3;
pub val WATCH_MODIFIED:  WatchEvent = 4;
pub val WATCH_METADATA:  WatchEvent = 5;

pub rec Watch {
    root:        *Root;
    path:        Path;
    metadata:    filesystem.Metadata;
    identity:    filesystem.Identity;
    exists:      bool;
    initialized: bool;
}

fun watch_observe(root: *Root, path: Path, metadata: *filesystem.Metadata, identity: *filesystem.Identity) res[bool, io_error.Error] {
    val opened: res[filesystem.File, io_error.Error] = open_confined(root, path, read_options());
    if (sel opened.err) {
        if (opened.err.code == os.ENOENT) { ret res[bool, io_error.Error].ok{false}; }
        ret res[bool, io_error.Error].err{opened.err};
    }
    var file: filesystem.File = opened.ok;
    val observed: res[filesystem.Metadata, io_error.Error] = filesystem.stat_of(file);
    val identified: res[filesystem.Identity, io_error.Error] = filesystem.identity_of(file);
    val closed: err[io_error.Error] = filesystem.close(?file);
    if (sel observed.err) { ret res[bool, io_error.Error].err{observed.err}; }
    if (sel closed.err) { ret res[bool, io_error.Error].err{closed.err}; }
    if (sel identified.err) { ret res[bool, io_error.Error].err{identified.err}; }
    @identity = identified.ok;
    @metadata = observed.ok;
    ret res[bool, io_error.Error].ok{true};
}

# the root and path remain borrowed until watch_close
pub fun watch_open(watch: *Watch, root: *Root, path: Path) res[bool, io_error.Error] {
    if (watch == nil || root == nil || path == nil) {
        ret res[bool, io_error.Error].err{failure(os.EINVAL, io_error.OP_OPEN)};
    }
    var metadata: filesystem.Metadata;
    var identity: filesystem.Identity;
    val observed: res[bool, io_error.Error] = watch_observe(root, path, ?metadata, ?identity);
    if (sel observed.err) { ret res[bool, io_error.Error].err{observed.err}; }
    watch.root = root;
    watch.path = path;
    watch.exists = observed.ok;
    if (watch.exists) { watch.metadata = metadata; watch.identity = identity; }
    watch.initialized = true;
    ret res[bool, io_error.Error].ok{watch.exists};
}

# scans observe identity without pinning it between calls or detecting every intervening write
pub fun watch_scan(watch: *Watch) res[WatchEvent, io_error.Error] {
    if (watch == nil || !watch.initialized) { ret res[WatchEvent, io_error.Error].err{failure(os.EINVAL, io_error.OP_WAIT)}; }
    var metadata: filesystem.Metadata;
    var identity: filesystem.Identity;
    val observed: res[bool, io_error.Error] = watch_observe(watch.root, watch.path, ?metadata, ?identity);
    if (sel observed.err) { ret res[WatchEvent, io_error.Error].err{observed.err}; }
    val exists: bool = observed.ok;
    if (!watch.exists && !exists) { ret res[WatchEvent, io_error.Error].ok{WATCH_UNCHANGED}; }
    if (!watch.exists && exists) {
        watch.metadata = metadata;
        watch.identity = identity;
        watch.exists = true;
        ret res[WatchEvent, io_error.Error].ok{WATCH_CREATED};
    }
    if (watch.exists && !exists) {
        watch.exists = false;
        ret res[WatchEvent, io_error.Error].ok{WATCH_REMOVED};
    }
    var event: WatchEvent = WATCH_UNCHANGED;
    if (!filesystem.identity_equal(watch.identity, identity)) { event = WATCH_REPLACED; }
    or (watch.metadata.size != metadata.size || !time.time_equal(watch.metadata.modified, metadata.modified)) { event = WATCH_MODIFIED; }
    or (watch.metadata.kind != metadata.kind || watch.metadata.mode != metadata.mode) { event = WATCH_METADATA; }
    watch.metadata = metadata;
    watch.identity = identity;
    ret res[WatchEvent, io_error.Error].ok{event};
}

# releases the borrowed root and path; a watch that was never opened is INVALID
pub fun watch_close(watch: *Watch) err[io_error.Error] {
    if (watch == nil || !watch.initialized) { ret err[io_error.Error].err{failure(os.EINVAL, io_error.OP_CLOSE)}; }
    watch.root = nil;
    watch.path = nil;
    watch.exists = false;
    watch.initialized = false;
    ret err[io_error.Error].ok{};
}
