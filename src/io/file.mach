# bounded asynchronous and handle-relative file operations

use R: std.types.result;
use O: std.types.option;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.path.Path;
use std.chrono.time;
use std.filesystem;
use std.memory;
use std.system.os;
use std.system.panic;
use std.sync.atomic;
use std.sync.cancel;
use std.sync.condition;
use std.sync.mutex;
use std.sync.thread;
use std.sync.worker_pool;
use io_error: std.io.error;
use io_handle: std.io.handle;
use io_runtime: std.io.runtime;

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    use posix: std.io.file.posix;
}

pub def Access: u8;
pub val READ_ONLY:  Access = 0;
pub val WRITE_ONLY: Access = 1;
pub val READ_WRITE: Access = 2;

pub rec OpenOptions {
    access:    Access;
    create:    bool;
    exclusive: bool;
    truncate:  bool;
    directory: bool;
    mode:      i32;
}

pub fun read_options() OpenOptions {
    ret OpenOptions{access: READ_ONLY, create: false, exclusive: false, truncate: false, directory: false, mode: 0};
}

pub fun write_options(mode: i32) OpenOptions {
    ret OpenOptions{access: WRITE_ONLY, create: true, exclusive: false, truncate: false, directory: false, mode: mode};
}

pub rec Root {
    directory:   filesystem.File;
    identity:    filesystem.Identity;
    active:      usize;
    initialized: bool;
    closing:     bool;
    lock:        mutex.Mutex;
    idle:        condition.Condition;
}

pub rec Capabilities {
    positioned_io:       bool;
    native_async:        bool;
    bounded_workers:     bool;
    confined_open:       bool;
    mapping:             bool;
    watching:            bool;
    accelerated_transfer: bool;
}

pub fun capabilities() Capabilities {
    $if ($mach.build.os == $mach.os.windows) {
        ret Capabilities{
            positioned_io: false,
            native_async: false,
            bounded_workers: false,
            confined_open: false,
            mapping: false,
            watching: false,
            accelerated_transfer: false,
        };
    }
    $or {
        ret Capabilities{
            positioned_io: true,
            native_async: false,
            bounded_workers: true,
            confined_open: true,
            mapping: true,
            watching: true,
            accelerated_transfer: false,
        };
    }
}

fun failure(code: i64, operation: io_error.Operation) io_error.Error {
    ret io_error.from_code(code, operation);
}

fun unsupported(operation: io_error.Operation) io_error.Error {
    ret failure(os.ENOTSUP, operation);
}

fun options_valid(options: OpenOptions) bool {
    if (options.access > READ_WRITE) { ret false; }
    if (options.directory && (options.create || options.truncate || options.access != READ_ONLY)) { ret false; }
    if (options.exclusive && !options.create) { ret false; }
    ret true;
}

fun options_flags(options: OpenOptions) i32 {
    var flags: i32 = os.O_RDONLY;
    if (options.access == WRITE_ONLY) { flags = os.O_WRONLY; }
    or (options.access == READ_WRITE) { flags = os.O_RDWR; }
    if (options.create) { flags = flags | os.O_CREAT; }
    if (options.exclusive) { flags = flags | os.O_EXCL; }
    if (options.truncate) { flags = flags | os.O_TRUNC; }
    if (options.directory) { flags = flags | os.O_DIRECTORY; }
    ret flags;
}

# the root path is trusted once and every later resolution starts from its handle
pub fun root_open(path: Path) R.Result[Root, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        ret R.err[Root, io_error.Error](unsupported(io_error.OP_OPEN));
    }
    $or {
        if (path == nil) { ret R.err[Root, io_error.Error](failure(os.EINVAL, io_error.OP_OPEN)); }
        val raw: i64 = posix.open_root(path::*u8);
        if (raw < 0) { ret R.err[Root, io_error.Error](failure(raw, io_error.OP_OPEN)); }
        var directory: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: raw::usize}};
        val metadata: R.Result[filesystem.Metadata, io_error.Error] = filesystem.stat_of_error(directory);
        if (R.is_err[filesystem.Metadata, io_error.Error](metadata)) {
            filesystem.close(?directory);
            ret R.err[Root, io_error.Error](R.unwrap_err[filesystem.Metadata, io_error.Error](metadata));
        }
        val value: filesystem.Metadata = R.unwrap_ok[filesystem.Metadata, io_error.Error](metadata);
        ret R.ok[Root, io_error.Error](Root{
            directory: directory,
            identity: value.identity,
            active: 0,
            initialized: true,
            closing: false,
            lock: mutex.make(),
            idle: condition.make(),
        });
    }
}

fun root_enter(root: *Root) bool {
    if (root == nil) { ret false; }
    mutex.lock(?root.lock);
    if (!root.initialized || root.closing) {
        mutex.unlock(?root.lock);
        ret false;
    }
    root.active = root.active + 1;
    mutex.unlock(?root.lock);
    ret true;
}

fun root_leave(root: *Root) {
    mutex.lock(?root.lock);
    root.active = root.active - 1;
    if (root.active == 0) { condition.broadcast(?root.idle); }
    mutex.unlock(?root.lock);
}

# close rejects new resolution and waits for admitted handle-relative work
pub fun root_close(root: *Root) R.Result[bool, io_error.Error] {
    if (root == nil) { ret R.err[bool, io_error.Error](failure(os.EBADF, io_error.OP_CLOSE)); }
    mutex.lock(?root.lock);
    if (!root.initialized || root.closing) {
        mutex.unlock(?root.lock);
        ret R.err[bool, io_error.Error](failure(os.EBADF, io_error.OP_CLOSE));
    }
    root.closing = true;
    for (root.active != 0) { condition.wait(?root.idle, ?root.lock); }
    val closed: O.Option[io_error.Error] = filesystem.close(?root.directory);
    root.initialized = false;
    root.closing = false;
    mutex.unlock(?root.lock);
    if (O.is_some[io_error.Error](closed)) { ret R.err[bool, io_error.Error](O.unwrap[io_error.Error](closed)); }
    ret R.ok[bool, io_error.Error](true);
}

# relative components are opened one at a time from pinned directory handles
pub fun open_confined(root: *Root, path: Path, options: OpenOptions) R.Result[filesystem.File, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        ret R.err[filesystem.File, io_error.Error](unsupported(io_error.OP_OPEN));
    }
    $or {
        if (root == nil || path == nil || !options_valid(options)) {
            ret R.err[filesystem.File, io_error.Error](failure(os.EINVAL, io_error.OP_OPEN));
        }
        if (!root_enter(root)) { ret R.err[filesystem.File, io_error.Error](failure(os.EBADF, io_error.OP_OPEN)); }
        val raw: i64 = posix.open_confined(root.directory.handle.value::i32, path::*u8, options_flags(options), options.mode);
        root_leave(root);
        if (raw < 0) { ret R.err[filesystem.File, io_error.Error](failure(raw, io_error.OP_OPEN)); }
        ret R.ok[filesystem.File, io_error.Error](filesystem.File{handle: io_handle.FileHandle{value: raw::usize}});
    }
}

# the temporary is synced before its namespace entry atomically replaces destination
pub fun replace_confined(root: *Root, temporary: Path, destination: Path) R.Result[bool, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        ret R.err[bool, io_error.Error](unsupported(io_error.OP_OPTION));
    }
    $or {
        if (root == nil || temporary == nil || destination == nil || !root_enter(root)) {
            ret R.err[bool, io_error.Error](failure(os.EBADF, io_error.OP_OPTION));
        }
        val raw: i64 = posix.open_confined(root.directory.handle.value::i32, temporary::*u8, options_flags(read_options()), 0);
        if (raw < 0) {
            root_leave(root);
            ret R.err[bool, io_error.Error](failure(raw, io_error.OP_OPEN));
        }
        var file: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: raw::usize}};
        val synced: O.Option[io_error.Error] = filesystem.sync(file);
        val closed: O.Option[io_error.Error] = filesystem.close(?file);
        if (O.is_some[io_error.Error](synced)) {
            root_leave(root);
            ret R.err[bool, io_error.Error](O.unwrap[io_error.Error](synced));
        }
        if (O.is_some[io_error.Error](closed)) {
            root_leave(root);
            ret R.err[bool, io_error.Error](O.unwrap[io_error.Error](closed));
        }
        val result: i64 = posix.rename_confined(root.directory.handle.value::i32, temporary::*u8, destination::*u8);
        root_leave(root);
        if (result < 0) { ret R.err[bool, io_error.Error](failure(result, io_error.OP_OPTION)); }
        ret R.ok[bool, io_error.Error](true);
    }
}

pub fun read_at(file: filesystem.File, buffer: *u8, length: usize, offset: u64) R.Result[usize, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        ret R.err[usize, io_error.Error](unsupported(io_error.OP_READ));
    }
    $or {
        if (!io_handle.file_is_valid(file.handle) || (buffer == nil && length != 0)) { ret R.err[usize, io_error.Error](failure(os.EINVAL, io_error.OP_READ)); }
        val result: i64 = posix.read_at(file.handle.value::i32, buffer, length, offset);
        if (result < 0) { ret R.err[usize, io_error.Error](failure(result, io_error.OP_READ)); }
        ret R.ok[usize, io_error.Error](result::usize);
    }
}

pub fun write_at(file: filesystem.File, buffer: *u8, length: usize, offset: u64) R.Result[usize, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        ret R.err[usize, io_error.Error](unsupported(io_error.OP_WRITE));
    }
    $or {
        if (!io_handle.file_is_valid(file.handle) || (buffer == nil && length != 0)) { ret R.err[usize, io_error.Error](failure(os.EINVAL, io_error.OP_WRITE)); }
        val result: i64 = posix.write_at(file.handle.value::i32, buffer, length, offset);
        if (result < 0) { ret R.err[usize, io_error.Error](failure(result, io_error.OP_WRITE)); }
        ret R.ok[usize, io_error.Error](result::usize);
    }
}

val REQUEST_FREE:      i64 = 0;
val REQUEST_QUEUED:    i64 = 1;
val REQUEST_RUNNING:   i64 = 2;
val REQUEST_CANCELLED: i64 = 3;
val REQUEST_ABORTED:   i64 = 4;

val ADAPTER_OPEN:     u8 = 0;
val ADAPTER_DRAINING: u8 = 1;
val ADAPTER_ABORTING: u8 = 2;
val ADAPTER_JOINED:   u8 = 3;

pub rec Request {
    adapter:             *Adapter;
    state:               i64;
    kind:                io_runtime.Kind;
    file:                filesystem.File;
    length:              usize;
    offset:              u64;
    scratch:             *u8;
    scope:               *cancel.Scope;
    token:               io_runtime.Token;
    cancellation:        cancel.Registration;
    cancellation_active: bool;
    cancel_done:         i64;
    cancel_reason:       i64;
}

# request, task, abort, worker, thread, and scratch storage are caller-owned
pub rec Adapter {
    runtime:          *io_runtime.Runtime;
    requests:         *Request;
    request_capacity: usize;
    scratch:          *u8;
    scratch_length:   usize;
    max_transfer:     usize;
    tasks:            *worker_pool.Task;
    abort_tasks:      *worker_pool.Task;
    threads:          *thread.Thread;
    workers:          *worker_pool.Worker;
    worker_count:     usize;
    pool:             worker_pool.Pool;
    next_request:     usize;
    active:           usize;
    state:            u8;
    initialized:      bool;
    lock:             mutex.Mutex;
}

fun cancel_error(reason: cancel.Reason, operation: io_error.Operation) io_error.Error {
    if (reason == cancel.TIMED_OUT) { ret failure(os.ETIMEDOUT, operation); }
    ret failure(os.ECANCELED, operation);
}

fun request_cancel(context: ptr, reason: cancel.Reason) {
    val request: *Request = context::*Request;
    atomic.store(?request.cancel_reason, reason);
    var expected: i64 = REQUEST_QUEUED;
    atomic.cas(?request.state, ?expected, REQUEST_CANCELLED);
}

fun request_cancel_complete(context: ptr, reason: cancel.Reason) {
    val request: *Request = context::*Request;
    val lock: *mutex.Mutex = ?request.adapter.lock;
    val registration: *cancel.Registration = ?request.cancellation;
    val done: *i64 = ?request.cancel_done;
    mutex.lock(lock);
    atomic.store(done, 1);
    os.thread_wake(done);
    val finished: bool = cancel.finish(registration);
    mutex.unlock(lock);
    if (!finished) { panic.panic("std.io.file: cancellation completion lost ownership\n"); }
}

fun detach_cancellation(request: *Request) {
    if (!request.cancellation_active) { ret; }
    if (!cancel.unregister(?request.cancellation)) {
        for (atomic.load(?request.cancel_done) == 0) { os.thread_wait(?request.cancel_done, 0); }
        mutex.lock(?request.adapter.lock);
        mutex.unlock(?request.adapter.lock);
    }
    request.cancellation_active = false;
}

fun release_request(request: *Request) {
    val adapter: *Adapter = request.adapter;
    mutex.lock(?adapter.lock);
    request.state = REQUEST_FREE;
    request.scope = nil;
    adapter.active = adapter.active - 1;
    mutex.unlock(?adapter.lock);
}

fun request_operation(request: *Request) io_error.Operation {
    if (request.kind == io_runtime.FILE_READ) { ret io_error.OP_READ; }
    ret io_error.OP_WRITE;
}

fun publish_cancelled(request: *Request) {
    val reason: cancel.Reason = atomic.load(?request.cancel_reason)::cancel.Reason;
    io_runtime.fail(request.adapter.runtime, request.token, cancel_error(reason, request_operation(request)));
}

fun execute_request(context: ptr) bool {
    val request: *Request = context::*Request;
    cancel.expire(request.scope, time.monotonic());
    var expected: i64 = REQUEST_QUEUED;
    if (!atomic.cas(?request.state, ?expected, REQUEST_RUNNING)) {
        detach_cancellation(request);
        if (expected == REQUEST_CANCELLED) { publish_cancelled(request); }
        or { io_runtime.fail(request.adapter.runtime, request.token, failure(os.ECANCELED, request_operation(request))); }
        release_request(request);
        ret true;
    }

    detach_cancellation(request);
    var result: i64 = os.ENOTSUP;
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        if (request.kind == io_runtime.FILE_READ) {
            result = posix.read_at(request.file.handle.value::i32, request.scratch, request.length, request.offset);
        }
        or {
            result = posix.write_at(request.file.handle.value::i32, request.scratch, request.length, request.offset);
        }
    }
    if (result < 0) {
        io_runtime.fail(request.adapter.runtime, request.token, failure(result, request_operation(request)));
    }
    or (request.kind == io_runtime.FILE_READ) {
        val count: usize = result::usize;
        io_runtime.complete_copy(request.adapter.runtime, request.token, request.scratch, count, request.file.handle.value, count == 0 && request.length != 0);
    }
    or {
        io_runtime.complete(request.adapter.runtime, request.token, result::usize, request.file.handle.value, false);
    }
    release_request(request);
    ret true;
}

fun claim_request(adapter: *Adapter) *Request {
    if (adapter.active == adapter.request_capacity) { ret nil; }
    var scanned: usize = 0;
    var index: usize = adapter.next_request;
    for (scanned < adapter.request_capacity && atomic.load(?adapter.requests[index].state) != REQUEST_FREE) {
        index = (index + 1) % adapter.request_capacity;
        scanned = scanned + 1;
    }
    if (scanned == adapter.request_capacity) { ret nil; }
    adapter.next_request = (index + 1) % adapter.request_capacity;
    adapter.active = adapter.active + 1;
    ret ?adapter.requests[index];
}

pub fun make(
    adapter: *Adapter,
    runtime: *io_runtime.Runtime,
    requests: *Request,
    request_capacity: usize,
    scratch: *u8,
    scratch_length: usize,
    max_transfer: usize,
    tasks: *worker_pool.Task,
    abort_tasks: *worker_pool.Task,
    threads: *thread.Thread,
    workers: *worker_pool.Worker,
    worker_count: usize,
) R.Result[bool, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        ret R.err[bool, io_error.Error](unsupported(io_error.OP_CREATE));
    }
    $or {
        if (adapter == nil || runtime == nil || requests == nil || request_capacity == 0 || scratch == nil || max_transfer == 0 || tasks == nil || abort_tasks == nil || threads == nil || workers == nil || worker_count == 0) {
            ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_CREATE));
        }
        val required: usize = request_capacity * max_transfer;
        if (required / request_capacity != max_transfer || scratch_length < required) {
            ret R.err[bool, io_error.Error](failure(os.ENOMEM, io_error.OP_CREATE));
        }
        adapter.runtime = runtime;
        adapter.requests = requests;
        adapter.request_capacity = request_capacity;
        adapter.scratch = scratch;
        adapter.scratch_length = scratch_length;
        adapter.max_transfer = max_transfer;
        adapter.tasks = tasks;
        adapter.abort_tasks = abort_tasks;
        adapter.threads = threads;
        adapter.workers = workers;
        adapter.worker_count = worker_count;
        adapter.next_request = 0;
        adapter.active = 0;
        adapter.state = ADAPTER_OPEN;
        adapter.initialized = true;
        adapter.lock = mutex.make();
        var i: usize = 0;
        for (i < request_capacity) {
            adapter.requests[i].adapter = adapter;
            adapter.requests[i].state = REQUEST_FREE;
            adapter.requests[i].scratch = (scratch::usize + i * max_transfer)::*u8;
            adapter.requests[i].cancellation_active = false;
            adapter.requests[i].cancel_done = 0;
            cancel.init_registration(?adapter.requests[i].cancellation);
            i = i + 1;
        }
        val status: worker_pool.Status = worker_pool.make(?adapter.pool, tasks, request_capacity, threads, workers, worker_count);
        if (status != worker_pool.ACCEPTED) {
            if (worker_pool.state(?adapter.pool) == worker_pool.JOINED) { worker_pool.destroy(?adapter.pool); }
            adapter.initialized = false;
            ret R.err[bool, io_error.Error](failure(os.EAGAIN, io_error.OP_CREATE));
        }
        ret R.ok[bool, io_error.Error](true);
    }
}

fun submit_operation(adapter: *Adapter, scope: *cancel.Scope, file: *filesystem.File, buffer: *u8, length: usize, offset: u64, context: usize, kind: io_runtime.Kind) R.Result[io_runtime.Token, io_error.Error] {
    val operation_kind: io_error.Operation = io_error.OP_READ;
    var normalized_kind: io_error.Operation = operation_kind;
    if (kind == io_runtime.FILE_WRITE) { normalized_kind = io_error.OP_WRITE; }
    if (adapter == nil || scope == nil || file == nil || !io_handle.file_is_valid(file.handle) || (buffer == nil && length != 0)) {
        ret R.err[io_runtime.Token, io_error.Error](failure(os.EINVAL, normalized_kind));
    }
    mutex.lock(?adapter.lock);
    if (!adapter.initialized || adapter.state != ADAPTER_OPEN || length > adapter.max_transfer) {
        mutex.unlock(?adapter.lock);
        var code: i64 = os.ENOMEM;
        if (adapter.initialized && adapter.state != ADAPTER_OPEN) { code = os.EBADF; }
        ret R.err[io_runtime.Token, io_error.Error](failure(code, normalized_kind));
    }
    val request: *Request = claim_request(adapter);
    if (request == nil) {
        mutex.unlock(?adapter.lock);
        ret R.err[io_runtime.Token, io_error.Error](failure(os.ENOMEM, normalized_kind));
    }
    request.kind = kind;
    request.file = @file;
    request.length = length;
    request.offset = offset;
    request.scope = scope;
    request.cancel_done = 0;
    request.cancel_reason = cancel.ACTIVE;
    request.cancellation_active = false;
    cancel.init_registration(?request.cancellation);
    if (kind == io_runtime.FILE_WRITE && length > 0) { memory.raw_copy(request.scratch::ptr, buffer::ptr, length); }
    atomic.store(?request.state, REQUEST_QUEUED);
    val attached: cancel.Reason = cancel.attach_with_completion(scope, ?request.cancellation, request_cancel, request_cancel_complete, request::ptr);
    if (attached != cancel.ACTIVE) {
        request.state = REQUEST_FREE;
        request.scope = nil;
        adapter.active = adapter.active - 1;
        mutex.unlock(?adapter.lock);
        ret R.err[io_runtime.Token, io_error.Error](cancel_error(attached, normalized_kind));
    }
    request.cancellation_active = true;
    var runtime_buffer: *u8 = buffer;
    if (kind == io_runtime.FILE_WRITE) { runtime_buffer = nil; }
    val operation: io_runtime.Operation = io_runtime.Operation{
        kind: kind,
        resource: file.handle.value,
        buffer: runtime_buffer,
        length: length,
        offset: offset,
        context: context,
    };
    val submitted: R.Result[io_runtime.Token, io_error.Error] = io_runtime.submit(adapter.runtime, operation);
    if (R.is_err[io_runtime.Token, io_error.Error](submitted)) {
        mutex.unlock(?adapter.lock);
        detach_cancellation(request);
        release_request(request);
        ret R.err[io_runtime.Token, io_error.Error](R.unwrap_err[io_runtime.Token, io_error.Error](submitted));
    }
    request.token = R.unwrap_ok[io_runtime.Token, io_error.Error](submitted);
    val queued: worker_pool.Status = worker_pool.try_submit(?adapter.pool, worker_pool.Task{context: request::ptr, run: execute_request});
    if (queued != worker_pool.ACCEPTED) {
        io_runtime.fail(adapter.runtime, request.token, failure(os.EBUSY, io_error.OP_SUBMIT));
        mutex.unlock(?adapter.lock);
        detach_cancellation(request);
        release_request(request);
        ret R.ok[io_runtime.Token, io_error.Error](request.token);
    }
    val token: io_runtime.Token = request.token;
    mutex.unlock(?adapter.lock);
    ret R.ok[io_runtime.Token, io_error.Error](token);
}

# file handles and cancellation scopes remain borrowed until the request retires
# read buffers remain borrowed until their runtime completion is dequeued
pub fun submit_read(adapter: *Adapter, scope: *cancel.Scope, file: *filesystem.File, buffer: *u8, length: usize, offset: u64, context: usize) R.Result[io_runtime.Token, io_error.Error] {
    ret submit_operation(adapter, scope, file, buffer, length, offset, context, io_runtime.FILE_READ);
}

# write bytes are copied into bounded adapter storage before this call succeeds
pub fun submit_write(adapter: *Adapter, scope: *cancel.Scope, file: *filesystem.File, buffer: *u8, length: usize, offset: u64, context: usize) R.Result[io_runtime.Token, io_error.Error] {
    ret submit_operation(adapter, scope, file, buffer, length, offset, context, io_runtime.FILE_WRITE);
}

fun publish_aborted(request: *Request) {
    detach_cancellation(request);
    if (atomic.load(?request.state) == REQUEST_CANCELLED) { publish_cancelled(request); }
    or { io_runtime.fail(request.adapter.runtime, request.token, failure(os.ECANCELED, io_error.OP_SHUTDOWN)); }
    release_request(request);
}

pub fun shutdown_drain(adapter: *Adapter) R.Result[bool, io_error.Error] {
    if (adapter == nil) { ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_SHUTDOWN)); }
    mutex.lock(?adapter.lock);
    if (!adapter.initialized) {
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_SHUTDOWN));
    }
    if (adapter.state == ADAPTER_JOINED) {
        mutex.unlock(?adapter.lock);
        ret R.ok[bool, io_error.Error](false);
    }
    if (adapter.state != ADAPTER_OPEN) {
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](failure(os.EBUSY, io_error.OP_SHUTDOWN));
    }
    adapter.state = ADAPTER_DRAINING;
    val closing: worker_pool.Status = worker_pool.close_drain(?adapter.pool);
    mutex.unlock(?adapter.lock);
    if (closing != worker_pool.DRAINING) { ret R.err[bool, io_error.Error](failure(os.EIO, io_error.OP_SHUTDOWN)); }
    if (worker_pool.join(?adapter.pool) != worker_pool.JOINED) { ret R.err[bool, io_error.Error](failure(os.EIO, io_error.OP_SHUTDOWN)); }
    mutex.lock(?adapter.lock);
    adapter.state = ADAPTER_JOINED;
    mutex.unlock(?adapter.lock);
    ret R.ok[bool, io_error.Error](true);
}

pub fun shutdown_abort(adapter: *Adapter) R.Result[usize, io_error.Error] {
    if (adapter == nil) { ret R.err[usize, io_error.Error](failure(os.EINVAL, io_error.OP_SHUTDOWN)); }
    mutex.lock(?adapter.lock);
    if (!adapter.initialized) {
        mutex.unlock(?adapter.lock);
        ret R.err[usize, io_error.Error](failure(os.EINVAL, io_error.OP_SHUTDOWN));
    }
    if (adapter.state != ADAPTER_OPEN) {
        mutex.unlock(?adapter.lock);
        ret R.err[usize, io_error.Error](failure(os.EBUSY, io_error.OP_SHUTDOWN));
    }
    adapter.state = ADAPTER_ABORTING;
    var rejected: usize = 0;
    val closing: worker_pool.Status = worker_pool.close_abort(?adapter.pool, adapter.abort_tasks, adapter.request_capacity, ?rejected);
    if (closing != worker_pool.ABORTING) {
        mutex.unlock(?adapter.lock);
        ret R.err[usize, io_error.Error](failure(os.EIO, io_error.OP_SHUTDOWN));
    }
    var i: usize = 0;
    for (i < rejected) {
        val request: *Request = adapter.abort_tasks[i].context::*Request;
        var expected: i64 = REQUEST_QUEUED;
        atomic.cas(?request.state, ?expected, REQUEST_ABORTED);
        i = i + 1;
    }
    mutex.unlock(?adapter.lock);
    i = 0;
    for (i < rejected) {
        publish_aborted(adapter.abort_tasks[i].context::*Request);
        i = i + 1;
    }
    if (worker_pool.join(?adapter.pool) != worker_pool.JOINED) { ret R.err[usize, io_error.Error](failure(os.EIO, io_error.OP_SHUTDOWN)); }
    mutex.lock(?adapter.lock);
    adapter.state = ADAPTER_JOINED;
    mutex.unlock(?adapter.lock);
    ret R.ok[usize, io_error.Error](rejected);
}

pub fun active(adapter: *Adapter) usize {
    if (adapter == nil) { ret 0; }
    mutex.lock(?adapter.lock);
    var count: usize = 0;
    if (adapter.initialized) { count = adapter.active; }
    mutex.unlock(?adapter.lock);
    ret count;
}

pub fun destroy(adapter: *Adapter) R.Result[bool, io_error.Error] {
    if (adapter == nil) { ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_CLOSE)); }
    mutex.lock(?adapter.lock);
    if (!adapter.initialized) {
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_CLOSE));
    }
    if (adapter.state != ADAPTER_JOINED || adapter.active != 0) {
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](failure(os.EBUSY, io_error.OP_CLOSE));
    }
    if (!worker_pool.destroy(?adapter.pool)) {
        mutex.unlock(?adapter.lock);
        ret R.err[bool, io_error.Error](failure(os.EIO, io_error.OP_CLOSE));
    }
    adapter.runtime = nil;
    adapter.requests = nil;
    adapter.scratch = nil;
    adapter.tasks = nil;
    adapter.abort_tasks = nil;
    adapter.threads = nil;
    adapter.workers = nil;
    adapter.initialized = false;
    mutex.unlock(?adapter.lock);
    ret R.ok[bool, io_error.Error](true);
}

pub rec Mapping {
    data:        ptr;
    length:      usize;
    offset:      u64;
    writable:    bool;
    initialized: bool;
}

# mappings own their virtual region independently of the file handle
pub fun map(file: filesystem.File, offset: u64, length: usize, writable: bool) R.Result[Mapping, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        ret R.err[Mapping, io_error.Error](unsupported(io_error.OP_OPTION));
    }
    $or {
        if (!io_handle.file_is_valid(file.handle) || length == 0 || offset > (-1)::usize::u64 || offset::usize % os.page_size() != 0) {
            ret R.err[Mapping, io_error.Error](failure(os.EINVAL, io_error.OP_OPTION));
        }
        var protection: u32 = os.PROT_READ;
        if (writable) { protection = protection | os.PROT_WRITE; }
        val data: ptr = os.map_file(file.handle.value::i32, offset::usize, length, protection);
        if (data == nil) { ret R.err[Mapping, io_error.Error](failure(os.EIO, io_error.OP_OPTION)); }
        ret R.ok[Mapping, io_error.Error](Mapping{data: data, length: length, offset: offset, writable: writable, initialized: true});
    }
}

pub fun mapping_sync(mapping: *Mapping) R.Result[bool, io_error.Error] {
    if (mapping == nil || !mapping.initialized || !mapping.writable) { ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_SYNC)); }
    val result: i64 = os.sync_file(mapping.data, mapping.length);
    if (result < 0) { ret R.err[bool, io_error.Error](failure(result, io_error.OP_SYNC)); }
    ret R.ok[bool, io_error.Error](true);
}

pub fun mapping_close(mapping: *Mapping) R.Result[bool, io_error.Error] {
    if (mapping == nil || !mapping.initialized) { ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_CLOSE)); }
    val result: i64 = os.deallocate(mapping.data, mapping.length);
    mapping.data = nil;
    mapping.length = 0;
    mapping.initialized = false;
    if (result < 0) { ret R.err[bool, io_error.Error](failure(result, io_error.OP_CLOSE)); }
    ret R.ok[bool, io_error.Error](true);
}

pub rec TransferReport {
    bytes:       usize;
    end_of_file: bool;
    accelerated: bool;
}

# the portable transfer uses fixed stack storage and preserves both file offsets
pub fun transfer(source: filesystem.File, destination: filesystem.File, source_offset: u64, destination_offset: u64, length: usize) R.Result[TransferReport, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        ret R.err[TransferReport, io_error.Error](unsupported(io_error.OP_WRITE));
    }
    $or {
        var buffer: [16384]u8;
        var transferred: usize = 0;
        var eof: bool = false;
        for (transferred < length && !eof) {
            var chunk: usize = length - transferred;
            if (chunk > 16384) { chunk = 16384; }
            val read_result: R.Result[usize, io_error.Error] = read_at(source, (?buffer)::*u8, chunk, source_offset + transferred::u64);
            if (R.is_err[usize, io_error.Error](read_result)) { ret R.err[TransferReport, io_error.Error](R.unwrap_err[usize, io_error.Error](read_result)); }
            val read_count: usize = R.unwrap_ok[usize, io_error.Error](read_result);
            if (read_count == 0) { eof = true; }
            var written: usize = 0;
            for (written < read_count) {
                val write_result: R.Result[usize, io_error.Error] = write_at(destination, ((?buffer)::usize + written)::*u8, read_count - written, destination_offset + transferred::u64 + written::u64);
                if (R.is_err[usize, io_error.Error](write_result)) { ret R.err[TransferReport, io_error.Error](R.unwrap_err[usize, io_error.Error](write_result)); }
                val count: usize = R.unwrap_ok[usize, io_error.Error](write_result);
                if (count == 0) { ret R.err[TransferReport, io_error.Error](failure(os.EIO, io_error.OP_WRITE)); }
                written = written + count;
            }
            transferred = transferred + read_count;
            if (read_count < chunk) { eof = true; }
        }
        ret R.ok[TransferReport, io_error.Error](TransferReport{bytes: transferred, end_of_file: eof, accelerated: false});
    }
}

pub rec WatchCapabilities {
    supported:     bool;
    recursive:     bool;
    native:        bool;
    requires_scan: bool;
}

pub fun watch_capabilities() WatchCapabilities {
    $if ($mach.build.os == $mach.os.windows) {
        ret WatchCapabilities{supported: false, recursive: false, native: false, requires_scan: false};
    }
    $or {
        ret WatchCapabilities{supported: true, recursive: false, native: false, requires_scan: true};
    }
}

pub def WatchEvent: u8;
pub val WATCH_UNCHANGED: WatchEvent = 0;
pub val WATCH_CREATED:   WatchEvent = 1;
pub val WATCH_REMOVED:   WatchEvent = 2;
pub val WATCH_REPLACED:  WatchEvent = 3;
pub val WATCH_MODIFIED:  WatchEvent = 4;
pub val WATCH_METADATA:  WatchEvent = 5;

pub rec Watch {
    root:        *Root;
    path:        Path;
    metadata:    filesystem.Metadata;
    exists:      bool;
    initialized: bool;
}

fun watch_observe(root: *Root, path: Path, metadata: *filesystem.Metadata) R.Result[bool, io_error.Error] {
    val opened: R.Result[filesystem.File, io_error.Error] = open_confined(root, path, read_options());
    if (R.is_err[filesystem.File, io_error.Error](opened)) {
        val open_error: io_error.Error = R.unwrap_err[filesystem.File, io_error.Error](opened);
        if (open_error.code == os.ENOENT) { ret R.ok[bool, io_error.Error](false); }
        ret R.err[bool, io_error.Error](open_error);
    }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](opened);
    val observed: R.Result[filesystem.Metadata, io_error.Error] = filesystem.stat_of_error(file);
    val closed: O.Option[io_error.Error] = filesystem.close(?file);
    if (R.is_err[filesystem.Metadata, io_error.Error](observed)) {
        ret R.err[bool, io_error.Error](R.unwrap_err[filesystem.Metadata, io_error.Error](observed));
    }
    if (O.is_some[io_error.Error](closed)) { ret R.err[bool, io_error.Error](O.unwrap[io_error.Error](closed)); }
    @metadata = R.unwrap_ok[filesystem.Metadata, io_error.Error](observed);
    ret R.ok[bool, io_error.Error](true);
}

# the root and path remain borrowed until watch_close
pub fun watch_open(watch: *Watch, root: *Root, path: Path) R.Result[bool, io_error.Error] {
    if (watch == nil || root == nil || path == nil) {
        ret R.err[bool, io_error.Error](failure(os.EINVAL, io_error.OP_OPEN));
    }
    $if ($mach.build.os == $mach.os.windows) {
        ret R.err[bool, io_error.Error](unsupported(io_error.OP_OPEN));
    }
    $or {
        var metadata: filesystem.Metadata;
        val observed: R.Result[bool, io_error.Error] = watch_observe(root, path, ?metadata);
        if (R.is_err[bool, io_error.Error](observed)) { ret R.err[bool, io_error.Error](R.unwrap_err[bool, io_error.Error](observed)); }
        watch.root = root;
        watch.path = path;
        watch.exists = R.unwrap_ok[bool, io_error.Error](observed);
        if (watch.exists) { watch.metadata = metadata; }
        watch.initialized = true;
        ret R.ok[bool, io_error.Error](watch.exists);
    }
}

# scans are synchronous and may be scheduled through the bounded worker pool
pub fun watch_scan(watch: *Watch) R.Result[WatchEvent, io_error.Error] {
    if (watch == nil || !watch.initialized) { ret R.err[WatchEvent, io_error.Error](failure(os.EINVAL, io_error.OP_WAIT)); }
    var metadata: filesystem.Metadata;
    val observed: R.Result[bool, io_error.Error] = watch_observe(watch.root, watch.path, ?metadata);
    if (R.is_err[bool, io_error.Error](observed)) { ret R.err[WatchEvent, io_error.Error](R.unwrap_err[bool, io_error.Error](observed)); }
    val exists: bool = R.unwrap_ok[bool, io_error.Error](observed);
    if (!watch.exists && !exists) { ret R.ok[WatchEvent, io_error.Error](WATCH_UNCHANGED); }
    if (!watch.exists && exists) {
        watch.metadata = metadata;
        watch.exists = true;
        ret R.ok[WatchEvent, io_error.Error](WATCH_CREATED);
    }
    if (watch.exists && !exists) {
        watch.exists = false;
        ret R.ok[WatchEvent, io_error.Error](WATCH_REMOVED);
    }
    var event: WatchEvent = WATCH_UNCHANGED;
    if (!filesystem.identity_equal(watch.metadata.identity, metadata.identity)) { event = WATCH_REPLACED; }
    or (watch.metadata.size != metadata.size || !time.time_equal(watch.metadata.modified, metadata.modified)) { event = WATCH_MODIFIED; }
    or (watch.metadata.kind != metadata.kind || watch.metadata.mode != metadata.mode) { event = WATCH_METADATA; }
    watch.metadata = metadata;
    ret R.ok[WatchEvent, io_error.Error](event);
}

pub fun watch_close(watch: *Watch) bool {
    if (watch == nil || !watch.initialized) { ret false; }
    watch.root = nil;
    watch.path = nil;
    watch.exists = false;
    watch.initialized = false;
    ret true;
}

fun bytes_equal(data: *u8, expected: *u8, length: usize) bool {
    var i: usize = 0;
    for (i < length) {
        if (data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun cleanup_file(path: Path) {
    filesystem.remove_file(path);
}

fun cleanup_dir(path: Path) {
    filesystem.remove_dir(path);
}

rec RenameRace {
    source:  Path;
    moved:   Path;
    started: *i64;
    failed:  *i64;
}

fun rename_race_worker(arg: *u8) {
    val race: *RenameRace = arg::*RenameRace;
    atomic.store(race.started, 1);
    os.thread_wake(race.started);
    var i: usize = 0;
    for (i < 128) {
        if (O.is_some[str](filesystem.rename(race.source, race.moved)) || O.is_some[str](filesystem.rename(race.moved, race.source))) {
            atomic.store(race.failed, 1);
            ret;
        }
        i = i + 1;
    }
}

test "io.file: positioned reads preserve offset and distinguish eof" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val path: Path = "mach-std-io-file-positioned";
    cleanup_file(path);
    if (O.is_some[str](filesystem.write_bytes(path, "abcdef", 6, 0o600))) { ret 1; }
    val opened: R.Result[filesystem.File, io_error.Error] = filesystem.open(path);
    if (R.is_err[filesystem.File, io_error.Error](opened)) { cleanup_file(path); ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](opened);
    var data: [3]u8;
    val first: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 3, 2);
    if (R.is_err[usize, io_error.Error](first) || R.unwrap_ok[usize, io_error.Error](first) != 3 || !bytes_equal((?data)::*u8, "cde"::*u8, 3)) { ret 3; }
    if (R.is_err[i64, io_error.Error](filesystem.seek(file, 0, os.SEEK_CUR)) || R.unwrap_ok[i64, io_error.Error](filesystem.seek(file, 0, os.SEEK_CUR)) != 0) { ret 4; }
    var short_data: [4]u8;
    val short: R.Result[usize, io_error.Error] = read_at(file, (?short_data)::*u8, 4, 4);
    if (R.is_err[usize, io_error.Error](short) || R.unwrap_ok[usize, io_error.Error](short) != 2 || !bytes_equal((?short_data)::*u8, "ef"::*u8, 2)) { ret 5; }
    val eof: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 3, 20);
    filesystem.close(?file);
    if (R.is_err[usize, io_error.Error](eof) || R.unwrap_ok[usize, io_error.Error](eof) != 0) { ret 6; }
    val root_result: R.Result[Root, io_error.Error] = root_open(".");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 7; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var truncate_options: OpenOptions = read_options();
    truncate_options.access = READ_WRITE;
    truncate_options.truncate = true;
    val truncated: R.Result[filesystem.File, io_error.Error] = open_confined(?root, path, truncate_options);
    if (R.is_err[filesystem.File, io_error.Error](truncated)) { ret 8; }
    var truncated_file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](truncated);
    val metadata: R.Result[filesystem.Metadata, io_error.Error] = filesystem.stat_of_error(truncated_file);
    filesystem.close(?truncated_file);
    root_close(?root);
    cleanup_file(path);
    if (R.is_err[filesystem.Metadata, io_error.Error](metadata) || R.unwrap_ok[filesystem.Metadata, io_error.Error](metadata).size != 0) { ret 9; }
    ret 0;
}

test "io.file: confined roots reject traversal and links after rename" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val root_path: Path = "mach-std-io-file-root";
    val moved_path: Path = "mach-std-io-file-root-moved";
    val inside_path: Path = "mach-std-io-file-root/inside";
    val moved_inside: Path = "mach-std-io-file-root-moved/inside";
    val outside_path: Path = "mach-std-io-file-outside";
    val outside_dir: Path = "mach-std-io-file-outside-dir";
    val outside_secret: Path = "mach-std-io-file-outside-dir/secret";
    val link_path: Path = "mach-std-io-file-root/link";
    val link_dir: Path = "mach-std-io-file-root/link-dir";
    val moved_link: Path = "mach-std-io-file-root-moved/link";
    val moved_link_dir: Path = "mach-std-io-file-root-moved/link-dir";
    cleanup_file(link_path);
    cleanup_file(link_dir);
    cleanup_file(moved_link);
    cleanup_file(moved_link_dir);
    cleanup_file(inside_path);
    cleanup_file(moved_inside);
    cleanup_file(outside_path);
    cleanup_file(outside_secret);
    cleanup_dir(outside_dir);
    cleanup_dir(root_path);
    cleanup_dir(moved_path);
    if (O.is_some[str](filesystem.create_dir(root_path, 0o700)) || O.is_some[str](filesystem.create_dir(outside_dir, 0o700)) || O.is_some[str](filesystem.write_bytes(inside_path, "inside", 6, 0o600)) || O.is_some[str](filesystem.write_bytes(outside_path, "outside", 7, 0o600)) || O.is_some[str](filesystem.write_bytes(outside_secret, "secret", 6, 0o600))) { ret 1; }
    val root_result: R.Result[Root, io_error.Error] = root_open(root_path);
    if (R.is_err[Root, io_error.Error](root_result)) { ret 2; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    if (!R.is_err[filesystem.File, io_error.Error](open_confined(?root, "../mach-std-io-file-outside", read_options()))) { ret 3; }
    if (O.is_some[str](filesystem.symlink("../mach-std-io-file-outside", link_path))) { ret 4; }
    if (!R.is_err[filesystem.File, io_error.Error](open_confined(?root, "link", read_options()))) { ret 5; }
    if (O.is_some[str](filesystem.symlink("../mach-std-io-file-outside-dir", link_dir)) || !R.is_err[filesystem.File, io_error.Error](open_confined(?root, "link-dir/secret", read_options()))) { ret 6; }

    var started: i64 = 0;
    var failed: i64 = 0;
    var race: RenameRace = RenameRace{source: root_path, moved: moved_path, started: ?started, failed: ?failed};
    var race_thread: thread.Thread;
    thread.spawn_with(rename_race_worker, (?race)::*u8, ?race_thread);
    if (race_thread.tid < 0) { ret 7; }
    for (atomic.load(?started) == 0) { os.thread_wait(?started, 0); }
    var round: usize = 0;
    var observed_failure: i64 = 0;
    for (round < 128 && observed_failure == 0) {
        val raced: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "inside", read_options());
        if (R.is_err[filesystem.File, io_error.Error](raced)) { observed_failure = 8; }
        or {
            var raced_file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](raced);
            var raced_data: [6]u8;
            val raced_read: R.Result[usize, io_error.Error] = read_at(raced_file, (?raced_data)::*u8, 6, 0);
            filesystem.close(?raced_file);
            if (R.is_err[usize, io_error.Error](raced_read) || !bytes_equal((?raced_data)::*u8, "inside"::*u8, 6)) { observed_failure = 9; }
        }
        round = round + 1;
    }
    thread.join(?race_thread);
    if (observed_failure != 0) { ret observed_failure::i32; }
    if (atomic.load(?failed) != 0) { ret 10; }
    if (O.is_some[str](filesystem.rename(root_path, moved_path)) || O.is_some[str](filesystem.create_dir(root_path, 0o700)) || O.is_some[str](filesystem.write_bytes(inside_path, "wrong", 5, 0o600))) { ret 11; }
    val confined: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "inside", read_options());
    if (R.is_err[filesystem.File, io_error.Error](confined)) { ret 12; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](confined);
    val before: R.Result[filesystem.Metadata, io_error.Error] = filesystem.stat_of_error(file);
    cleanup_file(moved_inside);
    val after: R.Result[filesystem.Metadata, io_error.Error] = filesystem.stat_of_error(file);
    var data: [6]u8;
    val read_result: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 6, 0);
    filesystem.close(?file);
    if (R.is_err[filesystem.Metadata, io_error.Error](before) || R.is_err[filesystem.Metadata, io_error.Error](after) || !filesystem.identity_equal(R.unwrap_ok[filesystem.Metadata, io_error.Error](before).identity, R.unwrap_ok[filesystem.Metadata, io_error.Error](after).identity)) { ret 13; }
    if (R.is_err[usize, io_error.Error](read_result) || R.unwrap_ok[usize, io_error.Error](read_result) != 6 || !bytes_equal((?data)::*u8, "inside"::*u8, 6)) { ret 14; }
    root_close(?root);
    cleanup_file(link_path);
    cleanup_file(link_dir);
    cleanup_file(moved_link);
    cleanup_file(moved_link_dir);
    cleanup_file(inside_path);
    cleanup_file(outside_path);
    cleanup_file(outside_secret);
    cleanup_dir(outside_dir);
    cleanup_dir(root_path);
    cleanup_dir(moved_path);
    ret 0;
}

test "io.file: confined replacement is atomic and durable" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val root_path: Path = "mach-std-io-file-replace-root";
    val temporary_path: Path = "mach-std-io-file-replace-root/new";
    val destination_path: Path = "mach-std-io-file-replace-root/current";
    cleanup_file(temporary_path);
    cleanup_file(destination_path);
    cleanup_dir(root_path);
    if (O.is_some[str](filesystem.create_dir(root_path, 0o700)) || O.is_some[str](filesystem.write_bytes(temporary_path, "new", 3, 0o600)) || O.is_some[str](filesystem.write_bytes(destination_path, "old", 3, 0o600))) { ret 1; }
    val root_result: R.Result[Root, io_error.Error] = root_open(root_path);
    if (R.is_err[Root, io_error.Error](root_result)) { ret 2; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    if (R.is_err[bool, io_error.Error](replace_confined(?root, "new", "current"))) { ret 3; }
    if (!R.is_err[filesystem.File, io_error.Error](open_confined(?root, "new", read_options()))) { ret 4; }
    val opened: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "current", read_options());
    if (R.is_err[filesystem.File, io_error.Error](opened)) { ret 5; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](opened);
    var data: [3]u8;
    val result: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 3, 0);
    filesystem.close(?file);
    root_close(?root);
    cleanup_file(destination_path);
    cleanup_dir(root_path);
    if (R.is_err[usize, io_error.Error](result) || !bytes_equal((?data)::*u8, "new"::*u8, 3)) { ret 6; }
    ret 0;
}

test "io.file: portable watch scan reports create modify replace remove" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val path: Path = "mach-std-io-file-watch";
    val replacement: Path = "mach-std-io-file-watch-new";
    cleanup_file(path);
    cleanup_file(replacement);
    val root_result: R.Result[Root, io_error.Error] = root_open(".");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 1; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var watch: Watch;
    val opened: R.Result[bool, io_error.Error] = watch_open(?watch, ?root, path);
    if (R.is_err[bool, io_error.Error](opened) || R.unwrap_ok[bool, io_error.Error](opened)) { ret 2; }
    val unchanged: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](unchanged) || R.unwrap_ok[WatchEvent, io_error.Error](unchanged) != WATCH_UNCHANGED) { ret 3; }
    if (O.is_some[str](filesystem.write_bytes(path, "a", 1, 0o600))) { ret 4; }
    val created: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](created) || R.unwrap_ok[WatchEvent, io_error.Error](created) != WATCH_CREATED) { ret 5; }
    var append_options: OpenOptions = read_options();
    append_options.access = READ_WRITE;
    val appended: R.Result[filesystem.File, io_error.Error] = open_confined(?root, path, append_options);
    if (R.is_err[filesystem.File, io_error.Error](appended)) { ret 6; }
    var append_file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](appended);
    if (R.is_err[usize, io_error.Error](write_at(append_file, "b"::*u8, 1, 1))) { ret 7; }
    filesystem.close(?append_file);
    val modified: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](modified) || R.unwrap_ok[WatchEvent, io_error.Error](modified) != WATCH_MODIFIED) { ret 8; }
    if (O.is_some[str](filesystem.write_bytes(replacement, "z", 1, 0o600)) || O.is_some[str](filesystem.rename(replacement, path))) { ret 9; }
    val replaced: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](replaced) || R.unwrap_ok[WatchEvent, io_error.Error](replaced) != WATCH_REPLACED) { ret 10; }
    if (O.is_some[str](filesystem.remove_file(path))) { ret 11; }
    val removed: R.Result[WatchEvent, io_error.Error] = watch_scan(?watch);
    if (R.is_err[WatchEvent, io_error.Error](removed) || R.unwrap_ok[WatchEvent, io_error.Error](removed) != WATCH_REMOVED) { ret 12; }
    if (!watch_close(?watch) || R.is_err[bool, io_error.Error](root_close(?root))) { ret 13; }
    cleanup_file(path);
    cleanup_file(replacement);
    ret 0;
}

test "io.file: mapping sync persists mutations" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val path: Path = "mach-std-io-file-mapping";
    cleanup_file(path);
    if (O.is_some[str](filesystem.write_bytes(path, "old!", 4, 0o600))) { ret 1; }
    val root_result: R.Result[Root, io_error.Error] = root_open(".");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 2; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var options: OpenOptions = read_options();
    options.access = READ_WRITE;
    val opened: R.Result[filesystem.File, io_error.Error] = open_confined(?root, path, options);
    if (R.is_err[filesystem.File, io_error.Error](opened)) { ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](opened);
    val mapped: R.Result[Mapping, io_error.Error] = map(file, 0, 4, true);
    if (R.is_err[Mapping, io_error.Error](mapped)) { ret 3; }
    var region: Mapping = R.unwrap_ok[Mapping, io_error.Error](mapped);
    val bytes: *u8 = region.data::*u8;
    bytes[0] = 'n';
    bytes[1] = 'e';
    bytes[2] = 'w';
    bytes[3] = '!';
    if (R.is_err[bool, io_error.Error](mapping_sync(?region)) || R.is_err[bool, io_error.Error](mapping_close(?region))) { ret 4; }
    var data: [4]u8;
    val result: R.Result[usize, io_error.Error] = read_at(file, (?data)::*u8, 4, 0);
    filesystem.close(?file);
    root_close(?root);
    cleanup_file(path);
    if (R.is_err[usize, io_error.Error](result) || !bytes_equal((?data)::*u8, "new!"::*u8, 4)) { ret 5; }
    ret 0;
}

test "io.file: target disk-full errors remain resource exhaustion" {
    $if ($mach.build.os != $mach.os.linux) { ret 0; }
    val root_result: R.Result[Root, io_error.Error] = root_open("/dev");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 1; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var options: OpenOptions = read_options();
    options.access = WRITE_ONLY;
    val opened: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "full", options);
    if (R.is_err[filesystem.File, io_error.Error](opened)) { ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](opened);
    val result: R.Result[usize, io_error.Error] = write_at(file, "x"::*u8, 1, 0);
    filesystem.close(?file);
    root_close(?root);
    if (!R.is_err[usize, io_error.Error](result)) { ret 3; }
    val write_error: io_error.Error = R.unwrap_err[usize, io_error.Error](result);
    if (write_error.code != os.ENOSPC || write_error.kind != io_error.RESOURCE_EXHAUSTED) { ret 4; }
    ret 0;
}

test "io.file: portable transfer reports fallback and preserves offsets" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val source_path: Path = "mach-std-io-file-transfer-source";
    val destination_path: Path = "mach-std-io-file-transfer-destination";
    cleanup_file(source_path);
    cleanup_file(destination_path);
    if (O.is_some[str](filesystem.write_bytes(source_path, "abcdef", 6, 0o600)) || O.is_some[str](filesystem.write_bytes(destination_path, "______", 6, 0o600))) { ret 1; }
    val source_result: R.Result[filesystem.File, io_error.Error] = filesystem.open(source_path);
    if (R.is_err[filesystem.File, io_error.Error](source_result)) { ret 2; }
    var source: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](source_result);
    var options: OpenOptions = read_options();
    options.access = READ_WRITE;
    val root_result: R.Result[Root, io_error.Error] = root_open(".");
    if (R.is_err[Root, io_error.Error](root_result)) { ret 3; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    val destination_result: R.Result[filesystem.File, io_error.Error] = open_confined(?root, destination_path, options);
    if (R.is_err[filesystem.File, io_error.Error](destination_result)) { ret 4; }
    var destination: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](destination_result);
    val copied: R.Result[TransferReport, io_error.Error] = transfer(source, destination, 1, 2, 3);
    var data: [6]u8;
    val result: R.Result[usize, io_error.Error] = read_at(destination, (?data)::*u8, 6, 0);
    filesystem.close(?source);
    filesystem.close(?destination);
    root_close(?root);
    cleanup_file(source_path);
    cleanup_file(destination_path);
    if (R.is_err[TransferReport, io_error.Error](copied) || R.unwrap_ok[TransferReport, io_error.Error](copied).bytes != 3 || R.unwrap_ok[TransferReport, io_error.Error](copied).accelerated) { ret 5; }
    if (R.is_err[usize, io_error.Error](result) || !bytes_equal((?data)::*u8, "__bcd_"::*u8, 6)) { ret 6; }
    ret 0;
}

rec BlockTask {
    entered: *i64;
    release: *i64;
}

fun block_worker(context: ptr) bool {
    val task: *BlockTask = context::*BlockTask;
    atomic.store(task.entered, 1);
    os.thread_wake(task.entered);
    for (atomic.load(task.release) == 0) { os.thread_wait(task.release, 0); }
    ret true;
}

test "io.file: worker fallback copies writes and publishes positioned reads" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val root_path: Path = "mach-std-io-file-async-root";
    val file_path: Path = "mach-std-io-file-async-root/data";
    cleanup_file(file_path);
    cleanup_dir(root_path);
    if (O.is_some[str](filesystem.create_dir(root_path, 0o700))) { ret 1; }
    val root_result: R.Result[Root, io_error.Error] = root_open(root_path);
    if (R.is_err[Root, io_error.Error](root_result)) { ret 2; }
    var root: Root = R.unwrap_ok[Root, io_error.Error](root_result);
    var options: OpenOptions = write_options(0o600);
    options.access = READ_WRITE;
    options.truncate = true;
    val file_result: R.Result[filesystem.File, io_error.Error] = open_confined(?root, "data", options);
    if (R.is_err[filesystem.File, io_error.Error](file_result)) { ret 3; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](file_result);
    var runtime: io_runtime.Runtime;
    if (R.is_err[bool, io_error.Error](io_runtime.make(?runtime, 4))) { ret 4; }
    var requests: [4]Request;
    var scratch: [64]u8;
    var tasks: [4]worker_pool.Task;
    var abort_tasks: [4]worker_pool.Task;
    var threads: [2]thread.Thread;
    var workers: [2]worker_pool.Worker;
    var adapter: Adapter;
    if (R.is_err[bool, io_error.Error](make(?adapter, ?runtime, (?requests)::*Request, 4, (?scratch)::*u8, 64, 16, (?tasks)::*worker_pool.Task, (?abort_tasks)::*worker_pool.Task, (?threads)::*thread.Thread, (?workers)::*worker_pool.Worker, 2))) { ret 5; }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 6; }
    var input: [5]u8;
    memory.raw_copy((?input)::ptr, "hello"::ptr, 5);
    if (R.is_err[io_runtime.Token, io_error.Error](submit_write(?adapter, ?scope, ?file, (?input)::*u8, 5, 3, 61))) { ret 7; }
    memory.raw_fill((?input)::ptr, 'x', 5);
    var completion: io_runtime.Completion;
    val written: R.Result[usize, io_error.Error] = io_runtime.wait(?runtime, ?completion, 1, 1000);
    if (R.is_err[usize, io_error.Error](written) || R.unwrap_ok[usize, io_error.Error](written) != 1 || completion.bytes != 5 || completion.context != 61 || completion.has_error) { ret 8; }
    var output: [8]u8;
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?scope, ?file, (?output)::*u8, 8, 0, 62))) { ret 9; }
    val read_result: R.Result[usize, io_error.Error] = io_runtime.wait(?runtime, ?completion, 1, 1000);
    if (R.is_err[usize, io_error.Error](read_result) || R.unwrap_ok[usize, io_error.Error](read_result) != 1 || completion.bytes != 8 || completion.end_of_stream || completion.has_error) { ret 10; }
    if (output[0] != 0 || output[1] != 0 || output[2] != 0 || !bytes_equal(((?output)::usize + 3)::*u8, "hello"::*u8, 5)) { ret 11; }
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?scope, ?file, (?output)::*u8, 8, 100, 63))) { ret 12; }
    val eof: R.Result[usize, io_error.Error] = io_runtime.wait(?runtime, ?completion, 1, 1000);
    if (R.is_err[usize, io_error.Error](eof) || completion.bytes != 0 || !completion.end_of_stream || completion.has_error) { ret 13; }
    if (R.is_err[bool, io_error.Error](shutdown_drain(?adapter)) || R.is_err[bool, io_error.Error](destroy(?adapter))) { ret 14; }
    if (!cancel.destroy(?scope)) { ret 15; }
    io_runtime.close(?runtime);
    if (R.is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 16; }
    filesystem.close(?file);
    root_close(?root);
    cleanup_file(file_path);
    cleanup_dir(root_path);
    ret 0;
}

test "io.file: queued cancellation and deadline leave read bytes untouched" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val path: Path = "mach-std-io-file-cancel";
    cleanup_file(path);
    if (O.is_some[str](filesystem.write_bytes(path, "secret", 6, 0o600))) { ret 1; }
    val file_result: R.Result[filesystem.File, io_error.Error] = filesystem.open(path);
    if (R.is_err[filesystem.File, io_error.Error](file_result)) { ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](file_result);
    var runtime: io_runtime.Runtime;
    if (R.is_err[bool, io_error.Error](io_runtime.make(?runtime, 1))) { ret 3; }
    var requests: [1]Request;
    var scratch: [8]u8;
    var tasks: [1]worker_pool.Task;
    var abort_tasks: [1]worker_pool.Task;
    var threads: [1]thread.Thread;
    var workers: [1]worker_pool.Worker;
    var adapter: Adapter;
    if (R.is_err[bool, io_error.Error](make(?adapter, ?runtime, (?requests)::*Request, 1, (?scratch)::*u8, 8, 8, (?tasks)::*worker_pool.Task, (?abort_tasks)::*worker_pool.Task, (?threads)::*thread.Thread, (?workers)::*worker_pool.Worker, 1))) { ret 4; }
    var entered: i64 = 0;
    var release: i64 = 0;
    var blocker: BlockTask = BlockTask{entered: ?entered, release: ?release};
    if (worker_pool.submit(?adapter.pool, worker_pool.Task{context: ?blocker, run: block_worker}) != worker_pool.ACCEPTED) { ret 5; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 6; }
    var output: [6]u8;
    memory.raw_fill((?output)::ptr, 9, 6);
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?scope, ?file, (?output)::*u8, 6, 0, 70)) || !cancel.cancel(?scope)) { ret 7; }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    var completion: io_runtime.Completion;
    val cancelled: R.Result[usize, io_error.Error] = io_runtime.wait(?runtime, ?completion, 1, 1000);
    if (R.is_err[usize, io_error.Error](cancelled) || R.unwrap_ok[usize, io_error.Error](cancelled) != 1 || !completion.has_error || completion.error.kind != io_error.CANCELLED) { ret 8; }
    var i: usize = 0;
    for (i < 6) { if (output[i] != 9) { ret 9; } i = i + 1; }
    atomic.store(?entered, 0);
    atomic.store(?release, 0);
    if (worker_pool.submit(?adapter.pool, worker_pool.Task{context: ?blocker, run: block_worker}) != worker_pool.ACCEPTED) { ret 10; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    var deadline_scope: cancel.Scope;
    if (!cancel.make_root(?deadline_scope, true, time.monotonic())) { ret 11; }
    memory.raw_fill((?output)::ptr, 8, 6);
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?deadline_scope, ?file, (?output)::*u8, 6, 0, 71))) { ret 12; }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    val timed_out: R.Result[usize, io_error.Error] = io_runtime.wait(?runtime, ?completion, 1, 1000);
    if (R.is_err[usize, io_error.Error](timed_out) || R.unwrap_ok[usize, io_error.Error](timed_out) != 1 || !completion.has_error || completion.error.kind != io_error.TIMEOUT) { ret 13; }
    i = 0;
    for (i < 6) { if (output[i] != 8) { ret 14; } i = i + 1; }
    if (R.is_err[bool, io_error.Error](shutdown_drain(?adapter)) || R.is_err[bool, io_error.Error](destroy(?adapter))) { ret 15; }
    if (!cancel.destroy(?scope) || !cancel.destroy(?deadline_scope)) { ret 16; }
    io_runtime.close(?runtime);
    if (R.is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 17; }
    filesystem.close(?file);
    cleanup_file(path);
    ret 0;
}

test "io.file: runtime close never exposes worker scratch" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    val path: Path = "mach-std-io-file-race";
    cleanup_file(path);
    if (O.is_some[str](filesystem.write_bytes(path, "secret", 6, 0o600))) { ret 1; }
    val file_result: R.Result[filesystem.File, io_error.Error] = filesystem.open(path);
    if (R.is_err[filesystem.File, io_error.Error](file_result)) { ret 2; }
    var file: filesystem.File = R.unwrap_ok[filesystem.File, io_error.Error](file_result);
    var runtime: io_runtime.Runtime;
    if (R.is_err[bool, io_error.Error](io_runtime.make(?runtime, 1))) { ret 3; }
    var requests: [1]Request;
    var scratch: [8]u8;
    var tasks: [1]worker_pool.Task;
    var abort_tasks: [1]worker_pool.Task;
    var threads: [1]thread.Thread;
    var workers: [1]worker_pool.Worker;
    var adapter: Adapter;
    if (R.is_err[bool, io_error.Error](make(?adapter, ?runtime, (?requests)::*Request, 1, (?scratch)::*u8, 8, 8, (?tasks)::*worker_pool.Task, (?abort_tasks)::*worker_pool.Task, (?threads)::*thread.Thread, (?workers)::*worker_pool.Worker, 1))) { ret 4; }
    var entered: i64 = 0;
    var release: i64 = 0;
    var blocker: BlockTask = BlockTask{entered: ?entered, release: ?release};
    if (worker_pool.submit(?adapter.pool, worker_pool.Task{context: ?blocker, run: block_worker}) != worker_pool.ACCEPTED) { ret 5; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    var scope: cancel.Scope;
    if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 6; }
    var output: [6]u8;
    memory.raw_fill((?output)::ptr, 9, 6);
    if (R.is_err[io_runtime.Token, io_error.Error](submit_read(?adapter, ?scope, ?file, (?output)::*u8, 6, 0, 71))) { ret 7; }
    if (R.is_err[bool, io_error.Error](io_runtime.close(?runtime))) { ret 8; }
    var completion: io_runtime.Completion;
    val closed: R.Result[usize, io_error.Error] = io_runtime.poll(?runtime, ?completion, 1);
    if (R.is_err[usize, io_error.Error](closed) || R.unwrap_ok[usize, io_error.Error](closed) != 1 || !completion.has_error || completion.error.kind != io_error.CLOSED) { ret 9; }
    memory.raw_fill((?output)::ptr, 7, 6);
    atomic.store(?release, 1);
    os.thread_wake(?release);
    if (R.is_err[bool, io_error.Error](shutdown_drain(?adapter)) || R.is_err[bool, io_error.Error](destroy(?adapter))) { ret 10; }
    var i: usize = 0;
    for (i < 6) { if (output[i] != 7) { ret 11; } i = i + 1; }
    val repeated: R.Result[usize, io_error.Error] = io_runtime.poll(?runtime, ?completion, 1);
    if (R.is_err[usize, io_error.Error](repeated) || R.unwrap_ok[usize, io_error.Error](repeated) != 0) { ret 12; }
    if (!cancel.destroy(?scope) || R.is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 13; }
    filesystem.close(?file);
    cleanup_file(path);
    ret 0;
}
