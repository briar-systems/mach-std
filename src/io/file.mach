# bounded asynchronous and handle-relative file operations

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.path.Path;
use std.chrono.time;
use std.filesystem;
use std.system.os;
use std.sync.condition;
use std.sync.mutex;
use io_error: std.io.error;
use io_handle: std.io.handle;

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    use platform: std.io.file.posix;
}
$or ($mach.build.os == $mach.os.windows) {
    use platform: std.io.file.windows;
}

pub def Access: u8;
pub val READ_ONLY:  Access = 0;
pub val WRITE_ONLY: Access = 1;
pub val READ_WRITE: Access = 2;
val MAX_FILE_OFFSET: u64 = 0x7fffffffffffffff;

fun span_valid(offset: u64, length: usize) bool {
    ret offset <= MAX_FILE_OFFSET && length::u64 <= MAX_FILE_OFFSET - offset;
}

pub rec OpenOptions {
    access:    Access;
    create:    bool;
    exclusive: bool;
    truncate:  bool;
    directory: bool;
    mode:      i32;
}

pub fun read_options() OpenOptions {
    ret OpenOptions{access: READ_ONLY, create: false, exclusive: false, truncate: false, directory: false, mode: 0};
}

pub fun write_options(mode: i32) OpenOptions {
    ret OpenOptions{access: WRITE_ONLY, create: true, exclusive: false, truncate: false, directory: false, mode: mode};
}

pub rec Root {
    directory:   filesystem.File;
    active:      usize;
    initialized: bool;
    closing:     bool;
    lock:        mutex.Mutex;
    idle:        condition.Condition;
}

pub rec Capabilities {
    positioned_io:       bool;
    native_async:        bool;
    bounded_workers:     bool;
    confined_open:       bool;
    replacement_flush_request: bool;
    replacement_persistence_guaranteed: bool;
    mapping:             bool;
    watching:            bool;
    accelerated_transfer: bool;
}

pub fun capabilities() Capabilities {
    ret Capabilities{
        positioned_io: true,
        native_async: false,
        bounded_workers: true,
        confined_open: true,
        replacement_flush_request: true,
        replacement_persistence_guaranteed: false,
        mapping: true,
        watching: true,
        accelerated_transfer: false,
    };
}

fun failure(code: i64, operation: io_error.Operation) io_error.Error {
    ret io_error.from_code(code, operation);
}

fun options_valid(options: OpenOptions) bool {
    if (options.access > READ_WRITE) { ret false; }
    if (options.directory && (options.create || options.truncate || options.access != READ_ONLY)) { ret false; }
    if (options.exclusive && !options.create) { ret false; }
    ret true;
}

fun options_flags(options: OpenOptions) i32 {
    var flags: i32 = os.O_RDONLY;
    if (options.access == WRITE_ONLY) { flags = os.O_WRONLY; }
    or (options.access == READ_WRITE) { flags = os.O_RDWR; }
    if (options.create) { flags = flags | os.O_CREAT; }
    if (options.exclusive) { flags = flags | os.O_EXCL; }
    if (options.truncate) { flags = flags | os.O_TRUNC; }
    if (options.directory) { flags = flags | os.O_DIRECTORY; }
    ret flags;
}

# the root path is trusted once and every later resolution starts from its handle
# the root is initialized in place: watches borrow its address and admitted work
# waits on its condition, so it never moves after this call succeeds
pub fun root_open(root: *Root, path: Path) err[io_error.Error] {
    if (root == nil || path == nil) { ret err[io_error.Error].err{failure(os.EINVAL, io_error.OP_OPEN)}; }
    val raw: i64 = platform.open_root(path::*u8);
    if (raw < 0) { ret err[io_error.Error].err{failure(raw, io_error.OP_OPEN)}; }
    var directory: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: raw::usize}};
    val metadata: res[filesystem.Metadata, io_error.Error] = filesystem.stat_of(directory);
    if (sel metadata.err) {
        filesystem.close(?directory);
        ret err[io_error.Error].err{metadata.err};
    }
    root.directory = directory;
    root.active = 0;
    root.initialized = true;
    root.closing = false;
    root.lock = mutex.make();
    root.idle = condition.make();
    ret err[io_error.Error].ok{};
}

fun root_enter(root: *Root) bool {
    if (root == nil) { ret false; }
    mutex.lock(?root.lock);
    if (!root.initialized || root.closing) {
        mutex.unlock(?root.lock);
        ret false;
    }
    root.active = root.active + 1;
    mutex.unlock(?root.lock);
    ret true;
}

fun root_leave(root: *Root) {
    mutex.lock(?root.lock);
    root.active = root.active - 1;
    if (root.active == 0) { condition.broadcast(?root.idle); }
    mutex.unlock(?root.lock);
}

# close rejects new resolution and waits for admitted handle-relative work
pub fun root_close(root: *Root) err[io_error.Error] {
    if (root == nil) { ret err[io_error.Error].err{failure(os.EBADF, io_error.OP_CLOSE)}; }
    mutex.lock(?root.lock);
    if (!root.initialized || root.closing) {
        mutex.unlock(?root.lock);
        ret err[io_error.Error].err{failure(os.EBADF, io_error.OP_CLOSE)};
    }
    root.closing = true;
    for (root.active != 0) { condition.wait(?root.idle, ?root.lock); }
    val closed: err[io_error.Error] = filesystem.close(?root.directory);
    root.initialized = false;
    root.closing = false;
    mutex.unlock(?root.lock);
    ret closed;
}

# relative components are opened one at a time from pinned directory handles
pub fun open_confined(root: *Root, path: Path, options: OpenOptions) res[filesystem.File, io_error.Error] {
    if (root == nil || path == nil || !options_valid(options)) {
        ret res[filesystem.File, io_error.Error].err{failure(os.EINVAL, io_error.OP_OPEN)};
    }
    if (!root_enter(root)) { ret res[filesystem.File, io_error.Error].err{failure(os.EBADF, io_error.OP_OPEN)}; }
    val raw: i64 = platform.open_confined(root.directory.handle.value::i32, path::*u8, options_flags(options), options.mode);
    root_leave(root);
    if (raw < 0) { ret res[filesystem.File, io_error.Error].err{failure(raw, io_error.OP_OPEN)}; }
    ret res[filesystem.File, io_error.Error].ok{filesystem.File{handle: io_handle.FileHandle{value: raw::usize}}};
}

# success confirms os data and namespace flush requests, not media persistence
pub fun replace_confined(root: *Root, temporary: Path, destination: Path) err[io_error.Error] {
    if (root == nil || temporary == nil || destination == nil || !root_enter(root)) {
        ret err[io_error.Error].err{failure(os.EBADF, io_error.OP_OPTION)};
    }
    var sync_options: OpenOptions = read_options();
    sync_options.access = WRITE_ONLY;
    val raw: i64 = platform.open_confined(root.directory.handle.value::i32, temporary::*u8, options_flags(sync_options), 0);
    if (raw < 0) {
        root_leave(root);
        ret err[io_error.Error].err{failure(raw, io_error.OP_OPEN)};
    }
    var file: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: raw::usize}};
    val synced: err[io_error.Error] = filesystem.sync(file);
    val closed: err[io_error.Error] = filesystem.close(?file);
    if (sel synced.err) {
        root_leave(root);
        ret synced;
    }
    if (sel closed.err) {
        root_leave(root);
        ret closed;
    }
    val result: i64 = platform.rename_confined(root.directory.handle.value::i32, temporary::*u8, destination::*u8);
    root_leave(root);
    if (result < 0) { ret err[io_error.Error].err{failure(result, io_error.OP_OPTION)}; }
    ret err[io_error.Error].ok{};
}

pub fun read_at(file: filesystem.File, buffer: *u8, length: usize, offset: u64) res[usize, io_error.Error] {
    if (!io_handle.file_is_valid(file.handle) || (buffer == nil && length != 0) || offset > MAX_FILE_OFFSET) { ret res[usize, io_error.Error].err{failure(os.EINVAL, io_error.OP_READ)}; }
    val result: i64 = platform.read_at(file.handle.value::i32, buffer, length, offset);
    if (result < 0) { ret res[usize, io_error.Error].err{failure(result, io_error.OP_READ)}; }
    ret res[usize, io_error.Error].ok{result::usize};
}

pub fun write_at(file: filesystem.File, buffer: *u8, length: usize, offset: u64) res[usize, io_error.Error] {
    if (!io_handle.file_is_valid(file.handle) || (buffer == nil && length != 0) || offset > MAX_FILE_OFFSET) { ret res[usize, io_error.Error].err{failure(os.EINVAL, io_error.OP_WRITE)}; }
    val result: i64 = platform.write_at(file.handle.value::i32, buffer, length, offset);
    if (result < 0) { ret res[usize, io_error.Error].err{failure(result, io_error.OP_WRITE)}; }
    ret res[usize, io_error.Error].ok{result::usize};
}

