# bounded asynchronous and handle-relative file operations

use std.chrono.time;
use io_error:  std.io.error;
use io_handle: std.io.handle;
use std.runtime.native.view.Unit;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.path.Path;
use std.types.result.res;
use std.types.size.usize;

$if ($mach.build.sys == $mach.sys.linux || $mach.build.sys == $mach.sys.darwin || $mach.build.sys == $mach.sys.wasi) {
    use platform: std.io.file.posix;
}
$or ($mach.build.sys == $mach.sys.windows) {
    use platform: std.io.file.windows;
}

pub def Access: u8;
pub val READ_ONLY:       Access = 0;
pub val WRITE_ONLY:      Access = 1;
pub val READ_WRITE:      Access = 2;
val     MAX_FILE_OFFSET: u64    = 0x7fffffffffffffff;

fun span_valid(offset: u64, length: usize) bool {
    ret offset <= MAX_FILE_OFFSET && length::u64 <= MAX_FILE_OFFSET - offset;
}

# how open_confined opens a file
# ---
# access:    the access the opened file grants
# create:    create the file when it is missing
# exclusive: refuse a file that already exists, valid only with create
# truncate:  empty an existing file
# directory: open a directory, valid only read-only without create or truncate
# mode:      permission bits for a created file
pub rec OpenOptions {
    access:    Access;
    create:    bool;
    exclusive: bool;
    truncate:  bool;
    directory: bool;
    mode:      i32;
}

# options that open an existing file read-only
# ---
# ret: READ_ONLY access with every flag off
pub fun read_options() OpenOptions {
    ret OpenOptions{access: READ_ONLY, create: false, exclusive: false, truncate: false, directory: false, mode: 0};
}

# options that open a file write-only, creating it when missing
# ---
# mode: permission bits for a created file
# ret:  WRITE_ONLY access with create set, not exclusive and not truncating
pub fun write_options(mode: i32) OpenOptions {
    ret OpenOptions{access: WRITE_ONLY, create: true, exclusive: false, truncate: false, directory: false, mode: mode};
}

# a directory every confined operation resolves beneath
#
# opened in place by root_open and closed by root_close. it never moves while open
# ---
# directory:   the pinned directory handle
# active:      operations admitted and not yet finished
# initialized: true between a successful open and close
# closing:     true while root_close waits for admitted work
# lock:        guards active, initialized and closing
# idle:        signalled when active drops to zero
pub rec Root {
    directory:   filesystem.File;
    active:      usize;
    initialized: bool;
    closing:     bool;
    lock:        mutex.Mutex;
    idle:        Idle;
}

# what the file layer provides on this target
# ---
# positioned_io:                      reads and writes at an offset are available
# native_async:                       the host completes file requests asynchronously
# bounded_workers:                    async requests run on a bounded worker adapter
# confined_open:                      opens resolve beneath a root without escaping it
# replacement_flush_request:          replace_confined requests a flush before renaming
# replacement_persistence_guaranteed: a replacement is guaranteed to reach the media
# mapping:                            files can be mapped into memory
# watching:                           a path can be watched for changes
# accelerated_transfer:               transfer uses a native copy path
pub rec Capabilities {
    positioned_io:                      bool;
    native_async:                       bool;
    bounded_workers:                    bool;
    confined_open:                      bool;
    replacement_flush_request:          bool;
    replacement_persistence_guaranteed: bool;
    mapping:                            bool;
    watching:                           bool;
    accelerated_transfer:               bool;
}

# the file layer's capabilities on this target
# ---
# ret: the capabilities, the same on every target that builds this module
pub fun capabilities() Capabilities {
    ret Capabilities{
        positioned_io:                      true,
        native_async:                       false,
        bounded_workers:                    true,
        confined_open:                      true,
        replacement_flush_request:          true,
        replacement_persistence_guaranteed: false,
        mapping:                            true,
        watching:                           true,
        accelerated_transfer:               false,
    };
}

fun failure(code: i64, operation: io_error.Operation) io_error.Error {
    ret os.error(code, operation);
}

fun options_valid(options: OpenOptions) bool {
    if (options.access > READ_WRITE)                                                              { ret false; }
    if (options.directory && (options.create || options.truncate || options.access != READ_ONLY)) { ret false; }
    if (options.exclusive && !options.create)                                                     { ret false; }
    ret true;
}

fun options_flags(options: OpenOptions) i32 {
    var flags: i32 = os.O_RDONLY;
    if (options.access == WRITE_ONLY) { flags = os.O_WRONLY; }
    or (options.access == READ_WRITE) { flags = os.O_RDWR; }
    if (options.create)               { flags = flags | os.O_CREAT; }
    if (options.exclusive)            { flags = flags | os.O_EXCL; }
    if (options.truncate)             { flags = flags | os.O_TRUNC; }
    if (options.directory)            { flags = flags | os.O_DIRECTORY; }
    ret flags;
}

# the root path is trusted once and every later resolution starts from its handle
# the root is initialized in place: watches borrow its address and admitted work
# waits on its condition, so it never moves after this call succeeds
pub fun root_open(root: *Root, path: Path) err[io_error.Error] {
    if (root == nil || path == nil) { ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPEN)}; }
    ret root_opened(root, platform.open_root(path::*u8));
}

# root_open for a directory named in native units
pub fun root_open_native(root: *Root, name: *Unit) err[io_error.Error] {
    if (root == nil || name == nil) { ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPEN)}; }
    ret root_opened(root, platform.open_root_native(name));
}

fun root_opened(root: *Root, raw: i64) err[io_error.Error] {
    if (raw < 0) { ret err[io_error.Error].err{failure(raw, io_error.OP_OPEN)}; }
    var directory:    filesystem.File                          = filesystem.File{handle: io_handle.FileHandle{value: raw::usize}};
    val res_metadata: res[filesystem.Metadata, io_error.Error] = filesystem.stat_of(directory);
    if (sel res_metadata.err) {
        filesystem.close(?directory);
        ret err[io_error.Error].err{res_metadata.err};
    }
    root.directory   = directory;
    root.active      = 0;
    root.initialized = true;
    root.closing     = false;
    root.lock        = mutex.make();
    root.idle        = idle_make();
    ret err[io_error.Error].ok{};
}

fun root_enter(root: *Root) bool {
    if (root == nil) { ret false; }
    mutex.lock(?root.lock);
    if (!root.initialized || root.closing) {
        mutex.unlock(?root.lock);
        ret false;
    }
    root.active = root.active + 1;
    mutex.unlock(?root.lock);
    ret true;
}

fun root_leave(root: *Root) {
    mutex.lock(?root.lock);
    root.active = root.active - 1;
    if (root.active == 0) { idle_signal(?root.idle); }
    mutex.unlock(?root.lock);
}

# close rejects new resolution and waits for admitted handle-relative work
# ---
# root: the root to close
# ret:  the directory close failure, or CLOSED when root is nil, not open or
#       already closing
pub fun root_close(root: *Root) err[io_error.Error] {
    if (root == nil) { ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_CLOSE)}; }
    mutex.lock(?root.lock);
    if (!root.initialized || root.closing) {
        mutex.unlock(?root.lock);
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_CLOSE)};
    }
    root.closing = true;
    for (root.active != 0) { idle_wait(?root.idle, ?root.lock); }
    val err_closed: err[io_error.Error] = filesystem.close(?root.directory);
    root.initialized = false;
    root.closing     = false;
    mutex.unlock(?root.lock);
    ret err_closed;
}

# relative components are opened one at a time from pinned directory handles
pub fun open_confined(root: *Root, path: Path, options: OpenOptions) res[filesystem.File, io_error.Error] {
    if (root == nil || path == nil || !options_valid(options)) {
        ret res[filesystem.File, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPEN)};
    }
    if (!root_enter(root)) { ret res[filesystem.File, io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_OPEN)}; }
    val raw: i64 = platform.open_confined(root.directory.handle.value::i32, path::*u8, options_flags(options), options.mode);
    root_leave(root);
    ret confined_file(raw);
}

# open_confined for a relative name in native units, split into components
# in those units
pub fun open_confined_native(root: *Root, name: *Unit, options: OpenOptions) res[filesystem.File, io_error.Error] {
    if (root == nil || name == nil || !options_valid(options)) {
        ret res[filesystem.File, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPEN)};
    }
    if (!root_enter(root)) { ret res[filesystem.File, io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_OPEN)}; }
    val raw: i64 = platform.open_confined_native(root.directory.handle.value::i32, name, options_flags(options), options.mode);
    root_leave(root);
    ret confined_file(raw);
}

fun confined_file(raw: i64) res[filesystem.File, io_error.Error] {
    if (raw < 0) { ret res[filesystem.File, io_error.Error].err{failure(raw, io_error.OP_OPEN)}; }
    ret res[filesystem.File, io_error.Error].ok{filesystem.File{handle: io_handle.FileHandle{value: raw::usize}}};
}

# success confirms os data and namespace flush requests, not media persistence
#
# both names are converted once before anything is flushed, so a name that
# cannot be converted leaves the temporary untouched
pub fun replace_confined(root: *Root, temporary: Path, destination: Path) err[io_error.Error] {
    if (root == nil || temporary == nil || destination == nil) {
        ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)};
    }
    var from:      os.NativePath;
    val converted: i64 = platform.confined_name(temporary, ?from);
    if (converted < 0) { ret err[io_error.Error].err{failure(converted, io_error.OP_OPTION)}; }
    var to:                    os.NativePath;
    val destination_converted: i64 = platform.confined_name(destination, ?to);
    if (destination_converted < 0) {
        os.native_path_dnit(?from);
        ret err[io_error.Error].err{failure(destination_converted, io_error.OP_OPTION)};
    }
    val err_replace_confined_native: err[io_error.Error] = replace_confined_native(root, from.units, to.units);
    os.native_path_dnit(?to);
    os.native_path_dnit(?from);
    ret err_replace_confined_native;
}

# replace_confined for relative names in native units
pub fun replace_confined_native(root: *Root, temporary: *Unit, destination: *Unit) err[io_error.Error] {
    if (root == nil || temporary == nil || destination == nil) {
        ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)};
    }
    if (!root_enter(root)) { ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_OPTION)}; }
    var sync_options: OpenOptions = read_options();
    sync_options.access = WRITE_ONLY;
    val raw: i64 = platform.open_confined_native(root.directory.handle.value::i32, temporary, options_flags(sync_options), 0);
    if (raw < 0) {
        root_leave(root);
        ret err[io_error.Error].err{failure(raw, io_error.OP_OPEN)};
    }
    var file:       filesystem.File     = filesystem.File{handle: io_handle.FileHandle{value: raw::usize}};
    val err_synced: err[io_error.Error] = filesystem.sync(file);
    val err_closed: err[io_error.Error] = filesystem.close(?file);
    if (sel err_synced.err) {
        root_leave(root);
        ret err_synced;
    }
    if (sel err_closed.err) {
        root_leave(root);
        ret err_closed;
    }
    val result: i64 = platform.rename_confined_native(root.directory.handle.value::i32, temporary, destination);
    root_leave(root);
    if (result < 0) { ret err[io_error.Error].err{failure(result, io_error.OP_OPTION)}; }
    ret err[io_error.Error].ok{};
}

# reads at an offset without using the file position
# ---
# file:   the file to read
# buffer: receives the bytes, may be nil only when length is 0
# length: the most bytes to read
# offset: the file offset to read from
# ret:    bytes read, 0 at end of file, or the failure. an invalid handle,
#         nil buffer or offset past the largest file offset is INVALID
pub fun read_at(file: filesystem.File, buffer: *u8, length: usize, offset: u64) res[usize, io_error.Error] {
    if (!io_handle.file_is_valid(file.handle) || (buffer == nil && length != 0) || offset > MAX_FILE_OFFSET) { ret res[usize, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_READ)}; }
    val result: i64 = platform.read_at(file.handle.value::i32, buffer, length, offset);
    if (result < 0) { ret res[usize, io_error.Error].err{failure(result, io_error.OP_READ)}; }
    ret res[usize, io_error.Error].ok{result::usize};
}

# writes at an offset without using the file position
# ---
# file:   the file to write
# buffer: the bytes to write, may be nil only when length is 0
# length: the number of bytes to write
# offset: the file offset to write at
# ret:    bytes written, which may be short, or the failure. an invalid
#         handle, nil buffer or offset past the largest file offset is INVALID
pub fun write_at(file: filesystem.File, buffer: *u8, length: usize, offset: u64) res[usize, io_error.Error] {
    if (!io_handle.file_is_valid(file.handle) || (buffer == nil && length != 0) || offset > MAX_FILE_OFFSET) { ret res[usize, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_WRITE)}; }
    val result: i64 = platform.write_at(file.handle.value::i32, buffer, length, offset);
    if (result < 0) { ret res[usize, io_error.Error].err{failure(result, io_error.OP_WRITE)}; }
    ret res[usize, io_error.Error].ok{result::usize};
}

use std.system.capability;

$if (capability.HAS_FILES && capability.HAS_PAGES) {
    use std.filesystem;
    use std.sync.mutex;
    use std.system.os;
}
$or {
    $error("std.io.file needs the files and pages capabilities (std.system.capability.HAS_FILES, HAS_PAGES)");
}

# the background request adapter runs on threads, and a thread is what a root's
# close waits for, so a threadless target has neither
$if (capability.HAS_THREADS) {
    use std.io.file.adapter;
    use std.sync.condition;

    fwd adapter.Request;
    fwd adapter.Adapter;
    fwd adapter.init;
    fwd adapter.submit_read;
    fwd adapter.submit_write;
    fwd adapter.attach_secret_scratch;
    fwd adapter.submit_secret_read;
    fwd adapter.submit_secret_write;
    fwd adapter.shutdown_drain;
    fwd adapter.shutdown_abort;
    fwd adapter.active;
    fwd adapter.dnit;

    def Idle: condition.Condition;

    fun idle_make() Idle {
        ret condition.make();
    }

    fun idle_signal(idle: *Idle) {
        condition.broadcast(idle);
    }

    fun idle_wait(idle: *Idle, lock: *mutex.Mutex) {
        condition.wait(idle, lock);
    }
}
$or {
    def Idle: u8;

    fun idle_make() Idle {
        ret 0;
    }

    fun idle_signal(idle: *Idle) {}

    fun idle_wait(idle: *Idle, lock: *mutex.Mutex) {}
}

# a file region mapped into memory
# ---
# data:        the first mapped byte
# length:      the mapped length in bytes
# offset:      the file offset the mapping starts at
# writable:    true when writes reach the file
# initialized: true until mapping_close
pub rec Mapping {
    data:        ptr;
    length:      usize;
    offset:      u64;
    writable:    bool;
    initialized: bool;
}

# mappings own their virtual region independently of the file handle
pub fun map(file: filesystem.File, offset: u64, length: usize, writable: bool) res[Mapping, io_error.Error] {
    val alignment: usize = os.map_alignment();
    if (!io_handle.file_is_valid(file.handle) || length == 0 || offset > (-1)::usize::u64 || !span_valid(offset, length) || offset::usize % alignment != 0) {
        ret res[Mapping, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)};
    }
    var protection: u32 = os.PROT_READ;
    if (writable) { protection = protection | os.PROT_WRITE; }
    val data: ptr = os.map_file(file.handle.value, offset::usize, length, protection);
    if (data == nil) { ret res[Mapping, io_error.Error].err{io_error.make(io_error.IO, io_error.OP_OPTION)}; }
    ret res[Mapping, io_error.Error].ok{Mapping{data: data, length: length, offset: offset, writable: writable, initialized: true}};
}

# flushes a writable mapping's changes to the file
# ---
# mapping: the mapping to flush
# ret:     the failure, INVALID for a nil, closed or read-only mapping
pub fun mapping_sync(mapping: *Mapping) err[io_error.Error] {
    if (mapping == nil || !mapping.initialized || !mapping.writable) { ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_SYNC)}; }
    val result: i64 = os.sync_file(mapping.data, mapping.length);
    if (result < 0) { ret err[io_error.Error].err{failure(result, io_error.OP_SYNC)}; }
    ret err[io_error.Error].ok{};
}

# unmaps a mapping and clears it
# ---
# mapping: the mapping to release
# ret:     the failure, INVALID for a nil or closed mapping
pub fun mapping_close(mapping: *Mapping) err[io_error.Error] {
    if (mapping == nil || !mapping.initialized) { ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_CLOSE)}; }
    val result: i64 = platform.unmap_file(mapping.data, mapping.length);
    if (result < 0) { ret err[io_error.Error].err{failure(result, io_error.OP_CLOSE)}; }
    mapping.data        = nil;
    mapping.length      = 0;
    mapping.initialized = false;
    ret err[io_error.Error].ok{};
}

# what transfer copied
# ---
# bytes:       bytes copied
# end_of_file: true when the source ended before length bytes were copied
# accelerated: true when a native copy path was used
pub rec TransferReport {
    bytes:       usize;
    end_of_file: bool;
    accelerated: bool;
}

# the portable transfer uses fixed stack storage and preserves both file offsets
pub fun transfer(source: filesystem.File, destination: filesystem.File, source_offset: u64, destination_offset: u64, length: usize) res[TransferReport, io_error.Error] {
    if (!span_valid(source_offset, length) || !span_valid(destination_offset, length)) {
        ret res[TransferReport, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)};
    }
    var buffer:      [16384]u8;
    var transferred: usize = 0;
    var eof:         bool  = false;
    for (transferred < length && !eof) {
        var chunk: usize = length - transferred;
        if (chunk > 16384) { chunk = 16384; }
        val res_read: res[usize, io_error.Error] = read_at(source, (?buffer)::*u8, chunk, source_offset + transferred::u64);
        if (sel res_read.err) { ret res[TransferReport, io_error.Error].err{res_read.err}; }
        val read_count: usize = res_read.ok;
        if (read_count == 0) { eof = true; }
        var written: usize = 0;
        for (written < read_count) {
            val res_write: res[usize, io_error.Error] = write_at(destination, ((?buffer)::usize + written)::*u8, read_count - written, destination_offset + transferred::u64 + written::u64);
            if (sel res_write.err) { ret res[TransferReport, io_error.Error].err{res_write.err}; }
            val count: usize = res_write.ok;
            if (count == 0) { ret res[TransferReport, io_error.Error].err{io_error.make(io_error.IO, io_error.OP_WRITE)}; }
            written = written + count;
        }
        transferred = transferred + read_count;
    }
    ret res[TransferReport, io_error.Error].ok{TransferReport{bytes: transferred, end_of_file: eof, accelerated: false}};
}

# what watching provides on this target
# ---
# supported:     a path can be watched
# recursive:     a watch covers a directory's descendants
# native:        the host reports changes itself
# requires_scan: changes are found only by calling watch_scan
pub rec WatchCapabilities {
    supported:     bool;
    recursive:     bool;
    native:        bool;
    requires_scan: bool;
}

# watching's capabilities on this target
# ---
# ret: supported and scan-driven, neither recursive nor native
pub fun watch_capabilities() WatchCapabilities {
    ret WatchCapabilities{supported: true, recursive: false, native: false, requires_scan: true};
}

pub def WatchEvent: u8;
pub val WATCH_UNCHANGED: WatchEvent = 0;
pub val WATCH_CREATED:   WatchEvent = 1;
pub val WATCH_REMOVED:   WatchEvent = 2;
pub val WATCH_REPLACED:  WatchEvent = 3;
pub val WATCH_MODIFIED:  WatchEvent = 4;
pub val WATCH_METADATA:  WatchEvent = 5;

# path: the UTF-8 path watch_init borrowed, nil for watch_init_native
# name: the watched name in native units, which every scan opens
pub rec Watch {
    root:        *Root;
    path:        Path;
    name:        os.NativePath;
    metadata:    filesystem.Metadata;
    identity:    filesystem.Identity;
    exists:      bool;
    initialized: bool;
}

fun watch_observe(root: *Root, name: *Unit, metadata: *filesystem.Metadata, identity: *filesystem.Identity) res[bool, io_error.Error] {
    val res_opened: res[filesystem.File, io_error.Error] = open_confined_native(root, name, read_options());
    if (sel res_opened.err) {
        if (res_opened.err.kind == io_error.NOT_FOUND) { ret res[bool, io_error.Error].ok{false}; }
        ret res[bool, io_error.Error].err{res_opened.err};
    }
    var file:           filesystem.File                          = res_opened.ok;
    val res_observed:   res[filesystem.Metadata, io_error.Error] = filesystem.stat_of(file);
    val res_identified: res[filesystem.Identity, io_error.Error] = filesystem.identity_of(file);
    val err_closed:     err[io_error.Error]                      = filesystem.close(?file);
    if (sel res_observed.err)   { ret res[bool, io_error.Error].err{res_observed.err}; }
    if (sel err_closed.err)     { ret res[bool, io_error.Error].err{err_closed.err}; }
    if (sel res_identified.err) { ret res[bool, io_error.Error].err{res_identified.err}; }
    @identity = res_identified.ok;
    @metadata = res_observed.ok;
    ret res[bool, io_error.Error].ok{true};
}

# the root and path remain borrowed until watch_dnit. the path is converted
# once here, and every scan opens the converted name
pub fun watch_init(watch: *Watch, root: *Root, path: Path) res[bool, io_error.Error] {
    if (watch == nil || root == nil || path == nil) {
        ret res[bool, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPEN)};
    }
    var name:      os.NativePath;
    val converted: i64 = platform.confined_name(path, ?name);
    if (converted < 0) { ret res[bool, io_error.Error].err{failure(converted, io_error.OP_OPEN)}; }
    val res_opened: res[bool, io_error.Error] = watch_start(watch, root, name);
    if (sel res_opened.err) {
        os.native_path_dnit(?name);
        ret res_opened;
    }
    watch.path = path;
    ret res_opened;
}

# watch_init for a relative name in native units; the root and name remain
# borrowed until watch_dnit
pub fun watch_init_native(watch: *Watch, root: *Root, name: *Unit) res[bool, io_error.Error] {
    if (watch == nil || root == nil || name == nil) {
        ret res[bool, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPEN)};
    }
    val res_opened: res[bool, io_error.Error] = watch_start(watch, root, os.NativePath{units: name, size: 0});
    if (sel res_opened.ok) { watch.path = nil; }
    ret res_opened;
}

# observe once and, on success, fill the watch with the name it now holds
fun watch_start(watch: *Watch, root: *Root, name: os.NativePath) res[bool, io_error.Error] {
    var metadata:     filesystem.Metadata;
    var identity:     filesystem.Identity;
    val res_observed: res[bool, io_error.Error] = watch_observe(root, name.units, ?metadata, ?identity);
    if (sel res_observed.err) { ret res[bool, io_error.Error].err{res_observed.err}; }
    if (watch.initialized)    { os.native_path_dnit(?watch.name); }
    watch.root   = root;
    watch.name   = name;
    watch.exists = res_observed.ok;
    if (watch.exists) {
        watch.metadata = metadata;
        watch.identity = identity;
    }
    watch.initialized = true;
    ret res[bool, io_error.Error].ok{watch.exists};
}

# scans observe identity without pinning it between calls or detecting every intervening write
pub fun watch_scan(watch: *Watch) res[WatchEvent, io_error.Error] {
    if (watch == nil || !watch.initialized) { ret res[WatchEvent, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_WAIT)}; }
    var metadata:     filesystem.Metadata;
    var identity:     filesystem.Identity;
    val res_observed: res[bool, io_error.Error] = watch_observe(watch.root, watch.name.units, ?metadata, ?identity);
    if (sel res_observed.err) { ret res[WatchEvent, io_error.Error].err{res_observed.err}; }
    val exists: bool = res_observed.ok;
    if (!watch.exists && !exists) { ret res[WatchEvent, io_error.Error].ok{WATCH_UNCHANGED}; }
    if (!watch.exists && exists) {
        watch.metadata = metadata;
        watch.identity = identity;
        watch.exists   = true;
        ret res[WatchEvent, io_error.Error].ok{WATCH_CREATED};
    }
    if (watch.exists && !exists) {
        watch.exists = false;
        ret res[WatchEvent, io_error.Error].ok{WATCH_REMOVED};
    }
    var event: WatchEvent = WATCH_UNCHANGED;
    if (!filesystem.identity_equal(watch.identity, identity))                                                 { event = WATCH_REPLACED; }
    or (watch.metadata.size != metadata.size || !time.time_equal(watch.metadata.modified, metadata.modified)) { event = WATCH_MODIFIED; }
    or (watch.metadata.kind != metadata.kind || watch.metadata.mode != metadata.mode)                         { event = WATCH_METADATA; }
    watch.metadata = metadata;
    watch.identity = identity;
    ret res[WatchEvent, io_error.Error].ok{event};
}

# releases the borrowed root and path and the converted name; a watch that
# was never opened is INVALID
pub fun watch_dnit(watch: *Watch) err[io_error.Error] {
    if (watch == nil || !watch.initialized) { ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_CLOSE)}; }
    os.native_path_dnit(?watch.name);
    watch.root        = nil;
    watch.path        = nil;
    watch.exists      = false;
    watch.initialized = false;
    ret err[io_error.Error].ok{};
}
