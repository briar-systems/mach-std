# line input from stdin
#
# the read-side twin of std.print: convenience wrappers that read whole lines
# from stdin, backed by the filesystem stdin file. this is plain canonical
# input -- it works on ttys, pipes, and file redirects with no tty required
# (raw single-key polling is std.terminal's concern).
#
# a line read has two failure classes: the reader's own outcome (the end of
# the stream, a stall, a native failure), which passes through as the ReadError
# with the bytes buffered so far as its progress, and a line the caller's
# buffer cannot hold, which is this module's own case.

use std.types.canonical.res;
use std.types.size.usize;
use std.types.string.str;

use std.io.reader;
use std.io.reader.ReadError;
use std.filesystem;

# every way a line read can fail
# ---
# read:     the reader failed; the payload's progress is the bytes buffered
#           before the outcome, and eof{0} is the end of input with nothing
#           buffered (a final line without a newline is not an error)
# too_long: the line does not fit; payload is the bytes buffered. the byte
#           that overflowed was consumed from the reader and dropped, so the
#           next call continues after it
pub tag InputError: u8 {
    read:     ReadError;
    too_long: usize;
}

fun stdin_reader(r: *reader.Reader) {
    @r = filesystem.reader(filesystem.STDIN);
}

# read one line from a reader into buf, up to cap bytes including the terminator
#
# reads a byte at a time until a newline, EOF, or the buffer fills. strips a
# trailing "\r\n" or "\n" and null-terminates; the returned length excludes the
# terminator. a line longer than cap-1 bytes is too_long rather than a silent
# truncation: the bytes that fit are in buf, the byte that overflowed has been
# consumed and dropped (a reader has no pushback), and the next call continues
# with the rest of the line. a read at end of input with no bytes buffered is
# read{eof{0}} -- distinct from an empty line, which is ok{0}.
# ---
# r:   reader to draw from
# buf: destination buffer
# cap: buffer capacity in bytes (at least 1 for the terminator; a zero cap
#      holds no line, so it is too_long{0} before anything is read)
# ret: line length excluding the terminator, or the failure
pub fun read_line_from(r: *reader.Reader, buf: *u8, cap: usize) res[usize, InputError] {
    if (cap == 0) { ret res[usize, InputError].err{InputError.too_long{0}}; }

    var len: usize = 0;
    for {
        var b:  u8 = 0;
        val rr: res[usize, ReadError] = reader.read(r, ?b, 1);
        if (sel rr.err) {
            if (!sel rr.err.eof) {
                buf[len] = 0;
                ret res[usize, InputError].err{InputError.read{reader.advance(rr.err, len)}};
            }
            if (len == 0) { ret res[usize, InputError].err{InputError.read{rr.err}}; }
            brk;  # a final line with no trailing newline
        }

        if (b == 10) { brk; }  # '\n' ends the line

        # only a content byte needs room; a terminator at len == cap-1 is fine
        if (len == cap - 1) {
            buf[len] = 0;
            ret res[usize, InputError].err{InputError.too_long{len}};
        }

        buf[len] = b;
        len = len + 1;
    }

    if (len > 0 && buf[len - 1] == 13) { len = len - 1; }  # drop a "\r\n" carriage return
    buf[len] = 0;
    ret res[usize, InputError].ok{len};
}

# read one line from stdin into buf, up to cap bytes including the terminator
#
# a thin wrapper over read_line_from drawing from the stdin file; see there for
# the trimming, truncation, and end-of-input semantics.
# ---
# buf: destination buffer
# cap: buffer capacity in bytes (must be at least 1 for the terminator)
# ret: line length excluding the terminator, or the failure
pub fun read_line(buf: *u8, cap: usize) res[usize, InputError] {
    var r: reader.Reader;
    stdin_reader(?r);
    ret read_line_from(?r, buf, cap);
}

use std.system.os;
use io_error: std.io.error;

# a reader over an in-memory byte range, for exercising read_line_from; it can
# be scripted to fail natively once `fail_at` bytes have been delivered
rec MemReader {
    data:    *u8;
    len:     usize;
    pos:     usize;
    fail_at: usize;
    code:    i64;
}

fun mem_read_cb(ctx: ptr, buf: *u8, n: usize) res[usize, ReadError] {
    val m: *MemReader = (ctx::usize)::*MemReader;
    if (m.code != 0 && m.pos >= m.fail_at) {
        ret res[usize, ReadError].err{reader.native_failure(0, io_error.from_code(m.code, io_error.OP_READ))};
    }
    var i: usize = 0;
    for (i < n && m.pos < m.len) {
        buf[i] = m.data[m.pos];
        m.pos  = m.pos + 1;
        i      = i + 1;
    }
    ret res[usize, ReadError].ok{i};
}

fun mem_reader(m: *MemReader) reader.Reader {
    var r: reader.Reader;
    r.ctx    = (m::usize)::ptr;
    r.f_read = mem_read_cb;
    ret r;
}

fun mem(data: str, len: usize) MemReader {
    ret MemReader{data: data, len: len, pos: 0, fail_at: 0, code: 0};
}

test "input.read_line_from: strips newline" {
    var m:   MemReader = mem("hello\nrest", 10);
    var rd:  reader.Reader = mem_reader(?m);
    var buf: [16]u8;

    val r: res[usize, InputError] = read_line_from(?rd, ?buf[0], 16);
    if (sel r.err)                      { ret 1; }
    if (r.ok != 5)                      { ret 2; }
    if (buf[0] != 'h' || buf[4] != 'o') { ret 3; }
    if (buf[5] != 0)                    { ret 4; }
    ret 0;
}

test "input.read_line_from: strips crlf" {
    var m:   MemReader = mem("ab\r\n", 4);
    var rd:  reader.Reader = mem_reader(?m);
    var buf: [16]u8;

    val r: res[usize, InputError] = read_line_from(?rd, ?buf[0], 16);
    if (sel r.err)   { ret 1; }
    if (r.ok != 2)   { ret 2; }
    if (buf[2] != 0) { ret 3; }
    ret 0;
}

test "input.read_line_from: final line without newline" {
    var m:   MemReader = mem("tail", 4);
    var rd:  reader.Reader = mem_reader(?m);
    var buf: [16]u8;

    val r: res[usize, InputError] = read_line_from(?rd, ?buf[0], 16);
    if (sel r.err) { ret 1; }
    if (r.ok != 4) { ret 2; }
    ret 0;
}

# an empty line is ok{0}; the end of input with nothing buffered is the
# reader's eof, distinct from it
test "input.read_line_from: an empty line and the end of input are distinct" {
    var m:   MemReader = mem("\n", 1);
    var rd:  reader.Reader = mem_reader(?m);
    var buf: [16]u8;

    val empty: res[usize, InputError] = read_line_from(?rd, ?buf[0], 16);
    if (sel empty.err) { ret 1; }
    if (empty.ok != 0) { ret 2; }
    if (buf[0] != 0)   { ret 3; }

    val end: res[usize, InputError] = read_line_from(?rd, ?buf[0], 16);
    if (!sel end.err)         { ret 4; }
    if (!sel end.err.read)    { ret 5; }
    if (!sel end.err.read.eof) { ret 6; }
    if (end.err.read.eof != 0) { ret 7; }
    ret 0;
}

# a line that does not fit reports the bytes buffered; the byte that
# overflowed is consumed, and the next call continues with the rest
test "input.read_line_from: line too long reports the buffered prefix" {
    var m:   MemReader = mem("toolong\n", 8);
    var rd:  reader.Reader = mem_reader(?m);
    var buf: [4]u8;

    val r: res[usize, InputError] = read_line_from(?rd, ?buf[0], 4);
    if (!sel r.err)          { ret 1; }
    if (!sel r.err.too_long) { ret 2; }
    if (r.err.too_long != 3) { ret 3; }
    if (buf[0] != 't' || buf[2] != 'o' || buf[3] != 0) { ret 4; }
    if (m.pos != 4)          { ret 5; }

    val rest: res[usize, InputError] = read_line_from(?rd, ?buf[0], 4);
    if (sel rest.err)        { ret 6; }
    if (rest.ok != 3)        { ret 7; }
    if (buf[0] != 'o' || buf[2] != 'g' || buf[3] != 0) { ret 8; }
    if (m.pos != 8)          { ret 9; }
    ret 0;
}

test "input.read_line_from: a zero capacity holds no line" {
    var m:   MemReader = mem("x\n", 2);
    var rd:  reader.Reader = mem_reader(?m);
    var buf: [4]u8;

    val r: res[usize, InputError] = read_line_from(?rd, ?buf[0], 0);
    if (!sel r.err)          { ret 1; }
    if (!sel r.err.too_long) { ret 2; }
    if (r.err.too_long != 0) { ret 3; }
    if (m.pos != 0)          { ret 4; }
    ret 0;
}

test "input.read_line_from: line of exactly cap-1 bytes fits" {
    var m:   MemReader = mem("abc\n", 4);
    var rd:  reader.Reader = mem_reader(?m);
    var buf: [4]u8;

    val r: res[usize, InputError] = read_line_from(?rd, ?buf[0], 4);
    if (sel r.err)                      { ret 1; }
    if (r.ok != 3)                      { ret 2; }
    if (buf[0] != 'a' || buf[2] != 'c') { ret 3; }
    if (buf[3] != 0)                    { ret 4; }
    ret 0;
}

# a reader that fails part way through a line reports the failure with the
# bytes it had delivered into the buffer, and a stall is classified apart
test "input.read_line_from: a reader failure after progress carries the prefix" {
    var m:   MemReader = mem("abcdef\n", 7);
    m.fail_at = 3;
    m.code = os.EIO;
    var rd:  reader.Reader = mem_reader(?m);
    var buf: [16]u8;

    val r: res[usize, InputError] = read_line_from(?rd, ?buf[0], 16);
    if (!sel r.err)               { ret 1; }
    if (!sel r.err.read)          { ret 2; }
    if (!sel r.err.read.native)   { ret 3; }
    if (r.err.read.native.delivered != 3) { ret 4; }
    if (r.err.read.native.error.code != os.EIO) { ret 5; }
    if (buf[0] != 'a' || buf[2] != 'c' || buf[3] != 0) { ret 6; }

    var n: MemReader = mem("xy\n", 3);
    n.fail_at = 2;
    n.code = os.EAGAIN;
    var rn: reader.Reader = mem_reader(?n);
    val blocked: res[usize, InputError] = read_line_from(?rn, ?buf[0], 16);
    if (!sel blocked.err)                  { ret 7; }
    if (!sel blocked.err.read)             { ret 8; }
    if (!sel blocked.err.read.would_block) { ret 9; }
    if (blocked.err.read.would_block != 2) { ret 10; }
    ret 0;
}
