# wall-clock time and monotonic instants with nanosecond precision
#
# Time is wall-clock time: seconds and nanoseconds since the Unix epoch
# (1970-01-01 00:00:00 UTC), which can jump when the system clock is set.
# Instant is monotonic: it counts from an unspecified start, never jumps, and
# has no calendar meaning. the two are distinct types with no conversion, so a
# deadline (always an Instant) cannot be built from the wall clock.

use std.chrono.duration.Duration;
use std.chrono.duration.MICROSECOND;
use std.chrono.duration.MILLISECOND;
use std.chrono.duration.SECOND;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;

use io_error: std.io.error;
use std.system.capability;

# the outcome of reading the wall clock
pub def Clock: res[Time, io_error.Error];
# the outcome of reading the monotonic clock
pub def InstantClock: res[Instant, io_error.Error];
# the outcome of measuring against a clock
pub def Elapsed: res[Duration, io_error.Error];

# a wall-clock time with nanosecond precision
#
# for dates, timestamps and logs. never a deadline or a timeout: those are
# Instants
# ---
# sec:  seconds since Unix epoch (1970-01-01 00:00:00 UTC)
# nsec: nanoseconds within second [0, 999999999]
pub rec Time {
    sec:  i64;
    nsec: i64;
}

# a monotonic instant with nanosecond precision
#
# read only from `instant`. it has no epoch meaning and is only compared with,
# or measured against, other Instants. every deadline in std is an Instant
# ---
# sec:  seconds since the monotonic clock's unspecified start
# nsec: nanoseconds within second [0, 999999999]
pub rec Instant {
    sec:  i64;
    nsec: i64;
}

# the clocks read the OS layer's clock group
$if (capability.HAS_CLOCK) {
    use std.system.os;

    # return the current wall-clock time
    #
    # a failed clock is reported, never replaced by the zero time. never use
    # this for a deadline or a timeout: see `instant`
    # ---
    # ret: current Time from the system clock, or the native refusal
    pub fun now() Clock {
        var ts:   os.Timespec;
        val code: i64 = os.realtime(?ts);
        if (code < 0) { ret Clock.err{os.error(code, io_error.OP_READ)}; }
        ret Clock.ok{Time{sec: ts.sec, nsec: ts.nsec}};
    }

    # return the current monotonic instant
    #
    # the clock for deadlines, timeouts and elapsed time. a deadline is
    # `instant_add(instant(), timeout)`
    # ---
    # ret: the current Instant, or the native refusal
    pub fun instant() InstantClock {
        var ts:   os.Timespec;
        val code: i64 = os.monotonic(?ts);
        if (code < 0) { ret InstantClock.err{os.error(code, io_error.OP_READ)}; }
        ret InstantClock.ok{Instant{sec: ts.sec, nsec: ts.nsec}};
    }

    # return the monotonic time elapsed since start
    # ---
    # start: an earlier Instant
    # ret:   the duration since start, or the monotonic clock's refusal
    pub fun elapsed(start: Instant) Elapsed {
        val current: InstantClock = instant();
        if (sel current.err) { ret Elapsed.err{current.err}; }
        ret Elapsed.ok{instant_sub(current.ok, start)};
    }

    # return how long remains until deadline, negative once it has passed
    # ---
    # deadline: the Instant to measure to
    # ret:      the duration until deadline, or the monotonic clock's refusal
    pub fun remaining(deadline: Instant) Elapsed {
        val current: InstantClock = instant();
        if (sel current.err) { ret Elapsed.err{current.err}; }
        ret Elapsed.ok{instant_sub(deadline, current.ok)};
    }

    # return the wall-clock time elapsed since t
    #
    # this is calendar time, which can jump. for elapsed time use `elapsed`
    # ---
    # t:   start time
    # ret: duration since t, or the wall clock's refusal
    pub fun since(t: Time) Elapsed {
        val current: Clock = now();
        if (sel current.err) { ret Elapsed.err{current.err}; }
        ret Elapsed.ok{time_sub(current.ok, t)};
    }

    # return the wall-clock duration until t
    #
    # this is calendar time, which can jump. for a deadline use `remaining`
    # ---
    # t:   target time
    # ret: duration until t, or the wall clock's refusal
    pub fun until(t: Time) Elapsed {
        val current: Clock = now();
        if (sel current.err) { ret Elapsed.err{current.err}; }
        ret Elapsed.ok{time_sub(t, current.ok)};
    }
}

# create a Time from a Unix timestamp
# ---
# sec:  seconds since Unix epoch
# nsec: nanoseconds within second
# ret:  Time with nsec normalized to [0, 999999999]
pub fun unix(sec: i64, nsec: i64) Time {
    var s: i64 = sec;
    var n: i64 = nsec;

    if (n >= SECOND) {
        s = s + n / SECOND;
        n = n % SECOND;
    }
    if (n < 0) {
        val borrow: i64 = (0 - n - 1) / SECOND + 1;
        s = s - borrow;
        n = n + borrow * SECOND;
    }

    ret Time{sec: s, nsec: n};
}

# return seconds since Unix epoch
# ---
# t:   time to query
# ret: seconds component
pub fun time_unix_sec(t: Time) i64 {
    ret t.sec;
}

# return nanoseconds since Unix epoch
# ---
# t:   time to query
# ret: total nanoseconds since epoch
pub fun time_unix_nsec(t: Time) i64 {
    ret t.sec * SECOND + t.nsec;
}

# return microseconds since Unix epoch
# ---
# t:   time to query
# ret: total microseconds since epoch
pub fun time_unix_usec(t: Time) i64 {
    ret t.sec * (SECOND / MICROSECOND) + t.nsec / MICROSECOND;
}

# return milliseconds since Unix epoch
# ---
# t:   time to query
# ret: total milliseconds since epoch
pub fun time_unix_msec(t: Time) i64 {
    ret t.sec * (SECOND / MILLISECOND) + t.nsec / MILLISECOND;
}

# return t + d
# ---
# t:   base time
# d:   duration to add
# ret: new Time offset by d
pub fun time_add(t: Time, d: Duration) Time {
    var sec:  i64 = t.sec + d / SECOND;
    var nsec: i64 = t.nsec + d % SECOND;

    if (nsec >= SECOND) {
        sec  = sec + 1;
        nsec = nsec - SECOND;
    }
    if (nsec < 0) {
        sec  = sec - 1;
        nsec = nsec + SECOND;
    }

    ret Time{sec: sec, nsec: nsec};
}

# return the duration t - u
# ---
# t:   minuend time
# u:   subtrahend time
# ret: duration between t and u
pub fun time_sub(t: Time, u: Time) Duration {
    ret (t.sec - u.sec) * SECOND + (t.nsec - u.nsec);
}

# report whether t is before u
# ---
# t:   time to test
# u:   time to compare against
# ret: true if t < u
pub fun time_before(t: Time, u: Time) bool {
    if (t.sec < u.sec) { ret true; }
    if (t.sec > u.sec) { ret false; }
    ret t.nsec < u.nsec;
}

# report whether t is after u
# ---
# t:   time to test
# u:   time to compare against
# ret: true if t > u
pub fun time_after(t: Time, u: Time) bool {
    if (t.sec > u.sec) { ret true; }
    if (t.sec < u.sec) { ret false; }
    ret t.nsec > u.nsec;
}

# report whether t and u represent the same instant
# ---
# t:   first time
# u:   second time
# ret: true if t == u
pub fun time_equal(t: Time, u: Time) bool {
    ret t.sec == u.sec && t.nsec == u.nsec;
}

# report whether t represents the zero time instant
# ---
# t:   time to test
# ret: true if t is the zero time (Unix epoch)
pub fun time_is_zero(t: Time) bool {
    ret t.sec == 0 && t.nsec == 0;
}

# return i + d
# ---
# i:   base instant
# d:   duration to add
# ret: the instant offset by d
pub fun instant_add(i: Instant, d: Duration) Instant {
    val t: Time = time_add(Time{sec: i.sec, nsec: i.nsec}, d);
    ret Instant{sec: t.sec, nsec: t.nsec};
}

# return the duration i - j
# ---
# i:   minuend instant
# j:   subtrahend instant
# ret: duration between i and j
pub fun instant_sub(i: Instant, j: Instant) Duration {
    ret (i.sec - j.sec) * SECOND + (i.nsec - j.nsec);
}

# report whether i is before j
# ---
# i:   instant to test
# j:   instant to compare against
# ret: true if i < j
pub fun instant_before(i: Instant, j: Instant) bool {
    if (i.sec < j.sec) { ret true; }
    if (i.sec > j.sec) { ret false; }
    ret i.nsec < j.nsec;
}

# report whether i is after j
# ---
# i:   instant to test
# j:   instant to compare against
# ret: true if i > j
pub fun instant_after(i: Instant, j: Instant) bool {
    ret instant_before(j, i);
}

# report whether i and j are the same instant
# ---
# i:   first instant
# j:   second instant
# ret: true if i == j
pub fun instant_equal(i: Instant, j: Instant) bool {
    ret i.sec == j.sec && i.nsec == j.nsec;
}

test time__instant_arithmetic_normalizes_and_orders {
    val base:  Instant = Instant{sec: 10, nsec: 900000000};
    val later: Instant = instant_add(base, 200 * MILLISECOND);
    if (later.sec != 11 || later.nsec != 100000000)                  { ret 1; }
    if (instant_sub(later, base) != 200 * MILLISECOND)               { ret 2; }
    if (!instant_before(base, later) || !instant_after(later, base)) { ret 3; }
    if (!instant_equal(base, Instant{sec: 10, nsec: 900000000}))     { ret 4; }
    val earlier: Instant = instant_add(base, 0 - 950 * MILLISECOND);
    if (earlier.sec != 9 || earlier.nsec != 950000000) { ret 5; }
    ret 0;
}

test unix__normalizes_nsec_both_ways {
    val over: Time = unix(100, 2500000000);
    if (over.sec != 102 || over.nsec != 500000000) { ret 1; }
    val under: Time = unix(100, -500000000);
    if (under.sec != 99 || under.nsec != 500000000) { ret 2; }
    ret 0;
}

test time_add__carries_and_borrows_nsec {
    val carry: Time = time_add(unix(100, 800000000), 500 * MILLISECOND);
    if (carry.sec != 101 || carry.nsec != 300000000) { ret 1; }
    val borrow: Time = time_add(unix(100, 100000000), 0 - 5 * SECOND - 200 * MILLISECOND);
    if (borrow.sec != 94 || borrow.nsec != 900000000) { ret 2; }
    if (time_sub(unix(100, 500000000), unix(95, 0)) != 5500000000) { ret 3; }
    ret 0;
}

test time_before_after__order_by_sec_then_nsec {
    val t1: Time = unix(100, 900);
    val t2: Time = unix(200, 0);
    val t3: Time = unix(100, 901);
    if (!time_before(t1, t2) || time_before(t2, t1)) { ret 1; }
    if (!time_after(t2, t1) || time_after(t1, t2))   { ret 2; }
    if (!time_before(t1, t3) || !time_after(t3, t1)) { ret 3; }
    if (time_before(t1, t1) || time_after(t1, t1))   { ret 4; }
    ret 0;
}

$if (capability.HAS_CLOCK) {
    test clock__wall_and_monotonic_read_and_measure {
        val t: Clock = now();
        if (sel t.err)             { ret 1; }
        if (t.ok.sec < 1000000000) { ret 2; }
        val d: Elapsed = until(unix(1000000000, 0));
        if (sel d.err || d.ok >= 0) { ret 3; }
        val start: InstantClock = instant();
        if (sel start.err) { ret 4; }
        val gone: Elapsed = elapsed(start.ok);
        if (!(sel gone.ok && gone.ok >= 0)) { ret 5; }
        val left: Elapsed = remaining(instant_add(start.ok, 3600000000000));
        if (sel left.err)                            { ret 6; }
        if (left.ok <= 0 || left.ok > 3600000000000) { ret 7; }
        ret 0;
    }
}
