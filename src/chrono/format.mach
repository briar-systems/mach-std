# date and time formatting and reading
#
# provides formatters for standard time representations, and the reader of the
# RFC 3339 forms they write.
# intended usage: `use fmt: std.chrono.format;` then
# `fmt.rfc3339(dt, fmt.Fraction.digits{3}, buf, len)`.

use std.chrono.date.Date;
use std.chrono.date.Datetime;
use std.chrono.date.LocalDatetime;
use std.chrono.date.TimeOfDay;
use std.chrono.date.civil_to_days;
use std.chrono.date.date_is_valid;
use std.chrono.date.datetime_from_time;
use std.chrono.date.datetime_is_valid;
use std.chrono.date.datetime_local;
use std.chrono.date.datetime_with_offset;
use std.chrono.date.local_date;
use std.chrono.date.local_datetime;
use std.chrono.date.local_datetime_is_valid;
use std.chrono.date.local_time_of_day;
use std.chrono.date.local_with_offset;
use std.chrono.date.time_of_day_is_valid;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;

$if (capability.HOSTED) {
    use std.chrono.time.unix;
}

use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

val SECONDS_PER_HOUR:   i64 = 3600;
val SECONDS_PER_MINUTE: i64 = 60;

# the offsets RFC 2822 can spell: its hour has two digits
val RFC2822_OFFSET_LIMIT: u64 = 360000;

# every way reading a date or time can fail
# ---
# syntax: the byte at the payload offset is not what the grammar allows there:
#         a missing digit, separator or offset, or the text ends early
# range:  the field starting at the payload offset is outside its range: a
#         month past 12, a day past its month's length, an hour past 23, a
#         minute past 59, a second past 60, or a second of 60 where no leap
#         second can fall
pub tag ReadError: u8 {
    syntax: usize;
    range:  usize;
}

# a date or time value in one of the forms RFC 3339 builds
# ---
# date:     full-date: a calendar date
# time:     partial-time: a time of day
# local:    full-date, separator, partial-time: a local datetime (ISO 8601's
#           form without an offset)
# datetime: date-time: a datetime with its offset
pub tag Stamp: u8 {
    date:     Date;
    time:     TimeOfDay;
    local:    LocalDatetime;
    datetime: Datetime;
}

# how a writer spells the fraction of a second, which RFC 3339 leaves to it
# ---
# shortest:            the fewest digits that hold nsec exactly, none for a
#                      whole second: what reads back to the same value
# digits:              exactly this many digits, 0 to 9, nsec past them
#                      truncated and zeros written, so every value has one width
# digits_unless_whole: this many digits as `digits` writes them, and none when
#                      they are all zero
pub tag Fraction: u8 {
    shortest;
    digits:              u8;
    digits_unless_whole: u8;
}

# a value read and the bytes it took
# ---
# stamp: the value read
# size:  bytes of the span it took
pub rec StampRead {
    stamp: Stamp;
    size:  usize;
}

# write a Datetime as RFC 3339 into a buffer
#
# output: YYYY-MM-DDTHH:MM:SS, the fraction of a second as `fraction` states
# it, then the offset: Z for a known offset of zero (RFC 3339's spelling of
# UTC, which +00:00 means too), -00:00 for an unknown one, else +HH:MM or
# -HH:MM. reads back through read_rfc3339 to the same fields when the fraction
# keeps every digit of nsec
# ---
# dt:       datetime to format
# fraction: how the fraction of a second is written
# buf:      output buffer (at least 36 bytes)
# len:      buffer length
# ret:      bytes written (excluding null terminator), 0 if buffer too small,
#           the year is outside [0, 9999], the offset is not a whole number of
#           minutes, the fraction asks for more than 9 digits, or dt is not
#           valid (datetime_is_valid)
pub fun rfc3339(dt: Datetime, fraction: Fraction, buf: *u8, len: usize) usize {
    if (buf == nil || len < 36)                                     { ret 0; }
    if (!datetime_is_valid(dt) || !year_fits(dt.year))              { ret 0; }
    if (offset_magnitude(dt.offset) % SECONDS_PER_MINUTE::u64 != 0) { ret 0; }
    if (!fraction_fits(fraction))                                   { ret 0; }

    var pos: usize = write_local(buf, datetime_local(dt), fraction);

    if (dt.offset_unknown) {
        buf[pos]     = '-';
        buf[pos + 1] = '0';
        buf[pos + 2] = '0';
        buf[pos + 3] = ':';
        buf[pos + 4] = '0';
        buf[pos + 5] = '0';
        pos          = pos + 6;
    }
    or (dt.offset == 0) {
        buf[pos] = 'Z';
        pos      = pos + 1;
    }
    or {
        buf[pos] = '+';
        if (dt.offset < 0) { buf[pos] = '-'; }

        val off_sec: i64 = offset_magnitude(dt.offset)::i64;
        val off_hr:  i64 = off_sec / SECONDS_PER_HOUR;
        val off_min: i64 = off_sec % SECONDS_PER_HOUR / SECONDS_PER_MINUTE;
        write_d2(buf, pos + 1, off_hr);
        buf[pos + 3] = ':';
        write_d2(buf, pos + 4, off_min);
        pos = pos + 6;
    }

    buf[pos] = 0;
    ret pos;
}

# write a Date as RFC 3339 full-date into a buffer
#
# output: YYYY-MM-DD
# ---
# d:   date to format
# buf: output buffer (at least 11 bytes)
# len: buffer length
# ret: bytes written (excluding null terminator), 0 if buffer too small, the
#      year is outside [0, 9999], or d is not valid (date_is_valid)
pub fun rfc3339_date(d: Date, buf: *u8, len: usize) usize {
    if (buf == nil || len < 11)                  { ret 0; }
    if (!date_is_valid(d) || !year_fits(d.year)) { ret 0; }

    write_date(buf, d);
    buf[10] = 0;

    ret 10;
}

# write a TimeOfDay as RFC 3339 partial-time into a buffer
#
# output: HH:MM:SS, the fraction of a second as `fraction` states it
# ---
# t:        time of day to format
# fraction: how the fraction of a second is written
# buf:      output buffer (at least 19 bytes)
# len:      buffer length
# ret:      bytes written (excluding null terminator), 0 if buffer too small,
#           the fraction asks for more than 9 digits, or t is not valid
#           (time_of_day_is_valid)
pub fun rfc3339_time(t: TimeOfDay, fraction: Fraction, buf: *u8, len: usize) usize {
    if (buf == nil || len < 19)                               { ret 0; }
    if (!time_of_day_is_valid(t) || !fraction_fits(fraction)) { ret 0; }

    val pos: usize = write_time(buf, 0, t, fraction);
    buf[pos] = 0;
    ret pos;
}

# write a LocalDatetime as RFC 3339 full-date and partial-time into a buffer
#
# output: YYYY-MM-DDTHH:MM:SS, the fraction of a second as `fraction` states
# it, and no offset
# ---
# ldt:      local datetime to format
# fraction: how the fraction of a second is written
# buf:      output buffer (at least 30 bytes)
# len:      buffer length
# ret:      bytes written (excluding null terminator), 0 if buffer too small,
#           the year is outside [0, 9999], the fraction asks for more than 9
#           digits, or ldt is not valid (local_datetime_is_valid)
pub fun rfc3339_local(ldt: LocalDatetime, fraction: Fraction, buf: *u8, len: usize) usize {
    if (buf == nil || len < 30)                                { ret 0; }
    if (!local_datetime_is_valid(ldt) || !year_fits(ldt.year)) { ret 0; }
    if (!fraction_fits(fraction))                              { ret 0; }

    val pos: usize = write_local(buf, ldt, fraction);
    buf[pos] = 0;
    ret pos;
}

# read the RFC 3339 date or time value at the start of a span
#
# reads the longest of the four forms there: a full-date, a partial-time, or a
# full-date and partial-time joined by T, t or a space (the readability form
# RFC 3339 section 5.6 permits) and then either an offset or none. a space
# joins them only when a partial-time's hour and colon follow it, so a date
# followed by a space and other text is a date. a T or t commits to a time.
# Z, z and +00:00 are UTC, and -00:00 is UTC with the local offset unknown
# (RFC 3339 section 4.3), read as offset 0 with offset_unknown set. fraction digits past the ninth are read and dropped, never rounded.
# every field is checked against its range (date_is_valid,
# time_of_day_is_valid, datetime_is_valid), so a value is refused, never
# normalized.
# ---
# s:   the span's bytes
# len: the span's length
# ret: the value and the bytes it took, or the failure positioned in the span
pub fun read_rfc3339(s: *u8, len: usize) res[StampRead, ReadError] {
    var i: usize = 0;
    if (is_time_start(s, len, 0)) {
        val res_time: res[TimeOfDay, ReadError] = read_time(s, len, ?i);
        if (sel res_time.err) { ret res[StampRead, ReadError].err{res_time.err}; }
        ret stamp_read(Stamp.time{res_time.ok}, i);
    }

    val res_date: res[Date, ReadError] = read_date(s, len, ?i);
    if (sel res_date.err) { ret res[StampRead, ReadError].err{res_date.err}; }
    var joined: bool = i < len && (s[i] == 'T' || s[i] == 't');
    if (i < len && s[i] == ' ' && is_time_start(s, len, i + 1)) { joined = true; }
    if (!joined)                                                { ret stamp_read(Stamp.date{res_date.ok}, i); }
    i = i + 1;

    val second_at: usize                     = i + 6;
    val res_time:  res[TimeOfDay, ReadError] = read_time(s, len, ?i);
    if (sel res_time.err) { ret res[StampRead, ReadError].err{res_time.err}; }
    val ldt: LocalDatetime = local_datetime(res_date.ok, res_time.ok);
    if (i >= len || !is_offset_start(s[i])) { ret stamp_read(Stamp.local{ldt}, i); }

    val unknown:    bool                = is_unknown_offset(s, len, i);
    val res_offset: res[i64, ReadError] = read_offset(s, len, ?i);
    if (sel res_offset.err) { ret res[StampRead, ReadError].err{res_offset.err}; }
    var dt: Datetime = local_with_offset(ldt, res_offset.ok);
    dt.offset_unknown = unknown;
    # the fields and the offset are in range, so only a leap second can fail here
    if (!datetime_is_valid(dt)) { ret res[StampRead, ReadError].err{ReadError.range{second_at}}; }
    ret stamp_read(Stamp.datetime{dt}, i);
}

# write a Datetime as RFC 2822 into a buffer
#
# output: Fri, 13 Feb 2009 23:31:30 +0000, with -0000 for an unknown offset
# (RFC 2822 section 3.3)
# ---
# dt:  datetime to format
# buf: output buffer (at least 32 bytes)
# len: buffer length
# ret: bytes written (excluding null terminator), 0 if buffer too small, the
#      year is outside [0, 9999], the offset's hours do not fit two digits,
#      the offset is not a whole number of minutes, or the date or the time
#      of day is not valid
pub fun rfc2822(dt: Datetime, buf: *u8, len: usize) usize {
    if (buf == nil || len < 32)                                              { ret 0; }
    if (!local_datetime_is_valid(datetime_local(dt)) || !year_fits(dt.year)) { ret 0; }
    if (offset_magnitude(dt.offset) >= RFC2822_OFFSET_LIMIT)                 { ret 0; }
    if (offset_magnitude(dt.offset) % SECONDS_PER_MINUTE::u64 != 0)          { ret 0; }

    val dow: i64 = day_of_week(dt.year, dt.month, dt.day);
    write_dow(buf, 0, dow);
    buf[3] = ',';
    buf[4] = ' ';
    write_d2(buf, 5, dt.day);
    buf[7] = ' ';
    write_month(buf, 8, dt.month);
    buf[11] = ' ';
    write_d4(buf, 12, dt.year);
    buf[16] = ' ';
    write_d2(buf, 17, dt.hour);
    buf[19] = ':';
    write_d2(buf, 20, dt.minute);
    buf[22] = ':';
    write_d2(buf, 23, dt.second);
    buf[25] = ' ';

    buf[26] = '+';
    if (dt.offset < 0 || dt.offset_unknown) { buf[26] = '-'; }

    val off_sec: i64 = offset_magnitude(dt.offset)::i64;
    val off_hr:  i64 = off_sec / SECONDS_PER_HOUR;
    val off_min: i64 = off_sec % SECONDS_PER_HOUR / SECONDS_PER_MINUTE;
    write_d2(buf, 27, off_hr);
    write_d2(buf, 29, off_min);
    buf[31] = 0;

    ret 31;
}

# write seconds as decimal Unix timestamp into a buffer
# ---
# sec: seconds since epoch
# buf: output buffer (at least 21 bytes)
# len: buffer length
# ret: bytes written (excluding null terminator), 0 if buffer too small
pub fun unix_sec(sec: i64, buf: *u8, len: usize) usize {
    if (buf == nil || len < 21) { ret 0; }

    # the magnitude in u64, which holds that of the smallest i64
    var v:   u64 = sec:~u64;
    var neg: i64 = 0;
    if (sec < 0) {
        neg = 1;
        v   = 0 - v;
    }

    var digits: [20]u8;
    var count:  usize = 0;

    if (v == 0) {
        digits[0] = 48;
        count     = 1;
    }
    or {
        for (v > 0) {
            digits[count] = (v % 10 + 48)::u8;
            v             = v / 10;
            count         = count + 1;
        }
    }

    var pos: usize = 0;
    if (neg == 1) {
        buf[0] = '-';
        pos    = 1;
    }

    var i: usize = 0;
    for (i < count) {
        buf[pos] = digits[count - 1 - i];
        pos      = pos + 1;
        i        = i + 1;
    }

    buf[pos] = 0;
    ret pos;
}

fun stamp_read(stamp: Stamp, size: usize) res[StampRead, ReadError] {
    ret res[StampRead, ReadError].ok{StampRead{stamp: stamp, size: size}};
}

# whether a partial-time's hour and colon start at s[at]
fun is_time_start(s: *u8, len: usize, at: usize) bool {
    if (at + 3 > len) { ret false; }
    ret is_digit(s[at]) && is_digit(s[at + 1]) && s[at + 2] == ':';
}

# whether RFC 3339's unknown local offset, -00:00, starts at s[at]
fun is_unknown_offset(s: *u8, len: usize, at: usize) bool {
    if (at + 6 > len) { ret false; }
    ret s[at] == '-' && s[at + 1] == '0' && s[at + 2] == '0' && s[at + 3] == ':' && s[at + 4] == '0' && s[at + 5] == '0';
}

fun is_offset_start(b: u8) bool {
    ret b == 'Z' || b == 'z' || b == '+' || b == '-';
}

fun is_digit(b: u8) bool {
    ret b >= '0' && b <= '9';
}

# the value of n digits at the cursor, which moves past them
fun read_digits(s: *u8, len: usize, i: *usize, n: usize) res[i64, ReadError] {
    var v: i64   = 0;
    var k: usize = 0;
    for (k < n) {
        if (@i >= len || !is_digit(s[@i])) { ret res[i64, ReadError].err{ReadError.syntax{@i}}; }
        v  = v * 10 + (s[@i] - '0')::i64;
        @i = @i + 1;
        k  = k + 1;
    }
    ret res[i64, ReadError].ok{v};
}

# step the cursor past byte c
fun read_byte(s: *u8, len: usize, i: *usize, c: u8) err[ReadError] {
    if (@i >= len || s[@i] != c) { ret err[ReadError].err{ReadError.syntax{@i}}; }
    @i = @i + 1;
    ret err[ReadError].ok{};
}

# full-date: YYYY-MM-DD
fun read_date(s: *u8, len: usize, i: *usize) res[Date, ReadError] {
    val at:       usize               = @i;
    val res_year: res[i64, ReadError] = read_digits(s, len, i, 4);
    if (sel res_year.err) { ret res[Date, ReadError].err{res_year.err}; }
    val err_dash: err[ReadError] = read_byte(s, len, i, '-');
    if (sel err_dash.err) { ret res[Date, ReadError].err{err_dash.err}; }
    val res_month: res[i64, ReadError] = read_digits(s, len, i, 2);
    if (sel res_month.err) { ret res[Date, ReadError].err{res_month.err}; }
    val err_dash2: err[ReadError] = read_byte(s, len, i, '-');
    if (sel err_dash2.err) { ret res[Date, ReadError].err{err_dash2.err}; }
    val res_day: res[i64, ReadError] = read_digits(s, len, i, 2);
    if (sel res_day.err) { ret res[Date, ReadError].err{res_day.err}; }

    val d: Date = Date{year: res_year.ok, month: res_month.ok, day: res_day.ok};
    if (d.month < 1 || d.month > 12) { ret res[Date, ReadError].err{ReadError.range{at + 5}}; }
    if (!date_is_valid(d))           { ret res[Date, ReadError].err{ReadError.range{at + 8}}; }
    ret res[Date, ReadError].ok{d};
}

# partial-time: HH:MM:SS, then optionally a dot and one or more digits
fun read_time(s: *u8, len: usize, i: *usize) res[TimeOfDay, ReadError] {
    val at:       usize               = @i;
    val res_hour: res[i64, ReadError] = read_digits(s, len, i, 2);
    if (sel res_hour.err) { ret res[TimeOfDay, ReadError].err{res_hour.err}; }
    val err_colon: err[ReadError] = read_byte(s, len, i, ':');
    if (sel err_colon.err) { ret res[TimeOfDay, ReadError].err{err_colon.err}; }
    val res_minute: res[i64, ReadError] = read_digits(s, len, i, 2);
    if (sel res_minute.err) { ret res[TimeOfDay, ReadError].err{res_minute.err}; }
    val err_colon2: err[ReadError] = read_byte(s, len, i, ':');
    if (sel err_colon2.err) { ret res[TimeOfDay, ReadError].err{err_colon2.err}; }
    val res_second: res[i64, ReadError] = read_digits(s, len, i, 2);
    if (sel res_second.err) { ret res[TimeOfDay, ReadError].err{res_second.err}; }

    var nsec: i64 = 0;
    if (@i < len && s[@i] == '.') {
        @i = @i + 1;
        if (@i >= len || !is_digit(s[@i])) { ret res[TimeOfDay, ReadError].err{ReadError.syntax{@i}}; }
        var scale: i64 = 100000000;
        for (@i < len && is_digit(s[@i])) {
            nsec  = nsec + (s[@i] - '0')::i64 * scale;
            scale = scale / 10;
            @i    = @i + 1;
        }
    }

    val t: TimeOfDay = TimeOfDay{hour: res_hour.ok, minute: res_minute.ok, second: res_second.ok, nsec: nsec};
    if (t.hour > 23)   { ret res[TimeOfDay, ReadError].err{ReadError.range{at}}; }
    if (t.minute > 59) { ret res[TimeOfDay, ReadError].err{ReadError.range{at + 3}}; }
    if (t.second > 60) { ret res[TimeOfDay, ReadError].err{ReadError.range{at + 6}}; }
    ret res[TimeOfDay, ReadError].ok{t};
}

# time-offset: Z, z, or a sign and HH:MM, as seconds east of UTC
fun read_offset(s: *u8, len: usize, i: *usize) res[i64, ReadError] {
    if (s[@i] == 'Z' || s[@i] == 'z') {
        @i = @i + 1;
        ret res[i64, ReadError].ok{0};
    }
    var sign: i64 = 1;
    if (s[@i] == '-') { sign = -1; }
    @i = @i + 1;
    val hour_at:  usize               = @i;
    val res_hour: res[i64, ReadError] = read_digits(s, len, i, 2);
    if (sel res_hour.err) { ret res_hour; }
    val err_colon: err[ReadError] = read_byte(s, len, i, ':');
    if (sel err_colon.err) { ret res[i64, ReadError].err{err_colon.err}; }
    val res_minute: res[i64, ReadError] = read_digits(s, len, i, 2);
    if (sel res_minute.err) { ret res_minute; }
    if (res_hour.ok > 23)   { ret res[i64, ReadError].err{ReadError.range{hour_at}}; }
    if (res_minute.ok > 59) { ret res[i64, ReadError].err{ReadError.range{hour_at + 3}}; }
    ret res[i64, ReadError].ok{sign * (res_hour.ok * SECONDS_PER_HOUR + res_minute.ok * SECONDS_PER_MINUTE)};
}

# whether a year has the four digits RFC 3339 gives it
fun year_fits(year: i64) bool {
    ret year >= 0 && year <= 9999;
}

# write YYYY-MM-DD at buf[0]
fun write_date(buf: *u8, d: Date) {
    write_d4(buf, 0, d.year);
    buf[4] = '-';
    write_d2(buf, 5, d.month);
    buf[7] = '-';
    write_d2(buf, 8, d.day);
}

# write HH:MM:SS and the fraction at buf[off], returning the offset past them
fun write_time(buf: *u8, off: usize, t: TimeOfDay, fraction: Fraction) usize {
    write_d2(buf, off, t.hour);
    buf[off + 2] = ':';
    write_d2(buf, off + 3, t.minute);
    buf[off + 5] = ':';
    write_d2(buf, off + 6, t.second);
    ret write_fraction(buf, off + 8, t.nsec, fraction);
}

# write YYYY-MM-DDTHH:MM:SS and the fraction at buf[0], returning the offset past them
fun write_local(buf: *u8, ldt: LocalDatetime, fraction: Fraction) usize {
    write_date(buf, local_date(ldt));
    buf[10] = 'T';
    ret write_time(buf, 11, local_time_of_day(ldt), fraction);
}

# whether a fraction asks for no more digits than nsec has
fun fraction_fits(fraction: Fraction) bool {
    if (sel fraction.digits)              { ret fraction.digits <= 9; }
    if (sel fraction.digits_unless_whole) { ret fraction.digits_unless_whole <= 9; }
    ret true;
}

# write a dot and the fraction of a second nsec is, as `fraction` states it, at
# buf[off], returning the offset past it; nothing when it writes no digit
fun write_fraction(buf: *u8, off: usize, nsec: i64, fraction: Fraction) usize {
    if (sel fraction.shortest) {
        if (nsec == 0) { ret off; }
        buf[off] = '.';
        write_d9(buf, off + 1, nsec);
        var end: usize = off + 10;
        for (buf[end - 1] == '0') {
            end = end - 1;
        }
        ret end;
    }

    var count: u8   = 0;
    var whole: bool = false;
    if (sel fraction.digits) { count = fraction.digits; }
    if (sel fraction.digits_unless_whole) {
        count = fraction.digits_unless_whole;
        whole = true;
    }
    if (count == 0) { ret off; }

    # nsec cut to its first `count` digits
    var kept: i64 = nsec;
    var k:    u8  = 9;
    for (k > count) {
        kept = kept / 10;
        k    = k - 1;
    }
    if (whole && kept == 0) { ret off; }

    buf[off] = '.';
    write_d9(buf, off + 1, nsec);
    ret off + 1 + count::usize;
}

# the magnitude of a utc offset in u64, which holds that of the smallest i64
fun offset_magnitude(offset: i64) u64 {
    var v: u64 = offset:~u64;
    if (offset < 0) { v = 0 - v; }
    ret v;
}

fun day_of_week(y: i64, m: i64, d: i64) i64 {
    val epoch_days: i64 = civil_to_days(y, m, d);
    var dow:        i64 = (epoch_days + 4) % 7;
    if (dow < 0) { dow = dow + 7; }
    ret dow;
}

fun write_dow(buf: *u8, off: usize, dow: i64) {
    if (dow == 0) {
        buf[off]     = 'S';
        buf[off + 1] = 'u';
        buf[off + 2] = 'n';
    }
    or (dow == 1) {
        buf[off]     = 'M';
        buf[off + 1] = 'o';
        buf[off + 2] = 'n';
    }
    or (dow == 2) {
        buf[off]     = 'T';
        buf[off + 1] = 'u';
        buf[off + 2] = 'e';
    }
    or (dow == 3) {
        buf[off]     = 'W';
        buf[off + 1] = 'e';
        buf[off + 2] = 'd';
    }
    or (dow == 4) {
        buf[off]     = 'T';
        buf[off + 1] = 'h';
        buf[off + 2] = 'u';
    }
    or (dow == 5) {
        buf[off]     = 'F';
        buf[off + 1] = 'r';
        buf[off + 2] = 'i';
    }
    or (dow == 6) {
        buf[off]     = 'S';
        buf[off + 1] = 'a';
        buf[off + 2] = 't';
    }
}

fun write_month(buf: *u8, off: usize, m: i64) {
    if (m == 1) {
        buf[off]     = 'J';
        buf[off + 1] = 'a';
        buf[off + 2] = 'n';
    }
    or (m == 2) {
        buf[off]     = 'F';
        buf[off + 1] = 'e';
        buf[off + 2] = 'b';
    }
    or (m == 3) {
        buf[off]     = 'M';
        buf[off + 1] = 'a';
        buf[off + 2] = 'r';
    }
    or (m == 4) {
        buf[off]     = 'A';
        buf[off + 1] = 'p';
        buf[off + 2] = 'r';
    }
    or (m == 5) {
        buf[off]     = 'M';
        buf[off + 1] = 'a';
        buf[off + 2] = 'y';
    }
    or (m == 6) {
        buf[off]     = 'J';
        buf[off + 1] = 'u';
        buf[off + 2] = 'n';
    }
    or (m == 7) {
        buf[off]     = 'J';
        buf[off + 1] = 'u';
        buf[off + 2] = 'l';
    }
    or (m == 8) {
        buf[off]     = 'A';
        buf[off + 1] = 'u';
        buf[off + 2] = 'g';
    }
    or (m == 9) {
        buf[off]     = 'S';
        buf[off + 1] = 'e';
        buf[off + 2] = 'p';
    }
    or (m == 10) {
        buf[off]     = 'O';
        buf[off + 1] = 'c';
        buf[off + 2] = 't';
    }
    or (m == 11) {
        buf[off]     = 'N';
        buf[off + 1] = 'o';
        buf[off + 2] = 'v';
    }
    or (m == 12) {
        buf[off]     = 'D';
        buf[off + 1] = 'e';
        buf[off + 2] = 'c';
    }
}

fun write_d2(buf: *u8, off: usize, v: i64) {
    buf[off]     = (v / 10 % 10 + 48)::u8;
    buf[off + 1] = (v % 10 + 48)::u8;
}

fun write_d4(buf: *u8, off: usize, v: i64) {
    buf[off]     = (v / 1000 % 10 + 48)::u8;
    buf[off + 1] = (v / 100 % 10 + 48)::u8;
    buf[off + 2] = (v / 10 % 10 + 48)::u8;
    buf[off + 3] = (v % 10 + 48)::u8;
}

fun write_d9(buf: *u8, off: usize, v: i64) {
    buf[off]     = (v / 100000000 % 10 + 48)::u8;
    buf[off + 1] = (v / 10000000 % 10 + 48)::u8;
    buf[off + 2] = (v / 1000000 % 10 + 48)::u8;
    buf[off + 3] = (v / 100000 % 10 + 48)::u8;
    buf[off + 4] = (v / 10000 % 10 + 48)::u8;
    buf[off + 5] = (v / 1000 % 10 + 48)::u8;
    buf[off + 6] = (v / 100 % 10 + 48)::u8;
    buf[off + 7] = (v / 10 % 10 + 48)::u8;
    buf[off + 8] = (v % 10 + 48)::u8;
}

$if (capability.HOSTED) {
    #[testing]
    var fmt_buf: [64]u8;

    test rfc3339__zulu_fraction_and_signed_offsets {
        val s:    str      = (?fmt_buf)::*u8::str;
        val nine: Fraction = Fraction.digits_unless_whole{9};
        if (rfc3339(datetime_from_time(unix(1234567890, 123456789)), nine, (?fmt_buf)::*u8, 64) == 0)      { ret 1; }
        if (!str_equals(s, "2009-02-13T23:31:30.123456789Z"))                                              { ret 2; }
        if (rfc3339(datetime_with_offset(unix(1234567890, 0), 19800), nine, (?fmt_buf)::*u8, 64) == 0)     { ret 3; }
        if (!str_equals(s, "2009-02-14T05:01:30+05:30"))                                                   { ret 4; }
        if (rfc3339(datetime_with_offset(unix(1234567890, 0), 0 - 18000), nine, (?fmt_buf)::*u8, 64) == 0) { ret 5; }
        if (!str_equals(s, "2009-02-13T18:31:30-05:00"))                                                   { ret 6; }
        if (rfc3339_date(Date{year: 2025, month: 3, day: 6}, (?fmt_buf)::*u8, 64) != 10)                   { ret 7; }
        if (!str_equals(s, "2025-03-06"))                                                                  { ret 8; }
        if (rfc3339(datetime_from_time(unix(0, 0)), nine, (?fmt_buf)::*u8, 35) != 0)                       { ret 9; }
        var dt: Datetime = Datetime{year: 2009, month: 2, day: 13, hour: 23, minute: 31, second: 30, offset: 0 - 86340};
        if (rfc3339(dt, nine, (?fmt_buf)::*u8, 64) == 0) { ret 10; }
        if (!str_equals(s, "2009-02-13T23:31:30-23:59")) { ret 10; }
        dt.offset = 86400;
        if (rfc3339(dt, nine, (?fmt_buf)::*u8, 64) != 0) { ret 11; }
        dt.offset = (1::u64 << 63)::i64;
        if (rfc3339(dt, nine, (?fmt_buf)::*u8, 64) != 0) { ret 12; }
        # an offset with seconds, a fifth year digit and a month 13 have no RFC 3339 spelling
        dt.offset = 0 - 86399;
        if (rfc3339(dt, nine, (?fmt_buf)::*u8, 64) != 0) { ret 13; }
        dt.offset = 0;
        dt.year   = 10000;
        if (rfc3339(dt, nine, (?fmt_buf)::*u8, 64) != 0)                                 { ret 14; }
        if (rfc3339_date(Date{year: 2025, month: 13, day: 6}, (?fmt_buf)::*u8, 64) != 0) { ret 15; }
        ret 0;
    }

    test rfc2822__weekday_month_and_signed_offset {
        val s: str = (?fmt_buf)::*u8::str;
        if (rfc2822(datetime_from_time(unix(1234567890, 0)), (?fmt_buf)::*u8, 64) == 0)              { ret 1; }
        if (!str_equals(s, "Fri, 13 Feb 2009 23:31:30 +0000"))                                       { ret 2; }
        if (rfc2822(datetime_with_offset(unix(1234567890, 0), 0 - 18000), (?fmt_buf)::*u8, 64) == 0) { ret 3; }
        if (!str_equals(s, "Fri, 13 Feb 2009 18:31:30 -0500"))                                       { ret 4; }
        var dt: Datetime = Datetime{year: 2009, month: 2, day: 13, hour: 23, minute: 31, second: 30, offset: 359940};
        if (rfc2822(dt, (?fmt_buf)::*u8, 64) == 0)             { ret 5; }
        if (!str_equals(s, "Fri, 13 Feb 2009 23:31:30 +9959")) { ret 5; }
        dt.offset = 0 - 360000;
        if (rfc2822(dt, (?fmt_buf)::*u8, 64) != 0) { ret 6; }
        dt.offset = (1::u64 << 63)::i64;
        if (rfc2822(dt, (?fmt_buf)::*u8, 64) != 0) { ret 7; }
        dt.offset = 359999;
        if (rfc2822(dt, (?fmt_buf)::*u8, 64) != 0) { ret 8; }
        ret 0;
    }

    # zero, a negative, the extremes (the smallest i64 has a magnitude only u64 holds) and a
    # buffer one byte short of the longest form
    test unix_sec__zero_sign_extremes_and_a_short_buffer {
        val s: str = (?fmt_buf)::*u8::str;
        if (unix_sec(0, (?fmt_buf)::*u8, 64) != 1)                    { ret 1; }
        if (!str_equals(s, "0"))                                      { ret 1; }
        if (unix_sec(0 - 86400, (?fmt_buf)::*u8, 64) != 6)            { ret 2; }
        if (!str_equals(s, "-86400"))                                 { ret 2; }
        if (unix_sec(0x7FFFFFFFFFFFFFFF, (?fmt_buf)::*u8, 64) != 19)  { ret 3; }
        if (!str_equals(s, "9223372036854775807"))                    { ret 3; }
        if (unix_sec((1::u64 << 63)::i64, (?fmt_buf)::*u8, 21) != 20) { ret 4; }
        if (!str_equals(s, "-9223372036854775808"))                   { ret 4; }
        if (unix_sec(0, (?fmt_buf)::*u8, 20) != 0)                    { ret 5; }
        ret 0;
    }
}

# the reading of `text`, which must take all of it
#[testing]
fun read_all(text: str) res[StampRead, ReadError] {
    ret read_rfc3339(text::*u8, str_len(text));
}

# whether `text` is refused for a field out of range at offset `at`
#[testing]
fun range_at(text: str, at: usize) bool {
    val res_read: res[StampRead, ReadError] = read_all(text);
    if (sel res_read.ok) { ret false; }
    val e: ReadError = res_read.err;
    ret sel e.range && e.range == at;
}

# whether `text` is refused for its grammar at offset `at`
#[testing]
fun syntax_at(text: str, at: usize) bool {
    val res_read: res[StampRead, ReadError] = read_all(text);
    if (sel res_read.ok) { ret false; }
    val e: ReadError = res_read.err;
    ret sel e.syntax && e.syntax == at;
}

# each of the four forms with each separator and offset spelling, a fraction
# past nine digits dropped, a date that a space and other text follow, then
# every field at its first value out of range, a leap second at and away from
# the end of a UTC month, and a digit or part missing at each step
test read_rfc3339__forms_ranges_and_missing_parts {
    val res_utc: res[StampRead, ReadError] = read_all("1979-05-27T07:32:00Z");
    if (sel res_utc.err)       { ret 1; }
    if (res_utc.ok.size != 20) { ret 1; }
    val utc: Stamp = res_utc.ok.stamp;
    if (!sel utc.datetime)                                                            { ret 1; }
    if (utc.datetime.hour != 7 || utc.datetime.offset != 0 || utc.datetime.day != 27) { ret 1; }

    val res_west: res[StampRead, ReadError] = read_all("1979-05-27 00:32:00.999999-07:00");
    if (sel res_west.err)       { ret 2; }
    if (res_west.ok.size != 32) { ret 2; }
    val west: Stamp = res_west.ok.stamp;
    if (!sel west.datetime)                                                   { ret 2; }
    if (west.datetime.nsec != 999999000 || west.datetime.offset != 0 - 25200) { ret 2; }

    val res_lower: res[StampRead, ReadError] = read_all("1979-05-27t07:32:00z");
    if (sel res_lower.err)       { ret 3; }
    if (res_lower.ok.size != 20) { ret 3; }

    val res_local: res[StampRead, ReadError] = read_all("1979-05-27T07:32:00");
    if (sel res_local.err)       { ret 4; }
    if (res_local.ok.size != 19) { ret 4; }
    val local: Stamp = res_local.ok.stamp;
    if (!sel local.local) { ret 4; }

    val res_date: res[StampRead, ReadError] = read_all("1979-05-27 # 07:32");
    if (sel res_date.err)       { ret 5; }
    if (res_date.ok.size != 10) { ret 5; }
    val date: Stamp = res_date.ok.stamp;
    if (!sel date.date) { ret 5; }

    val res_time: res[StampRead, ReadError] = read_all("00:32:00.1234567899");
    if (sel res_time.err)       { ret 6; }
    if (res_time.ok.size != 19) { ret 6; }
    val time: Stamp = res_time.ok.stamp;
    if (!sel time.time)              { ret 6; }
    if (time.time.nsec != 123456789) { ret 6; }

    val res_leap: res[StampRead, ReadError] = read_all("1990-12-31T15:59:60-08:00");
    if (sel res_leap.err) { ret 7; }

    if (!range_at("1979-13-01", 5))                 { ret 8; }
    if (!range_at("1979-02-29", 8))                 { ret 9; }
    if (!range_at("24:00:00", 0))                   { ret 10; }
    if (!range_at("00:60:00", 3))                   { ret 11; }
    if (!range_at("00:00:61", 6))                   { ret 12; }
    if (!range_at("1979-05-27T07:32:60Z", 17))      { ret 13; }
    if (!range_at("1979-05-27T07:32:00+24:00", 20)) { ret 14; }
    if (!range_at("1979-05-27T07:32:00-05:60", 23)) { ret 15; }
    if (!syntax_at("1979-05-2", 9))                 { ret 16; }
    if (!syntax_at("1979-05-27T", 11))              { ret 17; }
    if (!syntax_at("07:32:00.", 9))                 { ret 18; }
    if (!syntax_at("07:32", 5))                     { ret 19; }
    if (!syntax_at("1979-05-27T07:32:00+05", 22))   { ret 20; }
    if (!syntax_at("1979/05/27", 4))                { ret 21; }
    ret 0;
}

# what each formatter writes reads back to the same fields: a fraction in its
# shortest digits, a leap second, a time with no fraction, an offset, and the
# unknown offset -00:00 apart from +00:00, which is UTC and writes as Z
test rfc3339__formats_read_back {
    var buf:      [40]u8;
    val p:        *u8      = (?buf)::*u8;
    val shortest: Fraction = Fraction.shortest{};

    val t:      TimeOfDay = TimeOfDay{hour: 23, minute: 59, second: 60, nsec: 500000000};
    val n_time: usize     = rfc3339_time(t, shortest, p, 40);
    if (n_time == 0 || !str_equals(p::str, "23:59:60.5")) { ret 1; }
    val res_time: res[StampRead, ReadError] = read_rfc3339(p, n_time);
    if (sel res_time.err) { ret 2; }
    val time: Stamp = res_time.ok.stamp;
    if (!sel time.time)                                        { ret 2; }
    if (time.time.second != 60 || time.time.nsec != 500000000) { ret 2; }

    val ldt:     LocalDatetime = LocalDatetime{year: 0, month: 1, day: 1, hour: 0, minute: 0, second: 0, nsec: 1};
    val n_local: usize         = rfc3339_local(ldt, shortest, p, 40);
    if (n_local == 0 || !str_equals(p::str, "0000-01-01T00:00:00.000000001")) { ret 3; }
    val res_local: res[StampRead, ReadError] = read_rfc3339(p, n_local);
    if (sel res_local.err) { ret 4; }
    val local: Stamp = res_local.ok.stamp;
    if (!sel local.local)      { ret 4; }
    if (local.local.nsec != 1) { ret 4; }

    val dt:   Datetime = Datetime{year: 9999, month: 12, day: 31, hour: 23, minute: 59, second: 59, nsec: 0, offset: 19800};
    val n_dt: usize    = rfc3339(dt, shortest, p, 40);
    if (n_dt == 0 || !str_equals(p::str, "9999-12-31T23:59:59+05:30")) { ret 5; }
    val res_dt: res[StampRead, ReadError] = read_rfc3339(p, n_dt);
    if (sel res_dt.err) { ret 6; }
    val back: Stamp = res_dt.ok.stamp;
    if (!sel back.datetime)            { ret 6; }
    if (back.datetime.offset != 19800) { ret 6; }

    if (rfc3339_time(TimeOfDay{hour: 24}, shortest, p, 40) != 0) { ret 7; }
    if (rfc3339_local(ldt, shortest, p, 29) != 0)                { ret 8; }

    val res_unknown: res[StampRead, ReadError] = read_all("1979-05-27T07:32:00-00:00");
    if (sel res_unknown.err) { ret 9; }
    val unknown: Stamp = res_unknown.ok.stamp;
    if (!sel unknown.datetime)                                            { ret 9; }
    if (!unknown.datetime.offset_unknown || unknown.datetime.offset != 0) { ret 9; }
    if (rfc3339(unknown.datetime, shortest, p, 40) == 0)                  { ret 10; }
    if (!str_equals(p::str, "1979-05-27T07:32:00-00:00"))                 { ret 10; }
    val res_utc: res[StampRead, ReadError] = read_all("1979-05-27T07:32:00+00:00");
    if (sel res_utc.err) { ret 11; }
    val utc: Stamp = res_utc.ok.stamp;
    if (!sel utc.datetime)                           { ret 11; }
    if (utc.datetime.offset_unknown)                 { ret 11; }
    if (rfc3339(utc.datetime, shortest, p, 40) == 0) { ret 12; }
    if (!str_equals(p::str, "1979-05-27T07:32:00Z")) { ret 12; }
    ret 0;
}

# each way of stating the fraction: fixed digits truncated and written even
# when zero, the same omitted when its digits are all zero, none at all, and
# more digits than nsec has refused
test fraction__fixed_whole_and_refused {
    var buf: [40]u8;
    val p:   *u8       = (?buf)::*u8;
    var t:   TimeOfDay = TimeOfDay{hour: 7, minute: 32, second: 0, nsec: 123456789};
    if (rfc3339_time(t, Fraction.digits{3}, p, 40) == 0) { ret 1; }
    if (!str_equals(p::str, "07:32:00.123"))             { ret 1; }
    if (rfc3339_time(t, Fraction.digits{0}, p, 40) == 0) { ret 2; }
    if (!str_equals(p::str, "07:32:00"))                 { ret 2; }
    t.nsec = 999;
    if (rfc3339_time(t, Fraction.digits{3}, p, 40) == 0)              { ret 3; }
    if (!str_equals(p::str, "07:32:00.000"))                          { ret 3; }
    if (rfc3339_time(t, Fraction.digits_unless_whole{3}, p, 40) == 0) { ret 4; }
    if (!str_equals(p::str, "07:32:00"))                              { ret 4; }
    if (rfc3339_time(t, Fraction.digits_unless_whole{9}, p, 40) == 0) { ret 5; }
    if (!str_equals(p::str, "07:32:00.000000999"))                    { ret 5; }
    if (rfc3339_time(t, Fraction.digits{10}, p, 40) != 0)             { ret 6; }
    ret 0;
}
