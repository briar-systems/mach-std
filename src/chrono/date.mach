# calendar date and datetime types with civil date math
#
# Date represents a calendar date (year, month, day) and TimeOfDay a reading of
# the clock (hour, minute, second, nanosecond), each with nothing else.
# LocalDatetime is the two together with no UTC offset, a wall-clock reading
# that names no instant until an offset is chosen. Datetime adds the UTC offset
# it was read at, so it names one instant and keeps the offset beside it.

use std.chrono.time.Time;
use std.chrono.time.unix;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

val SECONDS_PER_DAY:    i64 = 86400;
val SECONDS_PER_HOUR:   i64 = 3600;
val SECONDS_PER_MINUTE: i64 = 60;

# a calendar date without time-of-day or timezone
# ---
# year:  year (e.g. 2025)
# month: month [1, 12]
# day:   day of month [1, 31]
pub rec Date {
    year:  i64;
    month: i64;
    day:   i64;
}

# a time of day without a date or UTC offset
# ---
# hour:   hour [0, 23]
# minute: minute [0, 59]
# second: second [0, 60], 60 in a leap second
# nsec:   nanoseconds within second [0, 999999999]
pub rec TimeOfDay {
    hour:   i64;
    minute: i64;
    second: i64;
    nsec:   i64;
}

# a calendar date with time-of-day and no UTC offset
# ---
# year:   year (e.g. 2025)
# month:  month [1, 12]
# day:    day of month [1, 31]
# hour:   hour [0, 23]
# minute: minute [0, 59]
# second: second [0, 60], 60 in a leap second
# nsec:   nanoseconds within second [0, 999999999]
pub rec LocalDatetime {
    year:   i64;
    month:  i64;
    day:    i64;
    hour:   i64;
    minute: i64;
    second: i64;
    nsec:   i64;
}

# a calendar date with time-of-day and UTC offset
# ---
# year:           year (e.g. 2025)
# month:          month [1, 12]
# day:            day of month [1, 31]
# hour:           hour [0, 23]
# minute:         minute [0, 59]
# second:         second [0, 60], 60 only in a leap second (see datetime_is_valid)
# nsec:           nanoseconds within second [0, 999999999]
# offset:         UTC offset in seconds (0 = UTC, 3600 = +01:00, -18000 = -05:00)
# offset_unknown: the fields are in UTC and the local offset is not known (RFC
#                 3339 section 4.3, written -00:00); offset is then 0
pub rec Datetime {
    year:           i64;
    month:          i64;
    day:            i64;
    hour:           i64;
    minute:         i64;
    second:         i64;
    nsec:           i64;
    offset:         i64;
    offset_unknown: bool;
}

# report whether year is a leap year
# ---
# year: year to test
# ret:  true if year is a leap year
pub fun is_leap_year(year: i64) bool {
    ret year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
}

# return the number of days in a given month
# ---
# year:  year (needed for February)
# month: month [1, 12]
# ret:   number of days in the month
pub fun days_in_month(year: i64, month: i64) i64 {
    if (month == 2) {
        if (is_leap_year(year)) { ret 29; }
        ret 28;
    }
    if (month == 4 || month == 6 || month == 9 || month == 11) {
        ret 30;
    }
    ret 31;
}

# report whether d names a day of the proleptic Gregorian calendar
# ---
# d:   date to test
# ret: true if month is in [1, 12] and day within that month's length
pub fun date_is_valid(d: Date) bool {
    if (d.month < 1 || d.month > 12) { ret false; }
    ret d.day >= 1 && d.day <= days_in_month(d.year, d.month);
}

# report whether t is a reading of the clock
#
# a second of 60 is accepted at any minute: with no date and no offset there is
# nothing to place it against, and some offset puts a leap second at each minute
# ---
# t:   time of day to test
# ret: true if every field is within its range
pub fun time_of_day_is_valid(t: TimeOfDay) bool {
    if (t.hour < 0 || t.hour > 23)     { ret false; }
    if (t.minute < 0 || t.minute > 59) { ret false; }
    if (t.second < 0 || t.second > 60) { ret false; }
    ret t.nsec >= 0 && t.nsec <= 999999999;
}

# report whether ldt is a valid date and time of day, as the two are alone
# ---
# ldt: local datetime to test
# ret: true if its date and its time of day are each valid
pub fun local_datetime_is_valid(ldt: LocalDatetime) bool {
    if (!date_is_valid(local_date(ldt))) { ret false; }
    ret time_of_day_is_valid(local_time_of_day(ldt));
}

# report whether dt names an instant
#
# the offset is less than a day either way, and 0 when it is unknown, and a
# second of 60 falls where a
# leap second can: the second after 23:59:59 UTC on the last day of a month,
# moved by the offset (RFC 3339, section 5.7). whether that month had one is
# the IERS's to announce, and is not checked
# ---
# dt:  datetime to test
# ret: true if its fields, its offset and any leap second are valid
pub fun datetime_is_valid(dt: Datetime) bool {
    if (!local_datetime_is_valid(datetime_local(dt)))                     { ret false; }
    if (dt.offset <= 0 - SECONDS_PER_DAY || dt.offset >= SECONDS_PER_DAY) { ret false; }
    if (dt.offset_unknown && dt.offset != 0)                              { ret false; }
    if (dt.second < 60)                                                   { ret true; }

    # the utc second before the leap second
    val day_total: i64 = civil_to_days(dt.year, dt.month, dt.day) * SECONDS_PER_DAY;
    val before:    i64 = day_total + dt.hour * SECONDS_PER_HOUR + dt.minute * SECONDS_PER_MINUTE + 59 - dt.offset;
    val days:      i64 = floor_div(before, SECONDS_PER_DAY);
    if (before - days * SECONDS_PER_DAY != SECONDS_PER_DAY - 1) { ret false; }

    var y: i64 = 0;
    var m: i64 = 0;
    var d: i64 = 0;
    civil_from_days(days, ?y, ?m, ?d);
    ret d == days_in_month(y, m);
}

# the date of a local datetime
# ---
# ldt: local datetime
# ret: its year, month and day
pub fun local_date(ldt: LocalDatetime) Date {
    ret Date{year: ldt.year, month: ldt.month, day: ldt.day};
}

# the time of day of a local datetime
# ---
# ldt: local datetime
# ret: its hour, minute, second and nanoseconds
pub fun local_time_of_day(ldt: LocalDatetime) TimeOfDay {
    ret TimeOfDay{hour: ldt.hour, minute: ldt.minute, second: ldt.second, nsec: ldt.nsec};
}

# join a date and a time of day into a local datetime
# ---
# d:   the date
# t:   the time of day
# ret: the local datetime holding both
pub fun local_datetime(d: Date, t: TimeOfDay) LocalDatetime {
    ret LocalDatetime{
        year:   d.year,
        month:  d.month,
        day:    d.day,
        hour:   t.hour,
        minute: t.minute,
        second: t.second,
        nsec:   t.nsec
    };
}

# read a local datetime at a UTC offset
# ---
# ldt:    the wall-clock reading
# offset: UTC offset in seconds it was read at
# ret:    the datetime naming that instant, its fields those of ldt
pub fun local_with_offset(ldt: LocalDatetime, offset: i64) Datetime {
    ret Datetime{
        year:   ldt.year,
        month:  ldt.month,
        day:    ldt.day,
        hour:   ldt.hour,
        minute: ldt.minute,
        second: ldt.second,
        nsec:   ldt.nsec,
        offset: offset
    };
}

# the wall-clock reading of a datetime, its offset dropped
# ---
# dt:  datetime
# ret: its fields without the offset
pub fun datetime_local(dt: Datetime) LocalDatetime {
    ret LocalDatetime{
        year:   dt.year,
        month:  dt.month,
        day:    dt.day,
        hour:   dt.hour,
        minute: dt.minute,
        second: dt.second,
        nsec:   dt.nsec
    };
}

# extract the UTC date from a Time
# ---
# t:   time instant
# ret: UTC calendar date
pub fun date_from_time(t: Time) Date {
    val epoch_days: i64 = floor_div(t.sec, SECONDS_PER_DAY);
    var y:          i64 = 0;
    var m:          i64 = 0;
    var d:          i64 = 0;
    civil_from_days(epoch_days, ?y, ?m, ?d);
    ret Date{year: y, month: m, day: d};
}

# extract a UTC Datetime from a Time
# ---
# t:   time instant
# ret: UTC datetime
pub fun datetime_from_time(t: Time) Datetime {
    ret datetime_with_offset(t, 0);
}

# extract a Datetime from a Time with a UTC offset
# ---
# t:      time instant
# offset: UTC offset in seconds
# ret:    datetime adjusted to the given offset
pub fun datetime_with_offset(t: Time, offset: i64) Datetime {
    val adj_sec:    i64 = t.sec + offset;
    val epoch_days: i64 = floor_div(adj_sec, SECONDS_PER_DAY);
    val day_sec:    i64 = adj_sec - epoch_days * SECONDS_PER_DAY;

    var y: i64 = 0;
    var m: i64 = 0;
    var d: i64 = 0;
    civil_from_days(epoch_days, ?y, ?m, ?d);

    ret Datetime{
        year:   y,
        month:  m,
        day:    d,
        hour:   day_sec / SECONDS_PER_HOUR,
        minute: day_sec % SECONDS_PER_HOUR / SECONDS_PER_MINUTE,
        second: day_sec % SECONDS_PER_MINUTE,
        nsec:   t.nsec,
        offset: offset
    };
}

# convert a Datetime back to a Time instant
# ---
# dt:  datetime to convert
# ret: time instant (UTC)
pub fun datetime_to_time(dt: Datetime) Time {
    val days:       i64 = civil_to_days(dt.year, dt.month, dt.day);
    val day_total:  i64 = days * SECONDS_PER_DAY;
    val hour_total: i64 = dt.hour * SECONDS_PER_HOUR;
    val min_total:  i64 = dt.minute * SECONDS_PER_MINUTE;
    val sec:        i64 = day_total + hour_total + min_total + dt.second - dt.offset;
    ret unix(sec, dt.nsec);
}

# convert a Date to a Time at midnight UTC
# ---
# d:   date to convert
# ret: time instant at 00:00:00 UTC on the given date
pub fun date_to_time(d: Date) Time {
    val days: i64 = civil_to_days(d.year, d.month, d.day);
    ret unix(days * SECONDS_PER_DAY, 0);
}

# divide rounding toward negative infinity
# ---
# a:   dividend
# b:   divisor, nonzero
# ret: the largest integer not above a / b
pub fun floor_div(a: i64, b: i64) i64 {
    val d: i64 = a / b;
    val r: i64 = a - d * b;
    if (r != 0 && (r ^ b) < 0) { ret d - 1; }
    ret d;
}

fun civil_from_days(epoch_days: i64, y: *i64, m: *i64, d: *i64) {
    val z:   i64 = epoch_days + 719468;
    val era: i64 = floor_div(z, 146097);
    val doe: i64 = z - era * 146097;
    val yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    val doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100);
    val mp:  i64 = (5 * doy + 2) / 153;

    @d = doy - (153 * mp + 2) / 5 + 1;

    var month: i64 = mp + 3;
    if (mp >= 10) { month = mp - 9; }
    @m = month;

    var year: i64 = yoe + era * 400;
    if (month <= 2) { year = year + 1; }
    @y = year;
}

# count the days from 1970-01-01 to a date of the proleptic Gregorian calendar
# ---
# y:   year
# m:   month [1, 12]
# d:   day of month [1, 31]
# ret: days since the unix epoch, negative before it
pub fun civil_to_days(y: i64, m: i64, d: i64) i64 {
    var yr: i64 = y;
    if (m <= 2) { yr = yr - 1; }

    val era: i64 = floor_div(yr, 400);
    val yoe: i64 = yr - era * 400;

    var adj: i64 = m - 3;
    if (m <= 2) { adj = m + 9; }

    val doy: i64 = (153 * adj + 2) / 5 + d - 1;
    val doe: i64 = yoe * 365 + yoe / 4 - yoe / 100 + doy;

    ret era * 146097 + doe - 719468;
}

test date_from_time__known_dates_either_side_of_the_epoch {
    val epoch: Date = date_from_time(unix(0, 0));
    if (epoch.year != 1970 || epoch.month != 1 || epoch.day != 1) { ret 1; }
    val before: Date = date_from_time(unix(0 - 1, 0));
    if (before.year != 1969 || before.month != 12 || before.day != 31) { ret 2; }
    val leap: Date = date_from_time(unix(951782400, 0));
    if (leap.year != 2000 || leap.month != 2 || leap.day != 29) { ret 3; }
    val old: Date = date_from_time(unix(0 - 2203891200, 0));
    if (old.year != 1900 || old.month != 3 || old.day != 1) { ret 4; }
    ret 0;
}

test datetime_with_offset__splits_the_day_and_rolls_the_date {
    val utc: Datetime = datetime_from_time(unix(1234567890, 0));
    if (utc.year != 2009 || utc.month != 2 || utc.day != 13)    { ret 1; }
    if (utc.hour != 23 || utc.minute != 31 || utc.second != 30) { ret 2; }
    val ahead: Datetime = datetime_with_offset(unix(1234567890, 0), 3600);
    if (ahead.day != 14 || ahead.hour != 0 || ahead.offset != 3600) { ret 3; }
    ret 0;
}

test datetime_to_time__round_trips_with_offset {
    val t1: Time     = unix(1234567890, 500);
    val dt: Datetime = datetime_with_offset(t1, 0 - 18000);
    val t2: Time     = datetime_to_time(dt);
    if (t2.sec != t1.sec || t2.nsec != t1.nsec) { ret 1; }
    val d: Date = date_from_time(date_to_time(Date{year: 2025, month: 3, day: 6}));
    if (d.year != 2025 || d.month != 3 || d.day != 6) { ret 2; }
    ret 0;
}

# each field at its first value out of range, a leap second where RFC 3339 puts
# one (23:59:60 UTC on a month's last day, moved by the offset) and refused a
# minute early or a day short, and an offset of a whole day
test validity__fields_offsets_and_leap_seconds {
    if (!date_is_valid(Date{year: 2024, month: 2, day: 29}))                                 { ret 1; }
    if (date_is_valid(Date{year: 2023, month: 2, day: 29}))                                  { ret 2; }
    if (date_is_valid(Date{year: 2024, month: 13, day: 1}))                                  { ret 3; }
    if (date_is_valid(Date{year: 2024, month: 4, day: 31}))                                  { ret 4; }
    if (date_is_valid(Date{year: 2024, month: 1, day: 0}))                                   { ret 5; }
    if (!time_of_day_is_valid(TimeOfDay{hour: 23, minute: 59, second: 60, nsec: 999999999})) { ret 6; }
    if (time_of_day_is_valid(TimeOfDay{hour: 24}))                                           { ret 7; }
    if (time_of_day_is_valid(TimeOfDay{minute: 60}))                                         { ret 8; }
    if (time_of_day_is_valid(TimeOfDay{second: 61}))                                         { ret 9; }
    if (time_of_day_is_valid(TimeOfDay{nsec: 1000000000}))                                   { ret 10; }
    var dt: Datetime = Datetime{year: 1990, month: 12, day: 31, hour: 23, minute: 59, second: 60};
    if (!datetime_is_valid(dt)) { ret 11; }
    dt.hour   = 15;
    dt.offset = 0 - 8 * SECONDS_PER_HOUR;
    if (!datetime_is_valid(dt)) { ret 12; }
    dt.minute = 58;
    if (datetime_is_valid(dt)) { ret 13; }
    dt = Datetime{year: 1990, month: 12, day: 30, hour: 23, minute: 59, second: 60};
    if (datetime_is_valid(dt)) { ret 14; }
    dt = Datetime{year: 1990, month: 7, day: 1, hour: 5, minute: 29, second: 60, offset: 19800};
    if (!datetime_is_valid(dt)) { ret 15; }
    dt = Datetime{year: 1990, month: 7, day: 1, offset: SECONDS_PER_DAY};
    if (datetime_is_valid(dt)) { ret 16; }
    dt = Datetime{year: 1990, month: 7, day: 1, offset: 3600, offset_unknown: true};
    if (datetime_is_valid(dt)) { ret 17; }
    ret 0;
}

# the century rule: 1900 is common and 2000 leap, beside a plain leap and a plain common
# year, with February's length in each
test calendar__leap_years_follow_the_century_rule {
    if (is_leap_year(1900) || days_in_month(1900, 2) != 28)  { ret 1; }
    if (!is_leap_year(2000) || days_in_month(2000, 2) != 29) { ret 2; }
    if (!is_leap_year(2024) || days_in_month(2024, 2) != 29) { ret 3; }
    if (is_leap_year(2023) || days_in_month(2023, 2) != 28)  { ret 4; }
    ret 0;
}
