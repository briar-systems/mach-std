# the canonical option tag: opt[T]
#
# genuine absence is spelled `opt[T]`: an empty container, no match, no
# element at an index, an unset variable. it is an ordinary std declaration
# (mach doc/design/tagged-values.md fixes the language contract; the compiler
# seeds nothing and treats it like any other tag). a consuming module gains
# `use std.types.option.opt;` and spells the bare name. the sibling tags live
# in `std.types.result` (`res[T, E]`) and `std.types.error` (`err[E]`).
#
# opt[T]: `none` is case 0 and `some: T` is case 1; the zero value reads as
# `none`.
#
# the discriminator is a u8 at offset zero and the payload follows at its
# natural alignment. the three canonical tags nest freely (`res[opt[T], E]`,
# `opt[res[T, E]]`) and instantiate user generics like any declared type.
#
# reading: `sel place.case` is the test, and the guarded payload place is the
# read. an `if (!sel o.some) { ret ...; }` chain guards `o.some` for the rest
# of the block; `||` opens no guard, so one term per `if`. construction is
# `Type.case{...}` only. no helper functions are provided on purpose: a
# by-value `unwrap` would copy owning payloads out of the ownership rules,
# and a constructor function would be a second spelling of a form the
# language already has. the tests below pin the shape: case order, case
# codes, zero defaults, layout, reflection and guards.

pub tag opt[T]: u8 { none; some: T; }

use std.types.size.usize;

fun code(p: *u8) u8 {
    ret p[0];
}

test opt_none_is_case_0_and_some_is_case_1 {
    var zero: opt[i64];
    if (!sel zero.none)          { ret 1; }
    if (code((?zero)::*u8) != 0) { ret 2; }

    var present: opt[i64] = opt[i64].some{42};
    if (!sel present.some)          { ret 3; }
    if (present.some != 42)         { ret 4; }
    if (code((?present)::*u8) != 1) { ret 5; }

    var absent: opt[i64] = opt[i64].none{};
    if (!sel absent.none)          { ret 6; }
    if (code((?absent)::*u8) != 0) { ret 7; }
    ret 0;
}

# the discriminator is a u8 at offset zero and the payload follows at the
# payload's natural alignment, which is the layout the contract fixes
test opt_discriminator_is_u8_at_offset_zero {
    if ($size_of($discriminant_of(opt[u8])) != 1) { ret 1; }
    if ($size_of(opt[u8]) != 2)                   { ret 2; }
    if ($offset_of(opt[i64], some) != 8)          { ret 3; }
    if ($size_of(opt[i64]) != 16)                 { ret 4; }
    ret 0;
}

# reflection sees exactly two cases in declaration order
test opt_reflection_enumerates_the_contract_cases {
    var n: usize = 0;
    $each c in $cases(opt[i64]) { n = n + 1; }
    if (n != 2)              { ret 1; }
    $if (!$is_tag(opt[i64])) { ret 2; }
    ret 0;
}

# an exiting chain guards the remainder of the block, and a loop body
# re-establishes its guard every iteration
fun find(key: i64) opt[i64] {
    if (key == 0) { ret opt[i64].none{}; }
    ret opt[i64].some{key * 2};
}

test opt_exiting_chains_guard_the_rest_of_the_block {
    var total: i64 = 0;
    var key:   i64 = -2;
    for (key < 3) {
        val found: opt[i64] = find(key);
        if (!sel found.some) {
            key = key + 1;
            cnt;
        }
        total = total + found.some;
        key   = key + 1;
    }
    if (total != 0) { ret 1; }
    val present: opt[i64] = find(21);
    if (!sel present.some)  { ret 2; }
    if (present.some != 42) { ret 3; }
    ret 0;
}

# a user generic instantiates over the canonical tag like over any other
# declared type: the tag is an ordinary std declaration
rec Holder[T] { item: T; }

fun hold[T](item: T) Holder[T] {
    ret Holder[T]{item: item};
}

test opt_user_generics_instantiate_over_the_canonical_tag {
    val maybe: Holder[opt[i64]] = hold[opt[i64]](opt[i64].some{42});
    if (!sel maybe.item.some)  { ret 1; }
    if (maybe.item.some != 42) { ret 2; }

    var empty: Holder[opt[i64]];
    if (!sel empty.item.none) { ret 3; }
    ret 0;
}
