# the canonical failure tags: res, opt and err
#
# these are the three value shapes every fallible or absent outcome in std is
# spelled with. the contract (mach doc/design/tagged-values.md) declares them
# as ordinary std tags, and this module is where std declares them. the
# compiler seeds nothing: a consuming module gains `use std.types.canonical.res;`
# and friends and spells the bare names. the tests below pin the shapes to the
# contract, case order, case codes and zero defaults included.
#
# no helper functions are provided on purpose. `sel place.case` is the test,
# the guarded payload place is the read, and `Type.case{...}` is the only
# construction. a by-value `unwrap` would copy owning payloads out of the
# ownership rules, and a constructor function would be a second spelling of
# a form the language already has.
#
# zero initialization selects the first declared case with a zero payload:
# `res` and `err` read as a failure and `opt` as absence until constructed.

pub tag res[T, E]: u8 { err: E; ok: T; }
pub tag opt[T]: u8    { none; some: T; }
pub tag err[E]: u8    { err: E; ok; }

use std.types.bool.bool;
use std.types.size.usize;

fun code(p: *u8) u8 { ret p[0]; }

test "std.types.canonical.res: err is case 0 and ok is case 1" {
    var zero: res[i64, i32];
    if (!sel zero.err)                { ret 1; }
    if (zero.err != 0)                { ret 2; }
    if (code((?zero)::*u8) != 0)      { ret 3; }

    var good: res[i64, i32] = res[i64, i32].ok{42};
    if (!sel good.ok)                 { ret 4; }
    if (good.ok != 42)                { ret 5; }
    if (code((?good)::*u8) != 1)      { ret 6; }

    var bad: res[i64, i32] = res[i64, i32].err{-7};
    if (!sel bad.err)                 { ret 7; }
    if (bad.err != -7)                { ret 8; }
    if (code((?bad)::*u8) != 0)       { ret 9; }
    ret 0;
}

test "std.types.canonical.opt: none is case 0 and some is case 1" {
    var zero: opt[i64];
    if (!sel zero.none)               { ret 1; }
    if (code((?zero)::*u8) != 0)      { ret 2; }

    var present: opt[i64] = opt[i64].some{42};
    if (!sel present.some)            { ret 3; }
    if (present.some != 42)           { ret 4; }
    if (code((?present)::*u8) != 1)   { ret 5; }

    var absent: opt[i64] = opt[i64].none{};
    if (!sel absent.none)             { ret 6; }
    if (code((?absent)::*u8) != 0)    { ret 7; }
    ret 0;
}

test "std.types.canonical.err: err is case 0 and payloadless ok is case 1" {
    var zero: err[i32];
    if (!sel zero.err)                { ret 1; }
    if (zero.err != 0)                { ret 2; }
    if (code((?zero)::*u8) != 0)      { ret 3; }

    var done: err[i32] = err[i32].ok{};
    if (!sel done.ok)                 { ret 4; }
    if (code((?done)::*u8) != 1)      { ret 5; }

    var failed: err[i32] = err[i32].err{9};
    if (!sel failed.err)              { ret 6; }
    if (failed.err != 9)              { ret 7; }
    if (code((?failed)::*u8) != 0)    { ret 8; }
    ret 0;
}

# the discriminator is a u8 at offset zero and the payload follows at the
# payload's natural alignment, which is the layout the contract fixes
test "std.types.canonical: discriminator is u8 at offset zero" {
    if ($size_of($discriminant_of(res[i64, i32])) != 1) { ret 1; }
    if ($size_of($discriminant_of(opt[u8])) != 1)       { ret 2; }
    if ($size_of($discriminant_of(err[u64])) != 1)      { ret 3; }
    if ($size_of(opt[u8]) != 2)                         { ret 4; }
    if ($size_of(err[i32]) != 8)                        { ret 5; }
    if ($offset_of(res[i64, i32], ok) != 8)             { ret 6; }
    if ($offset_of(res[i64, i32], err) != 8)            { ret 7; }
    if ($size_of(res[i64, i32]) != 16)                  { ret 8; }
    ret 0;
}

# reflection sees exactly two cases in declaration order on each of the three
test "std.types.canonical: reflection enumerates the contract cases" {
    var n: usize = 0;
    $each c in $cases(res[i64, i32]) { n = n + 1; }
    if (n != 2) { ret 1; }
    n = 0;
    $each c in $cases(opt[i64]) { n = n + 1; }
    if (n != 2) { ret 2; }
    n = 0;
    $each c in $cases(err[i32]) { n = n + 1; }
    if (n != 2) { ret 3; }
    $if (!$is_tag(res[i64, i32])) { ret 4; }
    $if (!$is_tag(opt[i64]))      { ret 5; }
    $if (!$is_tag(err[i32]))      { ret 6; }
    ret 0;
}

# the three nest: a result of an option, an option of a result, and a result
# whose error is another tag all read through chained guards
tag Cause: u8 { missing; refused: i32; }

fun lookup(key: i64) res[opt[i64], Cause] {
    if (key < 0)  { ret res[opt[i64], Cause].err{Cause.refused{-1}}; }
    if (key == 0) { ret res[opt[i64], Cause].ok{opt[i64].none{}}; }
    ret res[opt[i64], Cause].ok{opt[i64].some{key * 2}};
}

test "std.types.canonical: tags nest and guard through the chain" {
    val refused: res[opt[i64], Cause] = lookup(-1);
    if (!sel refused.err)             { ret 1; }
    if (!sel refused.err.refused)     { ret 2; }
    if (refused.err.refused != -1)    { ret 3; }

    val absent: res[opt[i64], Cause] = lookup(0);
    if (!sel absent.ok)               { ret 4; }
    if (!sel absent.ok.none)          { ret 5; }

    val present: res[opt[i64], Cause] = lookup(21);
    if (!sel present.ok)              { ret 6; }
    if (!sel present.ok.some)         { ret 7; }
    if (present.ok.some != 42)        { ret 8; }
    ret 0;
}

# an exiting chain guards the remainder of the block, and a loop body
# re-establishes its guard every iteration
test "std.types.canonical: exiting chains guard the rest of the block" {
    var total: i64 = 0;
    var key: i64 = 1;
    for (key < 5) {
        val found: res[opt[i64], Cause] = lookup(key);
        if (!sel found.ok) { ret 1; }
        if (!sel found.ok.some) { key = key + 1; cnt; }
        total = total + found.ok.some;
        key = key + 1;
    }
    if (total != 20) { ret 2; }
    ret 0;
}

# a user generic instantiates over the canonical tags like over any other
# declared type: the tags are ordinary std declarations
rec Holder[T] { item: T; }

fun hold[T](item: T) Holder[T] { ret Holder[T]{item: item}; }

test "std.types.canonical: user generics instantiate over the canonical tags" {
    val maybe: Holder[opt[i64]] = hold[opt[i64]](opt[i64].some{42});
    if (!sel maybe.item.some)          { ret 1; }
    if (maybe.item.some != 42)         { ret 2; }

    val outcome: Holder[res[i64, Cause]] = hold[res[i64, Cause]](res[i64, Cause].err{Cause.missing{}});
    if (!sel outcome.item.err)         { ret 3; }
    if (!sel outcome.item.err.missing) { ret 4; }

    val done: Holder[err[i32]] = hold[err[i32]](err[i32].ok{});
    if (!sel done.item.ok)             { ret 5; }

    var empty: Holder[opt[i64]];
    if (!sel empty.item.none)          { ret 6; }
    ret 0;
}
