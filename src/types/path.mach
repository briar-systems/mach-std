# path manipulation helpers
#
# Path is a type alias for str. functions that return new paths allocate
# through the caller-provided Allocator. functions that return views into
# existing paths (filename, extension) return pointers into the input and
# do not allocate.
#
# separator contract: parsing accepts any platform separator. on windows
# both '/' and '\' separate components (matching the Win32 file APIs); on
# posix only '/' separates ('\' is a legal filename byte). construction
# (join, separator) emits the platform-preferred separator, and stored
# paths are never normalized.
#
# windows absolute roots: drive-letter roots ('C:\', 'C:/') and UNC roots
# ('\\server\share') are recognized as absolute, and filename/parent/is_root
# never split inside them. a bare drive reference 'C:' (or 'C:foo') is
# drive-relative: it is a root unit (its own parent, empty filename) but is
# NOT absolute, matching Win32 where 'C:foo' resolves against the current
# directory on drive C. a UNC '\\server\share' is one indivisible root unit
# (a bare '\\server' is not a usable path and is likewise treated as a whole
# root). join does no drive-relative special-casing: join("C:", "foo")
# inserts a separator yielding "C:\foo".
#
# nil contract: a nil Path means "no path". predicates answer false for nil,
# views return nil, and clone/stem propagate nil as ok(nil) rather than
# allocating an empty path.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.char.char_is_alpha;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;
use std.types.view;
use std.memory;
use std.allocator;
use std.allocator.fixed;
use std.allocator.page;
use std.allocator.Allocator;
use std.system.os;

use std.text.string.str_free;
use O: std.types.option;
use R: std.types.result;

# a null-terminated filesystem path
pub def Path: str;

# platform path separator character, emitted by construction
# ---
# ret: the preferred separator byte for the target
pub fun separator() u8 {
    ret os.separator;
}

# check whether c separates path components on the target
#
# windows accepts both '/' and '\'; posix treats only '/' as a separator.
# ---
# c:   byte to test
# ret: true when c is a separator
pub fun is_separator(c: u8) bool {
    $if ($mach.build.os == $mach.os.windows) {
        ret c == separator() || c == '/';
    }
    $or {
        ret c == separator();
    }
}

# byte length of the absolute root prefix at the head of p
#
# recognizes windows drive roots ('C:' or 'C:\') and UNC roots
# ('\\server\share'); returns 0 for relative paths, single-separator roots,
# and on all non-windows targets. callers use it so filename/parent/is_root
# never split inside a volume or UNC root.
fun root_len(p: Path) usize {
    $if ($mach.build.os == $mach.os.windows) {
        if (is_empty(p)) { ret 0; }
        val len: usize = str_len(p);

        # UNC: two leading separators, root spans '\\server\share'.
        if (len >= 2 && is_separator(p[0]) && is_separator(p[1])) {
            var i: usize = 2;
            for (i < len && !is_separator(p[i])) { i = i + 1; }
            for (i < len && is_separator(p[i]))  { i = i + 1; }
            for (i < len && !is_separator(p[i])) { i = i + 1; }
            ret i;
        }

        # drive: 'X:' plus its root separator when present.
        if (char_is_alpha(p[0]) && len >= 2 && p[1] == ':') {
            if (len >= 3 && is_separator(p[2])) { ret 3; }
            ret 2;
        }

        ret 0;
    }
    $or {
        ret 0;
    }
}

# borrow the indivisible root prefix without changing its spelling
# relative, empty and nil paths have zero length and retain the input pointer
# separator-only paths expose one separator rather than an empty UNC share
pub fun root(p: Path) view.View {
    if (is_empty(p)) { ret view.view(p, 0); }

    var n: usize = root_len(p);
    var leading: usize = 0;
    for (is_separator(p[leading])) { leading = leading + 1; }
    if (leading > 0 && (n == 0 || p[leading] == 0)) { n = 1; }
    ret view.view(p, n);
}

# check whether p contains any path separator
# ---
# ret: true when at least one byte of p separates components
pub fun has_separator(p: Path) bool {
    if (p == nil) { ret false; }

    var i: usize = 0;
    for (p[i] != 0) {
        if (is_separator(p[i])) { ret true; }
        i = i + 1;
    }

    ret false;
}

# check whether a path is empty or nil
# ---
# ret: true if the path is nil or zero-length
pub fun is_empty(p: Path) bool {
    ret p == nil || p[0] == 0;
}

# check whether a path is absolute
#
# a path is absolute when it begins with a separator (a posix or UNC root)
# or, on windows, with a drive-letter root 'X:\' / 'X:/'. a bare drive
# reference 'C:' or 'C:foo' is drive-relative and is not absolute.
# ---
# ret: true when p is absolute
pub fun is_abs(p: Path) bool {
    if (p == nil) { ret false; }
    if (is_separator(p[0])) { ret true; }

    $if ($mach.build.os == $mach.os.windows) {
        if (char_is_alpha(p[0]) && p[1] == ':' && is_separator(p[2])) { ret true; }
    }

    ret false;
}

# check whether a path is a root unit
#
# true when p is only separators, or (on windows) exactly a drive or UNC
# root followed by any trailing separators.
# ---
# ret: true when p is exactly a root unit
pub fun is_root(p: Path) bool {
    if (is_empty(p)) { ret false; }

    val len: usize = str_len(p);
    val rl:  usize = root_len(p);
    var i:   usize = rl;

    for (i < len) {
        if (!is_separator(p[i])) { ret false; }
        i = i + 1;
    }

    ret true;
}

# count the net directory depth of a path
#
# walks p's is_separator-delimited segments: a real segment adds one level, a
# '.' segment contributes nothing, and a '..' segment climbs one level, clamped
# so the depth never falls below zero. empty runs (leading, trailing, or
# repeated separators) contribute nothing. the result is how far p descends
# below its anchor - the count of '..' needed to climb from p back to that
# anchor - which is why '..' decrements and the floor holds a relative climb at
# the root.
# ---
# p:   path to measure
# ret: the net segment depth, zero for a nil, empty, root, or fully-climbing path
pub fun seg_count(p: Path) usize {
    if (is_empty(p)) { ret 0; }

    val n: usize = str_len(p);
    val anchor: view.View = root(p);
    var depth: usize = 0;
    var i: usize = anchor.len;
    for (i < n) {
        for (i < n && is_separator(p[i])) { i = i + 1; }
        val start: usize = i;
        for (i < n && !is_separator(p[i])) { i = i + 1; }

        val seglen: usize = i - start;
        if (seglen == 0) { cnt; }
        if (seglen == 1 && p[start] == '.') { cnt; }
        if (seglen == 2 && p[start] == '.' && p[start + 1] == '.') {
            if (depth > 0) { depth = depth - 1; }
            cnt;
        }
        depth = depth + 1;
    }

    ret depth;
}

# return the final component of a path
#
# returns a pointer into p (no allocation). returns nil for empty paths
# and empty string for paths ending in a separator.
# ---
# p:   path to extract filename from
# ret: pointer into p at the filename, or nil
pub fun filename(p: Path) str {
    if (is_empty(p)) { ret nil; }
    val len: usize = str_len(p);
    val rl:  usize = root_len(p);
    var i:   usize = len;

    for (i > rl) {
        i = i - 1;
        if (is_separator(p[i])) {
            ret ?p[i + 1];
        }
    }

    # nothing follows the root: the path is exactly its root prefix.
    if (rl > 0) { ret ?p[rl]; }

    ret p;
}

# return the file extension without the leading dot
#
# returns a pointer into p (no allocation). returns nil if there is no
# extension (no dot, or dot is first char of filename).
# ---
# p:   path to extract extension from
# ret: pointer into p at the extension, or nil
pub fun extension(p: Path) str {
    val name: str = filename(p);
    if (name == nil) { ret nil; }

    val len: usize = str_len(name);
    if (len == 0) { ret nil; }

    var i: usize = len;
    for (i > 0) {
        i = i - 1;
        if (name[i] == '.') {
            if (i == 0) { ret nil; }
            ret ?name[i + 1];
        }
    }

    ret nil;
}

# return the filename without its extension
#
# "foo/bar.txt" → "bar", "foo/.hidden" → ".hidden", "foo/bar" → "bar"
# ---
# a:   allocator for the result
# p:   path to extract stem from
# ret: the stem, or an error message
pub fun stem(a: *allocator.Allocator, p: Path) R.Result[Path, str] {
    if (a == nil) { ret R.err[Path, str]("allocator is nil"); }

    val name: str = filename(p);
    if (name == nil) { ret R.ok[Path, str](nil); }

    val len: usize = str_len(name);
    if (len == 0) { ret R.ok[Path, str](nil); }

    val file_ext: str = extension(p);
    if (file_ext == nil) { ret clone(a, name); }

    val ext_len:  usize = str_len(file_ext);
    val stem_len: usize = len - ext_len - 1;

    val r: R.Result[*u8, str] = allocator.allocate[u8](a, stem_len + 1);
    if (R.is_err[*u8, str](r)) {
        ret R.err[Path, str](R.unwrap_err[*u8, str](r));
    }

    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    memory.raw_copy(buf::ptr, name::ptr, stem_len);
    buf[stem_len] = 0;

    ret R.ok[Path, str](buf);
}

# duplicate a path using the provided allocator
# ---
# a:   allocator for the new path
# p:   path to clone (nil returns nil)
# ret: the cloned path, or an error message
pub fun clone(a: *allocator.Allocator, p: Path) R.Result[Path, str] {
    if (a == nil) { ret R.err[Path, str]("allocator is nil"); }
    if (p == nil) { ret R.ok[Path, str](nil); }

    val n: usize              = str_len(p);
    val r: R.Result[*u8, str] = allocator.allocate[u8](a, n + 1);
    if (R.is_err[*u8, str](r)) {
        ret R.err[Path, str](R.unwrap_err[*u8, str](r));
    }

    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    memory.raw_copy(buf::ptr, p::ptr, n);
    buf[n] = 0;

    ret R.ok[Path, str](buf);
}

# join two path segments with the platform separator
# ---
# a:     allocator for the resulting path
# left:  left path segment
# right: right path segment
# ret:   the joined path, or an error message
pub fun join(a: *allocator.Allocator, left: Path, right: Path) R.Result[Path, str] {
    if (a == nil) { ret R.err[Path, str]("allocator is nil"); }
    if (is_empty(left))  { ret clone(a, right); }
    if (is_empty(right)) { ret clone(a, left); }

    val sep:       u8    = separator();
    val left_len:  usize = str_len(left);
    val right_len: usize = str_len(right);
    val has_sep:   bool  = is_separator(left[left_len - 1]) || is_separator(right[0]);

    var extra: usize = 0;
    if (!has_sep) { extra = 1; }

    val out_len: usize = left_len + right_len + extra;
    val r: R.Result[*u8, str] = allocator.allocate[u8](a, out_len + 1);
    if (R.is_err[*u8, str](r)) {
        ret R.err[Path, str](R.unwrap_err[*u8, str](r));
    }

    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    memory.raw_copy(buf::ptr, left::ptr, left_len);

    var off: usize = left_len;
    if (!has_sep) {
        buf[off] = sep;
        off = off + 1;
    }

    memory.raw_copy((?buf[off])::ptr, right::ptr, right_len);
    buf[out_len] = 0;

    ret R.ok[Path, str](buf);
}

# return the parent directory of a path
# ---
# a:   allocator for the resulting path
# p:   path to get parent of
# ret: the parent path, or an error message
pub fun parent(a: *allocator.Allocator, p: Path) R.Result[Path, str] {
    if (a == nil)    { ret R.err[Path, str]("allocator is nil"); }
    if (is_empty(p)) { ret clone(a, "."); }

    val len: usize = str_len(p);
    val rl:  usize = root_len(p);
    if (rl > 0) { ret parent_rooted(a, p, rl); }

    # root results preserve the input's leading separator rather than
    # forcing the platform one, so a '/'-rooted path stays '/'-rooted.
    var end: usize = len;
    for (end > 0 && is_separator(p[end - 1])) {
        end = end - 1;
    }
    if (end == 0) { ret clone_sep(a, p[0]); }

    var i: usize = end;
    for (i > 0) {
        i = i - 1;
        if (is_separator(p[i])) { brk; }
    }

    if (i == 0 && !is_separator(p[0])) { ret clone(a, "."); }
    if (i == 0)                        { ret clone_sep(a, p[0]); }

    var parent_end: usize = i;
    for (parent_end > 0 && is_separator(p[parent_end - 1])) {
        parent_end = parent_end - 1;
    }
    if (parent_end == 0) { ret clone_sep(a, p[0]); }

    val r: R.Result[*u8, str] = allocator.allocate[u8](a, parent_end + 1);
    if (R.is_err[*u8, str](r)) {
        ret R.err[Path, str](R.unwrap_err[*u8, str](r));
    }

    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    memory.raw_copy(buf::ptr, p::ptr, parent_end);
    buf[parent_end] = 0;

    ret R.ok[Path, str](buf);
}

# resolve p against base: an absolute p is cloned verbatim, a relative p is
# joined onto base
# ---
# a:    allocator for the result
# base: base directory for a relative p
# p:    path to resolve
# ret:  the resolved path, or an error
pub fun resolve(a: *allocator.Allocator, base: Path, p: Path) R.Result[Path, str] {
    if (is_abs(p)) { ret clone(a, p); }
    ret join(a, base, p);
}

# lexically normalize a path: collapse `.`, resolve safe `..`, and squash
# separator runs, without touching the filesystem (mach#2998, mach-lsp#141)
#
# PURELY LEXICAL, and that is the contract rather than a limitation. No `stat`, no
# symlink resolution, no current-directory lookup - two spellings that clean to the
# same bytes name the same path *as written*, which is exactly the identity an editor
# overlay needs: the compiler composes `<root>/./src/f.mach` from a manifest's
# `src = "./src"` while the editor supplies `<root>/src/f.mach`, and the buffer is
# missed unless those two compare equal. Resolving symlinks would be a different
# (and I/O-bearing) question.
#
# THE ROOT IS PRESERVED, NEVER CLIMBED THROUGH. `root_len` already knows what a root
# is on this target - a POSIX `/`, a drive `C:\`, a UNC `\\server\share` - so a `..`
# that would escape one is dropped, the way every real path resolver behaves. A
# RELATIVE path keeps its leading `..` segments, because there is nothing above it to
# cancel them against yet; `../a/../b` cleans to `../b`, not `b`.
#
# SEPARATORS COME OUT NATIVE, and go in either way on windows. `is_separator` accepts
# both `/` and `\` there, which is what lets a compiler-produced forward-slash
# spelling and an editor's backslash one meet; the output uses `separator()` so the
# result is one canonical spelling rather than whichever the caller happened to pass.
#
# EMBEDDED NUL IS NOT REPRESENTABLE. `Path` is a null-terminated `str`, so a path ends
# at its first NUL by construction and there is nothing to reject - stated here
# because the question is a real one for a byte-oriented normalizer and the answer is
# a property of the type rather than of this function.
#
# An empty result is spelled `.`, so the return is always a usable path.
# ---
# a: allocator for the returned path
# p: the path to normalize
# ret: the cleaned path, or an allocation error
pub fun clean(a: *allocator.Allocator, p: Path) R.Result[Path, str] {
    if (is_empty(p)) { ret clone_dot(a); }

    val len: usize = str_len(p);

    # the root prefix this path may not climb above
    var rl: usize = root_len(p);
    var rooted: bool = false;
    if (rl > 0) { rooted = is_abs(p); }
    or {
        if (is_separator(p[0])) { rl = 1; rooted = true; }
    }
    var leading: usize = 0;
    for (leading < len && is_separator(p[leading])) { leading = leading + 1; }
    if (leading == len) { rl = 1; }

    # the output can never exceed the input, except for the lone `.` case
    val br: R.Result[*u8, str] = allocator.allocate[u8](a, len + 2);
    if (R.is_err[*u8, str](br)) { ret R.err[Path, str](R.unwrap_err[*u8, str](br)); }
    val out: *u8 = R.unwrap_ok[*u8, str](br);

    # where each kept segment begins in `out`, so a `..` can pop one
    var seg_cap: usize = len / 2 + 2;
    val sr: R.Result[*usize, str] = allocator.allocate[usize](a, seg_cap);
    if (R.is_err[*usize, str](sr)) {
        allocator.deallocate[u8](a, out, len + 2);
        ret R.err[Path, str](R.unwrap_err[*usize, str](sr));
    }
    val starts: *usize = R.unwrap_ok[*usize, str](sr);
    var nseg: usize = 0;

    # copy the root prefix, normalizing its separators to the native one
    var w: usize = 0;
    var i: usize = 0;
    for (i < rl) {
        if (is_separator(p[i])) {
            if (w > 0 && is_separator(out[w - 1]) && i != 1) { i = i + 1; cnt; }
            out[w] = separator();
        }
        or                      { out[w] = p[i]; }
        w = w + 1;
        i = i + 1;
    }
    val prefix_end: usize = w;

    for (i < len) {
        # skip a run of separators
        if (is_separator(p[i])) { i = i + 1; cnt; }

        # measure this segment
        var j: usize = i;
        for (j < len && !is_separator(p[j])) { j = j + 1; }
        val slen: usize = j - i;

        if (slen == 1 && p[i] == '.') { i = j; cnt; }

        if (slen == 2 && p[i] == '.' && p[i + 1] == '.') {
            if (nseg > 0) {
                # pop the last kept segment
                nseg = nseg - 1;
                w = starts[nseg];
                # drop the separator that preceded it, unless that is the root
                if (w > prefix_end) { w = w - 1; }
            }
            or (!rooted) {
                # nothing to cancel against and no root above: the climb is real
                if (w > prefix_end) { out[w] = separator(); w = w + 1; }
                out[w] = '.'; w = w + 1;
                out[w] = '.'; w = w + 1;
                # a kept `..` is not poppable by a later one, so it is not pushed
            }
            # rooted with nothing to pop: `..` above the root is dropped
            i = j;
            cnt;
        }

        # an ordinary segment
        if (w > prefix_end || (rooted && w > 0 && !is_separator(out[w - 1]))) {
            out[w] = separator();
            w = w + 1;
        }
        if (nseg < seg_cap) { starts[nseg] = w; nseg = nseg + 1; }
        var k: usize = 0;
        for (k < slen) { out[w] = p[i + k]; w = w + 1; k = k + 1; }
        i = j;
    }

    allocator.deallocate[usize](a, starts, seg_cap);

    if (w == 0) {
        allocator.deallocate[u8](a, out, len + 2);
        ret clone_dot(a);
    }
    out[w] = 0;

    # SHRINK TO THE EXACT SIZE EVERY OTHER PATH RETURN USES. `clone`, `join` and
    # `parent` all allocate exactly `str_len + 1`, which is the size `str_free`
    # releases - so a `Path` that came back larger is freed short, and the remainder
    # leaks. Cleaning cannot know its own output length until it has produced it, so
    # the working buffer is sized for the input and handed back trimmed rather than
    # making this one return value the odd one out.
    if (w + 1 < len + 2) {
        val rr: R.Result[*u8, str] = allocator.reallocate[u8](a, out, len + 2, w + 1);
        if (R.is_err[*u8, str](rr)) {
            allocator.deallocate[u8](a, out, len + 2);
            ret R.err[Path, str](R.unwrap_err[*u8, str](rr));
        }
        ret R.ok[Path, str](R.unwrap_ok[*u8, str](rr)::str);
    }
    ret R.ok[Path, str](out::str);
}

# the one-byte relative path `.`
fun clone_dot(a: *allocator.Allocator) R.Result[Path, str] {
    val r: R.Result[*u8, str] = allocator.allocate[u8](a, 2);
    if (R.is_err[*u8, str](r)) { ret R.err[Path, str](R.unwrap_err[*u8, str](r)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    buf[0] = '.';
    buf[1] = 0;
    ret R.ok[Path, str](buf::str);
}

# clone a single separator byte as a null-terminated path

fun clone_sep(a: *allocator.Allocator, sep: u8) R.Result[Path, str] {
    val r: R.Result[*u8, str] = allocator.allocate[u8](a, 2);
    if (R.is_err[*u8, str](r)) {
        ret R.err[Path, str](R.unwrap_err[*u8, str](r));
    }

    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    buf[0] = sep;
    buf[1] = 0;

    ret R.ok[Path, str](buf);
}

# clone the first n bytes of p as a null-terminated path
fun clone_prefix(a: *allocator.Allocator, p: Path, n: usize) R.Result[Path, str] {
    val r: R.Result[*u8, str] = allocator.allocate[u8](a, n + 1);
    if (R.is_err[*u8, str](r)) {
        ret R.err[Path, str](R.unwrap_err[*u8, str](r));
    }

    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    memory.raw_copy(buf::ptr, p::ptr, n);
    buf[n] = 0;

    ret R.ok[Path, str](buf);
}

# parent of a path whose head is an absolute root of length
# rl (> 0). a path at the root returns the root itself, so the volume or
# UNC root is never split or crossed.
fun parent_rooted(a: *allocator.Allocator, p: Path, rl: usize) R.Result[Path, str] {
    val len: usize = str_len(p);

    var end: usize = len;
    for (end > rl && is_separator(p[end - 1])) { end = end - 1; }
    if (end <= rl) { ret clone_prefix(a, p, rl); }

    var i: usize = end;
    for (i > rl) {
        i = i - 1;
        if (is_separator(p[i])) { brk; }
    }
    if (i <= rl) { ret clone_prefix(a, p, rl); }

    var parent_end: usize = i;
    for (parent_end > rl && is_separator(p[parent_end - 1])) { parent_end = parent_end - 1; }
    if (parent_end <= rl) { ret clone_prefix(a, p, rl); }

    ret clone_prefix(a, p, parent_end);
}

# the tests cover the posix semantics that run on every host; the windows
# drive/UNC root arms are comptime-gated to windows targets and only
# exercise there

# on posix only '/' separates; '\' is a legal filename byte
test "std.types.path.is_separator:posix" {
    $if ($mach.build.os != $mach.os.windows) {
        if (!is_separator('/')) { ret 1; }
        if (is_separator('\\')) { ret 1; }
    }
    ret 0;
}

test "std.types.path.is_empty:nil_and_empty" {
    if (!is_empty(nil)) { ret 1; }
    if (!is_empty(""))  { ret 1; }
    if (is_empty("a"))  { ret 1; }
    ret 0;
}

test "std.types.path.is_abs:separator_rooted" {
    if (!is_abs("/foo")) { ret 1; }
    if (is_abs("foo"))   { ret 1; }
    if (is_abs(nil))     { ret 1; }
    ret 0;
}

# a root unit is only separators; anything past them is not a root
test "std.types.path.is_root:separators_only" {
    if (!is_root("/"))   { ret 1; }
    if (!is_root("///")) { ret 1; }
    if (is_root("/a"))   { ret 1; }
    if (is_root("a"))    { ret 1; }
    if (is_root(""))     { ret 1; }
    ret 0;
}

# seg_count sums real segments, ignores '.' and separator runs, and is zero
# for nil, empty, and root paths
test "std.types.path.seg_count:counts_real_segments" {
    if (seg_count("a/b/c") != 3)   { ret 1; }
    if (seg_count("/a/b") != 2)    { ret 1; }
    if (seg_count("a//b/") != 2)   { ret 1; }
    if (seg_count("./a/./b") != 2) { ret 1; }
    if (seg_count(nil) != 0)       { ret 1; }
    if (seg_count("") != 0)        { ret 1; }
    if (seg_count("/") != 0)       { ret 1; }
    ret 0;
}

# a '..' segment climbs one level and the depth floors at zero, so a relative
# path that climbs past its anchor counts from the root
test "std.types.path.seg_count:parent_climbs_floor" {
    if (seg_count("a/b/../c") != 2) { ret 1; }
    if (seg_count("a/../..") != 0)  { ret 1; }
    if (seg_count("../a") != 1)     { ret 1; }
    if (seg_count("../../x/y") != 2) { ret 1; }
    ret 0;
}

# filename is a view: the final component, "" after a trailing separator,
# nil for an empty path
test "std.types.path.filename:views" {
    if (!str_equals(filename("foo/bar.txt"), "bar.txt")) { ret 1; }
    if (!str_equals(filename("bar"), "bar"))             { ret 1; }
    if (!str_equals(filename("/a"), "a"))                { ret 1; }
    if (!str_equals(filename("foo/"), ""))               { ret 1; }
    if (filename("") != nil)                             { ret 1; }
    ret 0;
}

# extension is the text after the last dot; a leading dot is not an extension
test "std.types.path.extension:last_dot" {
    if (!str_equals(extension("a.txt"), "txt"))   { ret 1; }
    if (!str_equals(extension("a.tar.gz"), "gz")) { ret 1; }
    if (extension("bar") != nil)                  { ret 1; }
    if (extension(".hidden") != nil)              { ret 1; }
    if (extension("dir.d/file") != nil)           { ret 1; }
    ret 0;
}

# stem strips the extension from the filename; a dotless or hidden name is
# returned whole
test "std.types.path.stem:strips_extension" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: allocator.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    if (!str_equals(R.unwrap_ok[Path, str](stem(?a, "foo/bar.txt")), "bar")) { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](stem(?a, "bar")), "bar"))         { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](stem(?a, ".hidden")), ".hidden")) { ret 1; }
    ret 0;
}

# a clone is equal in content, a distinct allocation, and nil-propagating
test "std.types.path.clone:distinct_and_nil" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: allocator.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    val src: Path = "x/y";
    val r: R.Result[Path, str] = clone(?a, src);
    if (R.is_err[Path, str](r)) { ret 1; }

    val got: Path = R.unwrap_ok[Path, str](r);
    if (!str_equals(got, "x/y"))  { ret 1; }
    if (got::usize == src::usize) { ret 1; }

    if (R.unwrap_ok[Path, str](clone(?a, nil)) != nil) { ret 1; }
    ret 0;
}

# join inserts exactly one separator; an empty side clones the other
test "std.types.path.join:single_separator" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: allocator.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    var inserted: str = "a/b";
    $if ($mach.build.os == $mach.os.windows) { inserted = "a\\b"; }
    if (!str_equals(R.unwrap_ok[Path, str](join(?a, "a", "b")), inserted)) { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](join(?a, "a/", "b")), "a/b")) { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](join(?a, "a", "/b")), "a/b")) { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](join(?a, "", "b")), "b"))     { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](join(?a, "a", "")), "a"))     { ret 1; }
    ret 0;
}

# parent walks one component up, trims trailing separators, and stops at
# the root; a bare or empty name parents to "."
test "std.types.path.parent:component_up" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: allocator.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    if (!str_equals(R.unwrap_ok[Path, str](parent(?a, "/a/b")), "/a")) { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](parent(?a, "/a/b/")), "/a")) { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](parent(?a, "a/b")), "a"))   { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](parent(?a, "/a")), "/"))    { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](parent(?a, "/")), "/"))     { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](parent(?a, "a")), "."))     { ret 1; }
    if (!str_equals(R.unwrap_ok[Path, str](parent(?a, "")), "."))      { ret 1; }
    ret 0;
}

# resolve clones an absolute path verbatim and joins a relative one
test "std.types.path.resolve:abs_verbatim_rel_joined" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: allocator.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    if (!str_equals(R.unwrap_ok[Path, str](resolve(?a, "/base", "/abs")), "/abs"))     { ret 1; }
    var joined: str = "/base/rel";
    $if ($mach.build.os == $mach.os.windows) { joined = "/base\\rel"; }
    if (!str_equals(R.unwrap_ok[Path, str](resolve(?a, "/base", "rel")), joined)) { ret 1; }
    ret 0;
}

# lexical normalization (mach#2998).
#
# The cases are the ones an editor overlay actually produces: a manifest's `./src`
# against an editor's canonical spelling, a `..` that must cancel, a `..` that must
# NOT cancel because there is nothing above it yet, and a `..` that must not climb
# out of a root.
test "path: clean collapses dot and separator runs" {
    var a: Allocator;
    page.make(?a);

    if (!clean_is(?a, "./src", "src"))                 { ret 1; }
    if (!clean_is(?a, "a/./b", "a/b"))                 { ret 2; }
    if (!clean_is(?a, "a//b", "a/b"))                  { ret 3; }
    if (!clean_is(?a, "a/b/", "a/b"))                  { ret 4; }
    if (!clean_is(?a, "./a/././b//", "a/b"))           { ret 5; }

    # the compiler's own shape: `<root>/./src/f.mach` must equal the editor's
    if (!clean_is(?a, "/r/./src/f.mach", "/r/src/f.mach")) { ret 6; }
    ret 0;
}

test "path: clean resolves dot-dot without leaving the root" {
    var a: Allocator;
    page.make(?a);

    if (!clean_is(?a, "a/../b", "b"))          { ret 1; }
    if (!clean_is(?a, "a/b/../c", "a/c"))      { ret 2; }
    if (!clean_is(?a, "a/b/../../c", "c"))     { ret 3; }

    # A RELATIVE PATH KEEPS A LEADING CLIMB: there is nothing above it to cancel
    # against, so dropping these would change which directory the path names.
    if (!clean_is(?a, "../a", "../a"))         { ret 4; }
    if (!clean_is(?a, "../a/../b", "../b"))    { ret 5; }
    if (!clean_is(?a, "../../a", "../../a"))   { ret 6; }
    # a climb that cancels a real segment first, then keeps going
    if (!clean_is(?a, "a/../../b", "../b"))    { ret 7; }

    # AN ABSOLUTE PATH CANNOT CLIMB OUT: `/..` is `/`, as every resolver behaves.
    if (!clean_is(?a, "/../a", "/a"))          { ret 8; }
    if (!clean_is(?a, "/a/../../b", "/b"))     { ret 9; }
    ret 0;
}

test "path: clean degenerate and root inputs" {
    var a: Allocator;
    page.make(?a);

    # an empty result is spelled `.` so the return is always a usable path
    if (!clean_is(?a, "", "."))        { ret 1; }
    if (!clean_is(?a, ".", "."))       { ret 2; }
    if (!clean_is(?a, "./", "."))      { ret 3; }
    if (!clean_is(?a, "a/..", "."))    { ret 4; }
    if (!clean_is(?a, "..", ".."))     { ret 5; }

    # a root stays a root rather than becoming `.`
    if (!clean_is(?a, "/", "/"))       { ret 6; }
    if (!clean_is(?a, "//", "/"))      { ret 7; }
    if (!clean_is(?a, "////", "/"))    { ret 12; }
    if (!clean_is(?a, "/.", "/"))      { ret 8; }
    if (!clean_is(?a, "/..", "/"))     { ret 9; }

    # CLEAN IS IDEMPOTENT: cleaning an already-clean path returns it unchanged,
    # which is what lets a consumer compare two cleaned paths for identity.
    if (!clean_is(?a, "a/b", "a/b"))   { ret 10; }
    if (!clean_is(?a, "/a/b", "/a/b")) { ret 11; }
    ret 0;
}

# the roots only windows has. A drive or UNC root is what `root_len` exists to
# protect, and a `..` must not climb through one any more than through a posix `/`.
# A bare `C:` is drive-RELATIVE, so it is not a root to be protected: `C:..` climbs
# above the current directory on that drive exactly as `..` does.
test "path: clean preserves windows drive and UNC roots" {
    $if ($mach.build.os == $mach.os.windows) {
        var a: Allocator;
        page.make(?a);

        if (!clean_is(?a, "C:/a/./b", "C:/a/b"))       { ret 1; }
        if (!clean_is(?a, "C:/a/../b", "C:/b"))        { ret 2; }
        # cannot climb out of a drive root
        if (!clean_is(?a, "C:/../a", "C:/a"))          { ret 3; }
        if (!clean_is(?a, "C:/", "C:/"))               { ret 4; }
        # a forward-slash spelling comes back native, which is the whole point for a
        # compiler-produced path meeting an editor-produced one
        if (!clean_is(?a, "C:/a/b", "C:/a/b"))         { ret 5; }

        # UNC: the whole `\\server\share` is one indivisible root
        if (!clean_is(?a, "//server/share/a/./b", "//server/share/a/b")) { ret 6; }
        if (!clean_is(?a, "//server/share/../a", "//server/share/a"))    { ret 7; }
        if (!clean_is(?a, "//server/share/a/..", "//server/share"))      { ret 8; }
        if (!clean_is(?a, "//server//share///a", "//server/share/a"))   { ret 9; }
        if (!clean_is(?a, "C:a/../b", "C:b"))                        { ret 10; }
        if (!clean_is(?a, "C:../a", "C:../a"))                       { ret 11; }
    }
    ret 0;
}

# clean `input` and compare the result against `want`
#
# `want` is written with `/` and translated to the target's separator before the
# comparison, because `clean` emits the NATIVE one - so these cases state the shape
# they mean once and hold on every platform rather than encoding a posix spelling
# that the windows leg would fail on.
fun clean_is(a: *Allocator, input: str, want: str) bool {
    val r: R.Result[Path, str] = clean(a, input);
    if (R.is_err[Path, str](r)) { ret false; }
    val got: Path = R.unwrap_ok[Path, str](r);

    val wl: usize = str_len(want);
    var buf: [128]u8;
    if (wl >= 128) { ret false; }
    var i: usize = 0;
    for (i < wl) {
        if (want[i] == '/') { buf[i] = separator(); }
        or                  { buf[i] = want[i]; }
        i = i + 1;
    }
    buf[wl] = 0;
    ret str_equals(got, (?buf[0])::str);
}

# A RETURNED PATH IS FREEABLE WITH `str_free`, which is the contract every other
# allocating function here already keeps: `clone`, `join` and `parent` all reserve
# exactly `str_len + 1`. `clean` cannot know its output length until it has produced
# it, so it works in a buffer sized for the input and must hand back a trimmed one -
# otherwise a consumer frees `str_len + 1` of a larger allocation and the remainder
# leaks. Caught by a leak test one repo over (briar-systems/mach#3001's steady-state
# assertions), which is exactly the distance a size mismatch travels before anyone
# notices, hence this one asserts the balance directly.
rec CleanCount {
    backing: Allocator;
    live:    i64;
}

fun clean_count_alloc(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val c: *CleanCount = ctx::*CleanCount;
    val r: O.Option[ptr] = c.backing.fn_allocate(c.backing.ctx, size, align);
    if (O.is_some[ptr](r)) { c.live = c.live + size::i64; }
    ret r;
}
fun clean_count_realloc(ctx: ptr, p: ptr, o: usize, n: usize, align: usize) O.Option[ptr] {
    val c: *CleanCount = ctx::*CleanCount;
    val r: O.Option[ptr] = c.backing.fn_reallocate(c.backing.ctx, p, o, n, align);
    if (O.is_some[ptr](r)) { c.live = c.live - o::i64 + n::i64; }
    ret r;
}
fun clean_count_dealloc(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    val c: *CleanCount = ctx::*CleanCount;
    c.live = c.live - size::i64;
    ret c.backing.fn_deallocate(c.backing.ctx, p, size, align);
}

fun clean_refuse_realloc(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

test "path: failed output shrink releases every allocation" {
    var cc: CleanCount;
    if (O.is_some[str](page.make(?cc.backing))) { ret 1; }
    cc.live = 0;
    var a: Allocator;
    a.ctx = (?cc)::ptr;
    a.fn_allocate = clean_count_alloc;
    a.fn_reallocate = clean_refuse_realloc;
    a.fn_deallocate = clean_count_dealloc;

    val r: R.Result[Path, str] = clean(?a, "a/./b");
    if (R.is_ok[Path, str](r)) { str_free(?a, R.unwrap_ok[Path, str](r)); ret 2; }
    if (cc.live == 7) { ret 7; }
    if (cc.live != 0) { ret 3; }
    ret 0;
}

test "path: a cleaned path frees to exactly nothing" {
    var cc: CleanCount;
    if (O.is_some[str](page.make(?cc.backing))) { ret 1; }
    cc.live = 0;
    var a: Allocator;
    a.ctx = (?cc)::ptr;
    a.fn_allocate = clean_count_alloc;
    a.fn_reallocate = clean_count_realloc;
    a.fn_deallocate = clean_count_dealloc;

    # the shapes whose cleaned length differs most from their input length
    var inputs: [6]str;
    inputs[0] = "a/./b";
    inputs[1] = "./src/f.mach";
    inputs[2] = "/r/./src/./deep/../f.mach";
    inputs[3] = "a//////b";
    inputs[4] = "a/b";
    inputs[5] = "";

    var i: usize = 0;
    for (i < 6) {
        val r: R.Result[Path, str] = clean(?a, inputs[i]);
        if (R.is_err[Path, str](r)) { ret 2; }
        val got: Path = R.unwrap_ok[Path, str](r);
        str_free(?a, got);
        # freeing by string length must return every byte the clean took
        if (cc.live != 0) { ret 3; }
        i = i + 1;
    }
    ret 0;
}


fun root_is(p: Path, expected: str) bool {
    val v: view.View = root(p);
    ret v.data == p && view.view_eq_str(v, expected);
}

test "std.types.path.root: borrowed prefixes preserve ownership and spelling" {
    if (!root_is(nil, "")) { ret 1; }
    if (!root_is("", "")) { ret 2; }
    if (!root_is("relative/child", "")) { ret 3; }
    if (!root_is("/child", "/")) { ret 4; }
    if (!root_is("//", "/")) { ret 5; }
    if (!root_is("////", "/")) { ret 6; }
    ret 0;
}

test "std.types.path.root: platform anchors are indivisible" {
    $if ($mach.build.os == $mach.os.windows) {
        if (!root_is("C:\\child", "C:\\")) { ret 1; }
        if (!root_is("C:/child", "C:/")) { ret 2; }
        if (!root_is("C:", "C:")) { ret 3; }
        if (!root_is("C:child", "C:")) { ret 4; }
        if (!root_is("\\child", "\\")) { ret 5; }
        if (!root_is("\\\\", "\\")) { ret 6; }
        if (!root_is("/\\/", "/")) { ret 7; }
        if (!root_is("\\\\server\\share\\child", "\\\\server\\share")) { ret 8; }
        if (!root_is("//server/share/child", "//server/share")) { ret 9; }
        if (!root_is("//server\\share/child", "//server\\share")) { ret 10; }
        if (!root_is("//server", "//server")) { ret 11; }
        if (!root_is("//server/share", "//server/share")) { ret 12; }
    }
    $or {
        if (!root_is("C:/child", "")) { ret 1; }
        if (!root_is("C:child", "")) { ret 2; }
        if (!root_is("\\child", "")) { ret 3; }
        if (!root_is("//server/share/child", "/")) { ret 4; }
        if (!root_is("\\\\server\\share", "")) { ret 5; }
    }
    ret 0;
}

test "std.types.path.seg_count: excludes platform root units" {
    $if ($mach.build.os == $mach.os.windows) {
        if (seg_count("C:") != 0) { ret 1; }
        if (seg_count("C:/") != 0) { ret 2; }
        if (seg_count("C:\\") != 0) { ret 3; }
        if (seg_count("C:/a/b") != 2) { ret 4; }
        if (seg_count("C:a/b") != 2) { ret 5; }
        if (seg_count("C:../a") != 1) { ret 6; }
        if (seg_count("C:/../../a") != 1) { ret 7; }
        if (seg_count("//server/share") != 0) { ret 8; }
        if (seg_count("\\\\server\\share\\a\\b") != 2) { ret 9; }
        if (seg_count("//server\\share/a/../b") != 1) { ret 10; }
        if (seg_count("//server/share/../../a") != 1) { ret 11; }
        if (seg_count("//server/share///") != 0) { ret 12; }
    }
    $or {
        if (seg_count("C:/a") != 2) { ret 1; }
        if (seg_count("C:../a") != 2) { ret 2; }
        if (seg_count("\\\\server\\share") != 1) { ret 3; }
        if (seg_count("//server/share") != 2) { ret 4; }
        if (seg_count("/../../a") != 1) { ret 5; }
    }
    ret 0;
}
