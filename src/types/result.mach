# the canonical result tag: res[T, E]
#
# a fallible operation with a value is spelled `res[T, E]`. it is an ordinary
# std declaration (mach doc/design/tagged-values.md fixes the language
# contract; the compiler seeds nothing and treats it like any other tag). a
# consuming module gains `use std.types.result.res;` and spells the bare name.
# the sibling tags live in `std.types.option` (`opt[T]`) and
# `std.types.error` (`err[E]`).
#
# res[T, E]: `err: E` is case 0 and `ok: T` is case 1; `E` is the producing
# module's closed domain tag, never a string. the zero value reads as `err`
# with a zero error, so uninitialized storage never reads as success.
#
# the discriminator is a u8 at offset zero and the payload follows at its
# natural alignment. the three canonical tags nest freely (`res[opt[T], E]`,
# `res[T, Tag]`) and instantiate user generics like any declared type.
#
# reading: `sel place.case` is the test, and the guarded payload place is the
# read. an `if (!sel r.ok) { ret ...; }` chain guards `r.ok` for the rest of
# the block; `||` opens no guard, so one term per `if`. construction is
# `Type.case{...}` only. no helper functions are provided on purpose: a
# by-value `unwrap` would copy owning payloads out of the ownership rules,
# and a constructor function would be a second spelling of a form the
# language already has. the tests below pin the shape: case order, case
# codes, zero defaults, layout, reflection, nesting and guards.

pub tag res[T, E]: u8 { err: E; ok: T; }

use std.types.option.opt;
use std.types.error.err;
use std.types.size.usize;

fun code(p: *u8) u8 { ret p[0]; }

test "std.types.result.res: err is case 0 and ok is case 1" {
    var zero: res[i64, i32];
    if (!sel zero.err)                { ret 1; }
    if (zero.err != 0)                { ret 2; }
    if (code((?zero)::*u8) != 0)      { ret 3; }

    var good: res[i64, i32] = res[i64, i32].ok{42};
    if (!sel good.ok)                 { ret 4; }
    if (good.ok != 42)                { ret 5; }
    if (code((?good)::*u8) != 1)      { ret 6; }

    var bad: res[i64, i32] = res[i64, i32].err{-7};
    if (!sel bad.err)                 { ret 7; }
    if (bad.err != -7)                { ret 8; }
    if (code((?bad)::*u8) != 0)       { ret 9; }
    ret 0;
}

# the discriminator is a u8 at offset zero and the payload follows at the
# payload's natural alignment, which is the layout the contract fixes
test "std.types.result.res: discriminator is u8 at offset zero" {
    if ($size_of($discriminant_of(res[i64, i32])) != 1) { ret 1; }
    if ($offset_of(res[i64, i32], ok) != 8)             { ret 2; }
    if ($offset_of(res[i64, i32], err) != 8)            { ret 3; }
    if ($size_of(res[i64, i32]) != 16)                  { ret 4; }
    ret 0;
}

# reflection sees exactly two cases in declaration order
test "std.types.result.res: reflection enumerates the contract cases" {
    var n: usize = 0;
    $each c in $cases(res[i64, i32]) { n = n + 1; }
    if (n != 2) { ret 1; }
    $if (!$is_tag(res[i64, i32])) { ret 2; }
    ret 0;
}

# the three nest: a result of an option, an option of a result, and a result
# whose error is another tag all read through chained guards
tag Cause: u8 { missing; refused: i32; }

fun lookup(key: i64) res[opt[i64], Cause] {
    if (key < 0)  { ret res[opt[i64], Cause].err{Cause.refused{-1}}; }
    if (key == 0) { ret res[opt[i64], Cause].ok{opt[i64].none{}}; }
    ret res[opt[i64], Cause].ok{opt[i64].some{key * 2}};
}

test "std.types.result.res: tags nest and guard through the chain" {
    val refused: res[opt[i64], Cause] = lookup(-1);
    if (!sel refused.err)             { ret 1; }
    if (!sel refused.err.refused)     { ret 2; }
    if (refused.err.refused != -1)    { ret 3; }

    val absent: res[opt[i64], Cause] = lookup(0);
    if (!sel absent.ok)               { ret 4; }
    if (!sel absent.ok.none)          { ret 5; }

    val present: res[opt[i64], Cause] = lookup(21);
    if (!sel present.ok)              { ret 6; }
    if (!sel present.ok.some)         { ret 7; }
    if (present.ok.some != 42)        { ret 8; }

    var wrapped: opt[res[i64, Cause]] = opt[res[i64, Cause]].some{res[i64, Cause].ok{7}};
    if (!sel wrapped.some)            { ret 9; }
    if (!sel wrapped.some.ok)         { ret 10; }
    if (wrapped.some.ok != 7)         { ret 11; }

    var flat: res[err[Cause], Cause] = res[err[Cause], Cause].ok{err[Cause].ok{}};
    if (!sel flat.ok)                 { ret 12; }
    if (!sel flat.ok.ok)              { ret 13; }
    ret 0;
}

# an exiting chain guards the remainder of the block, and a loop body
# re-establishes its guard every iteration
test "std.types.result.res: exiting chains guard the rest of the block" {
    var total: i64 = 0;
    var key: i64 = 1;
    for (key < 5) {
        val found: res[opt[i64], Cause] = lookup(key);
        if (!sel found.ok) { ret 1; }
        if (!sel found.ok.some) { key = key + 1; cnt; }
        total = total + found.ok.some;
        key = key + 1;
    }
    if (total != 20) { ret 2; }
    ret 0;
}

# a user generic instantiates over the canonical tag like over any other
# declared type: the tag is an ordinary std declaration
rec Holder[T] { item: T; }

fun hold[T](item: T) Holder[T] { ret Holder[T]{item: item}; }

test "std.types.result.res: user generics instantiate over the canonical tag" {
    val outcome: Holder[res[i64, Cause]] = hold[res[i64, Cause]](res[i64, Cause].err{Cause.missing{}});
    if (!sel outcome.item.err)         { ret 1; }
    if (!sel outcome.item.err.missing) { ret 2; }

    val good: Holder[res[i64, Cause]] = hold[res[i64, Cause]](res[i64, Cause].ok{42});
    if (!sel good.item.ok)             { ret 3; }
    if (good.item.ok != 42)            { ret 4; }

    var empty: Holder[res[i64, Cause]];
    if (!sel empty.item.err)           { ret 5; }
    if (!sel empty.item.err.missing)   { ret 6; }
    ret 0;
}
