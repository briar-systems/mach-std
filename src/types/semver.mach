# semantic versioning (SemVer 2.0.0)

use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char_is_alnum;
use std.types.char.char_is_digit;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.allocator;

$if (capability.HOSTED) {
    use std.allocator.page;
    use std.allocator.testing;
}

use std.memory;

# why a version string did not parse
#
# the first case is the zero default.
# ---
# empty:  the input is nil or empty
# syntax: the byte offset of the first byte that violates SemVer 2.0.0 (a
#         missing separator or number is reported at the offset where one was
#         expected)
# alloc:  the allocator refused a prerelease or build copy, with its reason
pub tag SemverError: u8 {
    empty;
    syntax: usize;
    alloc:  allocator.Error;
}

# a semantic version per SemVer 2.0.0
# ---
# major:      major version number
# minor:      minor version number
# patch:      patch version number
# prerelease: optional prerelease identifier (e.g. "alpha.1")
# build:      optional build metadata
pub rec Semver {
    major:      u64;
    minor:      u64;
    patch:      u64;
    prerelease: str;
    build:      str;
}

# parse a version string into a Semver
# ---
# input: version string (major.minor.patch[-prerelease][+build])
# a:     allocator for prerelease/build substring copies
# ret:   the parsed version, or why it did not parse
pub fun semver_parse(input: str, a: *allocator.Allocator) res[Semver, SemverError] {
    if (input == nil || str_len(input) == 0) {
        ret res[Semver, SemverError].err{SemverError.empty{}};
    }

    var v:   Semver;
    var pos: usize = 0;

    val major: opt[u64] = parse_number(input, ?pos);
    if (!sel major.some) { ret res[Semver, SemverError].err{SemverError.syntax{pos}}; }
    v.major = major.some;

    if (pos >= str_len(input) || input[pos] != '.') {
        ret res[Semver, SemverError].err{SemverError.syntax{pos}};
    }
    pos = pos + 1;

    val minor: opt[u64] = parse_number(input, ?pos);
    if (!sel minor.some) { ret res[Semver, SemverError].err{SemverError.syntax{pos}}; }
    v.minor = minor.some;

    if (pos >= str_len(input) || input[pos] != '.') {
        ret res[Semver, SemverError].err{SemverError.syntax{pos}};
    }
    pos = pos + 1;

    val patch: opt[u64] = parse_number(input, ?pos);
    if (!sel patch.some) { ret res[Semver, SemverError].err{SemverError.syntax{pos}}; }
    v.patch = patch.some;

    if (pos < str_len(input) && input[pos] == '-') {
        pos = pos + 1;
        val start: usize = pos;

        for (pos < str_len(input)) {
            val c: u8 = input[pos];
            if (c == '+') { brk; }
            if (!is_valid_prerelease_char(c)) {
                ret res[Semver, SemverError].err{SemverError.syntax{pos}};
            }
            pos = pos + 1;
        }

        val pre_len: usize                     = pos - start;
        val got:     res[ptr, allocator.Error] = allocator.allocate_raw(a, pre_len + 1, 1);
        if (sel got.err) { ret res[Semver, SemverError].err{SemverError.alloc{got.err}}; }
        val buf: *u8 = got.ok::*u8;
        memory.raw_copy(buf::ptr, (input::usize + start)::ptr, pre_len);
        buf[pre_len] = 0;
        v.prerelease = buf::str;
    }

    if (pos < str_len(input) && input[pos] == '+') {
        pos = pos + 1;
        val start: usize = pos;

        for (pos < str_len(input)) {
            val c: u8 = input[pos];
            if (!is_valid_build_char(c)) {
                ret res[Semver, SemverError].err{SemverError.syntax{pos}};
            }
            pos = pos + 1;
        }

        val bld_len: usize                     = pos - start;
        val got:     res[ptr, allocator.Error] = allocator.allocate_raw(a, bld_len + 1, 1);
        if (sel got.err) {
            if (v.prerelease != nil) { allocator.deallocate_raw(a, v.prerelease::ptr, str_len(v.prerelease) + 1, 1); }
            ret res[Semver, SemverError].err{SemverError.alloc{got.err}};
        }
        val buf: *u8 = got.ok::*u8;
        memory.raw_copy(buf::ptr, (input::usize + start)::ptr, bld_len);
        buf[bld_len] = 0;
        v.build      = buf::str;
    }

    ret res[Semver, SemverError].ok{v};
}

# validate that a Semver is well-formed
pub fun semver_is_valid(v: *Semver) bool {
    if (!(v.prerelease == nil || str_len(v.prerelease) == 0)) {
        var i: usize = 0;
        for (v.prerelease[i] != 0) {
            if (!is_valid_prerelease_char(v.prerelease[i])) {
                ret false;
            }
            i = i + 1;
        }
    }

    if (!(v.build == nil || str_len(v.build) == 0)) {
        var i: usize = 0;
        for (v.build[i] != 0) {
            if (!is_valid_build_char(v.build[i])) {
                ret false;
            }
            i = i + 1;
        }
    }

    ret true;
}

# compare two semvers for precedence (ignores build metadata)
# ---
# v:     first version
# other: version to compare against
# ret:   <0 if v < other, 0 if equal, >0 if v > other
pub fun semver_compare(v: *Semver, other: *Semver) i64 {
    if (v.major < other.major) { ret -1; }
    if (v.major > other.major) { ret 1; }

    if (v.minor < other.minor) { ret -1; }
    if (v.minor > other.minor) { ret 1; }

    if (v.patch < other.patch) { ret -1; }
    if (v.patch > other.patch) { ret 1; }

    val this_has_pre:  bool = !(v.prerelease == nil || str_len(v.prerelease) == 0);
    val other_has_pre: bool = !(other.prerelease == nil || str_len(other.prerelease) == 0);

    if (!this_has_pre && other_has_pre) { ret 1; }
    if (this_has_pre && !other_has_pre) { ret -1; }

    if (this_has_pre && other_has_pre) {
        ret compare_prerelease(v.prerelease, other.prerelease);
    }

    ret 0;
}

# check if v is less than other
pub fun semver_is_less(v: *Semver, other: *Semver) bool {
    ret semver_compare(v, other) < 0;
}

# check if v is greater than other
pub fun semver_is_greater(v: *Semver, other: *Semver) bool {
    ret semver_compare(v, other) > 0;
}

# check if two versions are equal (ignoring build metadata)
pub fun semver_equals(v: *Semver, other: *Semver) bool {
    ret semver_compare(v, other) == 0;
}

# check whether v is a stable release
pub fun semver_is_stable(v: *Semver) bool {
    ret v.prerelease == nil || str_len(v.prerelease) == 0;
}

# check whether v is a prerelease
pub fun semver_is_prerelease(v: *Semver) bool {
    ret !(v.prerelease == nil || str_len(v.prerelease) == 0);
}

# check whether v has build metadata
pub fun semver_has_build(v: *Semver) bool {
    ret !(v.build == nil || str_len(v.build) == 0);
}

# parse an unsigned number from input at pos
# ---
# input: input string
# pos:   pointer to current position (advanced past the number on success)
# ret:   some(value), or none when no digits are present or the value overflows
fun parse_number(input: str, pos: *usize) opt[u64] {
    val start:       usize = @pos;
    var value:       u64   = 0;
    var found_digit: bool  = false;

    for (@pos < str_len(input)) {
        val c: u8 = input[@pos];
        if (!char_is_digit(c)) { brk; }

        val digit: u64 = (c - '0')::u64;
        if (value > 1844674407370955161 || (value == 1844674407370955161 && digit > 5)) {
            ret opt[u64].none{};
        }

        found_digit = true;
        value       = value * 10 + digit;
        @pos        = @pos + 1;
    }

    if (!found_digit) { ret opt[u64].none{}; }
    ret opt[u64].some{value};
}

# check if a byte is valid in a prerelease identifier
fun is_valid_prerelease_char(c: u8) bool {
    ret char_is_alnum(c) || c == '.' || c == '-';
}

# check if a byte is valid in build metadata
fun is_valid_build_char(c: u8) bool {
    ret char_is_alnum(c) || c == '.' || c == '-';
}

# compare two prerelease strings per SemVer rules
# ---
# a:   first prerelease string
# b:   second prerelease string
# ret: <0 if a < b, 0 if equal, >0 if a > b
fun compare_prerelease(a: str, b: str) i64 {
    var a_pos: usize = 0;
    var b_pos: usize = 0;

    for {
        val a_len: usize = str_len(a);
        val b_len: usize = str_len(b);

        if (a_pos >= a_len && b_pos >= b_len) { ret 0; }
        if (a_pos >= a_len)                   { ret -1; }
        if (b_pos >= b_len)                   { ret 1; }

        var a_start: usize = a_pos;
        for (a_pos < a_len && a[a_pos] != '.') {
            a_pos = a_pos + 1;
        }
        val a_ident_len: usize = a_pos - a_start;

        var b_start: usize = b_pos;
        for (b_pos < b_len && b[b_pos] != '.') {
            b_pos = b_pos + 1;
        }
        val b_ident_len: usize = b_pos - b_start;

        val cmp: i64 = compare_identifier((a::usize + a_start)::str, a_ident_len, (b::usize + b_start)::str, b_ident_len);
        if (cmp != 0) { ret cmp; }

        if (a_pos < a_len) { a_pos = a_pos + 1; }
        if (b_pos < b_len) { b_pos = b_pos + 1; }
    }

    ret 0;
}

# compare two identifiers per SemVer rules
# ---
# a:     first identifier
# a_len: length of first identifier
# b:     second identifier
# b_len: length of second identifier
# ret:   <0 if a < b, 0 if equal, >0 if a > b
fun compare_identifier(a: str, a_len: usize, b: str, b_len: usize) i64 {
    val a_numeric: bool = is_numeric(a, a_len);
    val b_numeric: bool = is_numeric(b, b_len);

    if (a_numeric && !b_numeric) { ret -1; }
    if (!a_numeric && b_numeric) { ret 1; }

    if (a_numeric && b_numeric) {
        val a_val: u64 = parse_identifier_num(a, a_len);
        val b_val: u64 = parse_identifier_num(b, b_len);
        if (a_val < b_val) { ret -1; }
        if (a_val > b_val) { ret 1; }
        ret 0;
    }

    ret compare_bounded(a, a_len, b, b_len);
}

# check whether the first len bytes of s are all digits
# ---
# s:   string to check
# len: number of bytes to examine
# ret: true if all bytes are digits and len > 0
fun is_numeric(s: str, len: usize) bool {
    if (len == 0) { ret false; }

    var i: usize = 0;
    for (i < len) {
        if (!char_is_digit(s[i])) { ret false; }
        i = i + 1;
    }

    ret true;
}

# parse the first len bytes of s as a number
# ---
# s:   string containing digits
# len: number of bytes to parse
# ret: the parsed value
fun parse_identifier_num(s: str, len: usize) u64 {
    var value: u64   = 0;
    var i:     usize = 0;

    for (i < len) {
        val c: u8 = s[i];
        if (char_is_digit(c)) {
            value = value * 10 + (c - '0')::u64;
        }
        i = i + 1;
    }

    ret value;
}

# lexicographic comparison of two bounded strings
# ---
# a:     first string
# a_len: length of first string
# b:     second string
# b_len: length of second string
# ret:   <0 if a < b, 0 if equal, >0 if a > b
fun compare_bounded(a: str, a_len: usize, b: str, b_len: usize) i64 {
    var min_len: usize = a_len;
    if (b_len < min_len) { min_len = b_len; }

    var i: usize = 0;
    for (i < min_len) {
        if (a[i] < b[i]) { ret -1; }
        if (a[i] > b[i]) { ret 1; }
        i = i + 1;
    }

    if (a_len < b_len) { ret -1; }
    if (a_len > b_len) { ret 1; }
    ret 0;
}

$if (capability.HOSTED) {
    test semver__parse_splits_prerelease_and_build {
        var pa: allocator.Allocator;
        page.make(?pa);

        val r1: res[Semver, SemverError] = semver_parse("1.2.3", ?pa);
        if (sel r1.err) { ret 1; }
        val plain: Semver = r1.ok;
        if (plain.major != 1 || plain.minor != 2 || plain.patch != 3)  { ret 2; }
        if (!semver_is_stable(?plain) || semver_is_prerelease(?plain)) { ret 3; }
        if (semver_has_build(?plain))                                  { ret 4; }

        val r2: res[Semver, SemverError] = semver_parse("2.0.0-rc.1+sha.abc", ?pa);
        if (sel r2.err) { ret 5; }
        val both: Semver = r2.ok;
        if (!str_equals(both.prerelease, "rc.1"))                    { ret 6; }
        if (!str_equals(both.build, "sha.abc"))                      { ret 7; }
        if (semver_is_stable(?both) || !semver_is_prerelease(?both)) { ret 8; }
        if (!semver_has_build(?both))                                { ret 9; }

        val r3: res[Semver, SemverError] = semver_parse("1.0.0+build", ?pa);
        if (sel r3.err) { ret 10; }
        val built: Semver = r3.ok;
        if (semver_is_prerelease(?built))      { ret 11; }
        if (!str_equals(built.build, "build")) { ret 12; }
        ret 0;
    }

    #[testing]
    fun order(pa: *allocator.Allocator, a: str, b: str) i64 {
        val ra: res[Semver, SemverError] = semver_parse(a, pa);
        val rb: res[Semver, SemverError] = semver_parse(b, pa);
        if (sel ra.err) { ret 99; }
        if (sel rb.err) { ret 99; }
        var va: Semver = ra.ok;
        var vb: Semver = rb.ok;
        ret semver_compare(?va, ?vb);
    }

    # precedence per semver 2.0.0 section 11, each rule both ways round
    test semver__precedence_follows_the_spec {
        var pa: allocator.Allocator;
        page.make(?pa);
        if (order(?pa, "1.9.9", "2.0.0") >= 0)                  { ret 1; }
        if (order(?pa, "1.0.0", "1.0.0-alpha") <= 0)            { ret 2; }
        if (order(?pa, "1.0.0-alpha.1", "1.0.0-alpha.2") >= 0)  { ret 3; }
        if (order(?pa, "1.0.0-alpha.2", "1.0.0-alpha.10") >= 0) { ret 4; }
        if (order(?pa, "1.0.0-1", "1.0.0-alpha") >= 0)          { ret 5; }
        if (order(?pa, "1.0.0-alpha", "1.0.0-alpha.1") >= 0)    { ret 6; }
        if (order(?pa, "1.0.0-alpha.1", "1.0.0-alpha") <= 0)    { ret 7; }
        if (order(?pa, "1.0.0+build1", "1.0.0+build2") != 0)    { ret 8; }
        if (order(?pa, "1.2.3", "1.2.3") != 0)                  { ret 9; }
        ret 0;
    }

    # each way a version string can fail is its own case, and a syntax error says
    # where: absence of a number and a missing separator are reported at the offset
    # where one was expected, an invalid identifier byte at its own offset
    test semver__parse_failures_are_distinct_and_positioned {
        var pa: allocator.Allocator;
        page.make(?pa);

        val empty: res[Semver, SemverError] = semver_parse("", ?pa);
        if (!sel empty.err)       { ret 1; }
        if (!sel empty.err.empty) { ret 2; }

        val no_major: res[Semver, SemverError] = semver_parse("x.2.3", ?pa);
        if (!sel no_major.err)        { ret 3; }
        if (!sel no_major.err.syntax) { ret 4; }
        if (no_major.err.syntax != 0) { ret 5; }

        val no_dot: res[Semver, SemverError] = semver_parse("1x2.3", ?pa);
        if (!sel no_dot.err)        { ret 6; }
        if (!sel no_dot.err.syntax) { ret 7; }
        if (no_dot.err.syntax != 1) { ret 8; }

        val no_patch: res[Semver, SemverError] = semver_parse("1.2.", ?pa);
        if (!sel no_patch.err)        { ret 9; }
        if (!sel no_patch.err.syntax) { ret 10; }
        if (no_patch.err.syntax != 4) { ret 11; }

        val bad_pre: res[Semver, SemverError] = semver_parse("1.2.3-al!pha", ?pa);
        if (!sel bad_pre.err)        { ret 12; }
        if (!sel bad_pre.err.syntax) { ret 13; }
        if (bad_pre.err.syntax != 8) { ret 14; }

        val bad_build: res[Semver, SemverError] = semver_parse("1.2.3+a b", ?pa);
        if (!sel bad_build.err)        { ret 15; }
        if (!sel bad_build.err.syntax) { ret 16; }
        if (bad_build.err.syntax != 7) { ret 17; }

        val overflow: res[Semver, SemverError] = semver_parse("99999999999999999999.0.0", ?pa);
        if (!sel overflow.err)        { ret 18; }
        if (!sel overflow.err.syntax) { ret 19; }
        ret 0;
    }

    # a refused copy is the allocator's refusal, and a prerelease copied before a
    # refused build copy is released rather than leaked
    test semver__a_refused_identifier_copy_is_the_allocator_s_and_leaks_nothing {
        var t:  testing.Testing;
        val mr: err[allocator.Error] = testing.make(?t);
        if (sel mr.err) { ret 1; }

        testing.fail_at_ordinal(?t, 1);
        val pre: res[Semver, SemverError] = semver_parse("1.0.0-alpha", ?t.a);
        if (!sel pre.err) {
            testing.dnit(?t);
            ret 2;
        }
        if (!sel pre.err.alloc) {
            testing.dnit(?t);
            ret 3;
        }
        if (!sel pre.err.alloc.exhausted) {
            testing.dnit(?t);
            ret 4;
        }
        if (testing.leaked(?t)) {
            testing.dnit(?t);
            ret 5;
        }

        testing.fail_at_ordinal(?t, testing.attempt_count(?t) + 2);
        val build: res[Semver, SemverError] = semver_parse("1.0.0-alpha+build", ?t.a);
        if (!sel build.err) {
            testing.dnit(?t);
            ret 6;
        }
        if (!sel build.err.alloc) {
            testing.dnit(?t);
            ret 7;
        }
        if (testing.leaked(?t)) {
            testing.dnit(?t);
            ret 8;
        }

        testing.clear_failure(?t);
        val both: res[Semver, SemverError] = semver_parse("1.0.0-alpha+build", ?t.a);
        if (!sel both.ok) {
            testing.dnit(?t);
            ret 9;
        }
        if (testing.live_count(?t) != 2) {
            testing.dnit(?t);
            ret 10;
        }
        allocator.deallocate_raw(?t.a, both.ok.prerelease::ptr, str_len(both.ok.prerelease) + 1, 1);
        allocator.deallocate_raw(?t.a, both.ok.build::ptr, str_len(both.ok.build) + 1, 1);
        if (testing.leaked(?t)) {
            testing.dnit(?t);
            ret 11;
        }
        testing.dnit(?t);
        ret 0;
    }
}
