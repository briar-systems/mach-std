# null-terminated string queries and allocating constructors
#
# nil contract: nil is the empty string throughout. queries and predicates
# treat it as "", and constructors produce a fresh empty allocation for it.
# constructors fail only on allocation failure or a nil allocator, never on
# their string inputs.

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.char.char;
use std.types.char.char_is_space;
use std.types.char.char_to_lower;
use std.types.char.char_to_upper;
use std.memory;
use std.allocator.fixed;

use A: std.allocator;

# a pointer to a null-terminated sequence of char
pub def str: *char;

# why an allocating string constructor did not produce a string
#
# the first case is the zero default, so a zero-initialized `res[str, StrError]`
# reads as an allocation refusal.
# ---
# alloc:  the allocator refused, with its reason
# bounds: a slice does not lie within its string
pub tag StrError: u8 {
    alloc:  A.Error;
    bounds;
}

# a string that owns its storage, with the extent needed to release it
#
# a plain owned `str` from this module is released with `str_len + 1` bytes,
# because that is what its constructor reserved. a producer whose buffer may
# be larger than its final text (an environment value read into a probe, a
# path normalized in place) cannot be released by length, so it hands the
# caller this record instead. the record holds no pointer to itself and may
# be copied into its final storage; exactly one copy is released.
# ---
# data:   the null-terminated text, or nil when nothing is owned
# len:    the logical length, excluding the terminator
# extent: the allocated byte count, at least len + 1 when data is not nil
# a:      the allocator that owns the extent
pub rec OwnedString {
    data:   str;
    len:    usize;
    extent: usize;
    a:      *A.Allocator;
}

# take ownership of a buffer an allocator already served
#
# `data` must be `extent` bytes served by `a`, null-terminated within its
# first `len + 1` bytes. nothing is allocated.
# ---
# a:      the allocator that served data
# data:   the buffer to own
# len:    the logical length of the text in data
# extent: the byte count a served
# ret:    the owning record
pub fun owned_adopt(a: *A.Allocator, data: str, len: usize, extent: usize) OwnedString {
    var o: OwnedString;
    o.data   = data;
    o.len    = len;
    o.extent = extent;
    o.a      = a;
    ret o;
}

# an owned copy of a string whose extent is exactly its length plus one
# ---
# a:   allocator for the copy
# s:   string to copy (nil copies as empty)
# ret: the owning record, or the allocator's refusal
pub fun owned_dup(a: *A.Allocator, s: str) res[OwnedString, A.Error] {
    if (a == nil) { ret res[OwnedString, A.Error].err{A.Error.invalid{}}; }

    val len: usize = str_len(s);
    val got: res[str, A.Error] = A.allocate[char](a, len + 1);
    if (sel got.err) { ret res[OwnedString, A.Error].err{got.err}; }

    memory.raw_copy(got.ok::ptr, s::ptr, len);
    got.ok[len] = 0;
    ret res[OwnedString, A.Error].ok{owned_adopt(a, got.ok, len, len + 1)};
}

# release an owned string's extent and leave the record owning nothing
#
# releasing a record that owns nothing succeeds. on a refused release the
# record is left as it was, still owning the extent.
# ---
# o:   the record to release
# ret: ok, or the allocator's refusal
pub fun owned_release(o: *OwnedString) err[A.Error] {
    if (o == nil)       { ret err[A.Error].err{A.Error.invalid{}}; }
    if (o.data == nil)  { ret err[A.Error].ok{}; }

    val freed: err[A.Error] = A.deallocate[char](o.a, o.data, o.extent);
    if (sel freed.err) { ret freed; }
    o.data   = nil;
    o.len    = 0;
    o.extent = 0;
    ret err[A.Error].ok{};
}

# calculate the length of a null-terminated string
# ---
# ret: length of the string (not including null terminator)
pub fun str_len(s: str) usize {
    if (s == nil) { ret 0; }

    # byte-scan to word alignment; an aligned word read never crosses a page
    val step: usize = $size_of(usize);
    var len:  usize = 0;
    for (((s::usize + len) & (step - 1)) != 0) {
        if (s[len] == 0) { ret len; }
        len = len + 1;
    }

    # scan word-by-word using the "has-zero-byte" trick
    # `(w - lo) & ~w & hi` is nonzero if any byte of w is zero
    # masks derived from the native word width
    val lo: usize = ~(0::usize) / 0xFF;
    val hi: usize = lo * 0x80;
    for {
        val w: usize = ((s::usize + len)::*usize)[0];
        if (((w - lo) & (~w) & hi) != 0) { brk; }
        len = len + step;
    }

    # locate the terminator within the final word
    for (s[len] != 0) {
        len = len + 1;
    }

    ret len;
}

# check if the string is empty or nil
# ---
# ret: true if the string has zero length or is nil
pub fun str_empty(s: str) bool {
    if (s == nil) { ret true; }
    ret s[0] == 0;
}

# compare two null-terminated strings for equality
# ---
# other: the other string to compare against
# ret:   true if the strings are equal
pub fun str_equals(s: str, other: str) bool {
    if (s == nil)     { ret str_empty(other); }
    if (other == nil) { ret str_empty(s); }

    # pointer value comparison
    if (s == other) { ret true; }

    var i: usize = 0;
    for (s[i] != 0 && other[i] != 0) {
        if (s[i] != other[i]) {
            ret false;
        }
        i = i + 1;
    }

    ret s[i] == other[i];
}

# compare a region of a string against a pattern
# ---
# start: byte offset into s
# len:   number of bytes to compare
# other: null-terminated string to compare against
# ret:   true if s[start..start+len] equals other exactly
pub fun str_region_equals(s: str, start: usize, len: usize, other: str) bool {
    if (str_len(other) != len) { ret false; }
    if (s == nil) { ret len == 0; }

    # the terminator check is fused into the compare so the haystack is never
    # measured: callers probe small regions of very large strings, and an
    # up-front str_len(s) would cost the whole haystack per call
    var i: usize = 0;
    for (i < len) {
        val c: char = s[start + i];
        if (c == 0)        { ret false; }
        if (c != other[i]) { ret false; }

        i = i + 1;
    }

    ret true;
}

# compare two null-terminated strings lexically
# ---
# other: the other string to compare against
# ret:   <0 if s < other, 0 if equal, >0 if s > other
pub fun str_compare(s: str, other: str) i64 {
    if (s == nil && str_empty(other)) { ret 0; }
    if (s == nil)                     { ret -1; }
    if (other == nil && str_empty(s)) { ret 0; }
    if (other == nil)                 { ret 1; }

    var i: usize = 0;
    for {
        val a: u8 = s[i];
        val b: u8 = other[i];

        if (a == 0 && b == 0) { ret 0; }
        if (a == 0)           { ret -1; }
        if (b == 0)           { ret 1; }

        if (a < b) { ret -1; }
        if (a > b) { ret 1; }

        i = i + 1;
    }

    ret 0;
}

# check if the string starts with the given prefix
# ---
# prefix: the prefix to check
# ret:    true if the string starts with prefix
pub fun str_starts_with(s: str, prefix: str) bool {
    if (prefix == nil) { ret true; }
    if (s == nil)      { ret str_empty(prefix); }

    var i: usize = 0;
    for (prefix[i] != 0) {
        if (s[i] == 0) { ret false; }

        if (s[i] != prefix[i]) {
            ret false;
        }

        i = i + 1;
    }

    ret true;
}

# check if the string ends with the given suffix
# ---
# suffix: the suffix to check
# ret:    true if the string ends with suffix
pub fun str_ends_with(s: str, suffix: str) bool {
    val s_len:      usize = str_len(s);
    val suffix_len: usize = str_len(suffix);

    if (suffix_len > s_len) { ret false; }

    ret memory.raw_equal((s::usize + (s_len - suffix_len))::ptr, suffix::ptr, suffix_len);
}

# find the first index of a substring
# ---
# sub: the substring to find
# ret: the index of the first occurrence, or none
pub fun str_index_of(s: str, sub: str) opt[usize] {
    ret str_index_of_from(s, sub, 0);
}

# find the first index of a substring at or after a starting offset
# ---
# sub:  the substring to find
# from: byte offset to begin scanning at
# ret:  the index of the first occurrence at or after from, or none
pub fun str_index_of_from(s: str, sub: str, from: usize) opt[usize] {
    val s_len:   usize = str_len(s);
    val sub_len: usize = str_len(sub);

    if (sub_len == 0 || sub_len > s_len) { ret opt[usize].none{}; }
    if (from > s_len - sub_len)          { ret opt[usize].none{}; }

    var i: usize = from;
    for (i <= s_len - sub_len) {
        var j:     usize = 0;
        var found: bool  = true;

        for (j < sub_len) {
            if (s[i + j] != sub[j]) {
                found = false;
                brk;
            }
            j = j + 1;
        }

        if (found) {
            ret opt[usize].some{i};
        }

        i = i + 1;
    }

    ret opt[usize].none{};
}

# find the last index of a substring
# ---
# sub: the substring to find
# ret: the index of the last occurrence, or none
pub fun str_last_index_of(s: str, sub: str) opt[usize] {
    val s_len:   usize = str_len(s);
    val sub_len: usize = str_len(sub);

    if (sub_len == 0 || sub_len > s_len) { ret opt[usize].none{}; }

    var i: usize = (s_len - sub_len) + 1;
    for (i > 0) {
        i = i - 1;
        var j:     usize = 0;
        var found: bool  = true;

        for (j < sub_len) {
            if (s[i + j] != sub[j]) {
                found = false;
                brk;
            }
            j = j + 1;
        }

        if (found) {
            ret opt[usize].some{i};
        }
    }

    ret opt[usize].none{};
}

# check if the string contains the given substring
# ---
# sub: the substring to check
# ret: true if the string contains sub
pub fun str_contains(s: str, sub: str) bool {
    val r: opt[usize] = str_index_of(s, sub);
    ret sel r.some;
}

# find the first occurrence of a substring and return a pointer to it
# ---
# sub: the substring to find
# ret: pointer into s at the first occurrence, or none
pub fun str_find(s: str, sub: str) opt[str] {
    val at: opt[usize] = str_index_of(s, sub);
    if (!sel at.some) { ret opt[str].none{}; }

    ret opt[str].some{?s[at.some]};
}

# find the last occurrence of a substring and return a pointer to it
# ---
# sub: the substring to find
# ret: pointer into s at the last occurrence, or none
pub fun str_find_last(s: str, sub: str) opt[str] {
    val at: opt[usize] = str_last_index_of(s, sub);
    if (!sel at.some) { ret opt[str].none{}; }

    ret opt[str].some{?s[at.some]};
}

# find the first occurrence of a character in a string
# ---
# c:   character to find
# ret: the index of the first occurrence, or none
pub fun str_index_char(s: str, c: char) opt[usize] {
    if (s == nil) { ret opt[usize].none{}; }

    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] == c) { ret opt[usize].some{i}; }
        i = i + 1;
    }

    ret opt[usize].none{};
}

# find the last occurrence of a character in a string
# ---
# c:   character to find
# ret: the index of the last occurrence, or none
pub fun str_last_index_char(s: str, c: char) opt[usize] {
    if (s == nil) { ret opt[usize].none{}; }

    var i: usize = str_len(s);
    for (i > 0) {
        i = i - 1;
        if (s[i] == c) { ret opt[usize].some{i}; }
    }

    ret opt[usize].none{};
}

# check if a string contains a character
# ---
# c:   character to find
# ret: true if c appears in s
pub fun str_contains_char(s: str, c: char) bool {
    val r: opt[usize] = str_index_char(s, c);
    ret sel r.some;
}

# find the first occurrence of a character and return a pointer to it
# ---
# c:   character to find
# ret: pointer into s at the first occurrence, or none
pub fun str_find_char(s: str, c: char) opt[str] {
    val at: opt[usize] = str_index_char(s, c);
    if (!sel at.some) { ret opt[str].none{}; }

    ret opt[str].some{?s[at.some]};
}

# find the last occurrence of a character and return a pointer to it
# ---
# c:   character to find
# ret: pointer into s at the last occurrence, or none
pub fun str_find_last_char(s: str, c: char) opt[str] {
    val at: opt[usize] = str_last_index_char(s, c);
    if (!sel at.some) { ret opt[str].none{}; }

    ret opt[str].some{?s[at.some]};
}

# create a copy of a string using the given allocator
# ---
# a:   allocator to use for the copy
# s:   string to copy
# ret: the copied string, or the allocator's refusal
pub fun str_copy(a: *A.Allocator, s: str) res[str, StrError] {
    if (a == nil) { ret res[str, StrError].err{StrError.alloc{A.Error.invalid{}}}; }

    val len: usize = str_len(s);
    val got: res[str, A.Error] = A.allocate[char](a, len + 1);
    if (sel got.err) { ret res[str, StrError].err{StrError.alloc{got.err}}; }
    val buf: str = got.ok;

    memory.raw_copy(buf::ptr, s::ptr, len);
    buf[len] = 0;

    ret res[str, StrError].ok{buf};
}

# create a copy of a slice of a string using the given allocator
# ---
# a:     allocator to use for the copy
# s:     string to copy from
# start: starting index of the slice
# len:   length of the slice
# ret:   the copied slice, `bounds` when the slice does not lie within s, or
#        the allocator's refusal
pub fun str_copy_slice(a: *A.Allocator, s: str, start: usize, len: usize) res[str, StrError] {
    if (a == nil) { ret res[str, StrError].err{StrError.alloc{A.Error.invalid{}}}; }

    val s_len: usize = str_len(s);
    if (start > s_len)       { ret res[str, StrError].err{StrError.bounds{}}; }
    if (len > s_len - start) { ret res[str, StrError].err{StrError.bounds{}}; }

    # allocate a buffer for the copied slice, including null terminator
    val got: res[str, A.Error] = A.allocate[char](a, len + 1);
    if (sel got.err) { ret res[str, StrError].err{StrError.alloc{got.err}}; }
    val buf: str = got.ok;

    # copy the slice into the buffer
    memory.raw_copy(buf::ptr, (s::usize + start)::ptr, len);
    buf[len] = 0;

    ret res[str, StrError].ok{buf};
}

# join any number of strings into one newly allocated string
#
# nil arguments contribute nothing, matching str_len/str_empty. a
# zero-argument call returns an allocated empty string. every argument
# must be a str, enforced at compile time.
# ---
# a:   allocator for the result
# va:  strings to concatenate, in order
# ret: the joined string, or the allocator's refusal
pub fun str_join(a: *A.Allocator, va: ...) res[str, StrError] {
    if (a == nil) { ret res[str, StrError].err{StrError.alloc{A.Error.invalid{}}}; }

    var len: usize = 0;
    $each s in va {
        $if ($type_of(s) != str) {
            $error("arguments must be of type str");
        }
        len = len + str_len(s);
    }

    # allocate a buffer for the joined string, including null terminator
    val got: res[str, A.Error] = A.allocate[char](a, len + 1);
    if (sel got.err) { ret res[str, StrError].err{StrError.alloc{got.err}}; }
    val buf: str = got.ok;

    # copy each string into the buffer, tracking the offset
    var offset: usize = 0;
    $each s in va {
        val n: usize = str_len(s);
        memory.raw_copy((buf::usize + offset)::ptr, s::ptr, n);
        offset = offset + n;
    }
    buf[len] = 0;

    ret res[str, StrError].ok{buf};
}

# trim leading and trailing whitespace from a string, returning a new allocated string
# ---
# a:   allocator to use for the new string
# s:   string to trim
# ret: the trimmed string, or the allocator's refusal
pub fun str_trim(a: *A.Allocator, s: str) res[str, StrError] {
    val len: usize = str_len(s);

    var start: usize = 0;
    for (start < len && char_is_space(s[start])) {
        start = start + 1;
    }

    var end: usize = len;
    for (end > start && char_is_space(s[end - 1])) {
        end = end - 1;
    }

    ret str_copy_slice(a, s, start, end - start);
}

# trim trailing whitespace from a string, returning a new allocated string
# ---
# a:   allocator to use for the new string
# s:   string to trim
# ret: the trimmed string, or the allocator's refusal
pub fun str_trim_right(a: *A.Allocator, s: str) res[str, StrError] {
    var end: usize = str_len(s);
    for (end > 0 && char_is_space(s[end - 1])) {
        end = end - 1;
    }

    ret str_copy_slice(a, s, 0, end);
}

# trim leading whitespace from a string, returning a new allocated string
# ---
# a:   allocator to use for the new string
# s:   string to trim
# ret: the trimmed string, or the allocator's refusal
pub fun str_trim_left(a: *A.Allocator, s: str) res[str, StrError] {
    val len: usize = str_len(s);

    var start: usize = 0;
    for (start < len && char_is_space(s[start])) {
        start = start + 1;
    }

    ret str_copy_slice(a, s, start, len - start);
}

# lowercase a string (ASCII), returning a new allocated string
# ---
# a:   allocator for the result
# s:   string to lowercase
# ret: the lowercased string, or the allocator's refusal
pub fun str_to_lower(a: *A.Allocator, s: str) res[str, StrError] {
    if (a == nil) { ret res[str, StrError].err{StrError.alloc{A.Error.invalid{}}}; }

    val len: usize = str_len(s);
    val got: res[str, A.Error] = A.allocate[char](a, len + 1);
    if (sel got.err) { ret res[str, StrError].err{StrError.alloc{got.err}}; }
    val buf: str = got.ok;

    var i: usize = 0;
    for (i < len) {
        buf[i] = char_to_lower(s[i]);
        i      = i + 1;
    }
    buf[len] = 0;

    ret res[str, StrError].ok{buf};
}

# uppercase a string (ASCII), returning a new allocated string
# ---
# a:   allocator for the result
# s:   string to uppercase
# ret: the uppercased string, or the allocator's refusal
pub fun str_to_upper(a: *A.Allocator, s: str) res[str, StrError] {
    if (a == nil) { ret res[str, StrError].err{StrError.alloc{A.Error.invalid{}}}; }

    val len: usize = str_len(s);
    val got: res[str, A.Error] = A.allocate[char](a, len + 1);
    if (sel got.err) { ret res[str, StrError].err{StrError.alloc{got.err}}; }
    val buf: str = got.ok;

    var i: usize = 0;
    for (i < len) {
        buf[i] = char_to_upper(s[i]);
        i      = i + 1;
    }
    buf[len] = 0;

    ret res[str, StrError].ok{buf};
}

# repeat a string n times, returning a new allocated string
# ---
# a:   allocator for the result
# s:   string to repeat
# n:   number of repetitions (0 yields an empty string)
# ret: the repeated string, or the allocator's refusal (`overflow` when len * n does not fit)
pub fun str_repeat(a: *A.Allocator, s: str, n: usize) res[str, StrError] {
    if (a == nil) { ret res[str, StrError].err{StrError.alloc{A.Error.invalid{}}}; }

    # check for size overflow (relies on unsigned wraparound behavior)
    val len:   usize = str_len(s);
    val total: usize = len * n;
    if (len != 0 && total / len != n) { ret res[str, StrError].err{StrError.alloc{A.Error.overflow{}}}; }

    val got: res[str, A.Error] = A.allocate[char](a, total + 1);
    if (sel got.err) { ret res[str, StrError].err{StrError.alloc{got.err}}; }
    val buf: str = got.ok;

    var w: usize = 0;
    var r: usize = 0;
    for (r < n) {
        memory.raw_copy((buf::usize + w)::ptr, s::ptr, len);
        w = w + len;
        r = r + 1;
    }
    buf[total] = 0;

    ret res[str, StrError].ok{buf};
}

# replace every occurrence of a substring, returning a new allocated string
#
# occurrences are found left to right and do not overlap. a nil or empty
# `old` yields a plain copy of `s`.
# ---
# a:   allocator for the result
# s:   string to replace within
# old: substring to replace
# new: replacement substring
# ret: the replaced string, or the allocator's refusal
pub fun str_replace(a: *A.Allocator, s: str, old: str, new: str) res[str, StrError] {
    if (a == nil) { ret res[str, StrError].err{StrError.alloc{A.Error.invalid{}}}; }

    val old_len: usize = str_len(old);
    if (old_len == 0) { ret str_copy(a, s); }

    val s_len:   usize = str_len(s);
    val new_len: usize = str_len(new);

    # count occurrences to size the result exactly
    var count: usize = 0;
    var cur:   usize = 0;
    for {
        val at: opt[usize] = str_index_of_from(s, old, cur);
        if (!sel at.some) { brk; }
        count = count + 1;
        cur   = at.some + old_len;
    }
    if (count == 0) { ret str_copy(a, s); }

    # calculate the length of the output string and allocate it
    val out_len: usize = s_len - count * old_len + count * new_len;
    val got: res[str, A.Error] = A.allocate[char](a, out_len + 1);
    if (sel got.err) { ret res[str, StrError].err{StrError.alloc{got.err}}; }
    val buf: str = got.ok;

    var w: usize = 0;
    cur = 0;
    for {
        val next: opt[usize] = str_index_of_from(s, old, cur);
        if (!sel next.some) { brk; }
        val at: usize = next.some;

        # copy the run before the match, then the replacement
        memory.raw_copy((buf::usize + w)::ptr, (s::usize + cur)::ptr, at - cur);
        w = w + (at - cur);
        memory.raw_copy((buf::usize + w)::ptr, new::ptr, new_len);
        w = w + new_len;

        cur = at + old_len;
    }

    # copy the tail after the last match
    memory.raw_copy((buf::usize + w)::ptr, (s::usize + cur)::ptr, s_len - cur);
    buf[out_len] = 0;

    ret res[str, StrError].ok{buf};
}

# test helpers: read a search or construction outcome without a guard at
# every call site. absence reads as the maximum index or nil, never as a
# plausible value.
fun index_or_max(o: opt[usize]) usize {
    if (sel o.some) { ret o.some; }
    ret ~(0::usize);
}

fun has_index(o: opt[usize]) bool { ret sel o.some; }

fun found_or_nil(o: opt[str]) str {
    if (sel o.some) { ret o.some; }
    ret nil;
}

fun has_found(o: opt[str]) bool { ret sel o.some; }

fun made_or_nil(r: res[str, StrError]) str {
    if (sel r.ok) { ret r.ok; }
    ret nil;
}

fun made(r: res[str, StrError]) bool { ret sel r.ok; }

# str_len over the alignment prologue, word-scan, and tail phases: lengths
# spanning below, at, and above one machine word exercise all three
test "std.types.string.str_len:across_word_boundary" {
    if (str_len("") != 0)                    { ret 1; }
    if (str_len("a") != 1)                   { ret 1; }
    if (str_len("abcdefg") != 7)             { ret 1; }
    if (str_len("abcdefgh") != 8)            { ret 1; }
    if (str_len("abcdefghi") != 9)           { ret 1; }
    if (str_len("0123456789abcde") != 15)    { ret 1; }
    if (str_len("0123456789abcdef") != 16)   { ret 1; }
    if (str_len("0123456789abcdefg") != 17)  { ret 1; }
    if (str_len(nil) != 0)                   { ret 1; }
    ret 0;
}

test "std.types.string.str_empty:nil_and_empty" {
    if (!str_empty(""))  { ret 1; }
    if (!str_empty(nil)) { ret 1; }
    if (str_empty("a"))  { ret 1; }
    ret 0;
}

# str_equals ground truth by content, plus the nil-is-empty contract
test "std.types.string.str_equals:content_and_nil" {
    if (!str_equals("abc", "abc")) { ret 1; }
    if (str_equals("abc", "abd"))  { ret 1; }
    if (str_equals("abc", "ab"))   { ret 1; }
    if (str_equals("ab", "abc"))   { ret 1; }
    if (!str_equals("", ""))       { ret 1; }
    if (!str_equals(nil, ""))      { ret 1; }
    if (!str_equals("", nil))      { ret 1; }
    if (!str_equals(nil, nil))     { ret 1; }
    if (str_equals("a", nil))      { ret 1; }
    if (str_equals(nil, "a"))      { ret 1; }
    ret 0;
}

test "std.types.string.str_compare:ordering" {
    if (str_compare("a", "b") >= 0)   { ret 1; }
    if (str_compare("b", "a") <= 0)   { ret 1; }
    if (str_compare("a", "a") != 0)   { ret 1; }
    if (str_compare("ab", "abc") >= 0) { ret 1; }
    if (str_compare("abc", "ab") <= 0) { ret 1; }
    if (str_compare("", "") != 0)     { ret 1; }
    if (str_compare(nil, "") != 0)    { ret 1; }
    if (str_compare(nil, "a") >= 0)   { ret 1; }
    if (str_compare("a", nil) <= 0)   { ret 1; }
    ret 0;
}

# nil or empty needle is a match anywhere, matching the nil-is-empty contract
test "std.types.string.str_starts_with:prefix_and_nil" {
    if (!str_starts_with("hello", "he")) { ret 1; }
    if (str_starts_with("hello", "lo"))  { ret 1; }
    if (str_starts_with("he", "hello"))  { ret 1; }
    if (!str_starts_with("x", ""))       { ret 1; }
    if (!str_starts_with("x", nil))      { ret 1; }
    if (!str_starts_with(nil, ""))       { ret 1; }
    if (str_starts_with(nil, "x"))       { ret 1; }
    ret 0;
}

test "std.types.string.str_ends_with:suffix_and_nil" {
    if (!str_ends_with("hello", "lo")) { ret 1; }
    if (str_ends_with("hello", "he"))  { ret 1; }
    if (str_ends_with("hi", "hello"))  { ret 1; }
    if (!str_ends_with("x", ""))       { ret 1; }
    if (!str_ends_with("x", nil))      { ret 1; }
    if (!str_ends_with(nil, ""))       { ret 1; }
    ret 0;
}

# region compare returns false on length mismatch and on an out-of-bounds
# window without reading past the string
test "std.types.string.str_region_equals:bounds_and_mismatch" {
    if (!str_region_equals("hello world", 6, 5, "world")) { ret 1; }
    if (!str_region_equals("hello world", 0, 5, "hello")) { ret 1; }
    if (str_region_equals("hello", 0, 5, "world"))        { ret 1; }
    if (str_region_equals("hello", 0, 3, "hello"))        { ret 1; }
    if (str_region_equals("hi", 1, 5, "world"))           { ret 1; }
    ret 0;
}

test "std.types.string.str_index_of:first_and_offset" {
    if (index_or_max(str_index_of("abcabc", "bc")) != 1)      { ret 1; }
    if (has_index(str_index_of("abc", "xyz")))            { ret 1; }
    if (has_index(str_index_of("abc", "")))              { ret 1; }
    if (index_or_max(str_index_of_from("abcabc", "bc", 2)) != 4) { ret 1; }
    if (has_index(str_index_of_from("abcabc", "bc", 5))) { ret 1; }
    ret 0;
}

test "std.types.string.str_last_index_of:last_occurrence" {
    if (index_or_max(str_last_index_of("abcabc", "bc")) != 4) { ret 1; }
    if (has_index(str_last_index_of("abc", "xyz")))       { ret 1; }
    ret 0;
}

test "std.types.string.str_contains:present_and_absent" {
    if (!str_contains("hello", "ell")) { ret 1; }
    if (str_contains("hello", "xyz"))  { ret 1; }
    ret 0;
}

# find returns a pointer into s at the match; the tail from there equals the
# expected suffix
test "std.types.string.str_find:pointer_into_match" {
    if (!str_equals(found_or_nil(str_find("hello world", "world")), "world")) { ret 1; }
    if (!str_equals(found_or_nil(str_find("abcabc", "bc")), "bcabc"))         { ret 1; }
    if (!str_equals(found_or_nil(str_find_last("abcabc", "bc")), "bc"))       { ret 1; }
    if (has_found(str_find("abc", "xyz")))                                { ret 1; }
    ret 0;
}

test "std.types.string.str_index_char:first_and_last" {
    if (index_or_max(str_index_char("hello", 'l')) != 2)      { ret 1; }
    if (index_or_max(str_last_index_char("hello", 'l')) != 3) { ret 1; }
    if (has_index(str_index_char("hello", 'z')))          { ret 1; }
    if (has_index(str_index_char(nil, 'a')))              { ret 1; }
    ret 0;
}

test "std.types.string.str_contains_char:present_and_absent" {
    if (!str_contains_char("hello", 'e')) { ret 1; }
    if (str_contains_char("hello", 'z'))  { ret 1; }
    ret 0;
}

test "std.types.string.str_find_char:pointer_into_match" {
    if (!str_equals(found_or_nil(str_find_char("hello", 'l')), "llo"))     { ret 1; }
    if (!str_equals(found_or_nil(str_find_last_char("hello", 'l')), "lo")) { ret 1; }
    if (has_found(str_find_char("hello", 'z')))                        { ret 1; }
    ret 0;
}

# a copy is equal in content but a distinct allocation; a nil source yields a
# fresh empty string, never nil
test "std.types.string.str_copy:distinct_alloc_and_nil" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    val src: str = "hello";
    val r: res[str, StrError] = str_copy(?a, src);
    if (sel r.err) { ret 1; }
    val got: str = r.ok;
    if (!str_equals(got, "hello")) { ret 1; }
    if (got::usize == src::usize)  { ret 1; }

    val rn: res[str, StrError] = str_copy(?a, nil);
    if (sel rn.err) { ret 1; }
    val gn: str = rn.ok;
    if (gn == nil || !str_empty(gn))         { ret 1; }
    ret 0;
}

# a zero-length window at the end of the string is valid and yields ""; an
# out-of-range start or length is an error
test "std.types.string.str_copy_slice:bounds" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    val r1: res[str, StrError] = str_copy_slice(?a, "hello", 1, 3);
    if (sel r1.err) { ret 1; }
    if (!str_equals(r1.ok, "ell"))   { ret 1; }

    val r2: res[str, StrError] = str_copy_slice(?a, "abc", 3, 0);
    if (sel r2.err) { ret 1; }
    if (!str_empty(r2.ok))           { ret 1; }

    val r3: res[str, StrError] = str_copy_slice(?a, "", 0, 0);
    if (sel r3.err) { ret 1; }
    if (!str_empty(r3.ok))           { ret 1; }

    if (made(str_copy_slice(?a, "abc", 4, 0))) { ret 1; }
    if (made(str_copy_slice(?a, "abc", 3, 1))) { ret 1; }
    ret 0;
}

# join concatenates in order; a zero-argument call and skipped nil/empty
# arguments all round-trip through the nil-is-empty contract
test "std.types.string.str_join:concat_and_skips" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    if (!str_empty(made_or_nil(str_join(?a))))            { ret 1; }
    if (!str_equals(made_or_nil(str_join(?a, "foo")), "foo")) { ret 1; }
    if (!str_equals(made_or_nil(str_join(?a, "a", "b", "c")), "abc")) { ret 1; }
    if (!str_equals(made_or_nil(str_join(?a, "a", "", "b")), "ab"))   { ret 1; }

    val n: str = nil;
    if (!str_equals(made_or_nil(str_join(?a, "a", n, "b")), "ab"))    { ret 1; }
    ret 0;
}

# every trim variant returns a fresh allocation, including the all-space and
# empty cases which must not alias the input
test "std.types.string.str_trim:variants" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    if (!str_equals(made_or_nil(str_trim(?a, "  hi  ")), "hi"))       { ret 1; }
    if (!str_equals(made_or_nil(str_trim(?a, "hi")), "hi"))           { ret 1; }
    if (!str_equals(made_or_nil(str_trim_left(?a, "  hi  ")), "hi  ")) { ret 1; }
    if (!str_equals(made_or_nil(str_trim_right(?a, "  hi  ")), "  hi")) { ret 1; }

    # all-space trims to a fresh empty string, distinct from the input
    val src: str = "   ";
    val r: res[str, StrError] = str_trim(?a, src);
    if (sel r.err) { ret 1; }
    val got: str = r.ok;
    if (!str_empty(got))          { ret 1; }
    if (got::usize == src::usize) { ret 1; }
    ret 0;
}

test "std.types.string.str_to_lower:case_mapping" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    if (!str_equals(made_or_nil(str_to_lower(?a, "HeLLo123")), "hello123")) { ret 1; }
    if (!str_equals(made_or_nil(str_to_upper(?a, "HeLLo123")), "HELLO123")) { ret 1; }
    if (!str_empty(made_or_nil(str_to_lower(?a, ""))))                      { ret 1; }
    ret 0;
}

# a zero count and an empty input both yield an empty string
test "std.types.string.str_repeat:count_and_empty" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    if (!str_equals(made_or_nil(str_repeat(?a, "ab", 3)), "ababab")) { ret 1; }
    if (!str_equals(made_or_nil(str_repeat(?a, "x", 1)), "x"))       { ret 1; }
    if (!str_empty(made_or_nil(str_repeat(?a, "ab", 0))))            { ret 1; }
    if (!str_empty(made_or_nil(str_repeat(?a, "", 5))))             { ret 1; }
    ret 0;
}

# replace covers no-match, growth, shrink, deletion, empty-old, and matches at
# the string boundaries
test "std.types.string.str_replace:all_cases" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    if (!str_equals(made_or_nil(str_replace(?a, "hello", "l", "L")), "heLLo"))   { ret 1; }
    if (!str_equals(made_or_nil(str_replace(?a, "hello", "xyz", "q")), "hello")) { ret 1; }
    if (!str_equals(made_or_nil(str_replace(?a, "aaa", "a", "bb")), "bbbbbb"))   { ret 1; }
    if (!str_equals(made_or_nil(str_replace(?a, "aabaa", "aa", "c")), "cbc"))    { ret 1; }
    if (!str_equals(made_or_nil(str_replace(?a, "hello", "l", "")), "heo"))      { ret 1; }
    if (!str_equals(made_or_nil(str_replace(?a, "hello", "", "x")), "hello"))    { ret 1; }
    if (!str_equals(made_or_nil(str_replace(?a, "abcabc", "abc", "X")), "XX"))   { ret 1; }
    ret 0;
}

# a slice that does not lie within its string is `bounds`, distinct from the
# allocator's refusal, and a nil allocator is the allocator's `invalid`
test "std.types.string.str_copy_slice:error_cases_are_distinct" {
    var buf: [256]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 256);

    val past: res[str, StrError] = str_copy_slice(?a, "abc", 4, 0);
    if (!sel past.err)        { ret 1; }
    if (!sel past.err.bounds) { ret 2; }

    val long: res[str, StrError] = str_copy_slice(?a, "abc", 3, 1);
    if (!sel long.err)        { ret 3; }
    if (!sel long.err.bounds) { ret 4; }

    val nil_alloc: res[str, StrError] = str_copy(nil, "abc");
    if (!sel nil_alloc.err)               { ret 5; }
    if (!sel nil_alloc.err.alloc)         { ret 6; }
    if (!sel nil_alloc.err.alloc.invalid) { ret 7; }

    # the fixed buffer is 256 bytes, so a longer copy is the backend's refusal
    val big: res[str, StrError] = str_repeat(?a, "0123456789", 30);
    if (!sel big.err)                 { ret 8; }
    if (!sel big.err.alloc)           { ret 9; }
    if (!sel big.err.alloc.exhausted) { ret 10; }
    ret 0;
}

# a counting shim over the fixed allocator: the testing allocator lives above
# the OS layer and this module is below it, so the release extent is observed
# by counting what reaches the backend
rec Counting {
    backing:  A.Allocator;
    released: usize;
    refuse:   bool;
}

fun counting_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val c: *Counting = ctx::*Counting;
    if (c.refuse) { ret opt[ptr].none{}; }
    ret c.backing.fn_allocate(c.backing.ctx, size, align);
}

fun counting_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val c: *Counting = ctx::*Counting;
    if (c.refuse) { ret opt[ptr].none{}; }
    ret c.backing.fn_reallocate(c.backing.ctx, p, old_size, new_size, align);
}

fun counting_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    val c: *Counting = ctx::*Counting;
    c.released = c.released + size;
    ret c.backing.fn_deallocate(c.backing.ctx, p, size, align);
}

fun counting_make(c: *Counting, st: *fixed.FixedState, buf: *u8, cap: usize) A.Allocator {
    fixed.make(?c.backing, st, buf, cap);
    c.released = 0;
    c.refuse   = false;
    var a: A.Allocator;
    a.ctx           = c::ptr;
    a.fn_allocate   = counting_allocate;
    a.fn_reallocate = counting_reallocate;
    a.fn_deallocate = counting_deallocate;
    ret a;
}

# an owned string releases exactly the extent it adopted, not its length, and
# a released record owns nothing so a second release is a clean no-op
test "std.types.string.OwnedString:extent_is_released_not_length" {
    var buf: [1024]u8;
    var st: fixed.FixedState;
    var c: Counting;
    var a: A.Allocator = counting_make(?c, ?st, ?buf[0], 1024);

    # a probe buffer larger than the text it holds
    val probe: res[*char, A.Error] = A.allocate[char](?a, 64);
    if (sel probe.err) { ret 2; }
    probe.ok[0] = 'h'; probe.ok[1] = 'i'; probe.ok[2] = 0;
    var o: OwnedString = owned_adopt(?a, probe.ok, 2, 64);
    if (o.len != 2 || o.extent != 64) { ret 3; }
    if (!str_equals(o.data, "hi"))     { ret 4; }

    val released: err[A.Error] = owned_release(?o);
    if (sel released.err)               { ret 5; }
    if (o.data != nil || o.extent != 0) { ret 6; }
    if (c.released != 64)               { ret 7; }

    val again: err[A.Error] = owned_release(?o);
    if (!sel again.ok)    { ret 8; }
    if (c.released != 64) { ret 9; }

    val dup: res[OwnedString, A.Error] = owned_dup(?a, "copy");
    if (sel dup.err) { ret 10; }
    var d: OwnedString = dup.ok;
    if (d.len != 4 || d.extent != 5 || !str_equals(d.data, "copy")) { ret 11; }
    owned_release(?d);
    if (c.released != 69) { ret 12; }

    c.refuse = true;
    val refused: res[OwnedString, A.Error] = owned_dup(?a, "copy");
    if (!sel refused.err)           { ret 13; }
    if (!sel refused.err.exhausted) { ret 14; }

    val no_alloc: res[OwnedString, A.Error] = owned_dup(nil, "copy");
    if (!sel no_alloc.err)         { ret 15; }
    if (!sel no_alloc.err.invalid) { ret 16; }
    ret 0;
}
