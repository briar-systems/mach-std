# the canonical error tag: err[E]
#
# a fallible operation with no value, the payloadless success form, is
# spelled `err[E]`. it is an ordinary std declaration (mach
# doc/design/tagged-values.md fixes the language contract; the compiler seeds
# nothing and treats it like any other tag). a consuming module gains
# `use std.types.error.err;` and spells the bare name. the sibling tags live
# in `std.types.result` (`res[T, E]`) and `std.types.option` (`opt[T]`).
#
# err[E]: `err: E` is case 0 and `ok` is case 1; `E` is the producing
# module's closed domain tag, never a string. the zero value reads as `err`
# with a zero error, so uninitialized storage never reads as success.
#
# the discriminator is a u8 at offset zero and the payload follows at its
# natural alignment. the three canonical tags nest freely (`res[err[E], E]`,
# `err[Tag]`) and instantiate user generics like any declared type.
#
# reading: `sel place.case` is the test, and the guarded payload place is the
# read. an `if (!sel e.ok) { ret ...; }` chain guards `e.err` for the rest of
# the block; `||` opens no guard, so one term per `if`. construction is
# `Type.case{...}` only. no helper functions are provided on purpose: a
# by-value `unwrap` would copy owning payloads out of the ownership rules,
# and a constructor function would be a second spelling of a form the
# language already has. the tests below pin the shape: case order, case
# codes, zero defaults, layout, reflection and guards.

pub tag err[E]: u8 { err: E; ok; }

use std.types.size.usize;

fun code(p: *u8) u8 {
    ret p[0];
}

test std_types_error_err__err_is_case_0_and_payloadless_ok_is_case_1 {
    var zero: err[i32];
    if (!sel zero.err)           { ret 1; }
    if (zero.err != 0)           { ret 2; }
    if (code((?zero)::*u8) != 0) { ret 3; }

    var done: err[i32] = err[i32].ok{};
    if (!sel done.ok)            { ret 4; }
    if (code((?done)::*u8) != 1) { ret 5; }

    var failed: err[i32] = err[i32].err{9};
    if (!sel failed.err)           { ret 6; }
    if (failed.err != 9)           { ret 7; }
    if (code((?failed)::*u8) != 0) { ret 8; }
    ret 0;
}

# the discriminator is a u8 at offset zero and the payload follows at the
# payload's natural alignment, which is the layout the contract fixes
test std_types_error_err__discriminator_is_u8_at_offset_zero {
    if ($size_of($discriminant_of(err[u64])) != 1) { ret 1; }
    if ($size_of(err[i32]) != 8)                   { ret 2; }
    if ($offset_of(err[i32], err) != 4)            { ret 3; }
    if ($size_of(err[u64]) != 16)                  { ret 4; }
    ret 0;
}

# reflection sees exactly two cases in declaration order
test std_types_error_err__reflection_enumerates_the_contract_cases {
    var n: usize = 0;
    $each c in $cases(err[i32]) { n = n + 1; }
    if (n != 2)              { ret 1; }
    $if (!$is_tag(err[i32])) { ret 2; }
    ret 0;
}

# the error payload is a closed domain tag and reads through a chained guard;
# an exiting chain guards the remainder of the block
tag Cause: u8 { missing; refused: i32; }

fun check(key: i64) err[Cause] {
    if (key < 0)  { ret err[Cause].err{Cause.refused{-1}}; }
    if (key == 0) { ret err[Cause].err{Cause.missing{}}; }
    ret err[Cause].ok{};
}

test std_types_error_err__exiting_chains_guard_the_rest_of_the_block {
    val refused: err[Cause] = check(-1);
    if (!sel refused.err)          { ret 1; }
    if (!sel refused.err.refused)  { ret 2; }
    if (refused.err.refused != -1) { ret 3; }

    val missing: err[Cause] = check(0);
    if (!sel missing.err)         { ret 4; }
    if (!sel missing.err.missing) { ret 5; }

    var passed: i64 = 0;
    var key:    i64 = -1;
    for (key < 4) {
        val outcome: err[Cause] = check(key);
        if (!sel outcome.ok) {
            key = key + 1;
            cnt;
        }
        passed = passed + 1;
        key    = key + 1;
    }
    if (passed != 3) { ret 6; }
    ret 0;
}

# a user generic instantiates over the canonical tag like over any other
# declared type: the tag is an ordinary std declaration
rec Holder[T] { item: T; }

fun hold[T](item: T) Holder[T] {
    ret Holder[T]{item: item};
}

test std_types_error_err__user_generics_instantiate_over_the_canonical_tag {
    val done: Holder[err[i32]] = hold[err[i32]](err[i32].ok{});
    if (!sel done.item.ok) { ret 1; }

    val failed: Holder[err[Cause]] = hold[err[Cause]](err[Cause].err{Cause.missing{}});
    if (!sel failed.item.err)         { ret 2; }
    if (!sel failed.item.err.missing) { ret 3; }

    var empty: Holder[err[i32]];
    if (!sel empty.item.err) { ret 4; }
    if (empty.item.err != 0) { ret 5; }
    ret 0;
}
