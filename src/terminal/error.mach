# terminal outcomes shared by std.terminal and its per-os backends
#
# lives in its own module so the parent and the backends name one tag without
# a circular import, the same split std.terminal.key makes for Key.

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use io_error: std.io.error;
use std.terminal.key;

# every way a terminal operation can fail
# ---
# native: the terminal call failed; payload carries the native failure, its
#         operation being OP_OPTION for a mode or queue control call and
#         OP_READ for a poll
pub tag TermError: u8 {
    native: io_error.Error;
}

# the outcome of a mode or queue control call
pub def Operation: err[TermError];

# the outcome of one poll: a waiting key, absence when the queue is empty, or
# the native read failure
pub def Poll: res[opt[key.Key], TermError];

# a native refusal on a mode or queue control call
pub fun control_failure(code: i64) TermError {
    ret TermError.native{io_error.from_code(code, io_error.OP_OPTION)};
}

# a native refusal on a poll
pub fun read_failure(code: i64) TermError {
    ret TermError.native{io_error.from_code(code, io_error.OP_READ)};
}

# the native code behind a terminal failure
pub fun code(e: TermError) i64 {
    if (sel e.native) { ret e.native.code; }
    ret 0;
}

test "terminal.error: failures keep the native code and name their operation" {
    val control: TermError = control_failure(-25);
    if (code(control) != -25) { ret 1; }
    if (!sel control.native) { ret 2; }
    if (control.native.operation != io_error.OP_OPTION) { ret 3; }
    val read: TermError = read_failure(-9);
    if (!sel read.native) { ret 4; }
    if (read.native.operation != io_error.OP_READ || read.native.kind != io_error.CLOSED) { ret 5; }
    ret 0;
}
