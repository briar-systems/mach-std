# wasi terminal keyboard input backend (see ../terminal.mach)
#
# preview 1 can say whether a descriptor is a terminal and nothing more: it has
# no line discipline to turn off and no read that returns before a byte
# arrives. so raw mode is never active, and each control and poll answers the
# native unsupported code, which a caller sees as it sees any refusal.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.isize;
use std.types.size.usize;

use io_error: std.io.error;
use terr:     std.terminal.error;

$if ($mach.build.sys == $mach.sys.wasi) {
    use std.system.os;
    use sys: std.system.os.wasi;
}
$or {
    $error("std.terminal.wasi needs the wasi target");
}

fun unsupported(operation: io_error.Operation) terr.TermError {
    ret terr.TermError.native{os.error(sys.ENOTSUP, operation)};
}

# whether a descriptor is a terminal
# ---
# fd:  the descriptor to test
# ret: true for a character device that cannot seek, false for a pipe, a file or a closed descriptor
pub fun is_terminal(fd: usize) bool {
    ret sys.is_terminal(fd::isize::i32);
}

# drop whatever's sitting unread in the input queue
# ---
# ret: the unsupported refusal: the preview has no queue to drop
pub fun flush_input() terr.Operation {
    ret terr.Operation.err{unsupported(io_error.OP_OPTION)};
}

# whether raw mode is currently active
# ---
# ret: false: the preview has no raw mode to enter
pub fun is_raw() bool {
    ret false;
}

# switch stdin into raw mode
# ---
# ret: the unsupported refusal
pub fun enable_raw() terr.Operation {
    ret terr.Operation.err{unsupported(io_error.OP_OPTION)};
}

# restore the mode enable_raw replaced
# ---
# ret: ok: raw mode is never active here, so there is nothing to restore
pub fun disable_raw() terr.Operation {
    ret terr.Operation.ok{};
}

# read one raw byte without blocking
# ---
# ret: the unsupported refusal: every read the preview has waits for a byte
pub fun poll_key() terr.Poll {
    ret terr.Poll.err{unsupported(io_error.OP_READ)};
}

test terminal_wasi__raw_mode_is_refused_as_unsupported {
    val raw: terr.Operation = enable_raw();
    if (!sel raw.err)                      { ret 1; }
    if (terr.code(raw.err) != sys.ENOTSUP) { ret 2; }
    if (is_raw())                          { ret 3; }
    ret 0;
}
