# x86_64 Windows entrypoint
#
# provides `_start` (via `mainCRTStartup`), the PE entry point for x86_64
# Windows executables.
#
# windows does not pass argc/argv on the stack. this entrypoint:
#   1. calls _rt_init to install the main thread's block
#   2. calls _rt_args, which reads GetCommandLineW and splits it into UTF-8
#      arguments in storage it allocates, with no cap on their count
#      (std.runtime.windows.cmdline holds the rules)
#   3. calls user-supplied `main(argc, argv)`
#   4. exits via ExitProcess with the return code from main
#
# user code must define:
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 { ... }

use std.runtime.windows.cmdline;
use os_shared: std.system.os.shared;
use std.system.panic.panic;
use std.types.size.usize;

$if ($mach.build.os != $mach.os.windows) {
    $error("std.runtime.windows.x86_64: requires windows target");
}

$if ($mach.build.arch != $mach.arch.x86_64) {
    $error("std.runtime.windows.x86_64: requires x86_64 target");
}

use os: std.system.os.windows.x86_64;

# the kernel32 imports the entrypoint binds, each pinned to the kernel32 link entry with a
# `#[library]` decorator so the PE import directory attributes it explicitly.
#[library("kernel32")]
ext fun GetCommandLineW() *u16;
#[library("kernel32")]
ext fun ExitProcess(code: u32);

# the entrypoint references these by literal name from inline asm, so each carries a
# `#[symbol]` decorator to keep its link name verbatim, as the linux and darwin runtimes do
#[symbol("_rt_argc")]
var _rt_argc: i64  = 0;
#[symbol("_rt_argv")]
var _rt_argv: **u8 = nil;

# the main thread's block; spawned threads get theirs from the OS layer
var main_block: os_shared.ThreadBlock;

# install the main thread's block before main so its token is valid from entry
#[symbol("_rt_init")]
fun _rt_init() {
    if (os.thread_block_enter(?main_block) < 0) {
        panic("std.runtime: the main thread's block could not be installed\n");
    }
}

# split the wide command line into argv, in one allocation the process keeps
#[symbol("_rt_args")]
fun _rt_args() {
    val line:  *u16         = GetCommandLineW();
    val size:  cmdline.Size = cmdline.measure(line);
    val slots: usize        = (size.count + 1) * $size_of(*u8);
    val block: ptr          = os.allocate(slots + size.bytes);
    if (block == nil) {
        panic("std.runtime: the command line's arguments could not be allocated\n");
    }
    _rt_argv = block::**u8;
    cmdline.fill(line, _rt_argv, (block::usize + slots)::*u8);
    _rt_argc = size.count::i64;
}

#[symbol("mainCRTStartup")]
pub fun _start() {
    asm x86_64 {
        and rsp, -16      # align stack to 16 bytes
        sub rsp, 32       # shadow space

        call _rt_init
        call _rt_args

        mov rcx, [_rt_argc]
        mov rdx, [_rt_argv]
        call main

        mov ecx, eax      # exit code -> rcx (1st argument, Windows convention)
        call ExitProcess
    }
}
