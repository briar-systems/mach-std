# the windows command line split into arguments, as UTF-8 or as raw UTF-16,
# and joined back from UTF-16 arguments
#
# the rules are the post-2008 msvcrt rules, which the universal C runtime keeps,
# so main sees what a C program's main would. arguments part at spaces and tabs outside double quotes. a run of
# backslashes is literal unless a double quote follows it, and then each pair
# is one backslash and an odd one left over makes the quote literal. inside
# quotes a doubled quote is one literal quote. the program name, the first
# argument, ends at the first space or tab outside quotes and takes every
# backslash literally. an empty command line holds no arguments.
#
# measure and fill convert each argument to UTF-8. a surrogate pair is one code
# point and an unpaired surrogate becomes U+FFFD, one per code unit, so every
# argument is valid UTF-8. measure_wide and fill_wide keep each argument's code
# units as the line held them, unpaired surrogates included. both forms come
# from one walker, so they always agree on where each argument starts and ends.
#
# join writes arguments as a line the wide split gives back unit for unit, so
# the spawns encode by the same rules the runtime decodes by.
#
# the split and the join are pure, so they compile and are tested on every
# host. the windows runtime sizes the storage it owns with the measures and then
# the fills write it.

use std.text.utf8;
use std.text.utf8.Codepoint;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

val TAB:       u16 = 0x09;
val SPACE:     u16 = 0x20;
val QUOTE:     u16 = 0x22;
val BACKSLASH: u16 = 0x5C;

# the storage a command line splits into as UTF-8
# ---
# count: number of arguments
# bytes: UTF-8 bytes of every argument, each terminator included
pub rec Size {
    count: usize;
    bytes: usize;
}

# the storage a command line splits into as UTF-16
# ---
# count: number of arguments
# units: UTF-16 code units of every argument, each terminator included
pub rec WideSize {
    count: usize;
    units: usize;
}

# the walker's output, written only when argv is set
# ---
# wide:  arguments keep their UTF-16 units rather than converting to UTF-8
# argv:  the argument slots, each a *u8 or a *u16 as wide says
# buf:   the argument storage, u8 or u16 as wide says
# count: arguments begun so far
# len:   units of buf used so far, bytes or code units as wide says
rec Walk {
    wide:  bool;
    argv:  *ptr;
    buf:   ptr;
    count: usize;
    len:   usize;
}

# measure the storage a command line splits into as UTF-8
# ---
# line: the command line, nul-terminated UTF-16
# ret:  the argument count and their UTF-8 bytes
pub fun measure(line: *u16) Size {
    var w: Walk;
    walk(line, ?w);
    ret Size{count: w.count, bytes: w.len};
}

# split a command line into UTF-8 arguments
# ---
# line:  the command line, nul-terminated UTF-16
# argv:  room for measure's count plus one, given the arguments and a closing nil
# bytes: room for measure's bytes, given the arguments' UTF-8
pub fun fill(line: *u16, argv: **u8, bytes: *u8) {
    var w: Walk;
    w.argv = argv::*ptr;
    w.buf  = bytes::ptr;
    walk(line, ?w);
    argv[w.count] = nil;
}

# measure the storage a command line splits into as UTF-16
# ---
# line: the command line, nul-terminated UTF-16
# ret:  the argument count and their code units
pub fun measure_wide(line: *u16) WideSize {
    var w: Walk;
    w.wide = true;
    walk(line, ?w);
    ret WideSize{count: w.count, units: w.len};
}

# split a command line into UTF-16 arguments that keep the line's code units
# ---
# line:  the command line, nul-terminated UTF-16
# argv:  room for measure_wide's count plus one, given the arguments and a closing nil
# units: room for measure_wide's units, given the arguments' code units
pub fun fill_wide(line: *u16, argv: **u16, units: *u16) {
    var w: Walk;
    w.wide = true;
    w.argv = argv::*ptr;
    w.buf  = units::ptr;
    walk(line, ?w);
    argv[w.count] = nil;
}

# how joining arguments into a command line ended
# ---
# unrepresentable: the program name holds a double quote, which its rule cannot carry
# overflow:        the line and its terminator do not fit
# done:            the units written, the terminator excluded
pub tag Joined: u8 {
    unrepresentable;
    overflow;
    done: usize;
}

# the line being joined
# ---
# buf: destination storage
# cap: size of buf in units
# off: units written so far
rec Join {
    buf: *u16;
    cap: usize;
    off: usize;
}

# append one unit, reserving the terminator slot
fun append(j: *Join, u: u16) bool {
    if (j.off + 1 >= j.cap) { ret false; }
    j.buf[j.off] = u;
    j.off        = j.off + 1;
    ret true;
}

# join UTF-16 arguments into a command line that measure_wide and fill_wide
# split back into the same units
#
# the program name follows its own rule: its units are written as they are,
# quoted when it is empty or holds a space or tab, and a double quote cannot be
# written at all. every later argument is quoted when it is empty or holds a
# space, tab or quote, a quote is written as \", and a run of backslashes is
# doubled before a quote or the closing quote. any other unit, an unpaired
# surrogate included, is copied unchanged
# ---
# argv: null-terminated array of nul-terminated UTF-16 arguments
# buf:  destination, nul-terminated on success
# cap:  size of buf in units
# ret:  the units written, or why the line could not be joined (buf is then unspecified)
pub fun join(argv: **u16, buf: *u16, cap: usize) Joined {
    var j: Join = Join{buf: buf, cap: cap, off: 0};
    if (cap == 0) { ret Joined.overflow{}; }
    var i: usize = 0;
    for (argv[i] != nil) {
        if (i > 0 && !append(?j, SPACE)) { ret Joined.overflow{}; }
        val arg:    *u16  = argv[i];
        var quoted: bool  = arg[0] == 0;
        var k:      usize = 0;
        for (arg[k] != 0) {
            if (blank(arg[k]))             { quoted = true; }
            if (arg[k] == QUOTE && i == 0) { ret Joined.unrepresentable{}; }
            if (arg[k] == QUOTE)           { quoted = true; }
            k = k + 1;
        }
        if (quoted && !append(?j, QUOTE)) { ret Joined.overflow{}; }
        k = 0;
        for (arg[k] != 0) {
            if (i > 0 && arg[k] == BACKSLASH) {
                var run: usize = 0;
                for (arg[k + run] == BACKSLASH) { run = run + 1; }
                # backslashes before a quote, or before the closing quote, are doubled
                var emit: usize = run;
                if (arg[k + run] == QUOTE || (quoted && arg[k + run] == 0)) { emit = run * 2; }
                var n: usize = 0;
                for (n < emit) {
                    if (!append(?j, BACKSLASH)) { ret Joined.overflow{}; }
                    n = n + 1;
                }
                k = k + run;
                cnt;
            }
            if (arg[k] == QUOTE && !append(?j, BACKSLASH)) { ret Joined.overflow{}; }
            if (!append(?j, arg[k]))                       { ret Joined.overflow{}; }
            k = k + 1;
        }
        if (quoted && !append(?j, QUOTE)) { ret Joined.overflow{}; }
        i = i + 1;
    }
    buf[j.off] = 0;
    ret Joined.done{j.off};
}

fun blank(u: u16) bool {
    ret u == SPACE || u == TAB;
}

# the address of the next unit of storage
fun at(w: *Walk) usize {
    if (w.wide) { ret w.buf::usize + w.len * $size_of(u16); }
    ret w.buf::usize + w.len;
}

fun begin(w: *Walk) {
    if (w.argv != nil) { w.argv[w.count] = at(w)::ptr; }
}

fun finish(w: *Walk) {
    if (w.argv != nil) {
        if (w.wide) { @(at(w)::*u16) = 0; }
        or          { @(at(w)::*u8) = 0; }
    }
    w.len   = w.len + 1;
    w.count = w.count + 1;
}

# store a code point as UTF-8
fun emit(w: *Walk, cp: Codepoint) {
    val need: usize = utf8.codepoint_len(cp);
    if (w.argv != nil) { utf8.encode(cp, at(w)::*u8, need); }
    w.len = w.len + need;
}

# store a code unit that stands alone: any unit when wide, else one that is not a surrogate
fun put(w: *Walk, u: u16) {
    if (!w.wide) {
        emit(w, u::Codepoint);
        ret;
    }
    if (w.argv != nil) { @(at(w)::*u16) = u; }
    w.len = w.len + 1;
}

fun backslashes(w: *Walk, n: usize) {
    var k: usize = 0;
    for (k < n) {
        put(w, BACKSLASH);
        k = k + 1;
    }
}

# store the argument text at a unit and return the index after it
fun unit(line: *u16, i: usize, w: *Walk) usize {
    val u: u16 = line[i];
    if (w.wide) {
        put(w, u);
        ret i + 1;
    }
    if (u >= 0xD800 && u <= 0xDBFF && line[i + 1] >= 0xDC00 && line[i + 1] <= 0xDFFF) {
        val high: Codepoint = u::Codepoint - 0xD800;
        val low:  Codepoint = line[i + 1]::Codepoint - 0xDC00;
        emit(w, 0x10000 + (high << 10) + low);
        ret i + 2;
    }
    if (u >= 0xD800 && u <= 0xDFFF) {
        emit(w, utf8.REPLACEMENT);
        ret i + 1;
    }
    emit(w, u::Codepoint);
    ret i + 1;
}

fun walk(line: *u16, w: *Walk) {
    if (line[0] == 0) { ret; }
    var i:      usize = 0;
    var quoted: bool  = false;
    begin(w);
    for (line[i] != 0) {
        if (line[i] == QUOTE) {
            quoted = !quoted;
            i      = i + 1;
            cnt;
        }
        if (!quoted && blank(line[i])) { brk; }
        i = unit(line, i, w);
    }
    finish(w);
    for {
        for (blank(line[i])) { i = i + 1; }
        if (line[i] == 0) { brk; }
        begin(w);
        quoted = false;
        var slashes: usize = 0;
        for (line[i] != 0) {
            val u: u16 = line[i];
            if (u == BACKSLASH) {
                slashes = slashes + 1;
                i       = i + 1;
                cnt;
            }
            if (u == QUOTE) {
                backslashes(w, slashes / 2);
                val escaped: bool = slashes % 2 == 1;
                slashes = 0;
                if (escaped || (quoted && line[i + 1] == QUOTE)) {
                    put(w, QUOTE);
                    i = i + 1;
                    if (!escaped) { i = i + 1; }
                    cnt;
                }
                quoted = !quoted;
                i      = i + 1;
                cnt;
            }
            backslashes(w, slashes);
            slashes = 0;
            if (!quoted && blank(u)) { brk; }
            i = unit(line, i, w);
        }
        backslashes(w, slashes);
        finish(w);
    }
}

# widen an ASCII string into nul-terminated UTF-16
#[testing]
fun widen(s: str, out: *u16) {
    var i: usize = 0;
    for (s[i] != 0) {
        out[i] = s[i]::u16;
        i      = i + 1;
    }
    out[i] = 0;
}

# split a line and compare it with the arguments wanted, joined by '|'
#[testing]
fun splits(line: *u16, count: usize, want: str) bool {
    val size: Size = measure(line);
    if (size.count != count || count + 1 > 8 || size.bytes >= 128) { ret false; }
    var argv:  [8]*u8;
    var bytes: [128]u8;
    bytes[size.bytes] = 0xAA;
    fill(line, ?argv[0], ?bytes[0]);
    if (argv[count] != nil || bytes[size.bytes] != 0xAA) { ret false; }
    var at:   usize = 0;
    var used: usize = 0;
    var k:    usize = 0;
    for (k < count) {
        val arg: *u8   = argv[k];
        var j:   usize = 0;
        for (arg[j] != 0) {
            if (want[at] != arg[j]) { ret false; }
            at = at + 1;
            j  = j + 1;
        }
        if (want[at] == '|') { at = at + 1; }
        or (want[at] != 0)   { ret false; }
        used = used + str_len(arg) + 1;
        k    = k + 1;
    }
    ret want[at] == 0 && used == size.bytes;
}

# split a line into UTF-16 and compare it with the units wanted, joined by '|'
#[testing]
fun splits_wide(line: *u16, count: usize, want: *u16) bool {
    val size: WideSize = measure_wide(line);
    if (size.count != count || count + 1 > 8 || size.units >= 64) { ret false; }
    var argv:  [8]*u16;
    var units: [64]u16;
    units[size.units] = 0xAAAA;
    fill_wide(line, ?argv[0], ?units[0]);
    if (argv[count] != nil || units[size.units] != 0xAAAA) { ret false; }
    var at:   usize = 0;
    var used: usize = 0;
    var k:    usize = 0;
    for (k < count) {
        val arg: *u16  = argv[k];
        var j:   usize = 0;
        for (arg[j] != 0) {
            if (want[at] != arg[j]) { ret false; }
            at = at + 1;
            j  = j + 1;
        }
        if (want[at] == '|'::u16) { at = at + 1; }
        or (want[at] != 0)        { ret false; }
        used = used + j + 1;
        k    = k + 1;
    }
    ret want[at] == 0 && used == size.units;
}

#[testing]
rec Case {
    line:  str;
    count: usize;
    want:  str;
}

# each row is a line split by the post-2008 msvcrt rules, as UTF-8 and as UTF-16
#[testing]
fun msvcrt_cases(cases: *Case) {
    # an empty command line holds no arguments
    cases[0] = Case{line: "", count: 0, want: ""};
    cases[1] = Case{line: "prog", count: 1, want: "prog"};
    cases[2] = Case{line: "prog a b", count: 3, want: "prog|a|b"};
    cases[3] = Case{line: "prog  a\t\tb  ", count: 3, want: "prog|a|b"};
    cases[4] = Case{line: " a", count: 2, want: "|a"};
    # the program name keeps its backslashes and only toggles on quotes
    cases[5] = Case{line: "\"C:\\Program Files\\x.exe\" a", count: 2, want: "C:\\Program Files\\x.exe|a"};
    cases[6] = Case{line: "a\\\"b c", count: 1, want: "a\\b c"};
    # the rows of the table microsoft documents for these rules
    cases[7]  = Case{line: "p \"abc\" d e", count: 4, want: "p|abc|d|e"};
    cases[8]  = Case{line: "p a\\\\b d\"e f\"g h", count: 4, want: "p|a\\\\b|de fg|h"};
    cases[9]  = Case{line: "p a\\\\\\\"b c d", count: 4, want: "p|a\\\"b|c|d"};
    cases[10] = Case{line: "p a\\\\\\\\\"b c\" d e", count: 4, want: "p|a\\\\b c|d|e"};
    cases[11] = Case{line: "p a\"b\"\" c d", count: 2, want: "p|ab\" c d"};
    # empty arguments survive, between others and at the end
    cases[12] = Case{line: "p \"\" b \"\"", count: 4, want: "p||b|"};
    cases[13] = Case{line: "p \"a b", count: 2, want: "p|a b"};
    cases[14] = Case{line: "p a\\\\", count: 2, want: "p|a\\\\"};
    cases[15] = Case{line: "p \\\"", count: 2, want: "p|\""};
    cases[16] = Case{line: "p \"\"\"\"", count: 2, want: "p|\""};
    cases[17] = Case{line: "p\ta", count: 2, want: "p|a"};
    cases[18] = Case{line: "p a\\b\\\\c", count: 2, want: "p|a\\b\\\\c"};
    cases[19] = Case{line: "p x\"y z\"w", count: 2, want: "p|xy zw"};
}

test cmdline__splits_by_the_msvcrt_rules {
    var cases: [20]Case;
    msvcrt_cases(?cases[0]);
    var line: [64]u16;
    var want: [64]u16;
    var i:    usize = 0;
    for (i < 20) {
        widen(cases[i].line, ?line[0]);
        widen(cases[i].want, ?want[0]);
        if (!splits(?line[0], cases[i].count, cases[i].want)) { ret (i + 1)::i32; }
        if (!splits_wide(?line[0], cases[i].count, ?want[0])) { ret (i + 101)::i32; }
        i = i + 1;
    }
    ret 0;
}

test cmdline__converts_utf16_to_utf8 {
    var pairs: [8]u16 = [8]u16{0x22, 0xE9, 0x20, 0x4E2D, 0x22, 0xD83D, 0xDE00, 0};
    if (!splits(?pairs[0], 1, "\xC3\xA9 \xE4\xB8\xAD\xF0\x9F\x98\x80")) { ret 1; }
    ret 0;
}

# a lone high, a lone low, a reversed pair and a high at the end each convert per unit
test cmdline__unpaired_surrogates_become_replacement {
    var lone: [12]u16 = [12]u16{0x70, 0x20, 0xD83D, 0x61, 0x20, 0xDE00, 0x20, 0xDE00, 0xD83D, 0x20, 0xD800, 0};
    val want: str     = "p|\xEF\xBF\xBDa|\xEF\xBF\xBD|\xEF\xBF\xBD\xEF\xBF\xBD|\xEF\xBF\xBD";
    if (!splits(?lone[0], 5, want)) { ret 1; }
    ret 0;
}

# the same lone surrogates, and a pair, split as UTF-16 keep every unit the line held
test cmdline__wide_keeps_unpaired_surrogates {
    var line: [15]u16 = [15]u16{0x70, 0x20, 0xD83D, 0x61, 0x20, 0xDE00, 0x20, 0xDE00, 0xD83D, 0x20, 0xD800, 0x20, 0xD83D, 0xDE00, 0};
    var want: [15]u16 = [15]u16{0x70, 0x7C, 0xD83D, 0x61, 0x7C, 0xDE00, 0x7C, 0xDE00, 0xD83D, 0x7C, 0xD800, 0x7C, 0xD83D, 0xDE00, 0};
    if (!splits_wide(?line[0], 6, ?want[0])) { ret 1; }
    ret 0;
}

# arguments joined by '|' as nul-terminated UTF-16, 0x01 standing for 0xD800 and 0x02 for 0xDC00
#[testing]
fun wide_argv(spec: str, count: usize, units: *u16, argv: **u16) {
    var at:   usize = 0;
    var used: usize = 0;
    var k:    usize = 0;
    for (k < count) {
        argv[k] = ?units[used];
        for (spec[at] != 0 && spec[at] != '|') {
            var u: u16 = spec[at]::u16;
            if (spec[at] == 1) { u = 0xD800; }
            or (spec[at] == 2) { u = 0xDC00; }
            units[used] = u;
            used        = used + 1;
            at          = at + 1;
        }
        units[used] = 0;
        used        = used + 1;
        if (spec[at] == '|') { at = at + 1; }
        k = k + 1;
    }
    argv[count] = nil;
}

# join the arguments, split the line as UTF-16, and compare every argument unit for unit
#[testing]
fun round_trips(spec: str, count: usize) bool {
    var given: [8]*u16;
    var text:  [128]u16;
    if (count + 1 > 8) { ret false; }
    wide_argv(spec, count, ?text[0], ?given[0]);
    var line:   [256]u16;
    val joined: Joined = join(?given[0], ?line[0], 256);
    if (!(sel joined.done)) { ret false; }
    val size: WideSize = measure_wide(?line[0]);
    if (size.count != count || size.units > 128) { ret false; }
    var split: [8]*u16;
    var units: [128]u16;
    fill_wide(?line[0], ?split[0], ?units[0]);
    var k: usize = 0;
    for (k < count) {
        var j: usize = 0;
        for (given[k][j] != 0 || split[k][j] != 0) {
            if (given[k][j] != split[k][j]) { ret false; }
            j = j + 1;
        }
        k = k + 1;
    }
    ret split[count] == nil;
}

# join is the inverse of the wide split for every argv the msvcrt table yields and the edges it leaves out
test cmdline__join_round_trips_through_the_wide_split {
    var cases: [20]Case;
    msvcrt_cases(?cases[0]);
    var i: usize = 0;
    for (i < 20) {
        if (!round_trips(cases[i].want, cases[i].count)) { ret (i + 1)::i32; }
        i = i + 1;
    }
    var edges: [10]Case;
    # unpaired surrogates, a reversed pair, and one in the program name
    edges[0] = Case{line: "", count: 4, want: "p|a\x01b|\x02|\x02\x01"};
    edges[1] = Case{line: "", count: 2, want: "\x01p q|x"};
    # empty arguments between others and at the end
    edges[2] = Case{line: "", count: 4, want: "p||x|"};
    # trailing backslashes before the closing quote and before an embedded quote
    edges[3] = Case{line: "", count: 5, want: "p|a\\\\|b c\\|\\\\\"|x\\\\\"y z"};
    # embedded quotes alone, doubled and inside text
    edges[4] = Case{line: "", count: 5, want: "p|say \"hi\"|\"|\"\"|a\"b"};
    # tabs in the program name and the arguments
    edges[5] = Case{line: "", count: 4, want: "p\tq|a\tb|\t|x"};
    # a program name keeps its backslashes, before its closing quote too
    edges[6] = Case{line: "", count: 2, want: "C:\\dir with space\\|x"};
    edges[7] = Case{line: "", count: 2, want: "C:\\dir\\\\|\\"};
    edges[8] = Case{line: "", count: 1, want: ""};
    edges[9] = Case{line: "", count: 3, want: "p|\\\\\\|\"\\\\\""};
    i        = 0;
    for (i < 10) {
        if (!round_trips(edges[i].want, edges[i].count)) { ret (i + 101)::i32; }
        i = i + 1;
    }
    ret 0;
}

# a quote in the program name has no spelling, and a line past the capacity does not fit
test cmdline__join_refuses_what_the_split_cannot_give_back {
    var text: [16]u16;
    var argv: [3]*u16;
    var line: [16]u16;
    wide_argv("a\"b|c", 2, ?text[0], ?argv[0]);
    val quoted: Joined = join(?argv[0], ?line[0], 16);
    if (!(sel quoted.unrepresentable)) { ret 1; }
    wide_argv("ab|c", 2, ?text[0], ?argv[0]);
    val tight: Joined = join(?argv[0], ?line[0], 4);
    if (!(sel tight.overflow)) { ret 2; }
    val fits: Joined = join(?argv[0], ?line[0], 5);
    if (!(sel fits.done && fits.done == 4 && line[4] == 0)) { ret 3; }
    ret 0;
}
