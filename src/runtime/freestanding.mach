# freestanding program entrypoint, dispatched by architecture
#
# bare metal has no loader to set a stack, place data or pass arguments, so the
# one `_start` of each architecture does that work in asm before any mach code
# runs: it points the stack at `__run_stop_.stack`, copies `.data` from where it
# loads to where it runs, zeroes `.bss`, calls `main(0, nil)`, and parks the core
# when main returns, since there is no process to exit.
#
# the linker defines the section boundaries the entry reads (mink#526): for an
# output section named `S`, `__run_start_S` and `__run_stop_S` bound where it
# runs and `__load_start_S` names where its bytes load. the manifest places
# `.data`, `.bss` and `.stack`, and std defines the `.stack` reserve below, so a
# manifest that places `.stack` in a RAM region needs no stack code of its own.

use std.types.size.usize;

$if ($mach.build.sys != $mach.sys.freestanding) {
    $error("std.runtime.freestanding needs a freestanding target");
}
$or {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        use std.runtime.freestanding.x86_64;
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        use std.runtime.freestanding.aarch64;
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        use std.runtime.freestanding.riscv64;
    }
    $or {
        $error("std.runtime.freestanding: unsupported architecture");
    }
}

# bytes of stack the reserve holds
pub val STACK_SIZE: usize = 65536;

# the stack, zeroed and without an initializer so the image carries no bytes
# for it. the entry sets the stack pointer to its end, `__run_stop_.stack`
#[section(".stack")]
var stack: [STACK_SIZE]u8;
