# the process arguments as the host passed them, before any conversion
#
# main's argv is UTF-8 on every host. on linux and darwin it is the bytes the
# kernel passed, so the native view holds the same arguments. on windows argv is
# converted from the wide command line and an unpaired surrogate, which a file
# name may hold, becomes U+FFFD, so such a name does not survive in argv. the
# native view there holds each argument as the UTF-16 code units the command
# line held, split by the same walker as argv (std.runtime.windows.cmdline), so
# both views have the same count and each index names the same argument.
#
# a program that must reopen a name exactly as it was given reads it here, in
# the host's own units, through one shape on every host. the runtime publishes
# the view at entry, before main, and it lives as long as the process.

use std.types.option.opt;
use std.types.size.usize;

# one unit of a native argument: a UTF-16 code unit on windows, a byte elsewhere
$if ($mach.build.os == $mach.os.windows) {
    pub def Unit: u16;
}
$or {
    pub def Unit: u8;
}

# the process arguments in native units
# ---
# count: number of arguments, the program name included
# argv:  the arguments, each nul-terminated, and a closing nil
pub rec Args {
    count: usize;
    argv:  **Unit;
}

var published: Args;

# the process arguments in native units
# ---
# ret: the view the runtime published before main
pub fun args() Args {
    ret published;
}

# the argument at an index
# ---
# a:   the arguments
# idx: argument index, 0 the program name
# ret: the argument's units, or none when the index is out of range
pub fun get(a: Args, idx: usize) opt[*Unit] {
    if (idx >= a.count) { ret opt[*Unit].none{}; }
    ret opt[*Unit].some{a.argv[idx]};
}

# hand the native view over from the entrypoint. std.runtime calls it once, before main
# ---
# count: number of arguments
# argv:  the arguments and a closing nil, kept for the life of the process
pub fun publish(count: usize, argv: **Unit) {
    published = Args{count: count, argv: argv};
}

# holds for any launch, an empty command line included
test native__runtime_published_the_arguments {
    val a: Args = args();
    if (a.argv == nil || a.argv[a.count] != nil) { ret 1; }
    var i: usize = 0;
    for (i < a.count) {
        val arg: opt[*Unit] = get(a, i);
        if (!(sel arg.some && arg.some != nil)) { ret 2; }
        i = i + 1;
    }
    val past: opt[*Unit] = get(a, a.count);
    if (sel past.some) { ret 3; }
    ret 0;
}
