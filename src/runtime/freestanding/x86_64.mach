# x86_64 freestanding entrypoint
# ---
# provides `_start`, the entry of a bare-metal x86_64 image. the core arrives in
# long mode with no stack the program may rely on and no arguments.
#
# this entrypoint, all in asm since no mach code may run before it is done:
#   1. points rsp at the top of the `.stack` reserve, 16-aligned for the SysV
#      call boundary
#   2. copies `.data` from where it loads to where it runs, unless they are the
#      same address
#   3. zeroes `.bss`
#   4. calls user-supplied `main(0, nil)`
#   5. parks the core in a hlt loop when main returns
#
# user code must define:
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 { ... }

#[symbol("__run_stop_.stack")]
ext var run_stop_stack:  u8;
#[symbol("__load_start_.data")]
ext var load_start_data: u8;
#[symbol("__run_start_.data")]
ext var run_start_data:  u8;
#[symbol("__run_stop_.data")]
ext var run_stop_data:   u8;
#[symbol("__run_start_.bss")]
ext var run_start_bss:   u8;
#[symbol("__run_stop_.bss")]
ext var run_stop_bss:    u8;

#[naked]
#[symbol("_start")]
pub fun _start() {
    asm x86_64 {
        lea rsp, [__run_stop_.stack]
        and rsp, -16

        lea rsi, [__load_start_.data]
        lea rdi, [__run_start_.data]
        lea rcx, [__run_stop_.data]
        sub rcx, rdi
        cmp rsi, rdi
        je 1f
        cld
        rep movsb
    1:
        lea rdi, [__run_start_.bss]
        lea rcx, [__run_stop_.bss]
        sub rcx, rdi
        xor eax, eax
        cld
        rep stosb

        xor edi, edi      # argc = 0
        xor esi, esi      # argv = nil
        call main
    2:
        hlt
        jmp 2b
    }
}
