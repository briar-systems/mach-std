# x86_64 freestanding entrypoint
# ---
# provides `_start`, the entry of a bare-metal x86_64 image. the core arrives in
# long mode with no stack the program may rely on and no arguments.
#
# supported level: ring 0 in long mode. at any other ring the control register
# writes would fault, so the entry skips step 2 and leaves SSE as the loader set it.
#
# this entrypoint, all in asm since no mach code may run before it is done:
#   1. points rsp at the top of the `.stack` region mink lays out,
#      16-aligned for the SysV call boundary
#   2. at ring 0, enables SSE: CR0.EM clear, CR0.MP set, CR4.OSFXSR and
#      CR4.OSXMMEXCPT set, so float and vector code runs before main
#   3. copies `.data` from where it loads to where it runs, unless they are the
#      same address
#   4. zeroes `.bss`
#   5. calls user-supplied `main(0, nil)`
#   6. parks the core in a hlt loop when main returns
#
# user code must define:
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 { ... }

#[symbol("__run_stop_.stack")]
ext var run_stop_stack:  u8;
#[symbol("__load_start_.data")]
ext var load_start_data: u8;
#[symbol("__run_start_.data")]
ext var run_start_data:  u8;
#[symbol("__run_stop_.data")]
ext var run_stop_data:   u8;
#[symbol("__run_start_.bss")]
ext var run_start_bss:   u8;
#[symbol("__run_stop_.bss")]
ext var run_stop_bss:    u8;

#[naked]
#[symbol("_start")]
pub fun _start() {
    asm x86_64 {
        lea rsp, [__run_stop_.stack]
        and rsp, -16

        .byte 0x8c, 0xc8 :: writes(rax)    # mov eax, cs
        test al, 3
        jnz 6f
        mov rax, cr0
        and rax, -5               # clear EM
        or rax, 2                 # set MP
        mov cr0, rax
        mov rax, cr4
        or rax, 0x600             # set OSFXSR and OSXMMEXCPT
        mov cr4, rax
    6:
        lea rsi, [__load_start_.data]
        lea rdi, [__run_start_.data]
        lea rcx, [__run_stop_.data]
        sub rcx, rdi
        cmp rsi, rdi
        je 1f
        cld
        rep movsb
    1:
        lea rdi, [__run_start_.bss]
        lea rcx, [__run_stop_.bss]
        sub rcx, rdi
        xor eax, eax
        cld
        rep stosb

        xor edi, edi      # argc = 0
        xor esi, esi      # argv = nil
        call main
    2:
        hlt
        jmp 2b
    }
}
