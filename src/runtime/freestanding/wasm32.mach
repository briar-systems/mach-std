# wasm32 freestanding entrypoint
# ---
# provides `_start`, which a freestanding module exports for its host to call
# with nothing. the host instantiates the module with the data and the stack
# pointer the link laid out, so mach code runs from the first instruction and
# nothing is copied or zeroed. this entrypoint:
#   1. calls user-supplied `main(0, nil)`
#   2. returns to the host when main returns 0
#   3. traps through std.system.panic when main returns anything else, since a
#      module has no process to exit and a trap is the end every host sees
#
# a module that wants no entry uses no std.runtime: its host calls what it
# marks `#[export]`.
#
# user code must define:
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 { ... }

use std.system.panic.panic;

#[symbol("main")]
ext fun program_main(argc: i64, argv: **u8) i64;

# the module entry, the steps the module comment lists
#[symbol("_start")]
pub fun _start() {
    if (program_main(0, nil) != 0) {
        panic("std.runtime: main returned a code other than 0\n");
    }
}
