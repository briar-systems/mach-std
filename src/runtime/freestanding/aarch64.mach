# aarch64 freestanding entrypoint
# ---
# provides `_start`, the entry of a bare-metal aarch64 image. the core arrives
# with no stack the program may rely on and no arguments.
#
# this entrypoint, all in asm since no mach code may run before it is done:
#   1. points sp at the top of the `.stack` region mink lays out,
#      16-aligned as AAPCS64 requires
#   2. copies `.data` from where it loads to where it runs, unless they are the
#      same address
#   3. zeroes `.bss`
#   4. calls user-supplied `main(0, nil)`
#   5. parks the core in a wfi loop when main returns
#
# user code must define:
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 { ... }

#[symbol("__run_stop_.stack")]
ext var run_stop_stack:  u8;
#[symbol("__load_start_.data")]
ext var load_start_data: u8;
#[symbol("__run_start_.data")]
ext var run_start_data:  u8;
#[symbol("__run_stop_.data")]
ext var run_stop_data:   u8;
#[symbol("__run_start_.bss")]
ext var run_start_bss:   u8;
#[symbol("__run_stop_.bss")]
ext var run_stop_bss:    u8;

#[naked]
#[symbol("_start")]
pub fun _start() {
    asm aarch64 {
        adrp x9, __run_stop_.stack
        add x9, x9, :lo12:__run_stop_.stack
        mov x10, -16
        and x9, x9, x10
        mov sp, x9

        adrp x0, __load_start_.data
        add x0, x0, :lo12:__load_start_.data
        adrp x1, __run_start_.data
        add x1, x1, :lo12:__run_start_.data
        adrp x2, __run_stop_.data
        add x2, x2, :lo12:__run_stop_.data
        cmp x0, x1
        b.eq 2f
    1:
        cmp x1, x2
        b.hs 2f
        ldrb w3, [x0]
        strb w3, [x1]
        add x0, x0, 1
        add x1, x1, 1
        b 1b
    2:
        adrp x1, __run_start_.bss
        add x1, x1, :lo12:__run_start_.bss
        adrp x2, __run_stop_.bss
        add x2, x2, :lo12:__run_stop_.bss
    3:
        cmp x1, x2
        b.hs 4f
        strb wzr, [x1]
        add x1, x1, 1
        b 3b
    4:
        mov x0, 0             # argc = 0
        mov x1, 0             # argv = nil
        bl main
    5:
        wfi
        b 5b
    }
}
