# aarch64 freestanding entrypoint
# ---
# provides `_start`, the entry of a bare-metal aarch64 image. the core arrives
# with no stack the program may rely on and no arguments.
#
# supported level: EL1, where the entry enables FP and SIMD. EL0 is not
# supported, since reading CurrentEL is undefined there and traps. EL2 and EL3
# are not supported either: their FP traps live in CPTR_EL2 and CPTR_EL3, which
# this entry does not touch, so float code there may still trap.
#
# this entrypoint, all in asm since no mach code may run before it is done:
#   1. points sp at the top of the `.stack` region mink lays out,
#      16-aligned as AAPCS64 requires
#   2. at EL1, sets CPACR_EL1.FPEN to 0b11 and synchronizes, so FP and SIMD
#      code runs before main
#   3. copies `.data` from where it loads to where it runs, unless they are the
#      same address
#   4. zeroes `.bss`
#   5. calls user-supplied `main(0, nil)`
#   6. parks the core in a wfi loop when main returns
#
# user code must define:
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 { ... }

#[symbol("__run_stop_.stack")]
ext var run_stop_stack:  u8;
#[symbol("__load_start_.data")]
ext var load_start_data: u8;
#[symbol("__run_start_.data")]
ext var run_start_data:  u8;
#[symbol("__run_stop_.data")]
ext var run_stop_data:   u8;
#[symbol("__run_start_.bss")]
ext var run_start_bss:   u8;
#[symbol("__run_stop_.bss")]
ext var run_stop_bss:    u8;

#[naked]
#[symbol("_start")]
pub fun _start() {
    asm aarch64 {
        adrp x9, __run_stop_.stack
        add x9, x9, :lo12:__run_stop_.stack
        mov x10, -16
        and x9, x9, x10
        mov sp, x9

        .word 0xd5384249 :: writes(x9)    # mrs x9, CurrentEL
        lsr x9, x9, 2
        cmp x9, 1
        b.ne 6f
        .word 0xd5381049 :: writes(x9)    # mrs x9, cpacr_el1
        mov x10, 0x300000         # FPEN = 0b11
        orr x9, x9, x10
        .word 0xd5181049 :: writes()      # msr cpacr_el1, x9
        isb
    6:
        adrp x0, __load_start_.data
        add x0, x0, :lo12:__load_start_.data
        adrp x1, __run_start_.data
        add x1, x1, :lo12:__run_start_.data
        adrp x2, __run_stop_.data
        add x2, x2, :lo12:__run_stop_.data
        cmp x0, x1
        b.eq 2f
    1:
        cmp x1, x2
        b.hs 2f
        ldrb w3, [x0]
        strb w3, [x1]
        add x0, x0, 1
        add x1, x1, 1
        b 1b
    2:
        adrp x1, __run_start_.bss
        add x1, x1, :lo12:__run_start_.bss
        adrp x2, __run_stop_.bss
        add x2, x2, :lo12:__run_stop_.bss
    3:
        cmp x1, x2
        b.hs 4f
        strb wzr, [x1]
        add x1, x1, 1
        b 3b
    4:
        mov x0, 0             # argc = 0
        mov x1, 0             # argv = nil
        bl main
    5:
        wfi
        b 5b
    }
}
