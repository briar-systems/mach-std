# riscv64 freestanding entrypoint
# ---
# provides `_start`, the entry of a bare-metal riscv64 image. the hart arrives
# with no stack the program may rely on and no arguments.
#
# this entrypoint, all in asm since no mach code may run before it is done:
#   1. points sp at the top of the `.stack` reserve, 16-aligned as the lp64
#      ABI requires
#   2. copies `.data` from where it loads to where it runs, unless they are the
#      same address
#   3. zeroes `.bss`
#   4. calls user-supplied `main(0, nil)`
#   5. parks the hart in a wfi loop when main returns
#
# user code must define:
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 { ... }

#[symbol("__run_stop_.stack")]
ext var run_stop_stack:  u8;
#[symbol("__load_start_.data")]
ext var load_start_data: u8;
#[symbol("__run_start_.data")]
ext var run_start_data:  u8;
#[symbol("__run_stop_.data")]
ext var run_stop_data:   u8;
#[symbol("__run_start_.bss")]
ext var run_start_bss:   u8;
#[symbol("__run_stop_.bss")]
ext var run_stop_bss:    u8;

#[naked]
#[symbol("_start")]
pub fun _start() {
    asm riscv64 {
        la t0, __run_stop_.stack
        andi t0, t0, -16
        mv sp, t0

        la t0, __load_start_.data
        la t1, __run_start_.data
        la t2, __run_stop_.data
        beq t0, t1, 2f
    1:
        bgeu t1, t2, 2f
        lbu t3, 0(t0)
        sb t3, 0(t1)
        addi t0, t0, 1
        addi t1, t1, 1
        j 1b
    2:
        la t1, __run_start_.bss
        la t2, __run_stop_.bss
    3:
        bgeu t1, t2, 4f
        sb zero, 0(t1)
        addi t1, t1, 1
        j 3b
    4:
        li a0, 0              # argc = 0
        li a1, 0              # argv = nil
        call main
    5:
        .word 0x10500073 :: writes()    # wfi
        j 5b
    }
}
