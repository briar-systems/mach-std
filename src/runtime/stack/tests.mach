# std.runtime.stack on the main thread and on a spawned one

use std.print;
use std.runtime.stack;
use std.sync.thread;
use std.system.os;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;

val DEPTH: usize = 16;
val PAD:   usize = 4096;

# the frames' pads escape here, so the recursion keeps them on the stack
var pad_sink: usize = 0;

# record remaining() at each depth into out, each frame holding PAD bytes
fun descend(depth: usize, out: *usize) {
    var pad: [4096]u8;
    pad[depth] = depth::u8;
    pad_sink   = (?pad[0])::usize;
    val left: opt[usize] = stack.remaining();
    out[depth] = 0;
    if (sel left.some)     { out[depth] = left.some; }
    if (depth + 1 < DEPTH) { descend(depth + 1, out); }
    out[depth] = out[depth] + (pad[depth] - depth::u8)::usize;
}

# 0 when every level is known, under reserve, and at least a pad below the last
fun check(out: *usize, reserve: usize) i32 {
    if (out[0] == 0 || out[0] >= reserve) { ret 1; }
    var i: usize = 1;
    for (i < DEPTH) {
        if (out[i] == 0 || out[i] + PAD > out[i - 1]) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

test stack__remaining_falls_by_each_frame_on_the_main_thread {
    var low:  usize = 0;
    var high: usize = 0;
    if (!os.stack_bounds(?low, ?high) || high <= low) { ret 1; }
    var out: [16]usize;
    descend(0, ?out[0]);
    ret check(?out[0], high - low) * 10;
}

rec Probe {
    out:    [16]usize;
    low:    usize;
    high:   usize;
    known:  bool;
    result: i32;
}

val SPAWNED_RESERVE: usize = 1048576;

fun probe_worker(arg: *u8) {
    val p: *Probe = arg::*Probe;
    p.known = os.stack_bounds(?p.low, ?p.high);
    descend(0, ?p.out[0]);
    p.result = check(?p.out[0], SPAWNED_RESERVE);
}

# the spawned thread reports against its own reserve, not the main thread's
test stack__remaining_counts_a_spawned_thread_against_its_own_reserve {
    var p: Probe;
    p.result = -1;
    var c: thread.Config;
    thread.config_default(?c);
    c.stack_reserve = SPAWNED_RESERVE;
    var t:       thread.Thread;
    val spawned: thread.Operation = thread.spawn_with_config(probe_worker, (?p)::*u8, ?c, ?t);
    if (sel spawned.err) { ret 1; }
    val joined: thread.Operation = thread.join(?t);
    if (sel joined.err) { ret 2; }
    # the bounds are the thread's own, within the reserve it asked for less
    # what the implementation keeps at its top
    if (!p.known) { ret 4; }
    val span: usize = p.high - p.low;
    print.eu64(p.low::u64);
    print.eprint(" ");
    print.eu64(p.high::u64);
    print.eprint(" ");
    print.eu64(span::u64);
    print.eprint(" ");
    print.eu64(p.out[0]::u64);
    print.eprintln("");
    if (span > SPAWNED_RESERVE || span + SPAWNED_RESERVE / 16 < SPAWNED_RESERVE) { ret 5; }
    if (p.result != 0)                                                           { ret 10 + p.result; }
    # most of the reserve is left at the thread's first frames
    if (p.out[0] < SPAWNED_RESERVE / 2) { ret 3; }
    ret 0;
}
