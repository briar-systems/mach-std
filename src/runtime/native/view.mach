# the shape of the native argument view, shared by std.runtime.native and the runtimes that own the arguments

use std.types.size.usize;

# one unit of a native argument: a UTF-16 code unit on windows, a byte elsewhere
$if ($mach.build.os == $mach.os.windows) {
    pub def Unit: u16;
}
$or {
    pub def Unit: u8;
}

# the process arguments in native units
# ---
# count: number of arguments, the program name included
# argv:  the arguments, each nul-terminated, and a closing nil
pub rec Args {
    count: usize;
    argv:  **Unit;
}

# a nul-terminated string in native units, owned by whoever allocated it
# ---
# units:  the units, length + 1 with the terminator
# length: its length in units
pub rec NativeName {
    units:  *Unit;
    length: usize;
}
