# windows program entrypoint, dispatched by architecture

$if ($mach.build.os != $mach.os.windows) {
    $error("std.runtime.windows needs the windows target");
}
$or {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        use std.runtime.windows.x86_64;
    }
    $or {
        $error("std.runtime.windows: unsupported architecture");
    }
}
