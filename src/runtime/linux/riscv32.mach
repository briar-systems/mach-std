# riscv32 (ilp32) linux entrypoint
# ---
# provides `_start`, the ELF entry point for riscv32 linux executables.
#
# on entry, the kernel places the following on the stack (every ILP32 linux
# triple, 4-byte slots):
#   [sp]      = argc
#   [sp+4]    = argv[0]
#   [sp+8]    = argv[1]
#   ...
#   argv + (argc+1)*4 = envp[0]
#
# this entrypoint mirrors the other linux ones:
#   1. extracts argc, argv, and envp from the initial stack
#   2. stores them into the runtime globals
#   3. calls _rt_init to publish envp into the OS layer
#   4. calls user-supplied `main(argc, argv)`. argc is an i64, which the ilp32
#      convention passes in a register pair, low word first: a0 and a1 hold
#      argc and a2 holds argv
#   5. exits via SYS_exit_group with the low word of main's return code
#      (terminates all threads; SYS_exit would leave non-main threads alive)
#
# user code must define:
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 { ... }
#
# entry frame: `_start` is a naked inline-asm function (no locals, no calls
# outside the asm block), so the backend emits no prologue and the first
# instruction reads the raw kernel-supplied sp (argc at [sp]). sp is 16-byte
# aligned on kernel entry (the riscv process-startup invariant), so no
# realignment is needed before the calls.

use std.runtime.native.view;
use os:        std.system.os.linux.riscv32;
use os_shared: std.system.os.shared;
use std.system.panic.panic;
use std.types.size.usize;

# the static-PIE self-relocation pass, linked only into a `--pie` build.
$if ($mach.build.pie == 1) {
    use std.runtime.linux.reloc;
}

#[symbol("_rt_argc")]
var _rt_argc: i64   = 0;
#[symbol("_rt_argv")]
var _rt_argv: usize = 0;
#[symbol("_rt_envp")]
var _rt_envp: usize = 0;

# the main thread's block where std owns its thread pointer; spawned threads get
# theirs from the OS layer
var main_block: os_shared.ThreadBlock;

# install the main thread's block unless an interpreter owns the thread pointer
#
# whoever starts the process owns the main thread's thread pointer. with no
# interpreter the kernel leaves it unset and std owns it. an interpreter sets it
# to its C runtime's thread control block before the entry point, and std never
# writes it then
fun install_main_block() {
    if (os.loader_present()) { ret; }
    if (os.thread_block_enter(?main_block) < 0) {
        panic("std.runtime: the main thread's block could not be installed\n");
    }
}

#[symbol("_rt_init")]
fun _rt_init() {
    # a `--pie` build self-relocates here, before `main` and before any global pointer
    # is read - the auxv is reached from envp, so `_start`'s raw-sp asm stays untouched
    # (and a non-PIE build links none of this, leaving `_rt_init` byte-identical).
    $if ($mach.build.pie == 1) {
        reloc._rt_relocate(_rt_envp::ptr::*usize);
    }
    os._envp = _rt_envp;
    # publish AT_PAGESZ into the OS layer for page_size(); runs after _envp is set
    # and (under --pie) after relocation, so it is ordinary post-relocation code.
    os.capture_pagesz();
    # before main, so the main thread's token is valid from entry
    install_main_block();
    # the main thread's stack bounds, for std.runtime.stack
    os.capture_main_stack();
}

# the arguments as the kernel passed them, for std.runtime.native
# ---
# ret: argc and argv, which are already the native bytes
pub fun native_args() view.Args {
    ret view.Args{count: _rt_argc::usize, argv: _rt_argv::ptr::**view.Unit};
}

#[naked]
#[symbol("_start")]
pub fun _start() {
    asm riscv32 {
        mv t0, sp            # t0 = initial stack pointer (argc at [t0])
        lw a0, 0(t0)         # argc
        addi a2, t0, 4       # argv

        # envp = argv + (argc + 1) * 4
        addi t1, a0, 1
        slli t1, t1, 2
        add t1, a2, t1       # t1 = envp

        la t2, _rt_argc
        sw a0, 0(t2)
        sw zero, 4(t2)       # _rt_argc is an i64, argc its low word
        la t2, _rt_argv
        sw a2, 0(t2)
        la t2, _rt_envp
        sw t1, 0(t2)

        call _rt_init

        la t2, _rt_argc
        lw a0, 0(t2)         # argc, low word
        lw a1, 4(t2)         # argc, high word
        la t2, _rt_argv
        lw a2, 0(t2)         # argv
        call main

        # exit_group with the low word of main's return value (already in a0)
        li a7, 94            # SYS_exit_group
        ecall
    }
}
