# SHA-1, for interop with formats that name it
#
# this module exists only to read and write formats that fix SHA-1 in their
# layout: Mach-O code directories, git object ids and the like. it is not a
# security primitive and lives outside `std.crypto` on purpose. SHA-1
# collisions are practical, so it must never be used for new integrity,
# signature, authentication or key derivation purposes. use
# `std.crypto.hash.sha256` or `std.crypto.hash.sha512` instead.
# there is no secret-typed form and nothing here is constant time.

use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

pub val DIGEST_SIZE: usize = 20;
pub val BLOCK_SIZE:  usize = 64;

pub rec State {
    h0:      u32;
    h1:      u32;
    h2:      u32;
    h3:      u32;
    h4:      u32;
    buf:     [64]u8;
    buf_len: usize;
    total:   u64;
}

fun rotl(x: u32, n: u32) u32 {
    ret (x << n) | (x >> (32 - n));
}

fun process_block(s: *State, block: *u8) {
    var w: [80]u32;
    var i: usize = 0;
    for (i < 16) {
        w[i] = (block[i * 4]::u32 << 24) | (block[i * 4 + 1]::u32 << 16) |
            (block[i * 4 + 2]::u32 << 8) | block[i * 4 + 3]::u32;
        i = i + 1;
    }
    for (i < 80) {
        w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
        i    = i + 1;
    }

    var a: u32 = s.h0;
    var b: u32 = s.h1;
    var c: u32 = s.h2;
    var d: u32 = s.h3;
    var e: u32 = s.h4;

    i = 0;
    for (i < 80) {
        var f: u32 = 0;
        var k: u32 = 0;
        if (i < 20) {
            f = (b & c) | (~b & d);
            k = 0x5a827999;
        }
        or (i < 40) {
            f = b ^ c ^ d;
            k = 0x6ed9eba1;
        }
        or (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8f1bbcdc;
        }
        or {
            f = b ^ c ^ d;
            k = 0xca62c1d6;
        }
        val t: u32 = rotl(a, 5) + f + e + k + w[i];
        e = d;
        d = c;
        c = rotl(b, 30);
        b = a;
        a = t;
        i = i + 1;
    }

    s.h0 = s.h0 + a;
    s.h1 = s.h1 + b;
    s.h2 = s.h2 + c;
    s.h3 = s.h3 + d;
    s.h4 = s.h4 + e;
}

# initialize a new SHA-1 state with the standard IV
# ---
# ret: initialized state
pub fun init() State {
    var s: State;
    s.h0      = 0x67452301;
    s.h1      = 0xefcdab89;
    s.h2      = 0x98badcfe;
    s.h3      = 0x10325476;
    s.h4      = 0xc3d2e1f0;
    s.buf_len = 0;
    s.total   = 0;
    ret s;
}

# feed data into the hash state
# ---
# s:    pointer to hash state
# data: pointer to input bytes
# len:  number of bytes to process
pub fun update(s: *State, data: *u8, len: usize) {
    var off: usize = 0;
    s.total = s.total + len::u64;

    if (s.buf_len > 0) {
        var fill: usize = 64 - s.buf_len;
        if (fill > len) { fill = len; }
        memory.raw_copy(?s.buf[s.buf_len], ?data[off], fill);
        s.buf_len = s.buf_len + fill;
        off       = off + fill;
        if (s.buf_len == 64) {
            process_block(s, ?s.buf[0]);
            s.buf_len = 0;
        }
    }

    for (off + 64 <= len) {
        process_block(s, ?data[off]);
        off = off + 64;
    }

    if (off < len) {
        val remaining: usize = len - off;
        memory.raw_copy(?s.buf[0], ?data[off], remaining);
        s.buf_len = remaining;
    }
}

fun put_be(digest: *u8, off: usize, v: u32) {
    digest[off]     = (v >> 24)::u8;
    digest[off + 1] = (v >> 16)::u8;
    digest[off + 2] = (v >> 8)::u8;
    digest[off + 3] = v::u8;
}

# finalize the hash and write the 20-byte digest
# ---
# s:      pointer to hash state
# digest: pointer to 20-byte output buffer
pub fun final(s: *State, digest: *u8) {
    val total_bits: u64 = s.total * 8;

    s.buf[s.buf_len] = 0x80;
    s.buf_len        = s.buf_len + 1;

    if (s.buf_len > 56) {
        for (s.buf_len < 64) {
            s.buf[s.buf_len] = 0;
            s.buf_len        = s.buf_len + 1;
        }
        process_block(s, ?s.buf[0]);
        s.buf_len = 0;
    }

    for (s.buf_len < 56) {
        s.buf[s.buf_len] = 0;
        s.buf_len        = s.buf_len + 1;
    }

    s.buf[56] = (total_bits >> 56)::u8;
    s.buf[57] = (total_bits >> 48)::u8;
    s.buf[58] = (total_bits >> 40)::u8;
    s.buf[59] = (total_bits >> 32)::u8;
    s.buf[60] = (total_bits >> 24)::u8;
    s.buf[61] = (total_bits >> 16)::u8;
    s.buf[62] = (total_bits >> 8)::u8;
    s.buf[63] = total_bits::u8;

    process_block(s, ?s.buf[0]);

    put_be(digest, 0, s.h0);
    put_be(digest, 4, s.h1);
    put_be(digest, 8, s.h2);
    put_be(digest, 12, s.h3);
    put_be(digest, 16, s.h4);
}

# compute the SHA-1 digest of a byte buffer in one call
# ---
# data:   pointer to input bytes
# len:    number of bytes to hash
# digest: pointer to 20-byte output buffer
pub fun hash(data: *u8, len: usize, digest: *u8) {
    var s: State = init();
    update(?s, data, len);
    final(?s, digest);
}

#[testing]
fun hex_matches(digest: *u8, len: usize, expected: str) bool {
    var i: usize = 0;
    for (i < len) {
        val hi: u8 = expected[i * 2];
        val lo: u8 = expected[i * 2 + 1];
        var v:  u8 = 0;
        if (hi >= 97)       { v = (hi - 87) << 4; }
        or                  { v = (hi - 48) << 4; }
        if (lo >= 97)       { v = v | (lo - 87); }
        or                  { v = v | (lo - 48); }
        if (digest[i] != v) { ret false; }
        i = i + 1;
    }
    ret true;
}

test sha1__fips_vectors {
    var digest: [20]u8;
    hash(""::*u8, 0, ?digest[0]);
    if (!hex_matches(?digest[0], 20, "da39a3ee5e6b4b0d3255bfef95601890afd80709")) { ret 1; }
    hash("abc"::*u8, 3, ?digest[0]);
    if (!hex_matches(?digest[0], 20, "a9993e364706816aba3e25717850c26c9cd0d89d")) { ret 2; }
    val two: str = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    hash(two::*u8, 56, ?digest[0]);
    if (!hex_matches(?digest[0], 20, "84983e441c3bd26ebaae4aa1f95129e5e54670f1")) { ret 3; }
    ret 0;
}

test sha1__million_a {
    var block: [1000]u8;
    var i:     usize = 0;
    for (i < 1000) {
        block[i] = 'a';
        i        = i + 1;
    }
    var s: State = init();
    i = 0;
    for (i < 1000) {
        update(?s, ?block[0], 1000);
        i = i + 1;
    }
    var digest: [20]u8;
    final(?s, ?digest[0]);
    if (!hex_matches(?digest[0], 20, "34aa973cd4c4daa4f61eeb2bdbad27316534016f")) { ret 1; }
    ret 0;
}

test sha1__uneven_chunks_cross_blocks {
    var data: [200]u8;
    var i:    usize = 0;
    for (i < 200) {
        data[i] = (i * 7 + 3)::u8;
        i       = i + 1;
    }
    val lens: [10]usize = [10]usize{0, 1, 55, 56, 57, 63, 64, 65, 127, 200};
    var k:    usize     = 0;
    for (k < 10) {
        var one: [20]u8;
        hash(?data[0], lens[k], ?one[0]);
        var s:   State = init();
        var off: usize = 0;
        var n:   usize = 1;
        for (off < lens[k]) {
            var take: usize = n;
            if (take > lens[k] - off) { take = lens[k] - off; }
            update(?s, ?data[off], take);
            off = off + take;
            n   = n * 3 + 1;
        }
        var split: [20]u8;
        final(?s, ?split[0]);
        i = 0;
        for (i < 20) {
            if (one[i] != split[i]) { ret 1; }
            i = i + 1;
        }
        k = k + 1;
    }
    ret 0;
}

test sha1__boundary_lengths_match_reference {
    var data: [64]u8;
    var i:    usize = 0;
    for (i < 64) {
        data[i] = 'a';
        i       = i + 1;
    }
    var digest: [20]u8;
    hash(?data[0], 55, ?digest[0]);
    if (!hex_matches(?digest[0], 20, "c1c8bbdc22796e28c0e15163d20899b65621d65a")) { ret 1; }
    hash(?data[0], 56, ?digest[0]);
    if (!hex_matches(?digest[0], 20, "c2db330f6083854c99d4b5bfb6e8f29f201be699")) { ret 2; }
    hash(?data[0], 64, ?digest[0]);
    if (!hex_matches(?digest[0], 20, "0098ba824b5c16427bd7a1122a5a442a25ec644d")) { ret 3; }
    ret 0;
}
