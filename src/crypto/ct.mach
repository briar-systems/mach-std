# constant-time primitives over `^` secrets
#
# the operations that replace the ones a leakage model observes. sema rejects a
# secret branch condition, a secret memory index, and a secret operand of a
# variable-latency instruction; these are what one writes instead. every
# computational primitive here is `#[oblivious]`, so the backend may not
# reintroduce a branch, select a variable-latency instruction on a secret
# operand, or delete a zeroizing store — see `zeroize` for which parts of that
# contract carry weight today and which are still waiting on a pass to subtract.
#
# TWO KINDS OF PRIMITIVE, FOR TWO DIFFERENT REASONS.
#
# the comparisons are the language's own `==` / `<` / `>` on secret operands.
# a comparison is not a branch — mach lowers one to a flag-setting compare and a
# materialize (`cmp`/`setb` on x86_64, `cmp`/`cset` on aarch64, `sltu` on
# riscv64), all branch-free, and each lowering zero-extends a narrow operand
# before comparing. what keeps it that way is `#[oblivious]`: inside it the
# backend may not turn a secret comparison into a branch, and the translation
# validator re-checks the lowered MIR. writing the bit-twiddling equivalent by
# hand would buy nothing the contract does not already give, and would cost the
# operand cleanup the compare gets for free.
#
# the merges are masked arithmetic — and/or/xor/not over an all-ones mask —
# because there is no operator that selects without branching. that set is
# branch-free on every architecture mach targets, including base RISC-V, which
# has no conditional move at all, and it needs no per-arch assembly. multiply is
# deliberately absent: it is variable-latency on some cores, and sema admits it
# on a secret operand only where the target declares its multiply constant-time
# (the compiler's `doc/language/secrecy.md`), so a primitive built on it would
# not be portable.
#
# THE FLAG CONVENTION. comparisons return a secret `^u8` holding 0 or 1, and
# `mask_*` lifts that flag to an all-ones mask of a chosen width. one flag type
# across every width is what lets a comparison at one width drive a select at
# another (`select_u32(eq[u8](x, y), a, b)`) with no conversion at the call site.
# `select_*` takes the flag directly and widens internally.
#
# THE COMPARISONS ARE GENERIC. `is_zero`, `eq`, `lt` and `gt` are one generic
# each over the width, spelled `eq[u32](a, b)` at the call site. an instance is
# the readable unit for auditing emitted code: it is a monomorphic symbol whose
# release lowering is pinned instruction for instruction against the
# hand-written per-width bodies it replaced (x86_64 and aarch64, #660, #839).
# an instance carries `#[oblivious]` exactly as a hand-written function does
# (the lowering sets the flag per instance, so the translation validator
# re-checks every width), and the flow typing checks the body against the
# instance's types, so a secret misuse is refused at the width that asked for
# it. `mask_*`, `select_*` and `lookup_*` are still spelled out per width
# because their bodies differ by the cast they widen through.
#
# > **Experimental preview.** mach's constant-time support is unaudited and has
# > known open holes — see the compiler's `doc/language/secrecy.md`. do not build
# > production cryptography on this version.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;

# lift a secret 0/1 flag to an all-ones 8-bit mask
#
# `0` maps to `0x00` and `1` to `0xFF`. the low bit is taken first, so a flag
# outside {0, 1} selects on its low bit rather than blending the two operands'
# bits together.
# ---
# c:   secret flag, 0 or 1
# ret: 0x00 or 0xFF
#[oblivious]
#[inline]
pub fun mask_u8(c: ^u8) ^u8 {
    val one: ^u8 = c & 1;
    ret 0 - one;
}

# lift a secret 0/1 flag to an all-ones 16-bit mask
#
# THE WIDENING CAST AND THE `& 1` DO DIFFERENT JOBS, stated once for the four
# `mask_*` that widen (u16/u32/u64/usize).
#
# `::^uN` zero-extends: it takes the low 8 bits of the flag and nothing else, so a
# caller's stray high bits cannot reach the subtraction. that is worth naming
# because it was NOT true until briar-systems/mach#2373 — a secret-to-secret `::`
# used to lower to a width-changing `bitcast`, a reinterpret that cleaned nothing,
# and these four were correct only because the `& 1` happened to be emitted at
# machine-register width. they are now correct because the cast converts.
#
# the `& 1` is the flag's normalization, not the cleanup: it reduces a flag outside
# {0, 1} to its low bit, which is what lets `0 - one` be all-ones or all-zeros
# rather than a partial blend. it is load-bearing for that reason alone, and
# dropping it is caught by `ct: mask reads only the flag's low bit`.
#
# `ct: mask_* answer for the value under a dirty flag` pins the pair: the masks must
# answer for the 8-bit VALUE of the flag whatever the register around it holds. a
# caller can still hand over stray high bits — a narrow `0 - x` is not truncated,
# #2357 canonicalized the shift consumers rather than the producers — so this stays
# a live property to guard, not a historical one.
# ---
# c:   secret flag, 0 or 1
# ret: 0x0000 or 0xFFFF
#[oblivious]
#[inline]
pub fun mask_u16(c: ^u8) ^u16 {
    val one: ^u16 = (c & 1)::^u16;
    ret 0 - one;
}

# lift a secret 0/1 flag to an all-ones 32-bit mask
#
# the cast zero-extends; the `& 1` normalizes the flag — see `mask_u16`.
# ---
# c:   secret flag, 0 or 1
# ret: 0x00000000 or 0xFFFFFFFF
#[oblivious]
#[inline]
pub fun mask_u32(c: ^u8) ^u32 {
    val one: ^u32 = (c & 1)::^u32;
    ret 0 - one;
}

# lift a secret 0/1 flag to an all-ones 64-bit mask
#
# the cast zero-extends; the `& 1` normalizes the flag — see `mask_u16`.
# ---
# c:   secret flag, 0 or 1
# ret: 0 or 0xFFFFFFFFFFFFFFFF
#[oblivious]
#[inline]
pub fun mask_u64(c: ^u8) ^u64 {
    val one: ^u64 = (c & 1)::^u64;
    ret 0 - one;
}

# lift a secret 0/1 flag to an all-ones usize mask
#
# the cast zero-extends; the `& 1` normalizes the flag — see `mask_u16`.
# ---
# c:   secret flag, 0 or 1
# ret: 0 or the all-ones usize
#[oblivious]
#[inline]
pub fun mask_usize(c: ^u8) ^usize {
    val one: ^usize = (c & 1)::^usize;
    ret 0 - one;
}

# branchless select between two secret bytes
#
# yields `a` when the flag is 1 and `b` when it is 0, as a bitwise blend under
# the widened mask. both operands are always read, so the choice leaves no trace
# in the control-flow or memory-address stream.
# ---
# cond: secret flag, 0 or 1
# a:    value chosen when the flag is 1
# b:    value chosen when the flag is 0
# ret:  the chosen value
#[oblivious]
#[inline]
pub fun select_u8(cond: ^u8, a: ^u8, b: ^u8) ^u8 {
    val m: ^u8 = mask_u8(cond);
    ret (a & m) | (b & ~m);
}

# branchless select between two secret 16-bit words
# ---
# cond: secret flag, 0 or 1
# a:    value chosen when the flag is 1
# b:    value chosen when the flag is 0
# ret:  the chosen value
#[oblivious]
#[inline]
pub fun select_u16(cond: ^u8, a: ^u16, b: ^u16) ^u16 {
    val m: ^u16 = mask_u16(cond);
    ret (a & m) | (b & ~m);
}

# branchless select between two secret 32-bit words
# ---
# cond: secret flag, 0 or 1
# a:    value chosen when the flag is 1
# b:    value chosen when the flag is 0
# ret:  the chosen value
#[oblivious]
#[inline]
pub fun select_u32(cond: ^u8, a: ^u32, b: ^u32) ^u32 {
    val m: ^u32 = mask_u32(cond);
    ret (a & m) | (b & ~m);
}

# branchless select between two secret 64-bit words
# ---
# cond: secret flag, 0 or 1
# a:    value chosen when the flag is 1
# b:    value chosen when the flag is 0
# ret:  the chosen value
#[oblivious]
#[inline]
pub fun select_u64(cond: ^u8, a: ^u64, b: ^u64) ^u64 {
    val m: ^u64 = mask_u64(cond);
    ret (a & m) | (b & ~m);
}

# branchless select between two secret usize words
# ---
# cond: secret flag, 0 or 1
# a:    value chosen when the flag is 1
# b:    value chosen when the flag is 0
# ret:  the chosen value
#[oblivious]
#[inline]
pub fun select_usize(cond: ^u8, a: ^usize, b: ^usize) ^usize {
    val m: ^usize = mask_usize(cond);
    ret (a & m) | (b & ~m);
}

# branchless test of a secret word against zero
#
# one generic per family, instantiated per width. `#[oblivious]` validates each
# instance's lowering, not the template: the template is never emitted, and the
# instance is what the translation validator re-checks.
# ---
# [T]: unsigned integer width
# a:   value to test
# ret: secret flag, 1 when `a` is zero
#[oblivious]
#[inline]
pub fun is_zero[T](a: ^T) ^u8 {
    ret a == 0;
}

# branchless equality of two secret words
# ---
# [T]: unsigned integer width
# a:   left operand
# b:   right operand
# ret: secret flag, 1 when equal
#[oblivious]
#[inline]
pub fun eq[T](a: ^T, b: ^T) ^u8 {
    ret a == b;
}

# branchless unsigned less-than of two secret words
# ---
# [T]: unsigned integer width
# a:   left operand
# b:   right operand
# ret: secret flag, 1 when `a < b`
#[oblivious]
#[inline]
pub fun lt[T](a: ^T, b: ^T) ^u8 {
    ret a < b;
}

# branchless unsigned greater-than of two secret words
# ---
# [T]: unsigned integer width
# a:   left operand
# b:   right operand
# ret: secret flag, 1 when `a > b`
#[oblivious]
#[inline]
pub fun gt[T](a: ^T, b: ^T) ^u8 {
    ret a > b;
}

# branchless equality of two secret byte buffers
#
# folds every byte of both buffers whatever they hold, so the running time
# depends only on `len`, which is public. the accumulator is the running
# difference: zero exactly when every byte agreed.
# ---
# a:   left buffer
# b:   right buffer
# len: length of both buffers in bytes
# ret: secret flag, 1 when the buffers are equal
#[oblivious]
pub fun eq_bytes(a: *^u8, b: *^u8, len: usize) ^u8 {
    var d: ^u8   = 0;
    var i: usize = 0;
    for (i < len) {
        d = d | (a[i] ^ b[i]);
        i = i + 1;
    }
    ret is_zero[u8](d);
}

# read a secret-indexed byte without a secret memory address
#
# scans the whole table and merges the element whose public position matches the
# secret index, so the address trace is the same for every index — that is what
# replaces `table[idx]`, which sema rejects. cost is linear in `len`.
#
# an index at or beyond `len` matches nothing and yields 0. that is the defined
# result of the scan, not a bounds check: no comparison against `len` reaches
# the control flow, so an out-of-range index costs exactly what an in-range one
# does.
# ---
# table: base of the table
# len:   number of elements, public
# idx:   secret element index
# ret:   the selected element, or 0 if the index is out of range
#[oblivious]
pub fun lookup_u8(table: *^u8, len: usize, idx: ^usize) ^u8 {
    var acc: ^u8   = 0;
    var i:   usize = 0;
    for (i < len) {
        acc = acc | (table[i] & mask_u8(eq[usize](i, idx)));
        i   = i + 1;
    }
    ret acc;
}

# read a secret-indexed 32-bit word without a secret memory address
# ---
# table: base of the table
# len:   number of elements, public
# idx:   secret element index
# ret:   the selected element, or 0 if the index is out of range
#[oblivious]
pub fun lookup_u32(table: *^u32, len: usize, idx: ^usize) ^u32 {
    var acc: ^u32  = 0;
    var i:   usize = 0;
    for (i < len) {
        acc = acc | (table[i] & mask_u32(eq[usize](i, idx)));
        i   = i + 1;
    }
    ret acc;
}

# read a secret-indexed 64-bit word without a secret memory address
# ---
# table: base of the table
# len:   number of elements, public
# idx:   secret element index
# ret:   the selected element, or 0 if the index is out of range
#[oblivious]
pub fun lookup_u64(table: *^u64, len: usize, idx: ^usize) ^u64 {
    var acc: ^u64  = 0;
    var i:   usize = 0;
    for (i < len) {
        acc = acc | (table[i] & mask_u64(eq[usize](i, idx)));
        i   = i + 1;
    }
    ret acc;
}

# wipe secret memory
#
# a zeroing loop over storage that is never read again is dead by every ordinary
# rule, and an optimizer may delete it — leaving key material in memory behind
# code that reads as if it had been erased.
#
# WHAT ACTUALLY HOLDS THIS UP TODAY, stated honestly because the difference
# matters if it ever changes. two things, and the decorator is not yet one of
# them:
#
#   * `p` is the caller's pointer, so these stores escape this function. no
#     dead-store analysis can call them dead, under any pipeline.
#   * mach has no store-eliminating pass at all right now — its DCE removes only
#     pure unused value ops, never a store, memzero, or call. verified at
#     `--profile release`: an entirely dead 32-byte fill of a PUBLIC local
#     survives untouched.
#
# so `#[oblivious]`'s "no dead-store elimination of a zeroizing write" clause is
# real but currently vacuous — there is no elimination for it to subtract. the
# decorator is on this function so the obligation binds the day that changes;
# the lowered MIR already carries the `writes_secret` seed a future pass must
# consult. do not read the clause as covering a secret in a REGISTER: a
# register-promoted `var x: ^u8 = k; x = 0;` is removed by ordinary DCE with or
# without the decorator, which is outside the epic's memory-address leakage
# model. this wipes memory.
# ---
# p: base of the region to wipe
# n: number of bytes
#[oblivious]
pub fun zeroize(p: *^u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        p[i] = 0;
        i    = i + 1;
    }
}

# engage the hardware data-independent-timing mode, if the target has one
#
# the timing guarantee the type system enforces is about the instructions
# emitted; whether a given instruction's latency is data-independent is the
# silicon's business. some architectures expose a mode that promises it, and
# this is where a caller asks for it around secret work.
#
# NO TARGET CAN ENGAGE IT TODAY, and the return value says so rather than a
# comment claiming otherwise:
#
#   * aarch64 — `PSTATE.DIT` is settable from user code by `msr DIT, #1`, but
#     `msr` is not in mach's aarch64 inline-asm instruction set, so the
#     instruction cannot be reached from mach source (briar-systems/mach#2352).
#     this is the one arch where the mode is real and merely unreachable.
#   * x86_64 — DOITM lives in the `IA32_UARCH_MISC_CTL` MSR, writable only at
#     ring 0. no user-mode program sets it on any OS; it is the kernel's to
#     configure.
#   * riscv64 — the Zkt extension states data-independent latency for its
#     instruction list as an architectural property. there is no mode bit,
#     so there is nothing to engage.
#
# callers should bracket secret work with `begin`/`end` regardless: the call
# sites are what make the aarch64 path a one-function change later.
# ---
# ret: whether a hardware data-independent-timing mode was engaged
pub fun begin() bool {
    ret false;
}

# release the hardware data-independent-timing mode engaged by `begin`
#
# a no-op wherever `begin` engaged nothing, which is every target today. see
# `begin` for the per-architecture reasons.
pub fun end() {}

test "ct: mask lifts a flag to all-ones at every width" {
    if (mask_u8(0):>u8 != 0x00)                 { ret 1; }
    if (mask_u8(1):>u8 != 0xFF)                 { ret 1; }
    if (mask_u16(0):>u16 != 0x0000)             { ret 1; }
    if (mask_u16(1):>u16 != 0xFFFF)             { ret 1; }
    if (mask_u32(0):>u32 != 0x00000000)         { ret 1; }
    if (mask_u32(1):>u32 != 0xFFFFFFFF)         { ret 1; }
    if (mask_u64(0):>u64 != 0)                  { ret 1; }
    if (mask_u64(1):>u64 != 0xFFFFFFFFFFFFFFFF) { ret 1; }
    ret 0;
}

test "ct: mask reads only the flag's low bit" {
    if (mask_u8(2):>u8 != 0x00)            { ret 1; }
    if (mask_u8(3):>u8 != 0xFF)            { ret 1; }
    if (mask_u32(0xFE):>u32 != 0x00000000) { ret 1; }
    if (mask_u32(0xFF):>u32 != 0xFFFFFFFF) { ret 1; }
    ret 0;
}

test "ct: select picks the flagged operand" {
    if (select_u8(1, 0xA5, 0x5A):>u8 != 0xA5)                                             { ret 1; }
    if (select_u8(0, 0xA5, 0x5A):>u8 != 0x5A)                                             { ret 1; }
    if (select_u16(1, 0xBEEF, 0xDEAD):>u16 != 0xBEEF)                                     { ret 1; }
    if (select_u16(0, 0xBEEF, 0xDEAD):>u16 != 0xDEAD)                                     { ret 1; }
    if (select_u32(1, 0xAAAAAAAA, 0x55555555):>u32 != 0xAAAAAAAA)                         { ret 1; }
    if (select_u32(0, 0xAAAAAAAA, 0x55555555):>u32 != 0x55555555)                         { ret 1; }
    if (select_u64(1, 0x0123456789ABCDEF, 0xFEDCBA9876543210):>u64 != 0x0123456789ABCDEF) { ret 1; }
    if (select_u64(0, 0x0123456789ABCDEF, 0xFEDCBA9876543210):>u64 != 0xFEDCBA9876543210) { ret 1; }
    if (select_usize(1, 12345, 67890):>usize != 12345)                                    { ret 1; }
    if (select_usize(0, 12345, 67890):>usize != 67890)                                    { ret 1; }
    ret 0;
}

test "ct: is_zero at the width boundaries" {
    if (is_zero[u8](0):>u8 != 1)                   { ret 1; }
    if (is_zero[u8](1):>u8 != 0)                   { ret 1; }
    if (is_zero[u8](0x80):>u8 != 0)                { ret 1; }
    if (is_zero[u8](0xFF):>u8 != 0)                { ret 1; }
    if (is_zero[u16](0):>u8 != 1)                  { ret 1; }
    if (is_zero[u16](0x8000):>u8 != 0)             { ret 1; }
    if (is_zero[u16](0xFFFF):>u8 != 0)             { ret 1; }
    if (is_zero[u32](0):>u8 != 1)                  { ret 1; }
    if (is_zero[u32](0x80000000):>u8 != 0)         { ret 1; }
    if (is_zero[u32](0xFFFFFFFF):>u8 != 0)         { ret 1; }
    if (is_zero[u64](0):>u8 != 1)                  { ret 1; }
    if (is_zero[u64](0x8000000000000000):>u8 != 0) { ret 1; }
    if (is_zero[u64](0xFFFFFFFFFFFFFFFF):>u8 != 0) { ret 1; }
    if (is_zero[usize](0):>u8 != 1)                { ret 1; }
    if (is_zero[usize](1):>u8 != 0)                { ret 1; }
    ret 0;
}

test "ct: eq against known vectors" {
    if (eq[u8](0x7F, 0x7F):>u8 != 1)                              { ret 1; }
    if (eq[u8](0x7F, 0xFF):>u8 != 0)                              { ret 1; }
    if (eq[u8](0x00, 0x80):>u8 != 0)                              { ret 1; }
    if (eq[u16](0xBEEF, 0xBEEF):>u8 != 1)                         { ret 1; }
    if (eq[u16](0xBEEF, 0xBEEE):>u8 != 0)                         { ret 1; }
    if (eq[u32](0xDEADBEEF, 0xDEADBEEF):>u8 != 1)                 { ret 1; }
    if (eq[u32](0xDEADBEEF, 0x5EADBEEF):>u8 != 0)                 { ret 1; }
    if (eq[u64](0x0123456789ABCDEF, 0x0123456789ABCDEF):>u8 != 1) { ret 1; }
    if (eq[u64](0x0123456789ABCDEF, 0x0123456789ABCDEE):>u8 != 0) { ret 1; }
    if (eq[usize](4096, 4096):>u8 != 1)                           { ret 1; }
    if (eq[usize](4096, 4097):>u8 != 0)                           { ret 1; }
    ret 0;
}

test "ct: unsigned lt and gt against known vectors" {
    if (lt[u8](0x00, 0x01):>u8 != 1)                              { ret 1; }
    if (lt[u8](0x01, 0x00):>u8 != 0)                              { ret 1; }
    if (lt[u8](0x7F, 0x80):>u8 != 1)                              { ret 1; }
    if (lt[u8](0x80, 0x7F):>u8 != 0)                              { ret 1; }
    if (lt[u8](0xFF, 0xFF):>u8 != 0)                              { ret 1; }
    if (lt[u8](0x00, 0xFF):>u8 != 1)                              { ret 1; }
    if (gt[u8](0xFF, 0x00):>u8 != 1)                              { ret 1; }
    if (gt[u8](0x00, 0xFF):>u8 != 0)                              { ret 1; }
    if (lt[u16](0x7FFF, 0x8000):>u8 != 1)                         { ret 1; }
    if (lt[u16](0x8000, 0x7FFF):>u8 != 0)                         { ret 1; }
    if (lt[u32](0x7FFFFFFF, 0x80000000):>u8 != 1)                 { ret 1; }
    if (lt[u32](0x80000000, 0x7FFFFFFF):>u8 != 0)                 { ret 1; }
    if (lt[u32](0xFFFFFFFF, 0x00000000):>u8 != 0)                 { ret 1; }
    if (lt[u64](0x7FFFFFFFFFFFFFFF, 0x8000000000000000):>u8 != 1) { ret 1; }
    if (lt[u64](0x8000000000000000, 0x7FFFFFFFFFFFFFFF):>u8 != 0) { ret 1; }
    if (lt[u64](0xFFFFFFFFFFFFFFFF, 0x0000000000000001):>u8 != 0) { ret 1; }
    if (lt[usize](0, 1):>u8 != 1)                                 { ret 1; }
    if (gt[usize](1, 0):>u8 != 1)                                 { ret 1; }
    ret 0;
}

test "ct: u8 comparisons agree with the operators over every pair" {
    var a: usize = 0;
    for (a < 256) {
        var b: usize = 0;
        for (b < 256) {
            val sa: ^u8 = a::u8;
            val sb: ^u8 = b::u8;

            var want: u8 = 0;
            if (a == b)                     { want = 1; }
            if (eq[u8](sa, sb):>u8 != want) { ret 1; }

            want = 0;
            if (a < b)                      { want = 1; }
            if (lt[u8](sa, sb):>u8 != want) { ret 1; }

            want = 0;
            if (a > b)                      { want = 1; }
            if (gt[u8](sa, sb):>u8 != want) { ret 1; }

            want = 0;
            if (a == b)                                      { want = 1; }
            if (select_u8(eq[u8](sa, sb), 1, 0):>u8 != want) { ret 1; }

            b = b + 1;
        }
        a = a + 1;
    }
    ret 0;
}

test "ct: the comparisons at 16, 64 and usize widths" {
    val a16: ^u16 = 0x0100;
    val b16: ^u16 = 0x00FF;
    if (lt[u16](a16, b16):>u8 != 0) { ret 1; }
    if (gt[u16](a16, b16):>u8 != 1) { ret 1; }
    if (eq[u16](a16, a16):>u8 != 1) { ret 1; }
    if (eq[u16](a16, b16):>u8 != 0) { ret 1; }
    val z16: ^u16 = 0;
    if (is_zero[u16](z16):>u8 != 1) { ret 1; }
    if (is_zero[u16](b16):>u8 != 0) { ret 1; }

    val a64: ^u64 = 0xFFFFFFFFFFFFFFFF;
    val b64: ^u64 = 1;
    if (lt[u64](b64, a64):>u8 != 1) { ret 1; }
    if (gt[u64](b64, a64):>u8 != 0) { ret 1; }
    if (eq[u64](a64, b64):>u8 != 0) { ret 1; }
    if (is_zero[u64](b64):>u8 != 0) { ret 1; }

    val z: ^usize = 0;
    if (is_zero[usize](z):>u8 != 1) { ret 1; }
    if (eq[usize](z, z):>u8 != 1)   { ret 1; }
    ret 0;
}

test "ct: u64 comparisons agree with the operators over a fixed sweep" {
    # a deterministic xorshift walk, so the vectors are fixed and reproducible
    var x: u64   = 0x243F6A8885A308D3;
    var n: usize = 0;
    for (n < 4096) {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        val y: u64 = x ^ 0x452821E638D01377;

        # every fourth pair is forced equal, so the equal case is exercised too
        var b: u64 = y;
        if (n % 4 == 0) { b = x; }

        val sa: ^u64 = x;
        val sb: ^u64 = b;

        var want: u8 = 0;
        if (x == b)                      { want = 1; }
        if (eq[u64](sa, sb):>u8 != want) { ret 1; }

        want = 0;
        if (x < b)                       { want = 1; }
        if (lt[u64](sa, sb):>u8 != want) { ret 1; }

        want = 0;
        if (x > b)                       { want = 1; }
        if (gt[u64](sa, sb):>u8 != want) { ret 1; }

        n = n + 1;
    }
    ret 0;
}

test "ct: eq_bytes over known buffers" {
    var a: [8]^u8 = [8]^u8{1, 2, 3, 4, 5, 6, 7, 8};
    var b: [8]^u8 = [8]^u8{1, 2, 3, 4, 5, 6, 7, 8};
    if (eq_bytes(?a[0], ?b[0], 8):>u8 != 1) { ret 1; }

    b[0] = 0xFF;
    if (eq_bytes(?a[0], ?b[0], 8):>u8 != 0) { ret 1; }

    b[0] = 1;
    b[7] = 0xFF;
    if (eq_bytes(?a[0], ?b[0], 8):>u8 != 0) { ret 1; }

    # a shorter comparison stops before the differing byte
    if (eq_bytes(?a[0], ?b[0], 7):>u8 != 1) { ret 1; }

    # a zero-length comparison is vacuously equal
    if (eq_bytes(?a[0], ?b[0], 0):>u8 != 1) { ret 1; }
    ret 0;
}

test "ct: lookup returns the secret-indexed element" {
    var t:    [8]^u8 = [8]^u8{0x10, 0x21, 0x32, 0x43, 0x54, 0x65, 0x76, 0x87};
    val want: [8]u8  = [8]u8{0x10, 0x21, 0x32, 0x43, 0x54, 0x65, 0x76, 0x87};
    var i:    usize  = 0;
    for (i < 8) {
        val idx: ^usize = i;
        if (lookup_u8(?t[0], 8, idx):>u8 != want[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "ct: lookup yields zero past the end of the table" {
    var t:    [4]^u8 = [4]^u8{0xAA, 0xBB, 0xCC, 0xDD};
    val at4:  ^usize = 4;
    val huge: ^usize = 0xFFFFFFFF;
    if (lookup_u8(?t[0], 4, at4):>u8 != 0)  { ret 1; }
    if (lookup_u8(?t[0], 4, huge):>u8 != 0) { ret 1; }

    # a shortened length hides the tail from the scan
    val at3: ^usize = 3;
    if (lookup_u8(?t[0], 3, at3):>u8 != 0) { ret 1; }
    ret 0;
}

test "ct: lookup at 32 and 64 bits" {
    var t32: [4]^u32 = [4]^u32{0xDEADBEEF, 0xFEEDFACE, 0x0BADC0DE, 0x8BADF00D};
    val i2:  ^usize  = 2;
    if (lookup_u32(?t32[0], 4, i2):>u32 != 0x0BADC0DE) { ret 1; }

    var t64: [3]^u64 = [3]^u64{0x0123456789ABCDEF, 0xFEDCBA9876543210, 0x5555555555555555};
    val i1:  ^usize  = 1;
    if (lookup_u64(?t64[0], 3, i1):>u64 != 0xFEDCBA9876543210) { ret 1; }

    val i9: ^usize = 9;
    if (lookup_u64(?t64[0], 3, i9):>u64 != 0) { ret 1; }
    ret 0;
}

test "ct: zeroize wipes exactly the requested span" {
    var buf: [8]^u8 = [8]^u8{0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA};
    zeroize(?buf[0], 4);
    var i: usize = 0;
    for (i < 4) {
        if (buf[i]:>u8 != 0) { ret 1; }
        i = i + 1;
    }
    for (i < 8) {
        if (buf[i]:>u8 != 0xAA) { ret 1; }
        i = i + 1;
    }

    zeroize(?buf[0], 8);
    i = 0;
    for (i < 8) {
        if (buf[i]:>u8 != 0) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "ct: zeroize of a zero-length span touches nothing" {
    var buf: [2]^u8 = [2]^u8{0x11, 0x22};
    zeroize(?buf[0], 0);
    if (buf[0]:>u8 != 0x11) { ret 1; }
    if (buf[1]:>u8 != 0x22) { ret 1; }
    ret 0;
}

test "ct: mask_* answer for the value under a dirty flag" {
    # GUARDS AN UNSTATED BACKEND PROPERTY. the widening in mask_u16/u32/u64/usize is
    # a `bitcast`, not a zext (briar-systems/mach#2373), so it cleans nothing; what
    # makes those four correct is that the preceding `& 1` is emitted at
    # machine-register width and clears the high bits. nothing in this repo can
    # state that, and nothing in the compiler promises it — a narrow ALU op emitted
    # at its declared width would break it silently while this source stays the same.
    #
    # so: hand the masks a flag whose high bits ARE stray and check the answer.
    # `mask_u8(1)` produces one by construction — it returns `0 - one`, and a narrow
    # subtraction is not truncated, so the byte 0xFF arrives in a register holding
    # 0xFFFFFFFF. if the high bits ever reach the subtract, the mask comes back
    # 0x000000FF instead of all-ones and these fail.
    val dirty: ^u8 = mask_u8(1);

    if (mask_u8(dirty):>u8 != 0xFF)                 { ret 1; }
    if (mask_u16(dirty):>u16 != 0xFFFF)             { ret 1; }
    if (mask_u32(dirty):>u32 != 0xFFFFFFFF)         { ret 1; }
    if (mask_u64(dirty):>u64 != 0xFFFFFFFFFFFFFFFF) { ret 1; }

    # and the consumers, which is where a wrong mask would actually do damage
    if (select_u16(dirty, 0xBEEF, 0xDEAD):>u16 != 0xBEEF)                                     { ret 1; }
    if (select_u32(dirty, 0xAAAAAAAA, 0x55555555):>u32 != 0xAAAAAAAA)                         { ret 1; }
    if (select_u64(dirty, 0x0123456789ABCDEF, 0xFEDCBA9876543210):>u64 != 0x0123456789ABCDEF) { ret 1; }
    ret 0;
}

test "ct: comparisons answer for the value, not for stray high bits" {
    # a narrow arithmetic result still carries stray high bits, and `mask_*` produces
    # one by construction: briar-systems/mach#2357 canonicalized the SHIFT consumers,
    # not the producers, so `0 - x` at u8 still leaves a full 32-bit register
    # (`sub eax, edi`, no truncation). the comparisons must answer for the 8-bit
    # VALUE, which is what the operators' operand zero-extension buys.
    #
    # WHAT THIS CATCHES, checked by mutation against a post-#2357 compiler: writing
    # these over an explicit `::^u32` widening instead of the operators. a
    # secret-to-secret cast lowers to a bitcast rather than a zext
    # (briar-systems/mach#2373), so the stray bits survive into the wider
    # computation and the answer is wrong. that form fails this test.
    #
    # WHAT IT NO LONGER CATCHES: the older masked-shift form. #2357 fixed the
    # truncation that form depended on, so it now passes. this test is not a guard
    # against it, and should not be cited as one.
    val neg: ^u8 = mask_u8(1);
    if (is_zero[u8](neg):>u8 != 0)  { ret 1; }
    if (eq[u8](neg, 0xFF):>u8 != 1) { ret 1; }
    if (lt[u8](neg, 0xFF):>u8 != 0) { ret 1; }
    if (gt[u8](neg, 0xFE):>u8 != 1) { ret 1; }

    val big: ^u16 = mask_u16(1);
    if (is_zero[u16](big):>u8 != 0)    { ret 1; }
    if (eq[u16](big, 0xFFFF):>u8 != 1) { ret 1; }
    ret 0;
}

test "ct: no target engages a data-independent-timing mode yet" {
    if (begin()) { ret 1; }
    end();
    ret 0;
}
