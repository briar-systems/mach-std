# cryptographic random number generation
#
# fills buffers with random bytes from the OS entropy source.

use io_error: std.io.error;
use std.system.capability;
use std.types.bool.bool;
use std.types.error.err;
use std.types.size.usize;

$if (capability.HAS_ENTROPY) {
    use std.system.os;
}
$or {
    $error("std.crypto.rand needs the entropy capability (std.system.capability.HAS_ENTROPY)");
}

# fill a buffer with cryptographic random bytes
#
# the entropy source is read until len bytes are written. on failure the
# bytes written before the refusal stay in buf (the completed prefix is
# observable) and the error carries the native code under OP_READ.
# ---
# buf: destination buffer
# len: number of bytes to fill
# ret: ok, or the entropy source's refusal
pub fun fill(buf: *u8, len: usize) err[io_error.Error] {
    val code: i64 = os.random_fill(buf, len);
    if (code < 0) { ret err[io_error.Error].err{os.error(code, io_error.OP_READ)}; }
    ret err[io_error.Error].ok{};
}

# return a random 64-bit unsigned integer
#
# aborts if the OS entropy source fails.
# ---
# ret: random value
pub fun u64() u64 {
    var v:      u64                 = 0;
    val filled: err[io_error.Error] = fill((?v)::*u8, 8);
    if (sel filled.err) { os.abort(); }
    ret v;
}

# return a random 32-bit unsigned integer
#
# aborts if the OS entropy source fails.
# ---
# ret: random value
pub fun u32() u32 {
    var v:      u32                 = 0;
    val filled: err[io_error.Error] = fill((?v)::*u8, 4);
    if (sel filled.err) { os.abort(); }
    ret v;
}

test fill__populates_buffer_with_non_zero_data {
    var buf: [32]u8;
    var i:   usize = 0;
    for (i < 32) {
        buf[i] = 0;
        i      = i + 1;
    }
    val filled: err[io_error.Error] = fill(?buf[0], 32);
    if (sel filled.err) { ret 1; }
    var all_zero: u8 = 1;
    i = 0;
    for (i < 32) {
        if (buf[i] != 0) { all_zero = 0; }
        i = i + 1;
    }
    if (all_zero != 0) { ret 1; }
    ret 0;
}

test fill__zero_length_succeeds {
    var buf:    [1]u8;
    val filled: err[io_error.Error] = fill(?buf[0], 0);
    if (!sel filled.ok) { ret 1; }
    ret 0;
}

test fill__a_nil_destination_is_refused_with_the_native_code {
    val filled: err[io_error.Error] = fill(nil, 1);
    if (!sel filled.err)                                   { ret 1; }
    if (filled.err.code >= 0)                              { ret 2; }
    if (filled.err.kind != os.error_kind(filled.err.code)) { ret 3; }
    if (filled.err.operation != io_error.OP_READ)          { ret 4; }
    ret 0;
}

test u64__two_calls_return_different_values {
    val a: u64 = u64();
    val b: u64 = u64();
    if (a == b) { ret 1; }
    ret 0;
}

test u32__returns_a_value {
    val v: u32 = u32();
    val w: u32 = u32();
    if (v == w) { ret 1; }
    ret 0;
}
