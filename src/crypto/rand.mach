# cryptographic random number generation
#
# fills buffers with random bytes from the OS entropy source: public storage
# through fill, and secret-welded storage through fill_secret, whose bytes
# never pass through public memory.

use std.crypto.ct;
use io_error: std.io.error;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.size.usize;

$if (capability.HAS_ENTROPY) {
    use std.system.os;
}
$or {
    $error("std.crypto.rand needs the entropy capability (std.system.capability.HAS_ENTROPY)");
}

# fill a buffer with cryptographic random bytes
#
# the entropy source is read until len bytes are written. on failure the
# bytes written before the refusal stay in buf (the completed prefix is
# observable) and the error carries the native code under OP_READ.
# ---
# buf: destination buffer
# len: number of bytes to fill
# ret: ok, or the entropy source's refusal
pub fun fill(buf: *u8, len: usize) err[io_error.Error] {
    val code: i64 = os.random_fill(buf, len);
    if (code < 0) { ret err[io_error.Error].err{os.error(code, io_error.OP_READ)}; }
    ret err[io_error.Error].ok{};
}

val INTERRUPT_MAX_RETRIES: usize = 8;

# providers return a count or a negative native code
def FillFun: fun(ptr, *^u8, usize) i64;

fun refused(kind: io_error.Kind, operation: io_error.Operation) err[io_error.Error] {
    ret err[io_error.Error].err{io_error.make(kind, operation)};
}

fun native(code: i64, operation: io_error.Operation) err[io_error.Error] {
    ret err[io_error.Error].err{os.error(code, operation)};
}

fun interrupted(code: i64) bool {
    ret code < 0 && os.error_kind(code) == io_error.INTERRUPTED;
}

fun fill_all(context: ptr, data: *^u8, len: usize, max_chunk: usize,
    fill_fn: FillFun) err[io_error.Error] {
    if (len == 0)    { ret err[io_error.Error].ok{}; }
    if (data == nil) { ret refused(io_error.INVALID, io_error.OP_READ); }
    if (max_chunk == 0) {
        ct.zeroize(data, len);
        ret refused(io_error.INVALID, io_error.OP_READ);
    }

    var filled:        usize = 0;
    var interruptions: usize = 0;
    for (filled < len) {
        var chunk: usize = len - filled;
        if (chunk > max_chunk) { chunk = max_chunk; }
        val count: i64 = fill_fn(context, ?data[filled], chunk);
        if (interrupted(count)) {
            interruptions = interruptions + 1;
            if (interruptions >= INTERRUPT_MAX_RETRIES) {
                ct.zeroize(data, len);
                ret native(count, io_error.OP_READ);
            }
        }
        or {
            if (count < 0) {
                ct.zeroize(data, len);
                ret native(count, io_error.OP_READ);
            }
            if (count == 0 || count::usize > chunk) {
                ct.zeroize(data, len);
                ret refused(io_error.IO, io_error.OP_READ);
            }
            filled        = filled + count::usize;
            interruptions = 0;
        }
    }
    ret err[io_error.Error].ok{};
}

fun native_fill(context: ptr, data: *^u8, len: usize) i64 {
    ret os.random_fill_secret(data, len);
}

# initialize every requested byte of secret-welded storage from the entropy
# source
#
# the source is read in the chunks one native call accepts, a short read is
# continued, and an interrupted call is retried within a budget that progress
# resets. the bytes are never seen outside the welded storage
# ---
# data: destination secret storage
# len:  number of bytes to initialize
# ret:  ok after complete initialization, or the error after a complete wipe:
#       INVALID for a nil data, IO for a source that delivers nothing or more
#       than it was asked, otherwise the native refusal
pub fun fill_secret(data: *^u8, len: usize) err[io_error.Error] {
    ret fill_all(nil, data, len, os.RANDOM_FILL_SECRET_MAX, native_fill);
}

# return a random 64-bit unsigned integer
#
# aborts if the OS entropy source fails.
# ---
# ret: random value
pub fun u64() u64 {
    var v:          u64                 = 0;
    val err_filled: err[io_error.Error] = fill((?v)::*u8, 8);
    if (sel err_filled.err) { os.abort(); }
    ret v;
}

# return a random 32-bit unsigned integer
#
# aborts if the OS entropy source fails.
# ---
# ret: random value
pub fun u32() u32 {
    var v:          u32                 = 0;
    val err_filled: err[io_error.Error] = fill((?v)::*u8, 4);
    if (sel err_filled.err) { os.abort(); }
    ret v;
}

test fill__populates_the_buffer {
    var buf: [32]u8;
    var i:   usize = 0;
    for (i < 32) {
        buf[i] = 0;
        i      = i + 1;
    }
    val err_filled: err[io_error.Error] = fill(?buf[0], 32);
    if (sel err_filled.err) { ret 1; }
    var all_zero: u8 = 1;
    i = 0;
    for (i < 32) {
        if (buf[i] != 0) { all_zero = 0; }
        i = i + 1;
    }
    if (all_zero != 0) { ret 2; }
    val err_empty: err[io_error.Error] = fill(?buf[0], 0);
    if (!sel err_empty.ok) { ret 3; }
    ret 0;
}

$if ($mach.build.sys == $mach.sys.linux) {
    use native_os: std.system.os.linux;
}
$or ($mach.build.sys == $mach.sys.darwin) {
    use native_os: std.system.os.darwin;
}
$or ($mach.build.sys == $mach.sys.windows) {
    use native_os: std.system.os.windows;
}
$or ($mach.build.sys == $mach.sys.wasi) {
    use native_os: std.system.os.wasi;
}

# generic fixtures instantiate only in test builds
#[testing]
fun is_ok[T](result: err[io_error.Error]) bool {
    ret sel result.ok;
}

#[testing]
fun refused_as[T](result: err[io_error.Error], kind: io_error.Kind) bool {
    if (sel result.err) { ret result.err.kind == kind && result.err.code == 0; }
    ret false;
}

#[testing]
fun failed_natively[T](result: err[io_error.Error], code: i64) bool {
    ret sel result.err && result.err.code == code;
}

#[testing]
fun all_zero[T](data: *^u8, len: usize) i64 {
    var i: usize = 0;
    for (i < len) {
        if (data[i]:>u8 != 0) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

#[testing]
rec FillScript {
    results: [4]i64;
    len:     usize;
    next:    usize;
    byte:    u8;
}

#[testing]
fun scripted_fill[T](context: ptr, data: *^u8, len: usize) i64 {
    val script: *FillScript = context::*FillScript;
    if (script.next >= script.len) { ret native_os.EIO; }
    val result: i64 = script.results[script.next];
    script.next = script.next + 1;
    if (result > 0) {
        var count: usize = result::usize;
        if (count > len) { count = len; }
        var i: usize = 0;
        for (i < count) {
            data[i] = script.byte;
            i       = i + 1;
        }
    }
    ret result;
}

#[testing]
rec InterruptProbe {
    calls: usize;
    byte:  u8;
}

#[testing]
fun reset_probe_fill[T](context: ptr, data: *^u8, len: usize) i64 {
    val probe: *InterruptProbe = context::*InterruptProbe;
    probe.calls = probe.calls + 1;
    if (probe.calls == INTERRUPT_MAX_RETRIES ||
        probe.calls == INTERRUPT_MAX_RETRIES * 2) {
        data[0] = probe.byte;
        ret 1;
    }
    ret native_os.EINTR;
}

#[testing]
fun interrupted_fill[T](context: ptr, data: *^u8, len: usize) i64 {
    val probe: *InterruptProbe = context::*InterruptProbe;
    probe.calls = probe.calls + 1;
    ret native_os.EINTR;
}

# nil and empty requests are guarded, and a fill larger than one native chunk
# is delivered in full through the chunking the native bound imposes
test fill_secret__guards_and_multi_chunk_fill {
    var data: [700]^u8;
    if (!is_ok[u8](fill_secret(nil, 0)))                        { ret 1; }
    if (!refused_as[u8](fill_secret(nil, 1), io_error.INVALID)) { ret 2; }
    if (!is_ok[u8](fill_secret(?data[0], 700)))                 { ret 3; }
    var nonzero: usize = 0;
    var i:       usize = 0;
    for (i < 700) {
        if (data[i]:>u8 != 0) { nonzero = nonzero + 1; }
        i = i + 1;
    }
    if (nonzero < 350) { ret 4; }
    ret 0;
}

test fill_secret__retries_partial_and_interrupted_providers {
    var data:   [4]^u8     = [4]^u8{0, 0, 0, 0};
    var script: FillScript = FillScript{
        results: [4]i64{native_os.EINTR, 2, 2, 0}, len: 3, next: 0, byte: 0xA5,
    };
    if (!is_ok[u8](fill_all(?script, ?data[0], 4, 4, scripted_fill[u8]))) { ret 1; }
    if (script.next != 3)                                                 { ret 1; }
    var i: usize = 0;
    for (i < 4) {
        if (data[i]:>u8 != 0xA5) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# progress resets the interruption budget, and a provider that only ever
# interrupts is cut off at the budget with the destination wiped
test fill_secret__interruption_budget_resets_on_progress_and_bounds_stalls {
    var data:  [2]^u8         = [2]^u8{0, 0};
    var probe: InterruptProbe = InterruptProbe{calls: 0, byte: 0xA5};
    if (!is_ok[u8](fill_all(?probe, ?data[0], 2, 2, reset_probe_fill[u8]))) { ret 1; }
    if (probe.calls != INTERRUPT_MAX_RETRIES * 2)                           { ret 2; }
    if (data[0]:>u8 != 0xA5 || data[1]:>u8 != 0xA5)                         { ret 3; }

    var wiped:         [4]^u8              = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var stalled:       InterruptProbe      = InterruptProbe{calls: 0, byte: 0};
    val err_exhausted: err[io_error.Error] = fill_all(?stalled, ?wiped[0], 4, 4, interrupted_fill[u8]);
    if (!failed_natively[u8](err_exhausted, native_os.EINTR))                    { ret 4; }
    if (sel err_exhausted.err && err_exhausted.err.kind != io_error.INTERRUPTED) { ret 5; }
    if (stalled.calls != INTERRUPT_MAX_RETRIES)                                  { ret 6; }
    if (all_zero[u8](?wiped[0], 4) == 0)                                         { ret 7; }
    ret 0;
}

test fill_secret__failures_wipe_the_complete_destination {
    var data:   [4]^u8     = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var failed: FillScript = FillScript{
        results: [4]i64{2, native_os.EIO, 0, 0}, len: 2, next: 0, byte: 0x5A,
    };
    if (!failed_natively[u8](fill_all(?failed, ?data[0], 4, 4, scripted_fill[u8]), native_os.EIO) ||
        all_zero[u8](?data[0], 4) == 0) { ret 1; }

    data = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var stalled: FillScript = FillScript{
        results: [4]i64{0, 0, 0, 0}, len: 1, next: 0, byte: 0x5A,
    };
    if (!refused_as[u8](fill_all(?stalled, ?data[0], 4, 4, scripted_fill[u8]), io_error.IO) ||
        all_zero[u8](?data[0], 4) == 0) { ret 1; }

    data = [4]^u8{0xA5, 0xA5, 0xA5, 0xA5};
    var oversized: FillScript = FillScript{
        results: [4]i64{5, 0, 0, 0}, len: 1, next: 0, byte: 0x5A,
    };
    if (!refused_as[u8](fill_all(?oversized, ?data[0], 4, 4, scripted_fill[u8]), io_error.IO) ||
        all_zero[u8](?data[0], 4) == 0) { ret 1; }
    ret 0;
}
