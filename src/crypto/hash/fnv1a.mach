# incremental FNV-1a hashing
#
# the type interners hash composite records field-by-field rather than over a
# contiguous byte buffer, so they need an incremental folding API. this mirrors
# the byte-wise FNV-1a used by the stdlib map's `hash_str`, exposed as the
# `FNV_INIT` seed constant plus per-value `step_*` folds. `step_bytes` folds a
# whole buffer, so hashing a string is `step_bytes(FNV_INIT, s, str_len(s))`.

use std.types.size.usize;

# FNV-1a 64-bit prime
pub val FNV_PRIME: u64 = 1099511628211;
# FNV-1a 64-bit offset basis
pub val FNV_OFFSET: u64 = 14695981039346656037;
pub val FNV_INIT:   u64 = FNV_OFFSET;

# fold one byte into the running hash
# ---
# h:   running hash
# v:   byte to fold in
# ret: updated hash
pub fun step_u8(h: u64, v: u8) u64 {
    var x: u64 = h ^ v::u64;
    x = x * FNV_PRIME;
    ret x;
}

# fold a 32-bit value into the running hash, byte by byte (little-endian)
# ---
# h:   running hash
# v:   value to fold in
# ret: updated hash
pub fun step_u32(h: u64, v: u32) u64 {
    var x: u64 = h;
    x = step_u8(x, (v & 0xFF)::u8);
    x = step_u8(x, ((v >> 8) & 0xFF)::u8);
    x = step_u8(x, ((v >> 16) & 0xFF)::u8);
    x = step_u8(x, ((v >> 24) & 0xFF)::u8);
    ret x;
}

# fold a run of bytes into the running hash, in order
# ---
# h:   running hash
# p:   bytes to fold in; may be nil when n is 0
# n:   number of bytes
# ret: updated hash
pub fun step_bytes(h: u64, p: *u8, n: usize) u64 {
    var x: u64   = h;
    var i: usize = 0;
    for (i < n) {
        x = step_u8(x, p[i]);
        i = i + 1;
    }
    ret x;
}

test fnv1a__step_bytes_known_vectors {
    if (step_bytes(FNV_INIT, nil, 0) != 0xcbf29ce484222325)      { ret 1; }
    if (step_bytes(FNV_INIT, "a"::*u8, 1) != 0xaf63dc4c8601ec8c) { ret 2; }
    val s: *u8 = "foobar"::*u8;
    if (step_bytes(FNV_INIT, s, 6) != 0x85944171f73967e8)                       { ret 3; }
    if (step_bytes(step_bytes(FNV_INIT, s, 2), ?s[2], 4) != 0x85944171f73967e8) { ret 4; }
    ret 0;
}
