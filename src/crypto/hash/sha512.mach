# SHA-512 cryptographic hash, and the secret-typed SHA-512 and SHA-384 entries
#
# `State` is public. `SecretState512` and `SecretState384` are the same engine
# over secret-typed data, held as `^u64` words and a `[128]^u8` block, with
# the SHA-512 IV and a 64-byte digest, or the SHA-384 IV and a 48-byte digest.
# they are distinct records, so a state cannot be finalized as the other hash.
# their contract is the welding, exactly as `sha256.SecretState`:
# `update_secret512` and `update_secret384` take `*^u8` only, so public bytes
# are lifted at the call site; the `final_secret*` digest goes to `*^u8`,
# never `*u8`, and declassifying is the caller's decision; neither record
# aliases `State` and no cast joins them; `buf_len` and `total` are public,
# as lengths are by the family's convention. `destroy_secret512` and
# `destroy_secret384` zeroize the words and the block through `ct.zeroize`
# and reset the lengths, so a destroyed state is all zero.
# test/sha256/refusals pins the contract with builds that must fail. the
# compression is `#[oblivious]` at the secret instance. no target has a
# hardware row for SHA-512, so there is one portable backend.

use std.crypto.ct;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

pub val DIGEST_SIZE: usize = 64;
pub val BLOCK_SIZE:  usize = 128;

pub rec State {
    h0:      u64;
    h1:      u64;
    h2:      u64;
    h3:      u64;
    h4:      u64;
    h5:      u64;
    h6:      u64;
    h7:      u64;
    buf:     [128]u8;
    buf_len: usize;
    total:   u64;
}

val K: [80]u64 = [80]u64{
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
};

#[oblivious]
#[inline]
fun rotr[W](x: W, n: u64) W {
    ret (x >> n) | (x << (64 - n));
}

#[oblivious]
#[inline]
fun ch[W](x: W, y: W, z: W) W {
    ret (x & y) ^ (~x & z);
}

#[oblivious]
#[inline]
fun maj[W](x: W, y: W, z: W) W {
    ret (x & y) ^ (x & z) ^ (y & z);
}

#[oblivious]
#[inline]
fun sigma0[W](x: W) W {
    ret rotr[W](x, 28) ^ rotr[W](x, 34) ^ rotr[W](x, 39);
}

#[oblivious]
#[inline]
fun sigma1[W](x: W) W {
    ret rotr[W](x, 14) ^ rotr[W](x, 18) ^ rotr[W](x, 41);
}

#[oblivious]
#[inline]
fun gamma0[W](x: W) W {
    ret rotr[W](x, 1) ^ rotr[W](x, 8) ^ (x >> 7);
}

#[oblivious]
#[inline]
fun gamma1[W](x: W) W {
    ret rotr[W](x, 19) ^ rotr[W](x, 61) ^ (x >> 6);
}

#[oblivious]
#[inline]
fun read_be[W, B](buf: *B, off: usize) W {
    ret (buf[off]::W << 56) | (buf[off + 1]::W << 48) |
        (buf[off + 2]::W << 40) | (buf[off + 3]::W << 32) |
        (buf[off + 4]::W << 24) | (buf[off + 5]::W << 16) |
        (buf[off + 6]::W << 8) | buf[off + 7]::W;
}

#[oblivious]
#[inline]
fun write_be[W, B](buf: *B, off: usize, v: W) {
    buf[off]     = (v >> 56)::B;
    buf[off + 1] = (v >> 48)::B;
    buf[off + 2] = (v >> 40)::B;
    buf[off + 3] = (v >> 32)::B;
    buf[off + 4] = (v >> 24)::B;
    buf[off + 5] = (v >> 16)::B;
    buf[off + 6] = (v >> 8)::B;
    buf[off + 7] = v::B;
}

# the compression over either state, one 128-byte block
#
# oblivious at the secret instance: no branch or address depends on a word.
# the schedule and the working variables are wiped on the way out, since at
# the secret instance they hold key material
#[oblivious]
fun portable_block[W, B](h: *W, block: *B) {
    var w: [80]W;
    var i: usize = 0;
    for (i < 16) {
        w[i] = read_be[W, B](block, i * 8);
        i    = i + 1;
    }
    for (i < 80) {
        w[i] = gamma1[W](w[i - 2]) + w[i - 7] + gamma0[W](w[i - 15]) + w[i - 16];
        i    = i + 1;
    }

    var a:  W = h[0];
    var b:  W = h[1];
    var c:  W = h[2];
    var d:  W = h[3];
    var e:  W = h[4];
    var f:  W = h[5];
    var g:  W = h[6];
    var hh: W = h[7];

    i = 0;
    for (i < 80) {
        val t1: W = hh + sigma1[W](e) + ch[W](e, f, g) + K[i] + w[i];
        val t2: W = sigma0[W](a) + maj[W](a, b, c);
        hh = g;
        g  = f;
        f  = e;
        e  = d + t1;
        d  = c;
        c  = b;
        b  = a;
        a  = t1 + t2;
        i  = i + 1;
    }

    h[0] = h[0] + a;
    h[1] = h[1] + b;
    h[2] = h[2] + c;
    h[3] = h[3] + d;
    h[4] = h[4] + e;
    h[5] = h[5] + f;
    h[6] = h[6] + g;
    h[7] = h[7] + hh;

    a  = 0;
    b  = 0;
    c  = 0;
    d  = 0;
    e  = 0;
    f  = 0;
    g  = 0;
    hh = 0;
    i  = 0;
    for (i < 80) {
        w[i] = 0;
        i    = i + 1;
    }
}

fun process_block(s: *State, block: *u8) {
    portable_block[u64, u8](?s.h0, block);
}

# initialize a new SHA-512 state with standard IV
# ---
# ret: initialized state
pub fun init() State {
    var s: State;
    s.h0      = 0x6a09e667f3bcc908;
    s.h1      = 0xbb67ae8584caa73b;
    s.h2      = 0x3c6ef372fe94f82b;
    s.h3      = 0xa54ff53a5f1d36f1;
    s.h4      = 0x510e527fade682d1;
    s.h5      = 0x9b05688c2b3e6c1f;
    s.h6      = 0x1f83d9abfb41bd6b;
    s.h7      = 0x5be0cd19137e2179;
    s.buf_len = 0;
    s.total   = 0;
    ret s;
}

# feed data into the hash state
# ---
# s:    pointer to hash state
# data: pointer to input bytes
# len:  number of bytes to process
pub fun update(s: *State, data: *u8, len: usize) {
    var off: usize = 0;
    s.total = s.total + len::u64;

    if (s.buf_len > 0) {
        var fill: usize = 128 - s.buf_len;
        if (fill > len) { fill = len; }
        memory.raw_copy(?s.buf[s.buf_len], ?data[off], fill);
        s.buf_len = s.buf_len + fill;
        off       = off + fill;
        if (s.buf_len == 128) {
            process_block(s, ?s.buf[0]);
            s.buf_len = 0;
        }
    }

    for (off + 128 <= len) {
        process_block(s, ?data[off]);
        off = off + 128;
    }

    if (off < len) {
        val remaining: usize = len - off;
        memory.raw_copy(?s.buf[0], ?data[off], remaining);
        s.buf_len = remaining;
    }
}

# finalize the hash and write the 64-byte digest
# ---
# s:      pointer to hash state
# digest: pointer to 64-byte output buffer
pub fun final(s: *State, digest: *u8) {
    val total_bits: u64 = s.total * 8;

    s.buf[s.buf_len] = 0x80;
    s.buf_len        = s.buf_len + 1;

    if (s.buf_len > 112) {
        for (s.buf_len < 128) {
            s.buf[s.buf_len] = 0;
            s.buf_len        = s.buf_len + 1;
        }
        process_block(s, ?s.buf[0]);
        s.buf_len = 0;
    }

    for (s.buf_len < 112) {
        s.buf[s.buf_len] = 0;
        s.buf_len        = s.buf_len + 1;
    }

    # 128-bit big-endian length: upper 64 bits at 112..119 (zero), lower at 120..127
    s.buf[112] = 0;
    s.buf[113] = 0;
    s.buf[114] = 0;
    s.buf[115] = 0;
    s.buf[116] = 0;
    s.buf[117] = 0;
    s.buf[118] = 0;
    s.buf[119] = 0;
    s.buf[120] = (total_bits >> 56)::u8;
    s.buf[121] = (total_bits >> 48)::u8;
    s.buf[122] = (total_bits >> 40)::u8;
    s.buf[123] = (total_bits >> 32)::u8;
    s.buf[124] = (total_bits >> 24)::u8;
    s.buf[125] = (total_bits >> 16)::u8;
    s.buf[126] = (total_bits >> 8)::u8;
    s.buf[127] = total_bits::u8;

    process_block(s, ?s.buf[0]);

    write_be[u64, u8](digest, 0, s.h0);
    write_be[u64, u8](digest, 8, s.h1);
    write_be[u64, u8](digest, 16, s.h2);
    write_be[u64, u8](digest, 24, s.h3);
    write_be[u64, u8](digest, 32, s.h4);
    write_be[u64, u8](digest, 40, s.h5);
    write_be[u64, u8](digest, 48, s.h6);
    write_be[u64, u8](digest, 56, s.h7);
}

# compute SHA-512 digest of a byte buffer in one call
# ---
# data:   pointer to input bytes
# len:    number of bytes to hash
# digest: pointer to 64-byte output buffer
pub fun hash(data: *u8, len: usize, digest: *u8) {
    var s: State = init();
    update(?s, data, len);
    final(?s, digest);
}

pub val DIGEST_SIZE_384: usize = 48;

# the secret-typed SHA-384 state, see the module doc
pub rec SecretState384 {
    h0:      ^u64;
    h1:      ^u64;
    h2:      ^u64;
    h3:      ^u64;
    h4:      ^u64;
    h5:      ^u64;
    h6:      ^u64;
    h7:      ^u64;
    buf:     [128]^u8;
    buf_len: usize;
    total:   u64;
}

# initialize a secret-typed SHA-384 state with the standard IV
# ---
# ret: initialized state, block zeroed
pub fun init_secret384() SecretState384 {
    var s: SecretState384;
    s.h0 = 0xcbbb9d5dc1059ed8;
    s.h1 = 0x629a292a367cd507;
    s.h2 = 0x9159015a3070dd17;
    s.h3 = 0x152fecd8f70e5939;
    s.h4 = 0x67332667ffc00b31;
    s.h5 = 0x8eb44a8768581511;
    s.h6 = 0xdb0c2e0d64f98fa7;
    s.h7 = 0x47b5481dbefa4fa4;
    ct.zeroize(?s.buf[0], 128);
    s.buf_len = 0;
    s.total   = 0;
    ret s;
}

# the secret-typed SHA-512 state, see the module doc
pub rec SecretState512 {
    h0:      ^u64;
    h1:      ^u64;
    h2:      ^u64;
    h3:      ^u64;
    h4:      ^u64;
    h5:      ^u64;
    h6:      ^u64;
    h7:      ^u64;
    buf:     [128]^u8;
    buf_len: usize;
    total:   u64;
}

# initialize a secret-typed SHA-512 state with the standard IV
# ---
# ret: initialized state, block zeroed
pub fun init_secret512() SecretState512 {
    var s: SecretState512;
    s.h0 = 0x6a09e667f3bcc908;
    s.h1 = 0xbb67ae8584caa73b;
    s.h2 = 0x3c6ef372fe94f82b;
    s.h3 = 0xa54ff53a5f1d36f1;
    s.h4 = 0x510e527fade682d1;
    s.h5 = 0x9b05688c2b3e6c1f;
    s.h6 = 0x1f83d9abfb41bd6b;
    s.h7 = 0x5be0cd19137e2179;
    ct.zeroize(?s.buf[0], 128);
    s.buf_len = 0;
    s.total   = 0;
    ret s;
}

# the secret engine over either secret record, which share their layout
fun secret_update[S](s: *S, data: *^u8, len: usize) {
    var off: usize = 0;
    s.total = s.total + len::u64;

    if (s.buf_len > 0) {
        var fill: usize = 128 - s.buf_len;
        if (fill > len) { fill = len; }
        var i: usize = 0;
        for (i < fill) {
            s.buf[s.buf_len + i] = data[off + i];
            i                    = i + 1;
        }
        s.buf_len = s.buf_len + fill;
        off       = off + fill;
        if (s.buf_len == 128) {
            portable_block[^u64, ^u8](?s.h0, ?s.buf[0]);
            s.buf_len = 0;
        }
    }

    for (off + 128 <= len) {
        portable_block[^u64, ^u8](?s.h0, ?data[off]);
        off = off + 128;
    }

    if (off < len) {
        val remaining: usize = len - off;
        var i:         usize = 0;
        for (i < remaining) {
            s.buf[i] = data[off + i];
            i        = i + 1;
        }
        s.buf_len = remaining;
    }
}

# pad, compress the last block and write `words` digest words
fun secret_final[S](s: *S, digest: *^u8, words: usize) {
    val total_bits: u64 = s.total * 8;

    s.buf[s.buf_len] = 0x80;
    s.buf_len        = s.buf_len + 1;

    if (s.buf_len > 112) {
        for (s.buf_len < 128) {
            s.buf[s.buf_len] = 0;
            s.buf_len        = s.buf_len + 1;
        }
        portable_block[^u64, ^u8](?s.h0, ?s.buf[0]);
        s.buf_len = 0;
    }

    for (s.buf_len < 120) {
        s.buf[s.buf_len] = 0;
        s.buf_len        = s.buf_len + 1;
    }

    s.buf[120] = (total_bits >> 56)::u8;
    s.buf[121] = (total_bits >> 48)::u8;
    s.buf[122] = (total_bits >> 40)::u8;
    s.buf[123] = (total_bits >> 32)::u8;
    s.buf[124] = (total_bits >> 24)::u8;
    s.buf[125] = (total_bits >> 16)::u8;
    s.buf[126] = (total_bits >> 8)::u8;
    s.buf[127] = total_bits::u8;

    portable_block[^u64, ^u8](?s.h0, ?s.buf[0]);

    val h: *^u64 = ?s.h0;
    var i: usize = 0;
    for (i < words) {
        write_be[^u64, ^u8](digest, i * 8, h[i]);
        i = i + 1;
    }
}

fun secret_destroy[S](s: *S) {
    ct.zeroize((?s.h0):~*^u8, 64);
    ct.zeroize(?s.buf[0], 128);
    s.buf_len = 0;
    s.total   = 0;
}

# feed secret bytes into a secret SHA-512 state
#
# takes `*^u8` only. lift public bytes at the call site
# ---
# s:    pointer to the state
# data: pointer to the secret input bytes
# len:  number of bytes to process, public
pub fun update_secret512(s: *SecretState512, data: *^u8, len: usize) {
    secret_update[SecretState512](s, data, len);
}

# finalize a secret SHA-512 state and write the 64-byte digest as secret bytes
#
# the digest is `*^u8`. declassify it with `:>` at the caller if that is the
# intent. the state keeps its words afterwards, so call `destroy_secret512`
# ---
# s:      pointer to the state
# digest: pointer to the 64-byte secret output buffer
pub fun final_secret512(s: *SecretState512, digest: *^u8) {
    secret_final[SecretState512](s, digest, 8);
}

# wipe a secret SHA-512 state: words and block zeroized, lengths reset
# ---
# s: pointer to the state, all zero afterwards
pub fun destroy_secret512(s: *SecretState512) {
    secret_destroy[SecretState512](s);
}

# feed secret bytes into a secret SHA-384 state
#
# takes `*^u8` only. lift public bytes at the call site
# ---
# s:    pointer to the state
# data: pointer to the secret input bytes
# len:  number of bytes to process, public
pub fun update_secret384(s: *SecretState384, data: *^u8, len: usize) {
    secret_update[SecretState384](s, data, len);
}

# finalize a secret SHA-384 state and write the 48-byte digest as secret bytes
#
# the digest is `*^u8`. declassify it with `:>` at the caller if that is the
# intent. the state keeps its words afterwards, so call `destroy_secret384`
# ---
# s:      pointer to the state
# digest: pointer to the 48-byte secret output buffer
pub fun final_secret384(s: *SecretState384, digest: *^u8) {
    secret_final[SecretState384](s, digest, 6);
}

# wipe a secret SHA-384 state: words and block zeroized, lengths reset
# ---
# s: pointer to the state, all zero afterwards
pub fun destroy_secret384(s: *SecretState384) {
    secret_destroy[SecretState384](s);
}

fun hex_matches(digest: *u8, len: usize, expected: str) bool {
    var i: usize = 0;
    for (i < len) {
        val hi: u8 = expected[i * 2];
        val lo: u8 = expected[i * 2 + 1];
        var v:  u8 = 0;
        if (hi >= 97)       { v = (hi - 87) << 4; }
        or                  { v = (hi - 48) << 4; }
        if (lo >= 97)       { v = v | (lo - 87); }
        or                  { v = v | (lo - 48); }
        if (digest[i] != v) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the secret SHA-384 digest of public bytes, lifted at the call and
# declassified here. only a test declassifies
fun secret384_digest_of(data: *u8, len: usize, digest: *u8) {
    var lifted: [1024]^u8;
    var i:      usize = 0;
    for (i < len) {
        lifted[i] = data[i];
        i         = i + 1;
    }
    var s: SecretState384 = init_secret384();
    update_secret384(?s, ?lifted[0], len);
    var out: [48]^u8;
    final_secret384(?s, ?out[0]);
    destroy_secret384(?s);
    i = 0;
    for (i < 48) {
        digest[i] = out[i]:>u8;
        i         = i + 1;
    }
}

# the secret SHA-512 digest of public bytes, lifted at the call and
# declassified here. only a test declassifies
fun secret512_digest_of(data: *u8, len: usize, digest: *u8) {
    var lifted: [1024]^u8;
    var i:      usize = 0;
    for (i < len) {
        lifted[i] = data[i];
        i         = i + 1;
    }
    var s: SecretState512 = init_secret512();
    update_secret512(?s, ?lifted[0], len);
    var out: [64]^u8;
    final_secret512(?s, ?out[0]);
    destroy_secret512(?s);
    i = 0;
    for (i < 64) {
        digest[i] = out[i]:>u8;
        i         = i + 1;
    }
}

test sha512__secret_fips_vectors {
    var digest: [64]u8;
    secret512_digest_of(""::*u8, 0, ?digest[0]);
    if (!hex_matches(?digest[0], 64, "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")) { ret 1; }
    secret512_digest_of("abc"::*u8, 3, ?digest[0]);
    if (!hex_matches(?digest[0], 64, "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")) { ret 2; }
    val two: str = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    secret512_digest_of(two::*u8, 112, ?digest[0]);
    if (!hex_matches(?digest[0], 64, "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")) { ret 3; }
    ret 0;
}

# an oblivious caller that wipes while secrets are still live in its registers,
# the shape of mach-crypto's snapshot_sha384. if ct.zeroize were inlined here,
# the constant-time walk would refuse its asm loops at release. generic so it
# instantiates only in test builds
#[oblivious]
fun snapshot384_then_wipe[T](s: *SecretState384, out: *u8) {
    var copy:   SecretState384 = @s;
    var digest: [48]^u8;
    final_secret384(?copy, ?digest[0]);
    destroy_secret384(?copy);
    var i: usize = 0;
    for (i < 48) {
        out[i] = digest[i]:>u8;
        i      = i + 1;
    }
    ct.zeroize(?digest[0], 48);
}

test sha512__oblivious_caller_wipes_after_snapshot {
    var s:   SecretState384 = init_secret384();
    var out: [48]u8;
    snapshot384_then_wipe[u8](?s, ?out[0]);
    destroy_secret384(?s);
    if (!hex_matches(?out[0], 48, "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")) { ret 1; }
    ret 0;
}

test sha512__secret_matches_public_over_random_splits {
    var buf:   [1024]u8;
    var seed:  u64   = 0x27bb2ee687b0b0fd;
    var round: usize = 0;
    for (round < 100) {
        seed = seed * 6364136223846793005 + 1442695040888963407;
        val len: usize = (seed >> 33)::usize % 1024;
        var i:   usize = 0;
        for (i < len) {
            seed   = seed * 6364136223846793005 + 1442695040888963407;
            buf[i] = (seed >> 56)::u8;
            i      = i + 1;
        }
        var expected: [64]u8;
        hash(?buf[0], len, ?expected[0]);
        var got: [64]u8;
        secret512_digest_of(?buf[0], len, ?got[0]);
        i = 0;
        for (i < 64) {
            if (got[i] != expected[i]) { ret 1; }
            i = i + 1;
        }
        seed = seed * 6364136223846793005 + 1442695040888963407;
        var cut: usize = 0;
        if (len > 0) { cut = (seed >> 40)::usize % len; }
        var lifted: [1024]^u8;
        i = 0;
        for (i < len) {
            lifted[i] = buf[i];
            i         = i + 1;
        }
        var s: SecretState512 = init_secret512();
        update_secret512(?s, ?lifted[0], cut);
        update_secret512(?s, ?lifted[cut], len - cut);
        var out: [64]^u8;
        final_secret512(?s, ?out[0]);
        destroy_secret512(?s);
        i = 0;
        for (i < 64) {
            if (out[i]:>u8 != expected[i]) { ret 2; }
            i = i + 1;
        }
        round = round + 1;
    }
    ret 0;
}

test sha512__destroyed_secret_state_is_zero {
    var s:   SecretState512 = init_secret512();
    var key: [200]^u8;
    var i:   usize          = 0;
    for (i < 200) {
        key[i] = (i * 3 + 9)::u8;
        i      = i + 1;
    }
    update_secret512(?s, ?key[0], 200);
    if (s.buf_len != 72 || s.total != 200) { ret 1; }
    destroy_secret512(?s);
    if (s.buf_len != 0 || s.total != 0)                                       { ret 2; }
    if (s.h0:>u64 != 0 || s.h1:>u64 != 0 || s.h2:>u64 != 0 || s.h3:>u64 != 0) { ret 3; }
    if (s.h4:>u64 != 0 || s.h5:>u64 != 0 || s.h6:>u64 != 0 || s.h7:>u64 != 0) { ret 3; }
    i = 0;
    for (i < 128) {
        if (s.buf[i]:>u8 != 0) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test sha384__secret_fips_vectors {
    var digest: [48]u8;
    secret384_digest_of(""::*u8, 0, ?digest[0]);
    if (!hex_matches(?digest[0], 48, "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")) { ret 1; }
    secret384_digest_of("abc"::*u8, 3, ?digest[0]);
    if (!hex_matches(?digest[0], 48, "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")) { ret 2; }
    val two: str = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    secret384_digest_of(two::*u8, 112, ?digest[0]);
    if (!hex_matches(?digest[0], 48, "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")) { ret 3; }
    ret 0;
}
