# SHA-256 cryptographic hash
#
# the block compression has one portable implementation and, on x86_64 and
# aarch64, a hardware one (SHA-NI, ARMv8 SHA2). `compress` picks the backend
# once from std.system.cpu.features() and caches the choice, so `init`,
# `update`, `final` and `hash` are the same on every processor. `accelerated`
# says which one is in use.
#
# the hardware functions are outliers: each carries `#[extensions(...)]`, and
# the contract with its caller is soft. control reaches the body only on a
# host that has the extensions, and the dispatcher's run-time check is what
# guarantees it. calling one elsewhere faults, with no guard and no diagnostic.

use std.memory;
use std.sync.atomic;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

$if ($mach.build.arch == $mach.arch.x86_64 || $mach.build.arch == $mach.arch.aarch64) {
    use std.system.cpu;
}

$if (capability.HAS_CLOCK) {
    use std.print;
    use std.system.os;
}

pub val DIGEST_SIZE: usize = 32;
pub val BLOCK_SIZE:  usize = 64;

pub rec State {
    h0:      u32;
    h1:      u32;
    h2:      u32;
    h3:      u32;
    h4:      u32;
    h5:      u32;
    h6:      u32;
    h7:      u32;
    buf:     [64]u8;
    buf_len: usize;
    total:   u64;
}

val K: [64]u32 = [64]u32{
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
};

fun rotr(x: u32, n: u32) u32 {
    ret (x >> n) | (x << (32 - n));
}

fun ch(x: u32, y: u32, z: u32) u32 {
    ret (x & y) ^ (~x & z);
}

fun maj(x: u32, y: u32, z: u32) u32 {
    ret (x & y) ^ (x & z) ^ (y & z);
}

fun sigma0(x: u32) u32 {
    ret rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22);
}

fun sigma1(x: u32) u32 {
    ret rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25);
}

fun gamma0(x: u32) u32 {
    ret rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3);
}

fun gamma1(x: u32) u32 {
    ret rotr(x, 17) ^ rotr(x, 19) ^ (x >> 10);
}

fun read_u32_be(buf: *u8, off: usize) u32 {
    ret (buf[off]::u32 << 24) | (buf[off + 1]::u32 << 16) |
        (buf[off + 2]::u32 << 8) | buf[off + 3]::u32;
}

fun write_u32_be(buf: *u8, off: usize, v: u32) {
    buf[off]     = (v >> 24)::u8;
    buf[off + 1] = (v >> 16)::u8;
    buf[off + 2] = (v >> 8)::u8;
    buf[off + 3] = v::u8;
}

# the portable compression, one 64-byte block
fun compress_portable(s: *State, block: *u8) {
    var w: [64]u32;

    var i: usize = 0;
    for (i < 16) {
        w[i] = read_u32_be(block, i * 4);
        i    = i + 1;
    }
    for (i < 64) {
        w[i] = gamma1(w[i - 2]) + w[i - 7] + gamma0(w[i - 15]) + w[i - 16];
        i    = i + 1;
    }

    var a: u32 = s.h0;
    var b: u32 = s.h1;
    var c: u32 = s.h2;
    var d: u32 = s.h3;
    var e: u32 = s.h4;
    var f: u32 = s.h5;
    var g: u32 = s.h6;
    var h: u32 = s.h7;

    i = 0;
    for (i < 64) {
        val t1: u32 = h + sigma1(e) + ch(e, f, g) + K[i] + w[i];
        val t2: u32 = sigma0(a) + maj(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        i = i + 1;
    }

    s.h0 = s.h0 + a;
    s.h1 = s.h1 + b;
    s.h2 = s.h2 + c;
    s.h3 = s.h3 + d;
    s.h4 = s.h4 + e;
    s.h5 = s.h5 + f;
    s.h6 = s.h6 + g;
    s.h7 = s.h7 + h;
}

$if ($mach.build.arch == $mach.arch.x86_64) {
    # the byte order of a message word, for pshufb
    val FLIP: [16]u8 = [16]u8{3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12};

    # the SHA-NI compression, one 64-byte block
    #
    # outlier: the body runs only on a processor with sha, ssse3 and sse4.1,
    # which `compress` checks through cpu.features() before calling it. xmm0
    # carries the message words, the operand sha256rnds2 reads without naming.
    # the state is held as abef and cdgh, the order the instruction expects,
    # and the h0..h7 layout is restored on the way out
    #[extensions(sha, ssse3, sse41)]
    fun compress_sha_ni(s: *State, block: *u8) {
        val state: *u32 = ?s.h0;
        val k:     *u32 = ?K[0];
        val mask:  *u8  = ?FLIP[0];
        asm x86_64 {
            mov rax, {state}
            mov rcx, {block}
            mov rdx, {k}
            mov rsi, {mask}
            movdqu xmm1, [rax]
            movdqu xmm2, [rax + 16]
            pshufd xmm1, xmm1, 0xB1
            pshufd xmm2, xmm2, 0x1B
            movdqa xmm7, xmm1
            palignr xmm1, xmm2, 8
            pblendw xmm2, xmm7, 0xF0
            movdqu xmm8, [rsi]
            movdqa xmm9, xmm1
            movdqa xmm10, xmm2
            # rounds 0-3
            movdqu xmm0, [rcx]
            pshufb xmm0, xmm8
            movdqa xmm3, xmm0
            movdqu xmm11, [rdx]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            # rounds 4-7
            movdqu xmm0, [rcx + 16]
            pshufb xmm0, xmm8
            movdqa xmm4, xmm0
            movdqu xmm11, [rdx + 16]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm3, xmm4
            # rounds 8-11
            movdqu xmm0, [rcx + 32]
            pshufb xmm0, xmm8
            movdqa xmm5, xmm0
            movdqu xmm11, [rdx + 32]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm4, xmm5
            # rounds 12-15
            movdqu xmm0, [rcx + 48]
            pshufb xmm0, xmm8
            movdqa xmm6, xmm0
            movdqu xmm11, [rdx + 48]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm6
            palignr xmm7, xmm5, 4
            paddd xmm3, xmm7
            sha256msg2 xmm3, xmm6
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm5, xmm6
            # rounds 16-19
            movdqa xmm0, xmm3
            movdqu xmm11, [rdx + 64]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm3
            palignr xmm7, xmm6, 4
            paddd xmm4, xmm7
            sha256msg2 xmm4, xmm3
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm6, xmm3
            # rounds 20-23
            movdqa xmm0, xmm4
            movdqu xmm11, [rdx + 80]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm4
            palignr xmm7, xmm3, 4
            paddd xmm5, xmm7
            sha256msg2 xmm5, xmm4
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm3, xmm4
            # rounds 24-27
            movdqa xmm0, xmm5
            movdqu xmm11, [rdx + 96]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm5
            palignr xmm7, xmm4, 4
            paddd xmm6, xmm7
            sha256msg2 xmm6, xmm5
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm4, xmm5
            # rounds 28-31
            movdqa xmm0, xmm6
            movdqu xmm11, [rdx + 112]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm6
            palignr xmm7, xmm5, 4
            paddd xmm3, xmm7
            sha256msg2 xmm3, xmm6
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm5, xmm6
            # rounds 32-35
            movdqa xmm0, xmm3
            movdqu xmm11, [rdx + 128]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm3
            palignr xmm7, xmm6, 4
            paddd xmm4, xmm7
            sha256msg2 xmm4, xmm3
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm6, xmm3
            # rounds 36-39
            movdqa xmm0, xmm4
            movdqu xmm11, [rdx + 144]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm4
            palignr xmm7, xmm3, 4
            paddd xmm5, xmm7
            sha256msg2 xmm5, xmm4
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm3, xmm4
            # rounds 40-43
            movdqa xmm0, xmm5
            movdqu xmm11, [rdx + 160]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm5
            palignr xmm7, xmm4, 4
            paddd xmm6, xmm7
            sha256msg2 xmm6, xmm5
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm4, xmm5
            # rounds 44-47
            movdqa xmm0, xmm6
            movdqu xmm11, [rdx + 176]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm6
            palignr xmm7, xmm5, 4
            paddd xmm3, xmm7
            sha256msg2 xmm3, xmm6
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm5, xmm6
            # rounds 48-51
            movdqa xmm0, xmm3
            movdqu xmm11, [rdx + 192]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm3
            palignr xmm7, xmm6, 4
            paddd xmm4, xmm7
            sha256msg2 xmm4, xmm3
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            sha256msg1 xmm6, xmm3
            # rounds 52-55
            movdqa xmm0, xmm4
            movdqu xmm11, [rdx + 208]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm4
            palignr xmm7, xmm3, 4
            paddd xmm5, xmm7
            sha256msg2 xmm5, xmm4
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            # rounds 56-59
            movdqa xmm0, xmm5
            movdqu xmm11, [rdx + 224]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            movdqa xmm7, xmm5
            palignr xmm7, xmm4, 4
            paddd xmm6, xmm7
            sha256msg2 xmm6, xmm5
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            # rounds 60-63
            movdqa xmm0, xmm6
            movdqu xmm11, [rdx + 240]
            paddd xmm0, xmm11
            sha256rnds2 xmm2, xmm1
            pshufd xmm0, xmm0, 0x0E
            sha256rnds2 xmm1, xmm2
            paddd xmm1, xmm9
            paddd xmm2, xmm10
            pshufd xmm1, xmm1, 0x1B
            pshufd xmm2, xmm2, 0xB1
            movdqa xmm7, xmm1
            pblendw xmm1, xmm2, 0xF0
            palignr xmm2, xmm7, 8
            movdqu [rax], xmm1
            movdqu [rax + 16], xmm2
        }
    }

    fun hardware_available(have: cpu.Features) bool {
        ret have.sha && have.ssse3 && have.sse41;
    }

    fun compress_hardware(s: *State, block: *u8) {
        compress_sha_ni(s, block);
    }
}
$or ($mach.build.arch == $mach.arch.aarch64) {
    # the ARMv8 SHA2 compression, one 64-byte block
    #
    # outlier: the body runs only on a processor with sha2, which `compress`
    # checks through cpu.features() before calling it. the message words are
    # byte-swapped into native order first, since the vector byte reverse is
    # not in the assembler's vocabulary. the state is abcd and efgh, which is
    # the h0..h7 layout as it stands
    #[extensions(sha2)]
    fun compress_sha2(s: *State, block: *u8) {
        var words: [16]u32;
        var i:     usize = 0;
        for (i < 16) {
            words[i] = read_u32_be(block, i * 4);
            i        = i + 1;
        }
        val state: *u32 = ?s.h0;
        val k:     *u32 = ?K[0];
        asm aarch64 {
            ldr x9, {state}
            ldr x10, {words}
            ldr x11, {k}
            mov x12, x9
            ld1 {v0.4s}, [x12], 16
            ld1 {v1.4s}, [x12], 16
            mov v2.16b, v0.16b
            mov v3.16b, v1.16b
            ld1 {v16.4s}, [x10], 16
            ld1 {v17.4s}, [x10], 16
            ld1 {v18.4s}, [x10], 16
            ld1 {v19.4s}, [x10], 16
            # rounds 0-3
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v16.4s, v20.4s
            sha256su0 v16.4s, v17.4s
            sha256su1 v16.4s, v18.4s, v19.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 4-7
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v17.4s, v20.4s
            sha256su0 v17.4s, v18.4s
            sha256su1 v17.4s, v19.4s, v16.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 8-11
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v18.4s, v20.4s
            sha256su0 v18.4s, v19.4s
            sha256su1 v18.4s, v16.4s, v17.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 12-15
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v19.4s, v20.4s
            sha256su0 v19.4s, v16.4s
            sha256su1 v19.4s, v17.4s, v18.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 16-19
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v16.4s, v20.4s
            sha256su0 v16.4s, v17.4s
            sha256su1 v16.4s, v18.4s, v19.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 20-23
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v17.4s, v20.4s
            sha256su0 v17.4s, v18.4s
            sha256su1 v17.4s, v19.4s, v16.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 24-27
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v18.4s, v20.4s
            sha256su0 v18.4s, v19.4s
            sha256su1 v18.4s, v16.4s, v17.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 28-31
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v19.4s, v20.4s
            sha256su0 v19.4s, v16.4s
            sha256su1 v19.4s, v17.4s, v18.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 32-35
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v16.4s, v20.4s
            sha256su0 v16.4s, v17.4s
            sha256su1 v16.4s, v18.4s, v19.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 36-39
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v17.4s, v20.4s
            sha256su0 v17.4s, v18.4s
            sha256su1 v17.4s, v19.4s, v16.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 40-43
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v18.4s, v20.4s
            sha256su0 v18.4s, v19.4s
            sha256su1 v18.4s, v16.4s, v17.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 44-47
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v19.4s, v20.4s
            sha256su0 v19.4s, v16.4s
            sha256su1 v19.4s, v17.4s, v18.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 48-51
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v16.4s, v20.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 52-55
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v17.4s, v20.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 56-59
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v18.4s, v20.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            # rounds 60-63
            ld1 {v20.4s}, [x11], 16
            add v21.4s, v19.4s, v20.4s
            mov v22.16b, v0.16b
            sha256h q0, q1, v21.4s
            sha256h2 q1, q22, v21.4s
            add v0.4s, v0.4s, v2.4s
            add v1.4s, v1.4s, v3.4s
            st1 {v0.4s}, [x9], 16
            st1 {v1.4s}, [x9], 16
        }
    }

    fun hardware_available(have: cpu.Features) bool {
        ret have.sha2;
    }

    fun compress_hardware(s: *State, block: *u8) {
        compress_sha2(s, block);
    }
}

$if ($mach.build.arch == $mach.arch.x86_64 || $mach.build.arch == $mach.arch.aarch64) {
    val BACKEND_UNKNOWN:  i64 = 0;
    val BACKEND_PORTABLE: i64 = 1;
    val BACKEND_HARDWARE: i64 = 2;

    # the chosen backend, decided once from cpu.features(). a concurrent first
    # call decides the same value twice, which is harmless
    var backend: i64 = BACKEND_UNKNOWN;

    fun choose() i64 {
        val seen: i64 = atomic.load(?backend);
        if (seen != BACKEND_UNKNOWN) { ret seen; }
        var chosen: i64 = BACKEND_PORTABLE;
        if (hardware_available(cpu.features())) { chosen = BACKEND_HARDWARE; }
        atomic.store(?backend, chosen);
        ret chosen;
    }

    # whether the hardware backend is in use on this processor
    pub fun accelerated() bool {
        ret choose() == BACKEND_HARDWARE;
    }

    fun compress(s: *State, block: *u8) {
        if (choose() == BACKEND_HARDWARE) { compress_hardware(s, block); }
        or                                { compress_portable(s, block); }
    }
}
$or {
    # whether the hardware backend is in use on this processor
    pub fun accelerated() bool {
        ret false;
    }

    fun compress(s: *State, block: *u8) {
        compress_portable(s, block);
    }
}

# initialize a new SHA-256 state with standard IV
# ---
# ret: initialized state
pub fun init() State {
    var s: State;
    s.h0      = 0x6a09e667;
    s.h1      = 0xbb67ae85;
    s.h2      = 0x3c6ef372;
    s.h3      = 0xa54ff53a;
    s.h4      = 0x510e527f;
    s.h5      = 0x9b05688c;
    s.h6      = 0x1f83d9ab;
    s.h7      = 0x5be0cd19;
    s.buf_len = 0;
    s.total   = 0;
    ret s;
}

# feed data into the hash state
# ---
# s:    pointer to hash state
# data: pointer to input bytes
# len:  number of bytes to process
pub fun update(s: *State, data: *u8, len: usize) {
    var off: usize = 0;
    s.total = s.total + len::u64;

    if (s.buf_len > 0) {
        var fill: usize = 64 - s.buf_len;
        if (fill > len) { fill = len; }
        memory.raw_copy(?s.buf[s.buf_len], ?data[off], fill);
        s.buf_len = s.buf_len + fill;
        off       = off + fill;
        if (s.buf_len == 64) {
            compress(s, ?s.buf[0]);
            s.buf_len = 0;
        }
    }

    for (off + 64 <= len) {
        compress(s, ?data[off]);
        off = off + 64;
    }

    if (off < len) {
        val remaining: usize = len - off;
        memory.raw_copy(?s.buf[0], ?data[off], remaining);
        s.buf_len = remaining;
    }
}

# finalize the hash and write the 32-byte digest
# ---
# s:      pointer to hash state
# digest: pointer to 32-byte output buffer
pub fun final(s: *State, digest: *u8) {
    val total_bits: u64 = s.total * 8;

    s.buf[s.buf_len] = 0x80;
    s.buf_len        = s.buf_len + 1;

    if (s.buf_len > 56) {
        for (s.buf_len < 64) {
            s.buf[s.buf_len] = 0;
            s.buf_len        = s.buf_len + 1;
        }
        compress(s, ?s.buf[0]);
        s.buf_len = 0;
    }

    for (s.buf_len < 56) {
        s.buf[s.buf_len] = 0;
        s.buf_len        = s.buf_len + 1;
    }

    s.buf[56] = (total_bits >> 56)::u8;
    s.buf[57] = (total_bits >> 48)::u8;
    s.buf[58] = (total_bits >> 40)::u8;
    s.buf[59] = (total_bits >> 32)::u8;
    s.buf[60] = (total_bits >> 24)::u8;
    s.buf[61] = (total_bits >> 16)::u8;
    s.buf[62] = (total_bits >> 8)::u8;
    s.buf[63] = total_bits::u8;

    compress(s, ?s.buf[0]);

    write_u32_be(digest, 0, s.h0);
    write_u32_be(digest, 4, s.h1);
    write_u32_be(digest, 8, s.h2);
    write_u32_be(digest, 12, s.h3);
    write_u32_be(digest, 16, s.h4);
    write_u32_be(digest, 20, s.h5);
    write_u32_be(digest, 24, s.h6);
    write_u32_be(digest, 28, s.h7);
}

# compute SHA-256 digest of a byte buffer in one call
# ---
# data:   pointer to input bytes
# len:    number of bytes to hash
# digest: pointer to 32-byte output buffer
pub fun hash(data: *u8, len: usize, digest: *u8) {
    var s: State = init();
    update(?s, data, len);
    final(?s, digest);
}

test "sha256: empty string" {
    var digest: [32]u8;
    hash(""::*u8, 0, ?digest[0]);
    if (digest[0] != 0xe3) { ret 1; }
    if (digest[1] != 0xb0) { ret 1; }
    if (digest[2] != 0xc4) { ret 1; }
    if (digest[3] != 0x42) { ret 1; }
    if (digest[4] != 0x98) { ret 1; }
    if (digest[5] != 0xfc) { ret 1; }
    if (digest[6] != 0x1c) { ret 1; }
    if (digest[7] != 0x14) { ret 1; }
    ret 0;
}

test "sha256: abc" {
    var digest: [32]u8;
    hash("abc"::*u8, 3, ?digest[0]);
    if (digest[0] != 0xba) { ret 1; }
    if (digest[1] != 0x78) { ret 1; }
    if (digest[2] != 0x16) { ret 1; }
    if (digest[3] != 0xbf) { ret 1; }
    if (digest[4] != 0x8f) { ret 1; }
    if (digest[5] != 0x01) { ret 1; }
    if (digest[6] != 0xcf) { ret 1; }
    if (digest[7] != 0xea) { ret 1; }
    ret 0;
}

test "sha256: streaming matches oneshot" {
    var d1: [32]u8;
    var d2: [32]u8;
    hash("abcdef"::*u8, 6, ?d1[0]);
    var s: State = init();
    update(?s, "abc"::*u8, 3);
    update(?s, "def"::*u8, 3);
    final(?s, ?d2[0]);
    var i: usize = 0;
    for (i < 32) {
        if (d1[i] != d2[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

fun hex_matches(digest: *u8, expected: str) bool {
    var i: usize = 0;
    for (i < 32) {
        val hi: u8 = expected[i * 2];
        val lo: u8 = expected[i * 2 + 1];
        var v:  u8 = 0;
        if (hi >= 97)       { v = (hi - 87) << 4; }
        or                  { v = (hi - 48) << 4; }
        if (lo >= 97)       { v = v | (lo - 87); }
        or                  { v = v | (lo - 48); }
        if (digest[i] != v) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "sha256: FIPS 180-4 vectors through the public api" {
    var digest: [32]u8;
    hash(""::*u8, 0, ?digest[0]);
    if (!hex_matches(?digest[0], "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")) { ret 1; }
    hash("abc"::*u8, 3, ?digest[0]);
    if (!hex_matches(?digest[0], "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")) { ret 2; }
    val two: str = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    hash(two::*u8, 56, ?digest[0]);
    if (!hex_matches(?digest[0], "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")) { ret 3; }
    val four: str = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    hash(four::*u8, 112, ?digest[0]);
    if (!hex_matches(?digest[0], "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")) { ret 4; }
    ret 0;
}

$if ($mach.build.arch == $mach.arch.x86_64 || $mach.build.arch == $mach.arch.aarch64) {
    # the digest of data through one backend, for the tests
    fun digest_with(hardware: bool, data: *u8, len: usize, digest: *u8) {
        var s:   State = init();
        var off: usize = 0;
        s.total = len::u64;
        for (off + 64 <= len) {
            if (hardware) { compress_hardware(?s, ?data[off]); }
            or            { compress_portable(?s, ?data[off]); }
            off = off + 64;
        }
        val remaining: usize = len - off;
        memory.raw_copy(?s.buf[0], ?data[off], remaining);
        s.buf_len = remaining;
        # final pads and compresses through `compress`, so force the backend by hand
        val saved: i64 = atomic.load(?backend);
        if (hardware) { atomic.store(?backend, BACKEND_HARDWARE); }
        or            { atomic.store(?backend, BACKEND_PORTABLE); }
        final(?s, digest);
        atomic.store(?backend, saved);
    }

    # FIPS 180-4 vectors and the padding boundaries, through one backend
    fun known_answers(hardware: bool) i32 {
        var digest: [32]u8;
        digest_with(hardware, ""::*u8, 0, ?digest[0]);
        if (!hex_matches(?digest[0], "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")) { ret 1; }
        digest_with(hardware, "abc"::*u8, 3, ?digest[0]);
        if (!hex_matches(?digest[0], "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")) { ret 2; }
        val two: str = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
        digest_with(hardware, two::*u8, 56, ?digest[0]);
        if (!hex_matches(?digest[0], "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")) { ret 3; }
        val four: str = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
        digest_with(hardware, four::*u8, 112, ?digest[0]);
        if (!hex_matches(?digest[0], "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")) { ret 4; }
        # one million 'a', fed as 64-byte blocks plus a tail
        var block: [64]u8;
        var i:     usize = 0;
        for (i < 64) {
            block[i] = 97;
            i        = i + 1;
        }
        var s: State = init();
        s.total = 1000000;
        var fed: usize = 0;
        for (fed + 64 <= 1000000) {
            if (hardware) { compress_hardware(?s, ?block[0]); }
            or            { compress_portable(?s, ?block[0]); }
            fed = fed + 64;
        }
        memory.raw_copy(?s.buf[0], ?block[0], 1000000 - fed);
        s.buf_len = 1000000 - fed;
        val saved: i64 = atomic.load(?backend);
        if (hardware) { atomic.store(?backend, BACKEND_HARDWARE); }
        or            { atomic.store(?backend, BACKEND_PORTABLE); }
        final(?s, ?digest[0]);
        atomic.store(?backend, saved);
        if (!hex_matches(?digest[0], "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")) { ret 5; }
        # the length boundaries around the padding block
        var buf: [130]u8;
        i = 0;
        for (i < 130) {
            buf[i] = (i * 7 + 3)::u8;
            i      = i + 1;
        }
        val lengths: [7]usize = [7]usize{55, 56, 57, 63, 64, 65, 128};
        var n:       usize    = 0;
        for (n < 7) {
            var expected: [32]u8;
            hash(?buf[0], lengths[n], ?expected[0]);
            digest_with(hardware, ?buf[0], lengths[n], ?digest[0]);
            i = 0;
            for (i < 32) {
                if (digest[i] != expected[i]) { ret 10 + n::i32; }
                i = i + 1;
            }
            n = n + 1;
        }
        ret 0;
    }

    test "sha256: known answers through the portable backend" {
        ret known_answers(false);
    }

    test "sha256: known answers through the hardware backend" {
        if (!accelerated()) { ret 0; }
        ret known_answers(true);
    }

    test "sha256: the hardware backend matches the portable one over random inputs" {
        if (!accelerated()) { ret 0; }
        var buf:   [1024]u8;
        var seed:  u64   = 0x9e3779b97f4a7c15;
        var round: usize = 0;
        for (round < 200) {
            seed = seed * 6364136223846793005 + 1442695040888963407;
            val len: usize = (seed >> 33)::usize % 1024;
            var i:   usize = 0;
            for (i < len) {
                seed   = seed * 6364136223846793005 + 1442695040888963407;
                buf[i] = (seed >> 56)::u8;
                i      = i + 1;
            }
            var a: [32]u8;
            var b: [32]u8;
            digest_with(false, ?buf[0], len, ?a[0]);
            digest_with(true, ?buf[0], len, ?b[0]);
            i = 0;
            for (i < 32) {
                if (a[i] != b[i]) { ret 1; }
                i = i + 1;
            }
            round = round + 1;
        }
        ret 0;
    }

    test "sha256: the dispatcher's choice is stable and matches the processor" {
        val first:  bool = accelerated();
        val second: bool = accelerated();
        if (first != second)                             { ret 1; }
        if (first != hardware_available(cpu.features())) { ret 2; }
        ret 0;
    }

    $if (capability.HAS_CLOCK) {
        fun nanos() u64 {
            var ts: os.Timespec;
            if (os.monotonic(?ts) < 0) { ret 0; }
            ret ts.sec::u64 * 1000000000 + ts.nsec::u64;
        }

        # ns per byte through one backend over a 4 MiB buffer, best of 5
        fun bench(hardware: bool, buf: *u8, len: usize) u64 {
            var best:  u64   = ~(0::u64);
            var round: usize = 0;
            for (round < 5) {
                var s:     State = init();
                val start: u64   = nanos();
                var off:   usize = 0;
                for (off + 64 <= len) {
                    if (hardware) { compress_hardware(?s, ?buf[off]); }
                    or            { compress_portable(?s, ?buf[off]); }
                    off = off + 64;
                }
                val took: u64 = nanos() - start;
                if (took < best) { best = took; }
                round = round + 1;
            }
            # hundredths of a nanosecond per byte
            ret best * 100 / len::u64;
        }

        # prints the numbers test/sha256/verify.sh collects. it never fails on
        # speed, since a loaded runner is not a defect
        test "sha256: benchmark ns per byte" {
            val len: usize = 4 << 20;
            var buf: [4194304]u8;
            var i:   usize = 0;
            for (i < len) {
                buf[i] = (i * 31)::u8;
                i      = i + 1;
            }
            val portable: u64 = bench(false, ?buf[0], len);
            print.eprintlnf("sha256 bench accelerated={} portable={}.{:02} ns/byte", accelerated(), portable / 100, portable % 100);
            if (accelerated()) {
                val hardware: u64 = bench(true, ?buf[0], len);
                print.eprintlnf("sha256 bench hardware={}.{:02} ns/byte speedup={}.{:01}x", hardware / 100, hardware % 100, portable / hardware, (portable * 10 / hardware) % 10);
            }
            ret 0;
        }
    }
}
