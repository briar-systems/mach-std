# Adler-32 checksum
#
# the rolling checksum carried by zlib streams (RFC 1950). two 16-bit sums
# modulo 65521 packed into one u32. this is an error-detecting checksum, not a
# cryptographic hash, and must never be used to authenticate data.

use std.types.size.usize;
use std.types.string.str;

# largest prime below 65536
val BASE: u32 = 65521;

# bytes that can be folded before the high sum can overflow a u32
val NMAX: usize = 5552;

# seed value for an incremental checksum
# ---
# ret: the initial running state
pub fun init() u32 {
    ret 1;
}

# fold len bytes into a running checksum
# ---
# sum:  running state from init or a previous update
# data: pointer to the bytes to fold in
# len:  number of bytes
# ret:  updated running state
pub fun update(sum: u32, data: *u8, len: usize) u32 {
    if (data == nil) { ret sum; }

    var lo: u32 = sum & 0xFFFF;
    var hi: u32 = (sum >> 16) & 0xFFFF;

    var i: usize = 0;
    for (i < len) {
        # fold at most NMAX bytes between reductions so hi cannot overflow
        var run: usize = len - i;
        if (run > NMAX) { run = NMAX; }

        val end: usize = i + run;
        for (i < end) {
            lo = lo + data[i]::u32;
            hi = hi + lo;
            i = i + 1;
        }

        lo = lo % BASE;
        hi = hi % BASE;
    }

    ret (hi << 16) | lo;
}

# compute the checksum of a buffer in one call
# ---
# data: pointer to the bytes to checksum
# len:  number of bytes
# ret:  the checksum value
pub fun hash(data: *u8, len: usize) u32 {
    ret update(init(), data, len);
}

test "adler32: empty input is 1" {
    if (hash(nil, 0) != 1) { ret 1; }
    ret 0;
}

test "adler32: check value for Wikipedia" {
    val s: str = "Wikipedia";
    if (hash(s::*u8, 9) != 0x11E60398) { ret 1; }
    ret 0;
}

test "adler32: single byte a" {
    val s: str = "a";
    if (hash(s::*u8, 1) != 0x00620062) { ret 1; }
    ret 0;
}

test "adler32: abc" {
    val s: str = "abc";
    if (hash(s::*u8, 3) != 0x024D0127) { ret 1; }
    ret 0;
}

test "adler32: incremental update matches one-shot" {
    val s: str = "Wikipedia";
    var c: u32 = init();
    c = update(c, s::*u8, 4);
    c = update(c, ?s[4], 5);
    if (c != 0x11E60398) { ret 1; }
    ret 0;
}

var big: [16384]u8;

test "adler32: reduction boundary beyond NMAX bytes" {
    var i: usize = 0;
    for (i < 16384) {
        big[i] = (i & 0xFF)::u8;
        i = i + 1;
    }

    # folding in one call must match folding in pieces that straddle NMAX
    val whole: u32 = hash(?big[0], 16384);
    var c: u32 = init();
    c = update(c, ?big[0], 5000);
    c = update(c, ?big[5000], 6000);
    c = update(c, ?big[11000], 5384);
    if (c != whole) { ret 1; }
    ret 0;
}

test "adler32: update with nil is a no-op" {
    val c: u32 = init();
    if (update(c, nil, 10) != c) { ret 1; }
    ret 0;
}
