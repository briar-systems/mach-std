# bounded windows IOCP backend and overlapped socket operations

$if ($mach.build.os != $mach.os.windows) {
    $error("std.net.async.windows: requires windows target");
}

use std.allocator;
use std.allocator.page;
use std.io.runtime;
use std.memory;
use std.memory.table;
use std.net.async.types;
use std.net.ip;
use std.sync.mutex;
use std.system.os.shared;
use std.system.os.windows;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.isize;
use std.types.size.usize;

#[library("kernel32.dll")]
ext fun GetCurrentProcess() isize;
#[library("kernel32.dll")]
ext fun GetProcessHandleCount(process: isize, count: *u32) i32;

fwd types.Vector;
fwd types.Packet;
fwd types.Token;
fwd types.NativeCompletion;

rec NativeOverlapped {
    internal:      usize;
    internal_high: usize;
    offset:        u32;
    offset_high:   u32;
    event:         usize;
}

rec NativeBuffer {
    length: u32;
    data:   *u8;
}

rec NativeMessage {
    address:        *u8;
    address_length: i32;
    buffers:        *NativeBuffer;
    buffer_count:   u32;
    control:        NativeBuffer;
    flags:          u32;
}

val MAX_VECTORS: usize = 16;

# a socket the backend has associated with the completion port, and the opening
# of the handle it was associated for
rec Attachment {
    socket:  usize;
    opening: u64;
}

# every field touched by the kernel is stable until its IOCP packet is consumed
pub rec Operation {
    overlapped:     NativeOverlapped;
    state:          u8;
    kind:           runtime.Kind;
    generation:     u32;
    resource:       usize;
    opening:        u64;
    auxiliary:      usize;
    context:        usize;
    buffer:         NativeBuffer;
    vectors:        [16]NativeBuffer;
    vector_count:   usize;
    peer:           *ip.Endpoint;
    packets:        *types.Packet;
    packet_count:   usize;
    packet_index:   usize;
    batch_bytes:    usize;
    address:        [288]u8;
    address_length: i32;
    control:        [128]u8;
    message:        NativeMessage;
    transferred:    u32;
    native_flags:   u32;
    sequence:       u64;
    result:         i64;
    index:          u32;
    next_free:      u32;
}

pub rec Backend {
    # submission order of read-lane requests
    next_sequence: u64;
    queue:         *shared.IoQueue;
    source_id:     u16;
    # where every table's chunks come from
    allocator:       allocator.Allocator;
    operations:      table.Table;
    attached:        table.Table;
    preserved:       table.Table;
    completions:     table.Table;
    native:          *windows.IoCompletion;
    operation_slots: usize;
    attached_slots:  usize;
    free_operation:  u32;
    active:          usize;
    ready:           usize;
    attached_count:  usize;
    lock:            mutex.Mutex;
    io_lock:         mutex.Mutex;
    # slots and attachments examined by scans, for the scaling tests
    steps: u64;
}

val NONE: u32 = 0xffffffff;
# readiness is harvested in fixed batches, so the batch is not a capacity
val NATIVE_BATCH: usize = 256;

fun operation_at(backend: *Backend, index: usize) *Operation {
    ret table.at(?backend.operations, index)::*Operation;
}

fun attached_at(backend: *Backend, index: usize) *Attachment {
    ret table.at(?backend.attached, index)::*Attachment;
}

fun preserved_at(backend: *Backend, index: usize) *windows.IoCompletion {
    ret table.at(?backend.preserved, index)::*windows.IoCompletion;
}

fun completion_at(backend: *Backend, index: usize) *types.NativeCompletion {
    ret table.at(?backend.completions, index)::*types.NativeCompletion;
}

pub fun aliases(backend: *Backend, data: *u8, len: usize) bool {
    if (!memory.range_valid(data, len)) { ret true; }
    if (len == 0)                       { ret false; }
    if (!memory.range_valid(backend::*u8, $size_of(Backend)) ||
        backend.queue == nil || backend.operations.capacity == 0) {
        ret true;
    }
    var native_bytes: usize = 0;
    if (!memory.range_scaled(NATIVE_BATCH, $size_of(windows.IoCompletion),
        ?native_bytes)) { ret true; }
    ret memory.ranges_overlap(backend::*u8, $size_of(Backend), data, len) ||
        memory.ranges_overlap(backend.queue::*u8, $size_of(shared.IoQueue),
        data, len) ||
        table.aliases(?backend.operations, data, len) ||
        table.aliases(?backend.attached, data, len) ||
        table.aliases(?backend.preserved, data, len) ||
        table.aliases(?backend.completions, data, len) ||
        memory.ranges_overlap(backend.native::*u8, native_bytes, data, len);
}

val SLOT_FREE:            u8 = 0;
val SLOT_ACTIVE:          u8 = 1;
val SLOT_CANCELLED:       u8 = 2;
val SLOT_CANCEL_READY:    u8 = 3;
val SLOT_CONTROL_PENDING: u8 = 4;
val SLOT_CONTROL_READY:   u8 = 5;
# a read-lane request held back so it posts in submission order
val SLOT_DEFERRED:    u8    = 6;
val INVALID_SOCKET:   usize = (-1)::usize;
val MESSAGE_TOO_LONG: i64   = -90;
val MSG_TRUNC:        u32   = 0x0100;
val IP_PKTINFO:       i32   = 19;
val IPV6_PKTINFO:     i32   = 19;

fun invalid() i64 {
    ret windows.EINVAL;
}

fun zero_overlapped(overlapped: *NativeOverlapped) {
    overlapped.internal      = 0;
    overlapped.internal_high = 0;
    overlapped.offset        = 0;
    overlapped.offset_high   = 0;
    overlapped.event         = 0;
}

fun operation_for(backend: *Backend, token: types.Token) *Operation {
    if (token.index::usize >= backend.operation_slots) { ret nil; }
    val operation: *Operation = operation_at(backend, token.index::usize);
    if (operation.state == SLOT_FREE || operation.generation != token.generation) { ret nil; }
    ret operation;
}

fun operation_from_context(backend: *Backend, context: usize) *Operation {
    val offset: usize = $offset_of(Operation, overlapped);
    if (context < offset) { ret nil; }
    val index: usize = table.index_of(?backend.operations, context - offset);
    if (index == table.NO_INDEX || index >= backend.operation_slots) { ret nil; }
    val operation: *Operation = operation_at(backend, index);
    if (operation.state == SLOT_FREE) { ret nil; }
    ret operation;
}

fun clear_borrowed(operation: *Operation) {
    operation.buffer.data   = nil;
    operation.buffer.length = 0;
    var i: usize = 0;
    for (i < operation.vector_count && i < MAX_VECTORS) {
        operation.vectors[i].data   = nil;
        operation.vectors[i].length = 0;
        i                           = i + 1;
    }
    operation.vector_count         = 0;
    operation.peer                 = nil;
    operation.packets              = nil;
    operation.packet_count         = 0;
    operation.packet_index         = 0;
    operation.message.address      = nil;
    operation.message.buffers      = nil;
    operation.message.control.data = nil;
}

# the completion and preserved tables track the operation table, so publishing
# and preserving a completion always have somewhere to land
fun operation_append(backend: *Backend) bool {
    if (backend.operation_slots > 0xffffffff) { ret false; }
    if (backend.operation_slots == backend.operations.capacity &&
        !table.grow(?backend.operations)) { ret false; }
    if (!table.reserve(?backend.completions, backend.operations.capacity) ||
        !table.reserve(?backend.preserved, backend.operations.capacity)) { ret false; }
    val index: usize      = backend.operation_slots;
    val entry: *Operation = operation_at(backend, index);
    entry.state             = SLOT_FREE;
    entry.generation        = 0;
    entry.index             = index::u32;
    entry.resource          = INVALID_SOCKET;
    entry.auxiliary         = INVALID_SOCKET;
    entry.vector_count      = 0;
    entry.peer              = nil;
    entry.packets           = nil;
    entry.buffer.data       = nil;
    entry.buffer.length     = 0;
    entry.next_free         = backend.free_operation;
    backend.free_operation  = index::u32;
    backend.operation_slots = index + 1;
    ret true;
}

fun claim_locked(backend: *Backend, kind: runtime.Kind, resource: usize, opening: u64, context: usize, token: *types.Token) *Operation {
    if (backend.free_operation == NONE && !operation_append(backend)) { ret nil; }
    val index:     usize      = backend.free_operation::usize;
    val operation: *Operation = operation_at(backend, index);
    backend.free_operation = operation.next_free;
    var generation: u32 = operation.generation + 1;
    if (generation == 0) { generation = 1; }
    zero_overlapped(?operation.overlapped);
    operation.state        = SLOT_ACTIVE;
    operation.kind         = kind;
    operation.generation   = generation;
    operation.resource     = resource;
    operation.opening      = opening;
    operation.auxiliary    = INVALID_SOCKET;
    operation.context      = context;
    operation.vector_count = 0;
    operation.peer         = nil;
    operation.packets      = nil;
    operation.packet_count = 0;
    operation.packet_index = 0;
    operation.batch_bytes  = 0;
    operation.transferred  = 0;
    operation.native_flags = 0;
    operation.result       = 0;
    operation.sequence     = backend.next_sequence;
    backend.next_sequence  = backend.next_sequence + 1;
    backend.active         = backend.active + 1;
    @token                 = types.Token{index: index::u32, generation: generation};
    ret operation;
}

fun read_lane(kind: runtime.Kind) bool {
    ret kind == runtime.READ || kind == runtime.READABLE;
}

fun release_locked(backend: *Backend, operation: *Operation) {
    val kind:     runtime.Kind = operation.kind;
    val resource: usize        = operation.resource;
    val opening:  u64          = operation.opening;
    release_raw_locked(backend, operation);
    if (read_lane(kind)) { start_deferred_locked(backend, resource, opening); }
}

# a readiness wait and the reads around it on one socket settle in submission
# order: a zero-byte receive posted beside a read could find the read's bytes
# already taken and report a false end of stream. other reads post at once
fun deferred_behind_locked(backend: *Backend, operation: *Operation) bool {
    var i: usize = 0;
    for (i < backend.operation_slots) {
        backend.steps = backend.steps + 1;
        val o: *Operation = operation_at(backend, i);
        if (o != operation && o.state != SLOT_FREE && o.state != SLOT_CONTROL_PENDING && o.state != SLOT_CONTROL_READY
            && o.resource == operation.resource && o.opening == operation.opening && read_lane(o.kind) && o.sequence < operation.sequence
            && (o.state == SLOT_DEFERRED || o.kind == runtime.READABLE || operation.kind == runtime.READABLE)) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun post_receive_locked(operation: *Operation) i64 {
    ret windows.sock_async_receive(operation.resource, (?operation.vectors[0])::ptr, 1, ?operation.native_flags, (?operation.overlapped)::ptr);
}

# post the socket's held read-lane requests, oldest first, while nothing older
# is still in flight
fun start_deferred_locked(backend: *Backend, resource: usize, opening: u64) {
    for (true) {
        var next: *Operation = nil;
        var i:    usize      = 0;
        for (i < backend.operation_slots) {
            backend.steps = backend.steps + 1;
            val operation: *Operation = operation_at(backend, i);
            if (operation.state == SLOT_DEFERRED && operation.resource == resource && operation.opening == opening
                && (next == nil || operation.sequence < next.sequence)) {
                next = operation;
            }
            i = i + 1;
        }
        if (next == nil || deferred_behind_locked(backend, next)) { ret; }
        next.state = SLOT_ACTIVE;
        val posted: i64 = post_receive_locked(next);
        if (posted < 0) {
            next.state  = SLOT_CONTROL_READY;
            next.result = posted;
        }
    }
}

fun release_raw_locked(backend: *Backend, operation: *Operation) {
    clear_borrowed(operation);
    operation.state        = SLOT_FREE;
    operation.resource     = INVALID_SOCKET;
    operation.auxiliary    = INVALID_SOCKET;
    operation.next_free    = backend.free_operation;
    backend.free_operation = operation.index;
    backend.active         = backend.active - 1;
}

fun has_control_locked(backend: *Backend, resource: usize, opening: u64) bool {
    var i: usize = 0;
    for (i < backend.operation_slots) {
        backend.steps = backend.steps + 1;
        val operation: *Operation = operation_at(backend, i);
        if (operation.state != SLOT_FREE && operation.resource == resource && operation.opening == opening && (operation.kind == runtime.SHUTDOWN || operation.kind == runtime.CLOSE)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun has_write_locked(backend: *Backend, resource: usize, opening: u64, except: *Operation) bool {
    var i: usize = 0;
    for (i < backend.operation_slots) {
        backend.steps = backend.steps + 1;
        val operation: *Operation = operation_at(backend, i);
        if (operation != except && operation.state != SLOT_FREE && operation.resource == resource && operation.opening == opening && operation.opening == opening && (operation.kind == runtime.WRITE || operation.kind == runtime.SEND_TO)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun has_operation_locked(backend: *Backend, resource: usize, opening: u64, except: *Operation) bool {
    var i: usize = 0;
    for (i < backend.operation_slots) {
        backend.steps = backend.steps + 1;
        val operation: *Operation = operation_at(backend, i);
        if (operation != except && operation.state != SLOT_FREE && operation.resource == resource && operation.opening == opening) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun progress_controls_locked(backend: *Backend) {
    var i: usize = 0;
    for (i < backend.operation_slots) {
        backend.steps = backend.steps + 1;
        val operation: *Operation = operation_at(backend, i);
        if (operation.state == SLOT_CONTROL_PENDING && operation.kind == runtime.SHUTDOWN && !has_write_locked(backend, operation.resource, operation.opening, operation)) {
            operation.result = windows.sock_shutdown(operation.resource, windows.SHUT_WR);
            operation.state  = SLOT_CONTROL_READY;
        }
        if (operation.state == SLOT_CONTROL_PENDING && operation.kind == runtime.CLOSE && !has_operation_locked(backend, operation.resource, operation.opening, operation)) {
            operation.state = SLOT_CONTROL_READY;
        }
        i = i + 1;
    }
}

fun push_completion_locked(
    backend: *Backend,
    context: usize,
    kind: runtime.Kind,
    bytes: usize,
    items: usize,
    resource: usize,
    status: i64,
    end_of_stream: bool,
) bool {
    if (backend.ready == backend.completions.capacity) { ret false; }
    @completion_at(backend, backend.ready) = types.NativeCompletion{
        context:       context,
        kind:          kind,
        bytes:         bytes,
        items:         items,
        resource:      resource,
        status:        status,
        end_of_stream: end_of_stream,
    };
    backend.ready = backend.ready + 1;
    ret true;
}

fun emit_control_locked(backend: *Backend) usize {
    var emitted: usize = 0;
    var i:       usize = 0;
    for (i < backend.operation_slots && backend.ready < backend.completions.capacity) {
        backend.steps = backend.steps + 1;
        val operation: *Operation = operation_at(backend, i);
        if (operation.state == SLOT_CONTROL_READY) {
            push_completion_locked(backend, operation.context, operation.kind, 0, 0, operation.resource, operation.result, false);
            release_locked(backend, operation);
            emitted = emitted + 1;
        }
        i = i + 1;
    }
    ret emitted;
}

# a control or a held request that completes can let another control progress
fun settle_controls_locked(backend: *Backend) {
    progress_controls_locked(backend);
    for (emit_control_locked(backend) > 0 && backend.ready < backend.completions.capacity) {
        progress_controls_locked(backend);
    }
}

# initial is the size the backend starts at: the operation, completion,
# preserved and attachment tables grow on demand
pub fun make(backend: *Backend, queue: *shared.IoQueue, initial: usize, source_id: u16) i64 {
    if (backend == nil || queue == nil || queue.handle == 0 || initial == 0 || source_id == 0) { ret invalid(); }
    var native_bytes: usize = 0;
    if (!memory.range_scaled(NATIVE_BATCH, $size_of(windows.IoCompletion), ?native_bytes)) { ret windows.ENOMEM; }

    val allocated: err[allocator.Error] = page.make(?backend.allocator);
    if (sel allocated.err)                                                                  { ret windows.ENOMEM; }
    if (!table.make(?backend.operations, ?backend.allocator, $size_of(Operation), initial)) { ret windows.ENOMEM; }
    if (!table.make(?backend.completions, ?backend.allocator, $size_of(types.NativeCompletion), initial) ||
        !table.make(?backend.preserved, ?backend.allocator, $size_of(windows.IoCompletion), initial) ||
        !table.make(?backend.attached, ?backend.allocator, $size_of(Attachment), initial)) {
        table.destroy(?backend.attached);
        table.destroy(?backend.preserved);
        table.destroy(?backend.completions);
        table.destroy(?backend.operations);
        ret windows.ENOMEM;
    }
    backend.native = windows.allocate(native_bytes)::*windows.IoCompletion;
    if (backend.native == nil) {
        table.destroy(?backend.attached);
        table.destroy(?backend.preserved);
        table.destroy(?backend.completions);
        table.destroy(?backend.operations);
        ret windows.ENOMEM;
    }
    backend.queue           = queue;
    backend.source_id       = source_id;
    backend.operation_slots = 0;
    backend.attached_slots  = 0;
    backend.free_operation  = NONE;
    backend.active          = 0;
    backend.ready           = 0;
    backend.attached_count  = 0;
    backend.lock            = mutex.make();
    backend.io_lock         = mutex.make();
    backend.steps           = 0;
    ret 0;
}

# the operations still pending on a socket that was closed outside the driver
# complete as closed. the close aborted their native requests, so each one's
# packet is on its way or already consumed
fun drop_stale_locked(backend: *Backend, resource: usize, opening: u64) {
    var i: usize = 0;
    for (i < backend.operation_slots) {
        backend.steps = backend.steps + 1;
        val operation: *Operation = operation_at(backend, i);
        if (operation.resource == resource && operation.opening == opening) {
            if (operation.state == SLOT_ACTIVE) {
                operation.state  = SLOT_CANCEL_READY;
                operation.result = types.STATUS_STALE;
            }
            or (operation.state == SLOT_CONTROL_PENDING || operation.state == SLOT_DEFERRED) {
                operation.state  = SLOT_CONTROL_READY;
                operation.result = types.STATUS_STALE;
            }
        }
        i = i + 1;
    }
}

# associates a socket with the completion port once per opening. a socket
# value attached under another opening belongs to a socket closed outside the
# driver: its state is dropped and the new socket is associated in its place.
# associating a socket that is still associated fails, so a handle wrapped
# twice from one live socket is refused rather than taken over
fun socket_attach(backend: *Backend, resource: usize, opening: u64) i64 {
    if (backend == nil || backend.queue == nil || resource == INVALID_SOCKET) { ret invalid(); }
    mutex.lock(?backend.lock);
    var free: usize = backend.attached_slots;
    var i:    usize = 0;
    for (i < backend.attached_slots) {
        backend.steps = backend.steps + 1;
        val entry: *Attachment = attached_at(backend, i);
        if (entry.socket == resource && entry.opening == opening) {
            mutex.unlock(?backend.lock);
            ret 0;
        }
        # openings only grow, so the older of two openings is the socket that was closed
        if (entry.socket == resource && opening < entry.opening) {
            mutex.unlock(?backend.lock);
            ret types.STATUS_STALE;
        }
        if (entry.socket == resource) {
            drop_stale_locked(backend, resource, entry.opening);
            entry.socket           = INVALID_SOCKET;
            backend.attached_count = backend.attached_count - 1;
        }
        if (free == backend.attached_slots && entry.socket == INVALID_SOCKET) { free = i; }
        i = i + 1;
    }
    if (free == backend.attached_slots) {
        if (!table.reserve(?backend.attached, free + 1)) {
            mutex.unlock(?backend.lock);
            ret windows.ENOMEM;
        }
        @attached_at(backend, free) = Attachment{socket: INVALID_SOCKET, opening: 0};
        backend.attached_slots      = free + 1;
    }
    val result: i64 = windows.io_queue_attach(backend.queue, resource, backend.source_id);
    if (result >= 0) {
        @attached_at(backend, free) = Attachment{socket: resource, opening: opening};
        backend.attached_count      = backend.attached_count + 1;
    }
    mutex.unlock(?backend.lock);
    ret result;
}

# a control submitted through a handle whose socket was closed and replaced
fun superseded_locked(backend: *Backend, resource: usize, opening: u64) bool {
    var i: usize = 0;
    for (i < backend.attached_slots) {
        backend.steps = backend.steps + 1;
        val entry: *Attachment = attached_at(backend, i);
        if (entry.socket == resource && opening < entry.opening) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun socket_detach_locked(backend: *Backend, resource: usize, opening: u64) {
    var i: usize = 0;
    for (i < backend.attached_slots) {
        backend.steps = backend.steps + 1;
        val entry: *Attachment = attached_at(backend, i);
        if (entry.socket == resource && entry.opening == opening) {
            entry.socket           = INVALID_SOCKET;
            backend.attached_count = backend.attached_count - 1;
            ret;
        }
        i = i + 1;
    }
}

fun submit_buffer(backend: *Backend, resource: usize, opening: u64, buffer: *u8, length: usize, context: usize, kind: runtime.Kind, token: *types.Token) i64 {
    if (backend == nil || token == nil || resource == INVALID_SOCKET || (buffer == nil && length != 0) || length > 0xffffffff) { ret invalid(); }
    val attached: i64 = socket_attach(backend, resource, opening);
    if (attached < 0) { ret attached; }
    mutex.lock(?backend.lock);
    if (has_control_locked(backend, resource, opening)) {
        mutex.unlock(?backend.lock);
        ret windows.ENOTCONN;
    }
    val operation: *Operation = claim_locked(backend, kind, resource, opening, context, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.ENOMEM;
    }
    operation.buffer       = NativeBuffer{length: length::u32, data: buffer};
    operation.vector_count = 1;
    operation.vectors[0]   = operation.buffer;
    var result: i64 = 0;
    if (read_lane(kind) && deferred_behind_locked(backend, operation)) {
        operation.state = SLOT_DEFERRED;
    }
    or (read_lane(kind)) {
        result = post_receive_locked(operation);
    }
    or {
        result = windows.sock_async_send(resource, (?operation.vectors[0])::ptr, 1, 0, (?operation.overlapped)::ptr);
    }
    if (result < 0) { release_raw_locked(backend, operation); }
    mutex.unlock(?backend.lock);
    ret result;
}

pub fun submit_read(backend: *Backend, resource: usize, opening: u64, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    ret submit_buffer(backend, resource, opening, buffer, length, context, runtime.READ, token);
}

# wait for the stream to be readable without a buffer: an overlapped zero-byte
# receive, settled on completion by the queued byte count
pub fun submit_readable(backend: *Backend, resource: usize, opening: u64, context: usize, token: *types.Token) i64 {
    ret submit_buffer(backend, resource, opening, nil, 0, context, runtime.READABLE, token);
}

pub fun submit_write(backend: *Backend, resource: usize, opening: u64, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    ret submit_buffer(backend, resource, opening, buffer, length, context, runtime.WRITE, token);
}

pub fun submit_write_vector(backend: *Backend, resource: usize, opening: u64, vectors: *types.Vector, count: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || resource == INVALID_SOCKET || vectors == nil || count == 0 || count > MAX_VECTORS) { ret invalid(); }
    var total: usize = 0;
    var i:     usize = 0;
    for (i < count) {
        if ((vectors[i].data == nil && vectors[i].length != 0) || vectors[i].length > 0xffffffff || total > 0xffffffff - vectors[i].length) { ret invalid(); }
        total = total + vectors[i].length;
        i     = i + 1;
    }
    val attached: i64 = socket_attach(backend, resource, opening);
    if (attached < 0) { ret attached; }
    mutex.lock(?backend.lock);
    if (has_control_locked(backend, resource, opening)) {
        mutex.unlock(?backend.lock);
        ret windows.ENOTCONN;
    }
    val operation: *Operation = claim_locked(backend, runtime.WRITE, resource, opening, context, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.ENOMEM;
    }
    operation.vector_count = count;
    i                      = 0;
    for (i < count) {
        operation.vectors[i] = NativeBuffer{length: vectors[i].length::u32, data: vectors[i].data};
        i                    = i + 1;
    }
    val result: i64 = windows.sock_async_send(resource, (?operation.vectors[0])::ptr, count, 0, (?operation.overlapped)::ptr);
    if (result < 0) { release_locked(backend, operation); }
    mutex.unlock(?backend.lock);
    ret result;
}

pub fun submit_accept(backend: *Backend, listener: usize, opening: u64, peer: *ip.Endpoint, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || listener == INVALID_SOCKET) { ret invalid(); }
    val attached: i64 = socket_attach(backend, listener, opening);
    if (attached < 0) { ret attached; }
    var local:        [128]u8;
    var local_length: u32 = 128;
    val located:      i64 = windows.sock_local_addr(listener, ?local[0], ?local_length);
    if (located < 0) { ret located; }
    val family:   i32   = ip.sockaddr_family(?local[0]);
    var accepted: usize = INVALID_SOCKET;
    val created:  i64   = windows.sock_create_flags(family, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, ?accepted);
    if (created < 0) { ret created; }
    mutex.lock(?backend.lock);
    if (has_control_locked(backend, listener, opening)) {
        mutex.unlock(?backend.lock);
        windows.sock_close(accepted);
        ret windows.ENOTCONN;
    }
    val operation: *Operation = claim_locked(backend, runtime.ACCEPT, listener, opening, context, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        windows.sock_close(accepted);
        ret windows.ENOMEM;
    }
    operation.auxiliary = accepted;
    operation.peer      = peer;
    val result: i64 = windows.sock_async_accept(listener, accepted, ?operation.address[0], 288, ?operation.transferred, (?operation.overlapped)::ptr);
    if (result < 0) {
        windows.sock_close(accepted);
        release_locked(backend, operation);
    }
    mutex.unlock(?backend.lock);
    ret result;
}

fun bind_for_connect(resource: usize, peer: ip.Endpoint) i64 {
    var local:        [128]u8;
    var local_length: u32 = 128;
    if (windows.sock_local_addr(resource, ?local[0], ?local_length) >= 0) {
        var endpoint: ip.Endpoint;
        if (ip.from_sockaddr(?local[0], ?endpoint) && endpoint.port != 0) { ret 0; }
    }
    var any: ip.Endpoint;
    if (peer.addr.is_v6 != 0) {
        any = ip.endpoint_v6(ip.ipv6_any(), 0, 0);
    }
    or {
        any = ip.endpoint_v4(ip.ipv4_any(), 0);
    }
    val length: usize = ip.to_sockaddr(any, ?local[0]);
    ret windows.sock_bind(resource, ?local[0], length);
}

pub fun submit_connect(backend: *Backend, resource: usize, opening: u64, peer: ip.Endpoint, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || resource == INVALID_SOCKET) { ret invalid(); }
    val bound: i64 = bind_for_connect(resource, peer);
    if (bound < 0) { ret bound; }
    val attached: i64 = socket_attach(backend, resource, opening);
    if (attached < 0) { ret attached; }
    mutex.lock(?backend.lock);
    if (has_control_locked(backend, resource, opening)) {
        mutex.unlock(?backend.lock);
        ret windows.ENOTCONN;
    }
    val operation: *Operation = claim_locked(backend, runtime.CONNECT, resource, opening, context, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.ENOMEM;
    }
    val length: usize = ip.to_sockaddr(peer, ?operation.address[0]);
    val result: i64   = windows.sock_async_connect(resource, ?operation.address[0], length, ?operation.transferred, (?operation.overlapped)::ptr);
    if (result < 0) { release_locked(backend, operation); }
    mutex.unlock(?backend.lock);
    ret result;
}

fun align_control(length: usize) usize {
    ret (length + 7) & ~7;
}

fun parse_packet_metadata(packet: *types.Packet, control: *u8, length: usize) {
    packet.has_local_destination = false;
    packet.interface_index       = 0;
    var offset: usize = 0;
    for (offset + 16 <= length) {
        val base:           usize = control::usize + offset;
        val message_length: usize = @(base::*usize);
        if (message_length < 16 || message_length > length - offset) { ret; }
        val level: i32   = @((base + 8)::*i32);
        val kind:  i32   = @((base + 12)::*i32);
        val data:  usize = base + 16;
        if (level == windows.IPPROTO_IP && kind == IP_PKTINFO && message_length >= 24) {
            val address: ip.IPv4 = ip.ipv4(@(data::*u8), @((data + 1)::*u8), @((data + 2)::*u8), @((data + 3)::*u8));
            packet.local_destination     = ip.addr_v4(address);
            packet.interface_index       = @((data + 4)::*u32);
            packet.has_local_destination = true;
        }
        or (level == windows.IPPROTO_IPV6 && kind == IPV6_PKTINFO && message_length >= 36) {
            var address6: ip.IPv6;
            var i:        usize = 0;
            for (i < 16) {
                address6.octets[i] = @((data + i)::*u8);
                i                  = i + 1;
            }
            packet.local_destination     = ip.addr_v6(address6);
            packet.interface_index       = @((data + 16)::*u32);
            packet.has_local_destination = true;
        }
        offset = offset + align_control(message_length);
    }
}

fun send_packet_metadata(packet: *types.Packet, control: *u8, length: *usize) i64 {
    @length = 0;
    if (!packet.has_local_destination && packet.interface_index == 0) { ret 0; }
    var i: usize = 0;
    for (i < 40) {
        control[i] = 0;
        i          = i + 1;
    }
    val base:   usize = control::usize;
    val family: i32   = ip.endpoint_family(packet.peer);
    if (family == windows.AF_INET) {
        if (packet.has_local_destination && packet.local_destination.is_v6 != 0) { ret invalid(); }
        @(base::*usize) = 24;
        @((base + 8)::*i32) = windows.IPPROTO_IP;
        @((base + 12)::*i32) = IP_PKTINFO;
        if (packet.has_local_destination) {
            for (i < 4) {
                @((base + 16 + i)::*u8) = packet.local_destination.v4.octets[i];
                i = i + 1;
            }
        }
        @((base + 20)::*u32) = packet.interface_index;
        @length = 24;
        ret 0;
    }
    if (family == windows.AF_INET6) {
        if (packet.has_local_destination && packet.local_destination.is_v6 == 0) { ret invalid(); }
        @(base::*usize) = 36;
        @((base + 8)::*i32) = windows.IPPROTO_IPV6;
        @((base + 12)::*i32) = IPV6_PKTINFO;
        if (packet.has_local_destination) {
            for (i < 16) {
                @((base + 16 + i)::*u8) = packet.local_destination.v6.octets[i];
                i = i + 1;
            }
        }
        @((base + 32)::*u32) = packet.interface_index;
        @length = 40;
        ret 0;
    }
    ret windows.ENOTSUP;
}

fun prepare_receive_packet(operation: *Operation) {
    val packet: *types.Packet = ?operation.packets[operation.packet_index];
    operation.buffer                 = NativeBuffer{length: packet.capacity::u32, data: packet.buffer};
    operation.address_length         = 128;
    operation.native_flags           = 0;
    operation.transferred            = 0;
    operation.message.address        = ?operation.address[0];
    operation.message.address_length = 128;
    operation.message.buffers        = ?operation.buffer;
    operation.message.buffer_count   = 1;
    operation.message.control        = NativeBuffer{length: 128, data: ?operation.control[0]};
    operation.message.flags          = 0;
    zero_overlapped(?operation.overlapped);
}

fun start_receive_packet(operation: *Operation) i64 {
    prepare_receive_packet(operation);
    ret windows.sock_async_receive_message(operation.resource, (?operation.message)::ptr, (?operation.overlapped)::ptr);
}

# the batch's later packets are taken now, while datagrams are queued, so the
# batch completes in one pass with what is available, as on the other backends
fun receive_ready_packet(operation: *Operation) i64 {
    prepare_receive_packet(operation);
    var bytes:    u32 = 0;
    val received: i64 = windows.sock_receive_message_ready(operation.resource, (?operation.message)::ptr, ?bytes);
    operation.transferred = bytes;
    ret received;
}

fun start_send_packet(operation: *Operation) i64 {
    val packet: *types.Packet = ?operation.packets[operation.packet_index];
    operation.buffer = NativeBuffer{length: packet.length::u32, data: packet.buffer};
    val address_length: usize = ip.to_sockaddr(packet.peer, ?operation.address[0]);
    var control_length: usize = 0;
    val metadata:       i64   = send_packet_metadata(packet, ?operation.control[0], ?control_length);
    if (metadata < 0) { ret metadata; }
    operation.transferred            = 0;
    operation.native_flags           = 0;
    operation.message.address        = ?operation.address[0];
    operation.message.address_length = address_length::i32;
    operation.message.buffers        = ?operation.buffer;
    operation.message.buffer_count   = 1;
    operation.message.control        = NativeBuffer{length: control_length::u32, data: ?operation.control[0]};
    if (control_length == 0) { operation.message.control.data = nil; }
    operation.message.flags = 0;
    zero_overlapped(?operation.overlapped);
    ret windows.sock_async_send_message(operation.resource, (?operation.message)::ptr, 0, (?operation.overlapped)::ptr);
}

fun validate_packets(packets: *types.Packet, count: usize, sending: bool) i64 {
    if (packets == nil || count == 0) { ret invalid(); }
    var i: usize = 0;
    for (i < count) {
        if (packets[i].capacity > 0xffffffff || (packets[i].buffer == nil && packets[i].capacity != 0)) { ret invalid(); }
        if (sending) {
            val length: usize = packets[i].length;
            if (length > 0xffffffff || length > packets[i].capacity || (packets[i].buffer == nil && length != 0)) { ret invalid(); }
            val family: i32 = ip.endpoint_family(packets[i].peer);
            if (family != windows.AF_INET && family != windows.AF_INET6) { ret windows.ENOTSUP; }
        }
        i = i + 1;
    }
    ret 0;
}

fun submit_packets(backend: *Backend, resource: usize, opening: u64, packets: *types.Packet, count: usize, context: usize, kind: runtime.Kind, token: *types.Token) i64 {
    if (backend == nil || token == nil || resource == INVALID_SOCKET) { ret invalid(); }
    val valid: i64 = validate_packets(packets, count, kind == runtime.SEND_TO);
    if (valid < 0) { ret valid; }
    if (kind == runtime.RECEIVE_FROM) {
        var local:        [128]u8;
        var local_length: u32 = 128;
        val located:      i64 = windows.sock_local_addr(resource, ?local[0], ?local_length);
        if (located < 0) { ret located; }
        val configured: i64 = configure_datagram(resource, ip.sockaddr_family(?local[0]));
        if (configured < 0) { ret configured; }
    }
    val attached: i64 = socket_attach(backend, resource, opening);
    if (attached < 0) { ret attached; }
    mutex.lock(?backend.lock);
    if (has_control_locked(backend, resource, opening)) {
        mutex.unlock(?backend.lock);
        ret windows.ENOTCONN;
    }
    val operation: *Operation = claim_locked(backend, kind, resource, opening, context, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.ENOMEM;
    }
    operation.packets      = packets;
    operation.packet_count = count;
    operation.packet_index = 0;
    var result: i64 = 0;
    if (kind == runtime.RECEIVE_FROM) { result = start_receive_packet(operation); }
    or                                { result = start_send_packet(operation); }
    if (result < 0)                   { release_locked(backend, operation); }
    mutex.unlock(?backend.lock);
    ret result;
}

pub fun submit_receive_batch(backend: *Backend, resource: usize, opening: u64, packets: *types.Packet, count: usize, context: usize, token: *types.Token) i64 {
    ret submit_packets(backend, resource, opening, packets, count, context, runtime.RECEIVE_FROM, token);
}

pub fun submit_send_batch(backend: *Backend, resource: usize, opening: u64, packets: *types.Packet, count: usize, context: usize, token: *types.Token) i64 {
    ret submit_packets(backend, resource, opening, packets, count, context, runtime.SEND_TO, token);
}

fun configure_datagram(resource: usize, family: i32) i64 {
    var enabled: i32 = 1;
    if (family == windows.AF_INET)  { ret windows.sock_setopt(resource, windows.IPPROTO_IP, IP_PKTINFO, (?enabled)::*u8, 4); }
    if (family == windows.AF_INET6) { ret windows.sock_setopt(resource, windows.IPPROTO_IPV6, IPV6_PKTINFO, (?enabled)::*u8, 4); }
    ret windows.ENOTSUP;
}

pub fun submit_shutdown_write(backend: *Backend, resource: usize, opening: u64, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || resource == INVALID_SOCKET) { ret invalid(); }
    mutex.lock(?backend.lock);
    if (superseded_locked(backend, resource, opening)) {
        mutex.unlock(?backend.lock);
        ret types.STATUS_STALE;
    }
    if (has_control_locked(backend, resource, opening)) {
        mutex.unlock(?backend.lock);
        ret windows.EBUSY;
    }
    val operation: *Operation = claim_locked(backend, runtime.SHUTDOWN, resource, opening, context, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.ENOMEM;
    }
    operation.state = SLOT_CONTROL_PENDING;
    progress_controls_locked(backend);
    mutex.unlock(?backend.lock);
    windows.io_queue_wake(backend.queue);
    ret 0;
}

pub fun submit_close(backend: *Backend, resource: usize, opening: u64, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || resource == INVALID_SOCKET) { ret invalid(); }
    mutex.lock(?backend.lock);
    if (superseded_locked(backend, resource, opening)) {
        mutex.unlock(?backend.lock);
        ret types.STATUS_STALE;
    }
    if (has_control_locked(backend, resource, opening)) {
        mutex.unlock(?backend.lock);
        ret windows.EBUSY;
    }
    val operation: *Operation = claim_locked(backend, runtime.CLOSE, resource, opening, context, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.ENOMEM;
    }
    operation.state = SLOT_CONTROL_PENDING;
    var i: usize = 0;
    for (i < backend.operation_slots) {
        backend.steps = backend.steps + 1;
        val pending: *Operation = operation_at(backend, i);
        if (pending != operation && pending.state == SLOT_ACTIVE && pending.resource == resource && pending.opening == opening) {
            windows.io_queue_cancel(resource, (?pending.overlapped)::ptr);
            pending.state  = SLOT_CANCEL_READY;
            pending.result = windows.ECANCELED;
        }
        or (pending.state == SLOT_DEFERRED && pending.resource == resource && pending.opening == opening) {
            pending.state  = SLOT_CONTROL_READY;
            pending.result = windows.ECANCELED;
        }
        i = i + 1;
    }
    operation.result = windows.sock_close(resource);
    socket_detach_locked(backend, resource, opening);
    progress_controls_locked(backend);
    mutex.unlock(?backend.lock);
    windows.io_queue_wake(backend.queue);
    ret 0;
}

fun restore_preserved(backend: *Backend, count: usize, wake: bool) i64 {
    var result: i64   = 0;
    var i:      usize = 0;
    for (i < count) {
        val restored: i64 = windows.io_queue_restore(backend.queue, @preserved_at(backend, i));
        if (result >= 0 && restored < 0) { result = restored; }
        i = i + 1;
    }
    if (wake) {
        val restored_wake: i64 = windows.io_queue_wake(backend.queue);
        if (result >= 0 && restored_wake < 0) { result = restored_wake; }
    }
    ret result;
}

# successful cancellation synchronously ends all native access to borrowed data
pub fun cancel(backend: *Backend, token: types.Token) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    val operation: *Operation = operation_for(backend, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.EBADF;
    }
    if (operation.state == SLOT_CONTROL_PENDING || operation.state == SLOT_CONTROL_READY || operation.state == SLOT_DEFERRED) {
        release_locked(backend, operation);
        mutex.unlock(?backend.lock);
        windows.io_queue_wake(backend.queue);
        ret 0;
    }
    if (operation.state != SLOT_ACTIVE && operation.state != SLOT_CANCEL_READY) {
        mutex.unlock(?backend.lock);
        ret windows.EBADF;
    }
    # a close already asked the kernel to abort a cancel-ready operation, and
    # its packet is still owed, so both states wait for that packet below
    if (operation.state == SLOT_ACTIVE) {
        val cancelled: i64 = windows.io_queue_cancel(operation.resource, (?operation.overlapped)::ptr);
        if (cancelled < 0) {
            mutex.unlock(?backend.lock);
            ret cancelled;
        }
    }
    operation.state = SLOT_CANCELLED;
    val context: usize = (?operation.overlapped)::usize;
    mutex.unlock(?backend.lock);

    mutex.lock(?backend.io_lock);
    mutex.lock(?backend.lock);
    val pending: *Operation = operation_for(backend, token);
    if (pending == nil) {
        mutex.unlock(?backend.lock);
        mutex.unlock(?backend.io_lock);
        ret 0;
    }
    if (pending.state != SLOT_CANCELLED) {
        mutex.unlock(?backend.lock);
        mutex.unlock(?backend.io_lock);
        ret windows.EBADF;
    }
    mutex.unlock(?backend.lock);

    var found:           bool  = false;
    var preserved_count: usize = 0;
    var preserved_wake:  bool  = false;
    var result:          i64   = 0;
    for (!found && result >= 0) {
        var native: windows.IoCompletion;
        val count:  i64 = windows.io_queue_poll(backend.queue, ?native, 1, -1);
        if (count < 0)  { result = count; }
        or (count == 0) { result = windows.EIO; }
        or (native.context == context) {
            found = true;
        }
        or ((native.events & windows.IO_EVENT_WAKE) != 0) {
            preserved_wake = true;
        }
        or (preserved_count == backend.preserved.capacity) {
            result = windows.ENOMEM;
        }
        or {
            @preserved_at(backend, preserved_count) = native;
            preserved_count                         = preserved_count + 1;
        }
    }
    if (found) {
        mutex.lock(?backend.lock);
        val completed: *Operation = operation_for(backend, token);
        if (completed != nil && completed.state == SLOT_CANCELLED) {
            if (completed.kind == runtime.ACCEPT && completed.auxiliary != INVALID_SOCKET) {
                windows.sock_close(completed.auxiliary);
                completed.auxiliary = INVALID_SOCKET;
            }
            release_locked(backend, completed);
        }
        mutex.unlock(?backend.lock);
    }
    val restored: i64 = restore_preserved(backend, preserved_count, preserved_wake);
    mutex.unlock(?backend.io_lock);
    if (result < 0) { ret result; }
    ret restored;
}

fun emit_operation_locked(backend: *Backend, operation: *Operation, status: i64, bytes: usize) {
    var result:             i64   = status;
    var completed_bytes:    usize = 0;
    var completed_resource: usize = operation.resource;
    var end_of_stream:      bool  = false;
    if (status >= 0 && operation.kind == runtime.ACCEPT) {
        val accepted_context: i64 = windows.sock_accept_context(operation.auxiliary, operation.resource);
        if (accepted_context < 0) {
            windows.sock_close(operation.auxiliary);
            operation.auxiliary = INVALID_SOCKET;
            result              = accepted_context;
        }
        or {
            if (operation.peer != nil) {
                var peer_length: u32 = 128;
                val located:     i64 = windows.sock_remote_addr(operation.auxiliary, ?operation.address[0], ?peer_length);
                if (located < 0 || !ip.from_sockaddr(?operation.address[0], operation.peer)) {
                    windows.sock_close(operation.auxiliary);
                    operation.auxiliary = INVALID_SOCKET;
                    result              = windows.ENOTSUP;
                    if (located < 0) { result = located; }
                }
            }
        }
        if (result >= 0) {
            completed_resource  = operation.auxiliary;
            operation.auxiliary = INVALID_SOCKET;
            result              = 0;
        }
        or {
            completed_resource = INVALID_SOCKET;
        }
    }
    or (status >= 0 && operation.kind == runtime.CONNECT) {
        result = windows.sock_connect_context(operation.resource);
    }
    or (status >= 0 && operation.kind == runtime.READABLE) {
        # a zero-byte receive completes on data, orderly close or error, and
        # cannot tell data from close: the queued byte count settles it
        var queued: usize = 0;
        result = windows.sock_pending_bytes(operation.resource, ?queued);
        if (result >= 0) {
            result        = 0;
            end_of_stream = queued == 0;
        }
    }
    or (status >= 0 && (operation.kind == runtime.READ || operation.kind == runtime.WRITE)) {
        result          = 0;
        completed_bytes = bytes;
        end_of_stream   = operation.kind == runtime.READ && bytes == 0 && operation.buffer.length != 0;
    }
    if (status < 0 && operation.kind == runtime.ACCEPT && operation.auxiliary != INVALID_SOCKET) {
        windows.sock_close(operation.auxiliary);
        operation.auxiliary = INVALID_SOCKET;
    }
    push_completion_locked(backend, operation.context, operation.kind, completed_bytes, 0, completed_resource, result, end_of_stream);
    release_locked(backend, operation);
}

fun record_received_packet(operation: *Operation, bytes: usize, flags: u32, truncated: bool) i64 {
    val packet: *types.Packet = ?operation.packets[operation.packet_index];
    var copied: usize         = bytes;
    if (truncated && copied == 0)                               { copied = packet.capacity; }
    if (operation.batch_bytes > (-1)::usize - copied)           { ret invalid(); }
    if (!ip.from_sockaddr(?operation.address[0], ?packet.peer)) { ret windows.ENOTSUP; }
    packet.length      = copied;
    packet.truncated   = truncated || (operation.message.flags & MSG_TRUNC) != 0 || (flags & MSG_TRUNC) != 0;
    packet.zero_length = copied == 0;
    parse_packet_metadata(packet, ?operation.control[0], operation.message.control.length::usize);
    operation.batch_bytes  = operation.batch_bytes + copied;
    operation.packet_index = operation.packet_index + 1;
    ret 0;
}

fun finish_receive_packet_locked(backend: *Backend, operation: *Operation, status: i64, bytes: usize, flags: u32) {
    var result: i64 = status;
    if (result >= 0 || result == MESSAGE_TOO_LONG) {
        result = record_received_packet(operation, bytes, flags, result == MESSAGE_TOO_LONG);
    }
    # a batch completes with what is available: after its first packet it
    # takes only datagrams that are already queued, and never waits for more
    for (result >= 0 && operation.packet_index < operation.packet_count) {
        var queued:  usize = 0;
        val checked: i64   = windows.sock_pending_bytes(operation.resource, ?queued);
        if (checked < 0 || queued == 0) { brk; }
        val next: i64 = receive_ready_packet(operation);
        if (next < 0 && next != MESSAGE_TOO_LONG) { brk; }
        result = record_received_packet(operation, operation.transferred::usize, 0, next == MESSAGE_TOO_LONG);
    }
    if (result < 0 && operation.packet_index != 0) { result = 0; }
    push_completion_locked(backend, operation.context, operation.kind, operation.batch_bytes, operation.packet_index, operation.resource, result, false);
    release_locked(backend, operation);
}

fun finish_send_packet_locked(backend: *Backend, operation: *Operation, status: i64, bytes: usize) {
    var result: i64 = status;
    if (result >= 0 && bytes != operation.packets[operation.packet_index].length) { result = windows.EIO; }
    if (result >= 0) {
        if (operation.batch_bytes > (-1)::usize - bytes) { result = invalid(); }
        or {
            operation.batch_bytes  = operation.batch_bytes + bytes;
            operation.packet_index = operation.packet_index + 1;
        }
    }
    if (result >= 0 && operation.packet_index < operation.packet_count) {
        val next: i64 = start_send_packet(operation);
        if (next >= 0) { ret; }
        result = next;
    }
    if (result < 0 && operation.packet_index != 0) { result = 0; }
    push_completion_locked(backend, operation.context, operation.kind, operation.batch_bytes, operation.packet_index, operation.resource, result, false);
    release_locked(backend, operation);
}

fun consume_native_locked(backend: *Backend, native: windows.IoCompletion) {
    if ((native.events & windows.IO_EVENT_WAKE) != 0) { ret; }
    val operation: *Operation = operation_from_context(backend, native.context);
    if (operation == nil) { ret; }
    if (operation.state == SLOT_CANCELLED) {
        release_locked(backend, operation);
        ret;
    }
    if (operation.state == SLOT_CANCEL_READY) {
        emit_operation_locked(backend, operation, operation.result, 0);
        ret;
    }
    if (operation.state != SLOT_ACTIVE) { ret; }
    var bytes:    u32 = native.flags::u32;
    var flags:    u32 = operation.native_flags;
    val observed: i64 = windows.sock_async_result(operation.resource, (?operation.overlapped)::ptr, ?bytes, ?flags, false);
    var status:   i64 = observed;
    # the driver's own cancels leave the active state first, so an aborted
    # request that is still active was aborted by a close outside the driver
    if (observed == windows.ECANCELED || observed == windows.ENOTSOCK) { status = types.STATUS_STALE; }
    if (operation.kind == runtime.RECEIVE_FROM) {
        finish_receive_packet_locked(backend, operation, status, bytes::usize, flags);
    }
    or (operation.kind == runtime.SEND_TO) {
        finish_send_packet_locked(backend, operation, status, bytes::usize);
    }
    or {
        emit_operation_locked(backend, operation, status, bytes::usize);
    }
}

pub fun flush(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    backend.ready = 0;
    settle_controls_locked(backend);
    val ready: usize = backend.ready;
    mutex.unlock(?backend.lock);
    ret ready::i64;
}

pub fun dispatch(
    backend: *Backend,
    context: usize,
    events: u32,
    status: i64,
    flags: u64,
    claimed: *bool,
) i64 {
    if (backend == nil || claimed == nil) { ret invalid(); }
    @claimed = false;
    mutex.lock(?backend.lock);
    val operation: *Operation = operation_from_context(backend, context);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret 0;
    }
    @claimed      = true;
    backend.ready = 0;
    consume_native_locked(backend, windows.IoCompletion{
        context: context,
        events:  events,
        status:  status,
        flags:   flags,
        source:  backend.source_id,
    });
    settle_controls_locked(backend);
    val ready: usize = backend.ready;
    mutex.unlock(?backend.lock);
    ret ready::i64;
}

# one thread owns poll and completion storage
pub fun poll(backend: *Backend, timeout_ms: i32) i64 {
    if (backend == nil || timeout_ms < -1) { ret invalid(); }
    mutex.lock(?backend.lock);
    backend.ready = 0;
    settle_controls_locked(backend);
    val immediately_ready: usize = backend.ready;
    mutex.unlock(?backend.lock);
    if (immediately_ready != 0) { ret immediately_ready::i64; }

    mutex.lock(?backend.io_lock);
    val count: i64 = windows.io_queue_poll(backend.queue, backend.native, NATIVE_BATCH, timeout_ms);
    if (count <= 0) {
        mutex.unlock(?backend.io_lock);
        ret count;
    }
    mutex.lock(?backend.lock);
    var i: usize = 0;
    for (i < count::usize && backend.ready < backend.completions.capacity) {
        consume_native_locked(backend, backend.native[i]);
        i = i + 1;
    }
    settle_controls_locked(backend);
    val ready: usize = backend.ready;
    mutex.unlock(?backend.lock);
    mutex.unlock(?backend.io_lock);
    ret ready::i64;
}

pub fun completion(backend: *Backend, index: usize, out: *types.NativeCompletion) i64 {
    if (backend == nil || out == nil || index >= backend.ready) { ret invalid(); }
    @out = @completion_at(backend, index);
    ret 0;
}

pub fun destroy(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    if (backend.active != 0) {
        mutex.unlock(?backend.lock);
        ret windows.EBUSY;
    }
    windows.deallocate(backend.native::ptr, $size_of(windows.IoCompletion) * NATIVE_BATCH);
    table.destroy(?backend.attached);
    table.destroy(?backend.preserved);
    table.destroy(?backend.completions);
    table.destroy(?backend.operations);
    backend.native          = nil;
    backend.operation_slots = 0;
    backend.attached_slots  = 0;
    backend.free_operation  = NONE;
    backend.active          = 0;
    backend.ready           = 0;
    backend.attached_count  = 0;
    backend.queue           = nil;
    backend.source_id       = 0;
    mutex.unlock(?backend.lock);
    ret 0;
}

fun test_listener(listener: *usize, endpoint: *ip.Endpoint, listening: bool) i64 {
    @listener = INVALID_SOCKET;
    val created: i64 = windows.sock_create_flags(windows.AF_INET, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, listener);
    if (created < 0) { ret created; }
    var address: [128]u8;
    ip.to_sockaddr(ip.endpoint(127, 0, 0, 1, 0), ?address[0]);
    var status: i64 = windows.sock_bind(@listener, ?address[0], windows.SOCKADDR_IN_SIZE);
    if (status >= 0 && listening) { status = windows.sock_listen(@listener, 8); }
    var length: u32 = 128;
    if (status >= 0)                                             { status = windows.sock_local_addr(@listener, ?address[0], ?length); }
    if (status >= 0 && !ip.from_sockaddr(?address[0], endpoint)) { status = windows.ENOTSUP; }
    if (status < 0) {
        windows.sock_close(@listener);
        @listener = INVALID_SOCKET;
    }
    ret status;
}

fun test_stream_pair(listener: *usize, client: *usize, server: *usize) i64 {
    @listener = INVALID_SOCKET;
    @client   = INVALID_SOCKET;
    @server   = INVALID_SOCKET;
    var endpoint: ip.Endpoint;
    var status:   i64 = test_listener(listener, ?endpoint, true);
    if (status >= 0) { status = windows.sock_create_flags(windows.AF_INET, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, client); }
    var address: [128]u8;
    if (status >= 0) {
        val length: usize = ip.to_sockaddr(endpoint, ?address[0]);
        status = windows.sock_connect(@client, ?address[0], length);
    }
    var address_length: u32 = 128;
    if (status >= 0) { status = windows.sock_accept_flags(@listener, ?address[0], ?address_length, false, true, server); }
    if (status < 0) {
        if (@server != INVALID_SOCKET) {
            windows.sock_close(@server);
            @server = INVALID_SOCKET;
        }
        if (@client != INVALID_SOCKET) {
            windows.sock_close(@client);
            @client = INVALID_SOCKET;
        }
        if (@listener != INVALID_SOCKET) {
            windows.sock_close(@listener);
            @listener = INVALID_SOCKET;
        }
    }
    ret status;
}

fun test_handle_count(count: *u32) bool {
    ret GetProcessHandleCount(GetCurrentProcess(), count) != 0;
}

test "async windows: native operation storage is fixed" {
    if ($size_of(NativeOverlapped) != 32 || $size_of(NativeBuffer) != 16 || $size_of(NativeMessage) != 56 || MAX_VECTORS != 16) { ret 1; }
    ret 0;
}

test "async windows: IOCP stream lifecycle preserves ordering" {
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 16, 1) < 0) {
        windows.io_queue_close(?queue);
        ret 1;
    }

    var listener: usize = INVALID_SOCKET;
    var client:   usize = INVALID_SOCKET;
    if (windows.sock_create_flags(windows.AF_INET, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, ?listener) < 0 || windows.sock_create_flags(windows.AF_INET, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, ?client) < 0) {
        if (listener != INVALID_SOCKET) { windows.sock_close(listener); }
        destroy(?backend);
        windows.io_queue_close(?queue);
        ret 1;
    }
    var address: [128]u8;
    ip.to_sockaddr(ip.endpoint(127, 0, 0, 1, 0), ?address[0]);
    if (windows.sock_bind(listener, ?address[0], windows.SOCKADDR_IN_SIZE) < 0 || windows.sock_listen(listener, 8) < 0) {
        windows.sock_close(client);
        windows.sock_close(listener);
        destroy(?backend);
        windows.io_queue_close(?queue);
        ret 1;
    }
    var address_length: u32 = 128;
    if (windows.sock_local_addr(listener, ?address[0], ?address_length) < 0) {
        windows.sock_close(client);
        windows.sock_close(listener);
        destroy(?backend);
        windows.io_queue_close(?queue);
        ret 1;
    }
    var endpoint: ip.Endpoint;
    if (!ip.from_sockaddr(?address[0], ?endpoint)) {
        windows.sock_close(client);
        windows.sock_close(listener);
        destroy(?backend);
        windows.io_queue_close(?queue);
        ret 1;
    }

    var peer:          ip.Endpoint;
    var accept_token:  types.Token;
    var connect_token: types.Token;
    if (submit_accept(?backend, listener, 1, ?peer, 1, ?accept_token) < 0 || submit_connect(?backend, client, 1, endpoint, 2, ?connect_token) < 0) {
        windows.sock_close(client);
        windows.sock_close(listener);
        destroy(?backend);
        windows.io_queue_close(?queue);
        ret 1;
    }
    var accepted:  usize = INVALID_SOCKET;
    var connected: bool  = false;
    var attempts:  usize = 0;
    for (attempts < 16 && (accepted == INVALID_SOCKET || !connected)) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 16; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var done: types.NativeCompletion;
                completion(?backend, i, ?done);
                if (done.context == 1 && done.kind == runtime.ACCEPT && done.status == 0 && done.items == 0)                             { accepted = done.resource; }
                if (done.context == 2 && done.kind == runtime.CONNECT && done.status == 0 && done.resource == client && done.items == 0) { connected = true; }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    if (accepted == INVALID_SOCKET || !connected || peer.port == 0) {
        if (accepted != INVALID_SOCKET) { windows.sock_close(accepted); }
        windows.sock_close(client);
        windows.sock_close(listener);
        destroy(?backend);
        windows.io_queue_close(?queue);
        ret 1;
    }

    var read_buffer: [4]u8;
    var fragment:    [2]u8;
    fragment[0] = 'a';
    fragment[1] = 'b';
    var read_token:  types.Token;
    var write_token: types.Token;
    if (submit_read(?backend, accepted, 1, ?read_buffer[0], 4, 3, ?read_token) < 0 || submit_write(?backend, client, 1, ?fragment[0], 2, 4, ?write_token) < 0) { ret 1; }
    var read_bytes:  i64 = -1;
    var write_bytes: i64 = -1;
    attempts = 0;
    for (attempts < 16 && (read_bytes < 0 || write_bytes < 0)) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 1; }
        var i: usize = 0;
        for (i < count::usize) {
            var done: types.NativeCompletion;
            completion(?backend, i, ?done);
            if (done.context == 3 && done.status == 0 && done.items == 0) { read_bytes = done.bytes::i64; }
            if (done.context == 4 && done.status == 0 && done.items == 0) { write_bytes = done.bytes::i64; }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    if (read_bytes != 2 || write_bytes != 2 || read_buffer[0] != 'a' || read_buffer[1] != 'b') { ret 1; }

    var read_c:  u8 = 0;
    var read_d:  u8 = 0;
    var c:       u8 = 'c';
    var d:       u8 = 'd';
    var vectors: [2]types.Vector;
    vectors[0] = types.Vector{data: ?c, length: 1};
    vectors[1] = types.Vector{data: ?d, length: 1};
    var read_c_token: types.Token;
    var read_d_token: types.Token;
    var vector_token: types.Token;
    if (submit_read(?backend, accepted, 1, ?read_c, 1, 5, ?read_c_token) < 0 || submit_read(?backend, accepted, 1, ?read_d, 1, 6, ?read_d_token) < 0 || submit_write_vector(?backend, client, 1, ?vectors[0], 2, 7, ?vector_token) < 0) { ret 1; }
    var concurrent: usize = 0;
    attempts = 0;
    for (attempts < 16 && concurrent < 3) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 1; }
        var i: usize = 0;
        for (i < count::usize) {
            var done: types.NativeCompletion;
            completion(?backend, i, ?done);
            if ((done.context == 5 || done.context == 6) && done.status == 0 && done.bytes == 1 && done.items == 0) { concurrent = concurrent + 1; }
            if (done.context == 7 && done.status == 0 && done.bytes == 2 && done.items == 0)                        { concurrent = concurrent + 1; }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    if (concurrent != 3 || read_c != 'c' || read_d != 'd') { ret 1; }

    var final_byte:        u8 = 'e';
    var final_read:        u8 = 0;
    var final_write_token: types.Token;
    var shutdown_token:    types.Token;
    var final_read_token:  types.Token;
    if (submit_write(?backend, client, 1, ?final_byte, 1, 8, ?final_write_token) < 0 || submit_shutdown_write(?backend, client, 1, 9, ?shutdown_token) < 0 || submit_read(?backend, accepted, 1, ?final_read, 1, 10, ?final_read_token) < 0) { ret 1; }
    var write_seen:    bool = false;
    var shutdown_seen: bool = false;
    var final_seen:    bool = false;
    attempts = 0;
    for (attempts < 16 && (!write_seen || !shutdown_seen || !final_seen)) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 1; }
        var i: usize = 0;
        for (i < count::usize) {
            var done: types.NativeCompletion;
            completion(?backend, i, ?done);
            if (done.context == 8 && done.status == 0 && done.bytes == 1 && done.items == 0) { write_seen = true; }
            if (done.context == 9 && done.status == 0) {
                if (!write_seen) { ret 1; }
                shutdown_seen = true;
            }
            if (done.context == 10 && done.status == 0 && done.bytes == 1 && done.items == 0) { final_seen = true; }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    if (!write_seen || !shutdown_seen || !final_seen || final_read != 'e') { ret 1; }

    var eof_byte:  u8 = 0;
    var eof_token: types.Token;
    if (submit_read(?backend, accepted, 1, ?eof_byte, 1, 11, ?eof_token) < 0) { ret 1; }
    var eof_seen: bool = false;
    attempts = 0;
    for (attempts < 16 && !eof_seen) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 1; }
        var i: usize = 0;
        for (i < count::usize) {
            var done: types.NativeCompletion;
            completion(?backend, i, ?done);
            if (done.context == 11 && done.status == 0 && done.bytes == 0 && done.items == 0 && done.end_of_stream) { eof_seen = true; }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    if (!eof_seen) { ret 1; }

    var close_accepted: types.Token;
    var close_client:   types.Token;
    var close_listener: types.Token;
    if (submit_close(?backend, accepted, 1, 12, ?close_accepted) < 0 || submit_close(?backend, client, 1, 13, ?close_client) < 0 || submit_close(?backend, listener, 1, 14, ?close_listener) < 0) { ret 1; }
    var closed: usize = 0;
    attempts = 0;
    for (attempts < 16 && closed < 3) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 1; }
        var i: usize = 0;
        for (i < count::usize) {
            var done: types.NativeCompletion;
            completion(?backend, i, ?done);
            if (done.context >= 12 && done.context <= 14 && done.status == 0) { closed = closed + 1; }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    if (closed != 3 || destroy(?backend) < 0 || windows.io_queue_close(?queue) < 0) { ret 1; }
    ret 0;
}

test "async windows: cancellation quiesces borrowed accept storage" {
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 2, 1) < 0) {
        windows.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize = INVALID_SOCKET;
    if (windows.sock_create_flags(windows.AF_INET, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, ?listener) < 0) {
        destroy(?backend);
        windows.io_queue_close(?queue);
        ret 1;
    }
    var address: [128]u8;
    ip.to_sockaddr(ip.endpoint(127, 0, 0, 1, 0), ?address[0]);
    if (windows.sock_bind(listener, ?address[0], windows.SOCKADDR_IN_SIZE) < 0 || windows.sock_listen(listener, 4) < 0) {
        windows.sock_close(listener);
        destroy(?backend);
        windows.io_queue_close(?queue);
        ret 1;
    }
    var first_peer:  ip.Endpoint;
    var second_peer: ip.Endpoint;
    var third_peer:  ip.Endpoint;
    var first:       types.Token;
    var second:      types.Token;
    var third:       types.Token;
    if (submit_accept(?backend, listener, 1, ?first_peer, 20, ?first) < 0 || submit_accept(?backend, listener, 1, ?second_peer, 21, ?second) < 0) { ret 1; }
    # the table was made at two, so the third accept grows it
    if (submit_accept(?backend, listener, 1, ?third_peer, 22, ?third) < 0 || backend.operations.capacity < 3) { ret 1; }
    if (cancel(?backend, first) < 0 || cancel(?backend, second) < 0 || cancel(?backend, third) < 0)           { ret 1; }
    if (operation_at(?backend, first.index::usize).auxiliary != INVALID_SOCKET
        || operation_at(?backend, second.index::usize).auxiliary != INVALID_SOCKET
        || operation_at(?backend, third.index::usize).auxiliary != INVALID_SOCKET) {
        ret 1;
    }
    first_peer.port  = 0xffff;
    second_peer.port = 0xffff;
    third_peer.port  = 0xffff;
    var attempts: usize = 0;
    for (attempts < 16 && backend.active != 0) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 1; }
        var i: usize = 0;
        for (i < count::usize) {
            var done: types.NativeCompletion;
            completion(?backend, i, ?done);
            if (done.context >= 20 && done.context <= 22) { ret 1; }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    if (backend.active != 0 || first_peer.port != 0xffff || second_peer.port != 0xffff || third_peer.port != 0xffff) { ret 1; }
    if (poll(?backend, 1) != 0)                                                                                      { ret 1; }
    windows.sock_close(listener);
    if (destroy(?backend) < 0 || windows.io_queue_close(?queue) < 0) { ret 1; }
    ret 0;
}

test "async windows: UDP batches preserve zero truncation and destination" {
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 4, 1) < 0) {
        windows.io_queue_close(?queue);
        ret 1;
    }
    var receiver: usize = INVALID_SOCKET;
    var sender:   usize = INVALID_SOCKET;
    if (windows.sock_create_flags(windows.AF_INET, windows.SOCK_DGRAM, 0, false, true, ?receiver) < 0 || windows.sock_create_flags(windows.AF_INET, windows.SOCK_DGRAM, 0, false, true, ?sender) < 0) { ret 1; }
    var address: [128]u8;
    ip.to_sockaddr(ip.endpoint(127, 0, 0, 1, 0), ?address[0]);
    if (windows.sock_bind(receiver, ?address[0], windows.SOCKADDR_IN_SIZE) < 0) { ret 1; }
    var address_length: u32 = 128;
    if (windows.sock_local_addr(receiver, ?address[0], ?address_length) < 0) { ret 1; }
    var destination: ip.Endpoint;
    if (!ip.from_sockaddr(?address[0], ?destination)) { ret 1; }

    var zero:    u8 = 0;
    var payload: [3]u8;
    payload[0] = 'a';
    payload[1] = 'b';
    payload[2] = 'c';
    var sent: [3]types.Packet;
    sent[0].buffer                = ?zero;
    sent[0].capacity              = 1;
    sent[0].length                = 0;
    sent[0].peer                  = destination;
    sent[0].has_local_destination = false;
    sent[0].interface_index       = 0;
    sent[1].buffer                = ?payload[0];
    sent[1].capacity              = 3;
    sent[1].length                = 3;
    sent[1].peer                  = destination;
    sent[1].has_local_destination = false;
    sent[1].interface_index       = 0;
    sent[2].buffer                = ?payload[0];
    sent[2].capacity              = 3;
    sent[2].length                = 3;
    sent[2].peer                  = destination;
    sent[2].has_local_destination = false;
    sent[2].interface_index       = 0;
    var first:    u8 = 0;
    var second:   [3]u8;
    var third:    u8 = 0;
    var received: [3]types.Packet;
    received[0].buffer   = ?first;
    received[0].capacity = 1;
    received[1].buffer   = ?second[0];
    received[1].capacity = 3;
    received[2].buffer   = ?third;
    received[2].capacity = 1;
    var receive_token: types.Token;
    var send_token:    types.Token;
    if (submit_receive_batch(?backend, receiver, 1, ?received[0], 3, 30, ?receive_token) < 0 || submit_send_batch(?backend, sender, 1, ?sent[0], 3, 31, ?send_token) < 0) { ret 1; }
    var receive_done:  bool  = false;
    var send_done:     bool  = false;
    var receive_items: usize = 0;
    var send_items:    usize = 0;
    var receive_bytes: usize = 0;
    var send_bytes:    usize = 0;
    var attempts:      usize = 0;
    for (attempts < 32 && (!receive_done || !send_done)) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 1; }
        var i: usize = 0;
        for (i < count::usize) {
            var done: types.NativeCompletion;
            completion(?backend, i, ?done);
            if (done.context == 30 && done.status == 0) {
                receive_items = receive_items + done.items;
                receive_bytes = receive_bytes + done.bytes;
                # a batch completes with the datagrams already queued, so the
                # rest arrive in later batches over the remaining slots
                if (receive_items >= 3 || done.items == 0) { receive_done = true; }
                or {
                    if (submit_receive_batch(?backend, receiver, 1, ?received[receive_items], 3 - receive_items, 30, ?receive_token) < 0) { ret 1; }
                }
            }
            if (done.context == 31 && done.status == 0) {
                send_done  = true;
                send_items = done.items;
                send_bytes = done.bytes;
            }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    var failure: i32 = 0;
    if (!receive_done)                        { failure = 2; }
    or (!send_done)                           { failure = 3; }
    or (receive_items != 3)                   { failure = 4; }
    or (send_items != 3)                      { failure = 5; }
    or (receive_bytes != 4)                   { failure = 6; }
    or (send_bytes != 6)                      { failure = 7; }
    or (received[0].length != 0)              { failure = 8; }
    or (!received[0].zero_length)             { failure = 9; }
    or (received[0].truncated)                { failure = 10; }
    or (!received[0].has_local_destination)   { failure = 11; }
    or (received[0].interface_index == 0)     { failure = 12; }
    or (received[1].length != 3)              { failure = 13; }
    or (second[0] != 'a' || second[2] != 'c') { failure = 14; }
    or (received[2].length != 1)              { failure = 15; }
    or (third != 'a')                         { failure = 16; }
    or (!received[2].truncated)               { failure = 17; }
    or (received[2].zero_length)              { failure = 18; }
    var close_receiver: types.Token;
    var close_sender:   types.Token;
    if (submit_close(?backend, receiver, 1, 32, ?close_receiver) < 0 || submit_close(?backend, sender, 1, 33, ?close_sender) < 0) { ret 1; }
    var closed: usize = 0;
    attempts = 0;
    for (attempts < 16 && closed < 2) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 1; }
        var i: usize = 0;
        for (i < count::usize) {
            var done: types.NativeCompletion;
            completion(?backend, i, ?done);
            if ((done.context == 32 || done.context == 33) && done.status == 0) { closed = closed + 1; }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    if (failure == 0 && closed != 2) { failure = 19; }
    val destroyed: i64 = destroy(?backend);
    if (failure == 0 && destroyed < 0) { failure = 20; }
    val queue_closed: i64 = windows.io_queue_close(?queue);
    if (failure == 0 && queue_closed < 0) { failure = 21; }
    if (failure != 0)                     { ret failure; }
    ret 0;
}

test "async windows: refused connect reports a normalized completion" {
    var guard:    usize = INVALID_SOCKET;
    var endpoint: ip.Endpoint;
    if (test_listener(?guard, ?endpoint, false) < 0) { ret 1; }
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) {
        windows.sock_close(guard);
        ret 1;
    }
    var backend: Backend;
    if (make(?backend, ?queue, 4, 1) < 0) {
        windows.io_queue_close(?queue);
        windows.sock_close(guard);
        ret 1;
    }
    var client: usize = INVALID_SOCKET;
    if (windows.sock_create_flags(windows.AF_INET, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, ?client) < 0) {
        destroy(?backend);
        windows.io_queue_close(?queue);
        windows.sock_close(guard);
        ret 1;
    }
    var token:            types.Token;
    val submitted:        i64   = submit_connect(?backend, client, 1, endpoint, 40, ?token);
    var saw_refusal:      bool  = false;
    var completion_count: usize = 0;
    var attempts:         usize = 0;
    for (attempts < 16 && !saw_refusal) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 16; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var done: types.NativeCompletion;
                completion(?backend, i, ?done);
                if (done.context == 40) {
                    completion_count = completion_count + 1;
                    if (done.kind == runtime.CONNECT && done.status == windows.ECONNREFUSED && done.bytes == 0 && done.items == 0 && done.resource == client) { saw_refusal = true; }
                }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val after: i64  = poll(?backend, 0);
    val valid: bool = submitted == 0 && saw_refusal && completion_count == 1 && after == 0 && backend.active == 0;
    windows.sock_close(client);
    windows.sock_close(guard);
    val destroyed: i64 = destroy(?backend);
    windows.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async windows: reset reports a normalized completion once" {
    var listener: usize;
    var client:   usize;
    var server:   usize;
    if (test_stream_pair(?listener, ?client, ?server) < 0) { ret 1; }
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) {
        windows.sock_close(server);
        windows.sock_close(client);
        windows.sock_close(listener);
        ret 1;
    }
    var backend: Backend;
    if (make(?backend, ?queue, 4, 1) < 0) {
        windows.io_queue_close(?queue);
        windows.sock_close(server);
        windows.sock_close(client);
        windows.sock_close(listener);
        ret 1;
    }
    var input:     u8  = 0;
    var token:     types.Token;
    val submitted: i64 = submit_read(?backend, server, 1, ?input, 1, 41, ?token);
    var linger:    [2]u16;
    linger[0] = 1;
    linger[1] = 0;
    val configured:       i64   = windows.sock_setopt(client, windows.SOL_SOCKET, windows.SO_LINGER, (?linger[0])::*u8, 4);
    val closed:           i64   = windows.sock_close(client);
    var saw_reset:        bool  = false;
    var completion_count: usize = 0;
    var attempts:         usize = 0;
    for (attempts < 16 && !saw_reset) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 16; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var done: types.NativeCompletion;
                completion(?backend, i, ?done);
                if (done.context == 41) {
                    completion_count = completion_count + 1;
                    if (done.kind == runtime.READ && done.status == windows.ECONNRESET && done.bytes == 0 && done.items == 0 && !done.end_of_stream) { saw_reset = true; }
                }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val after: i64  = poll(?backend, 0);
    val valid: bool = submitted == 0 && configured == 0 && closed == 0 && saw_reset && completion_count == 1 && after == 0 && backend.active == 0;
    windows.sock_close(server);
    windows.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    windows.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async windows: read cancellation quiesces borrowed storage" {
    var listener: usize;
    var client:   usize;
    var server:   usize;
    if (test_stream_pair(?listener, ?client, ?server) < 0) { ret 1; }
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) {
        windows.sock_close(server);
        windows.sock_close(client);
        windows.sock_close(listener);
        ret 1;
    }
    var backend: Backend;
    if (make(?backend, ?queue, 2, 1) < 0) {
        windows.io_queue_close(?queue);
        windows.sock_close(server);
        windows.sock_close(client);
        windows.sock_close(listener);
        ret 1;
    }
    var input:            u8    = 0xa5;
    var token:            types.Token;
    val submitted:        i64   = submit_read(?backend, server, 1, ?input, 1, 42, ?token);
    val canceled:         i64   = cancel(?backend, token);
    var output:           u8    = 0x5a;
    val sent:             i64   = windows.sock_send(client, ?output, 1);
    var completion_count: usize = 0;
    var attempts:         usize = 0;
    for (attempts < 16 && backend.active != 0) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 16; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var done: types.NativeCompletion;
                completion(?backend, i, ?done);
                if (done.context == 42) { completion_count = completion_count + 1; }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val valid: bool = submitted == 0 && canceled == 0 && sent == 1 && input == 0xa5 && completion_count == 0 && backend.active == 0;
    windows.sock_close(server);
    windows.sock_close(client);
    windows.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    windows.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async windows: cancellation preserves earlier IOCP packets" {
    var first_listener:  usize;
    var first_client:    usize;
    var first_server:    usize;
    var second_listener: usize;
    var second_client:   usize;
    var second_server:   usize;
    if (test_stream_pair(?first_listener, ?first_client, ?first_server) < 0 || test_stream_pair(?second_listener, ?second_client, ?second_server) < 0) { ret 1; }
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 2, 1) < 0) {
        windows.io_queue_close(?queue);
        ret 1;
    }
    var first_input:          u8    = 0;
    var canceled_input:       u8    = 0xa5;
    var first_token:          types.Token;
    var canceled_token:       types.Token;
    val first_submitted:      i64   = submit_read(?backend, first_server, 1, ?first_input, 1, 43, ?first_token);
    val canceled_submitted:   i64   = submit_read(?backend, second_server, 1, ?canceled_input, 1, 44, ?canceled_token);
    var output:               u8    = 0x5a;
    val sent:                 i64   = windows.sock_send(first_client, ?output, 1);
    var earlier:              windows.IoCompletion;
    val earlier_count:        i64   = windows.io_queue_poll(?queue, ?earlier, 1, 1000);
    val first_native_context: usize = (?operation_at(?backend, first_token.index::usize).overlapped)::usize;
    var earlier_restored:     i64   = windows.EIO;
    if (earlier_count == 1 && earlier.context == first_native_context) {
        earlier_restored = windows.io_queue_restore(?queue, earlier);
    }
    val canceled:     i64   = cancel(?backend, canceled_token);
    var saw_first:    bool  = false;
    var saw_canceled: bool  = false;
    var attempts:     usize = 0;
    for (attempts < 16 && !saw_first) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 16; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var done: types.NativeCompletion;
                completion(?backend, i, ?done);
                if (done.context == 43 && done.kind == runtime.READ && done.status == 0 && done.bytes == 1 && done.items == 0) { saw_first = true; }
                if (done.context == 44)                                                                                        { saw_canceled = true; }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val valid: bool = first_submitted == 0 && canceled_submitted == 0 && sent == 1 && earlier_count == 1 && earlier.context == first_native_context && earlier_restored == 0 && canceled == 0 && saw_first && !saw_canceled && first_input == 0x5a && canceled_input == 0xa5 && backend.active == 0;
    windows.sock_close(first_server);
    windows.sock_close(first_client);
    windows.sock_close(first_listener);
    windows.sock_close(second_server);
    windows.sock_close(second_client);
    windows.sock_close(second_listener);
    val destroyed: i64 = destroy(?backend);
    windows.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async windows: canceling close returns native resources to baseline" {
    var warm_listener: usize;
    var warm_client:   usize;
    var warm_server:   usize;
    if (test_stream_pair(?warm_listener, ?warm_client, ?warm_server) < 0) { ret 1; }
    windows.sock_close(warm_server);
    windows.sock_close(warm_client);
    windows.sock_close(warm_listener);
    var warm_queue: shared.IoQueue;
    if (windows.io_queue_create(?warm_queue) < 0 || windows.io_queue_close(?warm_queue) < 0) { ret 1; }
    var before: u32 = 0;
    if (!test_handle_count(?before)) { ret 1; }

    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) {
        windows.io_queue_close(?queue);
        ret 1;
    }
    var iteration: usize = 0;
    for (iteration < 16) {
        var listener: usize;
        var client:   usize;
        var server:   usize;
        if (test_stream_pair(?listener, ?client, ?server) < 0) { ret 1; }
        var input:             u8    = 0xa5;
        var read_token:        types.Token;
        var close_token:       types.Token;
        val read_context:      usize = 100 + iteration * 2;
        val close_context:     usize = read_context + 1;
        val read_submitted:    i64   = submit_read(?backend, server, 1, ?input, 1, read_context, ?read_token);
        val close_submitted:   i64   = submit_close(?backend, server, 1, close_context, ?close_token);
        val close_canceled:    i64   = cancel(?backend, close_token);
        val raw_close:         i64   = windows.sock_close(server);
        var read_completions:  usize = 0;
        var close_completions: usize = 0;
        var saw_cancel:        bool  = false;
        var attempts:          usize = 0;
        for (attempts < 16 && backend.active != 0) {
            val count: i64 = poll(?backend, 1000);
            if (count < 0) { attempts = 16; }
            or {
                var i: usize = 0;
                for (i < count::usize) {
                    var done: types.NativeCompletion;
                    completion(?backend, i, ?done);
                    if (done.context == read_context) {
                        read_completions = read_completions + 1;
                        if (done.kind == runtime.READ && done.status == windows.ECANCELED && done.bytes == 0 && done.items == 0) { saw_cancel = true; }
                    }
                    if (done.context == close_context) { close_completions = close_completions + 1; }
                    i = i + 1;
                }
                attempts = attempts + 1;
            }
        }
        val drained: i64 = poll(?backend, 0);
        windows.sock_close(client);
        windows.sock_close(listener);
        if (read_submitted != 0 || close_submitted != 0 || close_canceled != 0 || raw_close != -88 || !saw_cancel || read_completions != 1 || close_completions != 0 || drained != 0 || backend.active != 0 || backend.attached_count != 0) { ret 1; }
        iteration = iteration + 1;
    }
    if (destroy(?backend) < 0 || windows.io_queue_close(?queue) < 0) { ret 1; }
    var after: u32 = 0;
    if (!test_handle_count(?after) || after != before) { ret 1; }
    ret 0;
}

# an operation the kernel still owns keeps the backend alive, so no completion
# can outlive the source id once the runtime reuses it (#740)
test "async windows: destroy waits for every kernel-owned operation" {
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 1; }
    fin { windows.io_queue_close(?queue); }
    var backend: Backend;
    if (make(?backend, ?queue, 2, 1) < 0) { ret 2; }
    var listener: usize = INVALID_SOCKET;
    if (windows.sock_create_flags(windows.AF_INET, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, ?listener) < 0) { ret 3; }
    fin { windows.sock_close(listener); }
    var address: [128]u8;
    ip.to_sockaddr(ip.endpoint(127, 0, 0, 1, 0), ?address[0]);
    if (windows.sock_bind(listener, ?address[0], windows.SOCKADDR_IN_SIZE) < 0 || windows.sock_listen(listener, 4) < 0) { ret 4; }
    var peer:  ip.Endpoint;
    var token: types.Token;
    if (submit_accept(?backend, listener, 1, ?peer, 30, ?token) < 0) { ret 5; }
    if (destroy(?backend) != windows.EBUSY)                          { ret 6; }
    if (cancel(?backend, token) < 0)                                 { ret 7; }
    var attempts: usize = 0;
    for (attempts < 16 && backend.active != 0) {
        if (destroy(?backend) != windows.EBUSY) { ret 8; }
        if (poll(?backend, 1000) < 0)           { ret 9; }
        attempts = attempts + 1;
    }
    if (backend.active != 0)   { ret 10; }
    if (destroy(?backend) < 0) { ret 11; }
    var left: windows.IoCompletion;
    if (windows.io_queue_poll(?queue, ?left, 1, 0) != 0) { ret 12; }
    ret 0;
}

# a close marks its socket's reads for cancellation, and a scope cancel that
# lands afterwards still owns the read (#786)
test "async windows: canceling a read after its socket closed settles it" {
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 1; }
    fin { windows.io_queue_close(?queue); }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) { ret 2; }
    var listener: usize;
    var client:   usize;
    var server:   usize;
    if (test_stream_pair(?listener, ?client, ?server) < 0) { ret 3; }
    fin {
        windows.sock_close(client);
        windows.sock_close(listener);
    }
    var input:       u8 = 0;
    var read_token:  types.Token;
    var close_token: types.Token;
    if (submit_read(?backend, server, 1, ?input, 1, 40, ?read_token) != 0) { ret 4; }
    if (submit_close(?backend, server, 1, 41, ?close_token) != 0)          { ret 5; }
    if (cancel(?backend, read_token) != 0)                                 { ret 6; }
    var reads:    usize = 0;
    var closes:   usize = 0;
    var attempts: usize = 0;
    for (attempts < 16 && backend.active != 0) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 7; }
        var i: usize = 0;
        for (i < count::usize) {
            var done: types.NativeCompletion;
            completion(?backend, i, ?done);
            if (done.context == 40) { reads = reads + 1; }
            if (done.context == 41) { closes = closes + 1; }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    # the cancel consumed the read's packet, so only the close completes
    if (reads != 0 || closes != 1 || backend.active != 0) { ret 8; }
    # a pending wake may remain, and draining it must yield no completion
    if (poll(?backend, 0) != 0) { ret 9; }
    if (destroy(?backend) < 0)  { ret 10; }
    var left: windows.IoCompletion;
    if (windows.io_queue_poll(?queue, ?left, 1, 0) != 0) { ret 11; }
    ret 0;
}

# steps one event and one submit take while count operations share a socket
rec ScalingCost {
    flush:    u64;
    event:    u64;
    write:    u64;
    shutdown: u64;
}

# one read in flight and count - 1 readiness waits held behind it on one
# socket, then a flush, the read's completion and two submits on another socket
fun scaling_cost(count: usize, cost: *ScalingCost) i32 {
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 1; }
    fin { windows.io_queue_close(?queue); }
    var backend: Backend;
    if (make(?backend, ?queue, count + 8, 1) < 0) { ret 2; }
    var listener: usize;
    var client:   usize;
    var server:   usize;
    if (test_stream_pair(?listener, ?client, ?server) < 0) { ret 3; }
    fin {
        windows.sock_close(client);
        windows.sock_close(listener);
    }
    var other_listener: usize;
    var other_client:   usize;
    var other_server:   usize;
    if (test_stream_pair(?other_listener, ?other_client, ?other_server) < 0) { ret 4; }
    fin {
        windows.sock_close(other_server);
        windows.sock_close(other_client);
        windows.sock_close(other_listener);
    }
    var input: u8 = 0;
    var token: types.Token;
    if (submit_read(?backend, server, 1, ?input, 1, 1, ?token) != 0) { ret 5; }
    var i: usize = 1;
    for (i < count) {
        if (submit_readable(?backend, server, 1, 2, ?token) != 0) { ret 6; }
        i = i + 1;
    }
    if (backend.active != count) { ret 7; }
    var before: u64 = backend.steps;
    if (flush(?backend) != 0) { ret 8; }
    cost.flush = backend.steps - before;
    var byte: u8 = 'x';
    if (windows.sock_send(client, ?byte, 1) != 1) { ret 9; }
    before = backend.steps;
    val polled: i64 = poll(?backend, 1000);
    cost.event = backend.steps - before;
    if (polled != 1 || input != 'x') { ret 10; }
    var done: types.NativeCompletion;
    if (completion(?backend, 0, ?done) < 0 || done.context != 1 || done.status != 0 || done.bytes != 1) { ret 11; }
    var output: u8 = 'y';
    before = backend.steps;
    if (submit_write(?backend, other_client, 1, ?output, 1, 3, ?token) != 0) { ret 12; }
    cost.write = backend.steps - before;
    before     = backend.steps;
    if (submit_shutdown_write(?backend, other_client, 1, 4, ?token) != 0) { ret 13; }
    cost.shutdown = backend.steps - before;
    if (submit_close(?backend, server, 1, 5, ?token) != 0) { ret 14; }
    var attempts: usize = 0;
    for (attempts < 64 && backend.active != 0) {
        if (poll(?backend, 1000) < 0) { ret 15; }
        attempts = attempts + 1;
    }
    if (backend.active != 0)   { ret 16; }
    if (poll(?backend, 0) < 0) { ret 17; }
    if (destroy(?backend) < 0) { ret 18; }
    ret 0;
}

# a flush, a completion and a submit cost the same whatever else the backend
# holds (#744)
test "async windows: per-event and per-submit cost stays flat from 1k to 100k operations" {
    val sizes: [3]usize = [3]usize{1000, 10000, 100000};
    var costs: [3]ScalingCost;
    var i:     usize    = 0;
    for (i < 3) {
        val measured: i32 = scaling_cost(sizes[i], ?costs[i]);
        if (measured != 0) { ret 20 * (i::i32 + 1) + measured; }
        i = i + 1;
    }
    if (costs[1].flush != costs[0].flush || costs[2].flush != costs[0].flush)             { ret 150; }
    if (costs[1].event != costs[0].event || costs[2].event != costs[0].event)             { ret 151; }
    if (costs[1].write != costs[0].write || costs[2].write != costs[0].write)             { ret 152; }
    if (costs[1].shutdown != costs[0].shutdown || costs[2].shutdown != costs[0].shutdown) { ret 153; }
    if (costs[0].flush > 8)                                                               { ret 160; }
    if (costs[0].event > 8)                                                               { ret 161; }
    if (costs[0].write > 8)                                                               { ret 162; }
    if (costs[0].shutdown > 8)                                                            { ret 163; }
    ret 0;
}
