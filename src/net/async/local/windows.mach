# bounded windows iocp backend for af_unix streams

$if ($mach.build.os != $mach.os.windows) {
    $error("std.net.async.local.windows: requires windows target");
}

use io_error: std.io.error;
use std.io.runtime;
use std.net.async.iocp;
use std.net.async.iocp.port;
use std.net.async.types;
use std.net.local.endpoint;
use local_types: std.net.local.types;
use local_impl:  std.net.local.windows;
use std.sync.mutex;
use std.system.os.shared;
use std.system.os.windows;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

fwd types.Token;
fwd types.NativeCompletion;
fwd port.Backend;
fwd port.aliases;
fwd port.cancel;
fwd port.flush;
fwd port.dispatch;
fwd port.poll;
fwd port.completion;
fwd port.destroy;

# a local stream request needs nothing beyond the completion port layer's part
pub rec Operation {
    header: port.Header;
}

# the local backend has no handle openings, so every record is acquired under one
val OPENING: u64 = 0;

val INVALID_SOCKET: usize = (-1)::usize;

# the sockaddr for value, or the native code for the reason it has none
fun encode(value: endpoint.Endpoint, address: *u8, length: *usize) i64 {
    val encoded: err[io_error.Kind] = endpoint.to_sockaddr(value, address, 128, length);
    if (!sel encoded.err)                    { ret 0; }
    if (encoded.err == io_error.UNSUPPORTED) { ret windows.ENOTSUP; }
    ret windows.EINVAL;
}

fun clear_operation(header: *port.Header) {}

fun finish_accept(header: *port.Header) i64 {
    ret 0;
}

# initial is the size the backend starts at: every table grows on demand
pub fun make(backend: *Backend, queue: *shared.IoQueue, initial: usize, source_id: u16) i64 {
    ret port.make(backend, queue, initial, source_id, $size_of(Operation), port.Hooks{
        clear:    clear_operation,
        accepted: finish_accept,
        finish:   nil,
        stale:    false,
    });
}

pub fun submit_read(backend: *Backend, resource: usize, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    ret port.submit_buffer(backend, resource, OPENING, buffer, length, context, runtime.READ, token);
}

# wait for the stream to be readable without a buffer: an overlapped zero-byte
# receive, settled on completion by the queued byte count
pub fun submit_readable(backend: *Backend, resource: usize, context: usize, token: *types.Token) i64 {
    ret port.submit_buffer(backend, resource, OPENING, nil, 0, context, runtime.READABLE, token);
}

pub fun submit_write(backend: *Backend, resource: usize, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    ret port.submit_buffer(backend, resource, OPENING, buffer, length, context, runtime.WRITE, token);
}

pub fun create_connect(value: endpoint.Endpoint, resource: *usize) i64 {
    ret local_impl.create_stream(value, true, resource);
}

pub fun cleanup_listener(listener: *local_types.Listener) i64 {
    ret local_impl.cleanup_listener(listener);
}

pub fun rename_listener(listener: *local_types.Listener, replacement: endpoint.Endpoint) i64 {
    ret local_impl.rename(listener, replacement);
}

pub fun close_resource(backend: *Backend, resource: usize) i64 {
    ret port.close_socket(backend, resource, OPENING);
}

pub fun submit_accept(backend: *Backend, listener: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || listener == INVALID_SOCKET) { ret port.invalid(); }
    var sock: u32 = iocp.NONE;
    mutex.lock(?backend.lock);
    val attached: i64 = port.acquire_locked(backend, listener, OPENING, true, ?sock);
    mutex.unlock(?backend.lock);
    if (attached < 0) { ret attached; }
    var accepted: usize = INVALID_SOCKET;
    val created:  i64   = windows.sock_create_flags(1, windows.SOCK_STREAM, 0, true, true, ?accepted);
    if (created < 0) { ret created; }
    # the record is found again, since a close may have run while unlocked
    val admitted: i64 = port.admit(backend, listener, OPENING, ?sock);
    if (admitted < 0) {
        windows.sock_close(accepted);
        ret admitted;
    }
    val header: *port.Header = port.claim_locked(backend, sock, runtime.ACCEPT, listener, context, iocp.ACTIVE, token);
    if (header == nil) {
        mutex.unlock(?backend.lock);
        windows.sock_close(accepted);
        ret windows.ENOMEM;
    }
    header.auxiliary = accepted;
    val result: i64 = windows.sock_async_accept(listener, accepted, ?header.address[0], 288, ?header.transferred, (?header.overlapped)::ptr);
    if (result < 0) {
        windows.sock_close(accepted);
        header.auxiliary = INVALID_SOCKET;
        port.release_locked(backend, header);
    }
    mutex.unlock(?backend.lock);
    ret result;
}

fun bind_for_connect(resource: usize) i64 {
    var address: [128]u8;
    var length:  u32 = 128;
    if (windows.sock_local_addr(resource, ?address[0], ?length) >= 0 && length > 2) { ret 0; }
    var i: usize = 0;
    for (i < 128) {
        address[i] = 0;
        i          = i + 1;
    }
    address[0] = 1;
    address[1] = 0;
    ret windows.sock_bind(resource, ?address[0], 2);
}

pub fun submit_connect(backend: *Backend, resource: usize, peer: endpoint.Endpoint, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || resource == INVALID_SOCKET) { ret port.invalid(); }
    val bound: i64 = bind_for_connect(resource);
    if (bound < 0) { ret bound; }
    var sock:     u32 = iocp.NONE;
    val admitted: i64 = port.admit(backend, resource, OPENING, ?sock);
    if (admitted < 0) { ret admitted; }
    val header: *port.Header = port.claim_locked(backend, sock, runtime.CONNECT, resource, context, iocp.ACTIVE, token);
    if (header == nil) {
        mutex.unlock(?backend.lock);
        ret windows.ENOMEM;
    }
    var length:  usize = 0;
    val encoded: i64   = encode(peer, ?header.address[0], ?length);
    if (encoded < 0) {
        port.release_locked(backend, header);
        mutex.unlock(?backend.lock);
        ret encoded;
    }
    val result: i64 = windows.sock_async_connect(resource, ?header.address[0], length, ?header.transferred, (?header.overlapped)::ptr);
    if (result < 0) { port.release_locked(backend, header); }
    mutex.unlock(?backend.lock);
    ret result;
}

# a shutdown waits for the socket's writes, and runs once none is left
pub fun submit_shutdown_write(backend: *Backend, resource: usize, context: usize, token: *types.Token) i64 {
    ret port.submit_shutdown_write(backend, resource, OPENING, context, token);
}

# a close aborts the socket's requests and completes once they have all left
pub fun submit_close(backend: *Backend, resource: usize, context: usize, token: *types.Token) i64 {
    ret port.submit_close(backend, resource, OPENING, context, token);
}

fun test_listener_name(output: *u8) usize {
    val prefix: [19]u8 = [19]u8{'m', 'a', 'c', 'h', '-', 's', 't', 'd', '-', 'a', 's', 'y', 'n', 'c', '-', '7', '4', '0', '-'};
    var length: usize  = 0;
    for (length < 19) {
        output[length] = prefix[length];
        length         = length + 1;
    }
    var process: u64   = windows.getpid()::u64;
    var digits:  [20]u8;
    var count:   usize = 0;
    if (process == 0) {
        digits[0] = '0';
        count     = 1;
    }
    for (process != 0) {
        digits[count] = '0' + (process % 10)::u8;
        process       = process / 10;
        count         = count + 1;
    }
    var i: usize = 0;
    for (i < count) {
        output[length] = digits[count - i - 1];
        length         = length + 1;
        i              = i + 1;
    }
    output[length]     = '.';
    output[length + 1] = 's';
    output[length + 2] = 'o';
    output[length + 3] = 'c';
    output[length + 4] = 'k';
    output[length + 5] = 0;
    ret length + 5;
}

# an operation the kernel still owns keeps the backend alive, so no completion
# can outlive the source id once the runtime reuses it (#740)
test "async local windows: destroy waits for every kernel-owned operation" {
    if (windows.running_under_wine()) { ret 0; }
    var path:            [108]u8;
    val length:          usize                                  = test_listener_name(?path[0]);
    val endpoint_result: res[endpoint.Endpoint, io_error.Error] = endpoint.filesystem_bytes(?path[0], length);
    if (sel endpoint_result.err) { ret 1; }
    var listener: local_types.Listener;
    listener.handle            = INVALID_SOCKET;
    listener.endpoint          = endpoint_result.ok;
    listener.ownership         = local_types.OWNED;
    listener.has_node_identity = false;
    val options: local_types.ListenOptions = local_types.ListenOptions{
        backlog:     4, ownership: local_types.OWNED, stale: local_types.REJECT_STALE,
        permissions: local_types.INHERIT_PERMISSIONS,
    };
    if (local_impl.listen(?listener, endpoint_result.ok, options) < 0) { ret 2; }
    fin { local_impl.close_listener(?listener); }
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 3; }
    fin { windows.io_queue_close(?queue); }
    var backend: Backend;
    if (make(?backend, ?queue, 2, 1) < 0) { ret 4; }
    var token: types.Token;
    if (submit_accept(?backend, listener.handle, 30, ?token) < 0) { ret 5; }
    if (destroy(?backend) != windows.EBUSY)                       { ret 6; }
    if (cancel(?backend, token) < 0)                              { ret 7; }
    var attempts: usize = 0;
    for (attempts < 16 && backend.active != 0) {
        if (destroy(?backend) != windows.EBUSY) { ret 8; }
        if (poll(?backend, 1000) < 0)           { ret 9; }
        attempts = attempts + 1;
    }
    if (backend.active != 0)   { ret 10; }
    if (destroy(?backend) < 0) { ret 11; }
    var left: windows.IoCompletion;
    if (windows.io_queue_poll(?queue, ?left, 1, 0) != 0) { ret 12; }
    ret 0;
}

# a connected loopback tcp pair: the backend's stream operations do not depend
# on the address family, and af_unix is unavailable under wine
fun test_loopback_pair(listener: *usize, client: *usize, server: *usize) i64 {
    @listener = INVALID_SOCKET;
    @client   = INVALID_SOCKET;
    @server   = INVALID_SOCKET;
    var address: [128]u8;
    var i:       usize = 0;
    for (i < 128) {
        address[i] = 0;
        i          = i + 1;
    }
    address[0] = windows.AF_INET::u8;
    address[4] = 127;
    address[7] = 1;
    var length: u32 = 128;
    var status: i64 = windows.sock_create_flags(windows.AF_INET, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, listener);
    if (status >= 0) { status = windows.sock_bind(@listener, ?address[0], windows.SOCKADDR_IN_SIZE); }
    if (status >= 0) { status = windows.sock_listen(@listener, 8); }
    if (status >= 0) { status = windows.sock_local_addr(@listener, ?address[0], ?length); }
    if (status >= 0) { status = windows.sock_create_flags(windows.AF_INET, windows.SOCK_STREAM, windows.IPPROTO_TCP, false, true, client); }
    if (status >= 0) { status = windows.sock_connect(@client, ?address[0], windows.SOCKADDR_IN_SIZE); }
    length = 128;
    if (status >= 0) { status = windows.sock_accept_flags(@listener, ?address[0], ?length, false, true, server); }
    if (status < 0) {
        if (@server != INVALID_SOCKET) {
            windows.sock_close(@server);
            @server = INVALID_SOCKET;
        }
        if (@client != INVALID_SOCKET) {
            windows.sock_close(@client);
            @client = INVALID_SOCKET;
        }
        if (@listener != INVALID_SOCKET) {
            windows.sock_close(@listener);
            @listener = INVALID_SOCKET;
        }
    }
    ret status;
}

# steps one event and one submit take while count operations share a socket
rec ScalingCost {
    flush:    u64;
    event:    u64;
    write:    u64;
    shutdown: u64;
}

# one read in flight and count - 1 readiness waits held behind it on one
# socket, then a flush, the read's completion and two submits on another socket
fun scaling_cost(count: usize, cost: *ScalingCost) i32 {
    var queue: shared.IoQueue;
    if (windows.io_queue_create(?queue) < 0) { ret 1; }
    fin { windows.io_queue_close(?queue); }
    var backend: Backend;
    if (make(?backend, ?queue, count + 8, 1) < 0) { ret 2; }
    var listener: usize;
    var client:   usize;
    var server:   usize;
    if (test_loopback_pair(?listener, ?client, ?server) < 0) { ret 3; }
    fin {
        windows.sock_close(client);
        windows.sock_close(listener);
    }
    var other_listener: usize;
    var other_client:   usize;
    var other_server:   usize;
    if (test_loopback_pair(?other_listener, ?other_client, ?other_server) < 0) { ret 4; }
    fin {
        windows.sock_close(other_server);
        windows.sock_close(other_client);
        windows.sock_close(other_listener);
    }
    var input: u8 = 0;
    var token: types.Token;
    if (submit_read(?backend, server, ?input, 1, 1, ?token) != 0) { ret 5; }
    var i: usize = 1;
    for (i < count) {
        if (submit_readable(?backend, server, 2, ?token) != 0) { ret 6; }
        i = i + 1;
    }
    if (backend.active != count) { ret 7; }
    var before: u64 = backend.core.steps;
    if (flush(?backend) != 0) { ret 8; }
    cost.flush = backend.core.steps - before;
    var byte: u8 = 'x';
    if (windows.sock_send(client, ?byte, 1) != 1) { ret 9; }
    before = backend.core.steps;
    val polled: i64 = poll(?backend, 1000);
    cost.event = backend.core.steps - before;
    if (polled != 1 || input != 'x') { ret 10; }
    var done: types.NativeCompletion;
    if (completion(?backend, 0, ?done) < 0 || done.context != 1 || done.status != 0 || done.bytes != 1) { ret 11; }
    var output: u8 = 'y';
    before = backend.core.steps;
    if (submit_write(?backend, other_client, ?output, 1, 3, ?token) != 0) { ret 12; }
    cost.write = backend.core.steps - before;
    before     = backend.core.steps;
    if (submit_shutdown_write(?backend, other_client, 4, ?token) != 0) { ret 13; }
    cost.shutdown = backend.core.steps - before;
    if (submit_close(?backend, server, 5, ?token) != 0) { ret 14; }
    var attempts: usize = 0;
    for (attempts < 64 && backend.active != 0) {
        if (poll(?backend, 1000) < 0) { ret 15; }
        attempts = attempts + 1;
    }
    if (backend.active != 0)   { ret 16; }
    if (poll(?backend, 0) < 0) { ret 17; }
    if (destroy(?backend) < 0) { ret 18; }
    ret 0;
}

# a flush, a completion and a submit cost the same whatever else the backend
# holds (#744)
test "async local windows: per-event and per-submit cost stays flat from 1k to 100k operations" {
    val sizes: [3]usize = [3]usize{1000, 10000, 100000};
    var costs: [3]ScalingCost;
    var i:     usize    = 0;
    for (i < 3) {
        val measured: i32 = scaling_cost(sizes[i], ?costs[i]);
        if (measured != 0) { ret 20 * (i::i32 + 1) + measured; }
        i = i + 1;
    }
    # a hash probe may vary with the map's capacity, so flat means bounded
    i = 0;
    for (i < 3) {
        if (costs[i].flush > 8)    { ret 150 + i::i32; }
        if (costs[i].event > 8)    { ret 160 + i::i32; }
        if (costs[i].write > 8)    { ret 170 + i::i32; }
        if (costs[i].shutdown > 8) { ret 180 + i::i32; }
        i = i + 1;
    }
    ret 0;
}
