# bounded local unix readiness backend
# backend for std.net.async.local, signatures may change in a minor release (README, API surface)

$if ($mach.build.os != $mach.os.linux && $mach.build.os != $mach.os.darwin) {
    $error("std.net.async.local.unix: requires linux or darwin target");
}

use std.allocator;
use std.allocator.page;
use io_error: std.io.error;
use std.io.runtime;
use std.memory;
use std.memory.table;
use std.net.async.types;
use std.net.local.endpoint;
use local_types: std.net.local.types;
use std.sync.mutex;
use std.system.os;
use std.system.os.shared;
use std.system.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.isize;
use std.types.size.usize;

# cancel ends native access synchronously, so it runs while no thread is
# inside the native wait
pub val CANCEL_NEEDS_NATIVE_CONTROL: bool = true;

$if ($mach.build.os == $mach.os.linux) {
    use local_impl: std.net.local.unix;
    use native:     std.system.os.linux;
}
$or {
    use local_impl: std.net.local.unix;
    use native:     std.system.os.darwin;
}

fwd types.Token;
fwd types.NativeCompletion;

pub rec Operation {
    state:          u8;
    generation:     u32;
    index:          u32;
    completion:     types.NativeCompletion;
    kind:           runtime.Kind;
    resource:       usize;
    context:        usize;
    buffer:         *u8;
    length:         usize;
    peer:           endpoint.Endpoint;
    sequence:       u64;
    previous:       u32;
    next:           u32;
    resource_index: u32;
    lane:           u8;
    stage:          u8;
    # the pool's free-list link while the operation is free
    pool_next: usize;
}

rec Resource {
    state:        u8;
    generation:   u32;
    index:        u32;
    resource:     usize;
    read_head:    u32;
    read_tail:    u32;
    write_head:   u32;
    write_tail:   u32;
    close_index:  u32;
    armed:        bool;
    watched:      bool;
    closing:      bool;
    write_closed: bool;
    next_free:    usize;
}

pub rec Backend {
    queue:     *shared.IoQueue;
    source_id: u16;
    # where every table's chunks come from
    allocator:      allocator.Allocator;
    operations:     table.Table;
    resources:      table.Table;
    ready:          table.Table;
    resource_map:   *u32;
    native:         *native.IoCompletion;
    map_capacity:   usize;
    live:           usize;
    resource_count: usize;
    # free operations and resources, lowest chunk first. each pool's floor is
    # the generation an entry of a regrown chunk starts from
    operation_pool: table.Pool;
    resource_pool:  table.Pool;
    queued_head:    u32;
    queued_tail:    u32;
    queued_count:   usize;
    ready_count:    usize;
    sequence:       u64;
    # native registration and address calls, counted for the scaling tests
    watches:   u64;
    rearms:    u64;
    unwatches: u64;
    # registrations held, zero once destroy returns
    registered: usize;
    locates:    u64;
    lock:       mutex.Mutex;
}

fun operation_at(backend: *Backend, index: usize) *Operation {
    ret table.at(?backend.operations, index)::*Operation;
}

fun resource_at(backend: *Backend, index: usize) *Resource {
    ret table.at(?backend.resources, index)::*Resource;
}

fun ready_at(backend: *Backend, index: usize) *types.NativeCompletion {
    ret table.at(?backend.ready, index)::*types.NativeCompletion;
}

pub fun aliases(backend: *Backend, data: *u8, len: usize) bool {
    if (!memory.range_valid(data, len)) { ret true; }
    if (len == 0)                       { ret false; }
    if (!memory.range_valid(backend::*u8, $size_of(Backend)) ||
        backend.queue == nil || backend.operations.capacity == 0 ||
        backend.map_capacity == 0) { ret true; }
    var map_bytes:    usize = 0;
    var native_bytes: usize = 0;
    if (!memory.range_scaled(backend.map_capacity, $size_of(u32), ?map_bytes) ||
        !memory.range_scaled(NATIVE_BATCH, $size_of(native.IoCompletion),
        ?native_bytes)) { ret true; }
    ret memory.ranges_overlap(backend::*u8, $size_of(Backend), data, len) ||
        memory.ranges_overlap(backend.queue::*u8, $size_of(shared.IoQueue),
        data, len) ||
        table.aliases(?backend.operations, data, len) ||
        table.aliases(?backend.resources, data, len) ||
        table.aliases(?backend.ready, data, len) ||
        memory.ranges_overlap(backend.resource_map::*u8, map_bytes,
        data, len) ||
        memory.ranges_overlap(backend.native::*u8, native_bytes, data, len);
}

val SLOT_FREE:       u8  = 0;
val SLOT_ACTIVE:     u8  = 1;
val SLOT_QUEUED:     u8  = 2;
val RESOURCE_FREE:   u8  = 0;
val RESOURCE_ACTIVE: u8  = 1;
val LANE_NONE:       u8  = 0;
val LANE_READ:       u8  = 1;
val LANE_WRITE:      u8  = 2;
val NONE:            u32 = 0xffffffff;
# readiness is harvested in fixed batches, so the batch is not a capacity
val NATIVE_BATCH: usize = 256;

$if ($mach.build.os == $mach.os.linux) {
    val IN_PROGRESS: i64 = -115;
}
$or {
    val IN_PROGRESS: i64 = -36;
}

fun invalid() i64 {
    ret native.EINVAL;
}

fun token_context(backend: *Backend, token: types.Token) usize {
    ret shared.io_source_context(backend.source_id, (token.index::u64 << 16) | token.generation::u64);
}

fun context_token(backend: *Backend, context: usize, token: *types.Token) bool {
    val raw: u64 = context::u64;
    if (shared.io_context_source(context) != backend.source_id || token == nil) { ret false; }
    token.index      = ((raw >> 16) & 0xffffffff)::u32;
    token.generation = (raw & 0xffff)::u32;
    ret token.generation != 0;
}

# a resource generation stays inside the wire field, so the stored value and the
# encoded one are the same number and no comparison is made on a truncation
fun next_wire_generation(current: u32) u32 {
    val generation: u32 = current + 1;
    if (generation > 0xffff) { ret 1; }
    ret generation;
}

fun operation_for(backend: *Backend, token: types.Token) *Operation {
    if (token.index::usize >= backend.operations.capacity) { ret nil; }
    val operation: *Operation = operation_at(backend, token.index::usize);
    if (operation.state != SLOT_ACTIVE || operation.generation != token.generation) { ret nil; }
    ret operation;
}

fun operation_any(backend: *Backend, token: types.Token) *Operation {
    if (token.index::usize >= backend.operations.capacity) { ret nil; }
    val operation: *Operation = operation_at(backend, token.index::usize);
    if (operation.state == SLOT_FREE || operation.generation != token.generation) { ret nil; }
    ret operation;
}

fun resource_for(backend: *Backend, token: types.Token) *Resource {
    if (token.index::usize >= backend.resources.capacity) { ret nil; }
    val resource: *Resource = resource_at(backend, token.index::usize);
    if (resource.state != RESOURCE_ACTIVE || resource.generation != token.generation) { ret nil; }
    ret resource;
}

fun required_map_capacity(capacity: usize) usize {
    if (capacity > 0x3fffffff) { ret 0; }
    val required: usize = capacity * 2;
    var size:     usize = 1;
    for (size < required) { size = size * 2; }
    ret size;
}

fun resource_hash(resource: usize) usize {
    ret resource * 11400714819323198485;
}

fun resource_lookup(backend: *Backend, resource: usize) *Resource {
    var slot:    usize = resource_hash(resource) & (backend.map_capacity - 1);
    var scanned: usize = 0;
    for (scanned < backend.map_capacity) {
        val entry: u32 = backend.resource_map[slot];
        if (entry == 0) { ret nil; }
        val candidate: *Resource = resource_at(backend, (entry - 1)::usize);
        if (candidate.resource == resource) { ret candidate; }
        slot    = (slot + 1) & (backend.map_capacity - 1);
        scanned = scanned + 1;
    }
    ret nil;
}

fun resource_map_insert(backend: *Backend, index: u32) bool {
    val resource: usize = resource_at(backend, index::usize).resource;
    var slot:     usize = resource_hash(resource) & (backend.map_capacity - 1);
    var scanned:  usize = 0;
    for (scanned < backend.map_capacity) {
        if (backend.resource_map[slot] == 0) {
            backend.resource_map[slot] = index + 1;
            ret true;
        }
        slot    = (slot + 1) & (backend.map_capacity - 1);
        scanned = scanned + 1;
    }
    ret false;
}

# linear probing deletes by shifting the rest of the probe run back, so no
# tombstone is ever left and a lookup ends at the first empty slot
fun resource_map_remove(backend: *Backend, index: u32) {
    val mask:     usize = backend.map_capacity - 1;
    val resource: usize = resource_at(backend, index::usize).resource;
    var hole:     usize = resource_hash(resource) & mask;
    var scanned:  usize = 0;
    for (backend.resource_map[hole] != index + 1) {
        if (backend.resource_map[hole] == 0 || scanned == backend.map_capacity) { ret; }
        hole    = (hole + 1) & mask;
        scanned = scanned + 1;
    }
    backend.resource_map[hole] = 0;
    var next: usize = (hole + 1) & mask;
    for (backend.resource_map[next] != 0) {
        val entry: u32   = backend.resource_map[next];
        val home:  usize = resource_hash(resource_at(backend, (entry - 1)::usize).resource) & mask;
        # an entry may fill the hole only if its home is not after the hole
        if (((next - home) & mask) >= ((next - hole) & mask)) {
            backend.resource_map[hole] = entry;
            backend.resource_map[next] = 0;
            hole                       = next;
        }
        next = (next + 1) & mask;
    }
}

# the map holds indices, so a rehash may move it while every resource stays
# put. it is sized for a resource capacity, up before growth and down after a
# trim
fun resize_map(backend: *Backend, capacity: usize) bool {
    val required: usize = required_map_capacity(capacity);
    if (required == 0)                    { ret false; }
    if (required == backend.map_capacity) { ret true; }
    val got: res[*u32, allocator.Error] = allocator.allocate[u32](?backend.allocator, required);
    if (sel got.err) { ret false; }
    val fresh:             *u32  = got.ok;
    val previous:          *u32  = backend.resource_map;
    val previous_capacity: usize = backend.map_capacity;
    var i:                 usize = 0;
    for (i < required) {
        fresh[i] = 0;
        i        = i + 1;
    }
    backend.resource_map = fresh;
    backend.map_capacity = required;
    i                    = 0;
    for (i < backend.resources.capacity) {
        val entry: *Resource = resource_at(backend, i);
        if (entry.state == RESOURCE_ACTIVE && !resource_map_insert(backend, i::u32)) {
            backend.resource_map = previous;
            backend.map_capacity = previous_capacity;
            allocator.deallocate[u32](?backend.allocator, fresh, required);
            ret false;
        }
        i = i + 1;
    }
    allocator.deallocate[u32](?backend.allocator, previous, previous_capacity);
    ret true;
}

# the resource table's newest chunk joins the pool, every resource free
fun adopt_resources(backend: *Backend) {
    var index: usize = table.chunk_start(?backend.resources, backend.resources.chunk_count - 1);
    for (index < backend.resources.capacity) {
        val entry: *Resource = resource_at(backend, index);
        entry.state        = RESOURCE_FREE;
        entry.generation   = backend.resource_pool.floor;
        entry.index        = index::u32;
        entry.armed        = false;
        entry.closing      = false;
        entry.write_closed = false;
        index              = index + 1;
    }
    table.pool_adopt(?backend.resource_pool, ?backend.resources);
}

# a resource index is 32 bits wide. the map is sized for the new chunk before
# the table grows, so it always fits the table
fun grow_resources(backend: *Backend) bool {
    val chunk: usize = backend.resources.chunk_count;
    if (chunk >= table.DIRECTORY) { ret false; }
    val grown: usize = backend.resources.capacity + table.chunk_capacity(?backend.resources, chunk);
    if (grown - 1 > 0xffffffff || !resize_map(backend, grown) ||
        !table.grow(?backend.resources)) { ret false; }
    adopt_resources(backend);
    ret true;
}

fun resource_acquire(backend: *Backend, resource_value: usize, created: *bool) *Resource {
    val existing: *Resource = resource_lookup(backend, resource_value);
    if (existing != nil) {
        @created = false;
        ret existing;
    }
    if (table.pool_peek(?backend.resource_pool, ?backend.resources) == table.NO_INDEX && !grow_resources(backend)) { ret nil; }
    val index:      u32       = table.pool_take(?backend.resource_pool, ?backend.resources)::u32;
    val resource:   *Resource = resource_at(backend, index::usize);
    val generation: u32       = next_wire_generation(resource.generation);
    resource.state        = RESOURCE_ACTIVE;
    resource.generation   = generation;
    resource.resource     = resource_value;
    resource.watched      = false;
    resource.read_head    = NONE;
    resource.read_tail    = NONE;
    resource.write_head   = NONE;
    resource.write_tail   = NONE;
    resource.close_index  = NONE;
    resource.armed        = false;
    resource.closing      = false;
    resource.write_closed = false;
    if (!resource_map_insert(backend, index)) {
        resource.state = RESOURCE_FREE;
        table.pool_put(?backend.resource_pool, ?backend.resources, index::usize);
        ret nil;
    }
    backend.resource_count = backend.resource_count + 1;
    @created               = true;
    ret resource;
}

fun resource_release_unwatched(backend: *Backend, resource: *Resource) {
    val index: u32 = resource.index;
    set_watched(backend, resource, false);
    resource_map_remove(backend, index);
    resource.state         = RESOURCE_FREE;
    resource.armed         = false;
    backend.resource_count = backend.resource_count - 1;
    table.pool_put(?backend.resource_pool, ?backend.resources, index::usize);
}

# every registration change goes through here, so destroy can prove it gave up
# each one before the runtime recycles the source id they carry
fun set_watched(backend: *Backend, resource: *Resource, watched: bool) {
    if (watched && !resource.watched) { backend.registered = backend.registered + 1; }
    if (!watched && resource.watched) { backend.registered = backend.registered - 1; }
    resource.watched = watched;
}

fun resource_release(backend: *Backend, resource: *Resource) {
    unwatch_owned(backend, resource);
    resource_release_unwatched(backend, resource);
}

# a resource removes only the registration it made itself
fun unwatch_owned(backend: *Backend, resource: *Resource) {
    if (resource.watched) {
        backend.unwatches = backend.unwatches + 1;
        native.io_queue_unwatch(backend.queue, resource.resource);
    }
    set_watched(backend, resource, false);
    resource.armed = false;
}

# the ready table is held at least at the operation table's size, reserved
# before the operations grow, so a finished operation always has somewhere to
# publish. an operation index is 32 bits wide
fun grow_operations(backend: *Backend) bool {
    val chunk: usize = backend.operations.chunk_count;
    if (chunk >= table.DIRECTORY) { ret false; }
    val grown: usize = backend.operations.capacity + table.chunk_capacity(?backend.operations, chunk);
    if (grown - 1 > 0xffffffff || !table.reserve(?backend.ready, grown) ||
        !table.grow(?backend.operations)) { ret false; }
    adopt_operations(backend);
    ret true;
}

# the operation table's newest chunk joins the pool, every operation free
fun adopt_operations(backend: *Backend) {
    var index: usize = table.chunk_start(?backend.operations, backend.operations.chunk_count - 1);
    for (index < backend.operations.capacity) {
        val entry: *Operation = operation_at(backend, index);
        entry.state      = SLOT_FREE;
        entry.generation = backend.operation_pool.floor;
        entry.index      = index::u32;
        entry.previous   = NONE;
        entry.next       = NONE;
        index            = index + 1;
    }
    table.pool_adopt(?backend.operation_pool, ?backend.operations);
}

fun operation_claim(backend: *Backend, kind: runtime.Kind, resource_value: usize, context: usize, token: *types.Token) *Operation {
    if (table.pool_peek(?backend.operation_pool, ?backend.operations) == table.NO_INDEX && !grow_operations(backend)) { ret nil; }
    val index:      u32        = table.pool_take(?backend.operation_pool, ?backend.operations)::u32;
    val operation:  *Operation = operation_at(backend, index::usize);
    var generation: u32        = operation.generation + 1;
    if (generation == 0) { generation = 1; }
    operation.state      = SLOT_ACTIVE;
    operation.generation = generation;
    operation.kind       = kind;
    operation.resource   = resource_value;
    operation.context    = context;
    operation.sequence   = backend.sequence;
    operation.previous   = NONE;
    operation.next       = NONE;
    operation.lane       = LANE_NONE;
    operation.stage      = 0;
    backend.sequence     = backend.sequence + 1;
    backend.live         = backend.live + 1;
    @token               = types.Token{index: index, generation: generation};
    ret operation;
}

fun operation_release(backend: *Backend, index: u32) {
    val operation: *Operation = operation_at(backend, index::usize);
    operation.state    = SLOT_FREE;
    operation.previous = NONE;
    operation.next     = NONE;
    backend.live       = backend.live - 1;
    table.pool_put(?backend.operation_pool, ?backend.operations, index::usize);
}

# give back what a peak grew. operations and resources release a chunk once it
# and the chunk below it are free, the ready table follows the operations down
# but never below what the last publish filled, and the resource map is
# rehashed to the smaller table. only free entries are released, so no live
# token, queued completion or registration context moves or goes stale
fun trim_locked(backend: *Backend) {
    table.pool_trim(?backend.operation_pool, ?backend.operations, $offset_of(Operation, generation));
    var keep: usize = backend.operations.capacity;
    if (keep < backend.ready_count) { keep = backend.ready_count; }
    for (backend.ready.chunk_count > 1) {
        val top: usize = backend.ready.chunk_count - 1;
        if (backend.ready.capacity - table.chunk_capacity(?backend.ready, top) < keep) { brk; }
        val released: err[allocator.Error] = table.shrink(?backend.ready);
        if (sel released.err) { brk; }
    }
    # a refused rehash keeps the larger map, which still fits
    if (table.pool_trim(?backend.resource_pool, ?backend.resources, $offset_of(Resource, generation)) != 0) {
        resize_map(backend, backend.resources.capacity);
    }
}

fun operation_index(backend: *Backend, operation: *Operation) u32 {
    ret operation.index;
}

fun resource_index(backend: *Backend, resource: *Resource) u32 {
    ret resource.index;
}

fun enqueue(backend: *Backend, resource: *Resource, operation: *Operation, lane: u8) {
    val index: u32 = operation_index(backend, operation);
    operation.resource_index = resource_index(backend, resource);
    operation.lane           = lane;
    if (lane == LANE_READ) {
        operation.previous = resource.read_tail;
        if (resource.read_tail == NONE) { resource.read_head = index; }
        or                              { operation_at(backend, resource.read_tail::usize).next = index; }
        resource.read_tail = index;
    }
    or {
        operation.previous = resource.write_tail;
        if (resource.write_tail == NONE) { resource.write_head = index; }
        or                               { operation_at(backend, resource.write_tail::usize).next = index; }
        resource.write_tail = index;
    }
}

fun unlink(backend: *Backend, resource: *Resource, operation: *Operation) {
    val previous: u32 = operation.previous;
    val next:     u32 = operation.next;
    if (operation.lane == LANE_READ) {
        if (previous == NONE) { resource.read_head = next; }
        or                    { operation_at(backend, previous::usize).next = next; }
        if (next == NONE)     { resource.read_tail = previous; }
        or                    { operation_at(backend, next::usize).previous = previous; }
    }
    or (operation.lane == LANE_WRITE) {
        if (previous == NONE) { resource.write_head = next; }
        or                    { operation_at(backend, previous::usize).next = next; }
        if (next == NONE)     { resource.write_tail = previous; }
        or                    { operation_at(backend, next::usize).previous = previous; }
    }
    operation.previous = NONE;
    operation.next     = NONE;
    operation.lane     = LANE_NONE;
}

# a finished operation carries its own completion and the queue links them, so
# the finished queue is never a table that has to be sized
fun finish(backend: *Backend, resource: *Resource, operation: *Operation, status: i64, bytes: usize, items: usize, native_resource: usize, end_of_stream: bool) {
    unlink(backend, resource, operation);
    val index: u32 = operation.index;
    operation.completion.context       = operation.context;
    operation.completion.kind          = operation.kind;
    operation.completion.bytes         = bytes;
    operation.completion.items         = items;
    operation.completion.resource      = native_resource;
    operation.completion.status        = status;
    operation.completion.end_of_stream = end_of_stream;
    operation.previous                 = backend.queued_tail;
    operation.next                     = NONE;
    if (backend.queued_tail == NONE) { backend.queued_head = index; }
    or                               { operation_at(backend, backend.queued_tail::usize).next = index; }
    backend.queued_tail  = index;
    backend.queued_count = backend.queued_count + 1;
    operation.state      = SLOT_QUEUED;
}

fun queued_unlink(backend: *Backend, operation: *Operation) {
    val previous: u32 = operation.previous;
    val next:     u32 = operation.next;
    if (previous == NONE) { backend.queued_head = next; }
    or                    { operation_at(backend, previous::usize).next = next; }
    if (next == NONE)     { backend.queued_tail = previous; }
    or                    { operation_at(backend, next::usize).previous = previous; }
    operation.previous   = NONE;
    operation.next       = NONE;
    backend.queued_count = backend.queued_count - 1;
}

fun would_block(status: i64) bool {
    ret status == native.EAGAIN || status == IN_PROGRESS;
}

fun attempt(backend: *Backend, resource: *Resource, operation: *Operation) bool {
    var result:             i64   = 0;
    var completed_resource: usize = operation.resource;
    var end_of_stream:      bool  = false;
    if (operation.kind == runtime.ACCEPT) {
        result = stream_accept(operation.resource, ?completed_resource);
    }
    or (operation.kind == runtime.CONNECT) {
        if (operation.stage == 0) {
            result = stream_connect(operation.resource, operation.peer);
            if (would_block(result)) {
                operation.stage = 1;
                ret false;
            }
        }
        or {
            result = stream_connect_status(operation.resource);
        }
    }
    or (operation.kind == runtime.READ) {
        result        = stream_read(operation.resource, operation.buffer, operation.length);
        end_of_stream = result == 0 && operation.length != 0;
    }
    or (operation.kind == runtime.READABLE) {
        result        = native.sock_peek_readable(operation.resource);
        end_of_stream = result == 0;
    }
    or (operation.kind == runtime.WRITE) {
        result = stream_write(operation.resource, operation.buffer, operation.length);
    }
    or (operation.kind == runtime.SHUTDOWN) {
        result = stream_shutdown_write(operation.resource);
        if (result >= 0) { resource.write_closed = true; }
    }
    or {
        result = native.EINVAL;
    }
    if (would_block(result)) { ret false; }
    if (result < 0)          { finish(backend, resource, operation, result, 0, 0, completed_resource, false); }
    or {
        var bytes: usize = 0;
        if (operation.kind == runtime.READ || operation.kind == runtime.WRITE) { bytes = result::usize; }
        finish(backend, resource, operation, 0, bytes, 0, completed_resource, end_of_stream);
    }
    ret true;
}

fun fail_resource(backend: *Backend, resource: *Resource, status: i64) {
    for (resource.read_head != NONE || resource.write_head != NONE) {
        var index: u32 = resource.read_head;
        if (index == NONE)                                                                                                                            { index = resource.write_head; }
        or (resource.write_head != NONE && operation_at(backend, resource.write_head::usize).sequence < operation_at(backend, index::usize).sequence) { index = resource.write_head; }
        val operation: *Operation = operation_at(backend, index::usize);
        finish(backend, resource, operation, status, 0, 0, operation.resource, false);
    }
}

fun arm_resource(backend: *Backend, resource: *Resource) {
    var events: u32 = 0;
    if (resource.read_head != NONE)  { events = events | native.IO_EVENT_READ; }
    if (resource.write_head != NONE) { events = events | native.IO_EVENT_WRITE; }
    # an idle socket keeps its resource and its registration, which a oneshot
    # event has already disarmed, so the next operation only rearms it. only a
    # close through the driver gives them up
    if (events == 0) {
        if (resource.close_index != NONE) {
            unwatch_owned(backend, resource);
            val close_operation: *Operation = operation_at(backend, resource.close_index::usize);
            resource.close_index = NONE;
            val closed: i64 = socket_close(resource.resource);
            finish(backend, resource, close_operation, closed, 0, 0, resource.resource, false);
            resource_release_unwatched(backend, resource);
        }
        ret;
    }
    val token:  types.Token = types.Token{index: resource.index, generation: resource.generation};
    var status: i64         = 0;
    if (resource.watched) {
        backend.rearms = backend.rearms + 1;
        status         = native.io_queue_rearm(backend.queue, resource.resource, token_context(backend, token), events);
    }
    or {
        backend.watches = backend.watches + 1;
        status          = native.io_queue_watch(backend.queue, resource.resource, token_context(backend, token), events);
    }
    if (status < 0) {
        fail_resource(backend, resource, status);
        unwatch_owned(backend, resource);
        if (resource.close_index != NONE) {
            val close_operation: *Operation = operation_at(backend, resource.close_index::usize);
            resource.close_index = NONE;
            val closed: i64 = socket_close(resource.resource);
            finish(backend, resource, close_operation, closed, 0, 0, resource.resource, false);
        }
        resource_release_unwatched(backend, resource);
        ret;
    }
    set_watched(backend, resource, true);
    resource.armed = true;
}

fun drive_resource(backend: *Backend, resource: *Resource, events: u32) {
    val failure: bool = (events & (native.IO_EVENT_ERROR | native.IO_EVENT_HANGUP)) != 0;
    if ((events & native.IO_EVENT_READ) != 0 || failure) {
        var progress: bool = true;
        for (progress && resource.read_head != NONE) {
            progress = attempt(backend, resource, operation_at(backend, resource.read_head::usize));
        }
    }
    if ((events & native.IO_EVENT_WRITE) != 0 || failure) {
        var progress: bool = true;
        for (progress && resource.write_head != NONE) {
            progress = attempt(backend, resource, operation_at(backend, resource.write_head::usize));
        }
    }
    arm_resource(backend, resource);
}

fun prepare(backend: *Backend, resource_value: usize, kind: runtime.Kind, context: usize, lane: u8, token: *types.Token, resource_out: **Resource, operation_out: **Operation) i64 {
    if (backend == nil || token == nil || resource_out == nil || operation_out == nil) { ret invalid(); }
    var created:  bool      = false;
    val resource: *Resource = resource_acquire(backend, resource_value, ?created);
    if (resource == nil || resource.closing) { ret native.EBADF; }
    if (lane == LANE_WRITE && resource.write_closed && kind != runtime.CLOSE) {
        if (created) { resource_release(backend, resource); }
        ret native.EPIPE;
    }
    val operation: *Operation = operation_claim(backend, kind, resource_value, context, token);
    if (operation == nil) {
        if (created) { resource_release(backend, resource); }
        ret native.ENOMEM;
    }
    operation.buffer         = nil;
    operation.length         = 0;
    operation.resource_index = resource_index(backend, resource);
    if (lane != LANE_NONE) { enqueue(backend, resource, operation, lane); }
    @resource_out  = resource;
    @operation_out = operation;
    ret 0;
}

# a refused submission may have dropped a stale resource, so it trims too
fun begin(backend: *Backend, resource_value: usize, kind: runtime.Kind, context: usize, lane: u8, token: *types.Token, resource_out: **Resource, operation_out: **Operation) i64 {
    val status: i64 = prepare(backend, resource_value, kind, context, lane, token, resource_out, operation_out);
    if (status < 0) { trim_locked(backend); }
    ret status;
}

fun submission_done(backend: *Backend, resource: *Resource) {
    drive_resource(backend, resource, native.IO_EVENT_READ | native.IO_EVENT_WRITE);
    trim_locked(backend);
    mutex.unlock(?backend.lock);
    native.io_queue_wake(backend.queue);
}

# initial is the size the backend starts at: the operation, resource and ready
# tables grow on demand and the resource map rehashes with them
# ---
# a: where the tables, the resource map and the completion batch come from;
#    the backend keeps a copy, so a's context must outlive it
pub fun make(backend: *Backend, queue: *shared.IoQueue, a: *allocator.Allocator, initial: usize, source_id: u16) i64 {
    if (backend == nil || queue == nil || a == nil || initial == 0 || source_id == 0) { ret invalid(); }
    val map_capacity: usize = required_map_capacity(initial);
    if (map_capacity == 0) { ret native.ENOMEM; }
    backend.allocator = @a;
    if (!table.make(?backend.operations, ?backend.allocator, $size_of(Operation), initial)) { ret native.ENOMEM; }
    if (!table.make(?backend.resources, ?backend.allocator, $size_of(Resource), initial) ||
        !table.make(?backend.ready, ?backend.allocator, $size_of(types.NativeCompletion), initial)) {
        table.destroy(?backend.ready);
        table.destroy(?backend.resources);
        table.destroy(?backend.operations);
        ret native.ENOMEM;
    }
    val map: res[*u32, allocator.Error] = allocator.zallocate[u32](?backend.allocator, map_capacity);
    if (sel map.err) {
        table.destroy(?backend.ready);
        table.destroy(?backend.resources);
        table.destroy(?backend.operations);
        ret native.ENOMEM;
    }
    backend.resource_map = map.ok;
    val batch: res[*native.IoCompletion, allocator.Error] = allocator.allocate[native.IoCompletion](?backend.allocator, NATIVE_BATCH);
    if (sel batch.err) {
        allocator.deallocate[u32](?backend.allocator, backend.resource_map, map_capacity);
        backend.resource_map = nil;
        table.destroy(?backend.ready);
        table.destroy(?backend.resources);
        table.destroy(?backend.operations);
        ret native.ENOMEM;
    }
    backend.native = batch.ok;

    backend.queue          = queue;
    backend.source_id      = source_id;
    backend.map_capacity   = map_capacity;
    backend.live           = 0;
    backend.resource_count = 0;
    table.pool_make(?backend.operation_pool, $offset_of(Operation, pool_next));
    table.pool_make(?backend.resource_pool, $offset_of(Resource, next_free));
    adopt_operations(backend);
    adopt_resources(backend);
    backend.queued_head  = NONE;
    backend.queued_tail  = NONE;
    backend.queued_count = 0;
    backend.ready_count  = 0;
    backend.sequence     = 1;
    backend.watches      = 0;
    backend.rearms       = 0;
    backend.unwatches    = 0;
    backend.registered   = 0;
    backend.locates      = 0;
    backend.lock         = mutex.make();
    var i: usize = 0;
    for (i < map_capacity) {
        backend.resource_map[i] = 0;
        i                       = i + 1;
    }
    ret 0;
}

pub fun create_connect(value: endpoint.Endpoint, resource: *usize) i64 {
    ret local_impl.create_stream(value, true, resource);
}

pub fun cleanup_listener(listener: *local_types.Listener) i64 {
    ret local_impl.cleanup_listener(listener);
}

pub fun rename_listener(listener: *local_types.Listener, replacement: endpoint.Endpoint) i64 {
    ret local_impl.rename(listener, replacement);
}

pub fun close_resource(backend: *Backend, resource: usize) i64 {
    ret os.sock_close(resource);
}

pub fun submit_accept(backend: *Backend, listener: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, listener, runtime.ACCEPT, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_connect(backend: *Backend, resource_value: usize, peer: endpoint.Endpoint, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, resource_value, runtime.CONNECT, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.peer = peer;
    submission_done(backend, resource);
    ret 0;
}

# the backend exclusively owns receive and close access until queued work completes.
pub fun submit_read(backend: *Backend, resource_value: usize, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || (buffer == nil && length != 0)) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, resource_value, runtime.READ, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.buffer = buffer;
    operation.length = length;
    submission_done(backend, resource);
    ret 0;
}

# wait for the stream to be readable without a buffer: the completion reports
# end_of_stream at orderly EOF, and nothing is read
pub fun submit_readable(backend: *Backend, resource_value: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, resource_value, runtime.READABLE, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_write(backend: *Backend, resource_value: usize, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || (buffer == nil && length != 0)) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, resource_value, runtime.WRITE, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.buffer = buffer;
    operation.length = length;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_shutdown_write(backend: *Backend, resource_value: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, resource_value, runtime.SHUTDOWN, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_close(backend: *Backend, resource_value: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, resource_value, runtime.CLOSE, context, LANE_NONE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    resource.closing     = true;
    resource.close_index = operation_index(backend, operation);
    for (resource.read_head != NONE) {
        val read_operation: *Operation = operation_at(backend, resource.read_head::usize);
        finish(backend, resource, read_operation, native.ECANCELED, 0, 0, resource_value, false);
    }
    submission_done(backend, resource);
    ret 0;
}

# cancel an operation. one that already finished and waits to be published is
# withdrawn and handed back through finished, whatever it moved included, so the
# caller reports it with the cancellation: an accepted socket in it is the
# caller's to hand over or close
pub fun cancel(backend: *Backend, token: types.Token, finished: *opt[types.NativeCompletion]) i64 {
    if (finished != nil) { @finished = opt[types.NativeCompletion].none{}; }
    if (backend == nil)  { ret invalid(); }
    mutex.lock(?backend.lock);
    val operation: *Operation = operation_any(backend, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret native.EBADF;
    }
    if (operation.state == SLOT_QUEUED) {
        val removed: types.NativeCompletion = operation.completion;
        queued_unlink(backend, operation);
        operation_release(backend, token.index);
        trim_locked(backend);
        mutex.unlock(?backend.lock);
        if (finished != nil)                                       { @finished = opt[types.NativeCompletion].some{removed}; }
        or (removed.kind == runtime.ACCEPT && removed.status == 0) { socket_close(removed.resource); }
        native.io_queue_wake(backend.queue);
        ret 0;
    }
    val resource: *Resource = resource_at(backend, operation.resource_index::usize);
    if (operation.kind == runtime.CLOSE) {
        resource.close_index = NONE;
        unlink(backend, resource, operation);
        operation_release(backend, token.index);
        fail_resource(backend, resource, native.ECANCELED);
        unwatch_owned(backend, resource);
        socket_close(resource.resource);
        resource_release_unwatched(backend, resource);
        trim_locked(backend);
        mutex.unlock(?backend.lock);
        native.io_queue_wake(backend.queue);
        ret 0;
    }
    unlink(backend, resource, operation);
    operation_release(backend, token.index);
    drive_resource(backend, resource, native.IO_EVENT_READ | native.IO_EVENT_WRITE);
    trim_locked(backend);
    mutex.unlock(?backend.lock);
    native.io_queue_wake(backend.queue);
    ret 0;
}

fun publish_ready(backend: *Backend) usize {
    var count: usize = 0;
    for (backend.queued_count > 0) {
        val index:     u32        = backend.queued_head;
        val operation: *Operation = operation_at(backend, index::usize);
        @ready_at(backend, count) = operation.completion;
        queued_unlink(backend, operation);
        operation_release(backend, index);
        count = count + 1;
    }
    backend.ready_count = count;
    trim_locked(backend);
    ret count;
}

pub fun flush(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    val ready: usize = publish_ready(backend);
    mutex.unlock(?backend.lock);
    ret ready::i64;
}

pub fun dispatch(
    backend: *Backend,
    context: usize,
    events: u32,
    status: i64,
    flags: u64,
    claimed: *bool,
) i64 {
    if (backend == nil || claimed == nil) { ret invalid(); }
    @claimed = false;
    var resource_token: types.Token;
    if (!context_token(backend, context, ?resource_token)) { ret 0; }
    @claimed = true;
    mutex.lock(?backend.lock);
    val resource: *Resource = resource_for(backend, resource_token);
    if (resource != nil) {
        resource.armed = false;
        drive_resource(backend, resource, events);
    }
    val ready: usize = publish_ready(backend);
    mutex.unlock(?backend.lock);
    ret ready::i64;
}

# one thread owns poll and completion retrieval
pub fun poll(backend: *Backend, timeout_ms: i32) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    backend.ready_count = 0;
    val already_ready: bool = backend.queued_count != 0;
    mutex.unlock(?backend.lock);

    var native_timeout: i32 = timeout_ms;
    if (already_ready) { native_timeout = 0; }
    val count: i64 = native.io_queue_poll(backend.queue, backend.native, NATIVE_BATCH, native_timeout);
    mutex.lock(?backend.lock);
    var i: usize = 0;
    if (count > 0) {
        for (i < count::usize) {
            val native_completion: native.IoCompletion = backend.native[i];
            if (native_completion.context != 0 && (native_completion.events & native.IO_EVENT_WAKE) == 0) {
                var resource_token: types.Token;
                if (context_token(backend, native_completion.context, ?resource_token)) {
                    val resource: *Resource = resource_for(backend, resource_token);
                    if (resource != nil) {
                        resource.armed = false;
                        drive_resource(backend, resource, native_completion.events);
                    }
                }
            }
            i = i + 1;
        }
    }
    val ready: usize = publish_ready(backend);
    mutex.unlock(?backend.lock);
    if (ready == 0 && count < 0) { ret count; }
    ret ready::i64;
}

pub fun completion(backend: *Backend, index: usize, out: *types.NativeCompletion) i64 {
    if (backend == nil || out == nil || index >= backend.ready_count) { ret invalid(); }
    @out = @ready_at(backend, index);
    ret 0;
}

pub fun destroy(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    if (backend.live != 0 || backend.queued_count != 0) {
        mutex.unlock(?backend.lock);
        ret native.EBUSY;
    }
    # sockets idle at destruction still hold their resource and registration
    var slot: usize = 0;
    for (slot < backend.resources.capacity) {
        val resource: *Resource = resource_at(backend, slot);
        if (resource.state == RESOURCE_ACTIVE) { resource_release(backend, resource); }
        slot = slot + 1;
    }
    # a registration left behind could name this source id after it is reused
    if (backend.registered != 0) { panic.panic("std.net.async: destroy left a native registration behind\n"); }
    allocator.deallocate[native.IoCompletion](?backend.allocator, backend.native, NATIVE_BATCH);
    allocator.deallocate[u32](?backend.allocator, backend.resource_map, backend.map_capacity);
    table.destroy(?backend.ready);
    table.destroy(?backend.resources);
    table.destroy(?backend.operations);
    backend.native       = nil;
    backend.resource_map = nil;
    backend.map_capacity = 0;
    backend.ready_count  = 0;
    backend.queued_head  = NONE;
    backend.queued_tail  = NONE;
    backend.queue        = nil;
    backend.source_id    = 0;
    mutex.unlock(?backend.lock);
    ret 0;
}

fun stream_accept(listener: usize, accepted: *usize) i64 {
    if (accepted == nil) { ret invalid(); }
    var address:        [128]u8;
    var address_length: u32 = 128;
    ret native.sock_accept_flags(listener, ?address[0], ?address_length, true, true, accepted);
}

fun stream_connect(resource: usize, peer: endpoint.Endpoint) i64 {
    ret local_impl.connect_start(resource, peer);
}

fun stream_connect_status(resource: usize) i64 {
    ret native.sock_connect_status(resource);
}

fun stream_read(resource: usize, buffer: *u8, length: usize) i64 {
    if (buffer == nil && length != 0) { ret invalid(); }
    ret local_impl.read(resource, buffer, length);
}

fun stream_write(resource: usize, buffer: *u8, length: usize) i64 {
    if (buffer == nil && length != 0) { ret invalid(); }
    ret native.sock_send(resource, buffer, length);
}

fun stream_shutdown_write(resource: usize) i64 {
    ret native.sock_shutdown(resource, native.SHUT_WR);
}

fun socket_close(resource: usize) i64 {
    ret native.sock_close(resource);
}

$if ($mach.build.os == $mach.os.linux) {
    # the test's own inventory of its descriptor table, never a production mechanism
    fun test_descriptor_count() i64 {
        val directory: i64 = native.open(native.AT_FDCWD, "/proc/self/fd", native.O_RDONLY | native.O_DIRECTORY, 0);
        if (directory < 0) { ret directory; }
        var cursor:      native.DirectoryCursor     = native.DirectoryCursor{};
        val initialized: native.DirectoryInitResult = native.directory_init(?cursor, directory::i32);
        if (initialized.code != 0) {
            native.close(directory::i32);
            ret initialized.code;
        }
        var count: i64 = 0;
        var entry: native.DirectoryEntry;
        var next:  i64 = native.directory_next(?cursor, ?entry);
        for (next > 0) {
            if (entry.name[0] != '.') { count = count + 1; }
            next = native.directory_next(?cursor, ?entry);
        }
        native.directory_close(?cursor);
        native.close(directory::i32);
        if (next < 0) { ret next; }
        ret count - 1;
    }

    fun test_send_rights(handle: usize, data: *u8, length: usize, descriptor: i32, count: usize) i64 {
        var control:       [1032]u8;
        val record_length: usize = 16 + count * 4;
        @((?control[0])::*usize) = record_length;
        @((?control[8])::*i32) = native.SOL_SOCKET;
        @((?control[12])::*i32) = native.SCM_RIGHTS;
        var i: usize = 0;
        for (i < count) {
            @((?control[16 + i * 4])::*i32) = descriptor;
            i = i + 1;
        }
        var vector: native.IoVector = native.IoVector{data: data, length: length};
        ret native.sock_send_message(handle, ?vector, 1, nil, 0, ?control[0], (record_length + 7) & ~7::usize);
    }

    fun test_endpoint_name(output: *u8) usize {
        val prefix: *u8   = "/tmp/mach-std-local-618-";
        var length: usize = 0;
        for (prefix[length] != 0) {
            output[length] = prefix[length];
            length         = length + 1;
        }
        var process: u64   = native.getpid()::u64;
        var digits:  [20]u8;
        var count:   usize = 0;
        if (process == 0) {
            digits[0] = '0';
            count     = 1;
        }
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process       = process / 10;
            count         = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            output[length] = digits[count - i - 1];
            length         = length + 1;
            i              = i + 1;
        }
        output[length]     = '.';
        output[length + 1] = 's';
        output[length + 2] = 'o';
        output[length + 3] = 'c';
        output[length + 4] = 'k';
        output[length + 5] = 0;
        ret length + 5;
    }

    test async_local_queued_reads_close_unwanted_rights_and_complete_with_the_bytes {
        var pa: allocator.Allocator;
        page.make(?pa);
        var pipe: [2]i32;
        if (native.pipe(?pipe[0]) < 0) { ret 1; }
        fin {
            native.close(pipe[0]);
            native.close(pipe[1]);
        }
        var path:            [108]u8;
        val path_length:     usize                                  = test_endpoint_name(?path[0]);
        val endpoint_result: res[endpoint.Endpoint, io_error.Error] = endpoint.filesystem_bytes(?path[0], path_length);
        if (sel endpoint_result.err) { ret 2; }
        val bound:    endpoint.Endpoint = endpoint_result.ok;
        var listener: local_types.Listener;
        listener.handle            = (-1)::isize::usize;
        listener.endpoint          = bound;
        listener.ownership         = local_types.OWNED;
        listener.has_node_identity = false;
        val options: local_types.ListenOptions = local_types.ListenOptions{
            backlog:     4, ownership: local_types.OWNED, stale: local_types.REMOVE_STALE_SOCKET,
            permissions: local_types.INHERIT_PERMISSIONS,
        };
        if (local_impl.listen(?listener, bound, options) < 0) { ret 3; }
        fin { local_impl.close_listener(?listener); }
        var client: local_types.Stream;
        if (local_impl.connect(?client, bound, true) < 0) { ret 4; }
        fin {
            if (client.handle != (-1)::isize::usize) { native.sock_close(client.handle); }
        }
        var server: local_types.Stream;
        if (local_impl.accept(?listener, ?server, false) < 0) { ret 5; }
        fin { native.sock_close(server.handle); }
        var queue: shared.IoQueue;
        if (native.io_queue_create(?queue) < 0) { ret 6; }
        fin { native.io_queue_close(?queue); }
        var backend: Backend;
        if (make(?backend, ?queue, ?pa, 4, 1) < 0) { ret 7; }
        fin { destroy(?backend); }
        val before: i64 = test_descriptor_count();
        if (before < 0) { ret 8; }
        var buffer: [64]u8;
        var token:  types.Token;
        # the read is queued before any bytes exist, then the peer attaches rights to them
        if (submit_read(?backend, client.handle, ?buffer[0], 64, 618, ?token) < 0) { ret 9; }
        if (poll(?backend, 0) != 0)                                                { ret 10; }
        if (test_send_rights(server.handle, "abc", 3, pipe[0], 16) != 3)           { ret 11; }
        if (poll(?backend, 1000) != 1)                                             { ret 12; }
        var result: types.NativeCompletion;
        if (completion(?backend, 0, ?result) < 0)                                                     { ret 13; }
        if (result.context != 618 || result.status != 0 || result.bytes != 3 || result.end_of_stream) { ret 14; }
        if (buffer[0] != 'a' || buffer[1] != 'b' || buffer[2] != 'c')                                 { ret 15; }
        if (test_descriptor_count() != before)                                                        { ret 16; }
        # rights already queued when the read is submitted complete on the first drive
        if (test_send_rights(server.handle, "d", 1, pipe[0], native.SCM_MAX_FD) != 1)             { ret 17; }
        if (submit_read(?backend, client.handle, ?buffer[0], 64, 619, ?token) < 0)                { ret 18; }
        if (poll(?backend, 1000) != 1 || completion(?backend, 0, ?result) < 0)                    { ret 19; }
        if (result.context != 619 || result.status != 0 || result.bytes != 1 || buffer[0] != 'd') { ret 20; }
        if (test_descriptor_count() != before)                                                    { ret 21; }
        if (submit_close(?backend, client.handle, 620, ?token) < 0)                               { ret 22; }
        client.handle = (-1)::isize::usize;
        if (poll(?backend, 1000) != 1 || completion(?backend, 0, ?result) < 0) { ret 23; }
        if (result.context != 620 || result.status != 0)                       { ret 24; }
        if (test_descriptor_count() != before - 1)                             { ret 25; }
        var byte: u8 = 0;
        if (native.write(pipe[1], "k", 1) != 1 || native.read(pipe[0], ?byte, 1) != 1 || byte != 'k') { ret 26; }
        ret 0;
    }
}

# slots that hold something other than a live resource: tombstones, which
# lengthen every later lookup
fun test_map_stale(backend: *Backend) usize {
    var stale: usize = 0;
    var slot:  usize = 0;
    for (slot < backend.map_capacity) {
        val entry: u32 = backend.resource_map[slot];
        if (entry != 0) {
            val index: usize = (entry - 1)::usize;
            if (index >= backend.resources.capacity || resource_at(backend, index).state != RESOURCE_ACTIVE) { stale = stale + 1; }
        }
        slot = slot + 1;
    }
    ret stale;
}

# the probes a lookup of value makes before it finds value or an empty slot
fun test_map_probes(backend: *Backend, value: usize) usize {
    var slot:   usize = resource_hash(value) & (backend.map_capacity - 1);
    var probes: usize = 1;
    for (probes <= backend.map_capacity) {
        val entry: u32 = backend.resource_map[slot];
        if (entry == 0) { ret probes; }
        val index: usize = (entry - 1)::usize;
        if (index < backend.resources.capacity) {
            val candidate: *Resource = resource_at(backend, index);
            if (candidate.state == RESOURCE_ACTIVE && candidate.resource == value) { ret probes; }
        }
        slot   = (slot + 1) & (backend.map_capacity - 1);
        probes = probes + 1;
    }
    ret probes;
}

# n resources registered and released for several rounds, then n live ones:
# reports leftover stale slots and the longest hit and miss probe
fun test_map_churn(n: usize, stale: *usize, max_hit: *usize, max_miss: *usize) i64 {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (native.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, n, 1) < 0) {
        native.io_queue_close(?queue);
        ret 2;
    }
    var base:  usize = 0x100000;
    var round: usize = 0;
    for (round < 4) {
        var j: usize = 0;
        for (j < n) {
            var created: bool = false;
            if (resource_acquire(?backend, base + j, ?created) == nil) { ret 3; }
            j = j + 1;
        }
        if (round < 3) {
            j = 0;
            for (j < n) {
                val resource: *Resource = resource_lookup(?backend, base + j);
                if (resource == nil) { ret 4; }
                resource_release_unwatched(?backend, resource);
                j = j + 1;
            }
            base = base + n;
        }
        round = round + 1;
    }
    @stale    = test_map_stale(?backend);
    @max_hit  = 0;
    @max_miss = 0;
    var j: usize = 0;
    for (j < n) {
        val hit:  usize = test_map_probes(?backend, base + j);
        val miss: usize = test_map_probes(?backend, base + n + j);
        if (hit > @max_hit)   { @max_hit = hit; }
        if (miss > @max_miss) { @max_miss = miss; }
        j = j + 1;
    }
    j = 0;
    for (j < n) {
        val resource: *Resource = resource_lookup(?backend, base + j);
        if (resource == nil) { ret 5; }
        resource_release_unwatched(?backend, resource);
        j = j + 1;
    }
    if (destroy(?backend) < 0) { ret 6; }
    native.io_queue_close(?queue);
    ret 0;
}

# destroy gives up every registration it holds, so no event can name its source
# id once the runtime reuses it (#740)
test async_local_unix_destroy_removes_every_registration_it_holds {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (native.io_queue_create(?queue) < 0) { ret 1; }
    fin { native.io_queue_close(?queue); }
    var pipe: [2]i32;
    if (native.pipe(?pipe[0]) < 0) { ret 2; }
    fin {
        native.close(pipe[0]);
        native.close(pipe[1]);
    }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, 8, 1) < 0) { ret 3; }
    var created:  bool      = false;
    val resource: *Resource = resource_acquire(?backend, pipe[0]::usize, ?created);
    if (resource == nil) { ret 4; }
    val context: usize = token_context(?backend, types.Token{index: resource.index, generation: resource.generation});
    if (native.io_queue_watch(?queue, pipe[0]::usize, context, native.IO_EVENT_READ) < 0) { ret 5; }
    set_watched(?backend, resource, true);
    if (backend.registered != 1)                          { ret 6; }
    if (destroy(?backend) < 0 || backend.registered != 0) { ret 7; }
    var byte: u8 = 1;
    if (native.write(pipe[1], ?byte, 1) != 1) { ret 8; }
    var events: [4]native.IoCompletion;
    if (native.io_queue_poll(?queue, ?events[0], 4, 0) != 0) { ret 9; }
    ret 0;
}

# lookups stay short however much a server churns its sockets (#737)
test async_local_unix_resource_lookups_stay_bounded_after_churn_at_1k_10k_and_100k {
    var sizes: [3]usize = [3]usize{1000, 10000, 100000};
    var i:     usize    = 0;
    for (i < 3) {
        var stale:    usize = 0;
        var max_hit:  usize = 0;
        var max_miss: usize = 0;
        val churned:  i64   = test_map_churn(sizes[i], ?stale, ?max_hit, ?max_miss);
        if (churned != 0)                  { ret 10 + churned::i32; }
        if (stale != 0)                    { ret 20 + i::i32; }
        if (max_hit > 32 || max_miss > 32) { ret 30 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

# bytes live at the allocator a backend is made with
rec Counting {
    inner: allocator.Allocator;
    live:  usize;
}

fun counting_allocate(context: ptr, size: usize, align: usize) opt[ptr] {
    val counting: *Counting = context::*Counting;
    val got:      opt[ptr]  = counting.inner.fn_allocate(counting.inner.ctx, size, align);
    if (sel got.some) { counting.live = counting.live + size; }
    ret got;
}

fun counting_reallocate(context: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val counting: *Counting = context::*Counting;
    val got:      opt[ptr]  = counting.inner.fn_reallocate(counting.inner.ctx, p, old_size, new_size, align);
    if (sel got.some) { counting.live = counting.live - old_size + new_size; }
    ret got;
}

fun counting_deallocate(context: ptr, p: ptr, size: usize, align: usize) i64 {
    val counting: *Counting = context::*Counting;
    val code:     i64       = counting.inner.fn_deallocate(counting.inner.ctx, p, size, align);
    if (code == 0) { counting.live = counting.live - size; }
    ret code;
}

fun counting_make(counting: *Counting, a: *allocator.Allocator) {
    page.make(?counting.inner);
    counting.live = 0;
    @a            = allocator.Allocator{
        ctx:           counting::ptr,
        fn_allocate:   counting_allocate,
        fn_reallocate: counting_reallocate,
        fn_deallocate: counting_deallocate,
    };
}

# n resources each carrying one operation, then all of them released: the
# bytes held idle, at the peak and once the peak drained
fun footprint_peak(n: usize, idle: *usize, peak: *usize, after: *usize) i64 {
    var counting: Counting;
    var a:        allocator.Allocator;
    counting_make(?counting, ?a);
    var pa: allocator.Allocator;
    page.make(?pa);
    val tokens: res[*types.Token, allocator.Error] = allocator.allocate[types.Token](?pa, n);
    if (sel tokens.err) { ret 1; }
    var queue: shared.IoQueue;
    if (native.io_queue_create(?queue) < 0) { ret 2; }
    var backend: Backend;
    if (make(?backend, ?queue, ?a, 64, 1) < 0) { ret 3; }
    @idle = counting.live;
    var j: usize = 0;
    for (j < n) {
        var created: bool = false;
        if (resource_acquire(?backend, 0x100000 + j, ?created) == nil)                      { ret 4; }
        if (operation_claim(?backend, runtime.READ, 0x100000 + j, j, ?tokens.ok[j]) == nil) { ret 5; }
        j = j + 1;
    }
    @peak = counting.live;
    j     = 0;
    for (j < n) {
        operation_release(?backend, tokens.ok[j].index);
        resource_release_unwatched(?backend, resource_lookup(?backend, 0x100000 + j));
        j = j + 1;
    }
    trim_locked(?backend);
    @after = counting.live;
    if (backend.live != 0 || backend.resource_count != 0) { ret 6; }
    if (destroy(?backend) < 0)                            { ret 7; }
    native.io_queue_close(?queue);
    allocator.deallocate[types.Token](?pa, tokens.ok, n);
    if (counting.live != 0) { ret 8; }
    ret 0;
}

# #874: after a peak drains every table is back at its idle size, so what a
# peak grew goes back to the allocator
test async_local_unix_a_drained_peak_returns_the_tables_to_idle_at_1k_10k_and_100k {
    val sizes: [3]usize = [3]usize{1000, 10000, 100000};
    var i:     usize    = 0;
    for (i < 3) {
        var idle:  usize = 0;
        var peak:  usize = 0;
        var after: usize = 0;
        val ran:   i64   = footprint_peak(sizes[i], ?idle, ?peak, ?after);
        if (ran != 0)                    { ret 10 * (i::i32 + 1) + ran::i32; }
        if (peak < idle + 64 * sizes[i]) { ret 40 + i::i32; }
        if (after != idle)               { ret 50 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

# #874: a trim releases only empty chunks, so a live operation and resource
# stay where they were and still resolve, one pinned high keeps its chunk, and
# a token or wire context from a released chunk stays refused once it is grown
# again
test async_local_unix_live_entries_survive_a_shrink_and_stale_tokens_stay_refused {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (native.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, 4, 1) < 0) { ret 1; }
    var created: bool = false;
    # a low operation and resource held across the shrink
    val low:           *Resource  = resource_acquire(?backend, 0x200000, ?created);
    var low_token:     types.Token;
    val low_operation: *Operation = operation_claim(?backend, runtime.READ, 0x200000, 1, ?low_token);
    if (low == nil || low_operation == nil) { ret 2; }
    val low_resource: types.Token = types.Token{index: low.index, generation: low.generation};
    var tokens:       [64]types.Token;
    var j:            usize       = 0;
    for (j < 64) {
        if (resource_acquire(?backend, 0x300000 + j, ?created) == nil ||
            operation_claim(?backend, runtime.READ, 0x300000 + j, 2, ?tokens[j]) == nil) { ret 3; }
        j = j + 1;
    }
    if (backend.operations.chunk_count < 4 || backend.resources.chunk_count < 4) { ret 4; }
    val high:          types.Token = tokens[63];
    val high_resource: *Resource   = resource_lookup(?backend, 0x300000 + 63);
    val high_context:  usize       = token_context(?backend, types.Token{index: high_resource.index, generation: high_resource.generation});
    # the last entry pins the top chunk, so nothing goes
    j = 0;
    for (j < 63) {
        operation_release(?backend, tokens[j].index);
        resource_release_unwatched(?backend, resource_lookup(?backend, 0x300000 + j));
        j = j + 1;
    }
    val chunks: usize = backend.operations.chunk_count;
    trim_locked(?backend);
    if (backend.operations.chunk_count != chunks || operation_for(?backend, high) == nil) { ret 5; }
    # once it goes, every chunk above the live ones is released
    operation_release(?backend, high.index);
    resource_release_unwatched(?backend, high_resource);
    trim_locked(?backend);
    # chunk 0 holds the low entries and chunk 1 stays as slack
    if (backend.operations.chunk_count != 2 || backend.resources.chunk_count != 2 ||
        backend.ready.chunk_count != 2) { ret 6; }
    if (operation_at(?backend, low_token.index::usize) != low_operation ||
        operation_for(?backend, low_token) != low_operation ||
        resource_for(?backend, low_resource) != low ||
        resource_lookup(?backend, 0x200000) != low) { ret 7; }
    var decoded: types.Token;
    if (operation_for(?backend, high) != nil || operation_any(?backend, high) != nil ||
        !context_token(?backend, high_context, ?decoded) || resource_for(?backend, decoded) != nil) { ret 8; }
    # regrown, the released indices come back under generations no old token has
    j = 0;
    for (j < 64) {
        if (resource_acquire(?backend, 0x400000 + j, ?created) == nil ||
            operation_claim(?backend, runtime.READ, 0x400000 + j, 3, ?tokens[j]) == nil) { ret 9; }
        j = j + 1;
    }
    if (high.index::usize >= backend.operations.capacity || decoded.index::usize >= backend.resources.capacity) { ret 10; }
    if (operation_for(?backend, high) != nil || operation_any(?backend, high) != nil ||
        resource_for(?backend, decoded) != nil) { ret 11; }
    if (operation_for(?backend, low_token) != low_operation || resource_for(?backend, low_resource) != low) { ret 12; }
    j = 0;
    for (j < 64) {
        operation_release(?backend, tokens[j].index);
        resource_release_unwatched(?backend, resource_lookup(?backend, 0x400000 + j));
        j = j + 1;
    }
    operation_release(?backend, low_token.index);
    resource_release_unwatched(?backend, low);
    if (destroy(?backend) < 0) { ret 13; }
    native.io_queue_close(?queue);
    ret 0;
}

# #874: a load that crosses a chunk boundary back and forth keeps the empty
# chunk above it as slack, so only the first crossing allocates
test async_local_unix_a_load_oscillating_across_a_chunk_boundary_allocates_once {
    var counting: Counting;
    var a:        allocator.Allocator;
    counting_make(?counting, ?a);
    var queue: shared.IoQueue;
    if (native.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?a, 4, 1) < 0) { ret 1; }
    var tokens: [5]types.Token;
    var j:      usize = 0;
    for (j < 4) {
        if (operation_claim(?backend, runtime.READ, 1, j, ?tokens[j]) == nil) { ret 2; }
        j = j + 1;
    }
    var crossed: usize = 0;
    var round:   usize = 0;
    for (round < 100) {
        if (operation_claim(?backend, runtime.READ, 1, 4, ?tokens[4]) == nil) { ret 3; }
        if (round == 0)                                                       { crossed = counting.live; }
        operation_release(?backend, tokens[4].index);
        trim_locked(?backend);
        if (counting.live != crossed) { ret 4; }
        round = round + 1;
    }
    j = 0;
    for (j < 4) {
        operation_release(?backend, tokens[j].index);
        j = j + 1;
    }
    trim_locked(?backend);
    if (backend.operations.chunk_count != 1 || backend.ready.chunk_count != 1) { ret 5; }
    if (destroy(?backend) < 0)                                                 { ret 6; }
    native.io_queue_close(?queue);
    if (counting.live != 0) { ret 7; }
    ret 0;
}
