# bounded local unix readiness backend
# backend for std.net.async.local, signatures may change in a minor release (README, API surface)
# the engine is std.net.async.readiness. a local handle carries no opening.

$if ($mach.build.os == $mach.os.linux) {
    use native: std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use native: std.system.os.darwin;
}
$or {
    $error("std.net.async.local.unix: requires linux or darwin target");
}

use std.allocator;
use std.allocator.page;
use io_error: std.io.error;
use std.io.runtime;
use std.net.async.readiness;
use std.net.async.types;
use std.net.local.endpoint;
use local_types: std.net.local.types;
use local_impl:  std.net.local.unix;
use std.sync.mutex;
use std.system.os;
use std.system.os.shared;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.isize;
use std.types.size.usize;

fwd types.Token;
fwd types.NativeCompletion;

fwd readiness.CANCEL_NEEDS_NATIVE_CONTROL;
fwd readiness.Backend;
fwd readiness.aliases;
fwd readiness.cancel;
fwd readiness.flush;
fwd readiness.dispatch;
fwd readiness.poll;
fwd readiness.completion;
fwd readiness.destroy;

# a local operation: the engine's part, then the peer a connect carries
rec Request {
    operation: readiness.Operation;
    peer:      endpoint.Endpoint;
}

# initial is the size the backend starts at: the operation, resource and ready
# tables grow on demand and the resource map rehashes with them
# ---
# a: where the tables, the resource map and the completion batch come from;
#    the backend keeps a copy, so a's context must outlive it
pub fun make(backend: *readiness.Backend, queue: *shared.IoQueue, a: *allocator.Allocator, initial: usize, source_id: u16) i64 {
    ret readiness.make(backend, queue, a, initial, source_id, readiness.Protocol{
        operation_size: $size_of(Request),
        attempt:        attempt,
        admit:          admit,
        openings:       false,
    });
}

# every socket the driver hands over is a local one
fun admit(backend: *readiness.Backend, resource_value: usize) i64 {
    ret 0;
}

fun attempt(backend: *readiness.Backend, resource: *readiness.Resource, operation: *readiness.Operation) bool {
    var result:             i64   = 0;
    var completed_resource: usize = operation.resource;
    var end_of_stream:      bool  = false;
    if (operation.kind == runtime.ACCEPT) {
        var address:        [128]u8;
        var address_length: u32 = 128;
        result = native.sock_accept_flags(operation.resource, ?address[0], ?address_length, true, true, ?completed_resource);
    }
    or (operation.kind == runtime.CONNECT) {
        if (operation.stage == 0) {
            result = local_impl.connect_start(operation.resource, (operation::*Request).peer);
            if (readiness.would_block(result)) {
                operation.stage = 1;
                ret false;
            }
        }
        or {
            result = native.sock_connect_status(operation.resource);
        }
    }
    or (operation.kind == runtime.READ) {
        if (operation.buffer == nil && operation.length != 0) { result = readiness.invalid(); }
        or                                                    { result = local_impl.read(operation.resource, operation.buffer, operation.length); }
        end_of_stream = result == 0 && operation.length != 0;
    }
    or (operation.kind == runtime.READABLE) {
        result        = native.sock_peek_readable(operation.resource);
        end_of_stream = result == 0;
    }
    or (operation.kind == runtime.WRITE) {
        if (operation.buffer == nil && operation.length != 0) { result = readiness.invalid(); }
        or                                                    { result = native.sock_send(operation.resource, operation.buffer, operation.length); }
    }
    or (operation.kind == runtime.SHUTDOWN) {
        result = native.sock_shutdown(operation.resource, native.SHUT_WR);
        if (result >= 0) { resource.write_closed = true; }
    }
    or {
        result = native.EINVAL;
    }
    if (readiness.would_block(result)) { ret false; }
    if (result < 0)                    { readiness.finish(backend, resource, operation, result, 0, 0, completed_resource, false); }
    or {
        var bytes: usize = 0;
        if (operation.kind == runtime.READ || operation.kind == runtime.WRITE) { bytes = result::usize; }
        readiness.finish(backend, resource, operation, 0, bytes, 0, completed_resource, end_of_stream);
    }
    ret true;
}

pub fun create_connect(value: endpoint.Endpoint, resource: *usize) i64 {
    ret local_impl.create_stream(value, true, resource);
}

pub fun cleanup_listener(listener: *local_types.Listener) i64 {
    ret local_impl.cleanup_listener(listener);
}

pub fun rename_listener(listener: *local_types.Listener, replacement: endpoint.Endpoint) i64 {
    ret local_impl.rename(listener, replacement);
}

pub fun close_resource(backend: *readiness.Backend, resource: usize) i64 {
    ret os.sock_close(resource);
}

# give up a socket with nothing queued on it, so another backend can take it:
# its registration and record go and the socket stays open
# ---
# resource_value: the socket to give up
# ret:            0, EBUSY while an operation or a close is queued on it, or the
#                 native refusal to deregister, which leaves the record as it was
pub fun detach(backend: *readiness.Backend, resource_value: usize) i64 {
    if (backend == nil) { ret readiness.invalid(); }
    mutex.lock(?backend.lock);
    val resource: *readiness.Resource = readiness.resource_lookup(backend, resource_value);
    if (resource == nil) {
        mutex.unlock(?backend.lock);
        ret 0;
    }
    if (resource.read_head != readiness.NONE || resource.write_head != readiness.NONE ||
        resource.close_index != readiness.NONE || resource.closing) {
        mutex.unlock(?backend.lock);
        ret native.EBUSY;
    }
    if (resource.watched) {
        val removed: i64 = native.io_queue_unwatch(backend.queue, resource.resource);
        if (removed < 0) {
            mutex.unlock(?backend.lock);
            ret removed;
        }
        backend.unwatches = backend.unwatches + 1;
    }
    readiness.resource_release_unwatched(backend, resource);
    readiness.trim_locked(backend);
    mutex.unlock(?backend.lock);
    ret 0;
}

pub fun submit_accept(backend: *readiness.Backend, listener: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret readiness.invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *readiness.Resource;
    var operation: *readiness.Operation;
    val status:    i64 = readiness.begin(backend, listener, 0, runtime.ACCEPT, context, readiness.LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    readiness.submission_done(backend, resource);
    ret 0;
}

pub fun submit_connect(backend: *readiness.Backend, resource_value: usize, peer: endpoint.Endpoint, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret readiness.invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *readiness.Resource;
    var operation: *readiness.Operation;
    val status:    i64 = readiness.begin(backend, resource_value, 0, runtime.CONNECT, context, readiness.LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    (operation::*Request).peer = peer;
    readiness.submission_done(backend, resource);
    ret 0;
}

pub fun submit_read(backend: *readiness.Backend, resource_value: usize, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    ret readiness.submit_read(backend, resource_value, 0, buffer, length, context, token);
}

pub fun submit_readable(backend: *readiness.Backend, resource_value: usize, context: usize, token: *types.Token) i64 {
    ret readiness.submit_readable(backend, resource_value, 0, context, token);
}

pub fun submit_write(backend: *readiness.Backend, resource_value: usize, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    ret readiness.submit_write(backend, resource_value, 0, buffer, length, context, token);
}

pub fun submit_shutdown_write(backend: *readiness.Backend, resource_value: usize, context: usize, token: *types.Token) i64 {
    ret readiness.submit_shutdown_write(backend, resource_value, 0, context, token);
}

pub fun submit_close(backend: *readiness.Backend, resource_value: usize, context: usize, token: *types.Token) i64 {
    ret readiness.submit_close(backend, resource_value, 0, context, token);
}

$if ($mach.build.os == $mach.os.linux) {
    # the test's own inventory of its descriptor table, never a production mechanism
    #[testing]
    fun test_descriptor_count() i64 {
        val directory: i64 = native.open(native.AT_FDCWD, "/proc/self/fd", native.O_RDONLY | native.O_DIRECTORY, 0);
        if (directory < 0) { ret directory; }
        var cursor:      native.DirectoryCursor     = native.DirectoryCursor{};
        val initialized: native.DirectoryInitResult = native.directory_init(?cursor, directory::i32);
        if (initialized.code != 0) {
            native.close(directory::i32);
            ret initialized.code;
        }
        var count: i64 = 0;
        var entry: native.DirectoryEntry;
        var next:  i64 = native.directory_next(?cursor, ?entry);
        for (next > 0) {
            if (entry.name[0] != '.') { count = count + 1; }
            next = native.directory_next(?cursor, ?entry);
        }
        native.directory_close(?cursor);
        native.close(directory::i32);
        if (next < 0) { ret next; }
        ret count - 1;
    }

    #[testing]
    fun test_send_rights(handle: usize, data: *u8, length: usize, descriptor: i32, count: usize) i64 {
        var control:       [1032]u8;
        val record_length: usize = 16 + count * 4;
        @((?control[0])::*usize) = record_length;
        @((?control[8])::*i32)   = native.SOL_SOCKET;
        @((?control[12])::*i32)  = native.SCM_RIGHTS;
        var i: usize = 0;
        for (i < count) {
            @((?control[16 + i * 4])::*i32) = descriptor;
            i                               = i + 1;
        }
        var vector: native.IoVector = native.IoVector{data: data, length: length};
        ret native.sock_send_message(handle, ?vector, 1, nil, 0, ?control[0], (record_length + 7) & ~7::usize);
    }

    #[testing]
    fun test_endpoint_name(output: *u8) usize {
        val prefix: *u8   = "/tmp/mach-std-local-618-";
        var length: usize = 0;
        for (prefix[length] != 0) {
            output[length] = prefix[length];
            length         = length + 1;
        }
        var process: u64   = native.getpid()::u64;
        var digits:  [20]u8;
        var count:   usize = 0;
        if (process == 0) {
            digits[0] = '0';
            count     = 1;
        }
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process       = process / 10;
            count         = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            output[length] = digits[count - i - 1];
            length         = length + 1;
            i              = i + 1;
        }
        output[length]     = '.';
        output[length + 1] = 's';
        output[length + 2] = 'o';
        output[length + 3] = 'c';
        output[length + 4] = 'k';
        output[length + 5] = 0;
        ret length + 5;
    }

    test async_local__queued_reads_close_unwanted_rights_and_complete_with_the_bytes {
        var pa: allocator.Allocator;
        page.make(?pa);
        var pipe: [2]i32;
        if (native.pipe(?pipe[0]) < 0) { ret 1; }
        fin {
            native.close(pipe[0]);
            native.close(pipe[1]);
        }
        var path:            [108]u8;
        val path_length:     usize                                  = test_endpoint_name(?path[0]);
        val endpoint_result: res[endpoint.Endpoint, io_error.Error] = endpoint.filesystem_bytes(?path[0], path_length);
        if (sel endpoint_result.err) { ret 2; }
        val bound:    endpoint.Endpoint = endpoint_result.ok;
        var listener: local_types.Listener;
        listener.handle            = (-1)::isize::usize;
        listener.endpoint          = bound;
        listener.ownership         = local_types.OWNED;
        listener.has_node_identity = false;
        val options: local_types.ListenOptions = local_types.ListenOptions{
            backlog:     4, ownership: local_types.OWNED, stale: local_types.REMOVE_STALE_SOCKET,
            permissions: local_types.INHERIT_PERMISSIONS,
        };
        if (local_impl.listen(?listener, bound, options) < 0) { ret 3; }
        fin { local_impl.close_listener(?listener); }
        var client: local_types.Stream;
        if (local_impl.connect(?client, bound, true) < 0) { ret 4; }
        fin {
            if (client.handle != (-1)::isize::usize) { native.sock_close(client.handle); }
        }
        var server: local_types.Stream;
        if (local_impl.accept(?listener, ?server, false) < 0) { ret 5; }
        fin { native.sock_close(server.handle); }
        var queue: shared.IoQueue;
        if (native.io_queue_create(?queue) < 0) { ret 6; }
        fin { native.io_queue_close(?queue); }
        var backend: Backend;
        if (make(?backend, ?queue, ?pa, 4, 1) < 0) { ret 7; }
        fin { destroy(?backend); }
        val before: i64 = test_descriptor_count();
        if (before < 0) { ret 8; }
        var buffer: [64]u8;
        var token:  types.Token;
        # the read is queued before any bytes exist, then the peer attaches rights to them
        if (submit_read(?backend, client.handle, ?buffer[0], 64, 618, ?token) < 0) { ret 9; }
        if (poll(?backend, 0) != 0)                                                { ret 10; }
        if (test_send_rights(server.handle, "abc", 3, pipe[0], 16) != 3)           { ret 11; }
        if (poll(?backend, 1000) != 1)                                             { ret 12; }
        var result: types.NativeCompletion;
        if (completion(?backend, 0, ?result) < 0)                                                     { ret 13; }
        if (result.context != 618 || result.status != 0 || result.bytes != 3 || result.end_of_stream) { ret 14; }
        if (buffer[0] != 'a' || buffer[1] != 'b' || buffer[2] != 'c')                                 { ret 15; }
        if (test_descriptor_count() != before)                                                        { ret 16; }
        # rights already queued when the read is submitted complete on the first drive
        if (test_send_rights(server.handle, "d", 1, pipe[0], native.SCM_MAX_FD) != 1)             { ret 17; }
        if (submit_read(?backend, client.handle, ?buffer[0], 64, 619, ?token) < 0)                { ret 18; }
        if (poll(?backend, 1000) != 1 || completion(?backend, 0, ?result) < 0)                    { ret 19; }
        if (result.context != 619 || result.status != 0 || result.bytes != 1 || buffer[0] != 'd') { ret 20; }
        if (test_descriptor_count() != before)                                                    { ret 21; }
        if (submit_close(?backend, client.handle, 620, ?token) < 0)                               { ret 22; }
        client.handle = (-1)::isize::usize;
        if (poll(?backend, 1000) != 1 || completion(?backend, 0, ?result) < 0) { ret 23; }
        if (result.context != 620 || result.status != 0)                       { ret 24; }
        if (test_descriptor_count() != before - 1)                             { ret 25; }
        var byte: u8 = 0;
        if (native.write(pipe[1], "k", 1) != 1 || native.read(pipe[0], ?byte, 1) != 1 || byte != 'k') { ret 26; }
        ret 0;
    }
}
