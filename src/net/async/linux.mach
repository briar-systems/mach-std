# bounded linux readiness backend and nonblocking socket operations

$if ($mach.build.os != $mach.os.linux) {
    $error("std.net.async.linux: requires linux target");
}

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.system.os.linux;
use std.system.os.shared;
use std.net.ip;
use std.sync.mutex;

fwd linux.IoVector;

pub rec Token {
    index: u32;
    generation: u32;
}

pub rec Operation {
    state: u8;
    generation: u32;
    resource: usize;
    context: usize;
    events: u32;
}

pub rec NativeCompletion {
    context: usize;
    events: u32;
    status: i64;
    flags: u64;
}

pub rec Backend {
    queue: *shared.IoQueue;
    operations: *Operation;
    native: *linux.IoCompletion;
    capacity: usize;
    active: usize;
    ready: usize;
    next: usize;
    lock: mutex.Mutex;
}

pub rec Packet {
    buffer: *u8;
    capacity: usize;
    length: usize;
    peer: ip.Endpoint;
    local_destination: ip.Addr;
    interface_index: u32;
    has_local_destination: bool;
    truncated: bool;
    zero_length: bool;
}

pub val READABLE: u32 = linux.IO_EVENT_READ;
pub val WRITABLE: u32 = linux.IO_EVENT_WRITE;
pub val FAILED: u32 = linux.IO_EVENT_ERROR;
pub val HUNG_UP: u32 = linux.IO_EVENT_HANGUP;
pub val WOKEN: u32 = linux.IO_EVENT_WAKE;
pub val WOULD_BLOCK: i64 = linux.EAGAIN;
pub val IN_PROGRESS: i64 = -115;

val SLOT_FREE: u8 = 0;
val SLOT_ARMED: u8 = 1;
val SLOT_IDLE: u8 = 2;
val MSG_TRUNC: i32 = 0x20;
val IP_PKTINFO: i32 = 8;
val IPV6_RECVPKTINFO: i32 = 49;
val IPV6_PKTINFO: i32 = 50;

fun invalid() i64 { ret linux.EINVAL; }

fun token_context(token: Token) usize {
    ret ((token.generation::u64 << 32) | (token.index::u64 + 1))::usize;
}

fun context_token(context: usize) Token {
    val raw: u64 = context::u64;
    ret Token{index: ((raw & 0xffffffff) - 1)::u32, generation: (raw >> 32)::u32};
}

fun operation_for(backend: *Backend, token: Token) *Operation {
    if (token.index::usize >= backend.capacity) { ret nil; }
    val operation: *Operation = ?backend.operations[token.index::usize];
    if (operation.state == SLOT_FREE || operation.generation != token.generation) { ret nil; }
    ret operation;
}

pub fun make(backend: *Backend, queue: *shared.IoQueue, capacity: usize) i64 {
    if (backend == nil || queue == nil || capacity == 0 || capacity > 0xffffffff) { ret invalid(); }
    val operation_size: usize = $size_of(Operation);
    val native_size: usize = $size_of(linux.IoCompletion);
    val operation_bytes: usize = operation_size * capacity;
    val native_bytes: usize = native_size * capacity;
    if (operation_bytes / operation_size != capacity || native_bytes / native_size != capacity) { ret linux.ENOMEM; }

    backend.operations = linux.allocate(operation_bytes)::*Operation;
    if (backend.operations == nil) { ret linux.ENOMEM; }
    backend.native = linux.allocate(native_bytes)::*linux.IoCompletion;
    if (backend.native == nil) {
        linux.deallocate(backend.operations::ptr, operation_bytes);
        backend.operations = nil;
        ret linux.ENOMEM;
    }
    backend.queue = queue;
    backend.capacity = capacity;
    backend.active = 0;
    backend.ready = 0;
    backend.next = 0;
    backend.lock = mutex.make();
    var i: usize = 0;
    for (i < capacity) {
        backend.operations[i].state = SLOT_FREE;
        backend.operations[i].generation = 0;
        i = i + 1;
    }
    ret 0;
}

pub fun watch(backend: *Backend, resource: usize, context: usize, events: u32, token: *Token) i64 {
    if (backend == nil || token == nil || (events & (READABLE | WRITABLE)) == 0) { ret invalid(); }
    mutex.lock(?backend.lock);
    if (backend.active == backend.capacity) {
        mutex.unlock(?backend.lock);
        ret linux.ENOMEM;
    }
    var i: usize = 0;
    for (i < backend.capacity) {
        if (backend.operations[i].state != SLOT_FREE && backend.operations[i].resource == resource) {
            mutex.unlock(?backend.lock);
            ret linux.EBUSY;
        }
        i = i + 1;
    }
    var index: usize = backend.next;
    var scanned: usize = 0;
    for (scanned < backend.capacity && backend.operations[index].state != SLOT_FREE) {
        index = (index + 1) % backend.capacity;
        scanned = scanned + 1;
    }
    var generation: u32 = backend.operations[index].generation + 1;
    if (generation == 0) { generation = 1; }
    val claimed: Token = Token{index: index::u32, generation: generation};
    backend.operations[index].state = SLOT_ARMED;
    backend.operations[index].generation = generation;
    backend.operations[index].resource = resource;
    backend.operations[index].context = context;
    backend.operations[index].events = events;
    val result: i64 = linux.io_queue_watch(backend.queue, resource, token_context(claimed), events);
    if (result < 0) {
        backend.operations[index].state = SLOT_FREE;
        mutex.unlock(?backend.lock);
        ret result;
    }
    backend.active = backend.active + 1;
    backend.next = (index + 1) % backend.capacity;
    @token = claimed;
    mutex.unlock(?backend.lock);
    linux.io_queue_wake(backend.queue);
    ret 0;
}

pub fun rearm(backend: *Backend, token: Token, events: u32) i64 {
    if (backend == nil || (events & (READABLE | WRITABLE)) == 0) { ret invalid(); }
    mutex.lock(?backend.lock);
    val operation: *Operation = operation_for(backend, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret linux.EBADF;
    }
    val result: i64 = linux.io_queue_watch(backend.queue, operation.resource, token_context(token), events);
    if (result >= 0) {
        operation.events = events;
        operation.state = SLOT_ARMED;
    }
    mutex.unlock(?backend.lock);
    if (result >= 0) { linux.io_queue_wake(backend.queue); }
    ret result;
}

pub fun unwatch(backend: *Backend, token: Token) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    val operation: *Operation = operation_for(backend, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret linux.EBADF;
    }
    val result: i64 = linux.io_queue_unwatch(backend.queue, operation.resource);
    if (result >= 0) {
        operation.state = SLOT_FREE;
        backend.active = backend.active - 1;
    }
    mutex.unlock(?backend.lock);
    if (result >= 0) { linux.io_queue_wake(backend.queue); }
    ret result;
}

# one thread owns poll and native completion storage
pub fun poll(backend: *Backend, timeout_ms: i32) i64 {
    if (backend == nil) { ret invalid(); }
    val count: i64 = linux.io_queue_poll(backend.queue, backend.native, backend.capacity, timeout_ms);
    if (count <= 0) {
        backend.ready = 0;
        ret count;
    }

    mutex.lock(?backend.lock);
    var input: usize = 0;
    var output: usize = 0;
    for (input < count::usize) {
        val completion: linux.IoCompletion = backend.native[input];
        if ((completion.events & WOKEN) != 0) {
            backend.native[output] = completion;
            output = output + 1;
        } or (completion.context != 0) {
            val token: Token = context_token(completion.context);
            val operation: *Operation = operation_for(backend, token);
            if (operation != nil && operation.state == SLOT_ARMED) {
                operation.state = SLOT_IDLE;
                backend.native[output].context = operation.context;
                backend.native[output].events = completion.events;
                backend.native[output].status = completion.status;
                backend.native[output].flags = completion.flags;
                output = output + 1;
            }
        }
        input = input + 1;
    }
    backend.ready = output;
    mutex.unlock(?backend.lock);
    ret output::i64;
}

pub fun completion(backend: *Backend, index: usize, out: *NativeCompletion) i64 {
    if (backend == nil || out == nil || index >= backend.ready) { ret invalid(); }
    val native: linux.IoCompletion = backend.native[index];
    out.context = native.context;
    out.events = native.events;
    out.status = native.status;
    out.flags = native.flags;
    ret 0;
}

pub fun destroy(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    if (backend.active != 0) {
        mutex.unlock(?backend.lock);
        ret linux.EBUSY;
    }
    val operation_bytes: usize = $size_of(Operation) * backend.capacity;
    val native_bytes: usize = $size_of(linux.IoCompletion) * backend.capacity;
    linux.deallocate(backend.native::ptr, native_bytes);
    linux.deallocate(backend.operations::ptr, operation_bytes);
    backend.native = nil;
    backend.operations = nil;
    backend.capacity = 0;
    backend.ready = 0;
    backend.queue = nil;
    mutex.unlock(?backend.lock);
    ret 0;
}

pub fun stream_accept(listener: usize, peer: *ip.Endpoint, accepted: *usize) i64 {
    if (accepted == nil) { ret invalid(); }
    var address: [128]u8;
    var address_length: u32 = linux.SOCKADDR_STORAGE_SIZE::u32;
    val result: i64 = linux.sock_accept_flags(listener, ?address[0], ?address_length, true, true, accepted);
    if (result < 0) { ret result; }
    if (peer != nil && !ip.from_sockaddr(?address[0], peer)) {
        linux.sock_close(@accepted);
        @accepted = (-1)::usize;
        ret linux.ENOTSUP;
    }
    ret 0;
}

pub fun stream_connect(resource: usize, peer: ip.Endpoint) i64 {
    var address: [128]u8;
    val address_length: usize = ip.to_sockaddr(peer, ?address[0]);
    ret linux.sock_connect(resource, ?address[0], address_length);
}

pub fun stream_connect_status(resource: usize) i64 {
    ret linux.sock_connect_status(resource);
}

pub fun stream_read(resource: usize, buffer: *u8, length: usize) i64 {
    if (buffer == nil && length != 0) { ret invalid(); }
    ret linux.sock_recv(resource, buffer, length);
}

pub fun stream_write(resource: usize, buffer: *u8, length: usize) i64 {
    if (buffer == nil && length != 0) { ret invalid(); }
    ret linux.sock_send(resource, buffer, length);
}

pub fun stream_write_vector(resource: usize, vectors: *linux.IoVector, count: usize) i64 {
    ret linux.sock_write_vector(resource, vectors, count);
}

pub fun stream_shutdown_write(resource: usize) i64 {
    ret linux.sock_shutdown(resource, linux.SHUT_WR);
}

pub fun socket_close(resource: usize) i64 {
    ret linux.sock_close(resource);
}

pub fun configure_datagram(resource: usize, family: i32) i64 {
    var enabled: i32 = 1;
    if (family == linux.AF_INET) {
        ret linux.sock_setopt(resource, linux.IPPROTO_IP, IP_PKTINFO, (?enabled)::*u8, 4);
    }
    if (family == linux.AF_INET6) {
        ret linux.sock_setopt(resource, linux.IPPROTO_IPV6, IPV6_RECVPKTINFO, (?enabled)::*u8, 4);
    }
    ret linux.ENOTSUP;
}

fun align_control(length: usize) usize {
    ret (length + 7) & ~7;
}

fun packet_metadata(packet: *Packet, control: *u8, length: usize) {
    packet.has_local_destination = false;
    packet.interface_index = 0;
    var offset: usize = 0;
    for (offset + 16 <= length) {
        val base: usize = control::usize + offset;
        val message_length: usize = @(base::*usize);
        if (message_length < 16 || message_length > length - offset) { ret; }
        val level: i32 = @((base + 8)::*i32);
        val kind: i32 = @((base + 12)::*i32);
        val data: usize = base + 16;
        if (level == linux.IPPROTO_IP && kind == IP_PKTINFO && message_length >= 28) {
            packet.interface_index = @(data::*u32);
            val address: ip.IPv4 = ip.ipv4(@((data + 8)::*u8), @((data + 9)::*u8), @((data + 10)::*u8), @((data + 11)::*u8));
            packet.local_destination = ip.addr_v4(address);
            packet.has_local_destination = true;
        } or (level == linux.IPPROTO_IPV6 && kind == IPV6_PKTINFO && message_length >= 36) {
            var address: ip.IPv6;
            var i: usize = 0;
            for (i < 16) { address.octets[i] = @((data + i)::*u8); i = i + 1; }
            packet.interface_index = @((data + 16)::*u32);
            packet.local_destination = ip.addr_v6(address);
            packet.has_local_destination = true;
        }
        offset = offset + align_control(message_length);
    }
}

fun packet_send_metadata(packet: *Packet, control: *u8, length: *usize) i64 {
    @length = 0;
    if (!packet.has_local_destination && packet.interface_index == 0) { ret 0; }
    var i: usize = 0;
    for (i < 48) { control[i] = 0; i = i + 1; }
    val base: usize = control::usize;
    val family: i32 = ip.endpoint_family(packet.peer);
    if (family == linux.AF_INET) {
        if (packet.has_local_destination && packet.local_destination.is_v6 != 0) { ret invalid(); }
        @(base::*usize) = 28;
        @((base + 8)::*i32) = linux.IPPROTO_IP;
        @((base + 12)::*i32) = IP_PKTINFO;
        @((base + 16)::*u32) = packet.interface_index;
        if (packet.has_local_destination) {
            for (i < 4) { @((base + 20 + i)::*u8) = packet.local_destination.v4.octets[i]; i = i + 1; }
        }
        @length = 32;
        ret 0;
    }
    if (family == linux.AF_INET6) {
        if (packet.has_local_destination && packet.local_destination.is_v6 == 0) { ret invalid(); }
        @(base::*usize) = 36;
        @((base + 8)::*i32) = linux.IPPROTO_IPV6;
        @((base + 12)::*i32) = IPV6_PKTINFO;
        if (packet.has_local_destination) {
            for (i < 16) { @((base + 16 + i)::*u8) = packet.local_destination.v6.octets[i]; i = i + 1; }
        }
        @((base + 32)::*u32) = packet.interface_index;
        @length = 40;
        ret 0;
    }
    ret linux.ENOTSUP;
}

pub fun datagram_receive_batch(resource: usize, packets: *Packet, count: usize) i64 {
    if (packets == nil || count == 0) { ret invalid(); }
    var received: usize = 0;
    for (received < count) {
        var vector: linux.IoVector = linux.IoVector{data: packets[received].buffer, length: packets[received].capacity};
        var address: [128]u8;
        var address_length: u32 = linux.SOCKADDR_STORAGE_SIZE::u32;
        var control: [128]u8;
        var control_length: usize = 128;
        var flags: i32 = 0;
        val result: i64 = linux.sock_receive_message(resource, ?vector, 1, ?address[0], ?address_length, ?control[0], ?control_length, ?flags);
        if (result < 0) {
            if (received != 0) { ret received::i64; }
            ret result;
        }
        if (!ip.from_sockaddr(?address[0], ?packets[received].peer)) {
            if (received != 0) { ret received::i64; }
            ret linux.ENOTSUP;
        }
        packets[received].length = result::usize;
        packets[received].truncated = (flags & MSG_TRUNC) != 0;
        packets[received].zero_length = result == 0;
        packet_metadata(?packets[received], ?control[0], control_length);
        received = received + 1;
    }
    ret received::i64;
}

pub fun datagram_send_batch(resource: usize, packets: *Packet, count: usize) i64 {
    if (packets == nil || count == 0) { ret invalid(); }
    var sent: usize = 0;
    for (sent < count) {
        if (packets[sent].buffer == nil && packets[sent].length != 0) {
            if (sent != 0) { ret sent::i64; }
            ret invalid();
        }
        var vector: linux.IoVector = linux.IoVector{data: packets[sent].buffer, length: packets[sent].length};
        var address: [128]u8;
        val address_length: usize = ip.to_sockaddr(packets[sent].peer, ?address[0]);
        var control: [48]u8;
        var control_length: usize = 0;
        val metadata: i64 = packet_send_metadata(?packets[sent], ?control[0], ?control_length);
        if (metadata < 0) {
            if (sent != 0) { ret sent::i64; }
            ret metadata;
        }
        var control_pointer: *u8 = nil;
        if (control_length != 0) { control_pointer = ?control[0]; }
        val result: i64 = linux.sock_send_message(resource, ?vector, 1, ?address[0], address_length::u32, control_pointer, control_length);
        if (result < 0) {
            if (sent != 0) { ret sent::i64; }
            ret result;
        }
        if (result::usize != packets[sent].length) {
            if (sent != 0) { ret sent::i64; }
            ret linux.EIO;
        }
        sent = sent + 1;
    }
    ret sent::i64;
}

test "async linux: queue payload and zero datagram metadata survive" {
    var queue: shared.IoQueue;
    if (linux.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 1) < 0) { linux.io_queue_close(?queue); ret 1; }

    var receiver: usize = (-1)::usize;
    var sender: usize = (-1)::usize;
    if (linux.sock_create_flags(linux.AF_INET, linux.SOCK_DGRAM, 0, true, true, ?receiver) < 0) {
        destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    if (linux.sock_create_flags(linux.AF_INET, linux.SOCK_DGRAM, 0, true, true, ?sender) < 0) {
        linux.sock_close(receiver); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    var loopback: [4]u8;
    loopback[0] = 127;
    loopback[1] = 0;
    loopback[2] = 0;
    loopback[3] = 1;
    var address: [128]u8;
    linux.sock_addr_init(?address[0], 0, ?loopback[0]);
    if (linux.sock_bind(receiver, ?address[0], linux.SOCKADDR_IN_SIZE) < 0 || configure_datagram(receiver, linux.AF_INET) < 0) {
        linux.sock_close(sender); linux.sock_close(receiver); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    var address_length: u32 = linux.SOCKADDR_STORAGE_SIZE::u32;
    if (linux.sock_local_addr(receiver, ?address[0], ?address_length) < 0) {
        linux.sock_close(sender); linux.sock_close(receiver); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }

    var token: Token;
    if (watch(?backend, receiver, 0x12345678, READABLE, ?token) < 0) {
        linux.sock_close(sender); linux.sock_close(receiver); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    var extra: Token;
    if (watch(?backend, sender, 1, WRITABLE, ?extra) != linux.ENOMEM) {
        unwatch(?backend, token); linux.sock_close(sender); linux.sock_close(receiver); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    if (linux.sock_sendto(sender, nil, 0, 0, ?address[0], address_length::usize) != 0) {
        unwatch(?backend, token); linux.sock_close(sender); linux.sock_close(receiver); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }

    var ready: bool = false;
    var attempts: usize = 0;
    for (attempts < 4 && !ready) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) {
            attempts = 4;
        } or {
            var i: usize = 0;
            for (i < count::usize) {
                var native: NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 0x12345678 && (native.events & READABLE) != 0) { ready = true; }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }

    var byte: u8 = 0;
    var packet: Packet;
    packet.buffer = ?byte;
    packet.capacity = 1;
    val received: i64 = datagram_receive_batch(receiver, ?packet, 1);
    val zero_valid: bool = received == 1 && packet.length == 0 && packet.zero_length && !packet.truncated && packet.has_local_destination && packet.interface_index != 0;
    var payload: [3]u8;
    payload[0] = 'a';
    payload[1] = 'b';
    payload[2] = 'c';
    val sent_payload: i64 = linux.sock_sendto(sender, ?payload[0], 3, 0, ?address[0], address_length::usize);
    val truncated_received: i64 = datagram_receive_batch(receiver, ?packet, 1);
    val valid: bool = ready && zero_valid && sent_payload == 3 && truncated_received == 1 && packet.length == 1 && packet.truncated && !packet.zero_length;
    unwatch(?backend, token);
    linux.sock_close(sender);
    linux.sock_close(receiver);
    if (destroy(?backend) < 0) { linux.io_queue_close(?queue); ret 1; }
    linux.io_queue_close(?queue);
    if (!valid) { ret 1; }
    ret 0;
}

test "async linux: connect accept vector write and half close" {
    var queue: shared.IoQueue;
    if (linux.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 2) < 0) { linux.io_queue_close(?queue); ret 1; }
    var listener: usize = (-1)::usize;
    var client: usize = (-1)::usize;
    var server: usize = (-1)::usize;
    if (linux.sock_create_flags(linux.AF_INET, linux.SOCK_STREAM, 0, true, true, ?listener) < 0 || linux.sock_create_flags(linux.AF_INET, linux.SOCK_STREAM, 0, true, true, ?client) < 0) {
        if (listener != (-1)::usize) { linux.sock_close(listener); }
        destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    var loopback: [4]u8;
    loopback[0] = 127;
    loopback[1] = 0;
    loopback[2] = 0;
    loopback[3] = 1;
    var address: [128]u8;
    linux.sock_addr_init(?address[0], 0, ?loopback[0]);
    if (linux.sock_bind(listener, ?address[0], linux.SOCKADDR_IN_SIZE) < 0 || linux.sock_listen(listener, 4) < 0) {
        linux.sock_close(client); linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    var address_length: u32 = linux.SOCKADDR_STORAGE_SIZE::u32;
    if (linux.sock_local_addr(listener, ?address[0], ?address_length) < 0) {
        linux.sock_close(client); linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    var peer: ip.Endpoint;
    if (!ip.from_sockaddr(?address[0], ?peer)) {
        linux.sock_close(client); linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }

    var listener_token: Token;
    if (watch(?backend, listener, 1, READABLE, ?listener_token) < 0) {
        linux.sock_close(client); linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    val connected_now: i64 = stream_connect(client, peer);
    var client_watched: bool = false;
    var client_token: Token;
    var connected: bool = connected_now == 0;
    if (connected_now == IN_PROGRESS) {
        if (watch(?backend, client, 2, WRITABLE, ?client_token) < 0) {
            unwatch(?backend, listener_token); linux.sock_close(client); linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1;
        }
        client_watched = true;
    } or (connected_now < 0) {
        unwatch(?backend, listener_token); linux.sock_close(client); linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }

    var accepted: bool = false;
    var attempts: usize = 0;
    for (attempts < 8 && (!accepted || !connected)) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) {
            attempts = 8;
        } or {
            var i: usize = 0;
            for (i < count::usize) {
                var native: NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 1 && !accepted) {
                    accepted = stream_accept(listener, nil, ?server) == 0;
                }
                if (native.context == 2 && !connected) {
                    connected = stream_connect_status(client) == 0;
                }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }

    var first: [2]u8;
    first[0] = 'a';
    first[1] = 'b';
    var second: [2]u8;
    second[0] = 'c';
    second[1] = 'd';
    var vectors: [2]linux.IoVector;
    vectors[0] = linux.IoVector{data: ?first[0], length: 2};
    vectors[1] = linux.IoVector{data: ?second[0], length: 2};
    var received: [4]u8;
    val written: i64 = stream_write_vector(client, ?vectors[0], 2);
    val read_first: i64 = stream_read(server, ?received[0], 2);
    val read_second: i64 = stream_read(server, ?received[2], 2);
    val shutdown: i64 = stream_shutdown_write(client);
    val end_of_stream: i64 = stream_read(server, ?received[0], 1);
    val valid: bool = accepted && connected && written == 4 && read_first == 2 && read_second == 2 && shutdown == 0 && end_of_stream == 0 && received[2] == 'c' && received[3] == 'd';

    unwatch(?backend, listener_token);
    if (client_watched) { unwatch(?backend, client_token); }
    if (server != (-1)::usize) { socket_close(server); }
    socket_close(client);
    socket_close(listener);
    if (destroy(?backend) < 0) { linux.io_queue_close(?queue); ret 1; }
    linux.io_queue_close(?queue);
    if (!valid) { ret 1; }
    ret 0;
}
