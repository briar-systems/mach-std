# bounded linux readiness backend and nonblocking socket operations

$if ($mach.build.os != $mach.os.linux) {
    $error("std.net.async.linux: requires linux target");
}

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.system.os.linux;
use std.system.os.shared;
use std.net.ip;
use std.net.async.types;
use std.io.runtime;
use std.sync.mutex;

fwd types.Vector;
fwd types.Packet;
fwd types.Token;
fwd types.NativeCompletion;

pub rec Operation {
    state: u8;
    generation: u32;
    kind: runtime.Kind;
    resource: usize;
    context: usize;
    buffer: *u8;
    length: usize;
    vectors: *types.Vector;
    vector_count: usize;
    packets: *types.Packet;
    packet_count: usize;
    peer: ip.Endpoint;
    accept_peer: *ip.Endpoint;
    sequence: u64;
    previous: u32;
    next: u32;
    resource_index: u32;
    lane: u8;
    stage: u8;
}

rec Resource {
    state: u8;
    generation: u32;
    resource: usize;
    read_head: u32;
    read_tail: u32;
    write_head: u32;
    write_tail: u32;
    close_index: u32;
    armed: bool;
    closing: bool;
    write_closed: bool;
    next_free: u32;
}

rec QueuedCompletion {
    value: types.NativeCompletion;
    operation_index: u32;
}

pub rec Backend {
    queue: *shared.IoQueue;
    operations: *Operation;
    resources: *Resource;
    resource_map: *u32;
    native: *linux.IoCompletion;
    queued: *QueuedCompletion;
    ready: *types.NativeCompletion;
    capacity: usize;
    map_capacity: usize;
    live: usize;
    resource_count: usize;
    free_operation: u32;
    free_resource: u32;
    queued_head: usize;
    queued_tail: usize;
    queued_count: usize;
    ready_count: usize;
    sequence: u64;
    lock: mutex.Mutex;
}

val SLOT_FREE: u8 = 0;
val SLOT_ACTIVE: u8 = 1;
val SLOT_QUEUED: u8 = 2;
val RESOURCE_FREE: u8 = 0;
val RESOURCE_ACTIVE: u8 = 1;
val LANE_NONE: u8 = 0;
val LANE_READ: u8 = 1;
val LANE_WRITE: u8 = 2;
val NONE: u32 = 0xffffffff;
val MAP_TOMBSTONE: u32 = 0xffffffff;
val IN_PROGRESS: i64 = -115;
val MSG_TRUNC: i32 = 0x20;
val IP_PKTINFO: i32 = 8;
val IPV6_RECVPKTINFO: i32 = 49;
val IPV6_PKTINFO: i32 = 50;

fun invalid() i64 { ret linux.EINVAL; }

fun token_context(token: types.Token) usize {
    ret ((token.generation::u64 << 32) | (token.index::u64 + 1))::usize;
}

fun context_token(context: usize) types.Token {
    val raw: u64 = context::u64;
    ret types.Token{index: ((raw & 0xffffffff) - 1)::u32, generation: (raw >> 32)::u32};
}

fun operation_for(backend: *Backend, token: types.Token) *Operation {
    if (token.index::usize >= backend.capacity) { ret nil; }
    val operation: *Operation = ?backend.operations[token.index::usize];
    if (operation.state != SLOT_ACTIVE || operation.generation != token.generation) { ret nil; }
    ret operation;
}

fun operation_any(backend: *Backend, token: types.Token) *Operation {
    if (token.index::usize >= backend.capacity) { ret nil; }
    val operation: *Operation = ?backend.operations[token.index::usize];
    if (operation.state == SLOT_FREE || operation.generation != token.generation) { ret nil; }
    ret operation;
}

fun resource_for(backend: *Backend, token: types.Token) *Resource {
    if (token.index::usize >= backend.capacity) { ret nil; }
    val resource: *Resource = ?backend.resources[token.index::usize];
    if (resource.state != RESOURCE_ACTIVE || resource.generation != token.generation) { ret nil; }
    ret resource;
}

fun required_map_capacity(capacity: usize) usize {
    if (capacity > 0x3fffffff) { ret 0; }
    val required: usize = capacity * 2;
    var size: usize = 1;
    for (size < required) { size = size * 2; }
    ret size;
}

fun resource_hash(resource: usize) usize {
    ret resource * 11400714819323198485;
}

fun resource_lookup(backend: *Backend, resource: usize) *Resource {
    var slot: usize = resource_hash(resource) & (backend.map_capacity - 1);
    var scanned: usize = 0;
    for (scanned < backend.map_capacity) {
        val entry: u32 = backend.resource_map[slot];
        if (entry == 0) { ret nil; }
        if (entry != MAP_TOMBSTONE) {
            val candidate: *Resource = ?backend.resources[(entry - 1)::usize];
            if (candidate.state == RESOURCE_ACTIVE && candidate.resource == resource) { ret candidate; }
        }
        slot = (slot + 1) & (backend.map_capacity - 1);
        scanned = scanned + 1;
    }
    ret nil;
}

fun resource_map_insert(backend: *Backend, index: u32) bool {
    val resource: usize = backend.resources[index::usize].resource;
    var slot: usize = resource_hash(resource) & (backend.map_capacity - 1);
    var tombstone: usize = backend.map_capacity;
    var scanned: usize = 0;
    for (scanned < backend.map_capacity) {
        val entry: u32 = backend.resource_map[slot];
        if (entry == 0) {
            if (tombstone != backend.map_capacity) { slot = tombstone; }
            backend.resource_map[slot] = index + 1;
            ret true;
        }
        if (entry == MAP_TOMBSTONE && tombstone == backend.map_capacity) { tombstone = slot; }
        slot = (slot + 1) & (backend.map_capacity - 1);
        scanned = scanned + 1;
    }
    if (tombstone != backend.map_capacity) {
        backend.resource_map[tombstone] = index + 1;
        ret true;
    }
    ret false;
}

fun resource_map_remove(backend: *Backend, index: u32) {
    val resource: usize = backend.resources[index::usize].resource;
    var slot: usize = resource_hash(resource) & (backend.map_capacity - 1);
    var scanned: usize = 0;
    for (scanned < backend.map_capacity) {
        val entry: u32 = backend.resource_map[slot];
        if (entry == 0) { ret; }
        if (entry == index + 1) {
            backend.resource_map[slot] = MAP_TOMBSTONE;
            ret;
        }
        slot = (slot + 1) & (backend.map_capacity - 1);
        scanned = scanned + 1;
    }
}

fun resource_acquire(backend: *Backend, native: usize, created: *bool) *Resource {
    val existing: *Resource = resource_lookup(backend, native);
    if (existing != nil) { @created = false; ret existing; }
    if (backend.free_resource == NONE) { ret nil; }
    val index: u32 = backend.free_resource;
    val resource: *Resource = ?backend.resources[index::usize];
    backend.free_resource = resource.next_free;
    var generation: u32 = resource.generation + 1;
    if (generation == 0) { generation = 1; }
    resource.state = RESOURCE_ACTIVE;
    resource.generation = generation;
    resource.resource = native;
    resource.read_head = NONE;
    resource.read_tail = NONE;
    resource.write_head = NONE;
    resource.write_tail = NONE;
    resource.close_index = NONE;
    resource.armed = false;
    resource.closing = false;
    resource.write_closed = false;
    if (!resource_map_insert(backend, index)) {
        resource.state = RESOURCE_FREE;
        resource.next_free = backend.free_resource;
        backend.free_resource = index;
        ret nil;
    }
    backend.resource_count = backend.resource_count + 1;
    @created = true;
    ret resource;
}

fun resource_release(backend: *Backend, resource: *Resource) {
    val index: u32 = ((resource::usize - backend.resources::usize) / $size_of(Resource))::u32;
    linux.io_queue_unwatch(backend.queue, resource.resource);
    resource_map_remove(backend, index);
    resource.state = RESOURCE_FREE;
    resource.armed = false;
    resource.next_free = backend.free_resource;
    backend.free_resource = index;
    backend.resource_count = backend.resource_count - 1;
}

fun operation_claim(backend: *Backend, kind: runtime.Kind, native: usize, context: usize, token: *types.Token) *Operation {
    if (backend.live == backend.capacity || backend.free_operation == NONE) { ret nil; }
    val index: u32 = backend.free_operation;
    val operation: *Operation = ?backend.operations[index::usize];
    backend.free_operation = operation.next;
    var generation: u32 = operation.generation + 1;
    if (generation == 0) { generation = 1; }
    operation.state = SLOT_ACTIVE;
    operation.generation = generation;
    operation.kind = kind;
    operation.resource = native;
    operation.context = context;
    operation.sequence = backend.sequence;
    operation.previous = NONE;
    operation.next = NONE;
    operation.lane = LANE_NONE;
    operation.stage = 0;
    backend.sequence = backend.sequence + 1;
    backend.live = backend.live + 1;
    @token = types.Token{index: index, generation: generation};
    ret operation;
}

fun operation_release(backend: *Backend, index: u32) {
    val operation: *Operation = ?backend.operations[index::usize];
    operation.state = SLOT_FREE;
    operation.next = backend.free_operation;
    backend.free_operation = index;
    backend.live = backend.live - 1;
}

fun operation_index(backend: *Backend, operation: *Operation) u32 {
    ret ((operation::usize - backend.operations::usize) / $size_of(Operation))::u32;
}

fun resource_index(backend: *Backend, resource: *Resource) u32 {
    ret ((resource::usize - backend.resources::usize) / $size_of(Resource))::u32;
}

fun enqueue(backend: *Backend, resource: *Resource, operation: *Operation, lane: u8) {
    val index: u32 = operation_index(backend, operation);
    operation.resource_index = resource_index(backend, resource);
    operation.lane = lane;
    if (lane == LANE_READ) {
        operation.previous = resource.read_tail;
        if (resource.read_tail == NONE) { resource.read_head = index; }
        or { backend.operations[resource.read_tail::usize].next = index; }
        resource.read_tail = index;
    } or {
        operation.previous = resource.write_tail;
        if (resource.write_tail == NONE) { resource.write_head = index; }
        or { backend.operations[resource.write_tail::usize].next = index; }
        resource.write_tail = index;
    }
}

fun unlink(backend: *Backend, resource: *Resource, operation: *Operation) {
    val previous: u32 = operation.previous;
    val next: u32 = operation.next;
    if (operation.lane == LANE_READ) {
        if (previous == NONE) { resource.read_head = next; }
        or { backend.operations[previous::usize].next = next; }
        if (next == NONE) { resource.read_tail = previous; }
        or { backend.operations[next::usize].previous = previous; }
    } or (operation.lane == LANE_WRITE) {
        if (previous == NONE) { resource.write_head = next; }
        or { backend.operations[previous::usize].next = next; }
        if (next == NONE) { resource.write_tail = previous; }
        or { backend.operations[next::usize].previous = previous; }
    }
    operation.previous = NONE;
    operation.next = NONE;
    operation.lane = LANE_NONE;
}

fun finish(backend: *Backend, resource: *Resource, operation: *Operation, status: i64, bytes: usize, native_resource: usize, end_of_stream: bool) {
    unlink(backend, resource, operation);
    val index: u32 = operation_index(backend, operation);
    backend.queued[backend.queued_tail].value.context = operation.context;
    backend.queued[backend.queued_tail].value.kind = operation.kind;
    backend.queued[backend.queued_tail].value.bytes = bytes;
    backend.queued[backend.queued_tail].value.resource = native_resource;
    backend.queued[backend.queued_tail].value.status = status;
    backend.queued[backend.queued_tail].value.end_of_stream = end_of_stream;
    backend.queued[backend.queued_tail].operation_index = index;
    backend.queued_tail = (backend.queued_tail + 1) % backend.capacity;
    backend.queued_count = backend.queued_count + 1;
    operation.state = SLOT_QUEUED;
}

fun would_block(status: i64) bool {
    ret status == linux.EAGAIN || status == IN_PROGRESS;
}

fun attempt(backend: *Backend, resource: *Resource, operation: *Operation) bool {
    var result: i64 = 0;
    var completed_resource: usize = operation.resource;
    var end_of_stream: bool = false;
    if (operation.kind == runtime.ACCEPT) {
        result = stream_accept(operation.resource, operation.accept_peer, ?completed_resource);
    } or (operation.kind == runtime.CONNECT) {
        if (operation.stage == 0) {
            result = stream_connect(operation.resource, operation.peer);
            if (would_block(result)) { operation.stage = 1; ret false; }
        } or {
            result = stream_connect_status(operation.resource);
        }
    } or (operation.kind == runtime.READ) {
        result = stream_read(operation.resource, operation.buffer, operation.length);
        end_of_stream = result == 0 && operation.length != 0;
    } or (operation.kind == runtime.WRITE) {
        if (operation.vectors != nil) { result = stream_write_vector(operation.resource, operation.vectors, operation.vector_count); }
        or { result = stream_write(operation.resource, operation.buffer, operation.length); }
    } or (operation.kind == runtime.RECEIVE_FROM) {
        result = datagram_receive_batch(operation.resource, operation.packets, operation.packet_count);
    } or (operation.kind == runtime.SEND_TO) {
        result = datagram_send_batch(operation.resource, operation.packets, operation.packet_count);
    } or (operation.kind == runtime.SHUTDOWN) {
        result = stream_shutdown_write(operation.resource);
        if (result >= 0) { resource.write_closed = true; }
    } or {
        result = linux.EINVAL;
    }
    if (would_block(result)) { ret false; }
    if (result < 0) { finish(backend, resource, operation, result, 0, completed_resource, false); }
    or {
        var bytes: usize = 0;
        if (operation.kind == runtime.READ || operation.kind == runtime.WRITE || operation.kind == runtime.RECEIVE_FROM || operation.kind == runtime.SEND_TO) { bytes = result::usize; }
        finish(backend, resource, operation, 0, bytes, completed_resource, end_of_stream);
    }
    ret true;
}

fun fail_resource(backend: *Backend, resource: *Resource, status: i64) {
    for (resource.read_head != NONE || resource.write_head != NONE) {
        var index: u32 = resource.read_head;
        if (index == NONE) { index = resource.write_head; }
        or (resource.write_head != NONE && backend.operations[resource.write_head::usize].sequence < backend.operations[index::usize].sequence) { index = resource.write_head; }
        val operation: *Operation = ?backend.operations[index::usize];
        finish(backend, resource, operation, status, 0, operation.resource, false);
    }
}

fun arm_resource(backend: *Backend, resource: *Resource) {
    var events: u32 = 0;
    if (resource.read_head != NONE) { events = events | linux.IO_EVENT_READ; }
    if (resource.write_head != NONE) { events = events | linux.IO_EVENT_WRITE; }
    if (events == 0) {
        if (resource.close_index != NONE) {
            val close_operation: *Operation = ?backend.operations[resource.close_index::usize];
            resource.close_index = NONE;
            val closed: i64 = socket_close(resource.resource);
            finish(backend, resource, close_operation, closed, 0, resource.resource, false);
        }
        resource_release(backend, resource);
        ret;
    }
    val token: types.Token = types.Token{index: resource_index(backend, resource), generation: resource.generation};
    val status: i64 = linux.io_queue_watch(backend.queue, resource.resource, token_context(token), events);
    if (status < 0) {
        fail_resource(backend, resource, status);
        if (resource.close_index != NONE) {
            val close_operation: *Operation = ?backend.operations[resource.close_index::usize];
            resource.close_index = NONE;
            val closed: i64 = socket_close(resource.resource);
            finish(backend, resource, close_operation, closed, 0, resource.resource, false);
        }
        resource_release(backend, resource);
        ret;
    }
    resource.armed = true;
}

fun drive_resource(backend: *Backend, resource: *Resource, events: u32) {
    val failure: bool = (events & (linux.IO_EVENT_ERROR | linux.IO_EVENT_HANGUP)) != 0;
    if ((events & linux.IO_EVENT_READ) != 0 || failure) {
        var progress: bool = true;
        for (progress && resource.read_head != NONE) {
            progress = attempt(backend, resource, ?backend.operations[resource.read_head::usize]);
        }
    }
    if ((events & linux.IO_EVENT_WRITE) != 0 || failure) {
        var progress: bool = true;
        for (progress && resource.write_head != NONE) {
            progress = attempt(backend, resource, ?backend.operations[resource.write_head::usize]);
        }
    }
    arm_resource(backend, resource);
}

fun begin(backend: *Backend, native: usize, kind: runtime.Kind, context: usize, lane: u8, token: *types.Token, resource_out: **Resource, operation_out: **Operation) i64 {
    if (backend == nil || token == nil || resource_out == nil || operation_out == nil) { ret invalid(); }
    var created: bool = false;
    val resource: *Resource = resource_acquire(backend, native, ?created);
    if (resource == nil || resource.closing) { ret linux.EBADF; }
    if (lane == LANE_WRITE && resource.write_closed && kind != runtime.CLOSE) {
        if (created) { resource_release(backend, resource); }
        ret linux.EPIPE;
    }
    val operation: *Operation = operation_claim(backend, kind, native, context, token);
    if (operation == nil) {
        if (created) { resource_release(backend, resource); }
        ret linux.ENOMEM;
    }
    operation.buffer = nil;
    operation.length = 0;
    operation.vectors = nil;
    operation.vector_count = 0;
    operation.packets = nil;
    operation.packet_count = 0;
    operation.accept_peer = nil;
    operation.resource_index = resource_index(backend, resource);
    if (lane != LANE_NONE) { enqueue(backend, resource, operation, lane); }
    @resource_out = resource;
    @operation_out = operation;
    ret 0;
}

fun submission_done(backend: *Backend, resource: *Resource) {
    drive_resource(backend, resource, linux.IO_EVENT_READ | linux.IO_EVENT_WRITE);
    mutex.unlock(?backend.lock);
    linux.io_queue_wake(backend.queue);
}

pub fun make(backend: *Backend, queue: *shared.IoQueue, capacity: usize) i64 {
    if (backend == nil || queue == nil || capacity == 0) { ret invalid(); }
    val map_capacity: usize = required_map_capacity(capacity);
    if (map_capacity == 0) { ret linux.ENOMEM; }
    val operation_size: usize = $size_of(Operation);
    val resource_size: usize = $size_of(Resource);
    val map_size: usize = $size_of(u32);
    val native_size: usize = $size_of(linux.IoCompletion);
    val queued_size: usize = $size_of(QueuedCompletion);
    val ready_size: usize = $size_of(types.NativeCompletion);
    val operation_bytes: usize = operation_size * capacity;
    val resource_bytes: usize = resource_size * capacity;
    val map_bytes: usize = map_size * map_capacity;
    val native_bytes: usize = native_size * capacity;
    val queued_bytes: usize = queued_size * capacity;
    val ready_bytes: usize = ready_size * capacity;
    if (operation_bytes / operation_size != capacity || resource_bytes / resource_size != capacity || map_bytes / map_size != map_capacity || native_bytes / native_size != capacity || queued_bytes / queued_size != capacity || ready_bytes / ready_size != capacity) { ret linux.ENOMEM; }

    backend.operations = linux.allocate(operation_bytes)::*Operation;
    if (backend.operations == nil) { ret linux.ENOMEM; }
    backend.resources = linux.allocate(resource_bytes)::*Resource;
    if (backend.resources == nil) {
        linux.deallocate(backend.operations::ptr, operation_bytes);
        backend.operations = nil;
        ret linux.ENOMEM;
    }
    backend.resource_map = linux.allocate(map_bytes)::*u32;
    if (backend.resource_map == nil) {
        linux.deallocate(backend.resources::ptr, resource_bytes);
        linux.deallocate(backend.operations::ptr, operation_bytes);
        ret linux.ENOMEM;
    }
    backend.native = linux.allocate(native_bytes)::*linux.IoCompletion;
    if (backend.native == nil) {
        linux.deallocate(backend.resource_map::ptr, map_bytes);
        linux.deallocate(backend.resources::ptr, resource_bytes);
        linux.deallocate(backend.operations::ptr, operation_bytes);
        ret linux.ENOMEM;
    }
    backend.queued = linux.allocate(queued_bytes)::*QueuedCompletion;
    if (backend.queued == nil) {
        linux.deallocate(backend.native::ptr, native_bytes);
        linux.deallocate(backend.resource_map::ptr, map_bytes);
        linux.deallocate(backend.resources::ptr, resource_bytes);
        linux.deallocate(backend.operations::ptr, operation_bytes);
        ret linux.ENOMEM;
    }
    backend.ready = linux.allocate(ready_bytes)::*types.NativeCompletion;
    if (backend.ready == nil) {
        linux.deallocate(backend.queued::ptr, queued_bytes);
        linux.deallocate(backend.native::ptr, native_bytes);
        linux.deallocate(backend.resource_map::ptr, map_bytes);
        linux.deallocate(backend.resources::ptr, resource_bytes);
        linux.deallocate(backend.operations::ptr, operation_bytes);
        ret linux.ENOMEM;
    }
    backend.queue = queue;
    backend.capacity = capacity;
    backend.map_capacity = map_capacity;
    backend.live = 0;
    backend.resource_count = 0;
    backend.free_operation = 0;
    backend.free_resource = 0;
    backend.queued_head = 0;
    backend.queued_tail = 0;
    backend.queued_count = 0;
    backend.ready_count = 0;
    backend.sequence = 1;
    backend.lock = mutex.make();
    var i: usize = 0;
    for (i < capacity) {
        backend.operations[i].state = SLOT_FREE;
        backend.operations[i].generation = 0;
        backend.operations[i].next = (i + 1)::u32;
        backend.resources[i].state = RESOURCE_FREE;
        backend.resources[i].generation = 0;
        backend.resources[i].next_free = (i + 1)::u32;
        i = i + 1;
    }
    backend.operations[capacity - 1].next = NONE;
    backend.resources[capacity - 1].next_free = NONE;
    i = 0;
    for (i < map_capacity) { backend.resource_map[i] = 0; i = i + 1; }
    ret 0;
}

pub fun submit_accept(backend: *Backend, listener: usize, peer: *ip.Endpoint, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    var operation: *Operation;
    val status: i64 = begin(backend, listener, runtime.ACCEPT, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.accept_peer = peer;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_connect(backend: *Backend, native: usize, peer: ip.Endpoint, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    var operation: *Operation;
    val status: i64 = begin(backend, native, runtime.CONNECT, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.peer = peer;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_read(backend: *Backend, native: usize, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || (buffer == nil && length != 0)) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    var operation: *Operation;
    val status: i64 = begin(backend, native, runtime.READ, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.buffer = buffer;
    operation.length = length;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_write(backend: *Backend, native: usize, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || (buffer == nil && length != 0)) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    var operation: *Operation;
    val status: i64 = begin(backend, native, runtime.WRITE, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.buffer = buffer;
    operation.length = length;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_write_vector(backend: *Backend, native: usize, vectors: *types.Vector, count: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || vectors == nil || count == 0 || count > 1024) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    var operation: *Operation;
    val status: i64 = begin(backend, native, runtime.WRITE, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.vectors = vectors;
    operation.vector_count = count;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_receive_batch(backend: *Backend, native: usize, packets: *types.Packet, count: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || packets == nil || count == 0) { ret invalid(); }
    val configured: i64 = configure_datagram_socket(native);
    if (configured < 0) { ret configured; }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    var operation: *Operation;
    val status: i64 = begin(backend, native, runtime.RECEIVE_FROM, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.packets = packets;
    operation.packet_count = count;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_send_batch(backend: *Backend, native: usize, packets: *types.Packet, count: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || packets == nil || count == 0) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    var operation: *Operation;
    val status: i64 = begin(backend, native, runtime.SEND_TO, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.packets = packets;
    operation.packet_count = count;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_shutdown_write(backend: *Backend, native: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    var operation: *Operation;
    val status: i64 = begin(backend, native, runtime.SHUTDOWN, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_close(backend: *Backend, native: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    var operation: *Operation;
    val status: i64 = begin(backend, native, runtime.CLOSE, context, LANE_NONE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    resource.closing = true;
    resource.close_index = operation_index(backend, operation);
    for (resource.read_head != NONE) {
        val read_operation: *Operation = ?backend.operations[resource.read_head::usize];
        finish(backend, resource, read_operation, linux.ECANCELED, 0, native, false);
    }
    submission_done(backend, resource);
    ret 0;
}

pub fun cancel(backend: *Backend, token: types.Token) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    val operation: *Operation = operation_any(backend, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret linux.EBADF;
    }
    if (operation.state == SLOT_QUEUED) {
        var offset: usize = 0;
        var found: bool = false;
        var removed: types.NativeCompletion;
        for (offset < backend.queued_count && !found) {
            val position: usize = (backend.queued_head + offset) % backend.capacity;
            if (backend.queued[position].operation_index == token.index) {
                removed = backend.queued[position].value;
                var current: usize = offset;
                for (current + 1 < backend.queued_count) {
                    val from: usize = (backend.queued_head + current + 1) % backend.capacity;
                    val to: usize = (backend.queued_head + current) % backend.capacity;
                    backend.queued[to] = backend.queued[from];
                    current = current + 1;
                }
                backend.queued_tail = (backend.queued_tail + backend.capacity - 1) % backend.capacity;
                backend.queued_count = backend.queued_count - 1;
                found = true;
            }
            offset = offset + 1;
        }
        if (!found) {
            mutex.unlock(?backend.lock);
            ret linux.EBADF;
        }
        operation_release(backend, token.index);
        mutex.unlock(?backend.lock);
        if (removed.kind == runtime.ACCEPT && removed.status == 0) { socket_close(removed.resource); }
        linux.io_queue_wake(backend.queue);
        ret 0;
    }
    val resource: *Resource = ?backend.resources[operation.resource_index::usize];
    if (operation.kind == runtime.CLOSE) {
        resource.close_index = NONE;
        resource.closing = false;
    }
    unlink(backend, resource, operation);
    operation_release(backend, token.index);
    drive_resource(backend, resource, linux.IO_EVENT_READ | linux.IO_EVENT_WRITE);
    mutex.unlock(?backend.lock);
    linux.io_queue_wake(backend.queue);
    ret 0;
}

fun publish_ready(backend: *Backend) usize {
    var count: usize = 0;
    for (backend.queued_count > 0) {
        val queued: QueuedCompletion = backend.queued[backend.queued_head];
        backend.ready[count] = queued.value;
        operation_release(backend, queued.operation_index);
        backend.queued_head = (backend.queued_head + 1) % backend.capacity;
        backend.queued_count = backend.queued_count - 1;
        count = count + 1;
    }
    backend.ready_count = count;
    ret count;
}

# one thread owns poll and completion retrieval
pub fun poll(backend: *Backend, timeout_ms: i32) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    backend.ready_count = 0;
    val already_ready: bool = backend.queued_count != 0;
    mutex.unlock(?backend.lock);

    var native_timeout: i32 = timeout_ms;
    if (already_ready) { native_timeout = 0; }
    val count: i64 = linux.io_queue_poll(backend.queue, backend.native, backend.capacity, native_timeout);
    mutex.lock(?backend.lock);
    var i: usize = 0;
    if (count > 0) {
        for (i < count::usize) {
            val native_completion: linux.IoCompletion = backend.native[i];
            if (native_completion.context != 0 && (native_completion.events & linux.IO_EVENT_WAKE) == 0) {
                val resource_token: types.Token = context_token(native_completion.context);
                val resource: *Resource = resource_for(backend, resource_token);
                if (resource != nil) {
                    resource.armed = false;
                    drive_resource(backend, resource, native_completion.events);
                }
            }
            i = i + 1;
        }
    }
    val ready: usize = publish_ready(backend);
    mutex.unlock(?backend.lock);
    if (ready == 0 && count < 0) { ret count; }
    ret ready::i64;
}

pub fun completion(backend: *Backend, index: usize, out: *types.NativeCompletion) i64 {
    if (backend == nil || out == nil || index >= backend.ready_count) { ret invalid(); }
    @out = backend.ready[index];
    ret 0;
}

pub fun destroy(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    if (backend.live != 0 || backend.resource_count != 0 || backend.queued_count != 0) {
        mutex.unlock(?backend.lock);
        ret linux.EBUSY;
    }
    val operation_bytes: usize = $size_of(Operation) * backend.capacity;
    val resource_bytes: usize = $size_of(Resource) * backend.capacity;
    val map_bytes: usize = $size_of(u32) * backend.map_capacity;
    val native_bytes: usize = $size_of(linux.IoCompletion) * backend.capacity;
    val queued_bytes: usize = $size_of(QueuedCompletion) * backend.capacity;
    val ready_bytes: usize = $size_of(types.NativeCompletion) * backend.capacity;
    linux.deallocate(backend.ready::ptr, ready_bytes);
    linux.deallocate(backend.queued::ptr, queued_bytes);
    linux.deallocate(backend.native::ptr, native_bytes);
    linux.deallocate(backend.resource_map::ptr, map_bytes);
    linux.deallocate(backend.resources::ptr, resource_bytes);
    linux.deallocate(backend.operations::ptr, operation_bytes);
    backend.ready = nil;
    backend.queued = nil;
    backend.native = nil;
    backend.resource_map = nil;
    backend.resources = nil;
    backend.operations = nil;
    backend.capacity = 0;
    backend.map_capacity = 0;
    backend.ready_count = 0;
    backend.queue = nil;
    mutex.unlock(?backend.lock);
    ret 0;
}

fun stream_accept(listener: usize, peer: *ip.Endpoint, accepted: *usize) i64 {
    if (accepted == nil) { ret invalid(); }
    var address: [128]u8;
    var address_length: u32 = linux.SOCKADDR_STORAGE_SIZE::u32;
    val result: i64 = linux.sock_accept_flags(listener, ?address[0], ?address_length, true, true, accepted);
    if (result < 0) { ret result; }
    if (peer != nil && !ip.from_sockaddr(?address[0], peer)) {
        linux.sock_close(@accepted);
        @accepted = (-1)::usize;
        ret linux.ENOTSUP;
    }
    ret 0;
}

fun stream_connect(resource: usize, peer: ip.Endpoint) i64 {
    var address: [128]u8;
    val address_length: usize = ip.to_sockaddr(peer, ?address[0]);
    ret linux.sock_connect(resource, ?address[0], address_length);
}

fun stream_connect_status(resource: usize) i64 {
    ret linux.sock_connect_status(resource);
}

fun stream_read(resource: usize, buffer: *u8, length: usize) i64 {
    if (buffer == nil && length != 0) { ret invalid(); }
    ret linux.sock_recv(resource, buffer, length);
}

fun stream_write(resource: usize, buffer: *u8, length: usize) i64 {
    if (buffer == nil && length != 0) { ret invalid(); }
    ret linux.sock_send(resource, buffer, length);
}

fun stream_write_vector(resource: usize, vectors: *types.Vector, count: usize) i64 {
    if ($size_of(types.Vector) != $size_of(linux.IoVector)) { ret linux.EINVAL; }
    ret linux.sock_write_vector(resource, (vectors::usize)::*linux.IoVector, count);
}

fun stream_shutdown_write(resource: usize) i64 {
    ret linux.sock_shutdown(resource, linux.SHUT_WR);
}

fun socket_close(resource: usize) i64 {
    ret linux.sock_close(resource);
}

fun configure_datagram(resource: usize, family: i32) i64 {
    var enabled: i32 = 1;
    if (family == linux.AF_INET) {
        ret linux.sock_setopt(resource, linux.IPPROTO_IP, IP_PKTINFO, (?enabled)::*u8, 4);
    }
    if (family == linux.AF_INET6) {
        ret linux.sock_setopt(resource, linux.IPPROTO_IPV6, IPV6_RECVPKTINFO, (?enabled)::*u8, 4);
    }
    ret linux.ENOTSUP;
}

fun configure_datagram_socket(resource: usize) i64 {
    var address: [128]u8;
    var length: u32 = linux.SOCKADDR_STORAGE_SIZE::u32;
    val status: i64 = linux.sock_local_addr(resource, ?address[0], ?length);
    if (status < 0) { ret status; }
    ret configure_datagram(resource, linux.sock_addr_family(?address[0]));
}

fun align_control(length: usize) usize {
    ret (length + 7) & ~7;
}

fun packet_metadata(packet: *types.Packet, control: *u8, length: usize) {
    packet.has_local_destination = false;
    packet.interface_index = 0;
    var offset: usize = 0;
    for (offset + 16 <= length) {
        val base: usize = control::usize + offset;
        val message_length: usize = @(base::*usize);
        if (message_length < 16 || message_length > length - offset) { ret; }
        val level: i32 = @((base + 8)::*i32);
        val kind: i32 = @((base + 12)::*i32);
        val data: usize = base + 16;
        if (level == linux.IPPROTO_IP && kind == IP_PKTINFO && message_length >= 28) {
            packet.interface_index = @(data::*u32);
            val address: ip.IPv4 = ip.ipv4(@((data + 8)::*u8), @((data + 9)::*u8), @((data + 10)::*u8), @((data + 11)::*u8));
            packet.local_destination = ip.addr_v4(address);
            packet.has_local_destination = true;
        } or (level == linux.IPPROTO_IPV6 && kind == IPV6_PKTINFO && message_length >= 36) {
            var address: ip.IPv6;
            var i: usize = 0;
            for (i < 16) { address.octets[i] = @((data + i)::*u8); i = i + 1; }
            packet.interface_index = @((data + 16)::*u32);
            packet.local_destination = ip.addr_v6(address);
            packet.has_local_destination = true;
        }
        offset = offset + align_control(message_length);
    }
}

fun packet_send_metadata(packet: *types.Packet, control: *u8, length: *usize) i64 {
    @length = 0;
    if (!packet.has_local_destination && packet.interface_index == 0) { ret 0; }
    var i: usize = 0;
    for (i < 48) { control[i] = 0; i = i + 1; }
    val base: usize = control::usize;
    val family: i32 = ip.endpoint_family(packet.peer);
    if (family == linux.AF_INET) {
        if (packet.has_local_destination && packet.local_destination.is_v6 != 0) { ret invalid(); }
        @(base::*usize) = 28;
        @((base + 8)::*i32) = linux.IPPROTO_IP;
        @((base + 12)::*i32) = IP_PKTINFO;
        @((base + 16)::*u32) = packet.interface_index;
        if (packet.has_local_destination) {
            for (i < 4) { @((base + 20 + i)::*u8) = packet.local_destination.v4.octets[i]; i = i + 1; }
        }
        @length = 32;
        ret 0;
    }
    if (family == linux.AF_INET6) {
        if (packet.has_local_destination && packet.local_destination.is_v6 == 0) { ret invalid(); }
        @(base::*usize) = 36;
        @((base + 8)::*i32) = linux.IPPROTO_IPV6;
        @((base + 12)::*i32) = IPV6_PKTINFO;
        if (packet.has_local_destination) {
            for (i < 16) { @((base + 16 + i)::*u8) = packet.local_destination.v6.octets[i]; i = i + 1; }
        }
        @((base + 32)::*u32) = packet.interface_index;
        @length = 40;
        ret 0;
    }
    ret linux.ENOTSUP;
}

fun datagram_receive_batch(resource: usize, packets: *types.Packet, count: usize) i64 {
    if (packets == nil || count == 0) { ret invalid(); }
    var received: usize = 0;
    for (received < count) {
        var vector: linux.IoVector = linux.IoVector{data: packets[received].buffer, length: packets[received].capacity};
        var address: [128]u8;
        var address_length: u32 = linux.SOCKADDR_STORAGE_SIZE::u32;
        var control: [128]u8;
        var control_length: usize = 128;
        var flags: i32 = 0;
        val result: i64 = linux.sock_receive_message(resource, ?vector, 1, ?address[0], ?address_length, ?control[0], ?control_length, ?flags);
        if (result < 0) {
            if (received != 0) { ret received::i64; }
            ret result;
        }
        if (!ip.from_sockaddr(?address[0], ?packets[received].peer)) {
            if (received != 0) { ret received::i64; }
            ret linux.ENOTSUP;
        }
        packets[received].length = result::usize;
        packets[received].truncated = (flags & MSG_TRUNC) != 0;
        packets[received].zero_length = result == 0;
        packet_metadata(?packets[received], ?control[0], control_length);
        received = received + 1;
    }
    ret received::i64;
}

fun datagram_send_batch(resource: usize, packets: *types.Packet, count: usize) i64 {
    if (packets == nil || count == 0) { ret invalid(); }
    var sent: usize = 0;
    for (sent < count) {
        if (packets[sent].buffer == nil && packets[sent].length != 0) {
            if (sent != 0) { ret sent::i64; }
            ret invalid();
        }
        var vector: linux.IoVector = linux.IoVector{data: packets[sent].buffer, length: packets[sent].length};
        var address: [128]u8;
        val address_length: usize = ip.to_sockaddr(packets[sent].peer, ?address[0]);
        var control: [48]u8;
        var control_length: usize = 0;
        val metadata: i64 = packet_send_metadata(?packets[sent], ?control[0], ?control_length);
        if (metadata < 0) {
            if (sent != 0) { ret sent::i64; }
            ret metadata;
        }
        var control_pointer: *u8 = nil;
        if (control_length != 0) { control_pointer = ?control[0]; }
        val result: i64 = linux.sock_send_message(resource, ?vector, 1, ?address[0], address_length::u32, control_pointer, control_length);
        if (result < 0) {
            if (sent != 0) { ret sent::i64; }
            ret result;
        }
        if (result::usize != packets[sent].length) {
            if (sent != 0) { ret sent::i64; }
            ret linux.EIO;
        }
        sent = sent + 1;
    }
    ret sent::i64;
}

fun test_listener(listener: *usize, endpoint: *ip.Endpoint) i64 {
    @listener = (-1)::usize;
    val created: i64 = linux.sock_create_flags(linux.AF_INET, linux.SOCK_STREAM, 0, true, true, listener);
    if (created < 0) { ret created; }
    var loopback: [4]u8;
    loopback[0] = 127;
    loopback[1] = 0;
    loopback[2] = 0;
    loopback[3] = 1;
    var address: [128]u8;
    linux.sock_addr_init(?address[0], 0, ?loopback[0]);
    var status: i64 = linux.sock_bind(@listener, ?address[0], linux.SOCKADDR_IN_SIZE);
    if (status >= 0) { status = linux.sock_listen(@listener, 8); }
    var length: u32 = linux.SOCKADDR_STORAGE_SIZE::u32;
    if (status >= 0) { status = linux.sock_local_addr(@listener, ?address[0], ?length); }
    if (status >= 0 && !ip.from_sockaddr(?address[0], endpoint)) { status = linux.ENOTSUP; }
    if (status < 0) {
        linux.sock_close(@listener);
        @listener = (-1)::usize;
    }
    ret status;
}

fun test_client(endpoint: ip.Endpoint, client: *usize) i64 {
    @client = (-1)::usize;
    val created: i64 = linux.sock_create_flags(linux.AF_INET, linux.SOCK_STREAM, 0, false, true, client);
    if (created < 0) { ret created; }
    val status: i64 = stream_connect(@client, endpoint);
    if (status < 0) {
        linux.sock_close(@client);
        @client = (-1)::usize;
    }
    ret status;
}

test "async linux: queued cancellation preserves FIFO" {
    var queue: shared.IoQueue;
    if (linux.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 4) < 0) { linux.io_queue_close(?queue); ret 1; }
    var socket: usize = (-1)::usize;
    if (linux.sock_create_flags(linux.AF_INET, linux.SOCK_DGRAM, 0, true, true, ?socket) < 0) {
        destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    val destination: ip.Endpoint = ip.endpoint(127, 0, 0, 1, 9);
    var packets: [3]types.Packet;
    var i: usize = 0;
    for (i < 3) {
        packets[i].buffer = nil;
        packets[i].capacity = 0;
        packets[i].length = 0;
        packets[i].peer = destination;
        packets[i].has_local_destination = false;
        packets[i].interface_index = 0;
        i = i + 1;
    }
    var tokens: [3]types.Token;
    val first: i64 = submit_send_batch(?backend, socket, ?packets[0], 1, 11, ?tokens[0]);
    val second: i64 = submit_send_batch(?backend, socket, ?packets[1], 1, 22, ?tokens[1]);
    val third: i64 = submit_send_batch(?backend, socket, ?packets[2], 1, 33, ?tokens[2]);
    val cancelled: i64 = cancel(?backend, tokens[1]);
    val count: i64 = poll(?backend, 0);
    var a: types.NativeCompletion;
    var b: types.NativeCompletion;
    if (count == 2) { completion(?backend, 0, ?a); completion(?backend, 1, ?b); }
    val valid: bool = first == 0 && second == 0 && third == 0 && cancelled == 0 && count == 2 && a.context == 11 && b.context == 33 && a.kind == runtime.SEND_TO && b.kind == runtime.SEND_TO && backend.live == 0 && backend.resource_count == 0;
    linux.sock_close(socket);
    val destroyed: i64 = destroy(?backend);
    linux.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async linux: queued accept cancellation closes handle" {
    var queue: shared.IoQueue;
    if (linux.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 4) < 0) { linux.io_queue_close(?queue); ret 1; }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) { destroy(?backend); linux.io_queue_close(?queue); ret 1; }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) { linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1; }
    var peer: ip.Endpoint;
    var token: types.Token;
    val submitted: i64 = submit_accept(?backend, listener, ?peer, 44, ?token);
    var accepted: usize = (-1)::usize;
    if (submitted == 0 && backend.queued_count == 1) { accepted = backend.queued[backend.queued_head].value.resource; }
    val cancelled: i64 = cancel(?backend, token);
    val closed: i64 = linux.sock_close(accepted);
    val valid: bool = submitted == 0 && cancelled == 0 && accepted != (-1)::usize && closed == linux.EBADF && backend.live == 0 && backend.queued_count == 0 && backend.resource_count == 0;
    linux.sock_close(client);
    linux.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    linux.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async linux: one stream drives concurrent read and write" {
    var queue: shared.IoQueue;
    if (linux.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8) < 0) { linux.io_queue_close(?queue); ret 1; }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) { destroy(?backend); linux.io_queue_close(?queue); ret 1; }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) { linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1; }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) { linux.sock_close(client); linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1; }

    var input: [4]u8;
    var output: [4]u8;
    output[0] = 'p'; output[1] = 'o'; output[2] = 'n'; output[3] = 'g';
    var read_token: types.Token;
    var write_token: types.Token;
    val read_submitted: i64 = submit_read(?backend, server, ?input[0], 4, 51, ?read_token);
    val write_submitted: i64 = submit_write(?backend, server, ?output[0], 4, 52, ?write_token);
    var response: [4]u8;
    val response_bytes: i64 = linux.sock_recv(client, ?response[0], 4);
    var request: [4]u8;
    request[0] = 'p'; request[1] = 'i'; request[2] = 'n'; request[3] = 'g';
    val request_bytes: i64 = linux.sock_send(client, ?request[0], 4);
    var saw_read: bool = false;
    var saw_write: bool = false;
    var attempts: usize = 0;
    for (attempts < 6 && (!saw_read || !saw_write)) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 6; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 51 && native.status == 0 && native.bytes == 4) { saw_read = true; }
                if (native.context == 52 && native.status == 0 && native.bytes == 4) { saw_write = true; }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val valid: bool = read_submitted == 0 && write_submitted == 0 && response_bytes == 4 && request_bytes == 4 && saw_read && saw_write && input[0] == 'p' && input[3] == 'g' && response[0] == 'p' && response[3] == 'g' && backend.resource_count == 0;
    linux.sock_close(server); linux.sock_close(client); linux.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    linux.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async linux: listener owns multiple bounded accepts" {
    var queue: shared.IoQueue;
    if (linux.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8) < 0) { linux.io_queue_close(?queue); ret 1; }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) { destroy(?backend); linux.io_queue_close(?queue); ret 1; }
    var peers: [2]ip.Endpoint;
    var tokens: [2]types.Token;
    val first: i64 = submit_accept(?backend, listener, ?peers[0], 61, ?tokens[0]);
    val second: i64 = submit_accept(?backend, listener, ?peers[1], 62, ?tokens[1]);
    val one_resource: bool = backend.resource_count == 1;
    var clients: [2]usize;
    if (test_client(endpoint, ?clients[0]) < 0 || test_client(endpoint, ?clients[1]) < 0) {
        cancel(?backend, tokens[0]); cancel(?backend, tokens[1]); linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1;
    }
    var accepted: [2]usize;
    accepted[0] = (-1)::usize;
    accepted[1] = (-1)::usize;
    var completions: usize = 0;
    var attempts: usize = 0;
    for (attempts < 6 && completions < 2) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 6; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 61) { accepted[0] = native.resource; completions = completions + 1; }
                if (native.context == 62) { accepted[1] = native.resource; completions = completions + 1; }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val valid: bool = first == 0 && second == 0 && one_resource && completions == 2 && accepted[0] != (-1)::usize && accepted[1] != (-1)::usize && accepted[0] != accepted[1] && backend.resource_count == 0;
    if (accepted[0] != (-1)::usize) { linux.sock_close(accepted[0]); }
    if (accepted[1] != (-1)::usize) { linux.sock_close(accepted[1]); }
    linux.sock_close(clients[0]); linux.sock_close(clients[1]); linux.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    linux.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async linux: shutdown and close follow prior writes" {
    var queue: shared.IoQueue;
    if (linux.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8) < 0) { linux.io_queue_close(?queue); ret 1; }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) { destroy(?backend); linux.io_queue_close(?queue); ret 1; }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) { linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1; }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) { linux.sock_close(client); linux.sock_close(listener); destroy(?backend); linux.io_queue_close(?queue); ret 1; }

    var first: u8 = 'a';
    var second: u8 = 'b';
    var tokens: [5]types.Token;
    val write_first: i64 = submit_write(?backend, server, ?first, 1, 71, ?tokens[0]);
    val write_second: i64 = submit_write(?backend, server, ?second, 1, 72, ?tokens[1]);
    val shutdown: i64 = submit_shutdown_write(?backend, server, 73, ?tokens[2]);
    var received: [2]u8;
    val received_bytes: i64 = linux.sock_recv(client, ?received[0], 2);
    var eof_byte: u8 = 0;
    val eof: i64 = linux.sock_recv(client, ?eof_byte, 1);
    var pending: u8 = 0;
    val read_pending: i64 = submit_read(?backend, server, ?pending, 1, 74, ?tokens[3]);
    val close_pending: i64 = submit_close(?backend, server, 75, ?tokens[4]);
    val count: i64 = poll(?backend, 0);
    var valid_order: bool = count == 5;
    var expected: [5]usize;
    expected[0] = 71; expected[1] = 72; expected[2] = 73; expected[3] = 74; expected[4] = 75;
    var i: usize = 0;
    for (i < count::usize && i < 5) {
        var native: types.NativeCompletion;
        completion(?backend, i, ?native);
        if (native.context != expected[i]) { valid_order = false; }
        if (native.context == 74 && native.status != linux.ECANCELED) { valid_order = false; }
        if (native.context == 75 && (native.kind != runtime.CLOSE || native.status != 0)) { valid_order = false; }
        i = i + 1;
    }
    val valid: bool = write_first == 0 && write_second == 0 && shutdown == 0 && read_pending == 0 && close_pending == 0 && received_bytes == 2 && received[0] == 'a' && received[1] == 'b' && eof == 0 && valid_order && backend.resource_count == 0;
    linux.sock_close(client); linux.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    linux.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}
