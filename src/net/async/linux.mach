# the linux part of the linux and darwin readiness backend for internet sockets
# backend for std.net.async, signatures may change in a minor release (README, API surface)
# std.net.async.unix holds the backend. what differs on linux is the packet
# metadata a datagram carries in its control messages.

$if ($mach.build.sys != $mach.sys.linux) {
    $error("std.net.async.linux: requires linux target");
}

use std.net.async.types;
use std.net.ip;
use std.system.os.linux;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val MSG_TRUNC:        i32 = 0x20;
val     IP_PKTINFO:       i32 = 8;
val     IPV6_RECVPKTINFO: i32 = 49;
val     IPV6_PKTINFO:     i32 = 50;

pub fun configure_datagram(resource: usize, family: i32) i64 {
    var enabled: i32 = 1;
    if (family == linux.AF_INET) {
        ret linux.sock_setopt(resource, linux.IPPROTO_IP, IP_PKTINFO, (?enabled)::*u8, 4);
    }
    if (family == linux.AF_INET6) {
        ret linux.sock_setopt(resource, linux.IPPROTO_IPV6, IPV6_RECVPKTINFO, (?enabled)::*u8, 4);
    }
    ret linux.ENOTSUP;
}

# cmsghdr: the record length as a word, then the level and type as two i32s.
# records align to the word
val WORD:   usize = $size_of(usize);
val HEADER: usize = WORD + 8;

# in_pktinfo and in6_pktinfo, the payloads after the header
val PKTINFO_SIZE:  usize = 12;
val PKTINFO6_SIZE: usize = 20;

fun align_control(length: usize) usize {
    ret (length + WORD - 1) & ~(WORD - 1);
}

pub fun packet_metadata(packet: *types.Packet, control: *u8, length: usize) {
    packet.has_local_destination = false;
    packet.interface_index       = 0;
    var offset: usize = 0;
    for (offset + HEADER <= length) {
        val base:           usize = control::usize + offset;
        val message_length: usize = @(base::*usize);
        if (message_length < HEADER || message_length > length - offset) { ret; }
        val level: i32   = @((base + WORD)::*i32);
        val kind:  i32   = @((base + WORD + 4)::*i32);
        val data:  usize = base + HEADER;
        if (level == linux.IPPROTO_IP && kind == IP_PKTINFO && message_length >= HEADER + PKTINFO_SIZE) {
            packet.interface_index = @(data::*u32);
            val address: ip.IPv4 = ip.ipv4(@((data + 8)::*u8), @((data + 9)::*u8), @((data + 10)::*u8), @((data + 11)::*u8));
            packet.local_destination     = ip.addr_v4(address);
            packet.has_local_destination = true;
        }
        or (level == linux.IPPROTO_IPV6 && kind == IPV6_PKTINFO && message_length >= HEADER + PKTINFO6_SIZE) {
            var address: ip.IPv6;
            var i:       usize = 0;
            for (i < 16) {
                address.octets[i] = @((data + i)::*u8);
                i                 = i + 1;
            }
            packet.interface_index       = @((data + 16)::*u32);
            packet.local_destination     = ip.addr_v6(address);
            packet.has_local_destination = true;
        }
        offset = offset + align_control(message_length);
    }
}

pub fun packet_send_metadata(packet: *types.Packet, control: *u8, length: *usize) i64 {
    @length = 0;
    if (!packet.has_local_destination && packet.interface_index == 0) { ret 0; }
    var i: usize = 0;
    for (i < 48) {
        control[i] = 0;
        i          = i + 1;
    }
    val base:   usize = control::usize;
    val family: i32   = ip.endpoint_family(packet.peer);
    if (family == linux.AF_INET) {
        if (packet.has_local_destination && packet.local_destination.is_v6 != 0) { ret linux.EINVAL; }
        @(base::*usize)            = HEADER + PKTINFO_SIZE;
        @((base + WORD)::*i32)     = linux.IPPROTO_IP;
        @((base + WORD + 4)::*i32) = IP_PKTINFO;
        @((base + HEADER)::*u32)   = packet.interface_index;
        if (packet.has_local_destination) {
            for (i < 4) {
                @((base + HEADER + 4 + i)::*u8) = packet.local_destination.v4.octets[i];
                i                               = i + 1;
            }
        }
        @length = HEADER + align_control(PKTINFO_SIZE);
        ret 0;
    }
    if (family == linux.AF_INET6) {
        if (packet.has_local_destination && packet.local_destination.is_v6 == 0) { ret linux.EINVAL; }
        @(base::*usize)            = HEADER + PKTINFO6_SIZE;
        @((base + WORD)::*i32)     = linux.IPPROTO_IPV6;
        @((base + WORD + 4)::*i32) = IPV6_PKTINFO;
        if (packet.has_local_destination) {
            for (i < 16) {
                @((base + HEADER + i)::*u8) = packet.local_destination.v6.octets[i];
                i                           = i + 1;
            }
        }
        @((base + HEADER + 16)::*u32) = packet.interface_index;
        @length                       = HEADER + align_control(PKTINFO6_SIZE);
        ret 0;
    }
    ret linux.ENOTSUP;
}
