# bounded darwin readiness backend for internet sockets
# attached handles remain exclusively owned by this backend through completion and close.

$if ($mach.build.os != $mach.os.darwin) {
    $error("std.net.async.darwin: requires darwin target");
}

use std.allocator;
use std.allocator.page;
use std.io.runtime;
use std.memory;
use std.memory.table;
use std.net.async.types;
use std.net.ip;
use std.sync.mutex;
use std.system.os.darwin;
use std.system.os.shared;
use std.system.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

fwd types.Vector;
fwd types.Packet;
fwd types.Token;
fwd types.NativeCompletion;

pub rec Operation {
    state:          u8;
    generation:     u32;
    index:          u32;
    completion:     types.NativeCompletion;
    kind:           runtime.Kind;
    resource:       usize;
    context:        usize;
    buffer:         *u8;
    length:         usize;
    vectors:        *types.Vector;
    vector_count:   usize;
    packets:        *types.Packet;
    packet_count:   usize;
    peer:           ip.Endpoint;
    accept_peer:    *ip.Endpoint;
    sequence:       u64;
    previous:       u32;
    next:           u32;
    resource_index: u32;
    lane:           u8;
    stage:          u8;
}

rec Resource {
    state:        u8;
    generation:   u32;
    index:        u32;
    resource:     usize;
    read_head:    u32;
    read_tail:    u32;
    write_head:   u32;
    write_tail:   u32;
    close_index:  u32;
    armed:        bool;
    watched:      bool;
    closing:      bool;
    write_closed: bool;
    opening:      u64;
    configured:   bool;
    next_free:    u32;
}

pub rec Backend {
    queue:     *shared.IoQueue;
    source_id: u16;
    # where every table's chunks come from
    allocator:       allocator.Allocator;
    operations:      table.Table;
    resources:       table.Table;
    ready:           table.Table;
    resource_map:    *u32;
    native:          *darwin.IoCompletion;
    operation_slots: usize;
    resource_slots:  usize;
    map_capacity:    usize;
    live:            usize;
    resource_count:  usize;
    free_operation:  u32;
    free_resource:   u32;
    queued_head:     u32;
    queued_tail:     u32;
    queued_count:    usize;
    ready_count:     usize;
    sequence:        u64;
    # native registration and address calls, counted for the scaling tests
    watches:   u64;
    rearms:    u64;
    unwatches: u64;
    # registrations held, zero once destroy returns
    registered: usize;
    locates:    u64;
    lock:       mutex.Mutex;
}

fun operation_at(backend: *Backend, index: usize) *Operation {
    ret table.at(?backend.operations, index)::*Operation;
}

fun resource_at(backend: *Backend, index: usize) *Resource {
    ret table.at(?backend.resources, index)::*Resource;
}

fun ready_at(backend: *Backend, index: usize) *types.NativeCompletion {
    ret table.at(?backend.ready, index)::*types.NativeCompletion;
}

pub fun aliases(backend: *Backend, data: *u8, len: usize) bool {
    if (!memory.range_valid(data, len)) { ret true; }
    if (len == 0)                       { ret false; }
    if (!memory.range_valid(backend::*u8, $size_of(Backend)) ||
        backend.queue == nil || backend.operations.capacity == 0 ||
        backend.map_capacity == 0) { ret true; }
    var map_bytes:    usize = 0;
    var native_bytes: usize = 0;
    if (!memory.range_scaled(backend.map_capacity, $size_of(u32), ?map_bytes) ||
        !memory.range_scaled(NATIVE_BATCH, $size_of(darwin.IoCompletion),
        ?native_bytes)) { ret true; }
    ret memory.ranges_overlap(backend::*u8, $size_of(Backend), data, len) ||
        memory.ranges_overlap(backend.queue::*u8, $size_of(shared.IoQueue),
        data, len) ||
        table.aliases(?backend.operations, data, len) ||
        table.aliases(?backend.resources, data, len) ||
        table.aliases(?backend.ready, data, len) ||
        memory.ranges_overlap(backend.resource_map::*u8, map_bytes,
        data, len) ||
        memory.ranges_overlap(backend.native::*u8, native_bytes, data, len);
}

val SLOT_FREE:       u8  = 0;
val SLOT_ACTIVE:     u8  = 1;
val SLOT_QUEUED:     u8  = 2;
val RESOURCE_FREE:   u8  = 0;
val RESOURCE_ACTIVE: u8  = 1;
val LANE_NONE:       u8  = 0;
val LANE_READ:       u8  = 1;
val LANE_WRITE:      u8  = 2;
val NONE:            u32 = 0xffffffff;
# readiness is harvested in fixed batches, so the batch is not a capacity
val NATIVE_BATCH:     usize = 256;
val IN_PROGRESS:      i64   = -36;
val MSG_TRUNC:        i32   = 0x10;
val IP_RECVDSTADDR:   i32   = 7;
val IP_SENDSRCADDR:   i32   = 7;
val IP_RECVIF:        i32   = 20;
val IPV6_RECVPKTINFO: i32   = 61;
val IPV6_PKTINFO:     i32   = 46;

fun invalid() i64 {
    ret darwin.EINVAL;
}

fun token_context(backend: *Backend, token: types.Token) usize {
    ret shared.io_source_context(backend.source_id, (token.index::u64 << 16) | token.generation::u64);
}

fun context_token(backend: *Backend, context: usize, token: *types.Token) bool {
    val raw: u64 = context::u64;
    if (shared.io_context_source(context) != backend.source_id || token == nil) { ret false; }
    token.index      = ((raw >> 16) & 0xffffffff)::u32;
    token.generation = (raw & 0xffff)::u32;
    ret token.generation != 0;
}

# a resource generation stays inside the wire field, so the stored value and the
# encoded one are the same number and no comparison is made on a truncation
fun next_wire_generation(current: u32) u32 {
    val generation: u32 = current + 1;
    if (generation > 0xffff) { ret 1; }
    ret generation;
}

fun operation_for(backend: *Backend, token: types.Token) *Operation {
    if (token.index::usize >= backend.operation_slots) { ret nil; }
    val operation: *Operation = operation_at(backend, token.index::usize);
    if (operation.state != SLOT_ACTIVE || operation.generation != token.generation) { ret nil; }
    ret operation;
}

fun operation_any(backend: *Backend, token: types.Token) *Operation {
    if (token.index::usize >= backend.operation_slots) { ret nil; }
    val operation: *Operation = operation_at(backend, token.index::usize);
    if (operation.state == SLOT_FREE || operation.generation != token.generation) { ret nil; }
    ret operation;
}

fun resource_for(backend: *Backend, token: types.Token) *Resource {
    if (token.index::usize >= backend.resource_slots) { ret nil; }
    val resource: *Resource = resource_at(backend, token.index::usize);
    if (resource.state != RESOURCE_ACTIVE || resource.generation != token.generation) { ret nil; }
    ret resource;
}

fun required_map_capacity(capacity: usize) usize {
    if (capacity > 0x3fffffff) { ret 0; }
    val required: usize = capacity * 2;
    var size:     usize = 1;
    for (size < required) { size = size * 2; }
    ret size;
}

fun resource_hash(resource: usize) usize {
    ret resource * 11400714819323198485;
}

fun resource_lookup(backend: *Backend, resource: usize) *Resource {
    var slot:    usize = resource_hash(resource) & (backend.map_capacity - 1);
    var scanned: usize = 0;
    for (scanned < backend.map_capacity) {
        val entry: u32 = backend.resource_map[slot];
        if (entry == 0) { ret nil; }
        val candidate: *Resource = resource_at(backend, (entry - 1)::usize);
        if (candidate.resource == resource) { ret candidate; }
        slot    = (slot + 1) & (backend.map_capacity - 1);
        scanned = scanned + 1;
    }
    ret nil;
}

fun resource_map_insert(backend: *Backend, index: u32) bool {
    val resource: usize = resource_at(backend, index::usize).resource;
    var slot:     usize = resource_hash(resource) & (backend.map_capacity - 1);
    var scanned:  usize = 0;
    for (scanned < backend.map_capacity) {
        if (backend.resource_map[slot] == 0) {
            backend.resource_map[slot] = index + 1;
            ret true;
        }
        slot    = (slot + 1) & (backend.map_capacity - 1);
        scanned = scanned + 1;
    }
    ret false;
}

# linear probing deletes by shifting the rest of the probe run back, so no
# tombstone is ever left and a lookup ends at the first empty slot
fun resource_map_remove(backend: *Backend, index: u32) {
    val mask:     usize = backend.map_capacity - 1;
    val resource: usize = resource_at(backend, index::usize).resource;
    var hole:     usize = resource_hash(resource) & mask;
    var scanned:  usize = 0;
    for (backend.resource_map[hole] != index + 1) {
        if (backend.resource_map[hole] == 0 || scanned == backend.map_capacity) { ret; }
        hole    = (hole + 1) & mask;
        scanned = scanned + 1;
    }
    backend.resource_map[hole] = 0;
    var next: usize = (hole + 1) & mask;
    for (backend.resource_map[next] != 0) {
        val entry: u32   = backend.resource_map[next];
        val home:  usize = resource_hash(resource_at(backend, (entry - 1)::usize).resource) & mask;
        # an entry may fill the hole only if its home is not after the hole
        if (((next - home) & mask) >= ((next - hole) & mask)) {
            backend.resource_map[hole] = entry;
            backend.resource_map[next] = 0;
            hole                       = next;
        }
        next = (next + 1) & mask;
    }
}

# the map holds indices, so a rehash may move it while every resource stays put
fun rehash_resources(backend: *Backend) bool {
    val required: usize = required_map_capacity(backend.resources.capacity);
    if (required == 0 || required <= backend.map_capacity) { ret required != 0; }
    var bytes: usize = 0;
    if (!memory.range_scaled(required, $size_of(u32), ?bytes)) { ret false; }
    val fresh: *u32 = darwin.allocate(bytes)::*u32;
    if (fresh == nil) { ret false; }
    val previous:          *u32  = backend.resource_map;
    val previous_capacity: usize = backend.map_capacity;
    var i:                 usize = 0;
    for (i < required) {
        fresh[i] = 0;
        i        = i + 1;
    }
    backend.resource_map = fresh;
    backend.map_capacity = required;
    i                    = 0;
    for (i < backend.resource_slots) {
        val entry: *Resource = resource_at(backend, i);
        if (entry.state == RESOURCE_ACTIVE && !resource_map_insert(backend, i::u32)) {
            backend.resource_map = previous;
            backend.map_capacity = previous_capacity;
            darwin.deallocate(fresh::ptr, bytes);
            ret false;
        }
        i = i + 1;
    }
    darwin.deallocate(previous::ptr, $size_of(u32) * previous_capacity);
    ret true;
}

fun resource_append(backend: *Backend) bool {
    if (backend.resource_slots > 0xffffffff) { ret false; }
    if (backend.resource_slots == backend.resources.capacity) {
        if (!table.grow(?backend.resources) || !rehash_resources(backend)) { ret false; }
    }
    val index: usize     = backend.resource_slots;
    val entry: *Resource = resource_at(backend, index);
    entry.state            = RESOURCE_FREE;
    entry.generation       = 0;
    entry.index            = index::u32;
    entry.armed            = false;
    entry.closing          = false;
    entry.write_closed     = false;
    entry.next_free        = backend.free_resource;
    backend.free_resource  = index::u32;
    backend.resource_slots = index + 1;
    ret true;
}

fun resource_acquire(backend: *Backend, native: usize, opening: u64, created: *bool) *Resource {
    val existing: *Resource = resource_lookup(backend, native);
    # openings only grow, so the older of two openings is the socket that was closed
    if (existing != nil && opening < existing.opening) {
        @created = false;
        ret nil;
    }
    if (existing != nil && existing.opening != opening) { drop_stale(backend, existing); }
    or (existing != nil) {
        @created = false;
        ret existing;
    }
    if (backend.free_resource == NONE && !resource_append(backend)) { ret nil; }
    val index:    u32       = backend.free_resource;
    val resource: *Resource = resource_at(backend, index::usize);
    backend.free_resource = resource.next_free;
    val generation: u32 = next_wire_generation(resource.generation);
    resource.state        = RESOURCE_ACTIVE;
    resource.generation   = generation;
    resource.resource     = native;
    resource.opening      = opening;
    resource.configured   = false;
    resource.watched      = false;
    resource.read_head    = NONE;
    resource.read_tail    = NONE;
    resource.write_head   = NONE;
    resource.write_tail   = NONE;
    resource.close_index  = NONE;
    resource.armed        = false;
    resource.closing      = false;
    resource.write_closed = false;
    if (!resource_map_insert(backend, index)) {
        resource.state        = RESOURCE_FREE;
        resource.next_free    = backend.free_resource;
        backend.free_resource = index;
        ret nil;
    }
    backend.resource_count = backend.resource_count + 1;
    @created               = true;
    ret resource;
}

fun resource_release_unwatched(backend: *Backend, resource: *Resource) {
    val index: u32 = resource.index;
    set_watched(backend, resource, false);
    resource_map_remove(backend, index);
    resource.state         = RESOURCE_FREE;
    resource.armed         = false;
    resource.next_free     = backend.free_resource;
    backend.free_resource  = index;
    backend.resource_count = backend.resource_count - 1;
}

# every registration change goes through here, so destroy can prove it gave up
# each one before the runtime recycles the source id they carry
fun set_watched(backend: *Backend, resource: *Resource, watched: bool) {
    if (watched && !resource.watched) { backend.registered = backend.registered + 1; }
    if (!watched && resource.watched) { backend.registered = backend.registered - 1; }
    resource.watched = watched;
}

fun resource_release(backend: *Backend, resource: *Resource) {
    unwatch_owned(backend, resource);
    resource_release_unwatched(backend, resource);
}

# a resource removes only the registration it made itself
fun unwatch_owned(backend: *Backend, resource: *Resource) {
    if (resource.watched) {
        backend.unwatches = backend.unwatches + 1;
        darwin.io_queue_unwatch(backend.queue, resource.resource);
    }
    set_watched(backend, resource, false);
    resource.armed = false;
}

# the socket this resource tracked was closed outside the driver and its
# native value now names another socket. its pending operations complete as
# closed, and it gives up only the registration it still owns: the new socket
# has none from this backend yet, because the stale resource is dropped before
# the new one is armed
fun drop_stale(backend: *Backend, resource: *Resource) {
    fail_resource(backend, resource, types.STATUS_STALE);
    if (resource.close_index != NONE) {
        val close_operation: *Operation = operation_at(backend, resource.close_index::usize);
        resource.close_index = NONE;
        finish(backend, resource, close_operation, types.STATUS_STALE, 0, 0, resource.resource, false);
    }
    unwatch_owned(backend, resource);
    resource_release_unwatched(backend, resource);
}

# the ready table is held at the operation table's size, so a finished
# operation always has somewhere to publish
fun operation_append(backend: *Backend) bool {
    if (backend.operation_slots > 0xffffffff) { ret false; }
    if (backend.operation_slots == backend.operations.capacity &&
        !table.grow(?backend.operations)) { ret false; }
    if (!table.reserve(?backend.ready, backend.operations.capacity)) { ret false; }
    val index: usize      = backend.operation_slots;
    val entry: *Operation = operation_at(backend, index);
    entry.state             = SLOT_FREE;
    entry.generation        = 0;
    entry.index             = index::u32;
    entry.previous          = NONE;
    entry.next              = backend.free_operation;
    backend.free_operation  = index::u32;
    backend.operation_slots = index + 1;
    ret true;
}

fun operation_claim(backend: *Backend, kind: runtime.Kind, native: usize, context: usize, token: *types.Token) *Operation {
    if (backend.free_operation == NONE && !operation_append(backend)) { ret nil; }
    val index:     u32        = backend.free_operation;
    val operation: *Operation = operation_at(backend, index::usize);
    backend.free_operation = operation.next;
    var generation: u32 = operation.generation + 1;
    if (generation == 0) { generation = 1; }
    operation.state      = SLOT_ACTIVE;
    operation.generation = generation;
    operation.kind       = kind;
    operation.resource   = native;
    operation.context    = context;
    operation.sequence   = backend.sequence;
    operation.previous   = NONE;
    operation.next       = NONE;
    operation.lane       = LANE_NONE;
    operation.stage      = 0;
    backend.sequence     = backend.sequence + 1;
    backend.live         = backend.live + 1;
    @token               = types.Token{index: index, generation: generation};
    ret operation;
}

fun operation_release(backend: *Backend, index: u32) {
    val operation: *Operation = operation_at(backend, index::usize);
    operation.state        = SLOT_FREE;
    operation.previous     = NONE;
    operation.next         = backend.free_operation;
    backend.free_operation = index;
    backend.live           = backend.live - 1;
}

fun operation_index(backend: *Backend, operation: *Operation) u32 {
    ret operation.index;
}

fun resource_index(backend: *Backend, resource: *Resource) u32 {
    ret resource.index;
}

fun enqueue(backend: *Backend, resource: *Resource, operation: *Operation, lane: u8) {
    val index: u32 = operation_index(backend, operation);
    operation.resource_index = resource_index(backend, resource);
    operation.lane           = lane;
    if (lane == LANE_READ) {
        operation.previous = resource.read_tail;
        if (resource.read_tail == NONE) { resource.read_head = index; }
        or                              { operation_at(backend, resource.read_tail::usize).next = index; }
        resource.read_tail = index;
    }
    or {
        operation.previous = resource.write_tail;
        if (resource.write_tail == NONE) { resource.write_head = index; }
        or                               { operation_at(backend, resource.write_tail::usize).next = index; }
        resource.write_tail = index;
    }
}

fun unlink(backend: *Backend, resource: *Resource, operation: *Operation) {
    val previous: u32 = operation.previous;
    val next:     u32 = operation.next;
    if (operation.lane == LANE_READ) {
        if (previous == NONE) { resource.read_head = next; }
        or                    { operation_at(backend, previous::usize).next = next; }
        if (next == NONE)     { resource.read_tail = previous; }
        or                    { operation_at(backend, next::usize).previous = previous; }
    }
    or (operation.lane == LANE_WRITE) {
        if (previous == NONE) { resource.write_head = next; }
        or                    { operation_at(backend, previous::usize).next = next; }
        if (next == NONE)     { resource.write_tail = previous; }
        or                    { operation_at(backend, next::usize).previous = previous; }
    }
    operation.previous = NONE;
    operation.next     = NONE;
    operation.lane     = LANE_NONE;
}

# a finished operation carries its own completion and the queue links them, so
# the finished queue is never a table that has to be sized
fun finish(backend: *Backend, resource: *Resource, operation: *Operation, status: i64, bytes: usize, items: usize, native_resource: usize, end_of_stream: bool) {
    unlink(backend, resource, operation);
    val index: u32 = operation.index;
    operation.completion.context       = operation.context;
    operation.completion.kind          = operation.kind;
    operation.completion.bytes         = bytes;
    operation.completion.items         = items;
    operation.completion.resource      = native_resource;
    operation.completion.status        = status;
    operation.completion.end_of_stream = end_of_stream;
    operation.previous                 = backend.queued_tail;
    operation.next                     = NONE;
    if (backend.queued_tail == NONE) { backend.queued_head = index; }
    or                               { operation_at(backend, backend.queued_tail::usize).next = index; }
    backend.queued_tail  = index;
    backend.queued_count = backend.queued_count + 1;
    operation.state      = SLOT_QUEUED;
}

fun queued_unlink(backend: *Backend, operation: *Operation) {
    val previous: u32 = operation.previous;
    val next:     u32 = operation.next;
    if (previous == NONE) { backend.queued_head = next; }
    or                    { operation_at(backend, previous::usize).next = next; }
    if (next == NONE)     { backend.queued_tail = previous; }
    or                    { operation_at(backend, next::usize).previous = previous; }
    operation.previous   = NONE;
    operation.next       = NONE;
    backend.queued_count = backend.queued_count - 1;
}

fun would_block(status: i64) bool {
    ret status == darwin.EAGAIN || status == IN_PROGRESS;
}

fun attempt(backend: *Backend, resource: *Resource, operation: *Operation) bool {
    var result:             i64   = 0;
    var completed_bytes:    usize = 0;
    var completed_items:    usize = 0;
    var completed_resource: usize = operation.resource;
    var end_of_stream:      bool  = false;
    if (operation.kind == runtime.ACCEPT) {
        result = stream_accept(operation.resource, operation.accept_peer, ?completed_resource);
    }
    or (operation.kind == runtime.CONNECT) {
        if (operation.stage == 0) {
            result = stream_connect(operation.resource, operation.peer);
            if (would_block(result)) {
                operation.stage = 1;
                ret false;
            }
        }
        or {
            result = stream_connect_status(operation.resource);
        }
    }
    or (operation.kind == runtime.READ) {
        result        = stream_read(operation.resource, operation.buffer, operation.length);
        end_of_stream = result == 0 && operation.length != 0;
    }
    or (operation.kind == runtime.READABLE) {
        result        = stream_readable(operation.resource);
        end_of_stream = result == 0;
    }
    or (operation.kind == runtime.WRITE) {
        if (operation.vectors != nil) { result = stream_write_vector(operation.resource, operation.vectors, operation.vector_count); }
        or                            { result = stream_write(operation.resource, operation.buffer, operation.length); }
    }
    or (operation.kind == runtime.RECEIVE_FROM) {
        result = datagram_receive_batch(operation.resource, operation.packets, operation.packet_count);
        if (result >= 0) {
            completed_items = result::usize;
            var i: usize = 0;
            for (i < completed_items) {
                var copied: usize = operation.packets[i].length;
                if (copied > operation.packets[i].capacity) { copied = operation.packets[i].capacity; }
                completed_bytes = completed_bytes + copied;
                i               = i + 1;
            }
        }
    }
    or (operation.kind == runtime.SEND_TO) {
        result = datagram_send_batch(operation.resource, operation.packets, operation.packet_count);
        if (result >= 0) {
            completed_items = result::usize;
            var i: usize = 0;
            for (i < completed_items) {
                completed_bytes = completed_bytes + operation.packets[i].length;
                i               = i + 1;
            }
        }
    }
    or (operation.kind == runtime.SHUTDOWN) {
        result = stream_shutdown_write(operation.resource);
        if (result >= 0) { resource.write_closed = true; }
    }
    or {
        result = darwin.EINVAL;
    }
    if (would_block(result)) { ret false; }
    if (result < 0)          { finish(backend, resource, operation, result, 0, 0, completed_resource, false); }
    or {
        var bytes: usize = 0;
        if (operation.kind == runtime.READ || operation.kind == runtime.WRITE)           { bytes = result::usize; }
        or (operation.kind == runtime.RECEIVE_FROM || operation.kind == runtime.SEND_TO) { bytes = completed_bytes; }
        finish(backend, resource, operation, 0, bytes, completed_items, completed_resource, end_of_stream);
    }
    ret true;
}

fun fail_resource(backend: *Backend, resource: *Resource, status: i64) {
    for (resource.read_head != NONE || resource.write_head != NONE) {
        var index: u32 = resource.read_head;
        if (index == NONE)                                                                                                                            { index = resource.write_head; }
        or (resource.write_head != NONE && operation_at(backend, resource.write_head::usize).sequence < operation_at(backend, index::usize).sequence) { index = resource.write_head; }
        val operation: *Operation = operation_at(backend, index::usize);
        finish(backend, resource, operation, status, 0, 0, operation.resource, false);
    }
}

fun arm_resource(backend: *Backend, resource: *Resource) {
    var events: u32 = 0;
    if (resource.read_head != NONE)  { events = events | darwin.IO_EVENT_READ; }
    if (resource.write_head != NONE) { events = events | darwin.IO_EVENT_WRITE; }
    # an idle socket keeps its resource and its registration, so the next
    # operation only rearms it. only a close through the driver gives them up.
    # kqueue's read and write filters are separate oneshots, so a filter armed
    # for an operation that finished without it firing stays armed while the
    # socket is idle. its event later finds an empty queue and does nothing
    if (events == 0) {
        if (resource.close_index != NONE) {
            unwatch_owned(backend, resource);
            val close_operation: *Operation = operation_at(backend, resource.close_index::usize);
            resource.close_index = NONE;
            val closed: i64 = socket_close(resource.resource);
            finish(backend, resource, close_operation, closed, 0, 0, resource.resource, false);
            resource_release_unwatched(backend, resource);
        }
        ret;
    }
    val token:  types.Token = types.Token{index: resource.index, generation: resource.generation};
    var status: i64         = 0;
    if (resource.watched) {
        backend.rearms = backend.rearms + 1;
        status         = darwin.io_queue_rearm(backend.queue, resource.resource, token_context(backend, token), events);
    }
    or {
        backend.watches = backend.watches + 1;
        status          = darwin.io_queue_watch(backend.queue, resource.resource, token_context(backend, token), events);
    }
    # the registration vanishes only when every descriptor for the socket is
    # closed, so the socket this resource tracked was closed outside the driver
    if (status == darwin.ENOENT && resource.watched) {
        set_watched(backend, resource, false);
        drop_stale(backend, resource);
        ret;
    }
    if (status < 0) {
        fail_resource(backend, resource, status);
        unwatch_owned(backend, resource);
        if (resource.close_index != NONE) {
            val close_operation: *Operation = operation_at(backend, resource.close_index::usize);
            resource.close_index = NONE;
            val closed: i64 = socket_close(resource.resource);
            finish(backend, resource, close_operation, closed, 0, 0, resource.resource, false);
        }
        resource_release_unwatched(backend, resource);
        ret;
    }
    set_watched(backend, resource, true);
    resource.armed = true;
}

fun drive_resource(backend: *Backend, resource: *Resource, events: u32) {
    val failure: bool = (events & (darwin.IO_EVENT_ERROR | darwin.IO_EVENT_HANGUP)) != 0;
    if ((events & darwin.IO_EVENT_READ) != 0 || failure) {
        var progress: bool = true;
        for (progress && resource.read_head != NONE) {
            progress = attempt(backend, resource, operation_at(backend, resource.read_head::usize));
        }
    }
    if ((events & darwin.IO_EVENT_WRITE) != 0 || failure) {
        var progress: bool = true;
        for (progress && resource.write_head != NONE) {
            progress = attempt(backend, resource, operation_at(backend, resource.write_head::usize));
        }
    }
    arm_resource(backend, resource);
}

fun begin(backend: *Backend, native: usize, opening: u64, kind: runtime.Kind, context: usize, lane: u8, token: *types.Token, resource_out: **Resource, operation_out: **Operation) i64 {
    if (backend == nil || token == nil || resource_out == nil || operation_out == nil) { ret invalid(); }
    if (resource_lookup(backend, native) == nil) {
        var address:        [128]u8;
        var address_length: u32 = 128;
        backend.locates = backend.locates + 1;
        val located: i64 = darwin.sock_local_addr(native, ?address[0], ?address_length);
        if (located < 0)        { ret located; }
        if (address_length < 2) { ret darwin.EINVAL; }
        val family: i32 = ip.sockaddr_family(?address[0]);
        if (family != darwin.AF_INET && family != darwin.AF_INET6) { ret darwin.ENOTSUP; }
    }
    val known: *Resource = resource_lookup(backend, native);
    if (known != nil && opening < known.opening) { ret types.STATUS_STALE; }
    var created:  bool      = false;
    val resource: *Resource = resource_acquire(backend, native, opening, ?created);
    if (resource == nil || resource.closing) { ret darwin.EBADF; }
    if (lane == LANE_WRITE && resource.write_closed && kind != runtime.CLOSE) {
        if (created) { resource_release(backend, resource); }
        ret darwin.EPIPE;
    }
    val operation: *Operation = operation_claim(backend, kind, native, context, token);
    if (operation == nil) {
        if (created) { resource_release(backend, resource); }
        ret darwin.ENOMEM;
    }
    operation.buffer         = nil;
    operation.length         = 0;
    operation.vectors        = nil;
    operation.vector_count   = 0;
    operation.packets        = nil;
    operation.packet_count   = 0;
    operation.accept_peer    = nil;
    operation.resource_index = resource_index(backend, resource);
    if (lane != LANE_NONE) { enqueue(backend, resource, operation, lane); }
    @resource_out  = resource;
    @operation_out = operation;
    ret 0;
}

fun submission_done(backend: *Backend, resource: *Resource) {
    drive_resource(backend, resource, darwin.IO_EVENT_READ | darwin.IO_EVENT_WRITE);
    mutex.unlock(?backend.lock);
    darwin.io_queue_wake(backend.queue);
}

# initial is the size the backend starts at: the operation, resource and ready
# tables grow on demand and the resource map rehashes with them
pub fun make(backend: *Backend, queue: *shared.IoQueue, initial: usize, source_id: u16) i64 {
    if (backend == nil || queue == nil || initial == 0 || source_id == 0) { ret invalid(); }
    val map_capacity: usize = required_map_capacity(initial);
    if (map_capacity == 0) { ret darwin.ENOMEM; }
    var map_bytes:    usize = 0;
    var native_bytes: usize = 0;
    if (!memory.range_scaled(map_capacity, $size_of(u32), ?map_bytes) ||
        !memory.range_scaled(NATIVE_BATCH, $size_of(darwin.IoCompletion), ?native_bytes)) { ret darwin.ENOMEM; }

    val allocated: err[allocator.Error] = page.make(?backend.allocator);
    if (sel allocated.err)                                                                  { ret darwin.ENOMEM; }
    if (!table.make(?backend.operations, ?backend.allocator, $size_of(Operation), initial)) { ret darwin.ENOMEM; }
    if (!table.make(?backend.resources, ?backend.allocator, $size_of(Resource), initial) ||
        !table.make(?backend.ready, ?backend.allocator, $size_of(types.NativeCompletion), initial)) {
        table.destroy(?backend.ready);
        table.destroy(?backend.resources);
        table.destroy(?backend.operations);
        ret darwin.ENOMEM;
    }
    backend.resource_map = darwin.allocate(map_bytes)::*u32;
    if (backend.resource_map == nil) {
        table.destroy(?backend.ready);
        table.destroy(?backend.resources);
        table.destroy(?backend.operations);
        ret darwin.ENOMEM;
    }
    backend.native = darwin.allocate(native_bytes)::*darwin.IoCompletion;
    if (backend.native == nil) {
        darwin.deallocate(backend.resource_map::ptr, map_bytes);
        backend.resource_map = nil;
        table.destroy(?backend.ready);
        table.destroy(?backend.resources);
        table.destroy(?backend.operations);
        ret darwin.ENOMEM;
    }

    backend.queue           = queue;
    backend.source_id       = source_id;
    backend.map_capacity    = map_capacity;
    backend.operation_slots = 0;
    backend.resource_slots  = 0;
    backend.live            = 0;
    backend.resource_count  = 0;
    backend.free_operation  = NONE;
    backend.free_resource   = NONE;
    backend.queued_head     = NONE;
    backend.queued_tail     = NONE;
    backend.queued_count    = 0;
    backend.ready_count     = 0;
    backend.sequence        = 1;
    backend.watches         = 0;
    backend.rearms          = 0;
    backend.unwatches       = 0;
    backend.registered      = 0;
    backend.locates         = 0;
    backend.lock            = mutex.make();
    var i: usize = 0;
    for (i < map_capacity) {
        backend.resource_map[i] = 0;
        i                       = i + 1;
    }
    ret 0;
}

pub fun submit_accept(backend: *Backend, listener: usize, opening: u64, peer: *ip.Endpoint, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, listener, opening, runtime.ACCEPT, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.accept_peer = peer;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_connect(backend: *Backend, native: usize, opening: u64, peer: ip.Endpoint, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, native, opening, runtime.CONNECT, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.peer = peer;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_read(backend: *Backend, native: usize, opening: u64, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || (buffer == nil && length != 0)) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, native, opening, runtime.READ, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.buffer = buffer;
    operation.length = length;
    submission_done(backend, resource);
    ret 0;
}

# wait for the stream to be readable without a buffer: the completion reports
# end_of_stream at orderly EOF, and nothing is read
pub fun submit_readable(backend: *Backend, native: usize, opening: u64, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, native, opening, runtime.READABLE, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_write(backend: *Backend, native: usize, opening: u64, buffer: *u8, length: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || (buffer == nil && length != 0)) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, native, opening, runtime.WRITE, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.buffer = buffer;
    operation.length = length;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_write_vector(backend: *Backend, native: usize, opening: u64, vectors: *types.Vector, count: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || vectors == nil || count == 0 || count > 1024) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, native, opening, runtime.WRITE, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.vectors      = vectors;
    operation.vector_count = count;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_receive_batch(backend: *Backend, native: usize, opening: u64, packets: *types.Packet, count: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || packets == nil || count == 0) { ret invalid(); }
    mutex.lock(?backend.lock);
    val known: *Resource = resource_lookup(backend, native);
    if (known == nil || known.opening != opening || !known.configured) {
        backend.locates = backend.locates + 1;
        val configured: i64 = configure_datagram_socket(native);
        if (configured < 0) {
            mutex.unlock(?backend.lock);
            ret configured;
        }
    }
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, native, opening, runtime.RECEIVE_FROM, context, LANE_READ, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    resource.configured    = true;
    operation.packets      = packets;
    operation.packet_count = count;
    submission_done(backend, resource);
    ret 0;
}

# a send batch is validated whole before submission, as on windows: a packet
# longer than its capacity, a missing buffer or an unsupported peer family
# refuses the batch and nothing from it is sent
fun validate_send_packets(packets: *types.Packet, count: usize) i64 {
    var i: usize = 0;
    for (i < count) {
        val packet: *types.Packet = ?packets[i];
        if (packet.length > packet.capacity || (packet.buffer == nil && (packet.capacity != 0 || packet.length != 0))) { ret invalid(); }
        val family: i32 = ip.endpoint_family(packet.peer);
        if (family != darwin.AF_INET && family != darwin.AF_INET6) { ret darwin.ENOTSUP; }
        i = i + 1;
    }
    ret 0;
}

pub fun submit_send_batch(backend: *Backend, native: usize, opening: u64, packets: *types.Packet, count: usize, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil || packets == nil || count == 0) { ret invalid(); }
    val valid: i64 = validate_send_packets(packets, count);
    if (valid < 0) { ret valid; }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, native, opening, runtime.SEND_TO, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    operation.packets      = packets;
    operation.packet_count = count;
    submission_done(backend, resource);
    ret 0;
}

pub fun submit_shutdown_write(backend: *Backend, native: usize, opening: u64, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource:  *Resource;
    var operation: *Operation;
    val status:    i64 = begin(backend, native, opening, runtime.SHUTDOWN, context, LANE_WRITE, token, ?resource, ?operation);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    submission_done(backend, resource);
    ret 0;
}

fun begin_close_locked(backend: *Backend, native: usize, opening: u64, context: usize, token: *types.Token, resource_out: **Resource) i64 {
    var operation: *Operation;
    val status:    i64 = begin(backend, native, opening, runtime.CLOSE, context, LANE_NONE, token, resource_out, ?operation);
    if (status < 0) { ret status; }
    val resource: *Resource = @resource_out;
    resource.closing     = true;
    resource.close_index = operation_index(backend, operation);
    for (resource.read_head != NONE) {
        val read_operation: *Operation = operation_at(backend, resource.read_head::usize);
        finish(backend, resource, read_operation, darwin.ECANCELED, 0, 0, native, false);
    }
    ret 0;
}

pub fun submit_close(backend: *Backend, native: usize, opening: u64, context: usize, token: *types.Token) i64 {
    if (backend == nil || token == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    var resource: *Resource;
    val status:   i64 = begin_close_locked(backend, native, opening, context, token, ?resource);
    if (status < 0) {
        mutex.unlock(?backend.lock);
        ret status;
    }
    submission_done(backend, resource);
    ret 0;
}

pub fun cancel(backend: *Backend, token: types.Token) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    val operation: *Operation = operation_any(backend, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret darwin.EBADF;
    }
    if (operation.state == SLOT_QUEUED) {
        val removed: types.NativeCompletion = operation.completion;
        queued_unlink(backend, operation);
        operation_release(backend, token.index);
        mutex.unlock(?backend.lock);
        if (removed.kind == runtime.ACCEPT && removed.status == 0) { socket_close(removed.resource); }
        darwin.io_queue_wake(backend.queue);
        ret 0;
    }
    val resource: *Resource = resource_at(backend, operation.resource_index::usize);
    if (operation.kind == runtime.CLOSE) {
        resource.close_index = NONE;
        unlink(backend, resource, operation);
        operation_release(backend, token.index);
        fail_resource(backend, resource, darwin.ECANCELED);
        unwatch_owned(backend, resource);
        socket_close(resource.resource);
        resource_release_unwatched(backend, resource);
        mutex.unlock(?backend.lock);
        darwin.io_queue_wake(backend.queue);
        ret 0;
    }
    unlink(backend, resource, operation);
    operation_release(backend, token.index);
    drive_resource(backend, resource, darwin.IO_EVENT_READ | darwin.IO_EVENT_WRITE);
    mutex.unlock(?backend.lock);
    darwin.io_queue_wake(backend.queue);
    ret 0;
}

fun publish_ready(backend: *Backend) usize {
    var count: usize = 0;
    for (backend.queued_count > 0) {
        val index:     u32        = backend.queued_head;
        val operation: *Operation = operation_at(backend, index::usize);
        @ready_at(backend, count) = operation.completion;
        queued_unlink(backend, operation);
        operation_release(backend, index);
        count = count + 1;
    }
    backend.ready_count = count;
    ret count;
}

pub fun flush(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    val ready: usize = publish_ready(backend);
    mutex.unlock(?backend.lock);
    ret ready::i64;
}

pub fun dispatch(
    backend: *Backend,
    context: usize,
    events: u32,
    status: i64,
    flags: u64,
    claimed: *bool,
) i64 {
    if (backend == nil || claimed == nil) { ret invalid(); }
    @claimed = false;
    var resource_token: types.Token;
    if (!context_token(backend, context, ?resource_token)) { ret 0; }
    @claimed = true;
    mutex.lock(?backend.lock);
    val resource: *Resource = resource_for(backend, resource_token);
    if (resource != nil) {
        resource.armed = false;
        drive_resource(backend, resource, events);
    }
    val ready: usize = publish_ready(backend);
    mutex.unlock(?backend.lock);
    ret ready::i64;
}

# one thread owns poll and completion retrieval
pub fun poll(backend: *Backend, timeout_ms: i32) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    backend.ready_count = 0;
    val already_ready: bool = backend.queued_count != 0;
    mutex.unlock(?backend.lock);

    var native_timeout: i32 = timeout_ms;
    if (already_ready) { native_timeout = 0; }
    val count: i64 = darwin.io_queue_poll(backend.queue, backend.native, NATIVE_BATCH, native_timeout);
    mutex.lock(?backend.lock);
    var i: usize = 0;
    if (count > 0) {
        for (i < count::usize) {
            val native_completion: darwin.IoCompletion = backend.native[i];
            if (native_completion.context != 0 && (native_completion.events & darwin.IO_EVENT_WAKE) == 0) {
                var resource_token: types.Token;
                if (context_token(backend, native_completion.context, ?resource_token)) {
                    val resource: *Resource = resource_for(backend, resource_token);
                    if (resource != nil) {
                        resource.armed = false;
                        drive_resource(backend, resource, native_completion.events);
                    }
                }
            }
            i = i + 1;
        }
    }
    val ready: usize = publish_ready(backend);
    mutex.unlock(?backend.lock);
    if (ready == 0 && count < 0) { ret count; }
    ret ready::i64;
}

pub fun completion(backend: *Backend, index: usize, out: *types.NativeCompletion) i64 {
    if (backend == nil || out == nil || index >= backend.ready_count) { ret invalid(); }
    @out = @ready_at(backend, index);
    ret 0;
}

pub fun destroy(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    if (backend.live != 0 || backend.queued_count != 0) {
        mutex.unlock(?backend.lock);
        ret darwin.EBUSY;
    }
    # sockets idle at destruction still hold their resource and registration
    var slot: usize = 0;
    for (slot < backend.resource_slots) {
        val resource: *Resource = resource_at(backend, slot);
        if (resource.state == RESOURCE_ACTIVE) { resource_release(backend, resource); }
        slot = slot + 1;
    }
    # a registration left behind could name this source id after it is reused
    if (backend.registered != 0) { panic.panic("std.net.async: destroy left a native registration behind\n"); }
    val map_bytes:    usize = $size_of(u32) * backend.map_capacity;
    val native_bytes: usize = $size_of(darwin.IoCompletion) * NATIVE_BATCH;
    darwin.deallocate(backend.native::ptr, native_bytes);
    darwin.deallocate(backend.resource_map::ptr, map_bytes);
    table.destroy(?backend.ready);
    table.destroy(?backend.resources);
    table.destroy(?backend.operations);
    backend.native          = nil;
    backend.resource_map    = nil;
    backend.operation_slots = 0;
    backend.resource_slots  = 0;
    backend.map_capacity    = 0;
    backend.ready_count     = 0;
    backend.queued_head     = NONE;
    backend.queued_tail     = NONE;
    backend.queue           = nil;
    mutex.unlock(?backend.lock);
    ret 0;
}

fun stream_accept(listener: usize, peer: *ip.Endpoint, accepted: *usize) i64 {
    if (accepted == nil) { ret invalid(); }
    var address:        [128]u8;
    var address_length: u32 = darwin.SOCKADDR_STORAGE_SIZE::u32;
    val result:         i64 = darwin.sock_accept_flags(listener, ?address[0], ?address_length, true, true, accepted);
    if (result < 0) { ret result; }
    if (peer != nil && !ip.from_sockaddr(?address[0], peer)) {
        darwin.sock_close(@accepted);
        @accepted = (-1)::usize;
        ret darwin.ENOTSUP;
    }
    ret 0;
}

fun stream_connect(resource: usize, peer: ip.Endpoint) i64 {
    var address:        [128]u8;
    val address_length: usize = ip.to_sockaddr(peer, ?address[0]);
    ret darwin.sock_connect(resource, ?address[0], address_length);
}

fun stream_connect_status(resource: usize) i64 {
    ret darwin.sock_connect_status(resource);
}

fun stream_read(resource: usize, buffer: *u8, length: usize) i64 {
    if (buffer == nil && length != 0) { ret invalid(); }
    ret darwin.sock_recv(resource, buffer, length);
}

# 1 when a byte is readable, 0 at orderly end of stream
fun stream_readable(resource: usize) i64 {
    ret darwin.sock_peek_readable(resource);
}

fun stream_write(resource: usize, buffer: *u8, length: usize) i64 {
    if (buffer == nil && length != 0) { ret invalid(); }
    ret darwin.sock_send(resource, buffer, length);
}

fun stream_write_vector(resource: usize, vectors: *types.Vector, count: usize) i64 {
    if ($size_of(types.Vector) != $size_of(darwin.IoVector)) { ret darwin.EINVAL; }
    ret darwin.sock_write_vector(resource, (vectors::usize)::*darwin.IoVector, count);
}

fun stream_shutdown_write(resource: usize) i64 {
    ret darwin.sock_shutdown(resource, darwin.SHUT_WR);
}

fun socket_close(resource: usize) i64 {
    ret darwin.sock_close(resource);
}

fun configure_datagram(resource: usize, family: i32) i64 {
    var enabled: i32 = 1;
    if (family == darwin.AF_INET) {
        val destination: i64 = darwin.sock_setopt(resource, darwin.IPPROTO_IP, IP_RECVDSTADDR, (?enabled)::*u8, 4);
        if (destination < 0) { ret destination; }
        ret darwin.sock_setopt(resource, darwin.IPPROTO_IP, IP_RECVIF, (?enabled)::*u8, 4);
    }
    if (family == darwin.AF_INET6) {
        ret darwin.sock_setopt(resource, darwin.IPPROTO_IPV6, IPV6_RECVPKTINFO, (?enabled)::*u8, 4);
    }
    ret darwin.ENOTSUP;
}

fun configure_datagram_socket(resource: usize) i64 {
    var address: [128]u8;
    var length:  u32 = darwin.SOCKADDR_STORAGE_SIZE::u32;
    val status:  i64 = darwin.sock_local_addr(resource, ?address[0], ?length);
    if (status < 0) { ret status; }
    ret configure_datagram(resource, ip.sockaddr_family(?address[0]));
}

fun align_control(length: usize) usize {
    ret (length + 3) & ~3;
}

fun packet_metadata(packet: *types.Packet, control: *u8, length: usize) {
    packet.has_local_destination = false;
    packet.interface_index       = 0;
    var offset: usize = 0;
    for (offset + 12 <= length) {
        val base:                  usize = control::usize + offset;
        val native_message_length: u32   = @(base::*u32);
        val message_length:        usize = native_message_length::usize;
        if (message_length < 12 || message_length > length - offset) { ret; }
        val level: i32   = @((base + 4)::*i32);
        val kind:  i32   = @((base + 8)::*i32);
        val data:  usize = base + 12;
        if (level == darwin.IPPROTO_IP && kind == IP_RECVDSTADDR && message_length >= 16) {
            val address: ip.IPv4 = ip.ipv4(@(data::*u8), @((data + 1)::*u8), @((data + 2)::*u8), @((data + 3)::*u8));
            packet.local_destination     = ip.addr_v4(address);
            packet.has_local_destination = true;
        }
        or (level == darwin.IPPROTO_IP && kind == IP_RECVIF && message_length >= 16) {
            val native_interface_index: u16 = @((data + 2)::*u16);
            packet.interface_index = native_interface_index::u32;
        }
        or (level == darwin.IPPROTO_IPV6 && kind == IPV6_PKTINFO && message_length >= 32) {
            var address: ip.IPv6;
            var i:       usize = 0;
            for (i < 16) {
                address.octets[i] = @((data + i)::*u8);
                i                 = i + 1;
            }
            packet.interface_index       = @((data + 16)::*u32);
            packet.local_destination     = ip.addr_v6(address);
            packet.has_local_destination = true;
        }
        offset = offset + align_control(message_length);
    }
}

fun packet_send_metadata(packet: *types.Packet, control: *u8, length: *usize) i64 {
    @length = 0;
    if (!packet.has_local_destination && packet.interface_index == 0) { ret 0; }
    var i: usize = 0;
    for (i < 48) {
        control[i] = 0;
        i          = i + 1;
    }
    val base:   usize = control::usize;
    val family: i32   = ip.endpoint_family(packet.peer);
    if (family == darwin.AF_INET) {
        if (packet.interface_index != 0 || !packet.has_local_destination || packet.local_destination.is_v6 != 0) { ret darwin.ENOTSUP; }
        @(base::*u32) = 16;
        @((base + 4)::*i32) = darwin.IPPROTO_IP;
        @((base + 8)::*i32) = IP_SENDSRCADDR;
        for (i < 4) {
            @((base + 12 + i)::*u8) = packet.local_destination.v4.octets[i];
            i = i + 1;
        }
        @length = 16;
        ret 0;
    }
    if (family == darwin.AF_INET6) {
        if (packet.has_local_destination && packet.local_destination.is_v6 == 0) { ret invalid(); }
        @(base::*u32) = 32;
        @((base + 4)::*i32) = darwin.IPPROTO_IPV6;
        @((base + 8)::*i32) = IPV6_PKTINFO;
        if (packet.has_local_destination) {
            for (i < 16) {
                @((base + 12 + i)::*u8) = packet.local_destination.v6.octets[i];
                i = i + 1;
            }
        }
        @((base + 28)::*u32) = packet.interface_index;
        @length = 32;
        ret 0;
    }
    ret darwin.ENOTSUP;
}

fun datagram_receive_batch(resource: usize, packets: *types.Packet, count: usize) i64 {
    if (packets == nil || count == 0) { ret invalid(); }
    var received: usize = 0;
    for (received < count) {
        var vector:         darwin.IoVector = darwin.IoVector{data: packets[received].buffer, length: packets[received].capacity};
        var address:        [128]u8;
        var address_length: u32             = darwin.SOCKADDR_STORAGE_SIZE::u32;
        var control:        [128]u8;
        var control_length: usize           = 128;
        var flags:          i32             = 0;
        val result:         i64             = darwin.sock_receive_message(resource, ?vector, 1, ?address[0], ?address_length, ?control[0], ?control_length, ?flags);
        if (result < 0) {
            if (received != 0) { ret received::i64; }
            ret result;
        }
        if (!ip.from_sockaddr(?address[0], ?packets[received].peer)) {
            if (received != 0) { ret received::i64; }
            ret darwin.ENOTSUP;
        }
        packets[received].length      = result::usize;
        packets[received].truncated   = (flags & MSG_TRUNC) != 0;
        packets[received].zero_length = result == 0;
        packet_metadata(?packets[received], ?control[0], control_length);
        received = received + 1;
    }
    ret received::i64;
}

fun datagram_send_batch(resource: usize, packets: *types.Packet, count: usize) i64 {
    if (packets == nil || count == 0) { ret invalid(); }
    var sent: usize = 0;
    for (sent < count) {
        if (packets[sent].buffer == nil && packets[sent].length != 0) {
            if (sent != 0) { ret sent::i64; }
            ret invalid();
        }
        var vector:         darwin.IoVector = darwin.IoVector{data: packets[sent].buffer, length: packets[sent].length};
        var address:        [128]u8;
        val address_length: usize           = ip.to_sockaddr(packets[sent].peer, ?address[0]);
        var control:        [48]u8;
        var control_length: usize           = 0;
        val metadata:       i64             = packet_send_metadata(?packets[sent], ?control[0], ?control_length);
        if (metadata < 0) {
            if (sent != 0) { ret sent::i64; }
            ret metadata;
        }
        var control_pointer: *u8 = nil;
        if (control_length != 0) { control_pointer = ?control[0]; }
        val result: i64 = darwin.sock_send_message(resource, ?vector, 1, ?address[0], address_length::u32, control_pointer, control_length);
        if (result < 0) {
            if (sent != 0) { ret sent::i64; }
            ret result;
        }
        if (result::usize != packets[sent].length) {
            if (sent != 0) { ret sent::i64; }
            ret darwin.EIO;
        }
        sent = sent + 1;
    }
    ret sent::i64;
}

fun test_listener_flags(listener: *usize, endpoint: *ip.Endpoint, nonblocking: bool) i64 {
    @listener = (-1)::usize;
    val created: i64 = darwin.sock_create_flags(darwin.AF_INET, darwin.SOCK_STREAM, 0, nonblocking, true, listener);
    if (created < 0) { ret created; }
    var address: [128]u8;
    ip.to_sockaddr(ip.endpoint(127, 0, 0, 1, 0), ?address[0]);
    var status: i64 = darwin.sock_bind(@listener, ?address[0], darwin.SOCKADDR_IN_SIZE);
    if (status >= 0) { status = darwin.sock_listen(@listener, 8); }
    var length: u32 = darwin.SOCKADDR_STORAGE_SIZE::u32;
    if (status >= 0)                                             { status = darwin.sock_local_addr(@listener, ?address[0], ?length); }
    if (status >= 0 && !ip.from_sockaddr(?address[0], endpoint)) { status = darwin.ENOTSUP; }
    if (status < 0) {
        darwin.sock_close(@listener);
        @listener = (-1)::usize;
    }
    ret status;
}

fun test_listener(listener: *usize, endpoint: *ip.Endpoint) i64 {
    ret test_listener_flags(listener, endpoint, false);
}

fun test_async_listener(listener: *usize, endpoint: *ip.Endpoint) i64 {
    ret test_listener_flags(listener, endpoint, true);
}

fun test_client(endpoint: ip.Endpoint, client: *usize) i64 {
    @client = (-1)::usize;
    val created: i64 = darwin.sock_create_flags(darwin.AF_INET, darwin.SOCK_STREAM, 0, false, true, client);
    if (created < 0) { ret created; }
    val status: i64 = stream_connect(@client, endpoint);
    if (status < 0) {
        darwin.sock_close(@client);
        @client = (-1)::usize;
    }
    ret status;
}

fun test_send_exact(socket: usize, buffer: *u8, length: usize) i64 {
    var sent: usize = 0;
    for (sent < length) {
        val result: i64 = darwin.sock_send(socket, (buffer::usize + sent)::*u8, length - sent);
        if (result < 0)  { ret result; }
        if (result == 0) { ret darwin.EIO; }
        sent = sent + result::usize;
    }
    ret sent::i64;
}

fun test_receive_exact(socket: usize, buffer: *u8, length: usize) i64 {
    var received: usize = 0;
    for (received < length) {
        val result: i64 = darwin.sock_recv(socket, (buffer::usize + received)::*u8, length - received);
        if (result < 0)  { ret result; }
        if (result == 0) { ret received::i64; }
        received = received + result::usize;
    }
    ret received::i64;
}

fun test_await_completion(backend: *Backend, context: usize, out: *types.NativeCompletion) i64 {
    var attempts: usize = 0;
    for (attempts < 6) {
        val count: i64 = poll(backend, 1000);
        if (count < 0) { ret count; }
        var i: usize = 0;
        for (i < count::usize) {
            var native: types.NativeCompletion;
            val read:   i64 = completion(backend, i, ?native);
            if (read < 0) { ret read; }
            if (native.context == context) {
                @out = native;
                ret 0;
            }
            i = i + 1;
        }
        attempts = attempts + 1;
    }
    ret darwin.ETIMEDOUT;
}

fun test_collect_completions(backend: *Backend, output: *types.NativeCompletion, wanted: usize) i64 {
    if (backend == nil || output == nil || wanted == 0) { ret darwin.EINVAL; }
    var total:    usize = 0;
    var attempts: usize = 0;
    for (total < wanted && attempts < 8) {
        val count: i64 = poll(backend, 1000);
        if (count < 0) { ret count; }
        var i: usize = 0;
        for (i < count::usize && total < wanted) {
            val read: i64 = completion(backend, i, ?output[total]);
            if (read < 0) { ret read; }
            total = total + 1;
            i     = i + 1;
        }
        attempts = attempts + 1;
    }
    if (total != wanted) { ret darwin.ETIMEDOUT; }
    ret total::i64;
}

fun test_datagram(socket: *usize, endpoint: *ip.Endpoint) i64 {
    @socket = (-1)::usize;
    val created: i64 = darwin.sock_create_flags(darwin.AF_INET, darwin.SOCK_DGRAM, 0, true, true, socket);
    if (created < 0) { ret created; }
    var address: [128]u8;
    ip.to_sockaddr(ip.endpoint(127, 0, 0, 1, 0), ?address[0]);
    var status: i64 = darwin.sock_bind(@socket, ?address[0], darwin.SOCKADDR_IN_SIZE);
    var length: u32 = darwin.SOCKADDR_STORAGE_SIZE::u32;
    if (status >= 0)                                             { status = darwin.sock_local_addr(@socket, ?address[0], ?length); }
    if (status >= 0 && !ip.from_sockaddr(?address[0], endpoint)) { status = darwin.ENOTSUP; }
    if (status < 0) {
        darwin.sock_close(@socket);
        @socket = (-1)::usize;
    }
    ret status;
}

test "async darwin: UDP batch preserves boundaries and metadata" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var receiver:          usize;
    var receiver_endpoint: ip.Endpoint;
    var sender:            usize;
    var sender_endpoint:   ip.Endpoint;
    if (test_datagram(?receiver, ?receiver_endpoint) < 0 || test_datagram(?sender, ?sender_endpoint) < 0) {
        if (receiver != (-1)::usize) { darwin.sock_close(receiver); }
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }

    var first_out: [3]u8;
    first_out[0] = 'o';
    first_out[1] = 'n';
    first_out[2] = 'e';
    var third_out: [8]u8;
    var i:         usize = 0;
    for (i < 8) {
        third_out[i] = (i + 1)::u8;
        i            = i + 1;
    }
    var outgoing: [3]types.Packet;
    outgoing[0].buffer = ?first_out[0];
    outgoing[0].length = 3;
    outgoing[1].buffer = nil;
    outgoing[1].length = 0;
    outgoing[2].buffer = ?third_out[0];
    outgoing[2].length = 8;
    i                  = 0;
    for (i < 3) {
        outgoing[i].capacity              = outgoing[i].length;
        outgoing[i].peer                  = receiver_endpoint;
        outgoing[i].local_destination     = ip.addr_v4(ip.ipv4_loopback());
        outgoing[i].has_local_destination = true;
        outgoing[i].interface_index       = 0;
        outgoing[i].truncated             = false;
        outgoing[i].zero_length           = outgoing[i].length == 0;
        i                                 = i + 1;
    }

    var first_in: [3]u8;
    var zero_in:  u8 = 0;
    var third_in: [4]u8;
    var incoming: [3]types.Packet;
    incoming[0].buffer   = ?first_in[0];
    incoming[0].capacity = 3;
    incoming[1].buffer   = ?zero_in;
    incoming[1].capacity = 1;
    incoming[2].buffer   = ?third_in[0];
    incoming[2].capacity = 4;
    i                    = 0;
    for (i < 3) {
        incoming[i].length                = 0;
        incoming[i].has_local_destination = false;
        incoming[i].interface_index       = 0;
        incoming[i].truncated             = false;
        incoming[i].zero_length           = false;
        i                                 = i + 1;
    }

    var receive_token:     types.Token;
    var send_token:        types.Token;
    var receive_submitted: i64   = submit_receive_batch(?backend, receiver, 1, ?incoming[0], 3, 81, ?receive_token);
    var send_submitted:    i64   = submit_send_batch(?backend, sender, 1, ?outgoing[0], 3, 82, ?send_token);
    var receive_items:     usize = 0;
    var receive_bytes:     usize = 0;
    var send_items:        usize = 0;
    var send_bytes:        usize = 0;
    var failed:            bool  = receive_submitted < 0 || send_submitted < 0;
    var attempts:          usize = 0;
    for (attempts < 12 && !failed && (receive_items < 3 || send_items < 3)) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { failed = true; }
        or {
            i = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 81) {
                    if (native.kind != runtime.RECEIVE_FROM || native.status != 0 || native.items == 0 || native.items > 3 - receive_items) { failed = true; }
                    or {
                        receive_items = receive_items + native.items;
                        receive_bytes = receive_bytes + native.bytes;
                        if (receive_items < 3) {
                            receive_submitted = submit_receive_batch(?backend, receiver, 1, ?incoming[receive_items], 3 - receive_items, 81, ?receive_token);
                            if (receive_submitted < 0) { failed = true; }
                        }
                    }
                }
                if (native.context == 82) {
                    if (native.kind != runtime.SEND_TO || native.status != 0 || native.items == 0 || native.items > 3 - send_items) { failed = true; }
                    or {
                        send_items = send_items + native.items;
                        send_bytes = send_bytes + native.bytes;
                        if (send_items < 3) {
                            send_submitted = submit_send_batch(?backend, sender, 1, ?outgoing[send_items], 3 - send_items, 82, ?send_token);
                            if (send_submitted < 0) { failed = true; }
                        }
                    }
                }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val peer_valid:       bool = incoming[0].peer.port == sender_endpoint.port && incoming[1].peer.port == sender_endpoint.port && incoming[2].peer.port == sender_endpoint.port;
    val metadata_valid:   bool = incoming[0].has_local_destination && incoming[0].local_destination.is_v6 == 0 && incoming[0].local_destination.v4.octets[0] == 127 && incoming[0].local_destination.v4.octets[3] == 1 && incoming[0].interface_index != 0;
    val boundaries_valid: bool = incoming[0].length == 3 && !incoming[0].zero_length && !incoming[0].truncated && first_in[0] == 'o' && first_in[2] == 'e' && incoming[1].length == 0 && incoming[1].zero_length && !incoming[1].truncated && incoming[2].length == 4 && !incoming[2].zero_length && incoming[2].truncated && third_in[0] == 1 && third_in[3] == 4;
    val valid:            bool = !failed && receive_items == 3 && receive_bytes == 7 && send_items == 3 && send_bytes == 11 && peer_valid && metadata_valid && boundaries_valid && backend.live == 0 && backend.resource_count == 2;
    darwin.sock_close(sender);
    darwin.sock_close(receiver);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async darwin: vectored writes and fragmented reads report progress" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        darwin.sock_close(client);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }

    var prefix: [2]u8;
    prefix[0] = 'h';
    prefix[1] = 'i';
    var suffix: [3]u8;
    suffix[0] = '!';
    suffix[1] = '!';
    suffix[2] = '!';
    var vectors: [3]types.Vector;
    vectors[0] = types.Vector{data: ?prefix[0], length: 2};
    vectors[1] = types.Vector{data: nil, length: 0};
    vectors[2] = types.Vector{data: ?suffix[0], length: 3};
    var vector_token:      types.Token;
    val vector_submitted:  i64 = submit_write_vector(?backend, server, 1, ?vectors[0], 3, 83, ?vector_token);
    var vector_completion: types.NativeCompletion;
    val vector_completed:  i64 = test_await_completion(?backend, 83, ?vector_completion);
    var vector_input:      [5]u8;
    val vector_bytes:      i64 = test_receive_exact(client, ?vector_input[0], 5);

    var assembled:            [4]u8;
    var first_read_token:     types.Token;
    val first_read_submitted: i64 = submit_read(?backend, server, 1, ?assembled[0], 4, 84, ?first_read_token);
    var first_fragment:       [2]u8;
    first_fragment[0] = 'a';
    first_fragment[1] = 'b';
    val first_sent:       i64 = test_send_exact(client, ?first_fragment[0], 2);
    var first_completion: types.NativeCompletion;
    val first_completed:  i64 = test_await_completion(?backend, 84, ?first_completion);

    var second_read_token:     types.Token;
    val second_read_submitted: i64 = submit_read(?backend, server, 1, ?assembled[2], 2, 85, ?second_read_token);
    var second_fragment:       [2]u8;
    second_fragment[0] = 'c';
    second_fragment[1] = 'd';
    val second_sent:       i64 = test_send_exact(client, ?second_fragment[0], 2);
    var second_completion: types.NativeCompletion;
    val second_completed:  i64 = test_await_completion(?backend, 85, ?second_completion);

    val vector_valid:    bool = vector_submitted == 0 && vector_completed == 0 && vector_bytes == 5 && vector_completion.context == 83 && vector_completion.kind == runtime.WRITE && vector_completion.status == 0 && vector_completion.bytes == 5 && vector_completion.items == 0 && vector_input[0] == 'h' && vector_input[1] == 'i' && vector_input[2] == '!' && vector_input[4] == '!';
    val fragments_valid: bool = first_read_submitted == 0 && first_sent == 2 && first_completed == 0 && first_completion.context == 84 && first_completion.status == 0 && first_completion.bytes == 2 && first_completion.items == 0 && !first_completion.end_of_stream && second_read_submitted == 0 && second_sent == 2 && second_completed == 0 && second_completion.context == 85 && second_completion.status == 0 && second_completion.bytes == 2 && second_completion.items == 0 && assembled[0] == 'a' && assembled[1] == 'b' && assembled[2] == 'c' && assembled[3] == 'd';
    val valid:           bool = vector_valid && fragments_valid && backend.live == 0 && backend.resource_count == 1;
    darwin.sock_close(server);
    darwin.sock_close(client);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async darwin: remote half-close reports EOF and preserves writes" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 4, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        darwin.sock_close(client);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }

    var input:           u8  = 0;
    var read_token:      types.Token;
    val read_submitted:  i64 = submit_read(?backend, server, 1, ?input, 1, 86, ?read_token);
    val half_closed:     i64 = darwin.sock_shutdown(client, darwin.SHUT_WR);
    var read_completion: types.NativeCompletion;
    val read_completed:  i64 = test_await_completion(?backend, 86, ?read_completion);

    var output: [2]u8;
    output[0] = 'o';
    output[1] = 'k';
    var write_token:      types.Token;
    val write_submitted:  i64 = submit_write(?backend, server, 1, ?output[0], 2, 87, ?write_token);
    var write_completion: types.NativeCompletion;
    val write_completed:  i64 = test_await_completion(?backend, 87, ?write_completion);
    var response:         [2]u8;
    val response_bytes:   i64 = test_receive_exact(client, ?response[0], 2);

    var failure: i32 = 0;
    if (read_submitted != 0)                                        { failure = 2; }
    or (half_closed != 0)                                           { failure = 3; }
    or (read_completed != 0)                                        { failure = 4; }
    or (read_completion.context != 86)                              { failure = 5; }
    or (read_completion.kind != runtime.READ)                       { failure = 6; }
    or (read_completion.status != 0)                                { failure = 7; }
    or (read_completion.bytes != 0 || read_completion.items != 0)   { failure = 8; }
    or (!read_completion.end_of_stream)                             { failure = 9; }
    or (write_submitted != 0)                                       { failure = 10; }
    or (write_completed != 0)                                       { failure = 11; }
    or (response_bytes != 2)                                        { failure = 12; }
    or (response[0] != 'o' || response[1] != 'k')                   { failure = 13; }
    or (write_completion.context != 87)                             { failure = 14; }
    or (write_completion.status != 0)                               { failure = 15; }
    or (write_completion.bytes != 2 || write_completion.items != 0) { failure = 16; }
    or (backend.live != 0)                                          { failure = 17; }
    or (backend.resource_count != 1)                                { failure = 18; }
    darwin.sock_close(server);
    darwin.sock_close(client);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (failure == 0 && destroyed < 0) { failure = 19; }
    if (failure != 0)                  { ret failure; }
    ret 0;
}

test "async darwin: reset completes a pending read once" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 4, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        darwin.sock_close(client);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }

    var input:     u8  = 0;
    var token:     types.Token;
    val submitted: i64 = submit_read(?backend, server, 1, ?input, 1, 88, ?token);
    var linger:    [2]i32;
    linger[0] = 1;
    linger[1] = 0;
    val configured:       i64   = darwin.sock_setopt(client, darwin.SOL_SOCKET, darwin.SO_LINGER, (?linger[0])::*u8, 8);
    val closed:           i64   = darwin.sock_close(client);
    var saw_reset:        bool  = false;
    var completion_count: usize = 0;
    var attempts:         usize = 0;
    for (attempts < 6 && !saw_reset) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 6; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 88) {
                    completion_count = completion_count + 1;
                    if (native.kind == runtime.READ && native.status == darwin.ECONNRESET && native.bytes == 0 && native.items == 0 && !native.end_of_stream) { saw_reset = true; }
                }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val after: i64  = poll(?backend, 0);
    val valid: bool = submitted == 0 && configured == 0 && closed == 0 && saw_reset && completion_count == 1 && after == 0 && backend.live == 0 && backend.resource_count == 1;
    darwin.sock_close(server);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

# the old encoding packed the index into 16 bits and make refused past 65535
test "async darwin: a resource index past the old bound survives the wire" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 1, 7) < 0) {
        darwin.io_queue_close(?queue);
        ret 2;
    }
    var appended: usize = 0;
    for (appended < 70000) {
        if (!resource_append(?backend)) {
            destroy(?backend);
            darwin.io_queue_close(?queue);
            ret 3;
        }
        appended = appended + 1;
    }
    val first:   *Resource   = resource_at(?backend, 0);
    val high:    types.Token = types.Token{index: 69999, generation: 0xffff};
    var round:   types.Token;
    val encoded: usize       = token_context(?backend, high);
    val decoded: bool        = context_token(?backend, encoded, ?round);
    val foreign: usize       = ((encoded::u64) ^ (1::u64 << 48))::usize;
    var ignored: types.Token;
    val zero:    usize       = token_context(?backend, types.Token{index: 69999, generation: 0});
    val valid:   bool        = backend.resource_slots == 70000 &&
        decoded && round.index == 69999 && round.generation == 0xffff &&
        !context_token(?backend, foreign, ?ignored) &&
        !context_token(?backend, zero, ?ignored) &&
        next_wire_generation(0xffff) == 1 &&
        next_wire_generation(1) == 2 &&
        resource_at(?backend, 0) == first &&
        resource_at(?backend, 69999).index == 69999;
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 4; }
    ret 0;
}

test "async darwin: storage grows past the initial size and recycles" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 2, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        darwin.sock_close(client);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }

    var storage: [3]u8;
    storage[0] = 0xa1;
    storage[1] = 0xb2;
    storage[2] = 0xc3;
    var tokens:    [3]types.Token;
    val first:     i64 = submit_read(?backend, server, 1, ?storage[0], 1, 89, ?tokens[0]);
    val second:    i64 = submit_read(?backend, server, 1, ?storage[1], 1, 90, ?tokens[1]);
    val timed_out: i64 = poll(?backend, 5);
    # the third operation is past the initial size and grows the table
    val grown:              i64        = submit_read(?backend, server, 1, ?storage[2], 1, 91, ?tokens[2]);
    val grew:               bool       = backend.operations.capacity == 4 && tokens[2].index == 2;
    val held:               *Operation = operation_at(?backend, tokens[0].index::usize);
    val cancel_first:       i64        = cancel(?backend, tokens[0]);
    var reused:             types.Token;
    val replacement:        i64        = submit_read(?backend, server, 1, ?storage[2], 1, 92, ?reused);
    val generation_changed: bool       = reused.index == tokens[0].index && reused.generation != tokens[0].generation;
    val stable:             bool       = operation_at(?backend, tokens[0].index::usize) == held;
    val cancel_second:      i64        = cancel(?backend, tokens[1]);
    val cancel_third:       i64        = cancel(?backend, tokens[2]);
    val cancel_replacement: i64        = cancel(?backend, reused);
    var byte:               u8         = 'x';
    val sent:               i64        = test_send_exact(client, ?byte, 1);
    val after:              i64        = poll(?backend, 0);
    val valid:              bool       = first == 0 && second == 0 && timed_out == 0 && grown == 0 && grew && stable && cancel_first == 0 && replacement == 0 && generation_changed && cancel_second == 0 && cancel_third == 0 && cancel_replacement == 0 && sent == 1 && after == 0 && storage[0] == 0xa1 && storage[1] == 0xb2 && storage[2] == 0xc3 && backend.live == 0 && backend.resource_count == 1;
    darwin.sock_close(server);
    darwin.sock_close(client);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async darwin: wake-only poll preserves an armed read" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 4, 1) < 0) {
        darwin.io_queue_close(?queue);
