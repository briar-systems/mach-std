    darwin.sock_close(client);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async darwin: one stream drives concurrent read and write" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        darwin.sock_close(client);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }

    var input:  [4]u8;
    var output: [4]u8;
    output[0] = 'p';
    output[1] = 'o';
    output[2] = 'n';
    output[3] = 'g';
    var read_token:      types.Token;
    var write_token:     types.Token;
    val read_submitted:  i64 = submit_read(?backend, server, 1, ?input[0], 4, 51, ?read_token);
    val write_submitted: i64 = submit_write(?backend, server, 1, ?output[0], 4, 52, ?write_token);
    var response:        [4]u8;
    val response_bytes:  i64 = test_receive_exact(client, ?response[0], 4);
    var request:         [4]u8;
    request[0] = 'p';
    request[1] = 'i';
    request[2] = 'n';
    request[3] = 'g';
    val request_bytes: i64   = test_send_exact(client, ?request[0], 4);
    var saw_read:      bool  = false;
    var saw_write:     bool  = false;
    var attempts:      usize = 0;
    for (attempts < 6 && (!saw_read || !saw_write)) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 6; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 51 && native.status == 0 && native.bytes == 4) { saw_read = true; }
                if (native.context == 52 && native.status == 0 && native.bytes == 4) { saw_write = true; }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    var failure: i32 = 0;
    if (read_submitted != 0)                      { failure = 2; }
    or (write_submitted != 0)                     { failure = 3; }
    or (response_bytes != 4)                      { failure = 4; }
    or (request_bytes != 4)                       { failure = 5; }
    or (!saw_read)                                { failure = 6; }
    or (!saw_write)                               { failure = 7; }
    or (input[0] != 'p' || input[3] != 'g')       { failure = 8; }
    or (response[0] != 'p' || response[3] != 'g') { failure = 9; }
    or (backend.resource_count != 1)              { failure = 10; }
    darwin.sock_close(server);
    darwin.sock_close(client);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (failure == 0 && destroyed < 0) { failure = 11; }
    if (failure != 0)                  { ret failure; }
    ret 0;
}

test "async darwin: listener owns multiple bounded accepts" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_async_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var peers:        [2]ip.Endpoint;
    var tokens:       [2]types.Token;
    val first:        i64  = submit_accept(?backend, listener, 1, ?peers[0], 61, ?tokens[0]);
    val second:       i64  = submit_accept(?backend, listener, 1, ?peers[1], 62, ?tokens[1]);
    val one_resource: bool = backend.resource_count == 1;
    var clients:      [2]usize;
    if (test_client(endpoint, ?clients[0]) < 0 || test_client(endpoint, ?clients[1]) < 0) {
        cancel(?backend, tokens[0]);
        cancel(?backend, tokens[1]);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var accepted: [2]usize;
    accepted[0] = (-1)::usize;
    accepted[1] = (-1)::usize;
    var completions: usize = 0;
    var attempts:    usize = 0;
    for (attempts < 6 && completions < 2) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 6; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 61) {
                    accepted[0] = native.resource;
                    completions = completions + 1;
                }
                if (native.context == 62) {
                    accepted[1] = native.resource;
                    completions = completions + 1;
                }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val valid: bool = first == 0 && second == 0 && one_resource && completions == 2 && accepted[0] != (-1)::usize && accepted[1] != (-1)::usize && accepted[0] != accepted[1] && backend.resource_count == 1;
    if (accepted[0] != (-1)::usize) { darwin.sock_close(accepted[0]); }
    if (accepted[1] != (-1)::usize) { darwin.sock_close(accepted[1]); }
    darwin.sock_close(clients[0]);
    darwin.sock_close(clients[1]);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

# slots that hold something other than a live resource: tombstones, which
# lengthen every later lookup
fun test_map_stale(backend: *Backend) usize {
    var stale: usize = 0;
    var slot:  usize = 0;
    for (slot < backend.map_capacity) {
        val entry: u32 = backend.resource_map[slot];
        if (entry != 0) {
            val index: usize = (entry - 1)::usize;
            if (index >= backend.resource_slots || resource_at(backend, index).state != RESOURCE_ACTIVE) { stale = stale + 1; }
        }
        slot = slot + 1;
    }
    ret stale;
}

# the probes a lookup of value makes before it finds value or an empty slot
fun test_map_probes(backend: *Backend, value: usize) usize {
    var slot:   usize = resource_hash(value) & (backend.map_capacity - 1);
    var probes: usize = 1;
    for (probes <= backend.map_capacity) {
        val entry: u32 = backend.resource_map[slot];
        if (entry == 0) { ret probes; }
        val index: usize = (entry - 1)::usize;
        if (index < backend.resource_slots) {
            val candidate: *Resource = resource_at(backend, index);
            if (candidate.state == RESOURCE_ACTIVE && candidate.resource == value) { ret probes; }
        }
        slot   = (slot + 1) & (backend.map_capacity - 1);
        probes = probes + 1;
    }
    ret probes;
}

# n resources registered and released for several rounds, then n live ones:
# reports leftover stale slots and the longest hit and miss probe
fun test_map_churn(n: usize, stale: *usize, max_hit: *usize, max_miss: *usize) i64 {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, n, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 2;
    }
    var base:  usize = 0x100000;
    var round: usize = 0;
    for (round < 4) {
        var j: usize = 0;
        for (j < n) {
            var created: bool = false;
            if (resource_acquire(?backend, base + j, 1, ?created) == nil) { ret 3; }
            j = j + 1;
        }
        if (round < 3) {
            j = 0;
            for (j < n) {
                val resource: *Resource = resource_lookup(?backend, base + j);
                if (resource == nil) { ret 4; }
                resource_release_unwatched(?backend, resource);
                j = j + 1;
            }
            base = base + n;
        }
        round = round + 1;
    }
    @stale    = test_map_stale(?backend);
    @max_hit  = 0;
    @max_miss = 0;
    var j: usize = 0;
    for (j < n) {
        val hit:  usize = test_map_probes(?backend, base + j);
        val miss: usize = test_map_probes(?backend, base + n + j);
        if (hit > @max_hit)   { @max_hit = hit; }
        if (miss > @max_miss) { @max_miss = miss; }
        j = j + 1;
    }
    j = 0;
    for (j < n) {
        val resource: *Resource = resource_lookup(?backend, base + j);
        if (resource == nil) { ret 5; }
        resource_release_unwatched(?backend, resource);
        j = j + 1;
    }
    if (destroy(?backend) < 0) { ret 6; }
    darwin.io_queue_close(?queue);
    ret 0;
}

# lookups stay short however much a server churns its sockets (#737)
test "async darwin: resource lookups stay bounded after churn at 1k, 10k and 100k" {
    var sizes: [3]usize = [3]usize{1000, 10000, 100000};
    var i:     usize    = 0;
    for (i < 3) {
        var stale:    usize = 0;
        var max_hit:  usize = 0;
        var max_miss: usize = 0;
        val churned:  i64   = test_map_churn(sizes[i], ?stale, ?max_hit, ?max_miss);
        if (churned != 0)                  { ret 10 + churned::i32; }
        if (stale != 0)                    { ret 20 + i::i32; }
        if (max_hit > 32 || max_miss > 32) { ret 30 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

# the blocked operations a socket carries one after another register it once:
# only the first finds its address and adds it, every later one rearms (#737)
test "async darwin: a socket stays registered across blocked operations" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 2;
    }
    var receiver:          usize;
    var receiver_endpoint: ip.Endpoint;
    var sender:            usize;
    var sender_endpoint:   ip.Endpoint;
    if (test_datagram(?receiver, ?receiver_endpoint) < 0 || test_datagram(?sender, ?sender_endpoint) < 0) { ret 3; }
    var inbound:  [8]u8;
    var outbound: [1]u8;
    outbound[0] = 'x';
    var incoming: types.Packet;
    var outgoing: types.Packet;
    outgoing.buffer   = ?outbound[0];
    outgoing.length   = 1;
    outgoing.capacity = 1;
    outgoing.peer     = receiver_endpoint;
    val rounds: usize = 32;
    var round:  usize = 0;
    for (round < rounds) {
        incoming.buffer   = ?inbound[0];
        incoming.capacity = 8;
        incoming.length   = 0;
        var token: types.Token;
        if (submit_receive_batch(?backend, receiver, 1, ?incoming, 1, 100 + round, ?token) < 0) { ret 4; }
        if (datagram_send_batch(sender, ?outgoing, 1) != 1)                                     { ret 5; }
        var done:     bool  = false;
        var attempts: usize = 0;
        for (!done && attempts < 8) {
            val count: i64 = poll(?backend, 1000);
            if (count < 0) { ret 6; }
            var i: usize = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                if (completion(?backend, i, ?native) < 0) { ret 7; }
                if (native.context == 100 + round) {
                    if (native.status != 0 || native.items != 1) { ret 8; }
                    done = true;
                }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
        if (!done) { ret 9; }
        round = round + 1;
    }
    if (backend.watches != 1)         { ret 10; }
    if (backend.unwatches != 0)       { ret 11; }
    if (backend.locates != 2)         { ret 12; }
    if (backend.rearms != rounds - 1) { ret 13; }
    var close_token: types.Token;
    if (submit_close(?backend, receiver, 1, 200, ?close_token) < 0) { ret 14; }
    var closed: bool  = false;
    var tries:  usize = 0;
    for (!closed && tries < 8) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 15; }
        var i: usize = 0;
        for (i < count::usize) {
            var native: types.NativeCompletion;
            if (completion(?backend, i, ?native) < 0) { ret 16; }
            if (native.context == 200)                { closed = true; }
            i = i + 1;
        }
        tries = tries + 1;
    }
    if (!closed)                { ret 17; }
    if (backend.unwatches != 1) { ret 18; }
    darwin.sock_close(sender);
    if (destroy(?backend) < 0) { ret 19; }
    darwin.io_queue_close(?queue);
    ret 0;
}

# destroy gives up every registration it holds, so no event can name its source
# id once the runtime reuses it (#740)
test "async darwin: destroy removes every registration it holds" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    fin { darwin.io_queue_close(?queue); }
    var pipe: [2]i32;
    if (darwin.pipe(?pipe[0]) < 0) { ret 2; }
    fin {
        darwin.close(pipe[0]);
        darwin.close(pipe[1]);
    }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) { ret 3; }
    var created:  bool      = false;
    val resource: *Resource = resource_acquire(?backend, pipe[0]::usize, 0, ?created);
    if (resource == nil) { ret 4; }
    val context: usize = token_context(?backend, types.Token{index: resource.index, generation: resource.generation});
    if (darwin.io_queue_watch(?queue, pipe[0]::usize, context, darwin.IO_EVENT_READ) < 0) { ret 5; }
    set_watched(?backend, resource, true);
    if (backend.registered != 1)                          { ret 6; }
    if (destroy(?backend) < 0 || backend.registered != 0) { ret 7; }
    var byte: u8 = 1;
    if (darwin.write(pipe[1], ?byte, 1) != 1) { ret 8; }
    var events: [4]darwin.IoCompletion;
    if (darwin.io_queue_poll(?queue, ?events[0], 4, 0) != 0) { ret 9; }
    ret 0;
}
