        darwin.sock_close(client);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }

    var input:     u8  = 0;
    var token:     types.Token;
    val submitted: i64 = submit_read(?backend, server, 1, ?input, 1, 96, ?token);
    val wake_only: i64 = poll(?backend, 0);
    var output:    u8  = 'w';
    val sent:      i64 = test_send_exact(client, ?output, 1);
    var native:    types.NativeCompletion;
    val completed: i64 = test_await_completion(?backend, 96, ?native);
    var failure:   i32 = 0;
    if (submitted != 0)              { failure = 2; }
    or (wake_only != 0)              { failure = 3; }
    or (sent != 1)                   { failure = 4; }
    or (completed != 0)              { failure = 5; }
    or (native.kind != runtime.READ) { failure = 6; }
    or (native.status != 0)          { failure = 7; }
    or (native.bytes != 1)           { failure = 8; }
    or (native.items != 0)           { failure = 9; }
    or (native.end_of_stream)        { failure = 10; }
    or (input != 'w')                { failure = 11; }
    or (backend.live != 0)           { failure = 12; }
    or (backend.resource_count != 1) { failure = 13; }
    darwin.sock_close(server);
    darwin.sock_close(client);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (failure == 0 && destroyed < 0) { failure = 14; }
    if (failure != 0)                  { ret failure; }
    ret 0;
}

test "async darwin: canceling close preserves handle ownership" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        darwin.sock_close(client);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }

    var pending_byte:    u8   = 'z';
    var write_token:     types.Token;
    var write_submitted: i64  = darwin.EIO;
    var close_token:     types.Token;
    var close_submitted: i64  = darwin.EIO;
    var close_active:    bool = false;
    mutex.lock(?backend.lock);
    var write_resource:  *Resource;
    var write_operation: *Operation;
    write_submitted = begin(?backend, server, 1, runtime.WRITE, 93, LANE_WRITE, ?write_token, ?write_resource, ?write_operation);
    if (write_submitted == 0) {
        write_operation.buffer = ?pending_byte;
        write_operation.length = 1;
        var close_resource: *Resource;
        close_submitted = begin_close_locked(?backend, server, 1, 94, ?close_token, ?close_resource);
        close_active    = close_submitted == 0 && operation_for(?backend, close_token) != nil;
    }
    mutex.unlock(?backend.lock);
    val canceled:  i64 = cancel(?backend, close_token);
    val raw_close: i64 = darwin.sock_close(server);
    var displaced: types.NativeCompletion;
    val count:     i64 = test_collect_completions(?backend, ?displaced, 1);
    var failure:   i32 = 0;
    if (write_submitted != 0)                 { failure = 2; }
    or (close_submitted != 0)                 { failure = 3; }
    or (!close_active)                        { failure = 4; }
    or (canceled != 0)                        { failure = 5; }
    or (raw_close != darwin.EBADF)            { failure = 6; }
    or (count != 1)                           { failure = 7; }
    or (displaced.context != 93)              { failure = 8; }
    or (displaced.kind != runtime.WRITE)      { failure = 9; }
    or (displaced.status != darwin.ECANCELED) { failure = 10; }
    or (displaced.bytes != 0)                 { failure = 11; }
    or (displaced.items != 0)                 { failure = 12; }
    or (backend.live != 0)                    { failure = 13; }
    or (backend.resource_count != 0)          { failure = 14; }
    darwin.sock_close(client);

    var second_client: usize;
    if (test_client(endpoint, ?second_client) < 0) {
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var second_server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?second_server) < 0) {
        darwin.sock_close(second_client);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var queued_token:     types.Token;
    val queued_submitted: i64  = submit_close(?backend, second_server, 1, 95, ?queued_token);
    val close_queued:     bool = backend.queued_count == 1;
    val queued_canceled:  i64  = cancel(?backend, queued_token);
    val second_raw_close: i64  = darwin.sock_close(second_server);
    val after:            i64  = poll(?backend, 0);
    if (failure == 0 && queued_submitted != 0)            { failure = 15; }
    or (failure == 0 && !close_queued)                    { failure = 16; }
    or (failure == 0 && queued_canceled != 0)             { failure = 17; }
    or (failure == 0 && second_raw_close != darwin.EBADF) { failure = 18; }
    or (failure == 0 && after != 0)                       { failure = 19; }
    or (failure == 0 && backend.live != 0)                { failure = 20; }
    or (failure == 0 && backend.resource_count != 0)      { failure = 21; }
    darwin.sock_close(second_client);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (failure == 0 && destroyed < 0) { failure = 22; }
    if (failure != 0)                  { ret failure; }
    ret 0;
}

test "async darwin: queued cancellation preserves FIFO" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 4, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var socket: usize = (-1)::usize;
    if (darwin.sock_create_flags(darwin.AF_INET, darwin.SOCK_DGRAM, 0, true, true, ?socket) < 0) {
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    val destination: ip.Endpoint = ip.endpoint(127, 0, 0, 1, 9);
    var packets:     [3]types.Packet;
    var i:           usize       = 0;
    for (i < 3) {
        packets[i].buffer                = nil;
        packets[i].capacity              = 0;
        packets[i].length                = 0;
        packets[i].peer                  = destination;
        packets[i].has_local_destination = false;
        packets[i].interface_index       = 0;
        i                                = i + 1;
    }
    var tokens:      [3]types.Token;
    val first:       i64 = submit_send_batch(?backend, socket, 1, ?packets[0], 1, 11, ?tokens[0]);
    val second:      i64 = submit_send_batch(?backend, socket, 1, ?packets[1], 1, 22, ?tokens[1]);
    val third:       i64 = submit_send_batch(?backend, socket, 1, ?packets[2], 1, 33, ?tokens[2]);
    val cancelled:   i64 = cancel(?backend, tokens[1]);
    var completions: [2]types.NativeCompletion;
    val count:       i64 = test_collect_completions(?backend, ?completions[0], 2);
    var a:           types.NativeCompletion;
    var b:           types.NativeCompletion;
    if (count == 2) {
        a = completions[0];
        b = completions[1];
    }
    val valid: bool = first == 0 && second == 0 && third == 0 && cancelled == 0 && count == 2 && a.context == 11 && b.context == 33 && a.kind == runtime.SEND_TO && b.kind == runtime.SEND_TO && backend.live == 0 && backend.resource_count == 1;
    darwin.sock_close(socket);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test "async darwin: shutdown and close follow prior writes" {
    var queue: shared.IoQueue;
    if (darwin.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, 8, 1) < 0) {
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        darwin.sock_close(client);
        darwin.sock_close(listener);
        destroy(?backend);
        darwin.io_queue_close(?queue);
        ret 1;
    }

    var first:          u8   = 'a';
    var second:         u8   = 'b';
    var tokens:         [5]types.Token;
    val write_first:    i64  = submit_write(?backend, server, 1, ?first, 1, 71, ?tokens[0]);
    val write_second:   i64  = submit_write(?backend, server, 1, ?second, 1, 72, ?tokens[1]);
    val shutdown:       i64  = submit_shutdown_write(?backend, server, 1, 73, ?tokens[2]);
    var received:       [2]u8;
    val received_bytes: i64  = test_receive_exact(client, ?received[0], 2);
    var eof_byte:       u8   = 0;
    val eof:            i64  = darwin.sock_recv(client, ?eof_byte, 1);
    var pending:        u8   = 0;
    val read_pending:   i64  = submit_read(?backend, server, 1, ?pending, 1, 74, ?tokens[3]);
    val close_pending:  i64  = submit_close(?backend, server, 1, 75, ?tokens[4]);
    var completions:    [5]types.NativeCompletion;
    val count:          i64  = test_collect_completions(?backend, ?completions[0], 5);
    var valid_order:    bool = count == 5;
    var expected:       [5]usize;
    expected[0] = 71;
    expected[1] = 72;
    expected[2] = 73;
    expected[3] = 74;
    expected[4] = 75;
    var i: usize = 0;
    for (count == 5 && i < 5) {
        val native: types.NativeCompletion = completions[i];
        if (native.context != expected[i])                                                { valid_order = false; }
        if (native.context == 74 && native.status != darwin.ECANCELED)                    { valid_order = false; }
        if (native.context == 75 && (native.kind != runtime.CLOSE || native.status != 0)) { valid_order = false; }
        i = i + 1;
    }
    var failure: i32 = 0;
    if (write_first != 0)                         { failure = 2; }
    or (write_second != 0)                        { failure = 3; }
    or (shutdown != 0)                            { failure = 4; }
    or (read_pending != 0)                        { failure = 5; }
    or (close_pending != 0)                       { failure = 6; }
    or (received_bytes != 2)                      { failure = 7; }
    or (received[0] != 'a' || received[1] != 'b') { failure = 8; }
    or (eof != 0)                                 { failure = 9; }
    or (!valid_order)                             { failure = 10; }
    or (backend.resource_count != 0)              { failure = 11; }
    darwin.sock_close(client);
    darwin.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    darwin.io_queue_close(?queue);
    if (failure == 0 && destroyed < 0) { failure = 12; }
    if (failure != 0)                  { ret failure; }
    ret 0;
}

