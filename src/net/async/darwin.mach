    val active_valid: bool = configured == 0 && peer_configured == 0 && blocked && fill_error == 0 && write_submitted == 0 && close_submitted == 0 && close_active && canceled == 0 && raw_close == darwin.EBADF && count == 1 && displaced.context == 93 && displaced.kind == runtime.WRITE && displaced.status == darwin.ECANCELED && displaced.bytes == 0 && displaced.items == 0 && backend.live == 0 && backend.resource_count == 0;
    darwin.sock_close(client);

    var second_client: usize;
    if (test_client(endpoint, ?second_client) < 0) { darwin.sock_close(listener); destroy(?backend); darwin.io_queue_close(?queue); ret 1; }
    var second_server: usize = (-1)::usize;
