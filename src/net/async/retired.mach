# the openings detach retired, across every driver in the process
#
# a driver knows only the sockets it has seen, so on its own it would take a
# copy of a detached stream's old handle for a socket it had not met. detach
# raises a floor for the native value here, and a driver reads the floor when it
# meets a value under an opening it has no record of. openings only grow, so a
# socket that later reuses the value is above the floor and passes.
#
# a value keeps its entry for the life of the process, so the table never holds
# more than one entry per native value that was ever detached

use std.sync.mutex;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

# key: the native value plus one, 0 for a free entry
rec Entry {
    key:   usize;
    floor: u64;
}

# fits one page, which is the least the os allocates
val INITIAL_CAPACITY: usize = 128;

var lock:     mutex.Mutex = 0;
var entries:  *Entry      = nil;
var capacity: usize       = 0;
var used:     usize       = 0;

# the entry for key, or the free entry where it belongs. the table is at most
# half full, so a free entry always ends the probe
fun find(table: *Entry, slots: usize, key: usize) *Entry {
    val mask:  usize = slots - 1;
    var index: usize = (key ^ (key >> 2)) & mask;
    for (table[index].key != 0 && table[index].key != key) {
        index = (index + 1) & mask;
    }
    ret ?table[index];
}

# double the table, or start it. false leaves the table as it was
fun grow() bool {
    var slots: usize = INITIAL_CAPACITY;
    if (capacity != 0) { slots = capacity * 2; }
    val fresh: *Entry = os.allocate(slots * $size_of(Entry))::*Entry;
    if (fresh == nil) { ret false; }
    var index: usize = 0;
    for (index < capacity) {
        if (entries[index].key != 0) {
            @find(fresh, slots, entries[index].key) = entries[index];
        }
        index = index + 1;
    }
    if (capacity != 0) { os.deallocate(entries::ptr, capacity * $size_of(Entry)); }
    entries  = fresh;
    capacity = slots;
    ret true;
}

# make sure retire of value cannot fail, before anything is given up
# ---
# value: the native socket
# ret:   false when the table cannot grow, and nothing changes
pub fun reserve(value: usize) bool {
    mutex.lock(?lock);
    fin { mutex.unlock(?lock); }
    if ((used + 1) * 2 > capacity && !grow()) { ret false; }
    val entry: *Entry = find(entries, capacity, value + 1);
    if (entry.key == 0) {
        entry.key = value + 1;
        used      = used + 1;
    }
    ret true;
}

# refuse every handle of value at or below opening, on every driver. reserve
# has run for value
pub fun retire(value: usize, opening: u64) {
    mutex.lock(?lock);
    val entry: *Entry = find(entries, capacity, value + 1);
    if (opening > entry.floor) { entry.floor = opening; }
    mutex.unlock(?lock);
}

# whether a handle was retired on some driver. a backend whose handles carry no
# opening passes 0, which nothing retires
pub fun stale(value: usize, opening: u64) bool {
    if (opening == 0) { ret false; }
    mutex.lock(?lock);
    fin { mutex.unlock(?lock); }
    if (capacity == 0) { ret false; }
    ret opening <= find(entries, capacity, value + 1).floor;
}
