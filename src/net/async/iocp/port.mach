# the completion port layer shared by the windows net.async backends
#
# everything here makes a native call: posting, aborting, settling and
# harvesting packets. std.net.async.iocp decides what is due, and this layer
# acts on it. a backend's operation record starts with a Header, so one
# address names both, and the backend hands in Hooks for what only it knows

$if ($mach.build.os != $mach.os.windows) {
    $error("std.net.async.iocp.port: requires windows target");
}

use std.allocator;
use std.allocator.page;
use std.io.runtime;
use std.memory;
use std.memory.table;
use std.net.async.iocp;
use std.net.async.types;
use std.sync.mutex;
use std.system.os.shared;
use std.system.os.windows;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

pub rec NativeOverlapped {
    internal:      usize;
    internal_high: usize;
    offset:        u32;
    offset_high:   u32;
    event:         usize;
}

pub rec NativeBuffer {
    length: u32;
    data:   *u8;
}

# the part of an operation this layer owns. every field the kernel touches is
# stable until the operation's packet is consumed
# ---
# overlapped: the native request, whose address is the packet's context
# link:       state, kind and socket membership, owned by the iocp core
# auxiliary:  the socket an accept fills, closed unless handed to the caller
# buffer:     the one buffer a read or write borrows
# address:    native address storage for accept and connect
pub rec Header {
    overlapped:   NativeOverlapped;
    link:         iocp.Link;
    generation:   u32;
    index:        u32;
    next_free:    u32;
    resource:     usize;
    auxiliary:    usize;
    context:      usize;
    buffer:       NativeBuffer;
    address:      [288]u8;
    transferred:  u32;
    native_flags: u32;
}

# what differs between the backends
# ---
# clear:    resets the backend's own fields and drops what they borrow
# accepted: finishes an accept once its context is set, 0 or a native code
# finish:   settles an active packet of a kind this layer does not know, or nil
# stale:    whether a request aborted outside the driver reports STATUS_STALE
pub rec Hooks {
    clear:    fun(*Header);
    accepted: fun(*Header) i64;
    finish:   fun(ptr, *Header, i64, usize, u32);
    stale:    bool;
}

# a bounded completion port backend
# ---
# operations: operation records, each starting with a Header
# core:       the socket records, their map and the control lists
pub rec Backend {
    queue:     *shared.IoQueue;
    source_id: u16;
    # where every table's chunks come from
    allocator:       allocator.Allocator;
    operations:      table.Table;
    preserved:       table.Table;
    completions:     table.Table;
    core:            iocp.Core;
    native:          *windows.IoCompletion;
    hooks:           Hooks;
    operation_slots: usize;
    free_operation:  u32;
    active:          usize;
    ready:           usize;
    lock:            mutex.Mutex;
    io_lock:         mutex.Mutex;
}

# readiness is harvested in fixed batches, so the batch is not a capacity
val NATIVE_BATCH: usize = 256;

pub val INVALID_SOCKET: usize = (-1)::usize;

pub fun header_at(backend: *Backend, index: usize) *Header {
    ret table.at(?backend.operations, index)::*Header;
}

fun preserved_at(backend: *Backend, index: usize) *windows.IoCompletion {
    ret table.at(?backend.preserved, index)::*windows.IoCompletion;
}

fun completion_at(backend: *Backend, index: usize) *types.NativeCompletion {
    ret table.at(?backend.completions, index)::*types.NativeCompletion;
}

pub fun socket_record(backend: *Backend, sock: u32) *iocp.Socket {
    ret iocp.socket_at(?backend.core, sock);
}

pub fun aliases(backend: *Backend, data: *u8, len: usize) bool {
    if (!memory.range_valid(data, len)) { ret true; }
    if (len == 0)                       { ret false; }
    if (!memory.range_valid(backend::*u8, $size_of(Backend)) ||
        backend.queue == nil || backend.operations.capacity == 0) {
        ret true;
    }
    var native_bytes: usize = 0;
    if (!memory.range_scaled(NATIVE_BATCH, $size_of(windows.IoCompletion),
        ?native_bytes)) { ret true; }
    ret memory.ranges_overlap(backend::*u8, $size_of(Backend), data, len) ||
        memory.ranges_overlap(backend.queue::*u8, $size_of(shared.IoQueue),
        data, len) ||
        table.aliases(?backend.operations, data, len) ||
        table.aliases(?backend.preserved, data, len) ||
        table.aliases(?backend.completions, data, len) ||
        iocp.aliases(?backend.core, data, len) ||
        memory.ranges_overlap(backend.native::*u8, native_bytes, data, len);
}

pub fun invalid() i64 {
    ret windows.EINVAL;
}

pub fun zero_overlapped(overlapped: *NativeOverlapped) {
    overlapped.internal      = 0;
    overlapped.internal_high = 0;
    overlapped.offset        = 0;
    overlapped.offset_high   = 0;
    overlapped.event         = 0;
}

pub fun operation_for(backend: *Backend, token: types.Token) *Header {
    if (token.index::usize >= backend.operation_slots) { ret nil; }
    val operation: *Header = header_at(backend, token.index::usize);
    if (operation.link.state == iocp.FREE || operation.generation != token.generation) { ret nil; }
    ret operation;
}

# the packet context is the overlapped's own address, which the table never moves
fun operation_from_context(backend: *Backend, context: usize) *Header {
    val offset: usize = $offset_of(Header, overlapped);
    if (context < offset) { ret nil; }
    val index: usize = table.index_of(?backend.operations, context - offset);
    if (index == table.NO_INDEX || index >= backend.operation_slots) { ret nil; }
    val operation: *Header = header_at(backend, index);
    if (operation.link.state == iocp.FREE) { ret nil; }
    ret operation;
}

fun clear_borrowed(backend: *Backend, operation: *Header) {
    operation.buffer.data   = nil;
    operation.buffer.length = 0;
    backend.hooks.clear(operation);
}

# the completion and preserved tables track the operation table, so publishing
# and preserving a completion always have somewhere to land
fun operation_append(backend: *Backend) bool {
    if (backend.operation_slots >= iocp.NONE::usize) { ret false; }
    if (backend.operation_slots == backend.operations.capacity &&
        !table.grow(?backend.operations)) { ret false; }
    if (!table.reserve(?backend.completions, backend.operations.capacity) ||
        !table.reserve(?backend.preserved, backend.operations.capacity)) { ret false; }
    val index: usize   = backend.operation_slots;
    val entry: *Header = header_at(backend, index);
    entry.link.state = iocp.FREE;
    entry.generation = 0;
    entry.index      = index::u32;
    entry.resource   = INVALID_SOCKET;
    entry.auxiliary  = INVALID_SOCKET;
    clear_borrowed(backend, entry);
    entry.next_free         = backend.free_operation;
    backend.free_operation  = index::u32;
    backend.operation_slots = index + 1;
    ret true;
}

# a free operation joins the socket record sock in state
pub fun claim_locked(backend: *Backend, sock: u32, kind: runtime.Kind, resource: usize, context: usize, state: u8, token: *types.Token) *Header {
    if (backend.free_operation == iocp.NONE && !operation_append(backend)) { ret nil; }
    val index:     usize   = backend.free_operation::usize;
    val operation: *Header = header_at(backend, index);
    backend.free_operation = operation.next_free;
    var generation: u32 = operation.generation + 1;
    if (generation == 0) { generation = 1; }
    zero_overlapped(?operation.overlapped);
    operation.generation   = generation;
    operation.resource     = resource;
    operation.auxiliary    = INVALID_SOCKET;
    operation.context      = context;
    operation.transferred  = 0;
    operation.native_flags = 0;
    clear_borrowed(backend, operation);
    backend.active = backend.active + 1;
    iocp.join(?backend.core, ?backend.operations, sock, index::u32, kind, state);
    @token = types.Token{index: index::u32, generation: generation};
    ret operation;
}

fun read_lane(kind: runtime.Kind) bool {
    ret kind == runtime.READ || kind == runtime.READABLE;
}

fun post_receive(operation: *Header) i64 {
    ret windows.sock_async_receive(operation.resource, (?operation.buffer)::ptr, 1, ?operation.native_flags, (?operation.overlapped)::ptr);
}

# act on what a state change on the socket made due: its held read-lane
# requests post oldest first, and a shutdown with no write left runs
fun settle_socket_locked(backend: *Backend, sock: u32) {
    for (true) {
        val next: u32 = iocp.take_deferred(?backend.core, ?backend.operations, sock);
        if (next == iocp.NONE) { brk; }
        val posted: i64 = post_receive(header_at(backend, next::usize));
        if (posted < 0) { iocp.transition(?backend.core, ?backend.operations, next, iocp.CONTROL_READY, posted); }
    }
    val due: u32 = iocp.progress(?backend.core, ?backend.operations, sock);
    if (due != iocp.NONE) {
        val shut: i64 = windows.sock_shutdown(header_at(backend, due::usize).resource, windows.SHUT_WR);
        iocp.transition(?backend.core, ?backend.operations, due, iocp.CONTROL_READY, shut);
    }
}

# the operation leaves its own socket record, never one found by socket value
pub fun release_locked(backend: *Backend, operation: *Header) {
    val sock: u32 = iocp.release(?backend.core, ?backend.operations, operation.index);
    clear_borrowed(backend, operation);
    operation.resource     = INVALID_SOCKET;
    operation.auxiliary    = INVALID_SOCKET;
    operation.next_free    = backend.free_operation;
    backend.free_operation = operation.index;
    backend.active         = backend.active - 1;
    if (sock != iocp.NONE) { settle_socket_locked(backend, sock); }
}

pub fun push_completion_locked(
    backend: *Backend,
    context: usize,
    kind: runtime.Kind,
    bytes: usize,
    items: usize,
    resource: usize,
    status: i64,
    end_of_stream: bool,
) bool {
    if (backend.ready == backend.completions.capacity) { ret false; }
    @completion_at(backend, backend.ready) = types.NativeCompletion{
        context:       context,
        kind:          kind,
        bytes:         bytes,
        items:         items,
        resource:      resource,
        status:        status,
        end_of_stream: end_of_stream,
    };
    backend.ready = backend.ready + 1;
    ret true;
}

# releasing a ready operation can make another one ready, and it joins the
# same list, so one pass settles every control the completions have room for
fun emit_control_locked(backend: *Backend) {
    for (backend.core.ready_head != iocp.NONE && backend.ready < backend.completions.capacity) {
        backend.core.steps = backend.core.steps + 1;
        val operation: *Header = header_at(backend, backend.core.ready_head::usize);
        push_completion_locked(backend, operation.context, operation.link.kind, 0, 0, operation.resource, operation.link.result, false);
        release_locked(backend, operation);
    }
}

# initial is the size the backend starts at: the operation, completion,
# preserved and socket tables grow on demand
# ---
# operation_size: bytes per operation record, which starts with a Header
pub fun make(backend: *Backend, queue: *shared.IoQueue, initial: usize, source_id: u16, operation_size: usize, hooks: Hooks) i64 {
    if (backend == nil || queue == nil || queue.handle == 0 || initial == 0 || source_id == 0 || operation_size < $size_of(Header)) { ret invalid(); }
    var native_bytes: usize = 0;
    if (!memory.range_scaled(NATIVE_BATCH, $size_of(windows.IoCompletion), ?native_bytes)) { ret windows.ENOMEM; }

    val allocated: err[allocator.Error] = page.make(?backend.allocator);
    if (sel allocated.err)                                                             { ret windows.ENOMEM; }
    if (!table.make(?backend.operations, ?backend.allocator, operation_size, initial)) { ret windows.ENOMEM; }
    if (!table.make(?backend.completions, ?backend.allocator, $size_of(types.NativeCompletion), initial) ||
        !table.make(?backend.preserved, ?backend.allocator, $size_of(windows.IoCompletion), initial)) {
        table.destroy(?backend.preserved);
        table.destroy(?backend.completions);
        table.destroy(?backend.operations);
        ret windows.ENOMEM;
    }
    if (!iocp.make(?backend.core, ?backend.allocator, $offset_of(Header, link), initial)) {
        table.destroy(?backend.preserved);
        table.destroy(?backend.completions);
        table.destroy(?backend.operations);
        ret windows.ENOMEM;
    }
    backend.native = windows.allocate(native_bytes)::*windows.IoCompletion;
    if (backend.native == nil) {
        iocp.destroy(?backend.core);
        table.destroy(?backend.preserved);
        table.destroy(?backend.completions);
        table.destroy(?backend.operations);
        ret windows.ENOMEM;
    }
    backend.queue           = queue;
    backend.source_id       = source_id;
    backend.hooks           = hooks;
    backend.operation_slots = 0;
    backend.free_operation  = iocp.NONE;
    backend.active          = 0;
    backend.ready           = 0;
    backend.lock            = mutex.make();
    backend.io_lock         = mutex.make();
    ret 0;
}

# the socket record a submit joins, associated with the completion port once
# per opening when associate is set. a socket value mapped under a newer
# opening makes this handle stale, and one mapped under an older opening
# belongs to a socket closed outside the driver, whose record the core drops.
# associating a socket that is still associated fails, so a handle wrapped
# twice from one live socket is refused rather than taken over
pub fun acquire_locked(backend: *Backend, resource: usize, opening: u64, associate: bool, sock: *u32) i64 {
    val acquired: u8 = iocp.acquire(?backend.core, ?backend.operations, resource, opening, sock);
    if (acquired == iocp.STALE)     { ret types.STATUS_STALE; }
    if (acquired == iocp.EXHAUSTED) { ret windows.ENOMEM; }
    val record: *iocp.Socket = socket_record(backend, @sock);
    if (!associate || record.associated) { ret 0; }
    val result: i64 = windows.io_queue_attach(backend.queue, resource, backend.source_id);
    if (result < 0) {
        if (acquired == iocp.CREATED) { iocp.unmap(?backend.core, @sock); }
        ret result;
    }
    record.associated = true;
    ret 0;
}

# a socket with a shutdown or close submitted takes no further requests
pub fun controlled_locked(backend: *Backend, sock: u32) bool {
    ret socket_record(backend, sock).control != iocp.NONE;
}

# the socket record a request joins, or the refusal. backend.lock stays held on success
pub fun admit(backend: *Backend, resource: usize, opening: u64, sock: *u32) i64 {
    mutex.lock(?backend.lock);
    val acquired: i64 = acquire_locked(backend, resource, opening, true, sock);
    if (acquired < 0) {
        mutex.unlock(?backend.lock);
        ret acquired;
    }
    if (controlled_locked(backend, @sock)) {
        mutex.unlock(?backend.lock);
        ret windows.ENOTCONN;
    }
    ret 0;
}

# a read, readiness wait or write over one borrowed buffer
pub fun submit_buffer(backend: *Backend, resource: usize, opening: u64, buffer: *u8, length: usize, context: usize, kind: runtime.Kind, token: *types.Token) i64 {
    if (backend == nil || token == nil || resource == INVALID_SOCKET || (buffer == nil && length != 0) || length > 0xffffffff) { ret invalid(); }
    var sock:     u32 = iocp.NONE;
    val admitted: i64 = admit(backend, resource, opening, ?sock);
    if (admitted < 0) { ret admitted; }
    var state: u8 = iocp.ACTIVE;
    if (iocp.must_defer(?backend.core, sock, kind)) { state = iocp.DEFERRED; }
    val operation: *Header = claim_locked(backend, sock, kind, resource, context, state, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.ENOMEM;
    }
    operation.buffer = NativeBuffer{length: length::u32, data: buffer};
    var result: i64 = 0;
    if (state == iocp.ACTIVE && read_lane(kind)) {
        result = post_receive(operation);
    }
    or (state == iocp.ACTIVE) {
        result = windows.sock_async_send(resource, (?operation.buffer)::ptr, 1, 0, (?operation.overlapped)::ptr);
    }
    if (result < 0) { release_locked(backend, operation); }
    mutex.unlock(?backend.lock);
    ret result;
}

fun submit_control(backend: *Backend, resource: usize, opening: u64, context: usize, kind: runtime.Kind, token: *types.Token) i64 {
    if (backend == nil || token == nil || resource == INVALID_SOCKET) { ret invalid(); }
    mutex.lock(?backend.lock);
    var sock:     u32 = iocp.NONE;
    val acquired: i64 = acquire_locked(backend, resource, opening, false, ?sock);
    if (acquired < 0) {
        mutex.unlock(?backend.lock);
        ret acquired;
    }
    if (controlled_locked(backend, sock)) {
        mutex.unlock(?backend.lock);
        ret windows.EBUSY;
    }
    val operation: *Header = claim_locked(backend, sock, kind, resource, context, iocp.CONTROL_PENDING, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.ENOMEM;
    }
    if (kind == runtime.CLOSE) {
        var current: u32 = socket_record(backend, sock).ops_head;
        for (current != iocp.NONE) {
            val pending: *Header = header_at(backend, current::usize);
            if (iocp.abort(?backend.core, ?backend.operations, current, false, windows.ECANCELED)) {
                windows.io_queue_cancel(resource, (?pending.overlapped)::ptr);
            }
            current = pending.link.sock_next;
        }
        operation.link.result = windows.sock_close(resource);
        iocp.unmap(?backend.core, sock);
    }
    settle_socket_locked(backend, sock);
    mutex.unlock(?backend.lock);
    windows.io_queue_wake(backend.queue);
    ret 0;
}

# a shutdown waits for the socket's writes, and runs once none is left
pub fun submit_shutdown_write(backend: *Backend, resource: usize, opening: u64, context: usize, token: *types.Token) i64 {
    ret submit_control(backend, resource, opening, context, runtime.SHUTDOWN, token);
}

# a close aborts the socket's requests and completes once they have all left.
# the record is unmapped at once, so a reused socket value attaches fresh
pub fun submit_close(backend: *Backend, resource: usize, opening: u64, context: usize, token: *types.Token) i64 {
    ret submit_control(backend, resource, opening, context, runtime.CLOSE, token);
}

# close a socket without a completion. its outstanding requests settle on the
# unmapped record, so a reused socket value attaches fresh
pub fun close_socket(backend: *Backend, resource: usize, opening: u64) i64 {
    if (backend == nil || resource == INVALID_SOCKET) { ret invalid(); }
    mutex.lock(?backend.lock);
    val closed: i64 = windows.sock_close(resource);
    val sock:   u32 = iocp.lookup(?backend.core, resource);
    if (sock != iocp.NONE && socket_record(backend, sock).opening == opening) { iocp.unmap(?backend.core, sock); }
    mutex.unlock(?backend.lock);
    ret closed;
}

fun restore_preserved(backend: *Backend, count: usize, wake: bool) i64 {
    var result: i64   = 0;
    var i:      usize = 0;
    for (i < count) {
        val restored: i64 = windows.io_queue_restore(backend.queue, @preserved_at(backend, i));
        if (result >= 0 && restored < 0) { result = restored; }
        i = i + 1;
    }
    if (wake) {
        val restored_wake: i64 = windows.io_queue_wake(backend.queue);
        if (result >= 0 && restored_wake < 0) { result = restored_wake; }
    }
    ret result;
}

# successful cancellation synchronously ends all native access to borrowed data
pub fun cancel(backend: *Backend, token: types.Token) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    val operation: *Header = operation_for(backend, token);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret windows.EBADF;
    }
    if (operation.link.state == iocp.CONTROL_PENDING || operation.link.state == iocp.CONTROL_READY || operation.link.state == iocp.DEFERRED) {
        release_locked(backend, operation);
        mutex.unlock(?backend.lock);
        windows.io_queue_wake(backend.queue);
        ret 0;
    }
    if (operation.link.state != iocp.ACTIVE && operation.link.state != iocp.CANCEL_READY) {
        mutex.unlock(?backend.lock);
        ret windows.EBADF;
    }
    # a close already asked the kernel to abort a cancel-ready operation, and
    # its packet is still owed, so both states wait for that packet below
    if (operation.link.state == iocp.ACTIVE) {
        val cancelled: i64 = windows.io_queue_cancel(operation.resource, (?operation.overlapped)::ptr);
        if (cancelled < 0) {
            mutex.unlock(?backend.lock);
            ret cancelled;
        }
    }
    iocp.transition(?backend.core, ?backend.operations, operation.index, iocp.CANCELLED, operation.link.result);
    val context: usize = (?operation.overlapped)::usize;
    mutex.unlock(?backend.lock);

    mutex.lock(?backend.io_lock);
    mutex.lock(?backend.lock);
    val pending: *Header = operation_for(backend, token);
    if (pending == nil) {
        mutex.unlock(?backend.lock);
        mutex.unlock(?backend.io_lock);
        ret 0;
    }
    if (pending.link.state != iocp.CANCELLED) {
        mutex.unlock(?backend.lock);
        mutex.unlock(?backend.io_lock);
        ret windows.EBADF;
    }
    mutex.unlock(?backend.lock);

    var found:           bool  = false;
    var preserved_count: usize = 0;
    var preserved_wake:  bool  = false;
    var result:          i64   = 0;
    for (!found && result >= 0) {
        var native: windows.IoCompletion;
        val count:  i64 = windows.io_queue_poll(backend.queue, ?native, 1, -1);
        if (count < 0)  { result = count; }
        or (count == 0) { result = windows.EIO; }
        or (native.context == context) {
            found = true;
        }
        or ((native.events & windows.IO_EVENT_WAKE) != 0) {
            preserved_wake = true;
        }
        or (preserved_count == backend.preserved.capacity) {
            result = windows.ENOMEM;
        }
        or {
            @preserved_at(backend, preserved_count) = native;
            preserved_count                         = preserved_count + 1;
        }
    }
    if (found) {
        mutex.lock(?backend.lock);
        val completed: *Header = operation_for(backend, token);
        if (completed != nil && completed.link.state == iocp.CANCELLED) {
            if (completed.auxiliary != INVALID_SOCKET) {
                windows.sock_close(completed.auxiliary);
                completed.auxiliary = INVALID_SOCKET;
            }
            release_locked(backend, completed);
        }
        mutex.unlock(?backend.lock);
    }
    val restored: i64 = restore_preserved(backend, preserved_count, preserved_wake);
    mutex.unlock(?backend.io_lock);
    if (result < 0) { ret result; }
    ret restored;
}

# an active request settled with status: an accept's socket is finished or
# closed, a readiness wait reads the queued byte count, and the rest report
# their bytes
pub fun finish_locked(backend: *Backend, operation: *Header, status: i64, bytes: usize) {
    var result:             i64   = status;
    var completed_bytes:    usize = 0;
    var completed_resource: usize = operation.resource;
    var end_of_stream:      bool  = false;
    val kind:               u8    = operation.link.kind;
    if (status >= 0 && kind == runtime.ACCEPT) {
        result = windows.sock_accept_context(operation.auxiliary, operation.resource);
        if (result >= 0) { result = backend.hooks.accepted(operation); }
        if (result >= 0) {
            completed_resource  = operation.auxiliary;
            operation.auxiliary = INVALID_SOCKET;
            result              = 0;
        }
        or {
            windows.sock_close(operation.auxiliary);
            operation.auxiliary = INVALID_SOCKET;
            completed_resource  = INVALID_SOCKET;
        }
    }
    or (status >= 0 && kind == runtime.CONNECT) {
        result = windows.sock_connect_context(operation.resource);
    }
    or (status >= 0 && kind == runtime.READABLE) {
        # a zero-byte receive completes on data, orderly close or error, and
        # cannot tell data from close: the queued byte count settles it
        var queued: usize = 0;
        result = windows.sock_pending_bytes(operation.resource, ?queued);
        if (result >= 0) {
            result        = 0;
            end_of_stream = queued == 0;
        }
    }
    or (status >= 0 && (kind == runtime.READ || kind == runtime.WRITE)) {
        result          = 0;
        completed_bytes = bytes;
        end_of_stream   = kind == runtime.READ && bytes == 0 && operation.buffer.length != 0;
    }
    if (status < 0 && kind == runtime.ACCEPT && operation.auxiliary != INVALID_SOCKET) {
        windows.sock_close(operation.auxiliary);
        operation.auxiliary = INVALID_SOCKET;
    }
    push_completion_locked(backend, operation.context, kind, completed_bytes, 0, completed_resource, result, end_of_stream);
    release_locked(backend, operation);
}

fun consume_native_locked(backend: *Backend, native: windows.IoCompletion) {
    if ((native.events & windows.IO_EVENT_WAKE) != 0) { ret; }
    val operation: *Header = operation_from_context(backend, native.context);
    if (operation == nil) { ret; }
    if (operation.link.state == iocp.CANCELLED) {
        release_locked(backend, operation);
        ret;
    }
    if (operation.link.state == iocp.CANCEL_READY) {
        finish_locked(backend, operation, operation.link.result, 0);
        ret;
    }
    if (operation.link.state != iocp.ACTIVE) { ret; }
    var bytes:    u32 = native.flags::u32;
    var flags:    u32 = operation.native_flags;
    val observed: i64 = windows.sock_async_result(operation.resource, (?operation.overlapped)::ptr, ?bytes, ?flags, false);
    var status:   i64 = observed;
    # the driver's own cancels leave the active state first, so an aborted
    # request that is still active was aborted by a close outside the driver
    if (backend.hooks.stale && (observed == windows.ECANCELED || observed == windows.ENOTSOCK)) { status = types.STATUS_STALE; }
    val kind: u8 = operation.link.kind;
    if (backend.hooks.finish != nil && kind != runtime.ACCEPT && kind != runtime.CONNECT && kind != runtime.READ && kind != runtime.READABLE && kind != runtime.WRITE) {
        backend.hooks.finish(backend::ptr, operation, status, bytes::usize, flags);
    }
    or {
        finish_locked(backend, operation, status, bytes::usize);
    }
}

pub fun flush(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    backend.ready = 0;
    emit_control_locked(backend);
    val ready: usize = backend.ready;
    mutex.unlock(?backend.lock);
    ret ready::i64;
}

pub fun dispatch(
    backend: *Backend,
    context: usize,
    events: u32,
    status: i64,
    flags: u64,
    claimed: *bool,
) i64 {
    if (backend == nil || claimed == nil) { ret invalid(); }
    @claimed = false;
    mutex.lock(?backend.lock);
    val operation: *Header = operation_from_context(backend, context);
    if (operation == nil) {
        mutex.unlock(?backend.lock);
        ret 0;
    }
    @claimed      = true;
    backend.ready = 0;
    consume_native_locked(backend, windows.IoCompletion{
        context: context,
        events:  events,
        status:  status,
        flags:   flags,
        source:  backend.source_id,
    });
    emit_control_locked(backend);
    val ready: usize = backend.ready;
    mutex.unlock(?backend.lock);
    ret ready::i64;
}

# one thread owns poll and completion storage
pub fun poll(backend: *Backend, timeout_ms: i32) i64 {
    if (backend == nil || timeout_ms < -1) { ret invalid(); }
    mutex.lock(?backend.lock);
    backend.ready = 0;
    emit_control_locked(backend);
    val immediately_ready: usize = backend.ready;
    mutex.unlock(?backend.lock);
    if (immediately_ready != 0) { ret immediately_ready::i64; }

    mutex.lock(?backend.io_lock);
    val count: i64 = windows.io_queue_poll(backend.queue, backend.native, NATIVE_BATCH, timeout_ms);
    if (count <= 0) {
        mutex.unlock(?backend.io_lock);
        ret count;
    }
    mutex.lock(?backend.lock);
    var i: usize = 0;
    for (i < count::usize && backend.ready < backend.completions.capacity) {
        consume_native_locked(backend, backend.native[i]);
        i = i + 1;
    }
    emit_control_locked(backend);
    val ready: usize = backend.ready;
    mutex.unlock(?backend.lock);
    mutex.unlock(?backend.io_lock);
    ret ready::i64;
}

pub fun completion(backend: *Backend, index: usize, out: *types.NativeCompletion) i64 {
    if (backend == nil || out == nil || index >= backend.ready) { ret invalid(); }
    @out = @completion_at(backend, index);
    ret 0;
}

pub fun destroy(backend: *Backend) i64 {
    if (backend == nil) { ret invalid(); }
    mutex.lock(?backend.lock);
    if (backend.active != 0) {
        mutex.unlock(?backend.lock);
        ret windows.EBUSY;
    }
    windows.deallocate(backend.native::ptr, $size_of(windows.IoCompletion) * NATIVE_BATCH);
    iocp.destroy(?backend.core);
    table.destroy(?backend.preserved);
    table.destroy(?backend.completions);
    table.destroy(?backend.operations);
    backend.native          = nil;
    backend.operation_slots = 0;
    backend.free_operation  = iocp.NONE;
    backend.active          = 0;
    backend.ready           = 0;
    backend.queue           = nil;
    backend.source_id       = 0;
    mutex.unlock(?backend.lock);
    ret 0;
}
