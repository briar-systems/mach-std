        if (is_err[bool, io_error.Error](io_runtime.close(?runtime))) { ret 17; }
        setup = wait(?driver, ?output[0], 4, 1000);
        if (is_err[usize, io_error.Error](setup)
            || unwrap_ok[usize, io_error.Error](setup) != 1
            || output[0].has_error
            || output[0].kind != io_runtime.LISTEN
            || is_err[bool, io_error.Error](listening(?driver, output[0]))) {
