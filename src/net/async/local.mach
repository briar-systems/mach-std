    }

    test "async local: stale listener tokens do not survive driver recreation" {
        val endpoint_result: Result[endpoint.Endpoint, io_error.Error] = test_endpoint();
        if (is_err[endpoint.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
        var bound: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](endpoint_result);
        bound.name[bound.length - 1] = 'a';
        var runtime: io_runtime.Runtime;
        if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 4))) { ret 2; }
        var driver: Driver;
        if (is_err[bool, io_error.Error](make(?driver, ?runtime))) { ret 3; }
        var scope: cancel.Scope;
        if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 4; }
        var options: types.BindOptions = local.default_bind_options();
        options.stale = types.REMOVE_STALE_SOCKET;
        if (is_err[io_runtime.Token, io_error.Error](submit_bind(?driver, ?scope, bound, options, 301))) { ret 5; }
        var output: [4]io_runtime.Completion;
        var waited: Result[usize, io_error.Error] = wait(?driver, ?output[0], 4, 1000);
        if (is_err[usize, io_error.Error](waited) || unwrap_ok[usize, io_error.Error](waited) != 1) { ret 6; }
        val first_result: Result[Listener, io_error.Error] = bound_listener(?driver, output[0]);
        if (is_err[Listener, io_error.Error](first_result)) { ret 7; }
        var first: Listener = unwrap_ok[Listener, io_error.Error](first_result);
        val stale: Listener = first;
        if (is_err[io_runtime.Token, io_error.Error](submit_listener_close(?driver, ?scope, ?first, 302))) { ret 8; }
        waited = wait(?driver, ?output[0], 4, 1000);
        if (is_err[usize, io_error.Error](waited)
            || unwrap_ok[usize, io_error.Error](waited) != 1
            || output[0].has_error
            || !cancel.destroy(?scope)
            || is_err[bool, io_error.Error](destroy(?driver))
            || is_err[bool, io_error.Error](io_runtime.close(?runtime))
            || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) {
            ret 9;
        }

        if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 4))) { ret 10; }
        if (is_err[bool, io_error.Error](make(?driver, ?runtime))) { ret 11; }
        if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 12; }
        if (is_err[io_runtime.Token, io_error.Error](submit_bind(?driver, ?scope, bound, options, 303))) { ret 13; }
        waited = wait(?driver, ?output[0], 4, 1000);
        if (is_err[usize, io_error.Error](waited) || unwrap_ok[usize, io_error.Error](waited) != 1) { ret 14; }
        val second_result: Result[Listener, io_error.Error] = bound_listener(?driver, output[0]);
        if (is_err[Listener, io_error.Error](second_result)) { ret 15; }
        var second: Listener = unwrap_ok[Listener, io_error.Error](second_result);
        val rejected: Result[io_runtime.Token, io_error.Error] = submit_listen(?driver, ?scope, ?stale, 8, 304);
        if (!is_err[io_runtime.Token, io_error.Error](rejected)
            || unwrap_err[io_runtime.Token, io_error.Error](rejected).code != os.EBADF
            || is_err[io_runtime.Token, io_error.Error](submit_listener_close(?driver, ?scope, ?second, 305))) {
            ret 16;
        }
        waited = wait(?driver, ?output[0], 4, 1000);
        if (is_err[usize, io_error.Error](waited)
            || unwrap_ok[usize, io_error.Error](waited) != 1
            || output[0].has_error
            || !cancel.destroy(?scope)
            || is_err[bool, io_error.Error](destroy(?driver))
            || is_err[bool, io_error.Error](io_runtime.close(?runtime))
            || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))
            || !test_endpoint_absent(bound)) {
            ret 17;
        }
        ret 0;
    }

    test "async local: managed rename requires owned filesystem listener" {
        val endpoint_result: Result[endpoint.Endpoint, io_error.Error] = test_endpoint();
        if (is_err[endpoint.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
        var first: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](endpoint_result);
        var second: endpoint.Endpoint = first;
        first.name[first.length - 1] = 'o';
        second.name[second.length - 1] = 'p';
        var runtime: io_runtime.Runtime;
        if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 4))) { ret 2; }
        var driver: Driver;
        if (is_err[bool, io_error.Error](make(?driver, ?runtime))) { ret 3; }
        var scope: cancel.Scope;
        if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 4; }
        var options: types.BindOptions = local.default_bind_options();
        options.stale = types.REMOVE_STALE_SOCKET;
        options.ownership = types.BORROWED;
        if (is_err[io_runtime.Token, io_error.Error](submit_bind(?driver, ?scope, first, options, 311))) { ret 5; }
        var output: [4]io_runtime.Completion;
        var waited: Result[usize, io_error.Error] = wait(?driver, ?output[0], 4, 1000);
        if (is_err[usize, io_error.Error](waited) || unwrap_ok[usize, io_error.Error](waited) != 1) { ret 6; }
        val listener_result: Result[Listener, io_error.Error] = bound_listener(?driver, output[0]);
        if (is_err[Listener, io_error.Error](listener_result)) { ret 7; }
        var listener: Listener = unwrap_ok[Listener, io_error.Error](listener_result);
        val renamed: Result[bool, io_error.Error] = listener_rename(?driver, ?listener, second);
        if (!is_err[bool, io_error.Error](renamed)
            || unwrap_err[bool, io_error.Error](renamed).code != os.EBADF
            || is_err[io_runtime.Token, io_error.Error](submit_listener_close(?driver, ?scope, ?listener, 312))) {
            ret 8;
        }
        waited = wait(?driver, ?output[0], 4, 1000);
        if (is_err[usize, io_error.Error](waited)
            || unwrap_ok[usize, io_error.Error](waited) != 1
            || output[0].has_error
            || test_endpoint_absent(first)
            || !test_endpoint_absent(second)
            || !test_endpoint_remove(first)
            || !cancel.destroy(?scope)
            || is_err[bool, io_error.Error](destroy(?driver))
            || is_err[bool, io_error.Error](io_runtime.close(?runtime))
            || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) {
            ret 9;
        }
        ret 0;
    }

