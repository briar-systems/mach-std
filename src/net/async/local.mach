# portable bounded asynchronous local byte streams

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.system.os;
use std.system.panic;
use std.chrono.time;
use std.sync.cancel;
use std.sync.atomic;
use std.sync.mutex;
use std.io.lifecycle;
use std.net.local;
use std.net.local.endpoint;
use std.net.local.types;
use async_types: std.net.async.types;
use io_error: std.io.error;
use io_handle: std.io.handle;
use io_runtime: std.io.runtime;

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    use impl: std.net.async.local.unix;
}
$or ($mach.build.os == $mach.os.windows) {
    use impl: std.net.async.local.windows;
    use windows_os: std.system.os.windows;
}
$or {
    $error("std.net.async.local: unsupported target");
}

val SLOT_FREE: u8 = 0;
val SLOT_ACTIVE: u8 = 1;
val LISTENER_FREE: u8 = 0;
val LISTENER_BIND_PENDING: u8 = 1;
val LISTENER_BOUND: u8 = 2;
val LISTENER_LISTEN_PENDING: u8 = 3;
val LISTENER_LISTENING: u8 = 4;
val LISTENER_CLOSING: u8 = 5;
val STREAM_FREE: u8 = 0;
val STREAM_PENDING: u8 = 1;
val STREAM_OPEN: u8 = 2;
val STREAM_CLOSING: u8 = 3;
val NONE: u32 = 0xffffffff;
var next_driver_instance: i64 = 0;

rec Slot {
    state: u8;
    generation: u32;
    native_active: bool;
    native: async_types.Token;
    kind: io_runtime.Kind;
    resource: usize;
    listener_index: u32;
    stream_index: u32;
}

rec ListenerEntry {
    state: u8;
    generation: u32;
    bind_token: io_runtime.Token;
    listen_token: io_runtime.Token;
    value: types.Listener;
}

# listener tokens are resolved only by the driver that created them
pub rec Listener {
    index: u32;
    generation: u32;
    owner: u64;
}

rec StreamEntry {
    state: u8;
    generation: u32;
    completion_token: io_runtime.Token;
    value: types.Stream;
}

pub rec Stream {
    index: u32;
    generation: u32;
    owner: u64;
}

pub rec Driver {
    runtime: *io_runtime.Runtime;
    source: io_runtime.SourceToken;
    backend: impl.Backend;
    slots: *Slot;
    listeners: *ListenerEntry;
    streams: *StreamEntry;
    capacity: usize;
    backend_destroyed: bool;
    cleanup_code: i64;
    instance: u64;
    lock: mutex.Mutex;
}

fun invalid(operation: io_error.Operation) io_error.Error {
    ret io_error.from_code(os.EINVAL, operation);
}

fun exhausted(operation: io_error.Operation) io_error.Error {
    ret io_error.from_code(os.ENOMEM, operation);
}

fun operation_for_kind(kind: io_runtime.Kind) io_error.Operation {
    if (kind == io_runtime.ACCEPT) { ret io_error.OP_ACCEPT; }
    if (kind == io_runtime.BIND) { ret io_error.OP_BIND; }
    if (kind == io_runtime.LISTEN) { ret io_error.OP_LISTEN; }
    if (kind == io_runtime.CONNECT) { ret io_error.OP_CONNECT; }
    if (kind == io_runtime.READ) { ret io_error.OP_READ; }
    if (kind == io_runtime.WRITE) { ret io_error.OP_WRITE; }
    if (kind == io_runtime.SHUTDOWN) { ret io_error.OP_SHUTDOWN; }
    if (kind == io_runtime.CLOSE) { ret io_error.OP_CLOSE; }
    ret io_error.OP_UNKNOWN;
}

fun token_context(token: io_runtime.Token) usize {
    ret ((token.generation::u64 << 32) | (token.index::u64 + 1))::usize;
}

fun context_token(context: usize, token: *io_runtime.Token) bool {
    val raw: u64 = context::u64;
    val low: u64 = raw & 0xffffffff;
    if (token == nil || low == 0) { ret false; }
    token.index = (low - 1)::u32;
    token.generation = (raw >> 32)::u32;
    ret token.generation != 0;
}

fun slot_for(driver: *Driver, token: io_runtime.Token) *Slot {
    if (token.index::usize >= driver.capacity) { ret nil; }
    val slot: *Slot = ?driver.slots[token.index::usize];
    if (slot.state != SLOT_ACTIVE || slot.generation != token.generation) { ret nil; }
    ret slot;
}

fun listener_for(driver: *Driver, token: Listener) *ListenerEntry {
    if (token.index::usize >= driver.capacity
        || token.generation == 0
        || token.owner != driver.instance) {
        ret nil;
    }
    val listener: *ListenerEntry = ?driver.listeners[token.index::usize];
    if (listener.state == LISTENER_FREE || listener.generation != token.generation) { ret nil; }
    ret listener;
}

fun listener_resource(listener: *ListenerEntry) usize {
    ret listener::usize;
}

fun resource_listener(driver: *Driver, resource: usize) *ListenerEntry {
    val start: usize = driver.listeners::usize;
    val size: usize = $size_of(ListenerEntry);
    val bytes: usize = size * driver.capacity;
    if (resource < start || resource - start >= bytes || (resource - start) % size != 0) { ret nil; }
    ret resource::*ListenerEntry;
}

fun listener_index(driver: *Driver, listener: *ListenerEntry) u32 {
    ret ((listener::usize - driver.listeners::usize) / $size_of(ListenerEntry))::u32;
}

fun listener_claim(driver: *Driver) *ListenerEntry {
    var i: usize = 0;
    for (i < driver.capacity) {
        val listener: *ListenerEntry = ?driver.listeners[i];
        if (listener.state == LISTENER_FREE) { ret listener; }
        i = i + 1;
    }
    ret nil;
}

fun stream_for(driver: *Driver, token: Stream) *StreamEntry {
    if (token.index::usize >= driver.capacity || token.generation == 0 || token.owner != driver.instance) { ret nil; }
    val stream: *StreamEntry = ?driver.streams[token.index::usize];
    if (stream.state == STREAM_FREE || stream.generation != token.generation) { ret nil; }
    ret stream;
}

fun stream_index(driver: *Driver, stream: *StreamEntry) u32 {
    ret ((stream::usize - driver.streams::usize) / $size_of(StreamEntry))::u32;
}

fun stream_claim(driver: *Driver) *StreamEntry {
    var i: usize = 0;
    for (i < driver.capacity) {
        val stream: *StreamEntry = ?driver.streams[i];
        if (stream.state == STREAM_FREE) { ret stream; }
        i = i + 1;
    }
    ret nil;
}

fun stream_resource(stream: *StreamEntry) usize { ret stream::usize; }

fun resource_stream(driver: *Driver, resource: usize) *StreamEntry {
    val start: usize = driver.streams::usize;
    val size: usize = $size_of(StreamEntry);
    val bytes: usize = size * driver.capacity;
    if (resource < start || resource - start >= bytes || (resource - start) % size != 0) { ret nil; }
    ret resource::*StreamEntry;
}

fun close_all_streams_locked(driver: *Driver) {
    var i: usize = 0;
    for (i < driver.capacity) {
        val stream: *StreamEntry = ?driver.streams[i];
        if (stream.state == STREAM_OPEN) {
            val code: i64 = impl.close_resource(?driver.backend, stream.value.handle);
            if (driver.cleanup_code >= 0 && code < 0) { driver.cleanup_code = code; }
            stream.value.handle = io_handle.INVALID_VALUE;
            stream.state = STREAM_FREE;
        }
        i = i + 1;
    }
}

$if ($mach.build.os == $mach.os.windows) {
    fun windows_test_endpoint() Result[endpoint.Endpoint, io_error.Error] {
        val prefix: *u8 = "mach-std-async-local-flags-";
        var name: [108]u8;
        var length: usize = 0;
        for (prefix[length] != 0) {
            name[length] = prefix[length];
            length = length + 1;
        }
        var process: u64 = os.getpid()::u64;
        var digits: [20]u8;
        var count: usize = 0;
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process = process / 10;
            count = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            name[length] = digits[count - i - 1];
            length = length + 1;
            i = i + 1;
        }
        ret endpoint.filesystem_bytes(?name[0], length);
    }

    test "async local windows: native handles are nonblocking and non-inheritable" {
        if (windows_os.running_under_wine()) { ret 0; }
        val endpoint_result: Result[endpoint.Endpoint, io_error.Error] = windows_test_endpoint();
        if (is_err[endpoint.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
        val bound: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](endpoint_result);
        var runtime: io_runtime.Runtime;
        if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 8))) { ret 2; }
        var driver: Driver;
        if (is_err[bool, io_error.Error](make(?driver, ?runtime))) { ret 3; }
        var scope: cancel.Scope;
        if (!cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0})) { ret 4; }
        val options: types.BindOptions = local.default_bind_options();
        if (is_err[io_runtime.Token, io_error.Error](submit_bind(?driver, ?scope, bound, options, 401))) { ret 5; }
        var output: [8]io_runtime.Completion;
        var waited: Result[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
        if (is_err[usize, io_error.Error](waited) || unwrap_ok[usize, io_error.Error](waited) != 1) { ret 6; }
        val listener_result: Result[Listener, io_error.Error] = bound_listener(?driver, output[0]);
        if (is_err[Listener, io_error.Error](listener_result)) { ret 7; }
        var listener: Listener = unwrap_ok[Listener, io_error.Error](listener_result);
        if (is_err[io_runtime.Token, io_error.Error](submit_listen(?driver, ?scope, ?listener, 8, 402))) { ret 8; }
        waited = wait(?driver, ?output[0], 8, 1000);
        if (is_err[usize, io_error.Error](waited)
            || unwrap_ok[usize, io_error.Error](waited) != 1
            || is_err[bool, io_error.Error](listening(?driver, output[0]))) {
            ret 9;
        }
        if (is_err[io_runtime.Token, io_error.Error](submit_accept(?driver, ?scope, ?listener, 403))
            || is_err[io_runtime.Token, io_error.Error](submit_connect(?driver, ?scope, bound, 404))) {
            ret 10;
        }
        var server: Stream;
        var client: Stream;
        var saw_server: bool = false;
        var saw_client: bool = false;
        var rounds: usize = 0;
        for (rounds < 8 && (!saw_server || !saw_client)) {
            waited = wait(?driver, ?output[0], 8, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 11; }
            val count: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < count) {
                if (output[i].context == 403) {
                    val made: Result[Stream, io_error.Error] = accepted(?driver, output[i]);
                    if (is_err[Stream, io_error.Error](made)) { ret 12; }
                    server = unwrap_ok[Stream, io_error.Error](made);
                    saw_server = true;
                } or (output[i].context == 404) {
                    val made: Result[Stream, io_error.Error] = connected(?driver, output[i]);
                    if (is_err[Stream, io_error.Error](made)) { ret 13; }
                    client = unwrap_ok[Stream, io_error.Error](made);
                    saw_client = true;
                }
                i = i + 1;
            }
            rounds = rounds + 1;
        }
        if (!saw_server || !saw_client) { ret 14; }
        mutex.lock(?driver.lock);
        val listener_entry: *ListenerEntry = listener_for(?driver, listener);
        val server_entry: *StreamEntry = stream_for(?driver, server);
        val client_entry: *StreamEntry = stream_for(?driver, client);
        if (listener_entry == nil || server_entry == nil || client_entry == nil) {
            mutex.unlock(?driver.lock);
            ret 15;
        }
        var inheritable: bool = true;
        val listener_flags: i64 = os.sock_inheritable(listener_entry.value.handle, ?inheritable);
        val listener_inheritable: bool = inheritable;
        inheritable = true;
        val server_flags: i64 = os.sock_inheritable(server_entry.value.handle, ?inheritable);
        val server_inheritable: bool = inheritable;
        inheritable = true;
        val client_flags: i64 = os.sock_inheritable(client_entry.value.handle, ?inheritable);
        val client_inheritable: bool = inheritable;
        var byte: u8 = 0;
        val server_read: i64 = os.sock_recv(server_entry.value.handle, ?byte, 1);
        val client_read: i64 = os.sock_recv(client_entry.value.handle, ?byte, 1);
        var address: [128]u8;
        var address_length: u32 = 128;
        var unexpected: usize = io_handle.INVALID_VALUE;
        val listener_accept: i64 = os.sock_accept_flags(
            listener_entry.value.handle,
            ?address[0],
            ?address_length,
            false,
            true,
            ?unexpected,
        );
        mutex.unlock(?driver.lock);
        if (unexpected != io_handle.INVALID_VALUE) { os.sock_close(unexpected); }
        if (listener_flags < 0
            || server_flags < 0
            || client_flags < 0
            || listener_inheritable
            || server_inheritable
            || client_inheritable
            || listener_accept != os.EAGAIN
            || server_read != os.EAGAIN
            || client_read != os.EAGAIN) {
            ret 16;
        }
        if (!cancel.destroy(?scope)) { ret 17; }
        var close_scope: cancel.Scope;
        if (!cancel.make_root(?close_scope, false, time.Time{sec: 0, nsec: 0})
            || is_err[io_runtime.Token, io_error.Error](submit_stream_close(?driver, ?close_scope, ?server, lifecycle.ABORTIVE, 405))
            || is_err[io_runtime.Token, io_error.Error](submit_stream_close(?driver, ?close_scope, ?client, lifecycle.ABORTIVE, 406))
            || is_err[io_runtime.Token, io_error.Error](submit_listener_close(?driver, ?close_scope, ?listener, 407))) {
            ret 18;
        }
        var closed: usize = 0;
        rounds = 0;
        for (rounds < 8 && closed < 3) {
            waited = wait(?driver, ?output[0], 8, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 19; }
            val count: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < count) {
                if (output[i].has_error || output[i].kind != io_runtime.CLOSE) { ret 20; }
                closed = closed + 1;
                i = i + 1;
            }
            rounds = rounds + 1;
        }
        if (closed != 3
            || !cancel.destroy(?close_scope)
            || is_err[bool, io_error.Error](destroy(?driver))
            || is_err[bool, io_error.Error](io_runtime.close(?runtime))
            || is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) {
            ret 21;
        }
        ret 0;
    }
}

fun close_listener_entry_locked(driver: *Driver, listener: *ListenerEntry) {
    if (listener == nil
        || listener.state == LISTENER_FREE
        || listener.state == LISTENER_BIND_PENDING
        || listener.state == LISTENER_LISTEN_PENDING
        || listener.state == LISTENER_CLOSING) {
        ret;
    }
    val closed: i64 = impl.close_resource(?driver.backend, listener.value.handle);
    var removed: i64 = 0;
    if (listener.value.ownership == types.OWNED) { removed = impl.cleanup_listener(?listener.value); }
    if (driver.cleanup_code >= 0 && closed < 0) { driver.cleanup_code = closed; }
    if (driver.cleanup_code >= 0 && removed < 0) { driver.cleanup_code = removed; }
    listener.value.handle = io_handle.INVALID_VALUE;
    listener.state = LISTENER_FREE;
}

fun close_all_listeners_locked(driver: *Driver) {
    var i: usize = 0;
    for (i < driver.capacity) {
        close_listener_entry_locked(driver, ?driver.listeners[i]);
        i = i + 1;
    }
}

fun publish_backend_locked(driver: *Driver, count: usize) {
    var i: usize = 0;
    for (i < count) {
        var native: async_types.NativeCompletion;
        if (impl.completion(?driver.backend, i, ?native) < 0) {
            panic.panic("std.net.async.local: target completion ownership failed\n");
        }
        resolve_native_locked(driver, native);
        i = i + 1;
    }
}

fun source_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    val driver: *Driver = context::*Driver;
    mutex.lock(?driver.lock);
    var claimed: bool = false;
    var count: i64 = 0;
    if (native_context == 0) {
        count = impl.flush(?driver.backend);
    } or {
        count = impl.dispatch(?driver.backend, native_context, events, status, flags, ?claimed);
    }
    if (count < 0) {
        mutex.unlock(?driver.lock);
        panic.panic("std.net.async.local: native dispatch failed\n");
    }
    publish_backend_locked(driver, count::usize);
    mutex.unlock(?driver.lock);
    ret claimed;
}

fun source_cancel(context: ptr, token: io_runtime.Token, reason: io_error.Error) i64 {
    val driver: *Driver = context::*Driver;
    val controlled: Result[bool, io_error.Error] = io_runtime.begin_native_control(driver.runtime);
    if (is_err[bool, io_error.Error](controlled)) {
        ret unwrap_err[bool, io_error.Error](controlled).code;
    }
    mutex.lock(?driver.lock);
    val slot: *Slot = slot_for(driver, token);
    var code: i64 = 0;
    if (slot != nil && slot.native_active) {
        code = impl.cancel(?driver.backend, slot.native);
        if (code >= 0) { slot.native_active = false; }
    }
    mutex.unlock(?driver.lock);
    io_runtime.end_native_control(driver.runtime);
    ret code;
}

fun source_release(context: ptr, completion: *io_runtime.Completion) {
    val driver: *Driver = context::*Driver;
    mutex.lock(?driver.lock);
    cleanup_locked(driver, completion);
    mutex.unlock(?driver.lock);
}

pub fun make(driver: *Driver, runtime: *io_runtime.Runtime) Result[bool, io_error.Error] {
    if (driver == nil || runtime == nil || runtime.capacity == 0) {
        ret err[bool, io_error.Error](invalid(io_error.OP_CREATE));
    }
    val capacity: usize = runtime.capacity;
    val slot_size: usize = $size_of(Slot);
    val bytes: usize = slot_size * capacity;
    val listener_size: usize = $size_of(ListenerEntry);
    val listener_bytes: usize = listener_size * capacity;
    val stream_size: usize = $size_of(StreamEntry);
    val stream_bytes: usize = stream_size * capacity;
    if (bytes / slot_size != capacity
        || listener_bytes / listener_size != capacity
        || stream_bytes / stream_size != capacity) {
        ret err[bool, io_error.Error](exhausted(io_error.OP_CREATE));
    }
    driver.slots = os.allocate(bytes)::*Slot;
    if (driver.slots == nil) {
        ret err[bool, io_error.Error](exhausted(io_error.OP_CREATE));
    }
    driver.listeners = os.allocate(listener_bytes)::*ListenerEntry;
    if (driver.listeners == nil) {
        os.deallocate(driver.slots::ptr, bytes);
        driver.slots = nil;
        ret err[bool, io_error.Error](exhausted(io_error.OP_CREATE));
    }
    driver.streams = os.allocate(stream_bytes)::*StreamEntry;
    if (driver.streams == nil) {
        os.deallocate(driver.listeners::ptr, listener_bytes);
        os.deallocate(driver.slots::ptr, bytes);
        driver.listeners = nil;
        driver.streams = nil;
        driver.slots = nil;
        ret err[bool, io_error.Error](exhausted(io_error.OP_CREATE));
    }
    val instance: i64 = atomic.fetch_add(?next_driver_instance, 1) + 1;
    if (instance <= 0) {
        os.deallocate(driver.streams::ptr, stream_bytes);
        os.deallocate(driver.listeners::ptr, listener_bytes);
        os.deallocate(driver.slots::ptr, bytes);
        driver.listeners = nil;
        driver.streams = nil;
        driver.slots = nil;
        ret err[bool, io_error.Error](exhausted(io_error.OP_CREATE));
    }
    driver.runtime = runtime;
    driver.instance = instance::u64;
    driver.capacity = capacity;
    driver.backend_destroyed = false;
    driver.cleanup_code = 0;
    driver.lock = mutex.make();
    var i: usize = 0;
    for (i < capacity) {
        driver.slots[i].state = SLOT_FREE;
        driver.slots[i].generation = 0;
        driver.slots[i].native_active = false;
        driver.slots[i].listener_index = NONE;
        driver.slots[i].stream_index = NONE;
        driver.listeners[i].state = LISTENER_FREE;
        driver.listeners[i].generation = 0;
        driver.streams[i].state = STREAM_FREE;
        driver.streams[i].generation = 0;
        i = i + 1;
    }
    val registered: Result[io_runtime.SourceToken, io_error.Error] = io_runtime.register_source(
        runtime,
        driver::ptr,
        source_dispatch,
        source_cancel,
        source_release,
    );
    if (is_err[io_runtime.SourceToken, io_error.Error](registered)) {
        os.deallocate(driver.streams::ptr, stream_bytes);
        os.deallocate(driver.listeners::ptr, listener_bytes);
        os.deallocate(driver.slots::ptr, bytes);
        driver.listeners = nil;
        driver.streams = nil;
        driver.slots = nil;
        driver.runtime = nil;
        driver.capacity = 0;
        ret err[bool, io_error.Error](unwrap_err[io_runtime.SourceToken, io_error.Error](registered));
    }
    driver.source = unwrap_ok[io_runtime.SourceToken, io_error.Error](registered);
    val code: i64 = impl.make(?driver.backend, ?runtime.queue, capacity, io_runtime.source_id(driver.source));
    if (code < 0) {
        io_runtime.unregister_source(runtime, driver.source);
        os.deallocate(driver.streams::ptr, stream_bytes);
        os.deallocate(driver.listeners::ptr, listener_bytes);
        os.deallocate(driver.slots::ptr, bytes);
        driver.listeners = nil;
        driver.streams = nil;
        driver.slots = nil;
        driver.runtime = nil;
        driver.capacity = 0;
        ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_CREATE));
    }
    ret ok[bool, io_error.Error](true);
}

fun claim_locked(
    driver: *Driver,
    scope: *cancel.Scope,
    kind: io_runtime.Kind,
    resource: usize,
    buffer: *u8,
    length: usize,
    context: usize,
    token: *io_runtime.Token,
) Result[bool, io_error.Error] {
    val operation: io_runtime.Operation = io_runtime.Operation{
        kind: kind,
        resource: resource,
        buffer: buffer,
        length: length,
        offset: 0,
        context: context,
    };
    val submitted: Result[io_runtime.Token, io_error.Error] = io_runtime.submit_scoped_owned(driver.runtime, driver.source, scope, operation);
    if (is_err[io_runtime.Token, io_error.Error](submitted)) {
        ret err[bool, io_error.Error](unwrap_err[io_runtime.Token, io_error.Error](submitted));
    }
    @token = unwrap_ok[io_runtime.Token, io_error.Error](submitted);
    if (token.index::usize >= driver.capacity || driver.slots[token.index::usize].state != SLOT_FREE) {
        io_runtime.fail(driver.runtime, @token, io_error.from_code(os.EBUSY, io_error.OP_SUBMIT));
        ret ok[bool, io_error.Error](false);
    }
    val slot: *Slot = ?driver.slots[token.index::usize];
    slot.state = SLOT_ACTIVE;
    slot.generation = token.generation;
    slot.native_active = false;
    slot.listener_index = NONE;
    slot.stream_index = NONE;
    slot.kind = kind;
    slot.resource = resource;
    ret ok[bool, io_error.Error](true);
}

fun publish_submission(driver: *Driver, token: io_runtime.Token, native: async_types.Token, code: i64) {
    val slot: *Slot = slot_for(driver, token);
    if (slot == nil) { ret; }
    if (code >= 0) {
        slot.native = native;
        slot.native_active = true;
    } or {
        io_runtime.fail(driver.runtime, token, io_error.from_code(code, operation_for_kind(slot.kind)));
    }
}

pub fun submit_bind(
    driver: *Driver,
    scope: *cancel.Scope,
    bound: endpoint.Endpoint,
    options: types.BindOptions,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || !endpoint.supported(bound)) {
        ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_BIND));
    }
    mutex.lock(?driver.lock);
    val listener: *ListenerEntry = listener_claim(driver);
    if (listener == nil) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](exhausted(io_error.OP_BIND));
    }
    var token: io_runtime.Token;
    val claimed: Result[bool, io_error.Error] = claim_locked(
        driver,
        scope,
        io_runtime.BIND,
        io_handle.INVALID_VALUE,
        nil,
        0,
        context,
        ?token,
    );
    if (is_err[bool, io_error.Error](claimed)) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](unwrap_err[bool, io_error.Error](claimed));
    }
    if (unwrap_ok[bool, io_error.Error](claimed)) {
        val bound_result: Result[types.Listener, io_error.Error] = local.bind(bound, options);
        if (is_err[types.Listener, io_error.Error](bound_result)) {
            io_runtime.fail(driver.runtime, token, unwrap_err[types.Listener, io_error.Error](bound_result));
        } or {
            listener.value = unwrap_ok[types.Listener, io_error.Error](bound_result);
            var generation: u32 = listener.generation + 1;
            if (generation == 0) { generation = 1; }
            listener.generation = generation;
            listener.state = LISTENER_BIND_PENDING;
            val slot: *Slot = slot_for(driver, token);
            slot.resource = listener.value.handle;
            slot.listener_index = listener_index(driver, listener);
            listener.bind_token = token;
            io_runtime.complete(driver.runtime, token, 0, listener_resource(listener), false);
        }
    }
    mutex.unlock(?driver.lock);
    ret ok[io_runtime.Token, io_error.Error](token);
}

pub fun bound_listener(driver: *Driver, completion: io_runtime.Completion) Result[Listener, io_error.Error] {
    if (driver == nil || completion.kind != io_runtime.BIND || completion.has_error) {
        if (completion.has_error) { ret err[Listener, io_error.Error](completion.error); }
        ret err[Listener, io_error.Error](invalid(io_error.OP_BIND));
    }
    mutex.lock(?driver.lock);
    val listener: *ListenerEntry = resource_listener(driver, completion.resource);
    if (listener == nil
        || listener.bind_token.index != completion.token.index
        || listener.bind_token.generation != completion.token.generation
        || listener.state != LISTENER_BOUND) {
        mutex.unlock(?driver.lock);
        ret err[Listener, io_error.Error](io_error.from_code(os.EBADF, io_error.OP_BIND));
    }
    val value: Listener = Listener{index: listener_index(driver, listener), generation: listener.generation, owner: driver.instance};
    mutex.unlock(?driver.lock);
    ret ok[Listener, io_error.Error](value);
}

pub fun submit_listen(
    driver: *Driver,
    scope: *cancel.Scope,
    listener: *Listener,
    backlog: i32,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || listener == nil || backlog <= 0) {
        ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_LISTEN));
    }
    mutex.lock(?driver.lock);
    val entry: *ListenerEntry = listener_for(driver, @listener);
    if (entry == nil || entry.state != LISTENER_BOUND) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](io_error.from_code(os.EBADF, io_error.OP_LISTEN));
    }
    var token: io_runtime.Token;
    val claimed: Result[bool, io_error.Error] = claim_locked(
        driver,
        scope,
        io_runtime.LISTEN,
        listener_resource(entry),
        nil,
        0,
        context,
        ?token,
    );
    if (is_err[bool, io_error.Error](claimed)) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](unwrap_err[bool, io_error.Error](claimed));
    }
    if (unwrap_ok[bool, io_error.Error](claimed)) {
        val started: Result[bool, io_error.Error] = local.listener_start(?entry.value, backlog);
        val slot: *Slot = slot_for(driver, token);
        slot.listener_index = listener_index(driver, entry);
        entry.listen_token = token;
        if (is_err[bool, io_error.Error](started)) {
            io_runtime.fail(driver.runtime, token, unwrap_err[bool, io_error.Error](started));
        } or {
            entry.state = LISTENER_LISTEN_PENDING;
            io_runtime.complete(driver.runtime, token, 0, listener_resource(entry), false);
        }
    }
    mutex.unlock(?driver.lock);
    ret ok[io_runtime.Token, io_error.Error](token);
}

pub fun listening(driver: *Driver, completion: io_runtime.Completion) Result[bool, io_error.Error] {
    if (driver == nil || completion.kind != io_runtime.LISTEN || completion.has_error) {
        if (completion.has_error) { ret err[bool, io_error.Error](completion.error); }
        ret err[bool, io_error.Error](invalid(io_error.OP_LISTEN));
    }
    mutex.lock(?driver.lock);
    val listener: *ListenerEntry = resource_listener(driver, completion.resource);
    val active: bool = listener != nil
        && listener.listen_token.index == completion.token.index
        && listener.listen_token.generation == completion.token.generation
        && listener.state == LISTENER_LISTENING;
    mutex.unlock(?driver.lock);
    if (!active) { ret err[bool, io_error.Error](io_error.from_code(os.EBADF, io_error.OP_LISTEN)); }
    ret ok[bool, io_error.Error](true);
}

# managed listeners must rename through their owning driver
pub fun listener_rename(
    driver: *Driver,
    listener: *Listener,
    replacement: endpoint.Endpoint,
) Result[bool, io_error.Error] {
    val target_capabilities: endpoint.Capabilities = endpoint.capabilities();
    if (!target_capabilities.listener_rename) {
        ret err[bool, io_error.Error](io_error.from_code(os.ENOTSUP, io_error.OP_OPTION));
    }
    if (driver == nil
        || listener == nil
        || replacement.kind != endpoint.FILESYSTEM
        || !endpoint.supported(replacement)) {
        ret err[bool, io_error.Error](invalid(io_error.OP_OPTION));
    }
    mutex.lock(?driver.lock);
    val entry: *ListenerEntry = listener_for(driver, @listener);
    if (entry == nil
        || entry.value.ownership != types.OWNED
        || entry.value.endpoint.kind != endpoint.FILESYSTEM
        || (entry.state != LISTENER_BOUND && entry.state != LISTENER_LISTENING)) {
        mutex.unlock(?driver.lock);
        ret err[bool, io_error.Error](io_error.from_code(os.EBADF, io_error.OP_OPTION));
    }
    val code: i64 = impl.rename_listener(?entry.value, replacement);
    if (code >= 0) {
        entry.value.endpoint = replacement;
    }
    mutex.unlock(?driver.lock);
    if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    ret ok[bool, io_error.Error](true);
}

pub fun submit_accept(
    driver: *Driver,
    scope: *cancel.Scope,
    listener: *Listener,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || listener == nil) {
        ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_ACCEPT));
    }
    mutex.lock(?driver.lock);
    val entry: *ListenerEntry = listener_for(driver, @listener);
    if (entry == nil || entry.state != LISTENER_LISTENING) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](io_error.from_code(os.EBADF, io_error.OP_ACCEPT));
    }
    val stream: *StreamEntry = stream_claim(driver);
    if (stream == nil) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](exhausted(io_error.OP_ACCEPT));
    }
    var token: io_runtime.Token;
    val claimed: Result[bool, io_error.Error] = claim_locked(driver, scope, io_runtime.ACCEPT, entry.value.handle, nil, 0, context, ?token);
    if (is_err[bool, io_error.Error](claimed)) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](unwrap_err[bool, io_error.Error](claimed));
    }
    if (unwrap_ok[bool, io_error.Error](claimed)) {
        var generation: u32 = stream.generation + 1;
        if (generation == 0) { generation = 1; }
        stream.generation = generation;
        stream.state = STREAM_PENDING;
        stream.value.handle = io_handle.INVALID_VALUE;
        stream.value.server_side = true;
        stream.completion_token = token;
        val slot: *Slot = slot_for(driver, token);
        slot.stream_index = stream_index(driver, stream);
        var native: async_types.Token;
        val code: i64 = impl.submit_accept(?driver.backend, entry.value.handle, token_context(token), ?native);
        publish_submission(driver, token, native, code);
    }
    mutex.unlock(?driver.lock);
    ret ok[io_runtime.Token, io_error.Error](token);
}

pub fun submit_connect(
    driver: *Driver,
    scope: *cancel.Scope,
    remote: endpoint.Endpoint,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || !endpoint.supported(remote)) {
        ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_CONNECT));
    }
    var resource: usize = io_handle.INVALID_VALUE;
    val created: i64 = impl.create_connect(remote, ?resource);
    if (created < 0) {
        ret err[io_runtime.Token, io_error.Error](io_error.from_code(created, io_error.OP_CONNECT));
    }
    mutex.lock(?driver.lock);
    val stream: *StreamEntry = stream_claim(driver);
    if (stream == nil) {
        impl.close_resource(?driver.backend, resource);
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](exhausted(io_error.OP_CONNECT));
    }
    var token: io_runtime.Token;
    val claimed: Result[bool, io_error.Error] = claim_locked(driver, scope, io_runtime.CONNECT, resource, nil, 0, context, ?token);
    if (is_err[bool, io_error.Error](claimed)) {
        impl.close_resource(?driver.backend, resource);
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](unwrap_err[bool, io_error.Error](claimed));
    }
    if (unwrap_ok[bool, io_error.Error](claimed)) {
        val slot: *Slot = slot_for(driver, token);
        var generation: u32 = stream.generation + 1;
        if (generation == 0) { generation = 1; }
        stream.generation = generation;
        stream.state = STREAM_PENDING;
        stream.value.handle = resource;
        stream.value.server_side = false;
        stream.completion_token = token;
        slot.stream_index = stream_index(driver, stream);
        var native: async_types.Token;
        val code: i64 = impl.submit_connect(?driver.backend, resource, remote, token_context(token), ?native);
        publish_submission(driver, token, native, code);
    } or {
        impl.close_resource(?driver.backend, resource);
    }
    mutex.unlock(?driver.lock);
    ret ok[io_runtime.Token, io_error.Error](token);
}

fun submit_buffer(
    driver: *Driver,
    scope: *cancel.Scope,
    kind: io_runtime.Kind,
    stream: *Stream,
    buffer: *u8,
    length: usize,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || stream == nil || (buffer == nil && length != 0)) {
        ret err[io_runtime.Token, io_error.Error](invalid(operation_for_kind(kind)));
    }
    mutex.lock(?driver.lock);
    val entry: *StreamEntry = stream_for(driver, @stream);
    if (entry == nil || entry.state != STREAM_OPEN) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](io_error.from_code(os.EBADF, operation_for_kind(kind)));
    }
    val resource: usize = entry.value.handle;
    var token: io_runtime.Token;
    val claimed: Result[bool, io_error.Error] = claim_locked(driver, scope, kind, resource, buffer, length, context, ?token);
    if (is_err[bool, io_error.Error](claimed)) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](unwrap_err[bool, io_error.Error](claimed));
    }
    if (unwrap_ok[bool, io_error.Error](claimed)) {
        var native: async_types.Token;
        var code: i64 = os.EINVAL;
        if (kind == io_runtime.READ) {
            code = impl.submit_read(?driver.backend, resource, buffer, length, token_context(token), ?native);
        } or {
            code = impl.submit_write(?driver.backend, resource, buffer, length, token_context(token), ?native);
        }
        publish_submission(driver, token, native, code);
    }
    mutex.unlock(?driver.lock);
    ret ok[io_runtime.Token, io_error.Error](token);
}

pub fun submit_read(driver: *Driver, scope: *cancel.Scope, stream: *Stream, buffer: *u8, length: usize, context: usize) Result[io_runtime.Token, io_error.Error] {
    ret submit_buffer(driver, scope, io_runtime.READ, stream, buffer, length, context);
}

pub fun submit_write(driver: *Driver, scope: *cancel.Scope, stream: *Stream, buffer: *u8, length: usize, context: usize) Result[io_runtime.Token, io_error.Error] {
    ret submit_buffer(driver, scope, io_runtime.WRITE, stream, buffer, length, context);
}

fun submit_stream_control(
    driver: *Driver,
    scope: *cancel.Scope,
    stream: *Stream,
    kind: io_runtime.Kind,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || stream == nil) {
        ret err[io_runtime.Token, io_error.Error](invalid(operation_for_kind(kind)));
    }
    mutex.lock(?driver.lock);
    val entry: *StreamEntry = stream_for(driver, @stream);
    if (entry == nil || entry.state != STREAM_OPEN) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](io_error.from_code(os.EBADF, operation_for_kind(kind)));
    }
    val resource: usize = entry.value.handle;
    var token: io_runtime.Token;
    val claimed: Result[bool, io_error.Error] = claim_locked(driver, scope, kind, resource, nil, 0, context, ?token);
    if (is_err[bool, io_error.Error](claimed)) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](unwrap_err[bool, io_error.Error](claimed));
    }
    if (unwrap_ok[bool, io_error.Error](claimed)) {
        var native: async_types.Token;
        var code: i64 = os.EINVAL;
        if (kind == io_runtime.SHUTDOWN) {
            code = impl.submit_shutdown_write(?driver.backend, resource, token_context(token), ?native);
        } or {
            code = impl.submit_close(?driver.backend, resource, token_context(token), ?native);
        }
        publish_submission(driver, token, native, code);
        if (kind == io_runtime.CLOSE && code >= 0) {
            val slot: *Slot = slot_for(driver, token);
            slot.stream_index = stream_index(driver, entry);
            entry.state = STREAM_CLOSING;
            stream.generation = 0;
        }
    }
    mutex.unlock(?driver.lock);
    ret ok[io_runtime.Token, io_error.Error](token);
}

pub fun submit_shutdown_write(driver: *Driver, scope: *cancel.Scope, stream: *Stream, context: usize) Result[io_runtime.Token, io_error.Error] {
    ret submit_stream_control(driver, scope, stream, io_runtime.SHUTDOWN, context);
}

pub fun submit_stream_close(
    driver: *Driver,
    scope: *cancel.Scope,
    stream: *Stream,
    mode: lifecycle.Mode,
    context: usize,
) Result[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || stream == nil || mode > lifecycle.ABORTIVE) {
        ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_CLOSE));
    }
    if (mode == lifecycle.GRACEFUL) {
        ret submit_shutdown_write(driver, scope, stream, context);
    }
    ret submit_stream_control(driver, scope, stream, io_runtime.CLOSE, context);
}

pub fun submit_listener_close(driver: *Driver, scope: *cancel.Scope, listener: *Listener, context: usize) Result[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || listener == nil) {
        ret err[io_runtime.Token, io_error.Error](invalid(io_error.OP_CLOSE));
    }
    mutex.lock(?driver.lock);
    val entry: *ListenerEntry = listener_for(driver, @listener);
    if (entry == nil || (entry.state != LISTENER_BOUND && entry.state != LISTENER_LISTENING)) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](io_error.from_code(os.EBADF, io_error.OP_CLOSE));
    }
    val resource: usize = entry.value.handle;
    val previous: u8 = entry.state;
    var token: io_runtime.Token;
    val claimed: Result[bool, io_error.Error] = claim_locked(driver, scope, io_runtime.CLOSE, resource, nil, 0, context, ?token);
    if (is_err[bool, io_error.Error](claimed)) {
        mutex.unlock(?driver.lock);
        ret err[io_runtime.Token, io_error.Error](unwrap_err[bool, io_error.Error](claimed));
    }
    var accepted: bool = false;
    if (unwrap_ok[bool, io_error.Error](claimed)) {
        val slot: *Slot = slot_for(driver, token);
        slot.listener_index = listener_index(driver, entry);
        entry.state = LISTENER_CLOSING;
        var native: async_types.Token;
        val code: i64 = impl.submit_close(?driver.backend, resource, token_context(token), ?native);
        publish_submission(driver, token, native, code);
        accepted = code >= 0;
        if (!accepted) {
            slot.listener_index = NONE;
            entry.state = previous;
        }
    }
    mutex.unlock(?driver.lock);
    if (accepted) { listener.generation = 0; }
    ret ok[io_runtime.Token, io_error.Error](token);
}

fun cleanup_locked(driver: *Driver, completion: *io_runtime.Completion) {
    val slot: *Slot = slot_for(driver, completion.token);
    if (slot == nil) { ret; }
    if (slot.native_active) {
        panic.panic("std.net.async.local: completion released before native quiescence\n");
    }
    if ((slot.kind == io_runtime.ACCEPT || slot.kind == io_runtime.CONNECT) && slot.stream_index != NONE) {
        val stream: *StreamEntry = ?driver.streams[slot.stream_index::usize];
        if (completion.has_error) {
            if (stream.value.handle != io_handle.INVALID_VALUE) { impl.close_resource(?driver.backend, stream.value.handle); }
            stream.value.handle = io_handle.INVALID_VALUE;
            stream.state = STREAM_FREE;
        } or {
            stream.value.handle = completion.resource;
            stream.state = STREAM_OPEN;
            completion.resource = stream_resource(stream);
        }
    }
    if (slot.kind == io_runtime.BIND && slot.listener_index != NONE) {
        val listener: *ListenerEntry = ?driver.listeners[slot.listener_index::usize];
        if (completion.has_error) {
            impl.close_resource(?driver.backend, listener.value.handle);
            impl.cleanup_listener(?listener.value);
            listener.value.handle = io_handle.INVALID_VALUE;
            listener.state = LISTENER_FREE;
        } or {
            listener.state = LISTENER_BOUND;
        }
    }
    if (slot.kind == io_runtime.LISTEN && slot.listener_index != NONE) {
        val listener: *ListenerEntry = ?driver.listeners[slot.listener_index::usize];
        if (completion.has_error) {
            if (listener.state == LISTENER_LISTEN_PENDING) {
                listener.state = LISTENER_LISTENING;
            } or {
                listener.state = LISTENER_BOUND;
            }
        } or {
            listener.state = LISTENER_LISTENING;
        }
    }
    if (slot.kind == io_runtime.CLOSE && slot.listener_index != NONE) {
        val listener: *ListenerEntry = ?driver.listeners[slot.listener_index::usize];
        var removed: i64 = 0;
        if (listener.value.ownership == types.OWNED) { removed = impl.cleanup_listener(?listener.value); }
        if (removed < 0 && !completion.has_error) {
            completion.has_error = true;
            completion.error = io_error.from_code(removed, io_error.OP_CLOSE);
        }
        listener.value.handle = io_handle.INVALID_VALUE;
        listener.state = LISTENER_FREE;
    }
    if (slot.kind == io_runtime.CLOSE && slot.stream_index != NONE) {
        val stream: *StreamEntry = ?driver.streams[slot.stream_index::usize];
        stream.value.handle = io_handle.INVALID_VALUE;
        stream.state = STREAM_FREE;
    }
    slot.state = SLOT_FREE;
    slot.listener_index = NONE;
    slot.stream_index = NONE;
}

fun resolve_native_locked(driver: *Driver, native: async_types.NativeCompletion) {
    var token: io_runtime.Token;
    if (!context_token(native.context, ?token)) { ret; }
    val slot: *Slot = slot_for(driver, token);
    if (slot == nil || native.kind != slot.kind) {
        if (native.kind == io_runtime.ACCEPT && native.status >= 0 && native.resource != io_handle.INVALID_VALUE) {
            os.sock_close(native.resource);
        }
        ret;
    }
    slot.native_active = false;
    var resolved: Result[bool, io_error.Error];
    if (native.status < 0) {
        resolved = io_runtime.fail(driver.runtime, token, io_error.from_code(native.status, operation_for_kind(native.kind)));
    } or {
        resolved = io_runtime.complete(driver.runtime, token, native.bytes, native.resource, native.end_of_stream);
    }
    if (is_err[bool, io_error.Error](resolved) && native.kind == io_runtime.ACCEPT && native.status >= 0 && native.resource != io_handle.INVALID_VALUE) {
        os.sock_close(native.resource);
    }
}

pub fun wait(
    driver: *Driver,
    output: *io_runtime.Completion,
    output_capacity: usize,
    timeout_ms: i32,
) Result[usize, io_error.Error] {
    if (driver == nil || output == nil || output_capacity == 0 || timeout_ms < -1) {
        ret err[usize, io_error.Error](invalid(io_error.OP_WAIT));
    }
    ret io_runtime.wait(driver.runtime, output, output_capacity, timeout_ms);
}

pub fun accepted(driver: *Driver, completion: io_runtime.Completion) Result[Stream, io_error.Error] {
    if (driver == nil || completion.kind != io_runtime.ACCEPT || completion.has_error) {
        if (completion.has_error) { ret err[Stream, io_error.Error](completion.error); }
        ret err[Stream, io_error.Error](invalid(io_error.OP_ACCEPT));
    }
    mutex.lock(?driver.lock);
    val stream: *StreamEntry = resource_stream(driver, completion.resource);
    if (stream == nil || stream.state != STREAM_OPEN
        || stream.completion_token.index != completion.token.index
        || stream.completion_token.generation != completion.token.generation) {
        mutex.unlock(?driver.lock);
        ret err[Stream, io_error.Error](io_error.from_code(os.EBADF, io_error.OP_ACCEPT));
    }
    val value: Stream = Stream{index: stream_index(driver, stream), generation: stream.generation, owner: driver.instance};
    mutex.unlock(?driver.lock);
    ret ok[Stream, io_error.Error](value);
}

pub fun connected(driver: *Driver, completion: io_runtime.Completion) Result[Stream, io_error.Error] {
    if (driver == nil || completion.kind != io_runtime.CONNECT || completion.has_error) {
        if (completion.has_error) { ret err[Stream, io_error.Error](completion.error); }
        ret err[Stream, io_error.Error](invalid(io_error.OP_CONNECT));
    }
    mutex.lock(?driver.lock);
    val stream: *StreamEntry = resource_stream(driver, completion.resource);
    if (stream == nil || stream.state != STREAM_OPEN
        || stream.completion_token.index != completion.token.index
        || stream.completion_token.generation != completion.token.generation) {
        mutex.unlock(?driver.lock);
        ret err[Stream, io_error.Error](io_error.from_code(os.EBADF, io_error.OP_CONNECT));
    }
    val value: Stream = Stream{index: stream_index(driver, stream), generation: stream.generation, owner: driver.instance};
    mutex.unlock(?driver.lock);
    ret ok[Stream, io_error.Error](value);
}

pub fun peer_identity(driver: *Driver, stream: *Stream) Result[types.PeerIdentity, io_error.Error] {
    if (driver == nil || stream == nil) { ret err[types.PeerIdentity, io_error.Error](invalid(io_error.OP_OPTION)); }
    mutex.lock(?driver.lock);
    val entry: *StreamEntry = stream_for(driver, @stream);
    if (entry == nil || entry.state != STREAM_OPEN) {
        mutex.unlock(?driver.lock);
        ret err[types.PeerIdentity, io_error.Error](io_error.from_code(os.EBADF, io_error.OP_OPTION));
    }
    val value: Result[types.PeerIdentity, io_error.Error] = local.peer_identity(?entry.value);
    mutex.unlock(?driver.lock);
    ret value;
}

pub fun destroy(driver: *Driver) Result[bool, io_error.Error] {
    if (driver == nil || driver.runtime == nil) {
        ret err[bool, io_error.Error](invalid(io_error.OP_CLOSE));
    }
    mutex.lock(?driver.lock);
    var i: usize = 0;
    for (i < driver.capacity) {
        if (driver.slots[i].state != SLOT_FREE) {
            mutex.unlock(?driver.lock);
            ret err[bool, io_error.Error](io_error.from_code(os.EBUSY, io_error.OP_CLOSE));
        }
        i = i + 1;
    }
    mutex.unlock(?driver.lock);
    val retired: Result[bool, io_error.Error] = io_runtime.retire_source(driver.runtime, driver.source);
    if (is_err[bool, io_error.Error](retired)) {
        ret err[bool, io_error.Error](unwrap_err[bool, io_error.Error](retired));
    }
    mutex.lock(?driver.lock);
    close_all_listeners_locked(driver);
    close_all_streams_locked(driver);
    if (!driver.backend_destroyed) {
        val code: i64 = impl.destroy(?driver.backend);
        if (code < 0) {
            mutex.unlock(?driver.lock);
            ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_CLOSE));
        }
        driver.backend_destroyed = true;
    }
    mutex.unlock(?driver.lock);
    val released_source: Result[bool, io_error.Error] = io_runtime.release_source(driver.runtime, driver.source);
    mutex.lock(?driver.lock);
    val bytes: usize = $size_of(Slot) * driver.capacity;
    val listener_bytes: usize = $size_of(ListenerEntry) * driver.capacity;
    val stream_bytes: usize = $size_of(StreamEntry) * driver.capacity;
    val slots_released: i64 = os.deallocate(driver.slots::ptr, bytes);
    val listeners_released: i64 = os.deallocate(driver.listeners::ptr, listener_bytes);
    val streams_released: i64 = os.deallocate(driver.streams::ptr, stream_bytes);
    driver.slots = nil;
    driver.listeners = nil;
    driver.streams = nil;
    val cleanup_code: i64 = driver.cleanup_code;
    mutex.unlock(?driver.lock);
    driver.runtime = nil;
    driver.capacity = 0;
    if (is_err[bool, io_error.Error](released_source)) {
        ret err[bool, io_error.Error](unwrap_err[bool, io_error.Error](released_source));
    }
    if (slots_released < 0 || listeners_released < 0 || streams_released < 0) {
        ret err[bool, io_error.Error](io_error.from_code(os.EIO, io_error.OP_CLOSE));
    }
    if (cleanup_code < 0) { ret err[bool, io_error.Error](io_error.from_code(cleanup_code, io_error.OP_CLOSE)); }
    ret ok[bool, io_error.Error](true);
}

test "async local: managed listener tokens are distinct from raw listeners" {
    if ($size_of(Listener) == 0
        || $size_of(Stream) == 0
        || $size_of(Driver) == 0
        || $size_of(Listener) == $size_of(types.Listener)) {
        ret 1;
    }
    ret 0;
}

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    fun test_endpoint() Result[endpoint.Endpoint, io_error.Error] {
        val prefix: *u8 = "/tmp/mach-std-async-local-502-";
        var name: [108]u8;
        var length: usize = 0;
        for (prefix[length] != 0) {
            name[length] = prefix[length];
            length = length + 1;
        }
        var process: u64 = os.getpid()::u64;
        var digits: [20]u8;
        var count: usize = 0;
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process = process / 10;
            count = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            name[length] = digits[count - i - 1];
            length = length + 1;
            i = i + 1;
        }
        name[length] = '.';
        name[length + 1] = 's';
        name[length + 2] = 'o';
        name[length + 3] = 'c';
        name[length + 4] = 'k';
        ret endpoint.filesystem_bytes(?name[0], length + 5);
    }

    fun test_endpoint_absent(value: endpoint.Endpoint) bool {
        var path: [108]u8;
        var i: usize = 0;
        for (i < value.length) { path[i] = value.name[i]; i = i + 1; }
        path[value.length] = 0;
        var status: os.stat_t;
        ret os.stat_path(os.AT_FDCWD, ?path[0], ?status, os.AT_SYMLINK_NOFOLLOW) == os.ENOENT;
    }

    fun test_endpoint_remove(value: endpoint.Endpoint) bool {
        var path: [108]u8;
        var i: usize = 0;
        for (i < value.length) { path[i] = value.name[i]; i = i + 1; }
        path[value.length] = 0;
        ret os.unlink(os.AT_FDCWD, ?path[0], 0) >= 0;
    }

    test "async local: listener stream cancellation half close and cleanup" {
        val endpoint_result: Result[endpoint.Endpoint, io_error.Error] = test_endpoint();
        if (is_err[endpoint.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
        val bound: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](endpoint_result);
        var runtime: io_runtime.Runtime;
        if (is_err[bool, io_error.Error](io_runtime.make(?runtime, 8))) { ret 2; }
        var driver: Driver;
        if (is_err[bool, io_error.Error](make(?driver, ?runtime))) {
            io_runtime.close(?runtime);
            io_runtime.destroy(?runtime);
            ret 3;
        }
        var bind_options: types.BindOptions = local.default_bind_options();
        bind_options.stale = types.REMOVE_STALE_SOCKET;
        var setup_scope: cancel.Scope;
        if (!cancel.make_root(?setup_scope, false, time.Time{sec: 0, nsec: 0})) { ret 4; }
        if (is_err[io_runtime.Token, io_error.Error](submit_bind(?driver, ?setup_scope, bound, bind_options, 99))) { ret 4; }
        var output: [8]io_runtime.Completion;
        var setup_wait: Result[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
        if (is_err[usize, io_error.Error](setup_wait) || unwrap_ok[usize, io_error.Error](setup_wait) != 1) { ret 4; }
        val listener_result: Result[Listener, io_error.Error] = bound_listener(?driver, output[0]);
        if (is_err[Listener, io_error.Error](listener_result)) { ret 4; }
        var listener: Listener = unwrap_ok[Listener, io_error.Error](listener_result);
        if (is_err[io_runtime.Token, io_error.Error](submit_listen(?driver, ?setup_scope, ?listener, 128, 100))) { ret 4; }
        setup_wait = wait(?driver, ?output[0], 8, 1000);
        if (is_err[usize, io_error.Error](setup_wait)
            || unwrap_ok[usize, io_error.Error](setup_wait) != 1
            || is_err[bool, io_error.Error](listening(?driver, output[0]))
            || !cancel.destroy(?setup_scope)) {
            ret 4;
        }

        var connection_scope: cancel.Scope;
        if (!cancel.make_root(?connection_scope, false, time.Time{sec: 0, nsec: 0})) { ret 5; }
        val accept_token: Result[io_runtime.Token, io_error.Error] = submit_accept(?driver, ?connection_scope, ?listener, 101);
        val connect_token: Result[io_runtime.Token, io_error.Error] = submit_connect(?driver, ?connection_scope, bound, 102);
        if (is_err[io_runtime.Token, io_error.Error](accept_token) || is_err[io_runtime.Token, io_error.Error](connect_token)) { ret 6; }
        var server: Stream;
        var client: Stream;
        var saw_accept: bool = false;
        var saw_connect: bool = false;
        var rounds: usize = 0;
        for ((!saw_accept || !saw_connect) && rounds < 8) {
            val waited: Result[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 7; }
            val available: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < available) {
                if (output[i].context == 101) {
                    val made: Result[Stream, io_error.Error] = accepted(?driver, output[i]);
                    if (is_err[Stream, io_error.Error](made)) { ret 8; }
                    server = unwrap_ok[Stream, io_error.Error](made);
                    saw_accept = true;
                } or (output[i].context == 102) {
                    val made: Result[Stream, io_error.Error] = connected(?driver, output[i]);
                    if (is_err[Stream, io_error.Error](made)) { ret 9; }
                    client = unwrap_ok[Stream, io_error.Error](made);
                    saw_connect = true;
                }
                i = i + 1;
            }
            rounds = rounds + 1;
        }
        if (!saw_accept || !saw_connect || !cancel.destroy(?connection_scope)) { ret 10; }

        var transfer_scope: cancel.Scope;
        if (!cancel.make_root(?transfer_scope, false, time.Time{sec: 0, nsec: 0})) { ret 11; }
        var input: [4]u8;
        var payload: [4]u8;
        payload[0] = 'l'; payload[1] = 'o'; payload[2] = 'c'; payload[3] = 'l';
        val read_token: Result[io_runtime.Token, io_error.Error] = submit_read(?driver, ?transfer_scope, ?server, ?input[0], 4, 103);
        val write_token: Result[io_runtime.Token, io_error.Error] = submit_write(?driver, ?transfer_scope, ?client, ?payload[0], 4, 104);
        if (is_err[io_runtime.Token, io_error.Error](read_token) || is_err[io_runtime.Token, io_error.Error](write_token)) { ret 12; }
        var saw_read: bool = false;
        var saw_write: bool = false;
        rounds = 0;
        for ((!saw_read || !saw_write) && rounds < 8) {
            val waited: Result[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 13; }
            val available: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < available) {
                if (output[i].has_error) { ret 14; }
                if (output[i].context == 103) {
                    if (output[i].bytes != 4) { ret 15; }
                    saw_read = true;
                } or (output[i].context == 104) {
                    if (output[i].bytes != 4) { ret 16; }
                    saw_write = true;
                }
                i = i + 1;
            }
            rounds = rounds + 1;
        }
        if (!saw_read || !saw_write || input[0] != 'l' || input[1] != 'o' || input[2] != 'c' || input[3] != 'l') { ret 17; }
        payload[0] = 'b'; payload[1] = 'a'; payload[2] = 'c'; payload[3] = 'k';
        if (is_err[io_runtime.Token, io_error.Error](submit_read(?driver, ?transfer_scope, ?client, ?input[0], 4, 111))
            || is_err[io_runtime.Token, io_error.Error](submit_write(?driver, ?transfer_scope, ?server, ?payload[0], 4, 112))) {
            ret 18;
        }
        saw_read = false;
        saw_write = false;
        rounds = 0;
        for ((!saw_read || !saw_write) && rounds < 8) {
            val waited: Result[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 19; }
            val available: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < available) {
                if (output[i].has_error || output[i].bytes != 4) { ret 20; }
                if (output[i].context == 111) { saw_read = true; }
                if (output[i].context == 112) { saw_write = true; }
                i = i + 1;
            }
            rounds = rounds + 1;
        }
        if (!saw_read || !saw_write || input[0] != 'b' || input[1] != 'a' || input[2] != 'c' || input[3] != 'k'
            || !cancel.destroy(?transfer_scope)) {
            ret 21;
        }

        var cancellation_scope: cancel.Scope;
        if (!cancel.make_root(?cancellation_scope, false, time.Time{sec: 0, nsec: 0})) { ret 22; }
        val pending_accept: Result[io_runtime.Token, io_error.Error] = submit_accept(?driver, ?cancellation_scope, ?listener, 105);
        if (is_err[io_runtime.Token, io_error.Error](pending_accept) || !cancel.cancel(?cancellation_scope)) { ret 19; }
        val cancelled_wait: Result[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
        if (is_err[usize, io_error.Error](cancelled_wait)
            || unwrap_ok[usize, io_error.Error](cancelled_wait) != 1
            || output[0].context != 105
            || !output[0].has_error
            || output[0].error.kind != io_error.CANCELLED
            || !cancel.destroy(?cancellation_scope)) {
            ret 20;
        }

        var deadline_scope: cancel.Scope;
        val deadline: time.Time = time.time_add(time.monotonic(), 1000000);
        if (!cancel.make_root(?deadline_scope, true, deadline)
            || is_err[io_runtime.Token, io_error.Error](submit_accept(?driver, ?deadline_scope, ?listener, 113))) {
            ret 21;
        }
        var deadline_wait: Result[usize, io_error.Error];
        var deadline_count: usize = 0;
        var deadline_rounds: usize = 0;
        for (deadline_count == 0 && deadline_rounds < 8) {
            deadline_wait = wait(?driver, ?output[0], 8, 1000);
            if (is_err[usize, io_error.Error](deadline_wait)) { ret 22; }
            deadline_count = unwrap_ok[usize, io_error.Error](deadline_wait);
            deadline_rounds = deadline_rounds + 1;
        }
        if (deadline_count != 1) { ret 23; }
        if (output[0].context != 113) { ret 24; }
        if (!output[0].has_error) { ret 25; }
        if (output[0].error.kind != io_error.TIMEOUT) { ret 26; }
        if (!cancel.destroy(?deadline_scope)) { ret 27; }

        var shutdown_scope: cancel.Scope;
        if (!cancel.make_root(?shutdown_scope, false, time.Time{sec: 0, nsec: 0})) { ret 21; }
        if (is_err[io_runtime.Token, io_error.Error](submit_stream_close(?driver, ?shutdown_scope, ?client, lifecycle.GRACEFUL, 106))) { ret 22; }
        val shutdown_wait: Result[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
        if (is_err[usize, io_error.Error](shutdown_wait)
            || unwrap_ok[usize, io_error.Error](shutdown_wait) != 1
            || output[0].context != 106
            || output[0].kind != io_runtime.SHUTDOWN
            || output[0].has_error
            || !cancel.destroy(?shutdown_scope)) {
            ret 23;
        }

        var eof_scope: cancel.Scope;
        if (!cancel.make_root(?eof_scope, false, time.Time{sec: 0, nsec: 0})) { ret 24; }
        if (is_err[io_runtime.Token, io_error.Error](submit_read(?driver, ?eof_scope, ?server, ?input[0], 4, 107))) { ret 25; }
        val eof_wait: Result[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
        if (is_err[usize, io_error.Error](eof_wait)
            || unwrap_ok[usize, io_error.Error](eof_wait) != 1
            || output[0].context != 107
            || output[0].has_error
            || !output[0].end_of_stream
            || !cancel.destroy(?eof_scope)) {
            ret 26;
        }

        var close_scope: cancel.Scope;
        if (!cancel.make_root(?close_scope, false, time.Time{sec: 0, nsec: 0})) { ret 27; }
        if (is_err[io_runtime.Token, io_error.Error](submit_stream_close(?driver, ?close_scope, ?client, lifecycle.ABORTIVE, 108))
            || is_err[io_runtime.Token, io_error.Error](submit_stream_close(?driver, ?close_scope, ?server, lifecycle.ABORTIVE, 109))
            || is_err[io_runtime.Token, io_error.Error](submit_listener_close(?driver, ?close_scope, ?listener, 110))) {
            ret 28;
        }
        var closed: usize = 0;
        rounds = 0;
        for (closed < 3 && rounds < 8) {
            val waited: Result[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
            if (is_err[usize, io_error.Error](waited)) { ret 29; }
            val available: usize = unwrap_ok[usize, io_error.Error](waited);
            var i: usize = 0;
            for (i < available) {
                if (output[i].has_error || output[i].kind != io_runtime.CLOSE) { ret 30; }
                closed = closed + 1;
                i = i + 1;
            }
            rounds = rounds + 1;
        }
        if (closed != 3 || !cancel.destroy(?close_scope) || !test_endpoint_absent(bound)) { ret 31; }
        if (is_err[bool, io_error.Error](destroy(?driver))) { ret 32; }
        if (is_err[bool, io_error.Error](io_runtime.close(?runtime))) { ret 33; }
        if (is_err[bool, io_error.Error](io_runtime.destroy(?runtime))) { ret 34; }
        ret 0;
    }

    test "async local: queued bind and listen success stay valid through runtime close" {
