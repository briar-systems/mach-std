# portable asynchronous network descriptors

use std.types.bool.bool;
use std.types.size.usize;
use std.net.ip;
use std.io.runtime;

pub rec Token {
    index: u32;
    generation: u32;
}

pub rec Vector {
    data: *u8;
    length: usize;
}

# packet storage is borrowed until its operation completes
pub rec Packet {
    buffer: *u8;
    capacity: usize;
    length: usize;
    peer: ip.Endpoint;
    local_destination: ip.Addr;
    interface_index: u32;
    has_local_destination: bool;
    truncated: bool;
    zero_length: bool;
}

pub rec NativeCompletion {
    context: usize;
    kind: runtime.Kind;
    bytes: usize;
    resource: usize;
    status: i64;
    end_of_stream: bool;
}
