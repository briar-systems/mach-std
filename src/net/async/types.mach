# portable asynchronous network descriptors

use std.io.runtime;
use std.net.ip;
use std.types.bool.bool;
use std.types.size.usize;

pub rec Token {
    index:      u32;
    generation: u32;
}

pub rec Vector {
    data:   *u8;
    length: usize;
}

# packet storage is borrowed until its operation completes
# ---
# buffer:   the packet's storage
# capacity: the storage size in bytes. a send refuses a length above it
# length:   bytes to send, or bytes received
pub rec Packet {
    buffer:                *u8;
    capacity:              usize;
    length:                usize;
    peer:                  ip.Endpoint;
    local_destination:     ip.Addr;
    interface_index:       u32;
    has_local_destination: bool;
    truncated:             bool;
    zero_length:           bool;
}

# the status a backend reports for an operation left pending on a socket that
# was closed outside its driver. no native code has this value
pub val STATUS_STALE: i64 = -0x4000000000000000;

# the status a backend reports for an operation whose cancellation it finished
# asynchronously: the driver publishes the cancellation, never a result. no
# native code has this value
pub val STATUS_CANCELLED: i64 = -0x4000000000000001;

pub rec NativeCompletion {
    context:       usize;
    kind:          runtime.Kind;
    bytes:         usize;
    items:         usize;
    resource:      usize;
    status:        i64;
    end_of_stream: bool;
}
