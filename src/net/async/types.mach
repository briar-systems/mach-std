# portable asynchronous network descriptors

use std.types.bool.bool;
use std.types.size.usize;
use std.net.ip;

pub rec Vector {
    data: *u8;
    length: usize;
}

# packet storage is borrowed until its operation completes
pub rec Packet {
    buffer: *u8;
    capacity: usize;
    length: usize;
    peer: ip.Endpoint;
    local_destination: ip.Addr;
    interface_index: u32;
    has_local_destination: bool;
    truncated: bool;
    zero_length: bool;
}
