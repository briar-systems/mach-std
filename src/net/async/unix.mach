        sys.sock_close(client);
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }

    var input:     u8  = 0;
    var token:     types.Token;
    val submitted: i64 = submit_read(?backend, server, 1, ?input, 1, 96, ?token);
    val wake_only: i64 = poll(?backend, 0);
    var output:    u8  = 'w';
    val sent:      i64 = test_send_exact(client, ?output, 1);
    var native:    types.NativeCompletion;
    val completed: i64 = test_await_completion(?backend, 96, ?native);
    var failure:   i32 = 0;
    if (submitted != 0)              { failure = 2; }
    or (wake_only != 0)              { failure = 3; }
    or (sent != 1)                   { failure = 4; }
    or (completed != 0)              { failure = 5; }
    or (native.kind != runtime.READ) { failure = 6; }
    or (native.status != 0)          { failure = 7; }
    or (native.bytes != 1)           { failure = 8; }
    or (native.items != 0)           { failure = 9; }
    or (native.end_of_stream)        { failure = 10; }
    or (input != 'w')                { failure = 11; }
    or (backend.live != 0)           { failure = 12; }
    or (backend.resource_count != 1) { failure = 13; }
    sys.sock_close(server);
    sys.sock_close(client);
    sys.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    sys.io_queue_close(?queue);
    if (failure == 0 && destroyed < 0) { failure = 14; }
    if (failure != 0)                  { ret failure; }
    ret 0;
}

# the backend's tables come from the allocator it was made with, so a
# refusal there is the one way to reach the ENOMEM path on purpose
test async_unix__a_refused_table_growth_is_enomem_and_settles_what_is_live {
    # the tracker is too large for the stack, so it lives on the mapper
    val t: *testing.Testing = sys.allocate($size_of(testing.Testing))::*testing.Testing;
    if (t == nil) { ret 1; }
    fin { sys.deallocate(t::ptr, $size_of(testing.Testing)); }
    val tr: err[allocator.Error] = testing.make(t);
    if (sel tr.err) { ret 1; }
    fin { testing.dnit(t); }

    var queue: shared.IoQueue;
    if (sys.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, testing.allocator_of(t), 2, 1) < 0) {
        sys.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        sys.sock_close(client);
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }

    var storage: [3]u8;
    storage[0] = 0xa1;
    storage[1] = 0xb2;
    storage[2] = 0xc3;
    var tokens: [3]types.Token;
    val first:  i64                  = submit_read(?backend, server, 1, ?storage[0], 1, 89, ?tokens[0]);
    val second: i64                  = submit_read(?backend, server, 1, ?storage[1], 1, 90, ?tokens[1]);
    val held:   *readiness.Operation = readiness.operation_at(?backend, tokens[0].index::usize);
    # the third operation needs a chunk, and each allocation of that growth
    # is refused in turn; the ordinal counts refused attempts, so it is
    # re-based each time
    var refused:   usize = 0;
    var offset:    usize = 1;
    var grown:     i64   = 0;
    var disturbed: bool  = false;
    for (offset <= 8) {
        testing.fail_at_ordinal(t, testing.attempt_count(t) + offset);
        grown = submit_read(?backend, server, 1, ?storage[2], 1, 91, ?tokens[2]);
        if (grown == 0)                                                       { brk; }
        if (grown != sys.ENOMEM)                                              { disturbed = true; }
        if (readiness.operation_at(?backend, tokens[0].index::usize) != held) { disturbed = true; }
        if (held.context != 89 || held.generation != tokens[0].generation)    { disturbed = true; }
        if (backend.live != 2 || backend.operations.capacity != 2)            { disturbed = true; }
        refused = refused + 1;
        offset  = offset + 1;
    }
    testing.clear_failure(t);
    val grew:          bool = grown == 0 && refused > 0 && !disturbed && backend.operations.capacity == 4 && tokens[2].index == 2;
    val cancel_first:  i64  = cancel(?backend, tokens[0], nil);
    val cancel_second: i64  = cancel(?backend, tokens[1], nil);
    val cancel_third:  i64  = cancel(?backend, tokens[2], nil);
    var byte:          u8   = 'x';
    val sent:          i64  = test_send_exact(client, ?byte, 1);
    val after:         i64  = poll(?backend, 0);
    val valid:         bool = first == 0 && second == 0 && grew && cancel_first == 0 && cancel_second == 0 && cancel_third == 0 && sent == 1 && after == 0 && storage[0] == 0xa1 && storage[1] == 0xb2 && storage[2] == 0xc3 && backend.live == 0 && backend.resource_count == 1;
    sys.sock_close(server);
    sys.sock_close(client);
    sys.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    sys.io_queue_close(?queue);
    if (!valid || destroyed < 0)           { ret 1; }
    if (testing.leaked(t))                 { ret 2; }
    if (testing.double_free_count(t) != 0) { ret 2; }
    ret 0;
}

test async_unix__canceling_close_preserves_handle_ownership {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (sys.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, 8, 1) < 0) {
        sys.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        sys.sock_close(client);
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }

    var pending_byte:    u8   = 'z';
    var write_token:     types.Token;
    var write_submitted: i64  = sys.EIO;
    var close_token:     types.Token;
    var close_submitted: i64  = sys.EIO;
    var close_active:    bool = false;
    mutex.lock(?backend.lock);
    var write_resource:  *readiness.Resource;
    var write_operation: *readiness.Operation;
    write_submitted = readiness.begin(?backend, server, 1, runtime.WRITE, 93, readiness.LANE_WRITE, ?write_token, ?write_resource, ?write_operation);
    if (write_submitted == 0) {
        write_operation.buffer = ?pending_byte;
        write_operation.length = 1;
        var close_resource: *readiness.Resource;
        close_submitted = readiness.begin_close_locked(?backend, server, 1, 94, ?close_token, ?close_resource);
        close_active    = close_submitted == 0 && readiness.operation_for(?backend, close_token) != nil;
    }
    mutex.unlock(?backend.lock);
    val canceled:  i64 = cancel(?backend, close_token, nil);
    val raw_close: i64 = sys.sock_close(server);
    var displaced: types.NativeCompletion;
    val count:     i64 = test_collect_completions(?backend, ?displaced, 1);
    var failure:   i32 = 0;
    if (write_submitted != 0)              { failure = 2; }
    or (close_submitted != 0)              { failure = 3; }
    or (!close_active)                     { failure = 4; }
    or (canceled != 0)                     { failure = 5; }
    or (raw_close != sys.EBADF)            { failure = 6; }
    or (count != 1)                        { failure = 7; }
    or (displaced.context != 93)           { failure = 8; }
    or (displaced.kind != runtime.WRITE)   { failure = 9; }
    or (displaced.status != sys.ECANCELED) { failure = 10; }
    or (displaced.bytes != 0)              { failure = 11; }
    or (displaced.items != 0)              { failure = 12; }
    or (backend.live != 0)                 { failure = 13; }
    or (backend.resource_count != 0)       { failure = 14; }
    sys.sock_close(client);

    var second_client: usize;
    if (test_client(endpoint, ?second_client) < 0) {
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var second_server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?second_server) < 0) {
        sys.sock_close(second_client);
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var queued_token:     types.Token;
    val queued_submitted: i64  = submit_close(?backend, second_server, 1, 95, ?queued_token);
    val close_queued:     bool = backend.queued_count == 1;
    val queued_canceled:  i64  = cancel(?backend, queued_token, nil);
    val second_raw_close: i64  = sys.sock_close(second_server);
    val after:            i64  = poll(?backend, 0);
    if (failure == 0 && queued_submitted != 0)         { failure = 15; }
    or (failure == 0 && !close_queued)                 { failure = 16; }
    or (failure == 0 && queued_canceled != 0)          { failure = 17; }
    or (failure == 0 && second_raw_close != sys.EBADF) { failure = 18; }
    or (failure == 0 && after != 0)                    { failure = 19; }
    or (failure == 0 && backend.live != 0)             { failure = 20; }
    or (failure == 0 && backend.resource_count != 0)   { failure = 21; }
    sys.sock_close(second_client);
    sys.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    sys.io_queue_close(?queue);
    if (failure == 0 && destroyed < 0) { failure = 22; }
    if (failure != 0)                  { ret failure; }
    ret 0;
}

test async_unix__queued_cancellation_preserves_fifo {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (sys.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, 4, 1) < 0) {
        sys.io_queue_close(?queue);
        ret 1;
    }
    var socket: usize = (-1)::usize;
    if (sys.sock_create_flags(sys.AF_INET, sys.SOCK_DGRAM, 0, true, true, ?socket) < 0) {
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    val destination: ip.Endpoint = ip.endpoint(127, 0, 0, 1, 9);
    var packets:     [3]types.Packet;
    var i:           usize       = 0;
    for (i < 3) {
        packets[i].buffer                = nil;
        packets[i].capacity              = 0;
        packets[i].length                = 0;
        packets[i].peer                  = destination;
        packets[i].has_local_destination = false;
        packets[i].interface_index       = 0;
        i                                = i + 1;
    }
    var tokens:      [3]types.Token;
    val first:       i64 = submit_send_batch(?backend, socket, 1, ?packets[0], 1, 11, ?tokens[0]);
    val second:      i64 = submit_send_batch(?backend, socket, 1, ?packets[1], 1, 22, ?tokens[1]);
    val third:       i64 = submit_send_batch(?backend, socket, 1, ?packets[2], 1, 33, ?tokens[2]);
    val cancelled:   i64 = cancel(?backend, tokens[1], nil);
    var completions: [2]types.NativeCompletion;
    val count:       i64 = test_collect_completions(?backend, ?completions[0], 2);
    var a:           types.NativeCompletion;
    var b:           types.NativeCompletion;
    if (count == 2) {
        a = completions[0];
        b = completions[1];
    }
    val valid: bool = first == 0 && second == 0 && third == 0 && cancelled == 0 && count == 2 && a.context == 11 && b.context == 33 && a.kind == runtime.SEND_TO && b.kind == runtime.SEND_TO && backend.live == 0 && backend.resource_count == 1;
    sys.sock_close(socket);
    val destroyed: i64 = destroy(?backend);
    sys.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test async_unix__shutdown_and_close_follow_prior_writes {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (sys.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, 8, 1) < 0) {
        sys.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        sys.sock_close(client);
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }

    var first:          u8   = 'a';
    var second:         u8   = 'b';
    var tokens:         [5]types.Token;
    val write_first:    i64  = submit_write(?backend, server, 1, ?first, 1, 71, ?tokens[0]);
    val write_second:   i64  = submit_write(?backend, server, 1, ?second, 1, 72, ?tokens[1]);
    val shutdown:       i64  = submit_shutdown_write(?backend, server, 1, 73, ?tokens[2]);
    var received:       [2]u8;
    val received_bytes: i64  = test_receive_exact(client, ?received[0], 2);
    var eof_byte:       u8   = 0;
    val eof:            i64  = sys.sock_recv(client, ?eof_byte, 1);
    var pending:        u8   = 0;
    val read_pending:   i64  = submit_read(?backend, server, 1, ?pending, 1, 74, ?tokens[3]);
    val close_pending:  i64  = submit_close(?backend, server, 1, 75, ?tokens[4]);
    var completions:    [5]types.NativeCompletion;
    val count:          i64  = test_collect_completions(?backend, ?completions[0], 5);
    var valid_order:    bool = count == 5;
    var expected:       [5]usize;
    expected[0] = 71;
    expected[1] = 72;
    expected[2] = 73;
    expected[3] = 74;
    expected[4] = 75;
    var i: usize = 0;
    for (count == 5 && i < 5) {
        val native: types.NativeCompletion = completions[i];
        if (native.context != expected[i])                                                { valid_order = false; }
        if (native.context == 74 && native.status != sys.ECANCELED)                       { valid_order = false; }
        if (native.context == 75 && (native.kind != runtime.CLOSE || native.status != 0)) { valid_order = false; }
        i = i + 1;
    }
    var failure: i32 = 0;
    if (write_first != 0)                         { failure = 2; }
    or (write_second != 0)                        { failure = 3; }
    or (shutdown != 0)                            { failure = 4; }
    or (read_pending != 0)                        { failure = 5; }
    or (close_pending != 0)                       { failure = 6; }
    or (received_bytes != 2)                      { failure = 7; }
    or (received[0] != 'a' || received[1] != 'b') { failure = 8; }
    or (eof != 0)                                 { failure = 9; }
    or (!valid_order)                             { failure = 10; }
    or (backend.resource_count != 0)              { failure = 11; }
    sys.sock_close(client);
    sys.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    sys.io_queue_close(?queue);
    if (failure == 0 && destroyed < 0) { failure = 12; }
    if (failure != 0)                  { ret failure; }
    ret 0;
}

test async_unix__queued_accept_cancellation_closes_handle {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (sys.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, 4, 1) < 0) {
        sys.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var peer:      ip.Endpoint;
    var token:     types.Token;
    val submitted: i64   = submit_accept(?backend, listener, 1, ?peer, 44, ?token);
    var accepted:  usize = (-1)::usize;
    if (submitted == 0 && backend.queued_count == 1) { accepted = readiness.operation_at(?backend, backend.queued_head::usize).completion.resource; }
    val cancelled: i64  = cancel(?backend, token, nil);
    val closed:    i64  = sys.sock_close(accepted);
    val valid:     bool = submitted == 0 && cancelled == 0 && accepted != (-1)::usize && closed == sys.EBADF && backend.live == 0 && backend.queued_count == 0 && backend.resource_count == 1;
    sys.sock_close(client);
    sys.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    sys.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

test async_unix__one_stream_drives_concurrent_read_and_write {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (sys.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, 8, 1) < 0) {
        sys.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var client: usize;
    if (test_client(endpoint, ?client) < 0) {
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var server: usize = (-1)::usize;
    if (stream_accept(listener, nil, ?server) < 0) {
        sys.sock_close(client);
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }

    var input:  [4]u8;
    var output: [4]u8;
    output[0] = 'p';
    output[1] = 'o';
    output[2] = 'n';
    output[3] = 'g';
    var read_token:      types.Token;
    var write_token:     types.Token;
    val read_submitted:  i64 = submit_read(?backend, server, 1, ?input[0], 4, 51, ?read_token);
    val write_submitted: i64 = submit_write(?backend, server, 1, ?output[0], 4, 52, ?write_token);
    var response:        [4]u8;
    val response_bytes:  i64 = test_receive_exact(client, ?response[0], 4);
    var request:         [4]u8;
    request[0] = 'p';
    request[1] = 'i';
    request[2] = 'n';
    request[3] = 'g';
    val request_bytes: i64   = test_send_exact(client, ?request[0], 4);
    var saw_read:      bool  = false;
    var saw_write:     bool  = false;
    var attempts:      usize = 0;
    for (attempts < 6 && (!saw_read || !saw_write)) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 6; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 51 && native.status == 0 && native.bytes == 4) { saw_read = true; }
                if (native.context == 52 && native.status == 0 && native.bytes == 4) { saw_write = true; }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    var failure: i32 = 0;
    if (read_submitted != 0)                      { failure = 2; }
    or (write_submitted != 0)                     { failure = 3; }
    or (response_bytes != 4)                      { failure = 4; }
    or (request_bytes != 4)                       { failure = 5; }
    or (!saw_read)                                { failure = 6; }
    or (!saw_write)                               { failure = 7; }
    or (input[0] != 'p' || input[3] != 'g')       { failure = 8; }
    or (response[0] != 'p' || response[3] != 'g') { failure = 9; }
    or (backend.resource_count != 1)              { failure = 10; }
    sys.sock_close(server);
    sys.sock_close(client);
    sys.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    sys.io_queue_close(?queue);
    if (failure == 0 && destroyed < 0) { failure = 11; }
    if (failure != 0)                  { ret failure; }
    ret 0;
}

test async_unix__listener_owns_multiple_bounded_accepts {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (sys.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, 8, 1) < 0) {
        sys.io_queue_close(?queue);
        ret 1;
    }
    var listener: usize;
    var endpoint: ip.Endpoint;
    if (test_async_listener(?listener, ?endpoint) < 0) {
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var peers:        [2]ip.Endpoint;
    var tokens:       [2]types.Token;
    val first:        i64  = submit_accept(?backend, listener, 1, ?peers[0], 61, ?tokens[0]);
    val second:       i64  = submit_accept(?backend, listener, 1, ?peers[1], 62, ?tokens[1]);
    val one_resource: bool = backend.resource_count == 1;
    var clients:      [2]usize;
    if (test_client(endpoint, ?clients[0]) < 0 || test_client(endpoint, ?clients[1]) < 0) {
        cancel(?backend, tokens[0], nil);
        cancel(?backend, tokens[1], nil);
        sys.sock_close(listener);
        destroy(?backend);
        sys.io_queue_close(?queue);
        ret 1;
    }
    var accepted: [2]usize;
    accepted[0] = (-1)::usize;
    accepted[1] = (-1)::usize;
    var completions: usize = 0;
    var attempts:    usize = 0;
    for (attempts < 6 && completions < 2) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { attempts = 6; }
        or {
            var i: usize = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                completion(?backend, i, ?native);
                if (native.context == 61) {
                    accepted[0] = native.resource;
                    completions = completions + 1;
                }
                if (native.context == 62) {
                    accepted[1] = native.resource;
                    completions = completions + 1;
                }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
    }
    val valid: bool = first == 0 && second == 0 && one_resource && completions == 2 && accepted[0] != (-1)::usize && accepted[1] != (-1)::usize && accepted[0] != accepted[1] && backend.resource_count == 1;
    if (accepted[0] != (-1)::usize) { sys.sock_close(accepted[0]); }
    if (accepted[1] != (-1)::usize) { sys.sock_close(accepted[1]); }
    sys.sock_close(clients[0]);
    sys.sock_close(clients[1]);
    sys.sock_close(listener);
    val destroyed: i64 = destroy(?backend);
    sys.io_queue_close(?queue);
    if (!valid || destroyed < 0) { ret 1; }
    ret 0;
}

# the blocked operations a socket carries one after another register it once:
# only the first finds its address and adds it, every later one rearms (#737)
test async_unix__a_socket_stays_registered_across_blocked_operations {
    var pa: allocator.Allocator;
    page.make(?pa);
    var queue: shared.IoQueue;
    if (sys.io_queue_create(?queue) < 0) { ret 1; }
    var backend: Backend;
    if (make(?backend, ?queue, ?pa, 8, 1) < 0) {
        sys.io_queue_close(?queue);
        ret 2;
    }
    var receiver:          usize;
    var receiver_endpoint: ip.Endpoint;
    var sender:            usize;
    var sender_endpoint:   ip.Endpoint;
    if (test_datagram(?receiver, ?receiver_endpoint) < 0 || test_datagram(?sender, ?sender_endpoint) < 0) { ret 3; }
    var inbound:  [8]u8;
    var outbound: [1]u8;
    outbound[0] = 'x';
    var incoming: types.Packet;
    var outgoing: types.Packet;
    outgoing.buffer   = ?outbound[0];
    outgoing.length   = 1;
    outgoing.capacity = 1;
    outgoing.peer     = receiver_endpoint;
    val rounds: usize = 32;
    var round:  usize = 0;
    for (round < rounds) {
        incoming.buffer   = ?inbound[0];
        incoming.capacity = 8;
        incoming.length   = 0;
        var token: types.Token;
        if (submit_receive_batch(?backend, receiver, 1, ?incoming, 1, 100 + round, ?token) < 0) { ret 4; }
        if (datagram_send_batch(sender, ?outgoing, 1) != 1)                                     { ret 5; }
        var done:     bool  = false;
        var attempts: usize = 0;
        for (!done && attempts < 8) {
            val count: i64 = poll(?backend, 1000);
            if (count < 0) { ret 6; }
            var i: usize = 0;
            for (i < count::usize) {
                var native: types.NativeCompletion;
                if (completion(?backend, i, ?native) < 0) { ret 7; }
                if (native.context == 100 + round) {
                    if (native.status != 0 || native.items != 1) { ret 8; }
                    done = true;
                }
                i = i + 1;
            }
            attempts = attempts + 1;
        }
        if (!done) { ret 9; }
        round = round + 1;
    }
    if (backend.watches != 1)         { ret 10; }
    if (backend.unwatches != 0)       { ret 11; }
    if (backend.locates != 2)         { ret 12; }
    if (backend.rearms != rounds - 1) { ret 13; }
    var close_token: types.Token;
    if (submit_close(?backend, receiver, 1, 200, ?close_token) < 0) { ret 14; }
    var closed: bool  = false;
    var tries:  usize = 0;
    for (!closed && tries < 8) {
        val count: i64 = poll(?backend, 1000);
        if (count < 0) { ret 15; }
        var i: usize = 0;
        for (i < count::usize) {
            var native: types.NativeCompletion;
            if (completion(?backend, i, ?native) < 0) { ret 16; }
            if (native.context == 200)                { closed = true; }
            i = i + 1;
        }
        tries = tries + 1;
    }
    if (!closed)                { ret 17; }
    if (backend.unwatches != 1) { ret 18; }
    sys.sock_close(sender);
    if (destroy(?backend) < 0) { ret 19; }
    sys.io_queue_close(?queue);
    ret 0;
}
