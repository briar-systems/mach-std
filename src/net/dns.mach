# DNS hostname resolution
#
# a convenience IPv4 surface over the native resolver modules. richer needs
# (dual stack, canonical names, services, asynchrony) belong to
# std.net.resolve.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.net.ip;
use std.net.resolve.conf;
use std.net.resolve.hosts;
use std.net.resolve.lookup;

# resolve a hostname via the system hosts file
#
# searches the platform hosts file for a matching hostname and writes
# the first IPv4 address found into addr.
# ---
# hostname: null-terminated hostname to look up
# addr:     pointer to an IPv4 to fill on success
# ret:      true if a match was found
pub fun lookup_hosts(hostname: str, addr: *ip.IPv4) bool {
    var found: [1]ip.Addr;
    var search: hosts.Lookup = hosts.Lookup{
        hostname: hostname,
        want_v4: true,
        want_v6: false,
        addrs: ?found[0],
        capacity: 1,
        count: 0,
        canonical: nil,
        canonical_capacity: 0,
    };
    if (hosts.collect(?search) == 0) { ret false; }
    @addr = found[0].v4;
    ret true;
}

# resolve a hostname via a DNS A record query
#
# queries the target's configured nameservers for the literal name, without
# search-domain expansion. writes the first address from the response into
# addr. windows configures its resolver through the winsock surface instead
# of resolv.conf, so this returns false there; use std.net.resolve.
# ---
# hostname: null-terminated hostname to resolve
# addr:     pointer to an IPv4 to fill on success
# ret:      true if resolution succeeded
pub fun query(hostname: str, addr: *ip.IPv4) bool {
    $if ($mach.build.os == $mach.os.windows) {
        ret false;
    }
    $or {
        var config: conf.Config;
        conf.load(?config);
        var answer: lookup.Answer;
        if (lookup.query_name(?config, hostname, nil, true, false, ?answer) != lookup.FOUND) {
            ret false;
        }
        @addr = answer.addrs[0].v4;
        ret true;
    }
}

# resolve a hostname to an IPv4 address
#
# per RFC 6761 the name `localhost` and any name ending in `.localhost`
# resolve to the loopback address (127.0.0.1) without consulting the hosts
# file or a nameserver, this is resolver behavior, not hosts-file content,
# and so is portable across platforms whose hosts file omits localhost.
# other names fall back to the hosts file, then DNS with the target's
# search-domain policy applied.
# ---
# hostname: null-terminated hostname to resolve
# addr:     pointer to an IPv4 to fill on success
# ret:      true if resolution succeeded
pub fun resolve(hostname: str, addr: *ip.IPv4) bool {
    if (is_localhost(hostname)) {
        @addr = ip.ipv4_loopback();
        ret true;
    }
    if (lookup_hosts(hostname, addr)) { ret true; }
    $if ($mach.build.os == $mach.os.windows) {
        ret false;
    }
    $or {
        var config: conf.Config;
        conf.load(?config);
        var answer: lookup.Answer;
        if (lookup.resolve_name(?config, hostname, true, false, ?answer) != lookup.FOUND) {
            ret false;
        }
        @addr = answer.addrs[0].v4;
        ret true;
    }
}

# report whether hostname is an RFC 6761 localhost name
#
# matches `localhost` or any name ending in `.localhost`, case-insensitively.
fun is_localhost(hostname: str) bool {
    val host_len: usize = str_len(hostname);
    if (host_len == 9 && region_eq(hostname, "localhost", 9)) { ret true; }
    if (host_len > 9
        && (hostname::*u8)[host_len - 10] == '.'
        && region_eq(?(hostname::*u8)[host_len - 9], "localhost", 9)) {
        ret true;
    }
    ret false;
}

fun region_eq(a: *u8, b: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        var ca: u8 = a[i];
        var cb: u8 = b[i];
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "dns: resolve localhost" {
    var addr: ip.IPv4;
    if (!resolve("localhost", ?addr)) { ret 1; }
    if (addr.octets[0] != 127 || addr.octets[1] != 0
        || addr.octets[2] != 0 || addr.octets[3] != 1) { ret 1; }

    var sub: ip.IPv4;
    if (!resolve("web.localhost", ?sub)) { ret 1; }
    if (sub.octets[0] != 127 || sub.octets[1] != 0
        || sub.octets[2] != 0 || sub.octets[3] != 1) { ret 1; }
    ret 0;
}

test "dns: lookup_hosts nonexistent" {
    var addr: ip.IPv4;
    val found: bool = lookup_hosts("this.host.does.not.exist.local", ?addr);
    if (found) { ret 1; }
    ret 0;
}
