# DNS hostname resolution
#
# a convenience IPv4 surface over the native resolver modules. richer needs
# (dual stack, canonical names, services, asynchrony) belong to
# std.net.resolve.

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.net.ip;
use std.net.resolve.conf;
use std.net.resolve.hosts;
use std.net.resolve.lookup;
use std.net.resolve.types;
use std.net.resolve.shared;
use io_error: std.io.error;

fun found(addr: *ip.IPv4, value: ip.IPv4) res[bool, types.Error] {
    @addr = value;
    ret res[bool, types.Error].ok{true};
}

fun not_found() res[bool, types.Error] {
    ret res[bool, types.Error].ok{false};
}

fun system_failure(failure: io_error.Error) res[bool, types.Error] {
    ret res[bool, types.Error].err{shared.error(types.SYSTEM_FAILURE, failure.code)};
}

# resolve a hostname via the system hosts file
#
# searches the platform hosts file for a matching hostname and writes
# the first IPv4 address found into addr.
# ---
# hostname: null-terminated hostname to look up
# addr:     pointer to an IPv4 to fill on a match
# ret:      whether a match was found, or the hosts file failure
pub fun lookup_hosts(hostname: str, addr: *ip.IPv4) res[bool, types.Error] {
    var matches: [1]ip.Addr;
    var search: hosts.Lookup = hosts.Lookup{
        hostname: hostname,
        want_v4: true,
        want_v6: false,
        addrs: ?matches[0],
        capacity: 1,
        count: 0,
        canonical: nil,
        canonical_capacity: 0,
    };
    val collected: res[usize, io_error.Error] = hosts.collect(?search);
    if (sel collected.err) { ret system_failure(collected.err); }
    if (collected.ok == 0) { ret not_found(); }
    ret found(addr, matches[0].v4);
}

# a lookup outcome as this module reports it: found or not, with a temporary
# or failed lookup surfaced as the resolver error
fun answered(outcome: lookup.Outcome, answer: *lookup.Answer, addr: *ip.IPv4) res[bool, types.Error] {
    if (sel outcome.found) { ret found(addr, answer.addrs[0].v4); }
    if (sel outcome.no_name) { ret not_found(); }
    if (sel outcome.temporary) { ret res[bool, types.Error].err{shared.error(types.TEMPORARY, 0)}; }
    ret res[bool, types.Error].err{shared.error(types.SYSTEM_FAILURE, 0)};
}

# resolve a hostname via a DNS A record query
#
# queries the target's configured nameservers for the literal name, without
# search-domain expansion. writes the first address from the response into
# addr. windows configures its resolver through the winsock surface instead
# of resolv.conf, so this is not found there; use std.net.resolve.
# ---
# hostname: null-terminated hostname to resolve
# addr:     pointer to an IPv4 to fill on success
# ret:      whether the name resolved, or the configuration or lookup failure
pub fun query(hostname: str, addr: *ip.IPv4) res[bool, types.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        ret not_found();
    }
    $or {
        var config: conf.Config;
        val loaded: err[io_error.Error] = conf.load(?config);
        if (sel loaded.err) { ret system_failure(loaded.err); }
        var answer: lookup.Answer;
        val outcome: lookup.Outcome = lookup.query_name(?config, hostname, nil, true, false, ?answer);
        ret answered(outcome, ?answer, addr);
    }
}

# resolve a hostname to an IPv4 address
#
# per RFC 6761 the name `localhost` and any name ending in `.localhost`
# resolve to the loopback address (127.0.0.1) without consulting the hosts
# file or a nameserver, this is resolver behavior, not hosts-file content,
# and so is portable across platforms whose hosts file omits localhost.
# other names fall back to the hosts file, then DNS with the target's
# search-domain policy applied.
# ---
# hostname: null-terminated hostname to resolve
# addr:     pointer to an IPv4 to fill on success
# ret:      whether the name resolved, or the hosts, configuration or lookup failure
pub fun resolve(hostname: str, addr: *ip.IPv4) res[bool, types.Error] {
    if (is_localhost(hostname)) { ret found(addr, ip.ipv4_loopback()); }
    val in_hosts: res[bool, types.Error] = lookup_hosts(hostname, addr);
    if (sel in_hosts.err) { ret in_hosts; }
    if (in_hosts.ok) { ret in_hosts; }
    $if ($mach.build.os == $mach.os.windows) {
        ret not_found();
    }
    $or {
        var config: conf.Config;
        val loaded: err[io_error.Error] = conf.load(?config);
        if (sel loaded.err) { ret system_failure(loaded.err); }
        var answer: lookup.Answer;
        val outcome: lookup.Outcome = lookup.resolve_name(?config, hostname, true, false, ?answer);
        ret answered(outcome, ?answer, addr);
    }
}

# report whether hostname is an RFC 6761 localhost name
#
# matches `localhost` or any name ending in `.localhost`, case-insensitively.
fun is_localhost(hostname: str) bool {
    val host_len: usize = str_len(hostname);
    if (host_len == 9 && region_eq(hostname, "localhost", 9)) { ret true; }
    if (host_len > 9
        && (hostname::*u8)[host_len - 10] == '.'
        && region_eq(?(hostname::*u8)[host_len - 9], "localhost", 9)) {
        ret true;
    }
    ret false;
}

fun region_eq(a: *u8, b: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        var ca: u8 = a[i];
        var cb: u8 = b[i];
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun resolved_loopback(hostname: str) bool {
    var addr: ip.IPv4;
    val r: res[bool, types.Error] = resolve(hostname, ?addr);
    if (!sel r.ok) { ret false; }
    if (!r.ok) { ret false; }
    ret addr.octets[0] == 127 && addr.octets[1] == 0 && addr.octets[2] == 0 && addr.octets[3] == 1;
}

test "dns: resolve localhost" {
    if (!resolved_loopback("localhost")) { ret 1; }
    if (!resolved_loopback("web.localhost")) { ret 2; }
    ret 0;
}

test "dns: lookup_hosts nonexistent is not found, not a failure" {
    var addr: ip.IPv4;
    val r: res[bool, types.Error] = lookup_hosts("this.host.does.not.exist.local", ?addr);
    if (!sel r.ok) { ret 1; }
    if (r.ok) { ret 2; }
    ret 0;
}
