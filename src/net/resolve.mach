    if (!test_pool_make(?pool, 4)) { ret 1; }
    var gate: Gate = Gate{entered: 0, release: 0};
    var resolver: Resolver;
    if (!made(make_with_adapter(?resolver, ?pool.pool, ?owner, 2, test_limits(), (?gate)::ptr, gated_adapter))) { ret 2; }
    var scopes: [2]cancellation.Scope;
    cancellation.make_root(?scopes[0], false, time.Time{sec: 0, nsec: 0});
    cancellation.make_root(?scopes[1], false, time.Time{sec: 0, nsec: 0});
    var query: types.Query = test_query("cancelled", nil, 0);
    val first: res[types.Token, types.Error] = submit(?resolver, ?scopes[0], ?query, 10);
    val second: res[types.Token, types.Error] = submit(?resolver, ?scopes[1], ?query, 11);
    if (sel first.err) { ret 3; }
    if (sel second.err) { ret 3; }
    gate_wait_entered(?gate);
    if (!cancelled(?resolver, second.ok)) { ret 4; }
    var transition: ScopeTransition = ScopeTransition{
        scope: ?scopes[0], deadline: time.Time{sec: 0, nsec: 0}, expire: false,
        entered: 0, done: 0, result: 0,
    };
    var transition_thread: thread.Thread;
    thread.spawn_with(transition_run, (?transition)::*u8, ?transition_thread);
    if (transition_thread.tid < 0) { ret 5; }
    transition_wait_entered(?transition);
    val first_token: types.Token = first.ok;
    val first_reason: cancellation.Reason = operation_wait_reason(?resolver.operations[first_token.index::usize]);
    if (!sel first_reason.cancelled) { ret 6; }
    gate_release(?gate);
    if (!thread_joined(?transition_thread) || atomic.load(?transition.result) == 0) { ret 6; }
    var completions: [2]types.Completion;
    var count: usize = wait(?resolver, (?completions)::*types.Completion, 2);
    if (count < 2) { count = count + wait(?resolver, ?completions[count], 2 - count); }
    if (count != 2 || !completions[0].has_error || !completions[1].has_error
     || completions[0].error.kind != types.CANCELLED || completions[1].error.kind != types.CANCELLED) { ret 7; }
    if (!scope_ok(cancellation.destroy(?scopes[0])) || !scope_ok(cancellation.destroy(?scopes[1]))
     || !test_resolver_cleanup(?resolver, ?pool)) { ret 8; }
    ret 0;
}

