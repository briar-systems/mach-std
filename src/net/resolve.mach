# bounded asynchronous system name resolution

use std.types.canonical.res;
use std.types.canonical.err;
use std.io.lifecycle.StateError;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str_len;
use std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.sync.atomic;
use cancellation: std.sync.cancel;
use std.sync.condition;
use std.sync.mutex;
use std.sync.thread;
use std.sync.worker_pool;
use std.system.os;
use std.system.panic;
use io_runtime: std.io.runtime;
use io_error: std.io.error;
use std.io.lifecycle;

use std.net.ip;
use std.net.resolve.types;
use std.net.resolve.shared;

$if ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}

$if ($mach.build.os == $mach.os.linux) {
    use target: std.net.resolve.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use target: std.net.resolve.darwin;
}
$or ($mach.build.os == $mach.os.windows) {
    use target: std.net.resolve.windows;
}
$or {
    $error("std.net.resolve: unsupported target");
}

fwd types.Family;
fwd types.ANY_FAMILY;
fwd types.IPV4_ONLY;
fwd types.IPV6_ONLY;
fwd types.SocketKind;
fwd types.ANY_SOCKET;
fwd types.STREAM_SOCKET;
fwd types.DATAGRAM_SOCKET;
fwd types.CANONICAL_NAME;
fwd types.NUMERIC_HOST;
fwd types.NUMERIC_SERVICE;
fwd types.PASSIVE;
fwd types.ErrorKind;
fwd types.NO_ERROR;
fwd types.INVALID;
fwd types.OVERLOADED;
fwd types.CLOSED;
fwd types.OUT_OF_MEMORY;
fwd types.NO_NAME;
fwd types.TEMPORARY;
fwd types.MALFORMED;
fwd types.SYSTEM_FAILURE;
fwd types.CANCELLED;
fwd types.TIMED_OUT;
fwd types.Error;
fwd types.Token;
fwd types.Query;
fwd types.ResultLimits;
fwd types.Resolution;
fwd types.Completion;
fwd types.AdapterFun;

pub val MAX_HOST_LENGTH: usize = 253;
pub val MAX_SERVICE_LENGTH: usize = 31;

val SLOT_FREE: u8 = 0;
val SLOT_ACTIVE: u8 = 1;
val SLOT_QUEUED: u8 = 2;

pub val OPEN: u8 = 0;
pub val CLOSING: u8 = 1;
pub val DESTROYED: u8 = 2;

# the futex-waited reason word mirrors cancellation.Reason as an integer
val REASON_ACTIVE: i64 = 0;
val REASON_CANCELLED: i64 = 1;
val REASON_TIMED_OUT: i64 = 2;
val REASON_DESTROYED: i64 = 3;
val REASON_INVALID: i64 = 4;

rec Operation {
    state: u8;
    generation: u32;
    index: u32;
    resolver: *Resolver;
    context: usize;
    query: types.Query;
    host: [254]u8;
    service: [32]u8;
    scope: *cancellation.Scope;
    registration: cancellation.Registration;
    cancellation_reason: i64;
    scope_use_done: i64;
    registration_done: i64;
    runtime_token: io_runtime.Token;
    runtime_owned: bool;
    runtime_published: bool;
    runtime_released: bool;
    internal_dequeued: bool;
    runtime_cancellation_pending: bool;
    runtime_terminal_claimed: bool;
    runtime_terminal_failure: io_error.Error;
    terminal_failure: types.Error;
    resolution: types.Resolution;
}

# operation and completion storage is fixed after construction
# the worker pool and allocator must remain live and drain accepted tasks
# allocator callbacks must support concurrent calls from the pool's workers
pub rec Resolver {
    pool: *worker_pool.Pool;
    allocator: *allocator.Allocator;
    adapter: types.AdapterFun;
    adapter_context: ptr;
    result_limits: types.ResultLimits;
    runtime: *io_runtime.Runtime;
    runtime_source: io_runtime.SourceToken;
    runtime_registered: bool;
    operations: *Operation;
    completions: *types.Completion;
    capacity: usize;
    next_slot: usize;
    head: usize;
    tail: usize;
    count: usize;
    live: usize;
    state: u8;
    lock: mutex.Mutex;
    ready: condition.Condition;
}

fun system_adapter(context: ptr, query: *types.Query, owner: *allocator.Allocator, limits: types.ResultLimits, output: *types.Resolution) types.Error {
    ret target.resolve(query, owner, limits, output);
}

fun reason_code(reason: cancellation.Reason) i64 {
    if (sel reason.active) { ret REASON_ACTIVE; }
    if (sel reason.cancelled) { ret REASON_CANCELLED; }
    if (sel reason.timed_out) { ret REASON_TIMED_OUT; }
    if (sel reason.destroyed) { ret REASON_DESTROYED; }
    ret REASON_INVALID;
}

fun reason_of(code: i64) cancellation.Reason {
    if (code == REASON_ACTIVE) { ret cancellation.Reason.active{}; }
    if (code == REASON_CANCELLED) { ret cancellation.Reason.cancelled{}; }
    if (code == REASON_TIMED_OUT) { ret cancellation.Reason.timed_out{}; }
    if (code == REASON_DESTROYED) { ret cancellation.Reason.destroyed{}; }
    ret cancellation.Reason.invalid{};
}

fun transition_changed(transition: cancellation.Transition) bool {
    if (sel transition.ok) { ret transition.ok; }
    ret false;
}

fun cancellation_error(reason: cancellation.Reason) types.Error {
    if (sel reason.cancelled) { ret shared.error(types.CANCELLED, 0); }
    if (sel reason.timed_out) { ret shared.error(types.TIMED_OUT, 0); }
    ret shared.error(types.INVALID, reason_code(reason));
}

# error detail for a pool status: accepted 0, queue_full 1, pool_closed 2, timed_out 3,
# cancelled 4, invalid 5, spawn_failed 6, draining 7, aborting 8, joined 9, join_failed 10, joining 11
fun pool_status_code(status: worker_pool.Status) i64 {
    if (sel status.accepted) { ret 0; }
    if (sel status.queue_full) { ret 1; }
    if (sel status.pool_closed) { ret 2; }
    if (sel status.timed_out) { ret 3; }
    if (sel status.cancelled) { ret 4; }
    if (sel status.invalid) { ret 5; }
    if (sel status.spawn_failed) { ret 6; }
    if (sel status.draining) { ret 7; }
    if (sel status.aborting) { ret 8; }
    if (sel status.joined) { ret 9; }
    if (sel status.join_failed) { ret 10; }
    ret 11;
}

fun pool_error(status: worker_pool.Status) types.Error {
    if (sel status.queue_full) { ret shared.error(types.OVERLOADED, pool_status_code(status)); }
    if (sel status.pool_closed || sel status.draining || sel status.aborting
     || sel status.joined || sel status.joining) { ret shared.error(types.CLOSED, pool_status_code(status)); }
    ret shared.error(types.SYSTEM_FAILURE, pool_status_code(status));
}

fun runtime_error(failure: io_error.Error) types.Error {
    if (failure.kind == io_error.TIMEOUT) { ret shared.error(types.TIMED_OUT, failure.code); }
    if (failure.kind == io_error.CANCELLED) { ret shared.error(types.CANCELLED, failure.code); }
    if (failure.kind == io_error.CLOSED) { ret shared.error(types.CLOSED, failure.code); }
    if (failure.kind == io_error.RESOURCE_EXHAUSTED) { ret shared.error(types.OVERLOADED, failure.code); }
    if (failure.kind == io_error.INVALID) { ret shared.error(types.INVALID, failure.code); }
    ret shared.error(types.SYSTEM_FAILURE, failure.code);
}

fun refused(kind: types.ErrorKind, native_code: i64) err[types.Error] {
    ret err[types.Error].err{shared.error(kind, native_code)};
}

# initialize a resolver in place over caller-owned storage; a refused
# acquisition releases what was acquired and leaves the storage unowned
pub fun make_with_adapter(resolver: *Resolver, pool: *worker_pool.Pool, owner: *allocator.Allocator,
    capacity: usize, result_limits: types.ResultLimits, adapter_context: ptr, adapter: types.AdapterFun) err[types.Error] {
    if (resolver == nil || pool == nil || owner == nil || capacity == 0
     || capacity > 0xffffffff || result_limits.max_endpoints == 0
     || result_limits.max_canonical_name_bytes == 0 || adapter::usize == 0) {
        ret refused(types.INVALID, 0);
    }
    val pool_state: worker_pool.Status = worker_pool.state(pool);
    if (!sel pool_state.accepted) {
        if (sel pool_state.invalid) { ret refused(types.INVALID, pool_status_code(pool_state)); }
        ret refused(types.CLOSED, pool_status_code(pool_state));
    }
    val operation_allocation: res[*Operation, allocator.Error] = allocator.allocate[Operation](owner, capacity);
    if (sel operation_allocation.err) { ret refused(types.OUT_OF_MEMORY, 0); }
    resolver.operations = operation_allocation.ok;
    val completion_allocation: res[*types.Completion, allocator.Error] = allocator.allocate[types.Completion](owner, capacity);
    if (sel completion_allocation.err) {
        allocator.deallocate[Operation](owner, resolver.operations, capacity);
        resolver.operations = nil;
        ret refused(types.OUT_OF_MEMORY, 0);
    }
    resolver.completions = completion_allocation.ok;
    resolver.pool = pool;
    resolver.allocator = owner;
    resolver.adapter = adapter;
    resolver.adapter_context = adapter_context;
    resolver.result_limits = result_limits;
    resolver.runtime = nil;
    resolver.runtime_source = io_runtime.SourceToken{index: 0, generation: 0, tag: 0};
    resolver.runtime_registered = false;
    resolver.capacity = capacity;
    resolver.next_slot = 0;
    resolver.head = 0;
    resolver.tail = 0;
    resolver.count = 0;
    resolver.live = 0;
    resolver.state = OPEN;
    resolver.lock = mutex.make();
    resolver.ready = condition.make();
    var i: usize = 0;
    for (i < capacity) {
        val operation: *Operation = ?resolver.operations[i];
        operation.state = SLOT_FREE;
        operation.generation = 0;
        operation.index = i::u32;
        operation.resolver = resolver;
        operation.scope = nil;
        operation.cancellation_reason = REASON_ACTIVE;
        operation.scope_use_done = 1;
        operation.registration_done = 1;
        operation.runtime_token = io_runtime.Token{index: 0, generation: 0};
        operation.runtime_owned = false;
        operation.runtime_published = false;
        operation.runtime_released = false;
        operation.internal_dequeued = false;
        operation.runtime_cancellation_pending = false;
        operation.runtime_terminal_claimed = false;
        operation.runtime_terminal_failure = io_error.from_code(0, io_error.OP_UNKNOWN);
        operation.terminal_failure = shared.error(types.NO_ERROR, 0);
        cancellation.init_registration(?operation.registration);
        shared.clear(?operation.resolution, owner);
        i = i + 1;
    }
    ret err[types.Error].ok{};
}

pub fun make(resolver: *Resolver, pool: *worker_pool.Pool, owner: *allocator.Allocator,
    capacity: usize, result_limits: types.ResultLimits) err[types.Error] {
    ret make_with_adapter(resolver, pool, owner, capacity, result_limits, nil, system_adapter);
}

pub fun make_runtime_with_adapter(resolver: *Resolver, runtime: *io_runtime.Runtime,
    pool: *worker_pool.Pool, owner: *allocator.Allocator, capacity: usize,
    result_limits: types.ResultLimits, adapter_context: ptr, adapter: types.AdapterFun) err[types.Error] {
    if (runtime == nil) { ret refused(types.INVALID, 0); }
    val made: err[types.Error] = make_with_adapter(resolver, pool, owner, capacity,
        result_limits, adapter_context, adapter);
    if (sel made.err) { ret made; }
    resolver.runtime = runtime;
    val registered: res[io_runtime.SourceToken, io_error.Error] = io_runtime.register_source(
        runtime, resolver::ptr, runtime_dispatch, runtime_cancel, runtime_release);
    if (sel registered.err) {
        val failure: types.Error = runtime_error(registered.err);
        resolver.runtime = nil;
        close(resolver);
        destroy(resolver);
        ret err[types.Error].err{failure};
    }
    resolver.runtime_source = registered.ok;
    resolver.runtime_registered = true;
    ret err[types.Error].ok{};
}

pub fun make_runtime(resolver: *Resolver, runtime: *io_runtime.Runtime,
    pool: *worker_pool.Pool, owner: *allocator.Allocator, capacity: usize,
    result_limits: types.ResultLimits) err[types.Error] {
    ret make_runtime_with_adapter(resolver, runtime, pool, owner, capacity,
        result_limits, nil, system_adapter);
}

fun valid_query(query: *types.Query) bool {
    if (query == nil) { ret false; }
    if (query.family != types.ANY_FAMILY && query.family != types.IPV4_ONLY && query.family != types.IPV6_ONLY) { ret false; }
    if (query.socket_kind != types.ANY_SOCKET && query.socket_kind != types.STREAM_SOCKET && query.socket_kind != types.DATAGRAM_SOCKET) { ret false; }
    if ((query.flags & ~(types.CANONICAL_NAME | types.NUMERIC_HOST | types.NUMERIC_SERVICE | types.PASSIVE)) != 0) { ret false; }
    if (query.host == nil && (query.flags & types.PASSIVE) == 0) { ret false; }
    if (query.host != nil && str_len(query.host) > MAX_HOST_LENGTH) { ret false; }
    if (query.service != nil && str_len(query.service) > MAX_SERVICE_LENGTH) { ret false; }
    ret true;
}

fun claim_locked(resolver: *Resolver) *Operation {
    if (resolver.live == resolver.capacity) { ret nil; }
    var checked: usize = 0;
    for (checked < resolver.capacity) {
        val index: usize = resolver.next_slot;
        resolver.next_slot = (resolver.next_slot + 1) % resolver.capacity;
        val operation: *Operation = ?resolver.operations[index];
        if (operation.state == SLOT_FREE) {
            operation.state = SLOT_ACTIVE;
            operation.generation = operation.generation + 1;
            if (operation.generation == 0) { operation.generation = 1; }
            operation.context = 0;
            operation.scope = nil;
            operation.cancellation_reason = REASON_ACTIVE;
            operation.scope_use_done = 1;
            operation.registration_done = 1;
            operation.runtime_token = io_runtime.Token{index: 0, generation: 0};
            operation.runtime_owned = false;
            operation.runtime_published = false;
            operation.runtime_released = false;
            operation.internal_dequeued = false;
            operation.runtime_cancellation_pending = false;
            operation.runtime_terminal_claimed = false;
            operation.runtime_terminal_failure = io_error.from_code(0, io_error.OP_UNKNOWN);
            operation.terminal_failure = shared.error(types.NO_ERROR, 0);
            cancellation.init_registration(?operation.registration);
            shared.clear(?operation.resolution, resolver.allocator);
            resolver.live = resolver.live + 1;
            ret operation;
        }
        checked = checked + 1;
    }
    ret nil;
}

fun release_locked(resolver: *Resolver, operation: *Operation) {
    operation.state = SLOT_FREE;
    operation.scope = nil;
    operation.cancellation_reason = REASON_ACTIVE;
    operation.scope_use_done = 1;
    operation.registration_done = 1;
    operation.runtime_token = io_runtime.Token{index: 0, generation: 0};
    operation.runtime_owned = false;
    operation.runtime_published = false;
    operation.runtime_released = false;
    operation.internal_dequeued = false;
    operation.runtime_cancellation_pending = false;
    operation.runtime_terminal_claimed = false;
    operation.runtime_terminal_failure = io_error.from_code(0, io_error.OP_UNKNOWN);
    operation.terminal_failure = shared.error(types.NO_ERROR, 0);
    cancellation.init_registration(?operation.registration);
    shared.clear(?operation.resolution, resolver.allocator);
    resolver.live = resolver.live - 1;
}

fun copy_string(source: *u8, output: *u8, capacity: usize) *u8 {
    if (source == nil) { ret nil; }
    val length: usize = str_len(source);
    if (length + 1 > capacity) { ret nil; }
    var i: usize = 0;
    for (i < length) { output[i] = source[i]; i = i + 1; }
    output[length] = 0;
    ret output;
}

fun copy_query(operation: *Operation, query: *types.Query, context: usize) {
    operation.context = context;
    operation.query = @query;
    operation.query.host = copy_string(query.host, ?operation.host[0], 254);
    operation.query.service = copy_string(query.service, ?operation.service[0], 32);
}

fun parse_service(service: *u8, port: *u16) bool {
    if (service == nil) { @port = 0; ret true; }
    val length: usize = str_len(service);
    if (length == 0) { ret false; }
    var value: u32 = 0;
    var i: usize = 0;
    for (i < length) {
        val digit: u8 = service[i];
        if (digit < '0' || digit > '9') { ret false; }
        val numeric_digit: u32 = (digit - '0')::u32;
        if (value > (65535 - numeric_digit) / 10) { ret false; }
        value = value * 10 + numeric_digit;
        i = i + 1;
    }
    @port = value::u16;
    ret true;
}

fun enqueue_locked(resolver: *Resolver, operation: *Operation, failure: types.Error) {
    val token: types.Token = types.Token{index: operation.index, generation: operation.generation};
    resolver.completions[resolver.tail] = types.Completion{
        token: token,
        context: operation.context,
        resolution: operation.resolution,
        has_error: failure.kind != types.NO_ERROR,
        error: failure,
    };
    resolver.tail = (resolver.tail + 1) % resolver.capacity;
    resolver.count = resolver.count + 1;
    operation.terminal_failure = failure;
    operation.state = SLOT_QUEUED;
    if (resolver.runtime == nil) {
        condition.signal(?resolver.ready);
    } or {
        val woken: err[io_error.Error] = io_runtime.wake(resolver.runtime);
        if (sel woken.err) {
            panic.panic("std.net.resolve: runtime wake failed\n");
        }
    }
}

fun claim_reason(operation: *Operation, reason: cancellation.Reason) bool {
    var expected: i64 = REASON_ACTIVE;
    val changed: bool = atomic.cas(?operation.cancellation_reason, ?expected, reason_code(reason));
    if (changed) { os.thread_wake(?operation.cancellation_reason); }
    ret changed;
}

fun runtime_token_equal(a: io_runtime.Token, b: io_runtime.Token) bool {
    ret a.index == b.index && a.generation == b.generation;
}

fun operation_for_runtime_locked(resolver: *Resolver, token: io_runtime.Token) *Operation {
    var i: usize = 0;
    for (i < resolver.capacity) {
        val operation: *Operation = ?resolver.operations[i];
        if (operation.state != SLOT_FREE && operation.runtime_owned
         && runtime_token_equal(operation.runtime_token, token)) { ret operation; }
        i = i + 1;
    }
    ret nil;
}

fun runtime_cancel_reason(failure: io_error.Error) cancellation.Reason {
    if (failure.kind == io_error.TIMEOUT) { ret cancellation.Reason.timed_out{}; }
    ret cancellation.Reason.cancelled{};
}

fun resolver_io_error(failure: types.Error) io_error.Error {
    var code: i64 = os.EIO;
    if (failure.kind == types.INVALID) { code = os.EINVAL; }
    or (failure.kind == types.OVERLOADED || failure.kind == types.OUT_OF_MEMORY) { code = os.ENOMEM; }
    or (failure.kind == types.CLOSED) { code = os.EBADF; }
    or (failure.kind == types.NO_NAME) { code = os.ENOENT; }
    or (failure.kind == types.TEMPORARY) { code = os.EAGAIN; }
    or (failure.kind == types.CANCELLED) { code = os.ECANCELED; }
    or (failure.kind == types.TIMED_OUT) { code = os.ETIMEDOUT; }
    ret io_error.from_code(code, io_error.OP_SUBMIT);
}

fun queued_completion_locked(resolver: *Resolver, operation: *Operation) *types.Completion {
    var offset: usize = 0;
    var index: usize = resolver.head;
    for (offset < resolver.count) {
        val completion: *types.Completion = ?resolver.completions[index];
        if (completion.token.index == operation.index
         && completion.token.generation == operation.generation) { ret completion; }
        index = (index + 1) % resolver.capacity;
        offset = offset + 1;
    }
    ret nil;
}

fun rewrite_queued_runtime_terminal_locked(resolver: *Resolver, operation: *Operation,
    runtime_failure: io_error.Error) {
    val completion: *types.Completion = queued_completion_locked(resolver, operation);
    if (completion == nil) { ret; }
    if (operation.terminal_failure.kind == types.NO_ERROR) {
        cleanup_failed_result(operation);
    }
    val failure: types.Error = runtime_error(runtime_failure);
    operation.terminal_failure = failure;
    completion.resolution = operation.resolution;
    completion.has_error = true;
    completion.error = failure;
}

fun runtime_cancel(context: ptr, token: io_runtime.Token, failure: io_error.Error) i64 {
    val resolver: *Resolver = context::*Resolver;
    mutex.lock(?resolver.lock);
    val operation: *Operation = operation_for_runtime_locked(resolver, token);
    if (operation == nil) {
        mutex.unlock(?resolver.lock);
        ret 0;
    }
    if (operation.state == SLOT_QUEUED) {
        if (!operation.runtime_published && !operation.internal_dequeued) {
            operation.runtime_terminal_claimed = true;
            operation.runtime_terminal_failure = failure;
            rewrite_queued_runtime_terminal_locked(resolver, operation, failure);
        }
        operation.runtime_published = true;
        mutex.unlock(?resolver.lock);
        ret 0;
    }
    if (claim_reason(operation, runtime_cancel_reason(failure))) {
        operation.runtime_terminal_claimed = true;
        operation.runtime_terminal_failure = failure;
    }
    operation.runtime_cancellation_pending = true;
    mutex.unlock(?resolver.lock);
    ret io_runtime.CANCELLATION_PENDING;
}

fun runtime_release(context: ptr, completion: *io_runtime.Completion) {
    val resolver: *Resolver = context::*Resolver;
    mutex.lock(?resolver.lock);
    val operation: *Operation = operation_for_runtime_locked(resolver, completion.token);
    if (operation != nil && !operation.runtime_released) {
        operation.runtime_released = true;
        if (operation.internal_dequeued) { release_locked(resolver, operation); }
    }
    mutex.unlock(?resolver.lock);
}

fun runtime_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    val resolver: *Resolver = context::*Resolver;
    var published: bool = false;
    mutex.lock(?resolver.lock);
    var i: usize = 0;
    for (i < resolver.capacity) {
        val operation: *Operation = ?resolver.operations[i];
        if (operation.state == SLOT_QUEUED && operation.runtime_owned && !operation.runtime_published) {
            var completed: err[io_error.Error];
            if (operation.runtime_cancellation_pending) {
                completed = io_runtime.complete_cancellation(resolver.runtime, operation.runtime_token);
            }
            or (operation.terminal_failure.kind != types.NO_ERROR) {
                completed = io_runtime.fail(resolver.runtime, operation.runtime_token,
                    resolver_io_error(operation.terminal_failure));
            }
            or {
                completed = io_runtime.complete(resolver.runtime, operation.runtime_token, 0, 0, false);
            }
            if (sel completed.ok) {
                operation.runtime_published = true;
                published = true;
            }
        }
        i = i + 1;
    }
    mutex.unlock(?resolver.lock);
    ret published;
}

fun cancel_callback(context: ptr, reason: cancellation.Reason) {
    val operation: *Operation = context::*Operation;
    claim_reason(operation, reason);
}

fun cancel_complete(context: ptr, reason: cancellation.Reason) {
    val operation: *Operation = context::*Operation;
    for (atomic.load(?operation.scope_use_done) == 0) {
        os.thread_wait(?operation.scope_use_done, 0);
    }
    if (!transition_changed(cancellation.finish(?operation.registration))) {
        claim_reason(operation, cancellation.Reason.invalid{});
    }
    atomic.store(?operation.registration_done, 1);
    os.thread_wake(?operation.registration_done);
}

fun wait_for_cancellation(operation: *Operation) cancellation.Reason {
    for (atomic.load(?operation.registration_done) == 0) {
        os.thread_wait(?operation.registration_done, 0);
    }
    ret reason_of(atomic.load(?operation.cancellation_reason));
}

fun finish_scope_use(operation: *Operation) {
    atomic.store(?operation.scope_use_done, 1);
    os.thread_wake(?operation.scope_use_done);
}

fun read_deadline(scope: *cancellation.Scope, deadline: *time.Time) bool {
    val query: cancellation.DeadlineQuery = cancellation.get_deadline(scope);
    if (sel query.err) { ret false; }
    if (sel query.ok.some) {
        @deadline = query.ok.some.at;
        ret true;
    }
    ret false;
}

# an unreadable clock leaves the deadline to the scope owner's own expiry
fun deadline_reached(has_deadline: bool, deadline: time.Time) bool {
    if (!has_deadline) { ret false; }
    val now: time.Clock = time.monotonic();
    if (sel now.err) { ret false; }
    ret !time.time_before(now.ok, deadline);
}

fun settle_registration(operation: *Operation) cancellation.Reason {
    if (transition_changed(cancellation.unregister(?operation.registration))) {
        atomic.store(?operation.registration_done, 1);
        os.thread_wake(?operation.registration_done);
        ret reason_of(atomic.load(?operation.cancellation_reason));
    }
    ret wait_for_cancellation(operation);
}

fun cleanup_failed_result(operation: *Operation) {
    if (operation.resolution.allocator == operation.resolver.allocator) {
        shared.destroy(?operation.resolution);
    } or {
        shared.clear(?operation.resolution, operation.resolver.allocator);
    }
}

fun run_operation(context: ptr) bool {
    val operation: *Operation = context::*Operation;
    val resolver: *Resolver = operation.resolver;
    var failure: types.Error = shared.error(types.NO_ERROR, 0);
    var deadline: time.Time = time.Time{sec: 0, nsec: 0};
    var has_deadline: bool = false;
    if (!operation.runtime_owned) { has_deadline = read_deadline(operation.scope, ?deadline); }
    if (deadline_reached(has_deadline, deadline)) {
        claim_reason(operation, cancellation.Reason.timed_out{});
    }
    if (atomic.load(?operation.cancellation_reason) == REASON_ACTIVE) {
        failure = resolver.adapter(resolver.adapter_context, ?operation.query, resolver.allocator,
            resolver.result_limits, ?operation.resolution);
    }
    if (deadline_reached(has_deadline, deadline)) {
        claim_reason(operation, cancellation.Reason.timed_out{});
    }
    if (!operation.runtime_owned) { finish_scope_use(operation); }

    mutex.lock(?resolver.lock);
    var reason: cancellation.Reason = reason_of(atomic.load(?operation.cancellation_reason));
    if (!operation.runtime_owned) { reason = settle_registration(operation); }

    if (operation.runtime_owned && operation.runtime_terminal_claimed) {
        cleanup_failed_result(operation);
        failure = runtime_error(operation.runtime_terminal_failure);
    }
    or (!sel reason.active) {
        cleanup_failed_result(operation);
        failure = cancellation_error(reason);
    }
    or (failure.kind != types.NO_ERROR) {
        cleanup_failed_result(operation);
    }
    or (!compacted(?operation.resolution)) {
        cleanup_failed_result(operation);
        failure = shared.error(types.MALFORMED, 0);
    }
    or (!shared.within_limits(?operation.resolution, resolver.result_limits)) {
        cleanup_failed_result(operation);
        failure = shared.error(types.OVERLOADED, 0);
    }

    enqueue_locked(resolver, operation, failure);
    mutex.unlock(?resolver.lock);
    ret failure.kind == types.NO_ERROR;
}

# a delivered resolution is valid, non-empty and compacted; anything else is malformed
fun compacted(resolution: *types.Resolution) bool {
    if (!shared.valid(resolution) || resolution.len == 0) { ret false; }
    val deduplicated: err[types.Error] = shared.deduplicate(resolution);
    ret sel deduplicated.ok;
}

fun build_numeric_locked(resolver: *Resolver, operation: *Operation, addr: ip.Addr, port: u16) types.Error {
    if ((operation.query.family == types.IPV4_ONLY && addr.is_v6 != 0)
     || (operation.query.family == types.IPV6_ONLY && addr.is_v6 == 0)) {
        val failure: types.Error = shared.error(types.NO_NAME, 0);
        ret failure;
    }
    val allocated: err[types.Error] = shared.allocate_endpoints(?operation.resolution, 1);
    if (sel allocated.err) { ret allocated.err; }
    operation.resolution.endpoints[0] = ip.Endpoint{addr: addr, port: port, scope: 0};
    operation.resolution.len = 1;
    if ((operation.query.flags & types.CANONICAL_NAME) != 0) {
        val named: err[types.Error] = shared.set_canonical(?operation.resolution, operation.query.host);
        if (sel named.err) {
            shared.destroy(?operation.resolution);
            ret named.err;
        }
    }
    val success: types.Error = shared.error(types.NO_ERROR, 0);
    ret success;
}

fun complete_immediate_locked(resolver: *Resolver, operation: *Operation, failure: types.Error) {
    var final_error: types.Error = failure;
    var reason: cancellation.Reason = reason_of(atomic.load(?operation.cancellation_reason));
    if (!operation.runtime_owned) {
        finish_scope_use(operation);
        reason = settle_registration(operation);
    }
    if (!sel reason.active) {
        cleanup_failed_result(operation);
        final_error = cancellation_error(reason);
    }
    enqueue_locked(resolver, operation, final_error);
}

pub fun submit(resolver: *Resolver, scope: *cancellation.Scope, query: *types.Query, context: usize) res[types.Token, types.Error] {
    if (resolver == nil || scope == nil || !valid_query(query)) {
        ret res[types.Token, types.Error].err{shared.error(types.INVALID, 0)};
    }
    if (resolver.runtime != nil) {
        ret res[types.Token, types.Error].err{shared.error(types.INVALID, 0)};
    }
    val now: time.Clock = time.monotonic();
    if (sel now.err) {
        ret res[types.Token, types.Error].err{shared.error(types.SYSTEM_FAILURE, now.err.code)};
    }
    cancellation.expire(scope, now.ok);
    val prior_reason: cancellation.Reason = cancellation.reason(scope);
    if (!sel prior_reason.active) {
        ret res[types.Token, types.Error].err{cancellation_error(prior_reason)};
    }

    mutex.lock(?resolver.lock);
    if (resolver.state != OPEN) {
        mutex.unlock(?resolver.lock);
        ret res[types.Token, types.Error].err{shared.error(types.CLOSED, 0)};
    }
    val operation: *Operation = claim_locked(resolver);
    if (operation == nil) {
        mutex.unlock(?resolver.lock);
        ret res[types.Token, types.Error].err{shared.error(types.OVERLOADED, 0)};
    }
    copy_query(operation, query, context);
    val token: types.Token = types.Token{index: operation.index, generation: operation.generation};

    operation.scope = scope;
    atomic.store(?operation.scope_use_done, 0);
    atomic.store(?operation.registration_done, 0);
    val attached: cancellation.Reason = cancellation.attach_with_completion(scope, ?operation.registration, cancel_callback, cancel_complete, operation::ptr);
    if (!sel attached.active) {
        release_locked(resolver, operation);
        mutex.unlock(?resolver.lock);
        ret res[types.Token, types.Error].err{cancellation_error(attached)};
    }

    val numeric_addr: res[ip.Addr, ip.ParseError] = ip.addr_parse(operation.query.host);
    var port: u16 = 0;
    val numeric_service: bool = parse_service(operation.query.service, ?port);
    if (sel numeric_addr.ok) {
        if (numeric_service) {
            val failure: types.Error = build_numeric_locked(resolver, operation, numeric_addr.ok, port);
            complete_immediate_locked(resolver, operation, failure);
            mutex.unlock(?resolver.lock);
            ret res[types.Token, types.Error].ok{token};
        }
    }
    if (((operation.query.flags & types.NUMERIC_HOST) != 0 && sel numeric_addr.err)
     || ((operation.query.flags & types.NUMERIC_SERVICE) != 0 && !numeric_service)) {
        complete_immediate_locked(resolver, operation, shared.error(types.NO_NAME, 0));
        mutex.unlock(?resolver.lock);
        ret res[types.Token, types.Error].ok{token};
    }
    val status: worker_pool.Status = worker_pool.try_submit(resolver.pool, worker_pool.Task{context: operation::ptr, run: run_operation});
    if (!sel status.accepted) {
        finish_scope_use(operation);
        if (transition_changed(cancellation.unregister(?operation.registration))) {
            atomic.store(?operation.registration_done, 1);
            os.thread_wake(?operation.registration_done);
            release_locked(resolver, operation);
            mutex.unlock(?resolver.lock);
            ret res[types.Token, types.Error].err{pool_error(status)};
        }
        val reason: cancellation.Reason = wait_for_cancellation(operation);
        cleanup_failed_result(operation);
        enqueue_locked(resolver, operation, cancellation_error(reason));
    }
    mutex.unlock(?resolver.lock);
    ret res[types.Token, types.Error].ok{token};
}

pub fun submit_runtime(resolver: *Resolver, scope: *cancellation.Scope,
    query: *types.Query, context: usize) res[io_runtime.Token, types.Error] {
    if (resolver == nil || resolver.runtime == nil || scope == nil || !valid_query(query)) {
        ret res[io_runtime.Token, types.Error].err{shared.error(types.INVALID, 0)};
    }
    mutex.lock(?resolver.lock);
    if (resolver.state != OPEN || !resolver.runtime_registered) {
        mutex.unlock(?resolver.lock);
        ret res[io_runtime.Token, types.Error].err{shared.error(types.CLOSED, 0)};
    }
    val operation: *Operation = claim_locked(resolver);
    if (operation == nil) {
        mutex.unlock(?resolver.lock);
        ret res[io_runtime.Token, types.Error].err{shared.error(types.OVERLOADED, 0)};
    }
    copy_query(operation, query, context);
    operation.runtime_owned = true;
    operation.scope = nil;
    operation.scope_use_done = 1;
    operation.registration_done = 1;
    val runtime_operation: io_runtime.Operation = io_runtime.Operation{
        kind: io_runtime.RESOLVE,
        resource: 0,
        buffer: nil,
        length: 0,
        offset: 0,
        context: context,
    };
    val runtime_submission: res[io_runtime.Token, io_error.Error] = io_runtime.submit_scoped_owned(
        resolver.runtime, resolver.runtime_source, scope, runtime_operation);
    if (sel runtime_submission.err) {
        val failure: types.Error = runtime_error(runtime_submission.err);
        release_locked(resolver, operation);
        mutex.unlock(?resolver.lock);
        ret res[io_runtime.Token, types.Error].err{failure};
    }
    val token: io_runtime.Token = runtime_submission.ok;
    operation.runtime_token = token;

    val numeric_addr: res[ip.Addr, ip.ParseError] = ip.addr_parse(operation.query.host);
    var port: u16 = 0;
    val numeric_service: bool = parse_service(operation.query.service, ?port);
    if (sel numeric_addr.ok) {
        if (numeric_service) {
            val failure: types.Error = build_numeric_locked(resolver, operation, numeric_addr.ok, port);
            complete_immediate_locked(resolver, operation, failure);
            mutex.unlock(?resolver.lock);
            ret res[io_runtime.Token, types.Error].ok{token};
        }
    }
    if (((operation.query.flags & types.NUMERIC_HOST) != 0 && sel numeric_addr.err)
     || ((operation.query.flags & types.NUMERIC_SERVICE) != 0 && !numeric_service)) {
        complete_immediate_locked(resolver, operation, shared.error(types.NO_NAME, 0));
        mutex.unlock(?resolver.lock);
        ret res[io_runtime.Token, types.Error].ok{token};
    }
    val status: worker_pool.Status = worker_pool.try_submit(resolver.pool,
        worker_pool.Task{context: operation::ptr, run: run_operation});
    if (!sel status.accepted) {
        enqueue_locked(resolver, operation, pool_error(status));
    }
    mutex.unlock(?resolver.lock);
    ret res[io_runtime.Token, types.Error].ok{token};
}

# cancel a live operation
# ---
# ret: whether this call changed the operation's reason (false when a
#      deadline or an earlier cancellation already ended it); `invalid` for a
#      nil resolver or an out-of-range token, `stale` for a token whose slot
#      has been reused or released, `busy` for a runtime-owned operation,
#      which the runtime's own cancellation reaches
pub fun cancel(resolver: *Resolver, token: types.Token) res[bool, StateError] {
    if (resolver == nil || token.index::usize >= resolver.capacity) {
        ret res[bool, StateError].err{StateError.invalid{}};
    }
    mutex.lock(?resolver.lock);
    val operation: *Operation = ?resolver.operations[token.index::usize];
    if (operation.state != SLOT_ACTIVE || operation.generation != token.generation) {
        mutex.unlock(?resolver.lock);
        ret res[bool, StateError].err{StateError.stale{}};
    }
    if (operation.runtime_owned) {
        mutex.unlock(?resolver.lock);
        ret res[bool, StateError].err{StateError.busy{}};
    }
    val changed: bool = claim_reason(operation, cancellation.Reason.cancelled{});
    mutex.unlock(?resolver.lock);
    ret res[bool, StateError].ok{changed};
}

fun dequeue_locked(resolver: *Resolver, output: *types.Completion, capacity: usize) usize {
    var copied: usize = 0;
    for (copied < capacity && resolver.count != 0) {
        val completion: types.Completion = resolver.completions[resolver.head];
        val operation: *Operation = ?resolver.operations[completion.token.index::usize];
        if (operation.runtime_owned && !operation.runtime_released) { ret copied; }
        output[copied] = completion;
        resolver.head = (resolver.head + 1) % resolver.capacity;
        resolver.count = resolver.count - 1;
        if (operation.runtime_owned) {
            operation.internal_dequeued = true;
            if (operation.runtime_released) { release_locked(resolver, operation); }
        } or {
            release_locked(resolver, operation);
        }
        copied = copied + 1;
    }
    ret copied;
}

pub fun poll(resolver: *Resolver, output: *types.Completion, capacity: usize) usize {
    if (resolver == nil || output == nil || capacity == 0) { ret 0; }
    mutex.lock(?resolver.lock);
    val copied: usize = dequeue_locked(resolver, output, capacity);
    mutex.unlock(?resolver.lock);
    ret copied;
}

pub fun wait(resolver: *Resolver, output: *types.Completion, capacity: usize) usize {
    if (resolver == nil || output == nil || capacity == 0) { ret 0; }
    if (resolver.runtime != nil) { ret poll(resolver, output, capacity); }
    mutex.lock(?resolver.lock);
    for (resolver.count == 0 && resolver.live != 0 && resolver.state != DESTROYED) {
        condition.wait(?resolver.ready, ?resolver.lock);
    }
    val copied: usize = dequeue_locked(resolver, output, capacity);
    mutex.unlock(?resolver.lock);
    ret copied;
}

pub fun wait_until(resolver: *Resolver, output: *types.Completion, capacity: usize, deadline: time.Time) usize {
    if (resolver == nil || output == nil || capacity == 0) { ret 0; }
    if (resolver.runtime != nil) { ret poll(resolver, output, capacity); }
    mutex.lock(?resolver.lock);
    for (resolver.count == 0 && resolver.live != 0 && resolver.state != DESTROYED) {
        val status: condition.WaitStatus = condition.wait_until(?resolver.ready, ?resolver.lock, deadline);
        if (!sel status.notified) { mutex.unlock(?resolver.lock); ret 0; }
    }
    val copied: usize = dequeue_locked(resolver, output, capacity);
    mutex.unlock(?resolver.lock);
    ret copied;
}

# stop admitting submissions; CLOSED when the resolver is not open
pub fun close(resolver: *Resolver) err[types.Error] {
    if (resolver == nil) { ret refused(types.INVALID, os.EINVAL); }
    mutex.lock(?resolver.lock);
    if (resolver.state != OPEN) { mutex.unlock(?resolver.lock); ret refused(types.CLOSED, 0); }
    resolver.state = CLOSING;
    condition.broadcast(?resolver.ready);
    mutex.unlock(?resolver.lock);
    ret err[types.Error].ok{};
}

# release a dequeued completion's storage; a refused release keeps the
# storage owned so the caller can retry
pub fun resolution_destroy(resolution: *types.Resolution) err[types.Error] {
    ret shared.destroy(resolution);
}

# release the resolver's storage: INVALID with EINVAL before close, INVALID
# with EBUSY while operations, completions or waiters remain; a refused
# release reports the runtime's or the allocator's failure after every
# release has been attempted
pub fun destroy(resolver: *Resolver) err[types.Error] {
    if (resolver == nil) { ret refused(types.INVALID, os.EINVAL); }
    mutex.lock(?resolver.lock);
    if (resolver.state != CLOSING) {
        mutex.unlock(?resolver.lock);
        ret refused(types.INVALID, os.EINVAL);
    }
    if (resolver.live != 0 || resolver.count != 0 || condition.waiter_count(?resolver.ready) != 0) {
        mutex.unlock(?resolver.lock);
        ret refused(types.INVALID, os.EBUSY);
    }
    val attached_runtime: *io_runtime.Runtime = resolver.runtime;
    val runtime_source: io_runtime.SourceToken = resolver.runtime_source;
    val runtime_registered: bool = resolver.runtime_registered;
    if (runtime_registered) {
        val retired: res[bool, io_error.Error] = io_runtime.retire_source(
            resolver.runtime, resolver.runtime_source);
        if (sel retired.err) {
            mutex.unlock(?resolver.lock);
            ret err[types.Error].err{runtime_error(retired.err)};
        }
        resolver.runtime_registered = false;
    }
    val owner: *allocator.Allocator = resolver.allocator;
    val operations: *Operation = resolver.operations;
    val completions: *types.Completion = resolver.completions;
    val capacity: usize = resolver.capacity;
    resolver.state = DESTROYED;
    resolver.operations = nil;
    resolver.completions = nil;
    resolver.capacity = 0;
    resolver.pool = nil;
    resolver.allocator = nil;
    resolver.runtime = nil;
    mutex.unlock(?resolver.lock);
    val operations_freed: err[allocator.Error] = allocator.deallocate[Operation](owner, operations, capacity);
    val completions_freed: err[allocator.Error] = allocator.deallocate[types.Completion](owner, completions, capacity);
    var first: err[types.Error] = err[types.Error].ok{};
    var refused_any: bool = false;
    if (runtime_registered) {
        val source_released: err[io_error.Error] = io_runtime.release_source(attached_runtime, runtime_source);
        if (sel source_released.err) {
            first = err[types.Error].err{runtime_error(source_released.err)};
            refused_any = true;
        }
    }
    if (sel operations_freed.err) {
        if (!refused_any) { first = release_refused(operations_freed.err); }
        refused_any = true;
    }
    if (sel completions_freed.err) {
        if (!refused_any) { first = release_refused(completions_freed.err); }
    }
    ret first;
}

fun release_refused(failure: allocator.Error) err[types.Error] {
    if (sel failure.release) { ret refused(types.SYSTEM_FAILURE, failure.release); }
    ret refused(types.INVALID, os.EINVAL);
}

# test predicates: `sel` takes a place, so an inline call is tested through these
fun ok_err(r: err[io_error.Error]) bool { ret sel r.ok; }
fun ok_bool(r: res[bool, io_error.Error]) bool { ret sel r.ok; }
fun made(r: err[types.Error]) bool { ret sel r.ok; }
fun made_kind(r: err[types.Error], kind: types.ErrorKind) bool { ret sel r.err && r.err.kind == kind; }
fun closed(resolver: *Resolver) bool { val r: err[types.Error] = close(resolver); ret sel r.ok; }
fun destroyed(resolver: *Resolver) bool { val r: err[types.Error] = destroy(resolver); ret sel r.ok; }
fun released(resolution: *types.Resolution) bool { val r: err[types.Error] = resolution_destroy(resolution); ret sel r.ok; }
fun cancelled(resolver: *Resolver, token: types.Token) bool {
    val r: res[bool, StateError] = cancel(resolver, token);
    ret sel r.ok && r.ok;
}

rec TestPool {
    queue: [4]worker_pool.Task;
    threads: [1]thread.Thread;
    workers: [1]worker_pool.Worker;
    pool: worker_pool.Pool;
}

rec Gate {
    entered: i64;
    release: i64;
}

rec ScopeTransition {
    scope: *cancellation.Scope;
    deadline: time.Time;
    expire: bool;
    entered: i64;
    done: i64;
    result: i64;
}

fun resolver_threads_supported() bool {
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret false; }
    }
    ret true;
}

fun test_pool_make(value: *TestPool, queue_capacity: usize) bool {
    val made: worker_pool.Status = worker_pool.make(?value.pool, (?value.queue)::*worker_pool.Task, queue_capacity,
        (?value.threads)::*thread.Thread, (?value.workers)::*worker_pool.Worker, 1);
    ret sel made.accepted;
}

fun test_pool_destroy(value: *TestPool) bool {
    val drained: worker_pool.Status = worker_pool.shutdown_drain(?value.pool);
    if (!sel drained.joined) { ret false; }
    val destroyed: worker_pool.Operation = worker_pool.destroy(?value.pool);
    ret sel destroyed.ok;
}

fun scope_ok(r: cancellation.Operation) bool { ret sel r.ok; }

fun scope_changed(r: cancellation.Transition) bool { ret transition_changed(r); }

fun scope_destroyed(scope: *cancellation.Scope) bool {
    val destroyed: cancellation.Operation = cancellation.destroy(scope);
    ret sel destroyed.ok;
}

fun thread_joined(t: *thread.Thread) bool {
    val joined: thread.Operation = thread.join(t);
    ret sel joined.ok;
}

fun gate_run(context: ptr) bool {
    val gate: *Gate = context::*Gate;
    atomic.store(?gate.entered, 1);
    os.thread_wake(?gate.entered);
    for (atomic.load(?gate.release) == 0) { os.thread_wait(?gate.release, 0); }
    ret true;
}

fun transition_run(argument: *u8) {
    val transition: *ScopeTransition = argument::*ScopeTransition;
    atomic.store(?transition.entered, 1);
    os.thread_wake(?transition.entered);
    var changed: bool = false;
    if (transition.expire) {
        changed = transition_changed(cancellation.expire(transition.scope, transition.deadline));
    } or {
        changed = transition_changed(cancellation.cancel(transition.scope));
    }
    if (changed) { atomic.store(?transition.result, 1); }
    atomic.store(?transition.done, 1);
    os.thread_wake(?transition.done);
}

fun transition_wait_entered(transition: *ScopeTransition) {
    for (atomic.load(?transition.entered) == 0) { os.thread_wait(?transition.entered, 0); }
}

fun operation_wait_reason(operation: *Operation) cancellation.Reason {
    var code: i64 = atomic.load(?operation.cancellation_reason);
    for (code == REASON_ACTIVE) {
        os.thread_wait(?operation.cancellation_reason, REASON_ACTIVE);
        code = atomic.load(?operation.cancellation_reason);
    }
    ret reason_of(code);
}

fun gate_wait_entered(gate: *Gate) {
    for (atomic.load(?gate.entered) == 0) { os.thread_wait(?gate.entered, 0); }
}

fun gate_release(gate: *Gate) {
    atomic.store(?gate.release, 1);
    os.thread_wake(?gate.release);
}

fun test_limits() types.ResultLimits {
    ret types.ResultLimits{max_endpoints: 8, max_canonical_name_bytes: 256};
}

fun fake_adapter(context: ptr, query: *types.Query, owner: *allocator.Allocator,
    limits: types.ResultLimits, output: *types.Resolution) types.Error {
    shared.clear(output, owner);
    if (query.protocol == 1) { ret shared.error(types.TEMPORARY, 71); }
    if (query.protocol == 2) { ret shared.error(types.NO_NAME, 72); }
    if (limits.max_endpoints < 4) { ret shared.error(types.OVERLOADED, 0); }
    val allocated: err[types.Error] = shared.allocate_endpoints(output, 4);
    if (sel allocated.err) { ret allocated.err; }
    output.endpoints[0] = ip.endpoint(192, 0, 2, 2, 443);
    output.endpoints[1] = ip.endpoint_v6(ip.ipv6_loopback(), 443, 0);
    output.endpoints[2] = output.endpoints[0];
    output.endpoints[3] = ip.endpoint(192, 0, 2, 1, 443);
    output.len = 4;
    if (query.protocol == 3) {
        output.len = 5;
        ret shared.error(types.NO_ERROR, 0);
    }
    if (!shared.canonical_fits(query.host, limits.max_canonical_name_bytes)) {
        shared.destroy(output);
        ret shared.error(types.OVERLOADED, 0);
    }
    val named: err[types.Error] = shared.set_canonical(output, query.host);
    if (sel named.err) {
        shared.destroy(output);
        ret named.err;
    }
    ret shared.error(types.NO_ERROR, 0);
}

fun gated_adapter(context: ptr, query: *types.Query, owner: *allocator.Allocator,
    limits: types.ResultLimits, output: *types.Resolution) types.Error {
    gate_run(context);
    ret fake_adapter(nil, query, owner, limits, output);
}

fun test_query(host: *u8, service: *u8, protocol: i32) types.Query {
    ret types.Query{
        host: host,
        service: service,
        family: types.ANY_FAMILY,
        socket_kind: types.ANY_SOCKET,
        protocol: protocol,
        flags: 0,
    };
}

fun test_endpoint_equal(a: ip.Endpoint, b: ip.Endpoint) bool {
    if (a.addr.is_v6 != b.addr.is_v6 || a.port != b.port || a.scope != b.scope) { ret false; }
    var i: usize = 0;
    if (a.addr.is_v6 == 0) {
        for (i < 4) {
            if (a.addr.v4.octets[i] != b.addr.v4.octets[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    for (i < 16) {
        if (a.addr.v6.octets[i] != b.addr.v6.octets[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun test_resolver_cleanup(resolver: *Resolver, pool: *TestPool) bool {
    ret closed(resolver) && destroyed(resolver) && test_pool_destroy(pool);
}

test "resolver: numeric fast paths own results and preserve token generations" {
    if (!resolver_threads_supported()) { ret 0; }
    var owner: allocator.Allocator;
    page.make(?owner);
    var pool: TestPool;
    if (!test_pool_make(?pool, 1)) { ret 1; }
    var resolver: Resolver;
    if (!made(make(?resolver, ?pool.pool, ?owner, 1, test_limits()))) { ret 1; }
    var scope: cancellation.Scope;
    if (!scope_ok(cancellation.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 2; }

    var query: types.Query = test_query("127.0.0.1", "8443", 0);
    query.flags = types.CANONICAL_NAME | types.NUMERIC_HOST | types.NUMERIC_SERVICE;
    val submitted4: res[types.Token, types.Error] = submit(?resolver, ?scope, ?query, 41);
    if (sel submitted4.err) { ret 3; }
    val token4: types.Token = submitted4.ok;
    var completion: types.Completion;
    if (poll(?resolver, ?completion, 1) != 1 || completion.has_error || completion.context != 41
     || completion.resolution.len != 1 || completion.resolution.endpoints[0].addr.is_v6 != 0
     || completion.resolution.endpoints[0].port != 8443 || completion.resolution.canonical_length != 9) { ret 4; }
    if (!released(?completion.resolution)) { ret 5; }

    query = test_query("::1", "443", 0);
    query.family = types.IPV6_ONLY;
    query.flags = types.NUMERIC_HOST | types.NUMERIC_SERVICE;
    val submitted6: res[types.Token, types.Error] = submit(?resolver, ?scope, ?query, 42);
    if (sel submitted6.err) { ret 6; }
    val token6: types.Token = submitted6.ok;
    if (token6.index != token4.index || token6.generation == token4.generation) { ret 7; }
    if (poll(?resolver, ?completion, 1) != 1 || completion.has_error
     || completion.resolution.len != 1 || completion.resolution.endpoints[0].addr.is_v6 == 0
     || completion.resolution.endpoints[0].port != 443) { ret 8; }
    if (!released(?completion.resolution)) { ret 9; }
    if (!scope_ok(cancellation.destroy(?scope)) || !test_resolver_cleanup(?resolver, ?pool)) { ret 10; }
    ret 0;
}

