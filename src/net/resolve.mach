test "resolver: token cancellation and deadline preserve the first reason" {
    if (!resolver_threads_supported()) { ret 0; }
    var owner: allocator.Allocator;
    page.make(?owner);
    var pool: TestPool;
    if (!test_pool_make(?pool, 1)) { ret 1; }
    var gate: Gate = Gate{entered: 0, release: 0};
    var resolver: Resolver;
    if (!made(make_with_adapter(?resolver, ?pool.pool, ?owner, 1, test_limits(), (?gate)::ptr, gated_adapter))) { ret 2; }
    var query: types.Query = test_query("race", nil, 0);
    var scope: cancellation.Scope;
    val clock: time.Clock = time.monotonic();
    if (sel clock.err) { ret 1; }
    val deadline: time.Time = time.time_add(clock.ok, 1000000000);
    if (!scope_ok(cancellation.make_root(?scope, true, deadline))) { ret 3; }
    val token_first_submission: res[types.Token, types.Error] = submit(?resolver, ?scope, ?query, 41);
    if (sel token_first_submission.err) { ret 4; }
    gate_wait_entered(?gate);
    if (!cancelled(?resolver, token_first_submission.ok)) { ret 5; }
    var transition: ScopeTransition = ScopeTransition{
        scope: ?scope, deadline: time.time_add(deadline, 1), expire: true,
        entered: 0, done: 0, result: 0,
    };
    var transition_thread: thread.Thread;
    thread.spawn_with(transition_run, (?transition)::*u8, ?transition_thread);
    if (transition_thread.tid < 0) { ret 6; }
    transition_wait_entered(?transition);
    val waited: cancellation.Reason = cancellation.wait(?scope);
    if (!sel waited.timed_out) { ret 7; }
    gate_release(?gate);
    if (!thread_joined(?transition_thread) || atomic.load(?transition.result) == 0) { ret 8; }
    var completion: types.Completion;
    if (wait(?resolver, ?completion, 1) != 1 || !completion.has_error
     || completion.error.kind != types.CANCELLED || completion.context != 41) { ret 9; }
    if (!scope_ok(cancellation.destroy(?scope))) { ret 10; }

    gate = Gate{entered: 0, release: 0};
    val second_clock: time.Clock = time.monotonic();
    if (sel second_clock.err) { ret 9; }
    val second_deadline: time.Time = time.time_add(second_clock.ok, 1000000000);
    if (!scope_ok(cancellation.make_root(?scope, true, second_deadline))) { ret 11; }
    val deadline_first_submission: res[types.Token, types.Error] = submit(?resolver, ?scope, ?query, 42);
    if (sel deadline_first_submission.err) { ret 12; }
    val deadline_token: types.Token = deadline_first_submission.ok;
    gate_wait_entered(?gate);
    transition = ScopeTransition{
        scope: ?scope, deadline: time.time_add(second_deadline, 1), expire: true,
        entered: 0, done: 0, result: 0,
    };
    thread.spawn_with(transition_run, (?transition)::*u8, ?transition_thread);
    if (transition_thread.tid < 0) { ret 13; }
    transition_wait_entered(?transition);
    val deadline_reason: cancellation.Reason = operation_wait_reason(?resolver.operations[deadline_token.index::usize]);
    if (!sel deadline_reason.timed_out || cancelled(?resolver, deadline_token)) { ret 14; }
    gate_release(?gate);
    if (!thread_joined(?transition_thread) || atomic.load(?transition.result) == 0) { ret 15; }
    if (wait(?resolver, ?completion, 1) != 1 || !completion.has_error
     || completion.error.kind != types.TIMED_OUT || completion.context != 42) { ret 16; }
    if (!scope_ok(cancellation.destroy(?scope)) || !test_resolver_cleanup(?resolver, ?pool)) { ret 17; }
    ret 0;
}

