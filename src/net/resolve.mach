    if (count < 2) { count = count + wait(?resolver, ?completions[count], 2 - count); }
    if (count != 2 || completions[0].error.kind != types.CANCELLED
     || completions[1].error.kind != types.CANCELLED) { ret 5; }
    if (!scope_destroyed(?scopes[0]) || !scope_destroyed(?scopes[1]) || !scope_destroyed(?scopes[2])
     || !test_resolver_cleanup(?resolver, ?pool)) { ret 6; }
