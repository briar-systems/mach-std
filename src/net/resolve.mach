    if (!test_pool_make(?pool, 1)) { ret 2; }
    var resolver: Resolver;
    if (!made(make_runtime_with_adapter(?resolver, ?runtime, ?pool.pool, ?owner, 1,
        test_limits(), nil, fake_adapter))) { ret 3; }
    var scope: cancellation.Scope;
    cancellation.make_root(?scope, false, time.Time{sec: 0, nsec: 0});
    var query: types.Query = test_query("runtime-success", nil, 0);
    val submitted: res[io_runtime.Token, types.Error] = submit_runtime(
        ?resolver, ?scope, ?query, 62);
    if (sel submitted.err) { ret 4; }
    var runtime_completion: io_runtime.Completion;
    val waited: res[usize, io_error.Error] = io_runtime.wait(
        ?runtime, ?runtime_completion, 1, 1000);
    if (sel waited.err) { ret 5; }
    if (waited.ok != 1) { ret 5; }
    if (runtime_completion.kind != io_runtime.RESOLVE) { ret 5; }
    if (runtime_completion.context != 62) { ret 5; }
    if (runtime_completion.has_error) { ret 5; }
    var resolver_completion: types.Completion;
    if (poll(?resolver, ?resolver_completion, 1) != 1
     || resolver_completion.has_error
     || resolver_completion.context != 62
     || resolver_completion.resolution.len != 3
     || resolver.live != 0) { ret 6; }
    if (!released(?resolver_completion.resolution)
     || !scope_ok(cancellation.destroy(?scope))
     || !closed(?resolver)
     || !destroyed(?resolver)
     || !ok_bool(io_runtime.close(?runtime))
     || !ok_err(io_runtime.destroy(?runtime))
     || !test_pool_destroy(?pool)) { ret 7; }
    ret 0;
}

test "resolver: queued result adopts runtime close before dispatch" {
    if (!resolver_threads_supported()) { ret 0; }
    var owner: allocator.Allocator;
    page.make(?owner);
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 2))) { ret 1; }
    var pool: TestPool;
    if (!test_pool_make(?pool, 1)) { ret 2; }
    var resolver: Resolver;
    if (!made(make_runtime_with_adapter(?resolver, ?runtime, ?pool.pool, ?owner, 1,
        test_limits(), nil, fake_adapter))) { ret 3; }
    var scope: cancellation.Scope;
    cancellation.make_root(?scope, false, time.Time{sec: 0, nsec: 0});
    var query: types.Query = test_query("127.0.0.1", "443", 0);
    query.flags = types.CANONICAL_NAME | types.NUMERIC_HOST | types.NUMERIC_SERVICE;
    val submitted: res[io_runtime.Token, types.Error] = submit_runtime(?resolver, ?scope, ?query, 63);
    if (sel submitted.err || resolver.count != 1) { ret 4; }
    var resolver_completion: types.Completion;
    if (poll(?resolver, ?resolver_completion, 1) != 0) { ret 5; }
    if (!ok_bool(io_runtime.close(?runtime))) { ret 5; }
    var runtime_completion: io_runtime.Completion;
    val runtime_result: res[usize, io_error.Error] = io_runtime.poll(
        ?runtime, ?runtime_completion, 1);
    if (sel runtime_result.err) { ret 6; }
    if (runtime_result.ok != 1) { ret 6; }
    if (runtime_completion.kind != io_runtime.RESOLVE) { ret 6; }
    if (runtime_completion.context != 63) { ret 6; }
    if (!runtime_completion.has_error) { ret 6; }
    if (runtime_completion.error.kind != io_error.CLOSED) { ret 6; }
    if (poll(?resolver, ?resolver_completion, 1) != 1
     || !resolver_completion.has_error
     || resolver_completion.error.kind != types.CLOSED
     || resolver_completion.resolution.endpoints != nil
     || resolver_completion.resolution.canonical_name != nil
     || resolver.live != 0) { ret 7; }
    if (!scope_ok(cancellation.destroy(?scope))
     || !closed(?resolver)
     || !destroyed(?resolver)
     || !ok_err(io_runtime.destroy(?runtime))
     || !test_pool_destroy(?pool)) { ret 8; }
    ret 0;
}

test "resolver: runtime cancellation and deadline preserve the first reason" {
    if (!resolver_threads_supported()) { ret 0; }
    var owner: allocator.Allocator;
    page.make(?owner);
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 2))) { ret 1; }
    var pool: TestPool;
    if (!test_pool_make(?pool, 1)) { ret 2; }
    var gate: Gate = Gate{entered: 0, release: 0};
    var resolver: Resolver;
    if (!made(make_runtime_with_adapter(?resolver, ?runtime, ?pool.pool, ?owner, 1,
        test_limits(), (?gate)::ptr, gated_adapter))) { ret 3; }
    var scope: cancellation.Scope;
    cancellation.make_root(?scope, false, time.Time{sec: 0, nsec: 0});
    var query: types.Query = test_query("deadline-first", nil, 0);
    val submit_runtime_result: res[io_runtime.Token, types.Error] = submit_runtime(
        ?resolver, ?scope, ?query, 71);
    if (sel submit_runtime_result.err) { ret 4; }
    gate_wait_entered(?gate);
    val deadline_close: res[lifecycle.CloseResult, io_error.Error] = io_runtime.begin_close(
        ?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    val later_cancel: res[lifecycle.CloseResult, io_error.Error] = io_runtime.begin_close(
        ?runtime, lifecycle.ABORTIVE, lifecycle.CANCELLATION);
    if (sel deadline_close.err) { ret 5; }
    if (sel later_cancel.err) { ret 5; }
    if (!deadline_close.ok.started) { ret 5; }
    if (later_cancel.ok.escalated) { ret 5; }
    if (!scope_destroyed(?scope)) { ret 5; }
    gate_release(?gate);
    var runtime_completion: io_runtime.Completion;
    var deadline_wait: res[usize, io_error.Error] = io_runtime.wait(
        ?runtime, ?runtime_completion, 1, 1000);
    if (sel deadline_wait.ok && deadline_wait.ok == 0) {
        deadline_wait = io_runtime.wait(?runtime, ?runtime_completion, 1, 1000);
    }
    var resolver_completion: types.Completion;
    if (sel deadline_wait.err) { ret 6; }
    if (deadline_wait.ok != 1) { ret 6; }
    if (runtime_completion.error.kind != io_error.TIMEOUT) { ret 6; }
    if (poll(?resolver, ?resolver_completion, 1) != 1) { ret 6; }
    if (resolver_completion.error.kind != types.TIMED_OUT) { ret 6; }
    if (!closed(?resolver) || !destroyed(?resolver)
     || !ok_err(io_runtime.destroy(?runtime))
     || !test_pool_destroy(?pool)) { ret 7; }

    if (!ok_err(io_runtime.make(?runtime, 2))
     || !test_pool_make(?pool, 1)) { ret 8; }
    gate = Gate{entered: 0, release: 0};
    if (!made(make_runtime_with_adapter(?resolver, ?runtime, ?pool.pool, ?owner, 1,
        test_limits(), (?gate)::ptr, gated_adapter))) { ret 9; }
    cancellation.make_root(?scope, false, time.Time{sec: 0, nsec: 0});
    query = test_query("cancel-first", nil, 0);
    val second_submission: res[io_runtime.Token, types.Error] = submit_runtime(
        ?resolver, ?scope, ?query, 72);
    if (sel second_submission.err) { ret 10; }
    gate_wait_entered(?gate);
    if (!scope_changed(cancellation.cancel(?scope))) { ret 11; }
    val later_deadline: res[lifecycle.CloseResult, io_error.Error] = io_runtime.begin_close(
        ?runtime, lifecycle.ABORTIVE, lifecycle.DEADLINE);
    if (sel later_deadline.err) { ret 12; }
    if (!scope_ok(cancellation.destroy(?scope))) { ret 12; }
    gate_release(?gate);
    var cancel_wait: res[usize, io_error.Error] = io_runtime.wait(
        ?runtime, ?runtime_completion, 1, 1000);
    if (sel cancel_wait.ok && cancel_wait.ok == 0) {
        cancel_wait = io_runtime.wait(?runtime, ?runtime_completion, 1, 1000);
    }
    if (sel cancel_wait.err) { ret 13; }
    if (cancel_wait.ok != 1) { ret 13; }
    if (runtime_completion.error.kind != io_error.CANCELLED) { ret 13; }
    if (poll(?resolver, ?resolver_completion, 1) != 1) { ret 13; }
    if (resolver_completion.error.kind != types.CANCELLED) { ret 13; }
    if (!closed(?resolver) || !destroyed(?resolver)
     || !ok_err(io_runtime.destroy(?runtime))
     || !test_pool_destroy(?pool)) { ret 14; }
    ret 0;
}
