# UDP socket operations

use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use std.types.canonical.res;
use std.types.canonical.err;
use std.system.os;
use std.net.ip;
use socket_api: std.net.socket;
use io_error: std.io.error;
use io_handle: std.io.handle;

# a bound or unbound UDP socket
# ---
# handle: the native-width socket handle
pub rec Socket {
    handle: io_handle.SocketHandle;
    family: i32;
}

# create an unbound UDP socket
# ---
# ret: the Socket, or an error message
pub fun create() res[Socket, io_error.Error] {
    ret create_for(os.AF_INET, socket_api.blocking_flags());
}

pub fun create_v6() res[Socket, io_error.Error] {
    ret create_for(os.AF_INET6, socket_api.blocking_flags());
}

pub fun create_with_flags(family: i32, flags: socket_api.Flags) res[Socket, io_error.Error] {
    ret create_for(family, flags);
}

fun create_for(family: i32, flags: socket_api.Flags) res[Socket, io_error.Error] {
    val created: res[io_handle.SocketHandle, io_error.Error] = socket_api.create(family, os.SOCK_DGRAM, 0, flags);
    if (sel created.err) {
        ret res[Socket, io_error.Error].err{created.err};
    }
    ret res[Socket, io_error.Error].ok{Socket{handle: created.ok, family: family}};
}

# create a UDP socket bound to an endpoint
# ---
# ep:  endpoint to bind to
# ret: the bound Socket, or an error message
pub fun bind(ep: ip.Endpoint) res[Socket, io_error.Error] {
    ret bind_with_flags(ep, socket_api.blocking_flags());
}

pub fun bind_with_flags(ep: ip.Endpoint, flags: socket_api.Flags) res[Socket, io_error.Error] {
    val family: i32 = ip.endpoint_family(ep);
    val created: res[io_handle.SocketHandle, io_error.Error] = socket_api.create(family, os.SOCK_DGRAM, 0, flags);
    if (sel created.err) {
        ret res[Socket, io_error.Error].err{created.err};
    }
    val handle: io_handle.SocketHandle = created.ok;
    val raw: usize = handle.value;

    var opt: i32 = 1;
    var code: i64 = os.sock_setopt(raw, os.SOL_SOCKET, os.SO_REUSEADDR, (?opt)::*u8, 4);
    if (code < 0) {
        os.sock_close(raw);
        ret res[Socket, io_error.Error].err{io_error.from_code(code, io_error.OP_OPTION)};
    }

    var sa: [128]u8;
    val sa_len: usize = ip.to_sockaddr(ep, ?sa[0]);

    code = os.sock_bind(raw, ?sa[0], sa_len);
    if (code < 0) {
        os.sock_close(raw);
        ret res[Socket, io_error.Error].err{io_error.from_code(code, io_error.OP_BIND)};
    }

    ret res[Socket, io_error.Error].ok{Socket{handle: io_handle.SocketHandle{value: raw}, family: family}};
}

pub fun local_endpoint(s: *Socket) res[ip.Endpoint, io_error.Error] {
    ret socket_api.local_endpoint(s.handle);
}

pub fun remote_endpoint(s: *Socket) res[ip.Endpoint, io_error.Error] {
    ret socket_api.remote_endpoint(s.handle);
}

# send a datagram to a remote endpoint
# ---
# s:   the socket to send from
# buf: source buffer
# len: number of bytes to send
# ep:  destination endpoint
# ret: number of bytes sent, or negative on error
pub fun send_to(s: *Socket, buf: *u8, len: usize, ep: ip.Endpoint) res[usize, io_error.Error] {
    if (s.family != ip.endpoint_family(ep)) {
        ret res[usize, io_error.Error].err{io_error.from_code(os.EINVAL, io_error.OP_SEND)};
    }
    var sa: [128]u8;
    val sa_len: usize = ip.to_sockaddr(ep, ?sa[0]);
    val n: i64 = os.sock_sendto(s.handle.value, buf, len, 0, ?sa[0], sa_len);
    if (n < 0) { ret res[usize, io_error.Error].err{io_error.from_code(n, io_error.OP_SEND)}; }
    ret res[usize, io_error.Error].ok{n::usize};
}

# receive a datagram and populate the source endpoint
# ---
# s:   the socket to receive on
# buf: destination buffer
# len: maximum bytes to receive
# ep:  pointer to an Endpoint to fill with the source address
# ret: number of bytes received, or negative on error
pub fun recv_from(s: *Socket, buf: *u8, len: usize, ep: *ip.Endpoint) res[usize, io_error.Error] {
    var sa: [128]u8;
    var sa_len: u32 = os.SOCKADDR_STORAGE_SIZE::u32;
    val n: i64 = os.sock_recvfrom(s.handle.value, buf, len, 0, ?sa[0], ?sa_len);
    if (n >= 0 && ep != nil) {
        if (!ip.from_sockaddr(?sa[0], ep)) {
            ret res[usize, io_error.Error].err{io_error.from_code(os.ENOTSUP, io_error.OP_RECEIVE)};
        }
    }
    if (n < 0) { ret res[usize, io_error.Error].err{io_error.from_code(n, io_error.OP_RECEIVE)}; }
    ret res[usize, io_error.Error].ok{n::usize};
}

# bound blocking receives on a UDP socket to a timeout
#
# sets SO_RCVTIMEO on the socket. after ms elapses with no datagram pending, a
# recv_from returns a normalized timeout or would-block error. ms == 0
# restores indefinite blocking.
# ---
# s:   the socket to bound receives on
# ms:  timeout in milliseconds, or 0 for no timeout
# ret: ok on success, or an error message
pub fun socket_set_recv_timeout(s: *Socket, ms: u64) err[io_error.Error] {
    val code: i64 = os.sock_set_rcvtimeo(s.handle.value, ms);
    if (code < 0) {
        ret err[io_error.Error].err{io_error.from_code(code, io_error.OP_OPTION)};
    }
    ret err[io_error.Error].ok{};
}

# close a UDP socket
# ---
# s: the socket to close
pub fun socket_close(s: *Socket) err[io_error.Error] {
    if (!io_handle.socket_is_valid(s.handle)) {
        ret err[io_error.Error].err{io_error.from_code(os.EBADF, io_error.OP_CLOSE)};
    }
    val raw: usize = s.handle.value;
    s.handle = io_handle.invalid_socket();
    val code: i64 = os.sock_close(raw);
    if (code < 0) { ret err[io_error.Error].err{io_error.from_code(code, io_error.OP_CLOSE)}; }
    ret err[io_error.Error].ok{};
}

test "udp: create and close socket" {
    val r: res[Socket, io_error.Error] = create();
    if (sel r.err) { ret 1; }
    var s: Socket = r.ok;
    socket_close(?s);
    ret 0;
}

test "udp: bind to loopback" {
    val ep: ip.Endpoint = ip.endpoint(127, 0, 0, 1, 0);
    val r: res[Socket, io_error.Error] = bind(ep);
    if (sel r.err) { ret 1; }
    var s: Socket = r.ok;
    socket_close(?s);
    ret 0;
}

test "udp: duplicate close is normalized" {
    val r: res[Socket, io_error.Error] = create();
    if (sel r.err) { ret 1; }
    var s: Socket = r.ok;
    val socket_close_result: err[io_error.Error] = socket_close(?s);
    if (sel socket_close_result.err) { ret 1; }
    val second: err[io_error.Error] = socket_close(?s);
    if (!sel second.err) { ret 1; }
    if (second.err.kind != io_error.CLOSED) { ret 1; }
    ret 0;
}

test "udp: IPv6 loopback bind" {
    val ep: ip.Endpoint = ip.endpoint_v6(ip.ipv6_loopback(), 0, 0);
    val r: res[Socket, io_error.Error] = bind(ep);
    if (sel r.err) { ret 1; }
    var s: Socket = r.ok;
    if (s.family != os.AF_INET6) { socket_close(?s); ret 1; }
    socket_close(?s);
    ret 0;
}
