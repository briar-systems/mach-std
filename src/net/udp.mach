# UDP socket operations

use io_error:  std.io.error;
use io_handle: std.io.handle;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

$if (capability.HAS_SOCKETS) {
    use std.net.ip;
    use socket_api: std.net.socket;
    use std.system.os;
}
$or {
    $error("std.net.udp needs the sockets capability (std.system.capability.HAS_SOCKETS)");
}

# a bound or unbound UDP socket
# ---
# handle: the native-width socket handle
pub rec Socket {
    handle: io_handle.SocketHandle;
    family: i32;
}

# create an unbound UDP socket
# ---
# ret: the Socket, or an error message
pub fun create() res[Socket, io_error.Error] {
    ret create_for(os.AF_INET, socket_api.blocking_flags());
}

pub fun create_v6() res[Socket, io_error.Error] {
    ret create_for(os.AF_INET6, socket_api.blocking_flags());
}

pub fun create_with_flags(family: i32, flags: socket_api.Flags) res[Socket, io_error.Error] {
    ret create_for(family, flags);
}

fun create_for(family: i32, flags: socket_api.Flags) res[Socket, io_error.Error] {
    val created: res[io_handle.SocketHandle, io_error.Error] = socket_api.create(family, os.SOCK_DGRAM, 0, flags);
    if (sel created.err) {
        ret res[Socket, io_error.Error].err{created.err};
    }
    ret res[Socket, io_error.Error].ok{Socket{handle: created.ok, family: family}};
}

# create a UDP socket bound to an endpoint
# ---
# ep:  endpoint to bind to
# ret: the bound Socket, or an error message
pub fun bind(ep: ip.Endpoint) res[Socket, io_error.Error] {
    ret bind_with_flags(ep, socket_api.blocking_flags());
}

pub fun bind_with_flags(ep: ip.Endpoint, flags: socket_api.Flags) res[Socket, io_error.Error] {
    ret bind_with_options(ep, socket_api.bind_options(), flags);
}

# create a blocking UDP socket bound with explicit options
# ---
# ep:      endpoint to bind to
# options: options applied between creation and bind
# ret:     the bound Socket, or the refusal. reuse_port where the target has
#          no SO_REUSEPORT is UNSUPPORTED, and no socket is created
pub fun bind_with(ep: ip.Endpoint, options: socket_api.BindOptions) res[Socket, io_error.Error] {
    ret bind_with_options(ep, options, socket_api.blocking_flags());
}

# create a UDP socket bound with explicit options and creation flags
# ---
# ep:      endpoint to bind to
# options: options applied between creation and bind
# flags:   socket creation flags
# ret:     the bound Socket, or the refusal
pub fun bind_with_options(ep: ip.Endpoint, options: socket_api.BindOptions, flags: socket_api.Flags) res[Socket, io_error.Error] {
    val checked: err[io_error.Error] = socket_api.check_bind_options(options, io_error.OP_OPTION);
    if (sel checked.err) {
        ret res[Socket, io_error.Error].err{checked.err};
    }
    val family:  i32                                         = ip.endpoint_family(ep);
    val created: res[io_handle.SocketHandle, io_error.Error] = socket_api.create(family, os.SOCK_DGRAM, 0, flags);
    if (sel created.err) {
        ret res[Socket, io_error.Error].err{created.err};
    }
    val handle: io_handle.SocketHandle = created.ok;
    val raw:    usize                  = handle.value;

    val applied: err[io_error.Error] = socket_api.apply_bind_options(handle, options);
    if (sel applied.err) {
        os.sock_close(raw);
        ret res[Socket, io_error.Error].err{applied.err};
    }

    var sa:     [128]u8;
    val sa_len: usize = ip.to_sockaddr(ep, ?sa[0]);

    val code: i64 = os.sock_bind(raw, ?sa[0], sa_len);
    if (code < 0) {
        os.sock_close(raw);
        ret res[Socket, io_error.Error].err{os.error(code, io_error.OP_BIND)};
    }

    ret res[Socket, io_error.Error].ok{Socket{handle: handle, family: family}};
}

pub fun local_endpoint(s: *Socket) res[ip.Endpoint, io_error.Error] {
    ret socket_api.local_endpoint(s.handle);
}

pub fun remote_endpoint(s: *Socket) res[ip.Endpoint, io_error.Error] {
    ret socket_api.remote_endpoint(s.handle);
}

# send a datagram to a remote endpoint
# ---
# s:   the socket to send from
# buf: source buffer
# len: number of bytes to send
# ep:  destination endpoint
# ret: number of bytes sent, or negative on error
pub fun send_to(s: *Socket, buf: *u8, len: usize, ep: ip.Endpoint) res[usize, io_error.Error] {
    if (s.family != ip.endpoint_family(ep)) {
        ret res[usize, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_SEND)};
    }
    var sa:     [128]u8;
    val sa_len: usize = ip.to_sockaddr(ep, ?sa[0]);
    val n:      i64   = os.sock_sendto(s.handle.value, buf, len, 0, ?sa[0], sa_len);
    if (n < 0) { ret res[usize, io_error.Error].err{os.error(n, io_error.OP_SEND)}; }
    ret res[usize, io_error.Error].ok{n::usize};
}

# receive a datagram and populate the source endpoint
# ---
# s:   the socket to receive on
# buf: destination buffer
# len: maximum bytes to receive
# ep:  pointer to an Endpoint to fill with the source address
# ret: number of bytes received, or negative on error
pub fun recv_from(s: *Socket, buf: *u8, len: usize, ep: *ip.Endpoint) res[usize, io_error.Error] {
    var sa:     [128]u8;
    var sa_len: u32 = os.SOCKADDR_STORAGE_SIZE::u32;
    val n:      i64 = os.sock_recvfrom(s.handle.value, buf, len, 0, ?sa[0], ?sa_len);
    if (n >= 0 && ep != nil) {
        if (!ip.from_sockaddr(?sa[0], ep)) {
            ret res[usize, io_error.Error].err{io_error.make(io_error.UNSUPPORTED, io_error.OP_RECEIVE)};
        }
    }
    if (n < 0) { ret res[usize, io_error.Error].err{os.error(n, io_error.OP_RECEIVE)}; }
    ret res[usize, io_error.Error].ok{n::usize};
}

# bound blocking receives on a UDP socket to a timeout
#
# sets SO_RCVTIMEO on the socket. after ms elapses with no datagram pending, a
# recv_from returns a normalized timeout or would-block error. ms == 0
# restores indefinite blocking.
# ---
# s:   the socket to bound receives on
# ms:  timeout in milliseconds, or 0 for no timeout
# ret: ok on success, or an error message
pub fun socket_set_recv_timeout(s: *Socket, ms: u64) err[io_error.Error] {
    val code: i64 = os.sock_set_rcvtimeo(s.handle.value, ms);
    if (code < 0) {
        ret err[io_error.Error].err{os.error(code, io_error.OP_OPTION)};
    }
    ret err[io_error.Error].ok{};
}

# close a UDP socket
# ---
# s: the socket to close
pub fun socket_close(s: *Socket) err[io_error.Error] {
    if (!io_handle.socket_is_valid(s.handle)) {
        ret err[io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_CLOSE)};
    }
    val raw: usize = s.handle.value;
    s.handle = io_handle.invalid_socket();
    val code: i64 = os.sock_close(raw);
    if (code < 0) { ret err[io_error.Error].err{os.error(code, io_error.OP_CLOSE)}; }
    ret err[io_error.Error].ok{};
}

test udp__duplicate_close_is_normalized {
    val r: res[Socket, io_error.Error] = create();
    if (sel r.err) { ret 1; }
    var s:                   Socket              = r.ok;
    val socket_close_result: err[io_error.Error] = socket_close(?s);
    if (sel socket_close_result.err) { ret 1; }
    val second: err[io_error.Error] = socket_close(?s);
    if (!sel second.err)                    { ret 1; }
    if (second.err.kind != io_error.CLOSED) { ret 1; }
    ret 0;
}

test udp__ipv6_loopback_bind {
    val ep: ip.Endpoint                 = ip.endpoint_v6(ip.ipv6_loopback(), 0, 0);
    val r:  res[Socket, io_error.Error] = bind(ep);
    if (sel r.err) { ret 1; }
    var s: Socket = r.ok;
    if (s.family != os.AF_INET6) {
        socket_close(?s);
        ret 1;
    }
    socket_close(?s);
    ret 0;
}

# several datagram sockets with SO_REUSEPORT bind one port, and every datagram
# sent to it arrives on one of them. windows refuses before creating a socket
test udp__sockets_with_reuse_port_share_one_port {
    val shared:   socket_api.BindOptions = socket_api.BindOptions{reuse_address: true, reuse_port: true};
    val any_port: ip.Endpoint            = ip.endpoint(127, 0, 0, 1, 0);
    $if ($mach.build.os == $mach.os.windows) {
        val refused: res[Socket, io_error.Error] = bind_with(any_port, shared);
        if (sel refused.ok) {
            var unexpected: Socket = refused.ok;
            socket_close(?unexpected);
            ret 1;
        }
        if (refused.err.kind != io_error.UNSUPPORTED) { ret 2; }
        ret 0;
    }
    $or {
        var sockets: [3]Socket;
        val first:   res[Socket, io_error.Error] = bind_with_options(any_port, shared, socket_api.async_flags());
        if (sel first.err) { ret 3; }
        sockets[0] = first.ok;
        val bound: res[ip.Endpoint, io_error.Error] = local_endpoint(?sockets[0]);
        if (sel bound.err) {
            socket_close(?sockets[0]);
            ret 4;
        }
        val port:  ip.Endpoint = bound.ok;
        var count: usize       = 1;
        var bad:   i32         = 0;
        for (count < 3) {
            val next: res[Socket, io_error.Error] = bind_with_options(port, shared, socket_api.async_flags());
            if (sel next.err) {
                bad = 5;
                brk;
            }
            sockets[count] = next.ok;
            count          = count + 1;
        }
        var sender: Socket;
        var opened: bool = false;
        if (bad == 0) {
            val sr: res[Socket, io_error.Error] = create();
            if (sel sr.ok) {
                sender = sr.ok;
                opened = true;
            }
            or { bad = 6; }
        }
        var payload: [4]u8 = [4]u8{'m', 'a', 'r', 'k'};
        var sent:    usize = 0;
        for (bad == 0 && sent < 16) {
            val wr: res[usize, io_error.Error] = send_to(?sender, ?payload[0], 4, port);
            if (!(sel wr.ok && wr.ok == 4)) {
                bad = 7;
                brk;
            }
            sent = sent + 1;
        }
        var received: usize = 0;
        var rounds:   usize = 0;
        for (bad == 0 && received < sent && rounds < 2000) {
            var progressed: bool  = false;
            var which:      usize = 0;
            for (which < count) {
                var buffer: [8]u8;
                var from:   ip.Endpoint;
                val rr:     res[usize, io_error.Error] = recv_from(?sockets[which], ?buffer[0], 8, ?from);
                if (sel rr.ok) {
                    if (rr.ok != 4 || buffer[0] != 'm') { bad = 8; }
                    received   = received + 1;
                    progressed = true;
                }
                or (sel rr.err && (rr.err.kind != io_error.WOULD_BLOCK && rr.err.kind != io_error.INTERRUPTED)) {
                    bad = 9;
                }
                which = which + 1;
            }
            if (!progressed) {
                os.sleep(1000000);
                rounds = rounds + 1;
            }
        }
        if (bad == 0 && received != sent) { bad = 10; }
        if (opened)                       { socket_close(?sender); }
        var i: usize = 0;
        for (i < count) {
            socket_close(?sockets[i]);
            i = i + 1;
        }
        ret bad;
    }
}
