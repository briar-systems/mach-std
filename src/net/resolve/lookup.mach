# DNS lookup over the target's configured nameservers
#
# a lookup runs under the caller's cancellation scope: when the scope ends, it
# returns within shared.POLL_MSEC with the scope's reason and holds no socket.
# every wait blocks for at most that long before it asks the scope again, the
# TCP retry's connect included. the configuration's timeout_ms is the
# resolver's own policy, how long one request waits before the next server is
# tried, and never outlasts the scope

use std.chrono.duration;
use std.chrono.time;
use std.crypto.rand;
use io_error: std.io.error;
use std.net.ip;
use std.net.resolve.conf;
use std.net.resolve.shared;
use std.net.resolve.wire;
use std.net.tcp;
use std.net.udp;
use std.sync.atomic;
use std.sync.cancel;
use std.sync.thread;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

pub val MAX_ADDRS: usize = 32;

# how a lookup ended
# ---
# found:     the answer holds at least one address
# no_name:   every nameserver answered and none knows the name, or the name
#            does not encode as a query
# temporary: a nameserver did not answer in time; retrying may succeed
# failed:    no nameserver is configured or no family was requested
# ended:     the scope ended the lookup first, with its reason (invalid for a
#            nil scope)
pub tag Outcome: u8 { found; no_name; temporary; failed; ended: cancel.Reason; }

# a completed lookup: addresses in the order their responses arrived, each
# response's records in answer order, and the canonical name
# ---
# addrs:            the addresses found, at most MAX_ADDRS
# count:            valid entries in addrs
# canonical:        nul-terminated final CNAME target when a chain was
#                   followed, otherwise after resolve_name the name that
#                   resolved
# canonical_length: text length of canonical, 0 when there is none
pub rec Answer {
    addrs:            [32]ip.Addr;
    count:            usize;
    canonical:        [254]u8;
    canonical_length: usize;
}

rec Pending {
    qtype:          u16;
    id:             u16;
    message:        [320]u8;
    message_length: usize;
    answered:       bool;
    found_name:     bool;
    settled:        bool;
}

# what the next receive of a server visit may do
# ---
# lapsed: the visit's own deadline passed, or the clock cannot bound it
# ended:  the scope ended, with its reason
# slice:  block for at most this many milliseconds, then ask again
tag Wait: u8 { lapsed; ended: cancel.Reason; slice: u64; }

fun next_wait(scope: *cancel.Scope, deadline: time.Instant) Wait {
    val why: cancel.Reason = shared.scope_reason(scope);
    if (!sel why.active) { ret Wait.ended{why}; }
    val res_now: time.InstantClock = time.instant();
    if (sel res_now.err) { ret Wait.lapsed{}; }
    val remaining: i64 = duration.duration_msec(time.instant_sub(deadline, res_now.ok));
    if (remaining <= 0)               { ret Wait.lapsed{}; }
    if (remaining > shared.POLL_MSEC) { ret Wait.slice{shared.POLL_MSEC::u64}; }
    ret Wait.slice{remaining::u64};
}

# a receive that ran out its slice or was interrupted, to be asked again
fun waited_out(failure: io_error.Error) bool {
    ret failure.kind == io_error.TIMEOUT || io_error.retryable(failure);
}

fun visit_deadline(timeout_ms: u64) opt[time.Instant] {
    val res_started: time.InstantClock = time.instant();
    if (sel res_started.err) { ret opt[time.Instant].none{}; }
    ret opt[time.Instant].some{time.instant_add(res_started.ok, (timeout_ms::i64) * duration.MILLISECOND)};
}

fun endpoint_matches(a: ip.Endpoint, b: ip.Endpoint) bool {
    if (a.port != b.port || a.addr.is_v6 != b.addr.is_v6) { ret false; }
    var i: usize = 0;
    if (a.addr.is_v6 == 0) {
        for (i < 4) {
            if (a.addr.v4.octets[i] != b.addr.v4.octets[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    for (i < 16) {
        if (a.addr.v6.octets[i] != b.addr.v6.octets[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun collect(answer: *Answer, addrs: *ip.Addr, count: usize) {
    var i: usize = 0;
    for (i < count && answer.count < MAX_ADDRS) {
        answer.addrs[answer.count] = addrs[i];
        answer.count               = answer.count + 1;
        i                          = i + 1;
    }
}

# absorb one parsed response into the pending query and the answer. a
# failure code leaves the query unanswered for the next server
fun absorb(pending: *Pending, parsed: *wire.Parsed, addrs: *ip.Addr, answer: *Answer) {
    if (parsed.rcode == wire.RCODE_OK) {
        pending.answered   = true;
        pending.found_name = true;
        collect(answer, addrs, parsed.addr_count);
        if (parsed.canonical_length != 0) { answer.canonical_length = parsed.canonical_length; }
        ret;
    }
    if (parsed.rcode == wire.RCODE_NXDOMAIN) {
        pending.answered = true;
    }
}

# retry one truncated query over TCP against the same server, waiting at most
# timeout_ms for its answer
# ---
# ret: active when the retry ran to its end, whether or not it answered the
#      query, or the reason the scope ended it
fun exchange_tcp(server: ip.Endpoint, pending: *Pending, timeout_ms: u64, scope: *cancel.Scope, answer: *Answer) cancel.Reason {
    val opt_deadline: opt[time.Instant] = visit_deadline(timeout_ms);
    # an unreadable clock cannot bound the wait, so the retry ends as if it lapsed
    if (sel opt_deadline.none) { ret cancel.Reason.active{}; }
    # the connect waits under the lookup's scope narrowed to this visit's deadline
    var visit:    cancel.Scope;
    val err_made: cancel.Operation = cancel.make_child(?visit, scope, opt_deadline);
    if (sel err_made.err) { ret shared.scope_reason(scope); }
    val res_connected: res[tcp.Stream, io_error.Error] = tcp.connect_within(server, ?visit);
    cancel.dnit(?visit);
    if (sel res_connected.err) { ret shared.scope_reason(scope); }
    var stream: tcp.Stream = res_connected.ok;
    fin { tcp.stream_close(?stream); }

    var framed: [322]u8;
    framed[0] = (pending.message_length >> 8)::u8;
    framed[1] = pending.message_length::u8;
    var i: usize = 0;
    for (i < pending.message_length) {
        framed[i + 2] = pending.message[i];
        i             = i + 1;
    }
    var sent: usize = 0;
    for (sent < pending.message_length + 2) {
        val res_wrote: res[usize, io_error.Error] = tcp.stream_write(?stream, ?framed[sent], pending.message_length + 2 - sent);
        if (sel res_wrote.err) { ret cancel.Reason.active{}; }
        val n: usize = res_wrote.ok;
        if (n == 0) { ret cancel.Reason.active{}; }
        sent = sent + n;
    }

    var response: [4096]u8;
    var received: usize = 0;
    var expected: usize = 2;
    for (received < expected) {
        val wait: Wait = next_wait(scope, opt_deadline.some);
        if (sel wait.ended)  { ret wait.ended; }
        if (!sel wait.slice) { ret cancel.Reason.active{}; }
        tcp.stream_set_read_timeout(?stream, wait.slice);
        val res_stream_read: res[usize, io_error.Error] = tcp.stream_read(?stream, ?response[received], expected - received);
        if (sel res_stream_read.err) {
            if (waited_out(res_stream_read.err)) { cnt; }
            ret cancel.Reason.active{};
        }
        val n: usize = res_stream_read.ok;
        if (n == 0) { ret cancel.Reason.active{}; }
        received = received + n;
        if (received == 2 && expected == 2) {
            val body: usize = (response[0]::usize << 8) | response[1]::usize;
            if (body < wire.HEADER_LENGTH || body > wire.MAX_MESSAGE - 2) { ret cancel.Reason.active{}; }
            expected = body + 2;
        }
    }

    var addrs:  [32]ip.Addr;
    var parsed: wire.Parsed;
    if (!wire.parse(?response[2], received - 2, pending.id, pending.qtype, ?addrs[0], 32,
        ?answer.canonical[0], 254, ?parsed)) { ret cancel.Reason.active{}; }
    if (parsed.truncated) { ret cancel.Reason.active{}; }
    absorb(pending, ?parsed, ?addrs[0], answer);
    ret cancel.Reason.active{};
}

# one UDP visit to a server: send the unanswered queries, then absorb
# matching responses until each sent query has its response from this server
# or timeout_ms lapses
# ---
# ret: active when the visit ran to its end, or the reason the scope ended it
fun exchange(server: ip.Endpoint, pending: *Pending, pending_count: usize, timeout_ms: u64, scope: *cancel.Scope, answer: *Answer) cancel.Reason {
    val why: cancel.Reason = shared.scope_reason(scope);
    if (!sel why.active) { ret why; }
    var res_created: res[udp.Socket, io_error.Error];
    if (server.addr.is_v6 != 0) {
        res_created = udp.create_v6();
    }
    or {
        res_created = udp.create();
    }
    if (sel res_created.err) { ret why; }
    var socket: udp.Socket = res_created.ok;
    fin { udp.socket_close(?socket); }

    var outstanding: usize = 0;
    var i:           usize = 0;
    for (i < pending_count) {
        pending[i].settled = pending[i].answered;
        if (!pending[i].answered) {
            val res_sent: res[usize, io_error.Error] = udp.send_to(?socket,
                ?pending[i].message[0], pending[i].message_length, server);
            if (sel res_sent.err) { ret why; }
            outstanding = outstanding + 1;
        }
        i = i + 1;
    }
    if (outstanding == 0) { ret why; }

    val opt_deadline: opt[time.Instant] = visit_deadline(timeout_ms);
    # an unreadable clock cannot bound the wait, so the visit ends as if it lapsed
    if (sel opt_deadline.none) { ret why; }
    for (outstanding != 0) {
        val wait: Wait = next_wait(scope, opt_deadline.some);
        if (sel wait.ended)  { ret wait.ended; }
        if (!sel wait.slice) { brk; }
        udp.socket_set_recv_timeout(?socket, wait.slice);

        var response:      [4096]u8;
        var source:        ip.Endpoint;
        val res_recv_from: res[usize, io_error.Error] = udp.recv_from(?socket, ?response[0], 4096, ?source);
        if (sel res_recv_from.err) {
            if (waited_out(res_recv_from.err)) { cnt; }
            brk;
        }
        val length: usize = res_recv_from.ok;
        if (!endpoint_matches(source, server)) { cnt; }

        i = 0;
        for (i < pending_count) {
            if (pending[i].settled) {
                i = i + 1;
                cnt;
            }
            var addrs:  [32]ip.Addr;
            var parsed: wire.Parsed;
            if (!wire.parse(?response[0], length, pending[i].id, pending[i].qtype, ?addrs[0], 32,
                ?answer.canonical[0], 254, ?parsed)) {
                i = i + 1;
                cnt;
            }
            if (parsed.truncated && parsed.rcode == wire.RCODE_OK) {
                val retried: cancel.Reason = exchange_tcp(server, ?pending[i], timeout_ms, scope, answer);
                if (!sel retried.active) { ret retried; }
                pending[i].settled = true;
                outstanding        = outstanding - 1;
                brk;
            }
            absorb(?pending[i], ?parsed, ?addrs[0], answer);
            pending[i].settled = true;
            outstanding        = outstanding - 1;
            brk;
        }
    }
    ret why;
}

# query one fully-composed name (hostname, optionally suffixed by a search
# domain) for the requested families across the configured nameservers
# ---
# config:   the resolver policy
# scope:    bounds and cancels the lookup
# hostname: the name to ask for
# domain:   a search domain to append, or nil
# want_v4:  ask for A records
# want_v6:  ask for AAAA records
# answer:   filled with what was found, meaningful when the outcome is found
# ret:      how the lookup ended
pub fun query_name(config: *conf.Config, scope: *cancel.Scope, hostname: str, domain: *u8,
    want_v4: bool, want_v6: bool, answer: *Answer) Outcome {
    answer.count            = 0;
    answer.canonical[0]     = 0;
    answer.canonical_length = 0;
    if (config.nameserver_count == 0 || (!want_v4 && !want_v6)) { ret Outcome.failed{}; }

    var pending:       [2]Pending;
    var pending_count: usize = 0;
    if (want_v4) {
        pending[pending_count].qtype = wire.TYPE_A;
        pending_count                = pending_count + 1;
    }
    if (want_v6) {
        pending[pending_count].qtype = wire.TYPE_AAAA;
        pending_count                = pending_count + 1;
    }
    var i: usize = 0;
    for (i < pending_count) {
        pending[i].id = (rand.u32() & 0xFFFF)::u16;
        if (i != 0 && pending[i].id == pending[0].id) { pending[i].id = pending[i].id ^ 0x5A5A; }
        pending[i].answered       = false;
        pending[i].found_name     = false;
        pending[i].message_length = wire.build_query(pending[i].id, hostname, domain,
            pending[i].qtype, ?pending[i].message[0], 320);
        if (pending[i].message_length == 0) { ret Outcome.no_name{}; }
        i = i + 1;
    }

    var start: usize = 0;
    if (config.rotate && config.nameserver_count > 1) {
        start = (rand.u32()::usize) % config.nameserver_count;
    }
    var attempt: u32 = 0;
    for (attempt < config.attempts) {
        var server: usize = 0;
        for (server < config.nameserver_count) {
            var outstanding: bool = false;
            i = 0;
            for (i < pending_count) {
                if (!pending[i].answered) { outstanding = true; }
                i = i + 1;
            }
            if (!outstanding) { brk; }
            val index: usize         = (start + server) % config.nameserver_count;
            val why:   cancel.Reason = exchange(config.nameservers[index], ?pending[0], pending_count,
                config.timeout_ms, scope, answer);
            if (!sel why.active) { ret Outcome.ended{why}; }
            server = server + 1;
        }
        attempt = attempt + 1;
    }

    if (answer.count != 0) { ret Outcome.found{}; }
    var all_answered: bool = true;
    i = 0;
    for (i < pending_count) {
        if (!pending[i].answered) { all_answered = false; }
        i = i + 1;
    }
    if (all_answered) { ret Outcome.no_name{}; }
    ret Outcome.temporary{};
}

fun count_dots(hostname: str, length: usize) usize {
    var dots: usize = 0;
    var i:    usize = 0;
    for (i < length) {
        if (hostname[i] == '.') { dots = dots + 1; }
        i = i + 1;
    }
    ret dots;
}

fun compose_canonical(answer: *Answer, hostname: str, domain: *u8) {
    if (answer.canonical_length != 0) { ret; }
    val host_length: usize = str_len(hostname);
    var length:      usize = host_length;
    if (hostname[host_length - 1] == '.') { length = length - 1; }
    var total:         usize = length;
    var domain_length: usize = 0;
    if (domain != nil && domain[0] != 0) {
        domain_length = str_len(domain);
        total         = total + 1 + domain_length;
    }
    if (total + 1 > 254) { ret; }
    var i: usize = 0;
    for (i < length) {
        answer.canonical[i] = hostname[i];
        i                   = i + 1;
    }
    if (domain_length != 0) {
        answer.canonical[length] = '.';
        i                        = 0;
        for (i < domain_length) {
            answer.canonical[length + 1 + i] = domain[i];
            i                                = i + 1;
        }
    }
    answer.canonical[total] = 0;
    answer.canonical_length = total;
}

# resolve a hostname applying the search-domain and ndots policy: a name at
# or above the dot threshold (or fully qualified) tries the literal name
# first, otherwise the search list is tried first. the first name that
# resolves wins; a temporary or system failure, or the scope ending, aborts
# the search.
# ---
# config:   the resolver policy
# scope:    bounds and cancels the whole search
# hostname: the name to resolve
# want_v4:  ask for A records
# want_v6:  ask for AAAA records
# answer:   filled with what was found, meaningful when the outcome is found
# ret:      how the lookup ended
pub fun resolve_name(config: *conf.Config, scope: *cancel.Scope, hostname: str, want_v4: bool, want_v6: bool, answer: *Answer) Outcome {
    val length: usize = str_len(hostname);
    if (length == 0) { ret Outcome.no_name{}; }
    val qualified:     bool = hostname[length - 1] == '.';
    val literal_first: bool = qualified || count_dots(hostname, length) >= config.ndots::usize
        || config.search_count == 0;

    if (literal_first) {
        val literal: Outcome = query_name(config, scope, hostname, nil, want_v4, want_v6, answer);
        if (sel literal.found)                 { compose_canonical(answer, hostname, nil); }
        if (!sel literal.no_name || qualified) { ret literal; }
    }
    var i: usize = 0;
    for (i < config.search_count) {
        val domain: *u8 = conf.search_domain(config, i);
        if (length + 1 + str_len(domain) <= 253) {
            val searched: Outcome = query_name(config, scope, hostname, domain, want_v4, want_v6, answer);
            if (sel searched.found)    { compose_canonical(answer, hostname, domain); }
            if (!sel searched.no_name) { ret searched; }
        }
        i = i + 1;
    }
    if (!literal_first) {
        val last: Outcome = query_name(config, scope, hostname, nil, want_v4, want_v6, answer);
        if (sel last.found) { compose_canonical(answer, hostname, nil); }
        ret last;
    }
    ret Outcome.no_name{};
}

# deterministic loopback nameserver used by the transport tests
#[testing]
rec Stub {
    socket:   udp.Socket;
    requests: usize;
    rcode:    u8;
    truncate: bool;
}

# a root scope whose deadline bounds one test's lookups, far inside the
# harness's own limit
#[testing]
fun bounded(scope: *cancel.Scope, msec: i64) bool {
    val res_now: time.InstantClock = time.instant();
    if (sel res_now.err) { ret false; }
    val deadline: time.Instant     = time.instant_add(res_now.ok, msec * duration.MILLISECOND);
    val err_made: cancel.Operation = cancel.make_root(scope, opt[time.Instant].some{deadline});
    ret sel err_made.ok;
}

# end a stub's wait for a request the resolver will not send: a datagram
# shorter than a header ends every stub's loop
#[testing]
fun wake(target: *udp.Socket) {
    val res_local: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(target);
    if (sel res_local.err) { ret; }
    val res_created: res[udp.Socket, io_error.Error] = udp.create();
    if (sel res_created.err) { ret; }
    var socket: udp.Socket = res_created.ok;
    var byte:   u8         = 0;
    udp.send_to(?socket, ?byte, 1, res_local.ok);
    udp.socket_close(?socket);
}

# count the queries waiting at a nameserver that never answers
#[testing]
fun drained(silent: *udp.Socket) usize {
    val err_bounded: err[io_error.Error] = udp.socket_set_recv_timeout(silent, 1);
    if (sel err_bounded.err) { ret 0xffff; }
    var queries: usize = 0;
    for (queries < 4) {
        var request:       [512]u8;
        var source:        ip.Endpoint;
        val res_recv_from: res[usize, io_error.Error] = udp.recv_from(silent, ?request[0], 512, ?source);
        if (sel res_recv_from.err) { brk; }
        queries = queries + 1;
    }
    ret queries;
}

#[testing]
fun stub_answer(request: *u8, length: usize, response: *u8, rcode: u8, truncate: bool) usize {
    var i: usize = 0;
    for (i < length) {
        response[i] = request[i];
        i           = i + 1;
    }
    response[2] = 0x81;
    if (truncate) { response[2] = 0x83; }
    response[3] = 0x80 | rcode;
    if (rcode != 0 || truncate) { ret length; }
    val qtype: u16 = (request[length - 4]::u16 << 8) | request[length - 3]::u16;
    response[7] = 1;
    var pos: usize = length;
    response[pos]     = 0xC0;
    response[pos + 1] = 12;
    response[pos + 2] = (qtype >> 8)::u8;
    response[pos + 3] = qtype::u8;
    response[pos + 4] = 0;
    response[pos + 5] = 1;
    response[pos + 6] = 0;
    response[pos + 7] = 0;
    response[pos + 8] = 0;
    response[pos + 9] = 60;
    pos               = pos + 10;
    if (qtype == wire.TYPE_A) {
        response[pos]     = 0;
        response[pos + 1] = 4;
        response[pos + 2] = 192;
        response[pos + 3] = 0;
        response[pos + 4] = 2;
        response[pos + 5] = 55;
        ret pos + 6;
    }
    response[pos]     = 0;
    response[pos + 1] = 16;
    var j: usize = 0;
    for (j < 16) {
        response[pos + 2 + j] = 0;
        j                     = j + 1;
    }
    response[pos + 2]  = 0x20;
    response[pos + 3]  = 0x01;
    response[pos + 4]  = 0x0D;
    response[pos + 5]  = 0xB8;
    response[pos + 17] = 0x55;
    ret pos + 18;
}

#[testing]
fun stub_run(argument: *u8) {
    val stub:   *Stub = argument::*Stub;
    var served: usize = 0;
    for (served < stub.requests) {
        var request:       [512]u8;
        var source:        ip.Endpoint;
        val res_recv_from: res[usize, io_error.Error] = udp.recv_from(?stub.socket, ?request[0], 512, ?source);
        if (sel res_recv_from.err) { ret; }
        val length: usize = res_recv_from.ok;
        if (length < wire.HEADER_LENGTH) { ret; }
        var response:        [512]u8;
        val response_length: usize = stub_answer(?request[0], length, ?response[0], stub.rcode, stub.truncate);
        udp.send_to(?stub.socket, ?response[0], response_length, source);
        served = served + 1;
    }
}

#[testing]
fun stub_start(stub: *Stub, requests: usize, rcode: u8, truncate: bool, worker: *thread.Thread) res[conf.Config, io_error.Error] {
    val res_bound: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, 0));
    if (sel res_bound.err) {
        ret res[conf.Config, io_error.Error].err{res_bound.err};
    }
    stub.socket   = res_bound.ok;
    stub.requests = requests;
    stub.rcode    = rcode;
    stub.truncate = truncate;
    val res_local: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?stub.socket);
    if (sel res_local.err) {
        udp.socket_close(?stub.socket);
        ret res[conf.Config, io_error.Error].err{res_local.err};
    }
    var config: conf.Config;
    conf.defaults(?config);
    config.nameservers[0]   = res_local.ok;
    config.nameserver_count = 1;
    config.attempts         = 1;
    thread.spawn_with(stub_run, stub::*u8, worker);
    ret res[conf.Config, io_error.Error].ok{config};
}

#[testing]
fun stub_stop(stub: *Stub, worker: *thread.Thread) {
    wake(?stub.socket);
    thread.join(worker);
    udp.socket_close(?stub.socket);
}

test resolve_lookup__stub_nameserver_nxdomain {
    var scope: cancel.Scope;
    if (!bounded(?scope, 2000)) { ret 1; }
    var stub:        Stub;
    var worker:      thread.Thread;
    val res_started: res[conf.Config, io_error.Error] = stub_start(?stub, 2, wire.RCODE_NXDOMAIN, false, ?worker);
    if (sel res_started.err) { ret 1; }
    var config:  conf.Config = res_started.ok;
    var answer:  Answer;
    val outcome: Outcome     = query_name(?config, ?scope, "missing.example", nil, true, true, ?answer);
    stub_stop(?stub, ?worker);
    cancel.dnit(?scope);
    if (!sel outcome.no_name) { ret 1; }
    ret 0;
}

test resolve_lookup__search_domain_applies_before_literal_for_bare_names {
    var scope: cancel.Scope;
    if (!bounded(?scope, 2000)) { ret 1; }
    var stub:        Stub;
    var worker:      thread.Thread;
    val res_started: res[conf.Config, io_error.Error] = stub_start(?stub, 2, 0, false, ?worker);
    if (sel res_started.err) { ret 1; }
    var config: conf.Config = res_started.ok;
    val slot:   *u8         = conf.search_domain(?config, 0);
    slot[0]             = 'c';
    slot[1]             = 'o';
    slot[2]             = 'r';
    slot[3]             = 'p';
    slot[4]             = 0;
    config.search_count = 1;
    var answer:  Answer;
    val outcome: Outcome = resolve_name(?config, ?scope, "bare", true, true, ?answer);
    stub_stop(?stub, ?worker);
    cancel.dnit(?scope);
    if (!sel outcome.found) { ret 1; }
    # the canonical name reflects the search domain that resolved
    if (answer.canonical_length != 9)                             { ret 1; }
    if (answer.canonical[4] != '.' || answer.canonical[5] != 'c') { ret 1; }
    ret 0;
}

#[testing]
rec TcpStub {
    udp_socket: udp.Socket;
    listener:   tcp.Listener;
    stop:       i64;
}

#[testing]
fun tcp_stub_run(argument: *u8) {
    val stub: *TcpStub = argument::*TcpStub;
    # truncate both UDP queries, then serve both over TCP
    var served: usize = 0;
    for (served < 2) {
        var request:       [512]u8;
        var source:        ip.Endpoint;
        val res_recv_from: res[usize, io_error.Error] = udp.recv_from(?stub.udp_socket, ?request[0], 512, ?source);
        if (sel res_recv_from.err) { ret; }
        val length: usize = res_recv_from.ok;
        if (length < wire.HEADER_LENGTH) { ret; }
        var response:        [512]u8;
        val response_length: usize = stub_answer(?request[0], length, ?response[0], 0, true);
        udp.send_to(?stub.udp_socket, ?response[0], response_length, source);
        served = served + 1;
    }
    served = 0;
    for (served < 2) {
        val res_accepted: res[tcp.Stream, io_error.Error] = tcp.accept(?stub.listener);
        if (sel res_accepted.err) { ret; }
        var stream: tcp.Stream = res_accepted.ok;
        if (atomic.load(?stub.stop) != 0) {
            tcp.stream_close(?stream);
            ret;
        }
        var framed:   [512]u8;
        var received: usize = 0;
        var expected: usize = 2;
        for (received < expected) {
            val res_stream_read: res[usize, io_error.Error] = tcp.stream_read(?stream, ?framed[received], expected - received);
            if (sel res_stream_read.err) { brk; }
            val n: usize = res_stream_read.ok;
            if (n == 0) { brk; }
            received = received + n;
            if (received == 2 && expected == 2) {
                expected = ((framed[0]::usize << 8) | framed[1]::usize) + 2;
            }
        }
        if (received == expected) {
            var response: [512]u8;
            val body:     usize = stub_answer(?framed[2], received - 2, ?response[2], 0, false);
            response[0] = (body >> 8)::u8;
            response[1] = body::u8;
            var written: usize = 0;
            for (written < body + 2) {
                val res_wrote: res[usize, io_error.Error] = tcp.stream_write(?stream, ?response[written], body + 2 - written);
                if (sel res_wrote.err) { brk; }
                written = written + res_wrote.ok;
            }
        }
        tcp.stream_close(?stream);
        served = served + 1;
    }
}

# end the stub in whichever phase it waits: a short datagram ends the UDP one,
# and a connection it accepts after the stop flag ends the TCP one
#[testing]
fun tcp_stub_stop(stub: *TcpStub, port: u16, worker: *thread.Thread) {
    atomic.store(?stub.stop, 1);
    wake(?stub.udp_socket);
    val res_connected: res[tcp.Stream, io_error.Error] = tcp.connect(ip.endpoint(127, 0, 0, 1, port));
    if (sel res_connected.ok) {
        var stream: tcp.Stream = res_connected.ok;
        tcp.stream_close(?stream);
    }
    thread.join(worker);
    udp.socket_close(?stub.udp_socket);
    tcp.listener_close(?stub.listener);
}

# a TCP listener and a UDP socket on one loopback port, since the resolver
# retries over TCP at the port it asked over UDP; a few ephemeral ports are tried
# ---
# ret: 0 with both bound, 1 when no listener could be made, 77 when no port
#      had both free
#[testing]
fun paired(backlog: i32, listener: *tcp.Listener, socket: *udp.Socket, port: *u16) i32 {
    var tries: usize = 0;
    for (tries < 8) {
        val res_listening: res[tcp.Listener, io_error.Error] = tcp.listen(ip.endpoint(127, 0, 0, 1, 0), backlog);
        if (sel res_listening.err) { ret 1; }
        @listener = res_listening.ok;
        val res_local: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(listener);
        if (sel res_local.err) {
            tcp.listener_close(listener);
            ret 1;
        }
        @port = res_local.ok.port;
        val res_bound: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, @port));
        if (sel res_bound.ok) {
            @socket = res_bound.ok;
            ret 0;
        }
        tcp.listener_close(listener);
        tries = tries + 1;
    }
    ret 77;
}

# fill a listener's accept queue with connections nobody accepts, until a
# connect is neither accepted nor refused but left waiting on its SYN
# ---
# ret: 0 once a connect waited out its own 100 ms scope, 1 when the target
#      refuses a connect at a full queue instead, 2 when the queue outlasted
#      capacity connections, 3 when no scope could be made
#[testing]
fun fill_backlog(port: u16, held: *tcp.Stream, capacity: usize, count: *usize) i32 {
    @count = 0;
    for (@count < capacity) {
        var scope: cancel.Scope;
        if (!bounded(?scope, 100)) { ret 3; }
        val res_connected: res[tcp.Stream, io_error.Error] = tcp.connect_within(ip.endpoint(127, 0, 0, 1, port), ?scope);
        cancel.dnit(?scope);
        if (sel res_connected.ok) {
            held[@count] = res_connected.ok;
            @count       = @count + 1;
            cnt;
        }
        if (res_connected.err.kind == io_error.TIMEOUT) { ret 0; }
        ret 1;
    }
    ret 2;
}

test resolve_lookup__truncation_falls_back_to_tcp {
    var stub:        TcpStub;
    var port:        u16 = 0;
    val paired_stub: i32 = paired(4, ?stub.listener, ?stub.udp_socket, ?port);
    if (paired_stub != 0) { ret paired_stub; }

    var scope: cancel.Scope;
    if (!bounded(?scope, 2000)) { ret 1; }
    var worker: thread.Thread;
    thread.spawn_with(tcp_stub_run, (?stub)::*u8, ?worker);

    var config: conf.Config;
    conf.defaults(?config);
    config.nameservers[0]   = ip.endpoint(127, 0, 0, 1, port);
    config.nameserver_count = 1;
    config.attempts         = 1;
    var answer:  Answer;
    val outcome: Outcome = query_name(?config, ?scope, "large.example", nil, true, true, ?answer);
    tcp_stub_stop(?stub, port, ?worker);
    cancel.dnit(?scope);
    if (!sel outcome.found) { ret 1; }
    if (answer.count != 2)  { ret 1; }

    # a server that truncates over UDP and whose TCP port takes no connection:
    # a full accept queue drops the SYN on loopback, deterministically, where a
    # port nobody listens on refuses at once and nothing on loopback drops by
    # address. only the scope can end that retry, long before timeout_ms
    var full:        Stub;
    var full_ln:     tcp.Listener;
    var full_port:   u16 = 0;
    val paired_full: i32 = paired(0, ?full_ln, ?full.socket, ?full_port);
    if (paired_full != 0) { ret paired_full; }
    var held:    [4]tcp.Stream;
    var holding: usize = 0;
    val filled:  i32   = fill_backlog(full_port, ?held[0], 4, ?holding);
    var bad:     i32   = 0;
    # a target that refuses at a full queue leaves no wait to bound
    if (filled == 0) {
        full.requests = 2;
        full.rcode    = 0;
        full.truncate = true;
        var full_worker: thread.Thread;
        thread.spawn_with(stub_run, (?full)::*u8, ?full_worker);
        config.nameservers[0] = ip.endpoint(127, 0, 0, 1, full_port);
        config.timeout_ms     = 60000;
        var short: cancel.Scope;
        if (!bounded(?short, 200)) { bad = 20; }
        or {
            val res_started: time.InstantClock = time.instant();
            val ended:       Outcome           = query_name(?config, ?short, "large.example", nil, true, true, ?answer);
            val res_now:     time.InstantClock = time.instant();
            cancel.dnit(?short);
            if (!(sel ended.ended && sel ended.ended.timed_out)) { bad = 21; }
            if (sel res_started.ok) {
                if (sel res_now.ok && duration.duration_msec(time.instant_sub(res_now.ok, res_started.ok)) > 1000) { bad = 22; }
            }
        }
        stub_stop(?full, ?full_worker);
    }
    or (filled == 1) { udp.socket_close(?full.socket); }
    or {
        udp.socket_close(?full.socket);
        bad = 10 + filled;
    }
    var k: usize = 0;
    for (k < holding) {
        tcp.stream_close(?held[k]);
        k = k + 1;
    }
    tcp.listener_close(?full_ln);
    ret bad;
}

test resolve_lookup__canonical_composition {
    var answer: Answer;
    answer.canonical_length = 0;
    answer.canonical[0]     = 0;
    compose_canonical(?answer, "web", "example.test");
    if (answer.canonical_length != 16)                             { ret 1; }
    if (answer.canonical[3] != '.' || answer.canonical[15] != 't') { ret 1; }
    answer.canonical_length = 0;
    compose_canonical(?answer, "host.example.", nil);
    if (answer.canonical_length != 12 || answer.canonical[11] != 'e') { ret 1; }
    ret 0;
}

# a name with at least ndots dots is asked for as written before the search
# list, and a search query that times out ends the search: the literal name is
# not asked for after it. a scope that ends first ends the lookup whatever the
# configured wait, and an ended scope sends nothing
test resolve_lookup__dotted_names_go_literal_first_and_a_timeout_ends_the_search {
    var scope: cancel.Scope;
    if (!bounded(?scope, 2000)) { ret 1; }
    fin { cancel.dnit(?scope); }
    var stub:        Stub;
    var worker:      thread.Thread;
    val res_started: res[conf.Config, io_error.Error] = stub_start(?stub, 1, 0, false, ?worker);
    if (sel res_started.err) { ret 1; }
    var config: conf.Config = res_started.ok;
    val slot:   *u8         = conf.search_domain(?config, 0);
    slot[0]             = 'c';
    slot[1]             = 'o';
    slot[2]             = 'r';
    slot[3]             = 'p';
    slot[4]             = 0;
    config.search_count = 1;
    config.ndots        = 1;
    var answer:  Answer;
    val outcome: Outcome = resolve_name(?config, ?scope, "web.example", true, false, ?answer);
    stub_stop(?stub, ?worker);
    if (!sel outcome.found)            { ret 2; }
    if (answer.canonical_length != 11) { ret 3; }

    # a nameserver that never answers: every query it is sent waits in its queue
    val res_silent: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, 0));
    if (sel res_silent.err) { ret 4; }
    var silent: udp.Socket = res_silent.ok;
    fin { udp.socket_close(?silent); }
    val res_local: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?silent);
    if (sel res_local.err) { ret 5; }
    config.nameservers[0] = res_local.ok;
    config.timeout_ms     = 200;
    val timed_out: Outcome = resolve_name(?config, ?scope, "bare", true, false, ?answer);
    if (!sel timed_out.temporary) { ret 6; }
    if (drained(?silent) != 1)    { ret 8; }

    config.timeout_ms = 60000;
    var short: cancel.Scope;
    if (!bounded(?short, 100)) { ret 9; }
    fin { cancel.dnit(?short); }
    val bounded_out: Outcome = resolve_name(?config, ?short, "bare", true, false, ?answer);
    if (!sel bounded_out.ended)           { ret 10; }
    if (!sel bounded_out.ended.timed_out) { ret 11; }
    if (drained(?silent) != 1)            { ret 12; }

    var ended: cancel.Scope;
    cancel.make_root(?ended, opt[time.Instant].none{});
    fin { cancel.dnit(?ended); }
    cancel.cancel(?ended);
    val refused: Outcome = resolve_name(?config, ?ended, "bare", true, false, ?answer);
    if (!sel refused.ended)           { ret 13; }
    if (!sel refused.ended.cancelled) { ret 14; }
    if (drained(?silent) != 0)        { ret 15; }
    ret 0;
}

# the nameserver's socket and a second one that answers in its place
#[testing]
rec Spoofer {
    server: udp.Socket;
    other:  udp.Socket;
}

# answer the one query twice: a denial from the other socket first, then the
# real answer from the server's own
#[testing]
fun spoofer_run(argument: *u8) {
    val spoofer:       *Spoofer                   = argument::*Spoofer;
    var request:       [512]u8;
    var source:        ip.Endpoint;
    val res_recv_from: res[usize, io_error.Error] = udp.recv_from(?spoofer.server, ?request[0], 512, ?source);
    if (sel res_recv_from.err) { ret; }
    val length: usize = res_recv_from.ok;
    if (length < wire.HEADER_LENGTH) { ret; }
    var response:      [512]u8;
    val denial_length: usize = stub_answer(?request[0], length, ?response[0], wire.RCODE_NXDOMAIN, false);
    udp.send_to(?spoofer.other, ?response[0], denial_length, source);
    val answer_length: usize = stub_answer(?request[0], length, ?response[0], 0, false);
    udp.send_to(?spoofer.server, ?response[0], answer_length, source);
}

# a response from any endpoint but the queried server is ignored, even when it
# arrives first and matches the query
test resolve_lookup__a_response_from_another_endpoint_is_ignored {
    var spoofer:    Spoofer;
    val res_server: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, 0));
    if (sel res_server.err) { ret 1; }
    spoofer.server = res_server.ok;
    fin { udp.socket_close(?spoofer.server); }
    val res_other: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, 0));
    if (sel res_other.err) { ret 2; }
    spoofer.other = res_other.ok;
    fin { udp.socket_close(?spoofer.other); }
    val res_local: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?spoofer.server);
    if (sel res_local.err) { ret 3; }
    var scope: cancel.Scope;
    if (!bounded(?scope, 2000)) { ret 3; }
    fin { cancel.dnit(?scope); }
    var config: conf.Config;
    conf.defaults(?config);
    config.nameservers[0]   = res_local.ok;
    config.nameserver_count = 1;
    config.attempts         = 1;
    var worker: thread.Thread;
    thread.spawn_with(spoofer_run, (?spoofer)::*u8, ?worker);
    var answer:  Answer;
    val outcome: Outcome = query_name(?config, ?scope, "spoofed.example", nil, true, false, ?answer);
    wake(?spoofer.server);
    thread.join(?worker);
    if (!sel outcome.found) { ret 4; }
    if (answer.count != 1)  { ret 5; }
    ret 0;
}
