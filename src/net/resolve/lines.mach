# bounded line iteration over resolver configuration files

use io_error: std.io.error;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

pub val MAX_LINE: usize = 512;

# a buffered reader yielding one nul-terminated line at a time
# ---
# fd:   open handle, or os.INVALID_HANDLE when closed
# buf:  read-ahead storage
# len:  valid bytes in buf
# pos:  next unread byte in buf
# done: no more bytes will arrive from fd
pub rec Reader {
    fd:   usize;
    buf:  [1024]u8;
    len:  usize;
    pos:  usize;
    done: bool;
}

pub fun open(reader: *Reader, path: str) err[io_error.Error] {
    var fd:     usize = os.INVALID_HANDLE;
    val opened: i64   = os.open(os.working_dir(), path, os.O_RDONLY, 0, ?fd);
    if (opened < 0) { ret err[io_error.Error].err{os.error(opened, io_error.OP_OPEN)}; }
    reader.fd   = fd;
    reader.len  = 0;
    reader.pos  = 0;
    reader.done = false;
    ret err[io_error.Error].ok{};
}

# release the descriptor; a reader that is already closed or was never
# opened closes as a success, a refused native close is the failure
pub fun close(reader: *Reader) err[io_error.Error] {
    val fd: usize = reader.fd;
    reader.fd   = os.INVALID_HANDLE;
    reader.done = true;
    if (fd == os.INVALID_HANDLE) { ret err[io_error.Error].ok{}; }
    val code: i64 = os.close(fd);
    if (code < 0) { ret err[io_error.Error].err{os.error(code, io_error.OP_CLOSE)}; }
    ret err[io_error.Error].ok{};
}

# pull the next chunk; the end of the file and a read failure both stop the
# reader, and the failure is reported so the caller can surface it
fun fill(reader: *Reader) err[io_error.Error] {
    if (reader.done) { ret err[io_error.Error].ok{}; }
    val n: i64 = os.read(reader.fd, ?reader.buf[0], 1024);
    if (n < 0) {
        reader.done = true;
        ret err[io_error.Error].err{os.error(n, io_error.OP_READ)};
    }
    if (n == 0) {
        reader.done = true;
        ret err[io_error.Error].ok{};
    }
    reader.len = n::usize;
    reader.pos = 0;
    ret err[io_error.Error].ok{};
}

# copy the next line into output without its newline, nul-terminated
#
# a line longer than capacity - 1 bytes is consumed whole but truncated in
# output; the returned length is the untruncated length so the caller can
# detect and skip it. the end of the file is absence, a read failure is the
# error, and a zero capacity is invalid use.
# ---
# reader:   the reader to advance
# output:   destination for the line bytes
# capacity: size of output in bytes
# ret:      the untruncated line length, absent when exhausted, or the failure
pub fun next(reader: *Reader, output: *u8, capacity: usize) res[opt[usize], io_error.Error] {
    if (capacity == 0) {
        ret res[opt[usize], io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_READ)};
    }
    if (reader.pos >= reader.len) {
        val err_filled: err[io_error.Error] = fill(reader);
        if (sel err_filled.err)                      { ret res[opt[usize], io_error.Error].err{err_filled.err}; }
        if (reader.pos >= reader.len && reader.done) { ret res[opt[usize], io_error.Error].ok{opt[usize].none{}}; }
    }
    var written: usize = 0;
    var length:  usize = 0;
    for (true) {
        if (reader.pos >= reader.len) {
            val err_refilled: err[io_error.Error] = fill(reader);
            if (sel err_refilled.err)                    { ret res[opt[usize], io_error.Error].err{err_refilled.err}; }
            if (reader.pos >= reader.len && reader.done) { brk; }
            cnt;
        }
        val byte: u8 = reader.buf[reader.pos];
        reader.pos = reader.pos + 1;
        if (byte == 10) { brk; }
        if (written + 1 < capacity) {
            output[written] = byte;
            written         = written + 1;
        }
        length = length + 1;
    }
    output[written] = 0;
    ret res[opt[usize], io_error.Error].ok{opt[usize].some{length}};
}

# a missing file is the open failure, a bad descriptor the read failure, and
# the failure stops the reader
test resolve_lines__a_missing_file_is_the_open_failure_and_a_bad_descriptor_is_the_read_failure {
    var reader:     Reader;
    val err_opened: err[io_error.Error] = open(?reader, "/std_resolve_lines_no_such_file");
    if (!sel err_opened.err)                          { ret 1; }
    if (err_opened.err.operation != io_error.OP_OPEN) { ret 2; }
    reader.fd   = os.INVALID_HANDLE;
    reader.done = false;
    reader.len  = 0;
    reader.pos  = 0;
    var line:       [16]u8;
    val res_failed: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 16);
    if (!sel res_failed.err)                          { ret 3; }
    if (res_failed.err.operation != io_error.OP_READ) { ret 4; }
    # the failure stops the reader: the next call is absence, not a second read
    val res_after: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 16);
    if (!sel res_after.ok)      { ret 5; }
    if (!sel res_after.ok.none) { ret 6; }
    # a zero capacity is invalid use, and a reader with no descriptor closes
    val res_invalid: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 0);
    if (!sel res_invalid.err)                     { ret 7; }
    if (res_invalid.err.kind != io_error.INVALID) { ret 8; }
    val err_closed: err[io_error.Error] = close(?reader);
    if (!sel err_closed.ok) { ret 9; }
    ret 0;
}

test resolve_lines__lines_are_delivered_whole_with_truncation_reported_by_length {
    var reader: Reader;
    reader.fd   = os.INVALID_HANDLE;
    reader.done = false;
    reader.len  = 0;
    reader.pos  = 0;
    val text: str   = "first\nsecond line is long\n";
    var i:    usize = 0;
    for (text[i] != 0) {
        reader.buf[i] = text[i];
        i             = i + 1;
    }
    reader.len = i;
    var line:      [8]u8;
    val res_first: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 8);
    if (!sel res_first.ok)                                        { ret 1; }
    if (!sel res_first.ok.some)                                   { ret 2; }
    if (res_first.ok.some != 5 || line[0] != 'f' || line[5] != 0) { ret 3; }
    val res_second: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 8);
    if (!sel res_second.ok)                                                           { ret 4; }
    if (!sel res_second.ok.some)                                                      { ret 5; }
    if (res_second.ok.some != 19 || line[7] != 0 || line[6] != ' ' || line[0] != 's') { ret 6; }
    # the buffer is drained and the descriptor is invalid: the refill fails
    val res_third: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 8);
    if (!sel res_third.err) { ret 7; }
    ret 0;
}
