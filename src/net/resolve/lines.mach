# bounded line iteration over resolver configuration files

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.system.os;
use io_error: std.io.error;

pub val MAX_LINE: usize = 512;

# a buffered reader yielding one nul-terminated line at a time
# ---
# fd:   open descriptor, or negative when exhausted or closed
# buf:  read-ahead storage
# len:  valid bytes in buf
# pos:  next unread byte in buf
# done: no more bytes will arrive from fd
pub rec Reader {
    fd: i32;
    buf: [1024]u8;
    len: usize;
    pos: usize;
    done: bool;
}

pub fun open(reader: *Reader, path: str) err[io_error.Error] {
    val fd: i64 = os.open(os.AT_FDCWD, path, os.O_RDONLY, 0);
    if (fd < 0) { ret err[io_error.Error].err{io_error.from_code(fd, io_error.OP_OPEN)}; }
    reader.fd = fd::i32;
    reader.len = 0;
    reader.pos = 0;
    reader.done = false;
    ret err[io_error.Error].ok{};
}

# release the descriptor; a reader that is already closed or was never
# opened closes as a success, a refused native close is the failure
pub fun close(reader: *Reader) err[io_error.Error] {
    val fd: i32 = reader.fd;
    reader.fd = -1;
    reader.done = true;
    if (fd < 0) { ret err[io_error.Error].ok{}; }
    val code: i64 = os.close(fd);
    if (code < 0) { ret err[io_error.Error].err{io_error.from_code(code, io_error.OP_CLOSE)}; }
    ret err[io_error.Error].ok{};
}

# pull the next chunk; the end of the file and a read failure both stop the
# reader, and the failure is reported so the caller can surface it
fun fill(reader: *Reader) err[io_error.Error] {
    if (reader.done) { ret err[io_error.Error].ok{}; }
    val n: i64 = os.read(reader.fd, ?reader.buf[0], 1024);
    if (n < 0) {
        reader.done = true;
        ret err[io_error.Error].err{io_error.from_code(n, io_error.OP_READ)};
    }
    if (n == 0) {
        reader.done = true;
        ret err[io_error.Error].ok{};
    }
    reader.len = n::usize;
    reader.pos = 0;
    ret err[io_error.Error].ok{};
}

# copy the next line into output without its newline, nul-terminated
#
# a line longer than capacity - 1 bytes is consumed whole but truncated in
# output; the returned length is the untruncated length so the caller can
# detect and skip it. the end of the file is absence, a read failure is the
# error, and a zero capacity is invalid use.
# ---
# reader:   the reader to advance
# output:   destination for the line bytes
# capacity: size of output in bytes
# ret:      the untruncated line length, absent when exhausted, or the failure
pub fun next(reader: *Reader, output: *u8, capacity: usize) res[opt[usize], io_error.Error] {
    if (capacity == 0) {
        ret res[opt[usize], io_error.Error].err{io_error.from_code(os.EINVAL, io_error.OP_READ)};
    }
    if (reader.pos >= reader.len) {
        val filled: err[io_error.Error] = fill(reader);
        if (sel filled.err) { ret res[opt[usize], io_error.Error].err{filled.err}; }
        if (reader.pos >= reader.len && reader.done) { ret res[opt[usize], io_error.Error].ok{opt[usize].none{}}; }
    }
    var written: usize = 0;
    var length: usize = 0;
    for (true) {
        if (reader.pos >= reader.len) {
            val refilled: err[io_error.Error] = fill(reader);
            if (sel refilled.err) { ret res[opt[usize], io_error.Error].err{refilled.err}; }
            if (reader.pos >= reader.len && reader.done) { brk; }
            cnt;
        }
        val byte: u8 = reader.buf[reader.pos];
        reader.pos = reader.pos + 1;
        if (byte == 10) { brk; }
        if (written + 1 < capacity) {
            output[written] = byte;
            written = written + 1;
        }
        length = length + 1;
    }
    output[written] = 0;
    ret res[opt[usize], io_error.Error].ok{opt[usize].some{length}};
}

test "resolve.lines: an exhausted reader is absence and a zero capacity is invalid" {
    var reader: Reader;
    reader.fd = -1;
    reader.done = true;
    reader.len = 0;
    reader.pos = 0;
    var line: [16]u8;
    val exhausted: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 16);
    if (!sel exhausted.ok) { ret 1; }
    if (!sel exhausted.ok.none) { ret 2; }
    val invalid: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 0);
    if (!sel invalid.err) { ret 3; }
    if (invalid.err.kind != io_error.INVALID) { ret 4; }
    val closed: err[io_error.Error] = close(?reader);
    if (!sel closed.ok) { ret 5; }
    ret 0;
}

test "resolve.lines: a missing file is the open failure and a bad descriptor is the read failure" {
    var reader: Reader;
    val opened: err[io_error.Error] = open(?reader, "/std_resolve_lines_no_such_file");
    if (!sel opened.err) { ret 1; }
    if (opened.err.operation != io_error.OP_OPEN) { ret 2; }
    reader.fd = -1;
    reader.done = false;
    reader.len = 0;
    reader.pos = 0;
    var line: [16]u8;
    val failed: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 16);
    if (!sel failed.err) { ret 3; }
    if (failed.err.operation != io_error.OP_READ) { ret 4; }
    # the failure stops the reader: the next call is absence, not a second read
    val after: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 16);
    if (!sel after.ok) { ret 5; }
    if (!sel after.ok.none) { ret 6; }
    ret 0;
}

test "resolve.lines: lines are delivered whole with truncation reported by length" {
    var reader: Reader;
    reader.fd = -1;
    reader.done = false;
    reader.len = 0;
    reader.pos = 0;
    val text: str = "first\nsecond line is long\n";
    var i: usize = 0;
    for (text[i] != 0) { reader.buf[i] = text[i]; i = i + 1; }
    reader.len = i;
    var line: [8]u8;
    val first: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 8);
    if (!sel first.ok) { ret 1; }
    if (!sel first.ok.some) { ret 2; }
    if (first.ok.some != 5 || line[0] != 'f' || line[5] != 0) { ret 3; }
    val second: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 8);
    if (!sel second.ok) { ret 4; }
    if (!sel second.ok.some) { ret 5; }
    if (second.ok.some != 19 || line[6] != 0 || line[0] != 's') { ret 6; }
    # the buffer is drained and the descriptor is invalid: the refill fails
    val third: res[opt[usize], io_error.Error] = next(?reader, ?line[0], 8);
    if (!sel third.err) { ret 7; }
    ret 0;
}
