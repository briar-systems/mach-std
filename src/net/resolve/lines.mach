# bounded line iteration over resolver configuration files

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.system.os;

pub val MAX_LINE: usize = 512;

# a buffered reader yielding one nul-terminated line at a time
# ---
# fd:   open descriptor, or negative when exhausted or closed
# buf:  read-ahead storage
# len:  valid bytes in buf
# pos:  next unread byte in buf
# done: no more bytes will arrive from fd
pub rec Reader {
    fd: i32;
    buf: [1024]u8;
    len: usize;
    pos: usize;
    done: bool;
}

pub fun open(reader: *Reader, path: str) bool {
    val fd: i64 = os.open(os.AT_FDCWD, path, os.O_RDONLY, 0);
    if (fd < 0) { ret false; }
    reader.fd = fd::i32;
    reader.len = 0;
    reader.pos = 0;
    reader.done = false;
    ret true;
}

pub fun close(reader: *Reader) {
    if (reader.fd >= 0) { os.close(reader.fd); }
    reader.fd = -1;
    reader.done = true;
}

fun fill(reader: *Reader) {
    if (reader.done) { ret; }
    val n: i64 = os.read(reader.fd, ?reader.buf[0], 1024);
    if (n <= 0) {
        reader.done = true;
        ret;
    }
    reader.len = n::usize;
    reader.pos = 0;
}

# copy the next line into output without its newline, nul-terminated
#
# a line longer than capacity - 1 bytes is consumed whole but truncated in
# output; the returned length is the untruncated length so the caller can
# detect and skip it.
# ---
# reader:   the reader to advance
# output:   destination for the line bytes
# capacity: size of output in bytes
# ret:      untruncated line length, or negative when exhausted
pub fun next(reader: *Reader, output: *u8, capacity: usize) i64 {
    if (capacity == 0) { ret -1; }
    if (reader.pos >= reader.len) {
        fill(reader);
        if (reader.pos >= reader.len && reader.done) { ret -1; }
    }
    var written: usize = 0;
    var length: usize = 0;
    for (true) {
        if (reader.pos >= reader.len) {
            fill(reader);
            if (reader.pos >= reader.len && reader.done) { brk; }
            cnt;
        }
        val byte: u8 = reader.buf[reader.pos];
        reader.pos = reader.pos + 1;
        if (byte == 10) { brk; }
        if (written + 1 < capacity) {
            output[written] = byte;
            written = written + 1;
        }
        length = length + 1;
    }
    output[written] = 0;
    ret length::i64;
}

test "resolve.lines: reads and terminates" {
    var reader: Reader;
    reader.fd = -1;
    reader.done = true;
    reader.len = 0;
    reader.pos = 0;
    var line: [16]u8;
    if (next(?reader, ?line[0], 16) != -1) { ret 1; }
    ret 0;
}
