# service name to port resolution

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.net.resolve.lines;
use std.net.resolve.types;

fun blank(byte: u8) bool {
    ret byte == ' ' || byte == 9;
}

fun token_end(line: *u8, position: usize) usize {
    var i: usize = position;
    for (line[i] != 0 && !blank(line[i]) && line[i] != '#') { i = i + 1; }
    ret i;
}

fun skip_blanks(line: *u8, position: usize) usize {
    var i: usize = position;
    for (line[i] != 0 && blank(line[i])) { i = i + 1; }
    ret i;
}

fun lower(byte: u8) u8 {
    if (byte >= 'A' && byte <= 'Z') { ret byte + 32; }
    ret byte;
}

fun name_matches(line: *u8, start: usize, end: usize, name: str) bool {
    val length: usize = str_len(name);
    if (end - start != length) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (lower(line[start + i]) != lower(name[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# parse a decimal port, rejecting overflow and empty or trailing garbage
pub fun numeric(service: str, port: *u16) bool {
    if (service == nil) { ret false; }
    val length: usize = str_len(service);
    if (length == 0) { ret false; }
    var value: u32 = 0;
    var i: usize = 0;
    for (i < length) {
        val byte: u8 = service[i];
        if (byte < '0' || byte > '9') { ret false; }
        val digit: u32 = (byte - '0')::u32;
        if (value > (65535 - digit) / 10) { ret false; }
        value = value * 10 + digit;
        i = i + 1;
    }
    @port = value::u16;
    ret true;
}

fun protocol_matches(line: *u8, start: usize, end: usize, socket_kind: types.SocketKind) bool {
    if (socket_kind == types.STREAM_SOCKET) { ret name_matches(line, start, end, "tcp"); }
    if (socket_kind == types.DATAGRAM_SOCKET) { ret name_matches(line, start, end, "udp"); }
    ret name_matches(line, start, end, "tcp") || name_matches(line, start, end, "udp");
}

# fold one services line into the search; true when the line resolves it
pub fun scan_line(line: *u8, service: str, socket_kind: types.SocketKind, port: *u16) bool {
    val name_start: usize = skip_blanks(line, 0);
    if (line[name_start] == 0 || line[name_start] == '#') { ret false; }
    val name_end: usize = token_end(line, name_start);
    if (name_end == name_start) { ret false; }

    val port_start: usize = skip_blanks(line, name_end);
    var port_end: usize = port_start;
    for (line[port_end] >= '0' && line[port_end] <= '9') { port_end = port_end + 1; }
    if (port_end == port_start || line[port_end] != '/') { ret false; }
    val protocol_start: usize = port_end + 1;
    val protocol_end: usize = token_end(line, protocol_start);
    if (!protocol_matches(line, protocol_start, protocol_end, socket_kind)) { ret false; }

    var matched: bool = name_matches(line, name_start, name_end, service);
    var position: usize = skip_blanks(line, protocol_end);
    for (!matched && line[position] != 0 && line[position] != '#') {
        val end: usize = token_end(line, position);
        if (end == position) { brk; }
        if (name_matches(line, position, end, service)) { matched = true; }
        position = skip_blanks(line, end);
    }
    if (!matched) { ret false; }

    var value: u32 = 0;
    var i: usize = port_start;
    for (i < port_end) {
        val digit: u32 = (line[i] - '0')::u32;
        if (value > (65535 - digit) / 10) { ret false; }
        value = value * 10 + digit;
        i = i + 1;
    }
    @port = value::u16;
    ret true;
}

# resolve a service name to a port via /etc/services
# ---
# ret: true when a matching entry was found
pub fun lookup(service: str, socket_kind: types.SocketKind, port: *u16) bool {
    var reader: lines.Reader;
    if (!lines.open(?reader, "/etc/services")) { ret false; }
    var line: [512]u8;
    var length: i64 = lines.next(?reader, ?line[0], 512);
    for (length >= 0) {
        if (length < 512 && scan_line(?line[0], service, socket_kind, port)) {
            lines.close(?reader);
            ret true;
        }
        length = lines.next(?reader, ?line[0], 512);
    }
    lines.close(?reader);
    ret false;
}

test "resolve.service: numeric parsing bounds" {
    var port: u16 = 0;
    if (!numeric("65535", ?port) || port != 65535) { ret 1; }
    if (numeric("65536", ?port)) { ret 1; }
    if (numeric("", ?port)) { ret 1; }
    if (numeric("8http", ?port)) { ret 1; }
    ret 0;
}

test "resolve.service: names, aliases, and protocol filtering" {
    var port: u16 = 0;
    if (!scan_line("http  80/tcp  www www-http", "www", types.STREAM_SOCKET, ?port) || port != 80) { ret 1; }
    if (!scan_line("http  80/tcp  www", "HTTP", types.ANY_SOCKET, ?port) || port != 80) { ret 1; }
    if (scan_line("http  80/tcp  www", "http", types.DATAGRAM_SOCKET, ?port)) { ret 1; }
    if (scan_line("# http 80/tcp", "http", types.ANY_SOCKET, ?port)) { ret 1; }
    if (scan_line("domain 53/udp", "domain", types.DATAGRAM_SOCKET, ?port) == false || port != 53) { ret 1; }
    ret 0;
}
