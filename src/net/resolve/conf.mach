# resolv.conf resolver policy

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.system.os;
use std.net.ip;
use std.net.resolve.lines;

pub val DNS_PORT: u16 = 53;
pub val MAX_NAMESERVERS: usize = 3;
pub val MAX_SEARCH: usize = 6;
pub val MAX_NAME: usize = 254;

val MAX_NDOTS: u32 = 15;
val MAX_TIMEOUT_MS: u64 = 60000;
val MAX_ATTEMPTS: u32 = 10;

# parsed resolver policy with glibc-compatible defaults and caps
# ---
# nameservers:      servers queried in order (rotated when rotate is set)
# nameserver_count: valid entries in nameservers
# search:           MAX_SEARCH nul-terminated slots of MAX_NAME bytes each
# search_count:     valid slots in search
# ndots:            dot threshold selecting literal-first lookup order
# timeout_ms:       per-request wait before the next server is tried
# attempts:         full passes over the nameserver list
# rotate:           start each lookup at a different server
pub rec Config {
    nameservers: [3]ip.Endpoint;
    nameserver_count: usize;
    search: [1524]u8;
    search_count: usize;
    ndots: u32;
    timeout_ms: u64;
    attempts: u32;
    rotate: bool;
}

pub fun defaults(config: *Config) {
    config.nameserver_count = 0;
    config.search_count = 0;
    config.ndots = 1;
    config.timeout_ms = 5000;
    config.attempts = 2;
    config.rotate = false;
}

pub fun search_domain(config: *Config, index: usize) *u8 {
    ret ?config.search[index * MAX_NAME];
}

fun blank(byte: u8) bool {
    ret byte == ' ' || byte == 9;
}

fun token_end(line: *u8, position: usize) usize {
    var i: usize = position;
    for (line[i] != 0 && !blank(line[i])) { i = i + 1; }
    ret i;
}

fun skip_blanks(line: *u8, position: usize) usize {
    var i: usize = position;
    for (line[i] != 0 && blank(line[i])) { i = i + 1; }
    ret i;
}

fun token_is(line: *u8, start: usize, end: usize, word: str) bool {
    val length: usize = str_len(word);
    if (end - start != length) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (line[start + i] != word[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun parse_number(line: *u8, start: usize, end: usize, output: *u64) bool {
    if (start == end) { ret false; }
    var value: u64 = 0;
    var i: usize = start;
    for (i < end) {
        val byte: u8 = line[i];
        if (byte < '0' || byte > '9') { ret false; }
        if (value > 100000) { ret false; }
        value = value * 10 + (byte - '0')::u64;
        i = i + 1;
    }
    @output = value;
    ret true;
}

fun add_nameserver(config: *Config, line: *u8, start: usize, end: usize) {
    if (config.nameserver_count >= MAX_NAMESERVERS) { ret; }
    if (end - start >= 64) { ret; }
    var text: [64]u8;
    var scope: u32 = 0;
    var length: usize = 0;
    var i: usize = start;
    for (i < end && line[i] != '%') {
        text[length] = line[i];
        length = length + 1;
        i = i + 1;
    }
    text[length] = 0;
    if (i < end && line[i] == '%') {
        # an interface-name scope needs an index this parser will not guess;
        # only a numeric scope id is representable
        var value: u64 = 0;
        if (!parse_number(line, i + 1, end, ?value) || value > 0xffffffff) { ret; }
        scope = value::u32;
    }
    val parsed: Result[ip.Addr, str] = ip.addr_parse(?text[0]);
    if (is_err[ip.Addr, str](parsed)) { ret; }
    config.nameservers[config.nameserver_count] = ip.Endpoint{
        addr: unwrap_ok[ip.Addr, str](parsed),
        port: DNS_PORT,
        scope: scope,
    };
    config.nameserver_count = config.nameserver_count + 1;
}

fun add_search(config: *Config, line: *u8, start: usize, end: usize) {
    if (config.search_count >= MAX_SEARCH) { ret; }
    val length: usize = end - start;
    if (length == 0 || length >= MAX_NAME) { ret; }
    val slot: *u8 = search_domain(config, config.search_count);
    var i: usize = 0;
    for (i < length) { slot[i] = line[start + i]; i = i + 1; }
    slot[length] = 0;
    config.search_count = config.search_count + 1;
}

fun parse_option(config: *Config, line: *u8, start: usize, end: usize) {
    var value: u64 = 0;
    if (token_is(line, start, end, "rotate")) {
        config.rotate = true;
        ret;
    }
    var separator: usize = start;
    for (separator < end && line[separator] != ':') { separator = separator + 1; }
    if (separator == end || !parse_number(line, separator + 1, end, ?value)) { ret; }
    if (token_is(line, start, separator, "ndots")) {
        if (value > MAX_NDOTS::u64) { value = MAX_NDOTS::u64; }
        config.ndots = value::u32;
    }
    or (token_is(line, start, separator, "timeout")) {
        var ms: u64 = value * 1000;
        if (ms > MAX_TIMEOUT_MS) { ms = MAX_TIMEOUT_MS; }
        config.timeout_ms = ms;
    }
    or (token_is(line, start, separator, "attempts")) {
        if (value > MAX_ATTEMPTS::u64) { value = MAX_ATTEMPTS::u64; }
        config.attempts = value::u32;
    }
}

# fold one configuration line into config; comments and noise are skipped
pub fun parse_line(config: *Config, line: *u8) {
    var position: usize = skip_blanks(line, 0);
    if (line[position] == 0 || line[position] == '#' || line[position] == ';') { ret; }
    val keyword_end: usize = token_end(line, position);

    if (token_is(line, position, keyword_end, "nameserver")) {
        val start: usize = skip_blanks(line, keyword_end);
        var end: usize = token_end(line, start);
        var i: usize = start;
        for (i < end) {
            if (line[i] == '#' || line[i] == ';') { end = i; brk; }
            i = i + 1;
        }
        if (end > start) { add_nameserver(config, line, start, end); }
        ret;
    }

    val is_search: bool = token_is(line, position, keyword_end, "search");
    val is_domain: bool = token_is(line, position, keyword_end, "domain");
    if (is_search || is_domain) {
        # the last search or domain directive wins, per resolv.conf semantics
        config.search_count = 0;
        var start: usize = skip_blanks(line, keyword_end);
        for (line[start] != 0 && line[start] != '#' && line[start] != ';') {
            val end: usize = token_end(line, start);
            add_search(config, line, start, end);
            if (is_domain) { brk; }
            start = skip_blanks(line, end);
        }
        ret;
    }

    if (token_is(line, position, keyword_end, "options")) {
        var start: usize = skip_blanks(line, keyword_end);
        for (line[start] != 0 && line[start] != '#' && line[start] != ';') {
            val end: usize = token_end(line, start);
            parse_option(config, line, start, end);
            start = skip_blanks(line, end);
        }
    }
}

# a configuration with no reachable nameserver falls back to loopback,
# matching every mainstream resolver's behavior
pub fun finish(config: *Config) {
    if (config.nameserver_count != 0) { ret; }
    config.nameservers[0] = ip.Endpoint{
        addr: ip.addr_v4(ip.ipv4_loopback()),
        port: DNS_PORT,
        scope: 0,
    };
    config.nameserver_count = 1;
}

# load the target resolver policy from /etc/resolv.conf
pub fun load(config: *Config) {
    defaults(config);
    var reader: lines.Reader;
    if (lines.open(?reader, "/etc/resolv.conf")) {
        var line: [512]u8;
        var length: i64 = lines.next(?reader, ?line[0], 512);
        for (length >= 0) {
            if (length < 512) { parse_line(config, ?line[0]); }
            length = lines.next(?reader, ?line[0], 512);
        }
        lines.close(?reader);
    }
    finish(config);
}

test "resolve.conf: defaults and loopback fallback" {
    var config: Config;
    defaults(?config);
    finish(?config);
    if (config.nameserver_count != 1) { ret 1; }
    if (config.nameservers[0].addr.is_v6 != 0) { ret 1; }
    if (config.nameservers[0].addr.v4.octets[0] != 127) { ret 1; }
    if (config.nameservers[0].port != DNS_PORT) { ret 1; }
    if (config.ndots != 1 || config.attempts != 2 || config.timeout_ms != 5000) { ret 1; }
    ret 0;
}
