# DNS message encoding and decoding (RFC 1035)

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.net.ip;

pub val TYPE_A:     u16 = 1;
pub val TYPE_CNAME: u16 = 5;
pub val TYPE_AAAA:  u16 = 28;
pub val CLASS_IN:   u16 = 1;

pub val RCODE_OK:       u8 = 0;
pub val RCODE_FORMAT:   u8 = 1;
pub val RCODE_SERVFAIL: u8 = 2;
pub val RCODE_NXDOMAIN: u8 = 3;

pub val HEADER_LENGTH: usize = 12;
pub val MAX_MESSAGE: usize = 4096;
pub val MAX_NAME_TEXT: usize = 254;

val MAX_POINTER_JUMPS: usize = 64;

# decoded response summary; addresses and the canonical name are written
# into caller storage during parse
# ---
# rcode:            server response code
# truncated:        TC bit; the caller should retry the query over TCP
# addr_count:       addresses of the wanted type written to the addrs array
# canonical_length: text length of the final CNAME target, 0 when none
pub rec Parsed {
    rcode: u8;
    truncated: bool;
    addr_count: usize;
    canonical_length: usize;
}

fun write_u16(buf: *u8, position: usize, value: u16) {
    buf[position] = (value >> 8)::u8;
    buf[position + 1] = value::u8;
}

fun read_u16(buf: *u8, position: usize) u16 {
    ret (buf[position]::u16 << 8) | buf[position + 1]::u16;
}

fun append_labels(name: *u8, length: usize, buf: *u8, capacity: usize, position: usize) usize {
    var pos: usize = position;
    var i: usize = 0;
    for (i < length) {
        var label_length: usize = 0;
        for (i + label_length < length && name[i + label_length] != '.') {
            label_length = label_length + 1;
        }
        if (label_length == 0 || label_length > 63) { ret 0; }
        if (pos + 1 + label_length > capacity) { ret 0; }
        buf[pos] = label_length::u8;
        pos = pos + 1;
        var j: usize = 0;
        for (j < label_length) { buf[pos + j] = name[i + j]; j = j + 1; }
        pos = pos + label_length;
        i = i + label_length + 1;
    }
    ret pos;
}

# build a recursion-desired question for hostname, optionally suffixed with a
# search domain. a single trailing dot marks the name fully qualified and is
# stripped; when present the domain must be nil.
# ---
# ret: message length, or 0 when the name does not encode
pub fun build_query(id: u16, hostname: str, domain: *u8, qtype: u16, buf: *u8, capacity: usize) usize {
    if (hostname == nil || capacity < HEADER_LENGTH + 5) { ret 0; }
    var host_length: usize = str_len(hostname);
    if (host_length == 0) { ret 0; }
    if (hostname[host_length - 1] == '.') {
        if (domain != nil) { ret 0; }
        host_length = host_length - 1;
        if (host_length == 0) { ret 0; }
    }

    write_u16(buf, 0, id);
    buf[2] = 0x01;
    buf[3] = 0x00;
    write_u16(buf, 4, 1);
    write_u16(buf, 6, 0);
    write_u16(buf, 8, 0);
    write_u16(buf, 10, 0);

    var position: usize = append_labels(hostname::*u8, host_length, buf, capacity, HEADER_LENGTH);
    if (position == 0) { ret 0; }
    if (domain != nil && domain[0] != 0) {
        position = append_labels(domain, str_len(domain), buf, capacity, position);
        if (position == 0) { ret 0; }
    }
    # wire names cap at 255 bytes including the root label
    if (position - HEADER_LENGTH + 1 > 255) { ret 0; }
    if (position + 5 > capacity) { ret 0; }
    buf[position] = 0;
    position = position + 1;
    write_u16(buf, position, qtype);
    write_u16(buf, position + 2, CLASS_IN);
    ret position + 4;
}

# walk one possibly-compressed name. output may be nil to skip. writes the
# dotted text nul-terminated and its length to output_length.
# ---
# ret: position after the name in the record stream, or 0 on malformed input
fun read_name(buf: *u8, length: usize, position: usize, output: *u8, output_capacity: usize, output_length: *usize) usize {
    var pos: usize = position;
    var after: usize = 0;
    var jumps: usize = 0;
    var text_length: usize = 0;
    for (true) {
        if (pos >= length) { ret 0; }
        val byte: u8 = buf[pos];
        if (byte == 0) {
            if (after == 0) { after = pos + 1; }
            brk;
        }
        if ((byte & 0xC0) == 0xC0) {
            if (pos + 1 >= length) { ret 0; }
            if (after == 0) { after = pos + 2; }
            jumps = jumps + 1;
            if (jumps > MAX_POINTER_JUMPS) { ret 0; }
            pos = (((byte & 0x3F)::u16 << 8) | buf[pos + 1]::u16)::usize;
            cnt;
        }
        if ((byte & 0xC0) != 0) { ret 0; }
        val label_length: usize = byte::usize;
        if (pos + 1 + label_length > length) { ret 0; }
        if (output != nil) {
            if (text_length + label_length + 2 > output_capacity) { ret 0; }
            if (text_length != 0) {
                output[text_length] = '.';
                text_length = text_length + 1;
            }
            var i: usize = 0;
            for (i < label_length) {
                output[text_length + i] = buf[pos + 1 + i];
                i = i + 1;
            }
            text_length = text_length + label_length;
        } or {
            text_length = text_length + label_length + 1;
            if (text_length > 255) { ret 0; }
        }
        pos = pos + 1 + label_length;
    }
    if (output != nil) {
        output[text_length] = 0;
        if (output_length != nil) { @output_length = text_length; }
    }
    ret after;
}

# decode a response, collecting addresses of the wanted record type and the
# final CNAME target when the answer section carries a chain
# ---
# ret: true when the message parsed as a response to the given id; header
#      status (rcode, truncation) is reported through out even when the
#      answer section carries no usable records
pub fun parse(buf: *u8, length: usize, id: u16, want_type: u16, addrs: *ip.Addr,
    addr_capacity: usize, canonical: *u8, canonical_capacity: usize, out: *Parsed) bool {
    out.rcode = RCODE_FORMAT;
    out.truncated = false;
    out.addr_count = 0;
    out.canonical_length = 0;
    if (length < HEADER_LENGTH) { ret false; }
    if (read_u16(buf, 0) != id) { ret false; }
    if ((buf[2] & 0x80) == 0) { ret false; }
    if ((buf[2] & 0x78) != 0) { ret false; }
    out.truncated = (buf[2] & 0x02) != 0;
    out.rcode = buf[3] & 0x0F;

    val question_count: u16 = read_u16(buf, 4);
    val answer_count: u16 = read_u16(buf, 6);
    if (question_count > 1) { ret false; }

    var position: usize = HEADER_LENGTH;
    if (question_count == 1) {
        position = read_name(buf, length, position, nil, 0, nil);
        if (position == 0 || position + 4 > length) { ret false; }
        position = position + 4;
    }

    var i: u16 = 0;
    for (i < answer_count) {
        position = read_name(buf, length, position, nil, 0, nil);
        if (position == 0 || position + 10 > length) { ret false; }
        val record_type: u16 = read_u16(buf, position);
        val record_class: u16 = read_u16(buf, position + 2);
        val data_length: usize = read_u16(buf, position + 8)::usize;
        position = position + 10;
        if (position + data_length > length) { ret false; }

        if (record_class == CLASS_IN && record_type == want_type) {
            if (want_type == TYPE_A && data_length == 4 && out.addr_count < addr_capacity) {
                var v4: ip.IPv4;
                v4.octets[0] = buf[position];
                v4.octets[1] = buf[position + 1];
                v4.octets[2] = buf[position + 2];
                v4.octets[3] = buf[position + 3];
                addrs[out.addr_count] = ip.addr_v4(v4);
                out.addr_count = out.addr_count + 1;
            }
            if (want_type == TYPE_AAAA && data_length == 16 && out.addr_count < addr_capacity) {
                var v6: ip.IPv6;
                var j: usize = 0;
                for (j < 16) { v6.octets[j] = buf[position + j]; j = j + 1; }
                addrs[out.addr_count] = ip.addr_v6(v6);
                out.addr_count = out.addr_count + 1;
            }
        }
        or (record_class == CLASS_IN && record_type == TYPE_CNAME && canonical != nil) {
            # the last chain link in answer order names the canonical host
            var target_length: usize = 0;
            if (read_name(buf, length, position, canonical, canonical_capacity, ?target_length) != 0) {
                out.canonical_length = target_length;
            }
        }

        position = position + data_length;
        i = i + 1;
    }
    ret true;
}

fun test_response(buf: *u8) usize {
    # response id 0x1234: question web.example A, answers:
    # web.example CNAME canon.example, canon.example A 192.0.2.7
    var pos: usize = 0;
    buf[0] = 0x12; buf[1] = 0x34;
    buf[2] = 0x81; buf[3] = 0x00;
    buf[4] = 0; buf[5] = 1;
    buf[6] = 0; buf[7] = 2;
    buf[8] = 0; buf[9] = 0;
    buf[10] = 0; buf[11] = 0;
    pos = 12;
    buf[pos] = 3; buf[pos+1] = 'w'; buf[pos+2] = 'e'; buf[pos+3] = 'b';
    buf[pos+4] = 7; buf[pos+5] = 'e'; buf[pos+6] = 'x'; buf[pos+7] = 'a';
    buf[pos+8] = 'm'; buf[pos+9] = 'p'; buf[pos+10] = 'l'; buf[pos+11] = 'e';
    buf[pos+12] = 0;
    pos = pos + 13;
    buf[pos] = 0; buf[pos+1] = 1; buf[pos+2] = 0; buf[pos+3] = 1;
    pos = pos + 4;
    # answer 1: pointer to question name, CNAME canon.example
    buf[pos] = 0xC0; buf[pos+1] = 12;
    buf[pos+2] = 0; buf[pos+3] = 5;
    buf[pos+4] = 0; buf[pos+5] = 1;
    buf[pos+6] = 0; buf[pos+7] = 0; buf[pos+8] = 0; buf[pos+9] = 60;
    buf[pos+10] = 0; buf[pos+11] = 8;
    pos = pos + 12;
    buf[pos] = 5; buf[pos+1] = 'c'; buf[pos+2] = 'a'; buf[pos+3] = 'n';
    buf[pos+4] = 'o'; buf[pos+5] = 'n';
    buf[pos+6] = 0xC0; buf[pos+7] = 16;
    val cname_target: usize = pos;
    pos = pos + 8;
    # answer 2: canon.example A 192.0.2.7
    buf[pos] = 0xC0; buf[pos+1] = cname_target::u8;
    buf[pos+2] = 0; buf[pos+3] = 1;
    buf[pos+4] = 0; buf[pos+5] = 1;
    buf[pos+6] = 0; buf[pos+7] = 0; buf[pos+8] = 0; buf[pos+9] = 60;
    buf[pos+10] = 0; buf[pos+11] = 4;
    pos = pos + 12;
    buf[pos] = 192; buf[pos+1] = 0; buf[pos+2] = 2; buf[pos+3] = 7;
    ret pos + 4;
}

test "resolve.wire: query round trip shape" {
    var buf: [512]u8;
    val length: usize = build_query(0x1234, "web.example", nil, TYPE_A, ?buf[0], 512);
    if (length != 12 + 13 + 4) { ret 1; }
    if (buf[12] != 3 || buf[13] != 'w' || buf[16] != 7) { ret 1; }
    if (buf[length - 4] != 0 || buf[length - 3] != 1) { ret 1; }
    val suffixed: usize = build_query(1, "web", "example.test", TYPE_AAAA, ?buf[0], 512);
    if (suffixed == 0) { ret 1; }
    if (buf[12] != 3 || buf[16] != 7 || buf[24] != 4) { ret 1; }
    if (build_query(1, "bad..name", nil, TYPE_A, ?buf[0], 512) != 0) { ret 1; }
    if (build_query(1, "fully.qualified.", "example", TYPE_A, ?buf[0], 512) != 0) { ret 1; }
    ret 0;
}

test "resolve.wire: response with cname chain and compression" {
    var message: [512]u8;
    val length: usize = test_response(?message[0]);
    var addrs: [4]ip.Addr;
    var canonical: [254]u8;
    var out: Parsed;
    if (!parse(?message[0], length, 0x1234, TYPE_A, ?addrs[0], 4, ?canonical[0], 254, ?out)) { ret 1; }
    if (out.rcode != RCODE_OK || out.truncated) { ret 1; }
    if (out.addr_count != 1) { ret 1; }
    if (addrs[0].is_v6 != 0 || addrs[0].v4.octets[3] != 7) { ret 1; }
    if (out.canonical_length != 13) { ret 1; }
    if (canonical[0] != 'c' || canonical[5] != '.' || canonical[12] != 'e') { ret 1; }
    ret 0;
}

test "resolve.wire: rejects wrong id and non-responses" {
    var message: [512]u8;
    val length: usize = test_response(?message[0]);
    var addrs: [4]ip.Addr;
    var out: Parsed;
    if (parse(?message[0], length, 0x9999, TYPE_A, ?addrs[0], 4, nil, 0, ?out)) { ret 1; }
    message[2] = 0x01;
    if (parse(?message[0], length, 0x1234, TYPE_A, ?addrs[0], 4, nil, 0, ?out)) { ret 1; }
    ret 0;
}

test "resolve.wire: pointer loops are bounded" {
    var message: [64]u8;
    var i: usize = 0;
    for (i < 64) { message[i] = 0; i = i + 1; }
    message[0] = 0x00; message[1] = 0x01;
    message[2] = 0x81; message[3] = 0x00;
    message[5] = 1;
    # question name is a pointer to itself
    message[12] = 0xC0; message[13] = 12;
    message[14] = 0; message[15] = 1; message[16] = 0; message[17] = 1;
    var addrs: [4]ip.Addr;
    var out: Parsed;
    if (parse(?message[0], 18, 1, TYPE_A, ?addrs[0], 4, nil, 0, ?out)) { ret 1; }
    ret 0;
}
