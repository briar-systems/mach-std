# target resolver result ownership helpers

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.result;
use std.types.string.str;
use std.types.string.str_len;
use std.allocator;
use std.net.ip;
use std.net.resolve.types;

pub fun error(kind: types.ErrorKind, native_code: i64) types.Error {
    ret types.Error{kind: kind, native_code: native_code};
}

pub fun clear(output: *types.Resolution, owner: *allocator.Allocator) {
    output.endpoints = nil;
    output.len = 0;
    output.endpoint_capacity = 0;
    output.canonical_name = nil;
    output.canonical_length = 0;
    output.canonical_capacity = 0;
    output.allocator = owner;
}

pub fun destroy(output: *types.Resolution) bool {
    if (output == nil || output.allocator == nil) { ret false; }
    var valid: bool = true;
    if (output.endpoints != nil && output.endpoint_capacity != 0) {
        if (result.is_err[bool, *u8](allocator.deallocate[ip.Endpoint](output.allocator, output.endpoints, output.endpoint_capacity))) { valid = false; }
    }
    if (output.canonical_name != nil && output.canonical_capacity != 0) {
        if (result.is_err[bool, *u8](allocator.deallocate[u8](output.allocator, output.canonical_name, output.canonical_capacity))) { valid = false; }
    }
    clear(output, output.allocator);
    ret valid;
}

pub fun allocate_endpoints(output: *types.Resolution, capacity: usize) bool {
    if (output == nil || output.allocator == nil || capacity == 0) { ret false; }
    val allocated: result.Result[*ip.Endpoint, *u8] = allocator.allocate[ip.Endpoint](output.allocator, capacity);
    if (result.is_err[*ip.Endpoint, *u8](allocated)) { ret false; }
    output.endpoints = result.unwrap_ok[*ip.Endpoint, *u8](allocated);
    output.endpoint_capacity = capacity;
    output.len = 0;
    ret true;
}

fun endpoint_equal(a: ip.Endpoint, b: ip.Endpoint) bool {
    if (a.port != b.port || a.scope != b.scope || a.addr.is_v6 != b.addr.is_v6) { ret false; }
    var i: usize = 0;
    if (a.addr.is_v6 == 0) {
        for (i < 4) {
            if (a.addr.v4.octets[i] != b.addr.v4.octets[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    for (i < 16) {
        if (a.addr.v6.octets[i] != b.addr.v6.octets[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun valid(output: *types.Resolution) bool {
    if (output == nil || output.allocator == nil) { ret false; }
    if (output.len > output.endpoint_capacity) { ret false; }
    if (output.len != 0 && output.endpoints == nil) { ret false; }
    if (output.canonical_name == nil) {
        if (output.canonical_length != 0 || output.canonical_capacity != 0) { ret false; }
    } or {
        if (output.canonical_capacity == 0 || output.canonical_length >= output.canonical_capacity
         || output.canonical_name[output.canonical_length] != 0) { ret false; }
    }
    ret true;
}

# compaction preserves the target resolver's first occurrence order
pub fun deduplicate(output: *types.Resolution) bool {
    if (!valid(output)) { ret false; }
    var write: usize = 0;
    var read: usize = 0;
    for (read < output.len) {
        var duplicate: bool = false;
        var i: usize = 0;
        for (i < write) {
            if (endpoint_equal(output.endpoints[i], output.endpoints[read])) { duplicate = true; }
            i = i + 1;
        }
        if (!duplicate) {
            if (write != read) { output.endpoints[write] = output.endpoints[read]; }
            write = write + 1;
        }
        read = read + 1;
    }
    output.len = write;
    ret true;
}

# first occurrence wins, preserving the target resolver's policy order
pub fun append_unique(output: *types.Resolution, endpoint: ip.Endpoint) bool {
    if (output == nil || output.endpoints == nil || output.len >= output.endpoint_capacity) { ret false; }
    var i: usize = 0;
    for (i < output.len) {
        if (endpoint_equal(output.endpoints[i], endpoint)) { ret true; }
        i = i + 1;
    }
    output.endpoints[output.len] = endpoint;
    output.len = output.len + 1;
    ret true;
}

pub fun set_canonical(output: *types.Resolution, name: str) bool {
    if (output == nil || output.allocator == nil || name == nil) { ret false; }
    val length: usize = str_len(name);
    if (length == ~(0::usize)) { ret false; }
    val capacity: usize = length + 1;
    val allocated: result.Result[*u8, *u8] = allocator.allocate[u8](output.allocator, capacity);
    if (result.is_err[*u8, *u8](allocated)) { ret false; }
    output.canonical_name = result.unwrap_ok[*u8, *u8](allocated);
    output.canonical_length = length;
    output.canonical_capacity = capacity;
    var i: usize = 0;
    for (i < length) { output.canonical_name[i] = name[i]; i = i + 1; }
    output.canonical_name[length] = 0;
    ret true;
}
