# target resolver result ownership helpers

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.allocator;
use std.system.os;
use std.net.ip;
use std.net.resolve.types;

pub fun error(kind: types.ErrorKind, native_code: i64) types.Error {
    ret types.Error{kind: kind, native_code: native_code};
}

fun refused(kind: types.ErrorKind, native_code: i64) err[types.Error] {
    ret err[types.Error].err{types.Error{kind: kind, native_code: native_code}};
}

# an allocator refusal is the distinct OUT_OF_MEMORY case; a refused release
# carries the backend's status
fun allocation_refused(failure: allocator.Error) err[types.Error] {
    if (sel failure.release) { ret refused(types.SYSTEM_FAILURE, failure.release); }
    ret refused(types.OUT_OF_MEMORY, os.ENOMEM);
}

pub fun clear(output: *types.Resolution, owner: *allocator.Allocator) {
    output.endpoints = nil;
    output.len = 0;
    output.endpoint_capacity = 0;
    output.canonical_name = nil;
    output.canonical_length = 0;
    output.canonical_capacity = 0;
    output.allocator = owner;
}

# release the resolution's storage; both buffers are attempted, the first
# refusal is reported, and a buffer whose release was refused stays owned by
# the resolution so the caller can retry
pub fun destroy(output: *types.Resolution) err[types.Error] {
    if (output == nil || output.allocator == nil) { ret refused(types.INVALID, os.EINVAL); }
    var first: err[types.Error] = err[types.Error].ok{};
    var refused_any: bool = false;
    if (output.endpoints != nil && output.endpoint_capacity != 0) {
        val endpoints_freed: err[allocator.Error] = allocator.deallocate[ip.Endpoint](output.allocator, output.endpoints, output.endpoint_capacity);
        if (sel endpoints_freed.err) {
            first = allocation_refused(endpoints_freed.err);
            refused_any = true;
        } or {
            output.endpoints = nil;
            output.endpoint_capacity = 0;
            output.len = 0;
        }
    } or {
        output.endpoints = nil;
        output.endpoint_capacity = 0;
        output.len = 0;
    }
    if (output.canonical_name != nil && output.canonical_capacity != 0) {
        val name_freed: err[allocator.Error] = allocator.deallocate[u8](output.allocator, output.canonical_name, output.canonical_capacity);
        if (sel name_freed.err) {
            if (!refused_any) { first = allocation_refused(name_freed.err); }
        } or {
            output.canonical_name = nil;
            output.canonical_length = 0;
            output.canonical_capacity = 0;
        }
    } or {
        output.canonical_name = nil;
        output.canonical_length = 0;
        output.canonical_capacity = 0;
    }
    ret first;
}

pub fun allocate_endpoints(output: *types.Resolution, capacity: usize) err[types.Error] {
    if (output == nil || output.allocator == nil || capacity == 0) { ret refused(types.INVALID, os.EINVAL); }
    val allocated: res[*ip.Endpoint, allocator.Error] = allocator.allocate[ip.Endpoint](output.allocator, capacity);
    if (sel allocated.err) { ret allocation_refused(allocated.err); }
    output.endpoints = allocated.ok;
    output.endpoint_capacity = capacity;
    output.len = 0;
    ret err[types.Error].ok{};
}

fun endpoint_equal(a: ip.Endpoint, b: ip.Endpoint) bool {
    if (a.port != b.port || a.scope != b.scope || a.addr.is_v6 != b.addr.is_v6) { ret false; }
    var i: usize = 0;
    if (a.addr.is_v6 == 0) {
        for (i < 4) {
            if (a.addr.v4.octets[i] != b.addr.v4.octets[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    for (i < 16) {
        if (a.addr.v6.octets[i] != b.addr.v6.octets[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun valid(output: *types.Resolution) bool {
    if (output == nil || output.allocator == nil) { ret false; }
    if (output.len > output.endpoint_capacity) { ret false; }
    if (output.len != 0 && output.endpoints == nil) { ret false; }
    if (output.canonical_name == nil) {
        if (output.canonical_length != 0 || output.canonical_capacity != 0) { ret false; }
    } or {
        if (output.canonical_capacity == 0 || output.canonical_length >= output.canonical_capacity
         || output.canonical_name[output.canonical_length] != 0) { ret false; }
    }
    ret true;
}

pub fun within_limits(output: *types.Resolution, limits: types.ResultLimits) bool {
    if (!valid(output) || output.endpoint_capacity > limits.max_endpoints) { ret false; }
    if (output.canonical_capacity > limits.max_canonical_name_bytes) { ret false; }
    ret true;
}

# compaction preserves the target resolver's first occurrence order
pub fun deduplicate(output: *types.Resolution) err[types.Error] {
    if (!valid(output)) { ret refused(types.INVALID, os.EINVAL); }
    var write: usize = 0;
    var read: usize = 0;
    for (read < output.len) {
        var duplicate: bool = false;
        var i: usize = 0;
        for (i < write) {
            if (endpoint_equal(output.endpoints[i], output.endpoints[read])) { duplicate = true; }
            i = i + 1;
        }
        if (!duplicate) {
            if (write != read) { output.endpoints[write] = output.endpoints[read]; }
            write = write + 1;
        }
        read = read + 1;
    }
    output.len = write;
    ret err[types.Error].ok{};
}

# first occurrence wins, preserving the target resolver's policy order; a
# duplicate is a success that stores nothing, a full result is OVERLOADED
pub fun append_unique(output: *types.Resolution, endpoint: ip.Endpoint) err[types.Error] {
    if (output == nil || output.endpoints == nil) { ret refused(types.INVALID, os.EINVAL); }
    if (output.len >= output.endpoint_capacity) { ret refused(types.OVERLOADED, 0); }
    var i: usize = 0;
    for (i < output.len) {
        if (endpoint_equal(output.endpoints[i], endpoint)) { ret err[types.Error].ok{}; }
        i = i + 1;
    }
    output.endpoints[output.len] = endpoint;
    output.len = output.len + 1;
    ret err[types.Error].ok{};
}

pub fun set_canonical(output: *types.Resolution, name: str) err[types.Error] {
    if (output == nil || output.allocator == nil || name == nil) { ret refused(types.INVALID, os.EINVAL); }
    val length: usize = str_len(name);
    if (length == ~(0::usize)) { ret refused(types.OVERLOADED, 0); }
    val capacity: usize = length + 1;
    val allocated: res[*u8, allocator.Error] = allocator.allocate[u8](output.allocator, capacity);
    if (sel allocated.err) { ret allocation_refused(allocated.err); }
    output.canonical_name = allocated.ok;
    output.canonical_length = length;
    output.canonical_capacity = capacity;
    var i: usize = 0;
    for (i < length) { output.canonical_name[i] = name[i]; i = i + 1; }
    output.canonical_name[length] = 0;
    ret err[types.Error].ok{};
}

pub fun canonical_fits(name: str, max_bytes: usize) bool {
    if (name == nil) { ret true; }
    var length: usize = 0;
    for (length < max_bytes) {
        if (name[length] == 0) { ret true; }
        length = length + 1;
    }
    ret false;
}

use testing: std.allocator.testing;

# test predicate: `sel` takes a place, so an inline call is tested through this
fun accepted(r: err[types.Error]) bool { ret sel r.ok; }

test "resolve.shared: acquisitions report the allocator refusal and release keeps what was refused" {
    var tracking: testing.Testing;
    val tracked: err[allocator.Error] = testing.make(?tracking);
    if (sel tracked.err) { ret 1; }
    fin { testing.dnit(?tracking); }
    var output: types.Resolution;
    clear(?output, ?tracking.a);

    testing.fail_at_ordinal(?tracking, 1);
    val refused_endpoints: err[types.Error] = allocate_endpoints(?output, 2);
    if (!sel refused_endpoints.err) { ret 2; }
    if (refused_endpoints.err.kind != types.OUT_OF_MEMORY || output.endpoints != nil || tracking.live != 0) { ret 3; }
    testing.clear_failure(?tracking);
    if (!accepted(allocate_endpoints(?output, 2))) { ret 4; }
    val invalid: err[types.Error] = allocate_endpoints(?output, 0);
    if (!sel invalid.err) { ret 5; }
    if (invalid.err.kind != types.INVALID) { ret 6; }

    val ep: ip.Endpoint = ip.endpoint(127, 0, 0, 1, 53);
    if (!accepted(append_unique(?output, ep))) { ret 7; }
    if (!accepted(append_unique(?output, ep)) || output.len != 1) { ret 8; }
    if (!accepted(append_unique(?output, ip.endpoint(127, 0, 0, 2, 53))) || output.len != 2) { ret 9; }
    val full: err[types.Error] = append_unique(?output, ip.endpoint(127, 0, 0, 3, 53));
    if (!sel full.err) { ret 10; }
    if (full.err.kind != types.OVERLOADED || output.len != 2) { ret 11; }

    testing.fail_at_ordinal(?tracking, 1);
    val refused_name: err[types.Error] = set_canonical(?output, "example");
    if (!sel refused_name.err) { ret 12; }
    if (refused_name.err.kind != types.OUT_OF_MEMORY || output.canonical_name != nil) { ret 13; }
    testing.clear_failure(?tracking);
    if (!accepted(set_canonical(?output, "example")) || output.canonical_length != 7) { ret 14; }
    if (tracking.live != 2) { ret 15; }

    if (!accepted(deduplicate(?output)) || output.len != 2) { ret 16; }
    if (!accepted(destroy(?output))) { ret 17; }
    if (output.endpoints != nil || output.canonical_name != nil || tracking.live != 0) { ret 18; }
    val nothing: err[types.Error] = destroy(?output);
    if (!sel nothing.ok) { ret 19; }
    var unowned: types.Resolution;
    clear(?unowned, nil);
    val unowned_destroy: err[types.Error] = destroy(?unowned);
    if (!sel unowned_destroy.err) { ret 20; }
    if (unowned_destroy.err.kind != types.INVALID) { ret 21; }
    ret 0;
}
