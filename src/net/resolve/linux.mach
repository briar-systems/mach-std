# linux native resolver adapter
#
# resolution policy, in order: numeric addresses, RFC 6761 localhost names,
# the hosts file, then DNS over the resolv.conf nameservers with search-domain
# and ndots handling. results are ordered per RFC 6724. this speaks to the
# kernel directly; no libc is involved, so nsswitch plugin modules do not
# apply. systems routing resolution policy through a local stub resolver
# (systemd-resolved and peers) keep that policy, since the stub sits behind
# the nameserver interface.

$if ($mach.build.sys != $mach.sys.linux) {
    $error("std.net.resolve.linux: requires linux target");
}

use std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error: std.io.error;
use std.net.ip;
use std.net.resolve.conf;
use std.net.resolve.hosts;
use std.net.resolve.lookup;
use std.net.resolve.order;
use service_names: std.net.resolve.service;
use std.net.resolve.shared;
use std.net.resolve.types;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# resolve the query's service to a port; a nil service means port zero, an
# unknown service is NO_NAME and a services-file failure is the system failure
fun service_port(query: *types.Query) res[u16, types.Error] {
    if (query.service == nil) { ret res[u16, types.Error].ok{0}; }
    var numeric_port: u16 = 0;
    if (service_names.numeric(query.service, ?numeric_port)) { ret res[u16, types.Error].ok{numeric_port}; }
    if ((query.flags & types.NUMERIC_SERVICE) != 0)          { ret res[u16, types.Error].err{shared.error(types.NO_NAME, 0)}; }
    val res_named: res[opt[u16], types.Error] = service_names.lookup(query.service, query.socket_kind);
    if (sel res_named.err)     { ret res[u16, types.Error].err{res_named.err}; }
    if (sel res_named.ok.none) { ret res[u16, types.Error].err{shared.error(types.NO_NAME, 0)}; }
    ret res[u16, types.Error].ok{res_named.ok.some};
}

fun set_canonical_checked(query: *types.Query, limits: types.ResultLimits,
    output: *types.Resolution, name: str) types.Error {
    if ((query.flags & types.CANONICAL_NAME) == 0 || name == nil) {
        ret shared.error(types.NO_ERROR, 0);
    }
    if (!shared.canonical_fits(name, limits.max_canonical_name_bytes)) {
        ret shared.error(types.OVERLOADED, 0);
    }
    val err_named: err[types.Error] = shared.set_canonical(output, name);
    if (sel err_named.err) { ret err_named.err; }
    ret shared.error(types.NO_ERROR, 0);
}

fun deliver(query: *types.Query, limits: types.ResultLimits, output: *types.Resolution,
    addrs: *ip.Addr, count: usize, port: u16, canonical: str) types.Error {
    if (count == 0) {
        ret shared.error(types.NO_NAME, 0);
    }
    if (count > limits.max_endpoints) {
        ret shared.error(types.OVERLOADED, 0);
    }
    val err_allocated: err[types.Error] = shared.allocate_endpoints(output, count);
    if (sel err_allocated.err) { ret err_allocated.err; }
    var i: usize = 0;
    for (i < count) {
        # the capacity is the count, so the only refusal is a duplicate, which stores nothing
        shared.append_unique(output, ip.Endpoint{addr: addrs[i], port: port, scope: 0});
        i = i + 1;
    }
    val canonical_failure: types.Error = set_canonical_checked(query, limits, output, canonical);
    if (canonical_failure.kind != types.NO_ERROR) {
        shared.dnit(output);
        ret canonical_failure;
    }
    ret shared.error(types.NO_ERROR, 0);
}

fun fixed_pair(want_v4: bool, want_v6: bool, v4: ip.IPv4, v6: ip.IPv6, addrs: *ip.Addr) usize {
    var count: usize = 0;
    if (want_v6) {
        addrs[count] = ip.addr_v6(v6);
        count        = count + 1;
    }
    if (want_v4) {
        addrs[count] = ip.addr_v4(v4);
        count        = count + 1;
    }
    ret count;
}

fun outcome_error(outcome: lookup.Outcome) types.Error {
    if (sel outcome.no_name)   { ret shared.error(types.NO_NAME, 0); }
    if (sel outcome.temporary) { ret shared.error(types.TEMPORARY, 0); }
    if (sel outcome.ended)     { ret shared.ended(outcome.ended); }
    ret shared.error(types.SYSTEM_FAILURE, 0);
}

# the adapter body with an injected resolver policy, split out so tests can
# aim the lookup at a deterministic local nameserver
pub fun resolve_with_config(scope: *cancel.Scope, query: *types.Query, owner: *allocator.Allocator,
    limits: types.ResultLimits, output: *types.Resolution, config: *conf.Config) types.Error {
    if (query == nil || owner == nil || output == nil) { ret shared.error(types.INVALID, 0); }
    shared.clear(output, owner);
    val why: cancel.Reason = shared.scope_reason(scope);
    if (!sel why.active) { ret shared.ended(why); }

    val res_service: res[u16, types.Error] = service_port(query);
    if (sel res_service.err) { ret res_service.err; }
    val port:    u16  = res_service.ok;
    val want_v4: bool = query.family != types.IPV6_ONLY;
    val want_v6: bool = query.family != types.IPV4_ONLY;
    var addrs:   [32]ip.Addr;

    if (query.host == nil) {
        # the engine admits a nil host only for passive queries: wildcards
        val count: usize = fixed_pair(want_v4, want_v6, ip.ipv4_any(), ip.ipv6_any(), ?addrs[0]);
        ret deliver(query, limits, output, ?addrs[0], count, port, nil);
    }

    val res_numeric: res[ip.Addr, ip.ParseError] = ip.addr_parse(query.host);
    if (sel res_numeric.ok) {
        val addr: ip.Addr = res_numeric.ok;
        if ((addr.is_v6 != 0 && !want_v6) || (addr.is_v6 == 0 && !want_v4)) {
            ret shared.error(types.NO_NAME, 0);
        }
        addrs[0] = addr;
        ret deliver(query, limits, output, ?addrs[0], 1, port, query.host);
    }
    if ((query.flags & types.NUMERIC_HOST) != 0) { ret shared.error(types.NO_NAME, 0); }

    if (shared.is_localhost(query.host)) {
        val count: usize = fixed_pair(want_v4, want_v6, ip.ipv4_loopback(), ip.ipv6_loopback(), ?addrs[0]);
        ret deliver(query, limits, output, ?addrs[0], count, port, query.host);
    }

    var canonical: [254]u8;
    canonical[0] = 0;
    var hosts_lookup: hosts.Lookup = hosts.Lookup{
        hostname:           query.host,
        want_v4:            want_v4,
        want_v6:            want_v6,
        addrs:              ?addrs[0],
        capacity:           32,
        count:              0,
        canonical:          ?canonical[0],
        canonical_capacity: 254,
    };
    val res_collected: res[usize, io_error.Error] = hosts.collect(?hosts_lookup);
    if (sel res_collected.err) { ret shared.error(types.SYSTEM_FAILURE, res_collected.err.code); }
    val hosts_count: usize = res_collected.ok;
    if (hosts_count != 0) {
        order.sort(?addrs[0], hosts_count);
        var name: str = query.host;
        if (canonical[0] != 0) { name = ?canonical[0]; }
        ret deliver(query, limits, output, ?addrs[0], hosts_count, port, name);
    }

    var answer:  lookup.Answer;
    val outcome: lookup.Outcome = lookup.resolve_name(config, scope, query.host, want_v4, want_v6, ?answer);
    if (!sel outcome.found) { ret outcome_error(outcome); }
    order.sort(?answer.addrs[0], answer.count);
    var name: str = query.host;
    if (answer.canonical_length != 0) { name = ?answer.canonical[0]; }
    ret deliver(query, limits, output, ?answer.addrs[0], answer.count, port, name);
}

# resolve a query with the policy loaded from /etc/resolv.conf
# ---
# scope:  bounds and cancels the lookup
# query:  what to resolve
# owner:  the allocator the result's storage comes from
# limits: caps on the result
# output: the resolution to fill, owned by the caller and released with
#         shared.dnit
# ret:    kind NO_ERROR on success, SYSTEM_FAILURE when resolv.conf cannot be
#         read, or the lookup's failure
pub fun resolve(scope: *cancel.Scope, query: *types.Query, owner: *allocator.Allocator, limits: types.ResultLimits,
    output: *types.Resolution) types.Error {
    var config:     conf.Config;
    val err_loaded: err[io_error.Error] = conf.load(?config);
    if (sel err_loaded.err) { ret shared.error(types.SYSTEM_FAILURE, err_loaded.err.code); }
    ret resolve_with_config(scope, query, owner, limits, output, ?config);
}

# test predicate: `sel` takes a place, so an inline call is tested through this
#[testing]
fun released(output: *types.Resolution) bool {
    val err_destroy: err[types.Error] = shared.dnit(output);
    ret sel err_destroy.ok;
}

#[testing]
fun query_of(host: str, service: str, family: types.Family, flags: u32) types.Query {
    ret types.Query{
        host:        host,
        service:     service,
        family:      family,
        socket_kind: types.ANY_SOCKET,
        protocol:    0,
        flags:       flags,
    };
}

#[testing]
fun limits() types.ResultLimits {
    ret types.ResultLimits{max_endpoints: 8, max_canonical_name_bytes: 256};
}

# localhost resolves to both loopbacks with its canonical name when asked, and
# a family filter narrows the answer
test resolve_linux__localhost_resolves_to_both_loopbacks_with_canonical {
    var owner: allocator.Allocator;
    page.make(?owner);
    var config: conf.Config;
    conf.defaults(?config);
    var scope: cancel.Scope;
    cancel.make_root(?scope, opt[time.Instant].none{});
    var output:  types.Resolution;
    var query:   types.Query = query_of("localhost", "443", types.ANY_FAMILY, types.CANONICAL_NAME);
    val failure: types.Error = resolve_with_config(?scope, ?query, ?owner, limits(), ?output, ?config);
    if (failure.kind != types.NO_ERROR)                                                        { ret 1; }
    if (output.len != 2)                                                                       { ret 1; }
    if (output.endpoints[0].addr.is_v6 == 0 || !ip.addr_is_loopback(output.endpoints[0].addr)) { ret 1; }
    if (output.endpoints[1].addr.is_v6 != 0 || !ip.addr_is_loopback(output.endpoints[1].addr)) { ret 1; }
    if (output.endpoints[0].port != 443 || output.endpoints[1].port != 443)                    { ret 1; }
    if (output.canonical_name == nil || output.canonical_name[0] != 'l')                       { ret 1; }
    if (!released(?output))                                                                    { ret 1; }
    # a family filter narrows a subdomain of localhost, with no canonical name unasked
    var narrowed:         types.Resolution;
    var ipv4_query:       types.Query = query_of("web.localhost", nil, types.IPV4_ONLY, 0);
    val narrowed_failure: types.Error = resolve_with_config(?scope, ?ipv4_query, ?owner, limits(), ?narrowed, ?config);
    if (narrowed_failure.kind != types.NO_ERROR)                                                 { ret 2; }
    if (narrowed.len != 1)                                                                       { ret 2; }
    if (narrowed.endpoints[0].addr.is_v6 != 0 || narrowed.endpoints[0].addr.v4.octets[0] != 127) { ret 2; }
    if (narrowed.canonical_name != nil)                                                          { ret 2; }
    if (!released(?narrowed))                                                                    { ret 2; }
    ret 0;
}

test resolve_linux__passive_nil_host_yields_wildcards {
    var owner: allocator.Allocator;
    page.make(?owner);
    var config: conf.Config;
    conf.defaults(?config);
    var scope: cancel.Scope;
    cancel.make_root(?scope, opt[time.Instant].none{});
    var output:  types.Resolution;
    var query:   types.Query = query_of(nil, "8080", types.ANY_FAMILY, types.PASSIVE);
    val failure: types.Error = resolve_with_config(?scope, ?query, ?owner, limits(), ?output, ?config);
    if (failure.kind != types.NO_ERROR)                    { ret 1; }
    if (output.len != 2)                                   { ret 1; }
    if (!ip.addr_is_unspecified(output.endpoints[0].addr)) { ret 1; }
    if (!ip.addr_is_unspecified(output.endpoints[1].addr)) { ret 1; }
    if (output.endpoints[0].port != 8080)                  { ret 1; }
    if (!released(?output))                                { ret 1; }
    ret 0;
}

test resolve_linux__family_or_service_mismatch_is_a_name_miss {
    var owner: allocator.Allocator;
    page.make(?owner);
    var config: conf.Config;
    conf.defaults(?config);
    var scope: cancel.Scope;
    cancel.make_root(?scope, opt[time.Instant].none{});
    var output:  types.Resolution;
    var query:   types.Query = query_of("192.0.2.1", nil, types.IPV6_ONLY, 0);
    val failure: types.Error = resolve_with_config(?scope, ?query, ?owner, limits(), ?output, ?config);
    if (failure.kind != types.NO_NAME) { ret 1; }
    query = query_of("localhost", "no-such-service-name", types.ANY_FAMILY, types.NUMERIC_SERVICE);
    val service: types.Error = resolve_with_config(?scope, ?query, ?owner, limits(), ?output, ?config);
    if (service.kind != types.NO_NAME) { ret 2; }
    ret 0;
}
