# linux libc system resolver adapter

$if ($mach.build.os != $mach.os.linux) {
    $error("std.net.resolve.linux: requires linux target");
}

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.allocator;
use std.system.os;
use std.net.ip;
use std.net.resolve.types;
use std.net.resolve.shared;

rec AddrInfo {
    flags: i32;
    family: i32;
    socket_kind: i32;
    protocol: i32;
    address_length: u32;
    address: *u8;
    canonical_name: *u8;
    next: *AddrInfo;
}

val AI_PASSIVE: i32 = 0x0001;
val AI_CANONNAME: i32 = 0x0002;
val AI_NUMERICHOST: i32 = 0x0004;
val AI_NUMERICSERV: i32 = 0x0400;

val EAI_NONAME: i32 = -2;
val EAI_AGAIN: i32 = -3;
val EAI_FAIL: i32 = -4;
val EAI_FAMILY: i32 = -6;
val EAI_SOCKTYPE: i32 = -7;
val EAI_SERVICE: i32 = -8;
val EAI_MEMORY: i32 = -10;
val EAI_SYSTEM: i32 = -11;
val EAI_OVERFLOW: i32 = -12;
val EAI_BADFLAGS: i32 = -1;

#[library("libc")]
ext fun getaddrinfo(node: *u8, service: *u8, hints: *AddrInfo, output: **AddrInfo) i32;

#[library("libc")]
ext fun freeaddrinfo(value: *AddrInfo);

fun failure(code: i32) types.Error {
    if (code == EAI_NONAME) { ret shared.error(types.NO_NAME, code::i64); }
    if (code == EAI_AGAIN) { ret shared.error(types.TEMPORARY, code::i64); }
    if (code == EAI_MEMORY) { ret shared.error(types.OUT_OF_MEMORY, code::i64); }
    if (code == EAI_FAIL || code == EAI_OVERFLOW) { ret shared.error(types.MALFORMED, code::i64); }
    if (code == EAI_BADFLAGS || code == EAI_FAMILY || code == EAI_SOCKTYPE) { ret shared.error(types.INVALID, code::i64); }
    if (code == EAI_SERVICE) { ret shared.error(types.NO_NAME, code::i64); }
    if (code == EAI_SYSTEM) { ret shared.error(types.SYSTEM_FAILURE, code::i64); }
    ret shared.error(types.SYSTEM_FAILURE, code::i64);
}

fun family(query: *types.Query) i32 {
    if (query.family == types.IPV4_ONLY) { ret os.AF_INET; }
    if (query.family == types.IPV6_ONLY) { ret os.AF_INET6; }
    ret 0;
}

fun socket_kind(query: *types.Query) i32 {
    if (query.socket_kind == types.STREAM_SOCKET) { ret os.SOCK_STREAM; }
    if (query.socket_kind == types.DATAGRAM_SOCKET) { ret os.SOCK_DGRAM; }
    ret 0;
}

fun flags(query: *types.Query) i32 {
    var output: i32 = 0;
    if ((query.flags & types.PASSIVE) != 0) { output = output | AI_PASSIVE; }
    if ((query.flags & types.CANONICAL_NAME) != 0) { output = output | AI_CANONNAME; }
    if ((query.flags & types.NUMERIC_HOST) != 0) { output = output | AI_NUMERICHOST; }
    if ((query.flags & types.NUMERIC_SERVICE) != 0) { output = output | AI_NUMERICSERV; }
    ret output;
}

pub fun resolve(query: *types.Query, owner: *allocator.Allocator, limits: types.ResultLimits, output: *types.Resolution) types.Error {
    if (query == nil || owner == nil || output == nil) { ret shared.error(types.INVALID, os.EINVAL); }
    shared.clear(output, owner);
    var hints: AddrInfo;
    hints.flags = flags(query);
    hints.family = family(query);
    hints.socket_kind = socket_kind(query);
    hints.protocol = query.protocol;
    hints.address_length = 0;
    hints.address = nil;
    hints.canonical_name = nil;
    hints.next = nil;
    var first: *AddrInfo = nil;
    val code: i32 = getaddrinfo(query.host, query.service, ?hints, ?first);
    if (code != 0) { ret failure(code); }
    if (first == nil) { ret shared.error(types.NO_NAME, EAI_NONAME::i64); }

    var count: usize = 0;
    var current: *AddrInfo = first;
    for (current != nil) {
        if (count == limits.max_endpoints) { freeaddrinfo(first); ret shared.error(types.OVERLOADED, 0); }
        count = count + 1;
        current = current.next;
    }
    if (!shared.allocate_endpoints(output, count)) {
        freeaddrinfo(first);
        ret shared.error(types.OUT_OF_MEMORY, os.ENOMEM);
    }

    current = first;
    var malformed: bool = false;
    for (current != nil) {
        if ((current.family == os.AF_INET || current.family == os.AF_INET6)
         && current.address != nil) {
            var endpoint: ip.Endpoint;
            if (!ip.from_sockaddr(current.address, ?endpoint)
             || !shared.append_unique(output, endpoint)) { malformed = true; }
        }
        if (output.canonical_name == nil && current.canonical_name != nil
         && !shared.canonical_fits(current.canonical_name, limits.max_canonical_name_bytes)) {
            freeaddrinfo(first);
            shared.destroy(output);
            ret shared.error(types.OVERLOADED, 0);
        }
        if (output.canonical_name == nil && current.canonical_name != nil
         && !shared.set_canonical(output, current.canonical_name)) {
            freeaddrinfo(first);
            shared.destroy(output);
            ret shared.error(types.OUT_OF_MEMORY, os.ENOMEM);
        }
        current = current.next;
    }
    freeaddrinfo(first);
    if (output.len == 0) {
        shared.destroy(output);
        if (malformed) { ret shared.error(types.MALFORMED, EAI_FAIL::i64); }
        ret shared.error(types.NO_NAME, EAI_NONAME::i64);
    }
    ret shared.error(types.NO_ERROR, 0);
}
