# RFC 6724 destination address ordering

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.system.os;
use std.net.ip;
use std.net.udp;
use io_error: std.io.error;

val MAX_SORT: usize = 32;

val SCOPE_LINK:   u8 = 0x2;
val SCOPE_SITE:   u8 = 0x5;
val SCOPE_GLOBAL: u8 = 0xE;

rec Candidate {
    addr: ip.Addr;
    reachable: bool;
    source: ip.Addr;
}

# the address as sixteen policy octets: IPv4 maps to ::ffff:a.b.c.d
fun policy_octets(addr: ip.Addr, output: *u8) {
    var i: usize = 0;
    if (addr.is_v6 != 0) {
        for (i < 16) { output[i] = addr.v6.octets[i]; i = i + 1; }
        ret;
    }
    for (i < 10) { output[i] = 0; i = i + 1; }
    output[10] = 0xFF;
    output[11] = 0xFF;
    output[12] = addr.v4.octets[0];
    output[13] = addr.v4.octets[1];
    output[14] = addr.v4.octets[2];
    output[15] = addr.v4.octets[3];
}

fun prefix_matches(octets: *u8, prefix: *u8, bits: usize) bool {
    var full: usize = bits / 8;
    var i: usize = 0;
    for (i < full) {
        if (octets[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    val remainder: usize = bits % 8;
    if (remainder == 0) { ret true; }
    val mask: u8 = (0xFF00 >> remainder)::u8;
    ret (octets[full] & mask) == (prefix[full] & mask);
}

# the RFC 6724 default policy table, longest prefix match
fun policy(addr: ip.Addr, precedence: *u8, label: *u8) {
    var octets: [16]u8;
    policy_octets(addr, ?octets[0]);

    var loopback: [16]u8;
    var i: usize = 0;
    for (i < 16) { loopback[i] = 0; i = i + 1; }
    loopback[15] = 1;
    if (prefix_matches(?octets[0], ?loopback[0], 128)) { @precedence = 50; @label = 0; ret; }

    var mapped: [16]u8;
    i = 0;
    for (i < 16) { mapped[i] = 0; i = i + 1; }
    mapped[10] = 0xFF;
    mapped[11] = 0xFF;
    if (prefix_matches(?octets[0], ?mapped[0], 96)) { @precedence = 35; @label = 4; ret; }

    var zero: [16]u8;
    i = 0;
    for (i < 16) { zero[i] = 0; i = i + 1; }
    if (prefix_matches(?octets[0], ?zero[0], 96)) { @precedence = 1; @label = 3; ret; }

    if (octets[0] == 0x20 && octets[1] == 0x02) { @precedence = 30; @label = 2; ret; }
    if (octets[0] == 0x20 && octets[1] == 0x01 && octets[2] == 0 && octets[3] == 0) { @precedence = 5; @label = 5; ret; }
    if ((octets[0] & 0xFE) == 0xFC) { @precedence = 3; @label = 13; ret; }
    if (octets[0] == 0xFE && (octets[1] & 0xC0) == 0xC0) { @precedence = 1; @label = 11; ret; }
    if (octets[0] == 0x3F && octets[1] == 0xFE) { @precedence = 1; @label = 12; ret; }
    @precedence = 40;
    @label = 1;
}

fun scope_of(addr: ip.Addr) u8 {
    if (addr.is_v6 == 0) {
        if (addr.v4.octets[0] == 127) { ret SCOPE_LINK; }
        if (addr.v4.octets[0] == 169 && addr.v4.octets[1] == 254) { ret SCOPE_LINK; }
        ret SCOPE_GLOBAL;
    }
    if (addr.v6.octets[0] == 0xFF) { ret addr.v6.octets[1] & 0x0F; }
    if (addr.v6.octets[0] == 0xFE && (addr.v6.octets[1] & 0xC0) == 0x80) { ret SCOPE_LINK; }
    if (addr.v6.octets[0] == 0xFE && (addr.v6.octets[1] & 0xC0) == 0xC0) { ret SCOPE_SITE; }
    if (ip.addr_is_loopback(addr)) { ret SCOPE_LINK; }
    ret SCOPE_GLOBAL;
}

fun common_prefix(a: ip.Addr, b: ip.Addr) usize {
    var left: [16]u8;
    var right: [16]u8;
    policy_octets(a, ?left[0]);
    policy_octets(b, ?right[0]);
    # rule 9 considers at most the first 64 bits
    var bits: usize = 0;
    var i: usize = 0;
    for (i < 8) {
        val difference: u8 = left[i] ^ right[i];
        if (difference == 0) {
            bits = bits + 8;
            i = i + 1;
            cnt;
        }
        var mask: u8 = 0x80;
        for ((difference & mask) == 0) {
            bits = bits + 1;
            mask = mask >> 1;
        }
        brk;
    }
    ret bits;
}

# discover the source address the kernel would pick for a destination; a
# connected UDP socket routes without sending a packet
fun probe(addr: ip.Addr, candidate: *Candidate) {
    candidate.addr = addr;
    candidate.reachable = false;
    var created: Result[udp.Socket, io_error.Error];
    if (addr.is_v6 != 0) {
        created = udp.create_v6();
    } or {
        created = udp.create();
    }
    if (is_err[udp.Socket, io_error.Error](created)) { ret; }
    var socket: udp.Socket = unwrap_ok[udp.Socket, io_error.Error](created);
    val endpoint: ip.Endpoint = ip.Endpoint{addr: addr, port: 53, scope: 0};
    var sockaddr: [128]u8;
    val sockaddr_length: usize = ip.to_sockaddr(endpoint, ?sockaddr[0]);
    if (os.sock_connect(socket.handle.value, ?sockaddr[0], sockaddr_length) >= 0) {
        val local: Result[ip.Endpoint, io_error.Error] = udp.local_endpoint(?socket);
        if (!is_err[ip.Endpoint, io_error.Error](local)) {
            candidate.source = unwrap_ok[ip.Endpoint, io_error.Error](local).addr;
            candidate.reachable = true;
        }
    }
    udp.socket_close(?socket);
}

# true when a is a strictly better destination than b
fun better(a: *Candidate, b: *Candidate) bool {
    if (a.reachable != b.reachable) { ret a.reachable; }
    if (!a.reachable) { ret false; }

    val a_scope: u8 = scope_of(a.addr);
    val b_scope: u8 = scope_of(b.addr);
    val a_scope_match: bool = a_scope == scope_of(a.source);
    val b_scope_match: bool = b_scope == scope_of(b.source);
    if (a_scope_match != b_scope_match) { ret a_scope_match; }

    var a_precedence: u8 = 0;
    var a_label: u8 = 0;
    var b_precedence: u8 = 0;
    var b_label: u8 = 0;
    var a_source_label: u8 = 0;
    var b_source_label: u8 = 0;
    var ignored: u8 = 0;
    policy(a.addr, ?a_precedence, ?a_label);
    policy(b.addr, ?b_precedence, ?b_label);
    policy(a.source, ?ignored, ?a_source_label);
    policy(b.source, ?ignored, ?b_source_label);
    val a_label_match: bool = a_label == a_source_label;
    val b_label_match: bool = b_label == b_source_label;
    if (a_label_match != b_label_match) { ret a_label_match; }

    if (a_precedence != b_precedence) { ret a_precedence > b_precedence; }

    if (a_scope != b_scope) { ret a_scope < b_scope; }

    val a_prefix: usize = common_prefix(a.addr, a.source);
    val b_prefix: usize = common_prefix(b.addr, b.source);
    if (a.addr.is_v6 == b.addr.is_v6 && a_prefix != b_prefix) { ret a_prefix > b_prefix; }

    ret false;
}

# stable in-place ordering of resolved destinations per RFC 6724; a set
# larger than MAX_SORT keeps its resolver order
pub fun sort(addrs: *ip.Addr, count: usize) {
    if (count < 2 || count > MAX_SORT) { ret; }
    var candidates: [32]Candidate;
    var i: usize = 0;
    for (i < count) {
        probe(addrs[i], ?candidates[i]);
        i = i + 1;
    }
    i = 1;
    for (i < count) {
        val current: Candidate = candidates[i];
        var j: usize = i;
        for (j > 0 && better(?candidates[i], ?candidates[j - 1])) { j = j - 1; }
        if (j != i) {
            var k: usize = i;
            for (k > j) {
                candidates[k] = candidates[k - 1];
                k = k - 1;
            }
            candidates[j] = current;
        }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        addrs[i] = candidates[i].addr;
        i = i + 1;
    }
}

test "resolve.order: policy table precedence" {
    var precedence: u8 = 0;
    var label: u8 = 0;
    policy(ip.addr_v6(ip.ipv6_loopback()), ?precedence, ?label);
    if (precedence != 50 || label != 0) { ret 1; }
    policy(ip.addr_v4(ip.ipv4(192, 0, 2, 1)), ?precedence, ?label);
    if (precedence != 35 || label != 4) { ret 1; }
    var global: ip.IPv6;
    var i: usize = 0;
    for (i < 16) { global.octets[i] = 0; i = i + 1; }
    global.octets[0] = 0x20;
    global.octets[1] = 0x01;
    global.octets[2] = 0x0D;
    global.octets[3] = 0xB8;
    policy(ip.addr_v6(global), ?precedence, ?label);
    if (precedence != 40 || label != 1) { ret 1; }
    var unique_local: ip.IPv6 = global;
    unique_local.octets[0] = 0xFD;
    unique_local.octets[1] = 0;
    policy(ip.addr_v6(unique_local), ?precedence, ?label);
    if (precedence != 3 || label != 13) { ret 1; }
    ret 0;
}

test "resolve.order: scope classification" {
    if (scope_of(ip.addr_v4(ip.ipv4_loopback())) != SCOPE_LINK) { ret 1; }
    if (scope_of(ip.addr_v4(ip.ipv4(192, 0, 2, 1))) != SCOPE_GLOBAL) { ret 1; }
    if (scope_of(ip.addr_v4(ip.ipv4(169, 254, 0, 5))) != SCOPE_LINK) { ret 1; }
    if (scope_of(ip.addr_v6(ip.ipv6_loopback())) != SCOPE_LINK) { ret 1; }
    var link_local: ip.IPv6;
    var i: usize = 0;
    for (i < 16) { link_local.octets[i] = 0; i = i + 1; }
    link_local.octets[0] = 0xFE;
    link_local.octets[1] = 0x80;
    link_local.octets[15] = 1;
    if (scope_of(ip.addr_v6(link_local)) != SCOPE_LINK) { ret 1; }
    ret 0;
}

test "resolve.order: common prefix caps at 64 bits" {
    var a: ip.IPv6;
    var b: ip.IPv6;
    var i: usize = 0;
    for (i < 16) { a.octets[i] = 0xAA; b.octets[i] = 0xAA; i = i + 1; }
    if (common_prefix(ip.addr_v6(a), ip.addr_v6(b)) != 64) { ret 1; }
    b.octets[0] = 0xAB;
    if (common_prefix(ip.addr_v6(a), ip.addr_v6(b)) != 7) { ret 1; }
    b.octets[0] = 0xAA;
    b.octets[7] = 0xAB;
    if (common_prefix(ip.addr_v6(a), ip.addr_v6(b)) != 63) { ret 1; }
    ret 0;
}

test "resolve.order: loopback destinations sort reachable and stable" {
    var addrs: [3]ip.Addr;
    addrs[0] = ip.addr_v4(ip.ipv4(127, 0, 0, 2));
    addrs[1] = ip.addr_v4(ip.ipv4_loopback());
    addrs[2] = ip.addr_v4(ip.ipv4(127, 0, 0, 3));
    sort(?addrs[0], 3);
    # all three probe identically, so resolver order must be preserved
    if (addrs[0].v4.octets[3] != 2 || addrs[1].v4.octets[3] != 1 || addrs[2].v4.octets[3] != 3) { ret 1; }
    ret 0;
}
