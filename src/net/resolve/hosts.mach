# hosts-file name lookup

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.system.os;
use std.net.ip;
use std.net.resolve.lines;
use io_error: std.io.error;

# one in-progress hosts lookup accumulating matches in file order
# ---
# hostname:           name to match, case-insensitively
# want_v4, want_v6:   family filter applied while collecting
# addrs:              caller storage for matched addresses
# capacity:           slots in addrs
# count:              matches written so far
# canonical:          first name of the first matching line, nul-terminated;
#                     empty until a line matches. nil to skip collection
# canonical_capacity: bytes available at canonical
pub rec Lookup {
    hostname: str;
    want_v4: bool;
    want_v6: bool;
    addrs: *ip.Addr;
    capacity: usize;
    count: usize;
    canonical: *u8;
    canonical_capacity: usize;
}

fun blank(byte: u8) bool {
    ret byte == ' ' || byte == 9;
}

fun token_end(line: *u8, position: usize) usize {
    var i: usize = position;
    for (line[i] != 0 && !blank(line[i]) && line[i] != '#') { i = i + 1; }
    ret i;
}

fun skip_blanks(line: *u8, position: usize) usize {
    var i: usize = position;
    for (line[i] != 0 && blank(line[i])) { i = i + 1; }
    ret i;
}

fun lower(byte: u8) u8 {
    if (byte >= 'A' && byte <= 'Z') { ret byte + 32; }
    ret byte;
}

fun name_matches(line: *u8, start: usize, end: usize, hostname: str) bool {
    val length: usize = str_len(hostname);
    if (end - start != length) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (lower(line[start + i]) != lower(hostname[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun record_canonical(lookup: *Lookup, line: *u8, start: usize, end: usize) {
    if (lookup.canonical == nil || lookup.canonical[0] != 0) { ret; }
    val length: usize = end - start;
    if (length + 1 > lookup.canonical_capacity) { ret; }
    var i: usize = 0;
    for (i < length) { lookup.canonical[i] = line[start + i]; i = i + 1; }
    lookup.canonical[length] = 0;
}

# fold one hosts line into the lookup
pub fun scan_line(lookup: *Lookup, line: *u8) {
    val address_start: usize = skip_blanks(line, 0);
    if (line[address_start] == 0 || line[address_start] == '#') { ret; }
    val address_end: usize = token_end(line, address_start);
    if (address_end == address_start || address_end - address_start >= 64) { ret; }

    var matched: bool = false;
    var first_name_start: usize = 0;
    var first_name_end: usize = 0;
    var position: usize = skip_blanks(line, address_end);
    for (line[position] != 0 && line[position] != '#') {
        val end: usize = token_end(line, position);
        if (end == position) { brk; }
        if (first_name_end == 0) {
            first_name_start = position;
            first_name_end = end;
        }
        if (name_matches(line, position, end, lookup.hostname)) { matched = true; }
        position = skip_blanks(line, end);
    }
    if (!matched) { ret; }

    var text: [64]u8;
    var i: usize = 0;
    for (i < address_end - address_start) {
        text[i] = line[address_start + i];
        i = i + 1;
    }
    text[i] = 0;
    val parsed: res[ip.Addr, ip.ParseError] = ip.addr_parse(?text[0]);
    if (sel parsed.err) { ret; }
    val addr: ip.Addr = parsed.ok;
    if (addr.is_v6 == 0 && !lookup.want_v4) { ret; }
    if (addr.is_v6 != 0 && !lookup.want_v6) { ret; }

    record_canonical(lookup, line, first_name_start, first_name_end);
    if (lookup.count < lookup.capacity) {
        lookup.addrs[lookup.count] = addr;
        lookup.count = lookup.count + 1;
    }
}

# collect every hosts-file address for the lookup's hostname, in file order
#
# a missing hosts file is zero matches; a file that cannot be opened, read or
# closed is the failure, with the matches collected before it kept in
# lookup.addrs
# ---
# ret: number of addresses written to lookup.addrs, or the failure
pub fun collect(lookup: *Lookup) res[usize, io_error.Error] {
    lookup.count = 0;
    if (lookup.canonical != nil && lookup.canonical_capacity != 0) { lookup.canonical[0] = 0; }
    var reader: lines.Reader;
    val opened: err[io_error.Error] = lines.open(?reader, os.DNS_HOSTS_PATH);
    if (sel opened.err) {
        if (opened.err.code == os.ENOENT) { ret res[usize, io_error.Error].ok{0}; }
        ret res[usize, io_error.Error].err{opened.err};
    }
    var line: [512]u8;
    for (true) {
        val next: res[opt[usize], io_error.Error] = lines.next(?reader, ?line[0], 512);
        if (sel next.err) {
            lines.close(?reader);
            ret res[usize, io_error.Error].err{next.err};
        }
        if (sel next.ok.none) { brk; }
        if (next.ok.some < 512) { scan_line(lookup, ?line[0]); }
    }
    val closed: err[io_error.Error] = lines.close(?reader);
    if (sel closed.err) { ret res[usize, io_error.Error].err{closed.err}; }
    ret res[usize, io_error.Error].ok{lookup.count};
}

fun test_lookup(hostname: str, addrs: *ip.Addr, capacity: usize, canonical: *u8, canonical_capacity: usize) Lookup {
    ret Lookup{
        hostname: hostname,
        want_v4: true,
        want_v6: true,
        addrs: addrs,
        capacity: capacity,
        count: 0,
        canonical: canonical,
        canonical_capacity: canonical_capacity,
    };
}

test "resolve.hosts: matches aliases case-insensitively with canonical" {
    var addrs: [4]ip.Addr;
    var canonical: [64]u8;
    canonical[0] = 0;
    var lookup: Lookup = test_lookup("WEB.example", ?addrs[0], 4, ?canonical[0], 64);
    scan_line(?lookup, "192.0.2.1   canon.example web.example  # trailing");
    scan_line(?lookup, "2001:db8::1 canon.example web.example");
    scan_line(?lookup, "192.0.2.9   other.example");
    if (lookup.count != 2) { ret 1; }
    if (addrs[0].is_v6 != 0 || addrs[0].v4.octets[3] != 1) { ret 1; }
    if (addrs[1].is_v6 == 0 || addrs[1].v6.octets[15] != 1) { ret 1; }
    if (canonical[0] != 'c' || canonical[5] != '.') { ret 1; }
    ret 0;
}

test "resolve.hosts: skips comments, blanks, and malformed addresses" {
    var addrs: [4]ip.Addr;
    var lookup: Lookup = test_lookup("web.example", ?addrs[0], 4, nil, 0);
    scan_line(?lookup, "# 192.0.2.1 web.example");
    scan_line(?lookup, "    ");
    scan_line(?lookup, "not-an-address web.example");
    scan_line(?lookup, "192.0.2.5 # web.example");
    if (lookup.count != 0) { ret 1; }
    ret 0;
}

test "resolve.hosts: family filter drops mismatched records" {
    var addrs: [4]ip.Addr;
    var lookup: Lookup = test_lookup("web.example", ?addrs[0], 4, nil, 0);
    lookup.want_v6 = false;
    scan_line(?lookup, "2001:db8::1 web.example");
    scan_line(?lookup, "192.0.2.1 web.example");
    if (lookup.count != 1 || addrs[0].is_v6 != 0) { ret 1; }
    ret 0;
}
