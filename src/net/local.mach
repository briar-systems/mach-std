# portable local byte-stream descriptors and endpoint ownership

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.size.isize;
use std.types.string.str;
use std.types.canonical.res;
use std.types.canonical.err;
use std.system.os;
use std.io.lifecycle;
use std.net.local.endpoint;
use std.net.local.types;
use io_error: std.io.error;

$if ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}
$if ($mach.build.os == $mach.os.linux) {
    use linux: std.system.os.linux;
}

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    use impl: std.net.local.unix;
}
$or ($mach.build.os == $mach.os.windows) {
    use impl: std.net.local.windows;
}
$or {
    $error("std.net.local: unsupported target");
}

fwd endpoint.Kind;
fwd endpoint.Endpoint;
fwd endpoint.Capabilities;
fwd endpoint.FILESYSTEM;
fwd endpoint.ABSTRACT;
fwd endpoint.TARGET;
fwd types.Ownership;
fwd types.BORROWED;
fwd types.OWNED;
fwd types.StalePolicy;
fwd types.REJECT_STALE;
fwd types.REMOVE_STALE_SOCKET;
fwd types.INHERIT_PERMISSIONS;
fwd types.BindOptions;
fwd types.ListenOptions;
fwd types.Listener;
fwd types.Stream;
fwd types.PeerIdentity;

pub fun capabilities() endpoint.Capabilities {
    ret endpoint.capabilities();
}

pub fun filesystem(path: str) res[endpoint.Endpoint, io_error.Error] {
    ret endpoint.filesystem(path);
}

pub fun filesystem_bytes(data: *u8, length: usize) res[endpoint.Endpoint, io_error.Error] {
    ret endpoint.filesystem_bytes(data, length);
}

pub fun abstract(data: *u8, length: usize) res[endpoint.Endpoint, io_error.Error] {
    ret endpoint.abstract(data, length);
}

pub fun target(name: str) res[endpoint.Endpoint, io_error.Error] {
    ret endpoint.target(name);
}

pub fun target_bytes(data: *u8, length: usize) res[endpoint.Endpoint, io_error.Error] {
    ret endpoint.target_bytes(data, length);
}

pub fun default_listen_options() types.ListenOptions {
    ret types.ListenOptions{
        backlog: 128,
        ownership: OWNED,
        stale: REJECT_STALE,
        permissions: INHERIT_PERMISSIONS,
    };
}

pub fun default_bind_options() types.BindOptions {
    ret types.BindOptions{
        ownership: OWNED,
        stale: REJECT_STALE,
        permissions: INHERIT_PERMISSIONS,
    };
}

fun invalid(operation: io_error.Operation) io_error.Error {
    ret io_error.from_code(os.EINVAL, operation);
}

fun valid_bind(bound: endpoint.Endpoint, options: types.BindOptions) bool {
    ret endpoint.supported(bound)
        && (options.ownership == BORROWED || options.ownership == OWNED)
        && (options.stale == REJECT_STALE || options.stale == REMOVE_STALE_SOCKET)
        && (bound.kind == endpoint.FILESYSTEM || options.stale == REJECT_STALE);
}

# filesystem ownership is race-free when the caller controls mutations in the parent directory
pub fun bind(bound: endpoint.Endpoint, options: types.BindOptions) res[types.Listener, io_error.Error] {
    if (!valid_bind(bound, options)) {
        ret res[types.Listener, io_error.Error].err{invalid(io_error.OP_BIND)};
    }
    var listener: types.Listener;
    listener.handle = (-1)::isize::usize;
    listener.endpoint = bound;
    listener.ownership = options.ownership;
    listener.node_device = 0;
    listener.node_file = 0;
    listener.has_node_identity = false;
    val code: i64 = impl.bind(?listener, bound, options);
    if (code < 0) {
        ret res[types.Listener, io_error.Error].err{io_error.from_code(code, io_error.OP_BIND)};
    }
    ret res[types.Listener, io_error.Error].ok{listener};
}

pub fun listener_start(listener: *types.Listener, backlog: i32) err[io_error.Error] {
    if (listener == nil || listener.handle == (-1)::isize::usize || backlog <= 0) {
        ret err[io_error.Error].err{invalid(io_error.OP_LISTEN)};
    }
    val code: i64 = impl.start_listener(listener, backlog);
    if (code < 0) { ret err[io_error.Error].err{io_error.from_code(code, io_error.OP_LISTEN)}; }
    ret err[io_error.Error].ok{};
}

pub fun listen(bound: endpoint.Endpoint, options: types.ListenOptions) res[types.Listener, io_error.Error] {
    if (options.backlog <= 0) {
        ret res[types.Listener, io_error.Error].err{invalid(io_error.OP_LISTEN)};
    }
    val bind_options: types.BindOptions = types.BindOptions{
        ownership: options.ownership,
        stale: options.stale,
        permissions: options.permissions,
    };
    val bound_listener: res[types.Listener, io_error.Error] = bind(bound, bind_options);
    if (sel bound_listener.err) {
        ret res[types.Listener, io_error.Error].err{bound_listener.err};
    }
    var listener: types.Listener = bound_listener.ok;
    val started: err[io_error.Error] = listener_start(?listener, options.backlog);
    if (sel started.err) {
        listener.ownership = OWNED;
        listener_close(?listener);
        ret res[types.Listener, io_error.Error].err{started.err};
    }
    ret res[types.Listener, io_error.Error].ok{listener};
}

pub fun connect(remote: endpoint.Endpoint) res[types.Stream, io_error.Error] {
    if (!endpoint.supported(remote)) {
        ret res[types.Stream, io_error.Error].err{invalid(io_error.OP_CONNECT)};
    }
    var stream: types.Stream;
    stream.handle = (-1)::isize::usize;
    stream.server_side = false;
    val code: i64 = impl.connect(?stream, remote, false);
    if (code < 0) {
        ret res[types.Stream, io_error.Error].err{io_error.from_code(code, io_error.OP_CONNECT)};
    }
    ret res[types.Stream, io_error.Error].ok{stream};
}

pub fun accept(listener: *types.Listener) res[types.Stream, io_error.Error] {
    if (listener == nil || listener.handle == (-1)::isize::usize) {
        ret res[types.Stream, io_error.Error].err{invalid(io_error.OP_ACCEPT)};
    }
    var stream: types.Stream;
    stream.handle = (-1)::isize::usize;
    stream.server_side = true;
    val code: i64 = impl.accept(listener, ?stream, false);
    if (code < 0) {
        ret res[types.Stream, io_error.Error].err{io_error.from_code(code, io_error.OP_ACCEPT)};
    }
    ret res[types.Stream, io_error.Error].ok{stream};
}

# exclusively borrow the stream receive queue and close state, including raw aliases.
# darwin rejects ancillary input without consuming it and leaves the stream owned.
pub fun stream_read(stream: *types.Stream, buffer: *u8, length: usize) res[usize, io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize || (buffer == nil && length != 0)) {
        ret res[usize, io_error.Error].err{invalid(io_error.OP_READ)};
    }
    val count: i64 = impl.read(stream.handle, buffer, length);
    if (count < 0) { ret res[usize, io_error.Error].err{io_error.from_code(count, io_error.OP_READ)}; }
    ret res[usize, io_error.Error].ok{count::usize};
}

pub fun stream_write(stream: *types.Stream, buffer: *u8, length: usize) res[usize, io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize || (buffer == nil && length != 0)) {
        ret res[usize, io_error.Error].err{invalid(io_error.OP_WRITE)};
    }
    val count: i64 = impl.write(stream.handle, buffer, length);
    if (count < 0) { ret res[usize, io_error.Error].err{io_error.from_code(count, io_error.OP_WRITE)}; }
    ret res[usize, io_error.Error].ok{count::usize};
}

pub fun stream_shutdown_write(stream: *types.Stream) err[io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize) {
        ret err[io_error.Error].err{invalid(io_error.OP_SHUTDOWN)};
    }
    val code: i64 = impl.shutdown_write(stream.handle);
    if (code < 0) { ret err[io_error.Error].err{io_error.from_code(code, io_error.OP_SHUTDOWN)}; }
    ret err[io_error.Error].ok{};
}

pub fun peer_identity(stream: *types.Stream) res[types.PeerIdentity, io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize) {
        ret res[types.PeerIdentity, io_error.Error].err{invalid(io_error.OP_OPTION)};
    }
    var identity: types.PeerIdentity;
    identity.has_process = false;
    identity.has_user = false;
    identity.has_group = false;
    val code: i64 = impl.peer_identity(stream.handle, stream.server_side, ?identity);
    if (code < 0) { ret res[types.PeerIdentity, io_error.Error].err{io_error.from_code(code, io_error.OP_OPTION)}; }
    ret res[types.PeerIdentity, io_error.Error].ok{identity};
}

# rename never knowingly replaces an occupied path
# callers must serialize parent directory mutation where atomic no-replace rename is unavailable
pub fun listener_rename(listener: *types.Listener, replacement: endpoint.Endpoint) err[io_error.Error] {
    val target_capabilities: endpoint.Capabilities = endpoint.capabilities();
    if (!target_capabilities.listener_rename) {
        ret err[io_error.Error].err{io_error.from_code(os.ENOTSUP, io_error.OP_OPTION)};
    }
    if (listener == nil
        || listener.handle == (-1)::isize::usize
        || listener.ownership != OWNED
        || listener.endpoint.kind != endpoint.FILESYSTEM
        || replacement.kind != endpoint.FILESYSTEM
        || !endpoint.supported(replacement)) {
        ret err[io_error.Error].err{invalid(io_error.OP_OPTION)};
    }
    val code: i64 = impl.rename(listener, replacement);
    if (code < 0) { ret err[io_error.Error].err{io_error.from_code(code, io_error.OP_OPTION)}; }
    listener.endpoint = replacement;
    ret err[io_error.Error].ok{};
}

pub fun stream_close(stream: *types.Stream, mode: lifecycle.Mode) err[io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize || mode > lifecycle.ABORTIVE) {
        ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    val raw: usize = stream.handle;
    stream.handle = (-1)::isize::usize;
    var shutdown_code: i64 = 0;
    if (mode == lifecycle.GRACEFUL) { shutdown_code = impl.shutdown_write(raw); }
    val code: i64 = impl.close_stream(raw, stream.server_side);
    if (shutdown_code < 0) { ret err[io_error.Error].err{io_error.from_code(shutdown_code, io_error.OP_SHUTDOWN)}; }
    if (code < 0) { ret err[io_error.Error].err{io_error.from_code(code, io_error.OP_CLOSE)}; }
    ret err[io_error.Error].ok{};
}

pub fun listener_close(listener: *types.Listener) err[io_error.Error] {
    if (listener == nil || listener.handle == (-1)::isize::usize) {
        ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    val raw: usize = listener.handle;
    var closing: types.Listener = @listener;
    listener.handle = (-1)::isize::usize;
    closing.handle = raw;
    val code: i64 = impl.close_listener(?closing);
    if (code < 0) { ret err[io_error.Error].err{io_error.from_code(code, io_error.OP_CLOSE)}; }
    ret err[io_error.Error].ok{};
}

# test predicates: `sel` takes a place, so an inline call is tested through these
fun refused(r: err[io_error.Error]) bool { ret sel r.err; }

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    fun test_name(output: *u8, suffix: u8) usize {
        val prefix: str = "/tmp/mach-std-local-502-";
        var length: usize = 0;
        for (prefix[length] != 0) {
            output[length] = prefix[length];
            length = length + 1;
        }
        var process: u64 = os.getpid()::u64;
        var digits: [20]u8;
        var count: usize = 0;
        if (process == 0) {
            digits[0] = '0';
            count = 1;
        }
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process = process / 10;
            count = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            output[length] = digits[count - i - 1];
            length = length + 1;
            i = i + 1;
        }
        output[length] = '-';
        output[length + 1] = suffix;
        output[length + 2] = '.';
        output[length + 3] = 's';
        output[length + 4] = 'o';
        output[length + 5] = 'c';
        output[length + 6] = 'k';
        output[length + 7] = 0;
        ret length + 7;
    }

    fun test_absent(value: endpoint.Endpoint) bool {
        var path: [108]u8;
        var i: usize = 0;
        for (i < value.length) { path[i] = value.name[i]; i = i + 1; }
        path[value.length] = 0;
        var status: os.stat_t;
        ret os.stat_path(os.AT_FDCWD, ?path[0], ?status, os.AT_SYMLINK_NOFOLLOW) == os.ENOENT;
    }

    test "local stream: filesystem lifecycle identity and half close" {
        var path: [108]u8;
        val path_length: usize = test_name(?path[0], 'a');
        val endpoint_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?path[0], path_length);
        if (sel endpoint_result.err) { ret 1; }
        val bound: endpoint.Endpoint = endpoint_result.ok;
        var options: types.ListenOptions = default_listen_options();
        options.backlog = 4;
        options.stale = REMOVE_STALE_SOCKET;
        options.permissions = 0x180;
        val listener_result: res[types.Listener, io_error.Error] = listen(bound, options);
        if (sel listener_result.err) { ret 2; }
        var listener: types.Listener = listener_result.ok;
        var inheritable: bool = true;
        if (os.sock_inheritable(listener.handle, ?inheritable) < 0 || inheritable) { ret 3; }
        var status: os.stat_t;
        if (os.stat_path(os.AT_FDCWD, ?path[0], ?status, os.AT_SYMLINK_NOFOLLOW) < 0
            || (os.stat_mode(?status) & 0x01ff) != 0x180) {
            ret 4;
        }

        val client_result: res[types.Stream, io_error.Error] = connect(bound);
        if (sel client_result.err) { ret 5; }
        var client: types.Stream = client_result.ok;
        val server_result: res[types.Stream, io_error.Error] = accept(?listener);
        if (sel server_result.err) { ret 6; }
        var server: types.Stream = server_result.ok;
        val identity_result: res[types.PeerIdentity, io_error.Error] = peer_identity(?server);
        if (sel identity_result.err) { ret 7; }
        val identity: types.PeerIdentity = identity_result.ok;
        if (!identity.has_user || !identity.has_group) { ret 8; }
        $if ($mach.build.os == $mach.os.linux) {
            if (!identity.has_process || identity.process != os.getpid()::u64) { ret 9; }
        }
        $or {
            if (identity.has_process) { ret 10; }
        }

        var request: [4]u8;
        request[0] = 'p'; request[1] = 'i'; request[2] = 'n'; request[3] = 'g';
        val written: res[usize, io_error.Error] = stream_write(?client, ?request[0], 4);
        if (!(sel written.ok && written.ok == 4)) { ret 11; }
        var input: [4]u8;
        val read_result: res[usize, io_error.Error] = stream_read(?server, ?input[0], 4);
        if (!(sel read_result.ok && read_result.ok == 4)
            || input[0] != 'p' || input[1] != 'i' || input[2] != 'n' || input[3] != 'g') {
            ret 12;
        }
        val stream_shutdown_write_result: err[io_error.Error] = stream_shutdown_write(?client);
        if (sel stream_shutdown_write_result.err) { ret 13; }
        val end_result: res[usize, io_error.Error] = stream_read(?server, ?input[0], 4);
        if (!(sel end_result.ok && end_result.ok == 0)) { ret 14; }
        val client_handle: usize = client.handle;
        val server_handle: usize = server.handle;
        val listener_handle: usize = listener.handle;
        val stream_close_result: err[io_error.Error] = stream_close(?client, lifecycle.ABORTIVE);
        if (sel stream_close_result.err) { ret 15; }
        val stream_close_result2: err[io_error.Error] = stream_close(?server, lifecycle.ABORTIVE);
        if (sel stream_close_result2.err) { ret 16; }
        val listener_close_result: err[io_error.Error] = listener_close(?listener);
        if (sel listener_close_result.err) { ret 17; }
        if (!test_absent(bound)) { ret 18; }
        if (os.sock_inheritable(client_handle, ?inheritable) != os.EBADF
            || os.sock_inheritable(server_handle, ?inheritable) != os.EBADF
            || os.sock_inheritable(listener_handle, ?inheritable) != os.EBADF) {
            ret 19;
        }
        ret 0;
    }

    test "local stream: owned rename moves cleanup responsibility" {
        var first_path: [108]u8;
        var second_path: [108]u8;
        val first_length: usize = test_name(?first_path[0], 'b');
        val second_length: usize = test_name(?second_path[0], 'c');
        val first_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?first_path[0], first_length);
        val second_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?second_path[0], second_length);
        if (sel first_result.err) { ret 1; }
        if (sel second_result.err) { ret 1; }
        val first: endpoint.Endpoint = first_result.ok;
        val second: endpoint.Endpoint = second_result.ok;
        var options: types.ListenOptions = default_listen_options();
        options.stale = REMOVE_STALE_SOCKET;
        val made: res[types.Listener, io_error.Error] = listen(first, options);
        if (sel made.err) { ret 2; }
        var listener: types.Listener = made.ok;
        val listener_rename_result: err[io_error.Error] = listener_rename(?listener, second);
        if (sel listener_rename_result.err) { ret 3; }
        if (!test_absent(first) || test_absent(second)) { ret 4; }
        val client_result: res[types.Stream, io_error.Error] = connect(second);
        if (sel client_result.err) { ret 5; }
        var client: types.Stream = client_result.ok;
        val server_result: res[types.Stream, io_error.Error] = accept(?listener);
        if (sel server_result.err) { ret 6; }
        var server: types.Stream = server_result.ok;
        if (refused(stream_close(?client, lifecycle.ABORTIVE)) || refused(stream_close(?server, lifecycle.ABORTIVE))) { ret 7; }
        if (refused(listener_close(?listener)) || !test_absent(second)) { ret 8; }
        ret 0;
    }

    test "local stream: cleanup preserves a replacement path" {
        var path: [108]u8;
        val length: usize = test_name(?path[0], 'f');
        val endpoint_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?path[0], length);
        if (sel endpoint_result.err) { ret 1; }
        val value: endpoint.Endpoint = endpoint_result.ok;
        var options: types.ListenOptions = default_listen_options();
        options.stale = REMOVE_STALE_SOCKET;
        val made: res[types.Listener, io_error.Error] = listen(value, options);
        if (sel made.err) { ret 2; }
        var listener: types.Listener = made.ok;
        if (os.unlink(os.AT_FDCWD, ?path[0], 0) < 0) { ret 3; }
        val replacement: i64 = os.open(os.AT_FDCWD, ?path[0], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0x180);
        if (replacement < 0 || os.close(replacement::i32) < 0) { ret 4; }
        val closed: err[io_error.Error] = listener_close(?listener);
        if (!(sel closed.err && closed.err.code == os.EBUSY)
            || test_absent(value)) {
            ret 5;
        }
        if (os.unlink(os.AT_FDCWD, ?path[0], 0) < 0) { ret 6; }
        ret 0;
    }

    test "local stream: rename rejects an occupied destination" {
        var source_path: [108]u8;
        var destination_path: [108]u8;
        val source_length: usize = test_name(?source_path[0], 'g');
        val destination_length: usize = test_name(?destination_path[0], 'h');
        val source_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?source_path[0], source_length);
        val destination_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?destination_path[0], destination_length);
        if (sel source_result.err) { ret 1; }
        if (sel destination_result.err) { ret 1; }
        val source: endpoint.Endpoint = source_result.ok;
        val destination: endpoint.Endpoint = destination_result.ok;
        var options: types.ListenOptions = default_listen_options();
        options.stale = REMOVE_STALE_SOCKET;
        val made: res[types.Listener, io_error.Error] = listen(source, options);
        if (sel made.err) { ret 2; }
        var listener: types.Listener = made.ok;
        val occupied: i64 = os.open(os.AT_FDCWD, ?destination_path[0], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0x180);
        if (occupied < 0 || os.close(occupied::i32) < 0) { ret 3; }
        val renamed: err[io_error.Error] = listener_rename(?listener, destination);
        if (!(sel renamed.err && renamed.err.code == os.EEXIST)
            || test_absent(source)
            || test_absent(destination)) {
            ret 4;
        }
        if (refused(listener_close(?listener))
            || os.unlink(os.AT_FDCWD, ?destination_path[0], 0) < 0) {
            ret 5;
        }
        ret 0;
    }

    test "local stream: stale ownership and bind failure cleanup are explicit" {
        var path: [108]u8;
        val path_length: usize = test_name(?path[0], 'd');
        val endpoint_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?path[0], path_length);
        if (sel endpoint_result.err) { ret 1; }
        val bound: endpoint.Endpoint = endpoint_result.ok;
        var borrowed_options: types.ListenOptions = default_listen_options();
        borrowed_options.ownership = BORROWED;
        borrowed_options.stale = REMOVE_STALE_SOCKET;
        val borrowed_result: res[types.Listener, io_error.Error] = listen(bound, borrowed_options);
        if (sel borrowed_result.err) { ret 2; }
        var borrowed: types.Listener = borrowed_result.ok;
        if (refused(listener_close(?borrowed)) || test_absent(bound)) { ret 3; }

        var owned_options: types.ListenOptions = default_listen_options();
        owned_options.stale = REMOVE_STALE_SOCKET;
        val owned_result: res[types.Listener, io_error.Error] = listen(bound, owned_options);
        if (sel owned_result.err) { ret 4; }
        var owned: types.Listener = owned_result.ok;
        if (refused(listener_close(?owned)) || !test_absent(bound)) { ret 5; }

        var invalid_options: types.ListenOptions = default_listen_options();
        invalid_options.permissions = 0x800;
        val invalid_result: res[types.Listener, io_error.Error] = listen(bound, invalid_options);
        if (sel invalid_result.ok || !test_absent(bound)) { ret 6; }
        ret 0;
    }

    $if ($mach.build.os == $mach.os.linux) {
        test "local stream: linux abstract endpoints round trip" {
            var name: [64]u8;
            val length: usize = test_name(?name[0], 'e');
            val endpoint_result: res[endpoint.Endpoint, io_error.Error] = abstract(?name[5], length - 5);
            if (sel endpoint_result.err) { ret 1; }
            val bound: endpoint.Endpoint = endpoint_result.ok;
            val listener_result: res[types.Listener, io_error.Error] = listen(bound, default_listen_options());
            if (sel listener_result.err) { ret 2; }
            var listener: types.Listener = listener_result.ok;
            val client_result: res[types.Stream, io_error.Error] = connect(bound);
            if (sel client_result.err) { ret 3; }
            var client: types.Stream = client_result.ok;
            val server_result: res[types.Stream, io_error.Error] = accept(?listener);
            if (sel server_result.err) { ret 4; }
            var server: types.Stream = server_result.ok;
            if (refused(stream_close(?client, lifecycle.ABORTIVE)) || refused(stream_close(?server, lifecycle.ABORTIVE))) { ret 5; }
            val listener_close_result: err[io_error.Error] = listener_close(?listener);
            if (sel listener_close_result.err) { ret 6; }
            ret 0;
        }
    }
}

$if ($mach.build.os == $mach.os.windows) {
    #[library("kernel32.dll")]
    ext fun GetCurrentProcess() isize;
    #[library("kernel32.dll")]
    ext fun GetProcessHandleCount(process: isize, count: *u32) i32;

    fun test_windows_handle_count(count: *u32) bool {
        ret count != nil && GetProcessHandleCount(GetCurrentProcess(), count) != 0;
    }

    fun test_windows_name(output: *u8) usize {
        val prefix: str = "mach-std-local-502-";
        var length: usize = 0;
        for (prefix[length] != 0) {
            output[length] = prefix[length];
            length = length + 1;
        }
        var process: u64 = os.getpid()::u64;
        var digits: [20]u8;
        var count: usize = 0;
        if (process == 0) {
            digits[0] = '0';
            count = 1;
        }
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process = process / 10;
            count = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            output[length] = digits[count - i - 1];
            length = length + 1;
            i = i + 1;
        }
        output[length] = '.';
        output[length + 1] = 's';
        output[length + 2] = 'o';
        output[length + 3] = 'c';
        output[length + 4] = 'k';
        output[length + 5] = 0;
        ret length + 5;
    }

    fun test_windows_absent(value: endpoint.Endpoint) bool {
        var path: [108]u8;
        var i: usize = 0;
        for (i < value.length) { path[i] = value.name[i]; i = i + 1; }
        path[value.length] = 0;
        var status: os.stat_t;
        ret os.stat_path(os.AT_FDCWD, ?path[0], ?status, os.AT_SYMLINK_NOFOLLOW) == os.ENOENT;
    }

    test "local stream: windows old owner preserves rebound endpoint" {
        if (windows.running_under_wine()) { ret 0; }
        var path: [108]u8;
        val length: usize = test_windows_name(?path[0]);
        path[length - 5] = 'r';
        val endpoint_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?path[0], length);
        if (sel endpoint_result.err) { ret 1; }
        val bound: endpoint.Endpoint = endpoint_result.ok;
        val first_result: res[types.Listener, io_error.Error] = listen(bound, default_listen_options());
        if (sel first_result.err) { ret 2; }
        var first: types.Listener = first_result.ok;
        if (os.unlink(os.AT_FDCWD, ?path[0], 0) < 0) { ret 3; }
        val second_result: res[types.Listener, io_error.Error] = listen(bound, default_listen_options());
        if (sel second_result.err) { ret 4; }
        var second: types.Listener = second_result.ok;
        val stale_close: err[io_error.Error] = listener_close(?first);
        if (!(sel stale_close.err && stale_close.err.code == os.EBUSY)
            || test_windows_absent(bound)) {
            ret 5;
        }
        val client_result: res[types.Stream, io_error.Error] = connect(bound);
        if (sel client_result.err) { ret 6; }
        var client: types.Stream = client_result.ok;
        val server_result: res[types.Stream, io_error.Error] = accept(?second);
        if (sel server_result.err) { ret 7; }
        var server: types.Stream = server_result.ok;
        if (refused(stream_close(?client, lifecycle.ABORTIVE))
            || refused(stream_close(?server, lifecycle.ABORTIVE))
            || refused(listener_close(?second))
            || !test_windows_absent(bound)) {
            ret 8;
        }
        ret 0;
    }

    test "local stream: windows lifecycle limits and identity capability" {
        if (windows.running_under_wine()) { ret 0; }
        val capabilities: endpoint.Capabilities = endpoint.capabilities();
        if (!capabilities.stream || !capabilities.filesystem
            || capabilities.abstract || capabilities.target_names
            || capabilities.peer_process || capabilities.peer_user || capabilities.peer_group
            || !capabilities.owned_cleanup || capabilities.listener_rename
            || capabilities.stale_cleanup || capabilities.custom_permissions) {
            ret 1;
        }
        var name: [108]u8;
        val length: usize = test_windows_name(?name[0]);
        val endpoint_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?name[0], length);
        if (sel endpoint_result.err) { ret 2; }
        val bound: endpoint.Endpoint = endpoint_result.ok;
        var unsupported: types.ListenOptions = default_listen_options();
        unsupported.stale = REMOVE_STALE_SOCKET;
        val listen_result: res[types.Listener, io_error.Error] = listen(bound, unsupported);
        if (sel listen_result.ok) { ret 3; }
        unsupported = default_listen_options();
        unsupported.permissions = 0x180;
        val listen_result2: res[types.Listener, io_error.Error] = listen(bound, unsupported);
        if (sel listen_result2.ok) { ret 4; }

        var baseline: u32 = 0;
        var round: usize = 0;
        for (round < 17) {
            val listener_result: res[types.Listener, io_error.Error] = listen(bound, default_listen_options());
            if (sel listener_result.err) { ret 6; }
            var listener: types.Listener = listener_result.ok;
            val client_result: res[types.Stream, io_error.Error] = connect(bound);
            if (sel client_result.err) { ret 7; }
            var client: types.Stream = client_result.ok;
            val server_result: res[types.Stream, io_error.Error] = accept(?listener);
            if (sel server_result.err) { ret 8; }
            var server: types.Stream = server_result.ok;
            val identity_result: res[types.PeerIdentity, io_error.Error] = peer_identity(?server);
            if (sel identity_result.ok) { ret 9; }
            if (identity_result.err.code != os.ENOTSUP) { ret 9; }
            var byte: u8 = round::u8;
            val sent: res[usize, io_error.Error] = stream_write(?client, ?byte, 1);
            if (!(sel sent.ok && sent.ok == 1)) { ret 10; }
            byte = 0;
            val received: res[usize, io_error.Error] = stream_read(?server, ?byte, 1);
            if (!(sel received.ok && received.ok == 1)
                || byte != round::u8) {
                ret 11;
            }
            val stream_shutdown_write_result: err[io_error.Error] = stream_shutdown_write(?client);
            if (sel stream_shutdown_write_result.err) { ret 12; }
            val ended: res[usize, io_error.Error] = stream_read(?server, ?byte, 1);
            if (!(sel ended.ok && ended.ok == 0)) { ret 13; }
            if (refused(stream_close(?client, lifecycle.ABORTIVE))
                || refused(stream_close(?server, lifecycle.ABORTIVE))
                || refused(listener_close(?listener))) {
                ret 14;
            }
            if (round == 0 && !test_windows_handle_count(?baseline)) { ret 5; }
            round = round + 1;
        }
        var after: u32 = 0;
        if (!test_windows_handle_count(?after) || after != baseline) { ret 15; }
        ret 0;
    }
}

$if ($mach.build.os == $mach.os.linux) {
    # the test's own inventory of its descriptor table, never a production mechanism
    fun test_descriptor_count() i64 {
        val directory: i64 = os.open(os.AT_FDCWD, "/proc/self/fd", os.O_RDONLY | os.O_DIRECTORY, 0);
        if (directory < 0) { ret directory; }
        var cursor: os.DirectoryCursor = os.DirectoryCursor{};
        val initialized: os.DirectoryInitResult = os.directory_init(?cursor, directory::i32);
        if (initialized.code != 0) { os.close(directory::i32); ret initialized.code; }
        var count: i64 = 0;
        var entry: os.DirectoryEntry;
        var next: i64 = os.directory_next(?cursor, ?entry);
        for (next > 0) {
            if (entry.name[0] != '.') { count = count + 1; }
            next = os.directory_next(?cursor, ?entry);
        }
        os.directory_close(?cursor);
        os.close(directory::i32);
        if (next < 0) { ret next; }
        ret count - 1;
    }

    fun test_send_rights(handle: usize, data: *u8, length: usize, descriptor: i32, count: usize) i64 {
        if (count > linux.SCM_MAX_FD) { ret os.EINVAL; }
        var control: [1032]u8;
        val record_length: usize = 16 + count * 4;
        @((?control[0])::*usize) = record_length;
        @((?control[8])::*i32) = os.SOL_SOCKET;
        @((?control[12])::*i32) = linux.SCM_RIGHTS;
        var i: usize = 0;
        for (i < count) {
            @((?control[16 + i * 4])::*i32) = descriptor;
            i = i + 1;
        }
        var vector: linux.IoVector = linux.IoVector{data: data, length: length};
        ret linux.sock_send_message(handle, ?vector, 1, nil, 0, ?control[0], (record_length + 7) & ~7::usize);
    }

    fun test_rights_pair(suffix: u8, nonblocking_client: bool, listener: *types.Listener, client: *types.Stream, server: *types.Stream) i64 {
        var path: [108]u8;
        val path_length: usize = test_name(?path[0], suffix);
        val endpoint_result: res[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?path[0], path_length);
        if (sel endpoint_result.err) { ret 1; }
        val bound: endpoint.Endpoint = endpoint_result.ok;
        var options: types.ListenOptions = default_listen_options();
        options.stale = REMOVE_STALE_SOCKET;
        val listener_result: res[types.Listener, io_error.Error] = listen(bound, options);
        if (sel listener_result.err) { ret 2; }
        @listener = listener_result.ok;
        client.handle = (-1)::isize::usize;
        client.server_side = false;
        if (impl.connect(client, bound, nonblocking_client) < 0) {
            listener_close(listener);
            ret 3;
        }
        server.handle = (-1)::isize::usize;
        server.server_side = true;
        if (impl.accept(listener, server, false) < 0) {
            stream_close(client, lifecycle.ABORTIVE);
            listener_close(listener);
            ret 4;
        }
        ret 0;
    }

    fun test_pipe_intact(pipe: *i32, marker: u8) bool {
        var byte: u8 = 0;
        if (os.write(pipe[1], ?marker, 1) != 1) { ret false; }
        if (os.read(pipe[0], ?byte, 1) != 1) { ret false; }
        ret byte == marker;
    }

    test "local stream: unwanted rights are closed and unrelated descriptors untouched" {
        var unrelated: [2]i32;
        if (os.pipe(?unrelated[0]) < 0) { ret 1; }
        fin { os.close(unrelated[0]); os.close(unrelated[1]); }
        var listener: types.Listener;
        var client: types.Stream;
        var server: types.Stream;
        if (test_rights_pair('r', false, ?listener, ?client, ?server) != 0) { ret 2; }
        fin {
            stream_close(?client, lifecycle.ABORTIVE);
            stream_close(?server, lifecycle.ABORTIVE);
            listener_close(?listener);
        }
        val before: i64 = test_descriptor_count();
        if (before < 0) { ret 3; }
        if (test_send_rights(server.handle, "abc", 3, unrelated[0], 3) != 3) { ret 4; }
        var buffer: [64]u8;
        val received: res[usize, io_error.Error] = stream_read(?client, ?buffer[0], 64);
        if (!(sel received.ok && received.ok == 3)) { ret 5; }
        if (buffer[0] != 'a' || buffer[1] != 'b' || buffer[2] != 'c') { ret 6; }
        if (test_descriptor_count() != before) { ret 7; }
        if (!test_pipe_intact(?unrelated[0], 'u')) { ret 8; }
        var inheritable: bool = true;
        if (os.sock_inheritable(unrelated[0]::usize, ?inheritable) != 0 || os.sock_inheritable(unrelated[1]::usize, ?inheritable) != 0) { ret 9; }
        if (test_send_rights(server.handle, "d", 1, unrelated[1], 1) != 1) { ret 10; }
        val again: res[usize, io_error.Error] = stream_read(?client, ?buffer[0], 64);
        if (!(sel again.ok && again.ok == 1) || buffer[0] != 'd') { ret 11; }
        if (test_descriptor_count() != before) { ret 12; }
        if (!test_pipe_intact(?unrelated[0], 'v')) { ret 13; }
        ret 0;
    }

    test "local stream: undersized control storage closes what the kernel installed" {
        # qemu-user gives the host twice the guest's control length and reports only what
        # the guest's fits, so the host installs descriptors the guest never sees
        if (linux.running_under_user_emulation()) { ret 0; }
        var pipe: [2]i32;
        if (os.pipe(?pipe[0]) < 0) { ret 1; }
        fin { os.close(pipe[0]); os.close(pipe[1]); }
        var listener: types.Listener;
        var client: types.Stream;
        var server: types.Stream;
        if (test_rights_pair('t', false, ?listener, ?client, ?server) != 0) { ret 2; }
        fin {
            stream_close(?client, lifecycle.ABORTIVE);
            stream_close(?server, lifecycle.ABORTIVE);
            listener_close(?listener);
        }
        val before: i64 = test_descriptor_count();
        if (before < 0) { ret 3; }
        var buffer: [64]u8;
        var control: [64]u8;
        if (linux.sock_recv_close_rights(client.handle, ?buffer[0], 64, nil, nil, ?control[0], 8) != os.EINVAL) { ret 4; }
        if (linux.sock_recv_close_rights(client.handle, ?buffer[0], 64, nil, nil, nil, 64) != os.EINVAL) { ret 5; }
        if (linux.sock_recv_close_rights(client.handle, ?buffer[0], 64, ?buffer[0], nil, ?control[0], 64) != os.EINVAL) { ret 6; }
        # room for two descriptors: the kernel installs and reports two, drops the third
        if (test_send_rights(server.handle, "x", 1, pipe[0], 3) != 1) { ret 7; }
        if (linux.sock_recv_close_rights(client.handle, ?buffer[0], 64, nil, nil, ?control[0], 24) != 1 || buffer[0] != 'x') { ret 8; }
        if (@((?control[0])::*usize) != 24) { ret 9; }
        if (test_descriptor_count() != before) { ret 10; }
        # header-only storage: nothing fits, nothing is installed, the bytes still arrive
        if (test_send_rights(server.handle, "y", 1, pipe[0], 3) != 1) { ret 11; }
        if (linux.sock_recv_close_rights(client.handle, ?buffer[0], 64, nil, nil, ?control[0], 16) != 1 || buffer[0] != 'y') { ret 12; }
        if (@((?control[0])::*usize) != 0) { ret 13; }
        if (test_descriptor_count() != before) { ret 14; }
        if (!test_pipe_intact(?pipe[0], 'w')) { ret 15; }
        ret 0;
    }

    test "local stream: repeated rights under descriptor pressure never grow the table" {
        var pipe: [2]i32;
        if (os.pipe(?pipe[0]) < 0) { ret 1; }
        fin { os.close(pipe[0]); os.close(pipe[1]); }
        var listener: types.Listener;
        var client: types.Stream;
        var server: types.Stream;
        if (test_rights_pair('p', false, ?listener, ?client, ?server) != 0) { ret 2; }
        fin {
            stream_close(?client, lifecycle.ABORTIVE);
            stream_close(?server, lifecycle.ABORTIVE);
            listener_close(?listener);
        }
        val before: i64 = test_descriptor_count();
        if (before < 0) { ret 3; }
        var buffer: [64]u8;
        var round: usize = 0;
        for (round < 32) {
            if (test_send_rights(server.handle, "p", 1, pipe[0], linux.SCM_MAX_FD) != 1) { ret 4; }
            if (test_send_rights(server.handle, "q", 1, pipe[0], linux.SCM_MAX_FD) != 1) { ret 5; }
            var total: usize = 0;
            for (total < 2) {
                val received: res[usize, io_error.Error] = stream_read(?client, ?buffer[0], 64);
                if (sel received.err) { ret 6; }
                if (received.ok < 1 || buffer[0] != 'p' + total::u8) { ret 7; }
                total = total + received.ok;
            }
            if (total != 2 || test_descriptor_count() != before) { ret 8; }
            round = round + 1;
        }
        var burst: usize = 0;
        for (burst < 100) {
            if (test_send_rights(server.handle, "b", 1, pipe[0], 8) != 1) { ret 9; }
            burst = burst + 1;
        }
        var drained: usize = 0;
        for (drained < 100) {
            val received: res[usize, io_error.Error] = stream_read(?client, ?buffer[0], 64);
            if (sel received.err) { ret 10; }
            if (received.ok < 1 || buffer[0] != 'b') { ret 10; }
            drained = drained + received.ok;
        }
        if (drained != 100 || test_descriptor_count() != before) { ret 11; }
        if (!test_pipe_intact(?pipe[0], 'z')) { ret 12; }
        ret 0;
    }

    fun test_stream_byte(position: usize) u8 {
        ret ((position * 7 + 3) & 0xff)::u8;
    }

    test "local stream: a hostile peer attaching rights to a large stream leaks nothing" {
        var pipe: [2]i32;
        if (os.pipe(?pipe[0]) < 0) { ret 1; }
        fin { os.close(pipe[0]); os.close(pipe[1]); }
        var listener: types.Listener;
        var client: types.Stream;
        var server: types.Stream;
        if (test_rights_pair('h', true, ?listener, ?client, ?server) != 0) { ret 2; }
        fin {
            stream_close(?client, lifecycle.ABORTIVE);
            stream_close(?server, lifecycle.ABORTIVE);
            listener_close(?listener);
        }
        val before: i64 = test_descriptor_count();
        if (before < 0) { ret 3; }
        val total: usize = 262144;
        var chunk: [4096]u8;
        var buffer: [8192]u8;
        var sent_total: usize = 0;
        var received_total: usize = 0;
        var reads: usize = 0;
        for (sent_total < total) {
            var remaining: usize = 4096 - (sent_total & 4095);
            var i: usize = 0;
            for (i < remaining) { chunk[i] = test_stream_byte(sent_total + i); i = i + 1; }
            val sent: i64 = test_send_rights(client.handle, ?chunk[0], remaining, pipe[0], 8);
            if (sent == os.EAGAIN) {
                val received: res[usize, io_error.Error] = stream_read(?server, ?buffer[0], 8192);
                if (sel received.err) { ret 4; }
                if (received.ok < 1) { ret 4; }
                var j: usize = 0;
                for (j < received.ok) {
                    if (buffer[j] != test_stream_byte(received_total + j)) { ret 5; }
                    j = j + 1;
                }
                received_total = received_total + received.ok;
                reads = reads + 1;
                if (test_descriptor_count() != before) { ret 6; }
                cnt;
            }
            if (sent < 1) { ret 7; }
            sent_total = sent_total + sent::usize;
        }
        for (received_total < total) {
            val received: res[usize, io_error.Error] = stream_read(?server, ?buffer[0], 8192);
            if (sel received.err) { ret 8; }
            if (received.ok < 1) { ret 8; }
            var j: usize = 0;
            for (j < received.ok) {
                if (buffer[j] != test_stream_byte(received_total + j)) { ret 9; }
                j = j + 1;
            }
            received_total = received_total + received.ok;
            reads = reads + 1;
        }
        if (received_total != total || reads < 64 || test_descriptor_count() != before) { ret 10; }
        if (!test_pipe_intact(?pipe[0], 'k')) { ret 11; }
        ret 0;
    }

    test "local stream: a native failure after rights were externalized still closes them" {
        # qemu-user drops the control records when the address copy fails after the host
        # installed the descriptors
        if (linux.running_under_user_emulation()) { ret 0; }
        var pipe: [2]i32;
        if (os.pipe(?pipe[0]) < 0) { ret 1; }
        fin { os.close(pipe[0]); os.close(pipe[1]); }
        var listener: types.Listener;
        var client: types.Stream;
        var server: types.Stream;
        if (test_rights_pair('f', false, ?listener, ?client, ?server) != 0) { ret 2; }
        fin {
            stream_close(?client, lifecycle.ABORTIVE);
            stream_close(?server, lifecycle.ABORTIVE);
            listener_close(?listener);
        }
        val before: i64 = test_descriptor_count();
        if (before < 0) { ret 3; }
        if (test_send_rights(server.handle, "e", 1, pipe[0], 3) != 1) { ret 4; }
        # the bound peer has an address, so an unmapped address destination makes the
        # kernel fail after it installed the rights and wrote their record
        var buffer: [64]u8;
        var control: [1088]u8;
        var address_length: u32 = 128;
        val failed: i64 = linux.sock_recv_close_rights(client.handle, ?buffer[0], 64, 1::*u8, ?address_length, ?control[0], linux.LOCAL_CONTROL_CAPACITY);
        if (failed != os.EFAULT) { ret 5; }
        if (test_descriptor_count() != before) { ret 6; }
        # an emulator that rejects the destination before the native call installs nothing and
        # leaves the message queued; a native kernel consumed it with its record written
        val externalized: bool = @((?control[0])::*usize) == 28;
        if (!externalized && @((?control[0])::*usize) != 0) { ret 7; }
        if (test_send_rights(server.handle, "z", 1, pipe[0], 2) != 1) { ret 8; }
        var expected: u8 = 'z';
        if (!externalized) { expected = 'e'; }
        val next: res[usize, io_error.Error] = stream_read(?client, ?buffer[0], 64);
        if (!(sel next.ok && next.ok == 1) || buffer[0] != expected) { ret 9; }
        if (test_descriptor_count() != before) { ret 10; }
        if (!externalized) {
            val last: res[usize, io_error.Error] = stream_read(?client, ?buffer[0], 64);
            if (!(sel last.ok && last.ok == 1) || buffer[0] != 'z') { ret 11; }
            if (test_descriptor_count() != before) { ret 12; }
        }
        if (!test_pipe_intact(?pipe[0], 'n')) { ret 13; }
        ret 0;
    }
}
