# portable local byte-stream descriptors and endpoint ownership

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.size.isize;
use std.types.string.str;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.system.os;
use std.net.local.endpoint;
use std.net.local.types;
use io_error: std.io.error;

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    use impl: std.net.local.unix;
}
$or ($mach.build.os == $mach.os.windows) {
    use impl: std.net.local.windows;
}
$or {
    $error("std.net.local: unsupported target");
}

fwd endpoint.Kind;
fwd endpoint.Endpoint;
fwd endpoint.Capabilities;
fwd endpoint.FILESYSTEM;
fwd endpoint.ABSTRACT;
fwd endpoint.TARGET;
fwd types.Ownership;
fwd types.BORROWED;
fwd types.OWNED;
fwd types.StalePolicy;
fwd types.REJECT_STALE;
fwd types.REMOVE_STALE_SOCKET;
fwd types.INHERIT_PERMISSIONS;
fwd types.ListenOptions;
fwd types.Listener;
fwd types.Stream;
fwd types.PeerIdentity;

pub fun capabilities() endpoint.Capabilities {
    ret endpoint.capabilities();
}

pub fun filesystem(path: str) Result[endpoint.Endpoint, io_error.Error] {
    ret endpoint.filesystem(path);
}

pub fun filesystem_bytes(data: *u8, length: usize) Result[endpoint.Endpoint, io_error.Error] {
    ret endpoint.filesystem_bytes(data, length);
}

pub fun abstract(data: *u8, length: usize) Result[endpoint.Endpoint, io_error.Error] {
    ret endpoint.abstract(data, length);
}

pub fun target(name: str) Result[endpoint.Endpoint, io_error.Error] {
    ret endpoint.target(name);
}

pub fun target_bytes(data: *u8, length: usize) Result[endpoint.Endpoint, io_error.Error] {
    ret endpoint.target_bytes(data, length);
}

pub fun default_listen_options() types.ListenOptions {
    ret types.ListenOptions{
        backlog: 128,
        ownership: OWNED,
        stale: REJECT_STALE,
        permissions: INHERIT_PERMISSIONS,
    };
}

fun invalid(operation: io_error.Operation) io_error.Error {
    ret io_error.from_code(os.EINVAL, operation);
}

pub fun listen(bound: endpoint.Endpoint, options: types.ListenOptions) Result[types.Listener, io_error.Error] {
    if (!endpoint.supported(bound)
        || options.backlog <= 0
        || (options.ownership != BORROWED && options.ownership != OWNED)
        || (options.stale != REJECT_STALE && options.stale != REMOVE_STALE_SOCKET)
        || (bound.kind != endpoint.FILESYSTEM && options.stale != REJECT_STALE)) {
        ret err[types.Listener, io_error.Error](invalid(io_error.OP_LISTEN));
    }
    var listener: types.Listener;
    listener.handle = (-1)::isize::usize;
    listener.endpoint = bound;
    listener.ownership = options.ownership;
    val code: i64 = impl.listen(?listener, bound, options);
    if (code < 0) {
        ret err[types.Listener, io_error.Error](io_error.from_code(code, io_error.OP_LISTEN));
    }
    ret ok[types.Listener, io_error.Error](listener);
}

pub fun connect(remote: endpoint.Endpoint) Result[types.Stream, io_error.Error] {
    if (!endpoint.supported(remote)) {
        ret err[types.Stream, io_error.Error](invalid(io_error.OP_CONNECT));
    }
    var stream: types.Stream;
    stream.handle = (-1)::isize::usize;
    stream.server_side = false;
    val code: i64 = impl.connect(?stream, remote, false);
    if (code < 0) {
        ret err[types.Stream, io_error.Error](io_error.from_code(code, io_error.OP_CONNECT));
    }
    ret ok[types.Stream, io_error.Error](stream);
}

pub fun accept(listener: *types.Listener) Result[types.Stream, io_error.Error] {
    if (listener == nil || listener.handle == (-1)::isize::usize) {
        ret err[types.Stream, io_error.Error](invalid(io_error.OP_ACCEPT));
    }
    var stream: types.Stream;
    stream.handle = (-1)::isize::usize;
    stream.server_side = true;
    val code: i64 = impl.accept(listener, ?stream, false);
    if (code < 0) {
        ret err[types.Stream, io_error.Error](io_error.from_code(code, io_error.OP_ACCEPT));
    }
    ret ok[types.Stream, io_error.Error](stream);
}

pub fun stream_read(stream: *types.Stream, buffer: *u8, length: usize) Result[usize, io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize || (buffer == nil && length != 0)) {
        ret err[usize, io_error.Error](invalid(io_error.OP_READ));
    }
    val count: i64 = impl.read(stream.handle, buffer, length);
    if (count < 0) { ret err[usize, io_error.Error](io_error.from_code(count, io_error.OP_READ)); }
    ret ok[usize, io_error.Error](count::usize);
}

pub fun stream_write(stream: *types.Stream, buffer: *u8, length: usize) Result[usize, io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize || (buffer == nil && length != 0)) {
        ret err[usize, io_error.Error](invalid(io_error.OP_WRITE));
    }
    val count: i64 = impl.write(stream.handle, buffer, length);
    if (count < 0) { ret err[usize, io_error.Error](io_error.from_code(count, io_error.OP_WRITE)); }
    ret ok[usize, io_error.Error](count::usize);
}

pub fun stream_shutdown_write(stream: *types.Stream) Result[bool, io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize) {
        ret err[bool, io_error.Error](invalid(io_error.OP_SHUTDOWN));
    }
    val code: i64 = impl.shutdown_write(stream.handle);
    if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_SHUTDOWN)); }
    ret ok[bool, io_error.Error](true);
}

pub fun peer_identity(stream: *types.Stream) Result[types.PeerIdentity, io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize) {
        ret err[types.PeerIdentity, io_error.Error](invalid(io_error.OP_OPTION));
    }
    var identity: types.PeerIdentity;
    identity.has_process = false;
    identity.has_user = false;
    identity.has_group = false;
    val code: i64 = impl.peer_identity(stream.handle, stream.server_side, ?identity);
    if (code < 0) { ret err[types.PeerIdentity, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    ret ok[types.PeerIdentity, io_error.Error](identity);
}

# owned filesystem names move with the listener and cleanup follows the new name
pub fun listener_rename(listener: *types.Listener, replacement: endpoint.Endpoint) Result[bool, io_error.Error] {
    val target_capabilities: endpoint.Capabilities = endpoint.capabilities();
    if (!target_capabilities.listener_rename) {
        ret err[bool, io_error.Error](io_error.from_code(os.ENOTSUP, io_error.OP_OPTION));
    }
    if (listener == nil
        || listener.handle == (-1)::isize::usize
        || listener.ownership != OWNED
        || listener.endpoint.kind != endpoint.FILESYSTEM
        || replacement.kind != endpoint.FILESYSTEM
        || !endpoint.supported(replacement)) {
        ret err[bool, io_error.Error](invalid(io_error.OP_OPTION));
    }
    val code: i64 = impl.rename(listener, replacement);
    if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    listener.endpoint = replacement;
    ret ok[bool, io_error.Error](true);
}

pub fun stream_close(stream: *types.Stream) Result[bool, io_error.Error] {
    if (stream == nil || stream.handle == (-1)::isize::usize) {
        ret err[bool, io_error.Error](invalid(io_error.OP_CLOSE));
    }
    val raw: usize = stream.handle;
    stream.handle = (-1)::isize::usize;
    val code: i64 = impl.close_stream(raw, stream.server_side);
    if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_CLOSE)); }
    ret ok[bool, io_error.Error](true);
}

pub fun listener_close(listener: *types.Listener) Result[bool, io_error.Error] {
    if (listener == nil || listener.handle == (-1)::isize::usize) {
        ret err[bool, io_error.Error](invalid(io_error.OP_CLOSE));
    }
    val raw: usize = listener.handle;
    listener.handle = (-1)::isize::usize;
    val code: i64 = impl.close_listener(raw, listener.endpoint, listener.ownership == OWNED);
    if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_CLOSE)); }
    ret ok[bool, io_error.Error](true);
}

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    fun test_name(output: *u8, suffix: u8) usize {
        val prefix: str = "/tmp/mach-std-local-502-";
        var length: usize = 0;
        for (prefix[length] != 0) {
            output[length] = prefix[length];
            length = length + 1;
        }
        var process: u64 = os.getpid()::u64;
        var digits: [20]u8;
        var count: usize = 0;
        if (process == 0) {
            digits[0] = '0';
            count = 1;
        }
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process = process / 10;
            count = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            output[length] = digits[count - i - 1];
            length = length + 1;
            i = i + 1;
        }
        output[length] = '-';
        output[length + 1] = suffix;
        output[length + 2] = '.';
        output[length + 3] = 's';
        output[length + 4] = 'o';
        output[length + 5] = 'c';
        output[length + 6] = 'k';
        output[length + 7] = 0;
        ret length + 7;
    }

    fun test_absent(value: endpoint.Endpoint) bool {
        var path: [108]u8;
        var i: usize = 0;
        for (i < value.length) { path[i] = value.name[i]; i = i + 1; }
        path[value.length] = 0;
        var status: os.stat_t;
        ret os.stat_path(os.AT_FDCWD, ?path[0], ?status, os.AT_SYMLINK_NOFOLLOW) == os.ENOENT;
    }

    test "local stream: filesystem lifecycle identity and half close" {
        var path: [108]u8;
        val path_length: usize = test_name(?path[0], 'a');
        val endpoint_result: Result[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?path[0], path_length);
        if (is_err[endpoint.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
        val bound: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](endpoint_result);
        var options: types.ListenOptions = default_listen_options();
        options.backlog = 4;
        options.stale = REMOVE_STALE_SOCKET;
        options.permissions = 0x180;
        val listener_result: Result[types.Listener, io_error.Error] = listen(bound, options);
        if (is_err[types.Listener, io_error.Error](listener_result)) { ret 2; }
        var listener: types.Listener = unwrap_ok[types.Listener, io_error.Error](listener_result);
        var inheritable: bool = true;
        if (os.sock_inheritable(listener.handle, ?inheritable) < 0 || inheritable) { ret 3; }
        var status: os.stat_t;
        if (os.stat_path(os.AT_FDCWD, ?path[0], ?status, os.AT_SYMLINK_NOFOLLOW) < 0
            || (os.stat_mode(?status) & 0x01ff) != 0x180) {
            ret 4;
        }

        val client_result: Result[types.Stream, io_error.Error] = connect(bound);
        if (is_err[types.Stream, io_error.Error](client_result)) { ret 5; }
        var client: types.Stream = unwrap_ok[types.Stream, io_error.Error](client_result);
        val server_result: Result[types.Stream, io_error.Error] = accept(?listener);
        if (is_err[types.Stream, io_error.Error](server_result)) { ret 6; }
        var server: types.Stream = unwrap_ok[types.Stream, io_error.Error](server_result);
        val identity_result: Result[types.PeerIdentity, io_error.Error] = peer_identity(?server);
        if (is_err[types.PeerIdentity, io_error.Error](identity_result)) { ret 7; }
        val identity: types.PeerIdentity = unwrap_ok[types.PeerIdentity, io_error.Error](identity_result);
        if (!identity.has_user || !identity.has_group) { ret 8; }
        $if ($mach.build.os == $mach.os.linux) {
            if (!identity.has_process || identity.process != os.getpid()::u64) { ret 9; }
        }
        $or {
            if (identity.has_process) { ret 10; }
        }

        var request: [4]u8;
        request[0] = 'p'; request[1] = 'i'; request[2] = 'n'; request[3] = 'g';
        val written: Result[usize, io_error.Error] = stream_write(?client, ?request[0], 4);
        if (is_err[usize, io_error.Error](written) || unwrap_ok[usize, io_error.Error](written) != 4) { ret 11; }
        var input: [4]u8;
        val read_result: Result[usize, io_error.Error] = stream_read(?server, ?input[0], 4);
        if (is_err[usize, io_error.Error](read_result)
            || unwrap_ok[usize, io_error.Error](read_result) != 4
            || input[0] != 'p' || input[1] != 'i' || input[2] != 'n' || input[3] != 'g') {
            ret 12;
        }
        if (is_err[bool, io_error.Error](stream_shutdown_write(?client))) { ret 13; }
        val end_result: Result[usize, io_error.Error] = stream_read(?server, ?input[0], 4);
        if (is_err[usize, io_error.Error](end_result) || unwrap_ok[usize, io_error.Error](end_result) != 0) { ret 14; }
        val client_handle: usize = client.handle;
        val server_handle: usize = server.handle;
        val listener_handle: usize = listener.handle;
        if (is_err[bool, io_error.Error](stream_close(?client))) { ret 15; }
        if (is_err[bool, io_error.Error](stream_close(?server))) { ret 16; }
        if (is_err[bool, io_error.Error](listener_close(?listener))) { ret 17; }
        if (!test_absent(bound)) { ret 18; }
        if (os.sock_inheritable(client_handle, ?inheritable) != os.EBADF
            || os.sock_inheritable(server_handle, ?inheritable) != os.EBADF
            || os.sock_inheritable(listener_handle, ?inheritable) != os.EBADF) {
            ret 19;
        }
        ret 0;
    }

    test "local stream: owned rename moves cleanup responsibility" {
        var first_path: [108]u8;
        var second_path: [108]u8;
        val first_length: usize = test_name(?first_path[0], 'b');
        val second_length: usize = test_name(?second_path[0], 'c');
        val first_result: Result[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?first_path[0], first_length);
        val second_result: Result[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?second_path[0], second_length);
        if (is_err[endpoint.Endpoint, io_error.Error](first_result) || is_err[endpoint.Endpoint, io_error.Error](second_result)) { ret 1; }
        val first: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](first_result);
        val second: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](second_result);
        var options: types.ListenOptions = default_listen_options();
        options.stale = REMOVE_STALE_SOCKET;
        val made: Result[types.Listener, io_error.Error] = listen(first, options);
        if (is_err[types.Listener, io_error.Error](made)) { ret 2; }
        var listener: types.Listener = unwrap_ok[types.Listener, io_error.Error](made);
        if (is_err[bool, io_error.Error](listener_rename(?listener, second))) { ret 3; }
        if (!test_absent(first) || test_absent(second)) { ret 4; }
        val client_result: Result[types.Stream, io_error.Error] = connect(second);
        if (is_err[types.Stream, io_error.Error](client_result)) { ret 5; }
        var client: types.Stream = unwrap_ok[types.Stream, io_error.Error](client_result);
        val server_result: Result[types.Stream, io_error.Error] = accept(?listener);
        if (is_err[types.Stream, io_error.Error](server_result)) { ret 6; }
        var server: types.Stream = unwrap_ok[types.Stream, io_error.Error](server_result);
        if (is_err[bool, io_error.Error](stream_close(?client)) || is_err[bool, io_error.Error](stream_close(?server))) { ret 7; }
        if (is_err[bool, io_error.Error](listener_close(?listener)) || !test_absent(second)) { ret 8; }
        ret 0;
    }

    test "local stream: stale ownership and bind failure cleanup are explicit" {
        var path: [108]u8;
        val path_length: usize = test_name(?path[0], 'd');
        val endpoint_result: Result[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?path[0], path_length);
        if (is_err[endpoint.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
        val bound: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](endpoint_result);
        var borrowed_options: types.ListenOptions = default_listen_options();
        borrowed_options.ownership = BORROWED;
        borrowed_options.stale = REMOVE_STALE_SOCKET;
        val borrowed_result: Result[types.Listener, io_error.Error] = listen(bound, borrowed_options);
        if (is_err[types.Listener, io_error.Error](borrowed_result)) { ret 2; }
        var borrowed: types.Listener = unwrap_ok[types.Listener, io_error.Error](borrowed_result);
        if (is_err[bool, io_error.Error](listener_close(?borrowed)) || test_absent(bound)) { ret 3; }

        var owned_options: types.ListenOptions = default_listen_options();
        owned_options.stale = REMOVE_STALE_SOCKET;
        val owned_result: Result[types.Listener, io_error.Error] = listen(bound, owned_options);
        if (is_err[types.Listener, io_error.Error](owned_result)) { ret 4; }
        var owned: types.Listener = unwrap_ok[types.Listener, io_error.Error](owned_result);
        if (is_err[bool, io_error.Error](listener_close(?owned)) || !test_absent(bound)) { ret 5; }

        var invalid_options: types.ListenOptions = default_listen_options();
        invalid_options.permissions = 0x800;
        val invalid_result: Result[types.Listener, io_error.Error] = listen(bound, invalid_options);
        if (!is_err[types.Listener, io_error.Error](invalid_result) || !test_absent(bound)) { ret 6; }
        ret 0;
    }

    $if ($mach.build.os == $mach.os.linux) {
        test "local stream: linux abstract endpoints round trip" {
            var name: [64]u8;
            val length: usize = test_name(?name[0], 'e');
            val endpoint_result: Result[endpoint.Endpoint, io_error.Error] = abstract(?name[5], length - 5);
            if (is_err[endpoint.Endpoint, io_error.Error](endpoint_result)) { ret 1; }
            val bound: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](endpoint_result);
            val listener_result: Result[types.Listener, io_error.Error] = listen(bound, default_listen_options());
            if (is_err[types.Listener, io_error.Error](listener_result)) { ret 2; }
            var listener: types.Listener = unwrap_ok[types.Listener, io_error.Error](listener_result);
            val client_result: Result[types.Stream, io_error.Error] = connect(bound);
            if (is_err[types.Stream, io_error.Error](client_result)) { ret 3; }
            var client: types.Stream = unwrap_ok[types.Stream, io_error.Error](client_result);
            val server_result: Result[types.Stream, io_error.Error] = accept(?listener);
            if (is_err[types.Stream, io_error.Error](server_result)) { ret 4; }
            var server: types.Stream = unwrap_ok[types.Stream, io_error.Error](server_result);
            if (is_err[bool, io_error.Error](stream_close(?client)) || is_err[bool, io_error.Error](stream_close(?server))) { ret 5; }
            if (is_err[bool, io_error.Error](listener_close(?listener))) { ret 6; }
            ret 0;
        }
    }
}

$if ($mach.build.os == $mach.os.windows) {
    ext fun GetCurrentProcess() isize;
    ext fun GetProcessHandleCount(process: isize, count: *u32) i32;

    fun test_windows_handle_count(count: *u32) bool {
        ret count != nil && GetProcessHandleCount(GetCurrentProcess(), count) != 0;
    }

    fun test_windows_name(output: *u8) usize {
        val prefix: str = "mach-std-local-502-";
        var length: usize = 0;
        for (prefix[length] != 0) {
            output[length] = prefix[length];
            length = length + 1;
        }
        var process: u64 = os.getpid()::u64;
        var digits: [20]u8;
        var count: usize = 0;
        if (process == 0) {
            digits[0] = '0';
            count = 1;
        }
        for (process != 0) {
            digits[count] = '0' + (process % 10)::u8;
            process = process / 10;
            count = count + 1;
        }
        var i: usize = 0;
        for (i < count) {
            output[length] = digits[count - i - 1];
            length = length + 1;
            i = i + 1;
        }
        output[length] = '.';
        output[length + 1] = 's';
        output[length + 2] = 'o';
        output[length + 3] = 'c';
        output[length + 4] = 'k';
        output[length + 5] = 0;
        ret length + 5;
    }

    test "local stream: windows lifecycle limits and identity capability" {
        val capabilities: endpoint.Capabilities = endpoint.capabilities();
        if (!capabilities.stream || !capabilities.filesystem
            || capabilities.abstract || capabilities.target_names
            || capabilities.peer_process || capabilities.peer_user || capabilities.peer_group
            || !capabilities.owned_cleanup || capabilities.listener_rename
            || capabilities.stale_cleanup || capabilities.custom_permissions) {
            ret 1;
        }
        var name: [108]u8;
        val length: usize = test_windows_name(?name[0]);
        val endpoint_result: Result[endpoint.Endpoint, io_error.Error] = filesystem_bytes(?name[0], length);
        if (is_err[endpoint.Endpoint, io_error.Error](endpoint_result)) { ret 2; }
        val bound: endpoint.Endpoint = unwrap_ok[endpoint.Endpoint, io_error.Error](endpoint_result);
        var unsupported: types.ListenOptions = default_listen_options();
        unsupported.stale = REMOVE_STALE_SOCKET;
        if (!is_err[types.Listener, io_error.Error](listen(bound, unsupported))) { ret 3; }
        unsupported = default_listen_options();
        unsupported.permissions = 0x180;
        if (!is_err[types.Listener, io_error.Error](listen(bound, unsupported))) { ret 4; }

        var baseline: u32 = 0;
        var round: usize = 0;
        for (round < 17) {
            val listener_result: Result[types.Listener, io_error.Error] = listen(bound, default_listen_options());
            if (is_err[types.Listener, io_error.Error](listener_result)) { ret 6; }
            var listener: types.Listener = unwrap_ok[types.Listener, io_error.Error](listener_result);
            val client_result: Result[types.Stream, io_error.Error] = connect(bound);
            if (is_err[types.Stream, io_error.Error](client_result)) { ret 7; }
            var client: types.Stream = unwrap_ok[types.Stream, io_error.Error](client_result);
            val server_result: Result[types.Stream, io_error.Error] = accept(?listener);
            if (is_err[types.Stream, io_error.Error](server_result)) { ret 8; }
            var server: types.Stream = unwrap_ok[types.Stream, io_error.Error](server_result);
            val identity_result: Result[types.PeerIdentity, io_error.Error] = peer_identity(?server);
            if (!is_err[types.PeerIdentity, io_error.Error](identity_result)
                || unwrap_err[types.PeerIdentity, io_error.Error](identity_result).code != os.ENOTSUP) {
                ret 9;
            }
            var byte: u8 = round::u8;
            val sent: Result[usize, io_error.Error] = stream_write(?client, ?byte, 1);
            if (is_err[usize, io_error.Error](sent) || unwrap_ok[usize, io_error.Error](sent) != 1) { ret 10; }
            byte = 0;
            val received: Result[usize, io_error.Error] = stream_read(?server, ?byte, 1);
            if (is_err[usize, io_error.Error](received)
                || unwrap_ok[usize, io_error.Error](received) != 1
                || byte != round::u8) {
                ret 11;
            }
            if (is_err[bool, io_error.Error](stream_shutdown_write(?client))) { ret 12; }
            val ended: Result[usize, io_error.Error] = stream_read(?server, ?byte, 1);
            if (is_err[usize, io_error.Error](ended) || unwrap_ok[usize, io_error.Error](ended) != 0) { ret 13; }
            if (is_err[bool, io_error.Error](stream_close(?client))
                || is_err[bool, io_error.Error](stream_close(?server))
                || is_err[bool, io_error.Error](listener_close(?listener))) {
                ret 14;
            }
            if (round == 0 && !test_windows_handle_count(?baseline)) { ret 5; }
            round = round + 1;
        }
        var after: u32 = 0;
        if (!test_windows_handle_count(?after) || after != baseline) { ret 15; }
        ret 0;
    }
}
