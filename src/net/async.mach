# portable bounded asynchronous TCP and UDP
#
# ownership: a socket this driver has seen in a submission is closed through
# the driver (submit_stream_close, submit_datagram_close), never directly. a
# socket closed outside the driver is detected on its next submission through
# either handle: the old socket's pending work completes CLOSED with code 0,
# a submission through the old handle is refused the same way, and the socket
# that now holds the native value keeps its own state. the driver tells the
# two apart by the handle's opening (std.io.handle.socket), so wrap a native
# socket once and pass that handle around
#
# cancellation: an operation cancelled through its scope completes CANCELLED
# once the platform gives up its buffers. on windows that happens when the
# aborted request reports back, so the completion can arrive after the cancel
# returns and destroy stays busy until it does (awaiting_cancellations). a read
# whose data raced the cancel still completes cancelled and its bytes are lost
# (submit_read, discarded_reads)

use std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error:  std.io.error;
use io_handle: std.io.handle;
use std.io.lifecycle;
use io_runtime: std.io.runtime;
use std.memory;
use std.memory.table;
use std.net.ip;
use socket_api: std.net.socket;
use std.net.tcp;
use std.net.udp;
use std.sync.cancel;
use std.sync.mutex;
use std.sync.thread;
use std.system.os;
use std.system.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.net.async.types;

# test predicates: `sel` takes a place, so an inline call is tested through these
fun refused(r: err[io_error.Error]) bool {
    ret sel r.err;
}

fun ok_err(r: err[io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_bool(r: res[bool, io_error.Error]) bool {
    ret sel r.ok;
}

fun ok_token(r: res[io_runtime.Token, io_error.Error]) bool {
    ret sel r.ok;
}

fun scope_ok(r: cancel.Operation) bool {
    ret sel r.ok;
}

fun scope_changed(r: cancel.Transition) bool {
    if (sel r.ok) { ret r.ok; }
    ret false;
}

fun waited_one(r: res[usize, io_error.Error]) bool {
    ret sel r.ok && r.ok == 1;
}

$if ($mach.build.os == $mach.os.linux) {
    use impl: std.net.async.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use impl: std.net.async.darwin;
}
$or ($mach.build.os == $mach.os.windows) {
    use impl: std.net.async.windows;
}
$or {
    $error("std.net.async: unsupported target");
}

fwd types.Vector;
fwd types.Packet;

val SLOT_FREE:   u8 = 0;
val SLOT_ACTIVE: u8 = 1;

rec Slot {
    state:         u8;
    generation:    u32;
    native_active: bool;
    owns_resource: bool;
    native:        types.Token;
    kind:          io_runtime.Kind;
    resource:      usize;
    opening:       u64;
}

# the driver borrows one io runtime and never creates a second native queue
pub rec Driver {
    runtime: *io_runtime.Runtime;
    source:  io_runtime.SourceToken;
    backend: impl.Backend;
    # where every table's chunks come from
    allocator:         allocator.Allocator;
    slots:             table.Table;
    slot_count:        usize;
    backend_destroyed: bool;
    lock:              mutex.Mutex;
}

# whether a byte range overlaps the driver, its platform backend or its
# borrowed runtime. the contract is std.io.runtime.aliases's
pub fun aliases(driver: *Driver, data: *u8, len: usize) bool {
    if (!memory.range_valid(data, len)) { ret true; }
    if (len == 0)                       { ret false; }
    if (!memory.range_valid(driver::*u8, $size_of(Driver)) ||
        driver.runtime == nil || driver.slots.capacity == 0 ||
        driver.backend_destroyed) { ret true; }
    ret memory.ranges_overlap(driver::*u8, $size_of(Driver), data, len) ||
        table.aliases(?driver.slots, data, len) ||
        io_runtime.aliases(driver.runtime, data, len) ||
        impl.aliases(?driver.backend, data, len);
}

fun slot_at(driver: *Driver, index: usize) *Slot {
    ret table.at(?driver.slots, index)::*Slot;
}

fun init_slot(driver: *Driver, index: usize) {
    val slot: *Slot = slot_at(driver, index);
    slot.state         = SLOT_FREE;
    slot.generation    = 0;
    slot.native_active = false;
    slot.owns_resource = false;
}

# the runtime owns the index space, so the driver grows to whatever it hands out
fun ensure_slot(driver: *Driver, index: usize) *Slot {
    if (!table.reserve(?driver.slots, index + 1)) { ret nil; }
    for (driver.slot_count <= index) {
        init_slot(driver, driver.slot_count);
        driver.slot_count = driver.slot_count + 1;
    }
    ret slot_at(driver, index);
}

fun invalid(operation: io_error.Operation) io_error.Error {
    ret io_error.make(io_error.INVALID, operation);
}

fun exhausted(operation: io_error.Operation) io_error.Error {
    ret io_error.make(io_error.RESOURCE_EXHAUSTED, operation);
}

fun operation_for_kind(kind: io_runtime.Kind) io_error.Operation {
    if (kind == io_runtime.ACCEPT)       { ret io_error.OP_ACCEPT; }
    if (kind == io_runtime.CONNECT)      { ret io_error.OP_CONNECT; }
    if (kind == io_runtime.READ)         { ret io_error.OP_READ; }
    if (kind == io_runtime.READABLE)     { ret io_error.OP_READ; }
    if (kind == io_runtime.WRITE)        { ret io_error.OP_WRITE; }
    if (kind == io_runtime.RECEIVE_FROM) { ret io_error.OP_RECEIVE; }
    if (kind == io_runtime.SEND_TO)      { ret io_error.OP_SEND; }
    if (kind == io_runtime.SHUTDOWN)     { ret io_error.OP_SHUTDOWN; }
    if (kind == io_runtime.CLOSE)        { ret io_error.OP_CLOSE; }
    ret io_error.OP_UNKNOWN;
}

fun token_context(token: io_runtime.Token) usize {
    ret ((token.generation::u64 << 32) | (token.index::u64 + 1))::usize;
}

fun context_token(context: usize, token: *io_runtime.Token) bool {
    val raw: u64 = context::u64;
    val low: u64 = raw & 0xffffffff;
    if (token == nil || low == 0) { ret false; }
    token.index      = (low - 1)::u32;
    token.generation = (raw >> 32)::u32;
    ret token.generation != 0;
}

fun slot_for(driver: *Driver, token: io_runtime.Token) *Slot {
    if (token.index::usize >= driver.slot_count) { ret nil; }
    val slot: *Slot = slot_at(driver, token.index::usize);
    if (slot.state != SLOT_ACTIVE || slot.generation != token.generation) { ret nil; }
    ret slot;
}

fun publish_backend_locked(driver: *Driver, count: usize) {
    var i: usize = 0;
    for (i < count) {
        var native: types.NativeCompletion;
        if (impl.completion(?driver.backend, i, ?native) < 0) {
            panic.panic("std.net.async: target completion ownership failed\n");
        }
        resolve_native_locked(driver, native);
        i = i + 1;
    }
}

fun source_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    val driver: *Driver = context::*Driver;
    mutex.lock(?driver.lock);
    var claimed: bool = false;
    var count:   i64  = 0;
    if (native_context == 0) {
        count = impl.flush(?driver.backend);
    }
    or {
        count = impl.dispatch(?driver.backend, native_context, events, status, flags, ?claimed);
    }
    if (count < 0) {
        mutex.unlock(?driver.lock);
        panic.panic("std.net.async: native dispatch failed\n");
    }
    publish_backend_locked(driver, count::usize);
    mutex.unlock(?driver.lock);
    ret claimed;
}

fun source_cancel(context: ptr, token: io_runtime.Token, reason: io_error.Error) i64 {
    val driver:     *Driver             = context::*Driver;
    val controlled: err[io_error.Error] = io_runtime.begin_native_control(driver.runtime);
    if (sel controlled.err) {
        ret controlled.err.code;
    }
    mutex.lock(?driver.lock);
    val slot: *Slot = slot_for(driver, token);
    var code: i64   = 0;
    if (slot != nil && slot.native_active) {
        code = impl.cancel(?driver.backend, slot.native);
        # a pending cancellation keeps the kernel's hold until its packet is published
        if (code >= 0 && code != io_runtime.CANCELLATION_PENDING) { slot.native_active = false; }
    }
    mutex.unlock(?driver.lock);
    io_runtime.end_native_control(driver.runtime);
    ret code;
}

fun source_release(context: ptr, completion: *io_runtime.Completion) {
    val driver: *Driver = context::*Driver;
    mutex.lock(?driver.lock);
    cleanup_locked(driver, completion);
    mutex.unlock(?driver.lock);
}

# the driver starts at the runtime's initial size and grows with it
pub fun make(driver: *Driver, runtime: *io_runtime.Runtime) err[io_error.Error] {
    if (driver == nil || runtime == nil || runtime.initial == 0) {
        ret err[io_error.Error].err{invalid(io_error.OP_CREATE)};
    }
    val capacity:  usize                = runtime.initial;
    val allocated: err[allocator.Error] = page.make(?driver.allocator);
    if (sel allocated.err) { ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)}; }
    if (!table.make(?driver.slots, ?driver.allocator, $size_of(Slot), capacity)) {
        ret err[io_error.Error].err{exhausted(io_error.OP_CREATE)};
    }
    driver.runtime           = runtime;
    driver.slot_count        = 0;
    driver.backend_destroyed = false;
    driver.lock              = mutex.make();
    val registered: res[io_runtime.SourceToken, io_error.Error] = io_runtime.register_source(
        runtime,
        driver::ptr,
        source_dispatch,
        source_cancel,
        source_release,
    );
    if (sel registered.err) {
        table.destroy(?driver.slots);
        driver.runtime = nil;
        ret err[io_error.Error].err{registered.err};
    }
    driver.source = registered.ok;
    val code: i64 = impl.make(?driver.backend, ?runtime.queue, capacity, io_runtime.source_id(driver.source));
    if (code < 0) {
        io_runtime.unregister_source(runtime, driver.source);
        table.destroy(?driver.slots);
        driver.runtime = nil;
        ret err[io_error.Error].err{os.error(code, io_error.OP_CREATE)};
    }
    ret err[io_error.Error].ok{};
}

fun claim_locked(
    driver: *Driver,
    scope: *cancel.Scope,
    kind: io_runtime.Kind,
    resource: usize,
    opening: u64,
    buffer: *u8,
    length: usize,
    context: usize,
    token: *io_runtime.Token,
) res[bool, io_error.Error] {
    val operation: io_runtime.Operation = io_runtime.Operation{
        kind:     kind,
        resource: resource,
        buffer:   buffer,
        length:   length,
        offset:   0,
        context:  context,
    };
    val submitted: res[io_runtime.Token, io_error.Error] = io_runtime.submit_scoped_owned(driver.runtime, driver.source, scope, operation);
    if (sel submitted.err) {
        ret res[bool, io_error.Error].err{submitted.err};
    }
    @token = submitted.ok;
    val slot: *Slot = ensure_slot(driver, token.index::usize);
    if (slot == nil) {
        io_runtime.fail(driver.runtime, @token, exhausted(io_error.OP_SUBMIT));
        ret res[bool, io_error.Error].ok{false};
    }
    if (slot.state != SLOT_FREE) {
        io_runtime.fail(driver.runtime, @token, io_error.make(io_error.BUSY, io_error.OP_SUBMIT));
        ret res[bool, io_error.Error].ok{false};
    }
    slot.state         = SLOT_ACTIVE;
    slot.generation    = token.generation;
    slot.native_active = false;
    slot.owns_resource = false;
    slot.kind          = kind;
    slot.resource      = resource;
    slot.opening       = opening;
    ret res[bool, io_error.Error].ok{true};
}

fun publish_submission(driver: *Driver, token: io_runtime.Token, native: types.Token, code: i64) {
    val slot: *Slot = slot_for(driver, token);
    if (slot == nil) { ret; }
    if (code >= 0) {
        slot.native        = native;
        slot.native_active = true;
    }
    or (code == types.STATUS_STALE) {
        io_runtime.fail(driver.runtime, token, io_error.make(io_error.CLOSED, operation_for_kind(slot.kind)));
    }
    or {
        io_runtime.fail(driver.runtime, token, os.error(code, operation_for_kind(slot.kind)));
    }
}

pub fun listen(endpoint: ip.Endpoint, backlog: i32) res[tcp.Listener, io_error.Error] {
    ret tcp.listen_with_flags(endpoint, backlog, socket_api.async_flags());
}

pub fun bind_datagram(endpoint: ip.Endpoint) res[udp.Socket, io_error.Error] {
    ret udp.bind_with_flags(endpoint, socket_api.async_flags());
}

# a nonblocking listener with explicit options, for this driver's runtime
# ---
# endpoint: endpoint to bind to
# options:  bind options (reuse_port for one listener per thread) and backlog
# ret:      the listener, or the refusal
pub fun listen_with(endpoint: ip.Endpoint, options: tcp.ListenOptions) res[tcp.Listener, io_error.Error] {
    ret tcp.listen_with_options(endpoint, options, socket_api.async_flags());
}

# a nonblocking datagram socket bound with explicit options
# ---
# endpoint: endpoint to bind to
# options:  options applied between creation and bind
# ret:      the socket, or the refusal
pub fun bind_datagram_with(endpoint: ip.Endpoint, options: socket_api.BindOptions) res[udp.Socket, io_error.Error] {
    ret udp.bind_with_options(endpoint, options, socket_api.async_flags());
}

pub fun create_datagram(family: i32) res[udp.Socket, io_error.Error] {
    ret udp.create_with_flags(family, socket_api.async_flags());
}

# the stream an accept or connect completion hands over
#
# the handle keeps the opening the driver recorded for the socket, so the
# driver knows the stream as the socket it accepted or connected
# ---
# completion: a successful ACCEPT or CONNECT completion from this driver
# ret:        the stream, which the caller now owns and closes through the driver
pub fun stream(completion: *io_runtime.Completion) tcp.Stream {
    ret tcp.Stream{handle: io_handle.SocketHandle{value: completion.resource, opening: completion.opening}};
}

# the socket is closed through this driver once submitted (module header)
pub fun submit_accept(
    driver: *Driver,
    scope: *cancel.Scope,
    listener: *tcp.Listener,
    peer: *ip.Endpoint,
    context: usize,
) res[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || listener == nil || !io_handle.socket_is_valid(listener.handle)) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_ACCEPT)};
    }
    mutex.lock(?driver.lock);
    var token:   io_runtime.Token;
    val claimed: res[bool, io_error.Error] = claim_locked(driver, scope, io_runtime.ACCEPT, listener.handle.value, listener.handle.opening, nil, 0, context, ?token);
    if (sel claimed.err) {
        mutex.unlock(?driver.lock);
        ret res[io_runtime.Token, io_error.Error].err{claimed.err};
    }
    if (claimed.ok) {
        var native: types.Token;
        val code:   i64 = impl.submit_accept(?driver.backend, listener.handle.value, listener.handle.opening, peer, token_context(token), ?native);
        publish_submission(driver, token, native, code);
    }
    mutex.unlock(?driver.lock);
    ret res[io_runtime.Token, io_error.Error].ok{token};
}

# the socket is closed through this driver once submitted (module header)
pub fun submit_connect(
    driver: *Driver,
    scope: *cancel.Scope,
    endpoint: ip.Endpoint,
    context: usize,
) res[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_CONNECT)};
    }
    val created: res[io_handle.SocketHandle, io_error.Error] = socket_api.create(ip.endpoint_family(endpoint), os.SOCK_STREAM, 0, socket_api.async_flags());
    if (sel created.err) {
        ret res[io_runtime.Token, io_error.Error].err{created.err};
    }
    val handle: io_handle.SocketHandle = created.ok;
    mutex.lock(?driver.lock);
    var token:   io_runtime.Token;
    val claimed: res[bool, io_error.Error] = claim_locked(driver, scope, io_runtime.CONNECT, handle.value, handle.opening, nil, 0, context, ?token);
    if (sel claimed.err) {
        os.sock_close(handle.value);
        mutex.unlock(?driver.lock);
        ret res[io_runtime.Token, io_error.Error].err{claimed.err};
    }
    if (claimed.ok) {
        val slot: *Slot = slot_for(driver, token);
        slot.owns_resource = true;
        var native: types.Token;
        val code:   i64 = impl.submit_connect(?driver.backend, handle.value, handle.opening, endpoint, token_context(token), ?native);
        publish_submission(driver, token, native, code);
    }
    or {
        os.sock_close(handle.value);
    }
    mutex.unlock(?driver.lock);
    ret res[io_runtime.Token, io_error.Error].ok{token};
}

fun submit_buffer(
    driver: *Driver,
    scope: *cancel.Scope,
    kind: io_runtime.Kind,
    handle: io_handle.SocketHandle,
    buffer: *u8,
    length: usize,
    context: usize,
) res[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || (buffer == nil && length != 0)) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(operation_for_kind(kind))};
    }
    mutex.lock(?driver.lock);
    var token:   io_runtime.Token;
    val claimed: res[bool, io_error.Error] = claim_locked(driver, scope, kind, handle.value, handle.opening, buffer, length, context, ?token);
    if (sel claimed.err) {
        mutex.unlock(?driver.lock);
        ret res[io_runtime.Token, io_error.Error].err{claimed.err};
    }
    if (claimed.ok) {
        var native: types.Token;
        var code:   i64;
        if (kind == io_runtime.READ) {
            code = impl.submit_read(?driver.backend, handle.value, handle.opening, buffer, length, token_context(token), ?native);
        }
        or (kind == io_runtime.READABLE) {
            code = impl.submit_readable(?driver.backend, handle.value, handle.opening, token_context(token), ?native);
        }
        or {
            code = impl.submit_write(?driver.backend, handle.value, handle.opening, buffer, length, token_context(token), ?native);
        }
        publish_submission(driver, token, native, code);
    }
    mutex.unlock(?driver.lock);
    ret res[io_runtime.Token, io_error.Error].ok{token};
}

# the socket is closed through this driver once submitted (module header)
#
# cancelling a read is not free on every platform. on windows a read the kernel
# already holds is aborted asynchronously, and if data arrived first the read
# still completes as cancelled: its bytes are discarded although the peer
# considers them delivered, and the stream has silently lost them. a caller that
# needs every byte must not cancel a pending read to stop waiting. use a
# deadline, then keep reading until the stream drains. discarded_reads counts
# the reads this happened to
pub fun submit_read(driver: *Driver, scope: *cancel.Scope, stream: *tcp.Stream, buffer: *u8, length: usize, context: usize) res[io_runtime.Token, io_error.Error] {
    if (stream == nil || !io_handle.socket_is_valid(stream.handle)) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_READ)};
    }
    ret submit_buffer(driver, scope, io_runtime.READ, stream.handle, buffer, length, context);
}

# wait until the stream is readable, at orderly end of stream, or failed, without
# holding a buffer
#
# the completion has kind READABLE and zero bytes: ok with end_of_stream false
# means at least one byte can be read now, ok with end_of_stream true means the
# peer closed and nothing is left, and an error is the socket's failure. nothing
# is read. the wait queues in order with reads on the same stream, so a read
# submitted after it completes after it. a TLS layer may already hold decrypted
# bytes the socket no longer shows, so check that buffer before waiting here.
# the socket is closed through this driver once submitted (module header)
# ---
# driver:  the driver the stream belongs to
# scope:   the cancellation scope the wait is registered on
# stream:  the stream to wait on
# context: returned with the completion
# ret:     the wait's token, or the refusal
pub fun submit_readable(driver: *Driver, scope: *cancel.Scope, stream: *tcp.Stream, context: usize) res[io_runtime.Token, io_error.Error] {
    if (stream == nil || !io_handle.socket_is_valid(stream.handle)) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_READ)};
    }
    ret submit_buffer(driver, scope, io_runtime.READABLE, stream.handle, nil, 0, context);
}

# the socket is closed through this driver once submitted (module header)
pub fun submit_write(driver: *Driver, scope: *cancel.Scope, stream: *tcp.Stream, buffer: *u8, length: usize, context: usize) res[io_runtime.Token, io_error.Error] {
    if (stream == nil || !io_handle.socket_is_valid(stream.handle)) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_WRITE)};
    }
    ret submit_buffer(driver, scope, io_runtime.WRITE, stream.handle, buffer, length, context);
}

# the socket is closed through this driver once submitted (module header)
pub fun submit_write_vector(
    driver: *Driver,
    scope: *cancel.Scope,
    stream: *tcp.Stream,
    vectors: *types.Vector,
    count: usize,
    context: usize,
) res[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || stream == nil || !io_handle.socket_is_valid(stream.handle) || vectors == nil || count == 0) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_WRITE)};
    }
    mutex.lock(?driver.lock);
    var token:   io_runtime.Token;
    val claimed: res[bool, io_error.Error] = claim_locked(driver, scope, io_runtime.WRITE, stream.handle.value, stream.handle.opening, vectors::*u8, count, context, ?token);
    if (sel claimed.err) {
        mutex.unlock(?driver.lock);
        ret res[io_runtime.Token, io_error.Error].err{claimed.err};
    }
    if (claimed.ok) {
        var native: types.Token;
        val code:   i64 = impl.submit_write_vector(?driver.backend, stream.handle.value, stream.handle.opening, vectors, count, token_context(token), ?native);
        publish_submission(driver, token, native, code);
    }
    mutex.unlock(?driver.lock);
    ret res[io_runtime.Token, io_error.Error].ok{token};
}

fun submit_packets(
    driver: *Driver,
    scope: *cancel.Scope,
    kind: io_runtime.Kind,
    socket: *udp.Socket,
    packets: *types.Packet,
    count: usize,
    context: usize,
) res[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || socket == nil || !io_handle.socket_is_valid(socket.handle) || packets == nil || count == 0) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(operation_for_kind(kind))};
    }
    mutex.lock(?driver.lock);
    var token:   io_runtime.Token;
    val claimed: res[bool, io_error.Error] = claim_locked(driver, scope, kind, socket.handle.value, socket.handle.opening, packets::*u8, count, context, ?token);
    if (sel claimed.err) {
        mutex.unlock(?driver.lock);
        ret res[io_runtime.Token, io_error.Error].err{claimed.err};
    }
    if (claimed.ok) {
        var native: types.Token;
        var code:   i64;
        if (kind == io_runtime.RECEIVE_FROM) {
            code = impl.submit_receive_batch(?driver.backend, socket.handle.value, socket.handle.opening, packets, count, token_context(token), ?native);
        }
        or {
            code = impl.submit_send_batch(?driver.backend, socket.handle.value, socket.handle.opening, packets, count, token_context(token), ?native);
        }
        publish_submission(driver, token, native, code);
    }
    mutex.unlock(?driver.lock);
    ret res[io_runtime.Token, io_error.Error].ok{token};
}

# receive up to count datagrams into packets
#
# the completion arrives as soon as at least one datagram is available and
# carries every datagram already queued, up to count. it never waits for the
# batch to fill, so its items are between 1 and count
# ---
# driver:  the driver the socket belongs to
# scope:   the cancellation scope the operation is registered on
# socket:  the datagram socket
# packets: count packets whose buffer and capacity describe the storage. the
#          storage is borrowed until the operation completes
# count:   the most datagrams one completion carries
# context: returned with the completion
# ret:     the operation's token, or the refusal
#
# the socket is closed through this driver once submitted (module header)
pub fun submit_receive_batch(driver: *Driver, scope: *cancel.Scope, socket: *udp.Socket, packets: *types.Packet, count: usize, context: usize) res[io_runtime.Token, io_error.Error] {
    ret submit_packets(driver, scope, io_runtime.RECEIVE_FROM, socket, packets, count, context);
}

# the socket is closed through this driver once submitted (module header)
pub fun submit_send_batch(driver: *Driver, scope: *cancel.Scope, socket: *udp.Socket, packets: *types.Packet, count: usize, context: usize) res[io_runtime.Token, io_error.Error] {
    ret submit_packets(driver, scope, io_runtime.SEND_TO, socket, packets, count, context);
}

fun submit_control(
    driver: *Driver,
    scope: *cancel.Scope,
    kind: io_runtime.Kind,
    handle: io_handle.SocketHandle,
    context: usize,
    accepted: *bool,
) res[io_runtime.Token, io_error.Error] {
    @accepted = false;
    mutex.lock(?driver.lock);
    var token:   io_runtime.Token;
    val claimed: res[bool, io_error.Error] = claim_locked(driver, scope, kind, handle.value, handle.opening, nil, 0, context, ?token);
    if (sel claimed.err) {
        mutex.unlock(?driver.lock);
        ret res[io_runtime.Token, io_error.Error].err{claimed.err};
    }
    if (claimed.ok) {
        var native: types.Token;
        var code:   i64;
        if (kind == io_runtime.SHUTDOWN) {
            code = impl.submit_shutdown_write(?driver.backend, handle.value, handle.opening, token_context(token), ?native);
        }
        or {
            code = impl.submit_close(?driver.backend, handle.value, handle.opening, token_context(token), ?native);
        }
        publish_submission(driver, token, native, code);
        @accepted = code >= 0;
    }
    mutex.unlock(?driver.lock);
    ret res[io_runtime.Token, io_error.Error].ok{token};
}

# the socket is closed through this driver once submitted (module header)
pub fun submit_shutdown_write(driver: *Driver, scope: *cancel.Scope, stream: *tcp.Stream, context: usize) res[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || stream == nil || !io_handle.socket_is_valid(stream.handle)) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_SHUTDOWN)};
    }
    var accepted: bool = false;
    ret submit_control(driver, scope, io_runtime.SHUTDOWN, stream.handle, context, ?accepted);
}

# close a stream the driver knows about
#
# a tracked stream is closed here or with submit_shutdown_write, not with
# tcp.stream_close, so the backend unregisters it. a graceful close shuts the
# write side down, and an abortive close cancels pending reads and closes it
# a direct close is detected on next use and never hands the stream's state to
# the socket that reuses its value (module header)
pub fun submit_stream_close(
    driver: *Driver,
    scope: *cancel.Scope,
    stream: *tcp.Stream,
    mode: lifecycle.Mode,
    context: usize,
) res[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || stream == nil || mode > lifecycle.ABORTIVE) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    if (!io_handle.socket_is_valid(stream.handle)) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.CLOSED, io_error.OP_CLOSE)};
    }
    if (mode == lifecycle.GRACEFUL) {
        ret submit_shutdown_write(driver, scope, stream, context);
    }
    var accepted:  bool                                  = false;
    val submitted: res[io_runtime.Token, io_error.Error] = submit_control(driver, scope, io_runtime.CLOSE, stream.handle, context, ?accepted);
    if (accepted) { stream.handle = io_handle.invalid_socket(); }
    ret submitted;
}

# close a datagram socket the driver knows about
#
# a tracked socket is closed here, not with udp.socket_close, so the backend
# unregisters it. every receive still pending on it completes cancelled
# a direct close is detected on next use and never hands the socket's state to
# the socket that reuses its value (module header)
pub fun submit_datagram_close(driver: *Driver, scope: *cancel.Scope, socket: *udp.Socket, context: usize) res[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || socket == nil || !io_handle.socket_is_valid(socket.handle)) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    var accepted:  bool                                  = false;
    val submitted: res[io_runtime.Token, io_error.Error] = submit_control(driver, scope, io_runtime.CLOSE, socket.handle, context, ?accepted);
    if (accepted) { socket.handle = io_handle.invalid_socket(); }
    ret submitted;
}

# close a listener the driver knows about
#
# a listener that has had an accept submitted is tracked by the driver and is
# closed here, not with tcp.listener_close, so the backend unregisters it.
# every accept still pending on it completes cancelled. on success the
# listener's handle is invalidated, and the close completes as its own
# operation
# ---
# driver:   the driver the listener belongs to
# scope:    the cancellation scope the close is registered on
# listener: the listener to close
# context:  returned with the close's completion
# ret:      the close's token, or the refusal
pub fun submit_listener_close(driver: *Driver, scope: *cancel.Scope, listener: *tcp.Listener, context: usize) res[io_runtime.Token, io_error.Error] {
    if (driver == nil || scope == nil || listener == nil || !io_handle.socket_is_valid(listener.handle)) {
        ret res[io_runtime.Token, io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    var accepted:  bool                                  = false;
    val submitted: res[io_runtime.Token, io_error.Error] = submit_control(driver, scope, io_runtime.CLOSE, listener.handle, context, ?accepted);
    if (accepted) { listener.handle = io_handle.invalid_socket(); }
    ret submitted;
}

fun cleanup_locked(driver: *Driver, completion: *io_runtime.Completion) {
    val slot: *Slot = slot_for(driver, completion.token);
    if (slot == nil) { ret; }
    if (slot.native_active) {
        panic.panic("std.net.async: completion released before native quiescence\n");
    }
    if (slot.owns_resource && completion.has_error && slot.resource != io_handle.INVALID_VALUE) {
        os.sock_close(slot.resource);
    }
    slot.state         = SLOT_FREE;
    slot.owns_resource = false;
}

fun resolve_native_locked(driver: *Driver, native: types.NativeCompletion) {
    var token: io_runtime.Token;
    if (!context_token(native.context, ?token)) { ret; }
    val slot: *Slot = slot_for(driver, token);
    if (slot == nil || native.kind != slot.kind) {
        if (native.kind == io_runtime.ACCEPT && native.status >= 0 && native.resource != io_handle.INVALID_VALUE) {
            os.sock_close(native.resource);
        }
        ret;
    }
    slot.native_active = false;
    if (native.status == types.STATUS_CANCELLED) {
        val cancelled: err[io_error.Error] = io_runtime.complete_cancellation(driver.runtime, token);
        if (sel cancelled.err) {
            panic.panic("std.net.async: asynchronous cancellation lost operation ownership\n");
        }
        ret;
    }
    var resolved: err[io_error.Error];
    if (native.status == types.STATUS_STALE) {
        resolved = io_runtime.fail(driver.runtime, token, io_error.make(io_error.CLOSED, operation_for_kind(native.kind)));
    }
    or (native.status < 0) {
        resolved = io_runtime.fail(driver.runtime, token, os.error(native.status, operation_for_kind(native.kind)));
    }
    or (native.kind == io_runtime.ACCEPT) {
        val accepted: io_handle.SocketHandle = io_handle.socket(native.resource);
        resolved = io_runtime.complete_opened(driver.runtime, token, accepted.value, accepted.opening);
    }
    or (native.kind == io_runtime.CONNECT) {
        resolved = io_runtime.complete_opened(driver.runtime, token, slot.resource, slot.opening);
    }
    or (native.kind == io_runtime.RECEIVE_FROM || native.kind == io_runtime.SEND_TO) {
        resolved = io_runtime.complete_batch(driver.runtime, token, native.bytes, native.items, native.resource);
    }
    or {
        resolved = io_runtime.complete(driver.runtime, token, native.bytes, native.resource, native.end_of_stream);
    }
    if (sel resolved.err && native.kind == io_runtime.ACCEPT && native.status >= 0 && native.resource != io_handle.INVALID_VALUE) {
        os.sock_close(native.resource);
    }
}

# reads cancelled on this driver whose data had already arrived, so their bytes
# were discarded (see submit_read). a nonzero count means the peer sent bytes
# this program never saw: a protocol that cannot lose bytes must stop cancelling
# pending reads. always 0 on linux and darwin, which never discard a read
# ---
# driver: the driver to query
# bytes:  receives the total bytes discarded, when not nil
# ret:    the number of discarded reads since make
pub fun discarded_reads(driver: *Driver, bytes: *u64) u64 {
    if (bytes != nil)                           { @bytes = 0; }
    if (driver == nil || driver.runtime == nil) { ret 0; }
    $if ($mach.build.os == $mach.os.windows) {
        ret impl.discarded_reads(?driver.backend, bytes);
    }
    $or {
        ret 0;
    }
}

# operations cancelled on this driver whose native request has not yet
# reported back. each one keeps the driver busy, so a destroy that keeps
# refusing with a nonzero count is waiting for the kernel, which a caller
# settles by continuing to wait. always 0 on linux and darwin, which cancel
# synchronously
pub fun awaiting_cancellations(driver: *Driver) usize {
    if (driver == nil || driver.runtime == nil) { ret 0; }
    $if ($mach.build.os == $mach.os.windows) {
        ret impl.awaiting_cancellations(?driver.backend);
    }
    $or {
        ret 0;
    }
}

# one thread owns wait; submission may run concurrently
# returns 0 only on timeout, a caller's io.runtime.wake, or a closed runtime
pub fun wait(
    driver: *Driver,
    output: *io_runtime.Completion,
    output_capacity: usize,
    timeout_ms: i32,
) res[usize, io_error.Error] {
    if (driver == nil || output == nil || output_capacity == 0 || timeout_ms < -1) {
        ret res[usize, io_error.Error].err{invalid(io_error.OP_WAIT)};
    }
    val waited: res[usize, io_error.Error] = io_runtime.wait(driver.runtime, output, output_capacity, timeout_ms);
    if (sel waited.err) { ret res[usize, io_error.Error].err{waited.err}; }
    ret res[usize, io_error.Error].ok{waited.ok};
}

pub fun destroy(driver: *Driver) err[io_error.Error] {
    if (driver == nil || driver.runtime == nil) {
        ret err[io_error.Error].err{invalid(io_error.OP_CLOSE)};
    }
    mutex.lock(?driver.lock);
    var i: usize = 0;
    for (i < driver.slot_count) {
        if (slot_at(driver, i).state != SLOT_FREE) {
            mutex.unlock(?driver.lock);
            ret err[io_error.Error].err{io_error.make(io_error.BUSY, io_error.OP_CLOSE)};
        }
        i = i + 1;
    }
    mutex.unlock(?driver.lock);
    val retired: res[bool, io_error.Error] = io_runtime.retire_source(driver.runtime, driver.source);
    if (sel retired.err) {
        ret err[io_error.Error].err{retired.err};
    }
    mutex.lock(?driver.lock);
    if (!driver.backend_destroyed) {
        val code: i64 = impl.destroy(?driver.backend);
        if (code < 0) {
            mutex.unlock(?driver.lock);
            ret err[io_error.Error].err{os.error(code, io_error.OP_CLOSE)};
        }
        driver.backend_destroyed = true;
    }
    mutex.unlock(?driver.lock);
    val released_source: err[io_error.Error] = io_runtime.release_source(driver.runtime, driver.source);
    if (sel released_source.err) {
        ret err[io_error.Error].err{released_source.err};
    }
    mutex.lock(?driver.lock);
    val released: err[allocator.Error] = table.destroy(?driver.slots);
    driver.slot_count = 0;
    driver.runtime    = nil;
    mutex.unlock(?driver.lock);
    if (sel released.err) {
        if (sel released.err.release) {
            ret err[io_error.Error].err{os.error(released.err.release, io_error.OP_CLOSE)};
        }
        ret err[io_error.Error].err{io_error.make(io_error.IO, io_error.OP_CLOSE)};
    }
    ret err[io_error.Error].ok{};
}

test "async network: ownership query includes driver backend and runtime" {
    var runtime:  io_runtime.Runtime;
    var external: [8]u8;
    var empty:    Driver;
    if (!aliases(?empty, ?external[0], 1) ||
        !aliases((~(0::usize) - 1)::*Driver, ?external[0], 1) ||
        !ok_err(io_runtime.make(?runtime, 2))) { ret 1; }
    var partial: impl.Backend;
    partial.queue = ?runtime.queue;
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        partial.operations.capacity = 2;
        partial.map_capacity        = 4;
    }
    $or {
        partial.operations.capacity = 2;
    }
    if (!impl.aliases(?partial, ?external[0], 1) ||
        !impl.aliases((~(0::usize) - 1)::*impl.Backend,
        ?external[0], 1)) { ret 2; }
    var driver:      Driver;
    val make_result: err[io_error.Error] = make(?driver, ?runtime);
    if (sel make_result.err) { ret 3; }
    if (!aliases(?driver, (?driver)::*u8, $size_of(Driver)) ||
        !aliases(?driver, driver.slots.chunks[0]::*u8, $size_of(Slot) * 2) ||
        !aliases(?driver, (?driver.backend)::*u8, $size_of(impl.Backend)) ||
        !aliases(?driver, driver.backend.operations.chunks[0]::*u8, 1) ||
        !aliases(?driver, runtime.slots.chunks[0]::*u8, 1) ||
        aliases(?driver, ?external[0], 8) ||
        aliases(?driver, (~(0::usize))::*u8, 1) ||
        !aliases(?driver, (~(0::usize) - 1)::*u8, 3)) { ret 4; }
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
        if (!aliases(?driver, driver.backend.resources.chunks[0]::*u8, 1) ||
            !aliases(?driver, driver.backend.resource_map::*u8, 1) ||
            !aliases(?driver, driver.backend.native::*u8, 1) ||
            !aliases(?driver, driver.backend.ready.chunks[0]::*u8, 1)) { ret 5; }
    }
    $or {
        if (!aliases(?driver, driver.backend.core.sockets.chunks[0]::*u8, 1) ||
            !aliases(?driver, driver.backend.core.socket_map::*u8, 1) ||
            !aliases(?driver, driver.backend.native::*u8, 1) ||
            !aliases(?driver, driver.backend.completions.chunks[0]::*u8, 1)) { ret 5; }
    }
    if (refused(destroy(?driver)) ||
        !aliases(?driver, ?external[0], 1) ||
        !ok_bool(io_runtime.close(?runtime)) ||
        !ok_err(io_runtime.destroy(?runtime))) { ret 6; }
    ret 0;
}

test "async network: graceful and abortive stream close traces are distinct" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 2))) { ret 1; }
    var driver:      Driver;
    val make_result: err[io_error.Error] = make(?driver, ?runtime);
    if (sel make_result.err) { ret 2; }
    val listener_result: res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 2);
    if (sel listener_result.err) { ret 3; }
    var listener:        tcp.Listener                     = listener_result.ok;
    val endpoint_result: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?listener);
    if (sel endpoint_result.err) { ret 4; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 5; }
    # the listener is non-blocking, and darwin can return from a loopback
    # connect before the listener's queue holds the connection, so a direct
    # accept could see EAGAIN; the driver's accept waits for readiness instead
    var peer:          ip.Endpoint;
    val accept_result: res[io_runtime.Token, io_error.Error] = submit_accept(?driver, ?scope, ?listener, ?peer, 120);
    if (sel accept_result.err) { ret 6; }
    val client_result: res[tcp.Stream, io_error.Error] = tcp.connect(endpoint_result.ok);
    if (sel client_result.err) { ret 6; }
    var client: tcp.Stream = client_result.ok;
    var output: io_runtime.Completion;
    if (!waited_one(wait(?driver, ?output, 1, 1000))
        || output.has_error
        || output.kind != io_runtime.ACCEPT
        || output.context != 120) {
        ret 7;
    }
    var server: tcp.Stream = stream(?output);
    if (!io_handle.socket_is_valid(server.handle)) { ret 7; }
    val graceful: res[io_runtime.Token, io_error.Error] = submit_stream_close(?driver, ?scope, ?server, lifecycle.GRACEFUL, 121);
    if (sel graceful.err) { ret 8; }
    val graceful_wait: res[usize, io_error.Error] = wait(?driver, ?output, 1, 1000);
    if (!(sel graceful_wait.ok && graceful_wait.ok == 1)
        || output.has_error
        || output.kind != io_runtime.SHUTDOWN
        || output.context != 121
        || !io_handle.socket_is_valid(server.handle)) {
        ret 9;
    }
    val abortive: res[io_runtime.Token, io_error.Error] = submit_stream_close(?driver, ?scope, ?server, lifecycle.ABORTIVE, 122);
    if (sel abortive.err) { ret 10; }
    val abortive_wait: res[usize, io_error.Error] = wait(?driver, ?output, 1, 1000);
    if (!(sel abortive_wait.ok && abortive_wait.ok == 1)
        || output.has_error
        || output.kind != io_runtime.CLOSE
        || output.context != 122
        || io_handle.socket_is_valid(server.handle)) {
        ret 11;
    }
    val duplicate: res[io_runtime.Token, io_error.Error] = submit_stream_close(?driver, ?scope, ?server, lifecycle.ABORTIVE, 123);
    if (!(sel duplicate.err && duplicate.err.kind == io_error.CLOSED)) {
        ret 12;
    }
    if (refused(tcp.stream_close(?client))
        || refused(tcp.listener_close(?listener))
        || !scope_ok(cancel.destroy(?scope))
        || refused(destroy(?driver))
        || !ok_bool(io_runtime.close(?runtime))
        || !ok_err(io_runtime.destroy(?runtime))) {
        ret 13;
    }
    ret 0;
}

test "async network: cancellation reclaims target and runtime ownership" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 1))) { ret 1; }
    var driver:      Driver;
    val make_result: err[io_error.Error] = make(?driver, ?runtime);
    if (sel make_result.err) {
        io_runtime.close(?runtime);
        io_runtime.destroy(?runtime);
        ret 2;
    }
    val listener_result: res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 2);
    if (sel listener_result.err) {
        destroy(?driver);
        io_runtime.close(?runtime);
        io_runtime.destroy(?runtime);
        ret 3;
    }
    var listener:    tcp.Listener = listener_result.ok;
    var peer:        ip.Endpoint;
    var first_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?first_scope, opt[time.Instant].none{}))) { ret 4; }
    val first_result: res[io_runtime.Token, io_error.Error] = submit_accept(?driver, ?first_scope, ?listener, ?peer, 71);
    if (sel first_result.err)                        { ret 5; }
    if (!scope_changed(cancel.cancel(?first_scope))) { ret 5; }
    val first:      io_runtime.Token           = first_result.ok;
    var output:     [1]io_runtime.Completion;
    val first_wait: res[usize, io_error.Error] = wait(?driver, ?output[0], 1, 1000);
    if (!(sel first_wait.ok && first_wait.ok == 1)
        || !output[0].has_error
        || output[0].error.kind != io_error.CANCELLED
        || output[0].context != 71
        || !scope_ok(cancel.destroy(?first_scope))) {
        ret 6;
    }

    var second_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?second_scope, opt[time.Instant].none{}))) { ret 7; }
    val second_result: res[io_runtime.Token, io_error.Error] = submit_accept(?driver, ?second_scope, ?listener, ?peer, 72);
    if (sel second_result.err)                        { ret 8; }
    if (!scope_changed(cancel.cancel(?second_scope))) { ret 8; }
    val second: io_runtime.Token = second_result.ok;
    if (second.index != first.index || second.generation == first.generation) { ret 9; }
    val second_wait: res[usize, io_error.Error] = wait(?driver, ?output[0], 1, 1000);
    if (!(sel second_wait.ok && second_wait.ok == 1)
        || !output[0].has_error
        || output[0].error.kind != io_error.CANCELLED
        || output[0].context != 72
        || !scope_ok(cancel.destroy(?second_scope))) {
        ret 10;
    }
    val listener_close_result: err[io_error.Error] = tcp.listener_close(?listener);
    if (sel listener_close_result.err) { ret 11; }
    val destroy_result: err[io_error.Error] = destroy(?driver);
    if (sel destroy_result.err)                { ret 12; }
    if (!ok_bool(io_runtime.close(?runtime)))  { ret 13; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 14; }
    ret 0;
}

test "async network: one runtime dispatches independent drivers" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 4))) { ret 1; }
    var first_driver:  Driver;
    var second_driver: Driver;
    val make_result:   err[io_error.Error] = make(?first_driver, ?runtime);
    if (sel make_result.err) { ret 2; }
    val make_result2: err[io_error.Error] = make(?second_driver, ?runtime);
    if (sel make_result2.err) { ret 3; }
    val first_listener_result:  res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 2);
    val second_listener_result: res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 2);
    if (sel first_listener_result.err)  { ret 4; }
    if (sel second_listener_result.err) { ret 4; }
    var first_listener:         tcp.Listener                     = first_listener_result.ok;
    var second_listener:        tcp.Listener                     = second_listener_result.ok;
    val first_endpoint_result:  res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?first_listener);
    val second_endpoint_result: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?second_listener);
    if (sel first_endpoint_result.err)  { ret 5; }
    if (sel second_endpoint_result.err) { ret 5; }
    var first_scope:  cancel.Scope;
    var second_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?first_scope, opt[time.Instant].none{})) || !scope_ok(cancel.make_root(?second_scope, opt[time.Instant].none{}))) { ret 6; }
    var first_peer:    ip.Endpoint;
    var second_peer:   ip.Endpoint;
    val first_accept:  res[io_runtime.Token, io_error.Error] = submit_accept(?first_driver, ?first_scope, ?first_listener, ?first_peer, 101);
    val second_accept: res[io_runtime.Token, io_error.Error] = submit_accept(?second_driver, ?second_scope, ?second_listener, ?second_peer, 102);
    if (sel first_accept.err)  { ret 7; }
    if (sel second_accept.err) { ret 7; }
    val first_client_result:  res[tcp.Stream, io_error.Error] = tcp.connect(first_endpoint_result.ok);
    val second_client_result: res[tcp.Stream, io_error.Error] = tcp.connect(second_endpoint_result.ok);
    if (sel first_client_result.err)  { ret 8; }
    if (sel second_client_result.err) { ret 8; }
    var first_client:  tcp.Stream = first_client_result.ok;
    var second_client: tcp.Stream = second_client_result.ok;
    var output:        [2]io_runtime.Completion;
    var total:         usize      = 0;
    var saw_first:     bool       = false;
    var saw_second:    bool       = false;
    for (total < 2) {
        val waited: res[usize, io_error.Error] = io_runtime.wait(?runtime, ?output[total], 2 - total, 1000);
        if (sel waited.err) { ret 9; }
        val count: usize = waited.ok;
        if (count == 0) { ret 10; }
        var i: usize = 0;
        for (i < count) {
            val completion: *io_runtime.Completion = ?output[total + i];
            if (completion.has_error || completion.kind != io_runtime.ACCEPT) { ret 11; }
            if (completion.context == 101)                                    { saw_first = true; }
            or (completion.context == 102)                                    { saw_second = true; }
            or                                                                { ret 12; }
            os.sock_close(completion.resource);
            i = i + 1;
        }
        total = total + count;
    }
    tcp.stream_close(?first_client);
    tcp.stream_close(?second_client);
    tcp.listener_close(?first_listener);
    tcp.listener_close(?second_listener);
    if (!scope_ok(cancel.destroy(?first_scope)) || !scope_ok(cancel.destroy(?second_scope))) { ret 13; }
    if (!saw_first || !saw_second)                                                           { ret 14; }
    if (refused(destroy(?first_driver)) || refused(destroy(?second_driver)))                 { ret 15; }
    if (!ok_bool(io_runtime.close(?runtime)) || !ok_err(io_runtime.destroy(?runtime)))       { ret 16; }
    ret 0;
}

# growth must not move a driver slot a completion context already refers to
test "async network: work outstanding across a growth completes for its owner" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 1))) { ret 1; }
    var first_driver:  Driver;
    var second_driver: Driver;
    if (refused(make(?first_driver, ?runtime)))  { ret 2; }
    if (refused(make(?second_driver, ?runtime))) { ret 2; }
    val first_listener_result:  res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 2);
    val second_listener_result: res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 2);
    if (sel first_listener_result.err)  { ret 3; }
    if (sel second_listener_result.err) { ret 3; }
    var first_listener:         tcp.Listener                     = first_listener_result.ok;
    var second_listener:        tcp.Listener                     = second_listener_result.ok;
    val first_endpoint_result:  res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?first_listener);
    val second_endpoint_result: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?second_listener);
    if (sel first_endpoint_result.err)  { ret 4; }
    if (sel second_endpoint_result.err) { ret 4; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 5; }
    var first_peer:    ip.Endpoint;
    var second_peer:   ip.Endpoint;
    val first_accept:  res[io_runtime.Token, io_error.Error] = submit_accept(?first_driver, ?scope, ?first_listener, ?first_peer, 201);
    val second_accept: res[io_runtime.Token, io_error.Error] = submit_accept(?second_driver, ?scope, ?second_listener, ?second_peer, 202);
    if (sel first_accept.err)  { ret 6; }
    if (sel second_accept.err) { ret 6; }
    val held: *Slot = slot_at(?first_driver, first_accept.ok.index::usize);

    # keep growing the runtime while both accepts stay outstanding
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret 7; }
    val far:     time.Instant = time.Instant{sec: now.ok.sec + 3600, nsec: now.ok.nsec};
    var pending: usize        = 0;
    for (pending < 300) {
        if (!ok_token(io_runtime.submit_timer(?runtime, far, 900 + pending))) { ret 8; }
        pending = pending + 1;
    }
    if (io_runtime.capacity(?runtime) < 302)                          { ret 9; }
    if (slot_at(?first_driver, first_accept.ok.index::usize) != held) { ret 10; }
    if (held.generation != first_accept.ok.generation)                { ret 10; }

    val first_client_result:  res[tcp.Stream, io_error.Error] = tcp.connect(first_endpoint_result.ok);
    val second_client_result: res[tcp.Stream, io_error.Error] = tcp.connect(second_endpoint_result.ok);
    if (sel first_client_result.err)  { ret 11; }
    if (sel second_client_result.err) { ret 11; }
    var first_client:  tcp.Stream = first_client_result.ok;
    var second_client: tcp.Stream = second_client_result.ok;
    var output:        [8]io_runtime.Completion;
    var accepted:      usize      = 0;
    var saw_first:     bool       = false;
    var saw_second:    bool       = false;
    var rounds:        usize      = 0;
    for (accepted < 2 && rounds < 64) {
        val waited: res[usize, io_error.Error] = io_runtime.wait(?runtime, ?output[0], 8, 1000);
        if (sel waited.err) { ret 12; }
        var i: usize = 0;
        for (i < waited.ok) {
            val completion: *io_runtime.Completion = ?output[i];
            if (completion.kind == io_runtime.ACCEPT) {
                if (completion.has_error)      { ret 13; }
                if (completion.context == 201) { saw_first = true; }
                or (completion.context == 202) { saw_second = true; }
                or                             { ret 13; }
                os.sock_close(completion.resource);
                accepted = accepted + 1;
            }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if (!saw_first || !saw_second) { ret 14; }

    tcp.stream_close(?first_client);
    tcp.stream_close(?second_client);
    tcp.listener_close(?first_listener);
    tcp.listener_close(?second_listener);
    if (!scope_ok(cancel.destroy(?scope)))    { ret 15; }
    if (!ok_bool(io_runtime.close(?runtime))) { ret 16; }
    var drained: usize = 0;
    for (drained < 300) {
        val waited: res[usize, io_error.Error] = io_runtime.wait(?runtime, ?output[0], 8, 1000);
        if (sel waited.err) { ret 17; }
        if (waited.ok == 0) { ret 17; }
        drained = drained + waited.ok;
    }
    if (refused(destroy(?first_driver)))       { ret 18; }
    if (refused(destroy(?second_driver)))      { ret 18; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 19; }
    ret 0;
}

test "async network: runtime close quiesces native ownership before dequeue" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 1))) { ret 1; }
    var driver:      Driver;
    val make_result: err[io_error.Error] = make(?driver, ?runtime);
    if (sel make_result.err) { ret 2; }
    val listener_result: res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 2);
    if (sel listener_result.err) { ret 3; }
    var listener: tcp.Listener = listener_result.ok;
    var scope:    cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 4; }
    var peer:      ip.Endpoint;
    val submitted: res[io_runtime.Token, io_error.Error] = submit_accept(?driver, ?scope, ?listener, ?peer, 111);
    if (sel submitted.err) { ret 5; }
    val closed: res[bool, io_error.Error] = io_runtime.close(?runtime);
    if (sel closed.err) { ret 6; }
    if (!closed.ok)     { ret 6; }
    var completion: io_runtime.Completion;
    val waited:     res[usize, io_error.Error] = io_runtime.wait(?runtime, ?completion, 1, 1000);
    if (sel waited.err)                           { ret 7; }
    if (waited.ok != 1)                           { ret 7; }
    if (completion.context != 111)                { ret 7; }
    if (!completion.has_error)                    { ret 7; }
    if (completion.error.kind != io_error.CLOSED) { ret 7; }
    if (!scope_ok(cancel.destroy(?scope)))        { ret 8; }
    val listener_close_result: err[io_error.Error] = tcp.listener_close(?listener);
    if (sel listener_close_result.err) { ret 9; }
    val destroy_result: err[io_error.Error] = destroy(?driver);
    if (sel destroy_result.err)                { ret 10; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 11; }
    ret 0;
}

val STARVED_PEERS:  usize = 8;
val STARVED_ROUNDS: usize = 16;
val STARVED_BUFFER: usize = 64;

# a queued completion keeps wait from blocking, so a loop that always has one
# is paced instead, bounding it by time rather than by how fast it spins
val PACED_ROUNDS:  usize = 2000;
val PACE_NSEC:     i64   = 1000000;
val PAIR_ATTEMPTS: usize = 10;

# one resource whose writes complete at submission must not keep the native
# queue from being polled for every other resource's readiness
test "async network: a resource completing at submission starves no reader" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 64))) { ret 1; }
    var driver: Driver;
    if (!ok_err(make(?driver, ?runtime))) { ret 2; }
    val listener_result: res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 16);
    if (sel listener_result.err) { ret 3; }
    var listener:        tcp.Listener                     = listener_result.ok;
    val endpoint_result: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?listener);
    if (sel endpoint_result.err) { ret 4; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 5; }

    var servers: [9]tcp.Stream;
    var clients: [9]tcp.Stream;
    var peer:    ip.Endpoint;
    var output:  [16]io_runtime.Completion;
    var i:       usize = 0;
    for (i < STARVED_PEERS + 1) {
        val accepted: res[io_runtime.Token, io_error.Error] = submit_accept(?driver, ?scope, ?listener, ?peer, 200 + i);
        if (sel accepted.err) { ret 6; }
        val client_result: res[tcp.Stream, io_error.Error] = tcp.connect(endpoint_result.ok);
        if (sel client_result.err) { ret 7; }
        clients[i] = client_result.ok;
        if (!waited_one(wait(?driver, ?output[0], 1, 1000))
            || output[0].has_error
            || output[0].kind != io_runtime.ACCEPT) {
            ret 8;
        }
        servers[i] = stream(?output[0]);
        if (!io_handle.socket_is_valid(servers[i].handle)) { ret 8; }
        i = i + 1;
    }

    # the readers arm before their peers write, so their readiness reaches the
    # runtime only through the native queue
    var read_storage: [576]u8;
    i = 1;
    for (i < STARVED_PEERS + 1) {
        val submitted: res[io_runtime.Token, io_error.Error] = submit_read(?driver, ?scope, ?servers[i], ?read_storage[i * STARVED_BUFFER], STARVED_BUFFER, 300 + i);
        if (sel submitted.err) { ret 9; }
        i = i + 1;
    }
    var payload: [1]u8;
    payload[0] = 7;
    i          = 1;
    for (i < STARVED_PEERS + 1) {
        val written: res[usize, io_error.Error] = tcp.stream_write(?clients[i], ?payload[0], 1);
        if (!(sel written.ok && written.ok == 1)) { ret 10; }
        i = i + 1;
    }

    # the busy peer never reads, so every write fits the send buffer and
    # completes inside its own submission
    var busy_payload: [64]u8;
    val busy:         res[io_runtime.Token, io_error.Error] = submit_write(?driver, ?scope, ?servers[0], ?busy_payload[0], STARVED_BUFFER, 400);
    if (sel busy.err) { ret 11; }

    var reads:  usize = 0;
    var writes: usize = 0;
    var rounds: usize = 0;
    for (reads < STARVED_PEERS && rounds < PACED_ROUNDS) {
        if (rounds != 0) { os.sleep(PACE_NSEC); }
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 16, 1000);
        if (sel waited.err) { ret 12; }
        var j: usize = 0;
        for (j < waited.ok) {
            if (output[j].has_error) { ret 13; }
            if (output[j].kind == io_runtime.WRITE) {
                writes = writes + 1;
                val next: res[io_runtime.Token, io_error.Error] = submit_write(?driver, ?scope, ?servers[0], ?busy_payload[0], STARVED_BUFFER, 400);
                if (sel next.err) { ret 14; }
            }
            or (output[j].kind == io_runtime.READ) {
                if (output[j].bytes != 1) { ret 15; }
                reads = reads + 1;
            }
            or { ret 16; }
            j = j + 1;
        }
        rounds = rounds + 1;
    }
    if (reads != STARVED_PEERS) { ret 17; }
    if (writes == 0)            { ret 18; }

    var guard: usize = 0;
    for (io_runtime.pending(?runtime) > 0 && guard < STARVED_ROUNDS) {
        val drained: res[usize, io_error.Error] = wait(?driver, ?output[0], 16, 1000);
        if (sel drained.err) { ret 19; }
        guard = guard + 1;
    }
    if (io_runtime.pending(?runtime) != 0) { ret 20; }

    i = 0;
    for (i < STARVED_PEERS + 1) {
        tcp.stream_close(?servers[i]);
        tcp.stream_close(?clients[i]);
        i = i + 1;
    }
    if (refused(tcp.listener_close(?listener))) { ret 21; }
    if (!scope_ok(cancel.destroy(?scope)))      { ret 22; }
    if (refused(destroy(?driver)))              { ret 23; }
    if (!ok_bool(io_runtime.close(?runtime)))   { ret 24; }
    if (!ok_err(io_runtime.destroy(?runtime)))  { ret 25; }
    ret 0;
}

# a contract test, not a regression test: nothing here was broken, and the fix
# is downstream. one wait may return a completion that was already queued
# together with one its own collect has just produced, so a consumer that acts
# on a call carrying at most one completion per resource is wrong.
#
# this pins #658's behaviour rather than a version-independent rule. against the
# pre-#658 shape, where wait flushed without collecting, every attempt returns
# the queued write alone and this fails at 17. a batch of more than one was always
# possible there, but only out of a single collect, never mixing a queued
# completion with a fresh one (#670).
#
# darwin can land the byte after the send returns, so an attempt whose wait
# misses it settles the read alone and starts over with a longer pause.
test "async network: one wait returns a queued completion and a collected one together" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 16))) { ret 1; }
    var driver: Driver;
    if (!ok_err(make(?driver, ?runtime))) { ret 2; }
    val listener_result: res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 4);
    if (sel listener_result.err) { ret 3; }
    var listener:        tcp.Listener                     = listener_result.ok;
    val endpoint_result: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?listener);
    if (sel endpoint_result.err) { ret 4; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 5; }

    var peer:     ip.Endpoint;
    var output:   [8]io_runtime.Completion;
    val accepted: res[io_runtime.Token, io_error.Error] = submit_accept(?driver, ?scope, ?listener, ?peer, 700);
    if (sel accepted.err) { ret 6; }
    val client_result: res[tcp.Stream, io_error.Error] = tcp.connect(endpoint_result.ok);
    if (sel client_result.err) { ret 7; }
    var client: tcp.Stream = client_result.ok;
    if (!waited_one(wait(?driver, ?output[0], 1, 1000)) || output[0].kind != io_runtime.ACCEPT) { ret 8; }
    var server: tcp.Stream = stream(?output[0]);

    var inbound:  [4]u8;
    var outbound: [4]u8;
    var payload:  [1]u8;
    outbound[0] = 9;
    payload[0]  = 3;
    var paired:  bool  = false;
    var attempt: usize = 0;
    var pause:   i64   = PACE_NSEC;
    for (!paired && attempt < PAIR_ATTEMPTS) {
        # the read is armed before its peer writes, so its completion can only
        # come from this runtime's own native collect
        val reading: res[io_runtime.Token, io_error.Error] = submit_read(?driver, ?scope, ?server, ?inbound[0], 4, 701);
        if (sel reading.err) { ret 9; }
        # the write fits the send buffer, so it completes inside its own
        # submission and is queued behind the collect rather than produced by it
        val writing: res[io_runtime.Token, io_error.Error] = submit_write(?driver, ?scope, ?server, ?outbound[0], 4, 702);
        if (sel writing.err) { ret 10; }
        val sent: res[usize, io_error.Error] = tcp.stream_write(?client, ?payload[0], 1);
        if (!(sel sent.ok && sent.ok == 1)) { ret 11; }
        # the pause changes when the byte lands, not what the wait may return
        os.sleep(pause);
        val batch: res[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
        if (sel batch.err) { ret 12; }
        var reads:  usize = 0;
        var writes: usize = 0;
        var i:      usize = 0;
        for (i < batch.ok) {
            if (output[i].has_error)                { ret 13; }
            if (output[i].kind == io_runtime.READ)  { reads = reads + 1; }
            or (output[i].kind == io_runtime.WRITE) { writes = writes + 1; }
            or                                      { ret 14; }
            i = i + 1;
        }
        if (writes != 1 || reads > 1) { ret 15; }
        if (reads == 1) {
            paired = true;
        }
        or {
            if (!waited_one(wait(?driver, ?output[0], 1, 1000)) || output[0].has_error || output[0].kind != io_runtime.READ) { ret 16; }
            pause = pause * 2;
        }
        attempt = attempt + 1;
    }
    if (!paired) { ret 17; }

    var guard: usize = 0;
    for (io_runtime.pending(?runtime) > 0 && guard < 16) {
        val drained: res[usize, io_error.Error] = wait(?driver, ?output[0], 8, 1000);
        if (sel drained.err) { ret 18; }
        guard = guard + 1;
    }
    if (io_runtime.pending(?runtime) != 0) { ret 19; }

    tcp.stream_close(?server);
    tcp.stream_close(?client);
    if (refused(tcp.listener_close(?listener))) { ret 20; }
    if (!scope_ok(cancel.destroy(?scope)))      { ret 21; }
    if (refused(destroy(?driver)))              { ret 22; }
    if (!ok_bool(io_runtime.close(?runtime)))   { ret 23; }
    if (!ok_err(io_runtime.destroy(?runtime)))  { ret 24; }
    ret 0;
}

val FLOOD_ROUNDS:   usize = 400;
val FLOOD_BURST:    usize = 64;
val FLOOD_PAYLOAD:  usize = 512;
val FLOOD_PACKETS:  usize = 4;
val FLOOD_RCVBUF:   i32   = 4096;
val FLOOD_IDLE_MAX: usize = 3;

# bytes queued on a datagram socket, 0 when the count cannot be read. the flood
# tests treat a round as idle only while datagrams sit queued behind a pending
# receive: a loopback that drops a whole burst leaves nothing to receive, and
# darwin does that under receive-buffer overflow
$if ($mach.build.os == $mach.os.linux) {
    use linux_os: std.system.os.linux;

    $if ($mach.build.arch == $mach.arch.x86_64) {
        val FLOOD_SYS_IOCTL: usize = 16;
    }
    $or {
        val FLOOD_SYS_IOCTL: usize = 29;
    }

    fun flood_queued(fd: usize) usize {
        var count:  i32 = 0;
        val status: i64 = linux_os.syscall3(FLOOD_SYS_IOCTL, fd, 0x541b, (?count)::usize);
        if (status < 0 || count < 0) { ret 0; }
        ret count::usize;
    }
}
$or ($mach.build.os == $mach.os.darwin) {
    val FLOOD_SO_NREAD: i32 = 0x1020;

    fun flood_queued(fd: usize) usize {
        var count:  i32 = 0;
        var length: u32 = 4;
        val status: i64 = os.sock_getopt(fd, os.SOL_SOCKET, FLOOD_SO_NREAD, (?count)::*u8, ?length);
        if (status < 0 || count < 0) { ret 0; }
        ret count::usize;
    }
}
$or ($mach.build.os == $mach.os.windows) {
    use windows_os: std.system.os.windows;

    fun flood_queued(fd: usize) usize {
        var count: usize = 0;
        if (windows_os.sock_pending_bytes(fd, ?count) < 0) { ret 0; }
        ret count;
    }
}

# one pending receive and steady sends share a udp socket whose receive buffer
# a peer keeps overflowing. a wait that returns no receive while datagrams stay
# queued behind the pending receive has lost its readiness (#711)
test "async network: a pending datagram receive survives receive-buffer overflow under concurrent sends" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 16))) { ret 1; }
    var driver: Driver;
    if (!ok_err(make(?driver, ?runtime))) { ret 2; }
    val receiver_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel receiver_result.err) { ret 3; }
    var receiver:       udp.Socket                      = receiver_result.ok;
    val flooder_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel flooder_result.err) { ret 4; }
    var flooder: udp.Socket = flooder_result.ok;
    var rcvbuf:  i32        = FLOOD_RCVBUF;
    if (os.sock_setopt(receiver.handle.value, os.SOL_SOCKET, os.SO_RCVBUF, (?rcvbuf)::*u8, 4) < 0) { ret 5; }
    val receiver_endpoint: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?receiver);
    if (sel receiver_endpoint.err) { ret 6; }
    val flooder_endpoint: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?flooder);
    if (sel flooder_endpoint.err) { ret 7; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 8; }

    var inbound_storage:  [2048]u8;
    var outbound_storage: [2048]u8;
    var inbound:          [4]types.Packet;
    var outbound:         [4]types.Packet;
    var i:                usize = 0;
    for (i < FLOOD_PACKETS) {
        inbound[i].buffer    = ?inbound_storage[i * FLOOD_PAYLOAD];
        inbound[i].capacity  = FLOOD_PAYLOAD;
        outbound[i].buffer   = ?outbound_storage[i * FLOOD_PAYLOAD];
        outbound[i].capacity = FLOOD_PAYLOAD;
        outbound[i].length   = 16;
        outbound[i].peer     = flooder_endpoint.ok;
        i                    = i + 1;
    }
    val first_receive: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?scope, ?receiver, ?inbound[0], FLOOD_PACKETS, 900);
    if (sel first_receive.err) { ret 9; }
    val first_send: res[io_runtime.Token, io_error.Error] = submit_send_batch(?driver, ?scope, ?receiver, ?outbound[0], FLOOD_PACKETS, 901);
    if (sel first_send.err) { ret 10; }

    var datagram: [512]u8;
    var sink:     [512]u8;
    var output:   [16]io_runtime.Completion;
    var received: usize = 0;
    var idle:     usize = 0;
    var round:    usize = 0;
    for (round < FLOOD_ROUNDS) {
        var burst: usize = 0;
        for (burst < FLOOD_BURST) {
            val sent: res[usize, io_error.Error] = udp.send_to(?flooder, ?datagram[0], FLOOD_PAYLOAD, receiver_endpoint.ok);
            if (sel sent.err) { ret 20; }
            burst = burst + 1;
        }
        var drained: bool = true;
        for (drained) {
            var from:   ip.Endpoint;
            val pulled: res[usize, io_error.Error] = udp.recv_from(?flooder, ?sink[0], 512, ?from);
            drained = sel pulled.ok;
        }
        val queued: bool                       = flood_queued(receiver.handle.value) != 0;
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 16, 200);
        if (sel waited.err) { ret 11; }
        var got: bool  = false;
        var j:   usize = 0;
        for (j < waited.ok) {
            if (output[j].has_error) { ret 12; }
            if (output[j].kind == io_runtime.RECEIVE_FROM) {
                got      = true;
                received = received + output[j].items;
                val next: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?scope, ?receiver, ?inbound[0], FLOOD_PACKETS, 900);
                if (sel next.err) { ret 13; }
            }
            or (output[j].kind == io_runtime.SEND_TO) {
                val again: res[io_runtime.Token, io_error.Error] = submit_send_batch(?driver, ?scope, ?receiver, ?outbound[0], FLOOD_PACKETS, 901);
                if (sel again.err) { ret 14; }
            }
            or { ret 15; }
            j = j + 1;
        }
        if (got || !queued || flood_queued(receiver.handle.value) == 0) { idle = 0; }
        or {
            idle = idle + 1;
            if (idle > FLOOD_IDLE_MAX) { ret 16; }
        }
        round = round + 1;
    }
    if (received == 0) { ret 17; }

    udp.socket_close(?flooder);
    val closed: res[io_runtime.Token, io_error.Error] = submit_datagram_close(?driver, ?scope, ?receiver, 902);
    if (sel closed.err) { ret 18; }
    var guard: usize = 0;
    for (io_runtime.pending(?runtime) > 0 && guard < 64) {
        val drained_wait: res[usize, io_error.Error] = wait(?driver, ?output[0], 16, 1000);
        if (sel drained_wait.err) { ret 19; }
        guard = guard + 1;
    }
    if (io_runtime.pending(?runtime) != 0)     { ret 20; }
    if (!scope_ok(cancel.destroy(?scope)))     { ret 21; }
    if (refused(destroy(?driver)))             { ret 22; }
    if (!ok_bool(io_runtime.close(?runtime)))  { ret 23; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 24; }
    ret 0;
}

val FLOOD_SENDS_MAX: i64   = 4;
val FLOOD_WAITS:     usize = 400;

rec FloodContext {
    driver:   *Driver;
    scope:    *cancel.Scope;
    receiver: *udp.Socket;
    flooder:  *udp.Socket;
    target:   ip.Endpoint;
    outbound: *types.Packet;
    lock:     mutex.Mutex;
    sends:    i64;
    stop:     bool;
    failed:   i64;
}

fun flood_worker(arg: *u8) {
    val context:  *FloodContext = arg::*FloodContext;
    var datagram: [512]u8;
    var sink:     [512]u8;
    for {
        mutex.lock(?context.lock);
        val stop:   bool = context.stop;
        var submit: bool = context.sends < FLOOD_SENDS_MAX;
        if (submit) { context.sends = context.sends + 1; }
        mutex.unlock(?context.lock);
        if (stop) { ret; }
        if (submit) {
            val sent: res[io_runtime.Token, io_error.Error] = submit_send_batch(context.driver, context.scope, context.receiver, context.outbound, FLOOD_PACKETS, 901);
            if (sel sent.err) {
                mutex.lock(?context.lock);
                context.failed = 1;
                mutex.unlock(?context.lock);
                ret;
            }
        }
        var burst: usize = 0;
        for (burst < FLOOD_BURST) {
            val flooded: res[usize, io_error.Error] = udp.send_to(context.flooder, ?datagram[0], FLOOD_PAYLOAD, context.target);
            if (sel flooded.err) {
                mutex.lock(?context.lock);
                context.failed = 1;
                mutex.unlock(?context.lock);
                ret;
            }
            burst = burst + 1;
        }
        var drained: bool = true;
        for (drained) {
            var from:   ip.Endpoint;
            val pulled: res[usize, io_error.Error] = udp.recv_from(context.flooder, ?sink[0], 512, ?from);
            drained = sel pulled.ok;
        }
        os.sleep(200000);
    }
}

# the same shape with the sends and the flood on a second thread, so
# submissions race the waiting thread's native collect (#711)
test "async network: a pending datagram receive survives overflow while another thread submits sends" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 16))) { ret 1; }
    var driver: Driver;
    if (!ok_err(make(?driver, ?runtime))) { ret 2; }
    val receiver_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel receiver_result.err) { ret 3; }
    var receiver:       udp.Socket                      = receiver_result.ok;
    val flooder_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel flooder_result.err) { ret 4; }
    var flooder: udp.Socket = flooder_result.ok;
    var rcvbuf:  i32        = FLOOD_RCVBUF;
    if (os.sock_setopt(receiver.handle.value, os.SOL_SOCKET, os.SO_RCVBUF, (?rcvbuf)::*u8, 4) < 0) { ret 5; }
    val receiver_endpoint: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?receiver);
    if (sel receiver_endpoint.err) { ret 6; }
    val flooder_endpoint: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?flooder);
    if (sel flooder_endpoint.err) { ret 7; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 8; }

    var inbound_storage:  [2048]u8;
    var outbound_storage: [2048]u8;
    var inbound:          [4]types.Packet;
    var outbound:         [4]types.Packet;
    var i:                usize = 0;
    for (i < FLOOD_PACKETS) {
        inbound[i].buffer    = ?inbound_storage[i * FLOOD_PAYLOAD];
        inbound[i].capacity  = FLOOD_PAYLOAD;
        outbound[i].buffer   = ?outbound_storage[i * FLOOD_PAYLOAD];
        outbound[i].capacity = FLOOD_PAYLOAD;
        outbound[i].length   = 16;
        outbound[i].peer     = flooder_endpoint.ok;
        i                    = i + 1;
    }
    val first_receive: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?scope, ?receiver, ?inbound[0], FLOOD_PACKETS, 900);
    if (sel first_receive.err) { ret 9; }

    var context: FloodContext = FloodContext{
        driver:   ?driver,
        scope:    ?scope,
        receiver: ?receiver,
        flooder:  ?flooder,
        target:   receiver_endpoint.ok,
        outbound: ?outbound[0],
        lock:     mutex.make(),
        sends:    0,
        stop:     false,
        failed:   0,
    };
    var worker: thread.Thread;
    thread.spawn_with(flood_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 10; }

    var output:   [16]io_runtime.Completion;
    var received: usize = 0;
    var idle:     usize = 0;
    var code:     i64   = 0;
    var waits:    usize = 0;
    for (waits < FLOOD_WAITS && code == 0) {
        val queued: bool                       = flood_queued(receiver.handle.value) != 0;
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 16, 200);
        if (sel waited.err) {
            code = 11;
            brk;
        }
        var got: bool  = false;
        var j:   usize = 0;
        for (j < waited.ok) {
            if (output[j].has_error) {
                code = 12;
                brk;
            }
            if (output[j].kind == io_runtime.RECEIVE_FROM) {
                got      = true;
                received = received + output[j].items;
                val next: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?scope, ?receiver, ?inbound[0], FLOOD_PACKETS, 900);
                if (sel next.err) {
                    code = 13;
                    brk;
                }
            }
            or (output[j].kind == io_runtime.SEND_TO) {
                mutex.lock(?context.lock);
                context.sends = context.sends - 1;
                mutex.unlock(?context.lock);
            }
            j = j + 1;
        }
        if (got || !queued || flood_queued(receiver.handle.value) == 0) { idle = 0; }
        or {
            idle = idle + 1;
            if (idle > FLOOD_IDLE_MAX) { code = 16; }
        }
        waits = waits + 1;
    }
    mutex.lock(?context.lock);
    context.stop = true;
    mutex.unlock(?context.lock);
    thread.join(?worker);
    if (code != 0)           { ret code::i32; }
    if (context.failed != 0) { ret 17; }
    if (received == 0)       { ret 18; }

    udp.socket_close(?flooder);
    val closed: res[io_runtime.Token, io_error.Error] = submit_datagram_close(?driver, ?scope, ?receiver, 902);
    if (sel closed.err) { ret 19; }
    var guard: usize = 0;
    for (io_runtime.pending(?runtime) > 0 && guard < 64) {
        val drained_wait: res[usize, io_error.Error] = wait(?driver, ?output[0], 16, 1000);
        if (sel drained_wait.err) { ret 20; }
        guard = guard + 1;
    }
    if (io_runtime.pending(?runtime) != 0)     { ret 21; }
    if (!scope_ok(cancel.destroy(?scope)))     { ret 22; }
    if (refused(destroy(?driver)))             { ret 23; }
    if (!ok_bool(io_runtime.close(?runtime)))  { ret 24; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 25; }
    ret 0;
}

val CHURN_CHILDREN: usize = 8;
val CHURN_SENDS:    usize = 4;
val CHURN_ROUNDS:   usize = 600;
val CHURN_PAYLOAD:  usize = 1400;

# hedge's shape on one thread: a scoped receive of sixteen, batch-of-one sends
# under child scopes that are cancelled mid-flight, a flood past the receive
# buffer, and enough operations to grow every table past its initial size (#711)
test "async network: a pending datagram receive survives cancelled sibling sends and table growth" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 4))) { ret 1; }
    var driver: Driver;
    if (!ok_err(make(?driver, ?runtime))) { ret 2; }
    val receiver_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel receiver_result.err) { ret 3; }
    var receiver:       udp.Socket                      = receiver_result.ok;
    val flooder_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel flooder_result.err) { ret 4; }
    var flooder: udp.Socket = flooder_result.ok;
    var rcvbuf:  i32        = FLOOD_RCVBUF;
    if (os.sock_setopt(receiver.handle.value, os.SOL_SOCKET, os.SO_RCVBUF, (?rcvbuf)::*u8, 4) < 0) { ret 5; }
    var sndbuf: i32 = FLOOD_RCVBUF;
    if (os.sock_setopt(receiver.handle.value, os.SOL_SOCKET, os.SO_SNDBUF, (?sndbuf)::*u8, 4) < 0) { ret 5; }
    val receiver_endpoint: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?receiver);
    if (sel receiver_endpoint.err) { ret 6; }
    val flooder_endpoint: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?flooder);
    if (sel flooder_endpoint.err) { ret 7; }
    var pump: cancel.Scope;
    if (!scope_ok(cancel.make_root(?pump, opt[time.Instant].none{}))) { ret 8; }

    var inbound_storage: [24000]u8;
    var inbound:         [16]types.Packet;
    var i:               usize = 0;
    for (i < 16) {
        inbound[i].buffer   = ?inbound_storage[i * 1500];
        inbound[i].capacity = 1500;
        i                   = i + 1;
    }
    var payload:  [1400]u8;
    var outbound: [32]types.Packet;
    i = 0;
    for (i < CHURN_CHILDREN * CHURN_SENDS) {
        outbound[i].buffer   = ?payload[0];
        outbound[i].capacity = CHURN_PAYLOAD;
        outbound[i].length   = CHURN_PAYLOAD;
        outbound[i].peer     = flooder_endpoint.ok;
        i                    = i + 1;
    }
    val first_receive: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?pump, ?receiver, ?inbound[0], 16, 900);
    if (sel first_receive.err) { ret 9; }

    var children:  [8]cancel.Scope;
    var live:      [8]bool;
    var pending:   [8]usize;
    var datagram:  [512]u8;
    var sink:      [1500]u8;
    var output:    [64]io_runtime.Completion;
    var received:  usize = 0;
    var idle:      usize = 0;
    var receiving: bool  = true;
    var round:     usize = 0;
    for (round < CHURN_ROUNDS) {
        var c: usize = 0;
        for (c < CHURN_CHILDREN) {
            if (!live[c]) {
                if (!scope_ok(cancel.make_child(?children[c], ?pump, opt[time.Instant].none{}))) { ret 10; }
                live[c] = true;
                var s: usize = 0;
                for (s < CHURN_SENDS) {
                    val sent: res[io_runtime.Token, io_error.Error] = submit_send_batch(?driver, ?children[c], ?receiver, ?outbound[c * CHURN_SENDS + s], 1, 1000 + c);
                    if (sel sent.err) { ret 11; }
                    pending[c] = pending[c] + 1;
                    s          = s + 1;
                }
            }
            c = c + 1;
        }
        # cancel a rotating half of the connections while their sends are in flight
        c = round % 2;
        for (c < CHURN_CHILDREN) {
            cancel.cancel(?children[c]);
            c = c + 2;
        }
        var burst: usize = 0;
        for (burst < FLOOD_BURST) {
            val sent: res[usize, io_error.Error] = udp.send_to(?flooder, ?datagram[0], FLOOD_PAYLOAD, receiver_endpoint.ok);
            if (sel sent.err) { ret 21; }
            burst = burst + 1;
        }
        var drained: bool = true;
        for (drained) {
            var from:   ip.Endpoint;
            val pulled: res[usize, io_error.Error] = udp.recv_from(?flooder, ?sink[0], 1500, ?from);
            drained = sel pulled.ok;
        }
        val queued: bool                       = receiving && flood_queued(receiver.handle.value) != 0;
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 64, 50);
        if (sel waited.err) { ret 12; }
        var got: bool  = false;
        var j:   usize = 0;
        for (j < waited.ok) {
            if (output[j].kind == io_runtime.RECEIVE_FROM) {
                if (output[j].has_error) { ret 13; }
                got       = true;
                receiving = false;
                received  = received + output[j].items;
            }
            or (output[j].kind == io_runtime.SEND_TO) {
                val owner: usize = output[j].context - 1000;
                if (owner >= CHURN_CHILDREN || pending[owner] == 0) { ret 14; }
                pending[owner] = pending[owner] - 1;
            }
            or { ret 15; }
            j = j + 1;
        }
        # the receive is resubmitted after the batch is handled, as hedge does
        if (!receiving) {
            val next: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?pump, ?receiver, ?inbound[0], 16, 900);
            if (sel next.err) { ret 16; }
            receiving = true;
        }
        c = 0;
        for (c < CHURN_CHILDREN) {
            if (live[c] && pending[c] == 0) {
                if (!scope_ok(cancel.destroy(?children[c]))) { ret 17; }
                live[c] = false;
            }
            c = c + 1;
        }
        if (got || !queued || flood_queued(receiver.handle.value) == 0) { idle = 0; }
        or {
            idle = idle + 1;
            if (idle > FLOOD_IDLE_MAX * 4) { ret 18; }
        }
        round = round + 1;
    }
    if (received == 0) { ret 19; }

    udp.socket_close(?flooder);
    val closed: res[io_runtime.Token, io_error.Error] = submit_datagram_close(?driver, ?pump, ?receiver, 902);
    if (sel closed.err) { ret 20; }
    var guard: usize = 0;
    for (io_runtime.pending(?runtime) > 0 && guard < 256) {
        val drained_wait: res[usize, io_error.Error] = wait(?driver, ?output[0], 64, 1000);
        if (sel drained_wait.err) { ret 21; }
        var j: usize = 0;
        for (j < drained_wait.ok) {
            if (output[j].kind == io_runtime.SEND_TO) {
                val owner: usize = output[j].context - 1000;
                pending[owner] = pending[owner] - 1;
            }
            j = j + 1;
        }
        guard = guard + 1;
    }
    if (io_runtime.pending(?runtime) != 0) { ret 22; }
    var c: usize = 0;
    for (c < CHURN_CHILDREN) {
        if (live[c] && !scope_ok(cancel.destroy(?children[c]))) { ret 23; }
        c = c + 1;
    }
    if (!scope_ok(cancel.destroy(?pump)))      { ret 24; }
    if (refused(destroy(?driver)))             { ret 25; }
    if (!ok_bool(io_runtime.close(?runtime)))  { ret 26; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 27; }
    ret 0;
}

# a receive batch completes with what is available: one datagram completes a
# pending batch of four with one item, on every backend (#718)
test "async network: a datagram receive batch completes with the packets available" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 4))) { ret 1; }
    var driver: Driver;
    if (!ok_err(make(?driver, ?runtime))) { ret 2; }
    val receiver_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel receiver_result.err) { ret 3; }
    var receiver:      udp.Socket                      = receiver_result.ok;
    val sender_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel sender_result.err) { ret 4; }
    var sender: udp.Socket                       = sender_result.ok;
    val target: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?receiver);
    if (sel target.err) { ret 5; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 6; }

    var storage: [256]u8;
    var packets: [4]types.Packet;
    var i:       usize = 0;
    for (i < 4) {
        packets[i].buffer   = ?storage[i * 64];
        packets[i].capacity = 64;
        i                   = i + 1;
    }
    val receiving: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?scope, ?receiver, ?packets[0], 4, 71);
    if (sel receiving.err) { ret 7; }
    var payload: [3]u8                      = [3]u8{7, 8, 9};
    val sent:    res[usize, io_error.Error] = udp.send_to(?sender, ?payload[0], 3, target.ok);
    if (!(sel sent.ok && sent.ok == 3)) { ret 8; }

    var output: [4]io_runtime.Completion;
    var items:  usize = 0;
    var done:   bool  = false;
    var rounds: usize = 0;
    for (!done && rounds < 8) {
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 250);
        if (sel waited.err) { ret 9; }
        var j: usize = 0;
        for (j < waited.ok) {
            if (output[j].context != 71 || output[j].has_error) { ret 10; }
            done  = true;
            items = output[j].items;
            j     = j + 1;
        }
        rounds = rounds + 1;
    }
    if (!done)                                                        { ret 11; }
    if (items != 1)                                                   { ret 12; }
    if (packets[0].length != 3 || storage[0] != 7 || storage[2] != 9) { ret 13; }

    udp.socket_close(?sender);
    val closing: res[io_runtime.Token, io_error.Error] = submit_datagram_close(?driver, ?scope, ?receiver, 72);
    if (sel closing.err) { ret 14; }
    var guard: usize = 0;
    for (io_runtime.pending(?runtime) > 0 && guard < 16) {
        val drained: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 1000);
        if (sel drained.err) { ret 15; }
        guard = guard + 1;
    }
    if (io_runtime.pending(?runtime) != 0)     { ret 16; }
    if (!scope_ok(cancel.destroy(?scope)))     { ret 17; }
    if (refused(destroy(?driver)))             { ret 18; }
    if (!ok_bool(io_runtime.close(?runtime)))  { ret 19; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 20; }
    ret 0;
}

fun listener_close_settles(pending_accept: bool) i32 {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 4))) { ret 1; }
    var driver: Driver;
    if (!ok_err(make(?driver, ?runtime))) { ret 2; }
    val listener_result: res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 2);
    if (sel listener_result.err) { ret 3; }
    var listener: tcp.Listener = listener_result.ok;
    var scope:    cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 4; }
    val before: usize = io_runtime.pending(?runtime);
    var peer:   ip.Endpoint;
    if (pending_accept) {
        val accepting: res[io_runtime.Token, io_error.Error] = submit_accept(?driver, ?scope, ?listener, ?peer, 501);
        if (sel accepting.err) { ret 5; }
    }
    val closing: res[io_runtime.Token, io_error.Error] = submit_listener_close(?driver, ?scope, ?listener, 502);
    if (sel closing.err)                            { ret 6; }
    if (io_handle.socket_is_valid(listener.handle)) { ret 7; }
    var output:     [4]io_runtime.Completion;
    var saw_accept: bool  = false;
    var saw_close:  bool  = false;
    var rounds:     usize = 0;
    for ((!saw_close || (pending_accept && !saw_accept)) && rounds < 16) {
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 1000);
        if (sel waited.err) { ret 8; }
        var i: usize = 0;
        for (i < waited.ok) {
            if (output[i].context == 501) {
                if (!output[i].has_error)                                                                  { ret 9; }
                if (output[i].error.kind != io_error.CANCELLED && output[i].error.kind != io_error.CLOSED) { ret 10; }
                saw_accept = true;
            }
            or (output[i].context == 502) {
                if (output[i].has_error || output[i].kind != io_runtime.CLOSE) { ret 11; }
                saw_close = true;
            }
            or { ret 12; }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if (!saw_close)                             { ret 13; }
    if (pending_accept && !saw_accept)          { ret 14; }
    if (io_runtime.pending(?runtime) != before) { ret 15; }
    val repeated: res[io_runtime.Token, io_error.Error] = submit_listener_close(?driver, ?scope, ?listener, 503);
    if (!sel repeated.err)                     { ret 16; }
    if (!scope_ok(cancel.destroy(?scope)))     { ret 17; }
    if (refused(destroy(?driver)))             { ret 18; }
    if (!ok_bool(io_runtime.close(?runtime)))  { ret 19; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 20; }
    ret 0;
}

# a tracked listener closes through its driver, and a pending accept on it
# completes cancelled (#724)
test "async network: a listener with a pending accept closes through its driver" {
    ret listener_close_settles(true);
}

test "async network: a listener with nothing pending closes through its driver" {
    ret listener_close_settles(false);
}

$if ($mach.build.os == $mach.os.linux) {
    use reuse_os: std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use reuse_os: std.system.os.darwin;
}

val REUSE_ATTEMPTS: usize = 32;

# closes stale's socket without its driver and opens a new socket under the
# same native value, the way an unrelated open does after an outside close
$if ($mach.build.os == $mach.os.windows) {
    fun replace_socket(stale: *udp.Socket, fresh: *udp.Socket) bool {
        var copy: udp.Socket = @stale;
        if (!ok_err(udp.socket_close(?copy))) { ret false; }
        var spare: [32]udp.Socket;
        var kept:  usize = 0;
        var found: bool  = false;
        for (!found && kept < REUSE_ATTEMPTS) {
            val opened: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
            if (sel opened.err) { brk; }
            if (opened.ok.handle.value == stale.handle.value) {
                @fresh = opened.ok;
                found  = true;
            }
            or {
                spare[kept] = opened.ok;
                kept        = kept + 1;
            }
        }
        var i: usize = 0;
        for (i < kept) {
            udp.socket_close(?spare[i]);
            i = i + 1;
        }
        ret found;
    }
}
$or {
    fun replace_socket(stale: *udp.Socket, fresh: *udp.Socket) bool {
        val opened: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
        if (sel opened.err)                                                        { ret false; }
        if (reuse_os.duplicate_to(opened.ok.handle.value, stale.handle.value) < 0) { ret false; }
        if (os.sock_close(opened.ok.handle.value) < 0)                             { ret false; }
        @fresh = udp.Socket{handle: io_handle.socket(stale.handle.value), family: opened.ok.family};
        ret true;
    }
}

# a socket closed outside its driver is detected on the next submission and
# never takes over the socket that reuses its native value (#716)
test "async network: a socket closed outside the driver never hijacks its reused value" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 16))) { ret 1; }
    var driver: Driver;
    if (!ok_err(make(?driver, ?runtime))) { ret 2; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 3; }
    val stale_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel stale_result.err) { ret 4; }
    var stale:         udp.Socket                      = stale_result.ok;
    val sender_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel sender_result.err) { ret 5; }
    var sender: udp.Socket = sender_result.ok;

    var storage: [192]u8;
    var packets: [3]types.Packet;
    var i:       usize = 0;
    for (i < 3) {
        packets[i].buffer   = ?storage[i * 64];
        packets[i].capacity = 64;
        i                   = i + 1;
    }
    val pending: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?scope, ?stale, ?packets[0], 1, 900);
    if (sel pending.err) { ret 6; }
    var output: [4]io_runtime.Completion;
    val idle:   res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 0);
    if (!(sel idle.ok && idle.ok == 0)) { ret 7; }

    var fresh:    udp.Socket;
    val replaced: bool = replace_socket(?stale, ?fresh);
    $if ($mach.build.os != $mach.os.windows) {
        if (!replaced) { ret 8; }
    }
    var expected: usize = 1;
    if (replaced) {
        if (fresh.handle.opening <= stale.handle.opening) { ret 9; }
        val fresh_endpoint: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?fresh);
        if (sel fresh_endpoint.err) { ret 10; }
        val live: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?scope, ?fresh, ?packets[1], 1, 901);
        if (sel live.err) { ret 11; }
        val refused: res[io_runtime.Token, io_error.Error] = submit_receive_batch(?driver, ?scope, ?stale, ?packets[2], 1, 902);
        if (sel refused.err) { ret 12; }
        var datagram: [4]u8;
        datagram[0] = 7;
        val sent: res[usize, io_error.Error] = udp.send_to(?sender, ?datagram[0], 4, fresh_endpoint.ok);
        if (!(sel sent.ok && sent.ok == 4)) { ret 13; }
        expected = 3;
    }

    var seen:   usize = 0;
    var rounds: usize = 0;
    for (seen < expected && rounds < 40) {
        val batch: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 250);
        if (sel batch.err) { ret 14; }
        var j: usize = 0;
        for (j < batch.ok) {
            val done: *io_runtime.Completion = ?output[j];
            if (done.context == 900 || done.context == 902) {
                # the closed socket's work ends as closed, raised by std itself
                if (!done.has_error || done.error.kind != io_error.CLOSED || done.error.code != 0) { ret 15; }
            }
            or (done.context == 901) {
                # the reused value's own receive gets the datagram
                if (done.has_error || done.items != 1 || packets[1].length != 4 || storage[64] != 7) { ret 16; }
            }
            or { ret 17; }
            seen = seen + 1;
            j    = j + 1;
        }
        rounds = rounds + 1;
    }
    if (seen != expected) { ret 18; }

    if (replaced) {
        val closed: res[io_runtime.Token, io_error.Error] = submit_datagram_close(?driver, ?scope, ?fresh, 903);
        if (sel closed.err) { ret 19; }
        val closing: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 1000);
        if (!(sel closing.ok && closing.ok == 1) || output[0].context != 903 || output[0].has_error) { ret 20; }
    }
    udp.socket_close(?sender);
    if (!scope_ok(cancel.destroy(?scope)))     { ret 21; }
    if (!ok_err(destroy(?driver)))             { ret 22; }
    if (!ok_bool(io_runtime.close(?runtime)))  { ret 23; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 24; }
    ret 0;
}

# a send packet whose length exceeds its capacity refuses the whole batch at
# submission, and nothing from the batch reaches the peer (#720)
test "async network: a send batch with a packet longer than its capacity is refused" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 4))) { ret 1; }
    var driver: Driver;
    if (!ok_err(make(?driver, ?runtime))) { ret 2; }
    val sender_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel sender_result.err) { ret 3; }
    var sender:      udp.Socket                      = sender_result.ok;
    val peer_result: res[udp.Socket, io_error.Error] = bind_datagram(ip.endpoint(127, 0, 0, 1, 0));
    if (sel peer_result.err) { ret 4; }
    var peer:   udp.Socket                       = peer_result.ok;
    val target: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?peer);
    if (sel target.err) { ret 5; }
    var scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 6; }

    var storage: [16]u8;
    var packets: [2]types.Packet;
    packets[0].buffer   = ?storage[0];
    packets[0].capacity = 8;
    packets[0].length   = 4;
    packets[0].peer     = target.ok;
    packets[1].buffer   = ?storage[8];
    packets[1].capacity = 4;
    packets[1].length   = 8;
    packets[1].peer     = target.ok;
    storage[0]          = 'x';
    val refused_send: res[io_runtime.Token, io_error.Error] = submit_send_batch(?driver, ?scope, ?sender, ?packets[0], 2, 81);
    if (sel refused_send.err) { ret 7; }
    var output: [4]io_runtime.Completion;
    var failed: bool  = false;
    var rounds: usize = 0;
    for (!failed && rounds < 8) {
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 250);
        if (sel waited.err) { ret 20; }
        var j: usize = 0;
        for (j < waited.ok) {
            if (output[j].context != 81)                                          { ret 21; }
            if (!output[j].has_error || output[j].error.kind != io_error.INVALID) { ret 22; }
            if (output[j].items != 0)                                             { ret 23; }
            failed = true;
            j      = j + 1;
        }
        rounds = rounds + 1;
    }
    if (!failed) { ret 24; }

    # a marker sent after the refusal must be the first datagram the peer sees
    var marker: types.Packet;
    var mark:   [2]u8 = [2]u8{'m', 'k'};
    marker.buffer   = ?mark[0];
    marker.capacity = 2;
    marker.length   = 2;
    marker.peer     = target.ok;
    val marking: res[io_runtime.Token, io_error.Error] = submit_send_batch(?driver, ?scope, ?sender, ?marker, 1, 82);
    if (sel marking.err) { ret 8; }
    var sent: bool = false;
    rounds = 0;
    for (!sent && rounds < 8) {
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 250);
        if (sel waited.err) { ret 9; }
        var j: usize = 0;
        for (j < waited.ok) {
            if (output[j].context != 82 || output[j].has_error) { ret 10; }
            sent = true;
            j    = j + 1;
        }
        rounds = rounds + 1;
    }
    if (!sent) { ret 11; }

    var inbox: [16]u8;
    var from:  ip.Endpoint;
    var got:   usize = 0;
    var tries: usize = 0;
    for (got == 0 && tries < 200) {
        val pulled: res[usize, io_error.Error] = udp.recv_from(?peer, ?inbox[0], 16, ?from);
        if (sel pulled.ok) { got = pulled.ok; }
        or                 { os.sleep(5000000); }
        tries = tries + 1;
    }
    if (got != 2 || inbox[0] != 'm' || inbox[1] != 'k') { ret 12; }

    udp.socket_close(?peer);
    val closing: res[io_runtime.Token, io_error.Error] = submit_datagram_close(?driver, ?scope, ?sender, 83);
    if (sel closing.err) { ret 13; }
    var guard: usize = 0;
    for (io_runtime.pending(?runtime) > 0 && guard < 16) {
        val drained: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 1000);
        if (sel drained.err) { ret 14; }
        guard = guard + 1;
    }
    if (io_runtime.pending(?runtime) != 0)     { ret 15; }
    if (!scope_ok(cancel.destroy(?scope)))     { ret 16; }
    if (refused(destroy(?driver)))             { ret 17; }
    if (!ok_bool(io_runtime.close(?runtime)))  { ret 18; }
    if (!ok_err(io_runtime.destroy(?runtime))) { ret 19; }
    ret 0;
}

# accept one loopback connection through the driver
fun readable_pair(driver: *Driver, scope: *cancel.Scope, listener: *tcp.Listener, server: *tcp.Stream, client: *tcp.Stream) i32 {
    val endpoint_result: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(listener);
    if (sel endpoint_result.err) { ret 1; }
    var peer:     ip.Endpoint;
    val accepted: res[io_runtime.Token, io_error.Error] = submit_accept(driver, scope, listener, ?peer, 900);
    if (sel accepted.err) { ret 2; }
    val client_result: res[tcp.Stream, io_error.Error] = tcp.connect(endpoint_result.ok);
    if (sel client_result.err) { ret 3; }
    @client = client_result.ok;
    var output: io_runtime.Completion;
    if (!waited_one(wait(driver, ?output, 1, 1000)) || output.has_error || output.kind != io_runtime.ACCEPT) { ret 4; }
    @server = stream(?output);
    if (!io_handle.socket_is_valid(server.handle)) { ret 5; }
    ret 0;
}

fun readable_setup(runtime: *io_runtime.Runtime, driver: *Driver, scope: *cancel.Scope, listener: *tcp.Listener) i32 {
    if (!ok_err(io_runtime.make(runtime, 8)))                         { ret 1; }
    if (!ok_err(make(driver, runtime)))                               { ret 2; }
    if (!scope_ok(cancel.make_root(scope, opt[time.Instant].none{}))) { ret 3; }
    val listener_result: res[tcp.Listener, io_error.Error] = listen(ip.endpoint(127, 0, 0, 1, 0), 16);
    if (sel listener_result.err) { ret 4; }
    @listener = listener_result.ok;
    ret 0;
}

fun readable_teardown(runtime: *io_runtime.Runtime, driver: *Driver, scope: *cancel.Scope, listener: *tcp.Listener) bool {
    ret !refused(tcp.listener_close(listener))
        && scope_ok(cancel.destroy(scope))
        && !refused(destroy(driver))
        && ok_bool(io_runtime.close(runtime))
        && ok_err(io_runtime.destroy(runtime));
}

# a readiness wait completes when data arrives, reads nothing, and a read
# submitted after it completes after it with every byte (#759)
test "async network: a readiness wait completes on data before a later read" {
    var runtime:  io_runtime.Runtime;
    var driver:   Driver;
    var scope:    cancel.Scope;
    var listener: tcp.Listener;
    if (readable_setup(?runtime, ?driver, ?scope, ?listener) != 0) { ret 1; }
    var server: tcp.Stream;
    var client: tcp.Stream;
    if (readable_pair(?driver, ?scope, ?listener, ?server, ?client) != 0) { ret 2; }
    var output: [4]io_runtime.Completion;
    if (!ok_token(submit_readable(?driver, ?scope, ?server, 10))) { ret 3; }
    val idle: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 50);
    if (!(sel idle.ok && idle.ok == 0)) { ret 4; }
    var input: [16]u8;
    if (!ok_token(submit_read(?driver, ?scope, ?server, ?input[0], 16, 11))) { ret 5; }
    var payload: [5]u8                      = [5]u8{'h', 'e', 'l', 'l', 'o'};
    val written: res[usize, io_error.Error] = tcp.stream_write(?client, ?payload[0], 5);
    if (!(sel written.ok && written.ok == 5)) { ret 6; }
    var saw_ready: bool  = false;
    var saw_read:  bool  = false;
    var rounds:    usize = 0;
    for (rounds < 8 && !saw_read) {
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 4, 1000);
        if (sel waited.err) { ret 7; }
        var i: usize = 0;
        for (i < waited.ok) {
            if (output[i].context == 10) {
                if (saw_read || output[i].has_error || output[i].kind != io_runtime.READABLE
                    || output[i].bytes != 0 || output[i].end_of_stream) {
                    ret 8;
                }
                saw_ready = true;
            }
            or (output[i].context == 11) {
                if (!saw_ready || output[i].has_error || output[i].kind != io_runtime.READ || output[i].bytes != 5) { ret 9; }
                saw_read = true;
            }
            or {
                ret 10;
            }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if (!saw_ready || !saw_read)                                                               { ret 11; }
    if (input[0] != 'h' || input[4] != 'o')                                                    { ret 12; }
    if (refused(tcp.stream_close(?client)))                                                    { ret 13; }
    if (!ok_token(submit_stream_close(?driver, ?scope, ?server, lifecycle.ABORTIVE, 12)))      { ret 14; }
    if (!waited_one(wait(?driver, ?output[0], 4, 1000)) || output[0].kind != io_runtime.CLOSE) { ret 15; }
    if (!readable_teardown(?runtime, ?driver, ?scope, ?listener))                              { ret 16; }
    ret 0;
}

# a readiness wait reports end of stream after the peer's orderly shutdown, an
# error after a reset, and cancellation through its scope (#759)
test "async network: a readiness wait reports end of stream, reset and cancellation" {
    var runtime:  io_runtime.Runtime;
    var driver:   Driver;
    var scope:    cancel.Scope;
    var listener: tcp.Listener;
    if (readable_setup(?runtime, ?driver, ?scope, ?listener) != 0) { ret 1; }
    var output: io_runtime.Completion;

    var eof_server: tcp.Stream;
    var eof_client: tcp.Stream;
    if (readable_pair(?driver, ?scope, ?listener, ?eof_server, ?eof_client) != 0) { ret 2; }
    if (refused(tcp.stream_shutdown(?eof_client, 1)))                             { ret 3; }
    if (!ok_token(submit_readable(?driver, ?scope, ?eof_server, 20)))             { ret 4; }
    if (!waited_one(wait(?driver, ?output, 1, 1000))
        || output.context != 20 || output.has_error || output.kind != io_runtime.READABLE
        || output.bytes != 0 || !output.end_of_stream) {
        ret 5;
    }

    var reset_server: tcp.Stream;
    var reset_client: tcp.Stream;
    if (readable_pair(?driver, ?scope, ?listener, ?reset_server, ?reset_client) != 0)                               { ret 6; }
    if (!ok_token(submit_readable(?driver, ?scope, ?reset_server, 21)))                                             { ret 7; }
    if (refused(socket_api.set_linger(reset_client.handle, socket_api.Linger{enabled: true, seconds: 0})))          { ret 8; }
    if (refused(tcp.stream_close(?reset_client)))                                                                   { ret 9; }
    if (!waited_one(wait(?driver, ?output, 1, 1000)) || output.context != 21 || output.kind != io_runtime.READABLE) { ret 10; }
    # a reset may surface as the error itself, or as end of stream where the
    # platform reports the abortive close as readable with nothing left
    if (!output.has_error && !output.end_of_stream) { ret 11; }

    var cancel_server: tcp.Stream;
    var cancel_client: tcp.Stream;
    if (readable_pair(?driver, ?scope, ?listener, ?cancel_server, ?cancel_client) != 0) { ret 12; }
    var child: cancel.Scope;
    if (!scope_ok(cancel.make_child(?child, ?scope, opt[time.Instant].none{}))) { ret 13; }
    if (!ok_token(submit_readable(?driver, ?child, ?cancel_server, 22)))        { ret 14; }
    if (!scope_changed(cancel.cancel(?child)))                                  { ret 15; }
    if (!waited_one(wait(?driver, ?output, 1, 1000))
        || output.context != 22 || !output.has_error || output.error.kind != io_error.CANCELLED) {
        ret 16;
    }
    if (!scope_ok(cancel.destroy(?child))) { ret 17; }

    if (refused(tcp.stream_close(?eof_client)) || refused(tcp.stream_close(?cancel_client))) { ret 18; }
    var closes: usize = 0;
    if (!ok_token(submit_stream_close(?driver, ?scope, ?eof_server, lifecycle.ABORTIVE, 30)))    { ret 19; }
    if (!ok_token(submit_stream_close(?driver, ?scope, ?reset_server, lifecycle.ABORTIVE, 31)))  { ret 20; }
    if (!ok_token(submit_stream_close(?driver, ?scope, ?cancel_server, lifecycle.ABORTIVE, 32))) { ret 21; }
    var rounds: usize = 0;
    var batch:  [4]io_runtime.Completion;
    for (rounds < 8 && closes < 3) {
        val waited: res[usize, io_error.Error] = wait(?driver, ?batch[0], 4, 1000);
        if (sel waited.err) { ret 22; }
        closes = closes + waited.ok;
        rounds = rounds + 1;
    }
    if (closes != 3)                                              { ret 23; }
    if (!readable_teardown(?runtime, ?driver, ?scope, ?listener)) { ret 24; }
    ret 0;
}

# a read cancelled through its scope completes with the scope's reason once the
# platform gives its buffer back, the driver is left with nothing awaiting, and
# the stream still reads what the peer sends afterwards
test "async network: a cancelled read completes cancelled and leaves the stream usable" {
    var runtime:  io_runtime.Runtime;
    var driver:   Driver;
    var scope:    cancel.Scope;
    var listener: tcp.Listener;
    if (readable_setup(?runtime, ?driver, ?scope, ?listener) != 0) { ret 1; }
    var server: tcp.Stream;
    var client: tcp.Stream;
    if (readable_pair(?driver, ?scope, ?listener, ?server, ?client) != 0) { ret 2; }
    var child: cancel.Scope;
    if (!scope_ok(cancel.make_child(?child, ?scope, opt[time.Instant].none{}))) { ret 3; }
    var input: [8]u8;
    if (!ok_token(submit_read(?driver, ?child, ?server, ?input[0], 8, 40))) { ret 4; }
    if (!scope_changed(cancel.cancel(?child)))                              { ret 5; }
    var output: io_runtime.Completion;
    if (!waited_one(wait(?driver, ?output, 1, 1000))
        || output.context != 40 || output.kind != io_runtime.READ
        || !output.has_error || output.error.kind != io_error.CANCELLED) {
        ret 6;
    }
    if (!scope_ok(cancel.destroy(?child)))    { ret 7; }
    if (awaiting_cancellations(?driver) != 0) { ret 8; }
    var discarded: u64 = 9;
    if (discarded_reads(?driver, ?discarded) != 0 || discarded != 0)        { ret 9; }
    if (!ok_token(submit_read(?driver, ?scope, ?server, ?input[0], 8, 41))) { ret 10; }
    var payload: [2]u8                      = [2]u8{'o', 'k'};
    val written: res[usize, io_error.Error] = tcp.stream_write(?client, ?payload[0], 2);
    if (!(sel written.ok && written.ok == 2)) { ret 11; }
    if (!waited_one(wait(?driver, ?output, 1, 1000))
        || output.context != 41 || output.has_error || output.bytes != 2 || input[0] != 'o') {
        ret 12;
    }
    if (refused(tcp.stream_close(?client)))                                               { ret 13; }
    if (!ok_token(submit_stream_close(?driver, ?scope, ?server, lifecycle.ABORTIVE, 42))) { ret 14; }
    if (!waited_one(wait(?driver, ?output, 1, 1000)) || output.kind != io_runtime.CLOSE)  { ret 15; }
    if (!readable_teardown(?runtime, ?driver, ?scope, ?listener))                         { ret 16; }
    ret 0;
}

val READABLE_IDLE: usize = 64;

# idle connections holding readiness waits hold no caller buffer: each pending
# wait is one runtime slot, one driver slot and one backend operation, and the
# runtime's pending count is exactly the number of waits (#759)
test "async network: idle connections hold readiness waits without buffers" {
    var runtime:  io_runtime.Runtime;
    var driver:   Driver;
    var scope:    cancel.Scope;
    var listener: tcp.Listener;
    if (readable_setup(?runtime, ?driver, ?scope, ?listener) != 0) { ret 1; }
    var servers: [64]tcp.Stream;
    var clients: [64]tcp.Stream;
    var i:       usize = 0;
    for (i < READABLE_IDLE) {
        if (readable_pair(?driver, ?scope, ?listener, ?servers[i], ?clients[i]) != 0) { ret 2; }
        i = i + 1;
    }
    val before: usize = io_runtime.pending(?runtime);
    i = 0;
    for (i < READABLE_IDLE) {
        if (!ok_token(submit_readable(?driver, ?scope, ?servers[i], 1000 + i))) { ret 3; }
        i = i + 1;
    }
    if (io_runtime.pending(?runtime) != before + READABLE_IDLE) { ret 4; }
    var output: [64]io_runtime.Completion;
    val idle:   res[usize, io_error.Error] = wait(?driver, ?output[0], 64, 50);
    if (!(sel idle.ok && idle.ok == 0)) { ret 5; }
    # one byte to the last connection completes exactly its wait
    var one:     [1]u8                      = [1]u8{7};
    val written: res[usize, io_error.Error] = tcp.stream_write(?clients[READABLE_IDLE - 1], ?one[0], 1);
    if (!(sel written.ok && written.ok == 1)) { ret 6; }
    if (!waited_one(wait(?driver, ?output[0], 64, 1000))
        || output[0].context != 1000 + READABLE_IDLE - 1 || output[0].has_error || output[0].end_of_stream) {
        ret 7;
    }
    if (!scope_changed(cancel.cancel(?scope))) { ret 8; }
    var settled: usize = 0;
    var rounds:  usize = 0;
    for (rounds < 16 && settled < READABLE_IDLE - 1) {
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 64, 1000);
        if (sel waited.err) { ret 9; }
        settled = settled + waited.ok;
        rounds  = rounds + 1;
    }
    if (settled != READABLE_IDLE - 1) { ret 10; }
    var close_scope: cancel.Scope;
    if (!scope_ok(cancel.make_root(?close_scope, opt[time.Instant].none{}))) { ret 11; }
    i = 0;
    for (i < READABLE_IDLE) {
        if (refused(tcp.stream_close(?clients[i])))                                                           { ret 12; }
        if (!ok_token(submit_stream_close(?driver, ?close_scope, ?servers[i], lifecycle.ABORTIVE, 2000 + i))) { ret 13; }
        i = i + 1;
    }
    settled = 0;
    rounds  = 0;
    for (rounds < 16 && settled < READABLE_IDLE) {
        val waited: res[usize, io_error.Error] = wait(?driver, ?output[0], 64, 1000);
        if (sel waited.err) { ret 14; }
        settled = settled + waited.ok;
        rounds  = rounds + 1;
    }
    if (settled != READABLE_IDLE || !scope_ok(cancel.destroy(?close_scope))) { ret 15; }
    if (!ok_token(submit_listener_close(?driver, ?scope, ?listener, 3000))) {
        # the root scope is cancelled, so close the listener directly
        if (refused(tcp.listener_close(?listener))) { ret 16; }
    }
    if (!scope_ok(cancel.destroy(?scope))
        || refused(destroy(?driver))
        || !ok_bool(io_runtime.close(?runtime))
        || !ok_err(io_runtime.destroy(?runtime))) {
        ret 17;
    }
    ret 0;
}
