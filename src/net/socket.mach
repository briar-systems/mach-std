# portable socket creation, options, and endpoint queries

use io_error:  std.io.error;
use io_handle: std.io.handle;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

$if (capability.HAS_SOCKETS) {
    use std.net.ip;
    use std.system.os;
}
$or {
    $error("std.net.socket needs the sockets capability (std.system.capability.HAS_SOCKETS)");
}

# creation state is established before a handle reaches application code
# ---
# nonblocking:     the socket is created in nonblocking mode
# non_inheritable: child processes do not inherit the socket
pub rec Flags {
    nonblocking:     bool;
    non_inheritable: bool;
}

# the flags for a blocking socket that child processes do not inherit
pub fun blocking_flags() Flags {
    ret Flags{nonblocking: false, non_inheritable: true};
}

# the flags for a nonblocking socket that child processes do not inherit
pub fun async_flags() Flags {
    ret Flags{nonblocking: true, non_inheritable: true};
}

pub def BoolOption: u8;
pub val REUSE_ADDRESS:     BoolOption = 0;
pub val REUSE_PORT:        BoolOption = 1;
pub val EXCLUSIVE_ADDRESS: BoolOption = 2;
pub val NO_DELAY:          BoolOption = 3;
pub val KEEP_ALIVE:        BoolOption = 4;
pub val IPV6_ONLY:         BoolOption = 5;
pub val FAST_OPEN:         BoolOption = 6;

pub def ValueOption: u8;
pub val KEEP_IDLE_SECONDS:     ValueOption = 0;
pub val KEEP_INTERVAL_SECONDS: ValueOption = 1;
pub val KEEP_PROBE_COUNT:      ValueOption = 2;
pub val SEND_BUFFER_BYTES:     ValueOption = 3;
pub val RECEIVE_BUFFER_BYTES:  ValueOption = 4;
pub val TRAFFIC_CLASS_IPV4:    ValueOption = 5;
pub val TRAFFIC_CLASS_IPV6:    ValueOption = 6;

# the SO_LINGER setting of a socket
# ---
# enabled: close waits for unsent data, up to seconds
# seconds: how long close waits
pub rec Linger {
    enabled: bool;
    seconds: u32;
}

# socket options applied between creation and bind
# ---
# reuse_address: rebind an address whose closed connections still linger, set
#                by default as the plain bind functions do. SO_REUSEADDR does
#                this on posix. windows does it without an option, and its
#                SO_REUSEADDR would let the socket take an address another
#                socket is using, so nothing is set there
# reuse_port:    SO_REUSEPORT, so several sockets can bind one address. linux
#                spreads the traffic across them, and only linux does, which
#                std.system.capability.REUSE_PORT_BALANCES answers per target.
#                darwin binds them all but delivers everything to the last
#                one bound, which still serves a fast restart and not a
#                multi-worker server. windows refuses with UNSUPPORTED
pub rec BindOptions {
    reuse_address: bool;
    reuse_port:    bool;
}

# the options the plain bind and listen functions use
pub fun bind_options() BindOptions {
    ret BindOptions{reuse_address: true, reuse_port: false};
}

# refuses options the target cannot apply, before any socket exists
# ---
# options: the requested options
# op:      the operation a refusal is reported for
# ret:     ok, or UNSUPPORTED
pub fun check_bind_options(options: BindOptions, op: io_error.Operation) err[io_error.Error] {
    if (options.reuse_port && os.SO_REUSEPORT == os.SO_UNSUPPORTED) {
        ret err[io_error.Error].err{io_error.make(io_error.UNSUPPORTED, op)};
    }
    ret err[io_error.Error].ok{};
}

# applies bind options to a freshly created socket
# ---
# handle:  the socket, not yet bound
# options: the options to apply
# ret:     ok, or the native refusal
pub fun apply_bind_options(handle: io_handle.SocketHandle, options: BindOptions) err[io_error.Error] {
    if (options.reuse_address && $mach.build.sys != $mach.sys.windows) {
        val err_applied: err[io_error.Error] = set_bool(handle, REUSE_ADDRESS, true);
        if (sel err_applied.err) { ret err_applied; }
    }
    if (options.reuse_port) {
        val err_applied: err[io_error.Error] = set_bool(handle, REUSE_PORT, true);
        if (sel err_applied.err) { ret err_applied; }
    }
    ret err[io_error.Error].ok{};
}

# create a socket
# ---
# family:   the address family, such as AF_INET or AF_INET6
# typ:      the socket type, such as SOCK_STREAM or SOCK_DGRAM
# protocol: the protocol, 0 for the type's default
# flags:    the creation state the handle starts with
# ret:      the handle, which the caller owns and closes, or the failure
pub fun create(family: i32, typ: i32, protocol: i32, flags: Flags) res[io_handle.SocketHandle, io_error.Error] {
    var raw:  usize = io_handle.INVALID_VALUE;
    val code: i64   = os.sock_create_flags(family, typ, protocol, flags.nonblocking, flags.non_inheritable, ?raw);
    if (code < 0) {
        ret res[io_handle.SocketHandle, io_error.Error].err{os.error(code, io_error.OP_CREATE)};
    }
    ret res[io_handle.SocketHandle, io_error.Error].ok{io_handle.socket(raw)};
}

# accept a pending connection on a listening socket
# ---
# handle: the listening socket
# flags:  the creation state the accepted handle starts with
# peer:   filled with the peer's endpoint, or nil
# ret:    the accepted handle, which the caller owns and closes, or the failure.
#         UNSUPPORTED when the peer address cannot be read as an IP endpoint,
#         and the accepted socket is then closed
pub fun accept(handle: io_handle.SocketHandle, flags: Flags, peer: *ip.Endpoint) res[io_handle.SocketHandle, io_error.Error] {
    var sa:     [128]u8;
    var sa_len: u32   = os.SOCKADDR_STORAGE_SIZE::u32;
    var raw:    usize = io_handle.INVALID_VALUE;
    val code:   i64   = os.sock_accept_flags(handle.value, ?sa[0], ?sa_len, flags.nonblocking, flags.non_inheritable, ?raw);
    if (code < 0) {
        ret res[io_handle.SocketHandle, io_error.Error].err{os.error(code, io_error.OP_ACCEPT)};
    }
    if (peer != nil && !ip.from_sockaddr(?sa[0], peer)) {
        os.sock_close(raw);
        ret res[io_handle.SocketHandle, io_error.Error].err{io_error.make(io_error.UNSUPPORTED, io_error.OP_ACCEPT)};
    }
    ret res[io_handle.SocketHandle, io_error.Error].ok{io_handle.socket(raw)};
}

# the native level and name of a boolean option
# ---
# option: the option
# level:  given the native level
# name:   given the native option name
# ret:    whether the target supports the option
fun bool_native(option: BoolOption, level: *i32, name: *i32) bool {
    if (option == REUSE_ADDRESS) {
        @level = os.SOL_SOCKET;
        @name  = os.SO_REUSEADDR;
    }
    or (option == REUSE_PORT) {
        @level = os.SOL_SOCKET;
        @name  = os.SO_REUSEPORT;
    }
    or (option == EXCLUSIVE_ADDRESS) {
        @level = os.SOL_SOCKET;
        @name  = os.SO_EXCLUSIVEADDRUSE;
    }
    or (option == NO_DELAY) {
        @level = os.IPPROTO_TCP;
        @name  = os.TCP_NODELAY;
    }
    or (option == KEEP_ALIVE) {
        @level = os.SOL_SOCKET;
        @name  = os.SO_KEEPALIVE;
    }
    or (option == IPV6_ONLY) {
        @level = os.IPPROTO_IPV6;
        @name  = os.IPV6_V6ONLY;
    }
    or (option == FAST_OPEN) {
        @level = os.IPPROTO_TCP;
        @name  = os.TCP_FASTOPEN;
    }
    or {
        ret false;
    }
    ret @name != os.SO_UNSUPPORTED;
}

# the native level and name of a value option
# ---
# option: the option
# level:  given the native level
# name:   given the native option name
# ret:    whether the target supports the option
fun value_native(option: ValueOption, level: *i32, name: *i32) bool {
    if (option == KEEP_IDLE_SECONDS) {
        @level = os.IPPROTO_TCP;
        @name  = os.TCP_KEEPIDLE;
    }
    or (option == KEEP_INTERVAL_SECONDS) {
        @level = os.IPPROTO_TCP;
        @name  = os.TCP_KEEPINTVL;
    }
    or (option == KEEP_PROBE_COUNT) {
        @level = os.IPPROTO_TCP;
        @name  = os.TCP_KEEPCNT;
    }
    or (option == SEND_BUFFER_BYTES) {
        @level = os.SOL_SOCKET;
        @name  = os.SO_SNDBUF;
    }
    or (option == RECEIVE_BUFFER_BYTES) {
        @level = os.SOL_SOCKET;
        @name  = os.SO_RCVBUF;
    }
    or (option == TRAFFIC_CLASS_IPV4) {
        @level = os.IPPROTO_IP;
        @name  = os.IP_TOS;
    }
    or (option == TRAFFIC_CLASS_IPV6) {
        @level = os.IPPROTO_IPV6;
        @name  = os.IPV6_TCLASS;
    }
    or {
        ret false;
    }
    ret @name != os.SO_UNSUPPORTED;
}

# whether the target supports a boolean option
# ---
# option: the option
# ret:    true when set_bool and get_bool can reach it
pub fun bool_option_supported(option: BoolOption) bool {
    var level: i32 = 0;
    var name:  i32 = -1;
    ret bool_native(option, ?level, ?name);
}

# whether the target supports a value option
# ---
# option: the option
# ret:    true when set_value and get_value can reach it
pub fun value_option_supported(option: ValueOption) bool {
    var level: i32 = 0;
    var name:  i32 = -1;
    ret value_native(option, ?level, ?name);
}

# turn a boolean option on or off
# ---
# handle:  the socket
# option:  the option
# enabled: whether to turn it on
# ret:     ok, or the failure. UNSUPPORTED where the target lacks the option
pub fun set_bool(handle: io_handle.SocketHandle, option: BoolOption, enabled: bool) err[io_error.Error] {
    var level: i32 = 0;
    var name:  i32 = -1;
    if (!bool_native(option, ?level, ?name)) {
        ret err[io_error.Error].err{io_error.make(io_error.UNSUPPORTED, io_error.OP_OPTION)};
    }
    var raw: i32 = 0;
    if (enabled) { raw = 1; }
    val code: i64 = os.sock_setopt(handle.value, level, name, (?raw)::*u8, 4);
    if (code < 0) { ret err[io_error.Error].err{os.error(code, io_error.OP_OPTION)}; }
    ret err[io_error.Error].ok{};
}

# read a boolean option
# ---
# handle: the socket
# option: the option
# ret:    whether it is on, or the failure. UNSUPPORTED where the target lacks the option
pub fun get_bool(handle: io_handle.SocketHandle, option: BoolOption) res[bool, io_error.Error] {
    var level: i32 = 0;
    var name:  i32 = -1;
    if (!bool_native(option, ?level, ?name)) {
        ret res[bool, io_error.Error].err{io_error.make(io_error.UNSUPPORTED, io_error.OP_OPTION)};
    }
    var raw:  i32 = 0;
    var len:  u32 = 4;
    val code: i64 = os.sock_getopt(handle.value, level, name, (?raw)::*u8, ?len);
    if (code < 0) { ret res[bool, io_error.Error].err{os.error(code, io_error.OP_OPTION)}; }
    ret res[bool, io_error.Error].ok{raw != 0};
}

# setters copy values immediately and retain no caller storage
# units are seconds, probe count, requested bytes, or an 8-bit traffic class
pub fun set_value(handle: io_handle.SocketHandle, option: ValueOption, value: u32) err[io_error.Error] {
    var level: i32 = 0;
    var name:  i32 = -1;
    if (!value_native(option, ?level, ?name)) {
        ret err[io_error.Error].err{io_error.make(io_error.UNSUPPORTED, io_error.OP_OPTION)};
    }
    if (value > 0x7fffffff) {
        ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)};
    }
    if ((option == TRAFFIC_CLASS_IPV4 || option == TRAFFIC_CLASS_IPV6) && value > 255) {
        ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)};
    }
    var raw:  i32 = value::i32;
    val code: i64 = os.sock_setopt(handle.value, level, name, (?raw)::*u8, 4);
    if (code < 0) { ret err[io_error.Error].err{os.error(code, io_error.OP_OPTION)}; }
    ret err[io_error.Error].ok{};
}

# read a value option
# ---
# handle: the socket
# option: the option
# ret:    the value, or the failure. UNSUPPORTED where the target lacks the
#         option, INVALID when the native value is negative
pub fun get_value(handle: io_handle.SocketHandle, option: ValueOption) res[u32, io_error.Error] {
    var level: i32 = 0;
    var name:  i32 = -1;
    if (!value_native(option, ?level, ?name)) {
        ret res[u32, io_error.Error].err{io_error.make(io_error.UNSUPPORTED, io_error.OP_OPTION)};
    }
    var raw:  i32 = 0;
    var len:  u32 = 4;
    val code: i64 = os.sock_getopt(handle.value, level, name, (?raw)::*u8, ?len);
    if (code < 0) { ret res[u32, io_error.Error].err{os.error(code, io_error.OP_OPTION)}; }
    if (raw < 0)  { ret res[u32, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)}; }
    ret res[u32, io_error.Error].ok{raw::u32};
}

# set a socket's SO_LINGER
# ---
# handle: the socket
# value:  the linger setting
# ret:    ok, or the failure. INVALID when seconds exceeds what the target
#         stores, 65535 on windows and 0x7fffffff elsewhere
pub fun set_linger(handle: io_handle.SocketHandle, value: Linger) err[io_error.Error] {
    $if ($mach.build.sys == $mach.sys.windows) {
        if (value.seconds > 65535) {
            ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)};
        }
        var native: [2]u16;
        native[0] = 0;
        if (value.enabled) { native[0] = 1; }
        native[1] = value.seconds::u16;
        val code: i64 = os.sock_setopt(handle.value, os.SOL_SOCKET, os.SO_LINGER, (?native[0])::*u8, 4);
        if (code < 0) { ret err[io_error.Error].err{os.error(code, io_error.OP_OPTION)}; }
    }
    $or {
        if (value.seconds > 0x7fffffff) {
            ret err[io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)};
        }
        var native: [2]i32;
        native[0] = 0;
        if (value.enabled) { native[0] = 1; }
        native[1] = value.seconds::i32;
        val code: i64 = os.sock_setopt(handle.value, os.SOL_SOCKET, os.SO_LINGER, (?native[0])::*u8, 8);
        if (code < 0) { ret err[io_error.Error].err{os.error(code, io_error.OP_OPTION)}; }
    }
    ret err[io_error.Error].ok{};
}

# read a socket's SO_LINGER
# ---
# handle: the socket
# ret:    the linger setting, or the failure
pub fun get_linger(handle: io_handle.SocketHandle) res[Linger, io_error.Error] {
    $if ($mach.build.sys == $mach.sys.windows) {
        var native: [2]u16;
        var len:    u32 = 4;
        val code:   i64 = os.sock_getopt(handle.value, os.SOL_SOCKET, os.SO_LINGER, (?native[0])::*u8, ?len);
        if (code < 0) { ret res[Linger, io_error.Error].err{os.error(code, io_error.OP_OPTION)}; }
        ret res[Linger, io_error.Error].ok{Linger{enabled: native[0] != 0, seconds: native[1]::u32}};
    }
    $or {
        var native: [2]i32;
        var len:    u32 = 8;
        val code:   i64 = os.sock_getopt(handle.value, os.SOL_SOCKET, os.SO_LINGER, (?native[0])::*u8, ?len);
        if (code < 0) { ret res[Linger, io_error.Error].err{os.error(code, io_error.OP_OPTION)}; }
        ret res[Linger, io_error.Error].ok{Linger{enabled: native[0] != 0, seconds: native[1]::u32}};
    }
}

# the local or remote endpoint of a socket
# ---
# handle: the socket
# local:  true for the local endpoint, false for the remote one
# ret:    the endpoint, or the failure. UNSUPPORTED when the address is not IP
fun query_endpoint(handle: io_handle.SocketHandle, local: bool) res[ip.Endpoint, io_error.Error] {
    var sa:   [128]u8;
    var len:  u32 = os.SOCKADDR_STORAGE_SIZE::u32;
    var code: i64 = 0;
    if (local) {
        code = os.sock_local_addr(handle.value, ?sa[0], ?len);
    }
    or {
        code = os.sock_remote_addr(handle.value, ?sa[0], ?len);
    }
    if (code < 0) {
        ret res[ip.Endpoint, io_error.Error].err{os.error(code, io_error.OP_OPTION)};
    }
    var endpoint: ip.Endpoint;
    if (!ip.from_sockaddr(?sa[0], ?endpoint)) {
        ret res[ip.Endpoint, io_error.Error].err{io_error.make(io_error.UNSUPPORTED, io_error.OP_OPTION)};
    }
    ret res[ip.Endpoint, io_error.Error].ok{endpoint};
}

# the local endpoint a socket is bound to
# ---
# handle: the socket
# ret:    the endpoint, or the failure. UNSUPPORTED when the address is not IP
pub fun local_endpoint(handle: io_handle.SocketHandle) res[ip.Endpoint, io_error.Error] {
    ret query_endpoint(handle, true);
}

# the remote endpoint a socket is connected to
# ---
# handle: the socket
# ret:    the endpoint, or the failure. UNSUPPORTED when the address is not IP
pub fun remote_endpoint(handle: io_handle.SocketHandle) res[ip.Endpoint, io_error.Error] {
    ret query_endpoint(handle, false);
}

# whether child processes inherit a socket
# ---
# handle: the socket
# ret:    true when the socket is inherited, or the failure
pub fun inheritable(handle: io_handle.SocketHandle) res[bool, io_error.Error] {
    var value: bool = true;
    val code:  i64  = os.sock_inheritable(handle.value, ?value);
    if (code < 0) { ret res[bool, io_error.Error].err{os.error(code, io_error.OP_OPTION)}; }
    ret res[bool, io_error.Error].ok{value};
}

test socket__typed_boolean_and_value_options_round_trip {
    val res_created: res[io_handle.SocketHandle, io_error.Error] = create(os.AF_INET, os.SOCK_STREAM, 0, blocking_flags());
    if (sel res_created.err) { ret 1; }
    val handle: io_handle.SocketHandle = res_created.ok;

    val err_set_keep: err[io_error.Error] = set_bool(handle, KEEP_ALIVE, true);
    if (sel err_set_keep.err) {
        os.sock_close(handle.value);
        ret 1;
    }
    val res_get_keep: res[bool, io_error.Error] = get_bool(handle, KEEP_ALIVE);
    if (!(sel res_get_keep.ok && res_get_keep.ok)) {
        os.sock_close(handle.value);
        ret 1;
    }

    val err_set_buffer: err[io_error.Error] = set_value(handle, SEND_BUFFER_BYTES, 16384);
    if (sel err_set_buffer.err) {
        os.sock_close(handle.value);
        ret 1;
    }
    val res_get_buffer: res[u32, io_error.Error] = get_value(handle, SEND_BUFFER_BYTES);
    if (!(sel res_get_buffer.ok && res_get_buffer.ok != 0)) {
        os.sock_close(handle.value);
        ret 1;
    }

    val err_linger_set: err[io_error.Error] = set_linger(handle, Linger{enabled: true, seconds: 2});
    if (sel err_linger_set.err) {
        os.sock_close(handle.value);
        ret 1;
    }
    val res_linger_get: res[Linger, io_error.Error] = get_linger(handle);
    if (sel res_linger_get.err) {
        os.sock_close(handle.value);
        ret 1;
    }
    val linger: Linger = res_linger_get.ok;
    os.sock_close(handle.value);
    if (!linger.enabled || linger.seconds != 2) { ret 1; }
    ret 0;
}

test socket__unsupported_options_are_explicit {
    val res_created: res[io_handle.SocketHandle, io_error.Error] = create(os.AF_INET, os.SOCK_STREAM, 0, blocking_flags());
    if (sel res_created.err) { ret 1; }
    val handle: io_handle.SocketHandle = res_created.ok;
    var option: BoolOption             = REUSE_PORT;
    $if ($mach.build.sys != $mach.sys.windows) { option = EXCLUSIVE_ADDRESS; }
    val err_set_bool: err[io_error.Error] = set_bool(handle, option, true);
    os.sock_close(handle.value);
    if (!sel err_set_bool.err)                         { ret 1; }
    if (err_set_bool.err.kind != io_error.UNSUPPORTED) { ret 1; }
    ret 0;
}

test socket__created_handles_are_not_inheritable {
    val res_created: res[io_handle.SocketHandle, io_error.Error] = create(os.AF_INET, os.SOCK_STREAM, 0, blocking_flags());
    if (sel res_created.err) { ret 1; }
    val handle:          io_handle.SocketHandle    = res_created.ok;
    val res_inheritable: res[bool, io_error.Error] = inheritable(handle);
    os.sock_close(handle.value);
    if (sel res_inheritable.err) { ret 1; }
    if (res_inheritable.ok)      { ret 1; }
    ret 0;
}
