# portable socket creation, options, and endpoint queries

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.system.os;
use std.net.ip;
use io_error: std.io.error;
use io_handle: std.io.handle;

# creation state is established before a handle reaches application code
pub rec Flags {
    nonblocking: bool;
    non_inheritable: bool;
}

pub fun blocking_flags() Flags {
    ret Flags{nonblocking: false, non_inheritable: true};
}

pub fun async_flags() Flags {
    ret Flags{nonblocking: true, non_inheritable: true};
}

pub def BoolOption: u8;
pub val REUSE_ADDRESS:    BoolOption = 0;
pub val REUSE_PORT:       BoolOption = 1;
pub val EXCLUSIVE_ADDRESS:BoolOption = 2;
pub val NO_DELAY:         BoolOption = 3;
pub val KEEP_ALIVE:       BoolOption = 4;
pub val IPV6_ONLY:        BoolOption = 5;
pub val FAST_OPEN:        BoolOption = 6;

pub def ValueOption: u8;
pub val KEEP_IDLE_SECONDS:    ValueOption = 0;
pub val KEEP_INTERVAL_SECONDS:ValueOption = 1;
pub val KEEP_PROBE_COUNT:     ValueOption = 2;
pub val SEND_BUFFER_BYTES:    ValueOption = 3;
pub val RECEIVE_BUFFER_BYTES: ValueOption = 4;
pub val TRAFFIC_CLASS_IPV4:   ValueOption = 5;
pub val TRAFFIC_CLASS_IPV6:   ValueOption = 6;

pub rec Linger {
    enabled: bool;
    seconds: u32;
}

pub fun create(family: i32, typ: i32, protocol: i32, flags: Flags) Result[io_handle.SocketHandle, io_error.Error] {
    var raw: usize = io_handle.INVALID_VALUE;
    val code: i64 = os.sock_create_flags(family, typ, protocol, flags.nonblocking, flags.non_inheritable, ?raw);
    if (code < 0) {
        ret err[io_handle.SocketHandle, io_error.Error](io_error.from_code(code, io_error.OP_CREATE));
    }
    ret ok[io_handle.SocketHandle, io_error.Error](io_handle.SocketHandle{value: raw});
}

pub fun accept(handle: io_handle.SocketHandle, flags: Flags, peer: *ip.Endpoint) Result[io_handle.SocketHandle, io_error.Error] {
    var sa: [128]u8;
    var sa_len: u32 = os.SOCKADDR_STORAGE_SIZE::u32;
    var raw: usize = io_handle.INVALID_VALUE;
    val code: i64 = os.sock_accept_flags(handle.value, ?sa[0], ?sa_len, flags.nonblocking, flags.non_inheritable, ?raw);
    if (code < 0) {
        ret err[io_handle.SocketHandle, io_error.Error](io_error.from_code(code, io_error.OP_ACCEPT));
    }
    if (peer != nil && !ip.from_sockaddr(?sa[0], peer)) {
        os.sock_close(raw);
        ret err[io_handle.SocketHandle, io_error.Error](io_error.from_code(os.ENOTSUP, io_error.OP_ACCEPT));
    }
    ret ok[io_handle.SocketHandle, io_error.Error](io_handle.SocketHandle{value: raw});
}

fun bool_native(option: BoolOption, level: *i32, name: *i32) bool {
    if (option == REUSE_ADDRESS) {
        @level = os.SOL_SOCKET;
        @name = os.SO_REUSEADDR;
    } or (option == REUSE_PORT) {
        @level = os.SOL_SOCKET;
        @name = os.SO_REUSEPORT;
    } or (option == EXCLUSIVE_ADDRESS) {
        @level = os.SOL_SOCKET;
        @name = os.SO_EXCLUSIVEADDRUSE;
    } or (option == NO_DELAY) {
        @level = os.IPPROTO_TCP;
        @name = os.TCP_NODELAY;
    } or (option == KEEP_ALIVE) {
        @level = os.SOL_SOCKET;
        @name = os.SO_KEEPALIVE;
    } or (option == IPV6_ONLY) {
        @level = os.IPPROTO_IPV6;
        @name = os.IPV6_V6ONLY;
    } or (option == FAST_OPEN) {
        @level = os.IPPROTO_TCP;
        @name = os.TCP_FASTOPEN;
    } or {
        ret false;
    }
    ret @name != os.SO_UNSUPPORTED;
}

fun value_native(option: ValueOption, level: *i32, name: *i32) bool {
    if (option == KEEP_IDLE_SECONDS) {
        @level = os.IPPROTO_TCP;
        @name = os.TCP_KEEPIDLE;
    } or (option == KEEP_INTERVAL_SECONDS) {
        @level = os.IPPROTO_TCP;
        @name = os.TCP_KEEPINTVL;
    } or (option == KEEP_PROBE_COUNT) {
        @level = os.IPPROTO_TCP;
        @name = os.TCP_KEEPCNT;
    } or (option == SEND_BUFFER_BYTES) {
        @level = os.SOL_SOCKET;
        @name = os.SO_SNDBUF;
    } or (option == RECEIVE_BUFFER_BYTES) {
        @level = os.SOL_SOCKET;
        @name = os.SO_RCVBUF;
    } or (option == TRAFFIC_CLASS_IPV4) {
        @level = os.IPPROTO_IP;
        @name = os.IP_TOS;
    } or (option == TRAFFIC_CLASS_IPV6) {
        @level = os.IPPROTO_IPV6;
        @name = os.IPV6_TCLASS;
    } or {
        ret false;
    }
    ret @name != os.SO_UNSUPPORTED;
}

pub fun bool_option_supported(option: BoolOption) bool {
    var level: i32 = 0;
    var name: i32 = -1;
    ret bool_native(option, ?level, ?name);
}

pub fun value_option_supported(option: ValueOption) bool {
    var level: i32 = 0;
    var name: i32 = -1;
    ret value_native(option, ?level, ?name);
}

pub fun set_bool(handle: io_handle.SocketHandle, option: BoolOption, enabled: bool) Result[bool, io_error.Error] {
    var level: i32 = 0;
    var name: i32 = -1;
    if (!bool_native(option, ?level, ?name)) {
        ret err[bool, io_error.Error](io_error.from_code(os.ENOTSUP, io_error.OP_OPTION));
    }
    var raw: i32 = 0;
    if (enabled) { raw = 1; }
    val code: i64 = os.sock_setopt(handle.value, level, name, (?raw)::*u8, 4);
    if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    ret ok[bool, io_error.Error](true);
}

pub fun get_bool(handle: io_handle.SocketHandle, option: BoolOption) Result[bool, io_error.Error] {
    var level: i32 = 0;
    var name: i32 = -1;
    if (!bool_native(option, ?level, ?name)) {
        ret err[bool, io_error.Error](io_error.from_code(os.ENOTSUP, io_error.OP_OPTION));
    }
    var raw: i32 = 0;
    var len: u32 = 4;
    val code: i64 = os.sock_getopt(handle.value, level, name, (?raw)::*u8, ?len);
    if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    ret ok[bool, io_error.Error](raw != 0);
}

# setters copy values immediately and retain no caller storage
# units are seconds, probe count, requested bytes, or an 8-bit traffic class
pub fun set_value(handle: io_handle.SocketHandle, option: ValueOption, value: u32) Result[bool, io_error.Error] {
    var level: i32 = 0;
    var name: i32 = -1;
    if (!value_native(option, ?level, ?name)) {
        ret err[bool, io_error.Error](io_error.from_code(os.ENOTSUP, io_error.OP_OPTION));
    }
    if (value > 0x7fffffff) {
        ret err[bool, io_error.Error](io_error.from_code(os.EINVAL, io_error.OP_OPTION));
    }
    if ((option == TRAFFIC_CLASS_IPV4 || option == TRAFFIC_CLASS_IPV6) && value > 255) {
        ret err[bool, io_error.Error](io_error.from_code(os.EINVAL, io_error.OP_OPTION));
    }
    var raw: i32 = value::i32;
    val code: i64 = os.sock_setopt(handle.value, level, name, (?raw)::*u8, 4);
    if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    ret ok[bool, io_error.Error](true);
}

pub fun get_value(handle: io_handle.SocketHandle, option: ValueOption) Result[u32, io_error.Error] {
    var level: i32 = 0;
    var name: i32 = -1;
    if (!value_native(option, ?level, ?name)) {
        ret err[u32, io_error.Error](io_error.from_code(os.ENOTSUP, io_error.OP_OPTION));
    }
    var raw: i32 = 0;
    var len: u32 = 4;
    val code: i64 = os.sock_getopt(handle.value, level, name, (?raw)::*u8, ?len);
    if (code < 0) { ret err[u32, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    if (raw < 0) { ret err[u32, io_error.Error](io_error.from_code(os.EINVAL, io_error.OP_OPTION)); }
    ret ok[u32, io_error.Error](raw::u32);
}

pub fun set_linger(handle: io_handle.SocketHandle, value: Linger) Result[bool, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        if (value.seconds > 65535) {
            ret err[bool, io_error.Error](io_error.from_code(os.EINVAL, io_error.OP_OPTION));
        }
        var native: [2]u16;
        native[0] = 0;
        if (value.enabled) { native[0] = 1; }
        native[1] = value.seconds::u16;
        val code: i64 = os.sock_setopt(handle.value, os.SOL_SOCKET, os.SO_LINGER, (?native[0])::*u8, 4);
        if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    }
    $or {
        if (value.seconds > 0x7fffffff) {
            ret err[bool, io_error.Error](io_error.from_code(os.EINVAL, io_error.OP_OPTION));
        }
        var native: [2]i32;
        native[0] = 0;
        if (value.enabled) { native[0] = 1; }
        native[1] = value.seconds::i32;
        val code: i64 = os.sock_setopt(handle.value, os.SOL_SOCKET, os.SO_LINGER, (?native[0])::*u8, 8);
        if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    }
    ret ok[bool, io_error.Error](true);
}

pub fun get_linger(handle: io_handle.SocketHandle) Result[Linger, io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        var native: [2]u16;
        var len: u32 = 4;
        val code: i64 = os.sock_getopt(handle.value, os.SOL_SOCKET, os.SO_LINGER, (?native[0])::*u8, ?len);
        if (code < 0) { ret err[Linger, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
        ret ok[Linger, io_error.Error](Linger{enabled: native[0] != 0, seconds: native[1]::u32});
    }
    $or {
        var native: [2]i32;
        var len: u32 = 8;
        val code: i64 = os.sock_getopt(handle.value, os.SOL_SOCKET, os.SO_LINGER, (?native[0])::*u8, ?len);
        if (code < 0) { ret err[Linger, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
        ret ok[Linger, io_error.Error](Linger{enabled: native[0] != 0, seconds: native[1]::u32});
    }
}

fun query_endpoint(handle: io_handle.SocketHandle, local: bool) Result[ip.Endpoint, io_error.Error] {
    var sa: [128]u8;
    var len: u32 = os.SOCKADDR_STORAGE_SIZE::u32;
    var code: i64 = 0;
    if (local) {
        code = os.sock_local_addr(handle.value, ?sa[0], ?len);
    } or {
        code = os.sock_remote_addr(handle.value, ?sa[0], ?len);
    }
    if (code < 0) {
        ret err[ip.Endpoint, io_error.Error](io_error.from_code(code, io_error.OP_OPTION));
    }
    var endpoint: ip.Endpoint;
    if (!ip.from_sockaddr(?sa[0], ?endpoint)) {
        ret err[ip.Endpoint, io_error.Error](io_error.from_code(os.ENOTSUP, io_error.OP_OPTION));
    }
    ret ok[ip.Endpoint, io_error.Error](endpoint);
}

pub fun local_endpoint(handle: io_handle.SocketHandle) Result[ip.Endpoint, io_error.Error] {
    ret query_endpoint(handle, true);
}

pub fun remote_endpoint(handle: io_handle.SocketHandle) Result[ip.Endpoint, io_error.Error] {
    ret query_endpoint(handle, false);
}

pub fun inheritable(handle: io_handle.SocketHandle) Result[bool, io_error.Error] {
    var value: bool = true;
    val code: i64 = os.sock_inheritable(handle.value, ?value);
    if (code < 0) { ret err[bool, io_error.Error](io_error.from_code(code, io_error.OP_OPTION)); }
    ret ok[bool, io_error.Error](value);
}

test "socket: typed boolean and value options round trip" {
    val created: Result[io_handle.SocketHandle, io_error.Error] = create(os.AF_INET, os.SOCK_STREAM, 0, blocking_flags());
    if (is_err[io_handle.SocketHandle, io_error.Error](created)) { ret 1; }
    val handle: io_handle.SocketHandle = unwrap_ok[io_handle.SocketHandle, io_error.Error](created);

    val set_keep: Result[bool, io_error.Error] = set_bool(handle, KEEP_ALIVE, true);
    if (is_err[bool, io_error.Error](set_keep)) { os.sock_close(handle.value); ret 1; }
    val get_keep: Result[bool, io_error.Error] = get_bool(handle, KEEP_ALIVE);
    if (is_err[bool, io_error.Error](get_keep) || !unwrap_ok[bool, io_error.Error](get_keep)) {
        os.sock_close(handle.value);
        ret 1;
    }

    val set_buffer: Result[bool, io_error.Error] = set_value(handle, SEND_BUFFER_BYTES, 16384);
    if (is_err[bool, io_error.Error](set_buffer)) { os.sock_close(handle.value); ret 1; }
    val get_buffer: Result[u32, io_error.Error] = get_value(handle, SEND_BUFFER_BYTES);
    if (is_err[u32, io_error.Error](get_buffer) || unwrap_ok[u32, io_error.Error](get_buffer) == 0) {
        os.sock_close(handle.value);
        ret 1;
    }

    val linger_set: Result[bool, io_error.Error] = set_linger(handle, Linger{enabled: true, seconds: 2});
    if (is_err[bool, io_error.Error](linger_set)) { os.sock_close(handle.value); ret 1; }
    val linger_get: Result[Linger, io_error.Error] = get_linger(handle);
    if (is_err[Linger, io_error.Error](linger_get)) { os.sock_close(handle.value); ret 1; }
    val linger: Linger = unwrap_ok[Linger, io_error.Error](linger_get);
    os.sock_close(handle.value);
    if (!linger.enabled || linger.seconds != 2) { ret 1; }
    ret 0;
}

test "socket: unsupported options are explicit" {
    val created: Result[io_handle.SocketHandle, io_error.Error] = create(os.AF_INET, os.SOCK_STREAM, 0, blocking_flags());
    if (is_err[io_handle.SocketHandle, io_error.Error](created)) { ret 1; }
    val handle: io_handle.SocketHandle = unwrap_ok[io_handle.SocketHandle, io_error.Error](created);
    var option: BoolOption = REUSE_PORT;
    $if ($mach.build.os != $mach.os.windows) { option = EXCLUSIVE_ADDRESS; }
    val result: Result[bool, io_error.Error] = set_bool(handle, option, true);
    os.sock_close(handle.value);
    if (!is_err[bool, io_error.Error](result)) { ret 1; }
    if (unwrap_err[bool, io_error.Error](result).kind != io_error.UNSUPPORTED) { ret 1; }
    ret 0;
}

test "socket: created handles are not inheritable" {
    val created: Result[io_handle.SocketHandle, io_error.Error] = create(os.AF_INET, os.SOCK_STREAM, 0, blocking_flags());
    if (is_err[io_handle.SocketHandle, io_error.Error](created)) { ret 1; }
    val handle: io_handle.SocketHandle = unwrap_ok[io_handle.SocketHandle, io_error.Error](created);
    val result: Result[bool, io_error.Error] = inheritable(handle);
    os.sock_close(handle.value);
    if (is_err[bool, io_error.Error](result)) { ret 1; }
    if (unwrap_ok[bool, io_error.Error](result)) { ret 1; }
    ret 0;
}
