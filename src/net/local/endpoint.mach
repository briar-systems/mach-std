# tagged local transport endpoints and target capabilities

use io_error: std.io.error;
use std.memory;
use std.runtime.native.view.Unit;
use std.system.capability;
#[testing]
use std.system.os.shared;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

$if ($mach.build.sys == $mach.sys.windows) {
    use std.system.os.windows;
}

pub def Kind: u8;
pub val FILESYSTEM: Kind = 1;
pub val ABSTRACT:   Kind = 2;
pub val TARGET:     Kind = 3;

pub val NAME_CAPACITY: usize = 108;

# names are byte sequences and are never truncated or implicitly normalized
# ---
# kind:   the namespace of the name
# name:   the name bytes, zero past length
# length: name bytes in use
pub rec Endpoint {
    kind:   Kind;
    name:   [108]u8;
    length: usize;
}

# what the target's local transport supports
# ---
# stream:                   byte streams
# message:                  message-preserving streams
# datagram:                 datagrams
# sequenced_packet:         sequenced packets
# filesystem:               FILESYSTEM endpoints
# abstract:                 ABSTRACT endpoints
# target_names:             TARGET endpoints
# peer_process:             peer identity reports the process
# peer_user:                peer identity reports the user
# peer_group:               peer identity reports the group
# owned_cleanup:            an OWNED listener removes its socket file on close
# conditional_cleanup:      that removal leaves a path that names another file
# listener_rename:          listener_rename is available
# atomic_rename_no_replace: rename refuses an occupied path atomically
# stale_cleanup:            REMOVE_STALE_SOCKET is honoured
# custom_permissions:       bind options may set the socket file's permissions
pub rec Capabilities {
    stream:                   bool;
    message:                  bool;
    datagram:                 bool;
    sequenced_packet:         bool;
    filesystem:               bool;
    abstract:                 bool;
    target_names:             bool;
    peer_process:             bool;
    peer_user:                bool;
    peer_group:               bool;
    owned_cleanup:            bool;
    conditional_cleanup:      bool;
    listener_rename:          bool;
    atomic_rename_no_replace: bool;
    stale_cleanup:            bool;
    custom_permissions:       bool;
}

fun endpoint_error(kind: io_error.Kind) io_error.Error {
    ret io_error.make(kind, io_error.OP_CREATE);
}

# the local transport capabilities of the build target
# ---
# ret: the capability set, all false on a target with no local transport
pub fun capabilities() Capabilities {
    $if ($mach.build.sys == $mach.sys.linux) {
        ret Capabilities{
            stream:                   true,
            message:                  false,
            datagram:                 false,
            sequenced_packet:         false,
            filesystem:               true,
            abstract:                 true,
            target_names:             false,
            peer_process:             true,
            peer_user:                true,
            peer_group:               true,
            owned_cleanup:            true,
            conditional_cleanup:      true,
            listener_rename:          true,
            atomic_rename_no_replace: false,
            stale_cleanup:            true,
            custom_permissions:       true,
        };
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        ret Capabilities{
            stream:                   true,
            message:                  false,
            datagram:                 false,
            sequenced_packet:         false,
            filesystem:               true,
            abstract:                 false,
            target_names:             false,
            peer_process:             false,
            peer_user:                true,
            peer_group:               true,
            owned_cleanup:            true,
            conditional_cleanup:      true,
            listener_rename:          true,
            atomic_rename_no_replace: false,
            stale_cleanup:            true,
            custom_permissions:       true,
        };
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        ret Capabilities{
            stream:                   true,
            message:                  false,
            datagram:                 false,
            sequenced_packet:         false,
            filesystem:               true,
            abstract:                 false,
            target_names:             false,
            peer_process:             false,
            peer_user:                false,
            peer_group:               false,
            owned_cleanup:            true,
            conditional_cleanup:      true,
            listener_rename:          false,
            atomic_rename_no_replace: false,
            stale_cleanup:            false,
            custom_permissions:       false,
        };
    }
    $or {
        ret Capabilities{
            stream:                   false,
            message:                  false,
            datagram:                 false,
            sequenced_packet:         false,
            filesystem:               false,
            abstract:                 false,
            target_names:             false,
            peer_process:             false,
            peer_user:                false,
            peer_group:               false,
            owned_cleanup:            false,
            conditional_cleanup:      false,
            listener_rename:          false,
            atomic_rename_no_replace: false,
            stale_cleanup:            false,
            custom_permissions:       false,
        };
    }
}

# the longest name the target accepts for a kind
# ---
# kind: the endpoint kind
# ret:  the limit in bytes, 0 when the target does not support the kind
pub fun maximum_name_length(kind: Kind) usize {
    if (kind == ABSTRACT) {
        $if ($mach.build.sys == $mach.sys.linux) { ret 107; }
        $or                                      { ret 0; }
    }
    if (kind == TARGET) {
        ret 0;
    }
    if (kind == FILESYSTEM) {
        $if ($mach.build.sys == $mach.sys.darwin)  { ret 103; }
        $or ($mach.build.sys == $mach.sys.linux)   { ret 107; }
        $or ($mach.build.sys == $mach.sys.windows) { ret 107; }
        $or                                        { ret 0; }
    }
    ret 0;
}

# check an endpoint's name is non-empty and within its kind's limit on this target
# ---
# endpoint: the endpoint to check
# ret:      true when the target can use it
pub fun supported(endpoint: Endpoint) bool {
    val limits: usize = maximum_name_length(endpoint.kind);
    ret endpoint.length > 0 && endpoint.length <= limits;
}

fun make_bytes(kind: Kind, data: *u8, length: usize) res[Endpoint, io_error.Error] {
    val limit: usize = maximum_name_length(kind);
    if (kind != FILESYSTEM && kind != ABSTRACT && kind != TARGET) {
        ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.INVALID)};
    }
    if (limit == 0) {
        ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.UNSUPPORTED)};
    }
    if (data == nil || length == 0 || length > limit) {
        ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.INVALID)};
    }
    var endpoint: Endpoint;
    endpoint.kind   = kind;
    endpoint.length = length;
    memory.raw_zero(?endpoint.name[0], NAME_CAPACITY);
    memory.raw_copy(?endpoint.name[0], data, length);
    if (kind == FILESYSTEM || kind == TARGET) {
        var i: usize = 0;
        for (i < length) {
            if (endpoint.name[i] == 0) {
                ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.INVALID)};
            }
            i = i + 1;
        }
    }
    ret res[Endpoint, io_error.Error].ok{endpoint};
}

# a filesystem endpoint named by length bytes of a path
# ---
# data:   the path bytes, copied
# length: path bytes, at most maximum_name_length(FILESYSTEM)
# ret:    the endpoint, INVALID for nil, empty, overlong or NUL-holding bytes,
#         or UNSUPPORTED when the target has no filesystem endpoints
pub fun filesystem_bytes(data: *u8, length: usize) res[Endpoint, io_error.Error] {
    ret make_bytes(FILESYSTEM, data, length);
}

# a filesystem endpoint named by a nul-terminated path
# ---
# path: the path, copied
# ret:  as filesystem_bytes
pub fun filesystem(path: str) res[Endpoint, io_error.Error] {
    ret filesystem_bytes(path::*u8, str_len(path));
}

# a filesystem endpoint from a nul-terminated path in std.runtime.native units
#
# linux and darwin take the path as bytes, so they are the endpoint's name
# unchanged, valid UTF-8 or not. windows sun_path is a byte string too, spelled
# in UTF-8, so the UTF-16 path is converted once, and a path holding an
# unpaired surrogate, which has no UTF-8 spelling, cannot name a local socket
# there. it is refused with INVALID here, before any socket call
# ---
# name: the nul-terminated path
# ret:  the endpoint, or INVALID for a nil, empty, overlong or unspellable path
pub fun filesystem_native(name: *Unit) res[Endpoint, io_error.Error] {
    if (name == nil) { ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.INVALID)}; }
    $if ($mach.build.sys == $mach.sys.windows) {
        var bytes:  [108]u8;
        val length: i64 = windows.local_endpoint_path(name, ?bytes[0], NAME_CAPACITY);
        if (length < 0) { ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.INVALID)}; }
        ret filesystem_bytes(?bytes[0], length::usize);
    }
    $or {
        ret filesystem_bytes(name, str_len(name::str));
    }
}

# an abstract endpoint named by length bytes, NUL bytes included
# ---
# data:   the name bytes, copied
# length: name bytes, at most maximum_name_length(ABSTRACT)
# ret:    the endpoint, INVALID for nil, empty or overlong bytes, or
#         UNSUPPORTED off linux
pub fun abstract(data: *u8, length: usize) res[Endpoint, io_error.Error] {
    ret make_bytes(ABSTRACT, data, length);
}

# a target-name endpoint named by length bytes
# ---
# data:   the name bytes, copied
# length: name bytes
# ret:    the endpoint, or UNSUPPORTED since no current target has target names
pub fun target_bytes(data: *u8, length: usize) res[Endpoint, io_error.Error] {
    ret make_bytes(TARGET, data, length);
}

# a target-name endpoint named by a nul-terminated name
# ---
# name: the name, copied
# ret:  as target_bytes
pub fun target(name: str) res[Endpoint, io_error.Error] {
    ret target_bytes(name::*u8, str_len(name));
}

# compare two endpoints by kind and name bytes
# ---
# a:   first endpoint
# b:   second endpoint
# ret: true when kinds, lengths and bytes match, false for a length past
#      NAME_CAPACITY
pub fun equal(a: Endpoint, b: Endpoint) bool {
    if (a.length > NAME_CAPACITY || b.length > NAME_CAPACITY || a.kind != b.kind || a.length != b.length) { ret false; }
    var i: usize = 0;
    for (i < a.length) {
        if (a.name[i] != b.name[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# serialize only sockaddr-based endpoints
# ---
# endpoint: the endpoint to encode
# address:  storage for the sockaddr, zeroed first
# capacity: bytes at address
# length:   receives the sockaddr length
# ret:      ok, INVALID for nil storage, an unsupported endpoint or too little
#           room, or UNSUPPORTED for a kind with no sockaddr form
pub fun to_sockaddr(endpoint: Endpoint, address: *u8, capacity: usize, length: *usize) err[io_error.Kind] {
    if (address == nil || length == nil || capacity < 2 || !supported(endpoint)) { ret err[io_error.Kind].err{io_error.INVALID}; }
    if (endpoint.kind == TARGET)                                                 { ret err[io_error.Kind].err{io_error.UNSUPPORTED}; }
    memory.raw_zero(address, capacity);
    $if ($mach.build.sys == $mach.sys.darwin) {
        val required: usize = 2 + endpoint.length + 1;
        if (endpoint.kind != FILESYSTEM)           { ret err[io_error.Kind].err{io_error.UNSUPPORTED}; }
        if (required > capacity || required > 106) { ret err[io_error.Kind].err{io_error.INVALID}; }
        address[0] = required::u8;
        address[1] = 1;
        memory.raw_copy((address::usize + 2)::ptr, ?endpoint.name[0], endpoint.length);
        @length = required;
        ret err[io_error.Kind].ok{};
    }
    $or {
        address[0] = 1;
        address[1] = 0;
        if (endpoint.kind == ABSTRACT) {
            val required: usize = 3 + endpoint.length;
            if (required > capacity || required > 110) { ret err[io_error.Kind].err{io_error.INVALID}; }
            address[2] = 0;
            memory.raw_copy((address::usize + 3)::ptr, ?endpoint.name[0], endpoint.length);
            @length = required;
            ret err[io_error.Kind].ok{};
        }
        val required: usize = 2 + endpoint.length + 1;
        if (required > capacity || required > 110) { ret err[io_error.Kind].err{io_error.INVALID}; }
        memory.raw_copy((address::usize + 2)::ptr, ?endpoint.name[0], endpoint.length);
        @length = required;
        ret err[io_error.Kind].ok{};
    }
}

# decode a local sockaddr into an endpoint
# ---
# address:  the sockaddr bytes
# length:   the sockaddr length the system reported
# endpoint: receives the endpoint
# ret:      ok, or INVALID for a nil pointer, a malformed address or a name
#           the target does not accept
pub fun from_sockaddr(address: *u8, length: usize, endpoint: *Endpoint) err[io_error.Kind] {
    if (address == nil || endpoint == nil || length < 2) { ret err[io_error.Kind].err{io_error.INVALID}; }
    $if ($mach.build.sys == $mach.sys.darwin) {
        if (length > 106 || address[1] != 1 || address[0]::usize != length || address[0]::usize < 3) { ret err[io_error.Kind].err{io_error.INVALID}; }
        var name_length: usize = address[0]::usize - 2;
        if (address[1 + name_length] == 0) { name_length = name_length - 1; }
        val res_made: res[Endpoint, io_error.Error] = filesystem_bytes((address::usize + 2)::*u8, name_length);
        if (sel res_made.err) { ret err[io_error.Kind].err{io_error.INVALID}; }
        @endpoint = res_made.ok;
        ret err[io_error.Kind].ok{};
    }
    $or {
        if (length > 110 || address[0] != 1 || address[1] != 0 || length < 3) { ret err[io_error.Kind].err{io_error.INVALID}; }
        var kind:        Kind  = FILESYSTEM;
        var offset:      usize = 2;
        var name_length: usize = length - 2;
        if (address[2] == 0) {
            kind        = ABSTRACT;
            offset      = 3;
            name_length = length - 3;
        }
        or (address[length - 1] == 0) {
            name_length = name_length - 1;
        }
        val res_made: res[Endpoint, io_error.Error] = make_bytes(kind, (address::usize + offset)::*u8, name_length);
        if (sel res_made.err) { ret err[io_error.Kind].err{io_error.INVALID}; }
        @endpoint = res_made.ok;
        ret err[io_error.Kind].ok{};
    }
}

#[testing]
fun succeeded(r: err[io_error.Kind]) bool {
    ret sel r.ok;
}

#[testing]
fun refused_invalid(r: err[io_error.Kind]) bool {
    ret sel r.err && r.err == io_error.INVALID;
}

# a filesystem endpoint for leaf inside a test's scratch directory, whose
# path is written to out as well
#[testing]
pub fun scratch_endpoint(scratch: *shared.Scratch, leaf: str, out: *shared.ScratchPath) res[Endpoint, io_error.Error] {
    val name: str = shared.scratch_path(scratch, leaf, out);
    ret filesystem_bytes(name, str_len(name));
}

test local_endpoint__malformed_sockaddr_lengths_never_reach_name_storage {
    var address: [128]u8;
    var decoded: Endpoint;
    var i:       usize = 0;
    for (i < 128) {
        address[i] = 0;
        i          = i + 1;
    }
    $if ($mach.build.sys == $mach.sys.darwin) {
        address[0] = 3;
        address[1] = 1;
        address[2] = 'x';
        if (!refused_invalid(from_sockaddr(?address[0], 107, ?decoded))) { ret 1; }
        if (!refused_invalid(from_sockaddr(?address[0], 4, ?decoded)))   { ret 2; }
        address[0] = 3;
        address[1] = 2;
        if (!refused_invalid(from_sockaddr(?address[0], 3, ?decoded))) { ret 3; }
    }
    $or {
        address[0] = 1;
        address[1] = 0;
        address[2] = 'x';
        if (!refused_invalid(from_sockaddr(?address[0], 111, ?decoded))) { ret 4; }
        address[0] = 2;
        if (!refused_invalid(from_sockaddr(?address[0], 3, ?decoded))) { ret 5; }
    }
    var malformed: Endpoint;
    malformed.kind   = FILESYSTEM;
    malformed.length = NAME_CAPACITY + 1;
    if (equal(malformed, malformed)) { ret 6; }
    ret 0;
}

test local_endpoint__sockaddr_round_trip_preserves_tagged_bytes {
    # a target with no sockets names no local endpoint, so this cannot run there
    if (!capability.HAS_SOCKETS) { ret 77; }
    var input: [5]u8;
    input[0] = 'm';
    input[1] = 'a';
    input[2] = 'c';
    input[3] = 'h';
    input[4] = 0xff;
    val res_made: res[Endpoint, io_error.Error] = filesystem_bytes(?input[0], 5);
    if (sel res_made.err) { ret 1; }
    val original:       Endpoint = res_made.ok;
    var address:        [128]u8;
    var address_length: usize    = 0;
    if (!succeeded(to_sockaddr(original, ?address[0], 128, ?address_length))) { ret 2; }
    var decoded: Endpoint;
    if (!succeeded(from_sockaddr(?address[0], address_length, ?decoded)) || !equal(original, decoded)) { ret 3; }
    ret 0;
}

test local_endpoint__unsupported_forms_and_overlong_names_fail_before_copy {
    var bytes: [108]u8;
    var i:     usize = 0;
    for (i < 108) {
        bytes[i] = 'x';
        i        = i + 1;
    }
    val res_overlong: res[Endpoint, io_error.Error] = filesystem_bytes(?bytes[0], 108);
    if (sel res_overlong.ok) { ret 1; }
    $if ($mach.build.sys == $mach.sys.linux) {
        val res_abstract: res[Endpoint, io_error.Error] = abstract(?bytes[0], 4);
        if (sel res_abstract.err) { ret 2; }
        val res_target_bytes: res[Endpoint, io_error.Error] = target_bytes(?bytes[0], 4);
        if (sel res_target_bytes.ok) { ret 3; }
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        val res_abstract: res[Endpoint, io_error.Error] = abstract(?bytes[0], 4);
        if (sel res_abstract.ok) { ret 4; }
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        val res_filesystem_bytes: res[Endpoint, io_error.Error] = filesystem_bytes(?bytes[0], 4);
        if (sel res_filesystem_bytes.err) { ret 5; }
        val res_target_bytes: res[Endpoint, io_error.Error] = target_bytes(?bytes[0], 4);
        if (sel res_target_bytes.ok) { ret 6; }
    }
    ret 0;
}

# windows refuses at construction, so no socket call ever sees the path
test filesystem_native__passes_bytes_through_and_refuses_a_path_with_no_utf_8_spelling {
    # a target with no sockets names no local endpoint, so this cannot run there
    if (!capability.HAS_SOCKETS) { ret 77; }
    var name: [8]Unit;
    name[0] = 'm';
    name[1] = 'a';
    name[2] = 'c';
    name[3] = 'h';
    $if ($mach.build.sys == $mach.sys.windows) {
        name[4] = 0x00e9;
        name[5] = 0;
        val res_spelled: res[Endpoint, io_error.Error] = filesystem_native(?name[0]);
        val res_utf8:    res[Endpoint, io_error.Error] = filesystem("maché");
        if (sel res_spelled.err)                 { ret 1; }
        if (sel res_utf8.err)                    { ret 1; }
        if (!equal(res_spelled.ok, res_utf8.ok)) { ret 2; }
        name[4] = 0xd800;
        val res_lone: res[Endpoint, io_error.Error] = filesystem_native(?name[0]);
        if (!(sel res_lone.err && res_lone.err.kind == io_error.INVALID)) { ret 3; }
    }
    $or {
        name[4] = 0xff;
        name[5] = 0xfe;
        name[6] = 0;
        val res_native: res[Endpoint, io_error.Error] = filesystem_native(?name[0]);
        val res_bytes:  res[Endpoint, io_error.Error] = filesystem_bytes(?name[0], 6);
        if (sel res_native.err)                                                   { ret 4; }
        if (sel res_bytes.err)                                                    { ret 4; }
        if (!equal(res_native.ok, res_bytes.ok) || res_native.ok.name[5] != 0xfe) { ret 5; }
    }
    val res_empty: res[Endpoint, io_error.Error] = filesystem_native(?name[6]);
    if (!(sel res_empty.err && res_empty.err.kind == io_error.INVALID)) { ret 6; }
    ret 0;
}

# a filesystem name with an embedded NUL is refused, since the native path would
# stop at it and name a different file. on linux an abstract name keeps its NUL
# bytes and round-trips through its leading-NUL sockaddr form
test local_endpoint__embedded_nul_refuses_a_path_and_survives_an_abstract_name {
    # a target with no sockets names no local endpoint, so this cannot run there
    if (!capability.HAS_SOCKETS) { ret 77; }
    var bytes: [3]u8;
    bytes[0] = 'a';
    bytes[1] = 0;
    bytes[2] = 'b';
    val res_path: res[Endpoint, io_error.Error] = filesystem_bytes(?bytes[0], 3);
    if (!(sel res_path.err && res_path.err.kind == io_error.INVALID)) { ret 1; }
    $if ($mach.build.sys == $mach.sys.linux) {
        val res_abstract: res[Endpoint, io_error.Error] = abstract(?bytes[0], 3);
        if (sel res_abstract.err) { ret 2; }
        val original:       Endpoint = res_abstract.ok;
        var address:        [128]u8;
        var address_length: usize    = 0;
        if (!succeeded(to_sockaddr(original, ?address[0], 128, ?address_length)))                                { ret 3; }
        if (address_length != 6 || address[2] != 0 || address[3] != 'a' || address[4] != 0 || address[5] != 'b') { ret 4; }
        var decoded: Endpoint;
        if (!succeeded(from_sockaddr(?address[0], address_length, ?decoded))) { ret 5; }
        if (decoded.kind != ABSTRACT || !equal(original, decoded))            { ret 6; }
    }
    ret 0;
}
