# tagged local transport endpoints and target capabilities

use io_error: std.io.error;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

pub def Kind: u8;
pub val FILESYSTEM: Kind = 1;
pub val ABSTRACT:   Kind = 2;
pub val TARGET:     Kind = 3;

pub val NAME_CAPACITY: usize = 108;

# names are byte sequences and are never truncated or implicitly normalized
pub rec Endpoint {
    kind:   Kind;
    name:   [108]u8;
    length: usize;
}

pub rec Capabilities {
    stream:                   bool;
    message:                  bool;
    datagram:                 bool;
    sequenced_packet:         bool;
    filesystem:               bool;
    abstract:                 bool;
    target_names:             bool;
    peer_process:             bool;
    peer_user:                bool;
    peer_group:               bool;
    owned_cleanup:            bool;
    conditional_cleanup:      bool;
    listener_rename:          bool;
    atomic_rename_no_replace: bool;
    stale_cleanup:            bool;
    custom_permissions:       bool;
}

fun endpoint_error(kind: io_error.Kind) io_error.Error {
    ret io_error.make(kind, io_error.OP_CREATE);
}

pub fun capabilities() Capabilities {
    $if ($mach.build.os == $mach.os.linux) {
        ret Capabilities{
            stream:                   true,
            message:                  false,
            datagram:                 false,
            sequenced_packet:         false,
            filesystem:               true,
            abstract:                 true,
            target_names:             false,
            peer_process:             true,
            peer_user:                true,
            peer_group:               true,
            owned_cleanup:            true,
            conditional_cleanup:      true,
            listener_rename:          true,
            atomic_rename_no_replace: false,
            stale_cleanup:            true,
            custom_permissions:       true,
        };
    }
    $or ($mach.build.os == $mach.os.darwin) {
        ret Capabilities{
            stream:                   true,
            message:                  false,
            datagram:                 false,
            sequenced_packet:         false,
            filesystem:               true,
            abstract:                 false,
            target_names:             false,
            peer_process:             false,
            peer_user:                true,
            peer_group:               true,
            owned_cleanup:            true,
            conditional_cleanup:      true,
            listener_rename:          true,
            atomic_rename_no_replace: false,
            stale_cleanup:            true,
            custom_permissions:       true,
        };
    }
    $or ($mach.build.os == $mach.os.windows) {
        ret Capabilities{
            stream:                   true,
            message:                  false,
            datagram:                 false,
            sequenced_packet:         false,
            filesystem:               true,
            abstract:                 false,
            target_names:             false,
            peer_process:             false,
            peer_user:                false,
            peer_group:               false,
            owned_cleanup:            true,
            conditional_cleanup:      true,
            listener_rename:          false,
            atomic_rename_no_replace: false,
            stale_cleanup:            false,
            custom_permissions:       false,
        };
    }
    $or {
        ret Capabilities{
            stream:                   false,
            message:                  false,
            datagram:                 false,
            sequenced_packet:         false,
            filesystem:               false,
            abstract:                 false,
            target_names:             false,
            peer_process:             false,
            peer_user:                false,
            peer_group:               false,
            owned_cleanup:            false,
            conditional_cleanup:      false,
            listener_rename:          false,
            atomic_rename_no_replace: false,
            stale_cleanup:            false,
            custom_permissions:       false,
        };
    }
}

pub fun maximum_name_length(kind: Kind) usize {
    if (kind == ABSTRACT) {
        $if ($mach.build.os == $mach.os.linux) { ret 107; }
        $or                                    { ret 0; }
    }
    if (kind == TARGET) {
        ret 0;
    }
    if (kind == FILESYSTEM) {
        $if ($mach.build.os == $mach.os.darwin)  { ret 103; }
        $or ($mach.build.os == $mach.os.linux)   { ret 107; }
        $or ($mach.build.os == $mach.os.windows) { ret 107; }
        $or                                      { ret 0; }
    }
    ret 0;
}

pub fun supported(endpoint: Endpoint) bool {
    val limits: usize = maximum_name_length(endpoint.kind);
    ret endpoint.length > 0 && endpoint.length <= limits;
}

fun make_bytes(kind: Kind, data: *u8, length: usize) res[Endpoint, io_error.Error] {
    val limit: usize = maximum_name_length(kind);
    if (kind != FILESYSTEM && kind != ABSTRACT && kind != TARGET) {
        ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.INVALID)};
    }
    if (limit == 0) {
        ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.UNSUPPORTED)};
    }
    if (data == nil || length == 0 || length > limit) {
        ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.INVALID)};
    }
    var endpoint: Endpoint;
    endpoint.kind   = kind;
    endpoint.length = length;
    memory.raw_zero(?endpoint.name[0], NAME_CAPACITY);
    memory.raw_copy(?endpoint.name[0], data, length);
    if (kind == FILESYSTEM || kind == TARGET) {
        var i: usize = 0;
        for (i < length) {
            if (endpoint.name[i] == 0) {
                ret res[Endpoint, io_error.Error].err{endpoint_error(io_error.INVALID)};
            }
            i = i + 1;
        }
    }
    ret res[Endpoint, io_error.Error].ok{endpoint};
}

pub fun filesystem_bytes(data: *u8, length: usize) res[Endpoint, io_error.Error] {
    ret make_bytes(FILESYSTEM, data, length);
}

pub fun filesystem(path: str) res[Endpoint, io_error.Error] {
    ret filesystem_bytes(path::*u8, str_len(path));
}

pub fun abstract(data: *u8, length: usize) res[Endpoint, io_error.Error] {
    ret make_bytes(ABSTRACT, data, length);
}

pub fun target_bytes(data: *u8, length: usize) res[Endpoint, io_error.Error] {
    ret make_bytes(TARGET, data, length);
}

pub fun target(name: str) res[Endpoint, io_error.Error] {
    ret target_bytes(name::*u8, str_len(name));
}

pub fun equal(a: Endpoint, b: Endpoint) bool {
    if (a.length > NAME_CAPACITY || b.length > NAME_CAPACITY || a.kind != b.kind || a.length != b.length) { ret false; }
    var i: usize = 0;
    for (i < a.length) {
        if (a.name[i] != b.name[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# serialize only sockaddr-based endpoints
pub fun to_sockaddr(endpoint: Endpoint, address: *u8, capacity: usize, length: *usize) err[io_error.Kind] {
    if (address == nil || length == nil || capacity < 2 || !supported(endpoint)) { ret err[io_error.Kind].err{io_error.INVALID}; }
    if (endpoint.kind == TARGET)                                                 { ret err[io_error.Kind].err{io_error.UNSUPPORTED}; }
    memory.raw_zero(address, capacity);
    $if ($mach.build.os == $mach.os.darwin) {
        val required: usize = 2 + endpoint.length + 1;
        if (endpoint.kind != FILESYSTEM)           { ret err[io_error.Kind].err{io_error.UNSUPPORTED}; }
        if (required > capacity || required > 106) { ret err[io_error.Kind].err{io_error.INVALID}; }
        address[0] = required::u8;
        address[1] = 1;
        memory.raw_copy((address::usize + 2)::ptr, ?endpoint.name[0], endpoint.length);
        @length = required;
        ret err[io_error.Kind].ok{};
    }
    $or {
        address[0] = 1;
        address[1] = 0;
        if (endpoint.kind == ABSTRACT) {
            val required: usize = 3 + endpoint.length;
            if (required > capacity || required > 110) { ret err[io_error.Kind].err{io_error.INVALID}; }
            address[2] = 0;
            memory.raw_copy((address::usize + 3)::ptr, ?endpoint.name[0], endpoint.length);
            @length = required;
            ret err[io_error.Kind].ok{};
        }
        val required: usize = 2 + endpoint.length + 1;
        if (required > capacity || required > 110) { ret err[io_error.Kind].err{io_error.INVALID}; }
        memory.raw_copy((address::usize + 2)::ptr, ?endpoint.name[0], endpoint.length);
        @length = required;
        ret err[io_error.Kind].ok{};
    }
}

pub fun from_sockaddr(address: *u8, length: usize, endpoint: *Endpoint) err[io_error.Kind] {
    if (address == nil || endpoint == nil || length < 2) { ret err[io_error.Kind].err{io_error.INVALID}; }
    $if ($mach.build.os == $mach.os.darwin) {
        if (length > 106 || address[1] != 1 || address[0]::usize != length || address[0]::usize < 3) { ret err[io_error.Kind].err{io_error.INVALID}; }
        var name_length: usize = address[0]::usize - 2;
        if (address[1 + name_length] == 0) { name_length = name_length - 1; }
        val made: res[Endpoint, io_error.Error] = filesystem_bytes((address::usize + 2)::*u8, name_length);
        if (sel made.err) { ret err[io_error.Kind].err{io_error.INVALID}; }
        @endpoint = made.ok;
        ret err[io_error.Kind].ok{};
    }
    $or {
        if (length > 110 || address[0] != 1 || address[1] != 0 || length < 3) { ret err[io_error.Kind].err{io_error.INVALID}; }
        var kind:        Kind  = FILESYSTEM;
        var offset:      usize = 2;
        var name_length: usize = length - 2;
        if (address[2] == 0) {
            kind        = ABSTRACT;
            offset      = 3;
            name_length = length - 3;
        }
        or (address[length - 1] == 0) {
            name_length = name_length - 1;
        }
        val made: res[Endpoint, io_error.Error] = make_bytes(kind, (address::usize + offset)::*u8, name_length);
        if (sel made.err) { ret err[io_error.Kind].err{io_error.INVALID}; }
        @endpoint = made.ok;
        ret err[io_error.Kind].ok{};
    }
}

fun succeeded(r: err[io_error.Kind]) bool {
    ret sel r.ok;
}

fun refused_invalid(r: err[io_error.Kind]) bool {
    ret sel r.err && r.err == io_error.INVALID;
}

test local_endpoint__malformed_sockaddr_lengths_never_reach_name_storage {
    var address: [128]u8;
    var decoded: Endpoint;
    var i:       usize = 0;
    for (i < 128) {
        address[i] = 0;
        i          = i + 1;
    }
    $if ($mach.build.os == $mach.os.darwin) {
        address[0] = 3;
        address[1] = 1;
        address[2] = 'x';
        if (!refused_invalid(from_sockaddr(?address[0], 107, ?decoded))) { ret 1; }
        if (!refused_invalid(from_sockaddr(?address[0], 4, ?decoded)))   { ret 2; }
        address[0] = 3;
        address[1] = 2;
        if (!refused_invalid(from_sockaddr(?address[0], 3, ?decoded))) { ret 3; }
    }
    $or {
        address[0] = 1;
        address[1] = 0;
        address[2] = 'x';
        if (!refused_invalid(from_sockaddr(?address[0], 111, ?decoded))) { ret 4; }
        address[0] = 2;
        if (!refused_invalid(from_sockaddr(?address[0], 3, ?decoded))) { ret 5; }
    }
    var malformed: Endpoint;
    malformed.kind   = FILESYSTEM;
    malformed.length = NAME_CAPACITY + 1;
    if (equal(malformed, malformed)) { ret 6; }
    ret 0;
}

test local_endpoint__sockaddr_round_trip_preserves_tagged_bytes {
    var input: [5]u8;
    input[0] = 'm';
    input[1] = 'a';
    input[2] = 'c';
    input[3] = 'h';
    input[4] = 0xff;
    val made: res[Endpoint, io_error.Error] = filesystem_bytes(?input[0], 5);
    if (sel made.err) { ret 1; }
    val original:       Endpoint = made.ok;
    var address:        [128]u8;
    var address_length: usize    = 0;
    if (!succeeded(to_sockaddr(original, ?address[0], 128, ?address_length))) { ret 2; }
    var decoded: Endpoint;
    if (!succeeded(from_sockaddr(?address[0], address_length, ?decoded)) || !equal(original, decoded)) { ret 3; }
    ret 0;
}

test local_endpoint__unsupported_forms_and_overlong_names_fail_before_copy {
    var bytes: [108]u8;
    var i:     usize = 0;
    for (i < 108) {
        bytes[i] = 'x';
        i        = i + 1;
    }
    val overlong: res[Endpoint, io_error.Error] = filesystem_bytes(?bytes[0], 108);
    if (sel overlong.ok) { ret 1; }
    $if ($mach.build.os == $mach.os.linux) {
        val abstract_result: res[Endpoint, io_error.Error] = abstract(?bytes[0], 4);
        if (sel abstract_result.err) { ret 2; }
        val target_bytes_result: res[Endpoint, io_error.Error] = target_bytes(?bytes[0], 4);
        if (sel target_bytes_result.ok) { ret 3; }
    }
    $or ($mach.build.os == $mach.os.darwin) {
        val abstract_result: res[Endpoint, io_error.Error] = abstract(?bytes[0], 4);
        if (sel abstract_result.ok) { ret 4; }
    }
    $or ($mach.build.os == $mach.os.windows) {
        val filesystem_bytes_result: res[Endpoint, io_error.Error] = filesystem_bytes(?bytes[0], 4);
        if (sel filesystem_bytes_result.err) { ret 5; }
        val target_bytes_result: res[Endpoint, io_error.Error] = target_bytes(?bytes[0], 4);
        if (sel target_bytes_result.ok) { ret 6; }
    }
    ret 0;
}
