# windows AF_UNIX local byte streams

$if ($mach.build.os != $mach.os.windows) {
    $error("std.net.local.windows: requires windows target");
}

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.size.isize;
use std.system.os;
use std.net.socket;
use std.net.local.endpoint;
use std.net.local.types;

val AF_UNIX: i32 = 1;

fun path_buffer(value: endpoint.Endpoint, output: *u8) {
    var i: usize = 0;
    for (i < value.length) { output[i] = value.name[i]; i = i + 1; }
    output[value.length] = 0;
}

fun remove_owned(value: endpoint.Endpoint) i64 {
    if (value.kind != endpoint.FILESYSTEM) { ret 0; }
    var path: [108]u8;
    path_buffer(value, ?path[0]);
    val code: i64 = os.unlink(os.AT_FDCWD, ?path[0], 0);
    if (code == os.ENOENT) { ret 0; }
    ret code;
}

pub fun create_stream(value: endpoint.Endpoint, asynchronous: bool, handle: *usize) i64 {
    var flags: socket.Flags = socket.blocking_flags();
    if (asynchronous) { flags = socket.async_flags(); }
    ret os.sock_create_flags(AF_UNIX, os.SOCK_STREAM, 0, flags.nonblocking, flags.non_inheritable, handle);
}

pub fun connect_start(handle: usize, value: endpoint.Endpoint) i64 {
    var address: [128]u8;
    var length: usize = 0;
    val encoded: i64 = endpoint.to_sockaddr(value, ?address[0], 128, ?length);
    if (encoded < 0) { ret encoded; }
    ret os.sock_connect(handle, ?address[0], length);
}

pub fun listen(listener: *types.Listener, value: endpoint.Endpoint, options: types.ListenOptions) i64 {
    if (options.stale == types.REMOVE_STALE_SOCKET || options.permissions != types.INHERIT_PERMISSIONS) {
        ret os.ENOTSUP;
    }
    var handle: usize = (-1)::isize::usize;
    var code: i64 = create_stream(value, true, ?handle);
    if (code < 0) { ret code; }
    var address: [128]u8;
    var length: usize = 0;
    code = endpoint.to_sockaddr(value, ?address[0], 128, ?length);
    if (code >= 0) { code = os.sock_bind(handle, ?address[0], length); }
    var bound: bool = code >= 0;
    if (code >= 0) { code = os.sock_listen(handle, options.backlog); }
    if (code < 0) {
        os.sock_close(handle);
        if (bound) { remove_owned(value); }
        ret code;
    }
    listener.handle = handle;
    ret 0;
}

pub fun connect(stream: *types.Stream, value: endpoint.Endpoint, asynchronous: bool) i64 {
    var handle: usize = (-1)::isize::usize;
    val created: i64 = create_stream(value, asynchronous, ?handle);
    if (created < 0) { ret created; }
    val code: i64 = connect_start(handle, value);
    if (code < 0) {
        os.sock_close(handle);
        ret code;
    }
    stream.handle = handle;
    stream.server_side = false;
    ret 0;
}

pub fun accept(listener: *types.Listener, stream: *types.Stream, asynchronous: bool) i64 {
    var flags: socket.Flags = socket.blocking_flags();
    if (asynchronous) { flags = socket.async_flags(); }
    var handle: usize = (-1)::isize::usize;
    var address: [128]u8;
    var length: u32 = 128;
    val code: i64 = os.sock_accept_flags(listener.handle, ?address[0], ?length, flags.nonblocking, flags.non_inheritable, ?handle);
    if (code < 0) { ret code; }
    stream.handle = handle;
    stream.server_side = true;
    ret 0;
}

pub fun read(handle: usize, buffer: *u8, length: usize) i64 {
    ret os.sock_recv(handle, buffer, length);
}

pub fun write(handle: usize, buffer: *u8, length: usize) i64 {
    ret os.sock_send(handle, buffer, length);
}

pub fun shutdown_write(handle: usize) i64 {
    ret os.sock_shutdown(handle, os.SHUT_WR);
}

pub fun peer_identity(handle: usize, server_side: bool, identity: *types.PeerIdentity) i64 {
    ret os.ENOTSUP;
}

pub fun rename(listener: *types.Listener, replacement: endpoint.Endpoint) i64 {
    var source: [108]u8;
    var destination: [108]u8;
    path_buffer(listener.endpoint, ?source[0]);
    path_buffer(replacement, ?destination[0]);
    ret os.rename(os.AT_FDCWD, ?source[0], os.AT_FDCWD, ?destination[0]);
}

pub fun close_stream(handle: usize, server_side: bool) i64 {
    ret os.sock_close(handle);
}

pub fun close_listener(handle: usize, value: endpoint.Endpoint, owned: bool) i64 {
    val closed: i64 = os.sock_close(handle);
    var removed: i64 = 0;
    if (owned) { removed = remove_owned(value); }
    if (closed < 0) { ret closed; }
    ret removed;
}
