# windows af_unix local byte streams

$if ($mach.build.sys != $mach.sys.windows) {
    $error("std.net.local.windows: requires windows target");
}

use io_error: std.io.error;
use std.net.local.endpoint;
use std.net.local.types;
use std.net.socket;
use std.system.os;
use std.system.os.windows;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.isize;
use std.types.size.usize;

val AF_UNIX: i32 = 1;

fun path_buffer(value: endpoint.Endpoint, output: *u8) {
    var i: usize = 0;
    for (i < value.length) {
        output[i] = value.name[i];
        i         = i + 1;
    }
    output[value.length] = 0;
}

fun capture_identity(listener: *types.Listener) i64 {
    if (listener.endpoint.kind != endpoint.FILESYSTEM) {
        listener.has_node_identity = false;
        ret 0;
    }
    var path: [108]u8;
    path_buffer(listener.endpoint, ?path[0]);
    var device: u64 = 0;
    var file:   u64 = 0;
    val code:   i64 = windows.local_endpoint_identity(?path[0], ?device, ?file);
    if (code < 0) { ret code; }
    listener.node_device       = device;
    listener.node_file         = file;
    listener.has_node_identity = true;
    ret 0;
}

fun remove_owned(listener: *types.Listener) i64 {
    if (listener.endpoint.kind != endpoint.FILESYSTEM) { ret 0; }
    var path: [108]u8;
    path_buffer(listener.endpoint, ?path[0]);
    var device:    u64 = 0;
    var file:      u64 = 0;
    val inspected: i64 = windows.local_endpoint_identity(?path[0], ?device, ?file);
    if (inspected == windows.ENOENT)  { ret 0; }
    if (inspected == windows.ENOTSUP) { ret windows.EBUSY; }
    if (inspected < 0)                { ret inspected; }
    if (!listener.has_node_identity
        || device != listener.node_device
        || file != listener.node_file) {
        ret windows.EBUSY;
    }
    val code: i64 = os.unlink(os.working_dir(), ?path[0], 0);
    if (code == windows.ENOENT) { ret 0; }
    ret code;
}

# remove a listener's socket file when the path still names it, whatever its ownership
# ---
# listener: the listener whose file to remove
# ret:      0 when removed or already gone, a negative native code otherwise,
#           EBUSY when the path names another file or its identity cannot be read
pub fun cleanup_listener(listener: *types.Listener) i64 {
    ret remove_owned(listener);
}

# create an unbound local stream socket
# ---
# value:        the endpoint the socket is for, unused
# asynchronous: make it nonblocking
# handle:       receives the native socket, which the caller closes
# ret:          0, or a negative native code
pub fun create_stream(value: endpoint.Endpoint, asynchronous: bool, handle: *usize) i64 {
    var flags: socket.Flags = socket.blocking_flags();
    if (asynchronous) { flags = socket.async_flags(); }
    ret os.sock_create_flags(AF_UNIX, os.SOCK_STREAM, 0, flags.nonblocking, flags.non_inheritable, handle);
}

# the sockaddr for value, or the native code for the reason it has none
fun encode(value: endpoint.Endpoint, address: *u8, length: *usize) i64 {
    val err_encoded: err[io_error.Kind] = endpoint.to_sockaddr(value, address, 128, length);
    if (!sel err_encoded.err)                    { ret 0; }
    if (err_encoded.err == io_error.UNSUPPORTED) { ret windows.ENOTSUP; }
    ret windows.EINVAL;
}

# connect a socket to an endpoint
# ---
# handle: the native socket
# value:  the endpoint to connect to
# ret:    0, or a negative native code, ENOTSUP for a kind with no sockaddr
#         form and EINVAL for an endpoint that does not encode
pub fun connect_start(handle: usize, value: endpoint.Endpoint) i64 {
    var address: [128]u8;
    var length:  usize = 0;
    val encoded: i64   = encode(value, ?address[0], ?length);
    if (encoded < 0) { ret encoded; }
    ret os.sock_connect(handle, ?address[0], length);
}

# create a nonblocking socket and bind a listener to an endpoint
#
# a failure after the socket is created closes it, removes a socket file the
# bind made and sets listener.handle to all ones. an earlier failure leaves
# listener.handle untouched
# ---
# listener: the listener to bind, its endpoint and ownership already set
# value:    the endpoint to bind
# options:  stale policy and permissions
# ret:      0, or a negative native code, ENOTSUP for a stale policy or
#           permissions other than REJECT_STALE and INHERIT_PERMISSIONS
pub fun bind(listener: *types.Listener, value: endpoint.Endpoint, options: types.BindOptions) i64 {
    if (options.stale == types.REMOVE_STALE_SOCKET || options.permissions != types.INHERIT_PERMISSIONS) {
        ret windows.ENOTSUP;
    }
    var handle: usize = (-1)::isize::usize;
    var code:   i64   = create_stream(value, true, ?handle);
    if (code < 0) { ret code; }
    var address: [128]u8;
    var length:  usize = 0;
    code = encode(value, ?address[0], ?length);
    if (code >= 0) { code = os.sock_bind(handle, ?address[0], length); }
    var bound: bool = code >= 0;
    listener.handle = handle;
    if (code >= 0) { code = capture_identity(listener); }
    if (code < 0) {
        os.sock_close(handle);
        if (bound) { remove_owned(listener); }
        listener.handle = (-1)::isize::usize;
        ret code;
    }
    ret 0;
}

# start listening on a bound listener
# ---
# listener: the bound listener
# backlog:  pending connections the system may queue
# ret:      0, or a negative native code
pub fun start_listener(listener: *types.Listener, backlog: i32) i64 {
    ret os.sock_listen(listener.handle, backlog);
}

# bind a listener and start listening, closing it when listening fails
# ---
# listener: the listener to bind, its endpoint and ownership already set
# value:    the endpoint to bind
# options:  backlog, stale policy and permissions
# ret:      0, or a negative native code
pub fun listen(listener: *types.Listener, value: endpoint.Endpoint, options: types.ListenOptions) i64 {
    val bind_options: types.BindOptions = types.BindOptions{
        ownership:   options.ownership,
        stale:       options.stale,
        permissions: options.permissions,
    };
    val bound: i64 = bind(listener, value, bind_options);
    if (bound < 0) { ret bound; }
    val listening: i64 = start_listener(listener, options.backlog);
    if (listening < 0) {
        close_listener(listener);
        ret listening;
    }
    ret 0;
}

# create a socket and connect it to an endpoint as a client stream
# ---
# stream:       receives the connected stream, which the caller closes
# value:        the endpoint to connect to
# asynchronous: make the socket nonblocking
# ret:          0, or a negative native code
pub fun connect(stream: *types.Stream, value: endpoint.Endpoint, asynchronous: bool) i64 {
    var handle:  usize = (-1)::isize::usize;
    val created: i64   = create_stream(value, asynchronous, ?handle);
    if (created < 0) { ret created; }
    val code: i64 = connect_start(handle, value);
    if (code < 0) {
        os.sock_close(handle);
        ret code;
    }
    stream.handle      = handle;
    stream.server_side = false;
    ret 0;
}

# accept one connection as a server-side stream
# ---
# listener:     the listening listener
# stream:       receives the accepted stream, which the caller closes
# asynchronous: make the accepted socket nonblocking
# ret:          0, or a negative native code
pub fun accept(listener: *types.Listener, stream: *types.Stream, asynchronous: bool) i64 {
    var flags: socket.Flags = socket.blocking_flags();
    if (asynchronous) { flags = socket.async_flags(); }
    var handle:  usize = (-1)::isize::usize;
    var address: [128]u8;
    var length:  u32   = 128;
    val code:    i64   = os.sock_accept_flags(listener.handle, ?address[0], ?length, flags.nonblocking, flags.non_inheritable, ?handle);
    if (code < 0) { ret code; }
    stream.handle      = handle;
    stream.server_side = true;
    ret 0;
}

# receive bytes on a stream
# ---
# handle: the native socket
# buffer: storage for the bytes
# length: bytes of storage
# ret:    bytes received, 0 at the end of the stream, or a negative native code
pub fun read(handle: usize, buffer: *u8, length: usize) i64 {
    ret os.sock_recv(handle, buffer, length);
}

# send bytes on a stream
# ---
# handle: the native socket
# buffer: the bytes to send
# length: bytes to send
# ret:    bytes sent, or a negative native code
pub fun write(handle: usize, buffer: *u8, length: usize) i64 {
    ret os.sock_send(handle, buffer, length);
}

# shut down a stream's sending side
# ---
# handle: the native socket
# ret:    0, or a negative native code
pub fun shutdown_write(handle: usize) i64 {
    ret os.sock_shutdown(handle, os.SHUT_WR);
}

# peer credentials, which windows local sockets do not report
# ---
# handle:      the native socket, unused
# server_side: unused
# identity:    left untouched
# ret:         ENOTSUP
pub fun peer_identity(handle: usize, server_side: bool, identity: *types.PeerIdentity) i64 {
    ret windows.ENOTSUP;
}

# move a listener's socket file to another path, with no occupancy or identity check
# ---
# listener:    the listener whose file to move
# replacement: the new filesystem endpoint
# ret:         0, or a negative native code
pub fun rename(listener: *types.Listener, replacement: endpoint.Endpoint) i64 {
    var source:      [108]u8;
    var destination: [108]u8;
    path_buffer(listener.endpoint, ?source[0]);
    path_buffer(replacement, ?destination[0]);
    ret os.rename(os.working_dir(), ?source[0], os.working_dir(), ?destination[0]);
}

# close a stream's socket
# ---
# handle:      the native socket
# server_side: whether the stream was accepted, unused
# ret:         0, or a negative native code
pub fun close_stream(handle: usize, server_side: bool) i64 {
    ret os.sock_close(handle);
}

# close a listener's socket, then remove its socket file when it is owned
# ---
# listener: the listener to close
# ret:      0, the close's negative native code, or else the removal's
pub fun close_listener(listener: *types.Listener) i64 {
    val closed:  i64 = os.sock_close(listener.handle);
    var removed: i64 = 0;
    if (listener.ownership == types.OWNED) { removed = remove_owned(listener); }
    if (closed < 0)                        { ret closed; }
    ret removed;
}
