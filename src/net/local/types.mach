# local transport descriptor and ownership types

use std.net.local.endpoint;
use std.types.bool.bool;
use std.types.size.usize;

pub def Ownership: u8;
pub val BORROWED: Ownership = 0;
pub val OWNED:    Ownership = 1;

pub def StalePolicy: u8;
pub val REJECT_STALE:        StalePolicy = 0;
pub val REMOVE_STALE_SOCKET: StalePolicy = 1;

pub val INHERIT_PERMISSIONS: u32 = 0xffffffff;

# how a listener is bound
# ---
# ownership:   whether the listener removes its socket file on close
# stale:       what to do with a socket file already at the path
# permissions: mode bits 0o777 to set on the socket file, or INHERIT_PERMISSIONS
pub rec BindOptions {
    ownership:   Ownership;
    stale:       StalePolicy;
    permissions: u32;
}

# how a listener is bound and started
# ---
# backlog:     pending connections the system may queue, above zero
# ownership:   whether the listener removes its socket file on close
# stale:       what to do with a socket file already at the path
# permissions: mode bits 0o777 to set on the socket file, or INHERIT_PERMISSIONS
pub rec ListenOptions {
    backlog:     i32;
    ownership:   Ownership;
    stale:       StalePolicy;
    permissions: u32;
}

# a bound local listener
# ---
# handle:            the native socket, all ones when closed
# endpoint:          the endpoint it is bound to
# ownership:         whether close removes its socket file
# node_device:       device of the socket file as bound
# node_file:         file number of the socket file as bound
# has_node_identity: node_device and node_file were captured
pub rec Listener {
    handle:            usize;
    endpoint:          endpoint.Endpoint;
    ownership:         Ownership;
    node_device:       u64;
    node_file:         u64;
    has_node_identity: bool;
}

# one owner closes the handle, and receive operations exclude aliased reads and close.
pub rec Stream {
    handle:      usize;
    server_side: bool;
}

# the credentials of a connected peer, as far as the target reports them
# ---
# process:     the peer's process id, valid when has_process
# user:        the peer's user id, valid when has_user
# group:       the peer's group id, valid when has_group
# has_process: process was reported
# has_user:    user was reported
# has_group:   group was reported
pub rec PeerIdentity {
    process:     u64;
    user:        u64;
    group:       u64;
    has_process: bool;
    has_user:    bool;
    has_group:   bool;
}
