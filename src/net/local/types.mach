# local transport descriptor and ownership types

use std.types.bool.bool;
use std.types.size.usize;
use std.net.local.endpoint;

pub def Ownership: u8;
pub val BORROWED: Ownership = 0;
pub val OWNED: Ownership = 1;

pub def StalePolicy: u8;
pub val REJECT_STALE: StalePolicy = 0;
pub val REMOVE_STALE_SOCKET: StalePolicy = 1;

pub val INHERIT_PERMISSIONS: u32 = 0xffffffff;

pub rec ListenOptions {
    backlog: i32;
    ownership: Ownership;
    stale: StalePolicy;
    permissions: u32;
}

pub rec Listener {
    handle: usize;
    endpoint: endpoint.Endpoint;
    ownership: Ownership;
}

pub rec Stream {
    handle: usize;
    server_side: bool;
}

pub rec PeerIdentity {
    process: u64;
    user: u64;
    group: u64;
    has_process: bool;
    has_user: bool;
    has_group: bool;
}
