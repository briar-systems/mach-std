# the running processor's instruction-set extensions
#
# `features()` is the one facility std uses to pick a hardware path at run
# time: sha256's SHA-NI and ARMv8 SHA2 backends today, the AES and carry-less
# multiply extensions for other crypto. the record and its field names are the
# compiler's own extension vocabulary, declared per isa in
# std.system.cpu.features, so `have.sha2` on x86_64 is a compile error exactly
# as `$mach.build.extensions.sha2` is.
#
# the answer is computed once and cached. an extension the build target
# selects is reported present without a probe, because the binary already
# requires it. the rest comes from cpuid on x86_64, which needs no operating
# system, and from the OS on aarch64 (linux auxv AT_HWCAP, darwin sysctl),
# where the id registers are not readable from user mode. a freestanding
# aarch64 build without the cpu group reports only what it selects, so the
# portable path runs.
#
# selecting an extension admits its instructions and nothing more. selecting
# `dit`, when it exists, will say the instructions may be emitted, never that
# the mode is on.
#
# this module builds freestanding.

use std.sync.atomic;
use std.system.capability;
use isa: std.system.cpu.features;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

fwd isa.Features;

$if (capability.HAS_CPU_FEATURES) {
    use std.system.os;
}

# a high bit marks a computed value, the low bits carry the record
var cached: i64 = 0;

val COMPUTED: i64 = 1 << 62;

$if ($mach.build.arch == $mach.arch.x86_64) {
    fun pack(f: Features) i64 {
        var bits: i64 = COMPUTED;
        if (f.sha)    { bits = bits | 1; }
        if (f.ssse3)  { bits = bits | 2; }
        if (f.sse41)  { bits = bits | 4; }
        if (f.aes)    { bits = bits | 8; }
        if (f.pclmul) { bits = bits | 16; }
        ret bits;
    }

    fun unpack(bits: i64) Features {
        ret Features{sha: (bits & 1) != 0, ssse3: (bits & 2) != 0, sse41: (bits & 4) != 0,
            aes: (bits & 8) != 0, pclmul: (bits & 16) != 0};
    }

    fun detect() Features {
        var probed: Features;
        isa.probe(?probed);
        var out: Features;
        isa.merge(?out, probed);
        ret out;
    }
}
$or ($mach.build.arch == $mach.arch.aarch64) {
    fun pack(f: Features) i64 {
        var bits: i64 = COMPUTED;
        if (f.sha2)  { bits = bits | 1; }
        if (f.aes)   { bits = bits | 2; }
        if (f.pmull) { bits = bits | 4; }
        ret bits;
    }

    fun unpack(bits: i64) Features {
        ret Features{sha2: (bits & 1) != 0, aes: (bits & 2) != 0, pmull: (bits & 4) != 0};
    }

    fun detect() Features {
        var probed: Features = Features{sha2: false, aes: false, pmull: false};
        $if (capability.HAS_CPU_FEATURES) {
            if (os.cpu_features(?probed) < 0) { probed = Features{sha2: false, aes: false, pmull: false}; }
        }
        var out: Features;
        isa.merge(?out, probed);
        ret out;
    }
}

$or {
    fun pack(f: Features) i64 {
        var bits: i64 = COMPUTED;
        if (f.i)        { bits = bits | 1; }
        if (f.m)        { bits = bits | 2; }
        if (f.a)        { bits = bits | 4; }
        if (f.f)        { bits = bits | 8; }
        if (f.d)        { bits = bits | 16; }
        if (f.c)        { bits = bits | 32; }
        if (f.zicsr)    { bits = bits | 64; }
        if (f.zifencei) { bits = bits | 128; }
        if (f.zkt)      { bits = bits | 256; }
        ret bits;
    }

    fun unpack(bits: i64) Features {
        ret Features{i: (bits & 1) != 0, m: (bits & 2) != 0, a: (bits & 4) != 0, f: (bits & 8) != 0,
            d:        (bits & 16) != 0, c: (bits & 32) != 0, zicsr: (bits & 64) != 0,
            zifencei: (bits & 128) != 0, zkt: (bits & 256) != 0};
    }

    fun detect() Features {
        ret isa.selected();
    }
}

# the extensions the running processor has
#
# computed on the first call and cached. every call returns the same value
# for the life of the process. a concurrent first call computes the same
# value twice and stores it twice, which is harmless
# ---
# ret: the per-isa record, every field true when the processor has it
pub fun features() Features {
    val seen: i64 = atomic.load(?cached);
    if ((seen & COMPUTED) != 0) { ret unpack(seen); }
    val computed: Features = detect();
    atomic.store(?cached, pack(computed));
    ret computed;
}

$if ($mach.build.arch == $mach.arch.aarch64 && capability.HAS_CPU_FEATURES) {
    use std.system.dit;

    # these live here rather than in std.system.dit because that module must
    # not import the OS layer, whose trampolines import it
    test "cpu: dit enable sets the calling thread's PSTATE.DIT where the processor provides it" {
        if (os.cpu_dit() != 1) { ret 0; }
        dit.enable();
        if ((dit.read() & dit.DIT_BIT) == 0) { ret 1; }
        ret 0;
    }

    test "cpu: std's own test binary admits no secret multiply, so the link does not require dit" {
        if (dit.required())                                       { ret 1; }
        if (dit.decide(dit.required(), os.cpu_dit()) != dit.SKIP) { ret 2; }
        ret 0;
    }
}

test "cpu: features is stable across calls" {
    val first:  Features = features();
    val second: Features = features();
    if (pack(first) != pack(second))            { ret 1; }
    if ((atomic.load(?cached) & COMPUTED) == 0) { ret 2; }
    ret 0;
}
