# the OS contract: a small set of primitives, one implementation per OS
#
# the primitives fall into capability groups (core, pages, clock, entropy,
# threads, files, io queue, sockets, process). std.system.capability says which
# groups a target provides, and a target that claims a group exports every
# member of it (see src/system/capability/conformance.mach). OS-CONTRACT.md
# lists the members and the assumptions the contract holds. for
# platform-specific functionality, import the target module directly
# (e.g. std.system.os.linux).

use std.runtime.native.view.Unit;
use std.types.size.isize;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use io_error:   std.io.error;
use io_handle:  std.io.handle;
use identities: std.system.file_identity;
use std.system.os.shared;

$if ($mach.build.os == $mach.os.linux) {
    use impl: std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use impl: std.system.os.darwin;
}
$or ($mach.build.os == $mach.os.windows) {
    use impl: std.system.os.windows;
}
$or {
    $error("std.system.os needs a linux, darwin or windows target");
}

$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin || $mach.build.os == $mach.os.windows) {
    use secret_os: std.system.os.secret;
    use std.system.panic;
}

