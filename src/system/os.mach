# path

# handles
#
# every resource crosses the contract as a pointer-width handle. a primitive
# that makes one writes it through an out parameter and returns only a status,
# so no handle value can be mistaken for a negative native code. the standard
# handles and the working directory are functions, since an implementation may
# only learn them at run time

# the handle no resource ever has
pub val INVALID_HANDLE: usize = io_handle.INVALID_VALUE;

# the native descriptor behind a handle
fun native(handle: usize) i32 {
    ret handle::isize::i32;
}

# the handle for a native descriptor
fun wrap(descriptor: i32) usize {
    ret descriptor::isize::usize;
}

# the process's standard input, output and error
pub fun stdin() usize {
    ret wrap(impl.STDIN_FD);
}

pub fun stdout() usize {
    ret wrap(impl.STDOUT_FD);
}

pub fun stderr() usize {
    ret wrap(impl.STDERR_FD);
}

# the directory handle that resolves a relative path against the working directory
pub fun working_dir() usize {
    ret wrap(impl.AT_FDCWD);
}

