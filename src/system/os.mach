# remove a rooted entry without changing read-only attributes on surviving aliases
pub fun unlink_force(dirfd: i32, path: *u8, flags: i32) i64 {
    if (dirfd == impl.AT_FDCWD) { ret impl.EINVAL; }
    $if ($mach.build.os == $mach.os.windows) { ret impl.unlink_force(dirfd, path, flags); }
    $or { ret impl.unlink(dirfd, path, flags); }
}

