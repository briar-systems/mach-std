# time

# read the wall-clock time
# ---
# out: pointer to Timespec to populate
# ret: 0 on success, negative errno on failure
pub fun realtime(out: *Timespec) i64 {
    var ts: impl.timespec = impl.timespec{tv_sec: 0, tv_nsec: 0};
    val r:  i64           = impl.clock_gettime(impl.CLOCK_REALTIME, ?ts);
    if (r < 0) {
        out.sec  = 0;
        out.nsec = 0;
        ret r;
    }
    out.sec  = ts.tv_sec;
    out.nsec = ts.tv_nsec;
    ret 0;
}

# read the monotonic clock
# ---
# out: pointer to Timespec to populate
# ret: 0 on success, negative errno on failure
pub fun monotonic(out: *Timespec) i64 {
    var ts: impl.timespec = impl.timespec{tv_sec: 0, tv_nsec: 0};
    val r:  i64           = impl.clock_gettime(impl.CLOCK_MONOTONIC, ?ts);
    if (r < 0) {
        out.sec  = 0;
        out.nsec = 0;
        ret r;
    }
    out.sec  = ts.tv_sec;
    out.nsec = ts.tv_nsec;
    ret 0;
}

# errors
#
# a primitive's negative return is a native code whose meaning belongs to the
# implementation. error_kind is the only portable reading of one

fwd impl.error_kind;

# the native text for a code, "not an error" for one that is not negative
pub fun error_message(code: i64) str {
    if (code >= 0) {
        ret "not an error";
    }
    ret impl.error_message(code);
}

# the io error for a native code a primitive returned
# ---
# code:      the primitive's negative return
# operation: the operation that failed
# ret:       the error, classified by error_kind and keeping the native code
pub fun error(code: i64, operation: io_error.Operation) io_error.Error {
    ret io_error.Error{kind: impl.error_kind(code), code: code, operation: operation, cleanup_code: 0};
}

# the text for an io error: the native message when a native code is behind
# it, otherwise the name of its kind
pub fun message(failure: io_error.Error) str {
    if (failure.code < 0) {
        ret impl.error_message(failure.code);
    }
    ret io_error.kind_name(failure.kind);
}

# the rooted removal the tests below use, which keeps read-only aliases intact
#[testing]
fun unlink_rooted(dirfd: i32, path: *u8, flags: i32) i64 {
    $if ($mach.build.os == $mach.os.windows) { ret impl.unlink_force(dirfd, path, flags); }
    $or                                      { ret impl.unlink(dirfd, path, flags); }
}

test completion_queue__wake_and_close_lifecycle {
    if (impl.io_queue_wake(nil) != impl.EINVAL || impl.io_queue_close(nil) != impl.EINVAL) { ret 1; }
    var queue: shared.IoQueue;
    if (impl.io_queue_create(?queue) != 0) { ret 1; }
    fin { impl.io_queue_close(?queue); }
    if (impl.io_queue_wait(?queue, 0) != 0)                                   { ret 2; }
    if (impl.io_queue_wake(?queue) != 0)                                      { ret 3; }
    if (impl.io_queue_wait(?queue, 100) != 1)                                 { ret 4; }
    if (impl.io_queue_wait(?queue, 0) != 0)                                   { ret 5; }
    if (impl.io_queue_close(?queue) != 0 || impl.io_queue_close(?queue) != 0) { ret 6; }
    if (impl.io_queue_wake(?queue) != impl.EBADF)                             { ret 7; }
    ret 0;
}

# a wake posts once until a poll takes it, and then posts again (#753)
test completion_queue__wakes_coalesce_until_a_poll_takes_them {
    var queue: shared.IoQueue;
    if (impl.io_queue_create(?queue) != 0) { ret 1; }
    fin { impl.io_queue_close(?queue); }
    if (impl.io_queue_wake(?queue) != 0 || impl.io_queue_wake(?queue) != 0 || impl.io_queue_wake(?queue) != 0) { ret 2; }
    if (queue.wakes_posted != 1 || queue.wake_pending != 1)                                                    { ret 3; }
    var events: [4]impl.IoCompletion;
    if (impl.io_queue_poll(?queue, ?events[0], 4, 0) != 1 || (events[0].events & impl.IO_EVENT_WAKE) == 0) { ret 4; }
    if (queue.wake_pending != 0)                                                                           { ret 5; }
    if (impl.io_queue_poll(?queue, ?events[0], 4, 0) != 0)                                                 { ret 6; }
    if (impl.io_queue_wake(?queue) != 0 || queue.wakes_posted != 2)                                        { ret 7; }
    if (impl.io_queue_poll(?queue, ?events[0], 4, 0) != 1)                                                 { ret 8; }
    ret 0;
}

test file_identity__follows_the_object_across_rename_writes_and_unlink {
    val first:   str = "mach_583_identity_first";
    val renamed: str = "mach_583_identity_renamed";
    impl.unlink(impl.AT_FDCWD, first, 0);
    impl.unlink(impl.AT_FDCWD, renamed, 0);
    val raw: i64 = impl.open(impl.AT_FDCWD, first, impl.O_CREAT | impl.O_EXCL | impl.O_RDWR, 0);
    if (raw < 0) { ret 1; }
    val fd: i32 = raw::i32;
    fin {
        impl.close(fd);
        impl.unlink(impl.AT_FDCWD, first, 0);
        impl.unlink(impl.AT_FDCWD, renamed, 0);
    }
    var initial:  identities.Identity;
    var observed: identities.Identity;
    if (impl.file_identity(fd, ?initial) < 0)                                                            { ret 2; }
    if (impl.identity_at(impl.AT_FDCWD, first, ?observed) < 0 || !identities.equal(initial, observed))   { ret 3; }
    if (impl.rename(impl.AT_FDCWD, first, impl.AT_FDCWD, renamed) < 0)                                   { ret 4; }
    if (impl.identity_at(impl.AT_FDCWD, renamed, ?observed) < 0 || !identities.equal(initial, observed)) { ret 5; }
    if (impl.write(fd, "new contents", 12) != 12)                                                        { ret 6; }
    if (impl.file_identity(fd, ?observed) < 0 || !identities.equal(initial, observed))                   { ret 7; }
    val other: i64 = impl.open(impl.AT_FDCWD, first, impl.O_CREAT | impl.O_EXCL | impl.O_RDWR, 0);
    if (other < 0) { ret 8; }
    val queried: i64 = impl.file_identity(other::i32, ?observed);
    val closed:  i64 = impl.close(other::i32);
    if (queried < 0 || closed < 0 || identities.equal(initial, observed)) { ret 9; }
    val parent: i64 = impl.open(impl.AT_FDCWD, ".", impl.O_RDONLY | impl.O_DIRECTORY, 0);
    if (parent < 0) { ret 10; }
    val removed: i64 = unlink_rooted(parent::i32, renamed, 0);
    impl.close(parent::i32);
    if (removed < 0)                                                                   { ret 11; }
    if (impl.file_identity(fd, ?observed) < 0 || !identities.equal(initial, observed)) { ret 12; }
    var absent: impl.stat_t;
    if (impl.stat_path(impl.AT_FDCWD, renamed, ?absent, impl.AT_SYMLINK_NOFOLLOW) != impl.ENOENT) { ret 13; }
    ret 0;
}

test file_identity__metadata_retention_grants_no_content_access {
    val base: str = "mach_583_identity_retained";
    if (impl.make_dir(impl.AT_FDCWD, base, 0o700) < 0) { ret 1; }
    fin { impl.unlink(impl.AT_FDCWD, base, impl.AT_REMOVEDIR); }
    val opened: i64 = impl.open(impl.AT_FDCWD, base, impl.O_RDONLY | impl.O_DIRECTORY, 0);
    if (opened < 0) { ret 2; }
    val root: i32 = opened::i32;
    fin { impl.close(root); }
    fin {
        impl.unlink(root, "prior", 0);
        impl.unlink(root, "next", 0);
    }
    val created: i64 = impl.open(root, "prior", impl.O_CREAT | impl.O_EXCL | impl.O_WRONLY, 0);
    if (created < 0)                  { ret 3; }
    if (impl.close(created::i32) < 0) { ret 4; }
    var initial:  identities.Identity;
    val retained: i64 = impl.retain_identity_at(root, "prior", identities.METADATA_ONLY, ?initial);
    $if ($mach.build.os == $mach.os.darwin) {
        if (retained != impl.ENOTSUP) { ret 5; }
        ret 0;
    }
    $or {
        if (retained < 0) { ret 6; }
        val fd: i32 = retained::i32;
        fin { impl.close(fd); }
        var byte: u8;
        if (impl.read(fd, ?byte, 1) >= 0) { ret 7; }
        val replacement: i64 = impl.open(root, "next", impl.O_CREAT | impl.O_EXCL | impl.O_WRONLY, 0o600);
        if (replacement < 0)                              { ret 8; }
        if (impl.close(replacement::i32) < 0)             { ret 9; }
        if (impl.rename(root, "next", root, "prior") < 0) { ret 10; }
        var current: identities.Identity;
        if (impl.identity_at(root, "prior", ?current) < 0 || identities.equal(initial, current)) { ret 11; }
        if (impl.file_identity(fd, ?current) < 0 || !identities.equal(initial, current))         { ret 12; }
        ret 0;
    }
}

$if ($mach.build.os != $mach.os.windows) {
    test mode__held_and_rooted_changes_do_not_follow_links {
        val base: str = "mach_612_private_mode";
        if (impl.make_dir(impl.AT_FDCWD, base, 0o700) < 0) { ret 1; }
        fin { impl.unlink(impl.AT_FDCWD, base, impl.AT_REMOVEDIR); }
        val root: i64 = impl.open(impl.AT_FDCWD, base, impl.O_RDONLY | impl.O_DIRECTORY, 0);
        if (root < 0) { ret 2; }
        fin { impl.close(root::i32); }
        if (impl.make_dir(root::i32, "private", 0o700) < 0 || impl.make_dir(root::i32, "public", 0o700) < 0) { ret 3; }
        fin {
            impl.unlink(root::i32, "alias", 0);
            impl.set_mode_at(root::i32, "private", 0o700);
            impl.unlink(root::i32, "private", impl.AT_REMOVEDIR);
            impl.unlink(root::i32, "public", impl.AT_REMOVEDIR);
        }
        val private_fd: i64 = impl.open(root::i32, "private", impl.O_RDONLY | impl.O_DIRECTORY, 0);
        if (private_fd < 0) { ret 4; }
        val changed:   i64 = impl.set_mode(private_fd::i32, 0);
        var finalized: impl.stat_t;
        val observed:  i64 = impl.stat(private_fd::i32, ?finalized);
        impl.close(private_fd::i32);
        if (changed < 0 || observed < 0 || (impl.stat_mode(?finalized) & 0o777) != 0) { ret 5; }
        if (impl.set_mode_at(root::i32, "private", 0o700) < 0)                        { ret 6; }
        val reopened: i64 = impl.open(root::i32, "private", impl.O_RDONLY | impl.O_DIRECTORY, 0);
        if (reopened < 0) { ret 7; }
        var restored: impl.stat_t;
        val checked:  i64 = impl.stat(reopened::i32, ?restored);
        impl.close(reopened::i32);
        if (checked < 0 || (impl.stat_mode(?restored) & 0o777) != 0o700) { ret 8; }
        if (impl.symlink("public", "mach_612_private_mode/alias") < 0)   { ret 9; }
        impl.set_mode_at(root::i32, "alias", 0);
        var untouched: impl.stat_t;
        if (impl.stat_path(root::i32, "public", ?untouched, impl.AT_SYMLINK_NOFOLLOW) < 0
            || (impl.stat_mode(?untouched) & 0o777) != 0o700) { ret 10; }
        ret 0;
    }
}

test file_identity__read_authorized_retention_survives_replacement_and_unlink {
    val base: str = "mach_583_read_authorized";
    if (impl.make_dir(impl.AT_FDCWD, base, 0o700) < 0) { ret 1; }
    fin { impl.unlink(impl.AT_FDCWD, base, impl.AT_REMOVEDIR); }
    val opened: i64 = impl.open(impl.AT_FDCWD, base, impl.O_RDONLY | impl.O_DIRECTORY, 0);
    if (opened < 0) { ret 2; }
    val root: i32 = opened::i32;
    fin { impl.close(root); }
    fin {
        unlink_rooted(root, "prior", 0);
        unlink_rooted(root, "next", 0);
    }
    val created: i64 = impl.open(root, "prior", impl.O_CREAT | impl.O_EXCL | impl.O_WRONLY, 0o600);
    if (created < 0)                                                              { ret 3; }
    if (impl.write(created::i32, "data", 4) != 4 || impl.close(created::i32) < 0) { ret 4; }
    val capabilities: i64 = impl.publication_capabilities(root);
    if (capabilities < 0 || (capabilities & PUBLICATION_READ_RETAIN_REPLACE) == 0) { ret 14; }
    var initial:  identities.Identity;
    val retained: i64 = impl.retain_identity_at(root, "prior", identities.READ_AUTHORIZED, ?initial);
    if (retained < 0) { ret 5; }
    val fd: i32 = retained::i32;
    fin { impl.close(fd); }
    var byte: u8;
    val read: i64 = impl.read(fd, ?byte, 1);
    $if ($mach.build.os == $mach.os.darwin) {
        if (read != 1 || byte != 'd') { ret 6; }
    }
    $or {
        if (read >= 0) { ret 6; }
    }
    val replacement: i64 = impl.open(root, "next", impl.O_CREAT | impl.O_EXCL | impl.O_WRONLY, 0o600);
    if (replacement < 0)                                                                  { ret 7; }
    if (impl.close(replacement::i32) < 0 || impl.rename(root, "next", root, "prior") < 0) { ret 8; }
    var current: identities.Identity;
    if (impl.identity_at(root, "prior", ?current) < 0 || identities.equal(initial, current)) { ret 9; }
    if (impl.file_identity(fd, ?current) < 0 || !identities.equal(initial, current))         { ret 10; }
    if (unlink_rooted(root, "prior", 0) < 0)                                                 { ret 11; }
    if (impl.file_identity(fd, ?current) < 0 || !identities.equal(initial, current))         { ret 12; }
    if (impl.retain_identity_at(root, "missing", 2, ?current) != impl.EINVAL)                { ret 13; }
    ret 0;
}

$if ($mach.build.os == $mach.os.darwin) {
    test file_identity__darwin_read_authorization_keeps_permissions {
        val base: str = "mach_583_read_permissions";
        if (impl.make_dir(impl.AT_FDCWD, base, 0o700) < 0) { ret 1; }
        fin { impl.unlink(impl.AT_FDCWD, base, impl.AT_REMOVEDIR); }
        val opened: i64 = impl.open(impl.AT_FDCWD, base, impl.O_RDONLY | impl.O_DIRECTORY, 0);
        if (opened < 0) { ret 2; }
        val root: i32 = opened::i32;
        fin { impl.close(root); }
        fin {
            impl.unlink(root, "private", 0);
            impl.unlink(root, "alias", 0);
        }
        val created: i64 = impl.open(root, "private", impl.O_CREAT | impl.O_EXCL | impl.O_WRONLY, 0o600);
        if (created < 0) { ret 3; }
        val fd: i32 = created::i32;
        fin {
            impl.set_mode(fd, 0o600);
            impl.close(fd);
        }
        if (impl.symlink("private", "mach_583_read_permissions/alias") < 0) { ret 9; }
        var identity: identities.Identity;
        val alias:    i64 = impl.retain_identity_at(root, "alias", identities.READ_AUTHORIZED, ?identity);
        if (alias >= 0) {
            impl.close(alias::i32);
            ret 10;
        }
        if (alias != impl.ELOOP)                                                                           { ret 11; }
        if (impl.set_mode(fd, 0) < 0)                                                                      { ret 4; }
        if (impl.retain_identity_at(root, "private", identities.METADATA_ONLY, ?identity) != impl.ENOTSUP) { ret 5; }
        val retained: i64 = impl.retain_identity_at(root, "private", identities.READ_AUTHORIZED, ?identity);
        if (retained >= 0) {
            impl.close(retained::i32);
            ret 6;
        }
        if (retained != impl.EACCES) { ret 7; }
        var observed: impl.stat_t;
        if (impl.stat(fd, ?observed) < 0 || (impl.stat_mode(?observed) & 0o777) != 0) { ret 8; }
        ret 0;
    }
}

test directory__nil_and_non_directory_init_errors {
    var cursor: impl.DirectoryCursor = impl.DirectoryCursor{};
    var entry:  impl.DirectoryEntry  = impl.DirectoryEntry{name: "untouched", length: 9, type_hint: 77};
    if (impl.directory_init(nil, -1).code != impl.EINVAL) { ret 1; }
    val bad: impl.DirectoryInitResult = impl.directory_init(?cursor, -1);
    if (bad.code != impl.EBADF || bad.cleanup_code != 0)                                                   { ret 2; }
    if (impl.directory_next(nil, ?entry) != impl.EINVAL || impl.directory_close(nil) != impl.EINVAL)       { ret 3; }
    if (impl.directory_next(?cursor, ?entry) != impl.EINVAL || entry.length != 9 || entry.type_hint != 77) { ret 4; }
    if (impl.directory_close(?cursor) != 0)                                                                { ret 5; }
    val file: str = "mach_directory_regular";
    val fd:   i64 = impl.open(impl.AT_FDCWD, file, impl.O_CREAT | impl.O_EXCL | impl.O_RDWR, 0o600);
    if (fd < 0) { ret 6; }
    fin {
        impl.close(fd::i32);
        impl.unlink(impl.AT_FDCWD, file, 0);
    }
    val regular: impl.DirectoryInitResult = impl.directory_init(?cursor, fd::i32);
    if (regular.code != impl.ENOTDIR || regular.cleanup_code != 0)              { ret 7; }
    if (impl.write(fd::i32, "x", 1) != 1 || impl.directory_close(?cursor) != 0) { ret 8; }
    ret 0;
}

#[testing]
fun directory_test_name(name: *u8, ordinal: usize) {
    var at: usize = 0;
    for (at < 240) {
        name[at] = 'n';
        at       = at + 1;
    }
    val digits: str = "0123456789abcdef";
    name[237] = digits[(ordinal >> 8) & 15];
    name[238] = digits[(ordinal >> 4) & 15];
    name[239] = digits[ordinal & 15];
    name[240] = 0;
}

#[testing]
fun directory_test_scan(fd: i32) i32 {
    var cursor:      impl.DirectoryCursor     = impl.DirectoryCursor{};
    val initialized: impl.DirectoryInitResult = impl.directory_init(?cursor, fd);
    if (initialized.code != 0 || initialized.cleanup_code != 0) { ret 1; }
    fin { impl.directory_close(?cursor); }
    var copied: impl.DirectoryCursor = cursor;
    var entry:  impl.DirectoryEntry;
    if (impl.directory_close(?copied) != impl.EINVAL || impl.directory_next(?copied, ?entry) != impl.EINVAL) { ret 2; }
    if (impl.directory_init(?cursor, fd).code != impl.EINVAL)                                                { ret 3; }
    var seen:  [300]u8;
    var index: usize = 0;
    for (index < 300) {
        seen[index] = 0;
        index       = index + 1;
    }
    var count: usize = 0;
    var calls: usize = 0;
    for (calls < 304) {
        calls = calls + 1;
        val next: i64 = impl.directory_next(?cursor, ?entry);
        if (next < 0) { ret 4; }
        if (next == 0) {
            if (count != 300) { ret 5; }
            entry = impl.DirectoryEntry{name: "unchanged", length: 9, type_hint: 99};
            if (impl.directory_next(?cursor, ?entry) != 0 || entry.length != 9 || entry.type_hint != 99) { ret 6; }
            if (impl.directory_close(?cursor) != 0 || impl.directory_close(?cursor) != 0)                { ret 7; }
            if (impl.directory_next(?cursor, ?entry) != impl.EINVAL)                                     { ret 8; }
            var st: impl.stat_t;
            if (impl.stat(fd, ?st) < 0) { ret 9; }
            ret 0;
        }
        if (entry.name[0] == '.' && (entry.length == 1 || (entry.length == 2 && entry.name[1] == '.'))) { cnt; }
        if (entry.length != 240 || str_len(entry.name) != 240)                                          { ret 10; }
        var byte: usize = 0;
        for (byte < 237) {
            if (entry.name[byte] != 'n') { ret 11; }
            byte = byte + 1;
        }
        val digits: str   = "0123456789abcdef";
        var found:  usize = 0;
        for (byte < 240) {
            var digit: usize = 0;
            for (digit < 16 && digits[digit] != entry.name[byte]) { digit = digit + 1; }
            if (digit == 16) { ret 11; }
            found = found * 16 + digit;
            byte  = byte + 1;
        }
        if (found >= 300 || seen[found] != 0) { ret 11; }
        seen[found] = 1;
        count       = count + 1;
    }
    ret 12;
}

test directory__entries_span_native_batches_and_restart {
    val base: str = "mach_directory_batches";
    if (impl.make_dir(impl.AT_FDCWD, base, 0o700) < 0) { ret 1; }
    fin { impl.unlink(impl.AT_FDCWD, base, impl.AT_REMOVEDIR); }
    val raw: i64 = impl.open(impl.AT_FDCWD, base, impl.O_RDONLY | impl.O_DIRECTORY, 0);
    if (raw < 0) { ret 2; }
    val fd: i32 = raw::i32;
    fin { impl.close(fd); }
    var made: usize = 0;
    fin {
        var name:  [241]u8;
        var index: usize = 0;
        for (index < made) {
            directory_test_name(?name[0], index);
            impl.unlink(fd, ?name[0], 0);
            index = index + 1;
        }
    }
    var name: [241]u8;
    for (made < 300) {
        directory_test_name(?name[0], made);
        val opened: i64 = impl.open(fd, ?name[0], impl.O_CREAT | impl.O_EXCL | impl.O_WRONLY, 0o600);
        if (opened < 0) { ret 3; }
        made = made + 1;
        if (impl.close(opened::i32) < 0) { ret 4; }
    }
    # btrfs snapshots the directory's last index when the descriptor is opened
    # and hides entries created after it until a seek, which POSIX permits
    if (impl.seek(fd, 0, shared.SEEK_SET) < 0) { ret 6; }
    val first: i32 = directory_test_scan(fd);
    if (first != 0)                            { ret first + 10; }
    if (impl.seek(fd, 0, shared.SEEK_SET) < 0) { ret 5; }
    val again: i32 = directory_test_scan(fd);
    if (again != 0) { ret again + 30; }
    ret 0;
}

test error__classifies_a_native_code_and_keeps_it {
    val timeout: io_error.Error = error(impl.ETIMEDOUT, io_error.OP_READ);
    if (timeout.kind != io_error.TIMEOUT)                          { ret 1; }
    if (timeout.code != impl.ETIMEDOUT)                            { ret 2; }
    if (timeout.operation != io_error.OP_READ)                     { ret 3; }
    if (timeout.cleanup_code != 0)                                 { ret 4; }
    if (!io_error.retryable(error(impl.EINTR, io_error.OP_READ)))  { ret 5; }
    if (!io_error.retryable(error(impl.EAGAIN, io_error.OP_READ))) { ret 6; }
    if (io_error.retryable(error(impl.EINVAL, io_error.OP_READ)))  { ret 7; }
    ret 0;
}

test error_kind__gives_every_portable_code_its_own_kind {
    if (error_kind(impl.EIO) != io_error.IO)                     { ret 1; }
    if (error_kind(impl.ENOENT) != io_error.NOT_FOUND)           { ret 2; }
    if (error_kind(impl.EEXIST) != io_error.EXISTS)              { ret 3; }
    if (error_kind(impl.ENOTDIR) != io_error.NOT_DIRECTORY)      { ret 4; }
    if (error_kind(impl.EISDIR) != io_error.IS_DIRECTORY)        { ret 5; }
    if (error_kind(impl.ENOTEMPTY) != io_error.NOT_EMPTY)        { ret 6; }
    if (error_kind(impl.ENAMETOOLONG) != io_error.NAME_TOO_LONG) { ret 7; }
    if (error_kind(impl.EBUSY) != io_error.BUSY)                 { ret 8; }
    if (error_kind(impl.ERANGE) != io_error.RANGE)               { ret 9; }
    if (error_kind(impl.ECHILD) != io_error.NO_CHILD)            { ret 10; }
    if (error_kind(impl.ELOOP) != io_error.LOOP)                 { ret 11; }
    if (error_kind(impl.ENOSPC) != io_error.RESOURCE_EXHAUSTED)  { ret 12; }
    if (error_kind(impl.ENXIO) != io_error.OTHER)                { ret 13; }
    ret 0;
}

test message__reads_the_native_text_or_names_the_kind {
    if (str_len(message(error(impl.ENOENT, io_error.OP_OPEN))) == 0)            { ret 1; }
    if (str_len(message(io_error.make(io_error.BUSY, io_error.OP_WRITE))) == 0) { ret 2; }
    if (str_len(error_message(0)) == 0)                                         { ret 3; }
    ret 0;
}

# write a test name: an ascii prefix, then units the host spells its own way,
# then the terminator
#[testing]
fun native_test_name(prefix: str, tail: *Unit, tail_length: usize, out: *Unit) {
    var i: usize = 0;
    for (prefix[i] != 0) {
        out[i] = prefix[i]::Unit;
        i      = i + 1;
    }
    var j: usize = 0;
    for (j < tail_length) {
        out[i + j] = tail[j];
        j          = j + 1;
    }
    out[i + j] = 0;
}

# write the UTF-8 spelling of a test name, prefix then spelling
#[testing]
fun native_test_spelling(prefix: str, spelling: str, out: *u8) {
    val prefix_length: usize = str_len(prefix);
    val length:        usize = str_len(spelling);
    var i:             usize = 0;
    for (i < prefix_length) {
        out[i] = prefix[i];
        i      = i + 1;
    }
    var j: usize = 0;
    for (j <= length) {
        out[i + j] = spelling[j];
        j          = j + 1;
    }
}

#[testing]
fun native_test_kind(st: *impl.stat_t) u32 {
    ret impl.stat_mode(st) & S_IFMT;
}

# walk every native form over names ending in tail: a directory made, its mode
# set, queried, identified and linked to, and a file in it created, retained
# and renamed. when spelling is the tail's UTF-8 spelling, the UTF-8 forms
# must see each step the same way. everything made is removed through the
# native forms
#[testing]
fun native_forms_reach(tail: *Unit, tail_length: usize, spelling: str) i32 {
    var dir:   [64]Unit;
    var file:  [64]Unit;
    var moved: [64]Unit;
    var link:  [64]Unit;
    native_test_name("mach_std_os_native_", tail, tail_length, ?dir[0]);
    native_test_name("file_", tail, tail_length, ?file[0]);
    native_test_name("moved_", tail, tail_length, ?moved[0]);
    native_test_name("mach_std_os_native_link_", tail, tail_length, ?link[0]);
    var dir_utf8:   [64]u8;
    var file_utf8:  [64]u8;
    var moved_utf8: [64]u8;
    var link_utf8:  [64]u8;
    if (spelling != nil) {
        native_test_spelling("mach_std_os_native_", spelling, ?dir_utf8[0]);
        native_test_spelling("file_", spelling, ?file_utf8[0]);
        native_test_spelling("moved_", spelling, ?moved_utf8[0]);
        native_test_spelling("mach_std_os_native_link_", spelling, ?link_utf8[0]);
    }
    val wd: usize = working_dir();

    if (make_dir_native(wd, ?dir[0], 0o700) < 0) { ret 1; }
    fin { unlink_native(wd, ?dir[0], AT_REMOVEDIR); }
    if (set_mode_at_native(wd, ?dir[0], 0o700) < 0 || access_native(wd, ?dir[0], 0, 0) < 0) { ret 2; }
    var st: impl.stat_t;
    if (stat_path_native(wd, ?dir[0], ?st, 0) < 0 || native_test_kind(?st) != S_IFDIR) { ret 3; }
    var by_units: identities.Identity;
    if (identity_at_native(wd, ?dir[0], ?by_units) < 0) { ret 4; }
    var root: usize = INVALID_HANDLE;
    if (open_native(wd, ?dir[0], O_RDONLY | O_DIRECTORY, 0, ?root) < 0) { ret 5; }
    fin { close(root); }
    var held: identities.Identity;
    if (file_identity(root, ?held) < 0 || !identities.equal(held, by_units)) { ret 6; }
    if (spelling != nil) {
        var utf8_st: impl.stat_t;
        var by_name: identities.Identity;
        if (stat_path(wd, ?dir_utf8[0], ?utf8_st, 0) < 0 || impl.stat_mode(?utf8_st) != impl.stat_mode(?st)) { ret 7; }
        if (access(wd, ?dir_utf8[0], 0, 0) < 0)                                                              { ret 8; }
        if (identity_at(wd, ?dir_utf8[0], ?by_name) < 0 || !identities.equal(by_name, by_units))             { ret 9; }
    }

    var created: usize = INVALID_HANDLE;
    if (open_native(root, ?file[0], O_CREAT | O_EXCL | O_WRONLY, 0o600, ?created) < 0) { ret 10; }
    close(created);
    fin {
        unlink_native(root, ?file[0], 0);
        unlink_native(root, ?moved[0], 0);
    }
    var retained: identities.Identity;
    var kept:     usize = INVALID_HANDLE;
    val retain:   i64   = retain_identity_at_native(root, ?file[0], identities.METADATA_ONLY, ?retained, ?kept);
    $if ($mach.build.os == $mach.os.darwin) {
        if (retain != impl.ENOTSUP) { ret 11; }
    }
    $or {
        if (retain < 0) { ret 11; }
        close(kept);
        var plain: identities.Identity;
        if (identity_at_native(root, ?file[0], ?plain) < 0 || !identities.equal(plain, retained)) { ret 12; }
    }
    if (rename_native(root, ?file[0], root, ?moved[0]) < 0)                                                   { ret 13; }
    if (stat_path_native(root, ?moved[0], ?st, 0) < 0 || native_test_kind(?st) != S_IFREG)                    { ret 14; }
    if (error_kind(stat_path_native(root, ?file[0], ?st, 0)) != io_error.NOT_FOUND)                           { ret 15; }
    if (spelling != nil && (stat_path(root, ?moved_utf8[0], ?st, 0) < 0 || native_test_kind(?st) != S_IFREG)) { ret 16; }

    if (symlink_native(?dir[0], ?link[0]) < 0) { ret 17; }
    fin { unlink_native(wd, ?link[0], 0); }
    if (stat_path_native(wd, ?link[0], ?st, AT_SYMLINK_NOFOLLOW) < 0 || native_test_kind(?st) != S_IFLNK)                    { ret 18; }
    if (stat_path_native(wd, ?link[0], ?st, 0) < 0 || native_test_kind(?st) != S_IFDIR)                                      { ret 19; }
    if (spelling != nil && (stat_path(wd, ?link_utf8[0], ?st, AT_SYMLINK_NOFOLLOW) < 0 || native_test_kind(?st) != S_IFLNK)) { ret 20; }
    ret 0;
}

# every host: each native form reaches what the UTF-8 spelling of a valid name
# reaches (U+00E9 as one UTF-16 unit on windows, its two UTF-8 bytes elsewhere)
test native_forms__a_valid_name_reaches_what_its_utf_8_spelling_names {
    var tail:        [2]Unit;
    var tail_length: usize = 2;
    $if ($mach.build.os == $mach.os.windows) {
        tail[0]     = 0xe9;
        tail_length = 1;
    }
    $or {
        tail[0] = 0xc3;
        tail[1] = 0xa9;
    }
    ret native_forms_reach(?tail[0], tail_length, "\xc3\xa9");
}

# windows and linux: the native forms reach a name with no UTF-8 spelling, an
# unpaired surrogate on windows and bytes that are not UTF-8 on linux. darwin
# is left out because its filesystems refuse a name that is not UTF-8
$if ($mach.build.os == $mach.os.windows || $mach.build.os == $mach.os.linux) {
    test native_forms__a_name_with_no_utf_8_spelling_is_reached {
        var tail:        [2]Unit;
        var tail_length: usize = 2;
        $if ($mach.build.os == $mach.os.windows) {
            tail[0]     = 0xd800;
            tail_length = 1;
        }
        $or {
            tail[0] = 0xff;
            tail[1] = 0xfe;
        }
        ret native_forms_reach(?tail[0], tail_length, nil);
    }
}

# every host: the native working directory names the directory "." names, and
# a capacity that leaves no room for the terminator is ERANGE
test getcwd_native__names_the_working_directory {
    var cwd:    [4096]Unit;
    val length: i64 = getcwd_native(?cwd[0], 4096);
    if (length < 1 || cwd[length::usize] != 0)                { ret 1; }
    if (getcwd_native(?cwd[0], length::usize) != impl.ERANGE) { ret 2; }
    var by_units: identities.Identity;
    var by_dot:   identities.Identity;
    if (identity_at_native(working_dir(), ?cwd[0], ?by_units) < 0) { ret 3; }
    if (identity_at(working_dir(), ".", ?by_dot) < 0)              { ret 4; }
    if (!identities.equal(by_units, by_dot))                       { ret 5; }
    ret 0;
}

# every host: native_path borrows the bytes on linux and darwin and converts
# once on windows, refusing what the UTF-8 primitives refuse
test native_path__converts_once_with_the_utf_8_primitives_refusals {
    var path: NativePath;
    if (native_path(nil, ?path) != impl.EINVAL) { ret 1; }
    val name: str = "mach_\xc3\xa9";
    if (native_path(name, ?path) < 0) { ret 2; }
    $if ($mach.build.os == $mach.os.windows) {
        if (path.size == 0 || path.units[5] != 0xe9 || path.units[6] != 0) { ret 3; }
    }
    $or {
        if (path.size != 0 || path.units != name) { ret 3; }
    }
    native_path_release(?path);
    if (path.units != nil || path.size != 0) { ret 4; }
    $if ($mach.build.os == $mach.os.windows) {
        var malformed: [2]u8 = [2]u8{0xff, 0};
        if (native_path(?malformed[0], ?path) != impl.EINVAL) { ret 5; }
        if (native_path("", ?path) != impl.EINVAL)            { ret 6; }
    }
    ret 0;
}
