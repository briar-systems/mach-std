}

# spawn_redirected_in from an executable, arguments, environment and directory
# in native units
pub fun spawn_redirected_in_native(pathname: *Unit, argv: **Unit, envp: **Unit, cwd: *Unit, input: usize, output: usize, error_out: usize) i64 {
