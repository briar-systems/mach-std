# spawn with the child's standard handles replaced
# ---
# ret: the child's pid, or a negative native code
pub fun spawn_redirected(pathname: *u8, argv: **u8, envp: **u8, input: usize, output: usize, error_out: usize) i64 {
    ret impl.spawn_redirected(pathname, argv, envp, native(input), native(output), native(error_out));
}

