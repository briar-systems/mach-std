# secret-welded storage. each primitive is one native call that keeps the
# welded pointer shape. std.memory.secret builds wiping, retries and borrows on
# top of them

# the most bytes one random_fill_secret call accepts
fwd RANDOM_FILL_SECRET_MAX: secret_os.RANDOM_FILL_MAX;

# a zero-initialized welded region, nil for zero size or failure
pub fun allocate_secret(size: usize) *^u8 {
    ret secret_os.allocate(size);
}

# release a region allocate_secret returned, without wiping it
pub fun release_secret(data: *^u8, size: usize) i64 {
    ret secret_os.release(data, size);
}

# a zero-initialized region of total bytes typed as T, nil on failure
pub fun allocate_secret_typed[T](total: usize) *T {
    ret secret_os.allocate_typed[T](total);
}

# release a region allocate_secret_typed returned, without wiping it
pub fun release_secret_typed[T](base: *T, total: usize) i64 {
    ret secret_os.release_typed[T](base, total);
}

# fill up to RANDOM_FILL_SECRET_MAX welded bytes from the csprng in one call
# ---
# ret: bytes filled, possibly fewer than len, or a negative native code
pub fun random_fill_secret(data: *^u8, len: usize) i64 {
    ret secret_os.random_fill(data, len);
}

# one positioned read into welded storage
# ---
# ret: bytes delivered, zero at end of file, or a negative native code
pub fun read_at_secret(handle: usize, data: *^u8, len: usize, offset: u64) i64 {
    ret secret_os.read_at(native(handle), data, len, offset);
}

# one positioned write from welded storage
# ---
# ret: bytes persisted, or a negative native code
pub fun write_at_secret(handle: usize, data: *^u8, len: usize, offset: u64) i64 {
    ret secret_os.write_at(native(handle), data, len, offset);
}

