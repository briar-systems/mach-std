# temp directory

# resolve the directory designated for temporary files
#
# follows the env.get truncation contract: ret < cap means the path was
# copied and null-terminated; ret >= cap signals truncation and ret is the
# full path length. lookup order is per-OS:
#   windows: GetTempPathA, TMP, then TEMP, then USERPROFILE, then the
#            windows directory; the result ends with a path separator
#   posix:   the $TMPDIR environment variable, falling back to "/tmp"
# ---
# buf: destination buffer for the path
# cap: buffer capacity in bytes
# ret: full length of the path, or negative on error
pub fun temp_dir(buf: *u8, cap: usize) i64 {
    $if ($mach.build.os == $mach.os.windows) {
        ret impl.temp_dir(buf, cap);
    }
    $or {
        val n: i64 = impl.getenv("TMPDIR", buf, cap);
        if (n > 0) { ret n; }
        ret temp_dir_posix_default(buf, cap);
    }
}

$if ($mach.build.os != $mach.os.windows) {
    val TEMP_DIR_DEFAULT: str = "/tmp";

    # copy the posix fallback temp directory into buf under the temp_dir
    # truncation contract (used when $TMPDIR is unset or empty).
    fun temp_dir_posix_default(buf: *u8, cap: usize) i64 {
        val src: *u8 = TEMP_DIR_DEFAULT::*u8;
        val len: usize = str_len(TEMP_DIR_DEFAULT);
        var i: usize = 0;
        for (i + 1 < cap && i < len) {
            buf[i] = src[i];
            i = i + 1;
        }
        if (i < cap) { buf[i] = 0; }
        ret len::i64;
    }
}

# time

# read the wall-clock time
# ---
# out: pointer to Timespec to populate
# ret: 0 on success, negative errno on failure
pub fun realtime(out: *Timespec) i64 {
    var ts: impl.timespec = impl.timespec{tv_sec: 0, tv_nsec: 0};
    val r: i64 = impl.clock_gettime(impl.CLOCK_REALTIME, ?ts);
    if (r < 0) {
        out.sec = 0;
        out.nsec = 0;
        ret r;
    }
    out.sec = ts.tv_sec;
    out.nsec = ts.tv_nsec;
    ret 0;
}

# sentinels
fwd NOT_FOUND: shared.NOT_FOUND;

# read the monotonic clock
# ---
# out: pointer to Timespec to populate
# ret: 0 on success, negative errno on failure
pub fun monotonic(out: *Timespec) i64 {
    var ts: impl.timespec = impl.timespec{tv_sec: 0, tv_nsec: 0};
    val r: i64 = impl.clock_gettime(impl.CLOCK_MONOTONIC, ?ts);
    if (r < 0) {
        out.sec = 0;
        out.nsec = 0;
        ret r;
    }
    out.sec = ts.tv_sec;
    out.nsec = ts.tv_nsec;
    ret 0;
}

# error
pub fun message(code: i64) str {
    if (code >= 0) {
        ret "not an error";
    }
    ret impl.error_message(code);
}

test "os: cpu_count at least one" {
    if (impl.cpu_count() < 1) { ret 1; }
    ret 0;
}

test "std.system.os.file_identity: observes a pinned object across rename and in-place writes" {
    val first: str = "mach_583_identity_first";
    val renamed: str = "mach_583_identity_renamed";
    impl.unlink(impl.AT_FDCWD, first, 0);
    impl.unlink(impl.AT_FDCWD, renamed, 0);
    val raw: i64 = impl.open(impl.AT_FDCWD, first, impl.O_CREAT | impl.O_EXCL | impl.O_RDWR, 0);
    if (raw < 0) { ret 1; }
    val fd: i32 = raw::i32;
    fin {
        impl.close(fd);
        impl.unlink(impl.AT_FDCWD, first, 0);
        impl.unlink(impl.AT_FDCWD, renamed, 0);
    }
    var initial: identities.Identity;
    var observed: identities.Identity;
    if (impl.file_identity(fd, ?initial) < 0) { ret 2; }
    if (impl.identity_at(impl.AT_FDCWD, first, ?observed) < 0 || !identities.equal(initial, observed)) { ret 3; }
    if (impl.rename(impl.AT_FDCWD, first, impl.AT_FDCWD, renamed) < 0) { ret 4; }
    if (impl.identity_at(impl.AT_FDCWD, renamed, ?observed) < 0 || !identities.equal(initial, observed)) { ret 5; }
    if (impl.write(fd, "new contents", 12) != 12) { ret 6; }
    if (impl.file_identity(fd, ?observed) < 0 || !identities.equal(initial, observed)) { ret 7; }
    val other: i64 = impl.open(impl.AT_FDCWD, first, impl.O_CREAT | impl.O_EXCL | impl.O_RDWR, 0);
    if (other < 0) { ret 8; }
    val queried: i64 = impl.file_identity(other::i32, ?observed);
    val closed: i64 = impl.close(other::i32);
    if (queried < 0 || closed < 0 || identities.equal(initial, observed)) { ret 9; }
    ret 0;
}
