# observational identity within one host and its current mounted namespace
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.encoding.hex;

# maximum access authorized while retaining identity, never a required upgrade
pub def Access: u8;
pub val METADATA_ONLY: Access = 0;
pub val READ_AUTHORIZED: Access = 1;

pub val LINUX_LOCAL: u8 = 1;
pub val DARWIN_LOCAL: u8 = 2;
pub val WINDOWS_LOCAL: u8 = 3;
pub val TEXT_CAPACITY: usize = 83;

# opaque to filesystem callers, native producers initialize every byte
pub rec Identity {
    representation: [41]u8;
}

fun valid(value: *Identity) bool {
    val backend: u8 = value.representation[0];
    if (backend != LINUX_LOCAL && backend != DARWIN_LOCAL && backend != WINDOWS_LOCAL) { ret false; }
    var i: usize = 1;
    for (i < 17) {
        if (value.representation[i] != 0) { ret false; }
        i = i + 1;
    }
    if (backend == WINDOWS_LOCAL) { ret true; }
    i = 33;
    for (i < 41) {
        if (value.representation[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun equal(a: Identity, b: Identity) bool {
    if (!valid(?a) || !valid(?b)) { ret false; }
    var i: usize = 0;
    for (i < 41) {
        if (a.representation[i] != b.representation[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# failure leaves the output untouched
pub fun encode(value: Identity, out: *u8, capacity: usize) bool {
    if (out == nil || capacity < TEXT_CAPACITY || !valid(?value)) { ret false; }
    ret hex.encode(?value.representation[0], 41, out, capacity) == 82;
}

# only the complete current representation is accepted
pub fun decode(text: str, out: *Identity) bool {
    if (out == nil || text == nil || str_len(text) != 82) { ret false; }
    var value: Identity;
    if (hex.decode(text::*u8, 82, ?value.representation[0], 41) != 41 || !valid(?value)) { ret false; }
    @out = value;
    ret true;
}

pub fun native(backend: u8, volume: u64, file: u64) Identity {
    var value: Identity;
    value.representation[0] = backend;
    var i: usize = 0;
    for (i < 8) {
        value.representation[17 + i] = (volume >> (i * 8))::u8;
        value.representation[25 + i] = (file >> (i * 8))::u8;
        i = i + 1;
    }
    ret value;
}

test "std.system.file_identity: full native identity survives serialization" {
    var original: Identity = native(WINDOWS_LOCAL, 0xfedcba9876543210, 0x0123456789abcdef);
    original.representation[33] = 0x62;
    original.representation[40] = 0x93;
    var text: [83]u8;
    var restored: Identity;
    if (!encode(original, ?text[0], 83) || !decode((?text[0])::str, ?restored)) { ret 1; }
    if (!equal(original, restored)) { ret 2; }
    restored.representation[40] = 0x94;
    if (equal(original, restored)) { ret 3; }
    if (equal(native(LINUX_LOCAL, 23, 17), native(DARWIN_LOCAL, 23, 17))) { ret 4; }
    restored = original;
    restored.representation[24] = restored.representation[24] ^ 1;
    if (equal(original, restored)) { ret 5; }
    ret 0;
}

test "std.system.file_identity: malformed or partial tokens preserve the output" {
    val original: Identity = native(LINUX_LOCAL, 23, 17);
    var restored: Identity = original;
    var text: [83]u8;
    text[0] = 'x';
    if (encode(original, ?text[0], 82) || text[0] != 'x') { ret 1; }
    if (!encode(original, ?text[0], 83)) { ret 2; }
    text[81] = 'q';
    if (decode((?text[0])::str, ?restored) || !equal(original, restored)) { ret 3; }
    if (decode("0100", ?restored) || !equal(original, restored)) { ret 4; }
    if (!encode(original, ?text[0], 83)) { ret 5; }
    text[1] = '9';
    if (decode((?text[0])::str, ?restored) || !equal(original, restored)) { ret 6; }
    if (!encode(original, ?text[0], 83)) { ret 7; }
    text[3] = '1';
    if (decode((?text[0])::str, ?restored) || !equal(original, restored)) { ret 8; }
    ret 0;
}
