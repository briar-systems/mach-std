# observational identity within one host and its current mounted namespace
use std.types.bool.bool;
use std.encoding.hex;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

# maximum access authorized while retaining identity, never a required upgrade
pub def Access: u8;
pub val METADATA_ONLY:   Access = 0;
pub val READ_AUTHORIZED: Access = 1;

pub val LINUX_LOCAL:   u8 = 1;
pub val DARWIN_LOCAL:  u8 = 2;
pub val WINDOWS_LOCAL: u8 = 3;
pub val WASI_LOCAL:    u8 = 4;
# a windows volume with no stable file id, such as fat or exfat: the volume
# serial and the 64-bit file index, which names the file's directory entry
pub val WINDOWS_ENTRY: u8    = 5;
pub val TEXT_CAPACITY: usize = 83;

# opaque to filesystem callers, native producers initialize every byte
#
# byte 0 is the backend, bytes 1 to 16 are zero, bytes 17 to 24 hold the
# volume and 25 to 32 the file number, little-endian. bytes 33 to 40 are zero
# except for WINDOWS_LOCAL, whose file id is 128 bits
# ---
# representation: the 41 identity bytes
pub rec Identity {
    representation: [41]u8;
}

fun valid(value: *Identity) bool {
    val backend: u8 = value.representation[0];
    if (backend != LINUX_LOCAL && backend != DARWIN_LOCAL && backend != WINDOWS_LOCAL && backend != WASI_LOCAL
        && backend != WINDOWS_ENTRY) { ret false; }
    var i: usize = 1;
    for (i < 17) {
        if (value.representation[i] != 0) { ret false; }
        i = i + 1;
    }
    if (backend == WINDOWS_LOCAL) { ret true; }
    i = 33;
    for (i < 41) {
        if (value.representation[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# compare two identities byte for byte
# ---
# a:   first identity
# b:   second identity
# ret: true when both are well formed and identical
pub fun equal(a: Identity, b: Identity) bool {
    if (!valid(?a) || !valid(?b)) { ret false; }
    var i: usize = 0;
    for (i < 41) {
        if (a.representation[i] != b.representation[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether an identity names its file for as long as the file exists
#
# a WINDOWS_ENTRY identity names a directory entry: two entries that exist at
# once differ, but a file's entry can move when the file is renamed or its
# directory is reorganized, and a freed entry is reused by the next file made
# there. it compares soundly only between observations taken while the file
# stays open and unrenamed, never across a close or once stored for later
# ---
# value: a well-formed identity
# ret:   false for WINDOWS_ENTRY, true for every other backend
pub fun lasting(value: Identity) bool {
    ret value.representation[0] != WINDOWS_ENTRY;
}

# failure leaves the output untouched
#
# writes the identity as 82 lowercase hex digits and a terminating nul
# ---
# value:    identity to encode
# out:      destination buffer
# capacity: bytes at out, at least TEXT_CAPACITY
# ret:      false for a nil out, a short buffer or a malformed identity
pub fun encode(value: Identity, out: *u8, capacity: usize) bool {
    if (out == nil || capacity < TEXT_CAPACITY || !valid(?value)) { ret false; }
    ret hex.encode(?value.representation[0], 41, out, capacity) == 82;
}

# only the complete current representation is accepted
# ---
# text: 82 hex digits as encode writes them
# out:  receives the identity, untouched on failure
# ret:  false for nil operands, a wrong length, bad digits or a malformed identity
pub fun decode(text: str, out: *Identity) bool {
    if (out == nil || text == nil || str_len(text) != 82) { ret false; }
    var value: Identity;
    if (hex.decode(text::*u8, 82, ?value.representation[0], 41) != 41 || !valid(?value)) { ret false; }
    @out = value;
    ret true;
}

# build an identity from a backend's volume and file numbers
# ---
# backend: one of the *_LOCAL backend bytes
# volume:  volume or device number
# file:    file number within the volume
# ret:     the identity, every other byte zero
pub fun native(backend: u8, volume: u64, file: u64) Identity {
    var value: Identity;
    value.representation[0] = backend;
    var i: usize = 0;
    for (i < 8) {
        value.representation[17 + i] = (volume >> (i * 8))::u8;
        value.representation[25 + i] = (file >> (i * 8))::u8;
        i                            = i + 1;
    }
    ret value;
}

test identity__round_trip_and_equality {
    var original: Identity = native(WINDOWS_LOCAL, 0xfedcba9876543210, 0x0123456789abcdef);
    original.representation[33] = 0x62;
    original.representation[40] = 0x93;
    var text:     [83]u8;
    var restored: Identity;
    if (!encode(original, ?text[0], 83) || !decode((?text[0])::str, ?restored)) { ret 1; }
    if (!equal(original, restored))                                             { ret 2; }
    restored.representation[40] = 0x94;
    if (equal(original, restored))                                        { ret 3; }
    if (equal(native(LINUX_LOCAL, 23, 17), native(DARWIN_LOCAL, 23, 17))) { ret 4; }
    restored                    = original;
    restored.representation[24] = restored.representation[24] ^ 1;
    if (equal(original, restored)) { ret 5; }
    ret 0;
}

test lasting__only_windows_entry_identities_are_not {
    if (!lasting(native(LINUX_LOCAL, 23, 17)))                               { ret 1; }
    if (!lasting(native(WINDOWS_LOCAL, 23, 17)))                             { ret 2; }
    if (lasting(native(WINDOWS_ENTRY, 23, 17)))                              { ret 3; }
    if (equal(native(WINDOWS_ENTRY, 23, 17), native(WINDOWS_LOCAL, 23, 17))) { ret 4; }
    ret 0;
}

test decode__malformed_tokens_preserve_the_output {
    val original: Identity = native(LINUX_LOCAL, 23, 17);
    var restored: Identity = original;
    var text:     [83]u8;
    text[0] = 'x';
    if (encode(original, ?text[0], 82) || text[0] != 'x') { ret 1; }
    if (!encode(original, ?text[0], 83))                  { ret 2; }
    text[81] = 'q';
    if (decode((?text[0])::str, ?restored) || !equal(original, restored)) { ret 3; }
    if (decode("0100", ?restored) || !equal(original, restored))          { ret 4; }
    if (!encode(original, ?text[0], 83))                                  { ret 5; }
    text[1] = '9';
    if (decode((?text[0])::str, ?restored) || !equal(original, restored)) { ret 6; }
    if (!encode(original, ?text[0], 83))                                  { ret 7; }
    text[3] = '1';
    if (decode((?text[0])::str, ?restored) || !equal(original, restored)) { ret 8; }
    ret 0;
}
