# the processor's data-independent-timing mode (PSTATE.DIT) on aarch64
#
# a secret integer multiply in an `#[oblivious]` function is constant time on
# aarch64 only with FEAT_DIT on. the linker writes two hidden read-only cells
# of one byte in every aarch64-linux and aarch64-darwin executable
# (briar-systems/mink#605): `__mach_dit_wanted`, 1 when any input module
# admits such a multiply, and `__mach_timing_mode_required`, 1 when the build
# states `require_timing_mode`. both are 0 when unset. the mode is best
# effort, and std owns process start and every thread it spawns, so this
# module is the half that turns it on:
#
# - `_rt_init` calls `init` after envp is published and before main. with
#   both bytes 0 it does nothing. otherwise the OS says whether the processor
#   and kernel provide DIT (linux: HWCAP_DIT in AT_HWCAP, darwin:
#   hw.optional.arm.FEAT_DIT, both through `os.cpu_dit`). where it does, the
#   mode goes on. where it does not, the process continues, unless the
#   required byte is set, and then it writes `REFUSAL` and a newline to stderr
#   through the panic sink and ends with status 255, before any secret
#   multiply could run without the mode.
# - DIT is per thread and nothing guarantees a new thread inherits it, so
#   every trampoline std owns calls `enter_thread` first, which sets the mode
#   when `init` turned it on.
# - `init` records its outcome, which std.system.timing reports at run time.
#
# `decide` is the whole policy as a pure function, so every branch is unit
# tested on any processor by forcing the availability answer. the enable
# sequence is `msr dit, 1` then `dsb nsh; isb sy`.
# the module imports only the panic sink, so the OS layer's trampolines and
# crypto.ct can call it without a cycle. the tests that need the OS's answer live in
# std.system.cpu. the module builds on every target and is empty except on
# aarch64 linux and darwin, so the entry points can reference it
# unconditionally.

use std.system.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

# what `init` does with the bytes and the availability answer
pub val SKIP:     i64 = 0;
pub val ENABLE:   i64 = 1;
pub val REFUSE:   i64 = 2;
pub val CONTINUE: i64 = 3;

# the exact refusal text. `refuse` writes it as one line, the newline after it
pub val REFUSAL: *u8 = "std.runtime: this program requires the processor's data-independent-timing mode (PSTATE.DIT, built with require_timing_mode), and this processor or kernel does not provide it (aarch64-linux: HWCAP_DIT absent; aarch64-darwin: hw.optional.arm.FEAT_DIT is 0); refusing to start";

# the longest line `refuse` writes, the text and its newline
val LINE_CAPACITY: usize = 512;

# the length of `REFUSAL`, scanned here because std.types.string reaches
# crypto.ct, which reaches this module
fun refusal_len() usize {
    var len: usize = 0;
    for (REFUSAL[len] != 0) { len = len + 1; }
    ret len;
}

# write the refusal line to stderr and end the process with status 255
#
# the panic sink writes one buffer and never returns, so the line is
# assembled first
fun refuse() {
    var line: [512]u8;
    val len:  usize = refusal_len();
    var i:    usize = 0;
    for (i < len && i < LINE_CAPACITY - 1) {
        line[i] = REFUSAL[i];
        i       = i + 1;
    }
    line[i] = 10;
    panic.panic_sink(?line[0], i + 1);
}

# the policy: a link that wants the mode gets it where it exists, and only a
# link that requires it refuses to start where it does not
# ---
# wanted:    the link's `__mach_dit_wanted` byte, nonzero when a secret
#            multiply is admitted
# required:  the link's `__mach_timing_mode_required` byte, nonzero when the
#            build states `require_timing_mode`
# available: `os.cpu_dit()`: 1 when the processor and kernel provide DIT, 0
#            when not, negative when the answer could not be read
# ret:       SKIP, ENABLE, CONTINUE or REFUSE
pub fun decide(wanted: bool, required: bool, available: i64) i64 {
    if (!wanted && !required) { ret SKIP; }
    if (available == 1)       { ret ENABLE; }
    if (required)             { ret REFUSE; }
    ret CONTINUE;
}

$if ($mach.build.arch == $mach.arch.aarch64 && ($mach.build.sys == $mach.sys.linux || $mach.build.sys == $mach.sys.darwin)) {
    # whether this target has the mode for a process to set
    pub val PROVIDED: bool = true;

    # the bit the mode occupies in PSTATE, as `mrs x0, dit` reads it
    pub val DIT_BIT: u64 = 1 << 24;

    # where the asm below stores what it read, addressed by symbol as `_start`
    # addresses `_rt_argc`
    #[symbol("_std_dit_probe")]
    var probe: u64 = 0;

    # what `init` decided, SKIP until it runs
    var outcome: i64 = SKIP;

    # whether `init` found the mode provided
    var present: bool = false;

    # whether this link admits a secret multiply
    #
    # the linker's `__mach_dit_wanted` is hidden and one byte, read with the
    # page plus low-12 idiom rather than an `ext val`, which would go through
    # the GOT that Mach-O output does not carry
    pub fun wanted() bool {
        asm aarch64 {
            adrp x11, __mach_dit_wanted
            ldrb w0, [x11, :lo12:__mach_dit_wanted]
            adrp x11, _std_dit_probe
            str x0, [x11, :lo12:_std_dit_probe]
        }
        ret probe != 0;
    }

    # whether the build states `require_timing_mode`
    #
    # `__mach_timing_mode_required` is read as `wanted` reads its cell
    pub fun required() bool {
        asm aarch64 {
            adrp x11, __mach_timing_mode_required
            ldrb w0, [x11, :lo12:__mach_timing_mode_required]
            adrp x11, _std_dit_probe
            str x0, [x11, :lo12:_std_dit_probe]
        }
        ret probe != 0;
    }

    # set PSTATE.DIT for the calling thread
    #
    # `msr dit, 1`, then `dsb nsh` and `isb sy` so nothing after this point
    # was fetched or issued under the old state
    #[ext(dit)]
    pub fun enable() {
        asm aarch64 {
            msr dit, 1
            dsb nsh
            isb sy
        }
    }

    # the calling thread's PSTATE.DIT, `DIT_BIT` when the mode is on
    #[ext(dit)]
    pub fun read() u64 {
        asm aarch64 {
            mrs x0, dit
            adrp x11, _std_dit_probe
            str x0, [x11, :lo12:_std_dit_probe]
        }
        ret probe;
    }

    # process start: enable the mode, continue without it or refuse to start
    # ---
    # available: `os.cpu_dit()`
    pub fun init(available: i64) {
        present = available == 1;
        outcome = decide(wanted(), required(), available);
        if (outcome == REFUSE) { refuse(); }
        if (outcome == ENABLE) { enable(); }
    }

    # what `init` decided: SKIP, ENABLE or CONTINUE
    pub fun decided() i64 {
        ret outcome;
    }

    # set the mode for the calling thread where the processor provides it
    # ---
    # ret: whether the mode is now on for the calling thread
    pub fun engage() bool {
        if (!present) { ret false; }
        enable();
        ret true;
    }

    # thread start: set the mode when `init` turned it on
    #
    # every thread trampoline std owns calls this first
    pub fun enter_thread() {
        if (outcome == ENABLE) { enable(); }
    }
}
$or {
    # no other target has the mode or the cells
    pub val PROVIDED: bool = false;

    pub fun wanted() bool {
        ret false;
    }

    pub fun required() bool {
        ret false;
    }

    pub fun init(available: i64) {}

    pub fun decided() i64 {
        ret SKIP;
    }

    pub fun engage() bool {
        ret false;
    }

    pub fun enter_thread() {}
}

test decide__fails_closed_without_the_mode {
    if (decide(false, false, 0) != SKIP)      { ret 1; }
    if (decide(false, false, 1) != SKIP)      { ret 2; }
    if (decide(false, false, -38) != SKIP)    { ret 3; }
    if (decide(true, false, 1) != ENABLE)     { ret 4; }
    if (decide(true, false, 0) != CONTINUE)   { ret 5; }
    if (decide(true, false, -38) != CONTINUE) { ret 6; }
    if (decide(false, true, 1) != ENABLE)     { ret 7; }
    if (decide(true, true, 0) != REFUSE)      { ret 8; }
    if (decide(false, true, -38) != REFUSE)   { ret 9; }
    ret 0;
}

test refusal__is_one_line_that_fits_the_buffer {
    val len: usize = refusal_len();
    if (len < 200 || len + 1 > LINE_CAPACITY) { ret 1; }
    var i: usize = 0;
    for (i < len) {
        if (REFUSAL[i] == 10) { ret 2; }
        i = i + 1;
    }
    ret 0;
}
