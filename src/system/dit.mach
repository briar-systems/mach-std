# the processor's data-independent-timing mode (PSTATE.DIT) on aarch64
#
# a soft constant-time function switches the mode itself: its entry reads
# PSTATE.DIT and, where it is off, sets it, and its return clears it again
# where the entry set it. where the build does not select FEAT_DIT, the entry
# first reads `__mach_timing_available`, a hidden one-byte global std defines
# here, and runs without the mode where it is 0. std owns the byte:
#
# - it is defined on every aarch64 target, freestanding included, since every
#   aarch64 image with soft functions links a definition. it is never exported.
# - the runtime sets it once before main and before any thread starts: 1 when
#   the processor provides DIT and the process may switch it, 0 otherwise.
#   linux reads HWCAP_DIT in AT_HWCAP and darwin hw.optional.arm.FEAT_DIT, both
#   through `os.cpu_dit`, and freestanding reads ID_AA64PFR0_EL1 at EL1.
#
# nothing turns the mode on at start or per thread. `enable`, `disable` and
# `read` are for code that manages the mode itself. the enable sequence is
# `msr dit, 1` then `dsb nsh; isb sy`.
#
# the module imports no other std module but bool, so the runtimes and
# crypto.ct can call it without a cycle. the tests that need the OS's answer
# live in std.system.cpu. the module builds on every target, so the entry
# points can reference it unconditionally.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

$if ($mach.build.arch == $mach.arch.aarch64) {
    # the availability byte mirl's soft functions read
    #[symbol("__mach_timing_available")]
    var timing_available: u8 = 0;
}

$if ($mach.build.arch == $mach.arch.aarch64 && ($mach.build.sys == $mach.sys.linux || $mach.build.sys == $mach.sys.darwin)) {
    # publish whether the process may switch the mode, before main and before
    # any thread starts
    # ---
    # available: `os.cpu_dit()`: 1 when the processor and kernel provide DIT, 0
    #            when not, negative when the answer could not be read
    pub fun publish(available: i64) {
        if (available == 1) { timing_available = 1; }
        or                  { timing_available = 0; }
    }

    # whether the processor provides the mode and the process may switch it
    pub fun available() bool {
        ret timing_available != 0;
    }
}
$or {
    # freestanding aarch64 sets the byte from its entry asm, and mach code
    # there reaches no global, so it answers as a target without the mode
    pub fun publish(available: i64) {}

    pub fun available() bool {
        ret false;
    }
}

$if ($mach.build.arch == $mach.arch.aarch64 && ($mach.build.sys == $mach.sys.linux || $mach.build.sys == $mach.sys.darwin)) {
    # whether this target has the mode for a process to set
    pub val PROVIDED: bool = true;

    # the bit the mode occupies in PSTATE, as `mrs x0, dit` reads it
    pub val DIT_BIT: u64 = 1 << 24;

    # where the asm below stores what it read, addressed by symbol as `_start`
    # addresses `_rt_argc`
    #[symbol("_std_dit_probe")]
    var probe: u64 = 0;

    # set PSTATE.DIT for the calling thread
    #
    # `msr dit, 1`, then `dsb nsh` and `isb sy` so nothing after this point
    # was fetched or issued under the old state
    #[extension("dit")]
    pub fun enable() {
        asm aarch64 {
            msr dit, 1
            dsb nsh
            isb sy
        }
    }

    # clear PSTATE.DIT for the calling thread, synchronized as enable is
    #[extension("dit")]
    pub fun disable() {
        asm aarch64 {
            msr dit, 0
            dsb nsh
            isb sy
        }
    }

    # the calling thread's PSTATE.DIT, `DIT_BIT` when the mode is on
    #[extension("dit")]
    pub fun read() u64 {
        $if ($mach.build.sys == $mach.sys.darwin) {
            # mach-o spells the page and its offset as specifiers on the underscored name
            asm aarch64 {
                mrs x0, dit
                adrp x11, __std_dit_probe@PAGE
                str x0, [x11, __std_dit_probe@PAGEOFF]
            }
        }
        $or {
            asm aarch64 {
                mrs x0, dit
                adrp x11, _std_dit_probe
                str x0, [x11, :lo12:_std_dit_probe]
            }
        }
        ret probe;
    }

    # set the mode for the calling thread where the processor provides it
    # ---
    # ret: whether the mode is now on for the calling thread
    pub fun engage() bool {
        if (!available()) { ret false; }
        enable();
        ret true;
    }
}
$or {
    # no other hosted target has a mode for a process to set
    pub val PROVIDED: bool = false;

    pub fun engage() bool {
        ret false;
    }
}
