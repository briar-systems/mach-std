# the capability groups are a promise: a target that claims a group exports
# every member of it through std.system.os. each test names every member of
# one group, so a missing member fails the build on any target that claims it.
# the member lists are the 3.x surface documented in OS-CONTRACT.md. members
# std.system.os defines itself, rather than forwarding from the per-OS module,
# exist wherever the module compiles, so only forwarded members are named

use std.system.capability;

$if (capability.HOSTED) {
    use std.system.os;
}

$if (capability.HOSTED) {
    test "capability.conformance: the core group is complete" {
        if (os.NOT_FOUND::i64 != os.NOT_FOUND::i64) { ret 1; }
        if (os.abort == nil)                        { ret 2; }
        if (os.error_kind == nil)                   { ret 3; }
        if (os.terminate == nil)                    { ret 4; }
        ret 0;
    }
}

$if (capability.HAS_PAGES) {
    test "capability.conformance: the pages group is complete" {
        if (os.ADVISE_DONT_NEED::i64 != os.ADVISE_DONT_NEED::i64)   { ret 1; }
        if (os.ADVISE_NORMAL::i64 != os.ADVISE_NORMAL::i64)         { ret 2; }
        if (os.ADVISE_RANDOM::i64 != os.ADVISE_RANDOM::i64)         { ret 3; }
        if (os.ADVISE_SEQUENTIAL::i64 != os.ADVISE_SEQUENTIAL::i64) { ret 4; }
        if (os.ADVISE_WILL_NEED::i64 != os.ADVISE_WILL_NEED::i64)   { ret 5; }
        if (os.PROT_EXEC::i64 != os.PROT_EXEC::i64)                 { ret 6; }
        if (os.PROT_NONE::i64 != os.PROT_NONE::i64)                 { ret 7; }
        if (os.PROT_READ::i64 != os.PROT_READ::i64)                 { ret 8; }
        if (os.PROT_WRITE::i64 != os.PROT_WRITE::i64)               { ret 9; }
        if ($size_of(os.SecretBorrow) == 0)                         { ret 10; }
        if (os.advise == nil)                                       { ret 11; }
        if (os.allocate == nil)                                     { ret 12; }
        if (os.deallocate == nil)                                   { ret 13; }
        if (os.heap_region_base == nil)                             { ret 14; }
        if (os.heap_region_extend == nil)                           { ret 15; }
        if (os.lock == nil)                                         { ret 16; }
        if (os.page_size == nil)                                    { ret 17; }
        if (os.protect == nil)                                      { ret 18; }
        if (os.reallocate == nil)                                   { ret 19; }
        if (os.unlock == nil)                                       { ret 20; }
        ret 0;
    }
}

$if (capability.HAS_CLOCK) {
    test "capability.conformance: the clock group is complete" {
        if ($size_of(os.Timespec) == 0) { ret 1; }
        if (os.sleep == nil)            { ret 2; }
        ret 0;
    }
}

$if (capability.HAS_ENTROPY) {
    test "capability.conformance: the entropy group is complete" {
        if (os.random_fill == nil) { ret 1; }
        ret 0;
    }
}

