$if (capability.HAS_PROCESS) {
    test "capability.conformance: the process group is complete" {
        if (os.PROCESS_CONTINUED::i64 != os.PROCESS_CONTINUED::i64)       { ret 1; }
        if (os.PROCESS_EXITED::i64 != os.PROCESS_EXITED::i64)             { ret 2; }
        if (os.PROCESS_OP_CLOSE::i64 != os.PROCESS_OP_CLOSE::i64)         { ret 3; }
