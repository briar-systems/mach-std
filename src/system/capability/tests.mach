# a gate in another module selects on the capability constants at comptime

use std.system.capability;

$if (capability.HAS_PAGES) {
    use std.system.os;

    fun selected() i64 {
        ret os.page_size()::i64;
    }
}
$or {
    fun selected() i64 {
        ret 0;
    }
}

# the unselected branch is discarded before resolution, so an import that
# could never resolve does not fail the build
$if (!capability.HOSTED) {
    use std.system.capability.absent;

    fun discarded() i64 {
        ret absent.value;
    }
}
$or {
    fun discarded() i64 {
        ret 1;
    }
}

test capability_a_gate_in_another_module_selects_on_the_constants {
    if (selected() <= 0)  { ret 1; }
    if (discarded() != 1) { ret 2; }
    ret 0;
}
