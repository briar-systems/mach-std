# the data-independent-timing mode a process runs under, as a run-time query
#
# constant-time code is constant time on some processors only under a mode
# the processor or system provides. on aarch64 linux and darwin that is
# PSTATE.DIT, which std.system.dit turns on at start where the link wants it
# and the processor provides it, and where neither holds the process runs
# without it. a build that states `require_timing_mode` refuses to start
# instead. `mode` reports which of those happened. no other target has a mode
# a process can set (x86-64's DOITM is the kernel's to configure), so there
# the answer is UNAVAILABLE.

use std.system.dit;

# the mode is on for every thread std starts
pub val ON: i64 = 0;
# the link wants the mode and the processor or target does not provide it
pub val UNAVAILABLE: i64 = 1;
# nothing in the link relies on the mode, so start-up left it off
pub val UNNEEDED: i64 = 2;

# the timing mode this process runs under
# ---
# ret: ON, UNAVAILABLE or UNNEEDED
pub fun mode() i64 {
    if (!dit.PROVIDED) { ret UNAVAILABLE; }
    val outcome: i64 = dit.decided();
    if (outcome == dit.ENABLE)   { ret ON; }
    if (outcome == dit.CONTINUE) { ret UNAVAILABLE; }
    ret UNNEEDED;
}
