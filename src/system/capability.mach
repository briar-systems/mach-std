# which operating system capabilities the build target provides
#
# std.system.os is a contract of primitives in independent groups, and a
# target may provide only some of them. each HAS_* constant says whether one
# group is available, as a comptime value, so a module gates on it with `$if`
# and the unselected branch, OS-bound imports included, is discarded before
# resolution:
#
#   $if (capability.HAS_FILES) { use std.system.os; ... }
#
# this module imports nothing OS-bound and builds on every target, freestanding
# included. the signatures and assumptions behind each group are the contract
# itself (std.system.os).
#
# groups:
#
#   core      error translation, panic sink, exit. present whenever HOSTED is
#   pages     page allocation, protection, locking and advice
#   clock     realtime and monotonic clocks, sleep
#   entropy   cryptographic random fill
#   threads   thread spawn and join, futex-shaped wait and wake, cpu count
#   files     open, read, write, positioned io, stat, directories, pipes
#   io_queue  the native completion or readiness queue
#   sockets   stream, datagram and local sockets
#   process   spawn, wait, process id, environment
#
# each target selects one row of group bits below, so a new target or a new
# group is one row or one bit. a target that is not listed provides nothing,
# so a module gated on a group refuses it rather than resolving against an OS
# layer it does not have.

val CORE:     u32 = 1;
val PAGES:    u32 = 2;
val CLOCK:    u32 = 4;
val ENTROPY:  u32 = 8;
val THREADS:  u32 = 16;
val FILES:    u32 = 32;
val IO_QUEUE: u32 = 64;
val SOCKETS:  u32 = 128;
val PROCESS:  u32 = 256;

val ALL: u32 = CORE | PAGES | CLOCK | ENTROPY | THREADS | FILES | IO_QUEUE | SOCKETS | PROCESS;

$if ($mach.build.os == $mach.os.linux) {
    val GROUPS: u32 = ALL;
}
$or ($mach.build.os == $mach.os.darwin) {
    val GROUPS: u32 = ALL;
}
$or ($mach.build.os == $mach.os.windows) {
    val GROUPS: u32 = ALL;
}
$or {
    val GROUPS: u32 = 0;
}

# u8, the type a comparison yields. mach 5.0.4 fails `mach test` when a
# top-level gate reads a bool-typed constant from another module
# std.system.os resolves on this target: its core group is present
pub val HOSTED:       u8 = (GROUPS & CORE) != 0;
pub val HAS_PAGES:    u8 = (GROUPS & PAGES) != 0;
pub val HAS_CLOCK:    u8 = (GROUPS & CLOCK) != 0;
pub val HAS_ENTROPY:  u8 = (GROUPS & ENTROPY) != 0;
pub val HAS_THREADS:  u8 = (GROUPS & THREADS) != 0;
pub val HAS_FILES:    u8 = (GROUPS & FILES) != 0;
pub val HAS_IO_QUEUE: u8 = (GROUPS & IO_QUEUE) != 0;
pub val HAS_SOCKETS:  u8 = (GROUPS & SOCKETS) != 0;
pub val HAS_PROCESS:  u8 = (GROUPS & PROCESS) != 0;

test "capability: every group is present on the hosted targets" {
    if (!HOSTED || !HAS_PAGES || !HAS_CLOCK || !HAS_ENTROPY || !HAS_THREADS) { ret 1; }
    if (!HAS_FILES || !HAS_IO_QUEUE || !HAS_SOCKETS || !HAS_PROCESS)         { ret 2; }
    ret 0;
}
