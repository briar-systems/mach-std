# the per-architecture feature record, its build-time selection, and the probe that
# needs no operating system
#
# this module imports nothing OS-bound. std.system.cpu reports features at run
# time through it, and the per-OS modules fill it for the isas whose feature
# bits are only readable through the OS (aarch64). it is a separate module so
# that std.system.os can name the record without importing std.system.cpu.
#
# the record is declared once per architecture under `$if ($mach.build.arch == ...)`,
# and its field names are exactly the compiler's extension names for that architecture
# (`$mach.build.ext.<name>`). a field of another architecture is a compile error,
# as it is for the compiler. beside each field one `val` reads the compiler's
# row, so this record fails to compile the moment the compiler drops or renames
# an extension. the SELECTED_* values say what the build target selects: a
# selected extension is required by the binary, so it is reported present
# without a probe.
#
# a row the compiler added after std's floor sits behind CRYPTO_ROWS, the
# version gate for that release. an older compiler never reads the untaken
# branch, and since it cannot require the extension, its SELECTED_* value is
# false and the field is whatever the probe finds.

use std.types.bool.bool;
use std.types.bool.false;

# whether the compiler knows the aes and carry-less multiply extensions, which
# mach 5.12.2 added (briar-systems/mach#3835)
val CRYPTO_ROWS: bool = $mach.version.major > 5
    || ($mach.version.major == 5 && ($mach.version.minor > 12
    || ($mach.version.minor == 12 && $mach.version.patch >= 2)));

$if ($mach.build.arch == $mach.arch.x86_64) {
    # x86_64 extensions std detects
    # ---
    # sha:    SHA-NI (sha256rnds2, sha256msg1, sha256msg2)
    # ssse3:  pshufb, palignr
    # sse41:  pblendw, pinsrd, pextrd, ptest
    # aes:    AES-NI (aesenc, aesenclast, aesdec, aesdeclast, aesimc, aeskeygenassist)
    # pclmul: pclmulqdq
    pub rec Features {
        sha:    bool;
        ssse3:  bool;
        sse41:  bool;
        aes:    bool;
        pclmul: bool;
    }

    pub val SELECTED_SHA:   bool = $mach.build.ext.sha == 1;
    pub val SELECTED_SSSE3: bool = $mach.build.ext.ssse3 == 1;
    pub val SELECTED_SSE41: bool = $mach.build.ext.sse41 == 1;

    $if (CRYPTO_ROWS) {
        pub val SELECTED_AES:    bool = $mach.build.ext.aes == 1;
        pub val SELECTED_PCLMUL: bool = $mach.build.ext.pclmul == 1;
    }
    $or {
        pub val SELECTED_AES:    bool = false;
        pub val SELECTED_PCLMUL: bool = false;
    }

    # the features the build target selects, which the binary requires
    pub fun selected() Features {
        ret Features{sha: SELECTED_SHA, ssse3: SELECTED_SSSE3, sse41: SELECTED_SSE41,
            aes: SELECTED_AES, pclmul: SELECTED_PCLMUL};
    }

    # the features the running processor reports through cpuid
    #
    # leaf 1 ecx bit 9 is ssse3, bit 19 is sse4.1, bit 25 is aes and bit 1 is
    # pclmulqdq. leaf 7 subleaf 0 ebx bit 29 is sha, and leaf 0 eax says
    # whether leaf 7 exists. all five use only xmm state, which every x86_64
    # operating system enables, so no xgetbv check is needed. cpuid is
    # baseline on x86_64 and needs no OS
    pub fun probe(out: *Features) {
        var max_leaf: u32 = 0;
        var leaf1_c:  u32 = 0;
        var leaf7_b:  u32 = 0;
        asm x86_64 {
            xor eax, eax
            xor ecx, ecx
            cpuid
            mov {max_leaf}, eax
            mov eax, 1
            xor ecx, ecx
            cpuid
            mov {leaf1_c}, ecx
        }
        if (max_leaf >= 7) {
            asm x86_64 {
                mov eax, 7
                xor ecx, ecx
                cpuid
                mov {leaf7_b}, ebx
            }
        }
        out.ssse3  = ((leaf1_c >> 9) & 1) == 1;
        out.sse41  = ((leaf1_c >> 19) & 1) == 1;
        out.aes    = ((leaf1_c >> 25) & 1) == 1;
        out.pclmul = ((leaf1_c >> 1) & 1) == 1;
        out.sha    = ((leaf7_b >> 29) & 1) == 1;
    }

    # the union of what the build selects and what the processor reports
    pub fun merge(out: *Features, probed: Features) {
        out.sha    = SELECTED_SHA || probed.sha;
        out.ssse3  = SELECTED_SSSE3 || probed.ssse3;
        out.sse41  = SELECTED_SSE41 || probed.sse41;
        out.aes    = SELECTED_AES || probed.aes;
        out.pclmul = SELECTED_PCLMUL || probed.pclmul;
    }
}
$or ($mach.build.arch == $mach.arch.aarch64) {
    # aarch64 extensions std detects
    # ---
    # sha2:  sha256h, sha256h2, sha256su0, sha256su1
    # aes:   aese, aesd, aesmc, aesimc
    # pmull: pmull and pmull2 on 64-bit lanes (.1q from .1d or .2d)
    pub rec Features {
        sha2:  bool;
        aes:   bool;
        pmull: bool;
    }

    pub val SELECTED_SHA2: bool = $mach.build.ext.sha2 == 1;

    $if (CRYPTO_ROWS) {
        pub val SELECTED_AES:   bool = $mach.build.ext.aes == 1;
        pub val SELECTED_PMULL: bool = $mach.build.ext.pmull == 1;
    }
    $or {
        pub val SELECTED_AES:   bool = false;
        pub val SELECTED_PMULL: bool = false;
    }

    # the features the build target selects, which the binary requires
    pub fun selected() Features {
        ret Features{sha2: SELECTED_SHA2, aes: SELECTED_AES, pmull: SELECTED_PMULL};
    }

    # the union of what the build selects and what the OS reports
    pub fun merge(out: *Features, probed: Features) {
        out.sha2  = SELECTED_SHA2 || probed.sha2;
        out.aes   = SELECTED_AES || probed.aes;
        out.pmull = SELECTED_PMULL || probed.pmull;
    }
}
$or ($mach.build.arch == $mach.arch.riscv64 || $mach.build.arch == $mach.arch.riscv32) {
    # riscv extensions
    #
    # the names are the compiler's, `i c f d zkt` included. the OS fills the
    # record from riscv_hwprobe, or from AT_HWCAP on a kernel without it, and
    # the decoders below turn the raw words into fields, one row per extension.
    # zicsr and zifencei have no hwprobe key or hwcap bit, so they are what the
    # build selects
    pub rec Features {
        i:        bool;
        m:        bool;
        a:        bool;
        f:        bool;
        d:        bool;
        c:        bool;
        zicsr:    bool;
        zifencei: bool;
        zkt:      bool;
    }

    pub val SELECTED_I:        bool = $mach.build.ext.i == 1;
    pub val SELECTED_M:        bool = $mach.build.ext.m == 1;
    pub val SELECTED_A:        bool = $mach.build.ext.a == 1;
    pub val SELECTED_F:        bool = $mach.build.ext.f == 1;
    pub val SELECTED_D:        bool = $mach.build.ext.d == 1;
    pub val SELECTED_C:        bool = $mach.build.ext.c == 1;
    pub val SELECTED_ZICSR:    bool = $mach.build.ext.zicsr == 1;
    pub val SELECTED_ZIFENCEI: bool = $mach.build.ext.zifencei == 1;
    pub val SELECTED_ZKT:      bool = $mach.build.ext.zkt == 1;

    # the features the build target selects, which the binary requires
    pub fun selected() Features {
        ret Features{i: SELECTED_I, m: SELECTED_M, a: SELECTED_A, f: SELECTED_F, d: SELECTED_D,
            c: SELECTED_C, zicsr: SELECTED_ZICSR, zifencei: SELECTED_ZIFENCEI, zkt: SELECTED_ZKT};
    }

    # riscv_hwprobe keys, and the bits of the two values std reads
    pub val HWPROBE_BASE_BEHAVIOR: i64 = 3;
    pub val HWPROBE_IMA_EXT_0:     i64 = 4;

    # base behaviour value: the I, M and A base set
    val BASE_IMA: u64 = 1 << 0;

    # IMA_EXT_0 value bits, FD being F and D together
    val EXT_FD:  u64 = 1 << 0;
    val EXT_C:   u64 = 1 << 1;
    val EXT_ZKT: u64 = 1 << 16;

    # AT_HWCAP bits, the single-letter extensions: bit n is letter n of the alphabet
    val HWCAP_A: u64 = 1 << 0;
    val HWCAP_C: u64 = 1 << 2;
    val HWCAP_D: u64 = 1 << 3;
    val HWCAP_F: u64 = 1 << 5;
    val HWCAP_I: u64 = 1 << 8;
    val HWCAP_M: u64 = 1 << 12;

    # decode the riscv_hwprobe values for the base behaviour and IMA_EXT_0 keys
    # ---
    # base: the value for HWPROBE_BASE_BEHAVIOR, 0 when the key is unknown
    # ext0: the value for HWPROBE_IMA_EXT_0, 0 when the key is unknown
    pub fun from_hwprobe(out: *Features, base: u64, ext0: u64) {
        val ima: bool = (base & BASE_IMA) != 0;
        out.i        = ima;
        out.m        = ima;
        out.a        = ima;
        out.f        = (ext0 & EXT_FD) != 0;
        out.d        = (ext0 & EXT_FD) != 0;
        out.c        = (ext0 & EXT_C) != 0;
        out.zkt      = (ext0 & EXT_ZKT) != 0;
        out.zicsr    = false;
        out.zifencei = false;
    }

    # decode AT_HWCAP, which names single-letter extensions only
    pub fun from_hwcap(out: *Features, hwcap: u64) {
        out.i        = (hwcap & HWCAP_I) != 0;
        out.m        = (hwcap & HWCAP_M) != 0;
        out.a        = (hwcap & HWCAP_A) != 0;
        out.f        = (hwcap & HWCAP_F) != 0;
        out.d        = (hwcap & HWCAP_D) != 0;
        out.c        = (hwcap & HWCAP_C) != 0;
        out.zkt      = false;
        out.zicsr    = false;
        out.zifencei = false;
    }

    # the union of what the build selects and what the OS reports
    pub fun merge(out: *Features, probed: Features) {
        out.i        = SELECTED_I || probed.i;
        out.m        = SELECTED_M || probed.m;
        out.a        = SELECTED_A || probed.a;
        out.f        = SELECTED_F || probed.f;
        out.d        = SELECTED_D || probed.d;
        out.c        = SELECTED_C || probed.c;
        out.zicsr    = SELECTED_ZICSR || probed.zicsr;
        out.zifencei = SELECTED_ZIFENCEI || probed.zifencei;
        out.zkt      = SELECTED_ZKT || probed.zkt;
    }
}
