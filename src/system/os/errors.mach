# the portable reading of a native code, written once over the selected OS's codes
#
# each per-OS module forwards error_kind from here. linux and darwin return
# negated errno values, and windows maps its native errors onto the same names.

$if ($mach.build.os == $mach.os.linux) {
    use codes: std.system.os.linux.shared;
}
$or ($mach.build.os == $mach.os.darwin) {
    use codes: std.system.os.darwin.shared;
}
$or ($mach.build.os == $mach.os.windows) {
    use codes: std.system.os.windows.shared;
}
$or {
    $error("std.system.os.errors: requires linux, darwin or windows target");
}

use io_error: std.io.error;

# the portable kind of a native error code
# ---
# code: a negative native code from the selected implementation
# ret:  its io.error kind, OTHER when no portable kind fits
pub fun error_kind(code: i64) io_error.Kind {
    if (code == codes.EINTR)                                                                          { ret io_error.INTERRUPTED; }
    or (code == codes.EAGAIN)                                                                         { ret io_error.WOULD_BLOCK; }
    or (code == codes.ETIMEDOUT)                                                                      { ret io_error.TIMEOUT; }
    or (code == codes.ECANCELED)                                                                      { ret io_error.CANCELLED; }
    or (code == codes.ECONNREFUSED)                                                                   { ret io_error.REFUSED; }
    or (code == codes.ECONNRESET)                                                                     { ret io_error.RESET; }
    or (code == codes.ECONNABORTED)                                                                   { ret io_error.ABORTED; }
    or (code == codes.EBADF || code == codes.EPIPE || code == codes.ENOTCONN)                         { ret io_error.CLOSED; }
    or (code == codes.EADDRINUSE)                                                                     { ret io_error.ADDRESS_IN_USE; }
    or (code == codes.ENETUNREACH || code == codes.EHOSTUNREACH)                                      { ret io_error.UNREACHABLE; }
    or (code == codes.EACCES || code == codes.EPERM)                                                  { ret io_error.PERMISSION; }
    or (code == codes.ENOMEM || code == codes.ENFILE || code == codes.EMFILE || code == codes.ENOSPC) { ret io_error.RESOURCE_EXHAUSTED; }
    or (code == codes.EINVAL)                                                                         { ret io_error.INVALID; }
    or (code == codes.ENOTSUP)                                                                        { ret io_error.UNSUPPORTED; }
    or (code == codes.ENOENT)                                                                         { ret io_error.NOT_FOUND; }
    or (code == codes.EEXIST)                                                                         { ret io_error.EXISTS; }
    or (code == codes.ENOTDIR)                                                                        { ret io_error.NOT_DIRECTORY; }
    or (code == codes.EISDIR)                                                                         { ret io_error.IS_DIRECTORY; }
    or (code == codes.ENOTEMPTY)                                                                      { ret io_error.NOT_EMPTY; }
    or (code == codes.ENAMETOOLONG)                                                                   { ret io_error.NAME_TOO_LONG; }
    or (code == codes.EBUSY)                                                                          { ret io_error.BUSY; }
    or (code == codes.EIO)                                                                            { ret io_error.IO; }
    or (code == codes.ERANGE)                                                                         { ret io_error.RANGE; }
    or (code == codes.ECHILD)                                                                         { ret io_error.NO_CHILD; }
    or (code == codes.ELOOP)                                                                          { ret io_error.LOOP; }
    ret io_error.OTHER;
}
