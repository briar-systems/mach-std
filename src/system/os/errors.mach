# the portable reading of a native code, written once over the selected OS's codes
#
# each per-OS module forwards error_kind from here. linux and darwin return
# negated errno values, and windows maps its native errors onto the same names.

$if ($mach.build.sys == $mach.sys.linux) {
    use codes: std.system.os.linux.shared;
}
$or ($mach.build.sys == $mach.sys.darwin) {
    use codes: std.system.os.darwin.shared;
}
$or ($mach.build.sys == $mach.sys.windows) {
    use codes: std.system.os.windows.shared;
}
$or ($mach.build.sys == $mach.sys.wasi) {
    use codes: std.system.os.wasi.shared;
}
$or {
    $error("std.system.os.errors needs a linux, darwin, windows or wasi target");
}

use io_error: std.io.error;
use std.types.size.usize;

# a native code and the portable kind it reads as. every code std classifies is
# above -128 on each OS, so it fits a signed byte
rec Reading {
    code: i8;
    kind: io_error.Kind;
}

val READING_COUNT: usize = 33;

# the codes error_kind classifies, first match wins
val READINGS: [READING_COUNT]Reading = [READING_COUNT]Reading{
    Reading{code: codes.EINTR::i8, kind: io_error.INTERRUPTED},
    Reading{code: codes.EAGAIN::i8, kind: io_error.WOULD_BLOCK},
    Reading{code: codes.ETIMEDOUT::i8, kind: io_error.TIMEOUT},
    Reading{code: codes.ECANCELED::i8, kind: io_error.CANCELLED},
    Reading{code: codes.ECONNREFUSED::i8, kind: io_error.REFUSED},
    Reading{code: codes.ECONNRESET::i8, kind: io_error.RESET},
    Reading{code: codes.ECONNABORTED::i8, kind: io_error.ABORTED},
    Reading{code: codes.EBADF::i8, kind: io_error.CLOSED},
    Reading{code: codes.EPIPE::i8, kind: io_error.CLOSED},
    Reading{code: codes.ENOTCONN::i8, kind: io_error.CLOSED},
    Reading{code: codes.EADDRINUSE::i8, kind: io_error.ADDRESS_IN_USE},
    Reading{code: codes.ENETUNREACH::i8, kind: io_error.UNREACHABLE},
    Reading{code: codes.EHOSTUNREACH::i8, kind: io_error.UNREACHABLE},
    Reading{code: codes.EACCES::i8, kind: io_error.PERMISSION},
    Reading{code: codes.EPERM::i8, kind: io_error.PERMISSION},
    Reading{code: codes.ENOMEM::i8, kind: io_error.RESOURCE_EXHAUSTED},
    Reading{code: codes.ENFILE::i8, kind: io_error.RESOURCE_EXHAUSTED},
    Reading{code: codes.EMFILE::i8, kind: io_error.RESOURCE_EXHAUSTED},
    Reading{code: codes.ENOSPC::i8, kind: io_error.RESOURCE_EXHAUSTED},
    Reading{code: codes.EINVAL::i8, kind: io_error.INVALID},
    Reading{code: codes.ENOTSUP::i8, kind: io_error.UNSUPPORTED},
    Reading{code: codes.ENOSYS::i8, kind: io_error.UNSUPPORTED},
    Reading{code: codes.ENOENT::i8, kind: io_error.NOT_FOUND},
    Reading{code: codes.EEXIST::i8, kind: io_error.EXISTS},
    Reading{code: codes.ENOTDIR::i8, kind: io_error.NOT_DIRECTORY},
    Reading{code: codes.EISDIR::i8, kind: io_error.IS_DIRECTORY},
    Reading{code: codes.ENOTEMPTY::i8, kind: io_error.NOT_EMPTY},
    Reading{code: codes.ENAMETOOLONG::i8, kind: io_error.NAME_TOO_LONG},
    Reading{code: codes.EBUSY::i8, kind: io_error.BUSY},
    Reading{code: codes.EIO::i8, kind: io_error.IO},
    Reading{code: codes.ERANGE::i8, kind: io_error.RANGE},
    Reading{code: codes.ECHILD::i8, kind: io_error.NO_CHILD},
    Reading{code: codes.ELOOP::i8, kind: io_error.LOOP}
};

# the portable kind of a native error code
# ---
# code: a negative native code from the selected implementation
# ret:  its io.error kind, OTHER when no portable kind fits
pub fun error_kind(code: i64) io_error.Kind {
    var i: usize = 0;
    for (i < READING_COUNT) {
        if (READINGS[i].code == code) { ret READINGS[i].kind; }
        i = i + 1;
    }
    ret io_error.OTHER;
}
