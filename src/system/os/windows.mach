# windows OS interface with ISA dispatch
#
# forwards the complete surface from the selected ISA backend.
# consumers who need windows-specific functionality import this module
# directly rather than going through std.system.os.

$if ($mach.build.os != $mach.os.windows) {
    $error("std.system.os.windows: requires windows target");
}

$if ($mach.build.arch == $mach.arch.x86_64) {
    use impl: std.system.os.windows.x86_64;
}
$or {
    $error("std.system.os.windows: unsupported architecture");
}

use platform: std.system.os.windows.shared;

# kernel ABI types
fwd impl.stat_t;
fwd impl.timespec;
fwd impl.dirent64;

# path
fwd impl.separator;

