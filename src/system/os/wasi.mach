# wasi OS interface with one implementation per preview
#
# forwards the complete surface of the selected row. mach names one environment
# of the wasi system, preview1, so one row is selected here, and a later preview
# is its own module beside std.system.os.wasi.preview1 exporting this surface,
# selected on this line and given its capability row in std.system.capability.

$if ($mach.build.sys != $mach.sys.wasi) {
    $error("std.system.os.wasi: requires wasi target");
}

use std.system.os.errors;
use impl:     std.system.os.wasi.preview1;
use platform: std.system.os.wasi.shared;

# kernel ABI types
fwd impl.stat_t;
fwd impl.timespec;
fwd impl.DirectoryCursor;
fwd impl.DirectoryEntry;
fwd impl.DirectoryInitResult;

# path
fwd platform.separator;

# constants
fwd platform.STDIN_FD;
fwd platform.STDOUT_FD;
fwd platform.STDERR_FD;

fwd platform.O_RDONLY;
fwd platform.O_WRONLY;
fwd platform.O_RDWR;
fwd platform.O_CREAT;
fwd platform.O_EXCL;
fwd platform.O_TRUNC;
fwd platform.O_APPEND;
fwd platform.O_NONBLOCK;
fwd platform.O_DIRECTORY;
fwd platform.O_NOFOLLOW;

fwd platform.AT_FDCWD;
fwd platform.AT_SYMLINK_NOFOLLOW;
fwd platform.AT_REMOVEDIR;

fwd platform.LOCK_SH;
fwd platform.LOCK_EX;
fwd platform.LOCK_NB;
fwd platform.LOCK_UN;

fwd platform.S_IFMT;
fwd platform.S_IFDIR;
fwd platform.S_IFREG;
fwd platform.S_IFLNK;

fwd platform.WNOHANG;

fwd platform.CLOCK_REALTIME;
fwd platform.CLOCK_MONOTONIC;

fwd platform.EPERM;
fwd platform.ENOENT;
fwd platform.ESRCH;
fwd platform.EINTR;
fwd platform.EIO;
fwd platform.ENXIO;
fwd platform.E2BIG;
fwd platform.EBADF;
fwd platform.ECHILD;
fwd platform.EAGAIN;
fwd platform.ENOMEM;
fwd platform.EACCES;
fwd platform.EFAULT;
fwd platform.EBUSY;
fwd platform.EEXIST;
fwd platform.ENODEV;
fwd platform.ENOTDIR;
fwd platform.EISDIR;
fwd platform.EINVAL;
fwd platform.ENFILE;
fwd platform.EMFILE;
fwd platform.ETXTBSY;
fwd platform.ENOSPC;
fwd platform.EROFS;
fwd platform.EPIPE;
fwd platform.ENAMETOOLONG;
fwd platform.ERANGE;
fwd platform.ENOTEMPTY;
fwd platform.ELOOP;
fwd platform.ENOTSUP;
fwd platform.ETIMEDOUT;

# memory
fwd platform.allocate;
fwd platform.deallocate;
fwd platform.reallocate;
fwd platform.heap_region_base;
fwd platform.heap_region_extend;
fwd platform.protect;
fwd platform.lock;
fwd platform.unlock;
fwd platform.advise;
fwd platform.page_size;
fwd impl.map_file;
fwd impl.sync_file;

# files
fwd impl.read;
fwd impl.write;
fwd impl.read_at;
fwd impl.write_at;
fwd impl.open;
fwd open_native: impl.open;
fwd impl.close;
fwd impl.sync_fd;
fwd impl.stat;
fwd impl.set_mode;
fwd impl.set_mode_at;
fwd set_mode_at_native: impl.set_mode_at;
fwd impl.file_identity;
fwd impl.identity_at;
fwd identity_at_native: impl.identity_at;
fwd impl.retain_identity_at;
fwd retain_identity_at_native: impl.retain_identity_at;
fwd impl.publication_capabilities;
fwd impl.stat_path;
fwd stat_path_native: impl.stat_path;
fwd impl.stat_mode;
fwd impl.unlink;
fwd unlink_native: impl.unlink;
fwd impl.rename;
fwd rename_native: impl.rename;
fwd impl.symlink;
fwd symlink_native: impl.symlink;
fwd impl.make_dir;
fwd make_dir_native: impl.make_dir;
fwd impl.directory_init;
fwd impl.directory_next;
fwd impl.directory_close;
fwd impl.access;
fwd access_native: impl.access;
fwd impl.seek;
fwd impl.lock_fd;
fwd impl.pipe;
fwd impl.getcwd;
fwd getcwd_native: impl.getcwd;

# process
fwd impl.capture_process;
fwd impl.arguments;
fwd impl.argument_total;
fwd impl.terminate;
fwd impl.abort;
fwd impl.terminate_child;
fwd impl.spawn;
fwd impl.spawn_in;
fwd impl.spawn_redirected;
fwd impl.spawn_redirected_in;
fwd spawn_native:               impl.spawn;
fwd spawn_in_native:            impl.spawn_in;
fwd spawn_redirected_native:    impl.spawn_redirected;
fwd spawn_redirected_in_native: impl.spawn_redirected_in;
fwd impl.getpid;
fwd impl.ignore_sigpipe;
fwd impl.getenv;
fwd impl.environ;
fwd getenv_native:  impl.getenv;
fwd environ_native: impl.environ;
fwd impl.wait;
fwd impl.wait_pid;
fwd impl.ProcessStatus;
fwd impl.FileLimit;
fwd impl.LIMIT_UNLIMITED;
fwd impl.open_file_limit;
fwd impl.set_open_file_limit;
fwd impl.ProcessWaitError;
fwd impl.WaitResult;
fwd impl.PROCESS_OP_WAIT;
fwd impl.PROCESS_OP_STATUS;
fwd impl.PROCESS_OP_CLOSE;
fwd impl.PROCESS_OP_SPAWN;
fwd impl.PROCESS_OP_READ;
fwd impl.PROCESS_OP_PIPE;
fwd impl.PROCESS_OP_TERMINATE;
fwd impl.PROCESS_EXITED;
fwd impl.PROCESS_SIGNALED;
fwd impl.PROCESS_STOPPED;
fwd impl.PROCESS_CONTINUED;

# time and entropy
fwd impl.sleep;
fwd impl.clock_gettime;
fwd impl.random_fill;

# core
fwd impl.stack_bounds;
fwd errors.error_kind;
fwd platform.error_message;
