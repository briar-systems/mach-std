# code shared across all darwin ISA implementations
#
# contains types, constants, syscall wrappers, and all OS primitives that
# are identical across darwin architectures. arch-specific modules provide
# only page_size and pipe.

use std.types.size.usize;
use std.types.size.isize;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_starts_with;
use std.sync.atomic;

$if ($mach.build.os != $mach.os.darwin) {
    $error("std.system.os.darwin.shared: requires darwin target");
}

use os_shared: std.system.os.shared;
use ls: std.system.os.darwin.libsystem;

