pub val F_GETFD: i32 = 1;
pub val F_SETFD: i32 = 2;
pub val F_GETFL: i32 = 3;
pub val F_SETFL: i32 = 4;

pub val FD_CLOEXEC: i32 = 1;
pub val O_NONBLOCK: i32 = 4;

