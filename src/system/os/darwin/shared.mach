val SYS_MLOCK:            usize = 203;
val SYS_MUNLOCK:          usize = 204;
val SYS_EXECVE:           usize = 59;
val SYS_VFORK:            usize = 66;
val SYS_GETDIRENTRIES64:  usize = 344;
val SYS_GETPID:           usize = 20;
val SYS_KILL:             usize = 37;
val SYS___SYSCTL:         usize = 202;
