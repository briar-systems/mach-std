# abstract types and constants for the OS interface
#
# types here are target-independent. every OS implementation populates them.

use std.types.size.usize;
use std.types.bool.bool;

# seconds and nanoseconds from a clock source
# ---
# sec:  whole seconds
# nsec: nanoseconds within second [0, 999999999]
pub rec Timespec {
    sec:  i64;
    nsec: i64;
}

# native wait queue state owned by the portable completion runtime
pub rec IoQueue {
    handle: usize;
    wake: usize;
}

# independently qualified cooperative publication capabilities
pub val PUBLICATION_CLAIMS: i64 = 1;
pub val PUBLICATION_RETAIN_REPLACE: i64 = 2;
pub val PUBLICATION_READ_RETAIN_REPLACE: i64 = 4;

# seek whence
pub val SEEK_SET: i32 = 0;
pub val SEEK_CUR: i32 = 1;
pub val SEEK_END: i32 = 2;

# memory protection flags
pub val PROT_NONE:  u32 = 0b000;
pub val PROT_READ:  u32 = 0b001;
pub val PROT_WRITE: u32 = 0b010;
pub val PROT_EXEC:  u32 = 0b100;

# memory advisory hints
pub val ADVISE_NORMAL:     u32 = 0;
pub val ADVISE_RANDOM:     u32 = 1;
pub val ADVISE_SEQUENTIAL: u32 = 2;
pub val ADVISE_WILL_NEED:  u32 = 3;
pub val ADVISE_DONT_NEED:  u32 = 4;

# standard huge page sizes
pub val HUGE_2MB: usize = 2097152;
pub val HUGE_1GB: usize = 1073741824;

# heap region reserve size (256MB)
pub val HEAP_RESERVE: usize = 268435456;

# platform-agnostic sentinels
pub val NOT_FOUND: i64 = -1;

# a process state observation, with a full native windows exit code
pub val PROCESS_EXITED: u8 = 1;
pub val PROCESS_SIGNALED: u8 = 2;
pub val PROCESS_STOPPED: u8 = 3;
pub val PROCESS_CONTINUED: u8 = 4;

pub rec ProcessStatus {
    kind: u8;
    code: u32;
    signal: i32;
    core_dumped: bool;
}

pub val PROCESS_OP_WAIT: u8 = 1;
pub val PROCESS_OP_STATUS: u8 = 2;
pub val PROCESS_OP_CLOSE: u8 = 3;
pub val PROCESS_OP_SPAWN: u8 = 4;
pub val PROCESS_OP_READ: u8 = 5;
pub val PROCESS_OP_PIPE: u8 = 6;
pub val PROCESS_OP_TERMINATE: u8 = 7;

pub rec ProcessWaitError {
    code: i64;
    native_code: u32;
    operation: u8;
}

# pid is positive for an observation, zero for no event or an error
pub rec WaitResult {
    pid: i64;
    error: ProcessWaitError;
}

# native producers identify their own continued encoding before decoding
pub fun posix_status(raw: i32, continued: bool) ProcessStatus {
    if (continued) { ret ProcessStatus{kind: PROCESS_CONTINUED}; }
    val signal: i32 = raw & 0x7f;
    if (signal == 0) { ret ProcessStatus{kind: PROCESS_EXITED, code: ((raw >> 8) & 0xff)::u32}; }
    if (signal == 0x7f) { ret ProcessStatus{kind: PROCESS_STOPPED, signal: (raw >> 8) & 0xff}; }
    ret ProcessStatus{kind: PROCESS_SIGNALED, signal: signal, core_dumped: (raw & 0x80) != 0};
}

pub fun has_exited(status: ProcessStatus) bool {
    ret status.kind == PROCESS_EXITED;
}

pub fun exit_code(status: ProcessStatus) u32 {
    ret status.code;
}

pub fun was_signaled(status: ProcessStatus) bool {
    ret status.kind == PROCESS_SIGNALED;
}

pub fun term_signal(status: ProcessStatus) i32 {
    ret status.signal;
}

pub fun was_stopped(status: ProcessStatus) bool {
    ret status.kind == PROCESS_STOPPED;
}

pub fun stop_signal(status: ProcessStatus) i32 {
    ret status.signal;
}

pub fun was_continued(status: ProcessStatus) bool {
    ret status.kind == PROCESS_CONTINUED;
}

test "std.system.os.process_status: full exit values do not imply signals" {
    val values: [7]u32 = [7]u32{0, 1, 255, 256, 259, 0x10000, 0xc0000005};
    var i: usize = 0;
    for (i < 7) {
        val status: ProcessStatus = ProcessStatus{kind: PROCESS_EXITED, code: values[i]};
        if (!has_exited(status) || exit_code(status) != values[i]) { ret 1; }
        if (was_signaled(status) || was_stopped(status) || was_continued(status) || status.core_dumped) { ret 2; }
        i = i + 1;
    }
    if (has_exited(ProcessStatus{})) { ret 3; }
    ret 0;
}

test "std.system.os.process_status: posix exit signal stop and continuation stay distinct" {
    val exited: ProcessStatus = posix_status(255 << 8, 0);
    if (exited.kind != PROCESS_EXITED || exited.code != 255 || exited.signal != 0 || exited.core_dumped) { ret 1; }
    val signaled: ProcessStatus = posix_status(9, 0);
    if (signaled.kind != PROCESS_SIGNALED || signaled.code != 0 || signaled.signal != 9 || signaled.core_dumped) { ret 2; }
    val dumped: ProcessStatus = posix_status(11 | 0x80, 0);
    if (dumped.kind != PROCESS_SIGNALED || dumped.signal != 11 || !dumped.core_dumped) { ret 3; }
    val stopped: ProcessStatus = posix_status((17 << 8) | 0x7f, 0);
    if (stopped.kind != PROCESS_STOPPED || stopped.code != 0 || stopped.signal != 17 || stopped.core_dumped) { ret 4; }
    val continued: ProcessStatus = posix_status(0, 1);
    if (continued.kind != PROCESS_CONTINUED || continued.code != 0 || continued.signal != 0 || continued.core_dumped) { ret 5; }
    ret 0;
}
