# abstract types and constants for the OS interface
#
# types here are target-independent. every OS implementation populates them.

use std.runtime.native.view.Unit;
use std.sync.atomic;
use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;

# seconds and nanoseconds from a clock source
# ---
# sec:  whole seconds
# nsec: nanoseconds within second [0, 999999999]
pub rec Timespec {
    sec:  i64;
    nsec: i64;
}

# one buffer of a gather write, laid out as struct iovec on linux and darwin
# and as wasi's ciovec
# ---
# data:   start of the buffer
# length: its size in bytes
pub rec IoVector {
    data:   *u8;
    length: usize;
}

# native wait queue state owned by the portable completion runtime
# ---
# wake_pending: 1 from the first wake request until a poll harvests the posted
#               wake, so later requests in that window post nothing
#
# wake_pending is a word because a signal handler can wake the queue, and word
# atomics take no lock on any target
pub rec IoQueue {
    handle:       usize;
    wake:         usize;
    wake_pending: usize;
}

# whether this request must post the native wake: only the first since the
# last harvest does. a later request finds its work done by the collector that
# harvests the posted wake, because the collector clears the flag after taking
# the wake and before it looks for work
pub fun io_wake_claim(queue: *IoQueue) bool {
    var expected: usize = 0;
    ret atomic.cas_word(?queue.wake_pending, ?expected, 1);
}

# the posted wake was taken, or a claimed one could not be posted
pub fun io_wake_harvested(queue: *IoQueue) {
    atomic.store_word(?queue.wake_pending, 0);
}

# a registered readiness context carries its source id in the top 16 bits, the
# rest belongs to the source. a completion-port backend carries the id beside
# its context instead, so every native completion reports `source` either way
pub val IO_SOURCE_SHIFT: u64 = 48;

# the source id a registered readiness context carries
pub fun io_context_source(context: u64) u16 {
    ret (context >> IO_SOURCE_SHIFT)::u16;
}

# a readiness context for source from the source's own 48 low bits
pub fun io_source_context(source: u16, low: u64) u64 {
    ret (source::u64 << IO_SOURCE_SHIFT) | (low & ((1::u64 << IO_SOURCE_SHIFT) - 1));
}

# the per-thread block std installs for each thread it runs
#
# the implementation owns the block of every thread it spawns and installs it
# before the thread runs any std code. the runtime installs a static one for the
# main thread before main, unless a loader owns that thread's thread pointer
# (see OS-CONTRACT.md). its address identifies the thread while it lives.
# it is not general thread-local storage. on linux it shares an area with the
# thread's copy of the executable's thread-local template, at the thread
# pointer on x86_64 and just below it on aarch64, riscv64 and riscv32.
# ---
# self_addr:  the block's own address, written when it is installed. x86_64
#             linux reads the thread pointer through it (fs:[0]), as the psABI
#             has every thread control block do
# stack_low:  the lowest address of the thread's stack, recorded once where the
#             implementation keeps the bounds here
# stack_high: one past the highest usable address of the thread's stack, or 0
#             where the block records no bounds
pub rec ThreadBlock {
    self_addr:  usize;
    stack_low:  usize;
    stack_high: usize;
}

# the name is borrowed until the next cursor operation, including eof or failure
# ---
# name:      the entry's nul-terminated name
# length:    its length in bytes
# type_hint: the entry's type as a DT_* value (0 unknown, 1 fifo, 2 character
#            device, 4 directory, 6 block device, 8 regular, 10 symlink, 12 socket)
pub rec DirectoryEntry {
    name:      str;
    length:    usize;
    type_hint: u8;
}

# a whole path in native units, nul-terminated, as native_path gives it
# ---
# units: the path, borrowed from the UTF-8 input where that already is the
#        native name, owned otherwise
# size:  bytes owned, 0 when borrowed
pub rec NativePath {
    units: *Unit;
    size:  usize;
}

# a directory entry in native units, borrowed until the next cursor
# operation like a DirectoryEntry
# ---
# name:   the entry's nul-terminated name in std.runtime.native units
# length: its length in units
pub rec NativeEntry {
    name:      *Unit;
    length:    usize;
    type_hint: u8;
}

# initialization failure and failed duplicate cleanup remain independent
pub rec DirectoryInitResult {
    code:         i64;
    cleanup_code: i64;
}

# independently qualified cooperative publication capabilities
pub val PUBLICATION_CLAIMS:              i64 = 1;
pub val PUBLICATION_RETAIN_REPLACE:      i64 = 2;
pub val PUBLICATION_READ_RETAIN_REPLACE: i64 = 4;

# seek whence
pub val SEEK_SET: i32 = 0;
pub val SEEK_CUR: i32 = 1;
pub val SEEK_END: i32 = 2;

# memory protection flags
pub val PROT_NONE:  u32 = 0b000;
pub val PROT_READ:  u32 = 0b001;
pub val PROT_WRITE: u32 = 0b010;
pub val PROT_EXEC:  u32 = 0b100;

# memory advisory hints
pub val ADVISE_NORMAL:     u32 = 0;
pub val ADVISE_RANDOM:     u32 = 1;
pub val ADVISE_SEQUENTIAL: u32 = 2;
pub val ADVISE_WILL_NEED:  u32 = 3;
pub val ADVISE_DONT_NEED:  u32 = 4;

# standard huge page sizes
pub val HUGE_2MB: usize = 2097152;
pub val HUGE_1GB: usize = 1073741824;

# heap region reserve size (256MB)
pub val HEAP_RESERVE: usize = 268435456;

# a process state observation, with a full native windows exit code
pub val PROCESS_EXITED:    u8 = 1;
pub val PROCESS_SIGNALED:  u8 = 2;
pub val PROCESS_STOPPED:   u8 = 3;
pub val PROCESS_CONTINUED: u8 = 4;

# one observed change in a child's state
# ---
# kind:        which change it is, one of the PROCESS_* states above
# code:        the exit code when kind is PROCESS_EXITED, zero otherwise
# signal:      the terminating or stopping signal for PROCESS_SIGNALED and
#              PROCESS_STOPPED, zero otherwise
# core_dumped: whether a signaled child left a core dump
pub rec ProcessStatus {
    kind:        u8;
    code:        u32;
    signal:      i32;
    core_dumped: bool;
}

pub val PROCESS_OP_WAIT:      u8 = 1;
pub val PROCESS_OP_STATUS:    u8 = 2;
pub val PROCESS_OP_CLOSE:     u8 = 3;
pub val PROCESS_OP_SPAWN:     u8 = 4;
pub val PROCESS_OP_READ:      u8 = 5;
pub val PROCESS_OP_PIPE:      u8 = 6;
pub val PROCESS_OP_TERMINATE: u8 = 7;

# why a process wait or the release of a child's handle failed
# ---
# code:        the negated errno, zero when nothing failed
# native_code: the exact windows GetLastError, zero on posix
# operation:   the PROCESS_OP_* stage that failed
pub rec ProcessWaitError {
    code:        i64;
    native_code: u32;
    operation:   u8;
}

# the open-file limit. soft is the limit in force, hard its ceiling for an
# unprivileged raise, and ceiling the highest soft value this process may set,
# which the implementation fills and a set ignores
pub rec FileLimit {
    soft:    u64;
    hard:    u64;
    ceiling: u64;
}

# the locked-memory limit in bytes. soft is the limit in force and hard its
# ceiling for an unprivileged raise
pub rec MemoryLimit {
    soft: u64;
    hard: u64;
}

# a limit with no bound
pub val LIMIT_UNLIMITED: u64 = 0xffffffffffffffff;

# pid is positive for an observation, zero for no event or an error
pub rec WaitResult {
    pid:   i64;
    error: ProcessWaitError;
}

# the environment a spawn or exec hands its child, its entries in units T
# ---
# given:   a nil-terminated array of nul-terminated NAME=value entries in T,
#          passed as given. a nil array is not an environment and is refused
#          with EINVAL. it is the first case, so a zeroed environment is
#          refused rather than inherited
# inherit: this process's own environment in native units, with no
#          conversion: CreateProcessW's NULL environment on windows, the envp
#          the kernel gave the process on linux and darwin
pub tag EnvironmentOf[T]: u8 {
    given: **T;
    inherit;
}

# the environment of a UTF-8 spawn, its entries in UTF-8
pub def Environment: EnvironmentOf[u8];

# the environment of a native spawn, its entries in std.runtime.native units.
# on linux and darwin the units are bytes, so it is Environment itself
pub def NativeEnvironment: EnvironmentOf[Unit];

# native producers identify their own continued encoding before decoding
pub fun posix_status(raw: i32, continued: bool) ProcessStatus {
    if (continued) { ret ProcessStatus{kind: PROCESS_CONTINUED}; }
    val signal: i32 = raw & 0x7f;
    if (signal == 0)    { ret ProcessStatus{kind: PROCESS_EXITED, code: ((raw >> 8) & 0xff)::u32}; }
    if (signal == 0x7f) { ret ProcessStatus{kind: PROCESS_STOPPED, signal: (raw >> 8) & 0xff}; }
    ret ProcessStatus{kind: PROCESS_SIGNALED, signal: signal, core_dumped: (raw & 0x80) != 0};
}

test posix_status__exit_signal_stop_and_continuation_stay_distinct {
    val exited: ProcessStatus = posix_status(255 << 8, 0);
    if (exited.kind != PROCESS_EXITED || exited.code != 255 || exited.signal != 0 || exited.core_dumped) { ret 1; }
    val signaled: ProcessStatus = posix_status(9, 0);
    if (signaled.kind != PROCESS_SIGNALED || signaled.code != 0 || signaled.signal != 9 || signaled.core_dumped) { ret 2; }
    val dumped: ProcessStatus = posix_status(11 | 0x80, 0);
    if (dumped.kind != PROCESS_SIGNALED || dumped.signal != 11 || !dumped.core_dumped) { ret 3; }
    val stopped: ProcessStatus = posix_status((17 << 8) | 0x7f, 0);
    if (stopped.kind != PROCESS_STOPPED || stopped.code != 0 || stopped.signal != 17 || stopped.core_dumped) { ret 4; }
    val continued: ProcessStatus = posix_status(0, 1);
    if (continued.kind != PROCESS_CONTINUED || continued.code != 0 || continued.signal != 0 || continued.core_dumped) { ret 5; }
    ret 0;
}

# the posix temp directory: $TMPDIR as getenv found it, else "/tmp", under
# getenv's truncation contract
# ---
# found: getenv's result for TMPDIR, already copied into buf when it fit
# buf:   destination buffer for the path
# cap:   buffer capacity in bytes
# ret:   full length of the path
pub fun posix_temp_dir(found: i64, buf: *u8, cap: usize) i64 {
    if (found > 0) { ret found; }
    val fallback: str   = "/tmp";
    var i:        usize = 0;
    for (i + 1 < cap && fallback[i] != 0) {
        buf[i] = fallback[i];
        i      = i + 1;
    }
    if (i < cap) { buf[i] = 0; }
    ret 4;
}

# the bytes a scratch path may take, its nul included
#[testing]
pub val SCRATCH_CAP: usize = 1024;

# a path that names something in a scratch directory
#[testing]
pub def ScratchPath: [SCRATCH_CAP]u8;

# a scratch path in std.runtime.native units
#[testing]
pub def ScratchNative: [SCRATCH_CAP]Unit;

# a directory of one test process's own under the temp directory
# ---
# path:   the directory's nul-terminated path
# length: its length in bytes
#[testing]
pub rec Scratch {
    path:   ScratchPath;
    length: usize;
}

# the primitives a scratch directory is made with, one set per OS
# ---
# temp_dir:    the temp directory under its truncation contract
# random_fill: the entropy source
# make_dir:    the directory primitive, called on `here`
# mode:        the directory's mode
# here:        the working directory's descriptor, which an absolute path ignores
# exists:      the native code make_dir returns for a name that is taken
# too_long:    the native code for a temp directory with no room for the name
#[testing]
pub rec ScratchHost {
    temp_dir:    fun(*u8, usize) i64;
    random_fill: fun(*u8, usize) i64;
    make_dir:    fun(i32, *u8, i32) i64;
    mode:        i32;
    here:        i32;
    exists:      i64;
    too_long:    i64;
}

# make "<temp>/mach_std_<16 hex digits>", a name no other process holds,
# since a taken name is drawn again
# ---
# scratch: receives the directory's path
# host:    the OS's primitives
# ret:     zero, or a negative native code
#[testing]
pub fun scratch_create(scratch: *Scratch, host: ScratchHost) i64 {
    val prefix:  str   = "mach_std_";
    val hex:     str   = "0123456789abcdef";
    var attempt: usize = 0;
    for (attempt < 16) {
        val dir: i64 = host.temp_dir(?scratch.path[0], SCRATCH_CAP);
        if (dir < 0) { ret dir; }
        var at: usize = dir::usize;
        # a separator, the prefix, the digits and the nul
        if (at + 27 > SCRATCH_CAP) { ret host.too_long; }
        if (at == 0 || (scratch.path[at - 1] != '/' && scratch.path[at - 1] != scratch_separator())) {
            scratch.path[at] = scratch_separator();
            at               = at + 1;
        }
        var i: usize = 0;
        for (prefix[i] != 0) {
            scratch.path[at] = prefix[i];
            at               = at + 1;
            i                = i + 1;
        }
        var nonce:  [8]u8;
        val filled: i64 = host.random_fill(?nonce[0], 8);
        if (filled < 0) { ret filled; }
        i = 0;
        for (i < 8) {
            scratch.path[at]     = hex[(nonce[i] >> 4)::usize];
            scratch.path[at + 1] = hex[(nonce[i] & 15)::usize];
            at                   = at + 2;
            i                    = i + 1;
        }
        scratch.path[at] = 0;
        scratch.length   = at;
        val made: i64 = host.make_dir(host.here, ?scratch.path[0], host.mode);
        if (made != host.exists) { ret made; }
        attempt = attempt + 1;
    }
    ret host.exists;
}

# "<scratch><separator><leaf>" in out, or the empty string when it does not fit
# ---
# scratch: a made scratch directory
# leaf:    the name below it, which may hold further separators
# out:     the bytes the path is written to
# ret:     out as a string
#[testing]
pub fun scratch_path(scratch: *Scratch, leaf: str, out: *ScratchPath) str {
    val name: *u8   = out::*u8;
    var at:   usize = 0;
    for (at < scratch.length) {
        name[at] = scratch.path[at];
        at       = at + 1;
    }
    name[at] = scratch_separator();
    at       = at + 1;
    var i: usize = 0;
    for (leaf[i] != 0) {
        if (at + 1 >= SCRATCH_CAP) {
            name[0] = 0;
            ret name;
        }
        # one separator throughout, the host's own
        if (leaf[i] == '/') { name[at] = scratch_separator(); }
        or                  { name[at] = leaf[i]; }
        at = at + 1;
        i  = i + 1;
    }
    name[at] = 0;
    ret name;
}

# a scratch directory's own path as a string
#[testing]
pub fun scratch_dir(scratch: *Scratch) str {
    ret ?scratch.path[0];
}

#[testing]
fun scratch_separator() u8 {
    $if ($mach.build.sys == $mach.sys.windows) { ret '\\'; }
    $or                                        { ret '/'; }
}
