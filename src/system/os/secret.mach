# native primitives for secret-welded storage
#
# each primitive keeps the welded pointer shape across the native boundary.
# wiping, retrying, chunking and typed geometry are built on top of these in
# std.memory.secret. a negative return is a native code.
#
# every allocation is span usable bytes, the request rounded up to whole pages,
# between two inaccessible guard pages, so a run off either end faults. the
# span is locked against paging and, where the host can say so, kept out of
# core dumps:
#
#   linux    memfd_secret, which also removes the pages from the kernel's
#            direct map, or on a kernel without it an anonymous mapping with
#            mlock and MADV_DONTDUMP
#   darwin   mmap and mlock. xnu has no per-mapping dump exclusion
#   windows  VirtualAlloc and VirtualLock, the guards reserved and never
#            committed. windows has no per-allocation dump exclusion
#
# a host that refuses the lock (RLIMIT_MEMLOCK, the windows minimum working
# set) fails the allocation with Status.lock set. nothing is ever handed out
# unlocked on a host whose LOCKS is true.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.isize;
use std.types.size.usize;

val EIO:    i64 = -5;
val ENOMEM: i64 = -12;
val EINVAL: i64 = -22;

# the alignment every allocation starts on: the smallest page size any host has
pub val ALIGN: usize = 4096;

# how an allocation ended
# ---
# code: zero, or the negative native code of the step that failed
# lock: whether that step was the host refusing to lock the pages
pub rec Status {
    code: i64;
    lock: bool;
}

$if ($mach.build.sys == $mach.sys.linux) {
    use native:   std.system.os.linux;
    use platform: std.system.os.linux.shared;

    # every host std reaches locks secret pages. a host that cannot sets this
    # false, and std.memory.secret then serves it only to a program that
    # accepted unlocked storage
    pub val LOCKS: bool = true;

    $if ($mach.build.arch == $mach.arch.x86_64) {
        val SYS_MUNMAP:    usize = 11;
        val SYS_GETRANDOM: usize = 318;
    }
    $or ($mach.build.arch == $mach.arch.aarch64 || $mach.build.arch == $mach.arch.riscv64) {
        val SYS_MUNMAP:    usize = 215;
        val SYS_GETRANDOM: usize = 278;
    }
    $or {
        $error("std.system.os.secret: unsupported linux architecture");
    }

    fun native_unmap[T](base: *T, total: usize) i64 {
        val syscall_number: usize = SYS_MUNMAP;
        var out:            i64   = 0;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {syscall_number}
                mov rdi, {base}
                mov rsi, {total}
                syscall
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x8, {syscall_number}
                ldr x0, {base}
                ldr x1, {total}
                svc 0
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld a7, {syscall_number}
                ld a0, {base}
                ld a1, {total}
                ecall
                sd a0, {out}
            }
        }
        ret out;
    }

    fun linux_random_fill(context: ptr, data: *^u8, len: usize) i64 {
        val syscall_number: usize = SYS_GETRANDOM;
        var out:            i64   = 0;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {syscall_number}
                mov rdi, {data}
                mov rsi, {len}
                xor rdx, rdx
                syscall
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x8, {syscall_number}
                ldr x0, {data}
                ldr x1, {len}
                mov x2, 0
                svc 0
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld a7, {syscall_number}
                ld a0, {data}
                ld a1, {len}
                li a2, 0
                ecall
                sd a0, {out}
            }
        }
        ret out;
    }
}
$or ($mach.build.sys == $mach.sys.darwin) {
    use native:        std.system.os.darwin;
    use darwin_system: std.system.os.darwin.libsystem;
    use platform:      std.system.os.darwin.shared;

    pub val LOCKS: bool = true;

    #[library("libsystem")]
    ext fun getentropy(data: *^u8, len: usize) i32;

    #[naked]
    fun darwin_munmap[T](base: *T, total: usize) i32 {
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 { jmp _munmap }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 { b _munmap }
        }
    }

    fun native_unmap[T](base: *T, total: usize) i64 {
        if (darwin_munmap[T](base, total) != 0) { ret darwin_system.fail_errno(); }
        ret 0;
    }

    fun darwin_fill(data: *^u8, len: usize) i64 {
        if (getentropy(data, len) != 0) { ret darwin_system.fail_errno(); }
        ret len::i64;
    }

    # the native provider reports the kernel's own refusal: getentropy caps a
    # single request at 256 bytes, which is a real failure produced by the real
    # interface, not a scripted one. XNU answers it with EINVAL (the man page
    # borrows OpenBSD's EIO wording; the kernel does not, and the first native
    # run of this test proved it)
    test random_fill__darwin_reports_the_native_refusal_above_256_bytes {
        var data:    [300]^u8;
        val refused: i64 = random_fill(?data[0], 257);
        if (refused >= 0)                      { ret 1; }
        if (refused != EINVAL)                 { ret 2; }
        if (random_fill(?data[0], 256) != 256) { ret 3; }
        ret 0;
    }
}
$or ($mach.build.sys == $mach.sys.windows) {
    use native:   std.system.os.windows;
    use platform: std.system.os.windows.shared;

    pub val LOCKS: bool = true;

    #[library("bcrypt")]
    #[symbol("BCryptGenRandom")]
    ext fun windows_bcrypt_random(algorithm: isize, data: *^u8, len: u32, flags: u32) i32;

    #[naked]
    fun windows_free[T](base: *T, size: usize, free_type: u32) i32 {
        asm x86_64 { jmp VirtualFree }
    }

    # VirtualFree releases the whole reservation, guards included, from its base
    fun native_unmap[T](base: *T, total: usize) i64 {
        if (windows_free[T](base, 0, 0x8000) != 0) { ret 0; }
        ret platform.last_error();
    }
}

# the most bytes one random_fill call accepts
$if ($mach.build.sys == $mach.sys.darwin) {
    pub val RANDOM_FILL_MAX: usize = 256;
}
$or ($mach.build.sys == $mach.sys.windows) {
    pub val RANDOM_FILL_MAX: usize = 0xFFFFFFFF;
}
$or {
    pub val RANDOM_FILL_MAX: usize = 0xFFFFFFFFFFFFFFFF;
}

# the usable span an allocation of size bytes maps: size rounded up to whole
# pages. false for zero or a size whose span and guards overflow
fun span_of(size: usize, page: usize, span: *usize) bool {
    if (size == 0 || size > ~(0::usize) - 3 * page) { ret false; }
    @span = (size + page - 1) & ~(page - 1);
    ret true;
}

# fresh storage welded to T. it holds nothing yet, so no secret ever passes
# through the plain pointer
fun weld[T](data: ptr) *T {
    var out: *T = nil;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {data}
            mov {out}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x0, {data}
            str x0, {out}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {data}
            sd t0, {out}
        }
    }
    ret out;
}

# the leading guard page below an allocation, keeping its welded type, so the
# release names the whole mapping without an integer alias of the address
fun guard_of[T](data: *T, page: usize) *T {
    var out: *T = nil;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {data}
            sub rax, {page}
            mov {out}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x0, {data}
            ldr x1, {page}
            sub x0, x0, x1
            str x0, {out}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {data}
            ld t1, {page}
            sub t0, t0, t1
            sd t0, {out}
        }
    }
    ret out;
}

# allocate one zero-initialized secret-welded byte region
# ---
# size: number of addressable bytes, nonzero
# out:  receives the region, aligned to at least ALIGN, untouched on failure
# ret:  the outcome. EINVAL for zero size, ENOMEM for one too large to map
pub fun allocate(size: usize, out: **^u8) Status {
    ret allocate_typed[^u8](size, out);
}

# release a region allocate returned, without wiping it
# ---
# data: the region
# size: the size it was allocated with
# ret:  zero, or a negative native code with the region still owned
pub fun release(data: *^u8, size: usize) i64 {
    ret release_typed[^u8](data, size);
}

# allocate a zero-initialized region of total bytes typed as T, without
# changing T's secrecy shape
# ---
# total: region size in bytes, nonzero
# out:   receives the region, aligned to at least ALIGN, untouched on failure
# ret:   the outcome. EINVAL for zero total, ENOMEM for one too large to map
pub fun allocate_typed[T](total: usize, out: **T) Status {
    if (total == 0) { ret Status{code: EINVAL, lock: false}; }
    val page: usize = native.page_size();
    var span: usize = 0;
    if (!span_of(total, page, ?span)) { ret Status{code: ENOMEM, lock: false}; }
    var data:    ptr  = nil;
    var locking: bool = false;
    val code:    i64  = platform.map_secret(span, page, ?data, ?locking);
    if (code < 0) { ret Status{code: code, lock: locking}; }
    @out = weld[T](data);
    ret Status{code: 0, lock: false};
}

# release a region allocate_typed returned, without wiping it
# ---
# base:  the region
# total: the size in bytes it was allocated with
# ret:   zero, or a negative native code with the region still owned
pub fun release_typed[T](base: *T, total: usize) i64 {
    val page: usize = native.page_size();
    var span: usize = 0;
    if (base == nil || !span_of(total, page, ?span)) { ret EINVAL; }
    ret native_unmap[T](guard_of[T](base, page), span + 2 * page);
}

# fill part of a region from the operating-system csprng in one native call
# ---
# data: destination, at least len bytes
# len:  at most RANDOM_FILL_MAX
# ret:  bytes filled, which may be fewer than len, or a negative native code
pub fun random_fill(data: *^u8, len: usize) i64 {
    $if ($mach.build.sys == $mach.sys.linux) {
        ret linux_random_fill(nil, data, len);
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        ret darwin_fill(data, len);
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        if (windows_bcrypt_random(0, data, len::u32, 2) != 0) { ret EIO; }
        ret len::i64;
    }
}

# one positioned read into welded storage: the kernel writes it through this
# call and nothing else
# ---
# ret: bytes delivered (zero at end of file), or a negative native code
pub fun read_at(descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
    ret native_read_at(descriptor, data, len, offset);
}

# one positioned write from welded storage: the kernel reads it through this
# call and nothing else
# ---
# ret: bytes persisted, or a negative native code
pub fun write_at(descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
    ret native_write_at(descriptor, data, len, offset);
}

$if ($mach.build.sys == $mach.sys.linux) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        val SYS_PREAD64:  usize = 17;
        val SYS_PWRITE64: usize = 18;
    }
    $or ($mach.build.arch == $mach.arch.aarch64 || $mach.build.arch == $mach.arch.riscv64) {
        val SYS_PREAD64:  usize = 67;
        val SYS_PWRITE64: usize = 68;
    }

    fun linux_positioned(syscall_number: usize, descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        val fd:       usize = descriptor::isize::usize;
        val position: usize = offset::usize;
        var out:      i64   = 0;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {syscall_number}
                mov rdi, {fd}
                mov rsi, {data}
                mov rdx, {len}
                mov r10, {position}
                syscall
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x8, {syscall_number}
                ldr x0, {fd}
                ldr x1, {data}
                ldr x2, {len}
                ldr x3, {position}
                svc 0
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld a7, {syscall_number}
                ld a0, {fd}
                ld a1, {data}
                ld a2, {len}
                ld a3, {position}
                ecall
                sd a0, {out}
            }
        }
        ret out;
    }

    fun native_read_at(descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        ret linux_positioned(SYS_PREAD64, descriptor, data, len, offset);
    }

    fun native_write_at(descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        ret linux_positioned(SYS_PWRITE64, descriptor, data, len, offset);
    }
}
$or ($mach.build.sys == $mach.sys.darwin) {
    #[library("libsystem")]
    ext fun pread(fd: i32, buf: *^u8, count: usize, offset: i64) i64;

    #[library("libsystem")]
    ext fun pwrite(fd: i32, buf: *^u8, count: usize, offset: i64) i64;

    fun native_read_at(descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        val result: i64 = pread(descriptor, data, len, offset::i64);
        if (result < 0) { ret darwin_system.fail_errno(); }
        ret result;
    }

    fun native_write_at(descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        val result: i64 = pwrite(descriptor, data, len, offset::i64);
        if (result < 0) { ret darwin_system.fail_errno(); }
        ret result;
    }
}
$or ($mach.build.sys == $mach.sys.windows) {
    use windows_shared: std.system.os.windows.shared;

    # the OVERLAPPED block carries the file offset; the handle is synchronous, so
    # the transfer completes inside the call and the event stays null
    rec PositionedOverlapped {
        internal:      usize;
        internal_high: usize;
        offset:        u32;
        offset_high:   u32;
        event:         isize;
    }

    val ERROR_HANDLE_EOF: u32 = 38;

    #[library("kernel32")]
    #[symbol("ReadFile")]
    ext fun windows_read_file(handle: isize, data: *^u8, count: u32, transferred: *u32, overlapped: *PositionedOverlapped) i32;

    #[library("kernel32")]
    #[symbol("WriteFile")]
    ext fun windows_write_file(handle: isize, data: *^u8, count: u32, transferred: *u32, overlapped: *PositionedOverlapped) i32;

    #[library("kernel32")]
    #[symbol("GetLastError")]
    ext fun windows_last_error() u32;

    fun windows_positioned(descriptor: i32, data: *^u8, len: usize, offset: u64, write: bool) i64 {
        if (len > 0xffffffff) { ret EINVAL; }
        var handle: isize = 0;
        var saved:  i64   = 0;
        val begun:  i64   = windows_shared.positioned_begin(descriptor, ?handle, ?saved);
        if (begun < 0) { ret begun; }
        var overlapped: PositionedOverlapped = PositionedOverlapped{
            internal:      0,
            internal_high: 0,
            offset:        (offset & 0xffffffff)::u32,
            offset_high:   (offset >> 32)::u32,
            event:         0,
        };
        var transferred: u32 = 0;
        var ok:          i32 = 0;
        if (write) { ok = windows_write_file(handle, data, len::u32, ?transferred, ?overlapped); }
        or         { ok = windows_read_file(handle, data, len::u32, ?transferred, ?overlapped); }
        var code: i64 = 0;
        if (ok == 0) {
            if (!write && windows_last_error() == ERROR_HANDLE_EOF) { transferred = 0; }
            or                                                      { code = windows_shared.last_error(); }
        }
        val ended: i64 = windows_shared.positioned_end(descriptor, handle, saved);
        if (code < 0)  { ret code; }
        if (ended < 0) { ret ended; }
        ret transferred::i64;
    }

    fun native_read_at(descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        ret windows_positioned(descriptor, data, len, offset, false);
    }

    fun native_write_at(descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        ret windows_positioned(descriptor, data, len, offset, true);
    }
}
