# portable operating-system primitives for secret-welded storage
#
# these functions preserve each welded pointer shape across every native
# boundary. they provide secrecy-typed ownership, not memory locking or
# protection from process dumps.

use std.types.size.isize;
use std.types.size.usize;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.sync.atomic;

val EIO:    i64 = -5;
val EINTR:  i64 = -4;
val EBADF:  i64 = -9;
val ENOMEM: i64 = -12;
val EFAULT: i64 = -14;
val EINVAL: i64 = -22;

val EINTR_MAX_RETRIES: usize = 8;
val TYPED_HEADER_WORDS: usize = 3;
val TYPED_HEADER_SIZE:  usize = TYPED_HEADER_WORDS * $size_of(usize);

def FillFun: fun(ptr, *^u8, usize) i64;
def ReleaseFun: fun(ptr, *^u8, usize) i64;

rec TypedAllocation[T] {
    base:  *T;
    total: usize;
    count: usize;
}

#[oblivious]
fun wipe(data: *^u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        data[i] = 0;
        i = i + 1;
    }
}

fun fill_all(context: ptr, data: *^u8, len: usize, max_chunk: usize,
    fill_fn: FillFun) i64 {
    if (len == 0) { ret 0; }
    if (data == nil) { ret EFAULT; }
    if (max_chunk == 0) {
        wipe(data, len);
        ret EINVAL;
    }

    var filled: usize = 0;
    var interruptions: usize = 0;
    for (filled < len) {
        var chunk: usize = len - filled;
        if (chunk > max_chunk) { chunk = max_chunk; }
        val count: i64 = fill_fn(context, ?data[filled], chunk);
        if (count == EINTR) {
            interruptions = interruptions + 1;
            if (interruptions >= EINTR_MAX_RETRIES) {
                wipe(data, len);
                ret EINTR;
            }
        }
        or {
            if (count < 0) {
                wipe(data, len);
                ret count;
            }
            if (count == 0 || count::usize > chunk) {
                wipe(data, len);
                ret EIO;
            }
            filled = filled + count::usize;
            interruptions = 0;
        }
    }
    ret 0;
}

fun release_all(context: ptr, data: *^u8, size: usize, release_fn: ReleaseFun) i64 {
    if (data == nil && size == 0) { ret 0; }
    if (data == nil || size == 0) { ret EINVAL; }
    wipe(data, size);
    ret release_fn(context, data, size);
}

fun wipe_typed[T](data: *T, count: usize) {
    val bytes: usize = $size_of(T) * count;
    var i: usize = 0;
    for (i < bytes) {
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {data}
                mov rcx, {i}
                add rax, rcx
                mov byte [rax], 0
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x0, {data}
                ldr x1, {i}
                add x0, x0, x1
                strb wzr, [x0]
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld t0, {data}
                ld t1, {i}
                add t0, t0, t1
                sb zero, 0(t0)
            }
        }
        i = i + 1;
    }
}

fun typed_total[T](count: usize, total: *usize, alignment: *usize) bool {
    if (count == 0 || $size_of(T) == 0) { ret false; }
    if (count > ~(0::usize) / $size_of(T)) { ret false; }

    var align: usize = $align_of(T);
    if (align < $size_of(usize)) { align = $size_of(usize); }
    val bytes: usize = $size_of(T) * count;
    if (bytes > ~(0::usize) - TYPED_HEADER_SIZE) { ret false; }
    val with_header: usize = bytes + TYPED_HEADER_SIZE;
    if (with_header > ~(0::usize) - (align - 1)) { ret false; }
    @total = with_header + align - 1;
    @alignment = align;
    ret true;
}

fun typed_aligned[T](data: *T, alignment: usize) bool {
    var remainder: usize = 1;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {data}
            mov rcx, {alignment}
            dec rcx
            and rax, rcx
            mov {remainder}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x0, {data}
            ldr x1, {alignment}
            sub x1, x1, 1
            and x0, x0, x1
            str x0, {remainder}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {data}
            ld t1, {alignment}
            addi t1, t1, -1
            and t0, t0, t1
            sd t0, {remainder}
        }
    }
    ret remainder == 0;
}

fun align_typed[T](base: *T, total: usize, alignment: usize, count: usize) *T {
    var out: *T = nil;
    val header: usize = TYPED_HEADER_SIZE;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {base}
            mov rcx, {alignment}
            mov rdx, {header}
            add rax, rdx
            mov r8, rcx
            dec r8
            add rax, r8
            neg rcx
            and rax, rcx
            mov r8, rax
            sub r8, rdx
            mov r9, {base}
            mov [r8], r9
            mov r9, {total}
            mov [r8 + 8], r9
            mov r9, {count}
            mov [r8 + 16], r9
            mov {out}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x0, {base}
            ldr x1, {alignment}
            ldr x2, {header}
            add x3, x0, x2
            sub x4, x1, 1
            add x3, x3, x4
            sub x4, xzr, x1
            and x3, x3, x4
            sub x4, x3, x2
            str x0, [x4]
            ldr x5, {total}
            str x5, [x4, 8]
            ldr x5, {count}
            str x5, [x4, 16]
            str x3, {out}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {base}
            ld t1, {alignment}
            ld t2, {header}
            add t3, t0, t2
            addi t4, t1, -1
            add t3, t3, t4
            sub t4, zero, t1
            and t3, t3, t4
            sub t4, t3, t2
            sd t0, 0(t4)
            ld t5, {total}
            sd t5, 8(t4)
            ld t5, {count}
            sd t5, 16(t4)
            sd t3, {out}
        }
    }
    ret out;
}

fun typed_allocation[T](data: *T) TypedAllocation[T] {
    var base: *T = nil;
    var total: usize = 0;
    var count: usize = 0;
    val header: usize = TYPED_HEADER_SIZE;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rax, {data}
            sub rax, {header}
            mov rcx, [rax]
            mov {base}, rcx
            mov rcx, [rax + 8]
            mov {total}, rcx
            mov rcx, [rax + 16]
            mov {count}, rcx
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            ldr x0, {data}
            ldr x1, {header}
            sub x0, x0, x1
            ldr x1, [x0]
            str x1, {base}
            ldr x1, [x0, 8]
            str x1, {total}
            ldr x1, [x0, 16]
            str x1, {count}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            ld t0, {data}
            ld t1, {header}
            sub t0, t0, t1
            ld t1, 0(t0)
            sd t1, {base}
            ld t1, 8(t0)
            sd t1, {total}
            ld t1, 16(t0)
            sd t1, {count}
        }
    }
    ret TypedAllocation[T]{base: base, total: total, count: count};
}

fun release_typed[T](context: ptr, data: *T, count: usize,
    release_fn: fun(ptr, *T, *T, usize) i64) i64 {
    if (data == nil && count == 0) { ret 0; }
    if (data == nil || count == 0 || $size_of(T) == 0) { ret EINVAL; }
    var expected_total: usize = 0;
    var alignment: usize = 0;
    if (!typed_total[T](count, ?expected_total, ?alignment) ||
        !typed_aligned[T](data, alignment)) { ret EINVAL; }
    val allocation: TypedAllocation[T] = typed_allocation[T](data);
    if (allocation.base == nil || allocation.total != expected_total ||
        allocation.count != count) { ret EINVAL; }
    wipe_typed[T](data, count);
    ret release_fn(context, data, allocation.base, allocation.total);
}

$if ($mach.build.os == $mach.os.linux) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        val SYS_MMAP:      usize = 9;
        val SYS_MUNMAP:    usize = 11;
        val SYS_GETRANDOM: usize = 318;
    }
    $or ($mach.build.arch == $mach.arch.aarch64 || $mach.build.arch == $mach.arch.riscv64) {
        val SYS_MMAP:      usize = 222;
        val SYS_MUNMAP:    usize = 215;
        val SYS_GETRANDOM: usize = 278;
    }
    $or {
        $error("std.system.os.secret: unsupported linux architecture");
    }

    fun linux_allocate(size: usize) *^u8 {
        val syscall_number: usize = SYS_MMAP;
        val protection: usize = 3;
        val flags: usize = 0x22;
        val descriptor: usize = (-1)::isize::usize;
        val error_floor: usize = (-4095)::isize::usize;
        var out: *^u8 = nil;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {syscall_number}
                xor rdi, rdi
                mov rsi, {size}
                mov rdx, {protection}
                mov r10, {flags}
                mov r8, {descriptor}
                xor r9, r9
                syscall
                cmp rax, {error_floor}
                jb 1f
                xor rax, rax
                1:
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x8, {syscall_number}
                mov x0, 0
                ldr x1, {size}
                ldr x2, {protection}
                ldr x3, {flags}
                ldr x4, {descriptor}
                mov x5, 0
                svc 0
                cmp x0, 0
                b.ge 1f
                mov x0, 0
                1:
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld a7, {syscall_number}
                li a0, 0
                ld a1, {size}
                ld a2, {protection}
                ld a3, {flags}
                ld a4, {descriptor}
                li a5, 0
                ecall
                bgez a0, 1f
                li a0, 0
                1:
                sd a0, {out}
            }
        }
        ret out;
    }

    fun linux_allocate_typed[T](size: usize) *T {
        val syscall_number: usize = SYS_MMAP;
        val protection: usize = 3;
        val flags: usize = 0x22;
        val descriptor: usize = (-1)::isize::usize;
        val error_floor: usize = (-4095)::isize::usize;
        var out: *T = nil;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {syscall_number}
                xor rdi, rdi
                mov rsi, {size}
                mov rdx, {protection}
                mov r10, {flags}
                mov r8, {descriptor}
                xor r9, r9
                syscall
                cmp rax, {error_floor}
                jb 1f
                xor rax, rax
                1:
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x8, {syscall_number}
                mov x0, 0
                ldr x1, {size}
                ldr x2, {protection}
                ldr x3, {flags}
                ldr x4, {descriptor}
                mov x5, 0
                svc 0
                cmp x0, 0
                b.ge 1f
                mov x0, 0
                1:
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld a7, {syscall_number}
                li a0, 0
                ld a1, {size}
                ld a2, {protection}
                ld a3, {flags}
                ld a4, {descriptor}
                li a5, 0
                ecall
                bgez a0, 1f
                li a0, 0
                1:
                sd a0, {out}
            }
        }
        ret out;
    }

    fun linux_deallocate(context: ptr, data: *^u8, size: usize) i64 {
        val syscall_number: usize = SYS_MUNMAP;
        var out: i64 = 0;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {syscall_number}
                mov rdi, {data}
                mov rsi, {size}
                syscall
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x8, {syscall_number}
                ldr x0, {data}
                ldr x1, {size}
                svc 0
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld a7, {syscall_number}
                ld a0, {data}
                ld a1, {size}
                ecall
                sd a0, {out}
            }
        }
        ret out;
    }

    fun linux_deallocate_typed[T](context: ptr, data: *T, base: *T,
        size: usize) i64 {
        val syscall_number: usize = SYS_MUNMAP;
        var out: i64 = 0;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {syscall_number}
                mov rdi, {base}
                mov rsi, {size}
                syscall
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x8, {syscall_number}
                ldr x0, {base}
                ldr x1, {size}
                svc 0
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld a7, {syscall_number}
                ld a0, {base}
                ld a1, {size}
                ecall
                sd a0, {out}
            }
        }
        ret out;
    }

    fun linux_random_fill(context: ptr, data: *^u8, len: usize) i64 {
        val syscall_number: usize = SYS_GETRANDOM;
        var out: i64 = 0;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {syscall_number}
                mov rdi, {data}
                mov rsi, {len}
                xor rdx, rdx
                syscall
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x8, {syscall_number}
                ldr x0, {data}
                ldr x1, {len}
                mov x2, 0
                svc 0
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld a7, {syscall_number}
                ld a0, {data}
                ld a1, {len}
                li a2, 0
                ecall
                sd a0, {out}
            }
        }
        ret out;
    }
}
$or ($mach.build.os == $mach.os.darwin) {
    use darwin_system: std.system.os.darwin.libsystem;

    #[library("libSystem")]
    ext fun calloc(count: usize, size: usize) *^u8;

    #[library("libSystem")]
    ext fun free(data: *^u8);

    #[library("libSystem")]
    ext fun getentropy(data: *^u8, len: usize) i32;
}
$or ($mach.build.os == $mach.os.windows) {
    #[library("kernel32.dll")] #[symbol("VirtualAlloc")]
    ext fun windows_allocate(address: ptr, size: usize, allocation_type: u32, protection: u32) *^u8;

    #[library("kernel32.dll")] #[symbol("VirtualFree")]
    ext fun windows_deallocate(data: *^u8, size: usize, free_type: u32) i32;

    #[library("bcrypt.dll")] #[symbol("BCryptGenRandom")]
    ext fun windows_bcrypt_random(algorithm: isize, data: *^u8, len: u32, flags: u32) i32;
}

$if ($mach.build.os == $mach.os.darwin) {
    #[naked]
    fun darwin_allocate_typed[T](count: usize, size: usize) *T {
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 { jmp _calloc }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 { b _calloc }
        }
    }

    #[naked]
    fun darwin_free_typed[T](data: *T) {
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 { jmp _free }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 { b _free }
        }
    }

    fun darwin_release(context: ptr, data: *^u8, size: usize) i64 {
        free(data);
        ret 0;
    }

    fun darwin_fill(context: ptr, data: *^u8, len: usize) i64 {
        if (getentropy(data, len) != 0) { ret darwin_system.fail_errno(); }
        ret len::i64;
    }

    fun darwin_release_typed[T](context: ptr, data: *T, base: *T,
        size: usize) i64 {
        darwin_free_typed[T](base);
        ret 0;
    }

    # the native provider reports the kernel's own refusal: getentropy caps a
    # single request at 256 bytes, which is a real failure produced by the real
    # interface, not a scripted one. XNU answers it with EINVAL (the man page
    # borrows OpenBSD's EIO wording; the kernel does not, and the first native
    # run of this test proved it). the ordinary entry never sends more than 256
    # at a time, so this is the only way to observe the provider's errno path.
    test "std.system.os.secret.darwin: provider reports the native refusal above 256 bytes" {
        var data: [300]^u8;
        val refused: i64 = darwin_fill(nil, ?data[0], 257);
        if (refused >= 0) { ret 1; }
        if (refused != EINVAL) { ret 2; }
        if (darwin_fill(nil, ?data[0], 256) != 256) { ret 3; }
        ret 0;
    }

    # a fill larger than one native chunk is delivered in full and is not all
    # zero, through the same chunking that the portable layer applies
    test "std.system.os.secret.darwin: multi-chunk fill delivers every byte" {
        val size: usize = 700;
        val data: *^u8 = allocate(size);
        if (data == nil) { ret 1; }
        if (all_zero[u8](data, size) == 0) { deallocate(data, size); ret 2; }
        if (random_fill(data, size) != 0) { deallocate(data, size); ret 3; }
        var nonzero: usize = 0;
        var i: usize = 0;
        for (i < size) {
            if (data[i]:>u8 != 0) { nonzero = nonzero + 1; }
            i = i + 1;
        }
        val released: i64 = deallocate(data, size);
        if (nonzero < size / 2) { ret 4; }
        if (released != 0) { ret 5; }
        ret 0;
    }
}
$or ($mach.build.os == $mach.os.windows) {
    #[naked]
    fun windows_allocate_native_typed[T](address: ptr, size: usize,
        allocation_type: u32, protection: u32) *T {
        asm x86_64 { jmp VirtualAlloc }
    }

    #[naked]
    fun windows_deallocate_native_typed[T](data: *T, size: usize,
        free_type: u32) i32 {
        asm x86_64 { jmp VirtualFree }
    }

    fun windows_release(context: ptr, data: *^u8, size: usize) i64 {
        if (windows_deallocate(data, 0, 0x8000) != 0) { ret 0; }
        ret EIO;
    }

    fun windows_fill(context: ptr, data: *^u8, len: usize) i64 {
        if (windows_bcrypt_random(0, data, len::u32, 2) != 0) { ret EIO; }
        ret len::i64;
    }

    fun windows_release_typed[T](context: ptr, data: *T, base: *T,
        size: usize) i64 {
        if (windows_deallocate_native_typed[T](base, 0, 0x8000) != 0) { ret 0; }
        ret EIO;
    }
}
$or ($mach.build.os == $mach.os.linux) {
}
$or {
    $error("std.system.os.secret: unsupported target");
}

# allocate one zero-initialized secret-welded byte region
# ---
# size: number of addressable bytes
# ret:  logical span owner, or nil for zero size or failure
pub fun allocate(size: usize) *^u8 {
    if (size == 0) { ret nil; }
    $if ($mach.build.os == $mach.os.linux) {
        ret linux_allocate(size);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        ret calloc(1, size);
    }
    $or ($mach.build.os == $mach.os.windows) {
        ret windows_allocate(nil, size, 0x3000, 4);
    }
}

# release one secret-welded byte region
# ---
# data: allocation returned by allocate
# size: original nonzero allocation size
# ret:  zero after wipe and release, or a negative error with zeroed ownership retained
pub fun deallocate(data: *^u8, size: usize) i64 {
    $if ($mach.build.os == $mach.os.linux) {
        ret release_all(nil, data, size, linux_deallocate);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        ret release_all(nil, data, size, darwin_release);
    }
    $or ($mach.build.os == $mach.os.windows) {
        ret release_all(nil, data, size, windows_release);
    }
}

# allocate a zero-initialized typed region without changing T's secrecy shape
# ---
# count: number of T values
# ret:   aligned typed owner, or nil for zero count, overflow, or failure
pub fun allocate_typed[T](count: usize) *T {
    var total: usize = 0;
    var alignment: usize = 0;
    if (!typed_total[T](count, ?total, ?alignment)) { ret nil; }

    var base: *T = nil;
    $if ($mach.build.os == $mach.os.linux) {
        base = linux_allocate_typed[T](total);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        base = darwin_allocate_typed[T](1, total);
    }
    $or ($mach.build.os == $mach.os.windows) {
        base = windows_allocate_native_typed[T](nil, total, 0x3000, 4);
    }
    if (base == nil) { ret nil; }
    ret align_typed[T](base, total, alignment, count);
}

# wipe and release a typed region without changing T's secrecy shape
# ---
# data:  allocation returned by allocate_typed[T]
# count: original element count
# ret:   zero after release, or a negative error with wiped ownership retained
pub fun deallocate_typed[T](data: *T, count: usize) i64 {
    $if ($mach.build.os == $mach.os.linux) {
        ret release_typed[T](nil, data, count, linux_deallocate_typed[T]);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        ret release_typed[T](nil, data, count, darwin_release_typed[T]);
    }
    $or ($mach.build.os == $mach.os.windows) {
        ret release_typed[T](nil, data, count, windows_release_typed[T]);
    }
}

# initialize every requested byte from the operating-system csprng
# ---
# data: destination secret storage
# len:  number of bytes to initialize
# ret:  zero after complete initialization, or a negative error after a complete wipe
pub fun random_fill(data: *^u8, len: usize) i64 {
    if (len == 0) { ret 0; }
    if (data == nil) { ret EFAULT; }
    $if ($mach.build.os == $mach.os.linux) {
        ret fill_all(nil, data, len, 0xFFFFFFFFFFFFFFFF, linux_random_fill);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        ret fill_all(nil, data, len, 256, darwin_fill);
    }
    $or ($mach.build.os == $mach.os.windows) {
        ret fill_all(nil, data, len, 0xFFFFFFFF, windows_fill);
    }
}

# borrows: welded storage lent to a public integer handle
#
# a `*^u8` can never be erased to `ptr`, so no worker task, runtime source or
# cancellation registration (all `ptr` contexts) can carry one. a borrow is the
# boundary's answer: the owner lends its welded storage to this table and gets
# back an index-and-generation handle that is not an address, cannot be
# dereferenced, and unlocks only secret-to-secret copies, wipes and positioned
# kernel transfers. the native pointer leaves the process exactly once, in
# `borrow_read_at` and `borrow_write_at`, as the syscall or libSystem/kernel32
# argument the kernel reads or writes through. nothing here yields a `*u8`.
#
# the table is process-wide and typed: its entries hold `*^u8`, so it lives in
# its own secret-typed allocation and grows by doubling. the lock guards the
# table only; a handle's owner serializes its use against its close, the same
# way a descriptor's owner does.

pub rec Borrow {
    index:      u32;
    generation: u32;
}

rec BorrowEntry {
    data:       *^u8;
    size:       usize;
    generation: u32;
    used:       bool;
}

def PositionedFun: fun(ptr, i32, *^u8, usize, u64) i64;

val BORROW_INITIAL_CAPACITY: usize = 16;

var _borrow_entries:  *BorrowEntry = nil;
var _borrow_capacity: usize = 0;
var _borrow_lock:     i64 = 0;

fun borrow_lock() {
    var expected: i64 = 0;
    for (!atomic.cas(?_borrow_lock, ?expected, 1)) { expected = 0; }
}

fun borrow_unlock() {
    atomic.store(?_borrow_lock, 0);
}

#[oblivious]
fun copy_secret(destination: *^u8, source: *^u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        destination[i] = source[i];
        i = i + 1;
    }
}

fun borrow_grow() bool {
    var next: usize = BORROW_INITIAL_CAPACITY;
    if (_borrow_capacity != 0) {
        if (_borrow_capacity > ~(0::usize) / 2) { ret false; }
        next = _borrow_capacity * 2;
    }
    val fresh: *BorrowEntry = allocate_typed[BorrowEntry](next);
    if (fresh == nil) { ret false; }
    var i: usize = 0;
    for (i < _borrow_capacity) {
        fresh[i] = _borrow_entries[i];
        i = i + 1;
    }
    val previous: *BorrowEntry = _borrow_entries;
    val previous_capacity: usize = _borrow_capacity;
    _borrow_entries = fresh;
    _borrow_capacity = next;
    if (previous != nil) { deallocate_typed[BorrowEntry](previous, previous_capacity); }
    ret true;
}

fun borrow_entry_locked(borrow: Borrow) *BorrowEntry {
    if (borrow.index::usize >= _borrow_capacity) { ret nil; }
    val entry: *BorrowEntry = ?_borrow_entries[borrow.index::usize];
    if (!entry.used || entry.generation != borrow.generation) { ret nil; }
    ret entry;
}

# resolve a span inside a live borrow; the pointer is valid until the owner closes it
fun borrow_span(borrow: Borrow, offset: usize, len: usize, data: **^u8) i64 {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    if (entry == nil) {
        borrow_unlock();
        ret EBADF;
    }
    if (offset > entry.size || len > entry.size - offset) {
        borrow_unlock();
        ret EINVAL;
    }
    @data = ?entry.data[offset];
    borrow_unlock();
    ret 0;
}

# lend welded storage to a handle
# ---
# data: the storage, which stays owned by and valid for the caller until close
# size: nonzero span length
# out:  the handle
# ret:  zero, EFAULT for nil or empty storage, ENOMEM when the table cannot grow
pub fun borrow_open(data: *^u8, size: usize, out: *Borrow) i64 {
    if (out == nil) { ret EINVAL; }
    if (data == nil || size == 0) { ret EFAULT; }
    borrow_lock();
    var index: usize = 0;
    for (index < _borrow_capacity && _borrow_entries[index].used) { index = index + 1; }
    if (index == _borrow_capacity) {
        if (!borrow_grow()) {
            borrow_unlock();
            ret ENOMEM;
        }
    }
    val entry: *BorrowEntry = ?_borrow_entries[index];
    var generation: u32 = entry.generation + 1;
    if (generation == 0) { generation = 1; }
    entry.data = data;
    entry.size = size;
    entry.generation = generation;
    entry.used = true;
    borrow_unlock();
    @out = Borrow{index: index::u32, generation: generation};
    ret 0;
}

# return a borrow; the storage is neither wiped nor released, it was never owned
# ---
# ret: zero, or EBADF for a handle that is not live
pub fun borrow_close(borrow: Borrow) i64 {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    if (entry == nil) {
        borrow_unlock();
        ret EBADF;
    }
    entry.data = nil;
    entry.size = 0;
    entry.used = false;
    borrow_unlock();
    ret 0;
}

# the span length of a live borrow, or zero
pub fun borrow_size(borrow: Borrow) usize {
    borrow_lock();
    val entry: *BorrowEntry = borrow_entry_locked(borrow);
    var size: usize = 0;
    if (entry != nil) { size = entry.size; }
    borrow_unlock();
    ret size;
}

# zero a span of a borrow
# ---
# ret: zero, EBADF for a dead handle, EINVAL for a span outside the borrow
pub fun borrow_wipe(borrow: Borrow, offset: usize, len: usize) i64 {
    var data: *^u8 = nil;
    val resolved: i64 = borrow_span(borrow, offset, len, ?data);
    if (resolved < 0) { ret resolved; }
    wipe(data, len);
    ret 0;
}

# copy welded bytes into a span of a borrow
# ---
# source: welded storage the caller can read
# ret:    zero, EBADF, EINVAL for a span outside the borrow, EFAULT for a nil source
pub fun borrow_fill(borrow: Borrow, offset: usize, source: *^u8, len: usize) i64 {
    if (len == 0) { ret 0; }
    if (source == nil) { ret EFAULT; }
    var data: *^u8 = nil;
    val resolved: i64 = borrow_span(borrow, offset, len, ?data);
    if (resolved < 0) { ret resolved; }
    copy_secret(data, source, len);
    ret 0;
}

# copy welded bytes out of a span of a borrow
# ---
# destination: welded storage the caller owns
# ret:         zero, EBADF, EINVAL for a span outside the borrow, EFAULT for a nil destination
pub fun borrow_drain(borrow: Borrow, offset: usize, destination: *^u8, len: usize) i64 {
    if (len == 0) { ret 0; }
    if (destination == nil) { ret EFAULT; }
    var data: *^u8 = nil;
    val resolved: i64 = borrow_span(borrow, offset, len, ?data);
    if (resolved < 0) { ret resolved; }
    copy_secret(destination, data, len);
    ret 0;
}

# copy between two borrows without either pointer leaving the boundary
# ---
# ret: zero, EBADF for a dead handle, EINVAL for a span outside either borrow
pub fun borrow_copy(destination: Borrow, destination_offset: usize, source: Borrow, source_offset: usize, len: usize) i64 {
    if (len == 0) { ret 0; }
    var to: *^u8 = nil;
    val to_resolved: i64 = borrow_span(destination, destination_offset, len, ?to);
    if (to_resolved < 0) { ret to_resolved; }
    var from: *^u8 = nil;
    val from_resolved: i64 = borrow_span(source, source_offset, len, ?from);
    if (from_resolved < 0) { ret from_resolved; }
    copy_secret(to, from, len);
    ret 0;
}

# one positioned transfer with the interruption budget the fill path uses; the
# provider is the native call, and the storage stays untouched by this layer
# before, during and after it
fun positioned_all(context: ptr, descriptor: i32, data: *^u8, len: usize, offset: u64, native_fn: PositionedFun) i64 {
    var interruptions: usize = 0;
    for (interruptions < EINTR_MAX_RETRIES) {
        val result: i64 = native_fn(context, descriptor, data, len, offset);
        if (result != EINTR) { ret result; }
        interruptions = interruptions + 1;
    }
    ret EINTR;
}

fun positioned_span(borrow: Borrow, offset: usize, len: usize, file_offset: u64, data: **^u8) i64 {
    if (file_offset > 0x7fffffffffffffff) { ret EINVAL; }
    ret borrow_span(borrow, offset, len, data);
}

# read from a descriptor into a span of a borrow: the kernel writes the welded
# storage through this call and nothing else
# ---
# ret: bytes delivered (zero at end of file), or a negative error with the span unspecified
pub fun borrow_read_at(descriptor: i32, borrow: Borrow, offset: usize, len: usize, file_offset: u64) i64 {
    var data: *^u8 = nil;
    val resolved: i64 = positioned_span(borrow, offset, len, file_offset, ?data);
    if (resolved < 0) { ret resolved; }
    if (len == 0) { ret 0; }
    ret positioned_all(nil, descriptor, data, len, file_offset, native_read_at);
}

# write a span of a borrow to a descriptor: the kernel reads the welded storage
# through this call and nothing else
# ---
# ret: bytes persisted, or a negative error with nothing about the span changed
pub fun borrow_write_at(descriptor: i32, borrow: Borrow, offset: usize, len: usize, file_offset: u64) i64 {
    var data: *^u8 = nil;
    val resolved: i64 = positioned_span(borrow, offset, len, file_offset, ?data);
    if (resolved < 0) { ret resolved; }
    if (len == 0) { ret 0; }
    ret positioned_all(nil, descriptor, data, len, file_offset, native_write_at);
}

$if ($mach.build.os == $mach.os.linux) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        val SYS_PREAD64:  usize = 17;
        val SYS_PWRITE64: usize = 18;
    }
    $or ($mach.build.arch == $mach.arch.aarch64 || $mach.build.arch == $mach.arch.riscv64) {
        val SYS_PREAD64:  usize = 67;
        val SYS_PWRITE64: usize = 68;
    }

    fun linux_positioned(syscall_number: usize, descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        val fd: usize = descriptor::isize::usize;
        val position: usize = offset::usize;
        var out: i64 = 0;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            asm x86_64 {
                mov rax, {syscall_number}
                mov rdi, {fd}
                mov rsi, {data}
                mov rdx, {len}
                mov r10, {position}
                syscall
                mov {out}, rax
            }
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            asm aarch64 {
                ldr x8, {syscall_number}
                ldr x0, {fd}
                ldr x1, {data}
                ldr x2, {len}
                ldr x3, {position}
                svc 0
                str x0, {out}
            }
        }
        $or ($mach.build.arch == $mach.arch.riscv64) {
            asm riscv64 {
                ld a7, {syscall_number}
                ld a0, {fd}
                ld a1, {data}
                ld a2, {len}
                ld a3, {position}
                ecall
                sd a0, {out}
            }
        }
        ret out;
    }

    fun native_read_at(context: ptr, descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        ret linux_positioned(SYS_PREAD64, descriptor, data, len, offset);
    }

    fun native_write_at(context: ptr, descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        ret linux_positioned(SYS_PWRITE64, descriptor, data, len, offset);
    }
}
$or ($mach.build.os == $mach.os.darwin) {
    #[library("libSystem")]
    ext fun pread(fd: i32, buf: *^u8, count: usize, offset: i64) i64;

    #[library("libSystem")]
    ext fun pwrite(fd: i32, buf: *^u8, count: usize, offset: i64) i64;

    fun native_read_at(context: ptr, descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        val result: i64 = pread(descriptor, data, len, offset::i64);
        if (result < 0) { ret darwin_system.fail_errno(); }
        ret result;
    }

    fun native_write_at(context: ptr, descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        val result: i64 = pwrite(descriptor, data, len, offset::i64);
        if (result < 0) { ret darwin_system.fail_errno(); }
        ret result;
    }
}
$or ($mach.build.os == $mach.os.windows) {
    use windows_shared: std.system.os.windows.shared;

    # the OVERLAPPED block carries the file offset; the handle is synchronous, so
    # the transfer completes inside the call and the event stays null
    rec PositionedOverlapped {
        internal:      usize;
        internal_high: usize;
        offset:        u32;
        offset_high:   u32;
        event:         isize;
    }

    val ERROR_HANDLE_EOF: u32 = 38;

    #[library("kernel32.dll")] #[symbol("ReadFile")]
    ext fun windows_read_file(handle: isize, data: *^u8, count: u32, transferred: *u32, overlapped: *PositionedOverlapped) i32;

    #[library("kernel32.dll")] #[symbol("WriteFile")]
    ext fun windows_write_file(handle: isize, data: *^u8, count: u32, transferred: *u32, overlapped: *PositionedOverlapped) i32;

    #[library("kernel32.dll")] #[symbol("GetLastError")]
    ext fun windows_last_error() u32;

    fun windows_positioned(descriptor: i32, data: *^u8, len: usize, offset: u64, write: bool) i64 {
        if (len > 0xffffffff) { ret EINVAL; }
        var handle: isize = 0;
        var saved: i64 = 0;
        val begun: i64 = windows_shared.positioned_begin(descriptor, ?handle, ?saved);
        if (begun < 0) { ret begun; }
        var overlapped: PositionedOverlapped = PositionedOverlapped{
            internal: 0,
            internal_high: 0,
            offset: (offset & 0xffffffff)::u32,
            offset_high: (offset >> 32)::u32,
            event: 0,
        };
        var transferred: u32 = 0;
        var ok: i32 = 0;
        if (write) { ok = windows_write_file(handle, data, len::u32, ?transferred, ?overlapped); }
        or { ok = windows_read_file(handle, data, len::u32, ?transferred, ?overlapped); }
        var code: i64 = 0;
        if (ok == 0) {
            if (!write && windows_last_error() == ERROR_HANDLE_EOF) { transferred = 0; }
            or { code = windows_shared.last_error(); }
        }
        val ended: i64 = windows_shared.positioned_end(descriptor, handle, saved);
        if (code < 0) { ret code; }
        if (ended < 0) { ret ended; }
        ret transferred::i64;
    }

    fun native_read_at(context: ptr, descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        ret windows_positioned(descriptor, data, len, offset, false);
    }

    fun native_write_at(context: ptr, descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
        ret windows_positioned(descriptor, data, len, offset, true);
    }
}

# generic fixtures instantiate only in test builds
rec FillScript {
    results: [4]i64;
    len:     usize;
    next:    usize;
    byte:    u8;
}

fun scripted_fill[T](context: ptr, data: *^u8, len: usize) i64 {
    val script: *FillScript = context::*FillScript;
    if (script.next >= script.len) { ret EIO; }
    val result: i64 = script.results[script.next];
    script.next = script.next + 1;
    if (result > 0) {
        var count: usize = result::usize;
        if (count > len) { count = len; }
        var i: usize = 0;
        for (i < count) {
            data[i] = script.byte;
            i = i + 1;
        }
    }
    ret result;
}

fun all_zero[T](data: *^u8, len: usize) i64 {
    var i: usize = 0;
    for (i < len) {
        if (data[i]:>u8 != 0) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

rec InterruptProbe {
    calls: usize;
    byte:  u8;
}

fun reset_probe_fill[T](context: ptr, data: *^u8, len: usize) i64 {
    val probe: *InterruptProbe = context::*InterruptProbe;
    probe.calls = probe.calls + 1;
    if (probe.calls == EINTR_MAX_RETRIES ||
        probe.calls == EINTR_MAX_RETRIES * 2) {
        data[0] = probe.byte;
        ret 1;
    }
    ret EINTR;
}

fun interrupted_fill[T](context: ptr, data: *^u8, len: usize) i64 {
    val probe: *InterruptProbe = context::*InterruptProbe;
    probe.calls = probe.calls + 1;
    ret EINTR;
}

rec ReleaseProbe {
    calls:    usize;
    saw_zero: i64;
    result:   i64;
}

fun probe_release[T](context: ptr, data: *^u8, size: usize) i64 {
    val probe: *ReleaseProbe = context::*ReleaseProbe;
    probe.calls = probe.calls + 1;
    probe.saw_zero = all_zero[T](data, size);
    ret probe.result;
}

test "std.system.os.secret: lifecycle preserves welded storage" {
    if (allocate(0) != nil) { ret 1; }
    if (deallocate(nil, 0) != 0) { ret 1; }
    if (deallocate(nil, 1) != EINVAL) { ret 1; }
    if (random_fill(nil, 0) != 0) { ret 1; }
    if (random_fill(nil, 1) != EFAULT) { ret 1; }

    val size: usize = 513;
    val data: *^u8 = allocate(size);
    if (data == nil) { ret 1; }
    var failed: i64 = 0;
    if (all_zero[u8](data, size) == 0) { failed = 1; }
    if (deallocate(data, 0) != EINVAL) {
        failed = 1;
    }
    data[0] = 0xA5;
    data[size - 1] = 0x5A;
    if (data[0]:>u8 != 0xA5 || data[size - 1]:>u8 != 0x5A) {
        failed = 1;
    }
    if (random_fill(data, size) != 0) {
        failed = 1;
    }
    if (deallocate(data, size) != 0) { ret 1; }
    ret failed::i32;
}

test "std.system.os.secret: fill retries partial and interrupted providers" {
    var data: [4]^u8 = [4]^u8{ 0, 0, 0, 0 };
    var script: FillScript = FillScript{
        results: [4]i64{ EINTR, 2, 2, 0 }, len: 3, next: 0, byte: 0xA5,
    };
    if (fill_all(?script, ?data[0], 4, 4, scripted_fill[u8]) != 0) { ret 1; }
    if (script.next != 3) { ret 1; }
    var i: usize = 0;
    for (i < 4) {
        if (data[i]:>u8 != 0xA5) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "std.system.os.secret: fill resets its interruption budget after progress" {
    var data: [2]^u8 = [2]^u8{ 0, 0 };
    var probe: InterruptProbe = InterruptProbe{calls: 0, byte: 0xA5};
    if (fill_all(?probe, ?data[0], 2, 2, reset_probe_fill[u8]) != 0) { ret 1; }
    if (probe.calls != EINTR_MAX_RETRIES * 2) { ret 1; }
    if (data[0]:>u8 != 0xA5 || data[1]:>u8 != 0xA5) { ret 1; }
    ret 0;
}

test "std.system.os.secret: fill bounds repeated interruptions and wipes" {
    var data: [4]^u8 = [4]^u8{ 0xA5, 0xA5, 0xA5, 0xA5 };
    var probe: InterruptProbe = InterruptProbe{calls: 0, byte: 0};
    if (fill_all(?probe, ?data[0], 4, 4, interrupted_fill[u8]) != EINTR) { ret 1; }
    if (probe.calls != EINTR_MAX_RETRIES) { ret 1; }
    if (all_zero[u8](?data[0], 4) == 0) { ret 1; }
    ret 0;
}

test "std.system.os.secret: fill failures wipe the complete destination" {
    var data: [4]^u8 = [4]^u8{ 0xA5, 0xA5, 0xA5, 0xA5 };
    var failed: FillScript = FillScript{
        results: [4]i64{ 2, EIO, 0, 0 }, len: 2, next: 0, byte: 0x5A,
    };
    if (fill_all(?failed, ?data[0], 4, 4, scripted_fill[u8]) != EIO ||
        all_zero[u8](?data[0], 4) == 0) { ret 1; }

    data = [4]^u8{ 0xA5, 0xA5, 0xA5, 0xA5 };
    var stalled: FillScript = FillScript{
        results: [4]i64{ 0, 0, 0, 0 }, len: 1, next: 0, byte: 0x5A,
    };
    if (fill_all(?stalled, ?data[0], 4, 4, scripted_fill[u8]) != EIO ||
        all_zero[u8](?data[0], 4) == 0) { ret 1; }

    data = [4]^u8{ 0xA5, 0xA5, 0xA5, 0xA5 };
    var oversized: FillScript = FillScript{
        results: [4]i64{ 5, 0, 0, 0 }, len: 1, next: 0, byte: 0x5A,
    };
    if (fill_all(?oversized, ?data[0], 4, 4, scripted_fill[u8]) != EIO ||
        all_zero[u8](?data[0], 4) == 0) { ret 1; }
    ret 0;
}

test "std.system.os.secret: release wipes before success or failure" {
    var data: [4]^u8 = [4]^u8{ 0xA5, 0xA5, 0xA5, 0xA5 };
    var failed: ReleaseProbe = ReleaseProbe{calls: 0, saw_zero: 0, result: EIO};
    if (release_all(?failed, ?data[0], 4, probe_release[u8]) != EIO ||
        failed.calls != 1 || failed.saw_zero == 0 || all_zero[u8](?data[0], 4) == 0) {
        ret 1;
    }

    data = [4]^u8{ 0x5A, 0x5A, 0x5A, 0x5A };
    var succeeded: ReleaseProbe = ReleaseProbe{calls: 0, saw_zero: 0, result: 0};
    if (release_all(?succeeded, ?data[0], 4, probe_release[u8]) != 0 ||
        succeeded.calls != 1 || succeeded.saw_zero == 0) { ret 1; }
    ret 0;
}

# generic fixtures instantiate only in test builds
rec TypedSecretLeaf {
    value: ^u64;
}

rec TypedSecretRecord {
    public: u64;
    nested: TypedSecretLeaf;
}

#[align(8192)]
rec OverAlignedSecretRecord {
    public: u64;
    secret: ^u64;
}

rec TypedReleaseProbe {
    calls:    usize;
    saw_zero: bool;
    result:   i64;
}

fun probe_typed_release[T](context: ptr, data: *TypedSecretRecord,
    base: *TypedSecretRecord, size: usize) i64 {
    val probe: *TypedReleaseProbe = context::*TypedReleaseProbe;
    probe.calls = probe.calls + 1;
    probe.saw_zero = data[0].public == 0 && data[0].nested.value:>u64 == 0 &&
        data[1].public == 0 && data[1].nested.value:>u64 == 0;
    ret probe.result;
}

test "std.system.os.secret: typed allocation preserves public and direct secret shapes" {
    val public: *u64 = allocate_typed[u64](3);
    if (public == nil) { ret 1; }
    var failed: i64 = 0;
    var i: usize = 0;
    for (i < 3) {
        if (public[i] != 0) { failed = 1; }
        public[i] = i + 1;
        i = i + 1;
    }
    if (deallocate_typed[u64](public, 3) != 0) { ret 1; }

    val direct: *^u64 = allocate_typed[^u64](3);
    if (direct == nil) { ret 1; }
    i = 0;
    for (i < 3) {
        if (direct[i]:>u64 != 0) { failed = 1; }
        direct[i] = 12;
        i = i + 1;
    }
    if (deallocate_typed[^u64](direct, 3) != 0) { ret 1; }
    ret failed::i32;
}

test "std.system.os.secret: deeply secret typed allocation is aligned and zeroed" {
    val data: *TypedSecretRecord = allocate_typed[TypedSecretRecord](2);
    if (data == nil || !typed_aligned[TypedSecretRecord](data,
        $align_of(TypedSecretRecord))) { ret 1; }
    var i: usize = 0;
    for (i < 2) {
        if (data[i].public != 0 || data[i].nested.value:>u64 != 0) { ret 1; }
        data[i].public = i + 21;
        data[i].nested.value = 32;
        i = i + 1;
    }
    ret deallocate_typed[TypedSecretRecord](data, 2)::i32;
}

test "std.system.os.secret: explicit typed alignment is honored" {
    val data: *OverAlignedSecretRecord =
        allocate_typed[OverAlignedSecretRecord](2);
    if (data == nil || !typed_aligned[OverAlignedSecretRecord](data, 8192)) {
        ret 1;
    }
    if (data[0].public != 0 || data[0].secret:>u64 != 0 ||
        data[1].public != 0 || data[1].secret:>u64 != 0) { ret 1; }
    data[1].public = 41;
    data[1].secret = 42;
    ret deallocate_typed[OverAlignedSecretRecord](data, 2)::i32;
}

test "std.system.os.secret: typed geometry rejects empty and overflowing owners" {
    if (allocate_typed[u64](0) != nil) { ret 1; }
    if (deallocate_typed[u64](nil, 0) != 0) { ret 1; }
    if (deallocate_typed[u64](nil, 1) != EINVAL) { ret 1; }
    if (allocate_typed[u64](~(0::usize) / $size_of(u64) + 1) != nil) {
        ret 1;
    }
    if (allocate_typed[u8](~(0::usize)) != nil) { ret 1; }
    ret 0;
}

test "std.system.os.secret: typed release validates count and retains wiped failures" {
    val data: *TypedSecretRecord = allocate_typed[TypedSecretRecord](2);
    if (data == nil) { ret 1; }
    data[0].public = 51;
    data[0].nested.value = 52;
    data[1].public = 53;
    data[1].nested.value = 54;

    if (deallocate_typed[TypedSecretRecord](data, 1) != EINVAL) { ret 2; }
    if (data[0].public != 51 || data[0].nested.value:>u64 != 52 ||
        data[1].public != 53 || data[1].nested.value:>u64 != 54) { ret 3; }

    var probe: TypedReleaseProbe = TypedReleaseProbe{
        calls: 0, saw_zero: false, result: EIO,
    };
    if (release_typed[TypedSecretRecord](?probe, data, 2,
        probe_typed_release[u8]) != EIO) { ret 4; }
    if (probe.calls != 1) { ret 5; }
    if (!probe.saw_zero) { ret 6; }
    if (data[0].public != 0 || data[0].nested.value:>u64 != 0 ||
        data[1].public != 0 || data[1].nested.value:>u64 != 0) { ret 7; }
    ret deallocate_typed[TypedSecretRecord](data, 2)::i32;
}

# generic fixtures instantiate only in test builds
rec PositionedProbe {
    calls:       usize;
    descriptor:  i32;
    len:         usize;
    offset:      u64;
    saw_pattern: bool;
    byte:        u8;
    result:      i64;
    interrupt:   usize;
}

fun probe_positioned[T](context: ptr, descriptor: i32, data: *^u8, len: usize, offset: u64) i64 {
    val probe: *PositionedProbe = context::*PositionedProbe;
    probe.calls = probe.calls + 1;
    probe.descriptor = descriptor;
    probe.len = len;
    probe.offset = offset;
    if (probe.calls <= probe.interrupt) { ret EINTR; }
    var i: usize = 0;
    probe.saw_pattern = true;
    for (i < len) {
        if (data[i]:>u8 != probe.byte) { probe.saw_pattern = false; }
        i = i + 1;
    }
    ret probe.result;
}

fun borrow_all_zero[T](borrow: Borrow, offset: usize, len: usize) i64 {
    var data: *^u8 = nil;
    if (borrow_span(borrow, offset, len, ?data) < 0) { ret EBADF; }
    ret all_zero[T](data, len);
}

fun fill_pattern[T](data: *^u8, len: usize, byte: u8) {
    var i: usize = 0;
    for (i < len) {
        data[i] = byte;
        i = i + 1;
    }
}

test "std.system.os.secret: borrows lend welded storage to handles that are not addresses" {
    var handle: Borrow;
    if (borrow_open(nil, 8, ?handle) != EFAULT) { ret 1; }
    var storage: [8]^u8;
    if (borrow_open(?storage[0], 0, ?handle) != EFAULT) { ret 2; }
    if (borrow_open(?storage[0], 8, nil) != EINVAL) { ret 3; }
    if (borrow_open(?storage[0], 8, ?handle) != 0) { ret 4; }
    if (borrow_size(handle) != 8) { ret 5; }
    fill_pattern[u8](?storage[0], 8, 0x5a);
    var mirror: [8]^u8;
    if (borrow_drain(handle, 0, ?mirror[0], 8) != 0) { ret 6; }
    var i: usize = 0;
    for (i < 8) { if (mirror[i]:>u8 != 0x5a) { ret 7; } i = i + 1; }
    fill_pattern[u8](?mirror[0], 8, 0xa5);
    if (borrow_fill(handle, 2, ?mirror[0], 4) != 0) { ret 8; }
    if (storage[1]:>u8 != 0x5a || storage[2]:>u8 != 0xa5 || storage[5]:>u8 != 0xa5 || storage[6]:>u8 != 0x5a) { ret 9; }
    if (borrow_fill(handle, 6, ?mirror[0], 4) != EINVAL) { ret 10; }
    if (borrow_drain(handle, 9, ?mirror[0], 0) != 0) { ret 11; }
    if (borrow_wipe(handle, 8, 1) != EINVAL) { ret 12; }
    if (borrow_wipe(handle, 2, 4) != 0) { ret 13; }
    if (borrow_all_zero[u8](handle, 2, 4) != 1) { ret 14; }
    if (borrow_all_zero[u8](handle, 0, 8) != 0) { ret 15; }
    if (borrow_close(handle) != 0) { ret 16; }
    if (borrow_close(handle) != EBADF) { ret 17; }
    if (borrow_size(handle) != 0) { ret 18; }
    if (borrow_wipe(handle, 0, 1) != EBADF) { ret 19; }
    if (borrow_fill(handle, 0, ?mirror[0], 1) != EBADF) { ret 20; }
    if (storage[0]:>u8 != 0x5a || storage[7]:>u8 != 0x5a) { ret 21; }
    ret 0;
}

test "std.system.os.secret: a returned borrow handle does not revive with its slot" {
    var first: [4]^u8;
    var second: [4]^u8;
    var stale: Borrow;
    if (borrow_open(?first[0], 4, ?stale) != 0) { ret 1; }
    if (borrow_close(stale) != 0) { ret 2; }
    var fresh: Borrow;
    if (borrow_open(?second[0], 4, ?fresh) != 0) { ret 3; }
    if (fresh.index == stale.index && fresh.generation == stale.generation) { ret 4; }
    if (borrow_wipe(stale, 0, 4) != EBADF) { ret 5; }
    fill_pattern[u8](?second[0], 4, 3);
    var mirror: [4]^u8;
    if (borrow_drain(stale, 0, ?mirror[0], 4) != EBADF) { ret 6; }
    if (borrow_drain(fresh, 0, ?mirror[0], 4) != 0) { ret 7; }
    if (mirror[3]:>u8 != 3) { ret 8; }
    if (borrow_close(fresh) != 0) { ret 9; }
    ret 0;
}

test "std.system.os.secret: the borrow table grows past its first extent" {
    val count: usize = BORROW_INITIAL_CAPACITY * 2 + 3;
    val storage: *^u8 = allocate(count);
    if (storage == nil) { ret 1; }
    var handles: [64]Borrow;
    if (count > 64) { deallocate(storage, count); ret 2; }
    var i: usize = 0;
    for (i < count) {
        storage[i] = (i + 1)::u8;
        if (borrow_open(?storage[i], 1, ?handles[i]) != 0) { deallocate(storage, count); ret 3; }
        i = i + 1;
    }
    var mirror: [1]^u8;
    i = 0;
    for (i < count) {
        if (borrow_drain(handles[i], 0, ?mirror[0], 1) != 0) { deallocate(storage, count); ret 4; }
        if (mirror[0]:>u8 != (i + 1)::u8) { deallocate(storage, count); ret 5; }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        if (borrow_close(handles[i]) != 0) { deallocate(storage, count); ret 6; }
        i = i + 1;
    }
    if (deallocate(storage, count) != 0) { ret 7; }
    ret 0;
}

test "std.system.os.secret: borrow copies move bytes between handles without a pointer" {
    var from_storage: [6]^u8;
    var to_storage: [6]^u8;
    fill_pattern[u8](?from_storage[0], 6, 0x11);
    fill_pattern[u8](?to_storage[0], 6, 0x22);
    var from: Borrow;
    var to: Borrow;
    if (borrow_open(?from_storage[0], 6, ?from) != 0) { ret 1; }
    if (borrow_open(?to_storage[0], 6, ?to) != 0) { ret 2; }
    if (borrow_copy(to, 1, from, 0, 3) != 0) { ret 3; }
    if (to_storage[0]:>u8 != 0x22 || to_storage[1]:>u8 != 0x11 || to_storage[3]:>u8 != 0x11 || to_storage[4]:>u8 != 0x22) { ret 4; }
    if (borrow_copy(to, 4, from, 0, 3) != EINVAL) { ret 5; }
    if (borrow_copy(to, 0, from, 4, 3) != EINVAL) { ret 6; }
    if (borrow_copy(to, 0, from, 0, 0) != 0) { ret 7; }
    if (borrow_close(from) != 0) { ret 8; }
    if (borrow_copy(to, 0, from, 0, 1) != EBADF) { ret 9; }
    if (borrow_close(to) != 0) { ret 10; }
    ret 0;
}

test "std.system.os.secret: positioned transfers retry interruptions and never touch the span" {
    var storage: [16]^u8;
    fill_pattern[u8](?storage[0], 16, 0x3c);
    var probe: PositionedProbe = PositionedProbe{
        calls: 0, descriptor: 0, len: 0, offset: 0, saw_pattern: false, byte: 0x3c, result: 5, interrupt: 3,
    };
    if (positioned_all(?probe, 7, ?storage[4], 9, 1024, probe_positioned[u8]) != 5) { ret 1; }
    if (probe.calls != 4 || probe.descriptor != 7 || probe.len != 9 || probe.offset != 1024) { ret 2; }
    if (!probe.saw_pattern) { ret 3; }
    var i: usize = 0;
    for (i < 16) { if (storage[i]:>u8 != 0x3c) { ret 4; } i = i + 1; }

    var exhausted: PositionedProbe = PositionedProbe{
        calls: 0, descriptor: 0, len: 0, offset: 0, saw_pattern: false, byte: 0x3c, result: 5, interrupt: EINTR_MAX_RETRIES * 2,
    };
    if (positioned_all(?exhausted, 7, ?storage[0], 16, 0, probe_positioned[u8]) != EINTR) { ret 5; }
    if (exhausted.calls != EINTR_MAX_RETRIES) { ret 6; }
    i = 0;
    for (i < 16) { if (storage[i]:>u8 != 0x3c) { ret 7; } i = i + 1; }

    var failing: PositionedProbe = PositionedProbe{
        calls: 0, descriptor: 0, len: 0, offset: 0, saw_pattern: false, byte: 0x3c, result: EBADF, interrupt: 0,
    };
    if (positioned_all(?failing, 7, ?storage[0], 16, 0, probe_positioned[u8]) != EBADF) { ret 8; }
    if (failing.calls != 1 || !failing.saw_pattern) { ret 9; }
    i = 0;
    for (i < 16) { if (storage[i]:>u8 != 0x3c) { ret 10; } i = i + 1; }
    ret 0;
}

test "std.system.os.secret: positioned transfers refuse dead handles and bad spans before the kernel" {
    var storage: [8]^u8;
    var handle: Borrow;
    if (borrow_open(?storage[0], 8, ?handle) != 0) { ret 1; }
    if (borrow_read_at(-1, handle, 4, 8, 0) != EINVAL) { ret 2; }
    if (borrow_write_at(-1, handle, 0, 9, 0) != EINVAL) { ret 3; }
    if (borrow_read_at(-1, handle, 0, 8, 0x8000000000000000) != EINVAL) { ret 4; }
    if (borrow_read_at(-1, handle, 0, 0, 0) != 0) { ret 5; }
    if (borrow_write_at(-1, handle, 8, 0, 0) != 0) { ret 6; }
    if (borrow_close(handle) != 0) { ret 7; }
    if (borrow_read_at(-1, handle, 0, 8, 0) != EBADF) { ret 8; }
    if (borrow_write_at(-1, handle, 0, 8, 0) != EBADF) { ret 9; }
    ret 0;
}
