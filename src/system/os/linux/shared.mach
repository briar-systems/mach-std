    val SYS_CLOCK_GETTIME: usize = 113;
    val SYS_MBIND:         usize = 235;
    val SYS_GET_MEMPOLICY: usize = 236;
    val SYS_OPENAT:        usize = 56;
    val SYS_MKDIRAT:       usize = 34;
    val SYS_NEWFSTATAT:    usize = 79;
