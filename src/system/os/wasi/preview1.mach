# the os contract over wasi preview 1
#
# every import below resolves from wasi_snapshot_preview1, the module the
# target's environment names. a call answers with an errno and writes its
# results through pointers.
#
# the preview has no working directory and no absolute paths: a path is always
# relative to a directory descriptor, and the host hands the program a set of
# preopened directories at known names. an absolute path, or a relative one
# against AT_FDCWD, which behaves as the root, is taken onto the preopen that
# holds its longest leading part. a preopen named "." or "/" holds everything
# no longer one does. a path under no preopen is ENOENT.
#
# threads, the io queue, sockets and cpu features are groups this row does not
# claim, so nothing here names them. everything the process group claims and
# the preview cannot do answers ENOTSUP: there is no spawn, wait, pid or
# open-file limit, and symlinks, locks, modes and file mappings stop there too.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use identities: std.system.file_identity;
use os_shared:  std.system.os.shared;
use std.system.os.wasi.shared;

$if ($mach.build.sys != $mach.sys.wasi) {
    $error("std.system.os.wasi.preview1: requires wasi target");
}

fwd os_shared.DirectoryEntry;
fwd os_shared.DirectoryInitResult;
fwd os_shared.ProcessStatus;
fwd os_shared.FileLimit;
fwd os_shared.LIMIT_UNLIMITED;
fwd os_shared.ProcessWaitError;
fwd os_shared.WaitResult;
fwd os_shared.Environment;
fwd os_shared.PROCESS_OP_WAIT;
fwd os_shared.PROCESS_OP_STATUS;
fwd os_shared.PROCESS_OP_CLOSE;
fwd os_shared.PROCESS_OP_SPAWN;
fwd os_shared.PROCESS_OP_READ;
fwd os_shared.PROCESS_OP_PIPE;
fwd os_shared.PROCESS_OP_TERMINATE;
fwd os_shared.PROCESS_EXITED;
fwd os_shared.PROCESS_SIGNALED;
fwd os_shared.PROCESS_STOPPED;
fwd os_shared.PROCESS_CONTINUED;

# a scatter or gather element
rec Iovec {
    buf: *u8;
    len: usize;
}

# a preopen's description
rec Prestat {
    kind:     u32;
    name_len: usize;
}

# a descriptor's state
rec Fdstat {
    filetype:          u8;
    flags:             u16;
    rights_base:       u64;
    rights_inheriting: u64;
}

# a file's attributes
rec Filestat {
    dev:      u64;
    ino:      u64;
    filetype: u8;
    nlink:    u64;
    size:     u64;
    atim:     u64;
    mtim:     u64;
    ctim:     u64;
}

# a directory entry's fixed part, the name right after it
rec Dirent {
    next:   u64;
    ino:    u64;
    namlen: u32;
    kind:   u8;
}

# a clock subscription of poll_oneoff, its tag widened to the union's alignment
rec Subscription {
    userdata:  u64;
    tag:       u64;
    clock:     u32;
    timeout:   u64;
    precision: u64;
    flags:     u16;
}

rec Event {
    userdata: u64;
    errno:    u16;
    kind:     u8;
    rest:     [2]u64;
}

ext fun args_get(argv: **u8, buf: *u8) i32;
ext fun args_sizes_get(count: *usize, size: *usize) i32;
ext fun environ_get(environ: **u8, buf: *u8) i32;
ext fun environ_sizes_get(count: *usize, size: *usize) i32;
ext fun clock_time_get(id: u32, precision: u64, time: *u64) i32;
ext fun fd_close(fd: i32) i32;
ext fun fd_fdstat_get(fd: i32, out: *Fdstat) i32;
ext fun fd_filestat_get(fd: i32, out: *Filestat) i32;
ext fun fd_pread(fd: i32, iovs: *Iovec, count: usize, offset: u64, done: *usize) i32;
ext fun fd_prestat_dir_name(fd: i32, name: *u8, len: usize) i32;
ext fun fd_prestat_get(fd: i32, out: *Prestat) i32;
ext fun fd_pwrite(fd: i32, iovs: *Iovec, count: usize, offset: u64, done: *usize) i32;
ext fun fd_read(fd: i32, iovs: *Iovec, count: usize, done: *usize) i32;
ext fun fd_readdir(fd: i32, buf: *u8, len: usize, cookie: u64, used: *usize) i32;
ext fun fd_seek(fd: i32, offset: i64, whence: u32, out: *u64) i32;
ext fun fd_sync(fd: i32) i32;
ext fun fd_write(fd: i32, iovs: *Iovec, count: usize, done: *usize) i32;
ext fun path_create_directory(fd: i32, path: *u8, len: usize) i32;
ext fun path_filestat_get(fd: i32, flags: u32, path: *u8, len: usize, out: *Filestat) i32;
ext fun path_open(fd: i32, dirflags: u32, path: *u8, len: usize, oflags: u32, base: u64, inheriting: u64, fdflags: u32, out: *i32) i32;
ext fun path_remove_directory(fd: i32, path: *u8, len: usize) i32;
ext fun path_rename(old_fd: i32, old: *u8, old_len: usize, new_fd: i32, new: *u8, new_len: usize) i32;
ext fun path_symlink(old: *u8, old_len: usize, fd: i32, new: *u8, new_len: usize) i32;
ext fun path_unlink_file(fd: i32, path: *u8, len: usize) i32;
ext fun poll_oneoff(subscriptions: *Subscription, events: *Event, count: usize, done: *usize) i32;
ext fun proc_exit(code: u32);
ext fun random_get(buf: *u8, len: usize) i32;

val LOOKUP_FOLLOW: u32 = 1;

val OFLAGS_CREAT:     u32 = 1;
val OFLAGS_DIRECTORY: u32 = 2;
val OFLAGS_EXCL:      u32 = 4;
val OFLAGS_TRUNC:     u32 = 8;

val FDFLAGS_APPEND:   u32 = 1;
val FDFLAGS_NONBLOCK: u32 = 4;

val RIGHT_FD_DATASYNC:         u64 = 1 << 0;
val RIGHT_FD_READ:             u64 = 1 << 1;
val RIGHT_FD_SEEK:             u64 = 1 << 2;
val RIGHT_FD_FDSTAT_SET_FLAGS: u64 = 1 << 3;
val RIGHT_FD_SYNC:             u64 = 1 << 4;
val RIGHT_FD_TELL:             u64 = 1 << 5;
val RIGHT_FD_WRITE:            u64 = 1 << 6;
val RIGHT_FD_ADVISE:           u64 = 1 << 7;
val RIGHT_FD_ALLOCATE:         u64 = 1 << 8;
val RIGHT_FD_READDIR:          u64 = 1 << 14;
val RIGHT_FD_FILESTAT_GET:     u64 = 1 << 21;
val RIGHT_FD_FILESTAT_SIZE:    u64 = 1 << 22;
val RIGHT_FD_FILESTAT_TIMES:   u64 = 1 << 23;
val RIGHT_POLL_FD_READWRITE:   u64 = 1 << 27;

# what any open may ask for
val RIGHTS_COMMON: u64 = RIGHT_FD_SEEK | RIGHT_FD_TELL | RIGHT_FD_ADVISE | RIGHT_FD_FILESTAT_GET | RIGHT_FD_FILESTAT_TIMES
    | RIGHT_FD_FDSTAT_SET_FLAGS | RIGHT_FD_SYNC | RIGHT_FD_DATASYNC | RIGHT_POLL_FD_READWRITE;
val RIGHTS_READ:  u64 = RIGHT_FD_READ | RIGHT_FD_READDIR;
val RIGHTS_WRITE: u64 = RIGHT_FD_WRITE | RIGHT_FD_ALLOCATE | RIGHT_FD_FILESTAT_SIZE;
# bits 9 through 26 not named above: the path rights a directory passes on
val RIGHTS_PATH: u64 = 0x7FFFFFF ^ (0x3FF | RIGHT_FD_READDIR | RIGHT_FD_FILESTAT_GET | RIGHT_FD_FILESTAT_SIZE | RIGHT_FD_FILESTAT_TIMES);

val FILETYPE_DIRECTORY: u8 = 3;
val FILETYPE_REGULAR:   u8 = 4;
val FILETYPE_SYMLINK:   u8 = 7;

val ERRNO_BADF: i32 = 8;

# the attributes of a file as the contract's consumers read them
pub rec stat_t {
    st_dev:        u64;
    st_ino:        u64;
    st_mode:       u32;
    st_nlink:      u64;
    st_size:       i64;
    st_atime:      i64;
    st_atime_nsec: i64;
    st_mtime:      i64;
    st_mtime_nsec: i64;
    st_ctime:      i64;
    st_ctime_nsec: i64;
}

pub rec timespec {
    tv_sec:  i64;
    tv_nsec: i64;
}

val NANOSECONDS: u64 = 1000000000;

fun fill_stat(from: *Filestat, st: *stat_t) {
    var mode: u32 = 0o644;
    if (from.filetype == FILETYPE_DIRECTORY) { mode = shared.S_IFDIR | 0o755; }
    or (from.filetype == FILETYPE_REGULAR)   { mode = shared.S_IFREG | 0o644; }
    or (from.filetype == FILETYPE_SYMLINK)   { mode = shared.S_IFLNK | 0o777; }
    st.st_dev        = from.dev;
    st.st_ino        = from.ino;
    st.st_mode       = mode;
    st.st_nlink      = from.nlink;
    st.st_size       = from.size::i64;
    st.st_atime      = (from.atim / NANOSECONDS)::i64;
    st.st_atime_nsec = (from.atim % NANOSECONDS)::i64;
    st.st_mtime      = (from.mtim / NANOSECONDS)::i64;
    st.st_mtime_nsec = (from.mtim % NANOSECONDS)::i64;
    st.st_ctime      = (from.ctim / NANOSECONDS)::i64;
    st.st_ctime_nsec = (from.ctim % NANOSECONDS)::i64;
}

# one directory the host opened for the program
# ---
# fd:   its descriptor
# name: its name with any leading "/" and "./" gone, not terminated
# len:  the length of that name, 0 for the root
rec Preopen {
    fd:   i32;
    name: *u8;
    len:  usize;
}

var preopens:      *Preopen = nil;
var preopen_count: usize    = 0;
var preopens_read: bool     = false;

# read the preopens once, into one block sized by a first walk over them
fun read_preopens() {
    if (preopens_read) { ret; }
    preopens_read = true;
    var count: usize = 0;
    var names: usize = 0;
    var fd:    i32   = 3;
    for (true) {
        var p: Prestat;
        if (fd_prestat_get(fd, ?p) != 0) { brk; }
        count = count + 1;
        names = names + p.name_len;
        fd    = fd + 1;
    }
    if (count == 0) { ret; }
    val block: ptr = shared.allocate(count * $size_of(Preopen) + names);
    if (block == nil) { ret; }
    val table: *Preopen = block::*Preopen;
    var name:  *u8      = (block::usize + count * $size_of(Preopen))::*u8;
    var i:     usize    = 0;
    for (i < count) {
        var p:  Prestat;
        val at: i32 = 3 + i::i32;
        if (fd_prestat_get(at, ?p) != 0)                    { brk; }
        if (fd_prestat_dir_name(at, name, p.name_len) != 0) { brk; }
        var skip: usize = 0;
        for (skip < p.name_len) {
            if (name[skip] == '/')                                                      { skip = skip + 1; }
            or (name[skip] == '.' && (skip + 1 == p.name_len || name[skip + 1] == '/')) { skip = skip + 1; }
            or                                                                          { brk; }
        }
        var length: usize = p.name_len - skip;
        for (length > 0 && name[skip + length - 1] == '/') { length = length - 1; }
        table[i] = Preopen{fd: at, name: ?name[skip], len: length};
        name     = ?name[p.name_len];
        i        = i + 1;
    }
    preopens      = table;
    preopen_count = i;
}

# where a path lands: the directory it runs from and its rest
rec Located {
    code: i64;
    fd:   i32;
    path: *u8;
}

fun under(name: *u8, len: usize, path: *u8) bool {
    var i: usize = 0;
    for (i < len) {
        if (path[i] != name[i]) { ret false; }
        i = i + 1;
    }
    ret len == 0 || path[len] == 0 || path[len] == '/';
}

# find what a path names
# ---
# dir:  a directory descriptor, or AT_FDCWD
# path: the nul-terminated path
# ret:  the directory and the path relative to it, or code set
fun locate(dir: i32, path: *u8) Located {
    if (path == nil || path[0] == 0)              { ret Located{code: shared.ENOENT}; }
    if (dir != shared.AT_FDCWD && path[0] != '/') { ret Located{code: 0, fd: dir, path: path}; }
    read_preopens();
    var rest: *u8 = path;
    for (true) {
        if (rest[0] == '/')                   { rest = ?rest[1]; }
        or (rest[0] == '.' && rest[1] == '/') { rest = ?rest[2]; }
        or                                    { brk; }
    }
    var best: *Preopen = nil;
    var i:    usize    = 0;
    for (i < preopen_count) {
        val p: *Preopen = ?preopens[i];
        if (under(p.name, p.len, rest) && (best == nil || p.len >= best.len)) { best = p; }
        i = i + 1;
    }
    if (best == nil) { ret Located{code: shared.ENOENT}; }
    var tail: *u8 = ?rest[best.len];
    for (tail[0] == '/') { tail = ?tail[1]; }
    if (tail[0] == 0) { tail = "."; }
    ret Located{code: 0, fd: best.fd, path: tail};
}

pub fun read(fd: i32, buf: *u8, count: usize) i64 {
    var v:    Iovec = Iovec{buf: buf, len: count};
    var done: usize = 0;
    val e:    i32   = fd_read(fd, ?v, 1, ?done);
    if (e != 0) { ret shared.code(e); }
    ret done::i64;
}

pub fun write(fd: i32, buf: *u8, count: usize) i64 {
    var v:    Iovec = Iovec{buf: buf, len: count};
    var done: usize = 0;
    val e:    i32   = fd_write(fd, ?v, 1, ?done);
    if (e != 0) { ret shared.code(e); }
    ret done::i64;
}

pub fun read_at(fd: i32, buf: *u8, count: usize, offset: u64) i64 {
    var v:    Iovec = Iovec{buf: buf, len: count};
    var done: usize = 0;
    val e:    i32   = fd_pread(fd, ?v, 1, offset, ?done);
    if (e != 0) { ret shared.code(e); }
    ret done::i64;
}

pub fun write_at(fd: i32, buf: *u8, count: usize, offset: u64) i64 {
    var v:    Iovec = Iovec{buf: buf, len: count};
    var done: usize = 0;
    val e:    i32   = fd_pwrite(fd, ?v, 1, offset, ?done);
    if (e != 0) { ret shared.code(e); }
    ret done::i64;
}

# open a path, the rights asked for cut to what its directory may pass on
pub fun open(dirfd: i32, path: *u8, flags: i32, mode: i32) i64 {
    val at: Located = locate(dirfd, path);
    if (at.code != 0) { ret at.code; }

    var oflags: u32 = 0;
    if ((flags & shared.O_CREAT) != 0)     { oflags = oflags | OFLAGS_CREAT; }
    if ((flags & shared.O_DIRECTORY) != 0) { oflags = oflags | OFLAGS_DIRECTORY; }
    if ((flags & shared.O_EXCL) != 0)      { oflags = oflags | OFLAGS_EXCL; }
    if ((flags & shared.O_TRUNC) != 0)     { oflags = oflags | OFLAGS_TRUNC; }

    var fdflags: u32 = 0;
    if ((flags & shared.O_APPEND) != 0)   { fdflags = fdflags | FDFLAGS_APPEND; }
    if ((flags & shared.O_NONBLOCK) != 0) { fdflags = fdflags | FDFLAGS_NONBLOCK; }

    var base:      u64 = RIGHTS_COMMON;
    val mode_bits: i32 = flags & 3;
    if (mode_bits != shared.O_WRONLY) { base = base | RIGHTS_READ; }
    if (mode_bits != shared.O_RDONLY) { base = base | RIGHTS_WRITE; }
    var inheriting: u64 = 0;
    if ((flags & shared.O_DIRECTORY) != 0) {
        base       = base | RIGHTS_PATH;
        inheriting = RIGHTS_COMMON | RIGHTS_READ | RIGHTS_WRITE | RIGHTS_PATH;
    }
    var parent: Fdstat;
    val e:      i32 = fd_fdstat_get(at.fd, ?parent);
    if (e != 0) { ret shared.code(e); }
    base       = base & parent.rights_inheriting;
    inheriting = inheriting & parent.rights_inheriting;

    var lookup: u32 = LOOKUP_FOLLOW;
    if ((flags & shared.O_NOFOLLOW) != 0) { lookup = 0; }
    var fd:     i32 = -1;
    val opened: i32 = path_open(at.fd, lookup, at.path, str_len(at.path), oflags, base, inheriting, fdflags, ?fd);
    if (opened != 0) { ret shared.code(opened); }
    ret fd::i64;
}

pub fun close(fd: i32) i64 {
    ret shared.code(fd_close(fd));
}

pub fun sync_fd(fd: i32) i64 {
    ret shared.code(fd_sync(fd));
}

pub fun stat(fd: i32, st: *stat_t) i64 {
    var from: Filestat;
    val e:    i32 = fd_filestat_get(fd, ?from);
    if (e != 0) { ret shared.code(e); }
    fill_stat(?from, st);
    ret 0;
}

pub fun stat_path(dirfd: i32, path: *u8, st: *stat_t, flags: i32) i64 {
    val at: Located = locate(dirfd, path);
    if (at.code != 0) { ret at.code; }
    var lookup: u32 = LOOKUP_FOLLOW;
    if ((flags & shared.AT_SYMLINK_NOFOLLOW) != 0) { lookup = 0; }
    var from: Filestat;
    val e:    i32 = path_filestat_get(at.fd, lookup, at.path, str_len(at.path), ?from);
    if (e != 0) { ret shared.code(e); }
    fill_stat(?from, st);
    ret 0;
}

pub fun stat_mode(st: *stat_t) u32 {
    ret st.st_mode;
}

pub fun access(dirfd: i32, path: *u8, mode: i32, flags: i32) i64 {
    var st: stat_t;
    ret stat_path(dirfd, path, ?st, flags);
}

pub fun set_mode(fd: i32, mode: i32) i64 {
    ret shared.ENOTSUP;
}

pub fun set_mode_at(dirfd: i32, name: *u8, mode: i32) i64 {
    ret shared.ENOTSUP;
}

pub fun file_identity(fd: i32, out: *identities.Identity) i64 {
    var st:     stat_t;
    val status: i64 = stat(fd, ?st);
    if (status < 0) { ret status; }
    @out = identities.native(identities.WASI_LOCAL, st.st_dev, st.st_ino);
    ret 0;
}

pub fun identity_at(dirfd: i32, path: *u8, out: *identities.Identity) i64 {
    var st:     stat_t;
    val status: i64 = stat_path(dirfd, path, ?st, shared.AT_SYMLINK_NOFOLLOW);
    if (status < 0) { ret status; }
    @out = identities.native(identities.WASI_LOCAL, st.st_dev, st.st_ino);
    ret 0;
}

# a handle that only names a file does not exist here, so metadata alone is ENOTSUP
pub fun retain_identity_at(dirfd: i32, path: *u8, access: identities.Access, out: *identities.Identity) i64 {
    if (access == identities.METADATA_ONLY)   { ret shared.ENOTSUP; }
    if (access != identities.READ_AUTHORIZED) { ret shared.EINVAL; }
    val opened: i64 = open(dirfd, path, shared.O_RDONLY | shared.O_NOFOLLOW, 0);
    if (opened < 0) { ret opened; }
    val identified: i64 = file_identity(opened::i32, out);
    if (identified < 0) {
        close(opened::i32);
        ret identified;
    }
    ret opened;
}

# no file claims without advisory locks
pub fun publication_capabilities(fd: i32) i64 {
    ret 0;
}

pub fun unlink(dirfd: i32, path: *u8, flags: i32) i64 {
    val at: Located = locate(dirfd, path);
    if (at.code != 0) { ret at.code; }
    if ((flags & shared.AT_REMOVEDIR) != 0) {
        ret shared.code(path_remove_directory(at.fd, at.path, str_len(at.path)));
    }
    ret shared.code(path_unlink_file(at.fd, at.path, str_len(at.path)));
}

pub fun rename(olddir: i32, oldpath: *u8, newdir: i32, newpath: *u8) i64 {
    val from: Located = locate(olddir, oldpath);
    if (from.code != 0) { ret from.code; }
    val to: Located = locate(newdir, newpath);
    if (to.code != 0) { ret to.code; }
    ret shared.code(path_rename(from.fd, from.path, str_len(from.path), to.fd, to.path, str_len(to.path)));
}

pub fun symlink(target: *u8, linkpath: *u8) i64 {
    val at: Located = locate(shared.AT_FDCWD, linkpath);
    if (at.code != 0) { ret at.code; }
    ret shared.code(path_symlink(target, str_len(target), at.fd, at.path, str_len(at.path)));
}

pub fun make_dir(dirfd: i32, path: *u8, mode: i32) i64 {
    val at: Located = locate(dirfd, path);
    if (at.code != 0) { ret at.code; }
    ret shared.code(path_create_directory(at.fd, at.path, str_len(at.path)));
}

pub fun seek(fd: i32, offset: i64, whence: i32) i64 {
    var position: u64 = 0;
    val e:        i32 = fd_seek(fd, offset, whence::u32, ?position);
    if (e != 0) { ret shared.code(e); }
    ret position::i64;
}

pub fun lock_fd(fd: i32, op: i32) i64 {
    ret shared.ENOTSUP;
}

pub fun pipe(fds: *i32) i64 {
    ret shared.ENOTSUP;
}

pub fun map_file(fd: i32, offset: usize, size: usize, prot: u32) ptr {
    ret nil;
}

pub fun sync_file(p: ptr, size: usize) i64 {
    ret shared.ENOTSUP;
}

val DIRECTORY_BUFFER_SIZE: usize = 65536;

# half the buffer takes entries, the rest the name of the one being yielded
val DIRECTORY_ENTRIES: usize = 32768;

pub rec DirectoryCursor {
    address: usize;
    fd:      i32;
    active:  bool;
    ended:   bool;
    error:   i64;
    buffer:  ptr;
    offset:  usize;
    count:   usize;
    cookie:  u64;
}

pub fun directory_init(out: *DirectoryCursor, fd: i32) DirectoryInitResult {
    if (out == nil || (out.address != 0 && (out.address != out::usize || out.active))) {
        ret DirectoryInitResult{code: shared.EINVAL};
    }
    out.address = out::usize;
    out.active  = false;
    var st:      stat_t;
    val checked: i64 = stat(fd, ?st);
    if (checked < 0)                                    { ret DirectoryInitResult{code: checked}; }
    if ((st.st_mode & shared.S_IFMT) != shared.S_IFDIR) { ret DirectoryInitResult{code: shared.ENOTDIR}; }
    val buffer: ptr = shared.allocate(DIRECTORY_BUFFER_SIZE);
    if (buffer == nil) { ret DirectoryInitResult{code: shared.ENOMEM}; }
    out.fd     = fd;
    out.buffer = buffer;
    out.offset = 0;
    out.count  = 0;
    out.cookie = 0;
    out.ended  = false;
    out.error  = 0;
    out.active = true;
    ret DirectoryInitResult{};
}

# a host writes as many whole or cut entries as fit, so the buffer ran out where
# the next entry does not lie whole inside it, and the cookie refills from there
fun directory_whole(cursor: *DirectoryCursor) bool {
    val remaining: usize = cursor.count - cursor.offset;
    if (remaining < $size_of(Dirent)) { ret false; }
    val entry: *Dirent = (cursor.buffer::usize + cursor.offset)::*Dirent;
    ret entry.namlen::usize <= remaining - $size_of(Dirent);
}

pub fun directory_next(cursor: *DirectoryCursor, out: *DirectoryEntry) i64 {
    if (cursor == nil || out == nil || cursor.address != cursor::usize || !cursor.active) { ret shared.EINVAL; }
    if (cursor.error < 0)                                                                 { ret cursor.error; }
    if (cursor.ended)                                                                     { ret 0; }
    if (!directory_whole(cursor)) {
        if (cursor.count != 0 && cursor.count < DIRECTORY_ENTRIES) {
            cursor.ended = true;
            ret 0;
        }
        var used: usize = 0;
        val e:    i32   = fd_readdir(cursor.fd, cursor.buffer::*u8, DIRECTORY_ENTRIES, cursor.cookie, ?used);
        if (e != 0) {
            cursor.error = shared.code(e);
            ret cursor.error;
        }
        cursor.offset = 0;
        cursor.count  = used;
        if (used == 0) {
            cursor.ended = true;
            ret 0;
        }
        if (!directory_whole(cursor)) {
            cursor.error = shared.ENAMETOOLONG;
            ret cursor.error;
        }
    }
    val entry:  *Dirent = (cursor.buffer::usize + cursor.offset)::*Dirent;
    val length: usize   = entry.namlen::usize;
    val from:   *u8     = (cursor.buffer::usize + cursor.offset + $size_of(Dirent))::*u8;
    val name:   *u8     = (cursor.buffer::usize + DIRECTORY_ENTRIES)::*u8;
    var i:      usize   = 0;
    for (i < length) {
        name[i] = from[i];
        i       = i + 1;
    }
    name[length]  = 0;
    @out          = DirectoryEntry{name: name::str, length: length, type_hint: entry.kind};
    cursor.cookie = entry.next;
    cursor.offset = cursor.offset + $size_of(Dirent) + length;
    ret 1;
}

pub fun directory_close(cursor: *DirectoryCursor) i64 {
    if (cursor == nil || cursor.address != cursor::usize) { ret shared.EINVAL; }
    if (!cursor.active)                                   { ret 0; }
    val buffer: ptr = cursor.buffer;
    cursor.active = false;
    cursor.buffer = nil;
    ret shared.deallocate(buffer, DIRECTORY_BUFFER_SIZE);
}

# the preview has one directory the program starts in, the root
pub fun getcwd(buf: *u8, size: usize) i64 {
    if (size < 2) { ret shared.ERANGE; }
    buf[0] = '/';
    buf[1] = 0;
    ret 1;
}

# one block holding count + 1 pointers and then the strings they point into
fun capture(count: usize, size: usize, out: ***u8, strings: **u8) bool {
    val pointers: usize = (count + 1) * $size_of(*u8);
    val block:    ptr   = shared.allocate(pointers + size + 1);
    if (block == nil) { ret false; }
    @out     = block::**u8;
    @strings = (block::usize + pointers)::*u8;
    ret true;
}

var argument_count:  usize = 0;
var argument_values: **u8  = nil;
var environment:     **u8  = nil;

# take the arguments and the environment from the host, before main
# ---
# ret: whether they were read
pub fun capture_process() bool {
    var count:   usize = 0;
    var size:    usize = 0;
    var strings: *u8   = nil;
    if (args_sizes_get(?count, ?size) != 0 || !capture(count, size, ?argument_values, ?strings)) { ret false; }
    if (args_get(argument_values, strings) != 0)                                                 { ret false; }
    argument_values[count] = nil;
    argument_count         = count;

    if (environ_sizes_get(?count, ?size) != 0 || !capture(count, size, ?environment, ?strings)) { ret false; }
    if (environ_get(environment, strings) != 0)                                                 { ret false; }
    environment[count] = nil;
    ret true;
}

pub fun arguments() **u8 {
    ret argument_values;
}

pub fun argument_total() usize {
    ret argument_count;
}

pub fun environ() **u8 {
    ret environment;
}

pub fun getenv(name: *u8, buf: *u8, cap: usize) i64 {
    if (environment == nil) { ret shared.ENOENT; }
    val name_len: usize = str_len(name);
    var i:        usize = 0;
    for (environment[i] != nil) {
        val entry: *u8 = environment[i];
        if (str_starts_with(entry, name) && entry[name_len] == '='::u8) {
            val value: *u8   = ?entry[name_len + 1];
            val len:   usize = str_len(value);
            var j:     usize = 0;
            for (j < len && j + 1 < cap) {
                buf[j] = value[j];
                j      = j + 1;
            }
            if (j < cap) { buf[j] = 0; }
            ret len::i64;
        }
        i = i + 1;
    }
    ret shared.ENOENT;
}

pub fun terminate(code: i64) {
    proc_exit(code::u32);
}

pub fun abort() {
    proc_exit(255);
}

# the preview runs one process and knows no other
pub fun getpid() i64 {
    ret shared.ENOTSUP;
}

pub fun terminate_child(pid: i64) i64 {
    ret shared.ENOTSUP;
}

pub fun spawn(pathname: *u8, argv: **u8, envp: Environment) i64 {
    ret shared.ENOTSUP;
}

pub fun spawn_in(pathname: *u8, argv: **u8, envp: Environment, cwd: *u8) i64 {
    ret shared.ENOTSUP;
}

pub fun spawn_redirected(pathname: *u8, argv: **u8, envp: Environment, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32) i64 {
    ret shared.ENOTSUP;
}

pub fun spawn_redirected_in(pathname: *u8, argv: **u8, envp: Environment, cwd: *u8, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32) i64 {
    ret shared.ENOTSUP;
}

pub fun wait(pid: i64, status: *ProcessStatus, options: i32, rusage: *u8) WaitResult {
    ret WaitResult{pid: 0, error: ProcessWaitError{code: shared.ENOTSUP, native_code: 0, operation: PROCESS_OP_WAIT}};
}

pub fun wait_pid(pid: i64, status: *ProcessStatus, options: i32) WaitResult {
    ret wait(pid, status, options, nil);
}

pub fun ignore_sigpipe() i64 {
    ret 0;
}

pub fun open_file_limit(out: *FileLimit) i64 {
    ret shared.ENOTSUP;
}

pub fun set_open_file_limit(limit: FileLimit) i64 {
    ret shared.ENOTSUP;
}

pub fun random_fill(buf: *u8, len: usize) i64 {
    if (len == 0) { ret 0; }
    ret shared.code(random_get(buf, len));
}

pub fun clock_gettime(clock_id: i32, ts: *timespec) i64 {
    var time: u64 = 0;
    val e:    i32 = clock_time_get(clock_id::u32, 1, ?time);
    if (e != 0) { ret shared.code(e); }
    @ts = timespec{tv_sec: (time / NANOSECONDS)::i64, tv_nsec: (time % NANOSECONDS)::i64};
    ret 0;
}

# block the one thread for nsec nanoseconds
pub fun sleep(nsec: i64) {
    if (nsec <= 0) { ret; }
    var request: Subscription = Subscription{userdata: 0, tag: 0, clock: shared.CLOCK_MONOTONIC::u32, timeout: nsec::u64, precision: 0, flags: 0};
    var event:   Event;
    var done:    usize        = 0;
    poll_oneoff(?request, ?event, 1, ?done);
}

# linear memory holds its stack with no bound the module can read
pub fun stack_bounds(low: *usize, high: *usize) bool {
    ret false;
}
