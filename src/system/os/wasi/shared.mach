# what every wasi row shares: the contract's constants, the native codes and
# the pages of linear memory
#
# a wasi errno crosses the contract negated, as an errno does on linux and
# darwin. the numbers are the ones the interface states, so a native code is the
# host's own value. two of them have no contract meaning of their own and read
# as the code that does: nosys as ENOTSUP, and notcapable, a path the host holds
# outside what the program was given, as EACCES.
#
# linear memory only grows, so pages a caller gives back stay here, in address
# order and merged, and the next allocation takes them first. a page is 64 KiB.

use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

$if ($mach.build.sys != $mach.sys.wasi) {
    $error("std.system.os.wasi.shared: requires wasi target");
}

pub val separator: u8 = '/';

pub val STDIN_FD:  i32 = 0;
pub val STDOUT_FD: i32 = 1;
pub val STDERR_FD: i32 = 2;

pub val O_RDONLY:    i32 = 0;
pub val O_WRONLY:    i32 = 1;
pub val O_RDWR:      i32 = 2;
pub val O_CREAT:     i32 = 64;
pub val O_EXCL:      i32 = 128;
pub val O_TRUNC:     i32 = 512;
pub val O_APPEND:    i32 = 1024;
pub val O_NONBLOCK:  i32 = 0o4000;
pub val O_DIRECTORY: i32 = 0o200000;
pub val O_NOFOLLOW:  i32 = 0o400000;

# the preview has no working directory, so this names the root the preopens hang off
pub val AT_FDCWD:            i32 = -100;
pub val AT_SYMLINK_NOFOLLOW: i32 = 0x100;
pub val AT_REMOVEDIR:        i32 = 0x200;

pub val LOCK_SH: i32 = 1;
pub val LOCK_EX: i32 = 2;
pub val LOCK_NB: i32 = 4;
pub val LOCK_UN: i32 = 8;

pub val S_IFMT:  u32 = 0o170000;
pub val S_IFDIR: u32 = 0o040000;
pub val S_IFREG: u32 = 0o100000;
pub val S_IFLNK: u32 = 0o120000;

pub val WNOHANG:    i32 = 1;
pub val WUNTRACED:  i32 = 2;
pub val WCONTINUED: i32 = 8;

pub val CLOCK_REALTIME:  i32 = 0;
pub val CLOCK_MONOTONIC: i32 = 1;

pub val E2BIG:        i64 = -1;
pub val EACCES:       i64 = -2;
pub val EADDRINUSE:   i64 = -3;
pub val EAGAIN:       i64 = -6;
pub val EBADF:        i64 = -8;
pub val EBUSY:        i64 = -10;
pub val ECANCELED:    i64 = -11;
pub val ECHILD:       i64 = -12;
pub val ECONNABORTED: i64 = -13;
pub val ECONNREFUSED: i64 = -14;
pub val ECONNRESET:   i64 = -15;
pub val EEXIST:       i64 = -20;
pub val EFAULT:       i64 = -21;
pub val EHOSTUNREACH: i64 = -23;
pub val EINTR:        i64 = -27;
pub val EINVAL:       i64 = -28;
pub val EIO:          i64 = -29;
pub val EISDIR:       i64 = -31;
pub val ELOOP:        i64 = -32;
pub val EMFILE:       i64 = -33;
pub val ENAMETOOLONG: i64 = -37;
pub val ENETUNREACH:  i64 = -40;
pub val ENFILE:       i64 = -41;
pub val ENODEV:       i64 = -43;
pub val ENOENT:       i64 = -44;
pub val ENOMEM:       i64 = -48;
pub val ENOSPC:       i64 = -51;
pub val ENOSYS:       i64 = -52;
pub val ENOTCONN:     i64 = -53;
pub val ENOTDIR:      i64 = -54;
pub val ENOTEMPTY:    i64 = -55;
pub val ENOTSUP:      i64 = -58;
pub val ENXIO:        i64 = -60;
pub val EPERM:        i64 = -63;
pub val EPIPE:        i64 = -64;
pub val ERANGE:       i64 = -68;
pub val EROFS:        i64 = -69;
pub val ESRCH:        i64 = -71;
pub val ETIMEDOUT:    i64 = -73;
pub val ETXTBSY:      i64 = -74;
pub val ENOTCAPABLE:  i64 = -76;

# the contract's code for what the host returned
# ---
# errno: the host's errno, zero for success
# ret:   zero, or the negative native code
pub fun code(errno: i32) i64 {
    val native: i64 = -(errno::i64);
    if (native == ENOSYS)      { ret ENOTSUP; }
    if (native == ENOTCAPABLE) { ret EACCES; }
    ret native;
}

# the native text for a negative code
pub fun error_message(code: i64) str {
    if (code == EACCES)       { ret "permission denied"; }
    if (code == EBADF)        { ret "bad file descriptor"; }
    if (code == EEXIST)       { ret "file exists"; }
    if (code == EINVAL)       { ret "invalid argument"; }
    if (code == EIO)          { ret "input/output error"; }
    if (code == EISDIR)       { ret "is a directory"; }
    if (code == ELOOP)        { ret "too many levels of symbolic links"; }
    if (code == ENAMETOOLONG) { ret "file name too long"; }
    if (code == ENOENT)       { ret "no such file or directory"; }
    if (code == ENOMEM)       { ret "out of memory"; }
    if (code == ENOSPC)       { ret "no space left on device"; }
    if (code == ENOTDIR)      { ret "not a directory"; }
    if (code == ENOTEMPTY)    { ret "directory not empty"; }
    if (code == ENOTSUP)      { ret "not supported"; }
    if (code == EPIPE)        { ret "broken pipe"; }
    if (code == ERANGE)       { ret "result out of range"; }
    ret "unknown error";
}

val PAGE: usize = 65536;

# a run of whole pages given back, its header in its own first bytes
rec Span {
    next: *Span;
    size: usize;
}

var kept: *Span = nil;

# how far the heap region reaches
var region_end: usize = 0;

fun whole_pages(size: usize, out: *usize) bool {
    if (size > ~(0::usize) - (PAGE - 1)) { ret false; }
    @out = (size + PAGE - 1) & ~(PAGE - 1);
    ret true;
}

# the first address past linear memory, which only grows, so nothing past it
# was ever handed out
fun memory_end() usize {
    var pages: i32 = 0;
    asm mvp {
        local.get {pages}
        memory.size
        i32.store
    }
    ret pages::usize * PAGE;
}

# the pages past linear memory, zero filled by the host
#
# this is the one place new linear memory is reached
# ---
# size: bytes wanted, whole pages
# ret:  the pages, or nil when the host has no more
fun extend(size: usize) ptr {
    var pages: i32 = (size / PAGE)::i32;
    var old:   i32 = 0;
    asm mvp {
        local.get {old}
        local.get {pages}
        i32.load
        memory.grow
        i32.store
    }
    if (old < 0) { ret nil; }
    ret (old::usize * PAGE)::ptr;
}

pub fun page_size() usize {
    ret PAGE;
}

# whole zero-filled pages, kept ones first
# ---
# size: bytes wanted
# ret:  the pages, or nil when memory is exhausted
pub fun allocate(size: usize) ptr {
    if (size == 0) { ret nil; }
    var wanted: usize = 0;
    if (!whole_pages(size, ?wanted)) { ret nil; }
    var link: **Span = ?kept;
    for (@link != nil) {
        val span: *Span = @link;
        if (span.size >= wanted) {
            if (span.size == wanted) { @link = span.next; }
            or {
                val rest: *Span = (span::usize + wanted)::*Span;
                rest.next = span.next;
                rest.size = span.size - wanted;
                @link     = rest;
            }
            memory.raw_zero(span::ptr, wanted);
            ret span::ptr;
        }
        link = ?span.next;
    }
    ret extend(wanted);
}

# keep pages for the next allocate, merged with their neighbours
# ---
# p:    the pages, on a page boundary
# size: their size in bytes
# ret:  0, or EINVAL for an address off a page
pub fun deallocate(p: ptr, size: usize) i64 {
    if (p == nil || size == 0) { ret 0; }
    var whole: usize = 0;
    if ((p::usize & (PAGE - 1)) != 0 || !whole_pages(size, ?whole)) { ret EINVAL; }
    val span: *Span  = p::*Span;
    var link: **Span = ?kept;
    var last: *Span  = nil;
    for (@link != nil && (@link)::usize < p::usize) {
        last = @link;
        link = ?last.next;
    }
    span.next = @link;
    span.size = whole;
    @link     = span;
    if (span.next != nil && span::usize + span.size == span.next::usize) {
        span.size = span.size + span.next.size;
        span.next = span.next.next;
    }
    if (last != nil && last::usize + last.size == span::usize) {
        last.size = last.size + span.size;
        last.next = span.next;
    }
    ret 0;
}

# resize a page allocation, in place when its pages still hold it
pub fun reallocate(p: ptr, old_size: usize, new_size: usize) ptr {
    if (p == nil) { ret allocate(new_size); }
    if (new_size == 0) {
        deallocate(p, old_size);
        ret nil;
    }
    var held:   usize = 0;
    var wanted: usize = 0;
    if (!whole_pages(old_size, ?held) || !whole_pages(new_size, ?wanted)) { ret nil; }
    if (wanted <= held) {
        deallocate((p::usize + wanted)::ptr, held - wanted);
        ret p;
    }
    val moved: ptr = allocate(new_size);
    if (moved == nil) { ret nil; }
    memory.raw_copy(moved, p, old_size);
    deallocate(p, old_size);
    ret moved;
}

# the first address past what has been handed out
pub fun heap_region_base() usize {
    region_end = memory_end();
    ret region_end;
}

# move the region's end up to addr
#
# the region is contiguous, so it stops growing once pages from `allocate` lie
# past it
# ---
# addr: the address wanted
# ret:  the address reached, on a page and at least addr, which stays put when
#       addr is out of reach
pub fun heap_region_extend(addr: usize) usize {
    if (region_end == 0)                                  { heap_region_base(); }
    if (addr <= region_end || region_end != memory_end()) { ret region_end; }
    var wanted: usize = 0;
    if (!whole_pages(addr - region_end, ?wanted) || extend(wanted) == nil) { ret region_end; }
    region_end = region_end + wanted;
    ret region_end;
}

# linear memory has one protection, every page readable and writable
pub fun protect(p: ptr, size: usize, prot: u32) i64 {
    ret ENOTSUP;
}

pub fun lock(p: ptr, size: usize) i64 {
    ret ENOTSUP;
}

pub fun unlock(p: ptr, size: usize) i64 {
    ret ENOTSUP;
}

pub fun advise(p: ptr, size: usize, advice: u32) i64 {
    ret ENOTSUP;
}
