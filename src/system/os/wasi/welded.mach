# secret-welded storage on a target with no inline assembly
#
# the secrecy rules let no plain pointer become a welded one and no welded one
# become an integer, and a target with an assembler carries a page mapping across
# in asm. wasm has none, so here the storage is welded from its declaration: one
# region of ^u8 that every secret allocation is carved from, and an address
# crosses as an offset into it, recovered from a pointer by ordering it against
# the region, which the rules allow since an address is public. nothing here
# reads or moves a secret.
#
# a T with public bytes cannot be viewed through the region, and such an
# instance is refused where it is written.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

$if ($mach.build.sys != $mach.sys.wasi) {
    $error("std.system.os.wasi.welded: requires wasi target");
}

use std.system.os.wasi.shared;

# the unit storage is carved in, and the page of the secret contract here
pub val PAGE: usize = 4096;

val PAGES: usize = 4096;
val SIZE:  usize = PAGES * PAGE;

#[align(4096)]
var region: [SIZE]^u8;
var taken:  [PAGES]bool;

# the offset in the region a pointer into it holds
pub fun index[T](p: *T) usize {
    var low:  usize = 0;
    var high: usize = SIZE;
    for (low + 1 < high) {
        val middle: usize = (low + high) / 2;
        if (?region[middle] <= p) { low = middle; }
        or                        { high = middle; }
    }
    ret low;
}

# a view of T at an offset in the region
pub fun at[T](offset: usize) *T {
    ret (?region[offset])::*T;
}

# storage for span bytes between two pages, which cannot be guarded here
# ---
# span:    usable bytes, whole pages
# page:    PAGE
# data:    receives the usable bytes' offset, as a ptr
# locking: left false, since no step here locks
# ret:     0, or ENOMEM
pub fun map_secret(span: usize, page: usize, data: *ptr, locking: *bool) i64 {
    val count: usize = span / PAGE + 2;
    var first: usize = 0;
    var run:   usize = 0;
    var i:     usize = 0;
    for (i < PAGES && run < count) {
        if (taken[i]) {
            run   = 0;
            first = i + 1;
        }
        or { run = run + 1; }
        i = i + 1;
    }
    if (run < count) { ret shared.ENOMEM; }
    i = first;
    for (i < first + count) {
        taken[i] = true;
        i        = i + 1;
    }
    i = first * PAGE;
    for (i < (first + count) * PAGE) {
        region[i] = 0;
        i         = i + 1;
    }
    @data = ((first + 1) * PAGE)::ptr;
    ret 0;
}

# give back what map_secret took, guards included
# ---
# offset: where the leading page starts
# total:  its bytes, the two pages included
pub fun unmap_secret(offset: usize, total: usize) i64 {
    if ((offset % PAGE) != 0 || (total % PAGE) != 0 || offset + total > SIZE) { ret shared.EINVAL; }
    var i: usize = offset / PAGE;
    for (i < (offset + total) / PAGE) {
        taken[i] = false;
        i        = i + 1;
    }
    ret 0;
}
