# descriptor-relative recursive removal shared by namespace and transaction callers
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.path;
use std.system.os;
use O: std.types.option;

$if ($mach.build.os == $mach.os.linux) { use native: std.system.os.linux; }
$or ($mach.build.os == $mach.os.darwin) { use native: std.system.os.darwin; }

pub rec Error {
    code: i64;
    containment: bool;
}

pub fun message(e: Error) str {
    if (e.containment) { ret "invalid removal component or directory tree too deep"; }
    ret os.message(e.code);
}

fun failure(code: i64) O.Option[Error] {
    ret O.some[Error](Error{code: code, containment: false});
}

fun component(name: str) bool {
    if (str_empty(name) || str_equals(name, ".") || str_equals(name, "..")) { ret false; }
    val len: usize = str_len(name);
    var i: usize = 0;
    for (i < len) {
        if (path.is_separator(name[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun dot(name: *u8) bool {
    ret name[0] == '.' && (name[1] == 0 || (name[1] == '.' && name[2] == 0));
}

# count is usable only when the complete operation succeeds
pub fun tree(dirfd: i32, name: str, removed: *usize, max_depth: usize) O.Option[Error] {
    if (dirfd == os.AT_FDCWD || removed == nil || !component(name)) {
        ret O.some[Error](Error{code: os.EINVAL, containment: true});
    }
    ret walk(dirfd, name, removed, 0, max_depth);
}

fun walk(dirfd: i32, name: str, removed: *usize, depth: usize, max_depth: usize) O.Option[Error] {
    if (depth > max_depth) { ret O.some[Error](Error{code: os.EINVAL, containment: true}); }
    var before: os.stat_t;
    val sr: i64 = os.stat_path(dirfd, name, ?before, os.AT_SYMLINK_NOFOLLOW);
    if (sr == os.ENOENT) { ret O.none[Error](); }
    if (sr < 0) { ret failure(sr); }
    if ((os.stat_mode(?before) & os.S_IFMT) != os.S_IFDIR) {
        val raw: i64 = os.unlink_force(dirfd, name, 0);
        if (raw == os.ENOENT) { ret O.none[Error](); }
        if (raw < 0) { ret failure(raw); }
        @removed = removed[0] + 1;
        ret O.none[Error]();
    }
    var flags: i32 = os.O_RDONLY | os.O_DIRECTORY;
    $if ($mach.build.os != $mach.os.windows) { flags = flags | native.O_NOFOLLOW; }
    val raw: i64 = os.open(dirfd, name, flags, 0);
    if (raw < 0) { ret failure(raw); }
    val child_fd: i32 = raw::i32;
    var opened: os.stat_t;
    val checked: i64 = os.stat(child_fd, ?opened);
    if (checked < 0) { os.close(child_fd); ret failure(checked); }
    if ((os.stat_mode(?opened) & os.S_IFMT) != os.S_IFDIR) {
        os.close(child_fd);
        ret O.some[Error](Error{code: os.EINVAL, containment: true});
    }
    val result: O.Option[Error] = contents(child_fd, removed, depth, max_depth);
    val closed: i64 = os.close(child_fd);
    if (O.is_some[Error](result)) { ret result; }
    if (closed < 0) { ret failure(closed); }
    val unlinked: i64 = os.unlink_force(dirfd, name, os.AT_REMOVEDIR);
    if (unlinked == os.ENOENT) { ret O.none[Error](); }
    if (unlinked < 0) { ret failure(unlinked); }
    @removed = removed[0] + 1;
    ret O.none[Error]();
}

fun contents(dirfd: i32, removed: *usize, depth: usize, max_depth: usize) O.Option[Error] {
    var buffer: [8192]u8;
    for (true) {
        val rewind: i64 = os.seek(dirfd, 0, os.SEEK_SET);
        if (rewind < 0) { ret failure(rewind); }
        val count: i64 = os.read_dir(dirfd, (?buffer[0])::*os.dirent64, 8192);
        if (count < 0) { ret failure(count); }
        if (count == 0) { ret O.none[Error](); }
        if (count > 8192) { ret failure(os.EIO); }
        var any: bool = false;
        var at: usize = 0;
        for (at < count::usize) {
            val minimum: usize = $offset_of(os.dirent64, d_name) + 1;
            if (count::usize - at < minimum) { ret failure(os.EIO); }
            val entry: *os.dirent64 = ((?buffer[0])::usize + at)::*os.dirent64;
            val length: usize = entry.d_reclen::usize;
            if (length < minimum || length > count::usize - at) { ret failure(os.EIO); }
            val name: *u8 = ?entry.d_name[0];
            val capacity: usize = length - $offset_of(os.dirent64, d_name);
            var end: usize = 0;
            for (end < capacity && name[end] != 0) { end = end + 1; }
            if (end == capacity || end == 0) { ret failure(os.EIO); }
            if (!dot(name)) {
                if (!component(name::str)) { ret failure(os.EIO); }
                val prior_count: usize = removed[0];
                val result: O.Option[Error] = walk(dirfd, name::str, removed, depth + 1, max_depth);
                if (O.is_some[Error](result)) { ret result; }
                if (removed[0] != prior_count) { any = true; }
            }
            at = at + length;
        }
        if (!any) { ret O.none[Error](); }
    }
    ret O.none[Error]();
}
