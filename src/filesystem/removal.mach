# descriptor-relative recursive removal shared by namespace and transaction callers
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.path;
use std.system.os;
use O: std.types.option;

$if ($mach.build.os == $mach.os.linux) { use native: std.system.os.linux; }
$or ($mach.build.os == $mach.os.darwin) { use native: std.system.os.darwin; }

pub rec Error {
    code: i64;
    containment: bool;
}

pub fun message(e: Error) str {
    if (e.containment) { ret "invalid removal component or directory tree too deep"; }
    ret os.message(e.code);
}

fun failure(code: i64) O.Option[Error] {
    ret O.some[Error](Error{code: code, containment: false});
}

fun component(name: str) bool {
    if (str_empty(name) || str_equals(name, ".") || str_equals(name, "..")) { ret false; }
    val len: usize = str_len(name);
    var i: usize = 0;
    for (i < len) {
        if (path.is_separator(name[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun dot(name: *u8) bool {
    ret name[0] == '.' && (name[1] == 0 || (name[1] == '.' && name[2] == 0));
}

# count is usable only when the complete operation succeeds
pub fun tree(dirfd: i32, name: str, removed: *usize, max_depth: usize) O.Option[Error] {
    if (dirfd == os.AT_FDCWD || removed == nil || !component(name)) {
        ret O.some[Error](Error{code: os.EINVAL, containment: true});
    }
    ret walk(dirfd, name, removed, 0, max_depth, false);
}

# only for transaction-owned private trees under an exclusive cooperative root claim
pub fun private_tree(dirfd: i32, name: str, removed: *usize, max_depth: usize) O.Option[Error] {
    if (dirfd == os.AT_FDCWD || removed == nil || !component(name)) {
        ret O.some[Error](Error{code: os.EINVAL, containment: true});
    }
    ret walk(dirfd, name, removed, 0, max_depth, true);
}

fun walk(dirfd: i32, name: str, removed: *usize, depth: usize, max_depth: usize, private: bool) O.Option[Error] {
    if (depth > max_depth) { ret O.some[Error](Error{code: os.EINVAL, containment: true}); }
    var before: os.stat_t;
    val sr: i64 = os.stat_path(dirfd, name, ?before, os.AT_SYMLINK_NOFOLLOW);
    if (sr == os.ENOENT) { ret O.none[Error](); }
    if (sr < 0) { ret failure(sr); }
    if ((os.stat_mode(?before) & os.S_IFMT) != os.S_IFDIR) {
        val raw: i64 = os.unlink_force(dirfd, name, 0);
        if (raw == os.ENOENT) { ret O.none[Error](); }
        if (raw < 0) { ret failure(raw); }
        @removed = removed[0] + 1;
        ret O.none[Error]();
    }
    $if ($mach.build.os != $mach.os.windows) {
        if (private && (os.stat_mode(?before) & 0o700) != 0o700) {
            val mode: i32 = ((os.stat_mode(?before) & 0o7777) | 0o700)::i32;
            val restored: i64 = os.set_mode_at(dirfd, name, mode);
            if (restored < 0) { ret failure(restored); }
        }
    }
    var flags: i32 = os.O_RDONLY | os.O_DIRECTORY;
    $if ($mach.build.os != $mach.os.windows) { flags = flags | native.O_NOFOLLOW; }
    val raw: i64 = os.open(dirfd, name, flags, 0);
    if (raw < 0) { ret failure(raw); }
    val child_fd: i32 = raw::i32;
    var opened: os.stat_t;
    val checked: i64 = os.stat(child_fd, ?opened);
    if (checked < 0) { os.close(child_fd); ret failure(checked); }
    if ((os.stat_mode(?opened) & os.S_IFMT) != os.S_IFDIR) {
        os.close(child_fd);
        ret O.some[Error](Error{code: os.EINVAL, containment: true});
    }
    val result: O.Option[Error] = contents(child_fd, removed, depth, max_depth, private);
    val closed: i64 = os.close(child_fd);
    if (O.is_some[Error](result)) { ret result; }
    if (closed < 0) { ret failure(closed); }
    val unlinked: i64 = os.unlink_force(dirfd, name, os.AT_REMOVEDIR);
    if (unlinked == os.ENOENT) { ret O.none[Error](); }
    if (unlinked < 0) { ret failure(unlinked); }
    @removed = removed[0] + 1;
    ret O.none[Error]();
}

fun contents(dirfd: i32, removed: *usize, depth: usize, max_depth: usize, private: bool) O.Option[Error] {
    var buffer: [8192]u8;
    for (true) {
        val rewind: i64 = os.seek(dirfd, 0, os.SEEK_SET);
        if (rewind < 0) { ret failure(rewind); }
        val count: i64 = os.read_dir(dirfd, (?buffer[0])::*os.dirent64, 8192);
        if (count < 0) { ret failure(count); }
        if (count == 0) { ret O.none[Error](); }
        if (count > 8192) { ret failure(os.EIO); }
        var any: bool = false;
        var at: usize = 0;
        for (at < count::usize) {
            val minimum: usize = $offset_of(os.dirent64, d_name) + 1;
            if (count::usize - at < minimum) { ret failure(os.EIO); }
            val entry: *os.dirent64 = ((?buffer[0])::usize + at)::*os.dirent64;
            val length: usize = entry.d_reclen::usize;
            if (length < minimum || length > count::usize - at) { ret failure(os.EIO); }
            val name: *u8 = ?entry.d_name[0];
            val capacity: usize = length - $offset_of(os.dirent64, d_name);
            var end: usize = 0;
            for (end < capacity && name[end] != 0) { end = end + 1; }
            if (end == capacity || end == 0) { ret failure(os.EIO); }
            if (!dot(name)) {
                if (!component(name::str)) { ret failure(os.EIO); }
                val prior_count: usize = removed[0];
                val result: O.Option[Error] = walk(dirfd, name::str, removed, depth + 1, max_depth, private);
                if (O.is_some[Error](result)) { ret result; }
                if (removed[0] != prior_count) { any = true; }
            }
            at = at + length;
        }
        if (!any) { ret O.none[Error](); }
    }
    ret O.none[Error]();
}

$if ($mach.build.os != $mach.os.windows) {
    test "std.filesystem.removal.private: finalized directories recover without exposing file content or linked trees" {
        val base: str = "mach_612_private_removal";
        if (os.make_dir(os.AT_FDCWD, base, 0o700) < 0) { ret 1; }
        fin { os.unlink(os.AT_FDCWD, base, os.AT_REMOVEDIR); }
        val root: i64 = os.open(os.AT_FDCWD, base, os.O_RDONLY | os.O_DIRECTORY, 0);
        if (root < 0) { ret 2; }
        fin { os.close(root::i32); }
        if (os.make_dir(root::i32, "private", 0o700) < 0 || os.make_dir(root::i32, "public", 0o700) < 0) { ret 3; }
        fin {
            var ignored: usize = 0;
            private_tree(root::i32, "private", ?ignored, 256);
            os.unlink(root::i32, "public", os.AT_REMOVEDIR);
        }
        val private_fd: i64 = os.open(root::i32, "private", os.O_RDONLY | os.O_DIRECTORY, 0);
        if (private_fd < 0) { ret 4; }
        if (os.make_dir(private_fd::i32, "inner", 0o700) < 0) { os.close(private_fd::i32); ret 5; }
        val inner: i64 = os.open(private_fd::i32, "inner", os.O_RDONLY | os.O_DIRECTORY, 0);
        if (inner < 0) { os.close(private_fd::i32); ret 6; }
        val file: i64 = os.open(inner::i32, "secret", os.O_CREAT | os.O_EXCL | os.O_RDWR, 0);
        if (file < 0) { os.close(inner::i32); os.close(private_fd::i32); ret 7; }
        fin { os.close(file::i32); }
        if (os.write(file::i32, "secret", 6) != 6) { os.close(inner::i32); os.close(private_fd::i32); ret 8; }
        if (os.symlink("../public", "mach_612_private_removal/private/alias") < 0) { os.close(inner::i32); os.close(private_fd::i32); ret 9; }
        val inner_mode: i64 = os.set_mode(inner::i32, 0);
        val private_mode: i64 = os.set_mode(private_fd::i32, 0);
        os.close(inner::i32);
        os.close(private_fd::i32);
        if (inner_mode < 0 || private_mode < 0 || os.set_mode_at(root::i32, "public", 0o555) < 0) { ret 10; }
        var removed: usize = 0;
        val ordinary: O.Option[Error] = tree(root::i32, "private", ?removed, 256);
        if (O.is_none[Error](ordinary) || removed != 0) { ret 11; }
        var untouched: os.stat_t;
        if (os.stat_path(root::i32, "private", ?untouched, os.AT_SYMLINK_NOFOLLOW) < 0
            || (os.stat_mode(?untouched) & 0o777) != 0) { ret 12; }
        if (O.is_some[Error](private_tree(root::i32, "private", ?removed, 256)) || removed != 4) { ret 13; }
        if (os.stat(file::i32, ?untouched) < 0 || (os.stat_mode(?untouched) & 0o777) != 0) { ret 14; }
        if (os.stat_path(root::i32, "public", ?untouched, os.AT_SYMLINK_NOFOLLOW) < 0
            || (os.stat_mode(?untouched) & 0o777) != 0o555) { ret 15; }
        if (os.stat_path(root::i32, "private", ?untouched, os.AT_SYMLINK_NOFOLLOW) != os.ENOENT) { ret 16; }
        ret 0;
    }
}
