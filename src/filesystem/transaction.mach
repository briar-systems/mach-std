        fin { t_session_dnit(?root_session); }
            if (t_publish(?a, ?root_session, "y", "wide") != 0) { bad = 4; }
            or (O.is_some[Error](entry_rename(t_reserve(?root_session, "y"), t_reserve(?root_session, leaf)))) { bad = 9; }
            or (t_publish(?a, ?root_session, "x", "short") != 0) { bad = 5; }
            or (os.seek(root.dirfd, 0, os.SEEK_SET) < 0) { bad = 30; }
            or {
