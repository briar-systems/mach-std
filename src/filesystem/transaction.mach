    if (error_of(blocked).kind != INVALID || session.held.initialized) { ret 16; }
    if (os.unlink(backup, "out", 0) < 0) { ret 17; }
    if (res_failed[usize](recover(?alloc, ?session.held, "out"))) { ret 18; }
    if (failed(claim(?claimant, ?alloc, ?session.held, "next"))) { ret 19; }
    if (failed(release_claim(?claimant))) { ret 20; }
    ret 0;
}

test "std.filesystem.transaction.durability: final private modes remain abortable after subtree barriers" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (failed(root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (failed(t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var inv: Inventory = inventory_init(?alloc);
    fin { inventory_dnit(?inv); }
    if (failed(inventory_push(?inv, entry_file("locked/inner/secret", "data", 4, 0o000)))) { ret 6; }
    if (failed(inventory_push(?inv, entry_dir("locked", 0o000)))) { ret 7; }
    if (failed(inventory_push(?inv, entry_dir("locked/inner", 0o000)))) { ret 8; }
    var transaction: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_ABSENT, durability: durability_full(true)};
    val built: err[Error] = prepare_subtree(?transaction, ?alloc, destination, ?inv, 0o000, options);
    if (sel built.err) { ret 9; }
    fin { if (prepared(?transaction)) { abort(?transaction); } }
    if (!transaction.content_flushed) { ret 10; }
    var st: os.stat_t;
    if (os.stat(transaction.staging_fd, ?st) < 0) { ret 11; }
    $if ($mach.build.os != $mach.os.windows) {
        if ((os.stat_mode(?st) & 0o777) != 0) { ret 12; }
    }
    if (failed(abort(?transaction))) { ret 13; }
    if (payload_entry_count(?alloc, base) != 0 || destination.active) { ret 14; }
    if (failed(prepare_subtree(?transaction, ?alloc, destination, ?inv, 0o000, options))) { ret 15; }
    if (failed(transaction_cleanup(?transaction, false, OP_ABORT))) { ret 16; }
    val swept: res[usize, Error] = t_end_batch_and_recover(?session, "out");
    if (sel swept.err || res_value[usize](swept) != 1) { ret 17; }
    if (payload_entry_count(?alloc, base) != 0) { ret 18; }
    ret 0;
}

fun t_alias_spelling(alloc: *A.Allocator, root: *Root) i32 {
    if (t_fixture_write(root, "Leaf", "value") != 0) { ret 1; }
    var st: os.stat_t;
    val observed: i64 = os.stat_path(root.dirfd, "leaf", ?st, os.AT_SYMLINK_NOFOLLOW);
    if (observed < 0 && observed != os.ENOENT) { ret 2; }
    val folded: bool = observed >= 0;
    var held: Lock;
    if (failed(lock(?held, root))) { ret 3; }
    fin { unlock(?held); }
    if (res_failed[usize](recover(alloc, ?held, ""))) { ret 4; }
    var destination: Claim;
    if (failed(claim(?destination, alloc, ?held, "Leaf"))) { ret 5; }
    fin { release_claim(?destination); }
    var competitor: Claim;
    val reserved: err[Error] = claim(?competitor, alloc, ?held, "leaf");
    if (folded) {
        if (!sel reserved.err) { release_claim(?competitor); ret 6; }
        if (error_of(reserved).kind != CONFLICT) { ret 7; }
    }
    or {
        if (sel reserved.err) { ret 8; }
        if (failed(release_claim(?competitor))) { ret 9; }
    }
    var foreign: Claim;
    if (failed(claim(?foreign, alloc, ?held, "Different"))) { ret 22; }
    fin { release_claim(?foreign); }
    if (t_fixture_write(root, "Different", "other") != 0) { ret 23; }
    val distinct: err[Error] = entry_rename_alias(?destination, "Different");
    if (sel distinct.ok || error_of(distinct).kind != CONFLICT) { ret 24; }
    if (!str_equals(claim_leaf(?destination), "Leaf") || entry_absent(root.dirfd, "Leaf")) { ret 25; }
    var other: [6]u8;
    val preserved: res[opt[usize], Error] = entry_read_all(root, "Different", ?other[0], 6);
    if (sel preserved.err || !str_equals((?other[0])::str, "other")) { ret 26; }
    if (failed(entry_unlink(?foreign)) || failed(release_claim(?foreign))) { ret 27; }
    if (failed(borrow_claim(?destination, OP_COMMIT))) { ret 28; }
    val busy: err[Error] = entry_rename_alias(?destination, "Leaf");
    return_claim(?destination);
    if (sel busy.ok || error_of(busy).kind != INVALID) { ret 29; }
    val renamed: err[Error] = entry_rename_alias(?destination, "leaf");
    if (folded) {
        if (sel renamed.err) { ret 10; }
        if (!str_equals(claim_leaf(?destination), "leaf")) { ret 11; }
        if (!str_equals(destination.reservation.name, "leaf")) { ret 12; }
        var bytes: [6]u8;
        val read: res[opt[usize], Error] = entry_read_all(root, "leaf", ?bytes[0], 6);
        if (sel read.err || !str_equals((?bytes[0])::str, "value")) { ret 13; }
    }
    or {
        if (sel renamed.ok || error_of(renamed).kind != CONFLICT) { ret 14; }
        if (!str_equals(claim_leaf(?destination), "Leaf")) { ret 15; }
        if (!entry_absent(root.dirfd, "leaf")) { ret 16; }
    }
    if (destination.active) { ret 17; }
    if (failed(entry_rename_alias(?destination, claim_leaf(?destination)))) { ret 18; }
    if (failed(entry_unlink(?destination))) { ret 19; }
    if (failed(release_claim(?destination))) { ret 20; }
    if (held.borrowers != 0) { ret 21; }
    ret 0;
}

test "std.filesystem.transaction.claim: alias spelling follows the root filesystem namespace" {
