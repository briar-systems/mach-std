            }
            if (O.is_some[Error](entry_unlink(t_reserve(?root_session, leaf))) && bad == 0) { bad = 7; }
            if (O.is_some[Error](entry_unlink(t_reserve(?root_session, "x"))) && bad == 0) { bad = 8; }

        }
        fs.remove_all(?a, base);
        str_free(?a, base);
        ret bad;
    }
}

