        var name: [766]u8;
        var i: usize = 0;
        for (i < 255) {
            name[i * 3] = 0xe7;
            name[i * 3 + 1] = 0x95;
            name[i * 3 + 2] = 0x8c;
            i = i + 1;
        }
        name[765] = 0;
        val leaf: str = (?name[0])::str;
        var bad: i32 = 0;
        var root_storage_44: Root;
