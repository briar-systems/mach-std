        var inv: Inventory = sample_inventory(?alloc);
        var t_storage: Transaction;
        val t: O.Option[Error] = prepare_subtree(?t_storage, ?alloc, t_reserve(?g_session, "site"), ?inv, 0o755, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (O.is_some[Error](t)) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            val c: R.Result[Outcome, Error] = commit_replacing_owned[OwnsNames](a, ?owns, owns_listed);
            if (R.is_err[Outcome, Error](c)) { bad = 4; }
        }
        val m: O.Option[str] = read_back(?alloc, root, "site/mach.toml");
        if (bad == 0 && O.is_none[str](m)) { bad = 6; }
        or {
            if (bad == 0 && !str_equals(O.unwrap[str](m), "[project]")) { bad = 7; }
        }
        if (bad == 0 && payload_entry_count(?alloc, root) != 2) { bad = 8; }
        inventory_dnit(?inv);

    }

    str_free(?alloc, b); str_free(?alloc, bf);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.prepare: failing at every allocation ordinal leaks nothing and leaves no residue" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    val dest: str = abs_of(?alloc, root, "out");
    fs.write_bytes(dest, "published", 9, 0o644);

    var root_storage_30: Root;
    val opened: O.Option[Error] = root_open(?root_storage_30, root, "");
    if (O.is_some[Error](opened)) { bad = 2; }
    or {
        val g: *Root = ?root_storage_30;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (O.is_some[Error](t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        # walk the ordinal past the number of allocations a whole prepare and
        # commit makes, so the sweep covers every allocation site including the
        # middle ones, not just the first and last
        var ordinal: usize = 1;
        for (ordinal <= 24 && bad == 0) {
            var t: testing.Testing;
            if (O.is_some[str](testing.make(?t))) { bad = 3; cnt; }
            testing.fail_at_ordinal(?t, ordinal);

            var txn_storage: Transaction;
        val txn: O.Option[Error] = prepare_bytes(?txn_storage, testing.allocator_of(?t), t_reserve(?g_session, "out"), "replacement", 11, 0o644, true, PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()});
        fin { if (txn_storage.state == STATE_PREPARED) { abort(?txn_storage); } }
            if (O.is_none[Error](txn)) {
                val a: *Transaction = ?txn_storage;
                # the injected failure may land during commit instead
                commit(a);
            }

            # whatever failed and wherever it failed, nothing was left allocated
            if (testing.leaked(?t)) { bad = 4; }
            if (bad == 0 && testing.double_free_count(?t) != 0) { bad = 5; }
            if (bad == 0 && testing.tracking_exhausted(?t)) { bad = 6; }
            testing.dnit(?t);

            # and the directory holds only the destination: either the old
            # content or the new one, never staging residue and never nothing
            if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 7; }
            val now: O.Option[str] = read_back(?alloc, root, "out");
            if (bad == 0 && O.is_none[str](now)) { bad = 8; }
            or {
                val s: str = O.unwrap[str](now);
                if (bad == 0 && !str_equals(s, "published") && !str_equals(s, "replacement")) { bad = 9; }
            }

            # restore the starting state for the next ordinal
            fs.remove_file(dest);
            fs.write_bytes(dest, "published", 9, 0o644);
            ordinal = ordinal + 1;
        }

    }

    str_free(?alloc, dest);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.prepare_subtree: failing at every allocation ordinal leaves no destination and no residue" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    var root_storage_31: Root;
    val opened: O.Option[Error] = root_open(?root_storage_31, root, "");
    if (O.is_some[Error](opened)) { bad = 2; }
    or {
        val g: *Root = ?root_storage_31;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (O.is_some[Error](t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        var ordinal: usize = 1;
        for (ordinal <= 24 && bad == 0) {
            var t: testing.Testing;
            if (O.is_some[str](testing.make(?t))) { bad = 3; cnt; }
            val ta: *A.Allocator = testing.allocator_of(?t);

            var inv: Inventory = inventory_init(ta);
            inventory_push(?inv, entry_file("mach.toml", "[project]", 9, 0o644));
            inventory_push(?inv, entry_dir("src", 0o755));
            inventory_push(?inv, entry_file("src/main.mach", "fun main() {}", 13, 0o644));

            testing.fail_at_ordinal(?t, ordinal);
            var txn_storage: Transaction;
        val txn: O.Option[Error] = prepare_subtree(?txn_storage, ta, t_reserve(?g_session, "project"), ?inv, 0o755, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (txn_storage.state == STATE_PREPARED) { abort(?txn_storage); } }
            if (O.is_none[Error](txn)) {
                val a: *Transaction = ?txn_storage;
                abort(a);
            }
            testing.clear_failure(?t);
            inventory_dnit(?inv);

            if (testing.leaked(?t)) { bad = 4; }
            if (bad == 0 && testing.double_free_count(?t) != 0) { bad = 5; }
            testing.dnit(?t);

            # an aborted or failed subtree prepare never leaves the destination
            # half-built, and never leaves its private tree behind
            if (bad == 0 && payload_entry_count(?alloc, root) != 0) { bad = 6; }
            ordinal = ordinal + 1;
        }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.entry_probe: describes presence, kind and identity without following symlinks" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    val f: str = abs_of(?alloc, root, "file");
    val d: str = abs_of(?alloc, root, "dir");
    val l: str = abs_of(?alloc, root, "link");
    fs.write_bytes(f, "x", 1, 0o644);
    fs.create_dir(d, 0o755);
    fs.symlink("file", l);

    var root_storage_32: Root;
    val opened: O.Option[Error] = root_open(?root_storage_32, root, "");
    if (O.is_some[Error](opened)) { bad = 2; }
    or {
        val g: *Root = ?root_storage_32;

        val pf: R.Result[EntryProbe, Error] = entry_probe(g, "file");
        if (R.is_err[EntryProbe, Error](pf)) { bad = 3; }
        or {
            val e: EntryProbe = R.unwrap_ok[EntryProbe, Error](pf);
            if (!e.present || !e.is_regular || e.is_directory) { bad = 4; }
        }

        val pd: R.Result[EntryProbe, Error] = entry_probe(g, "dir");
        if (bad == 0 && R.is_err[EntryProbe, Error](pd)) { bad = 5; }
        or {
            val e: EntryProbe = R.unwrap_ok[EntryProbe, Error](pd);
            if (bad == 0 && (!e.present || !e.is_directory || e.is_regular)) { bad = 6; }
        }

        # a symlink is present but is neither a file nor a directory: the probe
        # reports the link, not what it points at
        val pl: R.Result[EntryProbe, Error] = entry_probe(g, "link");
        if (bad == 0 && R.is_err[EntryProbe, Error](pl)) { bad = 7; }
        or {
            val e: EntryProbe = R.unwrap_ok[EntryProbe, Error](pl);
            if (bad == 0 && (!e.present || e.is_regular || e.is_directory)) { bad = 8; }
        }

        # absent is an answer, not a failure
        val pa: R.Result[EntryProbe, Error] = entry_probe(g, "missing");
        if (bad == 0 && R.is_err[EntryProbe, Error](pa)) { bad = 9; }
        or {
            if (bad == 0 && R.unwrap_ok[EntryProbe, Error](pa).present) { bad = 10; }
        }

        # a name with a separator cannot be probed at all
        if (bad == 0 && R.is_ok[EntryProbe, Error](entry_probe(g, "dir/x"))) { bad = 11; }

        root_dnit(g);
    }

    str_free(?alloc, f); str_free(?alloc, d); str_free(?alloc, l);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction: root mutations stay inside the root" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    var root_storage_33: Root;
    val opened: O.Option[Error] = root_open(?root_storage_33, root, "");
    if (O.is_some[Error](opened)) { bad = 2; }
    or {
        val g: *Root = ?root_storage_33;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (O.is_some[Error](t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        val mk: R.Result[bool, Error] = entry_make_dir(t_reserve(?g_session, "made"), 0o755);
        if (R.is_err[bool, Error](mk)) { bad = 3; }
        or {
            if (!R.unwrap_ok[bool, Error](mk)) { bad = 4; }
        }
        # a second create reports "already there" rather than failing
        val mk2: R.Result[bool, Error] = entry_make_dir(t_reserve(?g_session, "made"), 0o755);
        if (bad == 0 && R.is_err[bool, Error](mk2)) { bad = 5; }
        or {
            if (bad == 0 && R.unwrap_ok[bool, Error](mk2)) { bad = 6; }
        }

        val f: str = abs_of(?alloc, root, "a.txt");
        fs.write_bytes(f, "content", 7, 0o644);
        if (bad == 0 && O.is_some[Error](entry_rename(t_reserve(?g_session, "a.txt"), t_reserve(?g_session, "b.txt")))) { bad = 7; }
        if (bad == 0 && O.is_none[str](read_back(?alloc, root, "b.txt"))) { bad = 8; }

        # every mutation refuses a name that would leave the root
        if (bad == 0 && O.is_none[Error](entry_rename(t_reserve(?g_session, "b.txt"), t_reserve(?g_session, "../escaped")))) { bad = 9; }
        if (bad == 0 && O.is_none[Error](entry_unlink(t_reserve(?g_session, "../escaped")))) { bad = 10; }
        if (bad == 0 && R.is_ok[bool, Error](entry_make_dir(t_reserve(?g_session, "../escaped"), 0o755))) { bad = 11; }

        if (bad == 0 && O.is_some[Error](entry_unlink(t_reserve(?g_session, "b.txt")))) { bad = 12; }
        # removing something already gone is success
        if (bad == 0 && O.is_some[Error](entry_unlink(t_reserve(?g_session, "b.txt")))) { bad = 13; }

        # an empty directory goes; a populated one is left alone
        val inner: str = abs_of(?alloc, root, "made/keep.txt");
        fs.write_bytes(inner, "keep", 4, 0o644);
        if (bad == 0 && O.is_some[Error](entry_rmdir_if_empty(t_reserve(?g_session, "made")))) { bad = 14; }
        if (bad == 0 && O.is_none[str](read_back(?alloc, root, "made/keep.txt"))) { bad = 15; }

        str_free(?alloc, f);
        str_free(?alloc, inner);

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.entry_read_all: reads a record and refuses one too large" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    val f: str = abs_of(?alloc, root, "record");
    fs.write_bytes(f, "abcdefgh", 8, 0o644);

    var root_storage_34: Root;
    val opened: O.Option[Error] = root_open(?root_storage_34, root, "");
    if (O.is_some[Error](opened)) { bad = 2; }
    or {
        val g: *Root = ?root_storage_34;
        var buf: [16]u8;

        val r1: R.Result[O.Option[usize], Error] = entry_read_all(g, "record", ?buf[0], 16);
        if (R.is_err[O.Option[usize], Error](r1)) { bad = 3; }
        or {
            val got: O.Option[usize] = R.unwrap_ok[O.Option[usize], Error](r1);
            if (O.is_none[usize](got)) { bad = 4; }
            or {
                if (O.unwrap[usize](got) != 8) { bad = 5; }
                if (bad == 0 && (buf[0] != 'a'::u8 || buf[7] != 'h'::u8)) { bad = 6; }
            }
        }

        # a missing record is absent, not an error
        val r2: R.Result[O.Option[usize], Error] = entry_read_all(g, "absent", ?buf[0], 16);
        if (bad == 0 && R.is_err[O.Option[usize], Error](r2)) { bad = 7; }
        or {
            if (bad == 0 && O.is_some[usize](R.unwrap_ok[O.Option[usize], Error](r2))) { bad = 8; }
        }

        # a record larger than the buffer is refused rather than truncated
        val r3: R.Result[O.Option[usize], Error] = entry_read_all(g, "record", ?buf[0], 4);
        if (bad == 0 && R.is_ok[O.Option[usize], Error](r3)) { bad = 9; }

        root_dnit(g);
    }

    str_free(?alloc, f);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

fun t_mkfile(root: str, alloc: *A.Allocator, rel: str, body: str) bool {
    val abs: str = abs_of(alloc, root, rel);
    val parent_r: R.Result[str, str] = path.parent(alloc, abs);
    if (R.is_err[str, str](parent_r)) { ret false; }
    val parent: str = R.unwrap_ok[str, str](parent_r);
    if (O.is_some[str](fs.create_dir_all(alloc, parent, 0o755))) { ret false; }
    ret O.is_none[str](fs.write_bytes(abs, body::*u8, str_len(body), 0o644));
}

# a nested tree goes away whole, and the count is what was actually removed
test "std.filesystem.transaction.root_remove_tree: removes a nested tree" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;
    # tree/ a  b/ c  d/ e     -> 3 files + 3 directories = 6 entries
    if (!t_mkfile(root, ?alloc, "tree/a", "a")) { bad = 2; }
    if (bad == 0 && !t_mkfile(root, ?alloc, "tree/b/c", "c")) { bad = 3; }
    if (bad == 0 && !t_mkfile(root, ?alloc, "tree/b/d/e", "e")) { bad = 4; }
    # a sibling the removal must not touch
    if (bad == 0 && !t_mkfile(root, ?alloc, "keep", "keep")) { bad = 5; }

    if (bad == 0) {
        var root_storage_35: Root;
        val opened: O.Option[Error] = root_open(?root_storage_35, root, "");
        if (O.is_some[Error](opened)) { bad = 6; }
        or {
            val g: *Root = ?root_storage_35;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (O.is_some[Error](t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
            val rr: R.Result[usize, Error] = root_remove_tree(t_reserve(?g_session, "tree"), "");
            if (R.is_err[usize, Error](rr)) { bad = 7; }
            or (R.unwrap_ok[usize, Error](rr) != 6) { bad = 8; }

        }
    }

    # the tree is gone and the sibling is untouched
    if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 9; }
    if (bad == 0) {
        val back: O.Option[str] = read_back(?alloc, root, "keep");
        if (O.is_none[str](back)) { bad = 10; }
        or (!str_equals(O.unwrap[str](back), "keep")) { bad = 11; }
    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

# every way out of the root is refused, and a refusal removes nothing
#
# the tree is rebuilt for nothing: each case must leave it exactly as it was,
# which is the property that makes a refusal safe to retry.
test "std.filesystem.transaction.root_remove_tree: refuses every escape and removes nothing" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var bad: i32 = 0;

    # an "outside" directory the escapes would reach, with a file in it
    val outside: str = abs_of(?alloc, root, "outside");
    if (O.is_some[str](fs.create_dir_all(?alloc, outside, 0o755))) { bad = 2; }
    val victim: str = abs_of(?alloc, outside, "victim");
    if (bad == 0 && O.is_some[str](fs.write_bytes(victim, "victim"::*u8, 6, 0o644))) { bad = 3; }

    # the root the capability is anchored to is a subdirectory of that
    val inner: str = abs_of(?alloc, root, "inner");
    if (bad == 0 && O.is_some[str](fs.create_dir_all(?alloc, inner, 0o755))) { bad = 4; }
    if (bad == 0 && !t_mkfile(inner, ?alloc, "kept", "kept")) { bad = 5; }

    # a symlink inside the root pointing at the outside directory
    val link: str = abs_of(?alloc, inner, "link");
    if (bad == 0 && O.is_some[str](fs.symlink(outside, link))) { bad = 6; }

    if (bad == 0) {
        var root_storage_36: Root;
        val opened: O.Option[Error] = root_open(?root_storage_36, inner, "");
        if (O.is_some[Error](opened)) { bad = 7; }
        or {
            val g: *Root = ?root_storage_36;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (O.is_some[Error](t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

            # a `..` component never resolves
            val up: R.Result[usize, Error] = root_remove_tree(t_reserve(?g_session, "link"), "../outside");
            if (R.is_ok[usize, Error](up)) { bad = 8; }
            or (R.unwrap_err[usize, Error](up).kind != CONTAINMENT) { bad = 9; }

            # nor does an absolute path
            if (bad == 0) {
                val abs_try: R.Result[usize, Error] = root_remove_tree(t_reserve(?g_session, "link"), outside);
                if (R.is_ok[usize, Error](abs_try)) { bad = 10; }
                or (R.unwrap_err[usize, Error](abs_try).kind != CONTAINMENT) { bad = 11; }
            }

            # nor a symlink named as the last component
            if (bad == 0) {
                val via_link: R.Result[usize, Error] = root_remove_tree(t_reserve(?g_session, "link"), "");
                if (R.is_ok[usize, Error](via_link)) { bad = 12; }
                or (R.unwrap_err[usize, Error](via_link).kind != CONTAINMENT) { bad = 13; }
            }

            # nor a path descending THROUGH that symlink
            if (bad == 0) {
                val through: R.Result[usize, Error] = root_remove_tree(t_reserve(?g_session, "link"), "victim");
                if (R.is_ok[usize, Error](through)) { bad = 14; }
                or (R.unwrap_err[usize, Error](through).kind != CONTAINMENT) { bad = 15; }
            }


        }
    }

    # nothing was removed by any of them: the outside file, the symlink and the
    # file inside the root are all still there
    if (bad == 0 && !fs.exists(victim)) { bad = 16; }
    if (bad == 0 && !fs.exists(link))   { bad = 17; }
    if (bad == 0) {
        val back: O.Option[str] = read_back(?alloc, inner, "kept");
        if (O.is_none[str](back)) { bad = 18; }
        or (!str_equals(O.unwrap[str](back), "kept")) { bad = 19; }
    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.prepare_subtree: a renamed root keeps every staged descendant" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val base_r: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](base_r)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](base_r);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    val original: str = abs_of(?alloc, base, "original");
    val moved: str = abs_of(?alloc, base, "moved");
    val marker: str = abs_of(?alloc, base, "original/marker");
    fin { str_free(?alloc, original); str_free(?alloc, moved); str_free(?alloc, marker); }
    if (O.is_some[str](fs.create_dir(original, 0o755))) { ret 3; }
    var root_storage_37: Root;
    val opened: O.Option[Error] = root_open(?root_storage_37, original, "");
    if (O.is_some[Error](opened)) { ret 4; }
    val r: *Root = ?root_storage_37;
        fin { root_dnit(r); }


    if (os.rename(os.AT_FDCWD, original, os.AT_FDCWD, moved) < 0) { ret 5; }
        var r_session: TestSession;
        if (O.is_some[Error](t_session_init(?r_session, ?alloc, r))) { ret 90; }
        fin { t_session_dnit(?r_session); }
    if (O.is_some[str](fs.create_dir(original, 0o755))) { ret 6; }
    if (O.is_some[str](fs.write_bytes(marker, "untouched", 9, 0o644))) { ret 7; }
    var inv: Inventory = inventory_init(?alloc);
    fin { inventory_dnit(?inv); }
    if (O.is_some[Error](inventory_push(?inv, entry_file("implicit/deep/data", "nested", 6, 0o640)))) { ret 8; }
    if (O.is_some[Error](inventory_push(?inv, entry_dir("explicit/empty", 0o750)))) { ret 9; }
    if (O.is_some[Error](inventory_push(?inv, entry_file("manifest", "complete", 8, 0o644)))) { ret 10; }
    var prepared_storage: Transaction;
        val prepared: O.Option[Error] = prepare_subtree(?prepared_storage, ?alloc, t_reserve(?r_session, "project"), ?inv, 0o755, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (prepared_storage.state == STATE_PREPARED) { abort(?prepared_storage); } }
    if (O.is_some[Error](prepared)) { ret 11; }
    val t: *Transaction = ?prepared_storage;
    val committed: R.Result[Outcome, Error] = commit(t);
    if (R.is_err[Outcome, Error](committed)) { ret 12; }
    val nested: O.Option[str] = read_back(?alloc, moved, "project/implicit/deep/data");
    if (O.is_none[str](nested)) { ret 13; }
    val nested_text: str = O.unwrap[str](nested);
    fin { str_free(?alloc, nested_text); }
    if (!str_equals(nested_text, "nested")) { ret 14; }
    val manifest: O.Option[str] = read_back(?alloc, moved, "project/manifest");
    if (O.is_none[str](manifest)) { ret 15; }
    val manifest_text: str = O.unwrap[str](manifest);
    fin { str_free(?alloc, manifest_text); }
    if (!str_equals(manifest_text, "complete")) { ret 16; }
    val empty: str = abs_of(?alloc, moved, "project/explicit/empty");
    fin { str_free(?alloc, empty); }
    if (!fs.is_dir(empty)) { ret 17; }
    val kept: O.Option[str] = read_back(?alloc, original, "marker");
    if (O.is_none[str](kept)) { ret 18; }
    val kept_text: str = O.unwrap[str](kept);
    fin { str_free(?alloc, kept_text); }
    if (!str_equals(kept_text, "untouched")) { ret 19; }
    if (payload_entry_count(?alloc, original) != 1 || payload_entry_count(?alloc, moved) != 1) { ret 20; }
    ret 0;
}

test "std.filesystem.transaction.prepare_subtree: staged symlinks cannot redirect inventory writes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val base_r: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](base_r)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](base_r);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    val staging: str = abs_of(?alloc, base, "staging");
    val outside: str = abs_of(?alloc, base, "outside");
    val marker: str = abs_of(?alloc, base, "outside/marker");
    val directory_link: str = abs_of(?alloc, base, "staging/redirect");
    val file_link: str = abs_of(?alloc, base, "staging/linked-file");
    fin {
        str_free(?alloc, staging); str_free(?alloc, outside); str_free(?alloc, marker);
        str_free(?alloc, directory_link); str_free(?alloc, file_link);
    }
    if (O.is_some[str](fs.create_dir(staging, 0o755))) { ret 3; }
    if (O.is_some[str](fs.create_dir(outside, 0o755))) { ret 4; }
    if (O.is_some[str](fs.write_bytes(marker, "untouched", 9, 0o644))) { ret 5; }
    if (O.is_some[str](fs.symlink(outside, directory_link))) { ret 6; }
    if (O.is_some[str](fs.symlink(marker, file_link))) { ret 7; }
    var root_storage_38: Root;
    val opened: O.Option[Error] = root_open(?root_storage_38, staging, "");
    if (O.is_some[Error](opened)) { ret 8; }
    val r: *Root = ?root_storage_38;
        fin { root_dnit(r); }
        var r_session: TestSession;
        if (O.is_some[Error](t_session_init(?r_session, ?alloc, r))) { ret 90; }
        fin { t_session_dnit(?r_session); }

    var nested: Entry = entry_file("redirect/new-file", "escaped", 7, 0o644);
    var direct: Transaction = Transaction{alloc: ?alloc, staging_fd: r.dirfd};
    var injected: Inventory = inventory_init(?alloc);
    fin { inventory_dnit(?injected); }
    inventory_push(?injected, nested);
    val nested_error: O.Option[Error] = build_subtree(?direct, ?injected);
    if (O.is_none[Error](nested_error)) { ret 9; }
    if (O.unwrap[Error](nested_error).kind != CONTAINMENT) { ret 10; }
    var linked: Entry = entry_file("linked-file", "corrupt", 7, 0o644);
    injected.entries.len = 0;
    inventory_push(?injected, linked);
    if (O.is_none[Error](build_subtree(?direct, ?injected))) { ret 11; }
    val kept: O.Option[str] = read_back(?alloc, outside, "marker");
    if (O.is_none[str](kept)) { ret 12; }
    val text: str = O.unwrap[str](kept);
    fin { str_free(?alloc, text); }
    if (!str_equals(text, "untouched")) { ret 13; }
    if (payload_entry_count(?alloc, outside) != 1) { ret 14; }
    ret 0;
}
fun t_journal_max_leaf(name: *u8) {
    var i: usize = 0;
    $if ($mach.build.os == $mach.os.windows) {
        for (i < 255) {
            name[i * 3] = 0xe7;
            name[i * 3 + 1] = 0x95;
            name[i * 3 + 2] = 0x8c;
            i = i + 1;
        }
        name[765] = 0;
    }
    $or {
        for (i < 255) { name[i] = 'a'; i = i + 1; }
        name[255] = 0;
    }
}

fun t_journal_publish(a: *A.Allocator, session: *TestSession, leaf: str, content: str) i32 {
    val root: *Root = session.held.root;
    var prepared_storage: Transaction;
        val prepared: O.Option[Error] = prepare_bytes(?prepared_storage, a, t_reserve(session, leaf), content, str_len(content), 0o644, false, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (prepared_storage.state == STATE_PREPARED) { abort(?prepared_storage); } }
    if (O.is_some[Error](prepared)) { ret 1; }
    val t: *Transaction = ?prepared_storage;
    val committed: R.Result[Outcome, Error] = commit(t);
    if (R.is_err[Outcome, Error](committed)) { ret 2; }
    ret 0;
}

fun t_journal_run(body: fun(*A.Allocator, *TestSession, str) i32) i32 {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?a);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    var bad: i32 = 0;
    var root_storage_39: Root;
    val opened: O.Option[Error] = root_open(?root_storage_39, base, "");
    if (O.is_some[Error](opened)) { bad = 3; }
    or {
        val root: *Root = ?root_storage_39;
        fin { root_dnit(root); }
        var root_session: TestSession;
        if (O.is_some[Error](t_session_init(?root_session, ?a, root))) { ret 90; }
        fin { t_session_dnit(?root_session); }
        bad = body(?a, ?root_session, base);
    }
    fs.remove_all(?a, base);
    str_free(?a, base);
    ret bad;
}

fun t_journal_max_file(a: *A.Allocator, session: *TestSession, base: str) i32 {
    val root: *Root = session.held.root;
    var name: [766]u8;
    t_journal_max_leaf(?name[0]);
    val leaf: str = (?name[0])::str;
    if (t_journal_publish(a, session, leaf, "before") != 0) { ret 4; }
    if (t_journal_publish(a, session, leaf, "after") != 0) { ret 5; }
    var content: [16]u8;
    val read: R.Result[O.Option[usize], Error] = entry_read_all(root, leaf, ?content[0], 16);
    if (R.is_err[O.Option[usize], Error](read)) { ret 6; }
    if (!str_equals((?content[0])::str, "after")) { ret 7; }
    val swept: R.Result[usize, Error] = t_end_batch_and_recover(session, leaf);
    if (R.is_err[usize, Error](swept)) { ret 8; }
    if (R.unwrap_ok[usize, Error](swept) != 0) { ret 9; }
    if (O.is_some[Error](entry_unlink(t_reserve(session, leaf)))) { ret 10; }
    if (payload_entry_count(a, base) != 0) { ret 11; }
    ret 0;
}

test "std.filesystem.transaction: maximum native destination names publish replace and recover" {
    ret t_journal_run(t_journal_max_file);
}

fun t_fixture_write(root: *Root, leaf: str, content: str) i32 {
    val opened: i64 = os.open(root.dirfd, leaf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644);
    if (opened < 0) { ret 1; }
    val wrote: i64 = os.write(opened::i32, content, str_len(content));
    val closed: i64 = os.close(opened::i32);
    if (wrote != str_len(content)::i64 || closed < 0) { ret 2; }
    ret 0;
}

fun t_journal_child_write(a: *A.Allocator, root: *Root, leaf: str, content: str) i32 {
    val opened: i64 = os.open(root.dirfd, leaf, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (opened < 0) { ret 1; }
    var child: Root;
    if (ownership.root_init(?child, opened::i32) < 0) { os.close(opened::i32); ret 99; }
    val result: i32 = t_fixture_write(?child, "entry", content);
    root_dnit(?child);
    ret result;
}

fun t_journal_child_has(root: *Root, leaf: str, content: str) bool {
    val opened: i64 = os.open(root.dirfd, leaf, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (opened < 0) { ret false; }
    var child: Root;
    if (ownership.root_init(?child, opened::i32) < 0) { os.close(opened::i32); ret false; }
    var bytes: [16]u8;
    val read: R.Result[O.Option[usize], Error] = entry_read_all(?child, "entry", ?bytes[0], 16);
    root_dnit(?child);
    if (R.is_err[O.Option[usize], Error](read)) { ret false; }
    val count: O.Option[usize] = R.unwrap_ok[O.Option[usize], Error](read);
    ret O.is_some[usize](count) && O.unwrap[usize](count) == str_len(content)
        && str_equals((?bytes[0])::str, content);
}

fun t_journal_owns(ctx: *i32, name: str, directory: bool) bool {
    ret str_equals(name, "entry") && !directory;
}

fun t_journal_empty_directory(a: *A.Allocator, session: *TestSession, leaf: str) i32 {
    val root: *Root = session.held.root;
    var prepared_storage: Transaction;
        val prepared: O.Option[Error] = prepare_dir(?prepared_storage, a, t_reserve(session, leaf), 0o755, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (prepared_storage.state == STATE_PREPARED) { abort(?prepared_storage); } }
