}

fun t_root_operations(a: *A.Allocator, session: *TestSession) i32 {
    val root: *Root = session.held.root;
    if (t_publish(a, session, "x", "content") != 0) { ret 1; }
    if (O.is_some[Error](entry_rename(t_reserve(session, "x"), t_reserve(session, "y")))) { ret 2; }
    var buf: [16]u8;
    val read: R.Result[O.Option[usize], Error] = entry_read_all(root, "y", ?buf[0], 16);
    if (R.is_err[O.Option[usize], Error](read)) { ret 3; }
    val found: O.Option[usize] = R.unwrap_ok[O.Option[usize], Error](read);
    if (O.is_none[usize](found) || O.unwrap[usize](found) != 7) { ret 4; }
    if (!str_equals((?buf[0])::str, "content")) { ret 5; }

    $if ($mach.build.os != $mach.os.darwin) {
    var stale_storage: Transaction;
        val stale: O.Option[Error] = prepare_bytes(?stale_storage, a, t_reserve(session, "y"), "stale", 5, 0o644, false, PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()});
        fin { if (stale_storage.state == STATE_PREPARED) { abort(?stale_storage); } }
    if (O.is_some[Error](stale)) { ret 6; }
    val t: *Transaction = ?stale_storage;
    if (t_fixture_write(root, "outsider", "winner") != 0) { abort(t); ret 7; }
    if (os.rename(root.dirfd, "outsider", root.dirfd, "y") < 0) { abort(t); ret 7; }
    val conflict: R.Result[Outcome, Error] = commit(t);
    if (R.is_ok[Outcome, Error](conflict)) { ret 8; }
    if (R.unwrap_err[Outcome, Error](conflict).kind != PRECONDITION) { ret 9; }
    var winner: [16]u8;
    val wr: R.Result[O.Option[usize], Error] = entry_read_all(root, "y", ?winner[0], 16);
    if (R.is_err[O.Option[usize], Error](wr)) { ret 10; }
    if (!str_equals((?winner[0])::str, "winner")) { ret 11; }

    }
    if (R.is_err[bool, Error](entry_make_dir(t_reserve(session, "sub"), 0o755))) { ret 12; }
    if (O.is_some[Error](entry_rename(t_reserve(session, "sub"), t_reserve(session, "r")))) { ret 13; }
    val child_raw: i64 = os.open(root.dirfd, "r", os.O_RDONLY | os.O_DIRECTORY, 0);
    if (child_raw < 0) { ret 14; }
    var child: Root;
    if (ownership.root_init(?child, child_raw::i32) < 0) { os.close(child_raw::i32); ret 99; }
    val published: i32 = t_fixture_write(?child, "inner", "kept");
    root_dnit(?child);
    if (published != 0) { ret 15; }
    val removed: R.Result[usize, Error] = root_remove_tree(t_reserve(session, "r"), "");
    if (R.is_err[usize, Error](removed)) { ret 16; }
    if (R.unwrap_ok[usize, Error](removed) != 2) { ret 17; }
    if (O.is_some[Error](entry_unlink(t_reserve(session, "y")))) { ret 18; }
    val probe: R.Result[EntryProbe, Error] = entry_probe(root, "y");
    if (R.is_err[EntryProbe, Error](probe)) { ret 19; }
    if (R.unwrap_ok[EntryProbe, Error](probe).present) { ret 20; }
    ret 0;
}

test "std.filesystem.transaction: publication and mutations retain a renamed root" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?a);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    val original: str = abs_of(?a, base, "original-\xc3\xa9");
    val moved: str = abs_of(?a, base, "moved-\xc3\xa9");
    var bad: i32 = 0;
    if (O.is_some[str](fs.create_dir(original, 0o755))) { bad = 3; }
    if (bad == 0) {
        var root_storage_41: Root;
        val opened: O.Option[Error] = root_open(?root_storage_41, base, "original-\xc3\xa9");
        if (O.is_some[Error](opened)) { bad = 4; }
        or {
            val root: *Root = ?root_storage_41;
        fin { root_dnit(root); }

            if (O.is_some[str](fs.rename(original, moved))) { bad = 5; }
            or (O.is_some[str](fs.create_dir(original, 0o755))) { bad = 6; }
            or (!t_mkfile(base, ?a, "original-\xc3\xa9/guard", "untouched")) { bad = 7; }
            or {
        var root_session: TestSession;
        if (O.is_some[Error](t_session_init(?root_session, ?a, root))) { ret 90; }
        fin { t_session_dnit(?root_session); }
                bad = t_root_operations(?a, ?root_session);
            }

        }
    }
    if (bad == 0) {
        val guard: O.Option[str] = read_back(?a, original, "guard");
        if (O.is_none[str](guard)) { bad = 21; }
        or {
            val content: str = O.unwrap[str](guard);
            if (!str_equals(content, "untouched")) { bad = 22; }
            str_free(?a, content);
        }
        if (payload_entry_count(?a, original) != 1 || payload_entry_count(?a, moved) != 0) { bad = 23; }
    }
    fs.remove_all(?a, base);
    str_free(?a, original);
    str_free(?a, moved);
    str_free(?a, base);
    ret bad;
}

fun t_scan_entries(fd: i32) i32 {
    var seen: u64 = 0;
    var storage: os.dirent64;
    val capacity: usize = $size_of(os.dirent64);
    var calls: usize = 0;
    for (calls < 128) {
        calls = calls + 1;
        val n: i64 = os.read_dir(fd, ?storage, capacity);
        if (n < 0) { ret 1; }
        if (n == 0) {
            if (seen != 0xffffffffffffffff) { ret 2; }
            if (os.read_dir(fd, ?storage, capacity) != 0) { ret 3; }
            ret 0;
        }
        var pos: usize = 0;
        for (pos < n::usize) {
            val entry: *os.dirent64 = ((?storage)::usize + pos)::*os.dirent64;
            val name: str = (?entry.d_name[0])::str;
            if (!dot_entry(name)) {
                if (str_len(name) != 7 || name[0] != 'i' || name[1] != 't'
                    || name[2] != 'e' || name[3] != 'm' || name[4] != '-'
                    || name[5] < 'a' || name[5] > 'd' || name[6] < 'a' || name[6] > 'p') { ret 4; }
                val slot: u64 = (name[5] - 'a')::u64 * 16 + (name[6] - 'a')::u64;
                val bit: u64 = 1::u64 << slot;
                if ((seen & bit) != 0) { ret 5; }
                seen = seen | bit;
            }
            val size: usize = entry.d_reclen::usize;
            if (size == 0 || size > n::usize - pos) { ret 6; }
            pos = pos + size;
        }
    }
    ret 7;
}

fun t_fill_and_scan(a: *A.Allocator, root: *Root) i32 {
    var name: [8]u8 = [8]u8{'i', 't', 'e', 'm', '-', 'a', 'a', 0};
    var i: u8 = 0;
    for (i < 64) {
        name[5] = 'a' + i / 16;
        name[6] = 'a' + i % 16;
        if (t_fixture_write(root, (?name[0])::str, "x") != 0) { ret 1; }
        i = i + 1;
    }
    val first: i32 = t_scan_entries(root.dirfd);
    if (first != 0) { ret first + 10; }
    if (os.seek(root.dirfd, 0, os.SEEK_SET) < 0) { ret 2; }
    val again: i32 = t_scan_entries(root.dirfd);
    if (again != 0) { ret again + 20; }
    ret 0;
}

test "std.filesystem.transaction: directory batches retain every entry and rewind before cleanup" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?a);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    var bad: i32 = 0;
    var root_storage_42: Root;
    val opened: O.Option[Error] = root_open(?root_storage_42, base, "");
    if (O.is_some[Error](opened)) { bad = 3; }
    or {
        val root: *Root = ?root_storage_42;
        fin { root_dnit(root); }
        var root_session: TestSession;
        if (O.is_some[Error](t_session_init(?root_session, ?a, root))) { ret 90; }
        fin { t_session_dnit(?root_session); }
        if (R.is_err[bool, Error](entry_make_dir(t_reserve(?root_session, "many"), 0o755))) { bad = 4; }
        or {
            val child_raw: i64 = os.open(root.dirfd, "many", os.O_RDONLY | os.O_DIRECTORY, 0);
            if (child_raw < 0) { bad = 5; }
            or {
                var child: Root;
    if (ownership.root_init(?child, child_raw::i32) < 0) { os.close(child_raw::i32); ret 99; }
                bad = t_fill_and_scan(?a, ?child);
                root_dnit(?child);
            }
        }
        if (bad == 0) {
            val removed: R.Result[usize, Error] = root_remove_tree(t_reserve(?root_session, "many"), "");
            if (R.is_err[usize, Error](removed)) { bad = 6; }
            or (R.unwrap_ok[usize, Error](removed) != 65) { bad = 7; }
            if (payload_entry_count(?a, base) != 0) { bad = 8; }
        }

    }
    # preserve failed scans for inspection without enumerating through the same defect
    if (bad == 0) { fs.remove_all(?a, base); }
    str_free(?a, base);
    ret bad;
}

