fun t_listing_allocation_ordinals(a: *A.Allocator, session: *TestSession, base: str) i32 {
    val parent: *Root = session.held.root;
    if (os.make_dir(parent.dirfd, "listing", 0o700) < 0) { ret 20; }
    val opened: i64 = os.open(parent.dirfd, "listing", os.O_RDONLY | os.O_DIRECTORY, 0);
    if (opened < 0) { ret 21; }
    var listing: Root;
    if (ownership.root_init(?listing, opened::i32) < 0) { os.close(opened::i32); ret 22; }
    val root: *Root = ?listing;
    fin { root_dnit(root); }
    var i: usize = 0;
    for (i < 9) {
        val formatted: R.Result[str, str] = format.sprint(a, "entry-{}", i);
        if (R.is_err[str, str](formatted)) { ret 4; }
        val name: str = R.unwrap_ok[str, str](formatted);
        val fd: i64 = os.open(root.dirfd, name, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644);
        str_free(a, name);
        if (fd < 0) { ret 5; }
        if (os.close(fd::i32) < 0) { ret 6; }
        i = i + 1;
    }

    var bad: i32 = 0;
    var allocations: usize = 0;
    var ordinal: usize = 0;
    for (ordinal <= allocations + 1 && bad == 0) {
        var tracker: testing.Testing;
        if (O.is_some[str](testing.make(?tracker))) { ret 7; }
        testing.fail_at_ordinal(?tracker, ordinal);
        val owned: *A.Allocator = testing.allocator_of(?tracker);
        var names: Vector[str] = vector.init[str](owned);
        if (os.seek(root.dirfd, 0, os.SEEK_SET) < 0) { bad = 8; }
        or {
            val listed: O.Option[Error] = list_entries(owned, root.dirfd, ?names);
            if (ordinal == 0) {
                allocations = tracker.attempts;
                if (allocations <= 9) { bad = 9; }
            }
            if (ordinal != 0 && ordinal <= allocations) {
                if (O.is_none[Error](listed)) { bad = 10; }
                or {
                    val err: Error = O.unwrap[Error](listed);
                    if (err.kind != MEMORY || err.op != OP_RECOVER) { bad = 11; }
                }
                if (tracker.attempts != ordinal) { bad = 12; }
            }
            or {
                if (O.is_some[Error](listed)) { bad = 13; }
                if (names.len != 9) { bad = 14; }
            }
            i = 0;
            for (i < names.len && bad == 0) {
                val name: str = names.data[i];
                if (str_len(name) != 7) { bad = 15; }
                or {
                    val prefix: str = "entry-";
                    var j: usize = 0;
                    for (j < 6) {
                        if (name[j] != prefix[j]) { bad = 15; }
                        j = j + 1;
                    }
                    if (name[6] < '0' || name[6] > '8') { bad = 15; }
                }
                var earlier: usize = 0;
                for (earlier < i) {
                    if (str_equals(name, names.data[earlier])) { bad = 16; }
                    earlier = earlier + 1;
                }
                i = i + 1;
            }
        }
        free_names(owned, ?names);
        if (testing.leaked(?tracker)) { bad = 17; }
        if (testing.double_free_count(?tracker) != 0) { bad = 18; }
        if (testing.tracking_exhausted(?tracker)) { bad = 19; }
        testing.dnit(?tracker);
        ordinal = ordinal + 1;
    }
    ret bad;
}

test "std.filesystem.transaction.list_entries: every allocation failure retains exact name ownership" {
    ret t_journal_run(t_listing_allocation_ordinals);
}

fun t_held_rename_contents(fd: i32, content: str) bool {
    if (os.seek(fd, 0, os.SEEK_SET) < 0) { ret false; }
    var bytes: [3]u8;
    if (os.read(fd, ?bytes[0], 3) != 3) { ret false; }
    ret bytes[0] == content[0] && bytes[1] == content[1] && bytes[2] == content[2];
}

test "std.filesystem.transaction.commit: held destinations retain old content through root rename" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val br: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](br)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](br);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    val mr: R.Result[str, str] = format.sprint(?alloc, "{}-moved", base);
    if (R.is_err[str, str](mr)) { ret 3; }
    val moved: str = R.unwrap_ok[str, str](mr);
    fin { fs.remove_all(?alloc, moved); str_free(?alloc, moved); }
    var root_storage_48: Root;
    val rr: O.Option[Error] = root_open(?root_storage_48, base, "");
    if (O.is_some[Error](rr)) { ret 4; }
    val root: *Root = ?root_storage_48;
        fin { root_dnit(root); }


    if (O.is_some[str](fs.rename(base, moved))) { ret 7; }
        var root_session: TestSession;
        if (O.is_some[Error](t_session_init(?root_session, ?alloc, root))) { ret 90; }
        fin { t_session_dnit(?root_session); }
    val held: i64 = os.open(root.dirfd, "b", os.O_CREAT | os.O_EXCL | os.O_RDWR, 0o600);
    if (held < 0) { ret 5; }
    fin { os.close(held::i32); }
    if (os.write(held::i32, "old", 3) != 3) { ret 6; }
    var pr_storage: Transaction;
        val pr: O.Option[Error] = prepare_bytes(?pr_storage, ?alloc, t_reserve(?root_session, "b"), "new", 3, 0o600, false, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (pr_storage.state == STATE_PREPARED) { abort(?pr_storage); } }
    if (O.is_some[Error](pr)) { ret 8; }
    val transaction: *Transaction = ?pr_storage;
    val committed: R.Result[Outcome, Error] = commit(transaction);
    if (R.is_err[Outcome, Error](committed)) { ret 74; }
    if (!t_held_rename_contents(held::i32, "old")) { ret 10; }
    val next: i64 = os.open(root.dirfd, "b", os.O_RDONLY, 0);
    if (next < 0) { ret 11; }
    fin { os.close(next::i32); }
    if (!t_held_rename_contents(next::i32, "new")) { ret 12; }
    if (os.seek(held::i32, 0, os.SEEK_SET) < 0) { ret 13; }
    if (os.write(held::i32, "pin", 3) != 3) { ret 14; }
    if (!t_held_rename_contents(held::i32, "pin")) { ret 15; }
    if (!t_held_rename_contents(next::i32, "new")) { ret 16; }
    ret 0;
}

test "std.filesystem.transaction.ownership: public descent refuses destruction while its root is claimed" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val base: str = "mach_583_public_descent";
    if (os.make_dir(os.AT_FDCWD, base, 0o700) < 0) { ret 2; }
    fin { fs.remove_all(?alloc, base); }
    var descent: Descent;
    val found: R.Result[bool, Error] = descend(?descent, ?alloc, base, "first/second");
    if (R.is_err[bool, Error](found) || !R.unwrap_ok[bool, Error](found)) { ret 3; }
    fin { descent_dnit(?alloc, ?descent); }
    var copied: Descent = descent;
    val refused_copy: O.Option[Error] = descent_dnit(?alloc, ?copied);
    if (O.is_none[Error](refused_copy) || O.unwrap[Error](refused_copy).kind != INVALID) { ret 4; }
    var held: Lock;
    if (O.is_some[Error](lock(?held, ?descent.root))) { ret 5; }
    fin { unlock(?held); }
    val refused_live: O.Option[Error] = descent_dnit(?alloc, ?descent);
    if (O.is_none[Error](refused_live) || O.unwrap[Error](refused_live).kind != INVALID) { ret 6; }
    if (!str_equals(descent.first_missing, "first") || !str_equals(descent.remainder, "second")) { ret 7; }
    if (root_fd(?descent.root) < 0) { ret 8; }
    if (O.is_some[Error](unlock(?held)) || O.is_some[Error](descent_dnit(?alloc, ?descent))) { ret 9; }
    if (descent.first_missing != nil || descent.remainder != nil || root_fd(?descent.root) >= 0) { ret 10; }
    ret 0;
}

test "std.filesystem.transaction.claim: planning owns reservations across active use and failed competitors" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val base: str = "mach_583_planned_claims";
    if (os.make_dir(os.AT_FDCWD, base, 0o700) < 0) { ret 2; }
    fin { fs.remove_all(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var held: Lock;
    if (O.is_some[Error](lock(?held, ?root))) { ret 4; }
    fin { unlock(?held); }
    if (ownership.begin_recovery(?held) < 0) { ret 5; }
    val initialized: i64 = ownership.initialize_claims(?held);
    ownership.end_recovery(?held, true);
    if (initialized < 0) { ret 6; }
    var first: Claim;
    var second: Claim;
    if (O.is_some[Error](claim(?first, ?alloc, ?held, "first"))) { ret 7; }
    fin { release_claim(?first); }
    if (O.is_some[Error](claim(?second, ?alloc, ?held, "second"))) { ret 8; }
    fin { release_claim(?second); }
    var competitor: Claim;
    val refused: O.Option[Error] = claim(?competitor, ?alloc, ?held, "first");
    if (O.is_none[Error](refused) || O.unwrap[Error](refused).kind != CONFLICT || held.borrowers != 2) { ret 9; }
    var copied: Claim = first;
    val refused_copy: O.Option[Error] = release_claim(?copied);
    if (O.is_none[Error](refused_copy) || O.unwrap[Error](refused_copy).kind != INVALID) { ret 10; }
    if (O.is_some[Error](borrow_claim(?first, OP_PREPARE))) { ret 11; }
    val refused_live: O.Option[Error] = release_claim(?first);
    if (O.is_none[Error](refused_live) || O.unwrap[Error](refused_live).kind != INVALID) { ret 12; }
    if (O.is_none[Error](borrow_claim(?first, OP_PREPARE))) { ret 13; }
    return_claim(?first);
    if (!str_equals(claim_leaf(?first), "first") || !str_equals(claim_leaf(?second), "second") || held.borrowers != 2) { ret 14; }
    var worker: Worker;
    if (O.is_some[Error](borrow_worker(?worker, ?held))) { ret 15; }
    if (ownership.begin_recovery(?held) != os.EINVAL) { release_worker(?worker); ret 16; }
    if (O.is_some[Error](release_worker(?worker))) { ret 17; }
    if (O.is_some[Error](release_claim(?first)) || held.borrowers != 1) { ret 18; }
    if (O.is_some[Error](release_claim(?second)) || held.borrowers != 0) { ret 19; }
    if (ownership.begin_recovery(?held) < 0) { ret 20; }
    ownership.end_recovery(?held, true);
    ret 0;
}

test "std.filesystem.transaction.lifecycle: copied and invalid commits preserve exactly one claim owner" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (O.is_some[Error](t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var first: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()};
    if (O.is_some[Error](prepare_bytes(?first, ?alloc, destination, "old", 3, 0o600, false, options))) { ret 6; }
    fin { if (prepared(?first)) { abort(?first); } }
    var copied: Transaction = first;
    val refused: R.Result[Outcome, Error] = commit(?copied);
    if (R.is_ok[Outcome, Error](refused)) { first.state = STATE_SPENT; ret 7; }
    if (R.unwrap_err[Outcome, Error](refused).kind != INVALID) {
        if (!destination.active) { first.state = STATE_SPENT; }
        ret 7;
    }
    if (O.is_none[Error](abort(?copied)) || !prepared(?first) || !destination.active) { ret 8; }
    var competing: Transaction;
    val conflict: O.Option[Error] = prepare_bytes(?competing, ?alloc, destination, "bad", 3, 0o600, false, options);
    if (O.is_none[Error](conflict) || O.unwrap[Error](conflict).kind != INVALID) { ret 9; }
    if (O.is_none[Error](release_claim(destination))) { ret 10; }
    var ctx: i32 = 0;
    val invalid: R.Result[Outcome, Error] = commit_replacing_owned[i32](?first, ?ctx, t_journal_owns);
    if (R.is_ok[Outcome, Error](invalid) || R.unwrap_err[Outcome, Error](invalid).kind != INVALID) { ret 11; }
    if (first.state != STATE_SPENT || destination.active || session.held.borrowers != 1) { ret 12; }
    if (payload_entry_count(?alloc, base) != 0) { ret 13; }
    if (O.is_some[Error](prepare_bytes(?first, ?alloc, destination, "new", 3, 0o600, false, options))) { ret 14; }
    if (R.is_err[Outcome, Error](commit(?first))) { ret 15; }
    if (O.is_none[Error](abort(?first)) || destination.active || session.held.borrowers != 1) { ret 16; }
    ret 0;
}

test "std.filesystem.transaction.lifecycle: preparation alone selects retained identity capability" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (O.is_some[Error](t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    val old: i64 = os.open(root.dirfd, "out", os.O_CREAT | os.O_EXCL | os.O_RDWR, 0o000);
    if (old < 0) { ret 6; }
    fin { os.close(old::i32); }
    if (os.write(old::i32, "old", 3) != 3) { ret 7; }
    var transaction: Transaction;
    val replace: PrepareOptions = PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()};
    if (O.is_some[Error](prepare_bytes(?transaction, ?alloc, destination, "new", 3, 0o000, false, replace))) { ret 8; }
    fin { if (prepared(?transaction)) { abort(?transaction); } }
    if (transaction.prior_fd != -1 || transaction.had_prior) { ret 9; }
    if (O.is_some[Error](abort(?transaction))) { ret 10; }
    val same: PrepareOptions = PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()};
    val retained: O.Option[Error] = prepare_bytes(?transaction, ?alloc, destination, "new", 3, 0o000, false, same);
    $if ($mach.build.os == $mach.os.darwin) {
        if (O.is_none[Error](retained) || O.unwrap[Error](retained).kind != UNSUPPORTED) { ret 11; }
        if (destination.active || transaction.state != STATE_SPENT) { ret 12; }
    }
    $or {
        if (O.is_some[Error](retained) || transaction.prior_fd < 0 || !transaction.had_prior) { ret 13; }
        val retained_fd: i32 = transaction.prior_fd;
        var observed: Identity;
        if (os.file_identity(retained_fd, ?observed) < 0 || !identity_equal(observed, transaction.prior)) { ret 18; }
        var byte: u8 = 0;
        if (os.read(transaction.prior_fd, ?byte, 1) >= 0) { ret 14; }
        if (os.seek(old::i32, 0, os.SEEK_SET) < 0 || os.write(old::i32, "edit", 4) != 4) { ret 15; }
        if (R.is_err[Outcome, Error](commit(?transaction))) { ret 16; }
        if (destination.active || transaction.prior_fd != -1) { ret 17; }
        var closed: os.stat_t;
        if (os.stat(retained_fd, ?closed) != os.EBADF) { ret 19; }
    }
    ret 0;
}

test "std.filesystem.transaction.lifecycle: recovery refuses live claims and closes failed admission" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (O.is_some[Error](t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var transaction: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()};
    if (O.is_some[Error](prepare_bytes(?transaction, ?alloc, destination, "new", 3, 0o600, false, options))) { ret 6; }
    fin { if (prepared(?transaction)) { abort(?transaction); } }
    val refused: R.Result[usize, Error] = recover(?alloc, ?session.held, "out");
    if (R.is_ok[usize, Error](refused) || R.unwrap_err[usize, Error](refused).kind != INVALID) { ret 7; }
    if (!prepared(?transaction) || !destination.active || payload_entry_count(?alloc, base) != 1) { ret 8; }
    if (O.is_some[Error](abort(?transaction))) { ret 9; }
    if (R.is_ok[usize, Error](recover(?alloc, ?session.held, "out"))) { ret 10; }
    if (O.is_some[Error](t_session_release_claims(?session))) { ret 11; }
    val opened: R.Result[i32, Error] = open_backup_container(root.dirfd, true);
    if (R.is_err[i32, Error](opened)) { ret 12; }
    val backup: i32 = R.unwrap_ok[i32, Error](opened);
    fin { os.close(backup); }
    val foreign: i64 = os.open(backup, "out", os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600);
    if (foreign < 0) { ret 13; }
    os.close(foreign::i32);
    val failed: R.Result[usize, Error] = recover(?alloc, ?session.held, "out");
    if (R.is_ok[usize, Error](failed) || R.unwrap_err[usize, Error](failed).kind != CONFLICT) { ret 14; }
    var claimant: Claim;
    val blocked: O.Option[Error] = claim(?claimant, ?alloc, ?session.held, "next");
    if (O.is_none[Error](blocked)) { release_claim(?claimant); ret 15; }
    if (O.unwrap[Error](blocked).kind != INVALID || session.held.initialized) { ret 16; }
    if (os.unlink(backup, "out", 0) < 0) { ret 17; }
    if (R.is_err[usize, Error](recover(?alloc, ?session.held, "out"))) { ret 18; }
    if (O.is_some[Error](claim(?claimant, ?alloc, ?session.held, "next"))) { ret 19; }
    if (O.is_some[Error](release_claim(?claimant))) { ret 20; }
    ret 0;
}

test "std.filesystem.transaction.durability: final private modes remain abortable after subtree barriers" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (O.is_some[Error](t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var inv: Inventory = inventory_init(?alloc);
    fin { inventory_dnit(?inv); }
    if (O.is_some[Error](inventory_push(?inv, entry_file("locked/inner/secret", "data", 4, 0o000)))) { ret 6; }
    if (O.is_some[Error](inventory_push(?inv, entry_dir("locked", 0o000)))) { ret 7; }
    if (O.is_some[Error](inventory_push(?inv, entry_dir("locked/inner", 0o000)))) { ret 8; }
    var transaction: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_ABSENT, durability: durability_full(true)};
    val built: O.Option[Error] = prepare_subtree(?transaction, ?alloc, destination, ?inv, 0o000, options);
    if (O.is_some[Error](built)) { ret 9; }
    fin { if (prepared(?transaction)) { abort(?transaction); } }
    if (!transaction.content_flushed) { ret 10; }
    var st: os.stat_t;
    if (os.stat(transaction.staging_fd, ?st) < 0) { ret 11; }
    $if ($mach.build.os != $mach.os.windows) {
        if ((os.stat_mode(?st) & 0o777) != 0) { ret 12; }
    }
    if (O.is_some[Error](abort(?transaction))) { ret 13; }
    if (payload_entry_count(?alloc, base) != 0 || destination.active) { ret 14; }
    if (O.is_some[Error](prepare_subtree(?transaction, ?alloc, destination, ?inv, 0o000, options))) { ret 15; }
    if (O.is_some[Error](transaction_cleanup(?transaction, false, OP_ABORT))) { ret 16; }
    val swept: R.Result[usize, Error] = t_end_batch_and_recover(?session, "out");
    if (R.is_err[usize, Error](swept) || R.unwrap_ok[usize, Error](swept) != 1) { ret 17; }
    if (payload_entry_count(?alloc, base) != 0) { ret 18; }
    ret 0;
}

fun t_alias_spelling(alloc: *A.Allocator, root: *Root) i32 {
    if (t_fixture_write(root, "Leaf", "value") != 0) { ret 1; }
    var st: os.stat_t;
    val observed: i64 = os.stat_path(root.dirfd, "leaf", ?st, os.AT_SYMLINK_NOFOLLOW);
    if (observed < 0 && observed != os.ENOENT) { ret 2; }
    val folded: bool = observed >= 0;
    var held: Lock;
    if (O.is_some[Error](lock(?held, root))) { ret 3; }
    fin { unlock(?held); }
    if (R.is_err[usize, Error](recover(alloc, ?held, ""))) { ret 4; }
    var destination: Claim;
    if (O.is_some[Error](claim(?destination, alloc, ?held, "Leaf"))) { ret 5; }
    fin { release_claim(?destination); }
    var competitor: Claim;
    val reserved: O.Option[Error] = claim(?competitor, alloc, ?held, "leaf");
    if (folded) {
        if (O.is_none[Error](reserved)) { release_claim(?competitor); ret 6; }
        if (O.unwrap[Error](reserved).kind != CONFLICT) { ret 7; }
    }
    or {
        if (O.is_some[Error](reserved)) { ret 8; }
        if (O.is_some[Error](release_claim(?competitor))) { ret 9; }
    }
    var foreign: Claim;
    if (O.is_some[Error](claim(?foreign, alloc, ?held, "Different"))) { ret 22; }
    fin { release_claim(?foreign); }
    if (t_fixture_write(root, "Different", "other") != 0) { ret 23; }
    val distinct: O.Option[Error] = entry_rename_alias(?destination, "Different");
    if (O.is_none[Error](distinct) || O.unwrap[Error](distinct).kind != CONFLICT) { ret 24; }
    if (!str_equals(claim_leaf(?destination), "Leaf") || entry_absent(root.dirfd, "Leaf")) { ret 25; }
    var other: [6]u8;
    val preserved: R.Result[O.Option[usize], Error] = entry_read_all(root, "Different", ?other[0], 6);
    if (R.is_err[O.Option[usize], Error](preserved) || !str_equals((?other[0])::str, "other")) { ret 26; }
    if (O.is_some[Error](entry_unlink(?foreign)) || O.is_some[Error](release_claim(?foreign))) { ret 27; }
    if (O.is_some[Error](borrow_claim(?destination, OP_COMMIT))) { ret 28; }
    val busy: O.Option[Error] = entry_rename_alias(?destination, "Leaf");
    return_claim(?destination);
    if (O.is_none[Error](busy) || O.unwrap[Error](busy).kind != INVALID) { ret 29; }
    val renamed: O.Option[Error] = entry_rename_alias(?destination, "leaf");
    if (folded) {
        if (O.is_some[Error](renamed)) { ret 10; }
        if (!str_equals(claim_leaf(?destination), "leaf")) { ret 11; }
        if (!str_equals(destination.reservation.name, "leaf")) { ret 12; }
        var bytes: [6]u8;
        val read: R.Result[O.Option[usize], Error] = entry_read_all(root, "leaf", ?bytes[0], 6);
        if (R.is_err[O.Option[usize], Error](read) || !str_equals((?bytes[0])::str, "value")) { ret 13; }
    }
    or {
        if (O.is_none[Error](renamed) || O.unwrap[Error](renamed).kind != CONFLICT) { ret 14; }
        if (!str_equals(claim_leaf(?destination), "Leaf")) { ret 15; }
        if (!entry_absent(root.dirfd, "leaf")) { ret 16; }
    }
    if (destination.active) { ret 17; }
    if (O.is_some[Error](entry_rename_alias(?destination, claim_leaf(?destination)))) { ret 18; }
    if (O.is_some[Error](entry_unlink(?destination))) { ret 19; }
    if (O.is_some[Error](release_claim(?destination))) { ret 20; }
    if (held.borrowers != 0) { ret 21; }
    ret 0;
}

test "std.filesystem.transaction.claim: alias spelling follows the root filesystem namespace" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    ret t_alias_spelling(?alloc, ?root);
}

test "std.filesystem.transaction.claim: distinct rename releases its first borrow when the second is busy" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var held: Lock;
    if (O.is_some[Error](lock(?held, ?root))) { ret 4; }
    fin { unlock(?held); }
    if (R.is_err[usize, Error](recover(?alloc, ?held, ""))) { ret 5; }
    var from: Claim;
    var to: Claim;
    if (O.is_some[Error](claim(?from, ?alloc, ?held, "source"))) { ret 6; }
    fin { release_claim(?from); }
    if (O.is_some[Error](claim(?to, ?alloc, ?held, "destination"))) { ret 7; }
    fin { release_claim(?to); }
    if (t_fixture_write(?root, "source", "keep") != 0) { ret 8; }
    if (O.is_some[Error](borrow_claim(?to, OP_COMMIT))) { ret 9; }
    val busy: O.Option[Error] = entry_rename(?from, ?to);
    if (O.is_none[Error](busy) || O.unwrap[Error](busy).kind != INVALID) { return_claim(?to); ret 10; }
    if (from.active || !to.active) { return_claim(?to); ret 11; }
    if (entry_absent(root.dirfd, "source") || !entry_absent(root.dirfd, "destination")) { return_claim(?to); ret 12; }
    return_claim(?to);
    if (O.is_some[Error](entry_rename(?from, ?to))) { ret 13; }
    if (!entry_absent(root.dirfd, "source") || entry_absent(root.dirfd, "destination")) { ret 14; }
    if (from.active || to.active || held.borrowers != 2) { ret 15; }
    ret 0;
}

test "std.filesystem.transaction.prior_access: readable outputs replace repeatedly with retained identity" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val scratch: R.Result[str, str] = scratch_root(?alloc);
    if (R.is_err[str, str](scratch)) { ret 2; }
    val base: str = R.unwrap_ok[str, str](scratch);
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (O.is_some[Error](root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (O.is_some[Error](t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var t: Transaction;
    fin { if (prepared(?t)) { abort(?t); } }
    val options: PrepareOptions = PrepareOptions{precondition: PRE_SAME_OBJECT,
        prior_access: READ_AUTHORIZED, durability: durability_none()};
    if (O.is_some[Error](prepare_bytes(?t, ?alloc, destination, "first", 5, 0o600, false, options))) { ret 6; }
    if (t.had_prior || R.is_err[Outcome, Error](commit(?t))) { ret 7; }
    if (O.is_some[Error](prepare_bytes(?t, ?alloc, destination, "second", 6, 0o600, false, options))) { ret 8; }
    if (!t.had_prior || t.prior_fd < 0) { ret 9; }
    val retained: i32 = t.prior_fd;
    var identity: Identity;
    if (os.file_identity(retained, ?identity) < 0 || !identity_equal(identity, t.prior)) { ret 10; }
    if (R.is_err[Outcome, Error](commit(?t))) { ret 11; }
    var closed: os.stat_t;
    if (os.stat(retained, ?closed) != os.EBADF || destination.active) { ret 12; }
    val invalid: PrepareOptions = PrepareOptions{precondition: PRE_REPLACE, prior_access: 2, durability: durability_none()};
    val denied: O.Option[Error] = prepare_bytes(?t, ?alloc, destination, "bad", 3, 0o600, false, invalid);
    if (O.is_none[Error](denied) || O.unwrap[Error](denied).kind != INVALID || destination.active) { ret 13; }
    ret 0;
}
