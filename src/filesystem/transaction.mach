# cooperative filesystem publication with explicit session ownership
#
# roots, locks, claims, workers and transactions remain at their initialized
# addresses. a copied owner cannot consume the original owner's resources.
# a caller supplies its authoritative coordinator scope, holds all root locks
# through recovery and worker completion, and reserves every planned destination
# before worker admission. independent claims can publish concurrently beneath
# one held root lock. a claim permits one active transaction or mutation at a time.
# commit, abort and failed preparation release that active use, while the session
# retains the reservation until its workers have joined.
#
# recovery requires the coordinator and root lock with no claims or workers.
# it resolves only the requested backup and sweeps recognized staging, preserving
# other destinations' backups and malformed content. successful recovery creates
# a fresh claims directory that inherits the root's native name equivalence.
# failed recovery leaves admission closed. the persistent lock sentinel is never
# unlinked by unlock. journal and claim ownership covers process interruption,
# not arbitrary noncooperative mutation, host restart or power-loss recovery.
#
# `.machtxn.<16 hex digits>` names private staging independently of destination
# length. owned replacement keeps the previous directory at `.machtxn.backup/leaf`.
# `.machtxn.claims/leaf` reserves the exact native destination name exclusively.
# the journal prefix and `.mach-txn-lock` are reserved case-insensitively on every
# platform. callers never place unrelated content in these namespaces.
#
# descriptor-relative nofollow walks preserve containment when ancestor names
# change. filesystem-qualified locks and claims enforce cooperative ownership.
# presence and type queries are observations only. same-object preparation alone
# retains the prior object and compares its complete local-domain identity at
# commit. it detects replacement, not in-place writes or all content changes.
# metadata-only retention is the default. explicit read authorization permits
# event-only darwin references where existing permissions allow the open.
# unsupported retention returns UNSUPPORTED without changing permissions.
#
# preparation selects both precondition and durability. DUR_NONE requests no
# barriers. DUR_FILE flushes file content through the original writable handles
# and flushes subtree directories after their children and final modes. DUR_FULL
# additionally flushes the publication parent after rename. required preparation
# barriers fail before publication, while a required parent-flush failure occurs
# after publication and does not undo it. permissive requests report aggregate
# shortfall without allowing an outer flush to hide a missing child barrier.
# windows directory persistence requires supported local ntfs and writable access.
# journal recovery does not infer a power-durable multi-root transaction from these
# per-publication barriers. callers serialize their own multi-root journal under
# the supplied coordinator and recover it before planning or recording baselines.
#
# ordinary commit uses one native rename. owned directory replacement uses two
# renames and may temporarily leave the destination absent. it never runs recovery
# while claims are live. every valid prepared transaction is consumed by commit,
# including an invalid owned-replacement request. failed validation leaves it owned.

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_starts_with;
use std.types.string.str_copy_slice;
use std.types.string.StrError;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.format;
use std.crypto.rand;
use std.crypto.hash.sha256;
use std.system.os;
use io_errors: std.io.error;
use removal: std.filesystem.removal;
use ownership: std.filesystem.transaction.ownership;
use identities: std.system.file_identity;
use std.sync.mutex;
fwd identities.Identity;
fwd identities.METADATA_ONLY;
fwd identities.READ_AUTHORIZED;
fwd ownership.Root;
fwd ownership.Lock;
$if ($mach.build.os == $mach.os.linux) { use nofollow_os: std.system.os.linux; }
$or ($mach.build.os == $mach.os.darwin) { use nofollow_os: std.system.os.darwin; }
use std.collections.vector;
use std.collections.vector.Vector;
use ehex: std.encoding.hex;
use m_writer: std.io.writer;
use std.io.writer.WriteError;
use std_io_error: std.io.error;
use fs: std.filesystem;
use std.types.path;
use std.types.path.Path;

use A: std.allocator;
use R: std.types.result;

# what went wrong. the set is closed: every failure this module reports is one
# of these, and no variant carries a message the caller has to parse.
pub def ErrorKind: u8;

# a name was not a single path component, or a walk left the root
pub val CONTAINMENT:  ErrorKind = 1;
# the destination did not satisfy the precondition asked for at commit
pub val PRECONDITION: ErrorKind = 2;
# a required durability level could not be achieved
pub val DURABILITY:   ErrorKind = 3;
# another process holds the root lock
pub val LOCK_HELD:    ErrorKind = 4;
# the destination changed underneath in a way the operation cannot absorb
pub val CONFLICT:     ErrorKind = 5;
# a validator rejected the staged content
pub val REJECTED:     ErrorKind = 6;
# the caller misused the interface: a spent transaction, a nil argument
pub val INVALID:      ErrorKind = 7;
# an allocation failed
pub val MEMORY:       ErrorKind = 8;
# the operating system refused, and `code` carries the errno
pub val IO:           ErrorKind = 9;
# entropy for a staging name was unavailable
pub val ENTROPY:      ErrorKind = 10;
# the backend cannot provide the requested contract
pub val UNSUPPORTED:  ErrorKind = 11;

# which step failed, so a caller can say where without this module having to
# build a sentence.
pub def Op: u8;
pub val OP_ROOT_OPEN: Op = 0;
pub val OP_LOCK:      Op = 1;
pub val OP_PREPARE:   Op = 2;
pub val OP_VALIDATE:  Op = 3;
pub val OP_COMMIT:    Op = 4;
pub val OP_ABORT:     Op = 5;
pub val OP_RECOVER:   Op = 6;
pub val OP_REMOVE:    Op = 7;

pub rec Error {
    kind: ErrorKind;
    op:   Op;
    # underlying producer errno when available, including native unsupported errors
    code: i64;
    # first independent cleanup failure
    cleanup_code: i64;
}

pub fun error(kind: ErrorKind, op: Op) Error {
    ret Error{kind: kind, op: op, code: 0};
}

pub fun io_error(op: Op, code: i64) Error {
    if (code == os.ENOTSUP) { ret Error{kind: UNSUPPORTED, op: op, code: code}; }
    ret Error{kind: IO, op: op, code: code};
}

fun with_cleanup_error(primary: Error, closed: i64) Error {
    var result: Error = primary;
    if (closed < 0 && result.cleanup_code == 0) { result.cleanup_code = closed; }
    ret result;
}

fun removal_error(op: Op, source: removal.Error) Error {
    var result: Error = io_error(op, source.code);
    if (source.containment) { result = Error{kind: CONTAINMENT, op: op, code: source.code}; }
    result.cleanup_code = source.cleanup_code;
    ret result;
}

# a stable description of the failure kind
#
# the returned string is a literal, so this never allocates and never returns
# an empty string. the offending path is deliberately absent: the caller passed
# it in and can name it far better than this module can.
# ---
# e:   the error to describe
# ret: a non-empty description of `e.kind`
pub fun error_message(e: Error) str {
    if (e.kind == CONTAINMENT)  { ret "path escapes the publication root"; }
    or (e.kind == PRECONDITION) { ret "destination changed since prepare"; }
    or (e.kind == DURABILITY)   { ret "required durability could not be achieved"; }
    or (e.kind == LOCK_HELD)    { ret "another process holds the publication root"; }
    or (e.kind == CONFLICT)     { ret "destination changed concurrently"; }
    or (e.kind == REJECTED)     { ret "staged content was rejected by the validator"; }
    or (e.kind == INVALID)      { ret "publication was used out of contract"; }
    or (e.kind == MEMORY)       { ret "out of memory"; }
    or (e.kind == ENTROPY)      { ret "entropy source failed"; }
    or (e.kind == IO)           { ret os.message(e.code); }
    or (e.kind == UNSUPPORTED)  { ret "filesystem does not support this publication contract"; }
    ret "unknown publication failure";
}

# a stable name for the step that failed
# ---
# e:   the error to describe
# ret: a non-empty name for `e.op`
pub fun error_op_name(e: Error) str {
    if (e.op == OP_ROOT_OPEN) { ret "opening the publication root"; }
    or (e.op == OP_LOCK)      { ret "locking the publication root"; }
    or (e.op == OP_PREPARE)   { ret "preparing the publication"; }
    or (e.op == OP_VALIDATE)  { ret "validating the staged content"; }
    or (e.op == OP_COMMIT)    { ret "committing the publication"; }
    or (e.op == OP_ABORT)     { ret "aborting the publication"; }
    or (e.op == OP_REMOVE)    { ret "removing a tree under the root"; }
    ret "recovering the publication root";
}

# complete observations have backend-qualified scope and do not retain an object
pub val IDENTITY_TEXT_CAPACITY: usize = identities.TEXT_CAPACITY;

pub fun identity_equal(a: Identity, b: Identity) bool {
    ret identities.equal(a, b);
}

pub fun identity_encode(value: Identity, out: *u8, capacity: usize) bool {
    ret identities.encode(value, out, capacity);
}

pub fun identity_decode(text: str, out: *Identity) bool {
    ret identities.decode(text, out);
}

# true when `name` is a single path component that can be published into
#
# `.` and `..` are refused because they do not name an entry to replace, and a
# separator is refused because a leaf is resolved against a directory
# descriptor and must not walk.
fun leaf_is_component(name: str) bool {
    if (str_empty(name)) { ret false; }
    if (str_equals(name, ".") || str_equals(name, "..")) { ret false; }
    val n: usize = str_len(name);
    var i: usize = 0;
    for (i < n) {
        if (name[i] == '/'::u8 || name[i] == '\\'::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun journal_prefix(name: str, prefix: str) bool {
    val size: usize = str_len(prefix);
    if (str_len(name) < size) { ret false; }
    var i: usize = 0;
    for (i < size) {
        var byte: u8 = name[i];
        if (byte >= 'A' && byte <= 'Z') { byte = byte + 32; }
        if (byte != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun publication_leaf(name: str) bool {
    if (!leaf_is_component(name)) { ret false; }
    if (journal_prefix(name, STAGING_TAG)) { ret false; }
    if (str_len(name) == str_len(LOCK_LEAF) && journal_prefix(name, LOCK_LEAF)) { ret false; }
    ret true;
}

# true when `rel` is a canonical relative path: no leading or trailing
# separator, no empty, `.` or `..` component, no backslash
fun rel_is_canonical(rel: str) bool {
    if (str_empty(rel)) { ret false; }
    if (rel[0] == '/'::u8) { ret false; }
    val n: usize = str_len(rel);
    if (rel[n - 1] == '/'::u8) { ret false; }
    var start: usize = 0;
    var i: usize = 0;
    for (i <= n) {
        if (i == n || rel[i] == '/'::u8) {
            if (i == start) { ret false; }
            val clen: usize = i - start;
            if (clen == 1 && rel[start] == '.'::u8) { ret false; }
            if (clen == 2 && rel[start] == '.'::u8 && rel[start + 1] == '.'::u8) { ret false; }
            start = i + 1;
        }
        or (rel[i] == '\\'::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a capability to publish into one directory
#
# holding a `Root` is the authority to write into that directory and nowhere
# else. it is a descriptor rather than a path so that the authority cannot be
# redirected after it was granted: renaming or replacing an ancestor does not
# change which directory the descriptor refers to.
#
rec ComponentScratch {
    name: str;
    size: usize;
}

fun copy_component(rel: str, start: usize, end: usize, op: Op) res[ComponentScratch, Error] {
    val length: usize = end - start;
    val size: usize = length + 1;
    val bytes: *u8 = os.allocate(size)::*u8;
    if (bytes == nil) { ret res[ComponentScratch, Error].err{error(MEMORY, op)}; }
    var i: usize = 0;
    for (i < length) { bytes[i] = rel[start + i]; i = i + 1; }
    bytes[length] = 0;
    ret res[ComponentScratch, Error].ok{ComponentScratch{name: bytes::str, size: size}};
}

fun free_component(component: *ComponentScratch) {
    os.deallocate(component.name::ptr, component.size);
    component.name = nil;
    component.size = 0;
}

# open a publication root
#
# walks `rel` beneath `base` one component at a time. each component must
# already exist and be a real directory, checked without following symlinks, so
# a symlinked ancestor is refused rather than traversed. passing an empty `rel`
# or `.` opens `base` itself.
# ---
# base: absolute or process-relative path of the anchor directory
# rel:  canonical relative path beneath `base`, or empty for `base` itself
# ret: none when initialized in caller-provided final storage
# failure retains the primary cause and first cleanup error, with no new root
# descriptors passed to close are consumed even when close reports an error
pub fun root_open(out: *Root, base: Path, rel: Path) err[Error] {
    if (out == nil) { ret err[Error].err{error(INVALID, OP_ROOT_OPEN)}; }
    val opened: res[i32, Error] = open_root_descriptor(base, rel);
    if (sel opened.err) { ret err[Error].err{opened.err}; }
    val fd: i32 = opened.ok;
    val initialized: i64 = ownership.root_init(out, fd);
    if (initialized < 0) {
        val closed: i64 = os.close(fd);
        ret err[Error].err{with_cleanup_error(error(INVALID, OP_ROOT_OPEN), closed)};
    }
    ret err[Error].ok{};
}

# derive an independently owned root from a held directory capability
# the caller keeps parent alive and reserves leaf across derivation and use
# no ancestor pathname is reconstructed and a symlink leaf is refused
pub fun root_open_child(out: *Root, parent: *Root, leaf: str) err[Error] {
    if (out == nil || !ownership.root_valid(parent)) { ret err[Error].err{error(INVALID, OP_ROOT_OPEN)}; }
    if (!leaf_is_component(leaf)) { ret err[Error].err{error(CONTAINMENT, OP_ROOT_OPEN)}; }
    val opened: res[i32, Error] = verified_directory(parent.dirfd, leaf, OP_ROOT_OPEN);
    if (sel opened.err) { ret err[Error].err{opened.err}; }
    val fd: i32 = opened.ok;
    val initialized: i64 = ownership.root_init(out, fd);
    if (initialized < 0) {
        val closed: i64 = os.close(fd);
        ret err[Error].err{with_cleanup_error(error(INVALID, OP_ROOT_OPEN), closed)};
    }
    ret err[Error].ok{};
}

fun open_root_descriptor(base: Path, rel: Path) res[i32, Error] {
    if (str_empty(base)) { ret res[i32, Error].err{error(INVALID, OP_ROOT_OPEN)}; }

    val base_raw: i64 = os.open(os.AT_FDCWD, base, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (base_raw < 0) { ret res[i32, Error].err{io_error(OP_ROOT_OPEN, base_raw)}; }
    var fd: i32 = base_raw::i32;

    if (str_empty(rel) || str_equals(rel, ".")) {
        ret res[i32, Error].ok{fd};
    }
    if (!rel_is_canonical(rel)) {
        val closed: i64 = os.close(fd);
        ret res[i32, Error].err{with_cleanup_error(error(CONTAINMENT, OP_ROOT_OPEN), closed)};
    }

    val n: usize = str_len(rel);
    var start: usize = 0;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }

        val copied: res[ComponentScratch, Error] = copy_component(rel, start, end, OP_ROOT_OPEN);
        if (sel copied.err) {
            val closed: i64 = os.close(fd);
            ret res[i32, Error].err{with_cleanup_error(copied.err, closed)};
        }
        var component: ComponentScratch = copied.ok;
        val next: res[i32, Error] = verified_directory(fd, component.name, OP_ROOT_OPEN);
        free_component(?component);
        val closed: i64 = os.close(fd);
        val advanced: res[i32, Error] = root_step_result(next, closed);
        if (sel advanced.err) { ret advanced; }
        fd = advanced.ok;
        start = end + 1;
    }

    ret res[i32, Error].ok{fd};
}

# next owns a descriptor only on success, and the prior descriptor is consumed
fun root_step_result(next: res[i32, Error], closed: i64) res[i32, Error] {
    if (sel next.err) {
        ret res[i32, Error].err{with_cleanup_error(next.err, closed)};
    }
    if (closed < 0) {
        val cleanup: i64 = os.close(next.ok);
        ret res[i32, Error].err{with_cleanup_error(io_error(OP_ROOT_OPEN, closed), cleanup)};
    }
    ret next;
}

# release a publication root
#
# idempotent: a second call is a no-op, so a caller may release on every exit
# path without tracking whether it already did.
pub fun root_dnit(r: *Root) err[Error] {
    val closed: i64 = ownership.root_destroy(r);
    if (closed == os.EINVAL) { ret err[Error].err{error(INVALID, OP_ROOT_OPEN)}; }
    if (closed < 0) { ret err[Error].err{io_error(OP_ROOT_OPEN, closed)}; }
    ret err[Error].ok{};
}

# the descriptor behind a root, for callers that must reach the operating
# system directly. the root retains ownership; do not close it.
pub fun root_fd(r: *Root) i32 {
    if (!ownership.root_valid(r)) { ret -1; }
    ret r.dirfd;
}

# the identity of the root directory itself
pub fun root_identity(r: *Root) res[Identity, Error] {
    if (!ownership.root_valid(r)) { ret res[Identity, Error].err{error(INVALID, OP_ROOT_OPEN)}; }
    var identity: Identity;
    val raw: i64 = os.file_identity(r.dirfd, ?identity);
    if (raw < 0) { ret res[Identity, Error].err{io_error(OP_ROOT_OPEN, raw)}; }
    ret res[Identity, Error].ok{identity};
}

# what a name under a root currently refers to
#
# probing through the root's descriptor rather than through a path is what
# makes the answer trustworthy: it describes an entry in the directory the
# capability was granted over, and cannot be redirected by an ancestor that
# changed since.
pub rec EntryProbe {
    present:      bool;
    is_regular:   bool;
    is_directory: bool;
}

# describe a name under a root
#
# a name that does not exist is not an error: the probe comes back absent. the
# lookup does not follow symlinks, so a symlink is reported as neither a
# regular file nor a directory.
# ---
# r:    the root to look in
# leaf: the name to describe, a single path component
# ret:  what is there, or why it could not be determined
pub fun entry_probe(r: *Root, leaf: str) res[EntryProbe, Error] {
    if (!ownership.root_valid(r))   { ret res[EntryProbe, Error].err{error(INVALID, OP_ROOT_OPEN)}; }
    if (!leaf_is_component(leaf))  { ret res[EntryProbe, Error].err{error(CONTAINMENT, OP_ROOT_OPEN)}; }

    var e: EntryProbe;
    var st: os.stat_t;
    val raw: i64 = os.stat_path(r.dirfd, leaf, ?st, os.AT_SYMLINK_NOFOLLOW);
    if (raw < 0) {
        if (raw == os.ENOENT) { ret res[EntryProbe, Error].ok{e}; }
        ret res[EntryProbe, Error].err{io_error(OP_ROOT_OPEN, raw)};
    }
    val mode: u32 = os.stat_mode(?st);
    e.present      = true;
    e.is_regular   = (mode & os.S_IFMT) == os.S_IFREG;
    e.is_directory = (mode & os.S_IFMT) == os.S_IFDIR;
    ret res[EntryProbe, Error].ok{e};
}

# identity is separate from presence and type, and may be unsupported
pub fun entry_identity(r: *Root, leaf: str) res[opt[Identity], Error] {
    if (!ownership.root_valid(r)) { ret res[opt[Identity], Error].err{error(INVALID, OP_ROOT_OPEN)}; }
    if (!leaf_is_component(leaf)) { ret res[opt[Identity], Error].err{error(CONTAINMENT, OP_ROOT_OPEN)}; }
    ret query_entry_identity(r.dirfd, leaf, OP_ROOT_OPEN);
}

# both distinct reservations are borrowed before native effects begin
pub fun entry_rename(from: *Claim, to: *Claim) err[Error] {
    val source: err[Error] = borrow_claim(from, OP_COMMIT);
    if (sel source.err) { ret source; }
    val target: err[Error] = borrow_claim(to, OP_COMMIT);
    if (sel target.err) { return_claim(from); ret target; }
    val renamed: i64 = os.rename(from.owner.root.dirfd, from.leaf, to.owner.root.dirfd, to.leaf);
    return_claim(to);
    return_claim(from);
    if (renamed < 0) { ret err[Error].err{io_error(OP_COMMIT, renamed)}; }
    ret err[Error].ok{};
}

# a native same-entry rename may preserve the existing on-disk spelling
pub fun entry_rename_alias(destination: *Claim, spelling: str) err[Error] {
    if (!publication_leaf(spelling)) { ret err[Error].err{error(CONTAINMENT, OP_COMMIT)}; }
    val borrowed: err[Error] = borrow_claim(destination, OP_COMMIT);
    if (sel borrowed.err) { ret borrowed; }
    fin { return_claim(destination); }
    var held_identity: Identity;
    val held: i64 = os.file_identity(destination.reservation.claim_fd, ?held_identity);
    if (held < 0) { ret err[Error].err{io_error(OP_COMMIT, held)}; }
    var alias_identity: Identity;
    val alias: i64 = os.identity_at(destination.owner.claims_fd, spelling, ?alias_identity);
    if (alias == os.ENOENT) { ret err[Error].err{error(CONFLICT, OP_COMMIT)}; }
    if (alias < 0) { ret err[Error].err{io_error(OP_COMMIT, alias)}; }
    if (!identity_equal(held_identity, alias_identity)) { ret err[Error].err{error(CONFLICT, OP_COMMIT)}; }
    val copied: res[str, A.Error] = str_dup(destination.alloc, spelling);
    if (sel copied.err) { ret err[Error].err{error(MEMORY, OP_COMMIT)}; }
    val name: str = copied.ok;
    val renamed: i64 = os.rename(destination.owner.root.dirfd, destination.leaf,
                                   destination.owner.root.dirfd, name);
    if (renamed < 0) {
        str_free(destination.alloc, name);
        ret err[Error].err{io_error(OP_COMMIT, renamed)};
    }
    val previous: str = destination.leaf;
    mutex.lock(?destination.gate);
    destination.leaf = name;
    destination.reservation.name = name;
    mutex.unlock(?destination.gate);
    str_free(destination.alloc, previous);
    ret err[Error].ok{};
}

# ordinary unlink policy is retained, including readonly-file refusal
pub fun entry_unlink(destination: *Claim) err[Error] {
    val borrowed: err[Error] = borrow_claim(destination, OP_ABORT);
    if (sel borrowed.err) { ret borrowed; }
    val removed: i64 = os.unlink(destination.owner.root.dirfd, destination.leaf, 0);
    return_claim(destination);
    if (removed < 0 && removed != os.ENOENT) { ret err[Error].err{io_error(OP_ABORT, removed)}; }
    ret err[Error].ok{};
}

# absent and nonempty directories remain successful cleanup no-ops
pub fun entry_rmdir_if_empty(destination: *Claim) err[Error] {
    val borrowed: err[Error] = borrow_claim(destination, OP_ABORT);
    if (sel borrowed.err) { ret borrowed; }
    val removed: i64 = os.unlink(destination.owner.root.dirfd, destination.leaf, os.AT_REMOVEDIR);
    return_claim(destination);
    if (removed < 0 && removed != os.ENOENT && removed != os.ENOTEMPTY) {
        ret err[Error].err{io_error(OP_ABORT, removed)};
    }
    ret err[Error].ok{};
}

# remove a tree under a root, by a path relative to it
#
# this is the removal a caller reaches for instead of validating a path with a
# string prefix check. containment is by construction rather than by comparison:
# `rel` is walked one component at a time against the root's own descriptor, so
# there is no absolute path to compare and no prefix to get wrong.
#
# every way out of the root is refused rather than silently ignored, and each
# comes back as CONTAINMENT:
#
#   - an absolute path, a `..` component, a `.` component, or an empty one,
#     none of which are canonical
#   - a symlink at any component of `rel`, its last included. one named by the
#     caller is refused rather than unlinked: removing the link itself would be
#     safe enough, but refusing means the capability never has to reason about
#     where a link points, and a caller that meant the link can unlink it by
#     name. a symlink FOUND INSIDE the tree during the descent is a different
#     thing and is unlinked, which removes the link and never its target
#   - a directory swapped for a symlink between the check and the descent,
#     refused by the native nofollow directory open
#   - a tree deeper than MAX_REMOVE_DEPTH, since depth is input too
#
# what it removed is reported only on success. a failure part-way returns the
# error and no count, because a partial count invites a caller to treat a
# failed removal as a smaller successful one. the entries removed before the
# failure stay removed: this reports what happened, it does not roll back.
# ---
# destination: reserved top-level leaf
# rel: canonical path beneath that leaf, empty to remove the leaf itself
# ret: how many entries were removed, or why the removal was refused
pub fun root_remove_tree(destination: *Claim, rel: Path) res[usize, Error] {
    if (!str_empty(rel) && !rel_is_canonical(rel)) { ret res[usize, Error].err{error(CONTAINMENT, OP_REMOVE)}; }
    val borrowed: err[Error] = borrow_claim(destination, OP_REMOVE);
    if (sel borrowed.err) { ret res[usize, Error].err{borrowed.err}; }
    fin { return_claim(destination); }
    val dirfd: i32 = destination.owner.root.dirfd;
    if (str_empty(rel)) {
        var removed: usize = 0;
        val result: err[Error] = remove_entry_checked(dirfd, destination.leaf, ?removed);
        if (sel result.err) { ret res[usize, Error].err{result.err}; }
        ret res[usize, Error].ok{removed};
    }
    val opened: res[i32, Error] = verified_directory(dirfd, destination.leaf, OP_REMOVE);
    if (sel opened.err) {
        val e: Error = opened.err;
        if (e.kind == IO && e.code == os.ENOENT) { ret res[usize, Error].ok{0}; }
        ret res[usize, Error].err{e};
    }
    val fd: i32 = opened.ok;
    val removed: res[usize, Error] = remove_relative(fd, rel);
    val closed: i64 = os.close(fd);
    if (sel removed.err) { ret removed; }
    if (closed < 0) { ret res[usize, Error].err{io_error(OP_REMOVE, closed)}; }
    ret removed;
}

fun remove_relative(dirfd: i32, rel: Path) res[usize, Error] {
    # walk to the parent of the last component, holding a descriptor at each
    # step so no part of the path is ever resolved as a string
    var fd:   i32  = dirfd;
    var held: bool = false;
    val n: usize = str_len(rel);
    var start: usize = 0;

    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }

        val copied: res[ComponentScratch, Error] = copy_component(rel, start, end, OP_REMOVE);
        if (sel copied.err) {
            if (held) { os.close(fd); }
            ret res[usize, Error].err{copied.err};
        }
        var component: ComponentScratch = copied.ok;
        if (end >= n) {
            var removed: usize = 0;
            val result: err[Error] = remove_entry_checked(fd, component.name, ?removed);
            free_component(?component);
            if (held) { os.close(fd); }
            if (sel result.err) { ret res[usize, Error].err{result.err}; }
            ret res[usize, Error].ok{removed};
        }
        val next: res[i32, Error] = verified_directory(fd, component.name, OP_REMOVE);
        free_component(?component);
        if (held) { os.close(fd); }
        if (sel next.err) { ret res[usize, Error].err{next.err}; }
        fd = next.ok;
        held = true;
        start = end + 1;
    }

    if (held) { os.close(fd); }
    ret res[usize, Error].err{error(CONTAINMENT, OP_REMOVE)};
}

# remove one named entry, refusing a symlink rather than unlinking it
fun remove_entry_checked(dirfd: i32, name: str, removed: *usize) err[Error] {
    var st: os.stat_t;
    val sr: i64 = os.stat_path(dirfd, name, ?st, os.AT_SYMLINK_NOFOLLOW);
    if (sr < 0) {
        if (sr == os.ENOENT) { ret err[Error].ok{}; }
        ret err[Error].err{io_error(OP_REMOVE, sr)};
    }
    val kind: u32 = os.stat_mode(?st) & os.S_IFMT;
    if (kind != os.S_IFDIR && kind != os.S_IFREG) {
        ret err[Error].err{error(CONTAINMENT, OP_REMOVE)};
    }
    ret remove_counted(dirfd, name, removed);
}

# create a directory under a root
# ---
# ret: true when this call created it, false when it already existed
pub fun entry_make_dir(destination: *Claim, mode: i32) res[bool, Error] {
    val borrowed: err[Error] = borrow_claim(destination, OP_PREPARE);
    if (sel borrowed.err) { ret res[bool, Error].err{borrowed.err}; }
    val made: i64 = os.make_dir(destination.owner.root.dirfd, destination.leaf, mode);
    return_claim(destination);
    if (made == os.EEXIST) { ret res[bool, Error].ok{false}; }
    if (made < 0) { ret res[bool, Error].err{io_error(OP_PREPARE, made)}; }
    ret res[bool, Error].ok{true};
}

# read a whole small file under a root into a caller-provided buffer
#
# for the fixed-size records a caller keeps beside its own data, where the
# expected size is known and anything larger is corruption rather than a file
# to grow a buffer for.
# ---
# out:     destination buffer
# out_cap: its capacity; a file larger than this is refused, not truncated
# ret:     the byte count, or none when the file does not exist
pub fun entry_read_all(r: *Root, leaf: str, out: *u8,
                       out_cap: usize) res[opt[usize], Error] {
    if (!ownership.root_valid(r)) { ret res[opt[usize], Error].err{error(INVALID, OP_ROOT_OPEN)}; }
    if (!leaf_is_component(leaf)) { ret res[opt[usize], Error].err{error(CONTAINMENT, OP_ROOT_OPEN)}; }

    val raw: i64 = os.open(r.dirfd, leaf, os.O_RDONLY, 0);
    if (raw < 0) {
        if (raw == os.ENOENT) { ret res[opt[usize], Error].ok{opt[usize].none{}}; }
        ret res[opt[usize], Error].err{io_error(OP_ROOT_OPEN, raw)};
    }
    val fd: i32 = raw::i32;

    var st: os.stat_t;
    val sr: i64 = os.stat(fd, ?st);
    if (sr < 0) {
        os.close(fd);
        ret res[opt[usize], Error].err{io_error(OP_ROOT_OPEN, sr)};
    }
    val len: usize = st.st_size::usize;
    if (len > out_cap) {
        os.close(fd);
        ret res[opt[usize], Error].err{error(INVALID, OP_ROOT_OPEN)};
    }

    var got: usize = 0;
    for (got < len) {
        val n: i64 = os.read(fd, ?out[got], len - got);
        if (n <= 0) {
            os.close(fd);
            if (n < 0) { ret res[opt[usize], Error].err{io_error(OP_ROOT_OPEN, n)}; }
            ret res[opt[usize], Error].err{error(IO, OP_ROOT_OPEN)};
        }
        got = got + n::usize;
    }
    os.close(fd);
    ret res[opt[usize], Error].ok{opt[usize].some{len}};
}

# the sentinel file a root lock is taken on
#
# the lock is held on this file's descriptor rather than on the root directory
# itself because windows cannot lock a directory handle. the file's existence
# means nothing: only the lock on it does, so a leftover sentinel from a crashed
# holder is not residue and is never swept.
pub val LOCK_LEAF: str = ".mach-txn-lock";

pub fun coordinator_entry(name: str) bool {
    ret str_equals(name, LOCK_LEAF) || str_equals(name, ownership.CLAIMS_LEAF);
}

# an exclusive claim on a publication root
#
# while held, no other process can take the same claim. the operating system
# releases it when this process exits, whether it exits cleanly, is killed, or
# crashes, so a claim can never outlive its holder and be mistaken for a live
# writer.
# acquire without waiting, keeping the root alive until unlock
pub fun lock(out: *Lock, r: *Root) err[Error] {
    val acquired: i64 = ownership.acquire(out, r);
    if (acquired == os.EINVAL) { ret err[Error].err{error(INVALID, OP_LOCK)}; }
    if (acquired == os.EAGAIN) { ret err[Error].err{error(LOCK_HELD, OP_LOCK)}; }
    if (acquired < 0) { ret err[Error].err{io_error(OP_LOCK, acquired)}; }
    ret err[Error].ok{};
}

# live borrowers and active recovery refuse release without closing anything
pub fun unlock(held: *Lock) err[Error] {
    val released: i64 = ownership.release_lock(held);
    if (released == os.EINVAL) { ret err[Error].err{error(INVALID, OP_LOCK)}; }
    if (released < 0) { ret err[Error].err{io_error(OP_LOCK, released)}; }
    ret err[Error].ok{};
}

# planned reservations remain owned by the session until its workers have joined
pub rec Claim {
    address: usize;
    owner: *Lock;
    leaf: str;
    alloc: *A.Allocator;
    reservation: ownership.Borrow;
    gate: mutex.Mutex;
    active: bool;
    closing: bool;
}

pub rec Worker {
    admission: ownership.Borrow;
}

pub fun borrow_worker(out: *Worker, held: *Lock) err[Error] {
    if (out == nil) { ret err[Error].err{error(INVALID, OP_LOCK)}; }
    val admitted: i64 = ownership.borrow_worker(?out.admission, held);
    if (admitted == os.EINVAL) { ret err[Error].err{error(INVALID, OP_LOCK)}; }
    if (admitted < 0) { ret err[Error].err{io_error(OP_LOCK, admitted)}; }
    ret err[Error].ok{};
}

pub fun release_worker(worker: *Worker) err[Error] {
    if (worker == nil) { ret err[Error].err{error(INVALID, OP_LOCK)}; }
    val released: i64 = ownership.release_borrow(?worker.admission);
    if (released == os.EINVAL) { ret err[Error].err{error(INVALID, OP_LOCK)}; }
    if (released < 0) { ret err[Error].err{io_error(OP_LOCK, released)}; }
    ret err[Error].ok{};
}

# reserves one complete destination spelling before workers or staging are admitted
pub fun claim(out: *Claim, alloc: *A.Allocator, held: *Lock, leaf: str) err[Error] {
    if (out == nil || alloc == nil || !ownership.lock_valid(held)) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
    if (out.address != 0 && (out.address != out::usize || out.owner != nil)) {
        ret err[Error].err{error(INVALID, OP_PREPARE)};
    }
    if (!publication_leaf(leaf)) { ret err[Error].err{error(CONTAINMENT, OP_PREPARE)}; }
    val copied: res[str, A.Error] = str_dup(alloc, leaf);
    if (sel copied.err) { ret err[Error].err{error(MEMORY, OP_PREPARE)}; }
    val name: str = copied.ok;
    val reserved: i64 = ownership.borrow_leaf(?out.reservation, held, name);
    if (reserved < 0) {
        str_free(alloc, name);
        if (reserved == os.EINVAL) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
        if (reserved == os.EEXIST) { ret err[Error].err{error(CONFLICT, OP_PREPARE)}; }
        ret err[Error].err{io_error(OP_PREPARE, reserved)};
    }
    out.address = out::usize;
    out.owner = held;
    out.leaf = name;
    out.alloc = alloc;
    out.gate = mutex.make();
    out.active = false;
    out.closing = false;
    ret err[Error].ok{};
}

# borrowed until successful alias rename or release, stable during active use
pub fun claim_leaf(destination: *Claim) str {
    if (destination == nil || destination.address != destination::usize) { ret nil; }
    mutex.lock(?destination.gate);
    val name: str = destination.leaf;
    mutex.unlock(?destination.gate);
    ret name;
}

fun borrow_claim(destination: *Claim, op: Op) err[Error] {
    if (destination == nil || destination.address != destination::usize) { ret err[Error].err{error(INVALID, op)}; }
    mutex.lock(?destination.gate);
    if (destination.owner == nil || destination.active || destination.closing) {
        mutex.unlock(?destination.gate);
        ret err[Error].err{error(INVALID, op)};
    }
    destination.active = true;
    mutex.unlock(?destination.gate);
    ret err[Error].ok{};
}

fun return_claim(destination: *Claim) {
    mutex.lock(?destination.gate);
    destination.active = false;
    mutex.unlock(?destination.gate);
}

# release refuses copied owners and active borrowers without changing their claim
pub fun release_claim(destination: *Claim) err[Error] {
    if (destination == nil) { ret err[Error].err{error(INVALID, OP_LOCK)}; }
    if (destination.address == 0) { ret err[Error].ok{}; }
    if (destination.address != destination::usize) { ret err[Error].err{error(INVALID, OP_LOCK)}; }
    mutex.lock(?destination.gate);
    if (destination.active || destination.closing) {
        mutex.unlock(?destination.gate);
        ret err[Error].err{error(INVALID, OP_LOCK)};
    }
    if (destination.owner == nil) { mutex.unlock(?destination.gate); ret err[Error].ok{}; }
    destination.closing = true;
    mutex.unlock(?destination.gate);
    val released: i64 = ownership.release_borrow(?destination.reservation);
    str_free(destination.alloc, destination.leaf);
    mutex.lock(?destination.gate);
    destination.owner = nil;
    destination.leaf = nil;
    destination.closing = false;
    mutex.unlock(?destination.gate);
    if (released < 0) { ret err[Error].err{io_error(OP_LOCK, released)}; }
    ret err[Error].ok{};
}

# how much of a publication must reach stable storage before commit reports
# success
pub def Durability: u8;

# order nothing; the destination appears when the operating system gets to it
pub val DUR_NONE: Durability = 0;
# flush the content, so a destination that survives a crash is complete
pub val DUR_FILE: Durability = 1;
# also flush the directory, so the destination's existence survives a crash
pub val DUR_FULL: Durability = 2;

pub rec DurabilityRequest {
    level: Durability;
    # when true a failed barrier fails its preparation or commit step
    required: bool;
}

pub fun durability_none() DurabilityRequest {
    ret DurabilityRequest{level: DUR_NONE, required: false};
}

pub fun durability_file(required: bool) DurabilityRequest {
    ret DurabilityRequest{level: DUR_FILE, required: required};
}

pub fun durability_full(required: bool) DurabilityRequest {
    ret DurabilityRequest{level: DUR_FULL, required: required};
}

# what the destination must look like at commit for the publication to be
# allowed to land
pub def Precondition: u8;

# replace without retaining or comparing an existing destination
pub val PRE_REPLACE: Precondition = 0;
# retain the prior object, or require continued absence when initially absent
pub val PRE_SAME_OBJECT: Precondition = 1;
# the destination must not exist. this is the create case: it detects a
# concurrent creator and refuses rather than absorbing or destroying it.
pub val PRE_ABSENT: Precondition = 2;

# selected before any destination observation or staging work
pub rec PrepareOptions {
    precondition: Precondition;
    # omitted fields retain the zero-valued metadata-only access contract
    prior_access: identities.Access;
    # file-only final permission mode, independent of the process umask
    # false keeps ordinary creation permissions, unsupported backends refuse true
    exact_mode: bool;
    durability: DurabilityRequest;
}

# what a transaction publishes
pub def EntryKind: u8;

# a single regular file, written through a writer
pub val ENTRY_FILE:    EntryKind = 0;
# a single empty directory
pub val ENTRY_DIR:     EntryKind = 1;
# a directory and everything beneath it, built privately and moved in whole
pub val ENTRY_SUBTREE: EntryKind = 2;

# the prefix on every entry this module creates while a transaction is in
# flight. it is the journal: see the module comment.
pub val STAGING_TAG: str = ".machtxn.";
val BACKUP_CONTAINER: str = ".machtxn.backup";

# a staging name collides only if the random suffix repeats, so a bounded
# retry is enough; exhausting it means the entropy source is broken.
val MAX_STAGING_ATTEMPTS: usize = 64;

fun hex_of(alloc: *A.Allocator, bytes: *u8, len: usize) res[str, Error] {
    val cap: usize = ehex.encoded_len(len);
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, cap);
    if (sel rb.err) { ret res[str, Error].err{error(MEMORY, OP_PREPARE)}; }
    val buf: *u8 = rb.ok;
    ehex.encode(bytes, len, buf, cap);
    ret res[str, Error].ok{buf::str};
}

fun make_staging_name(alloc: *A.Allocator) res[str, Error] {
    var rnd: [8]u8;
    val filled: err[io_errors.Error] = rand.fill(?rnd[0], 8);
    if (sel filled.err) { ret res[str, Error].err{error(ENTROPY, OP_PREPARE)}; }
    val hex_r: res[str, Error] = hex_of(alloc, ?rnd[0], 8);
    if (sel hex_r.err) { ret hex_r; }
    val hex: str = hex_r.ok;
    val name_r: R.Result[str, str] = format.sprint(alloc, "{}{}", STAGING_TAG, hex);
    str_free(alloc, hex);
    if (R.is_err[str, str](name_r)) { ret res[str, Error].err{error(MEMORY, OP_PREPARE)}; }
    ret res[str, Error].ok{R.unwrap_ok[str, str](name_r)};
}

# the identity of `leaf` under `dirfd`, or none when it does not exist
fun query_entry_identity(dirfd: i32, leaf: str, op: Op) res[opt[Identity], Error] {
    var identity: Identity;
    val raw: i64 = os.identity_at(dirfd, leaf, ?identity);
    if (raw >= 0) {
        ret res[opt[Identity], Error].ok{opt[Identity].some{identity}};
    }
    if (raw == os.ENOENT) { ret res[opt[Identity], Error].ok{opt[Identity].none{}}; }
    ret res[opt[Identity], Error].err{io_error(op, raw)};
}

fun entry_absent(dirfd: i32, leaf: str) bool {
    var st: os.stat_t;
    val raw: i64 = os.stat_path(dirfd, leaf, ?st, os.AT_SYMLINK_NOFOLLOW);
    ret raw == os.ENOENT;
}

# the writer end of a staged file
#
# every byte written to the transaction's writer lands here, which both writes
# it to the staging descriptor and folds it into the digest when one was asked
# for. a failing write records its errno so `prepare` can report a typed error
# rather than parsing the string the writer interface requires.
rec Sink {
    fd:           i32;
    digesting:    bool;
    digest_state: sha256.State;
    failed_code:  i64;
}

fun sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, WriteError] {
    val s: *Sink = ctx::*Sink;
    val n: i64 = os.write(s.fd, buf, len);
    if (n < 0) {
        s.failed_code = n;
        ret res[usize, WriteError].err{m_writer.native_failure(0, std_io_error.from_code(n, std_io_error.OP_WRITE))};
    }
    if (s.digesting) { sha256.update(?s.digest_state, buf, n::usize); }
    ret res[usize, WriteError].ok{n::usize};
}

# one publication in flight
#
# created in final storage and consumed by commit or abort
# the original staging descriptor remains owned for validation and observations
val STATE_PREPARING: u8 = 1;
val STATE_PREPARED: u8 = 2;
val STATE_SPENT: u8 = 3;

pub rec Transaction {
    address: usize;
    state: u8;
    destination: *Claim;
    dirfd: i32;
    leaf: str;
    staging_name: str;
    staging_fd: i32;
    prior_fd: i32;
    kind: EntryKind;
    had_prior: bool;
    prior: Identity;
    len: usize;
    has_digest: bool;
    digest: [32]u8;
    alloc: *A.Allocator;
    options: PrepareOptions;
    content_flushed: bool;
}

fun prepared(t: *Transaction) bool {
    ret t != nil && t.address == t::usize && t.state == STATE_PREPARED;
}

# all owned resources are consumed before returning the claim's active borrow
fun transaction_cleanup(t: *Transaction, remove: bool, op: Op) err[Error] {
    ret transaction_cleanup_retaining(t, remove, op, nil);
}

fun transaction_cleanup_retaining(t: *Transaction, remove: bool, op: Op, residue: *str) err[Error] {
    var remaining: bool = false;
    var failure: err[Error] = err[Error].ok{};
    if (t.staging_fd >= 0) {
        val closed: i64 = os.close(t.staging_fd);
        t.staging_fd = -1;
        if (closed < 0) { failure = err[Error].err{io_error(op, closed)}; }
    }
    if (remove && t.staging_name != nil) {
        if (t.kind == ENTRY_FILE) {
            val removed: i64 = os.unlink_force(t.dirfd, t.staging_name, 0);
            if (removed < 0 && removed != os.ENOENT) {
                remaining = true;
                if (!sel failure.err) { failure = err[Error].err{io_error(op, removed)}; }
            }
        }
        or {
            var count: usize = 0;
            val removed: err[removal.Error] = removal.private_tree(t.dirfd, t.staging_name, ?count, MAX_REMOVE_DEPTH);
            if (sel removed.err) {
                remaining = true;
                if (!sel failure.err) { failure = err[Error].err{removal_error(op, removed.err)}; }
            }
        }
    }
    if (t.prior_fd >= 0) {
        val closed: i64 = os.close(t.prior_fd);
        t.prior_fd = -1;
        if (closed < 0 && !sel failure.err) { failure = err[Error].err{io_error(op, closed)}; }
    }
    if (remaining && residue != nil) { @residue = t.staging_name; }
    or { str_free(t.alloc, t.staging_name); }
    t.staging_name = nil;
    t.leaf = nil;
    val destination: *Claim = t.destination;
    t.destination = nil;
    t.state = STATE_SPENT;
    return_claim(destination);
    ret failure;
}

fun prepare_failed(t: *Transaction, e: Error) err[Error] {
    val cleaned: err[Error] = transaction_cleanup(t, true, OP_PREPARE);
    if (sel cleaned.err) {
        val cleanup: Error = cleaned.err;
        ret err[Error].err{with_cleanup_error(e, cleanup.code)};
    }
    ret err[Error].err{e};
}

fun begin_prepare(out: *Transaction, alloc: *A.Allocator, destination: *Claim,
                  kind: EntryKind, options: PrepareOptions) err[Error] {
    if (out == nil || alloc == nil || options.precondition > PRE_ABSENT || options.prior_access > READ_AUTHORIZED || options.durability.level > DUR_FULL) {
        ret err[Error].err{error(INVALID, OP_PREPARE)};
    }
    if (options.exact_mode && kind != ENTRY_FILE) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
    if (out.address != 0 && (out.address != out::usize || out.state != STATE_SPENT)) {
        ret err[Error].err{error(INVALID, OP_PREPARE)};
    }
    val borrowed: err[Error] = borrow_claim(destination, OP_PREPARE);
    if (sel borrowed.err) { ret borrowed; }
    @out = Transaction{address: out::usize, state: STATE_PREPARING, destination: destination,
        dirfd: destination.owner.root.dirfd, leaf: destination.leaf, staging_fd: -1,
        prior_fd: -1, kind: kind, alloc: alloc, options: options,
        content_flushed: options.durability.level != DUR_NONE};
    if (options.precondition == PRE_SAME_OBJECT) {
        var st: os.stat_t;
        val observed: i64 = os.stat_path(out.dirfd, out.leaf, ?st, os.AT_SYMLINK_NOFOLLOW);
        if (observed < 0 && observed != os.ENOENT) { ret prepare_failed(out, io_error(OP_PREPARE, observed)); }
        if (observed >= 0) {
            val retained: i64 = os.retain_identity_at(out.dirfd, out.leaf, options.prior_access, ?out.prior);
            if (retained < 0 && retained != os.ENOENT) { ret prepare_failed(out, io_error(OP_PREPARE, retained)); }
            if (retained >= 0) { out.prior_fd = retained::i32; out.had_prior = true; }
        }
    }
    ret err[Error].ok{};
}

pub fun transaction_len(t: *Transaction) usize { ret t.len; }
pub fun transaction_kind(t: *Transaction) EntryKind { ret t.kind; }
pub fun transaction_has_digest(t: *Transaction) bool { ret t.has_digest; }

# the sha-256 of the staged content, when one was requested at prepare
# ---
# ret: false when no digest was requested, leaving `out` untouched
pub fun transaction_digest(t: *Transaction, out: *[32]u8) bool {
    if (!t.has_digest) { ret false; }
    @out = t.digest;
    ret true;
}

# the identity the destination had when prepare ran
# ---
# ret: false when the destination did not exist, leaving `out` untouched
pub fun transaction_prior_identity(t: *Transaction, out: *Identity) bool {
    if (!t.had_prior) { ret false; }
    @out = t.prior;
    ret true;
}

# the identity of the staged entry, before it is committed
#
# a caller that records what it is about to publish needs this: after the
# commit the staged name is gone, and the identity is the only thing that ties
# the destination back to the transaction that produced it.
pub fun transaction_staged_identity(t: *Transaction) res[Identity, Error] {
    if (!prepared(t)) { ret res[Identity, Error].err{error(INVALID, OP_PREPARE)}; }
    var identity: Identity;
    var raw: i64 = 0;
    if (t.staging_fd >= 0) { raw = os.file_identity(t.staging_fd, ?identity); }
    or { raw = os.identity_at(t.dirfd, t.staging_name, ?identity); }
    if (raw < 0) { ret res[Identity, Error].err{io_error(OP_PREPARE, raw)}; }
    ret res[Identity, Error].ok{identity};
}

# observe one prepared subtree child through its original held staging directory
# the observation does not transfer a reference or admit a mutation
pub fun transaction_staged_child_identity(t: *Transaction, leaf: str) res[Identity, Error] {
    if (!prepared(t) || t.kind == ENTRY_FILE || t.staging_fd < 0) {
        ret res[Identity, Error].err{error(INVALID, OP_PREPARE)};
    }
    if (!leaf_is_component(leaf)) { ret res[Identity, Error].err{error(CONTAINMENT, OP_PREPARE)}; }
    var identity: Identity;
    val observed: i64 = os.identity_at(t.staging_fd, leaf, ?identity);
    if (observed < 0) { ret res[Identity, Error].err{io_error(OP_PREPARE, observed)}; }
    ret res[Identity, Error].ok{identity};
}

fun dot_entry(name: *u8) bool {
    if (name[0] != '.') { ret false; }
    if (name[1] == 0) { ret true; }
    if (name[1] == '.' && name[2] == 0) { ret true; }
    ret false;
}

fun list_entries(alloc: *A.Allocator, dirfd: i32, out: *Vector[str]) err[Error] {
    var cursor: os.DirectoryCursor = os.DirectoryCursor{};
    val initialized: os.DirectoryInitResult = os.directory_init(?cursor, dirfd);
    if (initialized.code < 0) {
        var failure: Error = io_error(OP_RECOVER, initialized.code);
        failure.cleanup_code = initialized.cleanup_code;
        ret err[Error].err{failure};
    }
    var result: err[Error] = err[Error].ok{};
    for {
        var entry: os.DirectoryEntry;
        val next: i64 = os.directory_next(?cursor, ?entry);
        if (next < 0) { result = err[Error].err{io_error(OP_RECOVER, next)}; brk; }
        if (next == 0) { brk; }
        if (dot_entry(entry.name)) { cnt; }
        val copied: res[str, A.Error] = str_dup(alloc, entry.name);
        if (sel copied.err) { result = err[Error].err{error(MEMORY, OP_RECOVER)}; brk; }
        val name: str = copied.ok;
        val pushed: res[usize, A.Error] = vector.push[str](out, name);
        if (sel pushed.err) {
            str_free(alloc, name);
            result = err[Error].err{error(MEMORY, OP_RECOVER)};
            brk;
        }
    }
    val closed: i64 = os.directory_close(?cursor);
    if (closed < 0) {
        if (sel result.ok) { ret err[Error].err{io_error(OP_RECOVER, closed)}; }
        var failure: Error = result.err;
        if (failure.cleanup_code == 0) { failure.cleanup_code = closed; }
        ret err[Error].err{failure};
    }
    ret result;
}

fun free_names(alloc: *A.Allocator, v: *Vector[str]) {
    var i: usize = 0;
    for (i < v.len) { str_free(alloc, v.data[i]); i = i + 1; }
    vector.dnit[str](v);
}

# removal borrows names in place, but native cursor acquisition can fail
# private residue stays owned and reported when cleanup cannot complete
fun remove_recursive(dirfd: i32, name: str) err[Error] {
    var ignored: usize = 0;
    ret remove_counted(dirfd, name, ?ignored);
}

# how deep a removal will descend before refusing
#
# depth here is a property of the tree on disk, which is input like any other:
# without a bound the only limit is the stack, and a tree deep enough to
# exhaust it would kill the caller rather than being refused by it.
val MAX_REMOVE_DEPTH: usize = 256;

fun remove_counted(dirfd: i32, name: str, removed: *usize) err[Error] {
    val result: err[removal.Error] = removal.tree(dirfd, name, removed, MAX_REMOVE_DEPTH);
    if (sel result.ok) { ret err[Error].ok{}; }
    ret err[Error].err{removal_error(OP_REMOVE, result.err)};
}

# open a staging entry with a name nothing else holds
#
# `O_EXCL` is what makes the name ours: two processes preparing the same leaf
# at the same moment get different staging entries and neither sees the other.
fun open_staging(alloc: *A.Allocator, dirfd: i32, mode: i32,
                 out_name: *str, out_fd: *i32) err[Error] {
    var attempt: usize = 0;
    for (attempt < MAX_STAGING_ATTEMPTS) {
        val name_r: res[str, Error] = make_staging_name(alloc);
        if (sel name_r.err) { ret err[Error].err{name_r.err}; }
        val candidate: str = name_r.ok;

        val raw: i64 = os.open(dirfd, candidate, os.O_CREAT | os.O_EXCL | os.O_RDWR, mode);
        if (raw >= 0) {
            @out_name = candidate;
            @out_fd   = raw::i32;
            ret err[Error].ok{};
        }
        str_free(alloc, candidate);
        if (raw != os.EEXIST) { ret err[Error].err{io_error(OP_PREPARE, raw)}; }
        attempt = attempt + 1;
    }
    ret err[Error].err{error(ENTROPY, OP_PREPARE)};
}

# create a staging directory with a name nothing else holds
fun make_staging_dir(alloc: *A.Allocator, dirfd: i32, mode: i32,
                     out_name: *str) err[Error] {
    var attempt: usize = 0;
    for (attempt < MAX_STAGING_ATTEMPTS) {
        val name_r: res[str, Error] = make_staging_name(alloc);
        if (sel name_r.err) { ret err[Error].err{name_r.err}; }
        val candidate: str = name_r.ok;

        val raw: i64 = os.make_dir(dirfd, candidate, mode);
        if (raw >= 0) {
            @out_name = candidate;
            ret err[Error].ok{};
        }
        str_free(alloc, candidate);
        if (raw != os.EEXIST) { ret err[Error].err{io_error(OP_PREPARE, raw)}; }
        attempt = attempt + 1;
    }
    ret err[Error].err{error(ENTROPY, OP_PREPARE)};
}

# prepare a file publication from a writer
#
# the writer is the general form: `write_cb` is handed a `Writer` and may
# produce the content however it likes, streaming it without ever holding it
# all in memory. the bytes land in private staging beside the destination, on
# the same filesystem, so the eventual commit is a rename and not a copy.
#
# nothing about the destination changes here. on any failure the staging entry
# is removed and the destination is left exactly as it was.
# ---
# alloc:       allocator for the transaction's own strings
# destination: the session-owned reservation borrowed until commit or abort
# write_ctx:   context handed back to `write_cb`
# write_cb:    produces the content through the writer; its error, the
#              writer's own tag, rejects the prepare
# mode:        creation permission bits, or final file bits when exact_mode is true
# exact modes are applied after writing and before the requested durability barrier
# want_digest: compute the sha-256 of what was written
# ret:         none when out owns a prepared transaction
pub fun prepare[W](out: *Transaction, alloc: *A.Allocator, destination: *Claim,
                   write_ctx: *W, write_cb: fun(*W, *m_writer.Writer) err[WriteError],
                   mode: i32, want_digest: bool, options: PrepareOptions) err[Error] {
    if (write_ctx == nil || write_cb == nil) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
    val begun: err[Error] = begin_prepare(out, alloc, destination, ENTRY_FILE, options);
    if (sel begun.err) { ret begun; }
    val opened: err[Error] = open_staging(alloc, out.dirfd, mode, ?out.staging_name, ?out.staging_fd);
    if (sel opened.err) { ret prepare_failed(out, opened.err); }
    var sink: Sink;
    sink.fd = out.staging_fd;
    sink.digesting = want_digest;
    if (want_digest) { sink.digest_state = sha256.init(); }
    var writer: m_writer.Writer = m_writer.Writer{ctx: (?sink)::ptr, f_write: sink_write};
    val written: err[WriteError] = write_cb(write_ctx, ?writer);
    if (sink.failed_code < 0) { ret prepare_failed(out, io_error(OP_PREPARE, sink.failed_code)); }
    if (sel written.err) { ret prepare_failed(out, error(REJECTED, OP_PREPARE)); }
    if (options.exact_mode) {
        val finalized: i64 = os.set_mode(out.staging_fd, mode);
        if (finalized < 0) { ret prepare_failed(out, io_error(OP_PREPARE, finalized)); }
    }
    var st: os.stat_t;
    val observed: i64 = os.stat(out.staging_fd, ?st);
    if (observed < 0) { ret prepare_failed(out, io_error(OP_PREPARE, observed)); }
    if (options.exact_mode && (os.stat_mode(?st) & 0o7777) != (mode::u32 & 0o7777)) {
        ret prepare_failed(out, error(UNSUPPORTED, OP_PREPARE));
    }
    out.len = st.st_size::usize;
    out.has_digest = want_digest;
    if (want_digest) { sha256.final(?sink.digest_state, ?out.digest[0]); }
    val synced: err[Error] = prepare_barrier(out, out.staging_fd);
    if (sel synced.err) { ret prepare_failed(out, synced.err); }
    out.state = STATE_PREPARED;
    ret err[Error].ok{};
}

rec BytesSource {
    data: *u8;
    len:  usize;
}

fun bytes_write_cb(b: *BytesSource, w: *m_writer.Writer) err[WriteError] {
    if (b.len == 0) { ret err[WriteError].ok{}; }
    ret m_writer.write_all(w, b.data, b.len);
}

# prepare a file publication from bytes already in memory
#
# the trivial writer: everything `prepare` says applies, with the content
# supplied as a buffer instead of a callback.
pub fun prepare_bytes(out: *Transaction, alloc: *A.Allocator, destination: *Claim,
                      data: *u8, len: usize, mode: i32, want_digest: bool,
                      options: PrepareOptions) err[Error] {
    if (data == nil && len != 0) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
    var source: BytesSource = BytesSource{data: data, len: len};
    ret prepare[BytesSource](out, alloc, destination, ?source, bytes_write_cb, mode, want_digest, options);
}

# check the staged content before committing it
#
# a step on the prepared value rather than an argument to prepare, so a caller
# can decide what to check after seeing what was produced, and so a rejection
# is reported separately from a write failure. the whole staged content is read
# back from the staging descriptor and handed to `validator`; a validator that
# returns false leaves the staging entry in place, so the caller still owns
# the transaction and must abort it.
# ---
# t:         the prepared transaction, which must be a file
# ctx:       context handed back to `validator`
# validator: false rejects the content
# ret:       ok when the content passed
pub fun validate[V](t: *Transaction, ctx: *V,
                    validator: fun(*V, *u8, usize) bool) err[Error] {
    if (!prepared(t))   { ret err[Error].err{error(INVALID, OP_VALIDATE)}; }
    if (t.kind != ENTRY_FILE)  { ret err[Error].err{error(INVALID, OP_VALIDATE)}; }
    if (ctx == nil || validator == nil) { ret err[Error].err{error(INVALID, OP_VALIDATE)}; }

    var buf: *u8 = nil;
    var owned: bool = false;
    if (t.len > 0) {
        val seek: i64 = os.seek(t.staging_fd, 0, os.SEEK_SET);
        if (seek < 0) { ret err[Error].err{io_error(OP_VALIDATE, seek)}; }

        val ar: res[*u8, A.Error] = A.allocate[u8](t.alloc, t.len);
        if (sel ar.err) { ret err[Error].err{error(MEMORY, OP_VALIDATE)}; }
        buf = ar.ok;
        owned = true;

        var got: usize = 0;
        for (got < t.len) {
            val n: i64 = os.read(t.staging_fd, ?buf[got], t.len - got);
            if (n <= 0) {
                A.deallocate[u8](t.alloc, buf, t.len);
                if (n < 0) { ret err[Error].err{io_error(OP_VALIDATE, n)}; }
                ret err[Error].err{error(IO, OP_VALIDATE)};
            }
            got = got + n::usize;
        }
    }

    val accepted: bool = validator(ctx, buf, t.len);
    if (owned) { A.deallocate[u8](t.alloc, buf, t.len); }
    if (!accepted) { ret err[Error].err{error(REJECTED, OP_VALIDATE)}; }
    ret err[Error].ok{};
}

# what a commit actually achieved
pub rec Outcome {
    committed: bool;
    # the durability that was reached, which may be less than was requested
    achieved: Durability;
    # true when less was reached than was requested and the request allowed it
    shortfall: bool;
}

# exact effects of a caller-journaled file publication, including failure
pub rec BackupOutcome {
    consumed: bool;
    prior_moved: bool;
    published: bool;
    achieved: Durability;
    shortfall: bool;
    failure: err[Error];
    cleanup_failure: err[Error];
    # owned by the caller with the transaction allocator, nil after successful cleanup
    staging_residue: str;
}

fun finish_backup_commit(t: *Transaction, out: *BackupOutcome) BackupOutcome {
    if (out.published) {
        val dur: DurabilityRequest = t.options.durability;
        out.shortfall = dur.level != DUR_NONE && !t.content_flushed;
        if (dur.level != DUR_NONE && t.content_flushed) { out.achieved = DUR_FILE; }
        if (dur.level == DUR_FULL && t.content_flushed) {
            val synced: i64 = os.sync_fd(t.dirfd);
            if (synced >= 0) { out.achieved = DUR_FULL; }
            or {
                out.shortfall = true;
                if (dur.required) { out.failure = err[Error].err{error(DURABILITY, OP_COMMIT)}; }
            }
        }
    }
    out.cleanup_failure = transaction_cleanup_retaining(t, !out.published, OP_COMMIT, ?out.staging_residue);
    ret @out;
}

fun fail_backup_commit(t: *Transaction, out: *BackupOutcome, failure: Error) BackupOutcome {
    out.failure = err[Error].err{failure};
    ret finish_backup_commit(t, out);
}

# consume a prepared file while retaining its original for a caller-owned journal
# requires same-object preparation, including initial absence, and a distinct
# absent backup claim under the same lock. both reservations remain caller-owned.
# each successful rename is reported even if the next step or cleanup fails.
# no rollback or backup retirement is implicit. a published result may still carry
# a durability or cleanup error. failure and cleanup_failure are independent.
# staging_residue transfers only the name allocation when private removal fails.
# the caller frees that string with t.alloc and retains its journal for recovery.
# an invalid or copied transaction is not consumed. every valid prepared owner is.
pub fun commit_with_backup(t: *Transaction, backup: *Claim) BackupOutcome {
    var out: BackupOutcome = BackupOutcome{failure: err[Error].ok{}, cleanup_failure: err[Error].ok{}};
    if (!prepared(t)) { out.failure = err[Error].err{error(INVALID, OP_COMMIT)}; ret out; }
    t.state = STATE_SPENT;
    out.consumed = true;
    if (t.kind != ENTRY_FILE || t.options.precondition != PRE_SAME_OBJECT || backup == t.destination) {
        ret fail_backup_commit(t, ?out, error(INVALID, OP_COMMIT));
    }
    val borrowed: err[Error] = borrow_claim(backup, OP_COMMIT);
    if (sel borrowed.err) { ret fail_backup_commit(t, ?out, borrowed.err); }
    fin { return_claim(backup); }
    if (backup.owner != t.destination.owner) { ret fail_backup_commit(t, ?out, error(INVALID, OP_COMMIT)); }
    var st: os.stat_t;
    val backup_found: i64 = os.stat_path(t.dirfd, backup.leaf, ?st, os.AT_SYMLINK_NOFOLLOW);
    if (backup_found >= 0) { ret fail_backup_commit(t, ?out, error(CONFLICT, OP_COMMIT)); }
    if (backup_found != os.ENOENT) { ret fail_backup_commit(t, ?out, io_error(OP_COMMIT, backup_found)); }
    val holds: res[bool, Error] = precondition_holds(t);
    if (sel holds.err) { ret fail_backup_commit(t, ?out, holds.err); }
    if (!holds.ok) { ret fail_backup_commit(t, ?out, error(PRECONDITION, OP_COMMIT)); }
    if (t.had_prior) {
        val prior_stat: i64 = os.stat(t.prior_fd, ?st);
        if (prior_stat < 0) { ret fail_backup_commit(t, ?out, io_error(OP_COMMIT, prior_stat)); }
        if ((os.stat_mode(?st) & os.S_IFMT) != os.S_IFREG) {
            ret fail_backup_commit(t, ?out, error(CONFLICT, OP_COMMIT));
        }
    }
    val closed: err[Error] = close_staging(t);
    if (sel closed.err) { ret fail_backup_commit(t, ?out, closed.err); }
    if (t.had_prior) {
        val moved: i64 = os.rename(t.dirfd, t.leaf, t.dirfd, backup.leaf);
        if (moved < 0) { ret fail_backup_commit(t, ?out, io_error(OP_COMMIT, moved)); }
        out.prior_moved = true;
    }
    val placed: i64 = os.rename(t.dirfd, t.staging_name, t.dirfd, t.leaf);
    if (placed < 0) { ret fail_backup_commit(t, ?out, io_error(OP_COMMIT, placed)); }
    out.published = true;
    ret finish_backup_commit(t, ?out);
}

# true when the destination still satisfies `pre`
fun precondition_holds(t: *Transaction) res[bool, Error] {
    val pre: Precondition = t.options.precondition;
    if (pre == PRE_REPLACE) { ret res[bool, Error].ok{true}; }
    if (pre == PRE_ABSENT || (pre == PRE_SAME_OBJECT && !t.had_prior)) {
        var st: os.stat_t;
        val observed: i64 = os.stat_path(t.dirfd, t.leaf, ?st, os.AT_SYMLINK_NOFOLLOW);
        if (observed == os.ENOENT) { ret res[bool, Error].ok{true}; }
        if (observed < 0) { ret res[bool, Error].err{io_error(OP_COMMIT, observed)}; }
        ret res[bool, Error].ok{false};
    }
    if (pre != PRE_SAME_OBJECT || t.prior_fd < 0) { ret res[bool, Error].err{error(INVALID, OP_COMMIT)}; }
    val current: res[opt[Identity], Error] = query_entry_identity(t.dirfd, t.leaf, OP_COMMIT);
    if (sel current.err) { ret res[bool, Error].err{current.err}; }
    val observed: opt[Identity] = current.ok;
    ret res[bool, Error].ok{sel observed.some && identity_equal(t.prior, observed.some)};
}

# barriers run while preparation still owns the original writable handles
fun prepare_barrier(t: *Transaction, fd: i32) err[Error] {
    if (t.options.durability.level == DUR_NONE) { ret err[Error].ok{}; }
    val synced: i64 = os.sync_fd(fd);
    if (synced >= 0) { ret err[Error].ok{}; }
    t.content_flushed = false;
    if (t.options.durability.required) { ret err[Error].err{error(DURABILITY, OP_PREPARE)}; }
    ret err[Error].ok{};
}

# finish consumption after an effect, preserving cleanup failures
fun commit_failed(t: *Transaction, remove: bool, failure: Error) res[Outcome, Error] {
    val cleaned: err[Error] = transaction_cleanup(t, remove, OP_COMMIT);
    if (sel cleaned.err) {
        ret res[Outcome, Error].err{with_cleanup_error(failure, cleaned.err.code)};
    }
    ret res[Outcome, Error].err{failure};
}

fun close_staging(t: *Transaction) err[Error] {
    if (t.staging_fd < 0) { ret err[Error].ok{}; }
    val closed: i64 = os.close(t.staging_fd);
    t.staging_fd = -1;
    if (closed < 0) { ret err[Error].err{io_error(OP_COMMIT, closed)}; }
    ret err[Error].ok{};
}

fun publication_finished(t: *Transaction, flushed: bool) res[Outcome, Error] {
    val dur: DurabilityRequest = t.options.durability;
    var out: Outcome = Outcome{committed: true, achieved: DUR_NONE,
        shortfall: dur.level != DUR_NONE && !flushed};
    if (flushed && dur.level != DUR_NONE) { out.achieved = DUR_FILE; }
    if (dur.level == DUR_FULL && flushed) {
        val synced: i64 = os.sync_fd(t.dirfd);
        if (synced >= 0) { out.achieved = DUR_FULL; }
        or {
            if (dur.required) { ret commit_failed(t, false, error(DURABILITY, OP_COMMIT)); }
            out.shortfall = true;
        }
    }
    val cleaned: err[Error] = transaction_cleanup(t, false, OP_COMMIT);
    if (sel cleaned.err) { ret res[Outcome, Error].err{cleaned.err}; }
    ret res[Outcome, Error].ok{out};
}

# consumes the prepared transaction using its preparation-time policy
# a failure after rename reports an error without claiming publication rolled back
pub fun commit(t: *Transaction) res[Outcome, Error] {
    if (!prepared(t)) { ret res[Outcome, Error].err{error(INVALID, OP_COMMIT)}; }
    t.state = STATE_SPENT;
    val holds: res[bool, Error] = precondition_holds(t);
    if (sel holds.err) { ret commit_failed(t, true, holds.err); }
    if (!holds.ok) { ret commit_failed(t, true, error(PRECONDITION, OP_COMMIT)); }
    val closed: err[Error] = close_staging(t);
    if (sel closed.err) { ret commit_failed(t, true, closed.err); }
    val renamed: i64 = os.rename(t.dirfd, t.staging_name, t.dirfd, t.leaf);
    if (renamed < 0) { ret commit_failed(t, true, io_error(OP_COMMIT, renamed)); }
    ret publication_finished(t, t.content_flushed);
}

# discard the staged content without publishing it
#
# the destination is never touched. the transaction is spent afterwards.
# ---
# ret: none on success; an error means residue may remain, which a later
#      `recover` will remove
pub fun abort(t: *Transaction) err[Error] {
    if (!prepared(t)) { ret err[Error].err{error(INVALID, OP_ABORT)}; }
    t.state = STATE_SPENT;
    ret transaction_cleanup(t, true, OP_ABORT);
}

# one item in a subtree about to be published
pub rec Entry {
    # canonical path relative to the subtree root
    rel:  str;
    kind: EntryKind;
    data: *u8;
    len:  usize;
    mode: i32;
}

pub fun entry_file(rel: str, data: *u8, len: usize, mode: i32) Entry {
    ret Entry{rel: rel, kind: ENTRY_FILE, data: data, len: len, mode: mode};
}

pub fun entry_dir(rel: str, mode: i32) Entry {
    ret Entry{rel: rel, kind: ENTRY_DIR, data: nil, len: 0, mode: mode};
}

# the complete contents of a subtree to publish
#
# collected up front so the whole shape is known before anything is written,
# which is what lets a subtree be built privately and moved into place in one
# step rather than appearing a file at a time.
pub rec Inventory {
    entries: Vector[Entry];
}

pub fun inventory_init(alloc: *A.Allocator) Inventory {
    var inv: Inventory;
    inv.entries = vector.init[Entry](alloc);
    ret inv;
}

pub fun inventory_dnit(inv: *Inventory) err[A.Error] {
    ret vector.dnit[Entry](?inv.entries);
}

# add an item, refusing a path that is not canonical or that repeats one
# already added
pub fun inventory_push(inv: *Inventory, e: Entry) err[Error] {
    if (!rel_is_canonical(e.rel)) { ret err[Error].err{error(CONTAINMENT, OP_PREPARE)}; }
    var i: usize = 0;
    for (i < inv.entries.len) {
        if (str_equals(inv.entries.data[i].rel, e.rel)) {
            ret err[Error].err{error(INVALID, OP_PREPARE)};
        }
        i = i + 1;
    }
    val pr: res[usize, A.Error] = vector.push[Entry](?inv.entries, e);
    if (sel pr.err) { ret err[Error].err{error(MEMORY, OP_PREPARE)}; }
    ret err[Error].ok{};
}

fun join_rel(alloc: *A.Allocator, a: str, b: str) res[str, Error] {
    if (str_empty(a)) {
        val r: res[str, A.Error] = str_dup(alloc, b);
        if (sel r.err) { ret res[str, Error].err{error(MEMORY, OP_PREPARE)}; }
        ret res[str, Error].ok{r.ok};
    }
    val r2: R.Result[str, str] = format.sprint(alloc, "{}/{}", a, b);
    if (R.is_err[str, str](r2)) { ret res[str, Error].err{error(MEMORY, OP_PREPARE)}; }
    ret res[str, Error].ok{R.unwrap_ok[str, str](r2)};
}

# newly created directories record the umask-masked final mode before private access
fun open_private_directory(dirfd: i32, name: str, final_mode: *i32) res[i32, Error] {
    var st: os.stat_t;
    val observed: i64 = os.stat_path(dirfd, name, ?st, os.AT_SYMLINK_NOFOLLOW);
    if (observed < 0) { ret res[i32, Error].err{io_error(OP_PREPARE, observed)}; }
    val mode: u32 = os.stat_mode(?st);
    if ((mode & os.S_IFMT) != os.S_IFDIR) { ret res[i32, Error].err{error(CONTAINMENT, OP_PREPARE)}; }
    @final_mode = (mode & 0o7777)::i32;
    $if ($mach.build.os != $mach.os.windows) {
        if ((mode & 0o700) != 0o700) {
            val accessible: i64 = os.set_mode_at(dirfd, name, @final_mode | 0o700);
            if (accessible < 0) { ret res[i32, Error].err{io_error(OP_PREPARE, accessible)}; }
        }
    }
    ret verified_directory(dirfd, name, OP_PREPARE);
}

fun finish_private_directory(t: *Transaction, fd: i32, final_mode: i32) err[Error] {
    $if ($mach.build.os != $mach.os.windows) {
        val finalized: i64 = os.set_mode(fd, final_mode);
        if (finalized < 0) { ret err[Error].err{io_error(OP_PREPARE, finalized)}; }
    }
    ret prepare_barrier(t, fd);
}

fun write_subtree_file(t: *Transaction, dirfd: i32, name: str, e: *Entry) err[Error] {
    val opened: i64 = os.open(dirfd, name, os.O_WRONLY | os.O_CREAT | os.O_EXCL, e.mode);
    if (opened < 0) { ret err[Error].err{io_error(OP_PREPARE, opened)}; }
    val fd: i32 = opened::i32;
    var sink: Sink = Sink{fd: fd};
    var writer: m_writer.Writer = m_writer.Writer{ctx: (?sink)::ptr, f_write: sink_write};
    val written: err[WriteError] = m_writer.write_all(?writer, e.data, e.len);
    var failure: err[Error] = err[Error].ok{};
    if (sink.failed_code < 0) { failure = err[Error].err{io_error(OP_PREPARE, sink.failed_code)}; }
    or (sel written.err) { failure = err[Error].err{error(IO, OP_PREPARE)}; }
    or { failure = prepare_barrier(t, fd); }
    val closed: i64 = os.close(fd);
    if (sel failure.err) { ret failure; }
    if (closed < 0) { ret err[Error].err{io_error(OP_PREPARE, closed)}; }
    ret err[Error].ok{};
}

# explicit modes are selected before implicit parents are created
fun build_subtree_directory(t: *Transaction, dirfd: i32, prefix: str,
                            inv: *Inventory, depth: usize) err[Error] {
    if (depth > MAX_REMOVE_DEPTH) { ret err[Error].err{error(CONTAINMENT, OP_PREPARE)}; }
    var seen: Vector[str] = vector.init[str](t.alloc);
    fin { free_names(t.alloc, ?seen); }
    val prefix_len: usize = str_len(prefix);
    var start: usize = 0;
    if (prefix_len != 0) { start = prefix_len + 1; }
    var i: usize = 0;
    for (i < inv.entries.len) {
        val e: *Entry = ?inv.entries.data[i];
        i = i + 1;
        val length: usize = str_len(e.rel);
        if (length <= start) { cnt; }
        if (prefix_len != 0 && (!str_starts_with(e.rel, prefix) || e.rel[prefix_len] != '/')) { cnt; }
        if (depth >= MAX_REMOVE_DEPTH) { ret err[Error].err{error(CONTAINMENT, OP_PREPARE)}; }
        var end: usize = start;
        for (end < length && e.rel[end] != '/') { end = end + 1; }
        val copied: res[str, StrError] = str_copy_slice(t.alloc, e.rel, start, end - start);
        if (sel copied.err) { ret err[Error].err{error(MEMORY, OP_PREPARE)}; }
        val name: str = copied.ok;
        var known: bool = false;
        var j: usize = 0;
        for (j < seen.len) {
            if (str_equals(seen.data[j], name)) { known = true; brk; }
            j = j + 1;
        }
        if (known) { str_free(t.alloc, name); cnt; }
        val recorded: res[usize, A.Error] = vector.push[str](?seen, name);
        if (sel recorded.err) {
            str_free(t.alloc, name);
            ret err[Error].err{error(MEMORY, OP_PREPARE)};
        }
        val joined: res[str, Error] = join_rel(t.alloc, prefix, name);
        if (sel joined.err) { ret err[Error].err{joined.err}; }
        val rel: str = joined.ok;
        fin { str_free(t.alloc, rel); }
        var declared: *Entry = nil;
        var descendants: bool = false;
        j = 0;
        for (j < inv.entries.len) {
            val candidate: *Entry = ?inv.entries.data[j];
            j = j + 1;
            if (str_equals(candidate.rel, rel)) {
                if (declared != nil) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
                declared = candidate;
            }
            or (str_starts_with(candidate.rel, rel) && candidate.rel[str_len(rel)] == '/') { descendants = true; }
        }
        if (declared != nil && declared.kind == ENTRY_FILE) {
            if (descendants) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
            val written: err[Error] = write_subtree_file(t, dirfd, name, declared);
            if (sel written.err) { ret written; }
            cnt;
        }
        var mode: i32 = 0o755;
        if (declared != nil) { mode = declared.mode; }
        val made: i64 = os.make_dir(dirfd, name, mode);
        if (made == os.EEXIST) { ret err[Error].err{error(CONTAINMENT, OP_PREPARE)}; }
        if (made < 0) { ret err[Error].err{io_error(OP_PREPARE, made)}; }
        var final_mode: i32 = 0;
        val opened: res[i32, Error] = open_private_directory(dirfd, name, ?final_mode);
        if (sel opened.err) { ret err[Error].err{opened.err}; }
        val child: i32 = opened.ok;
        var result: err[Error] = build_subtree_directory(t, child, rel, inv, depth + 1);
        if (!sel result.err) { result = finish_private_directory(t, child, final_mode); }
        val closed: i64 = os.close(child);
        if (sel result.err) { ret result; }
        if (closed < 0) { ret err[Error].err{io_error(OP_PREPARE, closed)}; }
    }
    ret err[Error].ok{};
}

fun build_subtree(t: *Transaction, inv: *Inventory) err[Error] {
    var i: usize = 0;
    for (i < inv.entries.len) {
        val e: *Entry = ?inv.entries.data[i];
        if (!rel_is_canonical(e.rel)) { ret err[Error].err{error(CONTAINMENT, OP_PREPARE)}; }
        if (e.kind != ENTRY_DIR && e.kind != ENTRY_FILE) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
        if (e.kind == ENTRY_FILE && e.data == nil && e.len != 0) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
        i = i + 1;
    }
    ret build_subtree_directory(t, t.staging_fd, "", inv, 0);
}

# prepare a subtree publication
#
# builds the whole subtree privately beside its destination, so the commit is
# one rename of the subtree root and the destination never exists in a partial
# state. every descendant is created through held directory descriptors.
# ---
# alloc:    allocator for the transaction's own strings
# destination: the session-owned reservation borrowed until commit or abort
# inv:      everything the subtree contains
# mode:     permission bits for the subtree root directory
# ret:      none when out owns a prepared transaction
pub fun prepare_subtree(out: *Transaction, alloc: *A.Allocator, destination: *Claim,
                        inv: *Inventory, mode: i32, options: PrepareOptions) err[Error] {
    if (inv == nil) { ret err[Error].err{error(INVALID, OP_PREPARE)}; }
    val begun: err[Error] = begin_prepare(out, alloc, destination, ENTRY_SUBTREE, options);
    if (sel begun.err) { ret begun; }
    val made: err[Error] = make_staging_dir(alloc, out.dirfd, mode, ?out.staging_name);
    if (sel made.err) { ret prepare_failed(out, made.err); }
    var final_mode: i32 = 0;
    val opened: res[i32, Error] = open_private_directory(out.dirfd, out.staging_name, ?final_mode);
    if (sel opened.err) { ret prepare_failed(out, opened.err); }
    out.staging_fd = opened.ok;
    val built: err[Error] = build_subtree(out, inv);
    if (sel built.err) { ret prepare_failed(out, built.err); }
    out.len = inv.entries.len;
    val finalized: err[Error] = finish_private_directory(out, out.staging_fd, final_mode);
    if (sel finalized.err) { ret prepare_failed(out, finalized.err); }
    out.state = STATE_PREPARED;
    ret err[Error].ok{};
}

# prepare an empty directory publication
#
# the degenerate subtree: one directory and nothing in it.
pub fun prepare_dir(out: *Transaction, alloc: *A.Allocator, destination: *Claim,
                    mode: i32, options: PrepareOptions) err[Error] {
    val begun: err[Error] = begin_prepare(out, alloc, destination, ENTRY_DIR, options);
    if (sel begun.err) { ret begun; }
    val made: err[Error] = make_staging_dir(alloc, out.dirfd, mode, ?out.staging_name);
    if (sel made.err) { ret prepare_failed(out, made.err); }
    var final_mode: i32 = 0;
    val opened: res[i32, Error] = open_private_directory(out.dirfd, out.staging_name, ?final_mode);
    if (sel opened.err) { ret prepare_failed(out, opened.err); }
    out.staging_fd = opened.ok;
    val finalized: err[Error] = finish_private_directory(out, out.staging_fd, final_mode);
    if (sel finalized.err) { ret prepare_failed(out, finalized.err); }
    out.state = STATE_PREPARED;
    ret err[Error].ok{};
}

# walk everything under `dirfd`, refusing any entry the caller does not claim
#
# this is what makes replacing an existing tree safe: before anything is moved,
# every file already there is shown to the caller, and a single unrecognized
# entry aborts the whole replacement. a tree the caller does not fully own is
# never destroyed.
fun walk_owned[T](alloc: *A.Allocator, dirfd: i32, prefix: str, ctx: *T,
                  owns: fun(*T, str, bool) bool) err[Error] {
    var names: Vector[str] = vector.init[str](alloc);
    val le: err[Error] = list_entries(alloc, dirfd, ?names);
    if (sel le.err) { free_names(alloc, ?names); ret le; }

    var failure: err[Error] = err[Error].ok{};
    var i: usize = 0;
    for (i < names.len && !sel failure.err) {
        val name: str = names.data[i];
        i = i + 1;

        val rel_r: res[str, Error] = join_rel(alloc, prefix, name);
        if (sel rel_r.err) { failure = err[Error].err{rel_r.err}; cnt; }
        val rel: str = rel_r.ok;

        var st: os.stat_t;
        val sr: i64 = os.stat_path(dirfd, name, ?st, os.AT_SYMLINK_NOFOLLOW);
        if (sr < 0) { str_free(alloc, rel); failure = err[Error].err{io_error(OP_COMMIT, sr)}; cnt; }

        val smode: u32 = os.stat_mode(?st);
        val is_dir:  bool = (smode & os.S_IFMT) == os.S_IFDIR;
        val is_file: bool = (smode & os.S_IFMT) == os.S_IFREG;
        if (!is_dir && !is_file) {
            str_free(alloc, rel);
            failure = err[Error].err{error(CONFLICT, OP_COMMIT)};
            cnt;
        }
        if (!owns(ctx, rel, is_dir)) {
            str_free(alloc, rel);
            failure = err[Error].err{error(CONFLICT, OP_COMMIT)};
            cnt;
        }
        if (is_dir) {
            val opened: res[i32, Error] = verified_directory(dirfd, name, OP_COMMIT);
            if (sel opened.err) {
                str_free(alloc, rel);
                failure = err[Error].err{opened.err};
                cnt;
            }
            val child: i32 = opened.ok;
            val sub: err[Error] = walk_owned[T](alloc, child, rel, ctx, owns);
            val closed: i64 = os.close(child);
            if (sel sub.err) { failure = sub; }
            or (closed < 0) { failure = err[Error].err{io_error(OP_COMMIT, closed)}; }
        }
        str_free(alloc, rel);
    }
    free_names(alloc, ?names);
    ret failure;
}

fun verified_directory(dirfd: i32, name: str, op: Op) res[i32, Error] {
    var before: os.stat_t;
    val probed: i64 = os.stat_path(dirfd, name, ?before, os.AT_SYMLINK_NOFOLLOW);
    if (probed < 0) { ret res[i32, Error].err{io_error(op, probed)}; }
    if ((os.stat_mode(?before) & os.S_IFMT) != os.S_IFDIR) {
        ret res[i32, Error].err{error(CONTAINMENT, op)};
    }
    var flags: i32 = os.O_RDONLY | os.O_DIRECTORY;
    $if ($mach.build.os != $mach.os.windows) { flags = flags | nofollow_os.O_NOFOLLOW; }
    val opened: i64 = os.open(dirfd, name, flags, 0);
    if (opened < 0) { ret res[i32, Error].err{io_error(op, opened)}; }
    val fd: i32 = opened::i32;
    var after: os.stat_t;
    val checked: i64 = os.stat(fd, ?after);
    if (checked < 0) {
        val closed: i64 = os.close(fd);
        ret res[i32, Error].err{with_cleanup_error(io_error(op, checked), closed)};
    }
    if ((os.stat_mode(?after) & os.S_IFMT) != os.S_IFDIR) {
        val closed: i64 = os.close(fd);
        ret res[i32, Error].err{with_cleanup_error(error(CONTAINMENT, op), closed)};
    }
    ret res[i32, Error].ok{fd};
}

# the container is persistent metadata and is created only when a replace needs it
fun open_backup_container(dirfd: i32, create: bool) res[i32, Error] {
    var st: os.stat_t;
    val probed: i64 = os.stat_path(dirfd, BACKUP_CONTAINER, ?st, os.AT_SYMLINK_NOFOLLOW);
    if (probed == os.ENOENT) {
        if (!create) { ret res[i32, Error].ok{-1}; }
        val made: i64 = os.make_dir(dirfd, BACKUP_CONTAINER, 0o700);
        if (made < 0 && made != os.EEXIST) { ret res[i32, Error].err{io_error(OP_COMMIT, made)}; }
    }
    or (probed < 0) { ret res[i32, Error].err{io_error(OP_RECOVER, probed)}; }
    ret verified_directory(dirfd, BACKUP_CONTAINER, OP_RECOVER);
}

fun resolve_backup(dirfd: i32, leaf: str, backupfd: i32) res[bool, Error] {
    if (backupfd < 0) { ret res[bool, Error].ok{false}; }
    var backup: os.stat_t;
    val found: i64 = os.stat_path(backupfd, leaf, ?backup, os.AT_SYMLINK_NOFOLLOW);
    if (found == os.ENOENT) { ret res[bool, Error].ok{false}; }
    if (found < 0) { ret res[bool, Error].err{io_error(OP_RECOVER, found)}; }
    if ((os.stat_mode(?backup) & os.S_IFMT) != os.S_IFDIR) {
        ret res[bool, Error].err{error(CONFLICT, OP_RECOVER)};
    }
    var destination: os.stat_t;
    val present: i64 = os.stat_path(dirfd, leaf, ?destination, os.AT_SYMLINK_NOFOLLOW);
    if (present == os.ENOENT) {
        val restored: i64 = os.rename(backupfd, leaf, dirfd, leaf);
        if (restored < 0) { ret res[bool, Error].err{io_error(OP_RECOVER, restored)}; }
    }
    or (present < 0) { ret res[bool, Error].err{io_error(OP_RECOVER, present)}; }
    or {
        if ((os.stat_mode(?destination) & os.S_IFMT) != os.S_IFDIR) {
            ret res[bool, Error].err{error(CONFLICT, OP_RECOVER)};
        }
        val removed: err[Error] = remove_recursive(backupfd, leaf);
        if (sel removed.err) { ret res[bool, Error].err{removed.err}; }
    }
    ret res[bool, Error].ok{true};
}

fun owned_replace_failed(t: *Transaction, backupfd: i32, remove: bool, failure: Error) res[Outcome, Error] {
    if (backupfd >= 0) {
        val closed: i64 = os.close(backupfd);
        if (closed < 0) { ret commit_failed(t, remove, with_cleanup_error(failure, closed)); }
    }
    ret commit_failed(t, remove, failure);
}

# consumes even invalid replacement requests and never recovers a live session
# the destination may be temporarily absent between the backup and publication renames
pub fun commit_replacing_owned[T](t: *Transaction, ctx: *T,
                                  owns: fun(*T, str, bool) bool) res[Outcome, Error] {
    if (!prepared(t)) { ret res[Outcome, Error].err{error(INVALID, OP_COMMIT)}; }
    t.state = STATE_SPENT;
    if (ctx == nil || owns == nil || t.kind == ENTRY_FILE || t.options.precondition == PRE_ABSENT) {
        ret commit_failed(t, true, error(INVALID, OP_COMMIT));
    }
    val holds: res[bool, Error] = precondition_holds(t);
    if (sel holds.err) { ret commit_failed(t, true, holds.err); }
    if (!holds.ok) { ret commit_failed(t, true, error(PRECONDITION, OP_COMMIT)); }
    val opened: res[i32, Error] = open_backup_container(t.dirfd, false);
    if (sel opened.err) { ret commit_failed(t, true, opened.err); }
    var backupfd: i32 = opened.ok;
    if (backupfd >= 0) {
        var st: os.stat_t;
        val prior: i64 = os.stat_path(backupfd, t.leaf, ?st, os.AT_SYMLINK_NOFOLLOW);
        if (prior >= 0) { ret owned_replace_failed(t, backupfd, true, error(CONFLICT, OP_COMMIT)); }
        if (prior != os.ENOENT) { ret owned_replace_failed(t, backupfd, true, io_error(OP_COMMIT, prior)); }
    }
    val target: res[i32, Error] = verified_directory(t.dirfd, t.leaf, OP_COMMIT);
    if (sel target.err) {
        val e: Error = target.err;
        if (e.kind == IO && e.code == os.ENOENT) { ret owned_replace_failed(t, backupfd, true, error(PRECONDITION, OP_COMMIT)); }
        ret owned_replace_failed(t, backupfd, true, e);
    }
    val targetfd: i32 = target.ok;
    val checked: err[Error] = walk_owned[T](t.alloc, targetfd, "", ctx, owns);
    val target_closed: i64 = os.close(targetfd);
    if (sel checked.err) { ret owned_replace_failed(t, backupfd, true, checked.err); }
    if (target_closed < 0) { ret owned_replace_failed(t, backupfd, true, io_error(OP_COMMIT, target_closed)); }
    val staging_closed: err[Error] = close_staging(t);
    if (sel staging_closed.err) { ret owned_replace_failed(t, backupfd, true, staging_closed.err); }
    if (backupfd < 0) {
        val created: res[i32, Error] = open_backup_container(t.dirfd, true);
        if (sel created.err) { ret commit_failed(t, true, created.err); }
        backupfd = created.ok;
    }
    val vacated: i64 = os.rename(t.dirfd, t.leaf, backupfd, t.leaf);
    if (vacated < 0) { ret owned_replace_failed(t, backupfd, true, io_error(OP_COMMIT, vacated)); }
    val placed: i64 = os.rename(t.dirfd, t.staging_name, t.dirfd, t.leaf);
    if (placed < 0) {
        val restored: i64 = os.rename(backupfd, t.leaf, t.dirfd, t.leaf);
        if (restored < 0) { ret owned_replace_failed(t, backupfd, true, io_error(OP_COMMIT, restored)); }
        ret owned_replace_failed(t, backupfd, true, io_error(OP_COMMIT, placed));
    }
    val removed: err[Error] = remove_recursive(backupfd, t.leaf);
    if (sel removed.err) { ret owned_replace_failed(t, backupfd, false, removed.err); }
    val closed: i64 = os.close(backupfd);
    if (closed < 0) { ret commit_failed(t, false, io_error(OP_COMMIT, closed)); }
    ret publication_finished(t, t.content_flushed);
}

fun staging_residue(name: str) bool {
    val length: usize = str_len(name);
    val suffix: usize = str_len(STAGING_TAG);
    if (!str_starts_with(name, STAGING_TAG) || length != suffix + 16) { ret false; }
    var i: usize = suffix;
    for (i < length) {
        val byte: u8 = name[i];
        if (!((byte >= '0' && byte <= '9') || (byte >= 'a' && byte <= 'f'))) { ret false; }
        i = i + 1;
    }
    ret true;
}

# requires the supplied coordinator lock and no live claims or workers
# admission remains closed when any recovery or claims initialization step fails
pub fun recover(alloc: *A.Allocator, held: *Lock, leaf: str) res[usize, Error] {
    if (alloc == nil) { ret res[usize, Error].err{error(INVALID, OP_RECOVER)}; }
    if (!str_empty(leaf) && !publication_leaf(leaf)) { ret res[usize, Error].err{error(CONTAINMENT, OP_RECOVER)}; }
    val begun: i64 = ownership.begin_recovery(held);
    if (begun < 0) { ret res[usize, Error].err{error(INVALID, OP_RECOVER)}; }
    val swept: res[usize, Error] = recover_entries(alloc, held.root, leaf);
    if (sel swept.err) {
        ownership.end_recovery(held, false);
        ret swept;
    }
    val initialized: err[removal.Error] = ownership.initialize_claims(held);
    val finished: i64 = ownership.end_recovery(held, sel initialized.ok);
    if (sel initialized.err) { ret res[usize, Error].err{removal_error(OP_RECOVER, initialized.err)}; }
    if (finished < 0) { ret res[usize, Error].err{error(INVALID, OP_RECOVER)}; }
    ret swept;
}

fun recover_entries(alloc: *A.Allocator, r: *Root, leaf: str) res[usize, Error] {
    if (!str_empty(leaf)) {
        if (!publication_leaf(leaf)) { ret res[usize, Error].err{error(CONTAINMENT, OP_RECOVER)}; }
        val opened: res[i32, Error] = open_backup_container(r.dirfd, false);
        if (sel opened.err) { ret res[usize, Error].err{opened.err}; }
        val backupfd: i32 = opened.ok;
        val resolved: res[bool, Error] = resolve_backup(r.dirfd, leaf, backupfd);
        var closed: i64 = 0;
        if (backupfd >= 0) { closed = os.close(backupfd); }
        if (sel resolved.err) { ret res[usize, Error].err{resolved.err}; }
        if (closed < 0) { ret res[usize, Error].err{io_error(OP_RECOVER, closed)}; }
    }
    var removed: usize = 0;
    for {
        val rewound: i64 = os.seek(r.dirfd, 0, os.SEEK_SET);
        if (rewound < 0) { ret res[usize, Error].err{io_error(OP_RECOVER, rewound)}; }
        var cursor: os.DirectoryCursor = os.DirectoryCursor{};
        val initialized: os.DirectoryInitResult = os.directory_init(?cursor, r.dirfd);
        if (initialized.code < 0) {
            var failure: Error = io_error(OP_RECOVER, initialized.code);
            failure.cleanup_code = initialized.cleanup_code;
            ret res[usize, Error].err{failure};
        }
        val before: usize = removed;
        var failure: err[Error] = err[Error].ok{};
        for {
            var entry: os.DirectoryEntry;
            val next: i64 = os.directory_next(?cursor, ?entry);
            if (next < 0) { failure = err[Error].err{io_error(OP_RECOVER, next)}; brk; }
            if (next == 0) { brk; }
            if (!staging_residue(entry.name)) { cnt; }
            var count: usize = 0;
            val cleaned: err[removal.Error] = removal.private_tree(r.dirfd, entry.name, ?count, MAX_REMOVE_DEPTH);
            if (sel cleaned.err) {
                failure = err[Error].err{removal_error(OP_RECOVER, cleaned.err)};
                brk;
            }
            if (count != 0) { removed = removed + 1; }
        }
        val closed: i64 = os.directory_close(?cursor);
        if (sel failure.err) {
            ret res[usize, Error].err{with_cleanup_error(failure.err, closed)};
        }
        if (closed < 0) { ret res[usize, Error].err{io_error(OP_RECOVER, closed)}; }
        # rescan after mutation so native directory buffering cannot hide residue
        if (before == removed) { ret res[usize, Error].ok{removed}; }
    }
    ret res[usize, Error].ok{removed};
}

# a root at the deepest existing ancestor of a path, and what was missing
#
# publishing `a/b/c` when `a` does not exist yet must create `a`, `a/b` and
# `a/b/c` together: a reader must never see a half-built `a`. `descend` finds
# where the existing tree stops, so the caller can stage the entire missing
# chain privately and publish it with one rename of `first_missing`.
pub rec Descent {
    # a capability over the deepest directory that already exists
    root: Root;
    # the first component under `root` that does not exist, a single component
    first_missing: str;
    # the rest of the requested path below `first_missing`, possibly empty
    remainder: str;
}

# find where an existing tree stops along `rel`
#
# every component up to the first missing one must be a real directory,
# checked without following symlinks, exactly as `root_open` does.
# ---
# alloc: allocator for the returned strings
# base:  absolute path of the anchor directory
# rel:   canonical relative path beneath `base`
# ret: true when out owns the first missing location, false when all of rel exists
# failure retains the primary cause and first cleanup error, with no new descent
pub fun descend(out: *Descent, alloc: *A.Allocator, base: Path, rel: Path) res[bool, Error] {
    if (out == nil || alloc == nil || str_empty(base)) {
        ret res[bool, Error].err{error(INVALID, OP_ROOT_OPEN)};
    }
    if (out.root.address != 0 && (out.root.address != (?out.root)::usize || out.root.dirfd >= 0)) {
        ret res[bool, Error].err{error(INVALID, OP_ROOT_OPEN)};
    }
    if (str_empty(rel) || str_equals(rel, ".")) {
        ret res[bool, Error].ok{false};
    }
    if (!rel_is_canonical(rel)) {
        ret res[bool, Error].err{error(CONTAINMENT, OP_ROOT_OPEN)};
    }

    val base_raw: i64 = os.open(os.AT_FDCWD, base, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (base_raw < 0) { ret res[bool, Error].err{io_error(OP_ROOT_OPEN, base_raw)}; }
    var fd: i32 = base_raw::i32;

    val n: usize = str_len(rel);
    var start: usize = 0;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }

        val comp_r: res[str, StrError] = str_copy_slice(alloc, rel, start, end - start);
        if (sel comp_r.err) {
            val closed: i64 = os.close(fd);
            ret res[bool, Error].err{with_cleanup_error(error(MEMORY, OP_ROOT_OPEN), closed)};
        }
        val comp: str = comp_r.ok;

        var st: os.stat_t;
        val sr: i64 = os.stat_path(fd, comp, ?st, os.AT_SYMLINK_NOFOLLOW);
        if (sr == os.ENOENT) {
            var remainder: str = nil;
            if (end < n) {
                val rem_r: res[str, StrError] = str_copy_slice(alloc, rel, end + 1, n - end - 1);
                if (sel rem_r.err) {
                    val closed: i64 = os.close(fd);
                    str_free(alloc, comp);
                    ret res[bool, Error].err{with_cleanup_error(error(MEMORY, OP_ROOT_OPEN), closed)};
                }
                remainder = rem_r.ok;
            }
            val initialized: i64 = ownership.root_init(?out.root, fd);
            if (initialized < 0) {
                val closed: i64 = os.close(fd);
                str_free(alloc, comp);
                str_free(alloc, remainder);
                ret res[bool, Error].err{with_cleanup_error(error(INVALID, OP_ROOT_OPEN), closed)};
            }
            out.first_missing = comp;
            out.remainder = remainder;
            ret res[bool, Error].ok{true};
        }
        if (sr < 0) {
            val closed: i64 = os.close(fd);
            str_free(alloc, comp);
            ret res[bool, Error].err{with_cleanup_error(io_error(OP_ROOT_OPEN, sr), closed)};
        }
        if ((os.stat_mode(?st) & os.S_IFMT) != os.S_IFDIR) {
            val closed: i64 = os.close(fd);
            str_free(alloc, comp);
            ret res[bool, Error].err{with_cleanup_error(error(CONTAINMENT, OP_ROOT_OPEN), closed)};
        }

        val next: res[i32, Error] = verified_directory(fd, comp, OP_ROOT_OPEN);
        str_free(alloc, comp);
        val closed: i64 = os.close(fd);
        val advanced: res[i32, Error] = root_step_result(next, closed);
        if (sel advanced.err) {
            ret res[bool, Error].err{advanced.err};
        }
        fd = advanced.ok;
        start = end + 1;
    }

    val closed: i64 = os.close(fd);
    if (closed < 0) { ret res[bool, Error].err{io_error(OP_ROOT_OPEN, closed)}; }
    ret res[bool, Error].ok{false};
}

# release a descent and everything it allocated
pub fun descent_dnit(alloc: *A.Allocator, d: *Descent) err[Error] {
    if (alloc == nil || d == nil) { ret err[Error].err{error(INVALID, OP_ROOT_OPEN)}; }
    val closed: err[Error] = root_dnit(?d.root);
    if (sel closed.err) { ret closed; }
    str_free(alloc, d.first_missing);
    str_free(alloc, d.remainder);
    d.first_missing = nil;
    d.remainder = nil;
    ret err[Error].ok{};
}

use page: std.allocator.page;
use testing: std.allocator.testing;

# sel takes a place; the assertion sites hand a call, or an outcome they read
# in an unguarded arm, to one of these
fun failed(r: err[Error]) bool { ret sel r.err; }
fun error_of(r: err[Error]) Error { if (sel r.err) { ret r.err; } ret Error{}; }
fun res_failed[T](r: res[T, Error]) bool { ret sel r.err; }
fun res_error[T](r: res[T, Error]) Error { if (sel r.err) { ret r.err; } ret Error{}; }
fun res_value[T](r: res[T, Error]) T { if (sel r.ok) { ret r.ok; } var zero: T; ret zero; }
fun some_of[T](o: opt[T]) T { if (sel o.some) { ret o.some; } var zero: T; ret zero; }
fun absent(o: opt[str]) bool { ret sel o.none; }
fun present[T](o: opt[T]) bool { ret sel o.some; }
fun fs_refused(r: err[std_io_error.Error]) bool { ret sel r.err; }
fun fs_write_refused(r: err[fs.FsError]) bool { ret sel r.err; }
fun answered(r: res[bool, std_io_error.Error]) bool { ret sel r.ok && r.ok; }

# a private directory to publish into, removed by the caller
rec TestSession {
    held: Lock;
    alloc: *A.Allocator;
    claims: Vector[*Claim];
}

fun t_session_init(out: *TestSession, alloc: *A.Allocator, root: *Root) err[Error] {
    out.alloc = alloc;
    out.claims = vector.init[*Claim](alloc);
    ret lock(?out.held, root);
}

fun t_session_release_claims(session: *TestSession) err[Error] {
    for (session.claims.len != 0) {
        val owned: *Claim = session.claims.data[session.claims.len - 1];
        val released: err[Error] = release_claim(owned);
        if (sel released.err) { ret released; }
        session.claims.len = session.claims.len - 1;
        A.deallocate[Claim](session.alloc, owned, 1);
    }
    ret err[Error].ok{};
}

fun t_session_dnit(session: *TestSession) {
    if (failed(t_session_release_claims(session))) { ret; }
    vector.dnit[*Claim](?session.claims);
    unlock(?session.held);
}

fun t_end_batch_and_recover(session: *TestSession, leaf: str) res[usize, Error] {
    val ended: err[Error] = t_session_release_claims(session);
    if (sel ended.err) { ret res[usize, Error].err{error_of(ended)}; }
    ret recover(session.alloc, ?session.held, leaf);
}

fun t_reserve(session: *TestSession, leaf: str) *Claim {
    if (!session.held.initialized) {
        if (res_failed[usize](recover(session.alloc, ?session.held, ""))) { ret nil; }
    }
    var i: usize = 0;
    for (i < session.claims.len) {
        val owned: *Claim = session.claims.data[i];
        if (str_equals(claim_leaf(owned), leaf)) { ret owned; }
        i = i + 1;
    }
    val allocated: res[*Claim, A.Error] = A.allocate[Claim](session.alloc, 1);
    if (sel allocated.err) { ret nil; }
    val owned: *Claim = allocated.ok;
    @owned = Claim{};
    if (failed(claim(owned, session.alloc, ?session.held, leaf))) {
        A.deallocate[Claim](session.alloc, owned, 1);
        ret nil;
    }
    val recorded: res[usize, A.Error] = vector.push[*Claim](?session.claims, owned);
    if (sel recorded.err) {
        release_claim(owned);
        A.deallocate[Claim](session.alloc, owned, 1);
        ret nil;
    }
    ret owned;
}

fun scratch_root(alloc: *A.Allocator) res[str, fs.FsError] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_txn_test");
    if (sel tf_r.err) { ret res[str, fs.FsError].err{tf_r.err}; }
    var tf: fs.TempFile = tf_r.ok;
    val p: Path = fs.temp_path(?tf);
    val dup: res[str, StrError] = str_copy_slice(alloc, p, 0, str_len(p));
    fs.temp_close_and_remove(?tf);
    A.deallocate[u8](alloc, p, str_len(p) + 1);
    if (sel dup.err) { ret res[str, fs.FsError].err{fs.FsError.alloc{A.Error.exhausted{}}}; }
    val root: str = dup.ok;
    val made: err[std_io_error.Error] = fs.create_dir(root, 0o755);
    if (sel made.err) {
        str_free(alloc, root);
        ret res[str, fs.FsError].err{fs.FsError.io{made.err}};
    }
    ret res[str, fs.FsError].ok{root};
}

fun abs_of(alloc: *A.Allocator, root: str, leaf: str) str {
    val r: R.Result[str, str] = format.sprint(alloc, "{}/{}", root, leaf);
    if (R.is_err[str, str](r)) { ret ""; }
    ret R.unwrap_ok[str, str](r);
}

fun read_back(alloc: *A.Allocator, root: str, leaf: str) opt[str] {
    val p: str = abs_of(alloc, root, leaf);
    if (str_empty(p)) { ret opt[str].none{}; }
    val r: res[str, fs.FsError] = fs.read_string(alloc, p);
    str_free(alloc, p);
    if (sel r.err) { ret opt[str].none{}; }
    ret opt[str].some{r.ok};
}

fun payload_entry_count(alloc: *A.Allocator, root: str) usize {
    val r: res[Vector[str], fs.FsError] = fs.read_dir(alloc, root);
    if (sel r.err) { ret 0; }
    var v: Vector[str] = r.ok;
    var n: usize = 0;
    var i: usize = 0;
    for (i < v.len) {
        if (!str_equals(v.data[i], LOCK_LEAF) && !str_equals(v.data[i], ownership.CLAIMS_LEAF)) { n = n + 1; }
        str_free(alloc, v.data[i]);
        i = i + 1;
    }
    vector.dnit[str](?v);
    ret n;
}

rec Rejecting {}
fun reject_all(c: *Rejecting, data: *u8, len: usize) bool {
    ret false;
}

rec Accepting {}
fun accept_all(c: *Accepting, data: *u8, len: usize) bool {
    ret true;
}

# a writer that writes some bytes and then reports failure, standing in for a
# producer that dies partway through
rec PartialThenFail { wrote: usize; }
fun partial_then_fail(p: *PartialThenFail, w: *m_writer.Writer) err[WriteError] {
    m_writer.write_all(w, "partial", 7);
    p.wrote = 7;
    ret err[WriteError].err{WriteError.stalled{7}};
}

test "std.filesystem.transaction.root_open: close errors preserve the primary failure" {
    val refused: res[i32, Error] = res[i32, Error].err{error(CONTAINMENT, OP_ROOT_OPEN)};
    val clean: res[i32, Error] = root_step_result(refused, 0);
    if (sel clean.ok) { ret 1; }
    val original: Error = res_error[i32](clean);
    if (original.kind != CONTAINMENT || original.op != OP_ROOT_OPEN || original.code != 0 || original.cleanup_code != 0) { ret 2; }
    val failed: res[i32, Error] = root_step_result(refused, os.EIO);
    if (sel failed.ok) { ret 3; }
    val primary: Error = res_error[i32](failed);
    if (primary.kind != CONTAINMENT || primary.op != OP_ROOT_OPEN || primary.code != 0 || primary.cleanup_code != os.EIO) { ret 4; }
    val repeated: res[i32, Error] = root_step_result(failed, os.EBADF);
    if (sel repeated.ok || res_error[i32](repeated).cleanup_code != os.EIO) { ret 5; }
    val io: res[i32, Error] = root_step_result(res[i32, Error].err{io_error(OP_ROOT_OPEN, os.EACCES)}, os.EIO);
    if (sel io.ok) { ret 6; }
    val cause: Error = res_error[i32](io);
    if (cause.kind != IO || cause.op != OP_ROOT_OPEN || cause.code != os.EACCES || cause.cleanup_code != os.EIO) { ret 7; }
    ret 0;
}

test "std.filesystem.transaction.root_open: failed advance consumes the newly opened descriptor" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    val opened: res[i32, Error] = open_root_descriptor(base, "");
    if (sel opened.err) { ret 3; }
    val fd: i32 = res_value[i32](opened);
    val kept: res[i32, Error] = root_step_result(opened, 0);
    if (sel kept.err || res_value[i32](kept) != fd) { os.close(fd); ret 4; }
    var st: os.stat_t;
    if (os.stat(fd, ?st) < 0) { os.close(fd); ret 5; }
    val failed: res[i32, Error] = root_step_result(kept, os.EIO);
    if (sel failed.ok) { os.close(fd); ret 6; }
    val failure: Error = res_error[i32](failed);
    if (failure.kind != IO || failure.op != OP_ROOT_OPEN || failure.code != os.EIO || failure.cleanup_code != 0) { ret 7; }
    if (os.stat(fd, ?st) != os.EBADF) { ret 8; }
    val cleanup: res[i32, Error] = root_step_result(res[i32, Error].ok{-1}, os.EIO);
    if (sel cleanup.ok) { ret 9; }
    val both: Error = res_error[i32](cleanup);
    if (both.kind != IO || both.code != os.EIO || both.cleanup_code != os.EBADF) { ret 10; }
    ret 0;
}

test "std.filesystem.transaction.root_open: refuses a symlinked ancestor" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    val real: str = abs_of(?alloc, root, "real");
    val link: str = abs_of(?alloc, root, "link");
    if (fs_refused(fs.create_dir(real, 0o755))) { bad = 2; }
    or {
        if (fs_refused(fs.symlink("real", link))) { bad = 3; }
        or {
            # the link resolves to a directory, but it is not itself one, so the
            # walk must refuse it rather than follow it
            var root_storage_1: Root;
            val opened: err[Error] = root_open(?root_storage_1, root, "link");
            if (sel opened.ok) {
                val g: *Root = ?root_storage_1;
                root_dnit(g);
                bad = 4;
            }
            or {
                if (error_of(opened).kind != CONTAINMENT) { bad = 5; }
            }
        }
    }

    str_free(?alloc, real);
    str_free(?alloc, link);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.root_open: a swapped ancestor cannot redirect an open root" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    val original: str = abs_of(?alloc, root, "target");
    val decoy:    str = abs_of(?alloc, root, "decoy");
    if (fs_refused(fs.create_dir(original, 0o755))) { bad = 2; }
    or {
        if (fs_refused(fs.create_dir(decoy, 0o755))) { bad = 3; }
        or {
            var root_storage_2: Root;
            val opened: err[Error] = root_open(?root_storage_2, root, "target");
            if (sel opened.err) { bad = 4; }
            or {
                val g: *Root = ?root_storage_2;

                # swap a different directory into the name the root was opened
                # under; the descriptor must still refer to the original
                val orig_id: res[Identity, Error] = root_identity(g);
                fs.remove_dir(original);
                fs.rename(decoy, original);

                val now_id: res[Identity, Error] = root_identity(g);
                if (sel orig_id.err || sel now_id.err) { bad = 5; }
                or {
                    if (!identity_equal(res_value[Identity](orig_id),
                                        res_value[Identity](now_id))) { bad = 6; }
                }
                root_dnit(g);
            }
        }
    }

    str_free(?alloc, original);
    str_free(?alloc, decoy);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.claim: refuses a leaf that is not one component" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_3: Root;
    val opened: err[Error] = root_open(?root_storage_3, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_3;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        # every one of these would escape the root or name no entry at all
        var claim_1: Claim;
        val t1: err[Error] = claim(?claim_1, ?alloc, ?g_session.held, "a/b");
        var claim_2: Claim;
        val t2: err[Error] = claim(?claim_2, ?alloc, ?g_session.held, "..");
        var claim_3: Claim;
        val t3: err[Error] = claim(?claim_3, ?alloc, ?g_session.held, ".");
        var claim_4: Claim;
        val t4: err[Error] = claim(?claim_4, ?alloc, ?g_session.held, "");
        if (sel t1.ok) { bad = 3; }
        if (sel t2.ok) { bad = 4; }
        if (sel t3.ok) { bad = 5; }
        if (sel t4.ok) { bad = 6; }
        if (bad == 0 && error_of(t1).kind != CONTAINMENT) { bad = 7; }
        # nothing was created for any of them
        if (bad == 0 && payload_entry_count(?alloc, root) != 0) { bad = 8; }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.commit: absent-at-commit fills a vacancy once and refuses the second time" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_4: Root;
    val opened: err[Error] = root_open(?root_storage_4, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_4;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        var t1_storage: Transaction;
        val t1: err[Error] = prepare_bytes(?t1_storage, ?alloc, t_reserve(?g_session, "out"), "first", 5, 0o644, false, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (t1_storage.state == STATE_PREPARED) { abort(?t1_storage); } }
        if (sel t1.err) { bad = 3; }
        or {
            val a: *Transaction = ?t1_storage;
            val c1: res[Outcome, Error] = commit(a);
            if (sel c1.err) { bad = 4; }
        }

        # the destination now exists, so the same precondition must refuse and
        # must leave what is there alone
        var t2_storage: Transaction;
        val t2: err[Error] = prepare_bytes(?t2_storage, ?alloc, t_reserve(?g_session, "out"), "second", 6, 0o644, false, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (t2_storage.state == STATE_PREPARED) { abort(?t2_storage); } }
        if (bad == 0 && sel t2.err) { bad = 5; }
        or {
            val b: *Transaction = ?t2_storage;
            val c2: res[Outcome, Error] = commit(b);
            if (bad == 0 && sel c2.ok) { bad = 6; }
            or {
                if (bad == 0 && res_error[Outcome](c2).kind != PRECONDITION) { bad = 7; }
            }
        }

        val got: opt[str] = read_back(?alloc, root, "out");
        if (bad == 0 && sel got.none) { bad = 8; }
        or {
            if (bad == 0 && !str_equals(some_of[str](got), "first")) { bad = 9; }
        }
        # the refused commit left no staging entry behind
        if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 10; }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.commit: same-object-since-prepare detects a replacement and preserves it" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); str_free(?alloc, root); }

    var bad: i32 = 0;
    val dest: str = abs_of(?alloc, root, "out");
    fin { str_free(?alloc, dest); }
    if (fs_write_refused(fs.write_bytes(dest, "original", 8, 0o644))) { bad = 2; }
    or {
        var root_storage_5: Root;
        val opened: err[Error] = root_open(?root_storage_5, root, "");
        if (sel opened.err) { bad = 3; }
        or {
            val g: *Root = ?root_storage_5;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
            var t_storage: Transaction;
        val t: err[Error] = prepare_bytes(?t_storage, ?alloc, t_reserve(?g_session, "out"), "ours", 4, 0o644, false, PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
            $if ($mach.build.os == $mach.os.darwin) {
            if (sel t.ok) { ret 94; }
            if (error_of(t).kind != UNSUPPORTED) { ret 95; }
            ret 0;
        }
        if (sel t.err) { bad = 4; }
            or {
                val a: *Transaction = ?t_storage;

                # another writer replaces the destination while we hold staging
                fs.remove_file(dest);
                if (fs_write_refused(fs.write_bytes(dest, "theirs", 6, 0o644))) { bad = 5; }

                val c: res[Outcome, Error] = commit(a);
                if (bad == 0 && sel c.ok) { bad = 6; }
                or {
                    if (bad == 0 && res_error[Outcome](c).kind != PRECONDITION) { bad = 7; }
                }

                # their content survives untouched
                val got: opt[str] = read_back(?alloc, root, "out");
                if (bad == 0 && sel got.none) { bad = 8; }
                or {
                    if (bad == 0 && !str_equals(some_of[str](got), "theirs")) { bad = 9; }
                }
                if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 10; }
            }

        }
    }

    ret bad;
}

test "std.filesystem.transaction.commit: same-object-since-prepare succeeds when absent stays absent" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_6: Root;
    val opened: err[Error] = root_open(?root_storage_6, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_6;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        # nothing was there at prepare and nothing appeared, which is still
        # "unchanged" and must be allowed to land
        var t_storage: Transaction;
        val t: err[Error] = prepare_bytes(?t_storage, ?alloc, t_reserve(?g_session, "out"), "fresh", 5, 0o644, false, PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            val c: res[Outcome, Error] = commit(a);
            if (sel c.err) { bad = 4; }
        }
        val got: opt[str] = read_back(?alloc, root, "out");
        if (bad == 0 && sel got.none) { bad = 5; }
        or {
            if (bad == 0 && !str_equals(some_of[str](got), "fresh")) { bad = 6; }
        }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.commit: refuses a symlink swapped in at the destination" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); str_free(?alloc, root); }

    var bad: i32 = 0;
    val dest:    str = abs_of(?alloc, root, "out");
    fin { str_free(?alloc, dest); }
    val outside: str = abs_of(?alloc, root, "elsewhere");
    fin { str_free(?alloc, outside); }
    if (fs_write_refused(fs.write_bytes(dest, "original", 8, 0o644))) { bad = 2; }
    or {
        if (fs_write_refused(fs.write_bytes(outside, "victim", 6, 0o644))) { bad = 3; }
        or {
            var root_storage_7: Root;
            val opened: err[Error] = root_open(?root_storage_7, root, "");
            if (sel opened.err) { bad = 4; }
            or {
                val g: *Root = ?root_storage_7;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
                var t_storage: Transaction;
        val t: err[Error] = prepare_bytes(?t_storage, ?alloc, t_reserve(?g_session, "out"), "ours", 4, 0o644, false, PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
                $if ($mach.build.os == $mach.os.darwin) {
            if (sel t.ok) { ret 94; }
            if (error_of(t).kind != UNSUPPORTED) { ret 95; }
            ret 0;
        }
        if (sel t.err) { bad = 5; }
                or {
                    val a: *Transaction = ?t_storage;

                    # the destination becomes a symlink pointing at another file;
                    # committing through it would corrupt a file outside the
                    # transaction, so the identity check must catch the swap
                    fs.remove_file(dest);
                    if (fs_refused(fs.symlink("elsewhere", dest))) { bad = 6; }

                    val c: res[Outcome, Error] = commit(a);
                    if (bad == 0 && sel c.ok) { bad = 7; }

                    val victim: opt[str] = read_back(?alloc, root, "elsewhere");
                    if (bad == 0 && sel victim.none) { bad = 8; }
                    or {
                        if (bad == 0 && !str_equals(some_of[str](victim), "victim")) { bad = 9; }
                    }
                }

            }
        }
    }

    ret bad;
}

test "std.filesystem.transaction.prepare: a producer that fails partway leaves no staging and no destination" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_8: Root;
    val opened: err[Error] = root_open(?root_storage_8, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_8;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var p: PartialThenFail;
        p.wrote = 0;
        var t_storage: Transaction;
        val t: err[Error] = prepare[PartialThenFail](?t_storage, ?alloc, t_reserve(?g_session, "out"), ?p, partial_then_fail, 0o644, false, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.ok) { bad = 3; }
        # the bytes that were written are gone with the staging entry, and the
        # destination never existed
        if (bad == 0 && p.wrote != 7) { bad = 4; }
        if (bad == 0 && payload_entry_count(?alloc, root) != 0) { bad = 5; }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.prepare: a failed producer leaves a prior file whole" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_9: Root;
    val opened: err[Error] = root_open(?root_storage_9, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_9;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        # publish a first version the failed attempt must not disturb
        var first_storage: Transaction;
        val first: err[Error] = prepare_bytes(?first_storage, ?alloc, t_reserve(?g_session, "out"), "original", 8, 0o644, false, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (first_storage.state == STATE_PREPARED) { abort(?first_storage); } }
        if (sel first.err) { bad = 3; }
        or {
            val f: *Transaction = ?first_storage;
            if (res_failed[Outcome](commit(f))) { bad = 4; }
        }

        # now a producer that writes some bytes and then reports failure
        if (bad == 0) {
            var p: PartialThenFail;
            p.wrote = 0;
            var t_storage: Transaction;
        val t: err[Error] = prepare[PartialThenFail](?t_storage, ?alloc, t_reserve(?g_session, "out"), ?p, partial_then_fail, 0o644, false, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
            if (sel t.ok) { bad = 5; }
            if (bad == 0 && p.wrote != 7) { bad = 6; }
        }

        # the destination still holds the first version, whole
        if (bad == 0) {
            val back: opt[str] = read_back(?alloc, root, "out");
            if (sel back.none) { bad = 7; }
            or (!str_equals(some_of[str](back), "original")) { bad = 8; }
        }

        # and the staging entry is gone, so the directory holds only the file
        if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 9; }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.validate: a rejection leaves staging for the caller to abort" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_10: Root;
    val opened: err[Error] = root_open(?root_storage_10, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_10;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var t_storage: Transaction;
        val t: err[Error] = prepare_bytes(?t_storage, ?alloc, t_reserve(?g_session, "out"), "content", 7, 0o644, false, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            var rej: Rejecting;
            val v: err[Error] = validate[Rejecting](a, ?rej, reject_all);
            if (sel v.ok) { bad = 4; }
            or {
                if (error_of(v).kind != REJECTED) { bad = 5; }
            }
            # validation does not consume the transaction: the staging entry is
            # still there and still ours
            if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 6; }
            if (bad == 0 && failed(abort(a))) { bad = 7; }
            # the destination never appeared and staging is gone
            if (bad == 0 && payload_entry_count(?alloc, root) != 0) { bad = 8; }
        }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.validate: acceptance sees exactly the staged bytes" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_11: Root;
    val opened: err[Error] = root_open(?root_storage_11, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_11;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var t_storage: Transaction;
        val t: err[Error] = prepare_bytes(?t_storage, ?alloc, t_reserve(?g_session, "out"), "abcdefgh", 8, 0o644, false, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            if (transaction_len(a) != 8) { bad = 4; }
            var acc: Accepting;
            if (failed(validate[Accepting](a, ?acc, accept_all))) { bad = 5; }
            val c: res[Outcome, Error] = commit(a);
            if (bad == 0 && sel c.err) { bad = 6; }
            val got: opt[str] = read_back(?alloc, root, "out");
            if (bad == 0 && sel got.none) { bad = 7; }
            or {
                if (bad == 0 && !str_equals(some_of[str](got), "abcdefgh")) { bad = 8; }
            }
        }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.commit: durability reports what was achieved" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_12: Root;
    val opened: err[Error] = root_open(?root_storage_12, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_12;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        var t1_storage: Transaction;
        val t1: err[Error] = prepare_bytes(?t1_storage, ?alloc, t_reserve(?g_session, "full"), "x", 1, 0o644, false, PrepareOptions{precondition: PRE_ABSENT, durability: durability_full(true)});
        fin { if (t1_storage.state == STATE_PREPARED) { abort(?t1_storage); } }
        if (sel t1.err) { bad = 3; }
        or {
            val a: *Transaction = ?t1_storage;
            val c: res[Outcome, Error] = commit(a);
            if (sel c.err) { bad = 4; }
            or {
                val out: Outcome = res_value[Outcome](c);
                if (out.achieved != DUR_FULL) { bad = 5; }
                if (out.shortfall) { bad = 6; }
            }
        }

        var t2_storage: Transaction;
        val t2: err[Error] = prepare_bytes(?t2_storage, ?alloc, t_reserve(?g_session, "none"), "x", 1, 0o644, false, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (t2_storage.state == STATE_PREPARED) { abort(?t2_storage); } }
        if (bad == 0 && sel t2.err) { bad = 7; }
        or {
            val b: *Transaction = ?t2_storage;
            val c: res[Outcome, Error] = commit(b);
            if (bad == 0 && sel c.err) { bad = 8; }
            or {
                val out: Outcome = res_value[Outcome](c);
                # asking for nothing must report nothing, not a silent upgrade
                if (bad == 0 && out.achieved != DUR_NONE) { bad = 9; }
                if (bad == 0 && out.shortfall) { bad = 10; }
            }
        }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.prepare: the digest matches an independent sha-256" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_13: Root;
    val opened: err[Error] = root_open(?root_storage_13, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_13;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var t_storage: Transaction;
        val t: err[Error] = prepare_bytes(?t_storage, ?alloc, t_reserve(?g_session, "out"), "the quick brown fox", 19, 0o644, true, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            if (!transaction_has_digest(a)) { bad = 4; }

            var got: [32]u8;
            if (bad == 0 && !transaction_digest(a, ?got)) { bad = 5; }

            var want: [32]u8;
            var st: sha256.State = sha256.init();
            sha256.update(?st, "the quick brown fox", 19);
            sha256.final(?st, ?want[0]);

            var i: usize = 0;
            for (i < 32 && bad == 0) {
                if (got[i] != want[i]) { bad = 6; }
                i = i + 1;
            }
            abort(a);
        }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.abort: removes staging and leaves no destination" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_14: Root;
    val opened: err[Error] = root_open(?root_storage_14, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_14;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var t_storage: Transaction;
        val t: err[Error] = prepare_bytes(?t_storage, ?alloc, t_reserve(?g_session, "out"), "discard", 7, 0o644, false, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            if (payload_entry_count(?alloc, root) != 1) { bad = 4; }
            if (bad == 0 && failed(abort(a))) { bad = 5; }
            if (bad == 0 && payload_entry_count(?alloc, root) != 0) { bad = 6; }
            # the transaction is spent: a second abort is a contract error, not
            # a second removal
            if (bad == 0 && !failed(abort(a))) { bad = 7; }
        }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.recover: removes only this module's residue" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    # one file the caller owns, one that merely looks similar, and two real
    # pieces of residue
    val keep:      str = abs_of(?alloc, root, "keep.txt");
    val lookalike: str = abs_of(?alloc, root, "machtxn.not-ours");
    val residue1:  str = abs_of(?alloc, root, ".machtxn.0011223344556677");
    val residue2:  str = abs_of(?alloc, root, ".machtxn.8899aabbccddeeff");
    fs.write_bytes(keep, "keep", 4, 0o644);
    fs.write_bytes(lookalike, "keep", 4, 0o644);
    fs.write_bytes(residue1, "junk", 4, 0o644);
    fs.write_bytes(residue2, "junk", 4, 0o644);

    var root_storage_15: Root;
    val opened: err[Error] = root_open(?root_storage_15, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_15;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        val swept: res[usize, Error] = t_end_batch_and_recover(?g_session, "");
        if (sel swept.err) { bad = 3; }
        or {
            if (res_value[usize](swept) != 2) { bad = 4; }
        }
        if (bad == 0 && absent(read_back(?alloc, root, "keep.txt"))) { bad = 5; }
        if (bad == 0 && absent(read_back(?alloc, root, "machtxn.not-ours"))) { bad = 6; }
        if (bad == 0 && !absent(read_back(?alloc, root, ".machtxn.0011223344556677"))) { bad = 7; }
        if (bad == 0 && payload_entry_count(?alloc, root) != 2) { bad = 8; }

    }

    str_free(?alloc, keep); str_free(?alloc, lookalike);
    str_free(?alloc, residue1); str_free(?alloc, residue2);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

fun t_recovery_entry_name(out: *u8, index: usize, residue: bool) {
    var width: usize = 160;
    var i: usize = 0;
    if (residue) {
        val prefix: str = ".machtxn.";
        for (i < str_len(prefix)) { out[i] = prefix[i]; i = i + 1; }
        width = i + 16;
    }
    for (i < width) { out[i] = 'a'; i = i + 1; }
    out[width] = 0;
    val hex: str = "0123456789abcdef";
    var value: usize = index;
    i = width;
    for (i > width - 4) {
        i = i - 1;
        out[i] = hex[value % 16];
        value = value / 16;
    }
}

fun t_recovery_streaming(a: *A.Allocator, session: *TestSession, base: str) i32 {
    val root: *Root = session.held.root;
    var name: [161]u8;
    var i: usize = 0;
    # ordinary names alone exceed one native directory buffer
    for (i < 512) {
        t_recovery_entry_name(?name[0], i, false);
        if (t_fixture_write(root, (?name[0])::str, "keep") != 0) { ret 1; }
        if (i % 8 == 0) {
            t_recovery_entry_name(?name[0], i, true);
            if (i % 16 == 0) {
                if (os.make_dir(root.dirfd, (?name[0])::str, 0o700) < 0) { ret 2; }
            }
            or {
                if (t_fixture_write(root, (?name[0])::str, "residue") != 0) { ret 3; }
            }
        }
        i = i + 1;
    }
    if (t_fixture_write(root, ".machtxn.not-residue", "keep") != 0) { ret 4; }
    var tracker: testing.Testing;
    val tracker_r: err[A.Error] = testing.make(?tracker);
    if (sel tracker_r.err) { ret 5; }
    fin { testing.dnit(?tracker); }
    testing.fail_at_ordinal(?tracker, 1);
    val swept: res[usize, Error] = recover(testing.allocator_of(?tracker), ?session.held, "");
    if (sel swept.err) { ret 6; }
    if (res_value[usize](swept) != 64 || !session.held.initialized) { ret 7; }
    if (tracker.attempts != 0 || testing.leaked(?tracker) || testing.double_free_count(?tracker) != 0) { ret 8; }
    i = 0;
    for (i < 512) {
        t_recovery_entry_name(?name[0], i, false);
        var bytes: [4]u8;
        val read: res[opt[usize], Error] = entry_read_all(root, (?name[0])::str, ?bytes[0], 4);
        if (sel read.err) { ret 9; }
        val length: opt[usize] = res_value[opt[usize]](read);
        if (sel length.none || some_of[usize](length) != 4) { ret 10; }
        if (bytes[0] != 'k' || bytes[1] != 'e' || bytes[2] != 'e' || bytes[3] != 'p') { ret 11; }
        if (i % 8 == 0) {
            t_recovery_entry_name(?name[0], i, true);
            if (!entry_absent(root.dirfd, (?name[0])::str)) { ret 12; }
        }
        i = i + 1;
    }
    if (entry_absent(root.dirfd, ".machtxn.not-residue")) { ret 13; }
    val again: res[usize, Error] = recover(testing.allocator_of(?tracker), ?session.held, "");
    if (sel again.err || res_value[usize](again) != 0) { ret 14; }
    if (tracker.attempts != 0 || !session.held.initialized) { ret 15; }
    if (t_reserve(session, "after-recovery") == nil) { ret 16; }
    ret 0;
}

test "std.filesystem.transaction.recover: streaming mutation preserves entries without per-name allocation" {
    ret t_journal_run(t_recovery_streaming);
}

test "std.filesystem.transaction.recover: a crash between prepare and commit leaves recoverable residue only" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    val dest: str = abs_of(?alloc, root, "out");
    fs.write_bytes(dest, "published", 9, 0o644);

    var root_storage_16: Root;
    val opened: err[Error] = root_open(?root_storage_16, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_16;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        # process death closes descriptors but leaves prepared entries on disk
        var t_storage: Transaction;
        val t: err[Error] = prepare_bytes(?t_storage, ?alloc, t_reserve(?g_session, "out"), "unfinished", 10, 0o644, false, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val abandoned: *Transaction = ?t_storage;
            if (os.close(abandoned.staging_fd) < 0) { bad = 12; }
            abandoned.staging_fd = -1;
            transaction_cleanup(abandoned, false, OP_ABORT);

            # the destination still holds the old content: a crash mid-flight
            # never exposes a partial publication
            val got: opt[str] = read_back(?alloc, root, "out");
            if (sel got.none) { bad = 4; }
            or {
                if (!str_equals(some_of[str](got), "published")) { bad = 5; }
            }
            if (bad == 0 && payload_entry_count(?alloc, root) != 2) { bad = 6; }

            # a later run sweeps the residue and the destination is untouched
            val swept: res[usize, Error] = t_end_batch_and_recover(?g_session, "out");
            if (bad == 0 && sel swept.err) { bad = 7; }
            or {
                if (bad == 0 && res_value[usize](swept) != 1) { bad = 8; }
            }
            if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 9; }
            val after: opt[str] = read_back(?alloc, root, "out");
            if (bad == 0 && sel after.none) { bad = 10; }
            or {
                if (bad == 0 && !str_equals(some_of[str](after), "published")) { bad = 11; }
            }
        }

    }

    str_free(?alloc, dest);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.lock: a second holder is excluded and release readmits" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_17: Root;
    val o1: err[Error] = root_open(?root_storage_17, root, "");
    var root_storage_18: Root;
    val o2: err[Error] = root_open(?root_storage_18, root, "");
    if (sel o1.err || sel o2.err) { bad = 2; }
    or {
        val g1: *Root = ?root_storage_17;
        val g2: *Root = ?root_storage_18;

        var lock_storage_1: Lock;
        val first: err[Error] = lock(?lock_storage_1, g1);
        if (sel first.err) { bad = 3; }
        or {
            val held: *Lock = ?lock_storage_1;

            # a second claim on the same root must be refused, and refused as
            # "busy" rather than as some generic I/O failure
            var lock_storage_2: Lock;
            val second: err[Error] = lock(?lock_storage_2, g2);
            if (sel second.ok) {
                val l2: *Lock = ?lock_storage_2;
                unlock(l2);
                bad = 4;
            }
            or {
                if (error_of(second).kind != LOCK_HELD) { bad = 5; }
            }

            unlock(held);
            if (bad == 0 && held.fd != -1) { bad = 6; }

            # releasing readmits the next writer
            var lock_storage_3: Lock;
            val third: err[Error] = lock(?lock_storage_3, g2);
            if (bad == 0 && sel third.err) { bad = 7; }
            or {
                val l3: *Lock = ?lock_storage_3;
                unlock(l3);
                # unlock is idempotent, so an exit path may call it twice
                unlock(l3);
            }
        }
        root_dnit(g1);
        root_dnit(g2);
    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.lock: the sentinel is not residue and survives a sweep" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_19: Root;
    val opened: err[Error] = root_open(?root_storage_19, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_19;
        var lock_storage_4: Lock;
        val l: err[Error] = lock(?lock_storage_4, g);
        if (sel l.err) { bad = 3; }
        or {
            val held: *Lock = ?lock_storage_4;
            # sweeping while holding the lock must not remove the lock file
            val swept: res[usize, Error] = recover(?alloc, held, "");
            if (sel swept.err) { bad = 4; }
            or {
                if (res_value[usize](swept) != 0) { bad = 5; }
            }
            if (bad == 0 && absent(read_back(?alloc, root, LOCK_LEAF))) { bad = 6; }
            unlock(held);
        }
        root_dnit(g);
    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

# the project-shaped inventory the tree tests publish
fun sample_inventory(alloc: *A.Allocator) Inventory {
    var inv: Inventory = inventory_init(alloc);
    inventory_push(?inv, entry_file("mach.toml", "[project]", 9, 0o644));
    inventory_push(?inv, entry_dir("src", 0o755));
    inventory_push(?inv, entry_file("src/main.mach", "fun main() {}", 13, 0o644));
    ret inv;
}

rec OwnsNames {
    names: *str;
    count: usize;
}

fun owns_listed(c: *OwnsNames, rel: str, is_dir: bool) bool {
    var i: usize = 0;
    for (i < c.count) {
        if (str_equals(c.names[i], rel)) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "std.filesystem.transaction.prepare_subtree: publishes a whole tree in one step" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_20: Root;
    val opened: err[Error] = root_open(?root_storage_20, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_20;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var inv: Inventory = sample_inventory(?alloc);

        var t_storage: Transaction;
        val t: err[Error] = prepare_subtree(?t_storage, ?alloc, t_reserve(?g_session, "project"), ?inv, 0o755, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            # while staged, the destination does not exist at all: no reader can
            # observe a half-built tree
            if (!absent(read_back(?alloc, root, "project/mach.toml"))) { bad = 4; }

            val c: res[Outcome, Error] = commit(a);
            if (bad == 0 && sel c.err) { bad = 5; }
        }

        val manifest: opt[str] = read_back(?alloc, root, "project/mach.toml");
        if (bad == 0 && sel manifest.none) { bad = 6; }
        or {
            if (bad == 0 && !str_equals(some_of[str](manifest), "[project]")) { bad = 7; }
        }
        val main: opt[str] = read_back(?alloc, root, "project/src/main.mach");
        if (bad == 0 && sel main.none) { bad = 8; }
        or {
            if (bad == 0 && !str_equals(some_of[str](main), "fun main() {}")) { bad = 9; }
        }
        # exactly the destination, with no staging left over
        if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 10; }

        inventory_dnit(?inv);

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.prepare_subtree: a concurrent appearance conflicts and preserves the interloper" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_21: Root;
    val opened: err[Error] = root_open(?root_storage_21, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_21;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var inv: Inventory = sample_inventory(?alloc);

        var t_storage: Transaction;
        val t: err[Error] = prepare_subtree(?t_storage, ?alloc, t_reserve(?g_session, "project"), ?inv, 0o755, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;

            # somebody else creates the destination while we were building
            val theirs: str = abs_of(?alloc, root, "project");
            fs.create_dir(theirs, 0o755);
            val marker: str = abs_of(?alloc, root, "project/theirs.txt");
            fs.write_bytes(marker, "theirs", 6, 0o644);

            val c: res[Outcome, Error] = commit(a);
            if (sel c.ok) { bad = 4; }
            or {
                if (res_error[Outcome](c).kind != PRECONDITION) { bad = 5; }
            }

            # their directory is intact and our staging is gone
            val kept: opt[str] = read_back(?alloc, root, "project/theirs.txt");
            if (bad == 0 && sel kept.none) { bad = 6; }
            if (bad == 0 && !absent(read_back(?alloc, root, "project/mach.toml"))) { bad = 7; }
            if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 8; }

            str_free(?alloc, theirs);
            str_free(?alloc, marker);
        }
        inventory_dnit(?inv);

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.abort: removes a staged subtree entirely" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_22: Root;
    val opened: err[Error] = root_open(?root_storage_22, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_22;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var inv: Inventory = sample_inventory(?alloc);
        var t_storage: Transaction;
        val t: err[Error] = prepare_subtree(?t_storage, ?alloc, t_reserve(?g_session, "project"), ?inv, 0o755, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            if (payload_entry_count(?alloc, root) != 1) { bad = 4; }
            # the staged tree has real content in it, so this exercises the
            # recursive removal rather than a single unlink
            if (bad == 0 && failed(abort(a))) { bad = 5; }
            if (bad == 0 && payload_entry_count(?alloc, root) != 0) { bad = 6; }
        }
        inventory_dnit(?inv);

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.descend: finds where an existing tree stops" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    val a_dir: str = abs_of(?alloc, root, "a");
    fs.create_dir(a_dir, 0o755);

    # one level missing
    var descent1: Descent;
    val d1: res[bool, Error] = descend(?descent1, ?alloc, root, "a/b");
    if (sel d1.err) { bad = 2; }
    or {
        val present1: bool = res_value[bool](d1);
        if (!present1) { bad = 3; }
        or {
            val d: *Descent = ?descent1;
            if (!str_equals(d.first_missing, "b")) { bad = 4; }
            if (!str_empty(d.remainder)) { bad = 5; }
            descent_dnit(?alloc, d);
        }
    }

    # several levels missing: the first missing one is what gets published
    var descent2: Descent;
    val d2: res[bool, Error] = descend(?descent2, ?alloc, root, "a/b/c/d");
    if (bad == 0 && sel d2.err) { bad = 6; }
    or {
        val present2: bool = res_value[bool](d2);
        if (bad == 0 && !present2) { bad = 7; }
        or {
            val d: *Descent = ?descent2;
            if (bad == 0 && !str_equals(d.first_missing, "b")) { bad = 8; }
            if (bad == 0 && !str_equals(d.remainder, "c/d")) { bad = 9; }
            descent_dnit(?alloc, d);
        }
    }

    # nothing missing at all
    var descent3: Descent;
    val d3: res[bool, Error] = descend(?descent3, ?alloc, root, "a");
    if (bad == 0 && sel d3.err) { bad = 10; }
    or {
        if (bad == 0 && res_value[bool](d3)) { bad = 11; }
    }

    # a file blocks the walk: it is not a directory, so it cannot be traversed
    val blocker: str = abs_of(?alloc, root, "file");
    fs.write_bytes(blocker, "x", 1, 0o644);
    var descent4: Descent;
    val d4: res[bool, Error] = descend(?descent4, ?alloc, root, "file/below");
    if (bad == 0 && sel d4.ok) { bad = 12; }
    or {
        if (bad == 0 && res_error[bool](d4).kind != CONTAINMENT) { bad = 13; }
    }

    str_free(?alloc, a_dir);
    str_free(?alloc, blocker);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.commit_replacing_owned: replaces recognized content and stale entries disappear" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    # an existing tree with a page that the new tree does not have
    val d:  str = abs_of(?alloc, root, "site");
    val f1: str = abs_of(?alloc, root, "site/mach.toml");
    val f2: str = abs_of(?alloc, root, "site/stale.html");
    fs.create_dir(d, 0o755);
    fs.write_bytes(f1, "old", 3, 0o644);
    fs.write_bytes(f2, "stale", 5, 0o644);

    var names: [2]str;
    names[0] = "mach.toml";
    names[1] = "stale.html";
    var owns: OwnsNames;
    owns.names = ?names[0];
    owns.count = 2;

    var root_storage_23: Root;
    val opened: err[Error] = root_open(?root_storage_23, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_23;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var inv: Inventory = sample_inventory(?alloc);
        var t_storage: Transaction;
        val t: err[Error] = prepare_subtree(?t_storage, ?alloc, t_reserve(?g_session, "site"), ?inv, 0o755, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            val c: res[Outcome, Error] = commit_replacing_owned[OwnsNames](a, ?owns, owns_listed);
            if (sel c.err) { bad = 4; }
        }
        # the new content is in place
        val m: opt[str] = read_back(?alloc, root, "site/mach.toml");
        if (bad == 0 && sel m.none) { bad = 5; }
        or {
            if (bad == 0 && !str_equals(some_of[str](m), "[project]")) { bad = 6; }
        }
        # and the page the new tree does not have is gone rather than surviving
        if (bad == 0 && !absent(read_back(?alloc, root, "site/stale.html"))) { bad = 7; }
        # no backup and no staging left behind
        if (bad == 0 && payload_entry_count(?alloc, root) != 2) { bad = 8; }

        inventory_dnit(?inv);

    }

    str_free(?alloc, d); str_free(?alloc, f1); str_free(?alloc, f2);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.commit_replacing_owned: refuses an unrecognized entry and touches nothing" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    val d:  str = abs_of(?alloc, root, "site");
    val f1: str = abs_of(?alloc, root, "site/mach.toml");
    val f2: str = abs_of(?alloc, root, "site/handwritten.txt");
    fs.create_dir(d, 0o755);
    fs.write_bytes(f1, "old", 3, 0o644);
    fs.write_bytes(f2, "precious", 8, 0o644);

    # the caller claims only the manifest, so the handwritten file is a
    # stranger and the whole replacement must be refused
    var names: [1]str;
    names[0] = "mach.toml";
    var owns: OwnsNames;
    owns.names = ?names[0];
    owns.count = 1;

    var root_storage_24: Root;
    val opened: err[Error] = root_open(?root_storage_24, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_24;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var inv: Inventory = sample_inventory(?alloc);
        var t_storage: Transaction;
        val t: err[Error] = prepare_subtree(?t_storage, ?alloc, t_reserve(?g_session, "site"), ?inv, 0o755, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            val c: res[Outcome, Error] = commit_replacing_owned[OwnsNames](a, ?owns, owns_listed);
            if (sel c.ok) { bad = 4; }
            or {
                if (res_error[Outcome](c).kind != CONFLICT) { bad = 5; }
            }
        }
        # everything that was there is still there, unchanged
        val kept: opt[str] = read_back(?alloc, root, "site/handwritten.txt");
        if (bad == 0 && sel kept.none) { bad = 6; }
        or {
            if (bad == 0 && !str_equals(some_of[str](kept), "precious")) { bad = 7; }
        }
        val old: opt[str] = read_back(?alloc, root, "site/mach.toml");
        if (bad == 0 && sel old.none) { bad = 8; }
        or {
            if (bad == 0 && !str_equals(some_of[str](old), "old")) { bad = 9; }
        }
        # and the refused replacement left no staging behind
        if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 10; }

        inventory_dnit(?inv);

    }

    str_free(?alloc, d); str_free(?alloc, f1); str_free(?alloc, f2);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.commit_replacing_owned: refuses when the target does not exist" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var names: [1]str;
    names[0] = "mach.toml";
    var owns: OwnsNames;
    owns.names = ?names[0];
    owns.count = 1;

    var root_storage_25: Root;
    val opened: err[Error] = root_open(?root_storage_25, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_25;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        var inv: Inventory = sample_inventory(?alloc);
        var t_storage: Transaction;
        val t: err[Error] = prepare_subtree(?t_storage, ?alloc, t_reserve(?g_session, "site"), ?inv, 0o755, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            # replacing is not creating: with nothing there this is a
            # precondition failure, not an accidental publish
            val c: res[Outcome, Error] = commit_replacing_owned[OwnsNames](a, ?owns, owns_listed);
            if (sel c.ok) { bad = 4; }
            or {
                if (res_error[Outcome](c).kind != PRECONDITION) { bad = 5; }
            }
        }
        if (bad == 0 && payload_entry_count(?alloc, root) != 0) { bad = 6; }
        inventory_dnit(?inv);

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.recover: every backup crash state resolves deterministically" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    var bad: i32 = 0;

    # state one: a crash between the two renames, so the destination is missing
    # and only the backup holds the content. recovery must put it back.
    val r1_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel r1_r.err) { ret 1; }
    val r1: str = r1_r.ok;
    val b1: str = abs_of(?alloc, r1, ".machtxn.backup/site");
    fs.create_dir_all(?alloc, b1, 0o755);
    val b1f: str = abs_of(?alloc, r1, ".machtxn.backup/site/keep.txt");
    fs.write_bytes(b1f, "restored", 8, 0o644);

    var root_storage_26: Root;
    val o1: err[Error] = root_open(?root_storage_26, r1, "");
    if (sel o1.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_26;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        if (res_failed[usize](t_end_batch_and_recover(?g_session, "site"))) { bad = 3; }
        val back: opt[str] = read_back(?alloc, r1, "site/keep.txt");
        if (bad == 0 && sel back.none) { bad = 4; }
        or {
            if (bad == 0 && !str_equals(some_of[str](back), "restored")) { bad = 5; }
        }
        if (bad == 0 && payload_entry_count(?alloc, r1) != 2) { bad = 6; }

    }
    str_free(?alloc, b1); str_free(?alloc, b1f);
    fs.remove_all(?alloc, r1); str_free(?alloc, r1);

    # state two: a crash after the second rename, so both the destination and a
    # finished backup are present. recovery must drop the backup and keep the
    # new content.
    val r2_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel r2_r.err) { ret 1; }
    val r2: str = r2_r.ok;
    val d2:  str = abs_of(?alloc, r2, "site");
    val d2f: str = abs_of(?alloc, r2, "site/keep.txt");
    val b2:  str = abs_of(?alloc, r2, ".machtxn.backup/site");
    val b2f: str = abs_of(?alloc, r2, ".machtxn.backup/site/keep.txt");
    fs.create_dir(d2, 0o755);
    fs.write_bytes(d2f, "current", 7, 0o644);
    fs.create_dir_all(?alloc, b2, 0o755);
    fs.write_bytes(b2f, "previous", 8, 0o644);

    var root_storage_27: Root;
    val o2: err[Error] = root_open(?root_storage_27, r2, "");
    if (bad == 0 && sel o2.err) { bad = 7; }
    or {
        val g: *Root = ?root_storage_27;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        if (bad == 0 && res_failed[usize](t_end_batch_and_recover(?g_session, "site"))) { bad = 8; }
        val kept: opt[str] = read_back(?alloc, r2, "site/keep.txt");
        if (bad == 0 && sel kept.none) { bad = 9; }
        or {
            if (bad == 0 && !str_equals(some_of[str](kept), "current")) { bad = 10; }
        }
        if (bad == 0 && payload_entry_count(?alloc, r2) != 2) { bad = 11; }

    }
    str_free(?alloc, d2); str_free(?alloc, d2f);
    str_free(?alloc, b2); str_free(?alloc, b2f);
    fs.remove_all(?alloc, r2); str_free(?alloc, r2);

    # state three: no backup at all, which is the ordinary case and must be
    # left completely alone
    val r3_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel r3_r.err) { ret 1; }
    val r3: str = r3_r.ok;
    val d3:  str = abs_of(?alloc, r3, "site");
    val d3f: str = abs_of(?alloc, r3, "site/keep.txt");
    fs.create_dir(d3, 0o755);
    fs.write_bytes(d3f, "untouched", 9, 0o644);

    var root_storage_28: Root;
    val o3: err[Error] = root_open(?root_storage_28, r3, "");
    if (bad == 0 && sel o3.err) { bad = 12; }
    or {
        val g: *Root = ?root_storage_28;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        val swept: res[usize, Error] = t_end_batch_and_recover(?g_session, "site");
        if (bad == 0 && sel swept.err) { bad = 13; }
        or {
            if (bad == 0 && res_value[usize](swept) != 0) { bad = 14; }
        }
        val same: opt[str] = read_back(?alloc, r3, "site/keep.txt");
        if (bad == 0 && sel same.none) { bad = 15; }
        or {
            if (bad == 0 && !str_equals(some_of[str](same), "untouched")) { bad = 16; }
        }

    }
    str_free(?alloc, d3); str_free(?alloc, d3f);
    fs.remove_all(?alloc, r3); str_free(?alloc, r3);

    ret bad;
}

test "std.filesystem.transaction.commit_replacing_owned: recovers a stale backup before claiming and replacing" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    # a previous run crashed between the renames: only the backup exists
    val b:  str = abs_of(?alloc, root, ".machtxn.backup/site");
    val bf: str = abs_of(?alloc, root, ".machtxn.backup/site/mach.toml");
    fs.create_dir_all(?alloc, b, 0o755);
    fs.write_bytes(bf, "old", 3, 0o644);

    var names: [1]str;
    names[0] = "mach.toml";
    var owns: OwnsNames;
    owns.names = ?names[0];
    owns.count = 1;

    var root_storage_29: Root;
    val opened: err[Error] = root_open(?root_storage_29, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_29;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
        if (res_failed[usize](t_end_batch_and_recover(?g_session, "site"))) { ret 91; }
        var inv: Inventory = sample_inventory(?alloc);
        var t_storage: Transaction;
        val t: err[Error] = prepare_subtree(?t_storage, ?alloc, t_reserve(?g_session, "site"), ?inv, 0o755, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (t_storage.state == STATE_PREPARED) { abort(?t_storage); } }
        if (sel t.err) { bad = 3; }
        or {
            val a: *Transaction = ?t_storage;
            val c: res[Outcome, Error] = commit_replacing_owned[OwnsNames](a, ?owns, owns_listed);
            if (sel c.err) { bad = 4; }
        }
        val m: opt[str] = read_back(?alloc, root, "site/mach.toml");
        if (bad == 0 && sel m.none) { bad = 6; }
        or {
            if (bad == 0 && !str_equals(some_of[str](m), "[project]")) { bad = 7; }
        }
        if (bad == 0 && payload_entry_count(?alloc, root) != 2) { bad = 8; }
        inventory_dnit(?inv);

    }

    str_free(?alloc, b); str_free(?alloc, bf);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.prepare: failing at every allocation ordinal leaks nothing and leaves no residue" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    val dest: str = abs_of(?alloc, root, "out");
    fs.write_bytes(dest, "published", 9, 0o644);

    var root_storage_30: Root;
    val opened: err[Error] = root_open(?root_storage_30, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_30;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        # walk the ordinal past the number of allocations a whole prepare and
        # commit makes, so the sweep covers every allocation site including the
        # middle ones, not just the first and last
        var ordinal: usize = 1;
        for (ordinal <= 24 && bad == 0) {
            var t: testing.Testing;
            val made: err[A.Error] = testing.make(?t);
            if (sel made.err) { bad = 3; cnt; }
            testing.fail_at_ordinal(?t, ordinal);

            var txn_storage: Transaction;
        val txn: err[Error] = prepare_bytes(?txn_storage, testing.allocator_of(?t), t_reserve(?g_session, "out"), "replacement", 11, 0o644, true, PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()});
        fin { if (txn_storage.state == STATE_PREPARED) { abort(?txn_storage); } }
            if (sel txn.ok) {
                val a: *Transaction = ?txn_storage;
                # the injected failure may land during commit instead
                commit(a);
            }

            # whatever failed and wherever it failed, nothing was left allocated
            if (testing.leaked(?t)) { bad = 4; }
            if (bad == 0 && testing.double_free_count(?t) != 0) { bad = 5; }
            if (bad == 0 && testing.tracking_exhausted(?t)) { bad = 6; }
            testing.dnit(?t);

            # and the directory holds only the destination: either the old
            # content or the new one, never staging residue and never nothing
            if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 7; }
            val now: opt[str] = read_back(?alloc, root, "out");
            if (bad == 0 && sel now.none) { bad = 8; }
            or {
                val s: str = some_of[str](now);
                if (bad == 0 && !str_equals(s, "published") && !str_equals(s, "replacement")) { bad = 9; }
            }

            # restore the starting state for the next ordinal
            fs.remove_file(dest);
            fs.write_bytes(dest, "published", 9, 0o644);
            ordinal = ordinal + 1;
        }

    }

    str_free(?alloc, dest);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.prepare_subtree: failing at every allocation ordinal leaves no destination and no residue" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_31: Root;
    val opened: err[Error] = root_open(?root_storage_31, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_31;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        var ordinal: usize = 1;
        for (ordinal <= 24 && bad == 0) {
            var t: testing.Testing;
            val made: err[A.Error] = testing.make(?t);
            if (sel made.err) { bad = 3; cnt; }
            val ta: *A.Allocator = testing.allocator_of(?t);

            var inv: Inventory = inventory_init(ta);
            inventory_push(?inv, entry_file("mach.toml", "[project]", 9, 0o644));
            inventory_push(?inv, entry_dir("src", 0o755));
            inventory_push(?inv, entry_file("src/main.mach", "fun main() {}", 13, 0o644));

            testing.fail_at_ordinal(?t, ordinal);
            var txn_storage: Transaction;
        val txn: err[Error] = prepare_subtree(?txn_storage, ta, t_reserve(?g_session, "project"), ?inv, 0o755, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (txn_storage.state == STATE_PREPARED) { abort(?txn_storage); } }
            if (sel txn.ok) {
                val a: *Transaction = ?txn_storage;
                abort(a);
            }
            testing.clear_failure(?t);
            inventory_dnit(?inv);

            if (testing.leaked(?t)) { bad = 4; }
            if (bad == 0 && testing.double_free_count(?t) != 0) { bad = 5; }
            testing.dnit(?t);

            # an aborted or failed subtree prepare never leaves the destination
            # half-built, and never leaves its private tree behind
            if (bad == 0 && payload_entry_count(?alloc, root) != 0) { bad = 6; }
            ordinal = ordinal + 1;
        }

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.entry_probe: describes presence, kind and identity without following symlinks" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    val f: str = abs_of(?alloc, root, "file");
    val d: str = abs_of(?alloc, root, "dir");
    val l: str = abs_of(?alloc, root, "link");
    fs.write_bytes(f, "x", 1, 0o644);
    fs.create_dir(d, 0o755);
    fs.symlink("file", l);

    var root_storage_32: Root;
    val opened: err[Error] = root_open(?root_storage_32, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_32;

        val pf: res[EntryProbe, Error] = entry_probe(g, "file");
        if (sel pf.err) { bad = 3; }
        or {
            val e: EntryProbe = res_value[EntryProbe](pf);
            if (!e.present || !e.is_regular || e.is_directory) { bad = 4; }
        }

        val pd: res[EntryProbe, Error] = entry_probe(g, "dir");
        if (bad == 0 && sel pd.err) { bad = 5; }
        or {
            val e: EntryProbe = res_value[EntryProbe](pd);
            if (bad == 0 && (!e.present || !e.is_directory || e.is_regular)) { bad = 6; }
        }

        # a symlink is present but is neither a file nor a directory: the probe
        # reports the link, not what it points at
        val pl: res[EntryProbe, Error] = entry_probe(g, "link");
        if (bad == 0 && sel pl.err) { bad = 7; }
        or {
            val e: EntryProbe = res_value[EntryProbe](pl);
            if (bad == 0 && (!e.present || e.is_regular || e.is_directory)) { bad = 8; }
        }

        # absent is an answer, not a failure
        val pa: res[EntryProbe, Error] = entry_probe(g, "missing");
        if (bad == 0 && sel pa.err) { bad = 9; }
        or {
            if (bad == 0 && res_value[EntryProbe](pa).present) { bad = 10; }
        }

        # a name with a separator cannot be probed at all
        if (bad == 0 && !res_failed[EntryProbe](entry_probe(g, "dir/x"))) { bad = 11; }

        root_dnit(g);
    }

    str_free(?alloc, f); str_free(?alloc, d); str_free(?alloc, l);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction: root mutations stay inside the root" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    var root_storage_33: Root;
    val opened: err[Error] = root_open(?root_storage_33, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_33;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

        val mk: res[bool, Error] = entry_make_dir(t_reserve(?g_session, "made"), 0o755);
        if (sel mk.err) { bad = 3; }
        or {
            if (!res_value[bool](mk)) { bad = 4; }
        }
        # a second create reports "already there" rather than failing
        val mk2: res[bool, Error] = entry_make_dir(t_reserve(?g_session, "made"), 0o755);
        if (bad == 0 && sel mk2.err) { bad = 5; }
        or {
            if (bad == 0 && res_value[bool](mk2)) { bad = 6; }
        }

        val f: str = abs_of(?alloc, root, "a.txt");
        fs.write_bytes(f, "content", 7, 0o644);
        if (bad == 0 && failed(entry_rename(t_reserve(?g_session, "a.txt"), t_reserve(?g_session, "b.txt")))) { bad = 7; }
        if (bad == 0 && absent(read_back(?alloc, root, "b.txt"))) { bad = 8; }

        # every mutation refuses a name that would leave the root
        if (bad == 0 && !failed(entry_rename(t_reserve(?g_session, "b.txt"), t_reserve(?g_session, "../escaped")))) { bad = 9; }
        if (bad == 0 && !failed(entry_unlink(t_reserve(?g_session, "../escaped")))) { bad = 10; }
        if (bad == 0 && !res_failed[bool](entry_make_dir(t_reserve(?g_session, "../escaped"), 0o755))) { bad = 11; }

        if (bad == 0 && failed(entry_unlink(t_reserve(?g_session, "b.txt")))) { bad = 12; }
        # removing something already gone is success
        if (bad == 0 && failed(entry_unlink(t_reserve(?g_session, "b.txt")))) { bad = 13; }

        # an empty directory goes; a populated one is left alone
        val inner: str = abs_of(?alloc, root, "made/keep.txt");
        fs.write_bytes(inner, "keep", 4, 0o644);
        if (bad == 0 && failed(entry_rmdir_if_empty(t_reserve(?g_session, "made")))) { bad = 14; }
        if (bad == 0 && absent(read_back(?alloc, root, "made/keep.txt"))) { bad = 15; }

        str_free(?alloc, f);
        str_free(?alloc, inner);

    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.entry_read_all: reads a record and refuses one too large" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    val f: str = abs_of(?alloc, root, "record");
    fs.write_bytes(f, "abcdefgh", 8, 0o644);

    var root_storage_34: Root;
    val opened: err[Error] = root_open(?root_storage_34, root, "");
    if (sel opened.err) { bad = 2; }
    or {
        val g: *Root = ?root_storage_34;
        var buf: [16]u8;

        val r1: res[opt[usize], Error] = entry_read_all(g, "record", ?buf[0], 16);
        if (sel r1.err) { bad = 3; }
        or {
            val got: opt[usize] = res_value[opt[usize]](r1);
            if (sel got.none) { bad = 4; }
            or {
                if (some_of[usize](got) != 8) { bad = 5; }
                if (bad == 0 && (buf[0] != 'a'::u8 || buf[7] != 'h'::u8)) { bad = 6; }
            }
        }

        # a missing record is absent, not an error
        val r2: res[opt[usize], Error] = entry_read_all(g, "absent", ?buf[0], 16);
        if (bad == 0 && sel r2.err) { bad = 7; }
        or {
            if (bad == 0 && present[usize](res_value[opt[usize]](r2))) { bad = 8; }
        }

        # a record larger than the buffer is refused rather than truncated
        val r3: res[opt[usize], Error] = entry_read_all(g, "record", ?buf[0], 4);
        if (bad == 0 && sel r3.ok) { bad = 9; }

        root_dnit(g);
    }

    str_free(?alloc, f);
    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

fun t_mkfile(root: str, alloc: *A.Allocator, rel: str, body: str) bool {
    val abs: str = abs_of(alloc, root, rel);
    val parent_r: res[Path, A.Error] = path.parent(alloc, abs);
    if (sel parent_r.err) { ret false; }
    val parent: str = parent_r.ok;
    if (fs_write_refused(fs.create_dir_all(alloc, parent, 0o755))) { ret false; }
    ret !fs_write_refused(fs.write_bytes(abs, body::*u8, str_len(body), 0o644));
}

# a nested tree goes away whole, and the count is what was actually removed
test "std.filesystem.transaction.root_remove_tree: removes a nested tree" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;
    # tree/ a  b/ c  d/ e     -> 3 files + 3 directories = 6 entries
    if (!t_mkfile(root, ?alloc, "tree/a", "a")) { bad = 2; }
    if (bad == 0 && !t_mkfile(root, ?alloc, "tree/b/c", "c")) { bad = 3; }
    if (bad == 0 && !t_mkfile(root, ?alloc, "tree/b/d/e", "e")) { bad = 4; }
    # a sibling the removal must not touch
    if (bad == 0 && !t_mkfile(root, ?alloc, "keep", "keep")) { bad = 5; }

    if (bad == 0) {
        var root_storage_35: Root;
        val opened: err[Error] = root_open(?root_storage_35, root, "");
        if (sel opened.err) { bad = 6; }
        or {
            val g: *Root = ?root_storage_35;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }
            val rr: res[usize, Error] = root_remove_tree(t_reserve(?g_session, "tree"), "");
            if (sel rr.err) { bad = 7; }
            or (res_value[usize](rr) != 6) { bad = 8; }

        }
    }

    # the tree is gone and the sibling is untouched
    if (bad == 0 && payload_entry_count(?alloc, root) != 1) { bad = 9; }
    if (bad == 0) {
        val back: opt[str] = read_back(?alloc, root, "keep");
        if (sel back.none) { bad = 10; }
        or (!str_equals(some_of[str](back), "keep")) { bad = 11; }
    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

# every way out of the root is refused, and a refusal removes nothing
#
# the tree is rebuilt for nothing: each case must leave it exactly as it was,
# which is the property that makes a refusal safe to retry.
test "std.filesystem.transaction.root_remove_tree: refuses every escape and removes nothing" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val root_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    # an "outside" directory the escapes would reach, with a file in it
    val outside: str = abs_of(?alloc, root, "outside");
    if (fs_write_refused(fs.create_dir_all(?alloc, outside, 0o755))) { bad = 2; }
    val victim: str = abs_of(?alloc, outside, "victim");
    if (bad == 0 && fs_write_refused(fs.write_bytes(victim, "victim"::*u8, 6, 0o644))) { bad = 3; }

    # the root the capability is anchored to is a subdirectory of that
    val inner: str = abs_of(?alloc, root, "inner");
    if (bad == 0 && fs_write_refused(fs.create_dir_all(?alloc, inner, 0o755))) { bad = 4; }
    if (bad == 0 && !t_mkfile(inner, ?alloc, "kept", "kept")) { bad = 5; }

    # a symlink inside the root pointing at the outside directory
    val link: str = abs_of(?alloc, inner, "link");
    if (bad == 0 && fs_refused(fs.symlink(outside, link))) { bad = 6; }

    if (bad == 0) {
        var root_storage_36: Root;
        val opened: err[Error] = root_open(?root_storage_36, inner, "");
        if (sel opened.err) { bad = 7; }
        or {
            val g: *Root = ?root_storage_36;
        fin { root_dnit(g); }
        var g_session: TestSession;
        if (failed(t_session_init(?g_session, ?alloc, g))) { ret 90; }
        fin { t_session_dnit(?g_session); }

            # a `..` component never resolves
            val up: res[usize, Error] = root_remove_tree(t_reserve(?g_session, "link"), "../outside");
            if (sel up.ok) { bad = 8; }
            or (res_error[usize](up).kind != CONTAINMENT) { bad = 9; }

            # nor does an absolute path
            if (bad == 0) {
                val abs_try: res[usize, Error] = root_remove_tree(t_reserve(?g_session, "link"), outside);
                if (sel abs_try.ok) { bad = 10; }
                or (res_error[usize](abs_try).kind != CONTAINMENT) { bad = 11; }
            }

            # nor a symlink named as the last component
            if (bad == 0) {
                val via_link: res[usize, Error] = root_remove_tree(t_reserve(?g_session, "link"), "");
                if (sel via_link.ok) { bad = 12; }
                or (res_error[usize](via_link).kind != CONTAINMENT) { bad = 13; }
            }

            # nor a path descending THROUGH that symlink
            if (bad == 0) {
                val through: res[usize, Error] = root_remove_tree(t_reserve(?g_session, "link"), "victim");
                if (sel through.ok) { bad = 14; }
                or (res_error[usize](through).kind != CONTAINMENT) { bad = 15; }
            }


        }
    }

    # nothing was removed by any of them: the outside file, the symlink and the
    # file inside the root are all still there
    if (bad == 0 && !answered(fs.exists(victim))) { bad = 16; }
    if (bad == 0 && !answered(fs.exists(link)))   { bad = 17; }
    if (bad == 0) {
        val back: opt[str] = read_back(?alloc, inner, "kept");
        if (sel back.none) { bad = 18; }
        or (!str_equals(some_of[str](back), "kept")) { bad = 19; }
    }

    fs.remove_all(?alloc, root);
    str_free(?alloc, root);
    ret bad;
}

test "std.filesystem.transaction.prepare_subtree: a renamed root keeps every staged descendant" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val base_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel base_r.err) { ret 2; }
    val base: str = base_r.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    val original: str = abs_of(?alloc, base, "original");
    val moved: str = abs_of(?alloc, base, "moved");
    val marker: str = abs_of(?alloc, base, "original/marker");
    fin { str_free(?alloc, original); str_free(?alloc, moved); str_free(?alloc, marker); }
    if (fs_refused(fs.create_dir(original, 0o755))) { ret 3; }
    var root_storage_37: Root;
    val opened: err[Error] = root_open(?root_storage_37, original, "");
    if (sel opened.err) { ret 4; }
    val r: *Root = ?root_storage_37;
        fin { root_dnit(r); }


    if (os.rename(os.AT_FDCWD, original, os.AT_FDCWD, moved) < 0) { ret 5; }
        var r_session: TestSession;
        if (failed(t_session_init(?r_session, ?alloc, r))) { ret 90; }
        fin { t_session_dnit(?r_session); }
    if (fs_refused(fs.create_dir(original, 0o755))) { ret 6; }
    if (fs_write_refused(fs.write_bytes(marker, "untouched", 9, 0o644))) { ret 7; }
    var inv: Inventory = inventory_init(?alloc);
    fin { inventory_dnit(?inv); }
    if (failed(inventory_push(?inv, entry_file("implicit/deep/data", "nested", 6, 0o640)))) { ret 8; }
    if (failed(inventory_push(?inv, entry_dir("explicit/empty", 0o750)))) { ret 9; }
    if (failed(inventory_push(?inv, entry_file("manifest", "complete", 8, 0o644)))) { ret 10; }
    var prepared_storage: Transaction;
        val prepared: err[Error] = prepare_subtree(?prepared_storage, ?alloc, t_reserve(?r_session, "project"), ?inv, 0o755, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (prepared_storage.state == STATE_PREPARED) { abort(?prepared_storage); } }
    if (sel prepared.err) { ret 11; }
    val t: *Transaction = ?prepared_storage;
    val committed: res[Outcome, Error] = commit(t);
    if (sel committed.err) { ret 12; }
    val nested: opt[str] = read_back(?alloc, moved, "project/implicit/deep/data");
    if (sel nested.none) { ret 13; }
    val nested_text: str = some_of[str](nested);
    fin { str_free(?alloc, nested_text); }
    if (!str_equals(nested_text, "nested")) { ret 14; }
    val manifest: opt[str] = read_back(?alloc, moved, "project/manifest");
    if (sel manifest.none) { ret 15; }
    val manifest_text: str = some_of[str](manifest);
    fin { str_free(?alloc, manifest_text); }
    if (!str_equals(manifest_text, "complete")) { ret 16; }
    val empty: str = abs_of(?alloc, moved, "project/explicit/empty");
    fin { str_free(?alloc, empty); }
    if (!answered(fs.is_dir(empty))) { ret 17; }
    val kept: opt[str] = read_back(?alloc, original, "marker");
    if (sel kept.none) { ret 18; }
    val kept_text: str = some_of[str](kept);
    fin { str_free(?alloc, kept_text); }
    if (!str_equals(kept_text, "untouched")) { ret 19; }
    if (payload_entry_count(?alloc, original) != 1 || payload_entry_count(?alloc, moved) != 1) { ret 20; }
    ret 0;
}

test "std.filesystem.transaction.prepare_subtree: staged symlinks cannot redirect inventory writes" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val base_r: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel base_r.err) { ret 2; }
    val base: str = base_r.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    val staging: str = abs_of(?alloc, base, "staging");
    val outside: str = abs_of(?alloc, base, "outside");
    val marker: str = abs_of(?alloc, base, "outside/marker");
    val directory_link: str = abs_of(?alloc, base, "staging/redirect");
    val file_link: str = abs_of(?alloc, base, "staging/linked-file");
    fin {
        str_free(?alloc, staging); str_free(?alloc, outside); str_free(?alloc, marker);
        str_free(?alloc, directory_link); str_free(?alloc, file_link);
    }
    if (fs_refused(fs.create_dir(staging, 0o755))) { ret 3; }
    if (fs_refused(fs.create_dir(outside, 0o755))) { ret 4; }
    if (fs_write_refused(fs.write_bytes(marker, "untouched", 9, 0o644))) { ret 5; }
    if (fs_refused(fs.symlink(outside, directory_link))) { ret 6; }
    if (fs_refused(fs.symlink(marker, file_link))) { ret 7; }
    var root_storage_38: Root;
    val opened: err[Error] = root_open(?root_storage_38, staging, "");
    if (sel opened.err) { ret 8; }
    val r: *Root = ?root_storage_38;
        fin { root_dnit(r); }
        var r_session: TestSession;
        if (failed(t_session_init(?r_session, ?alloc, r))) { ret 90; }
        fin { t_session_dnit(?r_session); }

    var nested: Entry = entry_file("redirect/new-file", "escaped", 7, 0o644);
    var direct: Transaction = Transaction{alloc: ?alloc, staging_fd: r.dirfd};
    var injected: Inventory = inventory_init(?alloc);
    fin { inventory_dnit(?injected); }
    inventory_push(?injected, nested);
    val nested_error: err[Error] = build_subtree(?direct, ?injected);
    if (sel nested_error.ok) { ret 9; }
    if (error_of(nested_error).kind != CONTAINMENT) { ret 10; }
    var linked: Entry = entry_file("linked-file", "corrupt", 7, 0o644);
    injected.entries.len = 0;
    inventory_push(?injected, linked);
    if (!failed(build_subtree(?direct, ?injected))) { ret 11; }
    val kept: opt[str] = read_back(?alloc, outside, "marker");
    if (sel kept.none) { ret 12; }
    val text: str = some_of[str](kept);
    fin { str_free(?alloc, text); }
    if (!str_equals(text, "untouched")) { ret 13; }
    if (payload_entry_count(?alloc, outside) != 1) { ret 14; }
    ret 0;
}
fun t_journal_max_leaf(name: *u8) {
    var i: usize = 0;
    $if ($mach.build.os == $mach.os.windows) {
        for (i < 255) {
            name[i * 3] = 0xe7;
            name[i * 3 + 1] = 0x95;
            name[i * 3 + 2] = 0x8c;
            i = i + 1;
        }
        name[765] = 0;
    }
    $or {
        for (i < 255) { name[i] = 'a'; i = i + 1; }
        name[255] = 0;
    }
}

fun t_journal_publish(a: *A.Allocator, session: *TestSession, leaf: str, content: str) i32 {
    val root: *Root = session.held.root;
    var prepared_storage: Transaction;
        val prepared: err[Error] = prepare_bytes(?prepared_storage, a, t_reserve(session, leaf), content, str_len(content), 0o644, false, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (prepared_storage.state == STATE_PREPARED) { abort(?prepared_storage); } }
    if (sel prepared.err) { ret 1; }
    val t: *Transaction = ?prepared_storage;
    val committed: res[Outcome, Error] = commit(t);
    if (sel committed.err) { ret 2; }
    ret 0;
}

fun t_journal_run(body: fun(*A.Allocator, *TestSession, str) i32) i32 {
    var a: A.Allocator;
    val page_r: err[A.Error] = page.make(?a);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?a);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    var bad: i32 = 0;
    var root_storage_39: Root;
    val opened: err[Error] = root_open(?root_storage_39, base, "");
    if (sel opened.err) { bad = 3; }
    or {
        val root: *Root = ?root_storage_39;
        fin { root_dnit(root); }
        var root_session: TestSession;
        if (failed(t_session_init(?root_session, ?a, root))) { ret 90; }
        fin { t_session_dnit(?root_session); }
        bad = body(?a, ?root_session, base);
    }
    fs.remove_all(?a, base);
    str_free(?a, base);
    ret bad;
}

fun t_journal_max_file(a: *A.Allocator, session: *TestSession, base: str) i32 {
    val root: *Root = session.held.root;
    var name: [766]u8;
    t_journal_max_leaf(?name[0]);
    val leaf: str = (?name[0])::str;
    if (t_journal_publish(a, session, leaf, "before") != 0) { ret 4; }
    if (t_journal_publish(a, session, leaf, "after") != 0) { ret 5; }
    var content: [16]u8;
    val read: res[opt[usize], Error] = entry_read_all(root, leaf, ?content[0], 16);
    if (sel read.err) { ret 6; }
    if (!str_equals((?content[0])::str, "after")) { ret 7; }
    val swept: res[usize, Error] = t_end_batch_and_recover(session, leaf);
    if (sel swept.err) { ret 8; }
    if (res_value[usize](swept) != 0) { ret 9; }
    if (failed(entry_unlink(t_reserve(session, leaf)))) { ret 10; }
    if (payload_entry_count(a, base) != 0) { ret 11; }
    ret 0;
}

test "std.filesystem.transaction: maximum native destination names publish replace and recover" {
    ret t_journal_run(t_journal_max_file);
}

fun t_fixture_write(root: *Root, leaf: str, content: str) i32 {
    val opened: i64 = os.open(root.dirfd, leaf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644);
    if (opened < 0) { ret 1; }
    val wrote: i64 = os.write(opened::i32, content, str_len(content));
    val closed: i64 = os.close(opened::i32);
    if (wrote != str_len(content)::i64 || closed < 0) { ret 2; }
    ret 0;
}

fun t_journal_child_write(a: *A.Allocator, root: *Root, leaf: str, content: str) i32 {
    val opened: i64 = os.open(root.dirfd, leaf, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (opened < 0) { ret 1; }
    var child: Root;
    if (ownership.root_init(?child, opened::i32) < 0) { os.close(opened::i32); ret 99; }
    val result: i32 = t_fixture_write(?child, "entry", content);
    root_dnit(?child);
    ret result;
}

fun t_journal_child_has(root: *Root, leaf: str, content: str) bool {
    val opened: i64 = os.open(root.dirfd, leaf, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (opened < 0) { ret false; }
    var child: Root;
    if (ownership.root_init(?child, opened::i32) < 0) { os.close(opened::i32); ret false; }
    var bytes: [16]u8;
    val read: res[opt[usize], Error] = entry_read_all(?child, "entry", ?bytes[0], 16);
    root_dnit(?child);
    if (sel read.err) { ret false; }
    val count: opt[usize] = res_value[opt[usize]](read);
    ret sel count.some && some_of[usize](count) == str_len(content)
        && str_equals((?bytes[0])::str, content);
}

fun t_journal_owns(ctx: *i32, name: str, directory: bool) bool {
    ret str_equals(name, "entry") && !directory;
}

fun t_journal_empty_directory(a: *A.Allocator, session: *TestSession, leaf: str) i32 {
    val root: *Root = session.held.root;
    var prepared_storage: Transaction;
        val prepared: err[Error] = prepare_dir(?prepared_storage, a, t_reserve(session, leaf), 0o755, PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()});
        fin { if (prepared_storage.state == STATE_PREPARED) { abort(?prepared_storage); } }
    if (sel prepared.err) { ret 1; }
    val t: *Transaction = ?prepared_storage;
    val committed: res[Outcome, Error] = commit(t);
    if (sel committed.err) { ret 2; }
    ret 0;
}

fun t_journal_directory_states(a: *A.Allocator, session: *TestSession) i32 {
    val root: *Root = session.held.root;
    var name: [766]u8;
    t_journal_max_leaf(?name[0]);
    val leaf: str = (?name[0])::str;
    if (t_journal_empty_directory(a, session, leaf) != 0) { ret 4; }
    if (t_journal_child_write(a, root, leaf, "before") != 0) { ret 5; }
    val opened: res[i32, Error] = open_backup_container(root.dirfd, true);
    if (sel opened.err) { ret 6; }
    var backup: Root;
    if (ownership.root_init(?backup, res_value[i32](opened)) < 0) { os.close(res_value[i32](opened)); ret 99; }
    var bad: i32 = 0;
    if (os.make_dir(backup.dirfd, "other", 0o755) < 0) { bad = 7; }
    if (bad == 0 && t_journal_child_write(a, ?backup, "other", "keep") != 0) { bad = 8; }
    if (bad == 0 && os.rename(root.dirfd, leaf, backup.dirfd, leaf) < 0) { bad = 9; }
    if (bad == 0 && res_failed[usize](t_end_batch_and_recover(session, leaf))) { bad = 10; }
    if (bad == 0 && !t_journal_child_has(root, leaf, "before")) { bad = 11; }
    if (bad == 0 && !t_journal_child_has(?backup, "other", "keep")) { bad = 12; }
    if (bad == 0 && os.rename(root.dirfd, leaf, backup.dirfd, leaf) < 0) { bad = 13; }
    if (bad == 0 && t_journal_empty_directory(a, session, leaf) != 0) { bad = 14; }
    if (bad == 0 && t_journal_child_write(a, root, leaf, "after") != 0) { bad = 15; }
    if (bad == 0 && res_failed[usize](t_end_batch_and_recover(session, leaf))) { bad = 16; }
    if (bad == 0 && !entry_absent(backup.dirfd, leaf)) { bad = 17; }
    if (bad == 0 && !t_journal_child_has(root, leaf, "after")) { bad = 18; }
    if (bad == 0 && os.rename(root.dirfd, leaf, backup.dirfd, leaf) < 0) { bad = 19; }
    if (bad == 0) {
        if (res_failed[usize](t_end_batch_and_recover(session, leaf))) { ret 22; }
        var prepared_storage: Transaction;
        val prepared: err[Error] = prepare_dir(?prepared_storage, a, t_reserve(session, leaf), 0o755, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (prepared_storage.state == STATE_PREPARED) { abort(?prepared_storage); } }
        if (sel prepared.err) { bad = 20; }
        or {
            val t: *Transaction = ?prepared_storage;
            var ctx: i32 = 0;
            val committed: res[Outcome, Error] = commit_replacing_owned[i32](t, ?ctx, t_journal_owns);
            if (sel committed.err) { bad = 21; }
        }
    }
    if (bad == 0 && !entry_absent(backup.dirfd, leaf)) { bad = 23; }
    if (bad == 0 && !t_journal_child_has(?backup, "other", "keep")) { bad = 24; }
    if (bad == 0 && res_failed[usize](t_end_batch_and_recover(session, ""))) { bad = 25; }
    if (bad == 0 && !t_journal_child_has(?backup, "other", "keep")) { bad = 26; }
    root_dnit(?backup);
    ret bad;
}

fun t_journal_renamed_root(a: *A.Allocator, session: *TestSession, base: str) i32 {
    val root: *Root = session.held.root;
    if (res_failed[bool](entry_make_dir(t_reserve(session, "original"), 0o755))) { ret 4; }
    var root_storage_40: Root;
    val opened: err[Error] = root_open(?root_storage_40, base, "original");
    if (sel opened.err) { ret 5; }
    val held: *Root = ?root_storage_40;
        fin { root_dnit(held); }

    var bad: i32 = 0;
    if (failed(entry_rename(t_reserve(session, "original"), t_reserve(session, "moved")))) { bad = 6; }
    if (bad == 0 && res_failed[bool](entry_make_dir(t_reserve(session, "original"), 0o755))) { bad = 7; }
    if (bad == 0 && t_journal_child_write(a, root, "original", "untouched") != 0) { bad = 8; }
    if (bad == 0) {
        var held_session: TestSession;
        if (failed(t_session_init(?held_session, a, held))) { ret 90; }
        fin { t_session_dnit(?held_session); }
        bad = t_journal_directory_states(a, ?held_session);
    }

    if (bad == 0 && !t_journal_child_has(root, "original", "untouched")) { bad = 9; }
    ret bad;
}

test "std.filesystem.transaction: maximum directory backups recover through a renamed root" {
    ret t_journal_run(t_journal_renamed_root);
}

fun t_journal_reserved_and_sweep(a: *A.Allocator, session: *TestSession, base: str) i32 {
    val root: *Root = session.held.root;
    var reserved: [4]str = [4]str{".machtxn.out", ".machtxn.backup", ".MACHTXN.0011223344556677", ".MACH-TXN-LOCK"};
    var i: usize = 0;
    for (i < 4) {
        var refused: Claim;
        val result: err[Error] = claim(?refused, a, ?session.held, reserved[i]);
        if (!sel result.err) { release_claim(?refused); ret 4; }
        if (error_of(result).kind != CONTAINMENT) { ret 5; }
        i = i + 1;
    }
    if (payload_entry_count(a, base) != 0) { ret 8; }
    if (!t_mkfile(base, a, ".machtxn.0011223344556677", "staging one")) { ret 9; }
    if (!t_mkfile(base, a, ".machtxn.8899aabbccddeeff", "staging two")) { ret 10; }
    if (!t_mkfile(base, a, ".machtxn.not-a-nonce", "foreign")) { ret 11; }
    if (!t_mkfile(base, a, ".machtxn.unrecognized", "foreign")) { ret 12; }
    if (os.make_dir(root.dirfd, "other-backup-guard", 0o755) < 0) { ret 13; }
    if (t_journal_child_write(a, root, "other-backup-guard", "keep") != 0) { ret 14; }
    val recovered: res[usize, Error] = t_end_batch_and_recover(session, "chosen");
    if (sel recovered.err) { ret 15; }
    if (res_value[usize](recovered) != 2) { ret 16; }
    if (payload_entry_count(a, base) != 3 || !t_journal_child_has(root, "other-backup-guard", "keep")) { ret 17; }
    val again: res[usize, Error] = t_end_batch_and_recover(session, "");
    if (sel again.err || res_value[usize](again) != 0) { ret 18; }
    if (payload_entry_count(a, base) != 3) { ret 19; }
    ret 0;
}

test "std.filesystem.transaction: reserved publication names and exact staging recognition protect other content" {
    ret t_journal_run(t_journal_reserved_and_sweep);
}

fun t_journal_container_refusal(a: *A.Allocator, session: *TestSession, base: str) i32 {
    val root: *Root = session.held.root;
    val outside_result: res[str, fs.FsError] = scratch_root(a);
    if (sel outside_result.err) { ret 4; }
    val outside: str = outside_result.ok;
    val container: str = abs_of(a, base, BACKUP_CONTAINER);
    var bad: i32 = 0;
    if (!t_mkfile(outside, a, "guard", "keep")) { bad = 5; }
    if (bad == 0 && fs_refused(fs.symlink(outside, container))) { bad = 6; }
    if (bad == 0) {
        val recovered: res[usize, Error] = t_end_batch_and_recover(session, "chosen");
        if (sel recovered.ok) { bad = 7; }
        or (res_error[usize](recovered).kind != CONTAINMENT) { bad = 8; }
    }
    if (bad == 0 && absent(read_back(a, outside, "guard"))) { bad = 9; }
    os.unlink(root.dirfd, BACKUP_CONTAINER, 0);
    fs.remove_all(a, outside);
    str_free(a, outside);
    str_free(a, container);
    if (bad != 0) { ret bad; }
    val opened: res[i32, Error] = open_backup_container(root.dirfd, true);
    if (sel opened.err) { ret 10; }
    var backup: Root;
    if (ownership.root_init(?backup, res_value[i32](opened)) < 0) { os.close(res_value[i32](opened)); ret 99; }
    if (t_fixture_write(?backup, "chosen", "foreign") != 0) { bad = 11; }
    if (bad == 0) {
        val recovered: res[usize, Error] = t_end_batch_and_recover(session, "chosen");
        if (sel recovered.ok) { bad = 12; }
        or (res_error[usize](recovered).kind != CONFLICT) { bad = 13; }
    }
    if (bad == 0 && entry_absent(backup.dirfd, "chosen")) { bad = 14; }
    os.unlink(backup.dirfd, "chosen", 0);
    if (bad == 0 && os.make_dir(backup.dirfd, "chosen", 0o755) < 0) { bad = 15; }
    if (bad == 0 && t_journal_publish(a, session, "chosen", "foreign") != 0) { bad = 16; }
    if (bad == 0) {
        val recovered: res[usize, Error] = t_end_batch_and_recover(session, "chosen");
        if (sel recovered.ok) { bad = 17; }
        or (res_error[usize](recovered).kind != CONFLICT) { bad = 18; }
    }
    if (bad == 0 && (entry_absent(backup.dirfd, "chosen") || entry_absent(root.dirfd, "chosen"))) { bad = 19; }
    root_dnit(?backup);
    ret bad;
}

test "std.filesystem.transaction: backup containers reject symlinks malformed children and foreign destinations" {
    ret t_journal_run(t_journal_container_refusal);
}

fun t_publish(a: *A.Allocator, session: *TestSession, leaf: str, content: str) i32 {
    val root: *Root = session.held.root;
    var prepared_storage: Transaction;
        val prepared: err[Error] = prepare_bytes(?prepared_storage, a, t_reserve(session, leaf), content, str_len(content), 0o644, false, PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()});
        fin { if (prepared_storage.state == STATE_PREPARED) { abort(?prepared_storage); } }
    if (sel prepared.err) { ret 1; }
    val t: *Transaction = ?prepared_storage;
    val committed: res[Outcome, Error] = commit(t);
    if (sel committed.err) { ret 2; }
    ret 0;
}

fun t_root_operations(a: *A.Allocator, session: *TestSession) i32 {
    val root: *Root = session.held.root;
    if (t_publish(a, session, "x", "content") != 0) { ret 1; }
    if (failed(entry_rename(t_reserve(session, "x"), t_reserve(session, "y")))) { ret 2; }
    var buf: [16]u8;
    val read: res[opt[usize], Error] = entry_read_all(root, "y", ?buf[0], 16);
    if (sel read.err) { ret 3; }
    val found: opt[usize] = res_value[opt[usize]](read);
    if (sel found.none || some_of[usize](found) != 7) { ret 4; }
    if (!str_equals((?buf[0])::str, "content")) { ret 5; }

    $if ($mach.build.os != $mach.os.darwin) {
    var stale_storage: Transaction;
        val stale: err[Error] = prepare_bytes(?stale_storage, a, t_reserve(session, "y"), "stale", 5, 0o644, false, PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()});
        fin { if (stale_storage.state == STATE_PREPARED) { abort(?stale_storage); } }
    if (sel stale.err) { ret 6; }
    val t: *Transaction = ?stale_storage;
    if (t_fixture_write(root, "outsider", "winner") != 0) { abort(t); ret 7; }
    if (os.rename(root.dirfd, "outsider", root.dirfd, "y") < 0) { abort(t); ret 7; }
    val conflict: res[Outcome, Error] = commit(t);
    if (sel conflict.ok) { ret 8; }
    if (res_error[Outcome](conflict).kind != PRECONDITION) { ret 9; }
    var winner: [16]u8;
    val wr: res[opt[usize], Error] = entry_read_all(root, "y", ?winner[0], 16);
    if (sel wr.err) { ret 10; }
    if (!str_equals((?winner[0])::str, "winner")) { ret 11; }

    }
    if (res_failed[bool](entry_make_dir(t_reserve(session, "sub"), 0o755))) { ret 12; }
    if (failed(entry_rename(t_reserve(session, "sub"), t_reserve(session, "r")))) { ret 13; }
    val child_raw: i64 = os.open(root.dirfd, "r", os.O_RDONLY | os.O_DIRECTORY, 0);
    if (child_raw < 0) { ret 14; }
    var child: Root;
    if (ownership.root_init(?child, child_raw::i32) < 0) { os.close(child_raw::i32); ret 99; }
    val published: i32 = t_fixture_write(?child, "inner", "kept");
    root_dnit(?child);
    if (published != 0) { ret 15; }
    val removed: res[usize, Error] = root_remove_tree(t_reserve(session, "r"), "");
    if (sel removed.err) { ret 16; }
    if (res_value[usize](removed) != 2) { ret 17; }
    if (failed(entry_unlink(t_reserve(session, "y")))) { ret 18; }
    val probe: res[EntryProbe, Error] = entry_probe(root, "y");
    if (sel probe.err) { ret 19; }
    if (res_value[EntryProbe](probe).present) { ret 20; }
    ret 0;
}

test "std.filesystem.transaction: publication and mutations retain a renamed root" {
    var a: A.Allocator;
    val page_r: err[A.Error] = page.make(?a);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?a);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    val original: str = abs_of(?a, base, "original-\xc3\xa9");
    val moved: str = abs_of(?a, base, "moved-\xc3\xa9");
    var bad: i32 = 0;
    if (fs_refused(fs.create_dir(original, 0o755))) { bad = 3; }
    if (bad == 0) {
        var root_storage_41: Root;
        val opened: err[Error] = root_open(?root_storage_41, base, "original-\xc3\xa9");
        if (sel opened.err) { bad = 4; }
        or {
            val root: *Root = ?root_storage_41;
        fin { root_dnit(root); }

            if (fs_refused(fs.rename(original, moved))) { bad = 5; }
            or (fs_refused(fs.create_dir(original, 0o755))) { bad = 6; }
            or (!t_mkfile(base, ?a, "original-\xc3\xa9/guard", "untouched")) { bad = 7; }
            or {
        var root_session: TestSession;
        if (failed(t_session_init(?root_session, ?a, root))) { ret 90; }
        fin { t_session_dnit(?root_session); }
                bad = t_root_operations(?a, ?root_session);
            }

        }
    }
    if (bad == 0) {
        val guard: opt[str] = read_back(?a, original, "guard");
        if (sel guard.none) { bad = 21; }
        or {
            val content: str = some_of[str](guard);
            if (!str_equals(content, "untouched")) { bad = 22; }
            str_free(?a, content);
        }
        if (payload_entry_count(?a, original) != 1 || payload_entry_count(?a, moved) != 0) { bad = 23; }
    }
    fs.remove_all(?a, base);
    str_free(?a, original);
    str_free(?a, moved);
    str_free(?a, base);
    ret bad;
}

fun t_scan_entries(fd: i32) i32 {
    var cursor: os.DirectoryCursor = os.DirectoryCursor{};
    if (os.directory_init(?cursor, fd).code < 0) { ret 1; }
    fin { os.directory_close(?cursor); }
    var seen: u64 = 0;
    var calls: usize = 0;
    for (calls < 128) {
        calls = calls + 1;
        var entry: os.DirectoryEntry;
        val next: i64 = os.directory_next(?cursor, ?entry);
        if (next < 0) { ret 1; }
        if (next == 0) {
            if (seen != 0xffffffffffffffff) { ret 2; }
            if (os.directory_next(?cursor, ?entry) != 0) { ret 3; }
            if (os.directory_close(?cursor) < 0) { ret 8; }
            ret 0;
        }
        val name: str = entry.name;
        if (!dot_entry(name)) {
            if (entry.length != 7 || str_len(name) != entry.length || name[0] != 'i' || name[1] != 't'
                || name[2] != 'e' || name[3] != 'm' || name[4] != '-'
                || name[5] < 'a' || name[5] > 'd' || name[6] < 'a' || name[6] > 'p') { ret 4; }
            val slot: u64 = (name[5] - 'a')::u64 * 16 + (name[6] - 'a')::u64;
            val bit: u64 = 1::u64 << slot;
            if ((seen & bit) != 0) { ret 5; }
            seen = seen | bit;
        }
    }
    ret 7;
}

fun t_fill_and_scan(a: *A.Allocator, root: *Root) i32 {
    var name: [8]u8 = [8]u8{'i', 't', 'e', 'm', '-', 'a', 'a', 0};
    var i: u8 = 0;
    for (i < 64) {
        name[5] = 'a' + i / 16;
        name[6] = 'a' + i % 16;
        if (t_fixture_write(root, (?name[0])::str, "x") != 0) { ret 1; }
        i = i + 1;
    }
    val first: i32 = t_scan_entries(root.dirfd);
    if (first != 0) { ret first + 10; }
    if (os.seek(root.dirfd, 0, os.SEEK_SET) < 0) { ret 2; }
    val again: i32 = t_scan_entries(root.dirfd);
    if (again != 0) { ret again + 20; }
    ret 0;
}

test "std.filesystem.transaction: directory batches retain every entry and rewind before cleanup" {
    var a: A.Allocator;
    val page_r: err[A.Error] = page.make(?a);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?a);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    var bad: i32 = 0;
    var root_storage_42: Root;
    val opened: err[Error] = root_open(?root_storage_42, base, "");
    if (sel opened.err) { bad = 3; }
    or {
        val root: *Root = ?root_storage_42;
        fin { root_dnit(root); }
        var root_session: TestSession;
        if (failed(t_session_init(?root_session, ?a, root))) { ret 90; }
        fin { t_session_dnit(?root_session); }
        if (res_failed[bool](entry_make_dir(t_reserve(?root_session, "many"), 0o755))) { bad = 4; }
        or {
            val child_raw: i64 = os.open(root.dirfd, "many", os.O_RDONLY | os.O_DIRECTORY, 0);
            if (child_raw < 0) { bad = 5; }
            or {
                var child: Root;
    if (ownership.root_init(?child, child_raw::i32) < 0) { os.close(child_raw::i32); ret 99; }
                bad = t_fill_and_scan(?a, ?child);
                root_dnit(?child);
            }
        }
        if (bad == 0) {
            val removed: res[usize, Error] = root_remove_tree(t_reserve(?root_session, "many"), "");
            if (sel removed.err) { bad = 6; }
            or (res_value[usize](removed) != 65) { bad = 7; }
            if (payload_entry_count(?a, base) != 0) { bad = 8; }
        }

    }
    # preserve failed scans for inspection without enumerating through the same defect
    if (bad == 0) { fs.remove_all(?a, base); }
    str_free(?a, base);
    ret bad;
}

