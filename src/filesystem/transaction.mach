    if (!str_equals(descent.first_missing, "first") || !str_equals(descent.remainder, "second")) { ret 7; }
    if (root_fd(?descent.root) < 0) { ret 8; }
    if (failed(unlock(?held)) || failed(descent_dnit(?alloc, ?descent))) { ret 9; }
    if (descent.first_missing != nil || descent.remainder != nil || root_fd(?descent.root) >= 0) { ret 10; }
    ret 0;
}

test "std.filesystem.transaction.claim: planning owns reservations across active use and failed competitors" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val base: str = "mach_583_planned_claims";
    if (os.make_dir(os.AT_FDCWD, base, 0o700) < 0) { ret 2; }
    fin { fs.remove_all(?alloc, base); }
    var root: Root;
    if (failed(root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var held: Lock;
    if (failed(lock(?held, ?root))) { ret 4; }
    fin { unlock(?held); }
    if (ownership.begin_recovery(?held) < 0) { ret 5; }
    val initialized: err[removal.Error] = ownership.initialize_claims(?held);
    ownership.end_recovery(?held, true);
    if (sel initialized.err) { ret 6; }
    var first: Claim;
    var second: Claim;
    if (failed(claim(?first, ?alloc, ?held, "first"))) { ret 7; }
    fin { release_claim(?first); }
    if (failed(claim(?second, ?alloc, ?held, "second"))) { ret 8; }
    fin { release_claim(?second); }
    var competitor: Claim;
    val refused: err[Error] = claim(?competitor, ?alloc, ?held, "first");
    if (sel refused.ok || error_of(refused).kind != CONFLICT || held.borrowers != 2) { ret 9; }
    var copied: Claim = first;
    val refused_copy: err[Error] = release_claim(?copied);
    if (sel refused_copy.ok || error_of(refused_copy).kind != INVALID) { ret 10; }
    if (failed(borrow_claim(?first, OP_PREPARE))) { ret 11; }
    val refused_live: err[Error] = release_claim(?first);
    if (sel refused_live.ok || error_of(refused_live).kind != INVALID) { ret 12; }
    if (!failed(borrow_claim(?first, OP_PREPARE))) { ret 13; }
    return_claim(?first);
    if (!str_equals(claim_leaf(?first), "first") || !str_equals(claim_leaf(?second), "second") || held.borrowers != 2) { ret 14; }
    var worker: Worker;
    if (failed(borrow_worker(?worker, ?held))) { ret 15; }
    if (ownership.begin_recovery(?held) != os.EINVAL) { release_worker(?worker); ret 16; }
    if (failed(release_worker(?worker))) { ret 17; }
    if (failed(release_claim(?first)) || held.borrowers != 1) { ret 18; }
    if (failed(release_claim(?second)) || held.borrowers != 0) { ret 19; }
    if (ownership.begin_recovery(?held) < 0) { ret 20; }
    ownership.end_recovery(?held, true);
    ret 0;
}

test "std.filesystem.transaction.lifecycle: copied and invalid commits preserve exactly one claim owner" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (failed(root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (failed(t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var first: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()};
    if (failed(prepare_bytes(?first, ?alloc, destination, "old", 3, 0o600, false, options))) { ret 6; }
    fin { if (prepared(?first)) { abort(?first); } }
    var copied: Transaction = first;
    val refused: res[Outcome, Error] = commit(?copied);
    if (sel refused.ok) { first.state = STATE_SPENT; ret 7; }
    if (res_error[Outcome](refused).kind != INVALID) {
        if (!destination.active) { first.state = STATE_SPENT; }
        ret 7;
    }
    if (!failed(abort(?copied)) || !prepared(?first) || !destination.active) { ret 8; }
    var competing: Transaction;
    val conflict: err[Error] = prepare_bytes(?competing, ?alloc, destination, "bad", 3, 0o600, false, options);
    if (sel conflict.ok || error_of(conflict).kind != INVALID) { ret 9; }
    if (!failed(release_claim(destination))) { ret 10; }
    var ctx: i32 = 0;
    val invalid: res[Outcome, Error] = commit_replacing_owned[i32](?first, ?ctx, t_journal_owns);
    if (sel invalid.ok || res_error[Outcome](invalid).kind != INVALID) { ret 11; }
    if (first.state != STATE_SPENT || destination.active || session.held.borrowers != 1) { ret 12; }
    if (payload_entry_count(?alloc, base) != 0) { ret 13; }
    if (failed(prepare_bytes(?first, ?alloc, destination, "new", 3, 0o600, false, options))) { ret 14; }
    if (res_failed[Outcome](commit(?first))) { ret 15; }
    if (!failed(abort(?first)) || destination.active || session.held.borrowers != 1) { ret 16; }
    ret 0;
}

test "std.filesystem.transaction.lifecycle: preparation alone selects retained identity capability" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (failed(root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (failed(t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    val old: i64 = os.open(root.dirfd, "out", os.O_CREAT | os.O_EXCL | os.O_RDWR, 0o000);
    if (old < 0) { ret 6; }
    fin { os.close(old::i32); }
    if (os.write(old::i32, "old", 3) != 3) { ret 7; }
    var transaction: Transaction;
    val replace: PrepareOptions = PrepareOptions{precondition: PRE_REPLACE, durability: durability_none()};
    if (failed(prepare_bytes(?transaction, ?alloc, destination, "new", 3, 0o000, false, replace))) { ret 8; }
    fin { if (prepared(?transaction)) { abort(?transaction); } }
    if (transaction.prior_fd != -1 || transaction.had_prior) { ret 9; }
    if (failed(abort(?transaction))) { ret 10; }
    val same: PrepareOptions = PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()};
    val retained: err[Error] = prepare_bytes(?transaction, ?alloc, destination, "new", 3, 0o000, false, same);
    $if ($mach.build.os == $mach.os.darwin) {
        if (sel retained.ok || error_of(retained).kind != UNSUPPORTED) { ret 11; }
        if (destination.active || transaction.state != STATE_SPENT) { ret 12; }
    }
    $or {
        if (sel retained.err || transaction.prior_fd < 0 || !transaction.had_prior) { ret 13; }
        val retained_fd: i32 = transaction.prior_fd;
        var observed: Identity;
        if (os.file_identity(retained_fd, ?observed) < 0 || !identity_equal(observed, transaction.prior)) { ret 18; }
        var byte: u8 = 0;
        if (os.read(transaction.prior_fd, ?byte, 1) >= 0) { ret 14; }
        if (os.seek(old::i32, 0, os.SEEK_SET) < 0 || os.write(old::i32, "edit", 4) != 4) { ret 15; }
        if (res_failed[Outcome](commit(?transaction))) { ret 16; }
        if (destination.active || transaction.prior_fd != -1) { ret 17; }
        var closed: os.stat_t;
        if (os.stat(retained_fd, ?closed) != os.EBADF) { ret 19; }
    }
    ret 0;
}

