$if ($mach.build.os == $mach.os.windows) {
    fun t_scan_wide_component(fd: i32, expected: str) i32 {
        var cursor: os.DirectoryCursor = os.DirectoryCursor{};
        if (os.directory_init(?cursor, fd).code < 0) { ret 1; }
        fin { os.directory_close(?cursor); }
        var seen: u8 = 0;
        var calls: usize = 0;
        for (calls < 8) {
            calls = calls + 1;
            var entry: os.DirectoryEntry;
            val next: i64 = os.directory_next(?cursor, ?entry);
            if (next < 0) { ret 2; }
            if (next == 0) {
                if (seen != 3) { ret 3; }
                if (os.directory_close(?cursor) < 0) { ret 8; }
                ret 0;
            }
            val name: str = entry.name;
            if (entry.length != str_len(name)) { ret 4; }
            if (!dot_entry(name) && !str_equals(name, LOCK_LEAF) && !str_equals(name, ownership.CLAIMS_LEAF)) {
                var bit: u8 = 0;
                if (str_equals(name, expected)) { bit = 1; }
                or (str_equals(name, "x")) { bit = 2; }
                or { ret 5; }
                if ((seen & bit) != 0) { ret 6; }
                seen = seen | bit;
            }
        }
        ret 7;
    }

    test "std.filesystem.transaction: windows cursor returns full Unicode components without skipping entries" {
        var a: A.Allocator;
        val page_r: err[A.Error] = page.make(?a);
    if (sel page_r.err) { ret 1; }
        val scratch: res[str, fs.FsError] = scratch_root(?a);
        if (sel scratch.err) { ret 2; }
        val base: str = scratch.ok;
        var name: [766]u8;
        var i: usize = 0;
        for (i < 255) {
            name[i * 3] = 0xe7;
            name[i * 3 + 1] = 0x95;
            name[i * 3 + 2] = 0x8c;
            i = i + 1;
        }
        name[765] = 0;
        val leaf: str = (?name[0])::str;
        var bad: i32 = 0;
        var root_storage_44: Root;
        val opened: err[Error] = root_open(?root_storage_44, base, "");
        if (sel opened.err) { bad = 3; }
        or {
            val root: *Root = ?root_storage_44;
        fin { root_dnit(root); }
        var root_session: TestSession;
        if (failed(t_session_init(?root_session, ?a, root))) { ret 90; }
        fin { t_session_dnit(?root_session); }
            if (t_publish(?a, ?root_session, "y", "wide") != 0) { bad = 4; }
            or (failed(entry_rename(t_reserve(?root_session, "y"), t_reserve(?root_session, leaf)))) { bad = 9; }
            or (t_publish(?a, ?root_session, "x", "short") != 0) { bad = 5; }
            or (os.seek(root.dirfd, 0, os.SEEK_SET) < 0) { bad = 30; }
            or {
                val first: i32 = t_scan_wide_component(root.dirfd, leaf);
                if (first != 0) { bad = 10 + first; }
                or (os.seek(root.dirfd, 0, os.SEEK_SET) < 0) { bad = 6; }
                or {
                    val again: i32 = t_scan_wide_component(root.dirfd, leaf);
                    if (again != 0) { bad = 20 + again; }
                }
            }
            if (failed(entry_unlink(t_reserve(?root_session, leaf))) && bad == 0) { bad = 7; }
            if (failed(entry_unlink(t_reserve(?root_session, "x"))) && bad == 0) { bad = 8; }

        }
        fs.remove_all(?a, base);
        str_free(?a, base);
        ret bad;
    }
}

