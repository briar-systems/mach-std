        var seen: u8 = 0;
        var calls: usize = 0;
        for (calls < 8) {
            calls = calls + 1;
            if (os.read_dir(fd, ?storage, capacity - 1) != os.EINVAL) { ret 1; }
            val n: i64 = os.read_dir(fd, ?storage, capacity);
            if (n < 0) { ret 2; }
            if (n == 0) {
                if (seen != 3) { ret 3; }
                ret 0;
            }
            if (n::usize != capacity || storage.d_reclen::usize != capacity) { ret 4; }
            val name: str = (?storage.d_name[0])::str;
            if (!dot_entry(name) && !str_equals(name, LOCK_LEAF) && !str_equals(name, ownership.CLAIMS_LEAF)) {
                var bit: u8 = 0;
                if (str_equals(name, expected)) { bit = 1; }
                or (str_equals(name, "x")) { bit = 2; }
                or { ret 5; }
                if ((seen & bit) != 0) { ret 6; }
                seen = seen | bit;
            }
        }
        ret 7;
    }

    test "std.filesystem.transaction: windows enumerates full Unicode components without consuming short reads" {
        var a: A.Allocator;
