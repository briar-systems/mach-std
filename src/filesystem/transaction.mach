    fin { root_dnit(?root); }
    var session: TestSession;
    if (failed(t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var t: Transaction;
    fin { if (prepared(?t)) { abort(?t); } }
    val options: PrepareOptions = PrepareOptions{precondition: PRE_SAME_OBJECT,
        prior_access: READ_AUTHORIZED, durability: durability_none()};
    if (failed(prepare_bytes(?t, ?alloc, destination, "first", 5, 0o600, false, options))) { ret 6; }
    if (t.had_prior || res_failed[Outcome](commit(?t))) { ret 7; }
    if (failed(prepare_bytes(?t, ?alloc, destination, "second", 6, 0o600, false, options))) { ret 8; }
    if (!t.had_prior || t.prior_fd < 0) { ret 9; }
    val retained: i32 = t.prior_fd;
    var identity: Identity;
    if (os.file_identity(retained, ?identity) < 0 || !identity_equal(identity, t.prior)) { ret 10; }
    if (res_failed[Outcome](commit(?t))) { ret 11; }
    var closed: os.stat_t;
    if (os.stat(retained, ?closed) != os.EBADF || destination.active) { ret 12; }
    val invalid: PrepareOptions = PrepareOptions{precondition: PRE_REPLACE, prior_access: 2, durability: durability_none()};
    val denied: err[Error] = prepare_bytes(?t, ?alloc, destination, "bad", 3, 0o600, false, invalid);
    if (sel denied.ok || error_of(denied).kind != INVALID || destination.active) { ret 13; }
    ret 0;
}

fun t_backup_contents(root: *Root, leaf: str, expected: str) bool {
    var bytes: [16]u8;
    val read: res[opt[usize], Error] = entry_read_all(root, leaf, ?bytes[0], 16);
    if (sel read.err) { ret false; }
    val count: opt[usize] = res_value[opt[usize]](read);
    ret sel count.some && some_of[usize](count) == str_len(expected)
        && str_equals((?bytes[0])::str, expected);
}

fun t_backup_commit_case(which: u8) i32 {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (failed(root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (failed(t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    val backup: *Claim = t_reserve(?session, "saved");
    if (destination == nil || backup == nil) { ret 5; }
    val existing: bool = which == 1 || which == 2 || which == 3;
    if (existing && t_fixture_write(?root, "out", "prior") != 0) { ret 6; }
    var tracker: testing.Testing;
    val tracker_r: err[A.Error] = testing.make(?tracker);
    if (sel tracker_r.err) { ret 37; }
    fin { testing.dnit(?tracker); }
    val owned: *A.Allocator = testing.allocator_of(?tracker);
    var t: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_SAME_OBJECT, prior_access: READ_AUTHORIZED, durability: durability_full(true)};
    val made: err[Error] = prepare_bytes(?t, owned, destination, "next", 4, 0o600, false, options);
    if (sel made.err) { ret 9; }
    fin { if (prepared(?t)) { abort(?t); } }
    val staged: res[Identity, Error] = transaction_staged_identity(?t);
    if (sel staged.err) { ret 10; }
    if (which == 2) {
        if (t_fixture_write(?root, "other", "alien") != 0) { ret 11; }
        if (os.rename(root.dirfd, "other", root.dirfd, "out") < 0) { ret 12; }
    }
    if (which == 3) {
        if (failed(close_staging(?t)) || os.unlink(root.dirfd, t.staging_name, 0) < 0) { ret 13; }
    }
    if (which == 4 || which == 5) {
        if (t_fixture_write(?root, "saved", "foreign") != 0) { ret 14; }
    }
    if (which == 5) {
        if (failed(close_staging(?t)) || os.unlink(root.dirfd, t.staging_name, 0) < 0) { ret 15; }
        if (os.make_dir(root.dirfd, t.staging_name, 0o700) < 0) { ret 16; }
    }
    var out: BackupOutcome = commit_with_backup(?t, backup);
    fin { str_free(owned, out.staging_residue); }
    if (!out.consumed || prepared(?t) || destination.active || backup.active || session.held.borrowers != 2) { ret 17; }
    if (which == 0 || which == 1) {
        if (sel out.failure.err || sel out.cleanup_failure.err
            || !out.published || out.prior_moved != existing || out.achieved != DUR_FULL || out.shortfall) { ret 18; }
        if (!t_backup_contents(?root, "out", "next")) { ret 19; }
        val identity: res[opt[Identity], Error] = entry_identity(?root, "out");
        if (sel identity.err) { ret 20; }
        val current: opt[Identity] = res_value[opt[Identity]](identity);
        if (sel current.none || !identity_equal(res_value[Identity](staged), some_of[Identity](current))) { ret 21; }
        if (existing) {
            if (!t_backup_contents(?root, "saved", "prior")) { ret 22; }
            val prior: res[opt[Identity], Error] = entry_identity(?root, "saved");
            if (sel prior.err) { ret 23; }
            val saved: opt[Identity] = res_value[opt[Identity]](prior);
            if (sel saved.none || !identity_equal(t.prior, some_of[Identity](saved))) { ret 24; }
            if (failed(entry_unlink(backup))) { ret 25; }
        }
        or { if (!entry_absent(root.dirfd, "saved")) { ret 26; } }
    }
    or {
        if (!sel out.failure.err || out.published || out.achieved != DUR_NONE) { ret 27; }
        if (which == 2) {
            if (error_of(out.failure).kind != PRECONDITION || out.prior_moved
                || !t_backup_contents(?root, "out", "alien") || !entry_absent(root.dirfd, "saved")) { ret 28; }
        }
        if (which == 3) {
            if (!out.prior_moved || !entry_absent(root.dirfd, "out") || !t_backup_contents(?root, "saved", "prior")) { ret 29; }
            if (failed(entry_rename(backup, destination)) || !t_backup_contents(?root, "out", "prior")) { ret 30; }
        }
        if (which == 4 || which == 5) {
            if (error_of(out.failure).kind != CONFLICT || out.prior_moved
                || !t_backup_contents(?root, "saved", "foreign") || !entry_absent(root.dirfd, "out")) { ret 31; }
        }
    }
    if (which == 5) {
        if (!sel out.cleanup_failure.err || out.staging_residue == nil || !staging_residue(out.staging_residue)) { ret 32; }
        if (os.unlink(root.dirfd, out.staging_residue, os.AT_REMOVEDIR) < 0) { ret 33; }
    }
    or { if (sel out.cleanup_failure.err || out.staging_residue != nil) { ret 34; } }
    val spent: BackupOutcome = commit_with_backup(?t, backup);
    if (spent.consumed || !sel spent.failure.err || error_of(spent.failure).kind != INVALID) { ret 35; }
    str_free(owned, out.staging_residue);
    out.staging_residue = nil;
    if (testing.leaked(?tracker) || testing.double_free_count(?tracker) != 0 || testing.tracking_exhausted(?tracker)) { ret 36; }
    ret 0;
}

test "std.filesystem.transaction.backup_commit: initial absence publishes without creating a backup" {
    ret t_backup_commit_case(0);
}

test "std.filesystem.transaction.backup_commit: prior identity and contents remain caller-owned" {
    ret t_backup_commit_case(1);
}

test "std.filesystem.transaction.backup_commit: changed prior is preserved without any rename" {
    ret t_backup_commit_case(2);
}

test "std.filesystem.transaction.backup_commit: second rename failure retains the original for explicit rollback" {
    ret t_backup_commit_case(3);
}

test "std.filesystem.transaction.backup_commit: occupied backup is preserved and staging is consumed" {
    ret t_backup_commit_case(4);
}

test "std.filesystem.transaction.backup_commit: cleanup residue ownership does not replace the primary error" {
    ret t_backup_commit_case(5);
}

test "std.filesystem.transaction.backup_commit: copied owners and active backups cannot consume another borrow" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (failed(root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (failed(t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    val backup: *Claim = t_reserve(?session, "saved");
    if (destination == nil || backup == nil) { ret 5; }
    var t: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_SAME_OBJECT, durability: durability_none()};
    if (failed(prepare_bytes(?t, ?alloc, destination, "next", 4, 0o600, false, options))) { ret 6; }
    fin { if (prepared(?t)) { abort(?t); } }
    var copied: Transaction = t;
    val refused: BackupOutcome = commit_with_backup(?copied, backup);
    if (refused.consumed || !sel refused.failure.err || !prepared(?t) || !destination.active) { ret 7; }
    if (failed(borrow_claim(backup, OP_COMMIT))) { ret 8; }
    val busy: BackupOutcome = commit_with_backup(?t, backup);
    if (!busy.consumed || !sel busy.failure.err || destination.active || !backup.active) { return_claim(backup); ret 9; }
    return_claim(backup);
    if (!entry_absent(root.dirfd, "out") || !entry_absent(root.dirfd, "saved") || busy.staging_residue != nil) { ret 10; }
    ret 0;
}

test "std.filesystem.transaction.root_open_child: derives the held namespace after ancestor rename" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var outer: Root;
    if (failed(root_open(?outer, base, ""))) { ret 3; }
    fin { root_dnit(?outer); }
    if (os.make_dir(outer.dirfd, "anchor", 0o700) < 0) { ret 4; }
    var parent: Root;
    if (failed(root_open_child(?parent, ?outer, "anchor"))) { ret 14; }
    fin { root_dnit(?parent); }
    if (os.make_dir(parent.dirfd, "before", 0o700) < 0) { ret 15; }
    var child: Root;
    if (failed(root_open_child(?child, ?parent, "before"))) { ret 5; }
    if (t_fixture_write(?child, "data", "held") != 0 || failed(root_dnit(?child))) { ret 6; }
    if (os.rename(outer.dirfd, "anchor", outer.dirfd, "moved") < 0) { ret 7; }
    if (os.make_dir(outer.dirfd, "anchor", 0o700) < 0) { ret 16; }
    if (failed(root_open_child(?child, ?parent, "before"))) { ret 8; }
    fin { root_dnit(?child); }
    if (!t_backup_contents(?child, "data", "held")) { ret 9; }
    var copied: Root = parent;
    var invalid: Root;
    val refused: err[Error] = root_open_child(?invalid, ?copied, "before");
    if (sel refused.ok || error_of(refused).kind != INVALID) { ret 10; }
    if (!failed(root_open_child(?invalid, ?parent, "../before"))) { ret 11; }
    if (t_fixture_write(?parent, "file", "plain") != 0) { ret 12; }
    val regular: err[Error] = root_open_child(?invalid, ?parent, "file");
    if (sel regular.ok || error_of(regular).kind != CONTAINMENT) { ret 13; }
    ret 0;
}

test "std.filesystem.transaction.staged_child_identity: journal observes the exact prepared descendant" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (failed(root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (failed(t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "src");
    if (destination == nil) { ret 5; }
    var inv: Inventory = inventory_init(?alloc);
    fin { inventory_dnit(?inv); }
    if (failed(inventory_push(?inv, entry_file("entry", "payload", 7, 0o000)))) { ret 6; }
    var t: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_ABSENT, durability: durability_none()};
    if (failed(prepare_subtree(?t, ?alloc, destination, ?inv, 0o700, options))) { ret 7; }
    fin { if (prepared(?t)) { abort(?t); } }
    val before: res[Identity, Error] = transaction_staged_child_identity(?t, "entry");
    if (sel before.err) { ret 8; }
    var copy: Transaction = t;
    if (!res_failed[Identity](transaction_staged_child_identity(?copy, "entry"))) { ret 9; }
    val escape: res[Identity, Error] = transaction_staged_child_identity(?t, "../entry");
    if (sel escape.ok || res_error[Identity](escape).kind != CONTAINMENT) { ret 10; }
    val absent: res[Identity, Error] = transaction_staged_child_identity(?t, "missing");
    if (sel absent.ok || res_error[Identity](absent).code != os.ENOENT) { ret 11; }
    if (res_failed[Outcome](commit(?t))) { ret 12; }
    if (!res_failed[Identity](transaction_staged_child_identity(?t, "entry"))) { ret 13; }
    var child: Root;
    if (failed(root_open_child(?child, ?root, "src"))) { ret 14; }
    fin { root_dnit(?child); }
    val after: res[opt[Identity], Error] = entry_identity(?child, "entry");
    if (sel after.err) { ret 15; }
    val observed: opt[Identity] = res_value[opt[Identity]](after);
    if (sel observed.none || !identity_equal(res_value[Identity](before), some_of[Identity](observed))) { ret 16; }
    ret 0;
}

test "std.filesystem.transaction.exact_mode: file permissions finalize before publication or refuse" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (failed(root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (failed(t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var transaction: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_ABSENT, exact_mode: true, durability: durability_file(true)};
    val prepared: err[Error] = prepare_bytes(?transaction, ?alloc, destination, "exact", 5, 0o774, false, options);
    $if ($mach.build.os == $mach.os.windows) {
        if (!sel prepared.err) { abort(?transaction); ret 6; }
        val failure: Error = error_of(prepared);
        if (failure.kind != UNSUPPORTED || failure.op != OP_PREPARE || failure.code != os.ENOTSUP || failure.cleanup_code != 0) { ret 7; }
        if (destination.active || payload_entry_count(?alloc, base) != 0) { ret 8; }
        ret 0;
    }
    $or {
        if (sel prepared.err) { ret 9; }
        var staged: os.stat_t;
        if (os.stat(transaction.staging_fd, ?staged) < 0 || (os.stat_mode(?staged) & 0o7777) != 0o774) { abort(?transaction); ret 10; }
        if (!transaction.content_flushed) { abort(?transaction); ret 11; }
        val committed: res[Outcome, Error] = commit(?transaction);
        if (sel committed.err) { ret 12; }
        var published: os.stat_t;
        if (os.stat_path(root.dirfd, "out", ?published, os.AT_SYMLINK_NOFOLLOW) < 0 || (os.stat_mode(?published) & 0o7777) != 0o774) { ret 13; }
        if (!t_backup_contents(?root, "out", "exact") || destination.active) { ret 14; }
        ret 0;
    }
}

test "std.filesystem.transaction.exact_mode: directory and subtree requests refuse before borrowing" {
    var alloc: A.Allocator;
    val page_r: err[A.Error] = page.make(?alloc);
    if (sel page_r.err) { ret 1; }
    val scratch: res[str, fs.FsError] = scratch_root(?alloc);
    if (sel scratch.err) { ret 2; }
    val base: str = scratch.ok;
    fin { fs.remove_all(?alloc, base); str_free(?alloc, base); }
    var root: Root;
    if (failed(root_open(?root, base, ""))) { ret 3; }
    fin { root_dnit(?root); }
    var session: TestSession;
    if (failed(t_session_init(?session, ?alloc, ?root))) { ret 4; }
    fin { t_session_dnit(?session); }
    val destination: *Claim = t_reserve(?session, "out");
    if (destination == nil) { ret 5; }
    var transaction: Transaction;
    val options: PrepareOptions = PrepareOptions{precondition: PRE_ABSENT, exact_mode: true, durability: durability_none()};
    val directory: err[Error] = prepare_dir(?transaction, ?alloc, destination, 0o774, options);
    if (sel directory.ok || error_of(directory).kind != INVALID || destination.active) { ret 6; }
    var inventory: Inventory = inventory_init(?alloc);
    fin { inventory_dnit(?inventory); }
    val subtree: err[Error] = prepare_subtree(?transaction, ?alloc, destination, ?inventory, 0o774, options);
    if (sel subtree.ok || error_of(subtree).kind != INVALID || destination.active) { ret 7; }
    if (payload_entry_count(?alloc, base) != 0) { ret 8; }
    ret 0;
}

test "std.filesystem.transaction.error: producer codes survive semantic classification" {
    val native: Error = io_error(OP_PREPARE, os.ENOTSUP);
    if (native.kind != UNSUPPORTED || native.code != os.ENOTSUP) { ret 1; }
    val semantic: Error = error(UNSUPPORTED, OP_PREPARE);
    if (semantic.kind != UNSUPPORTED || semantic.code != 0) { ret 2; }
    val removed: Error = removal_error(OP_PREPARE, removal.Error{code: os.EINVAL, containment: true});
    if (removed.kind != CONTAINMENT || removed.code != os.EINVAL) { ret 3; }
    val combined: Error = with_cleanup_error(native, removed.code);
    if (combined.kind != UNSUPPORTED || combined.code != os.ENOTSUP || combined.cleanup_code != os.EINVAL) { ret 4; }
    ret 0;
}
