                    if (O.is_none[Error](absent)) {
                        val unexpected: *Root = ?root_storage_47;
        fin { root_dnit(unexpected); }
        var unexpected_session: TestSession;
        if (O.is_some[Error](t_session_init(?unexpected_session, ?a, unexpected))) { ret 90; }
        fin { t_session_dnit(?unexpected_session); }

                        bad = 15;
                    }
