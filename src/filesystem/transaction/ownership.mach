# stable owners for cooperative root claims and filesystem-enforced leaf reservations
use std.types.bool.bool;
use fsnative: std.filesystem.native;
use std.filesystem.removal;
use io_error: std.io.error;
use std.sync.atomic;
use std.sync.mutex;
use std.sync.thread;
use std.system.os;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;

$if ($mach.build.os == $mach.os.linux)  { use native: std.system.os.linux; }
$or ($mach.build.os == $mach.os.darwin) { use native: std.system.os.darwin; }

fun refused(kind: io_error.Kind) err[removal.Error] {
    ret err[removal.Error].err{removal.Error{kind: kind}};
}

# ok for a non-negative primitive return, the native failure otherwise
fun checked(code: i64) err[removal.Error] {
    if (code < 0) { ret err[removal.Error].err{removal.from_native(code)}; }
    ret err[removal.Error].ok{};
}

pub val LOCK_LEAF:   str = ".mach-txn-lock";
pub val CLAIMS_LEAF: str = ".machtxn.claims";

# initialized owners stay at their original address until destruction
pub rec Root {
    dirfd: usize;
    # the control directory holding the lock sentinel, claims and backups:
    # os.INVALID_HANDLE when the root directory is its own home, closed at destruction
    # only when derivation opened it
    home_fd:    usize;
    home_owned: bool;
    address:    usize;
    gate:       mutex.Mutex;
    claimed:    bool;
}

# the directory this module's control files live in
pub fun control_fd(root: *Root) usize {
    if (root.home_fd != os.INVALID_HANDLE) { ret root.home_fd; }
    ret root.dirfd;
}

pub fun root_homed(root: *Root) bool {
    ret root_valid(root) && root.home_fd != os.INVALID_HANDLE;
}

pub rec Lock {
    fd:          usize;
    claims_fd:   usize;
    address:     usize;
    root:        *Root;
    gate:        mutex.Mutex;
    borrowers:   usize;
    initialized: bool;
    recovering:  bool;
    closing:     bool;
}

# name is borrowed from the destination claim and remains valid through release
pub rec Borrow {
    address:  usize;
    owner:    *Lock;
    name:     str;
    claim_fd: usize;
    active:   bool;
}

pub fun root_valid(root: *Root) bool {
    if (root == nil || root.address != root::usize) { ret false; }
    mutex.lock(?root.gate);
    val valid: bool = root.dirfd != os.INVALID_HANDLE;
    mutex.unlock(?root.gate);
    ret valid;
}

pub fun lock_valid(held: *Lock) bool {
    if (held == nil || held.address != held::usize) { ret false; }
    mutex.lock(?held.gate);
    val valid: bool = held.fd != os.INVALID_HANDLE && !held.closing;
    mutex.unlock(?held.gate);
    ret valid;
}

pub fun borrow_valid(borrow: *Borrow) bool {
    ret borrow != nil && borrow.address == borrow::usize && borrow.active;
}

# takes descriptor ownership only on success
pub fun root_init(out: *Root, fd: usize) err[removal.Error] {
    ret root_init_with_home(out, fd, os.INVALID_HANDLE, false);
}

# `home_fd` is the control directory, owned by the root only when `owned`;
# a borrowed home stays the caller's to keep alive through the root's use
pub fun root_init_with_home(out: *Root, fd: usize, home_fd: usize, owned: bool) err[removal.Error] {
    if (out == nil || fd == os.INVALID_HANDLE)                                             { ret refused(io_error.INVALID); }
    if (out.address != 0 && (out.address != out::usize || out.dirfd != os.INVALID_HANDLE)) { ret refused(io_error.INVALID); }
    out.dirfd      = fd;
    out.home_fd    = home_fd;
    out.home_owned = owned && home_fd != os.INVALID_HANDLE;
    out.gate       = mutex.make();
    out.claimed    = false;
    out.address    = out::usize;
    ret err[removal.Error].ok{};
}

# give an unclaimed root a borrowed home, releasing one it owned
pub fun root_set_home(root: *Root, home_fd: usize) err[removal.Error] {
    if (!root_valid(root)) { ret refused(io_error.INVALID); }
    mutex.lock(?root.gate);
    if (root.claimed) {
        mutex.unlock(?root.gate);
        ret refused(io_error.INVALID);
    }
    val previous: usize = root.home_fd;
    val owned:    bool  = root.home_owned;
    root.home_fd    = home_fd;
    root.home_owned = false;
    mutex.unlock(?root.gate);
    if (owned) { ret checked(os.close(previous)); }
    ret err[removal.Error].ok{};
}

pub fun root_destroy(root: *Root) err[removal.Error] {
    if (root == nil)                 { ret refused(io_error.INVALID); }
    if (root.address == 0)           { ret err[removal.Error].ok{}; }
    if (root.address != root::usize) { ret refused(io_error.INVALID); }
    mutex.lock(?root.gate);
    if (root.claimed) {
        mutex.unlock(?root.gate);
        ret refused(io_error.INVALID);
    }
    val fd:      usize = root.dirfd;
    val home_fd: usize = root.home_fd;
    val owned:   bool  = root.home_owned;
    root.dirfd      = os.INVALID_HANDLE;
    root.home_fd    = os.INVALID_HANDLE;
    root.home_owned = false;
    mutex.unlock(?root.gate);
    if (fd == os.INVALID_HANDLE) { ret err[removal.Error].ok{}; }
    var result: i64 = os.close(fd);
    if (owned) {
        val closed: i64 = os.close(home_fd);
        if (result >= 0) { result = closed; }
    }
    ret checked(result);
}

fun nofollow(flags: i32) i32 {
    $if ($mach.build.os != $mach.os.windows) { ret flags | native.O_NOFOLLOW; }
    $or                                      { ret flags; }
}

fun directory(dirfd: usize, name: str) res[usize, removal.Error] {
    var opened_handle: usize = os.INVALID_HANDLE;
    val opened:        i64   = os.open(dirfd, name, nofollow(os.O_RDONLY | os.O_DIRECTORY), 0, ?opened_handle);
    if (opened < 0) { ret res[usize, removal.Error].err{removal.from_native(opened)}; }
    var st:     os.stat_t;
    val status: i64  = os.stat(opened_handle, ?st);
    var failed: removal.Error;
    var found:  bool = false;
    if (status < 0) {
        failed = removal.from_native(status);
        found  = true;
    }
    or ((fsnative.stat_mode(?st) & os.S_IFMT) != os.S_IFDIR) {
        failed = removal.Error{kind: io_error.NOT_DIRECTORY};
        found  = true;
    }
    if (found) {
        failed.cleanup_code = os.close(opened_handle);
        if (failed.cleanup_code >= 0) { failed.cleanup_code = 0; }
        ret res[usize, removal.Error].err{failed};
    }
    ret res[usize, removal.Error].ok{opened_handle};
}

fun root_unclaim(root: *Root) {
    mutex.lock(?root.gate);
    root.claimed = false;
    mutex.unlock(?root.gate);
}

pub fun acquire(out: *Lock, root: *Root) err[removal.Error] {
    if (out == nil || !root_valid(root))                                                { ret refused(io_error.INVALID); }
    if (out.address != 0 && (out.address != out::usize || out.fd != os.INVALID_HANDLE)) { ret refused(io_error.INVALID); }
    mutex.lock(?root.gate);
    if (root.dirfd == os.INVALID_HANDLE || root.claimed) {
        mutex.unlock(?root.gate);
        ret refused(io_error.WOULD_BLOCK);
    }
    root.claimed = true;
    val dirfd: usize = control_fd(root);
    mutex.unlock(?root.gate);
    var completed: bool = false;
    fin {
        if (!completed) { root_unclaim(root); }
    }
    val capabilities: i64 = os.publication_capabilities(dirfd);
    if (capabilities < 0)                            { ret checked(capabilities); }
    if ((capabilities & os.PUBLICATION_CLAIMS) == 0) { ret refused(io_error.UNSUPPORTED); }
    var raw_handle: usize = os.INVALID_HANDLE;
    val raw:        i64   = os.open(dirfd, LOCK_LEAF, nofollow(os.O_CREAT | os.O_WRONLY), 0o600, ?raw_handle);
    if (raw < 0) { ret checked(raw); }
    val fd: usize = raw_handle;
    fin {
        if (!completed) { os.close(fd); }
    }
    var st:     os.stat_t;
    val status: i64 = os.stat(fd, ?st);
    if (status < 0)                                          { ret checked(status); }
    if ((fsnative.stat_mode(?st) & os.S_IFMT) != os.S_IFREG) { ret refused(io_error.INVALID); }
    val locked: i64 = os.lock_fd(fd, os.LOCK_EX | os.LOCK_NB);
    if (locked < 0) { ret checked(locked); }
    out.fd          = fd;
    out.claims_fd   = os.INVALID_HANDLE;
    out.root        = root;
    out.gate        = mutex.make();
    out.borrowers   = 0;
    out.initialized = false;
    out.recovering  = false;
    out.closing     = false;
    out.address     = out::usize;
    completed       = true;
    ret err[removal.Error].ok{};
}

pub fun release_lock(held: *Lock) err[removal.Error] {
    if (held == nil)                 { ret refused(io_error.INVALID); }
    if (held.address == 0)           { ret err[removal.Error].ok{}; }
    if (held.address != held::usize) { ret refused(io_error.INVALID); }
    mutex.lock(?held.gate);
    if (held.borrowers != 0 || held.recovering || held.closing) {
        mutex.unlock(?held.gate);
        ret refused(io_error.INVALID);
    }
    if (held.fd == os.INVALID_HANDLE) {
        mutex.unlock(?held.gate);
        ret err[removal.Error].ok{};
    }
    held.closing = true;
    val fd:        usize = held.fd;
    val claims_fd: usize = held.claims_fd;
    val root:      *Root = held.root;
    mutex.unlock(?held.gate);
    var result: i64 = 0;
    if (claims_fd != os.INVALID_HANDLE) { result = os.close(claims_fd); }
    val closed: i64 = os.close(fd);
    if (result >= 0) { result = closed; }
    root_unclaim(root);
    mutex.lock(?held.gate);
    held.fd          = os.INVALID_HANDLE;
    held.claims_fd   = os.INVALID_HANDLE;
    held.initialized = false;
    held.closing     = false;
    mutex.unlock(?held.gate);
    ret checked(result);
}

fun component(name: str) bool {
    if (str_empty(name) || str_equals(name, ".") || str_equals(name, "..")) { ret false; }
    val len: usize = str_len(name);
    var i:   usize = 0;
    for (i < len) {
        if (name[i] == '/' || name[i] == '\\') { ret false; }
        i = i + 1;
    }
    ret true;
}

fun register(out: *Borrow, held: *Lock) err[removal.Error] {
    if (out == nil || !lock_valid(held))                               { ret refused(io_error.INVALID); }
    if (out.address != 0 && (out.address != out::usize || out.active)) { ret refused(io_error.INVALID); }
    mutex.lock(?held.gate);
    if (held.fd == os.INVALID_HANDLE || held.closing || held.recovering || !held.initialized) {
        mutex.unlock(?held.gate);
        ret refused(io_error.INVALID);
    }
    if (held.borrowers == ~0::usize) {
        mutex.unlock(?held.gate);
        ret refused(io_error.INVALID);
    }
    held.borrowers = held.borrowers + 1;
    mutex.unlock(?held.gate);
    out.address  = out::usize;
    out.owner    = held;
    out.name     = nil;
    out.claim_fd = os.INVALID_HANDLE;
    out.active   = true;
    ret err[removal.Error].ok{};
}

# admission happens before a worker is launched
pub fun borrow_worker(out: *Borrow, held: *Lock) err[removal.Error] {
    ret register(out, held);
}

pub fun borrow_leaf(out: *Borrow, held: *Lock, name: str) err[removal.Error] {
    if (!component(name)) { ret refused(io_error.INVALID); }
    val registered: err[removal.Error] = register(out, held);
    if (sel registered.err) { ret registered; }
    var raw_handle: usize = os.INVALID_HANDLE;
    val raw:        i64   = os.open(held.claims_fd, name,
        nofollow(os.O_CREAT | os.O_EXCL | os.O_WRONLY), 0o600, ?raw_handle);
    if (raw < 0) {
        release_borrow(out);
        ret checked(raw);
    }
    out.name     = name;
    out.claim_fd = raw_handle;
    ret err[removal.Error].ok{};
}

# even failed claim cleanup consumes the borrow and leaves recoverable residue
pub fun release_borrow(borrow: *Borrow) err[removal.Error] {
    if (!borrow_valid(borrow)) { ret refused(io_error.INVALID); }
    val held:   *Lock = borrow.owner;
    var result: i64   = 0;
    if (borrow.claim_fd != os.INVALID_HANDLE) {
        result          = os.close(borrow.claim_fd);
        borrow.claim_fd = os.INVALID_HANDLE;
    }
    if (borrow.name != nil) {
        val removed: i64 = os.unlink(held.claims_fd, borrow.name, 0);
        if (removed < 0 && result >= 0) { result = removed; }
        borrow.name = nil;
    }
    borrow.active = false;
    mutex.lock(?held.gate);
    held.borrowers = held.borrowers - 1;
    mutex.unlock(?held.gate);
    ret checked(result);
}

# the caller keeps the exclusive root claim throughout its recovery effects
pub fun begin_recovery(held: *Lock) err[removal.Error] {
    if (!lock_valid(held)) { ret refused(io_error.INVALID); }
    mutex.lock(?held.gate);
    if (held.fd == os.INVALID_HANDLE || held.borrowers != 0 || held.recovering || held.closing) {
        mutex.unlock(?held.gate);
        ret refused(io_error.INVALID);
    }
    held.recovering = true;
    mutex.unlock(?held.gate);
    ret err[removal.Error].ok{};
}

pub fun end_recovery(held: *Lock, admit: bool) err[removal.Error] {
    if (!lock_valid(held)) { ret refused(io_error.INVALID); }
    mutex.lock(?held.gate);
    if (!held.recovering) {
        mutex.unlock(?held.gate);
        ret refused(io_error.INVALID);
    }
    if (!admit) { held.initialized = false; }
    held.recovering = false;
    mutex.unlock(?held.gate);
    ret err[removal.Error].ok{};
}

fun clear_claims(dirfd: usize) err[removal.Error] {
    for {
        val rewind: i64 = os.seek(dirfd, 0, os.SEEK_SET);
        if (rewind < 0) { ret checked(rewind); }
        var cursor:      os.DirectoryCursor     = os.DirectoryCursor{};
        val initialized: os.DirectoryInitResult = os.directory_init(?cursor, dirfd);
        if (initialized.code < 0) {
            var failed: removal.Error = removal.from_native(initialized.code);
            failed.cleanup_code = initialized.cleanup_code;
            ret err[removal.Error].err{failed};
        }
        var removed:   bool               = false;
        val result:    err[removal.Error] = clear_claims_pass(dirfd, ?cursor, ?removed);
        val completed: err[removal.Error] = removal.with_cleanup(result, os.directory_close(?cursor));
        if (sel completed.err) { ret completed; }
        if (!removed)          { ret err[removal.Error].ok{}; }
    }
    ret err[removal.Error].ok{};
}

fun clear_claims_pass(dirfd: usize, cursor: *os.DirectoryCursor, removed: *bool) err[removal.Error] {
    for {
        var entry: os.DirectoryEntry;
        val next:  i64 = os.directory_next(cursor, ?entry);
        if (next <= 0) { ret checked(next); }
        val name: str = entry.name;
        if (str_equals(name, ".") || str_equals(name, "..")) { cnt; }
        if (!component(name))                                { ret refused(io_error.INVALID); }
        var st:        os.stat_t;
        val inspected: i64 = os.stat_path(dirfd, name, ?st, os.AT_SYMLINK_NOFOLLOW);
        if (inspected < 0)                                                          { ret checked(inspected); }
        if ((fsnative.stat_mode(?st) & os.S_IFMT) != os.S_IFREG || st.st_size != 0) { ret refused(io_error.INVALID); }
        val unlinked: i64 = os.unlink(dirfd, name, 0);
        if (unlinked < 0) { ret checked(unlinked); }
        @removed = true;
    }
    ret err[removal.Error].ok{};
}

# fresh creation inherits the root namespace instead of trusting stale directory flags
pub fun initialize_claims(held: *Lock) err[removal.Error] {
    if (!lock_valid(held)) { ret refused(io_error.INVALID); }
    mutex.lock(?held.gate);
    if (!held.recovering || held.borrowers != 0 || held.closing) {
        mutex.unlock(?held.gate);
        ret refused(io_error.INVALID);
    }
    held.initialized = false;
    val previous: usize = held.claims_fd;
    held.claims_fd = os.INVALID_HANDLE;
    mutex.unlock(?held.gate);
    if (previous != os.INVALID_HANDLE) {
        val closed: i64 = os.close(previous);
        if (closed < 0) { ret checked(closed); }
    }
    val dirfd: usize                     = control_fd(held.root);
    val prior: res[usize, removal.Error] = directory(dirfd, CLAIMS_LEAF);
    if (sel prior.ok) {
        val fd:        usize              = prior.ok;
        val cleared:   err[removal.Error] = clear_claims(fd);
        val completed: err[removal.Error] = removal.with_cleanup(cleared, os.close(fd));
        if (sel completed.err) { ret completed; }
        val removed: i64 = os.unlink(dirfd, CLAIMS_LEAF, os.AT_REMOVEDIR);
        if (removed < 0) { ret checked(removed); }
    }
    or (sel prior.err) {
        val error: removal.Error = prior.err;
        if (error.kind != io_error.NOT_FOUND || error.cleanup_code < 0) { ret err[removal.Error].err{error}; }
    }
    val made: i64 = os.make_dir(dirfd, CLAIMS_LEAF, 0o700);
    if (made < 0) { ret checked(made); }
    val opened: res[usize, removal.Error] = directory(dirfd, CLAIMS_LEAF);
    if (sel opened.err) { ret err[removal.Error].err{opened.err}; }
    mutex.lock(?held.gate);
    held.claims_fd   = opened.ok;
    held.initialized = true;
    mutex.unlock(?held.gate);
    ret err[removal.Error].ok{};
}

fun failed(r: err[removal.Error]) bool {
    ret sel r.err;
}

fun refused_as(r: err[removal.Error], kind: io_error.Kind) bool {
    ret sel r.err && r.err.kind == kind;
}

test std_filesystem_transaction_ownership__live_borrows_prevent_recovery_and_owner_destruction {
    val base: str = "mach_583_owner_lifetime";
    if (os.make_dir(os.working_dir(), base, 0o700) < 0) { ret 1; }
    fin {
        os.unlink(os.working_dir(), "mach_583_owner_lifetime/.machtxn.claims/first", 0);
        os.unlink(os.working_dir(), "mach_583_owner_lifetime/.machtxn.claims/second", 0);
        os.unlink(os.working_dir(), "mach_583_owner_lifetime/.machtxn.claims", os.AT_REMOVEDIR);
        os.unlink(os.working_dir(), "mach_583_owner_lifetime/.mach-txn-lock", 0);
        os.unlink(os.working_dir(), base, os.AT_REMOVEDIR);
    }
    var opened_handle: usize = os.INVALID_HANDLE;
    val opened:        i64   = os.open(os.working_dir(), base, os.O_RDONLY | os.O_DIRECTORY, 0, ?opened_handle);
    if (opened < 0) { ret 2; }
    var root: Root;
    if (failed(root_init(?root, opened_handle))) {
        os.close(opened_handle);
        ret 3;
    }
    fin { root_destroy(?root); }
    var copied_root: Root = root;
    if (!refused_as(root_destroy(?copied_root), io_error.INVALID) || !root_valid(?root)) { ret 4; }
    var held: Lock;
    if (failed(acquire(?held, ?root))) { ret 5; }
    fin { release_lock(?held); }
    if (!refused_as(root_destroy(?root), io_error.INVALID)) { ret 6; }
    var copied_lock: Lock = held;
    if (!refused_as(release_lock(?copied_lock), io_error.INVALID) || !lock_valid(?held)) { ret 7; }
    var worker: Borrow;
    if (!refused_as(borrow_worker(?worker, ?held), io_error.INVALID)) { ret 21; }
    if (failed(begin_recovery(?held)))                                { ret 22; }
    val initialized: err[removal.Error] = initialize_claims(?held);
    end_recovery(?held, true);
    if (sel initialized.err)                                                                                        { ret 23; }
    if (failed(borrow_worker(?worker, ?held)))                                                                      { ret 8; }
    if (!refused_as(begin_recovery(?held), io_error.INVALID) || !refused_as(release_lock(?held), io_error.INVALID)) { ret 9; }
    if (failed(release_borrow(?worker)) || !refused_as(release_borrow(?worker), io_error.INVALID))                  { ret 10; }
    var first:     Borrow;
    var second:    Borrow;
    var duplicate: Borrow;
    if (failed(borrow_leaf(?first, ?held, "first"))) { ret 11; }
    fin {
        if (borrow_valid(?first)) { release_borrow(?first); }
    }
    if (!refused_as(borrow_leaf(?duplicate, ?held, "first"), io_error.EXISTS) || held.borrowers != 1) { ret 12; }
    if (failed(borrow_leaf(?second, ?held, "second")) || held.borrowers != 2)                         { ret 13; }
    fin {
        if (borrow_valid(?second)) { release_borrow(?second); }
    }
    var copied_borrow: Borrow = first;
    if (!refused_as(release_borrow(?copied_borrow), io_error.INVALID) || held.borrowers != 2)                       { ret 14; }
    if (!refused_as(begin_recovery(?held), io_error.INVALID) || !refused_as(release_lock(?held), io_error.INVALID)) { ret 15; }
    if (failed(release_borrow(?first)) || failed(release_borrow(?second)) || held.borrowers != 0)                   { ret 16; }
    if (failed(begin_recovery(?held)))                                                                              { ret 17; }
    if (!refused_as(borrow_worker(?worker, ?held), io_error.INVALID)) {
        end_recovery(?held, true);
        ret 18;
    }
    end_recovery(?held, true);
    if (failed(release_lock(?held)) || failed(release_lock(?held))) { ret 19; }
    if (failed(root_destroy(?root)) || failed(root_destroy(?root))) { ret 20; }
    ret 0;
}

fun t_namespace(base: str) i32 {
    var opened_handle: usize = os.INVALID_HANDLE;
    val opened:        i64   = os.open(os.working_dir(), base, os.O_RDONLY | os.O_DIRECTORY, 0, ?opened_handle);
    if (opened < 0) { ret 1; }
    var root: Root;
    if (failed(root_init(?root, opened_handle))) {
        os.close(opened_handle);
        ret 2;
    }
    fin { root_destroy(?root); }
    var upper_handle: usize = os.INVALID_HANDLE;
    val upper:        i64   = os.open(root.dirfd, "A", nofollow(os.O_CREAT | os.O_EXCL | os.O_WRONLY), 0o600, ?upper_handle);
    if (upper < 0) { ret 3; }
    os.close(upper_handle);
    fin {
        os.unlink(root.dirfd, "A", 0);
        os.unlink(root.dirfd, "a", 0);
    }
    var lower_handle: usize = os.INVALID_HANDLE;
    val lower:        i64   = os.open(root.dirfd, "a", nofollow(os.O_CREAT | os.O_EXCL | os.O_WRONLY), 0o600, ?lower_handle);
    if (lower >= 0)                              { os.close(lower_handle); }
    or (os.error_kind(lower) != io_error.EXISTS) { ret 4; }
    var held: Lock;
    if (failed(acquire(?held, ?root))) { ret 5; }
    fin { release_lock(?held); }
    if (failed(begin_recovery(?held))) { ret 6; }
    val initialized: err[removal.Error] = initialize_claims(?held);
    end_recovery(?held, true);
    if (sel initialized.err) { ret 7; }
    var first:  Borrow;
    var second: Borrow;
    if (failed(borrow_leaf(?first, ?held, "A"))) { ret 8; }
    fin {
        if (borrow_valid(?first)) { release_borrow(?first); }
    }
    val next: err[removal.Error] = borrow_leaf(?second, ?held, "a");
    fin {
        if (borrow_valid(?second)) { release_borrow(?second); }
    }
    if (os.error_kind(lower) == io_error.EXISTS && !refused_as(next, io_error.EXISTS)) { ret 9; }
    if (lower >= 0 && failed(next))                                                    { ret 10; }
    ret 0;
}

test std_filesystem_transaction_ownership__leaf_claims_use_the_root_namespace_equivalence {
    val base: str = "mach_583_owner_namespace";
    if (os.make_dir(os.working_dir(), base, 0o700) < 0) { ret 1; }
    fin {
        os.unlink(os.working_dir(), "mach_583_owner_namespace/.machtxn.claims", os.AT_REMOVEDIR);
        os.unlink(os.working_dir(), "mach_583_owner_namespace/.mach-txn-lock", 0);
        os.unlink(os.working_dir(), base, os.AT_REMOVEDIR);
    }
    ret t_namespace(base);
}

test std_filesystem_transaction_ownership__malformed_claims_close_admission_until_recovery_succeeds {
    val base: str = "mach_583_owner_recovery";
    if (os.make_dir(os.working_dir(), base, 0o700) < 0) { ret 1; }
    fin {
        os.unlink(os.working_dir(), "mach_583_owner_recovery/.machtxn.claims/foreign", 0);
        os.unlink(os.working_dir(), "mach_583_owner_recovery/.machtxn.claims", os.AT_REMOVEDIR);
        os.unlink(os.working_dir(), "mach_583_owner_recovery/.mach-txn-lock", 0);
        os.unlink(os.working_dir(), base, os.AT_REMOVEDIR);
    }
    var opened_handle: usize = os.INVALID_HANDLE;
    val opened:        i64   = os.open(os.working_dir(), base, os.O_RDONLY | os.O_DIRECTORY, 0, ?opened_handle);
    if (opened < 0) { ret 2; }
    var root: Root;
    if (failed(root_init(?root, opened_handle))) {
        os.close(opened_handle);
        ret 3;
    }
    fin { root_destroy(?root); }
    var held: Lock;
    if (failed(acquire(?held, ?root))) { ret 4; }
    fin { release_lock(?held); }
    if (failed(begin_recovery(?held))) { ret 5; }
    val initial: err[removal.Error] = initialize_claims(?held);
    end_recovery(?held, true);
    if (sel initial.err) { ret 6; }
    var raw_handle: usize = os.INVALID_HANDLE;
    val raw:        i64   = os.open(held.claims_fd, "foreign", os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600, ?raw_handle);
    if (raw < 0) { ret 7; }
    val written: i64 = os.write(raw_handle, "x", 1);
    val closed:  i64 = os.close(raw_handle);
    if (written != 1 || closed < 0)    { ret 8; }
    if (failed(begin_recovery(?held))) { ret 9; }
    val refused: err[removal.Error] = initialize_claims(?held);
    end_recovery(?held, true);
    if (sel refused.ok)                       { ret 10; }
    if (refused.err.kind != io_error.INVALID) { ret 10; }
    var worker: Borrow;
    if (!refused_as(borrow_worker(?worker, ?held), io_error.INVALID)) { ret 11; }
    var st: os.stat_t;
    if (os.stat_path(root.dirfd, ".machtxn.claims/foreign", ?st, os.AT_SYMLINK_NOFOLLOW) < 0 || st.st_size != 1) { ret 12; }
    if (os.unlink(root.dirfd, ".machtxn.claims/foreign", 0) < 0)                                                 { ret 13; }
    if (failed(begin_recovery(?held)))                                                                           { ret 14; }
    val repaired: err[removal.Error] = initialize_claims(?held);
    end_recovery(?held, true);
    if (sel repaired.err || failed(borrow_worker(?worker, ?held))) { ret 15; }
    if (failed(release_borrow(?worker)))                           { ret 16; }
    ret 0;
}

rec ClaimWorker {
    held:   *Lock;
    name:   str;
    ready:  i64;
    phase:  i64;
    result: err[removal.Error];
}

fun claim_worker(raw: *u8) {
    val ctx:  *ClaimWorker = raw::*ClaimWorker;
    var leaf: Borrow;
    ctx.result = borrow_leaf(?leaf, ctx.held, ctx.name);
    atomic.store(?ctx.ready, 1);
    os.thread_wake(?ctx.ready);
    for (atomic.load(?ctx.phase) == 0) { os.thread_wait(?ctx.phase, 0); }
    val claimed: bool = sel ctx.result.ok;
    if (claimed) { ctx.result = release_borrow(?leaf); }
}

test std_filesystem_transaction_ownership__admitted_sibling_workers_progress_under_one_root_owner {
    val base: str = "mach_583_sibling_workers";
    if (os.make_dir(os.working_dir(), base, 0o700) < 0) { ret 1; }
    fin {
        os.unlink(os.working_dir(), "mach_583_sibling_workers/.machtxn.claims/first", 0);
        os.unlink(os.working_dir(), "mach_583_sibling_workers/.machtxn.claims/second", 0);
        os.unlink(os.working_dir(), "mach_583_sibling_workers/.machtxn.claims", os.AT_REMOVEDIR);
        os.unlink(os.working_dir(), "mach_583_sibling_workers/.mach-txn-lock", 0);
        os.unlink(os.working_dir(), base, os.AT_REMOVEDIR);
    }
    var raw_handle: usize = os.INVALID_HANDLE;
    val raw:        i64   = os.open(os.working_dir(), base, os.O_RDONLY | os.O_DIRECTORY, 0, ?raw_handle);
    if (raw < 0) { ret 2; }
    var root: Root;
    if (failed(root_init(?root, raw_handle))) {
        os.close(raw_handle);
        ret 3;
    }
    fin { root_destroy(?root); }
    var held: Lock;
    if (failed(acquire(?held, ?root))) { ret 4; }
    fin { release_lock(?held); }
    if (failed(begin_recovery(?held))) { ret 5; }
    val initialized: err[removal.Error] = initialize_claims(?held);
    end_recovery(?held, true);
    if (sel initialized.err) { ret 6; }
    var first_admission:  Borrow;
    var second_admission: Borrow;
    if (failed(borrow_worker(?first_admission, ?held))) { ret 7; }
    fin {
        if (borrow_valid(?first_admission)) { release_borrow(?first_admission); }
    }
    if (failed(borrow_worker(?second_admission, ?held))) { ret 8; }
    fin {
        if (borrow_valid(?second_admission)) { release_borrow(?second_admission); }
    }
    if (!refused_as(begin_recovery(?held), io_error.INVALID)) { ret 9; }
    var first:         ClaimWorker = ClaimWorker{held: ?held, name: "first", ready: 0, phase: 0, result: err[removal.Error].ok{}};
    var second:        ClaimWorker = ClaimWorker{held: ?held, name: "second", ready: 0, phase: 0, result: err[removal.Error].ok{}};
    var first_thread:  thread.Thread;
    var second_thread: thread.Thread;
    thread.spawn_with(claim_worker, (?first)::*u8, ?first_thread);
    if (first_thread.tid < 0) { ret 10; }
    fin {
        atomic.store(?first.phase, 2);
        os.thread_wake(?first.phase);
        if (first_thread.done == 0) { thread.join(?first_thread); }
    }
    thread.spawn_with(claim_worker, (?second)::*u8, ?second_thread);
    if (second_thread.tid < 0) { ret 11; }
    fin {
        atomic.store(?second.phase, 2);
        os.thread_wake(?second.phase);
        if (second_thread.done == 0) { thread.join(?second_thread); }
    }
    for (atomic.load(?first.ready) == 0) { os.thread_wait(?first.ready, 0); }
    for (atomic.load(?second.ready) == 0) { os.thread_wait(?second.ready, 0); }
    if (failed(first.result) || failed(second.result) || held.borrowers != 4) { ret 12; }
    var duplicate: Borrow;
    val refused:   err[removal.Error] = borrow_leaf(?duplicate, ?held, "first");
    if (borrow_valid(?duplicate))                                                                                   { release_borrow(?duplicate); }
    if (!refused_as(refused, io_error.EXISTS) || held.borrowers != 4)                                               { ret 13; }
    if (!refused_as(begin_recovery(?held), io_error.INVALID) || !refused_as(release_lock(?held), io_error.INVALID)) { ret 14; }
    atomic.store(?first.phase, 2);
    os.thread_wake(?first.phase);
    thread.join(?first_thread);
    if (failed(first.result) || failed(release_borrow(?first_admission))) { ret 15; }
    var next: Borrow;
    if (failed(borrow_leaf(?next, ?held, "first")))           { ret 16; }
    if (failed(release_borrow(?next)) || held.borrowers != 2) { ret 17; }
    if (!refused_as(begin_recovery(?held), io_error.INVALID)) { ret 18; }
    atomic.store(?second.phase, 2);
    os.thread_wake(?second.phase);
    thread.join(?second_thread);
    if (failed(second.result) || failed(release_borrow(?second_admission)) || held.borrowers != 0) { ret 19; }
    if (failed(begin_recovery(?held)))                                                             { ret 20; }
    end_recovery(?held, true);
    ret 0;
}
