# filesystem helpers built on the os contract's stat, unlink and environment
#
# each one reads a per-OS layout or policy the contract does not name, so it
# selects the per-OS module the way a filesystem backend does

use io_error: std.io.error;
use std.runtime.native.view.Unit;
use std.system.capability;
use identities: std.system.file_identity;
use std.types.size.isize;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

$if (capability.HAS_FILES && capability.HAS_PROCESS) {
    use std.system.os;
}
$or {
    $error("std.filesystem.native needs the files and process capabilities (std.system.capability.HAS_FILES, HAS_PROCESS)");
}

$if ($mach.build.os == $mach.os.linux) {
    use native: std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use native: std.system.os.darwin;
}
$or ($mach.build.os == $mach.os.windows) {
    use native: std.system.os.windows;
}

# the mode word of a stat record: file type and permission bits
pub fun stat_mode(st: *os.stat_t) u32 {
    ret native.stat_mode(st);
}

# remove a rooted entry without changing read-only attributes on surviving aliases
# ---
# dir:   the root handle, never the working directory
# path:  the entry below it
# flags: AT_REMOVEDIR for a directory
# ret:   zero, or a negative native code
pub fun unlink_force(dir: usize, path: *u8, flags: i32) i64 {
    if (dir == os.working_dir())             { ret native.EINVAL; }
    $if ($mach.build.os == $mach.os.windows) { ret native.unlink_force(dir::isize::i32, path, flags); }
    $or                                      { ret os.unlink(dir, path, flags); }
}

# unlink_force for a name in native units, which reach the kernel unchanged
# ---
# dir:   the root handle, never the working directory
# name:  the nul-terminated entry below it
# flags: AT_REMOVEDIR for a directory
# ret:   zero, or a negative native code
pub fun unlink_force_native(dir: usize, name: *Unit, flags: i32) i64 {
    if (dir == os.working_dir())             { ret native.EINVAL; }
    $if ($mach.build.os == $mach.os.windows) { ret native.unlink_force_native(dir::isize::i32, name, flags); }
    $or                                      { ret os.unlink_native(dir, name, flags); }
}

# resolve the directory designated for temporary files
#
# follows the env.get truncation contract: ret < cap means the path was
# copied and null-terminated, and ret >= cap signals truncation with ret the
# full path length. lookup order is per-OS:
#   windows: GetTempPathA, TMP, then TEMP, then USERPROFILE, then the
#            windows directory. the result ends with a path separator
#   posix:   the $TMPDIR environment variable, falling back to "/tmp"
# ---
# buf: destination buffer for the path
# cap: buffer capacity in bytes
# ret: full length of the path, or a negative native code
pub fun temp_dir(buf: *u8, cap: usize) i64 {
    $if ($mach.build.os == $mach.os.windows) {
        ret native.temp_dir(buf, cap);
    }
    $or {
        val n: i64 = os.getenv("TMPDIR", buf, cap);
        if (n > 0) { ret n; }
        ret copy_default(buf, cap);
    }
}

# temp_dir in native units, under the same truncation contract with cap
# counted in units. on windows the W API's path is reported as it is, so a
# directory whose path holds an unpaired surrogate is still found. on linux
# and darwin the bytes are the native units and this is temp_dir
pub fun temp_dir_native(buf: *Unit, cap: usize) i64 {
    $if ($mach.build.os == $mach.os.windows) { ret native.temp_dir_native(buf, cap); }
    $or                                      { ret temp_dir(buf, cap); }
}

$if ($mach.build.os != $mach.os.windows) {
    val TEMP_DIR_DEFAULT: str = "/tmp";

    # copy the posix fallback under the temp_dir truncation contract
    fun copy_default(buf: *u8, cap: usize) i64 {
        val src: *u8   = TEMP_DIR_DEFAULT::*u8;
        val len: usize = str_len(TEMP_DIR_DEFAULT);
        var i:   usize = 0;
        for (i + 1 < cap && i < len) {
            buf[i] = src[i];
            i      = i + 1;
        }
        if (i < cap) { buf[i] = 0; }
        ret len::i64;
    }
}

# every host: temp_dir_native names the directory temp_dir names, and
# unlink_force_native removes an entry below a root by its native units
# (U+00E9 as one UTF-16 unit on windows, its two UTF-8 bytes elsewhere)
test native__temp_dir_and_forced_removal_reach_what_the_utf_8_forms_reach {
    var units: [1024]Unit;
    var bytes: [1024]u8;
    val wide:  i64 = temp_dir_native(?units[0], 1024);
    val utf8:  i64 = temp_dir(?bytes[0], 1024);
    if (wide < 1 || wide >= 1024 || utf8 < 1 || utf8 >= 1024) { ret 1; }
    var by_units: identities.Identity;
    var by_name:  identities.Identity;
    if (os.identity_at_native(os.working_dir(), ?units[0], ?by_units) < 0
        || os.identity_at(os.working_dir(), ?bytes[0], ?by_name) < 0
        || !identities.equal(by_units, by_name)) { ret 2; }

    val base: str = "mach_std_unlink_force_native";
    if (os.make_dir(os.working_dir(), base, 0o700) < 0) { ret 3; }
    fin { os.unlink(os.working_dir(), base, os.AT_REMOVEDIR); }
    var root: usize = os.INVALID_HANDLE;
    if (os.open(os.working_dir(), base, os.O_RDONLY | os.O_DIRECTORY, 0, ?root) < 0) { ret 4; }
    fin { os.close(root); }
    var created: usize = os.INVALID_HANDLE;
    if (os.open(root, "entry_\xc3\xa9", os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600, ?created) < 0) { ret 5; }
    os.close(created);
    var name: [16]Unit;
    val leaf: str   = "entry_";
    var i:    usize = 0;
    for (leaf[i] != 0) {
        name[i] = leaf[i]::Unit;
        i       = i + 1;
    }
    $if ($mach.build.os == $mach.os.windows) {
        name[i] = 0xe9;
        i       = i + 1;
    }
    $or {
        name[i]     = 0xc3;
        name[i + 1] = 0xa9;
        i           = i + 2;
    }
    name[i] = 0;
    if (unlink_force_native(os.working_dir(), ?name[0], 0) != native.EINVAL) { ret 6; }
    if (unlink_force_native(root, ?name[0], 0) < 0) {
        os.unlink(root, "entry_\xc3\xa9", 0);
        ret 7;
    }
    var st: os.stat_t;
    if (os.error_kind(os.stat_path(root, "entry_\xc3\xa9", ?st, os.AT_SYMLINK_NOFOLLOW)) != io_error.NOT_FOUND) { ret 8; }
    ret 0;
}
