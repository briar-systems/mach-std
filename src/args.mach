# command-line arguments as views, and a reader for the toolchain's flag conventions
#
# the process arguments are the argc and argv std.runtime hands main. this
# module borrows them and allocates nothing. on windows the runtime splits the
# wide command line by the post-2008 msvcrt rules and converts each argument to
# UTF-8, so a program reads the same argv bytes on every host. an unpaired
# surrogate, which a windows argument may hold, arrives as U+FFFD, one per code
# unit, so such an argument does not round-trip to the native name.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

# the process arguments, borrowed from main's argc and argv
# ---
# argc: number of arguments, the program name included
# argv: the arguments, each a null-terminated string
pub rec Args {
    argc: usize;
    argv: **u8;
}

# view main's argc and argv
# ---
# argc: number of arguments
# argv: the arguments
# ret:  the view
pub fun of(argc: usize, argv: **u8) Args {
    var a: Args;
    a.argc = argc;
    a.argv = argv;
    ret a;
}

# the number of arguments, the program name included
pub fun count(a: Args) usize {
    ret a.argc;
}

# the argument at an index
# ---
# a:   the arguments
# idx: argument index, 0 the program name
# ret: the argument, or none when the index is out of range
pub fun get(a: Args, idx: usize) opt[str] {
    if (idx >= a.argc) { ret opt[str].none{}; }
    ret opt[str].some{a.argv[idx]::str};
}

# an iterator over arguments
# ---
# args: the arguments being walked
# at:   index of the next argument
pub rec Cursor {
    args: Args;
    at:   usize;
}

# iterate arguments from an index
# ---
# a:     the arguments
# start: index of the first argument to yield, 1 to skip the program name
# ret:   the cursor
pub fun cursor(a: Args, start: usize) Cursor {
    var c: Cursor;
    c.args = a;
    c.at   = start;
    ret c;
}

# take the next argument
# ---
# c:   the cursor
# ret: the argument, or none when they are exhausted
pub fun next(c: *Cursor) opt[str] {
    val s: opt[str] = get(c.args, c.at);
    if (sel s.some) { c.at = c.at + 1; }
    ret s;
}

# how a flag takes its value
# ---
# SWITCH:   `--key` sets it, and `--no-key` clears it when the row is negatable
# VALUE:    `--key value` or `--key=value` gives it a value
# ATTACHED: `--key` alone sets it, and `--key=value` also gives it a value
pub def Kind: u8;
pub val SWITCH:   Kind = 0;
pub val VALUE:    Kind = 1;
pub val ATTACHED: Kind = 2;

# one flag a program accepts. a row is its own identity: the reader reports the
# row a flag matched, and a program asks for its setting by address. the reader
# never reads value or doc, so a program builds its help text from the same rows
# ---
# name:      the long spelling, such as `--write`
# short:     the short spelling, such as `-w`, or nil. a short flag never takes `=value`
# kind:      SWITCH, VALUE or ATTACHED
# negatable: a switch also answers to `--no-` and the rest of name
# repeat:    the flag may occur more than once, each occurrence an event and the last one its
#            setting. any other flag is refused when it repeats
# value:     the placeholder help shows for a value
# doc:       one-line help text
pub rec Flag {
    name:      str;
    short:     str;
    kind:      Kind;
    negatable: bool;
    repeat:    bool;
    value:     str;
    doc:       str;
}

# where a command line was refused. idx is the argument index and flag its text
pub rec Refused {
    idx:  usize;
    flag: str;
}

# why a command line was refused
# ---
# unknown:       the flag names no row
# missing_value: a VALUE flag ends the line with no value after it
# repeated:      a flag that does not repeat occurs again
pub tag Error: u8 {
    unknown:       Refused;
    missing_value: Refused;
    repeated:      Refused;
}

# what one flag was given
# ---
# flag:  the row the flag matched
# idx:   argument index of the flag
# on:    false only for a negated switch
# value: the value given, nil when none was
pub rec Hit {
    flag:  *Flag;
    idx:   usize;
    on:    bool;
    value: str;
}

# one step of a command line
# ---
# done:    no arguments remain
# operand: an operand, by argument index
# hit:     a flag
pub tag Event: u8 {
    done;
    operand: usize;
    hit:     Hit;
}

# the last thing a row was given. the reader keeps one per row, in storage the program owns
# ---
# count: how many times the flag occurred
# idx:   argument index of the last occurrence
# on:    the last occurrence's state
# value: the last occurrence's value, nil when it had none
pub rec Setting {
    count: usize;
    idx:   usize;
    on:    bool;
    value: str;
}

# a command line being read against a flag table
pub rec Reader {
    args:     Args;
    flags:    **Flag;
    flag_n:   usize;
    settings: *Setting;
    at:       usize;
    ended:    bool;
    sep:      usize;
}

# read arguments against a flag table
# ---
# a:        the arguments
# start:    index of the first argument to read. 1 skips the program name, and a program that
#           dispatches on a command word reads it with get and starts after it
# flags:    the flag rows
# flag_n:   number of rows
# settings: one Setting per row, in row order. the reader clears it
# ret:      the reader
pub fun reader(a: Args, start: usize, flags: **Flag, flag_n: usize, settings: *Setting) Reader {
    var r: Reader;
    r.args     = a;
    r.flags    = flags;
    r.flag_n   = flag_n;
    r.settings = settings;
    r.at       = start;
    r.sep      = a.argc;
    var i: usize = 0;
    for (i < flag_n) {
        settings[i] = Setting{count: 0, idx: 0, on: false, value: nil};
        i           = i + 1;
    }
    ret r;
}

# a token that is a flag: a dash and something after it. a lone `-` is an operand
fun is_flag(tok: str) bool {
    ret tok[0] == '-' && tok[1] != 0;
}

# a token matched against a row
# ---
# found:    a row matched
# row:      its index
# negated:  the token was the row's `--no-` spelling
# value_at: byte offset of an attached value, 0 when the token carries none
rec Match {
    found:    bool;
    row:      usize;
    negated:  bool;
    value_at: usize;
}

fun find(r: *Reader, tok: str) Match {
    var m: Match;
    var j: usize = 0;
    for (j < r.flag_n) {
        val f: *Flag = r.flags[j];
        m.row = j;
        if (str_equals(tok, f.name) || (f.short != nil && str_equals(tok, f.short))) {
            m.found = true;
            ret m;
        }
        if (f.kind == SWITCH) {
            if (f.negatable && str_starts_with(tok, "--no-") && str_equals(?tok[5], ?f.name[2])) {
                m.found   = true;
                m.negated = true;
                ret m;
            }
        }
        or {
            val n: usize = str_len(f.name);
            if (str_starts_with(tok, f.name) && tok[n] == '=') {
                m.found    = true;
                m.value_at = n + 1;
                ret m;
            }
        }
        j = j + 1;
    }
    m.found = false;
    ret m;
}

# read the next argument: an operand, or a flag with its value taken
# ---
# r:   the reader
# ret: the event, or the refusal and where it happened. after a refusal the reader is not
#      to be read further
pub fun read(r: *Reader) res[Event, Error] {
    for {
        if (r.at >= r.args.argc) { ret res[Event, Error].ok{Event.done{}}; }
        val idx: usize = r.at;
        val tok: str   = r.args.argv[idx]::str;
        r.at = idx + 1;
        if (r.ended || !is_flag(tok)) { ret res[Event, Error].ok{Event.operand{idx}}; }
        if (str_equals(tok, "--")) {
            r.ended = true;
            r.sep   = idx;
            cnt;
        }

        val m:  Match   = find(r, tok);
        val at: Refused = Refused{idx: idx, flag: tok};
        if (!m.found) { ret res[Event, Error].err{Error.unknown{at}}; }
        val f: *Flag    = r.flags[m.row];
        val s: *Setting = ?r.settings[m.row];
        if (s.count > 0 && !f.repeat) { ret res[Event, Error].err{Error.repeated{at}}; }

        var hit: Hit = Hit{flag: f, idx: idx, on: !m.negated, value: nil};
        if (m.value_at > 0) { hit.value = ?tok[m.value_at]; }
        or (f.kind == VALUE) {
            if (r.at >= r.args.argc) { ret res[Event, Error].err{Error.missing_value{at}}; }
            hit.value = r.args.argv[r.at]::str;
            r.at      = r.at + 1;
        }
        s.count = s.count + 1;
        s.idx   = idx;
        s.on    = hit.on;
        s.value = hit.value;
        ret res[Event, Error].ok{Event.hit{hit}};
    }
    ret res[Event, Error].ok{Event.done{}};
}

# the index of the `--` that ended the options, or the argument count when none did.
# meaningful once the reader has read past it
pub fun separator(r: Reader) usize {
    ret r.sep;
}

# what a row was last given
# ---
# r:    the reader
# flag: a row of the reader's table
# ret:  its setting, or nil when the row is not in the table
pub fun setting(r: Reader, flag: *Flag) *Setting {
    var j: usize = 0;
    for (j < r.flag_n) {
        if (r.flags[j] == flag) { ret ?r.settings[j]; }
        j = j + 1;
    }
    ret nil;
}

# whether a row occurred at all
pub fun given(r: Reader, flag: *Flag) bool {
    val s: *Setting = setting(r, flag);
    ret s != nil && s.count > 0;
}

# whether a switch is set: it occurred and was not negated last
pub fun on(r: Reader, flag: *Flag) bool {
    val s: *Setting = setting(r, flag);
    ret s != nil && s.count > 0 && s.on;
}

# the value a row was last given, nil when it had none
pub fun value(r: Reader, flag: *Flag) str {
    val s: *Setting = setting(r, flag);
    if (s == nil) { ret nil; }
    ret s.value;
}

val F_ON:  Flag = Flag{name: "--on", short: "-o", kind: SWITCH, negatable: true, repeat: false, value: "", doc: ""};
val F_OUT: Flag = Flag{name: "--out", short: nil, kind: VALUE, negatable: false, repeat: false, value: "path", doc: ""};
val F_LOG: Flag = Flag{name: "--log", short: nil, kind: ATTACHED, negatable: false, repeat: false, value: "level", doc: ""};

val TABLE: [3]*Flag = [3]*Flag{?F_ON, ?F_OUT, ?F_LOG};

# the row the next event is a flag of, nil when it is not a flag
fun expect_hit(r: *Reader) *Flag {
    val e: res[Event, Error] = read(r);
    if (sel e.err)    { ret nil; }
    if (sel e.ok.hit) { ret e.ok.hit.flag; }
    ret nil;
}

# which refusal the next read gives and at what index, 0 when it gives none
fun refusal_at(r: *Reader) usize {
    val e: res[Event, Error] = read(r);
    if (sel e.ok)                { ret 0; }
    if (sel e.err.unknown)       { ret 1000 + e.err.unknown.idx; }
    if (sel e.err.missing_value) { ret 2000 + e.err.missing_value.idx; }
    if (sel e.err.repeated)      { ret 3000 + e.err.repeated.idx; }
    ret 9999;
}

test args__cursor_walks_views {
    var v: [3]*u8   = [3]*u8{"prog", "a", "b"};
    var c: Cursor   = cursor(of(3, ?v[0]), 1);
    val a: opt[str] = next(?c);
    val b: opt[str] = next(?c);
    val d: opt[str] = next(?c);
    if (!(sel a.some && str_equals(a.some, "a"))) { ret 1; }
    if (!(sel b.some && str_equals(b.some, "b"))) { ret 2; }
    if (sel d.some)                               { ret 3; }
    ret 0;
}

test args__switch_sets {
    var v: [2]*u8 = [2]*u8{"prog", "--on"};
    var s: [3]Setting;
    var r: Reader = reader(of(2, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (expect_hit(?r) != ?F_ON) { ret 1; }
    if (!on(r, ?F_ON))           { ret 2; }
    ret 0;
}

test args__negated_switch_clears {
    var v: [2]*u8 = [2]*u8{"prog", "--no-on"};
    var s: [3]Setting;
    var r: Reader = reader(of(2, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (expect_hit(?r) != ?F_ON)          { ret 1; }
    if (!given(r, ?F_ON) || on(r, ?F_ON)) { ret 2; }
    ret 0;
}

test args__value_takes_next_argument {
    var v: [3]*u8 = [3]*u8{"prog", "--out", "--on"};
    var s: [3]Setting;
    var r: Reader = reader(of(3, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (expect_hit(?r) != ?F_OUT)              { ret 1; }
    if (!str_equals(value(r, ?F_OUT), "--on")) { ret 2; }
    ret 0;
}

test args__attached_value_follows_equals {
    var v: [2]*u8 = [2]*u8{"prog", "--log=debug"};
    var s: [3]Setting;
    var r: Reader = reader(of(2, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (expect_hit(?r) != ?F_LOG)               { ret 1; }
    if (!str_equals(value(r, ?F_LOG), "debug")) { ret 2; }
    ret 0;
}

test args__operands_keep_their_order {
    var v:    [4]*u8 = [4]*u8{"prog", "a", "-", "b"};
    var s:    [3]Setting;
    var r:    Reader = reader(of(4, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    var want: usize  = 1;
    for (want < 4) {
        val e: res[Event, Error] = read(?r);
        if (sel e.err)                                   { ret 1; }
        if (!(sel e.ok.operand && e.ok.operand == want)) { ret 2; }
        want = want + 1;
    }
    ret 0;
}

test args__double_dash_ends_options {
    var v: [3]*u8            = [3]*u8{"prog", "--", "--on"};
    var s: [3]Setting;
    var r: Reader            = reader(of(3, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    val e: res[Event, Error] = read(?r);
    if (sel e.err)                                { ret 1; }
    if (!(sel e.ok.operand && e.ok.operand == 2)) { ret 2; }
    if (separator(r) != 1 || given(r, ?F_ON))     { ret 3; }
    ret 0;
}

test args__unknown_flag_is_refused_where_it_stands {
    var v: [3]*u8 = [3]*u8{"prog", "a", "--nope"};
    var s: [3]Setting;
    var r: Reader = reader(of(3, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    read(?r);
    if (refusal_at(?r) != 1002) { ret 1; }
    ret 0;
}

test args__missing_value_is_refused_where_it_stands {
    var v: [2]*u8 = [2]*u8{"prog", "--out"};
    var s: [3]Setting;
    var r: Reader = reader(of(2, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (refusal_at(?r) != 2001) { ret 1; }
    ret 0;
}

test args__repeated_flag_is_refused_where_it_stands {
    var v: [3]*u8 = [3]*u8{"prog", "--on", "--no-on"};
    var s: [3]Setting;
    var r: Reader = reader(of(3, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    read(?r);
    if (refusal_at(?r) != 3002) { ret 1; }
    ret 0;
}
