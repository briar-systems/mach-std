# command-line arguments as views, and the engine that reads them against declared commands
#
# the process arguments are the argc and argv std.runtime hands main. this
# module borrows them and allocates nothing. on windows the runtime splits the
# wide command line by the post-2008 msvcrt rules and converts each argument to
# UTF-8, so a program reads the same argv bytes on every host. an unpaired
# surrogate, which a windows argument may hold, arrives as U+FFFD, one per code
# unit, so such an argument does not round-trip to the native name. the
# arguments as the host passed them, UTF-16 on windows and bytes elsewhere, are
# in std.runtime.native.
#
# a program declares its command line as data. FlagSpec rows are grouped in
# TableRef tables, CommandSpec and ActionSpec records compose the tables, and a
# CommandSet holds the commands with what every command shares. parse reads the
# arguments against the set into an Invocation, which records the command, its
# action, where the options ended and the first refusal. the invocation keeps no
# copy of what it read: every query reads the arguments again, so the engine
# needs no storage from the caller. std.args.help renders the same records as
# help pages, so the refusals, the relations and the help are one text.
#
# a row is spelled long, `--name`, or short, `-c` with one byte other than a
# dash. a long VALUE row takes `--name value` or `--name=value`, a long ATTACHED
# row takes `--name` or `--name=value`, and a negatable flag row also answers to
# `--no-name`. a token with one dash is a cluster of short spellings read left to
# right: a FLAG character is one occurrence and reading goes on, a VALUE or
# ATTACHED character ends the cluster and the rest of the token, verbatim, is its
# value, so `-o=x` gives `=x`. a short VALUE row with nothing left takes the next
# argument. a lone `-` is an operand, and `--` ends the options.
#
# each row states how often it may occur. a once row is refused when it occurs
# again, a collect row keeps every occurrence for values to walk, and an override
# row accepts every occurrence and answers single reads with the last. once is
# the first case, so a zeroed row is strict.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use io_writer: std.io.writer;
use std.io.writer.WriteError;
use std.io.writer.Writer;

# the process arguments, borrowed from main's argc and argv
# ---
# argc: number of arguments, the program name included
# argv: the arguments, each a null-terminated string
pub rec Args {
    argc: usize;
    argv: **u8;
}

# view main's argc and argv
# ---
# argc: number of arguments
# argv: the arguments
# ret:  the view
pub fun of(argc: usize, argv: **u8) Args {
    var a: Args;
    a.argc = argc;
    a.argv = argv;
    ret a;
}

# the number of arguments, the program name included
pub fun count(a: Args) usize {
    ret a.argc;
}

# the argument at an index
# ---
# a:   the arguments
# idx: argument index, 0 the program name
# ret: the argument, or none when the index is out of range
pub fun get(a: Args, idx: usize) opt[str] {
    if (idx >= a.argc) { ret opt[str].none{}; }
    ret opt[str].some{a.argv[idx]::str};
}

# an iterator over arguments
# ---
# args: the arguments being walked
# at:   index of the next argument
pub rec Cursor {
    args: Args;
    at:   usize;
}

# iterate arguments from an index
# ---
# a:     the arguments
# start: index of the first argument to yield, 1 to skip the program name
# ret:   the cursor
pub fun cursor(a: Args, start: usize) Cursor {
    var c: Cursor;
    c.args = a;
    c.at   = start;
    ret c;
}

# take the next argument
# ---
# c:   the cursor
# ret: the argument, or none when they are exhausted
pub fun next(c: *Cursor) opt[str] {
    val s: opt[str] = get(c.args, c.at);
    if (sel s.some) { c.at = c.at + 1; }
    ret s;
}

# how a row takes its value
pub def Arity: u8;
# the row stands alone. a negatable long row also answers to `--no-` and the rest of its name
pub val ARITY_FLAG: Arity = 0;
# the row takes a value: `--name value` or `--name=value` long, `-cvalue` or `-c value` short
pub val ARITY_VALUE: Arity = 1;
# the row takes an optional value in its own token and never the next argument: `--name` or
# `--name=value` long, `-c` or `-cvalue` short
pub val ARITY_ATTACHED: Arity = 2;

# how often a row may occur, and what a single read of it answers
# ---
# once:     a second occurrence is refused as repeated. single reads answer the occurrence
# collect:  every occurrence is kept and walked with values. single reads are refused, since one
#           occurrence cannot stand for the rest
# override: every occurrence is accepted and a later one wins. single reads answer the last, and
#           values still walks every occurrence
pub tag Occurs: u8 {
    once;
    collect;
    override;
}

# one command-line option. a row is its own identity: the engine records the canonical row an
# option matched, and a program asks for it by address
# ---
# name:      the spelling, `--name` long or `-c` short with one byte other than a dash
# value:     help placeholder for the value, empty or nil exactly for ARITY_FLAG
# arity:     how the row takes its value, an ARITY_ constant
# doc:       one-line help text, which the set's check refuses empty
# default:   help text for what applies when the row is absent, empty or nil for none
# negatable: a long flag row also answers to `--no-` and the rest of its name, and that
#            occurrence reads as off
# occurs:    how often the row may occur, read from the canonical row
# alias_of:  the canonical row this spelling stands for, recorded in its place, nil for a
#            canonical row. an alias keeps its canonical row's arity and occurrence policy
pub rec FlagSpec {
    name:      str;
    value:     str;
    arity:     Arity;
    doc:       str;
    default:   str;
    negatable: bool;
    occurs:    Occurs;
    alias_of:  *FlagSpec;
}

# one option table as a command or action composes it
# ---
# rows:     first entry of the table's row list
# n:        row count of rows
# accepted: per-row acceptance parallel to rows, or nil to accept every row. an unaccepted row is
#           unknown to the engine and absent from help
# docs:     per-row help text parallel to rows that replaces the row's own doc in this table, or
#           nil. an empty entry keeps the row's doc
pub rec TableRef {
    rows:     **FlagSpec;
    n:        usize;
    accepted: *bool;
    docs:     *str;
}

# how a relation binds its two rows
pub def RelationKind: u8;
# the two rows cannot both be given
pub val RELATION_CONFLICTS: RelationKind = 0;
# `row` is valid only when `other` is given too
pub val RELATION_REQUIRES: RelationKind = 1;
# giving `row` also gives `other`
pub val RELATION_IMPLIES: RelationKind = 2;

# one constraint between two canonical rows. parse enforces it and help renders it from
# relation_sentence, so the refusal and the help line are one text
# ---
# kind:  a RELATION_ constant
# row:   the canonical row the relation is declared on
# other: the canonical row it names
pub rec Relation {
    kind:  RelationKind;
    row:   *FlagSpec;
    other: *FlagSpec;
}

# a spelling an earlier version took, refused by name with what replaced it. it is matched
# against the whole token before anything else, so it may be any spelling, `-O2` included
# ---
# name: the spelling
# use:  what to write instead
pub rec Removed {
    name: str;
    use:  str;
}

# the code of an exit note for the codes a command forwards from another process
pub val PASSTHROUGH: i64 = -1;

# one exit code as help documents it
# ---
# code:    the process exit code, or PASSTHROUGH. a command's note on a code the set shares
#          refines that code's meaning
# meaning: what the code reports
pub rec Exit {
    code:    i64;
    meaning: str;
}

# the operand_max of a command or action that takes any number of operands
pub val OPERANDS_ANY: usize = 0xffffffff;

# one action of a command, the word after the command's own
# ---
# name:         the action word
# id:           a value the program tells its actions apart by. the engine does not read it
# grammar:      the operand grammar help appends after the action name, leading space included
# effect:       one-sentence description
# exits:        the action's own exit notes beside the set's, nil when exit_n is 0
# exit_n:       length of exits
# tables:       the action's own option tables, searched after the command's, nil when table_n is 0
# table_n:      length of tables
# relations:    relations among the action's rows, nil when relation_n is 0
# relation_n:   length of relations
# constraints:  constraint sentences for help beyond the relations, nil when constraint_n is 0
# constraint_n: length of constraints
# operand_min:  fewest operands the action takes
# operand_max:  most operands the action takes, OPERANDS_ANY for no bound
# examples:     example lines for help, nil when example_n is 0
# example_n:    length of examples
pub rec ActionSpec {
    name:         str;
    id:           usize;
    grammar:      str;
    effect:       str;
    exits:        *Exit;
    exit_n:       usize;
    tables:       *TableRef;
    table_n:      usize;
    relations:    *Relation;
    relation_n:   usize;
    constraints:  *str;
    constraint_n: usize;
    operand_min:  usize;
    operand_max:  usize;
    examples:     *str;
    example_n:    usize;
}

# one command, the whole of its registration, read by parse, by help and by the program's dispatch
# ---
# name:            the command word
# id:              a value the program dispatches on. the engine does not read it
# aliases:         alternative command words, nil when alias_n is 0
# alias_n:         length of aliases
# grammar:         the operand grammar help appends after the name, leading space included
# summary:         one-line description for the overview
# effect:          one-sentence description for the command page
# exits:           the command's own exit notes beside the set's, nil when exit_n is 0
# exit_n:          length of exits
# terminator:      help text for what follows `--`, empty or nil when the command has none
# tables:          the option tables the command accepts, nil when table_n is 0
# table_n:         length of tables
# refused:         option tables the command recognizes only to refuse as inapplicable, nil when
#                  refused_n is 0
# refused_n:       length of refused
# refusal:         why a refused option does not apply, ending the refusal, empty when refused_n is 0
# relations:       relations among the command's own rows, nil when relation_n is 0
# relation_n:      length of relations
# constraints:     constraint sentences for help beyond the relations, nil when constraint_n is 0
# constraint_n:    length of constraints
# operand_min:     fewest operands the command takes. an action's own bounds apply instead
# operand_max:     most operands the command takes, OPERANDS_ANY for no bound
# truncate_at_sep: the arguments after `--` are neither options nor operands but the command's to
#                  pass on. without it they are operands
# actions:         the actions the word after the command names, nil when action_n is 0
# action_n:        length of actions
# examples:        example lines for help, nil when example_n is 0
# example_n:       length of examples
pub rec CommandSpec {
    name:            str;
    id:              usize;
    aliases:         *str;
    alias_n:         usize;
    grammar:         str;
    summary:         str;
    effect:          str;
    exits:           *Exit;
    exit_n:          usize;
    terminator:      str;
    tables:          *TableRef;
    table_n:         usize;
    refused:         *TableRef;
    refused_n:       usize;
    refusal:         str;
    relations:       *Relation;
    relation_n:      usize;
    constraints:     *str;
    constraint_n:    usize;
    operand_min:     usize;
    operand_max:     usize;
    truncate_at_sep: bool;
    actions:         *ActionSpec;
    action_n:        usize;
    examples:        *str;
    example_n:       usize;
}

# an option given in place of a command word, read as that option given to the command that
# answers it, as `mach --version` reads as `mach info --version`
# ---
# row:     the option's canonical row
# command: the command it is given to, a member of the set that accepts row and takes no actions
pub rec Global {
    row:     *FlagSpec;
    command: *CommandSpec;
}

# the commands a program's command line is read against, in help order, and what they share
# ---
# program:    the name refusals and help spell the program by
# title:      the overview's first line
# footer:     the overview's last line, empty or nil for none
# specs:      first entry of the command list
# n:          length of specs
# help:       the member that answers a help request, rendered as the overview, or nil
# help_flag:  the canonical row whose occurrence asks for a page instead of a run, accepted by a
#             common table, or nil when the set has none
# common:     tables every command accepts before its own, as `--help` is, nil when common_n is 0
# common_n:   length of common
# relations:  relations among shared rows, in force in every schema that accepts both rows, nil
#             when relation_n is 0
# relation_n: length of relations
# removed:    spellings refused by name with their replacement, nil when removed_n is 0
# removed_n:  length of removed
# exits:      the codes every command can exit with, in ascending order, nil when exit_n is 0
# exit_n:     length of exits
# globals:    the options the command word's place may give instead, nil when global_n is 0
# global_n:   length of globals
pub rec CommandSet {
    program:    str;
    title:      str;
    footer:     str;
    specs:      **CommandSpec;
    n:          usize;
    help:       *CommandSpec;
    help_flag:  *FlagSpec;
    common:     *TableRef;
    common_n:   usize;
    relations:  *Relation;
    relation_n: usize;
    removed:    *Removed;
    removed_n:  usize;
    exits:      *Exit;
    exit_n:     usize;
    globals:    *Global;
    global_n:   usize;
}

fun empty(s: str) bool {
    ret s == nil || s[0] == 0;
}

fun is_long(name: str) bool {
    ret name != nil && name[0] == '-' && name[1] == '-' && name[2] != 0;
}

fun is_short(name: str) bool {
    ret name != nil && name[0] == '-' && name[1] != 0 && name[1] != '-' && name[2] == 0;
}

# a token that is an option: a dash and something after it. a lone `-` is an operand
fun is_flag(tok: str) bool {
    ret tok != nil && tok[0] == '-' && tok[1] != 0;
}

fun canonical(row: *FlagSpec) *FlagSpec {
    if (row.alias_of != nil) { ret row.alias_of; }
    ret row;
}

fun occurs_code(o: Occurs) u8 {
    if (sel o.collect)  { ret 1; }
    if (sel o.override) { ret 2; }
    ret 0;
}

# the command whose name or one of whose aliases is name
# ---
# set:  the commands
# name: a command word
# ret:  the command, or nil when none matches
pub fun command_for(set: *CommandSet, name: str) *CommandSpec {
    var i: usize = 0;
    for (i < set.n) {
        val command: *CommandSpec = set.specs[i];
        if (str_equals(command.name, name)) { ret command; }
        var j: usize = 0;
        for (j < command.alias_n) {
            if (str_equals(command.aliases[j], name)) { ret command; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret nil;
}

# the action of a command named name
# ---
# command: the command
# name:    an action word
# ret:     the action, or nil when the command has none of that name
pub fun action_for(command: *CommandSpec, name: str) *ActionSpec {
    var i: usize = 0;
    for (i < command.action_n) {
        if (str_equals(command.actions[i].name, name)) { ret ?command.actions[i]; }
        i = i + 1;
    }
    ret nil;
}

# the help text of the row at j of a table: the table's override, or the row's own
# ---
# t:   the table
# j:   the row index
# ret: the text
pub fun row_doc(t: *TableRef, j: usize) str {
    if (t.docs != nil && !empty(t.docs[j])) { ret t.docs[j]; }
    ret t.rows[j].doc;
}

# the tables one invocation reads against: the set's common tables, the command's, then the
# action's
rec Schema {
    set:     *CommandSet;
    command: *CommandSpec;
    action:  *ActionSpec;
}

fun group(s: Schema, g: usize, n: *usize) *TableRef {
    @n = 0;
    if (g == 0) {
        @n = s.set.common_n;
        ret s.set.common;
    }
    if (g == 1 && s.command != nil) {
        @n = s.command.table_n;
        ret s.command.tables;
    }
    if (g == 2 && s.action != nil) {
        @n = s.action.table_n;
        ret s.action.tables;
    }
    ret nil;
}

# a walk over the accepted entries of a schema's tables, in order
# ---
# schema: the schema
# g:      the group being walked, 0 common, 1 the command's, 2 the action's
# i:      the table within the group
# j:      the next entry of the table
# table:  the table of the entry last returned
# at:     its index in that table
rec Rows {
    schema: Schema;
    g:      usize;
    i:      usize;
    j:      usize;
    table:  *TableRef;
    at:     usize;
}

fun rows_of(s: Schema) Rows {
    var r: Rows;
    r.schema = s;
    ret r;
}

# the next accepted row, nil past the last
fun next_row(r: *Rows) *FlagSpec {
    for (r.g < 3) {
        var n:      usize     = 0;
        val tables: *TableRef = group(r.schema, r.g, ?n);
        if (r.i >= n) {
            r.g = r.g + 1;
            r.i = 0;
            r.j = 0;
            cnt;
        }
        val t: *TableRef = ?tables[r.i];
        if (r.j >= t.n) {
            r.i = r.i + 1;
            r.j = 0;
            cnt;
        }
        val j: usize = r.j;
        r.j = j + 1;
        if (t.accepted != nil && !t.accepted[j]) { cnt; }
        r.table = t;
        r.at    = j;
        ret t.rows[j];
    }
    ret nil;
}

fun accepts(s: Schema, row: *FlagSpec) bool {
    var r: Rows = rows_of(s);
    for {
        val got: *FlagSpec = next_row(?r);
        if (got == nil) { ret false; }
        if (got == row) { ret true; }
    }
    ret false;
}

# whether a row is an option of a command's schema: the set's common tables, the command's, and
# the action's when one is given
# ---
# set:     the commands
# command: the command
# action:  its action, or nil for the command's own tables alone
# row:     the row
# ret:     true when an accepted entry is row
pub fun schema_accepts(set: *CommandSet, command: *CommandSpec, action: *ActionSpec, row: *FlagSpec) bool {
    ret accepts(Schema{set: set, command: command, action: action}, row);
}

# whether a relation is in force in a schema: it accepts both rows
# ---
# set:     the commands
# command: the command
# action:  its action, or nil
# rel:     the relation
# ret:     true when the schema accepts both its rows
pub fun relation_active(set: *CommandSet, command: *CommandSpec, action: *ActionSpec, rel: *Relation) bool {
    ret schema_accepts(set, command, action, rel.row) && schema_accepts(set, command, action, rel.other);
}

# the sentence a relation reads as, `{row}{joint}{other}{tail}`, in its parts
pub rec Sentence {
    row:   str;
    joint: str;
    other: str;
    tail:  str;
}

# the sentence a relation reads as, both in help and in the refusal of an invocation that breaks it
# ---
# rel: the relation
# ret: its parts, all empty for RELATION_IMPLIES, which nothing breaks
pub fun relation_sentence(rel: *Relation) Sentence {
    if (rel.kind == RELATION_CONFLICTS) { ret Sentence{row: rel.row.name, joint: " and ", other: rel.other.name, tail: " cannot be combined"}; }
    if (rel.kind == RELATION_REQUIRES)  { ret Sentence{row: rel.row.name, joint: " is valid only with ", other: rel.other.name, tail: ""}; }
    ret Sentence{row: "", joint: "", other: "", tail: ""};
}

# whether name is the negated spelling of a negatable row
fun negates(row: *FlagSpec, name: str) bool {
    ret row.negatable && str_starts_with(name, "--no-") && str_equals(?name[5], ?row.name[2]);
}

# whether two rows answer to a spelling in common
fun clash(a: *FlagSpec, b: *FlagSpec) bool {
    ret str_equals(a.name, b.name) || negates(a, b.name) || negates(b, a.name);
}

# what a long token is to a row
# ---
# row:      the row it spells, nil when none
# negated:  it is the row's `--no-` spelling
# value_at: byte offset of a value after `=`, 0 when it carries none
rec Found {
    row:      *FlagSpec;
    negated:  bool;
    value_at: usize;
}

fun spelt_long(row: *FlagSpec, tok: str) Found {
    var f: Found;
    if (!is_long(row.name)) { ret f; }
    if (str_equals(tok, row.name)) {
        f.row = row;
        ret f;
    }
    if (row.arity == ARITY_FLAG) {
        if (negates(row, tok)) {
            f.row     = row;
            f.negated = true;
        }
        ret f;
    }
    val n: usize = str_len(row.name);
    if (str_starts_with(tok, row.name) && tok[n] == '=') {
        f.row      = row;
        f.value_at = n + 1;
    }
    ret f;
}

fun lookup_long(s: Schema, tok: str) Found {
    var r: Rows = rows_of(s);
    for {
        val row: *FlagSpec = next_row(?r);
        if (row == nil) { brk; }
        val f: Found = spelt_long(row, tok);
        if (f.row != nil) { ret f; }
    }
    var none: Found;
    ret none;
}

fun lookup_short(s: Schema, c: u8) *FlagSpec {
    var r: Rows = rows_of(s);
    for {
        val row: *FlagSpec = next_row(?r);
        if (row == nil)                             { ret nil; }
        if (is_short(row.name) && row.name[1] == c) { ret row; }
    }
    ret nil;
}

# whether a refused table of the command spells a long token, or with long false a short character
fun refuses(command: *CommandSpec, tok: str, c: u8, long: bool) bool {
    var i: usize = 0;
    for (i < command.refused_n) {
        val t: *TableRef = ?command.refused[i];
        var j: usize     = 0;
        for (j < t.n) {
            val row: *FlagSpec = t.rows[j];
            if (t.accepted == nil || t.accepted[j]) {
                if (long && spelt_long(row, tok).row != nil)         { ret true; }
                if (!long && is_short(row.name) && row.name[1] == c) { ret true; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

# the replacement of a removed spelling, nil when tok names none
fun removed_use(set: *CommandSet, tok: str) str {
    var i: usize = 0;
    for (i < set.removed_n) {
        if (str_equals(set.removed[i].name, tok)) { ret set.removed[i].use; }
        i = i + 1;
    }
    ret nil;
}

# where a check of a command set found it breaks the contract
# ---
# command: the command whose record breaks it, nil for the set's own fields
# action:  the action, nil when the flaw is not an action's
# row:     the row, nil when the flaw is not a row's
# why:     the rule broken, as a sentence
pub rec Malformed {
    command: *CommandSpec;
    action:  *ActionSpec;
    row:     *FlagSpec;
    why:     str;
}

fun flaw(command: *CommandSpec, action: *ActionSpec, row: *FlagSpec, why: str) opt[Malformed] {
    ret opt[Malformed].some{Malformed{command: command, action: action, row: row, why: why}};
}

fun sound() opt[Malformed] {
    ret opt[Malformed].none{};
}

# whether exit notes keep the contract: each has a meaning, a code that is PASSTHROUGH or in
# 0 to 255, and no two share a code
# ---
# notes: the notes, nil when n is 0
# n:     length of notes
# ret:   true when they do
pub fun exits_valid(notes: *Exit, n: usize) bool {
    if ((n == 0) != (notes == nil)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        val code: i64 = notes[i].code;
        if (empty(notes[i].meaning))                         { ret false; }
        if (code != PASSTHROUGH && (code < 0 || code > 255)) { ret false; }
        var j: usize = i + 1;
        for (j < n) {
            if (notes[j].code == code) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun check_tables(command: *CommandSpec, action: *ActionSpec, tables: *TableRef, n: usize) opt[Malformed] {
    if (n == 0) {
        if (tables != nil) { ret flaw(command, action, nil, "a table list is given with a count of 0"); }
        ret sound();
    }
    if (tables == nil) { ret flaw(command, action, nil, "a table count above 0 has no table list"); }
    var i: usize = 0;
    for (i < n) {
        val t: *TableRef = ?tables[i];
        if (t.rows == nil || t.n == 0) { ret flaw(command, action, nil, "a table has no rows"); }
        var j: usize = 0;
        for (j < t.n) {
            val row: *FlagSpec = t.rows[j];
            if (row == nil) { ret flaw(command, action, nil, "a table holds a nil row"); }
            if (!is_long(row.name) && !is_short(row.name)) {
                ret flaw(command, action, row, "a row is spelled neither `--` and a word nor `-` and one byte other than a dash");
            }
            if (empty(row_doc(t, j)))                                             { ret flaw(command, action, row, "a row has no help text"); }
            if (row.arity > ARITY_ATTACHED)                                       { ret flaw(command, action, row, "a row's arity is not an ARITY_ constant"); }
            if ((row.arity == ARITY_FLAG) != empty(row.value))                    { ret flaw(command, action, row, "a row has a value placeholder exactly when it takes a value"); }
            if (row.negatable && (row.arity != ARITY_FLAG || !is_long(row.name))) { ret flaw(command, action, row, "only a long flag row is negatable"); }
            val target: *FlagSpec = row.alias_of;
            if (target != nil) {
                if (target.alias_of != nil) { ret flaw(command, action, row, "an alias names another alias"); }
                if (target.arity != row.arity || occurs_code(target.occurs) != occurs_code(row.occurs)) {
                    ret flaw(command, action, row, "an alias keeps its canonical row's arity and occurrence policy");
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret sound();
}

# every accepted spelling of a schema occurs once across its tables, and every alias names a row
# the schema accepts
fun check_unambiguous(s: Schema) opt[Malformed] {
    var r: Rows = rows_of(s);
    for {
        val row: *FlagSpec = next_row(?r);
        if (row == nil) { brk; }
        var count: usize = 0;
        var o:     Rows  = rows_of(s);
        for {
            val other: *FlagSpec = next_row(?o);
            if (other == nil)      { brk; }
            if (clash(row, other)) { count = count + 1; }
        }
        if (count != 1)                                       { ret flaw(s.command, s.action, row, "a spelling occurs more than once in one command's options"); }
        if (row.alias_of != nil && !accepts(s, row.alias_of)) { ret flaw(s.command, s.action, row, "an alias names a row its command does not accept"); }
    }
    ret sound();
}

fun check_relations(s: Schema, rels: *Relation, n: usize) opt[Malformed] {
    if ((n == 0) != (rels == nil)) { ret flaw(s.command, s.action, nil, "a relation count is 0 exactly when its list is nil"); }
    var i: usize = 0;
    for (i < n) {
        val rel: *Relation = ?rels[i];
        if (rel.row == nil || rel.other == nil || rel.row == rel.other) { ret flaw(s.command, s.action, rel.row, "a relation joins two different rows"); }
        if (rel.row.alias_of != nil || rel.other.alias_of != nil)       { ret flaw(s.command, s.action, rel.row, "a relation joins canonical rows"); }
        if (rel.kind > RELATION_IMPLIES)                                { ret flaw(s.command, s.action, rel.row, "a relation's kind is not a RELATION_ constant"); }
        if (!accepts(s, rel.row) || !accepts(s, rel.other))             { ret flaw(s.command, s.action, rel.row, "a relation joins rows its schema does not accept"); }
        i = i + 1;
    }
    ret sound();
}

# the canonical row of the first row of the tables that clashes with row, nil when none does
fun clash_in(tables: *TableRef, n: usize, row: *FlagSpec) *FlagSpec {
    var i: usize = 0;
    for (i < n) {
        var j: usize = 0;
        for (j < tables[i].n) {
            if (clash(tables[i].rows[j], row)) { ret canonical(tables[i].rows[j]); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret nil;
}

# the canonical row the first table of the set that spells row's spelling gives it
fun set_meaning(set: *CommandSet, row: *FlagSpec) *FlagSpec {
    var found: *FlagSpec = clash_in(set.common, set.common_n, row);
    var i:     usize     = 0;
    for (found == nil && i < set.n) {
        val command: *CommandSpec = set.specs[i];
        i     = i + 1;
        found = clash_in(command.tables, command.table_n, row);
        if (found == nil) { found = clash_in(command.refused, command.refused_n, row); }
        var k: usize = 0;
        for (found == nil && k < command.action_n) {
            found = clash_in(command.actions[k].tables, command.actions[k].table_n, row);
            k     = k + 1;
        }
    }
    ret found;
}

# every row of the tables means what every other row of its spelling across the set means
fun check_meaning(set: *CommandSet, command: *CommandSpec, action: *ActionSpec, tables: *TableRef, n: usize) opt[Malformed] {
    var i: usize = 0;
    for (i < n) {
        var j: usize = 0;
        for (j < tables[i].n) {
            val row: *FlagSpec = tables[i].rows[j];
            if (set_meaning(set, row) != canonical(row)) { ret flaw(command, action, row, "a spelling means different rows in different commands"); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret sound();
}

fun member_of(set: *CommandSet, command: *CommandSpec) bool {
    var i: usize = 0;
    for (i < set.n) {
        if (set.specs[i] == command) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun check_set_fields(set: *CommandSet) opt[Malformed] {
    if (empty(set.program))                           { ret flaw(nil, nil, nil, "the set has no program name"); }
    if (set.n > 0 && set.specs == nil)                { ret flaw(nil, nil, nil, "a command count above 0 has no command list"); }
    if (set.help != nil && !member_of(set, set.help)) { ret flaw(set.help, nil, nil, "the help command is not a member of the set"); }
    if (!exits_valid(set.exits, set.exit_n))          { ret flaw(nil, nil, nil, "the set's exit notes break the exit contract"); }
    if ((set.removed_n == 0) != (set.removed == nil)) { ret flaw(nil, nil, nil, "a removed count is 0 exactly when its list is nil"); }
    if ((set.global_n == 0) != (set.globals == nil))  { ret flaw(nil, nil, nil, "a global count is 0 exactly when its list is nil"); }
    val common: opt[Malformed] = check_tables(nil, nil, set.common, set.common_n);
    if (sel common.some) { ret common; }
    val none: Schema         = Schema{set: set, command: nil, action: nil};
    val once: opt[Malformed] = check_unambiguous(none);
    if (sel once.some) { ret once; }
    if (set.help_flag != nil) {
        if (set.help_flag.alias_of != nil || !accepts(none, set.help_flag)) { ret flaw(nil, nil, set.help_flag, "the help flag is a canonical row of a common table"); }
    }
    if ((set.relation_n == 0) != (set.relations == nil)) { ret flaw(nil, nil, nil, "a relation count is 0 exactly when its list is nil"); }
    var i: usize = 0;
    for (i < set.relation_n) {
        val rel: *Relation = ?set.relations[i];
        if (rel.row == nil || rel.other == nil || rel.row == rel.other) { ret flaw(nil, nil, rel.row, "a relation joins two different rows"); }
        if (rel.row.alias_of != nil || rel.other.alias_of != nil)       { ret flaw(nil, nil, rel.row, "a relation joins canonical rows"); }
        if (rel.kind > RELATION_IMPLIES)                                { ret flaw(nil, nil, rel.row, "a relation's kind is not a RELATION_ constant"); }
        i = i + 1;
    }
    ret sound();
}

# the tables of a command and its actions hold well-formed rows, which every other check reads
fun check_structure(command: *CommandSpec) opt[Malformed] {
    if ((command.action_n == 0) != (command.actions == nil)) { ret flaw(command, nil, nil, "an action count is 0 exactly when its list is nil"); }
    val tables: opt[Malformed] = check_tables(command, nil, command.tables, command.table_n);
    if (sel tables.some) { ret tables; }
    val refused: opt[Malformed] = check_tables(command, nil, command.refused, command.refused_n);
    if (sel refused.some) { ret refused; }
    var k: usize = 0;
    for (k < command.action_n) {
        val action: *ActionSpec    = ?command.actions[k];
        val own:    opt[Malformed] = check_tables(command, action, action.tables, action.table_n);
        if (sel own.some) { ret own; }
        k = k + 1;
    }
    ret sound();
}

fun check_command(set: *CommandSet, command: *CommandSpec) opt[Malformed] {
    if (empty(command.name) || empty(command.summary) || empty(command.effect)) { ret flaw(command, nil, nil, "a command has a name, a summary and an effect"); }
    if (!exits_valid(command.exits, command.exit_n))                            { ret flaw(command, nil, nil, "a command's exit notes break the exit contract"); }
    if ((command.alias_n == 0) != (command.aliases == nil))                     { ret flaw(command, nil, nil, "an alias count is 0 exactly when its list is nil"); }
    if ((command.constraint_n == 0) != (command.constraints == nil))            { ret flaw(command, nil, nil, "a constraint count is 0 exactly when its list is nil"); }
    if ((command.example_n == 0) != (command.examples == nil))                  { ret flaw(command, nil, nil, "an example count is 0 exactly when its list is nil"); }
    if ((command.action_n == 0) != (command.actions == nil))                    { ret flaw(command, nil, nil, "an action count is 0 exactly when its list is nil"); }
    if ((command.refused_n == 0) != empty(command.refusal))                     { ret flaw(command, nil, nil, "a command with refused tables says why they do not apply"); }
    if (command.operand_min > command.operand_max)                              { ret flaw(command, nil, nil, "a command's operand bounds are out of order"); }
    if (command_for(set, command.name) != command)                              { ret flaw(command, nil, nil, "two commands share a word"); }
    var ai: usize = 0;
    for (ai < command.alias_n) {
        if (empty(command.aliases[ai]) || command_for(set, command.aliases[ai]) != command) { ret flaw(command, nil, nil, "a command alias is empty or another command's word"); }
        var j: usize = 0;
        for (j < set.n) {
            if (set.specs[j] != command && str_equals(set.specs[j].name, command.aliases[ai])) { ret flaw(command, nil, nil, "a command alias is another command's word"); }
            j = j + 1;
        }
        ai = ai + 1;
    }
    val s:    Schema         = Schema{set: set, command: command, action: nil};
    val once: opt[Malformed] = check_unambiguous(s);
    if (sel once.some) { ret once; }
    val rels: opt[Malformed] = check_relations(s, command.relations, command.relation_n);
    if (sel rels.some) { ret rels; }
    var i: usize = 0;
    for (i < command.refused_n) {
        var j: usize = 0;
        for (j < command.refused[i].n) {
            val row: *FlagSpec = command.refused[i].rows[j];
            if (clash_in(command.tables, command.table_n, row) != nil) { ret flaw(command, nil, row, "a refused row is also accepted"); }
            j = j + 1;
        }
        i = i + 1;
    }
    var k: usize = 0;
    for (k < command.action_n) {
        val action: *ActionSpec = ?command.actions[k];
        if (empty(action.name) || empty(action.effect))                { ret flaw(command, action, nil, "an action has a name and an effect"); }
        if (action_for(command, action.name) != action)                { ret flaw(command, action, nil, "two actions of a command share a word"); }
        if (!exits_valid(action.exits, action.exit_n))                 { ret flaw(command, action, nil, "an action's exit notes break the exit contract"); }
        if ((action.constraint_n == 0) != (action.constraints == nil)) { ret flaw(command, action, nil, "a constraint count is 0 exactly when its list is nil"); }
        if ((action.example_n == 0) != (action.examples == nil))       { ret flaw(command, action, nil, "an example count is 0 exactly when its list is nil"); }
        if (action.operand_min > action.operand_max)                   { ret flaw(command, action, nil, "an action's operand bounds are out of order"); }
        val sa:    Schema         = Schema{set: set, command: command, action: action};
        val whole: opt[Malformed] = check_unambiguous(sa);
        if (sel whole.some) { ret whole; }
        val ar: opt[Malformed] = check_relations(sa, action.relations, action.relation_n);
        if (sel ar.some) { ret ar; }
        val am: opt[Malformed] = check_meaning(set, command, action, action.tables, action.table_n);
        if (sel am.some) { ret am; }
        k = k + 1;
    }
    val cm: opt[Malformed] = check_meaning(set, command, nil, command.tables, command.table_n);
    if (sel cm.some) { ret cm; }
    ret check_meaning(set, command, nil, command.refused, command.refused_n);
}

# whether a spelling is answered by some row of the set
fun spelled_in_set(set: *CommandSet, name: str) bool {
    var probe: FlagSpec;
    probe.name = name;
    ret set_meaning(set, ?probe) != nil;
}

# check a command set against the contract parse and help rely on. every command and action has
# a name and a summary or effect, exit notes that keep exits_valid, and operand bounds in order.
# each count is 0 exactly when its list is nil. every row is spelled long or short, has help text
# in its table, a value placeholder exactly when it takes a value, and negates only as a long
# flag. an alias names a canonical row its schema accepts and keeps that row's arity and policy.
# command words and aliases are unique across the set and action words within their command.
# every spelling, a negated one included, occurs once in each schema, the common tables joined to
# the command's and to each action's. a relation joins two canonical rows of its schema, no
# refused row is also accepted, and one canonical row stands behind each spelling across the
# whole set. the help command is a member, the help flag a canonical row of a common table, a
# removed spelling no row answers to, and each global a canonical row its command accepts, that
# command a member without actions and the row spelled by no command word
# ---
# set: the commands
# ret: the first flaw found, or none when the set keeps the contract
pub fun check(set: *CommandSet) opt[Malformed] {
    val fields: opt[Malformed] = check_set_fields(set);
    if (sel fields.some) { ret fields; }
    var i: usize = 0;
    for (i < set.n) {
        val command: *CommandSpec = set.specs[i];
        if (command == nil) { ret flaw(nil, nil, nil, "the command list holds a nil command"); }
        var j: usize = i + 1;
        for (j < set.n) {
            if (set.specs[j] == command) { ret flaw(command, nil, nil, "a command is listed twice"); }
            j = j + 1;
        }
        val c: opt[Malformed] = check_structure(command);
        if (sel c.some) { ret c; }
        i = i + 1;
    }
    i = 0;
    for (i < set.n) {
        val c: opt[Malformed] = check_command(set, set.specs[i]);
        if (sel c.some) { ret c; }
        i = i + 1;
    }
    val common: opt[Malformed] = check_meaning(set, nil, nil, set.common, set.common_n);
    if (sel common.some) { ret common; }
    var r: usize = 0;
    for (r < set.removed_n) {
        val gone: *Removed = ?set.removed[r];
        if (!is_flag(gone.name) || empty(gone.use)) { ret flaw(nil, nil, nil, "a removed spelling is an option with a replacement"); }
        if (spelled_in_set(set, gone.name))         { ret flaw(nil, nil, nil, "a removed spelling is answered by a row"); }
        r = r + 1;
    }
    var g: usize = 0;
    for (g < set.global_n) {
        val gl: *Global = ?set.globals[g];
        if (gl.row == nil || gl.command == nil || gl.row.alias_of != nil) { ret flaw(gl.command, nil, gl.row, "a global is a canonical row and its command"); }
        if (!member_of(set, gl.command) || gl.command.action_n > 0)       { ret flaw(gl.command, nil, gl.row, "a global's command is a member without actions"); }
        if (!schema_accepts(set, gl.command, nil, gl.row))                { ret flaw(gl.command, nil, gl.row, "a global's command does not accept its row"); }
        if (command_for(set, gl.row.name) != nil)                         { ret flaw(gl.command, nil, gl.row, "a global is spelled as a command word"); }
        g = g + 1;
    }
    ret sound();
}

# whether a command set keeps the contract check states
pub fun schema_valid(set: *CommandSet) bool {
    val c: opt[Malformed] = check(set);
    ret sel c.none;
}

# where a token was refused
# ---
# idx: argument index of the token
# at:  byte offset of the refused character in a short cluster, 0 for the whole token
# tok: the token
pub rec Refused {
    idx: usize;
    at:  usize;
    tok: str;
}

# why a command line was refused
# ---
# malformed:       the set breaks the contract check states, whatever the arguments are
# unknown_command: the command word names no command and no global
# unknown_action:  the word after the command names none of its actions
# missing_action:  the command takes an action and none was given, by the index it was wanted at
# unknown:         an option names no row of the schema
# inapplicable:    an option names a row the command refuses
# removed:         an option is a removed spelling
# missing_value:   a VALUE option ends the line with no value after it
# repeated:        a once row occurs again
# relation:        a relation is broken
# operands:        the operand count is outside the bounds, by the count given
pub tag Refusal: u8 {
    malformed:       Malformed;
    unknown_command: Refused;
    unknown_action:  Refused;
    missing_action:  usize;
    unknown:         Refused;
    inapplicable:    Refused;
    removed:         Refused;
    missing_value:   Refused;
    repeated:        Refused;
    relation:        *Relation;
    operands:        usize;
}

# a command line read against a command set. it holds no copy of the arguments, which every
# query reads again, so the arguments and the set outlive it
# ---
# args:    the arguments
# set:     the commands
# command: the command read, or nil when no command word was given or it was refused
# action:  the action read, or nil
# start:   index of the first argument read against the schema, after the command and action
# sep:     index of the `--` that ended the options, the argument count when none did
# refusal: the first way the line breaks the schema, none when it keeps it. a malformed set, an
#          unknown command and an unknown action come first. a help request withdraws every
#          other refusal, since the line then asks for a page. a missing action comes next, then
#          the first refused option, missing value or repeat in argument order, then a broken
#          relation, then an operand count outside the bounds
pub rec Invocation {
    args:    Args;
    set:     *CommandSet;
    command: *CommandSpec;
    action:  *ActionSpec;
    start:   usize;
    sep:     usize;
    refusal: opt[Refusal];
}

# what one option was given
# ---
# flag:    the canonical row the option names, whichever spelling was given
# spelled: the row whose spelling matched, flag unless an alias matched
# idx:     argument index of the option
# at:      byte offset of its character in a short cluster, 0 for a long option
# on:      false only for a negated flag
# value:   the value given, nil when none was
pub rec Hit {
    flag:    *FlagSpec;
    spelled: *FlagSpec;
    idx:     usize;
    at:      usize;
    on:      bool;
    value:   str;
}

# a scan of an invocation's arguments
# ---
# schema:   the tables it reads against
# args:     the arguments
# at:       index of the next argument
# cl:       offset of the next character of the short cluster in argument cl_idx, 0 when none
# cl_idx:   the argument the cluster is in
# ended:    a `--` ended the options
# sep:      index of that `--`, the argument count when none
# truncate: the arguments after `--` are left out
rec Scan {
    schema:   Schema;
    args:     Args;
    at:       usize;
    cl:       usize;
    cl_idx:   usize;
    ended:    bool;
    sep:      usize;
    truncate: bool;
}

# one step of a scan
# ---
# bare: a VALUE option with nothing after it, still an occurrence
tag Step: u8 {
    done;
    operand:      usize;
    hit:          Hit;
    bare:         Hit;
    unknown:      Refused;
    inapplicable: Refused;
    removed:      Refused;
}

fun scan_of(inv: *Invocation) Scan {
    var s: Scan;
    s.schema   = Schema{set: inv.set, command: inv.command, action: inv.action};
    s.args     = inv.args;
    s.at       = inv.start;
    s.sep      = inv.args.argc;
    s.truncate = inv.command != nil && inv.command.truncate_at_sep;
    if (inv.command == nil) { s.at = inv.args.argc; }
    ret s;
}

fun take_next(s: *Scan, h: Hit) Step {
    var hit: Hit = h;
    if (hit.spelled.arity != ARITY_VALUE) { ret Step.hit{hit}; }
    if (s.at >= s.args.argc)              { ret Step.bare{hit}; }
    hit.value = s.args.argv[s.at]::str;
    s.at      = s.at + 1;
    ret Step.hit{hit};
}

fun cluster(s: *Scan, idx: usize, at: usize) Step {
    val tok: str = s.args.argv[idx]::str;
    s.cl = 0;
    val row: *FlagSpec = lookup_short(s.schema, tok[at]);
    if (row == nil) {
        val where: Refused = Refused{idx: idx, at: at, tok: tok};
        if (refuses(s.schema.command, tok, tok[at], false)) { ret Step.inapplicable{where}; }
        ret Step.unknown{where};
    }
    var hit: Hit = Hit{flag: canonical(row), spelled: row, idx: idx, at: at, on: true, value: nil};
    if (tok[at + 1] == 0) { ret take_next(s, hit); }
    if (row.arity == ARITY_FLAG) {
        s.cl     = at + 1;
        s.cl_idx = idx;
        ret Step.hit{hit};
    }
    hit.value = ?tok[at + 1];
    ret Step.hit{hit};
}

fun step_of(s: *Scan) Step {
    for {
        if (s.cl != 0)           { ret cluster(s, s.cl_idx, s.cl); }
        if (s.at >= s.args.argc) { ret Step.done{}; }
        val idx: usize = s.at;
        s.at = idx + 1;
        val tok: str = s.args.argv[idx]::str;
        if (s.ended || !is_flag(tok)) { ret Step.operand{idx}; }
        if (str_equals(tok, "--")) {
            s.ended = true;
            s.sep   = idx;
            if (s.truncate) { s.at = s.args.argc; }
            cnt;
        }
        val where: Refused = Refused{idx: idx, at: 0, tok: tok};
        if (removed_use(s.schema.set, tok) != nil) { ret Step.removed{where}; }
        if (tok[1] != '-')                         { ret cluster(s, idx, 1); }
        val f: Found = lookup_long(s.schema, tok);
        if (f.row == nil) {
            if (refuses(s.schema.command, tok, 0, true)) { ret Step.inapplicable{where}; }
            ret Step.unknown{where};
        }
        var hit: Hit = Hit{flag: canonical(f.row), spelled: f.row, idx: idx, at: 0, on: !f.negated, value: nil};
        if (f.value_at > 0) {
            hit.value = ?tok[f.value_at];
            ret Step.hit{hit};
        }
        ret take_next(s, hit);
    }
    ret Step.done{};
}

# the next occurrence of any row, a bare one included, skipping operands and refused tokens
fun next_hit(s: *Scan) opt[Hit] {
    for {
        val st: Step = step_of(s);
        if (sel st.done) { ret opt[Hit].none{}; }
        if (sel st.hit)  { ret opt[Hit].some{st.hit}; }
        if (sel st.bare) { ret opt[Hit].some{st.bare}; }
    }
    ret opt[Hit].none{};
}

fun blank(set: *CommandSet, a: Args) Invocation {
    var inv: Invocation;
    inv.args    = a;
    inv.set     = set;
    inv.start   = a.argc;
    inv.sep     = a.argc;
    inv.refusal = opt[Refusal].none{};
    ret inv;
}

fun refuse(inv: *Invocation, r: Refusal) {
    val first: bool = sel inv.refusal.none;
    if (first) { inv.refusal = opt[Refusal].some{r}; }
}

# whether a once row occurred before this occurrence of it
fun repeated(inv: *Invocation, h: Hit) bool {
    if (!(sel h.flag.occurs.once)) { ret false; }
    var s: Scan = scan_of(inv);
    for {
        val got: opt[Hit] = next_hit(?s);
        if (sel got.none)                                 { ret false; }
        if (got.some.idx == h.idx && got.some.at == h.at) { ret false; }
        if (got.some.flag == h.flag)                      { ret true; }
    }
    ret false;
}

fun spot(inv: *Invocation, h: Hit) Refused {
    ret Refused{idx: h.idx, at: h.at, tok: inv.args.argv[h.idx]::str};
}

# refuse the first broken relation of a list, true when one was
fun refuse_relations(inv: *Invocation, rels: *Relation, n: usize, shared: bool) bool {
    var i: usize = 0;
    for (i < n) {
        val rel: *Relation = ?rels[i];
        i = i + 1;
        if (rel.kind == RELATION_IMPLIES)                                      { cnt; }
        if (shared && !relation_active(inv.set, inv.command, inv.action, rel)) { cnt; }
        val both:   bool = occurred(inv, rel.row) && occurred(inv, rel.other);
        val orphan: bool = occurred(inv, rel.row) && !given(inv, rel.other);
        if ((rel.kind == RELATION_CONFLICTS && both) || (rel.kind == RELATION_REQUIRES && orphan)) {
            refuse(inv, Refusal.relation{rel});
            ret true;
        }
    }
    ret false;
}

# read the arguments from first against a command: its action word when it takes actions, then
# every argument to the end
fun read(inv: *Invocation, command: *CommandSpec, first: usize) {
    inv.command = command;
    inv.start   = first;
    var missing: bool = false;
    if (command.action_n > 0) {
        var word: str = nil;
        if (first < inv.args.argc)        { word = inv.args.argv[first]::str; }
        if (word == nil || is_flag(word)) { missing = true; }
        or {
            inv.action = action_for(command, word);
            if (inv.action == nil) {
                refuse(inv, Refusal.unknown_action{Refused{idx: first, at: 0, tok: word}});
                ret;
            }
            inv.start = first + 1;
        }
    }
    var operands: usize = 0;
    var s:        Scan  = scan_of(inv);
    for {
        val st: Step = step_of(?s);
        if (sel st.done)    { brk; }
        if (sel st.operand) { operands = operands + 1; }
        or (sel st.hit) {
            if (repeated(inv, st.hit)) { refuse(inv, Refusal.repeated{spot(inv, st.hit)}); }
        }
        or (sel st.bare) {
            if (repeated(inv, st.bare)) { refuse(inv, Refusal.repeated{spot(inv, st.bare)}); }
            refuse(inv, Refusal.missing_value{spot(inv, st.bare)});
        }
        or (sel st.unknown)      { refuse(inv, Refusal.unknown{st.unknown}); }
        or (sel st.inapplicable) { refuse(inv, Refusal.inapplicable{st.inapplicable}); }
        or (sel st.removed)      { refuse(inv, Refusal.removed{st.removed}); }
    }
    inv.sep = s.sep;
    if (help_requested(inv)) {
        inv.refusal = opt[Refusal].none{};
        ret;
    }
    if (missing) {
        inv.refusal = opt[Refusal].some{Refusal.missing_action{first}};
        ret;
    }
    if (sel inv.refusal.some)                                                                           { ret; }
    if (refuse_relations(inv, inv.set.relations, inv.set.relation_n, true))                             { ret; }
    if (refuse_relations(inv, command.relations, command.relation_n, false))                            { ret; }
    if (inv.action != nil && refuse_relations(inv, inv.action.relations, inv.action.relation_n, false)) { ret; }
    var lo: usize = command.operand_min;
    var hi: usize = command.operand_max;
    if (inv.action != nil) {
        lo = inv.action.operand_min;
        hi = inv.action.operand_max;
    }
    if (operands < lo || operands > hi) { refuse(inv, Refusal.operands{operands}); }
}

# the command a global of the set spelled tok stands in for, nil when tok spells none
fun global_for(set: *CommandSet, tok: str) *CommandSpec {
    var i: usize = 0;
    for (i < set.global_n) {
        val g: *Global = ?set.globals[i];
        val s: Schema  = Schema{set: set, command: g.command, action: nil};
        if (is_short(tok)) {
            val row: *FlagSpec = lookup_short(s, tok[1]);
            if (row != nil && canonical(row) == g.row) { ret g.command; }
        }
        val f: Found = lookup_long(s, tok);
        if (f.row != nil && canonical(f.row) == g.row && f.value_at == 0) { ret g.command; }
        i = i + 1;
    }
    ret nil;
}

# read a command line against a command set: the command word at an index, which may instead be
# a global of the set, then the command's action and arguments
# ---
# set: the commands, which outlive the invocation
# a:   the arguments, which outlive the invocation
# at:  index of the command word, 1 after the program name
# ret: the invocation. its command is nil when no word is at the index, and its refusal names a
#      malformed set or an unknown word
pub fun parse(set: *CommandSet, a: Args, at: usize) Invocation {
    var inv: Invocation     = blank(set, a);
    val bad: opt[Malformed] = check(set);
    if (sel bad.some) {
        refuse(?inv, Refusal.malformed{bad.some});
        ret inv;
    }
    if (at >= a.argc) { ret inv; }
    val word:    str          = a.argv[at]::str;
    var command: *CommandSpec = command_for(set, word);
    var first:   usize        = at + 1;
    if (command == nil) {
        command = global_for(set, word);
        first   = at;
    }
    if (command == nil) {
        refuse(?inv, Refusal.unknown_command{Refused{idx: at, at: 0, tok: word}});
        ret inv;
    }
    read(?inv, command, first);
    ret inv;
}

# read a command line against one command of a set, its action word or first argument at an index
# ---
# set:     the commands, which outlive the invocation
# command: a member of the set
# a:       the arguments, which outlive the invocation
# at:      index of the action word or first argument, 2 after a command word
# ret:     the invocation
pub fun parse_command(set: *CommandSet, command: *CommandSpec, a: Args, at: usize) Invocation {
    var inv: Invocation     = blank(set, a);
    val bad: opt[Malformed] = check(set);
    if (sel bad.some) {
        refuse(?inv, Refusal.malformed{bad.some});
        ret inv;
    }
    if (!member_of(set, command)) {
        refuse(?inv, Refusal.malformed{Malformed{command: command, action: nil, row: nil, why: "the command read is not a member of the set"}});
        ret inv;
    }
    read(?inv, command, at);
    ret inv;
}

# whether a row occurred, under any of its spellings
# ---
# inv: the invocation
# row: a canonical row
# ret: true when some occurrence names it
pub fun occurred(inv: *Invocation, row: *FlagSpec) bool {
    var s: Scan = scan_of(inv);
    for {
        val got: opt[Hit] = next_hit(?s);
        if (sel got.none)         { ret false; }
        if (got.some.flag == row) { ret true; }
    }
    ret false;
}

# how many times a row occurred, under any of its spellings
pub fun occurrences(inv: *Invocation, row: *FlagSpec) usize {
    var n: usize = 0;
    var s: Scan  = scan_of(inv);
    for {
        val got: opt[Hit] = next_hit(?s);
        if (sel got.none)         { brk; }
        if (got.some.flag == row) { n = n + 1; }
    }
    ret n;
}

fun implied_by(inv: *Invocation, rels: *Relation, n: usize, row: *FlagSpec, shared: bool) bool {
    var i: usize = 0;
    for (i < n) {
        val rel: *Relation = ?rels[i];
        i = i + 1;
        if (rel.kind != RELATION_IMPLIES || rel.other != row)                  { cnt; }
        if (shared && !relation_active(inv.set, inv.command, inv.action, rel)) { cnt; }
        if (occurred(inv, rel.row))                                            { ret true; }
    }
    ret false;
}

# whether a row was given: it occurred, or a row that implies it did
# ---
# inv: the invocation
# row: a canonical row
# ret: true when given
pub fun given(inv: *Invocation, row: *FlagSpec) bool {
    if (occurred(inv, row))                                                         { ret true; }
    if (inv.command == nil)                                                         { ret false; }
    if (implied_by(inv, inv.set.relations, inv.set.relation_n, row, true))          { ret true; }
    if (implied_by(inv, inv.command.relations, inv.command.relation_n, row, false)) { ret true; }
    ret inv.action != nil && implied_by(inv, inv.action.relations, inv.action.relation_n, row, false);
}

# whether the invocation asks for a page rather than a run: the set's help flag occurred
pub fun help_requested(inv: *Invocation) bool {
    ret inv.set.help_flag != nil && occurred(inv, inv.set.help_flag);
}

# the index of the `--` that ended the options, or the argument count when none did
pub fun separator(inv: *Invocation) usize {
    ret inv.sep;
}

# why a row could not be read
# ---
# unlisted:  the invocation's schema does not accept the row
# repeating: the row collects, so one occurrence cannot answer for it. its occurrences are read
#            with values
pub tag Misread: u8 {
    unlisted:  *FlagSpec;
    repeating: *FlagSpec;
}

fun listed(inv: *Invocation, row: *FlagSpec) bool {
    ret inv.command != nil && accepts(Schema{set: inv.set, command: inv.command, action: inv.action}, row);
}

# the occurrence a single read of a row answers: the only one of a once row, the last of an
# override row
# ---
# inv: the invocation
# row: a canonical row of its schema
# ret: the occurrence, none when the row did not occur, or refused when the row is not in the
#      schema or collects
pub fun latest(inv: *Invocation, row: *FlagSpec) res[opt[Hit], Misread] {
    if (!listed(inv, row))      { ret res[opt[Hit], Misread].err{Misread.unlisted{row}}; }
    if (sel row.occurs.collect) { ret res[opt[Hit], Misread].err{Misread.repeating{row}}; }
    var last: opt[Hit] = opt[Hit].none{};
    var s:    Scan     = scan_of(inv);
    for {
        val got: opt[Hit] = next_hit(?s);
        if (sel got.none)         { brk; }
        if (got.some.flag == row) { last = got; }
    }
    ret res[opt[Hit], Misread].ok{last};
}

# whether a flag is on: its latest occurrence was not negated, or a row that implies it occurred
# ---
# inv: the invocation
# row: a canonical row of its schema
# ret: whether it is on, or refused as latest refuses
pub fun on(inv: *Invocation, row: *FlagSpec) res[bool, Misread] {
    val l: res[opt[Hit], Misread] = latest(inv, row);
    if (sel l.err)     { ret res[bool, Misread].err{l.err}; }
    if (sel l.ok.some) { ret res[bool, Misread].ok{l.ok.some.on}; }
    ret res[bool, Misread].ok{given(inv, row)};
}

# the value a row was given, the last one for an override row
# ---
# inv: the invocation
# row: a canonical row of its schema
# ret: the value, nil when it had none or did not occur, or refused as latest refuses
pub fun value(inv: *Invocation, row: *FlagSpec) res[str, Misread] {
    val l: res[opt[Hit], Misread] = latest(inv, row);
    if (sel l.err)     { ret res[str, Misread].err{l.err}; }
    if (sel l.ok.some) { ret res[str, Misread].ok{l.ok.some.value}; }
    ret res[str, Misread].ok{nil};
}

# a walk over one row's occurrences, in argument order
# ---
# scan: the scan of the invocation's arguments
# flag: the canonical row walked
pub rec Values {
    scan: Scan;
    flag: *FlagSpec;
}

# walk a row's occurrences, each as the line gave it, a bare one with a nil value. this is how a
# collect row is read, and any row of the schema may be walked
# ---
# inv: the invocation
# row: a canonical row of its schema
# ret: the walk, or refused when the row is not in the schema
pub fun values(inv: *Invocation, row: *FlagSpec) res[Values, Misread] {
    if (!listed(inv, row)) { ret res[Values, Misread].err{Misread.unlisted{row}}; }
    ret res[Values, Misread].ok{Values{scan: scan_of(inv), flag: row}};
}

# take the row's next occurrence
# ---
# w:   the walk
# ret: the occurrence, or none when the row occurs no more
pub fun next_value(w: *Values) opt[Hit] {
    for {
        val got: opt[Hit] = next_hit(?w.scan);
        if (sel got.none)            { ret got; }
        if (got.some.flag == w.flag) { ret got; }
    }
    ret opt[Hit].none{};
}

# one step of a command line, in argument order
# ---
# done:    no arguments remain
# operand: an operand, by argument index
# hit:     an option, a VALUE option with nothing after it giving a nil value
pub tag Event: u8 {
    done;
    operand: usize;
    hit:     Hit;
}

# a walk over an invocation's operands and options in argument order, for a program whose
# options apply where they stand among its operands. refused tokens are skipped
pub rec Walk {
    scan: Scan;
}

# walk an invocation
pub fun walk(inv: *Invocation) Walk {
    ret Walk{scan: scan_of(inv)};
}

# take the next event of a walk
pub fun step(w: *Walk) Event {
    for {
        val st: Step = step_of(?w.scan);
        if (sel st.done)    { ret Event.done{}; }
        if (sel st.operand) { ret Event.operand{st.operand}; }
        if (sel st.hit)     { ret Event.hit{st.hit}; }
        if (sel st.bare)    { ret Event.hit{st.bare}; }
    }
    ret Event.done{};
}

# the number of operands the invocation was given
pub fun operand_count(inv: *Invocation) usize {
    var n: usize = 0;
    var w: Walk  = walk(inv);
    for {
        val e: Event = step(?w);
        if (sel e.done)    { brk; }
        if (sel e.operand) { n = n + 1; }
    }
    ret n;
}

# the argument index of an operand
# ---
# inv: the invocation
# n:   the operand's position among the operands, 0 the first
# ret: its argument index, or none when there are not that many
pub fun operand(inv: *Invocation, n: usize) opt[usize] {
    var k: usize = 0;
    var w: Walk  = walk(inv);
    for {
        val e: Event = step(?w);
        if (sel e.done) { brk; }
        if (sel e.operand) {
            if (k == n) { ret opt[usize].some{e.operand}; }
            k = k + 1;
        }
    }
    ret opt[usize].none{};
}

# a writer that keeps its first failure, so text is written without a test per piece
rec Out {
    w:      *Writer;
    failed: bool;
    error:  WriteError;
}

fun put(o: *Out, s: str) {
    if (o.failed || empty(s)) { ret; }
    val r: err[WriteError] = io_writer.write_str(o.w, s);
    if (sel r.err) {
        o.failed = true;
        o.error  = r.err;
    }
}

fun put_byte(o: *Out, c: u8) {
    var b: [2]u8;
    b[0] = c;
    put(o, (?b[0])::str);
}

fun finish(o: *Out) err[WriteError] {
    if (o.failed) { ret err[WriteError].err{o.error}; }
    ret err[WriteError].ok{};
}

# the option a refusal names: the cluster character, and the token it stands in when there is more
fun put_option(o: *Out, r: Refused) {
    put(o, "'");
    if (r.at == 0) { put(o, r.tok); }
    or {
        put_byte(o, '-');
        put_byte(o, r.tok[r.at]);
        if (r.tok[2] != 0) {
            put(o, "' in '");
            put(o, r.tok);
        }
    }
    put(o, "'");
}

fun put_usage(o: *Out, inv: *Invocation) {
    put(o, inv.set.program);
    put(o, " ");
    put(o, inv.command.name);
    if (inv.action != nil) {
        put(o, " ");
        put(o, inv.action.name);
    }
}

fun put_actions(o: *Out, command: *CommandSpec) {
    var i: usize = 0;
    for (i < command.action_n) {
        if (i > 0) { put(o, ", "); }
        put(o, command.actions[i].name);
        i = i + 1;
    }
}

# write a refusal's message, the sentence a program reports it with, without a trailing newline
# ---
# inv: the invocation
# w:   where the message is written
# ret: ok, nothing written when the invocation has no refusal, or the write that failed
pub fun describe(inv: *Invocation, w: *Writer) err[WriteError] {
    var o: Out;
    o.w = w;
    if (sel inv.refusal.none) { ret finish(?o); }
    val r: Refusal = inv.refusal.some;
    if (sel r.malformed) {
        put(?o, "malformed command table: ");
        put(?o, r.malformed.why);
        if (r.malformed.command != nil) {
            put(?o, " (command '");
            put(?o, r.malformed.command.name);
            put(?o, "')");
        }
        if (r.malformed.action != nil) {
            put(?o, " (action '");
            put(?o, r.malformed.action.name);
            put(?o, "')");
        }
        if (r.malformed.row != nil) {
            put(?o, " (row '");
            put(?o, r.malformed.row.name);
            put(?o, "')");
        }
    }
    or (sel r.unknown_command) {
        put(?o, "unknown command '");
        put(?o, r.unknown_command.tok);
        put(?o, "'");
    }
    or (sel r.unknown_action) {
        put(?o, "unknown ");
        put(?o, inv.command.name);
        put(?o, " action '");
        put(?o, r.unknown_action.tok);
        put(?o, "'; the actions are ");
        put_actions(?o, inv.command);
    }
    or (sel r.missing_action) {
        put(?o, "missing ");
        put(?o, inv.command.name);
        put(?o, " action; the actions are ");
        put_actions(?o, inv.command);
    }
    or (sel r.unknown) {
        put(?o, "unknown flag ");
        put_option(?o, r.unknown);
        put(?o, " for '");
        put_usage(?o, inv);
        put(?o, "'");
    }
    or (sel r.inapplicable) {
        put(?o, "option ");
        put_option(?o, r.inapplicable);
        put(?o, " is not applicable to '");
        put(?o, inv.command.name);
        put(?o, "'; ");
        put(?o, inv.command.refusal);
    }
    or (sel r.removed) {
        put(?o, "option '");
        put(?o, r.removed.tok);
        put(?o, "' was removed; use ");
        put(?o, removed_use(inv.set, r.removed.tok));
    }
    or (sel r.missing_value) {
        put(?o, "option ");
        put_option(?o, r.missing_value);
        put(?o, " for '");
        put_usage(?o, inv);
        put(?o, "' requires a value");
    }
    or (sel r.repeated) {
        put(?o, "option ");
        put_option(?o, r.repeated);
        put(?o, " for '");
        put_usage(?o, inv);
        put(?o, "' cannot be repeated");
    }
    or (sel r.relation) {
        val said: Sentence = relation_sentence(r.relation);
        put(?o, said.row);
        put(?o, said.joint);
        put(?o, said.other);
        put(?o, said.tail);
    }
    or (sel r.operands) {
        put(?o, "usage: ");
        put_usage(?o, inv);
        if (inv.action != nil) { put(?o, inv.action.grammar); }
        or                     { put(?o, inv.command.grammar); }
    }
    ret finish(?o);
}

val F_ON:       FlagSpec = FlagSpec{name: "--on", value: "", arity: ARITY_FLAG, doc: "turn it on", default: "", negatable: true, occurs: Occurs.once{}, alias_of: nil};
val F_ON_SHORT: FlagSpec = FlagSpec{name: "-o", value: "", arity: ARITY_FLAG, doc: "turn it on", default: "", negatable: false, occurs: Occurs.once{}, alias_of: ?F_ON};
val F_OUT:      FlagSpec = FlagSpec{name: "--out", value: "path", arity: ARITY_VALUE, doc: "write here", default: "", negatable: false, occurs: Occurs.once{}, alias_of: nil};
val F_LOG:      FlagSpec = FlagSpec{name: "--log", value: "level", arity: ARITY_ATTACHED, doc: "log at a level", default: "", negatable: false, occurs: Occurs.once{}, alias_of: nil};

val TABLE: [4]*FlagSpec = [4]*FlagSpec{?F_ON, ?F_ON_SHORT, ?F_OUT, ?F_LOG};

val F_EXT:        FlagSpec = FlagSpec{name: "--ext", value: "name", arity: ARITY_ATTACHED, doc: "an extension", default: "", negatable: false, occurs: Occurs.collect{}, alias_of: nil};
val F_EXT_SHORT:  FlagSpec = FlagSpec{name: "-e", value: "name", arity: ARITY_ATTACHED, doc: "an extension", default: "", negatable: false, occurs: Occurs.collect{}, alias_of: ?F_EXT};
val F_INC:        FlagSpec = FlagSpec{name: "--inc", value: "dir", arity: ARITY_VALUE, doc: "an include directory", default: "", negatable: false, occurs: Occurs.collect{}, alias_of: nil};
val F_INC_SHORT:  FlagSpec = FlagSpec{name: "-I", value: "dir", arity: ARITY_VALUE, doc: "an include directory", default: "", negatable: false, occurs: Occurs.collect{}, alias_of: ?F_INC};
val F_LOUD:       FlagSpec = FlagSpec{name: "--loud", value: "", arity: ARITY_FLAG, doc: "speak up", default: "", negatable: true, occurs: Occurs.collect{}, alias_of: nil};
val F_LOUD_SHORT: FlagSpec = FlagSpec{name: "-l", value: "", arity: ARITY_FLAG, doc: "speak up", default: "", negatable: false, occurs: Occurs.collect{}, alias_of: ?F_LOUD};

val REPEATS: [8]*FlagSpec = [8]*FlagSpec{?F_EXT, ?F_EXT_SHORT, ?F_INC, ?F_INC_SHORT, ?F_LOUD, ?F_LOUD_SHORT, ?F_ON, ?F_ON_SHORT};

val F_LVL:       FlagSpec = FlagSpec{name: "--lvl", value: "level", arity: ARITY_ATTACHED, doc: "a level", default: "", negatable: false, occurs: Occurs.override{}, alias_of: nil};
val F_LVL_SHORT: FlagSpec = FlagSpec{name: "-L", value: "level", arity: ARITY_ATTACHED, doc: "a level", default: "", negatable: false, occurs: Occurs.override{}, alias_of: ?F_LVL};
val F_TGT:       FlagSpec = FlagSpec{name: "--tgt", value: "name", arity: ARITY_VALUE, doc: "a target", default: "", negatable: false, occurs: Occurs.override{}, alias_of: nil};
val F_TGT_SHORT: FlagSpec = FlagSpec{name: "-t", value: "name", arity: ARITY_VALUE, doc: "a target", default: "", negatable: false, occurs: Occurs.override{}, alias_of: ?F_TGT};
val F_SW:        FlagSpec = FlagSpec{name: "--sw", value: "", arity: ARITY_FLAG, doc: "a switch", default: "", negatable: true, occurs: Occurs.override{}, alias_of: nil};
val F_SW_SHORT:  FlagSpec = FlagSpec{name: "-s", value: "", arity: ARITY_FLAG, doc: "a switch", default: "", negatable: false, occurs: Occurs.override{}, alias_of: ?F_SW};

val OVERRIDES: [6]*FlagSpec = [6]*FlagSpec{?F_LVL, ?F_LVL_SHORT, ?F_TGT, ?F_TGT_SHORT, ?F_SW, ?F_SW_SHORT};

val T_TABLES: [3]TableRef = [3]TableRef{
    TableRef{rows: ?TABLE[0], n: 4, accepted: nil, docs: nil},
    TableRef{rows: ?REPEATS[0], n: 8, accepted: nil, docs: nil},
    TableRef{rows: ?OVERRIDES[0], n: 6, accepted: nil, docs: nil},
};

val T_PLAIN:     CommandSpec = CommandSpec{name: "plain", id: 0, aliases: nil, alias_n: 0, grammar: " [<file>...]", summary: "plain", effect: "read once rows", exits: nil, exit_n: 0, terminator: "", tables: ?T_TABLES[0], table_n: 1, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: OPERANDS_ANY, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};
val T_REPEATS:   CommandSpec = CommandSpec{name: "repeats", id: 1, aliases: nil, alias_n: 0, grammar: " [<file>...]", summary: "repeats", effect: "read collect rows", exits: nil, exit_n: 0, terminator: "", tables: ?T_TABLES[1], table_n: 1, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: OPERANDS_ANY, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};
val T_OVERRIDES: CommandSpec = CommandSpec{name: "overrides", id: 2, aliases: nil, alias_n: 0, grammar: " [<file>...]", summary: "overrides", effect: "read override rows", exits: nil, exit_n: 0, terminator: "", tables: ?T_TABLES[2], table_n: 1, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: OPERANDS_ANY, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};

val T_SPECS: [3]*CommandSpec = [3]*CommandSpec{?T_PLAIN, ?T_REPEATS, ?T_OVERRIDES};
val T_SET:   CommandSet      = CommandSet{program: "prog", title: "prog", footer: "", specs: ?T_SPECS[0], n: 3, help: nil, help_flag: nil, common: nil, common_n: 0, relations: nil, relation_n: 0, removed: nil, removed_n: 0, exits: nil, exit_n: 0, globals: nil, global_n: 0};

fun read_as(command: *CommandSpec, n: usize, argv: **u8) Invocation {
    ret parse_command(?T_SET, command, of(n, argv), 1);
}

# whether a row's walk gives exactly these indices, states and values in order. a nil value
# wants none
fun walks(inv: *Invocation, flag: *FlagSpec, idx: *usize, on: *bool, want: *str, n: usize) bool {
    val got: res[Values, Misread] = values(inv, flag);
    if (sel got.err) { ret false; }
    var w: Values = got.ok;
    var i: usize  = 0;
    for {
        val h: opt[Hit] = next_value(?w);
        if (sel h.none)                                                                  { brk; }
        if (i >= n || h.some.flag != flag || h.some.idx != idx[i] || h.some.on != on[i]) { ret false; }
        if (want[i] == nil) {
            if (h.some.value != nil) { ret false; }
        }
        or (h.some.value == nil || !str_equals(h.some.value, want[i])) { ret false; }
        i = i + 1;
    }
    ret i == n;
}

# whether a misread names this row, as repeating or as unlisted
fun names(e: Misread, flag: *FlagSpec, repeating: bool) bool {
    if (sel e.repeating) { ret repeating && e.repeating == flag; }
    ret !repeating && e.unlisted == flag;
}

# which refusal an invocation records and at what index, 0 when it records none
fun refusal_at(inv: *Invocation) usize {
    if (sel inv.refusal.none) { ret 0; }
    val r: Refusal = inv.refusal.some;
    if (sel r.unknown)       { ret 1000 + r.unknown.idx; }
    if (sel r.missing_value) { ret 2000 + r.missing_value.idx; }
    if (sel r.repeated)      { ret 3000 + r.repeated.idx; }
    ret 9999;
}

test args__cursor_walks_views {
    var v: [3]*u8   = [3]*u8{"prog", "a", "b"};
    var c: Cursor   = cursor(of(3, ?v[0]), 1);
    val a: opt[str] = next(?c);
    val b: opt[str] = next(?c);
    val d: opt[str] = next(?c);
    if (!(sel a.some && str_equals(a.some, "a"))) { ret 1; }
    if (!(sel b.some && str_equals(b.some, "b"))) { ret 2; }
    if (sel d.some)                               { ret 3; }
    ret 0;
}

test args__switch_sets {
    var v:   [2]*u8     = [2]*u8{"prog", "--on"};
    var inv: Invocation = read_as(?T_PLAIN, 2, ?v[0]);
    if (sel inv.refusal.some) { ret 1; }
    val o: res[bool, Misread] = on(?inv, ?F_ON);
    if (!(sel o.ok && o.ok)) { ret 2; }
    ret 0;
}

test args__negated_switch_clears {
    var v:   [2]*u8     = [2]*u8{"prog", "--no-on"};
    var inv: Invocation = read_as(?T_PLAIN, 2, ?v[0]);
    if (sel inv.refusal.some) { ret 1; }
    val o: res[bool, Misread] = on(?inv, ?F_ON);
    if (!given(?inv, ?F_ON) || !(sel o.ok && !o.ok)) { ret 2; }
    ret 0;
}

test args__value_takes_next_argument {
    var v:   [3]*u8     = [3]*u8{"prog", "--out", "--on"};
    var inv: Invocation = read_as(?T_PLAIN, 3, ?v[0]);
    if (sel inv.refusal.some || given(?inv, ?F_ON)) { ret 1; }
    val o: res[str, Misread] = value(?inv, ?F_OUT);
    if (!(sel o.ok && str_equals(o.ok, "--on"))) { ret 2; }
    ret 0;
}

test args__attached_value_follows_equals {
    var v:   [2]*u8     = [2]*u8{"prog", "--log=debug"};
    var inv: Invocation = read_as(?T_PLAIN, 2, ?v[0]);
    if (sel inv.refusal.some) { ret 1; }
    val o: res[str, Misread] = value(?inv, ?F_LOG);
    if (!(sel o.ok && str_equals(o.ok, "debug"))) { ret 2; }
    ret 0;
}

test args__operands_keep_their_order {
    var v:    [4]*u8     = [4]*u8{"prog", "a", "-", "b"};
    var inv:  Invocation = read_as(?T_PLAIN, 4, ?v[0]);
    var w:    Walk       = walk(?inv);
    var want: usize      = 1;
    for (want < 4) {
        val e: Event = step(?w);
        if (!(sel e.operand && e.operand == want)) { ret 1; }
        want = want + 1;
    }
    val end: Event = step(?w);
    if (!(sel end.done)) { ret 2; }
    ret 0;
}

test args__double_dash_ends_options {
    var v:   [3]*u8     = [3]*u8{"prog", "--", "--on"};
    var inv: Invocation = read_as(?T_PLAIN, 3, ?v[0]);
    if (sel inv.refusal.some) { ret 1; }
    val first: opt[usize] = operand(?inv, 0);
    if (!(sel first.some && first.some == 2))       { ret 2; }
    if (separator(?inv) != 1 || given(?inv, ?F_ON)) { ret 3; }
    ret 0;
}

test args__unknown_flag_is_refused_where_it_stands {
    var v:   [3]*u8     = [3]*u8{"prog", "a", "--nope"};
    var inv: Invocation = read_as(?T_PLAIN, 3, ?v[0]);
    if (refusal_at(?inv) != 1002) { ret 1; }
    ret 0;
}

test args__missing_value_is_refused_where_it_stands {
    var v:   [2]*u8     = [2]*u8{"prog", "--out"};
    var inv: Invocation = read_as(?T_PLAIN, 2, ?v[0]);
    if (refusal_at(?inv) != 2001) { ret 1; }
    ret 0;
}

test args__repeated_flag_is_refused_where_it_stands {
    var v:   [3]*u8     = [3]*u8{"prog", "--on", "--no-on"};
    var inv: Invocation = read_as(?T_PLAIN, 3, ?v[0]);
    if (refusal_at(?inv) != 3002) { ret 1; }
    ret 0;
}

test args__collect_values_walk_in_order {
    var v:   [16]*u8    = [16]*u8{"prog", "--ext=a", "-I", "x", "-e", "--on", "--inc=y", "op", "--ext=b", "-I", "z", "--", "--ext=c", "-I", "w", "-e"};
    var inv: Invocation = read_as(?T_REPEATS, 16, ?v[0]);
    if (sel inv.refusal.some) { ret 1; }
    var ext_idx: [3]usize = [3]usize{1, 4, 8};
    var ext_on:  [3]bool  = [3]bool{true, true, true};
    var ext_val: [3]str   = [3]str{"a", nil, "b"};
    if (!walks(?inv, ?F_EXT, ?ext_idx[0], ?ext_on[0], ?ext_val[0], 3)) { ret 2; }
    var inc_idx: [3]usize = [3]usize{2, 6, 9};
    var inc_on:  [3]bool  = [3]bool{true, true, true};
    var inc_val: [3]str   = [3]str{"x", "y", "z"};
    if (!walks(?inv, ?F_INC, ?inc_idx[0], ?inc_on[0], ?inc_val[0], 3)) { ret 3; }
    if (!given(?inv, ?F_EXT) || occurrences(?inv, ?F_EXT) != 3)        { ret 4; }
    ret 0;
}

test args__collect_switch_walks_its_negations {
    var v:   [4]*u8     = [4]*u8{"prog", "-l", "--no-loud", "--loud"};
    var inv: Invocation = read_as(?T_REPEATS, 4, ?v[0]);
    if (sel inv.refusal.some) { ret 1; }
    var idx: [3]usize = [3]usize{1, 2, 3};
    var on:  [3]bool  = [3]bool{true, false, true};
    var val: [3]str   = [3]str{nil, nil, nil};
    if (!walks(?inv, ?F_LOUD, ?idx[0], ?on[0], ?val[0], 3)) { ret 2; }
    ret 0;
}

test args__row_never_given_walks_empty {
    var v:   [3]*u8     = [3]*u8{"prog", "--on", "op"};
    var inv: Invocation = read_as(?T_REPEATS, 3, ?v[0]);
    if (sel inv.refusal.some)                   { ret 1; }
    if (!walks(?inv, ?F_EXT, nil, nil, nil, 0)) { ret 2; }
    ret 0;
}

test args__single_read_of_collect_row_is_refused {
    var v:   [3]*u8     = [3]*u8{"prog", "--inc=a", "--inc=b"};
    var inv: Invocation = read_as(?T_REPEATS, 3, ?v[0]);
    if (sel inv.refusal.some) { ret 1; }
    val one: res[str, Misread]      = value(?inv, ?F_INC);
    val set: res[opt[Hit], Misread] = latest(?inv, ?F_INC);
    val sw:  res[bool, Misread]     = on(?inv, ?F_LOUD);
    if (!(sel one.err && names(one.err, ?F_INC, true))) { ret 2; }
    if (!(sel set.err && names(set.err, ?F_INC, true))) { ret 3; }
    if (!(sel sw.err && names(sw.err, ?F_LOUD, true)))  { ret 4; }
    if (!given(?inv, ?F_INC))                           { ret 5; }
    val out: res[str, Misread] = value(?inv, ?F_OUT);
    if (!(sel out.err && names(out.err, ?F_OUT, false))) { ret 6; }
    ret 0;
}

test args__override_last_occurrence_wins {
    var v:   [9]*u8     = [9]*u8{"prog", "--lvl=x", "-t", "a", "-L", "--tgt=b", "--lvl=y", "-t", "c"};
    var inv: Invocation = read_as(?T_OVERRIDES, 9, ?v[0]);
    if (sel inv.refusal.some) { ret 1; }
    val lvl: res[str, Misread] = value(?inv, ?F_LVL);
    if (sel lvl.err)                               { ret 2; }
    if (lvl.ok == nil || !str_equals(lvl.ok, "y")) { ret 3; }
    val tgt: res[str, Misread] = value(?inv, ?F_TGT);
    if (sel tgt.err)                               { ret 2; }
    if (tgt.ok == nil || !str_equals(tgt.ok, "c")) { ret 4; }
    val last: res[opt[Hit], Misread] = latest(?inv, ?F_TGT);
    if (sel last.err)                              { ret 2; }
    if (occurrences(?inv, ?F_TGT) != 3)            { ret 5; }
    if (sel last.ok.none)                          { ret 5; }
    if (last.ok.some.idx != 7 || !last.ok.some.on) { ret 5; }
    var lvl_idx: [3]usize = [3]usize{1, 4, 6};
    var lvl_on:  [3]bool  = [3]bool{true, true, true};
    var lvl_val: [3]str   = [3]str{"x", nil, "y"};
    if (!walks(?inv, ?F_LVL, ?lvl_idx[0], ?lvl_on[0], ?lvl_val[0], 3)) { ret 6; }
    var tgt_idx: [3]usize = [3]usize{2, 5, 7};
    var tgt_on:  [3]bool  = [3]bool{true, true, true};
    var tgt_val: [3]str   = [3]str{"a", "b", "c"};
    if (!walks(?inv, ?F_TGT, ?tgt_idx[0], ?tgt_on[0], ?tgt_val[0], 3)) { ret 7; }
    ret 0;
}

test args__override_switch_negated_last_reads_off {
    var v:   [3]*u8     = [3]*u8{"prog", "-s", "--no-sw"};
    var inv: Invocation = read_as(?T_OVERRIDES, 3, ?v[0]);
    if (sel inv.refusal.some) { ret 1; }
    val o:    res[bool, Misread]     = on(?inv, ?F_SW);
    val last: res[opt[Hit], Misread] = latest(?inv, ?F_SW);
    if (!(sel o.ok && !o.ok) || !given(?inv, ?F_SW)) { ret 2; }
    if (sel last.err)                                { ret 3; }
    if (sel last.ok.none)                            { ret 3; }
    if (last.ok.some.idx != 2)                       { ret 3; }
    ret 0;
}

test args__zeroed_row_occurs_once {
    var z: FlagSpec;
    z.name = "--z";
    z.doc  = "zeroed";
    var rows: [1]*FlagSpec = [1]*FlagSpec{?z};
    var t:    [1]TableRef  = [1]TableRef{TableRef{rows: ?rows[0], n: 1, accepted: nil, docs: nil}};
    var c:    CommandSpec;
    c.name        = "zero";
    c.summary     = "zero";
    c.effect      = "read a zeroed row";
    c.tables      = ?t[0];
    c.table_n     = 1;
    c.operand_max = OPERANDS_ANY;
    var specs: [1]*CommandSpec = [1]*CommandSpec{?c};
    var set:   CommandSet;
    set.program = "prog";
    set.specs   = ?specs[0];
    set.n       = 1;
    var one: [2]*u8             = [2]*u8{"prog", "--z"};
    var inv: Invocation         = parse_command(?set, ?c, of(2, ?one[0]), 1);
    val o:   res[bool, Misread] = on(?inv, ?z);
    if (sel inv.refusal.some || !(sel o.ok && o.ok)) { ret 1; }
    var two:   [3]*u8     = [3]*u8{"prog", "--z", "--z"};
    var twice: Invocation = parse_command(?set, ?c, of(3, ?two[0]), 1);
    if (refusal_at(?twice) != 3002) { ret 2; }
    ret 0;
}
