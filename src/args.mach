# command-line arguments as views, and a reader for the toolchain's flag conventions
#
# the process arguments are the argc and argv std.runtime hands main. this
# module borrows them and allocates nothing. on windows the runtime splits the
# wide command line by the post-2008 msvcrt rules and converts each argument to
# UTF-8, so a program reads the same argv bytes on every host. an unpaired
# surrogate, which a windows argument may hold, arrives as U+FFFD, one per code
# unit, so such an argument does not round-trip to the native name. the
# arguments as the host passed them, UTF-16 on windows and bytes elsewhere, are
# in std.runtime.native.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

# the process arguments, borrowed from main's argc and argv
# ---
# argc: number of arguments, the program name included
# argv: the arguments, each a null-terminated string
pub rec Args {
    argc: usize;
    argv: **u8;
}

# view main's argc and argv
# ---
# argc: number of arguments
# argv: the arguments
# ret:  the view
pub fun of(argc: usize, argv: **u8) Args {
    var a: Args;
    a.argc = argc;
    a.argv = argv;
    ret a;
}

# the number of arguments, the program name included
pub fun count(a: Args) usize {
    ret a.argc;
}

# the argument at an index
# ---
# a:   the arguments
# idx: argument index, 0 the program name
# ret: the argument, or none when the index is out of range
pub fun get(a: Args, idx: usize) opt[str] {
    if (idx >= a.argc) { ret opt[str].none{}; }
    ret opt[str].some{a.argv[idx]::str};
}

# an iterator over arguments
# ---
# args: the arguments being walked
# at:   index of the next argument
pub rec Cursor {
    args: Args;
    at:   usize;
}

# iterate arguments from an index
# ---
# a:     the arguments
# start: index of the first argument to yield, 1 to skip the program name
# ret:   the cursor
pub fun cursor(a: Args, start: usize) Cursor {
    var c: Cursor;
    c.args = a;
    c.at   = start;
    ret c;
}

# take the next argument
# ---
# c:   the cursor
# ret: the argument, or none when they are exhausted
pub fun next(c: *Cursor) opt[str] {
    val s: opt[str] = get(c.args, c.at);
    if (sel s.some) { c.at = c.at + 1; }
    ret s;
}

# how a flag takes its value
# ---
# SWITCH:   `--key` sets it, and `--no-key` clears it when the row is negatable
# VALUE:    `--key value` or `--key=value` gives it a value
# ATTACHED: `--key` alone sets it, and `--key=value` also gives it a value
pub def Kind: u8;
pub val SWITCH:   Kind = 0;
pub val VALUE:    Kind = 1;
pub val ATTACHED: Kind = 2;

# one flag a program accepts. a row is its own identity: the reader reports the
# row a flag matched, and a program asks for its setting by address. the reader
# never reads value or doc, so a program builds its help text from the same rows
# ---
# name:      the long spelling, such as `--write`
# short:     the short spelling, such as `-w`, or nil. a short flag never takes `=value`
# kind:      SWITCH, VALUE or ATTACHED
# negatable: a switch also answers to `--no-` and the rest of name
# repeat:    the flag may occur more than once, each occurrence an event. its occurrences are
#            read with values, and a single read of it is refused. any other flag is refused
#            when it repeats
# value:     the placeholder help shows for a value
# doc:       one-line help text
pub rec Flag {
    name:      str;
    short:     str;
    kind:      Kind;
    negatable: bool;
    repeat:    bool;
    value:     str;
    doc:       str;
}

# where a command line was refused. idx is the argument index and flag its text
pub rec Refused {
    idx:  usize;
    flag: str;
}

# why a command line was refused
# ---
# unknown:       the flag names no row
# missing_value: a VALUE flag ends the line with no value after it
# repeated:      a flag that does not repeat occurs again
pub tag Error: u8 {
    unknown:       Refused;
    missing_value: Refused;
    repeated:      Refused;
}

# what one flag was given
# ---
# flag:  the row the flag matched
# idx:   argument index of the flag
# on:    false only for a negated switch
# value: the value given, nil when none was
pub rec Hit {
    flag:  *Flag;
    idx:   usize;
    on:    bool;
    value: str;
}

# one step of a command line
# ---
# done:    no arguments remain
# operand: an operand, by argument index
# hit:     a flag
pub tag Event: u8 {
    done;
    operand: usize;
    hit:     Hit;
}

# what a row was given. the reader keeps one per row, in storage the program owns. a repeating
# row keeps only its count, since one occurrence cannot stand for the rest
# ---
# count: how many times the flag occurred
# idx:   argument index of the occurrence
# on:    the occurrence's state
# value: the occurrence's value, nil when it had none
pub rec Setting {
    count: usize;
    idx:   usize;
    on:    bool;
    value: str;
}

# a command line being read against a flag table
pub rec Reader {
    args:     Args;
    flags:    **Flag;
    flag_n:   usize;
    settings: *Setting;
    start:    usize;
    at:       usize;
    ended:    bool;
    sep:      usize;
}

# read arguments against a flag table
# ---
# a:        the arguments
# start:    index of the first argument to read. 1 skips the program name, and a program that
#           dispatches on a command word reads it with get and starts after it
# flags:    the flag rows
# flag_n:   number of rows
# settings: one Setting per row, in row order. the reader clears it
# ret:      the reader
pub fun reader(a: Args, start: usize, flags: **Flag, flag_n: usize, settings: *Setting) Reader {
    var r: Reader;
    r.args     = a;
    r.flags    = flags;
    r.flag_n   = flag_n;
    r.settings = settings;
    r.start    = start;
    r.at       = start;
    r.sep      = a.argc;
    var i: usize = 0;
    for (i < flag_n) {
        settings[i] = Setting{count: 0, idx: 0, on: false, value: nil};
        i           = i + 1;
    }
    ret r;
}

# a token that is a flag: a dash and something after it. a lone `-` is an operand
fun is_flag(tok: str) bool {
    ret tok[0] == '-' && tok[1] != 0;
}

# a token matched against a row
# ---
# idx:      argument index of the token
# tok:      the token
# found:    a row matched
# row:      its index
# negated:  the token was the row's `--no-` spelling
# value_at: byte offset of an attached value, 0 when the token carries none
rec Match {
    idx:      usize;
    tok:      str;
    found:    bool;
    row:      usize;
    negated:  bool;
    value_at: usize;
}

fun find(r: *Reader, tok: str) Match {
    var m: Match;
    var j: usize = 0;
    for (j < r.flag_n) {
        val f: *Flag = r.flags[j];
        m.row = j;
        if (str_equals(tok, f.name) || (f.short != nil && str_equals(tok, f.short))) {
            m.found = true;
            ret m;
        }
        if (f.kind == SWITCH) {
            if (f.negatable && str_starts_with(tok, "--no-") && str_equals(?tok[5], ?f.name[2])) {
                m.found   = true;
                m.negated = true;
                ret m;
            }
        }
        or {
            val n: usize = str_len(f.name);
            if (str_starts_with(tok, f.name) && tok[n] == '=') {
                m.found    = true;
                m.value_at = n + 1;
                ret m;
            }
        }
        j = j + 1;
    }
    m.found = false;
    ret m;
}

# advance to the next flag, its value not yet taken
# ---
# r:   the reader
# m:   the flag's match, filled when the argument is a flag
# ret: done or an operand, or none when the argument is a flag
fun scan(r: *Reader, m: *Match) opt[Event] {
    for {
        if (r.at >= r.args.argc) { ret opt[Event].some{Event.done{}}; }
        val idx: usize = r.at;
        val tok: str   = r.args.argv[idx]::str;
        r.at = idx + 1;
        if (r.ended || !is_flag(tok)) { ret opt[Event].some{Event.operand{idx}}; }
        if (str_equals(tok, "--")) {
            r.ended = true;
            r.sep   = idx;
            cnt;
        }
        @m    = find(r, tok);
        m.idx = idx;
        m.tok = tok;
        ret opt[Event].none{};
    }
    ret opt[Event].some{Event.done{}};
}

# take a scanned flag's value
# ---
# r:   the reader
# m:   the flag's match
# ret: the flag, or the refusal of an unknown flag or a missing value
fun take(r: *Reader, m: Match) res[Event, Error] {
    val at: Refused = Refused{idx: m.idx, flag: m.tok};
    if (!m.found) { ret res[Event, Error].err{Error.unknown{at}}; }
    val f:   *Flag = r.flags[m.row];
    var hit: Hit   = Hit{flag: f, idx: m.idx, on: !m.negated, value: nil};
    if (m.value_at > 0) { hit.value = ?m.tok[m.value_at]; }
    or (f.kind == VALUE) {
        if (r.at >= r.args.argc) { ret res[Event, Error].err{Error.missing_value{at}}; }
        hit.value = r.args.argv[r.at]::str;
        r.at      = r.at + 1;
    }
    ret res[Event, Error].ok{Event.hit{hit}};
}

# read the next argument: an operand, or a flag with its value taken
# ---
# r:   the reader
# ret: the event, or the refusal and where it happened. after a refusal the reader is not
#      to be read further
pub fun read(r: *Reader) res[Event, Error] {
    var m: Match;
    val e: opt[Event] = scan(r, ?m);
    if (sel e.some) { ret res[Event, Error].ok{e.some}; }
    if (m.found && r.settings[m.row].count > 0 && !r.flags[m.row].repeat) {
        ret res[Event, Error].err{Error.repeated{Refused{idx: m.idx, flag: m.tok}}};
    }
    val t: res[Event, Error] = take(r, m);
    if (sel t.err) { ret t; }
    if (sel t.ok.hit) {
        val s: *Setting = ?r.settings[m.row];
        s.count = s.count + 1;
        if (!t.ok.hit.flag.repeat) {
            s.idx   = t.ok.hit.idx;
            s.on    = t.ok.hit.on;
            s.value = t.ok.hit.value;
        }
    }
    ret t;
}

# the index of the `--` that ended the options, or the argument count when none did.
# meaningful once the reader has read past it
pub fun separator(r: Reader) usize {
    ret r.sep;
}

# why a row could not be read from the reader
# ---
# unlisted:  the row is not in the reader's table
# repeating: the row repeats, so one occurrence cannot answer for it. its occurrences are
#            read with values
pub tag Misread: u8 {
    unlisted:  *Flag;
    repeating: *Flag;
}

# a row's index in the reader's table, none when it is not there
fun row_of(r: Reader, flag: *Flag) opt[usize] {
    var j: usize = 0;
    for (j < r.flag_n) {
        if (r.flags[j] == flag) { ret opt[usize].some{j}; }
        j = j + 1;
    }
    ret opt[usize].none{};
}

# what a row that does not repeat was given
# ---
# r:    the reader
# flag: a row of the reader's table
# ret:  its setting, or refused when the row is not in the table or repeats
pub fun setting(r: Reader, flag: *Flag) res[*Setting, Misread] {
    val j: opt[usize] = row_of(r, flag);
    if (sel j.none)  { ret res[*Setting, Misread].err{Misread.unlisted{flag}}; }
    if (flag.repeat) { ret res[*Setting, Misread].err{Misread.repeating{flag}}; }
    ret res[*Setting, Misread].ok{?r.settings[j.some]};
}

# whether a row occurred at all, false when it is not in the table. any row may be asked
pub fun given(r: Reader, flag: *Flag) bool {
    val j: opt[usize] = row_of(r, flag);
    ret sel j.some && r.settings[j.some].count > 0;
}

# whether a switch that does not repeat is set: it occurred and was not negated
# ---
# r:    the reader
# flag: a row of the reader's table
# ret:  whether it is set, or refused as setting refuses
pub fun on(r: Reader, flag: *Flag) res[bool, Misread] {
    val s: res[*Setting, Misread] = setting(r, flag);
    if (sel s.err) { ret res[bool, Misread].err{s.err}; }
    ret res[bool, Misread].ok{s.ok.count > 0 && s.ok.on};
}

# the value a row that does not repeat was given
# ---
# r:    the reader
# flag: a row of the reader's table
# ret:  the value, nil when it had none or did not occur, or refused as setting refuses
pub fun value(r: Reader, flag: *Flag) res[str, Misread] {
    val s: res[*Setting, Misread] = setting(r, flag);
    if (sel s.err) { ret res[str, Misread].err{s.err}; }
    ret res[str, Misread].ok{s.ok.value};
}

# a walk over one row's occurrences, in argument order up to the separator
# ---
# reader: the reader's own state over the arguments it has read, rewound to its start. the
#         walk keeps no settings
# flag:   the row walked
pub rec Values {
    reader: Reader;
    flag:   *Flag;
}

# walk a row's occurrences, each as read gave it. this is how a repeating row is read, and
# any row of the table may be walked. the walk covers the arguments the reader has read, so
# it is taken once the reader has read to the end, and a reader that refused is not walked
# ---
# r:    the reader
# flag: a row of the reader's table
# ret:  the walk, or refused when the row is not in the table
pub fun values(r: Reader, flag: *Flag) res[Values, Misread] {
    val j: opt[usize] = row_of(r, flag);
    if (sel j.none) { ret res[Values, Misread].err{Misread.unlisted{flag}}; }
    var w: Values;
    w.reader          = r;
    w.reader.args     = of(r.at, r.args.argv);
    w.reader.settings = nil;
    w.reader.at       = r.start;
    w.reader.ended    = false;
    w.reader.sep      = r.at;
    w.flag            = flag;
    ret res[Values, Misread].ok{w};
}

# take the row's next occurrence
# ---
# w:   the walk
# ret: the occurrence, its value and its state, or none when the row occurs no more before
#      the separator
pub fun next_value(w: *Values) opt[Hit] {
    for (!w.reader.ended) {
        var m: Match;
        val e: opt[Event] = scan(?w.reader, ?m);
        if (sel e.some) {
            if (sel e.some.done) { brk; }
            cnt;
        }
        val t: res[Event, Error] = take(?w.reader, m);
        if (sel t.err) { brk; }
        if (sel t.ok.hit) {
            if (t.ok.hit.flag == w.flag) { ret opt[Hit].some{t.ok.hit}; }
        }
    }
    ret opt[Hit].none{};
}

val F_ON:  Flag = Flag{name: "--on", short: "-o", kind: SWITCH, negatable: true, repeat: false, value: "", doc: ""};
val F_OUT: Flag = Flag{name: "--out", short: nil, kind: VALUE, negatable: false, repeat: false, value: "path", doc: ""};
val F_LOG: Flag = Flag{name: "--log", short: nil, kind: ATTACHED, negatable: false, repeat: false, value: "level", doc: ""};

val TABLE: [3]*Flag = [3]*Flag{?F_ON, ?F_OUT, ?F_LOG};

val F_EXT:  Flag = Flag{name: "--ext", short: "-e", kind: ATTACHED, negatable: false, repeat: true, value: "name", doc: ""};
val F_INC:  Flag = Flag{name: "--inc", short: "-I", kind: VALUE, negatable: false, repeat: true, value: "dir", doc: ""};
val F_LOUD: Flag = Flag{name: "--loud", short: "-l", kind: SWITCH, negatable: true, repeat: true, value: "", doc: ""};

val REPEATS: [4]*Flag = [4]*Flag{?F_EXT, ?F_INC, ?F_LOUD, ?F_ON};

# whether a row's walk gives exactly these indices, states and values in order. a nil value
# wants none
fun walks(r: Reader, flag: *Flag, idx: *usize, on: *bool, want: *str, n: usize) bool {
    val got: res[Values, Misread] = values(r, flag);
    if (sel got.err) { ret false; }
    var w: Values = got.ok;
    var i: usize  = 0;
    for {
        val h: opt[Hit] = next_value(?w);
        if (sel h.none)                                                                  { brk; }
        if (i >= n || h.some.flag != flag || h.some.idx != idx[i] || h.some.on != on[i]) { ret false; }
        if (want[i] == nil) {
            if (h.some.value != nil) { ret false; }
        }
        or (h.some.value == nil || !str_equals(h.some.value, want[i])) { ret false; }
        i = i + 1;
    }
    ret i == n;
}

# whether a misread names this row, as repeating or as unlisted
fun names(e: Misread, flag: *Flag, repeating: bool) bool {
    if (sel e.repeating) { ret repeating && e.repeating == flag; }
    ret !repeating && e.unlisted == flag;
}

# read every argument, false on a refusal
fun read_all(r: *Reader) bool {
    for {
        val e: res[Event, Error] = read(r);
        if (sel e.err)     { ret false; }
        if (sel e.ok.done) { ret true; }
    }
    ret true;
}

# the row the next event is a flag of, nil when it is not a flag
fun expect_hit(r: *Reader) *Flag {
    val e: res[Event, Error] = read(r);
    if (sel e.err)    { ret nil; }
    if (sel e.ok.hit) { ret e.ok.hit.flag; }
    ret nil;
}

# which refusal the next read gives and at what index, 0 when it gives none
fun refusal_at(r: *Reader) usize {
    val e: res[Event, Error] = read(r);
    if (sel e.ok)                { ret 0; }
    if (sel e.err.unknown)       { ret 1000 + e.err.unknown.idx; }
    if (sel e.err.missing_value) { ret 2000 + e.err.missing_value.idx; }
    if (sel e.err.repeated)      { ret 3000 + e.err.repeated.idx; }
    ret 9999;
}

test args__cursor_walks_views {
    var v: [3]*u8   = [3]*u8{"prog", "a", "b"};
    var c: Cursor   = cursor(of(3, ?v[0]), 1);
    val a: opt[str] = next(?c);
    val b: opt[str] = next(?c);
    val d: opt[str] = next(?c);
    if (!(sel a.some && str_equals(a.some, "a"))) { ret 1; }
    if (!(sel b.some && str_equals(b.some, "b"))) { ret 2; }
    if (sel d.some)                               { ret 3; }
    ret 0;
}

test args__switch_sets {
    var v: [2]*u8 = [2]*u8{"prog", "--on"};
    var s: [3]Setting;
    var r: Reader = reader(of(2, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (expect_hit(?r) != ?F_ON) { ret 1; }
    val o: res[bool, Misread] = on(r, ?F_ON);
    if (!(sel o.ok && o.ok)) { ret 2; }
    ret 0;
}

test args__negated_switch_clears {
    var v: [2]*u8 = [2]*u8{"prog", "--no-on"};
    var s: [3]Setting;
    var r: Reader = reader(of(2, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (expect_hit(?r) != ?F_ON) { ret 1; }
    val o: res[bool, Misread] = on(r, ?F_ON);
    if (!given(r, ?F_ON) || !(sel o.ok && !o.ok)) { ret 2; }
    ret 0;
}

test args__value_takes_next_argument {
    var v: [3]*u8 = [3]*u8{"prog", "--out", "--on"};
    var s: [3]Setting;
    var r: Reader = reader(of(3, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (expect_hit(?r) != ?F_OUT) { ret 1; }
    val o: res[str, Misread] = value(r, ?F_OUT);
    if (!(sel o.ok && str_equals(o.ok, "--on"))) { ret 2; }
    ret 0;
}

test args__attached_value_follows_equals {
    var v: [2]*u8 = [2]*u8{"prog", "--log=debug"};
    var s: [3]Setting;
    var r: Reader = reader(of(2, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (expect_hit(?r) != ?F_LOG) { ret 1; }
    val o: res[str, Misread] = value(r, ?F_LOG);
    if (!(sel o.ok && str_equals(o.ok, "debug"))) { ret 2; }
    ret 0;
}

test args__operands_keep_their_order {
    var v:    [4]*u8 = [4]*u8{"prog", "a", "-", "b"};
    var s:    [3]Setting;
    var r:    Reader = reader(of(4, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    var want: usize  = 1;
    for (want < 4) {
        val e: res[Event, Error] = read(?r);
        if (sel e.err)                                   { ret 1; }
        if (!(sel e.ok.operand && e.ok.operand == want)) { ret 2; }
        want = want + 1;
    }
    ret 0;
}

test args__double_dash_ends_options {
    var v: [3]*u8            = [3]*u8{"prog", "--", "--on"};
    var s: [3]Setting;
    var r: Reader            = reader(of(3, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    val e: res[Event, Error] = read(?r);
    if (sel e.err)                                { ret 1; }
    if (!(sel e.ok.operand && e.ok.operand == 2)) { ret 2; }
    if (separator(r) != 1 || given(r, ?F_ON))     { ret 3; }
    ret 0;
}

test args__unknown_flag_is_refused_where_it_stands {
    var v: [3]*u8 = [3]*u8{"prog", "a", "--nope"};
    var s: [3]Setting;
    var r: Reader = reader(of(3, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    read(?r);
    if (refusal_at(?r) != 1002) { ret 1; }
    ret 0;
}

test args__missing_value_is_refused_where_it_stands {
    var v: [2]*u8 = [2]*u8{"prog", "--out"};
    var s: [3]Setting;
    var r: Reader = reader(of(2, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    if (refusal_at(?r) != 2001) { ret 1; }
    ret 0;
}

test args__repeated_flag_is_refused_where_it_stands {
    var v: [3]*u8 = [3]*u8{"prog", "--on", "--no-on"};
    var s: [3]Setting;
    var r: Reader = reader(of(3, ?v[0]), 1, ?TABLE[0], 3, ?s[0]);
    read(?r);
    if (refusal_at(?r) != 3002) { ret 1; }
    ret 0;
}

test args__repeating_values_walk_in_order {
    var v: [16]*u8 = [16]*u8{"prog", "--ext=a", "-I", "x", "-e", "--on", "--inc=y", "op", "--ext=b", "-I", "z", "--", "--ext=c", "-I", "w", "-e"};
    var s: [4]Setting;
    var r: Reader  = reader(of(16, ?v[0]), 1, ?REPEATS[0], 4, ?s[0]);
    if (!read_all(?r)) { ret 1; }
    var ext_idx: [3]usize = [3]usize{1, 4, 8};
    var ext_on:  [3]bool  = [3]bool{true, true, true};
    var ext_val: [3]str   = [3]str{"a", nil, "b"};
    if (!walks(r, ?F_EXT, ?ext_idx[0], ?ext_on[0], ?ext_val[0], 3)) { ret 2; }
    var inc_idx: [3]usize = [3]usize{2, 6, 9};
    var inc_on:  [3]bool  = [3]bool{true, true, true};
    var inc_val: [3]str   = [3]str{"x", "y", "z"};
    if (!walks(r, ?F_INC, ?inc_idx[0], ?inc_on[0], ?inc_val[0], 3)) { ret 3; }
    if (!given(r, ?F_EXT) || s[0].count != 3)                       { ret 4; }
    ret 0;
}

test args__repeating_switch_walks_its_negations {
    var v: [4]*u8 = [4]*u8{"prog", "-l", "--no-loud", "--loud"};
    var s: [4]Setting;
    var r: Reader = reader(of(4, ?v[0]), 1, ?REPEATS[0], 4, ?s[0]);
    if (!read_all(?r)) { ret 1; }
    var idx: [3]usize = [3]usize{1, 2, 3};
    var on:  [3]bool  = [3]bool{true, false, true};
    var val: [3]str   = [3]str{nil, nil, nil};
    if (!walks(r, ?F_LOUD, ?idx[0], ?on[0], ?val[0], 3)) { ret 2; }
    ret 0;
}

test args__row_never_given_walks_empty {
    var v: [3]*u8 = [3]*u8{"prog", "--on", "op"};
    var s: [4]Setting;
    var r: Reader = reader(of(3, ?v[0]), 1, ?REPEATS[0], 4, ?s[0]);
    if (!read_all(?r))                       { ret 1; }
    if (!walks(r, ?F_EXT, nil, nil, nil, 0)) { ret 2; }
    ret 0;
}

test args__single_read_of_repeating_row_is_refused {
    var v: [3]*u8 = [3]*u8{"prog", "--inc=a", "--inc=b"};
    var s: [4]Setting;
    var r: Reader = reader(of(3, ?v[0]), 1, ?REPEATS[0], 4, ?s[0]);
    if (!read_all(?r)) { ret 1; }
    val one: res[str, Misread]      = value(r, ?F_INC);
    val set: res[*Setting, Misread] = setting(r, ?F_INC);
    val sw:  res[bool, Misread]     = on(r, ?F_LOUD);
    if (!(sel one.err && names(one.err, ?F_INC, true))) { ret 2; }
    if (!(sel set.err && names(set.err, ?F_INC, true))) { ret 3; }
    if (!(sel sw.err && names(sw.err, ?F_LOUD, true)))  { ret 4; }
    if (!given(r, ?F_INC))                              { ret 5; }
    val out: res[str, Misread] = value(r, ?F_OUT);
    if (!(sel out.err && names(out.err, ?F_OUT, false))) { ret 6; }
    ret 0;
}
