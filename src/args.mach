# command-line arguments as views, and a parser that reads them against declared commands
#
# the process arguments are the argc and argv std.runtime hands main. this
# module borrows them and allocates nothing. on windows the runtime splits the
# wide command line by the post-2008 msvcrt rules and converts each argument to
# UTF-8, so a program reads the same argv bytes on every host. an unpaired
# surrogate, which a windows argument may hold, arrives as U+FFFD, one per code
# unit, so such an argument does not round-trip to the native name. the
# arguments as the host passed them, UTF-16 on windows and bytes elsewhere, are
# in std.runtime.native.
#
# a program describes its command line as data: a root Command, Commands nested
# under it to any depth, and the Flags each one reads. parse reads the arguments
# against the root into a Parsed, which records the command path matched and the
# first refusal of the user's input. it keeps no copy of what it read: every
# query reads the arguments again, so the parser needs no storage from the
# caller. parse judges the user's line alone, never the description, and imposes
# no shape on a program's command line: a program declares its own `--help`,
# `--version` and exit codes, and decides what a refusal costs.
#
# a flag is spelled long, `--name`, short, `-c` with one byte, or both. a long
# flag that takes a value reads `--name value` or `--name=value`, and a
# negatable one also answers to `--no-name`, which reads as off. a token with
# one dash is a cluster of short spellings read left to right: a flag that takes
# no value is one occurrence and reading goes on, a flag that takes a value ends
# the cluster and the rest of the token, verbatim, is its value, so `-o=x` gives
# `=x` and `-vv` is two occurrences of `-v`. a short flag that takes a value
# with nothing left takes the next argument. a lone `-` is an operand, and `--`
# ends the flags: the arguments after it are operands, or the rest of a
# passthrough command, returned as given. std.args.help renders a neutral page
# from the same records for a program that wants one.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use std.collections.slice.Slice;
use io_writer: std.io.writer;
use std.io.writer.WriteError;
use std.io.writer.Writer;

# the process arguments, borrowed from main's argc and argv
# ---
# argc: number of arguments, the program name included
# argv: the arguments, each a null-terminated string
pub rec Args {
    argc: usize;
    argv: **u8;
}

# view main's argc and argv
# ---
# argc: number of arguments
# argv: the arguments
# ret:  the view
pub fun of(argc: usize, argv: **u8) Args {
    var a: Args;
    a.argc = argc;
    a.argv = argv;
    ret a;
}

# the number of arguments, the program name included
pub fun count(a: Args) usize {
    ret a.argc;
}

# the argument at an index
# ---
# a:   the arguments
# idx: argument index, 0 the program name
# ret: the argument, or none when the index is out of range
pub fun get(a: Args, idx: usize) opt[str] {
    if (idx >= a.argc) { ret opt[str].none{}; }
    ret opt[str].some{a.argv[idx]::str};
}

# an iterator over arguments
# ---
# args: the arguments being walked
# at:   index of the next argument
pub rec Cursor {
    args: Args;
    at:   usize;
}

# iterate arguments from an index
# ---
# a:     the arguments
# start: index of the first argument to yield, 1 to skip the program name
# ret:   the cursor
pub fun cursor(a: Args, start: usize) Cursor {
    var c: Cursor;
    c.args = a;
    c.at   = start;
    ret c;
}

# take the next argument
# ---
# c:   the cursor
# ret: the argument, or none when they are exhausted
pub fun next(c: *Cursor) opt[str] {
    val s: opt[str] = get(c.args, c.at);
    if (sel s.some) { c.at = c.at + 1; }
    ret s;
}

# one flag. a flag is its own identity: parse records the flag an option matched, and a program
# asks for it by address, so one flag listed by several commands reads as one
# ---
# long:      the long spelling without its dashes, `out` for `--out`, nil for none
# short:     the short spelling's byte, `o` for `-o`, 0 for none
# value:     the placeholder of the value the flag takes, as help prints it, nil or empty for a
#            flag that takes none
# repeat:    the flag is meant to occur more than once. parse accepts any number of occurrences
#            of every flag, a single read answers the last, and help marks a repeating flag
# negatable: the long spelling also answers to `--no-` and the rest of it, an occurrence that
#            reads as off and takes no value
# help:      one-line help text, nil or empty for none
pub rec Flag {
    long:      str;
    short:     u8;
    value:     str;
    repeat:    bool;
    negatable: bool;
    help:      str;
}

# the operand_max of a command that takes any number of operands
pub val OPERANDS_ANY: usize = 0xffffffff;

# one command, a program's root or a command nested under another to any depth
# ---
# name:        the command word. the root's is the program name refusals and help spell
# aliases:     other words for the command
# help:        help text for the command, nil or empty for none
# usage:       the operand grammar help prints after the command words, nil or empty for none
# flags:       the flags read while the command is the one matched so far
# commands:    the commands nested under it. a word in the operand place names one of them
# operand_min: fewest operands the command takes
# operand_max: most operands the command takes, OPERANDS_ANY for no bound
# passthrough: the arguments after `--` are neither flags nor operands but the rest, returned as
#              given. without it they are operands
pub rec Command {
    name:        str;
    aliases:     Slice[str];
    help:        str;
    usage:       str;
    flags:       Slice[*Flag];
    commands:    Slice[*Command];
    operand_min: usize;
    operand_max: usize;
    passthrough: bool;
}

fun empty(s: str) bool {
    ret s == nil || s[0] == 0;
}

# whether a flag takes a value
pub fun takes_value(f: *Flag) bool {
    ret !empty(f.value);
}

# a token that is an option: a dash and something after it. a lone `-` is an operand
fun is_flag(tok: str) bool {
    ret tok != nil && tok[0] == '-' && tok[1] != 0;
}

# the command nested under a command that a word names, by its name or one of its aliases
# ---
# command: the command
# word:    a command word
# ret:     the nested command, or nil when none answers to the word
pub fun subcommand(command: *Command, word: str) *Command {
    var i: usize = 0;
    for (i < command.commands.size) {
        val sub: *Command = command.commands.data[i];
        i = i + 1;
        if (str_equals(sub.name, word)) { ret sub; }
        var j: usize = 0;
        for (j < sub.aliases.size) {
            if (str_equals(sub.aliases.data[j], word)) { ret sub; }
            j = j + 1;
        }
    }
    ret nil;
}

# where a token was refused
# ---
# idx:   argument index of the token
# at:    byte offset of the refused character in a short cluster, 0 for the whole token
# tok:   the token
# depth: the depth of the command the token was read against, 0 the root
pub rec Refused {
    idx:   usize;
    at:    usize;
    tok:   str;
    depth: usize;
}

# why parse refused the user's command line. describe writes its message
# ---
# unknown_flag:    an option names no flag of the command it was read against
# missing_value:   a flag that takes a value ends the line with no value after it
# unknown_command: a word in a command's operand place names none of its nested commands
# operands:        the matched command's operand count is outside its bounds, by the count given
pub tag Refusal: u8 {
    unknown_flag:    Refused;
    missing_value:   Refused;
    unknown_command: Refused;
    operands:        usize;
}

# a command line read against a root command. it keeps no copy of the arguments, which every
# query reads again, so the arguments and the commands outlive it
# ---
# args:    the arguments, the program name at 0
# root:    the root command
# command: the command matched, the last of the path from the root
# depth:   the number of command words matched below the root
# sep:     index of the `--` that ended the flags, the argument count when none did
# rest:    index of the first argument after a passthrough command's `--`, the argument count
#          when there is none
# refusal: the first way the line is refused in argument order, an operand count last, none when
#          it is read whole
pub rec Parsed {
    args:    Args;
    root:    *Command;
    command: *Command;
    depth:   usize;
    sep:     usize;
    rest:    usize;
    refusal: opt[Refusal];
}

# what one option was given
# ---
# flag:  the flag the option names
# idx:   argument index of the option
# at:    byte offset of its character in a short cluster, 0 for a long option
# on:    false only for a negated flag
# value: the value given, nil when none was
pub rec Hit {
    flag:  *Flag;
    idx:   usize;
    at:    usize;
    on:    bool;
    value: str;
}

# a scan of a parsed line from its first argument
# ---
# args:   the arguments
# cur:    the command matched so far, whose flags the next option is read against
# depth:  its depth, 0 the root
# at:     index of the next argument
# cl:     offset of the next character of the short cluster in argument cl_idx, 0 when none
# cl_idx: the argument the cluster is in
# ended:  a `--` ended the flags
# sep:    index of that `--`, the argument count when none
# rest:   index after a passthrough `--`, the argument count when none
rec Scan {
    args:   Args;
    cur:    *Command;
    depth:  usize;
    at:     usize;
    cl:     usize;
    cl_idx: usize;
    ended:  bool;
    sep:    usize;
    rest:   usize;
}

# one step of a scan
# ---
# command: a command word, by argument index, after which the scan reads against that command
# bare:    a flag that takes a value with nothing after it, still an occurrence
tag Step: u8 {
    done;
    operand:         usize;
    command:         usize;
    hit:             Hit;
    bare:            Hit;
    unknown_flag:    Refused;
    unknown_command: Refused;
}

fun scan_from(root: *Command, a: Args) Scan {
    var s: Scan;
    s.args = a;
    s.cur  = root;
    s.at   = 1;
    s.sep  = a.argc;
    s.rest = a.argc;
    ret s;
}

fun scan_of(p: *Parsed) Scan {
    ret scan_from(p.root, p.args);
}

fun lookup_short(c: *Command, b: u8) *Flag {
    var i: usize = 0;
    for (i < c.flags.size) {
        val f: *Flag = c.flags.data[i];
        if (f.short != 0 && f.short == b) { ret f; }
        i = i + 1;
    }
    ret nil;
}

# what a long token is to a flag
# ---
# flag:     the flag it spells, nil when none
# negated:  it is the flag's `--no-` spelling
# value_at: byte offset of a value after `=`, 0 when it carries none
rec Found {
    flag:     *Flag;
    negated:  bool;
    value_at: usize;
}

fun spelt_long(f: *Flag, tok: str) Found {
    var found: Found;
    if (empty(f.long)) { ret found; }
    val name: str = ?tok[2];
    if (str_equals(name, f.long)) {
        found.flag = f;
        ret found;
    }
    if (f.negatable && str_starts_with(name, "no-") && str_equals(?name[3], f.long)) {
        found.flag    = f;
        found.negated = true;
        ret found;
    }
    val n: usize = str_len(f.long);
    if (takes_value(f) && str_starts_with(name, f.long) && name[n] == '=') {
        found.flag     = f;
        found.value_at = n + 3;
    }
    ret found;
}

fun lookup_long(c: *Command, tok: str) Found {
    var i: usize = 0;
    for (i < c.flags.size) {
        val found: Found = spelt_long(c.flags.data[i], tok);
        if (found.flag != nil) { ret found; }
        i = i + 1;
    }
    var none: Found;
    ret none;
}

fun take_next(s: *Scan, h: Hit) Step {
    var hit: Hit = h;
    if (!takes_value(hit.flag) || !hit.on) { ret Step.hit{hit}; }
    if (s.at >= s.args.argc)               { ret Step.bare{hit}; }
    hit.value = s.args.argv[s.at]::str;
    s.at      = s.at + 1;
    ret Step.hit{hit};
}

fun cluster(s: *Scan, idx: usize, at: usize) Step {
    val tok: str = s.args.argv[idx]::str;
    s.cl = 0;
    val f: *Flag = lookup_short(s.cur, tok[at]);
    if (f == nil) { ret Step.unknown_flag{Refused{idx: idx, at: at, tok: tok, depth: s.depth}}; }
    var hit: Hit = Hit{flag: f, idx: idx, at: at, on: true, value: nil};
    if (tok[at + 1] == 0) { ret take_next(s, hit); }
    if (!takes_value(f)) {
        s.cl     = at + 1;
        s.cl_idx = idx;
        ret Step.hit{hit};
    }
    hit.value = ?tok[at + 1];
    ret Step.hit{hit};
}

fun step_of(s: *Scan) Step {
    for {
        if (s.cl != 0)           { ret cluster(s, s.cl_idx, s.cl); }
        if (s.at >= s.args.argc) { ret Step.done{}; }
        val idx: usize = s.at;
        s.at = idx + 1;
        val tok: str = s.args.argv[idx]::str;
        if (s.ended || !is_flag(tok)) {
            if (s.ended || s.cur.commands.size == 0) { ret Step.operand{idx}; }
            val sub: *Command = subcommand(s.cur, tok);
            if (sub == nil) { ret Step.unknown_command{Refused{idx: idx, at: 0, tok: tok, depth: s.depth}}; }
            s.cur   = sub;
            s.depth = s.depth + 1;
            ret Step.command{idx};
        }
        if (str_equals(tok, "--")) {
            s.ended = true;
            s.sep   = idx;
            if (s.cur.passthrough) {
                s.rest = idx + 1;
                s.at   = s.args.argc;
            }
            cnt;
        }
        if (tok[1] != '-') { ret cluster(s, idx, 1); }
        val found: Found = lookup_long(s.cur, tok);
        if (found.flag == nil) { ret Step.unknown_flag{Refused{idx: idx, at: 0, tok: tok, depth: s.depth}}; }
        var hit: Hit = Hit{flag: found.flag, idx: idx, at: 0, on: !found.negated, value: nil};
        if (found.value_at > 0) {
            hit.value = ?tok[found.value_at];
            ret Step.hit{hit};
        }
        ret take_next(s, hit);
    }
    ret Step.done{};
}

# the next occurrence of any flag, a bare one included, skipping everything else
fun next_hit(s: *Scan) opt[Hit] {
    for {
        val st: Step = step_of(s);
        if (sel st.done) { ret opt[Hit].none{}; }
        if (sel st.hit)  { ret opt[Hit].some{st.hit}; }
        if (sel st.bare) { ret opt[Hit].some{st.bare}; }
    }
    ret opt[Hit].none{};
}

fun refuse(p: *Parsed, r: Refusal) {
    val first: bool = sel p.refusal.none;
    if (first) { p.refusal = opt[Refusal].some{r}; }
}

# read a command line against a root command. from argument 1 on, an option is read against the
# flags of the command matched so far, and while that command has nested commands a word in the
# operand place names one of them, which becomes the command matched. every other word is an
# operand of the command matched, and `--` ends the flags. parse judges the user's line alone:
# the commands are taken as the program wrote them
# ---
# spec: the root command, which outlives the result
# a:    the arguments, the program name at 0, which outlive the result
# ret:  the line read, its refusal none when it was read whole
pub fun parse(spec: *Command, a: Args) Parsed {
    var p: Parsed;
    p.args    = a;
    p.root    = spec;
    p.command = spec;
    p.refusal = opt[Refusal].none{};
    var operands: usize = 0;
    var s:        Scan  = scan_from(spec, a);
    for {
        val st: Step = step_of(?s);
        if (sel st.done) { brk; }
        if (sel st.command) {
            p.command = s.cur;
            p.depth   = s.depth;
            operands  = 0;
        }
        or (sel st.operand)      { operands = operands + 1; }
        or (sel st.bare)         { refuse(?p, Refusal.missing_value{Refused{idx: st.bare.idx, at: st.bare.at, tok: a.argv[st.bare.idx]::str, depth: s.depth}}); }
        or (sel st.unknown_flag) { refuse(?p, Refusal.unknown_flag{st.unknown_flag}); }
        or (sel st.unknown_command) {
            refuse(?p, Refusal.unknown_command{st.unknown_command});
            brk;
        }
    }
    p.sep  = s.sep;
    p.rest = s.rest;
    if (sel p.refusal.some)                                                   { ret p; }
    if (operands < p.command.operand_min || operands > p.command.operand_max) { refuse(?p, Refusal.operands{operands}); }
    ret p;
}

# the command at a depth of the matched path
# ---
# p:     the parsed line
# depth: 0 for the root, up to p.depth
# ret:   the command, or nil past the matched path
pub fun command_at(p: *Parsed, depth: usize) *Command {
    var s: Scan = scan_of(p);
    for (s.depth < depth) {
        val st: Step = step_of(?s);
        if (sel st.done || sel st.unknown_command) { ret nil; }
    }
    ret s.cur;
}

# how many times a flag occurred, under either spelling
pub fun occurrences(p: *Parsed, flag: *Flag) usize {
    var n: usize = 0;
    var s: Scan  = scan_of(p);
    for {
        val got: opt[Hit] = next_hit(?s);
        if (sel got.none)          { brk; }
        if (got.some.flag == flag) { n = n + 1; }
    }
    ret n;
}

# whether a flag occurred, negated or not
pub fun given(p: *Parsed, flag: *Flag) bool {
    ret occurrences(p, flag) > 0;
}

# the last occurrence of a flag
# ---
# p:    the parsed line
# flag: the flag
# ret:  the occurrence, none when the flag did not occur
pub fun latest(p: *Parsed, flag: *Flag) opt[Hit] {
    var last: opt[Hit] = opt[Hit].none{};
    var s:    Scan     = scan_of(p);
    for {
        val got: opt[Hit] = next_hit(?s);
        if (sel got.none)          { brk; }
        if (got.some.flag == flag) { last = got; }
    }
    ret last;
}

# whether a flag is on: it occurred and its last occurrence was not negated
pub fun on(p: *Parsed, flag: *Flag) bool {
    val last: opt[Hit] = latest(p, flag);
    ret sel last.some && last.some.on;
}

# the value of a flag's last occurrence, nil when it had none or the flag did not occur
pub fun value(p: *Parsed, flag: *Flag) str {
    val last: opt[Hit] = latest(p, flag);
    if (sel last.some) { ret last.some.value; }
    ret nil;
}

# a walk over one flag's occurrences, in argument order
# ---
# scan: the scan of the parsed line
# flag: the flag walked
pub rec Values {
    scan: Scan;
    flag: *Flag;
}

# walk a flag's occurrences, each as the line gave it, a negated or bare one with a nil value
pub fun values(p: *Parsed, flag: *Flag) Values {
    ret Values{scan: scan_of(p), flag: flag};
}

# take the flag's next occurrence
# ---
# w:   the walk
# ret: the occurrence, or none when the flag occurs no more
pub fun next_value(w: *Values) opt[Hit] {
    for {
        val got: opt[Hit] = next_hit(?w.scan);
        if (sel got.none)            { ret got; }
        if (got.some.flag == w.flag) { ret got; }
    }
    ret opt[Hit].none{};
}

# one step of a parsed line, in argument order
# ---
# done:    no arguments remain
# operand: an operand, by argument index
# hit:     an option, a flag that takes a value with nothing after it giving a nil value
pub tag Event: u8 {
    done;
    operand: usize;
    hit:     Hit;
}

# a walk over a parsed line's operands and options in argument order, for a program whose options
# apply where they stand among its operands. command words and refused tokens are skipped
pub rec Walk {
    scan: Scan;
}

# walk a parsed line
pub fun walk(p: *Parsed) Walk {
    ret Walk{scan: scan_of(p)};
}

# take the next event of a walk
pub fun step(w: *Walk) Event {
    for {
        val st: Step = step_of(?w.scan);
        if (sel st.done)    { ret Event.done{}; }
        if (sel st.operand) { ret Event.operand{st.operand}; }
        if (sel st.hit)     { ret Event.hit{st.hit}; }
        if (sel st.bare)    { ret Event.hit{st.bare}; }
    }
    ret Event.done{};
}

# the number of operands the line gave
pub fun operand_count(p: *Parsed) usize {
    var n: usize = 0;
    var w: Walk  = walk(p);
    for {
        val e: Event = step(?w);
        if (sel e.done)    { brk; }
        if (sel e.operand) { n = n + 1; }
    }
    ret n;
}

# an operand, as given
# ---
# p:   the parsed line
# n:   the operand's position among the operands, 0 the first
# ret: the operand, or none when there are not that many
pub fun operand(p: *Parsed, n: usize) opt[str] {
    var k: usize = 0;
    var w: Walk  = walk(p);
    for {
        val e: Event = step(?w);
        if (sel e.done) { brk; }
        if (sel e.operand) {
            if (k == n) { ret opt[str].some{p.args.argv[e.operand]::str}; }
            k = k + 1;
        }
    }
    ret opt[str].none{};
}

# the arguments after a passthrough command's `--`, as given, empty when there are none
pub fun rest(p: *Parsed) Slice[str] {
    var s: Slice[str];
    if (p.rest >= p.args.argc) { ret s; }
    s.data = ?p.args.argv[p.rest];
    s.size = p.args.argc - p.rest;
    ret s;
}

# the index of the `--` that ended the flags, or the argument count when none did
pub fun separator(p: *Parsed) usize {
    ret p.sep;
}

# a writer that keeps its first failure, so text is written without a test per piece
rec Out {
    w:      *Writer;
    failed: bool;
    error:  WriteError;
}

fun put(o: *Out, s: str) {
    if (o.failed || empty(s)) { ret; }
    val r: err[WriteError] = io_writer.write_str(o.w, s);
    if (sel r.err) {
        o.failed = true;
        o.error  = r.err;
    }
}

fun put_byte(o: *Out, c: u8) {
    var b: [2]u8;
    b[0] = c;
    put(o, (?b[0])::str);
}

fun finish(o: *Out) err[WriteError] {
    if (o.failed) { ret err[WriteError].err{o.error}; }
    ret err[WriteError].ok{};
}

# the option a refusal names: the cluster character, and the token it stands in when there is more
fun put_option(o: *Out, r: Refused) {
    put(o, "'");
    if (r.at == 0) { put(o, r.tok); }
    or {
        put_byte(o, '-');
        put_byte(o, r.tok[r.at]);
        if (r.tok[2] != 0) {
            put(o, "' in '");
            put(o, r.tok);
        }
    }
    put(o, "'");
}

fun put_path(o: *Out, p: *Parsed, depth: usize) {
    var s: Scan = scan_of(p);
    put(o, p.root.name);
    for (s.depth < depth) {
        val st: Step = step_of(?s);
        if (sel st.done || sel st.unknown_command) { ret; }
        if (sel st.command) {
            put(o, " ");
            put(o, s.cur.name);
        }
    }
}

fun put_commands(o: *Out, c: *Command) {
    var i: usize = 0;
    for (i < c.commands.size) {
        if (i > 0) { put(o, ", "); }
        put(o, c.commands.data[i].name);
        i = i + 1;
    }
}

# write a refusal's message, the sentence a program reports it with, without a trailing newline
# ---
# p:   the parsed line
# w:   where the message is written
# ret: ok, nothing written when the line has no refusal, or the write that failed
pub fun describe(p: *Parsed, w: *Writer) err[WriteError] {
    var o: Out;
    o.w = w;
    if (sel p.refusal.none) { ret finish(?o); }
    val r: Refusal = p.refusal.some;
    if (sel r.unknown_flag) {
        put(?o, "unknown flag ");
        put_option(?o, r.unknown_flag);
        put(?o, " for '");
        put_path(?o, p, r.unknown_flag.depth);
        put(?o, "'");
    }
    or (sel r.missing_value) {
        put(?o, "flag ");
        put_option(?o, r.missing_value);
        put(?o, " for '");
        put_path(?o, p, r.missing_value.depth);
        put(?o, "' requires a value");
    }
    or (sel r.unknown_command) {
        put(?o, "unknown command '");
        put(?o, r.unknown_command.tok);
        put(?o, "' for '");
        put_path(?o, p, r.unknown_command.depth);
        put(?o, "'; the commands are ");
        put_commands(?o, command_at(p, r.unknown_command.depth));
    }
    or (sel r.operands) {
        put(?o, "wrong number of operands; usage: ");
        put_path(?o, p, p.depth);
        if (!empty(p.command.usage)) {
            put(?o, " ");
            put(?o, p.command.usage);
        }
    }
    ret finish(?o);
}

val F_ON:  Flag = Flag{long: "on", short: 'o', value: nil, repeat: false, negatable: true, help: "turn it on"};
val F_OUT: Flag = Flag{long: "out", short: 0, value: "path", repeat: false, negatable: false, help: "write here"};

val PLAIN_FLAGS: [2]*Flag = [2]*Flag{?F_ON, ?F_OUT};

val F_EXT:  Flag = Flag{long: "ext", short: 'e', value: "name", repeat: true, negatable: false, help: "an extension"};
val F_INC:  Flag = Flag{long: "inc", short: 'I', value: "dir", repeat: true, negatable: false, help: "an include directory"};
val F_LOUD: Flag = Flag{long: "loud", short: 'l', value: nil, repeat: true, negatable: true, help: "speak up"};

val REPEAT_FLAGS: [4]*Flag = [4]*Flag{?F_EXT, ?F_INC, ?F_LOUD, ?F_ON};

val F_LVL: Flag = Flag{long: "lvl", short: 'L', value: "level", repeat: false, negatable: false, help: "a level"};
val F_TGT: Flag = Flag{long: "tgt", short: 't', value: "name", repeat: false, negatable: false, help: "a target"};
val F_SW:  Flag = Flag{long: "sw", short: 's', value: nil, repeat: false, negatable: true, help: "a switch"};

val OVERRIDE_FLAGS: [3]*Flag = [3]*Flag{?F_LVL, ?F_TGT, ?F_SW};

val T_PLAIN:     Command = Command{name: "prog", aliases: Slice[str]{data: nil, size: 0}, help: "", usage: "[<file>...]", flags: Slice[*Flag]{data: ?PLAIN_FLAGS[0], size: 2}, commands: Slice[*Command]{data: nil, size: 0}, operand_min: 0, operand_max: OPERANDS_ANY, passthrough: false};
val T_REPEATS:   Command = Command{name: "prog", aliases: Slice[str]{data: nil, size: 0}, help: "", usage: "[<file>...]", flags: Slice[*Flag]{data: ?REPEAT_FLAGS[0], size: 4}, commands: Slice[*Command]{data: nil, size: 0}, operand_min: 0, operand_max: OPERANDS_ANY, passthrough: false};
val T_OVERRIDES: Command = Command{name: "prog", aliases: Slice[str]{data: nil, size: 0}, help: "", usage: "[<file>...]", flags: Slice[*Flag]{data: ?OVERRIDE_FLAGS[0], size: 3}, commands: Slice[*Command]{data: nil, size: 0}, operand_min: 0, operand_max: OPERANDS_ANY, passthrough: false};

fun read_as(command: *Command, n: usize, argv: **u8) Parsed {
    ret parse(command, of(n, argv));
}

# whether a flag's walk gives exactly these indices, states and values in order. a nil value
# wants none
fun walks(p: *Parsed, flag: *Flag, idx: *usize, on: *bool, want: *str, n: usize) bool {
    var w: Values = values(p, flag);
    var i: usize  = 0;
    for {
        val h: opt[Hit] = next_value(?w);
        if (sel h.none)                                                                  { brk; }
        if (i >= n || h.some.flag != flag || h.some.idx != idx[i] || h.some.on != on[i]) { ret false; }
        if (want[i] == nil) {
            if (h.some.value != nil) { ret false; }
        }
        or (h.some.value == nil || !str_equals(h.some.value, want[i])) { ret false; }
        i = i + 1;
    }
    ret i == n;
}

# which refusal a parsed line records and at what index, 0 when it records none
fun refusal_at(p: *Parsed) usize {
    if (sel p.refusal.none) { ret 0; }
    val r: Refusal = p.refusal.some;
    if (sel r.unknown_flag)  { ret 1000 + r.unknown_flag.idx; }
    if (sel r.missing_value) { ret 2000 + r.missing_value.idx; }
    ret 9999;
}

test args__cursor_walks_views {
    var v: [3]*u8   = [3]*u8{"prog", "a", "b"};
    var c: Cursor   = cursor(of(3, ?v[0]), 1);
    val a: opt[str] = next(?c);
    val b: opt[str] = next(?c);
    val d: opt[str] = next(?c);
    if (!(sel a.some && str_equals(a.some, "a"))) { ret 1; }
    if (!(sel b.some && str_equals(b.some, "b"))) { ret 2; }
    if (sel d.some)                               { ret 3; }
    ret 0;
}

test args__switch_sets {
    var v: [2]*u8 = [2]*u8{"prog", "--on"};
    var p: Parsed = read_as(?T_PLAIN, 2, ?v[0]);
    if (sel p.refusal.some) { ret 1; }
    if (!on(?p, ?F_ON))     { ret 2; }
    ret 0;
}

test args__negated_switch_clears {
    var v: [2]*u8 = [2]*u8{"prog", "--no-on"};
    var p: Parsed = read_as(?T_PLAIN, 2, ?v[0]);
    if (sel p.refusal.some)                 { ret 1; }
    if (!given(?p, ?F_ON) || on(?p, ?F_ON)) { ret 2; }
    ret 0;
}

test args__value_takes_next_argument {
    var v: [3]*u8 = [3]*u8{"prog", "--out", "--on"};
    var p: Parsed = read_as(?T_PLAIN, 3, ?v[0]);
    if (sel p.refusal.some || given(?p, ?F_ON)) { ret 1; }
    val o: str = value(?p, ?F_OUT);
    if (o == nil || !str_equals(o, "--on")) { ret 2; }
    ret 0;
}

test args__value_follows_equals {
    var v: [2]*u8 = [2]*u8{"prog", "--out=a=b"};
    var p: Parsed = read_as(?T_PLAIN, 2, ?v[0]);
    if (sel p.refusal.some) { ret 1; }
    val o: str = value(?p, ?F_OUT);
    if (o == nil || !str_equals(o, "a=b")) { ret 2; }
    ret 0;
}

test args__operands_keep_their_order {
    var v:    [4]*u8 = [4]*u8{"prog", "a", "-", "b"};
    var p:    Parsed = read_as(?T_PLAIN, 4, ?v[0]);
    var w:    Walk   = walk(?p);
    var want: usize  = 1;
    for (want < 4) {
        val e: Event = step(?w);
        if (!(sel e.operand && e.operand == want)) { ret 1; }
        want = want + 1;
    }
    val end: Event = step(?w);
    if (!(sel end.done)) { ret 2; }
    ret 0;
}

test args__double_dash_ends_options {
    var v: [3]*u8 = [3]*u8{"prog", "--", "--on"};
    var p: Parsed = read_as(?T_PLAIN, 3, ?v[0]);
    if (sel p.refusal.some) { ret 1; }
    val first: opt[str] = operand(?p, 0);
    if (!(sel first.some && str_equals(first.some, "--on"))) { ret 2; }
    if (separator(?p) != 1 || given(?p, ?F_ON))              { ret 3; }
    ret 0;
}

test args__unknown_flag_is_refused_where_it_stands {
    var v: [3]*u8 = [3]*u8{"prog", "a", "--nope"};
    var p: Parsed = read_as(?T_PLAIN, 3, ?v[0]);
    if (refusal_at(?p) != 1002) { ret 1; }
    ret 0;
}

test args__missing_value_is_refused_where_it_stands {
    var v: [2]*u8 = [2]*u8{"prog", "--out"};
    var p: Parsed = read_as(?T_PLAIN, 2, ?v[0]);
    if (refusal_at(?p) != 2001) { ret 1; }
    ret 0;
}

test args__repeat_values_walk_in_order {
    var v: [16]*u8 = [16]*u8{"prog", "--ext=a", "-I", "x", "-e", "--on", "--inc=y", "op", "-eb", "-I", "z", "--", "--ext=c", "-I", "w", "-e"};
    var p: Parsed  = read_as(?T_REPEATS, 16, ?v[0]);
    if (sel p.refusal.some) { ret 1; }
    var ext_idx: [3]usize = [3]usize{1, 4, 8};
    var ext_on:  [3]bool  = [3]bool{true, true, true};
    var ext_val: [3]str   = [3]str{"a", "--on", "b"};
    if (!walks(?p, ?F_EXT, ?ext_idx[0], ?ext_on[0], ?ext_val[0], 3)) { ret 2; }
    var inc_idx: [3]usize = [3]usize{2, 6, 9};
    var inc_on:  [3]bool  = [3]bool{true, true, true};
    var inc_val: [3]str   = [3]str{"x", "y", "z"};
    if (!walks(?p, ?F_INC, ?inc_idx[0], ?inc_on[0], ?inc_val[0], 3)) { ret 3; }
    if (occurrences(?p, ?F_EXT) != 3 || given(?p, ?F_ON))            { ret 4; }
    ret 0;
}

test args__repeat_switch_walks_its_negations {
    var v: [5]*u8 = [5]*u8{"prog", "-l", "--no-loud", "--loud", "-ll"};
    var p: Parsed = read_as(?T_REPEATS, 5, ?v[0]);
    if (sel p.refusal.some) { ret 1; }
    var idx: [5]usize = [5]usize{1, 2, 3, 4, 4};
    var on:  [5]bool  = [5]bool{true, false, true, true, true};
    var val: [5]str   = [5]str{nil, nil, nil, nil, nil};
    if (!walks(?p, ?F_LOUD, ?idx[0], ?on[0], ?val[0], 5)) { ret 2; }
    ret 0;
}

test args__flag_never_given_walks_empty {
    var v: [3]*u8 = [3]*u8{"prog", "--on", "op"};
    var p: Parsed = read_as(?T_REPEATS, 3, ?v[0]);
    if (sel p.refusal.some)                   { ret 1; }
    if (!walks(?p, ?F_EXT, nil, nil, nil, 0)) { ret 2; }
    ret 0;
}

test args__last_occurrence_wins {
    var v: [9]*u8 = [9]*u8{"prog", "--lvl=x", "-t", "a", "-Lz", "--tgt=b", "--lvl=y", "-t", "c"};
    var p: Parsed = read_as(?T_OVERRIDES, 9, ?v[0]);
    if (sel p.refusal.some) { ret 1; }
    val lvl: str = value(?p, ?F_LVL);
    if (lvl == nil || !str_equals(lvl, "y")) { ret 2; }
    val tgt: str = value(?p, ?F_TGT);
    if (tgt == nil || !str_equals(tgt, "c")) { ret 3; }
    val last: opt[Hit] = latest(?p, ?F_TGT);
    if (occurrences(?p, ?F_TGT) != 3)        { ret 4; }
    if (sel last.none)                       { ret 5; }
    if (last.some.idx != 7 || !last.some.on) { ret 5; }
    var lvl_idx: [3]usize = [3]usize{1, 4, 6};
    var lvl_on:  [3]bool  = [3]bool{true, true, true};
    var lvl_val: [3]str   = [3]str{"x", "z", "y"};
    if (!walks(?p, ?F_LVL, ?lvl_idx[0], ?lvl_on[0], ?lvl_val[0], 3)) { ret 6; }
    ret 0;
}

test args__negated_last_reads_off {
    var v: [3]*u8 = [3]*u8{"prog", "-s", "--no-sw"};
    var p: Parsed = read_as(?T_OVERRIDES, 3, ?v[0]);
    if (sel p.refusal.some)                 { ret 1; }
    if (on(?p, ?F_SW) || !given(?p, ?F_SW)) { ret 2; }
    val last: opt[Hit] = latest(?p, ?F_SW);
    if (sel last.none)      { ret 3; }
    if (last.some.idx != 2) { ret 3; }
    ret 0;
}
