# the modules whose tests the std artifact does not reach on every target
# `mach test . -a tests` runs them

use std.runtime;

use std.crypto.hash.fnv1a;

use std.system.capability;

$if (capability.HAS_SOCKETS) {
    use std.net.async.iocp;
    use std.net.resolve.order;
    use resolve_service: std.net.resolve.service;
}

use std.process.limits;
use std.runtime.windows.cmdline;

$if (capability.HAS_CPU_FEATURES) {
    use std.system.cpu;
}

# modules std reaches only through a parent that refuses where a group it needs is missing
$if (!(capability.HAS_CLOCK && capability.HAS_FILES && capability.HAS_THREADS)) {
    use std.log.record;
}

$if (!(capability.HAS_CLOCK && capability.HAS_THREADS)) {
    use std.net.resolve.lines;
}

$if (!(capability.HAS_FILES && capability.HAS_PROCESS && capability.HAS_SOCKETS)) {
    use std.net.local.endpoint;
}

use std.system.dit;
