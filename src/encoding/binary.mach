# binary encoding with explicit byte order
#
# encodes and decodes fixed-width scalars in a chosen endianness. an Encoder
# builds a growable byte sequence, a Builder writes transactional fields into
# fixed storage, and a Decoder reads a checked cursor over existing bytes. all
# carry their Order so layouts never depend on the machine's native order.
#
# only fixed-width unsigned scalars have an unambiguous byte layout, so the
# scalar surface is the named-width write_u*/read_u*/patch_u* family; signed
# and float values reinterpret through the matching width at the call site
# (`v:~u32`). pointers, strings, and variable-length data need a format
# decision (length prefixes, encodings) the caller must make with the
# byte/str operations.
#
# every producing operation reports an EncodeError and every consuming one a
# DecodeError; both are closed tags, and a refused operation leaves its
# encoder, builder or cursor exactly as it was.

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.memory;

use A: std.allocator;

# byte order for multi-byte values
pub def Order: u8;
pub val LITTLE: Order = 0;
pub val BIG:    Order = 1;

# a logical position captured for explicit rollback
pub def Checkpoint: usize;

# every way a write, patch, alignment or reservation can fail
# ---
# alloc:     the encoder's growth was refused; the encoder is unchanged
# overflow:  a length or epoch would not fit usize
# invalid:   the encoder or builder is inconsistent (length past capacity,
#            storage missing for a nonzero width, a nil source for nonzero
#            bytes)
# full:      the fixed builder lacks room; payload is the bytes available
# alignment: the boundary is not a power of two; payload is the boundary
# reserved:  the builder is locked by an active reservation
# bounds:    a patch or checkpoint lies outside the published bytes
# inactive:  the reservation was already resolved, or never made
# stale:     the reservation no longer matches its parent
# busy:      the reservation's child still holds a reservation of its own
pub tag EncodeError: u8 {
    alloc:     A.Error;
    overflow;
    invalid;
    full:      usize;
    alignment: usize;
    reserved;
    bounds;
    inactive;
    stale;
    busy;
}

# every way a read, skip, alignment or checkpoint can fail
# ---
# short:        the request exceeds the bytes remaining; payload is the
#               remaining count
# invalid:      the cursor is inconsistent (position past the end, storage
#               missing for pending bytes)
# alignment:    the boundary is not a power of two; payload is the boundary
# bounds:       a checkpoint lies outside the cursor's past
# unterminated: no null terminator before the end
pub tag DecodeError: u8 {
    short:        usize;
    invalid;
    alignment:    usize;
    bounds;
    unterminated;
}

# write the low sz bytes of v into dst in the given order
# ---
# dst:   destination for sz bytes
# v:     value whose low sz bytes are written
# sz:    number of bytes to write (1..8)
# order: byte order
pub fun put_uint(dst: *u8, v: u64, sz: usize, order: Order) {
    var i: usize = 0;
    for (i < sz) {
        if (order == LITTLE) {
            dst[i] = (v >> (i * 8))::u8;
        } or {
            dst[i] = (v >> ((sz - 1 - i) * 8))::u8;
        }
        i = i + 1;
    }
}

# read sz bytes from src in the given order into a u64
# ---
# src:   source of sz bytes
# sz:    number of bytes to read (1..8)
# order: byte order
# ret:   the assembled value in the low sz bytes
pub fun get_uint(src: *u8, sz: usize, order: Order) u64 {
    var v: u64 = 0;
    var i: usize = 0;
    for (i < sz) {
        val b: u64 = src[i]::u64;
        if (order == LITTLE) {
            v = v | (b << (i * 8));
        } or {
            v = v | (b << ((sz - 1 - i) * 8));
        }
        i = i + 1;
    }
    ret v;
}

# whether width bytes fit in the region beginning at offset
fun span_fits(total: usize, offset: usize, width: usize) bool {
    if (offset > total) { ret false; }
    ret width <= total - offset;
}

# padding required to reach a power-of-two boundary, or none for a boundary
# that is not one
fun alignment_padding(pos: usize, boundary: usize) res[usize, usize] {
    if (boundary == 0) { ret res[usize, usize].err{boundary}; }

    val mask: usize = boundary - 1;
    if ((boundary & mask) != 0) { ret res[usize, usize].err{boundary}; }

    val rem: usize = pos & mask;
    if (rem == 0) { ret res[usize, usize].ok{0}; }
    ret res[usize, usize].ok{boundary - rem};
}

# grow by powers of two without allowing the capacity to wrap
fun growth_capacity(current: usize, need: usize) usize {
    var cap: usize = current;
    if (cap == 0) { cap = 256; }

    for (cap < need) {
        val doubled: usize = cap + cap;
        if (doubled <= cap) { cap = need; brk; }
        cap = doubled;
    }
    ret cap;
}

fun encode_fail(e: EncodeError) res[usize, EncodeError] {
    ret res[usize, EncodeError].err{e};
}

fun encoded(n: usize) res[usize, EncodeError] {
    ret res[usize, EncodeError].ok{n};
}

# growable byte sequence with a fixed byte order
# ---
# alloc: allocator for buffer memory
# order: byte order for multi-byte writes
# data:  backing byte array
# len:   bytes written
# cap:   allocated capacity
pub rec Encoder {
    alloc: *A.Allocator;
    order: Order;
    data:  *u8;
    len:   usize;
    cap:   usize;
}

# create an empty encoder
# ---
# a:     allocator for buffer memory
# order: byte order for multi-byte writes
# ret:   a new empty Encoder
pub fun encoder(a: *A.Allocator, order: Order) Encoder {
    var e: Encoder;
    e.alloc = a;
    e.order = order;
    e.data  = nil;
    e.len   = 0;
    e.cap   = 0;
    ret e;
}

# release the encoder's buffer and reset it
#
# an encoder that owns no buffer is reset without asking the allocator. a
# refused release leaves the encoder owning its buffer.
# ---
# e:   encoder to deinitialize
# ret: ok, or the allocator's refusal
pub fun encoder_dnit(e: *Encoder) err[A.Error] {
    if (e.cap == 0) { e.data = nil; e.len = 0; ret err[A.Error].ok{}; }

    val freed: err[A.Error] = A.deallocate[u8](e.alloc, e.data, e.cap);
    if (sel freed.err) { ret freed; }
    e.data = nil;
    e.len  = 0;
    e.cap  = 0;
    ret err[A.Error].ok{};
}

# ensure capacity for `additional` more bytes
# ---
# e:          encoder to reserve in
# additional: number of additional bytes needed
# ret:        new capacity, or the failure; a refused growth leaves the
#             encoder as it was
pub fun reserve(e: *Encoder, additional: usize) res[usize, EncodeError] {
    if (e.len > e.cap) { ret encode_fail(EncodeError.invalid{}); }
    if (e.cap > 0 && e.data == nil) { ret encode_fail(EncodeError.invalid{}); }

    val need: usize = e.len + additional;
    if (need < e.len)  { ret encode_fail(EncodeError.overflow{}); }
    if (e.cap >= need) { ret encoded(e.cap); }

    val new_cap: usize = growth_capacity(e.cap, need);

    val r: res[*u8, A.Error] = A.reallocate[u8](e.alloc, e.data, e.cap, new_cap);
    if (sel r.err) { ret encode_fail(EncodeError.alloc{r.err}); }

    e.data = r.ok;
    e.cap  = new_cap;
    ret encoded(e.cap);
}

# append sz bytes of v in the encoder's byte order
fun write_uint(e: *Encoder, v: u64, sz: usize) res[usize, EncodeError] {
    val rr: res[usize, EncodeError] = reserve(e, sz);
    if (sel rr.err) { ret rr; }

    put_uint(?e.data[e.len], v, sz, e.order);
    e.len = e.len + sz;
    ret encoded(e.len);
}

# append a u8
# ---
# e:   encoder to write into
# v:   value to append
# ret: new length, or the failure
pub fun write_u8(e: *Encoder, v: u8) res[usize, EncodeError] {
    ret write_uint(e, v::u64, 1);
}

# append a u16 in the encoder's byte order
# ---
# e:   encoder to write into
# v:   value to append
# ret: new length, or the failure
pub fun write_u16(e: *Encoder, v: u16) res[usize, EncodeError] {
    ret write_uint(e, v::u64, 2);
}

# append a u32 in the encoder's byte order
# ---
# e:   encoder to write into
# v:   value to append
# ret: new length, or the failure
pub fun write_u32(e: *Encoder, v: u32) res[usize, EncodeError] {
    ret write_uint(e, v::u64, 4);
}

# append a u64 in the encoder's byte order
# ---
# e:   encoder to write into
# v:   value to append
# ret: new length, or the failure
pub fun write_u64(e: *Encoder, v: u64) res[usize, EncodeError] {
    ret write_uint(e, v, 8);
}

# append raw bytes verbatim
# ---
# e:   encoder to write into
# p:   source bytes
# len: number of bytes
# ret: new length, or the failure
pub fun write_bytes(e: *Encoder, p: *u8, len: usize) res[usize, EncodeError] {
    if (len == 0) { ret encoded(e.len); }
    if (p == nil) { ret encode_fail(EncodeError.invalid{}); }

    val rr: res[usize, EncodeError] = reserve(e, len);
    if (sel rr.err) { ret rr; }

    memory.copy[u8](?e.data[e.len], p, len);
    e.len = e.len + len;
    ret encoded(e.len);
}

# append a string and its null terminator
# ---
# e:   encoder to write into
# s:   string to append
# ret: new length, or the failure
pub fun write_str(e: *Encoder, s: str) res[usize, EncodeError] {
    val slen:  usize = str_len(s);
    if (slen == 0 - 1) { ret encode_fail(EncodeError.overflow{}); }
    val total: usize = slen + 1;

    val rr: res[usize, EncodeError] = reserve(e, total);
    if (sel rr.err) { ret rr; }

    memory.copy[u8](?e.data[e.len], s, slen);
    e.data[e.len + slen] = 0;
    e.len = e.len + total;
    ret encoded(e.len);
}

# pad with zero bytes up to an alignment boundary
# ---
# e:        encoder to align
# boundary: alignment boundary (a power of two)
# ret:      new length, or the failure
pub fun align(e: *Encoder, boundary: usize) res[usize, EncodeError] {
    val pr: res[usize, usize] = alignment_padding(e.len, boundary);
    if (sel pr.err) { ret encode_fail(EncodeError.alignment{pr.err}); }

    val pad: usize = pr.ok;
    val rr: res[usize, EncodeError] = reserve(e, pad);
    if (sel rr.err) { ret rr; }
    if (pad == 0) { ret encoded(e.len); }

    memory.fill[u8](?e.data[e.len], 0, pad);
    e.len = e.len + pad;
    ret encoded(e.len);
}

# overwrite sz bytes of v at an earlier offset without changing length
fun patch_uint(e: *Encoder, offset: usize, v: u64, sz: usize) res[usize, EncodeError] {
    if (!span_fits(e.len, offset, sz)) { ret encode_fail(EncodeError.bounds{}); }

    put_uint(?e.data[offset], v, sz, e.order);
    ret encoded(sz);
}

# overwrite a u8 at an earlier offset without changing length
pub fun patch_u8(e: *Encoder, offset: usize, v: u8) res[usize, EncodeError] {
    ret patch_uint(e, offset, v::u64, 1);
}

# overwrite a u16 at an earlier offset in the encoder's byte order
# ---
# e:      encoder to patch
# offset: byte offset to write at
# v:      value to write
# ret:    bytes written, or the failure
pub fun patch_u16(e: *Encoder, offset: usize, v: u16) res[usize, EncodeError] {
    ret patch_uint(e, offset, v::u64, 2);
}

# overwrite a u32 at an earlier offset in the encoder's byte order
# ---
# e:      encoder to patch
# offset: byte offset to write at
# v:      value to write
# ret:    bytes written, or the failure
pub fun patch_u32(e: *Encoder, offset: usize, v: u32) res[usize, EncodeError] {
    ret patch_uint(e, offset, v::u64, 4);
}

# overwrite a u64 at an earlier offset in the encoder's byte order
# ---
# e:      encoder to patch
# offset: byte offset to write at
# v:      value to write
# ret:    bytes written, or the failure
pub fun patch_u64(e: *Encoder, offset: usize, v: u64) res[usize, EncodeError] {
    ret patch_uint(e, offset, v, 8);
}

# fixed-capacity byte builder with a transactional reservation lock
# ---
# order:    byte order for multi-byte writes
# data:     caller-owned backing bytes
# len:      logically published bytes
# cap:      backing capacity
# reserved: whether a child reservation owns the unpublished tail
# epoch:    monotonically increasing reservation identity
pub rec Builder {
    order:    Order;
    data:     *u8;
    len:      usize;
    cap:      usize;
    reserved: bool;
    epoch:    usize;
}

# unpublished child builder over a reserved parent tail
# ---
# parent: parent whose logical length remains unchanged until commit
# body:   fixed child builder bounded to the reservation
# start:  parent's logical length when the reservation began
# limit:  reserved byte capacity
# epoch:  identity used to reject stale reservation handles
# active: whether the reservation can still commit or roll back
#
# an active reservation and its parent must stay at stable addresses. resolve
# nested reservations before their parents and do not copy active handles.
pub rec Reservation {
    parent: *Builder;
    body:   Builder;
    start:  usize;
    limit:  usize;
    epoch:  usize;
    active: bool;
}

# wrap caller-owned storage as an empty fixed builder
pub fun builder(data: *u8, cap: usize, order: Order) Builder {
    var b: Builder;
    b.order    = order;
    b.data     = data;
    b.len      = 0;
    b.cap      = cap;
    b.reserved = false;
    b.epoch    = 0;
    ret b;
}

# bytes available after the builder's published prefix
pub fun builder_remaining(b: *Builder) usize {
    if (b == nil || b.reserved || b.len > b.cap) { ret 0; }
    ret b.cap - b.len;
}

# validate one atomic fixed-buffer write and return its start
fun builder_prepare(b: *Builder, width: usize) res[usize, EncodeError] {
    if (b.reserved) { ret encode_fail(EncodeError.reserved{}); }
    if (b.len > b.cap) { ret encode_fail(EncodeError.invalid{}); }
    if (width > b.cap - b.len) { ret encode_fail(EncodeError.full{b.cap - b.len}); }
    if (width > 0 && b.data == nil) { ret encode_fail(EncodeError.invalid{}); }
    ret encoded(b.len);
}

# append one fixed-width integer atomically
fun builder_write_uint(b: *Builder, v: u64, width: usize) res[usize, EncodeError] {
    val pr: res[usize, EncodeError] = builder_prepare(b, width);
    if (sel pr.err) { ret pr; }

    val start: usize = pr.ok;
    put_uint(?b.data[start], v, width, b.order);
    b.len = start + width;
    ret encoded(b.len);
}

# append a u8 atomically
pub fun builder_write_u8(b: *Builder, v: u8) res[usize, EncodeError] {
    ret builder_write_uint(b, v::u64, 1);
}

# append a u16 in the builder's byte order atomically
pub fun builder_write_u16(b: *Builder, v: u16) res[usize, EncodeError] {
    ret builder_write_uint(b, v::u64, 2);
}

# append a u32 in the builder's byte order atomically
pub fun builder_write_u32(b: *Builder, v: u32) res[usize, EncodeError] {
    ret builder_write_uint(b, v::u64, 4);
}

# append a u64 in the builder's byte order atomically
pub fun builder_write_u64(b: *Builder, v: u64) res[usize, EncodeError] {
    ret builder_write_uint(b, v, 8);
}

# append raw bytes atomically
pub fun builder_write_bytes(b: *Builder, data: *u8, len: usize) res[usize, EncodeError] {
    if (len > 0 && data == nil) { ret encode_fail(EncodeError.invalid{}); }

    val pr: res[usize, EncodeError] = builder_prepare(b, len);
    if (sel pr.err) { ret pr; }

    val start: usize = pr.ok;
    if (len > 0) { memory.copy[u8](?b.data[start], data, len); }
    b.len = start + len;
    ret encoded(b.len);
}

# append a string and null terminator atomically
pub fun builder_write_str(b: *Builder, s: str) res[usize, EncodeError] {
    val slen: usize = str_len(s);
    if (slen == 0 - 1) { ret encode_fail(EncodeError.overflow{}); }

    val total: usize = slen + 1;
    val pr: res[usize, EncodeError] = builder_prepare(b, total);
    if (sel pr.err) { ret pr; }

    val start: usize = pr.ok;
    if (slen > 0) { memory.copy[u8](?b.data[start], s, slen); }
    b.data[start + slen] = 0;
    b.len = start + total;
    ret encoded(b.len);
}

# append zero padding to a power-of-two boundary atomically
pub fun builder_align(b: *Builder, boundary: usize) res[usize, EncodeError] {
    val ar: res[usize, usize] = alignment_padding(b.len, boundary);
    if (sel ar.err) { ret encode_fail(EncodeError.alignment{ar.err}); }

    val pad: usize = ar.ok;
    val pr: res[usize, EncodeError] = builder_prepare(b, pad);
    if (sel pr.err) { ret pr; }

    val start: usize = pr.ok;
    if (pad > 0) { memory.fill[u8](?b.data[start], 0, pad); }
    b.len = start + pad;
    ret encoded(b.len);
}

# patch a published fixed-width integer without changing length
fun builder_patch_uint(b: *Builder, offset: usize, v: u64, width: usize) res[usize, EncodeError] {
    if (b.reserved) { ret encode_fail(EncodeError.reserved{}); }
    if (!span_fits(b.len, offset, width)) { ret encode_fail(EncodeError.bounds{}); }
    if (width > 0 && b.data == nil) { ret encode_fail(EncodeError.invalid{}); }

    put_uint(?b.data[offset], v, width, b.order);
    ret encoded(width);
}

# patch one published byte without changing length
pub fun builder_patch_u8(b: *Builder, offset: usize, v: u8) res[usize, EncodeError] {
    ret builder_patch_uint(b, offset, v::u64, 1);
}

# patch a published u16 without changing length
pub fun builder_patch_u16(b: *Builder, offset: usize, v: u16) res[usize, EncodeError] {
    ret builder_patch_uint(b, offset, v::u64, 2);
}

# patch a published u32 without changing length
pub fun builder_patch_u32(b: *Builder, offset: usize, v: u32) res[usize, EncodeError] {
    ret builder_patch_uint(b, offset, v::u64, 4);
}

# patch a published u64 without changing length
pub fun builder_patch_u64(b: *Builder, offset: usize, v: u64) res[usize, EncodeError] {
    ret builder_patch_uint(b, offset, v, 8);
}

# capture the current fixed-builder length for explicit rollback
pub fun builder_checkpoint(b: *Builder) res[Checkpoint, EncodeError] {
    if (b.reserved) { ret res[Checkpoint, EncodeError].err{EncodeError.reserved{}}; }
    if (b.len > b.cap) { ret res[Checkpoint, EncodeError].err{EncodeError.invalid{}}; }
    ret res[Checkpoint, EncodeError].ok{b.len};
}

# restore a prior builder checkpoint without changing backing bytes
pub fun builder_rollback(b: *Builder, mark: Checkpoint) res[usize, EncodeError] {
    if (b.reserved) { ret encode_fail(EncodeError.reserved{}); }
    if (b.len > b.cap) { ret encode_fail(EncodeError.invalid{}); }
    if (mark > b.len) { ret encode_fail(EncodeError.bounds{}); }

    b.len = mark;
    ret encoded(b.len);
}

# lock capacity for a child field without publishing parent length
pub fun builder_reserve(b: *Builder, capacity: usize) res[Reservation, EncodeError] {
    if (b.reserved) { ret res[Reservation, EncodeError].err{EncodeError.reserved{}}; }
    if (b.len > b.cap) { ret res[Reservation, EncodeError].err{EncodeError.invalid{}}; }
    if (capacity > b.cap - b.len) { ret res[Reservation, EncodeError].err{EncodeError.full{b.cap - b.len}}; }
    if (capacity > 0 && b.data == nil) { ret res[Reservation, EncodeError].err{EncodeError.invalid{}}; }
    if (b.epoch == 0 - 1) { ret res[Reservation, EncodeError].err{EncodeError.overflow{}}; }

    var child_data: *u8 = nil;
    if (capacity > 0) { child_data = ?b.data[b.len]; }

    b.epoch = b.epoch + 1;
    b.reserved = true;

    var r: Reservation;
    r.parent = b;
    r.body   = builder(child_data, capacity, b.order);
    r.start  = b.len;
    r.limit  = capacity;
    r.epoch  = b.epoch;
    r.active = true;
    ret res[Reservation, EncodeError].ok{r};
}

# invalidate a resolved reservation and revoke its child builder
fun reservation_close(r: *Reservation) {
    val order: Order = r.body.order;
    r.parent = nil;
    r.body   = builder(nil, 0, order);
    r.start  = 0;
    r.limit  = 0;
    r.epoch  = 0;
    r.active = false;
}

# publish the completed prefix of a reservation as one logical field
pub fun builder_commit(r: *Reservation) res[usize, EncodeError] {
    if (!r.active || r.parent == nil) { ret encode_fail(EncodeError.inactive{}); }

    val b: *Builder = r.parent;
    if (!b.reserved || b.epoch != r.epoch || b.len != r.start) { ret encode_fail(EncodeError.stale{}); }
    if (r.body.reserved) { ret encode_fail(EncodeError.busy{}); }
    if (r.body.len > r.body.cap || r.body.cap != r.limit) { ret encode_fail(EncodeError.invalid{}); }
    if (!span_fits(b.cap, r.start, r.limit)) { ret encode_fail(EncodeError.invalid{}); }
    if (r.body.len > r.limit) { ret encode_fail(EncodeError.invalid{}); }

    b.len = r.start + r.body.len;
    b.reserved = false;
    reservation_close(r);
    ret encoded(b.len);
}

# discard an unpublished reservation and unlock its parent
pub fun reservation_rollback(r: *Reservation) res[usize, EncodeError] {
    if (!r.active || r.parent == nil) { ret encode_fail(EncodeError.inactive{}); }

    val b: *Builder = r.parent;
    if (!b.reserved || b.epoch != r.epoch || b.len != r.start) { ret encode_fail(EncodeError.stale{}); }
    if (r.body.reserved) { ret encode_fail(EncodeError.busy{}); }

    b.reserved = false;
    reservation_close(r);
    ret encoded(b.len);
}

# cursor over existing bytes with a fixed byte order
# ---
# order: byte order for multi-byte reads
# data:  byte data
# len:   total length in bytes
# pos:   current read position
pub rec Decoder {
    order: Order;
    data:  *u8;
    len:   usize;
    pos:   usize;
}

# checked borrowed cursor, retained as an alias of Decoder for compatibility
pub def Cursor: Decoder;

# wrap existing bytes as a decoder positioned at offset 0
# ---
# data:  byte data
# len:   length in bytes
# order: byte order for multi-byte reads
# ret:   a new Decoder
pub fun decoder(data: *u8, len: usize, order: Order) Decoder {
    var d: Decoder;
    d.order = order;
    d.data  = data;
    d.len   = len;
    d.pos   = 0;
    ret d;
}

# wrap existing bytes as a checked cursor positioned at offset 0
pub fun cursor(data: *u8, len: usize, order: Order) Cursor {
    ret decoder(data, len, order);
}

# the failure for a request of `width` bytes the cursor cannot satisfy
fun too_short(d: *Decoder) DecodeError {
    if (d.pos > d.len) { ret DecodeError.invalid{}; }
    ret DecodeError.short{d.len - d.pos};
}

# read sz bytes in the decoder's byte order and advance
fun read_uint(d: *Decoder, sz: usize) res[u64, DecodeError] {
    if (!span_fits(d.len, d.pos, sz)) { ret res[u64, DecodeError].err{too_short(d)}; }
    if (sz > 0 && d.data == nil) { ret res[u64, DecodeError].err{DecodeError.invalid{}}; }

    val v: u64 = get_uint(?d.data[d.pos], sz, d.order);
    d.pos = d.pos + sz;
    ret res[u64, DecodeError].ok{v};
}

# read a u8 and advance
# ---
# d:   decoder to read from
# ret: the value, or the failure
pub fun read_u8(d: *Decoder) res[u8, DecodeError] {
    val r: res[u64, DecodeError] = read_uint(d, 1);
    if (sel r.err) { ret res[u8, DecodeError].err{r.err}; }
    ret res[u8, DecodeError].ok{r.ok::u8};
}

# read a u16 in the decoder's byte order and advance
# ---
# d:   decoder to read from
# ret: the value, or the failure
pub fun read_u16(d: *Decoder) res[u16, DecodeError] {
    val r: res[u64, DecodeError] = read_uint(d, 2);
    if (sel r.err) { ret res[u16, DecodeError].err{r.err}; }
    ret res[u16, DecodeError].ok{r.ok::u16};
}

# read a u32 in the decoder's byte order and advance
# ---
# d:   decoder to read from
# ret: the value, or the failure
pub fun read_u32(d: *Decoder) res[u32, DecodeError] {
    val r: res[u64, DecodeError] = read_uint(d, 4);
    if (sel r.err) { ret res[u32, DecodeError].err{r.err}; }
    ret res[u32, DecodeError].ok{r.ok::u32};
}

# read a u64 in the decoder's byte order and advance
# ---
# d:   decoder to read from
# ret: the value, or the failure
pub fun read_u64(d: *Decoder) res[u64, DecodeError] {
    ret read_uint(d, 8);
}

# return a pointer to the next `len` bytes and advance past them
# ---
# d:   decoder to read from
# len: number of bytes to consume
# ret: pointer into the decoder's data (nil for a zero-length request), or
#      the failure
pub fun read_bytes(d: *Decoder, len: usize) res[*u8, DecodeError] {
    if (!span_fits(d.len, d.pos, len)) { ret res[*u8, DecodeError].err{too_short(d)}; }
    if (len == 0) { ret res[*u8, DecodeError].ok{nil}; }
    if (d.data == nil) { ret res[*u8, DecodeError].err{DecodeError.invalid{}}; }

    val p: *u8 = ?d.data[d.pos];
    d.pos = d.pos + len;
    ret res[*u8, DecodeError].ok{p};
}

# read a null-terminated string and advance past the terminator
# ---
# d:   decoder to read from
# ret: pointer to the string within the data, or the failure
pub fun read_str(d: *Decoder) res[str, DecodeError] {
    if (d.pos > d.len) { ret res[str, DecodeError].err{DecodeError.invalid{}}; }
    if (d.pos < d.len && d.data == nil) { ret res[str, DecodeError].err{DecodeError.invalid{}}; }

    var i: usize = d.pos;
    for (i < d.len) {
        if (d.data[i] == 0) {
            val s: str = ?d.data[d.pos];
            d.pos = i + 1;
            ret res[str, DecodeError].ok{s};
        }
        i = i + 1;
    }
    ret res[str, DecodeError].err{DecodeError.unterminated{}};
}

# advance the cursor by n bytes
# ---
# d:   decoder to advance
# n:   number of bytes to skip
# ret: new position, or the failure
pub fun skip(d: *Decoder, n: usize) res[usize, DecodeError] {
    if (!span_fits(d.len, d.pos, n)) { ret res[usize, DecodeError].err{too_short(d)}; }
    d.pos = d.pos + n;
    ret res[usize, DecodeError].ok{d.pos};
}

# advance the cursor to an alignment boundary
# ---
# d:        decoder to align
# boundary: alignment boundary (a power of two)
# ret:      new position, or the failure
pub fun align_read(d: *Decoder, boundary: usize) res[usize, DecodeError] {
    if (d.pos > d.len) { ret res[usize, DecodeError].err{DecodeError.invalid{}}; }

    val ar: res[usize, usize] = alignment_padding(d.pos, boundary);
    if (sel ar.err) { ret res[usize, DecodeError].err{DecodeError.alignment{ar.err}}; }
    ret skip(d, ar.ok);
}

# return a bounded child cursor and advance only after validation
pub fun read_subview(d: *Decoder, len: usize) res[Cursor, DecodeError] {
    if (!span_fits(d.len, d.pos, len)) { ret res[Cursor, DecodeError].err{too_short(d)}; }
    if (len > 0 && d.data == nil) { ret res[Cursor, DecodeError].err{DecodeError.invalid{}}; }

    var data: *u8 = nil;
    if (len > 0) { data = ?d.data[d.pos]; }

    val sub: Cursor = cursor(data, len, d.order);
    d.pos = d.pos + len;
    ret res[Cursor, DecodeError].ok{sub};
}

# capture a cursor position for speculative decoding
pub fun cursor_checkpoint(d: *Decoder) res[Checkpoint, DecodeError] {
    if (d.pos > d.len) { ret res[Checkpoint, DecodeError].err{DecodeError.invalid{}}; }
    ret res[Checkpoint, DecodeError].ok{d.pos};
}

# restore an earlier cursor checkpoint
pub fun cursor_rollback(d: *Decoder, mark: Checkpoint) res[usize, DecodeError] {
    if (d.pos > d.len) { ret res[usize, DecodeError].err{DecodeError.invalid{}}; }
    if (mark > d.pos) { ret res[usize, DecodeError].err{DecodeError.bounds{}}; }

    d.pos = mark;
    ret res[usize, DecodeError].ok{d.pos};
}

# bytes remaining between the cursor and the end
# ---
# d:   decoder to query
# ret: unread byte count
pub fun remaining(d: *Decoder) usize {
    if (d == nil || d.pos > d.len) { ret 0; }
    ret d.len - d.pos;
}

# test predicates: `sel` takes a place, so an outcome tested inline goes
# through one of these
fun enc_ok(r: res[usize, EncodeError]) bool { ret sel r.ok; }
fun res_ok(r: res[Reservation, EncodeError]) bool { ret sel r.ok; }
fun mark_ok(r: res[Checkpoint, EncodeError]) bool { ret sel r.ok; }
fun dec_ok(r: res[usize, DecodeError]) bool { ret sel r.ok; }
fun bytes_ok(r: res[*u8, DecodeError]) bool { ret sel r.ok; }
fun str_ok(r: res[str, DecodeError]) bool { ret sel r.ok; }
fun view_ok(r: res[Cursor, DecodeError]) bool { ret sel r.ok; }
fun cmark_ok(r: res[Checkpoint, DecodeError]) bool { ret sel r.ok; }
fun u8_ok(r: res[u8, DecodeError]) bool { ret sel r.ok; }
fun u16_ok(r: res[u16, DecodeError]) bool { ret sel r.ok; }
fun u32_ok(r: res[u32, DecodeError]) bool { ret sel r.ok; }
fun u64_ok(r: res[u64, DecodeError]) bool { ret sel r.ok; }

test "binary cursor: exhaustive small-region reads preserve failure position" {
    var data: [16]u8;
    var i: usize = 0;
    for (i < 16) {
        data[i] = (i + 1)::u8;
        i = i + 1;
    }

    var region_len: usize = 0;
    for (region_len <= 16) {
        var offset: usize = 0;
        for (offset <= 17) {
            var width: usize = 0;
            for (width <= 17) {
                var d: Decoder = decoder(?data[0], region_len, LITTLE);
                d.pos = offset;
                val before: usize = d.pos;
                val r: res[*u8, DecodeError] = read_bytes(?d, width);

                var fits: bool = false;
                if (offset <= region_len && width <= region_len - offset) { fits = true; }

                if (sel r.ok != fits) { ret 1; }
                if (!fits && d.pos != before) { ret 1; }
                if (fits && d.pos != before + width) { ret 1; }
                if (sel r.ok) {
                    if (width == 0 && r.ok != nil) { ret 1; }
                    if (width > 0 && r.ok != ?data[offset]) { ret 1; }
                }

                width = width + 1;
            }
            offset = offset + 1;
        }
        region_len = region_len + 1;
    }
    ret 0;
}

test "binary cursor: exhaustive scalar widths obey the region and byte order" {
    var data: [16]u8;
    var i: usize = 0;
    for (i < 16) {
        data[i] = (0x80 + i)::u8;
        i = i + 1;
    }

    var order: Order = LITTLE;
    for (order <= BIG) {
        var region_len: usize = 0;
        for (region_len <= 16) {
            var offset: usize = 0;
            for (offset <= 17) {
                var width: usize = 1;
                for (width <= 8) {
                    var d: Decoder = decoder(?data[0], region_len, order);
                    d.pos = offset;
                    val before: usize = d.pos;
                    val r: res[u64, DecodeError] = read_uint(?d, width);

                    var fits: bool = false;
                    if (offset <= region_len && width <= region_len - offset) { fits = true; }

                    if (sel r.ok != fits) { ret 1; }
                    if (!fits && d.pos != before) { ret 1; }
                    if (fits && d.pos != before + width) { ret 1; }
                    if (sel r.ok) {
                        if (r.ok != get_uint(?data[offset], width, order)) { ret 1; }
                    }

                    width = width + 1;
                }
                offset = offset + 1;
            }
            region_len = region_len + 1;
        }
        order = order + 1;
    }
    ret 0;
}

test "binary cursor: exhaustive skips and subviews are transactional" {
    var data: [16]u8;
    var region_len: usize = 0;
    for (region_len <= 16) {
        var offset: usize = 0;
        for (offset <= 17) {
            var width: usize = 0;
            for (width <= 17) {
                var fits: bool = false;
                if (offset <= region_len && width <= region_len - offset) { fits = true; }

                var ds: Decoder = decoder(?data[0], region_len, BIG);
                ds.pos = offset;
                val sr: res[usize, DecodeError] = skip(?ds, width);
                if (sel sr.ok != fits) { ret 1; }
                if (!fits && ds.pos != offset) { ret 1; }
                if (fits && ds.pos != offset + width) { ret 1; }

                var dv: Decoder = decoder(?data[0], region_len, BIG);
                dv.pos = offset;
                val vr: res[Cursor, DecodeError] = read_subview(?dv, width);
                if (sel vr.ok != fits) { ret 1; }
                if (!fits && dv.pos != offset) { ret 1; }
                if (fits && dv.pos != offset + width) { ret 1; }
                if (sel vr.ok) {
                    val sub: Cursor = vr.ok;
                    if (sub.len != width || sub.pos != 0 || sub.order != BIG) { ret 1; }
                    if (width == 0 && sub.data != nil) { ret 1; }
                    if (width > 0 && sub.data != ?data[offset]) { ret 1; }
                }

                width = width + 1;
            }
            offset = offset + 1;
        }
        region_len = region_len + 1;
    }
    ret 0;
}

test "binary cursor: operation sequences match a reference position model" {
    var data: [32]u8;
    var seed: usize = 0;
    for (seed < 128) {
        val region_len: usize = seed % 33;
        var d: Decoder = decoder(?data[0], region_len, LITTLE);
        var model: usize = seed % (region_len + 1);
        d.pos = model;

        var state: usize = seed + 1;
        var step: usize = 0;
        for (step < 64) {
            state = state * 1664525 + 1013904223;
            val width: usize = (state >> 8) % 12;
            val kind: usize = state & 1;
            val fits: bool = width <= region_len - model;

            if (kind == 0) {
                val r: res[usize, DecodeError] = skip(?d, width);
                if (sel r.ok != fits) { ret 1; }
            } or {
                val r: res[*u8, DecodeError] = read_bytes(?d, width);
                if (sel r.ok != fits) { ret 1; }
            }

            if (fits) { model = model + width; }
            if (d.pos != model || remaining(?d) != region_len - model) { ret 1; }
            step = step + 1;
        }
        seed = seed + 1;
    }
    ret 0;
}

test "binary cursor: checkpoints restore only earlier valid positions" {
    var data: [16]u8;
    var d: Decoder = decoder(?data[0], 16, LITTLE);
    if (!u16_ok(read_u16(?d))) { ret 1; }

    val mr: res[Checkpoint, DecodeError] = cursor_checkpoint(?d);
    if (sel mr.err) { ret 1; }
    val mark: Checkpoint = mr.ok;

    if (!u32_ok(read_u32(?d))) { ret 1; }
    if (d.pos != 6) { ret 1; }
    if (!dec_ok(cursor_rollback(?d, mark))) { ret 1; }
    if (d.pos != 2) { ret 1; }

    val failed: res[usize, DecodeError] = cursor_rollback(?d, 3);
    if (sel failed.ok || d.pos != 2) { ret 1; }
    ret 0;
}

test "binary cursor: failed string scan preserves position" {
    var data: [8]u8;
    memory.fill[u8](?data[0], 0x41, 8);
    var d: Decoder = decoder(?data[0], 8, LITTLE);
    d.pos = 2;
    if (str_ok(read_str(?d)) || d.pos != 2) { ret 1; }

    data[5] = 0;
    val r: res[str, DecodeError] = read_str(?d);
    if (sel r.err || d.pos != 6) { ret 1; }

    d.pos = 0 - 1;
    if (str_ok(read_str(?d)) || d.pos != 0 - 1) { ret 1; }
    ret 0;
}

test "binary cursor: malformed positions and huge widths never wrap" {
    var data: [8]u8;
    val max: usize = 0 - 1;

    var d: Decoder = decoder(?data[0], 8, LITTLE);
    d.pos = max;
    if (bytes_ok(read_bytes(?d, 1)) || d.pos != max) { ret 1; }
    if (dec_ok(skip(?d, 1)) || d.pos != max) { ret 1; }
    if (view_ok(read_subview(?d, 1)) || d.pos != max) { ret 1; }
    if (dec_ok(align_read(?d, 8)) || d.pos != max) { ret 1; }
    if (remaining(?d) != 0) { ret 1; }

    d.pos = 1;
    if (bytes_ok(read_bytes(?d, max)) || d.pos != 1) { ret 1; }
    if (dec_ok(skip(?d, max)) || d.pos != 1) { ret 1; }

    d.pos = 3;
    if (dec_ok(align_read(?d, 0)) || d.pos != 3) { ret 1; }
    if (dec_ok(align_read(?d, 3)) || d.pos != 3) { ret 1; }
    ret 0;
}

test "binary builder: exhaustive small-region writes preserve failure state" {
    var backing: [32]u8;
    var input: [17]u8;
    var i: usize = 0;
    for (i < 17) {
        input[i] = (i + 1)::u8;
        i = i + 1;
    }

    var cap: usize = 0;
    for (cap <= 16) {
        var offset: usize = 0;
        for (offset <= cap + 1) {
            var width: usize = 0;
            for (width <= 17) {
                i = 0;
                for (i < 32) {
                    backing[i] = 0xA5;
                    i = i + 1;
                }

                var b: Builder = builder(?backing[0], cap, BIG);
                b.len = offset;
                val r: res[usize, EncodeError] = builder_write_bytes(?b, ?input[0], width);

                var fits: bool = false;
                if (offset <= cap && width <= cap - offset) { fits = true; }
                if (sel r.ok != fits) { ret 1; }
                if (!fits && b.len != offset) { ret 1; }
                if (fits && b.len != offset + width) { ret 1; }

                i = 0;
                for (i < 32) {
                    var expected: u8 = 0xA5;
                    if (fits && i >= offset && i < offset + width) {
                        expected = input[i - offset];
                    }
                    if (backing[i] != expected) { ret 1; }
                    i = i + 1;
                }

                width = width + 1;
            }
            offset = offset + 1;
        }
        cap = cap + 1;
    }
    ret 0;
}

test "binary builder: scalar output matches the growable encoder" {
    var order: Order = LITTLE;
    for (order <= BIG) {
        var fixed_data: [32]u8;
        var encoded_data: [32]u8;
        var b: Builder = builder(?fixed_data[0], 32, order);
        var e: Encoder;
        e.alloc = nil;
        e.order = order;
        e.data = ?encoded_data[0];
        e.len = 0;
        e.cap = 32;

        if (!enc_ok(builder_write_u8(?b, 0x12))) { ret 1; }
        if (!enc_ok(builder_write_u16(?b, 0x3456))) { ret 1; }
        if (!enc_ok(builder_write_u32(?b, 0x789ABCDE))) { ret 1; }
        if (!enc_ok(builder_write_u64(?b, 0x0123456789ABCDEF))) { ret 1; }

        if (!enc_ok(write_u8(?e, 0x12))) { ret 1; }
        if (!enc_ok(write_u16(?e, 0x3456))) { ret 1; }
        if (!enc_ok(write_u32(?e, 0x789ABCDE))) { ret 1; }
        if (!enc_ok(write_u64(?e, 0x0123456789ABCDEF))) { ret 1; }

        if (b.len != e.len) { ret 1; }
        var i: usize = 0;
        for (i < b.len) {
            if (b.data[i] != e.data[i]) { ret 1; }
            i = i + 1;
        }
        order = order + 1;
    }
    ret 0;
}

test "binary builder: scalar wrappers round trip through the checked cursor" {
    var data: [32]u8;
    var order: Order = LITTLE;
    for (order <= BIG) {
        var b: Builder = builder(?data[0], 32, order);
        if (!enc_ok(builder_write_u8(?b, 0x12))) { ret 1; }
        if (!enc_ok(builder_write_u16(?b, 0x3456))) { ret 1; }
        if (!enc_ok(builder_write_u32(?b, 0x789ABCDE))) { ret 1; }
        if (!enc_ok(builder_write_u64(?b, 0x0123456789ABCDEF))) { ret 1; }

        var c: Cursor = cursor(?data[0], b.len, order);
        val u8r: res[u8, DecodeError] = read_u8(?c);
        val u16r: res[u16, DecodeError] = read_u16(?c);
        val u32r: res[u32, DecodeError] = read_u32(?c);
        val u64r: res[u64, DecodeError] = read_u64(?c);
        if (!sel u8r.ok) { ret 1; }
        if (u8r.ok != 0x12) { ret 1; }
        if (!sel u16r.ok) { ret 1; }
        if (u16r.ok != 0x3456) { ret 1; }
        if (!sel u32r.ok) { ret 1; }
        if (u32r.ok != 0x789ABCDE) { ret 1; }
        if (!sel u64r.ok) { ret 1; }
        if (u64r.ok != 0x0123456789ABCDEF) { ret 1; }
        if (remaining(?c) != 0) { ret 1; }
        order = order + 1;
    }
    ret 0;
}

test "binary builder: strings and alignment publish only after full validation" {
    var data: [16]u8;
    memory.fill[u8](?data[0], 0xA5, 16);
    var b: Builder = builder(?data[0], 16, BIG);

    if (!enc_ok(builder_write_str(?b, "ab"))) { ret 1; }
    if (b.len != 3 || data[0] != 'a' || data[1] != 'b' || data[2] != 0) { ret 1; }
    if (!enc_ok(builder_align(?b, 4))) { ret 1; }
    if (b.len != 4 || data[3] != 0) { ret 1; }

    b.cap = 6;
    if (!enc_ok(builder_write_u8(?b, 0x11))) { ret 1; }
    if (enc_ok(builder_align(?b, 8)) || b.len != 5) { ret 1; }
    if (data[5] != 0xA5) { ret 1; }
    if (enc_ok(builder_write_str(?b, "x")) || b.len != 5) { ret 1; }
    if (data[5] != 0xA5) { ret 1; }
    ret 0;
}

test "binary builder: reservation bounds are exhaustive and transactional" {
    var data: [16]u8;
    var cap: usize = 0;
    for (cap <= 16) {
        var offset: usize = 0;
        for (offset <= cap + 1) {
            var capacity: usize = 0;
            for (capacity <= 17) {
                memory.fill[u8](?data[0], 0xA5, 16);
                var b: Builder = builder(?data[0], cap, BIG);
                b.len = offset;
                b.epoch = 5;

                val rr: res[Reservation, EncodeError] = builder_reserve(?b, capacity);
                var fits: bool = false;
                if (offset <= cap && capacity <= cap - offset) { fits = true; }
                if (sel rr.ok != fits) { ret 1; }

                if (!fits) {
                    if (b.len != offset || b.cap != cap || b.reserved || b.epoch != 5) { ret 1; }
                }
                if (sel rr.ok) {
                    if (b.len != offset || !b.reserved || b.epoch != 6) { ret 1; }
                    if (builder_remaining(?b) != 0) { ret 1; }
                    var reservation: Reservation = rr.ok;
                    if (reservation.start != offset || reservation.limit != capacity) { ret 1; }
                    if (reservation.body.len != 0 || reservation.body.cap != capacity) { ret 1; }
                    if (!enc_ok(reservation_rollback(?reservation))) { ret 1; }
                    if (b.len != offset || b.reserved || b.epoch != 6) { ret 1; }
                }

                var i: usize = 0;
                for (i < 16) {
                    if (data[i] != 0xA5) { ret 1; }
                    i = i + 1;
                }
                capacity = capacity + 1;
            }
            offset = offset + 1;
        }
        cap = cap + 1;
    }
    ret 0;
}

test "binary builder: reservation commits one length-prefixed field" {
    var data: [32]u8;
    var payload: [3]u8 = [3]u8{0xAA, 0xBB, 0xCC};
    var b: Builder = builder(?data[0], 32, BIG);

    val rr: res[Reservation, EncodeError] = builder_reserve(?b, 16);
    if (sel rr.err) { ret 1; }
    var r: Reservation = rr.ok;
    if (b.len != 0 || !b.reserved) { ret 1; }

    if (!enc_ok(builder_write_u16(?r.body, 0))) { ret 1; }
    if (!enc_ok(builder_write_bytes(?r.body, ?payload[0], 3))) { ret 1; }
    if (!enc_ok(builder_patch_u16(?r.body, 0, 3))) { ret 1; }
    if (b.len != 0) { ret 1; }

    val cr: res[usize, EncodeError] = builder_commit(?r);
    if (sel cr.err || b.len != 5 || b.reserved) { ret 1; }
    if (data[0] != 0 || data[1] != 3) { ret 1; }
    if (data[2] != 0xAA || data[3] != 0xBB || data[4] != 0xCC) { ret 1; }
    ret 0;
}

test "binary builder: nested reservations commit inside out" {
    var data: [32]u8;
    var root: Builder = builder(?data[0], 32, LITTLE);

    val orr: res[Reservation, EncodeError] = builder_reserve(?root, 16);
    if (sel orr.err) { ret 1; }
    var outer: Reservation = orr.ok;
    if (!enc_ok(builder_write_u8(?outer.body, 0xAA))) { ret 1; }

    val irr: res[Reservation, EncodeError] = builder_reserve(?outer.body, 8);
    if (sel irr.err) { ret 1; }
    var inner: Reservation = irr.ok;
    if (!enc_ok(builder_write_u32(?inner.body, 0x11223344))) { ret 1; }
    if (enc_ok(builder_commit(?outer))) { ret 1; }
    if (root.len != 0 || !root.reserved || !outer.body.reserved) { ret 1; }
    if (enc_ok(reservation_rollback(?outer))) { ret 1; }
    if (root.len != 0 || !root.reserved || !outer.body.reserved) { ret 1; }
    if (!enc_ok(builder_commit(?inner))) { ret 1; }
    if (!enc_ok(builder_write_u8(?outer.body, 0xBB))) { ret 1; }
    if (root.len != 0) { ret 1; }
    if (!enc_ok(builder_commit(?outer))) { ret 1; }

    if (root.len != 6) { ret 1; }
    if (data[0] != 0xAA || data[1] != 0x44 || data[2] != 0x33) { ret 1; }
    if (data[3] != 0x22 || data[4] != 0x11 || data[5] != 0xBB) { ret 1; }
    ret 0;
}

test "binary builder: failed child write and reservation rollback publish nothing" {
    var data: [8]u8;
    memory.fill[u8](?data[0], 0xCC, 8);
    var b: Builder = builder(?data[0], 8, BIG);
    if (!enc_ok(builder_write_u8(?b, 0x11))) { ret 1; }

    val rr: res[Reservation, EncodeError] = builder_reserve(?b, 4);
    if (sel rr.err) { ret 1; }
    var r: Reservation = rr.ok;

    if (enc_ok(builder_write_u64(?r.body, 1))) { ret 1; }
    if (r.body.len != 0 || b.len != 1) { ret 1; }
    if (data[1] != 0xCC || data[4] != 0xCC) { ret 1; }

    if (!enc_ok(builder_write_u32(?r.body, 0xAABBCCDD))) { ret 1; }
    if (b.len != 1) { ret 1; }
    if (!enc_ok(reservation_rollback(?r))) { ret 1; }
    if (b.len != 1 || b.reserved) { ret 1; }

    if (!enc_ok(builder_write_u8(?b, 0x22))) { ret 1; }
    if (b.len != 2 || data[1] != 0x22) { ret 1; }
    ret 0;
}

test "binary builder: malformed and stale commits leave the parent unchanged" {
    var data: [16]u8;
    var b: Builder = builder(?data[0], 16, LITTLE);

    val rr: res[Reservation, EncodeError] = builder_reserve(?b, 4);
    if (sel rr.err) { ret 1; }
    var malformed: Reservation = rr.ok;
    malformed.body.len = 5;
    if (enc_ok(builder_commit(?malformed))) { ret 1; }
    if (b.len != 0 || !b.reserved || !malformed.active) { ret 1; }
    if (!enc_ok(reservation_rollback(?malformed))) { ret 1; }

    val first_r: res[Reservation, EncodeError] = builder_reserve(?b, 4);
    if (sel first_r.err) { ret 1; }
    var first: Reservation = first_r.ok;
    var stale: Reservation = first;
    if (!enc_ok(reservation_rollback(?first))) { ret 1; }

    val second_r: res[Reservation, EncodeError] = builder_reserve(?b, 4);
    if (sel second_r.err) { ret 1; }
    var second: Reservation = second_r.ok;
    if (enc_ok(builder_commit(?stale))) { ret 1; }
    if (b.len != 0 || !b.reserved) { ret 1; }
    if (!enc_ok(reservation_rollback(?second))) { ret 1; }
    ret 0;
}

test "binary builder: checkpoints and locked parents roll back explicitly" {
    var data: [16]u8;
    var b: Builder = builder(?data[0], 16, BIG);
    if (!enc_ok(builder_write_u16(?b, 0x1234))) { ret 1; }

    val mr: res[Checkpoint, EncodeError] = builder_checkpoint(?b);
    if (sel mr.err) { ret 1; }
    val mark: Checkpoint = mr.ok;
    if (!enc_ok(builder_write_u32(?b, 0x55667788))) { ret 1; }
    if (!enc_ok(builder_rollback(?b, mark))) { ret 1; }
    if (b.len != 2) { ret 1; }

    if (enc_ok(builder_rollback(?b, 3)) || b.len != 2) { ret 1; }
    val rr: res[Reservation, EncodeError] = builder_reserve(?b, 4);
    if (sel rr.err) { ret 1; }
    var reservation: Reservation = rr.ok;
    if (mark_ok(builder_checkpoint(?b)) || b.len != 2) { ret 1; }
    if (enc_ok(builder_rollback(?b, 0)) || b.len != 2) { ret 1; }
    if (!enc_ok(reservation_rollback(?reservation))) { ret 1; }
    ret 0;
}

test "binary builder: patch failures leave length and bytes unchanged" {
    var data: [8]u8;
    memory.fill[u8](?data[0], 0xA5, 8);
    var b: Builder = builder(?data[0], 8, LITTLE);
    b.len = 4;

    if (enc_ok(builder_patch_u64(?b, 0, 1))) { ret 1; }
    if (b.len != 4) { ret 1; }
    var i: usize = 0;
    for (i < 8) {
        if (data[i] != 0xA5) { ret 1; }
        i = i + 1;
    }

    if (!enc_ok(builder_patch_u8(?b, 3, 0x11))) { ret 1; }
    if (b.len != 4 || data[3] != 0x11) { ret 1; }

    val rr: res[Reservation, EncodeError] = builder_reserve(?b, 2);
    if (sel rr.err) { ret 1; }
    var reservation: Reservation = rr.ok;
    if (enc_ok(builder_patch_u8(?b, 0, 0x22))) { ret 1; }
    if (data[0] != 0xA5 || b.len != 4) { ret 1; }
    if (!enc_ok(reservation_rollback(?reservation))) { ret 1; }
    ret 0;
}

test "binary builder: capacity and alignment arithmetic never wraps" {
    var data: [8]u8;
    val max: usize = 0 - 1;
    val high: usize = 0x8000000000000000;
    var input: [2]u8 = [2]u8{1, 2};

    if (growth_capacity(0, 255) != 256) { ret 1; }
    if (growth_capacity(256, 257) != 512) { ret 1; }
    if (growth_capacity(high, high + 1) != high + 1) { ret 1; }
    if (growth_capacity(0, max) != max) { ret 1; }

    var b: Builder = builder(?data[0], max, LITTLE);
    b.len = max - 1;
    if (enc_ok(builder_write_bytes(?b, ?input[0], 2)) || b.len != max - 1) { ret 1; }
    if (enc_ok(builder_align(?b, 8)) || b.len != max - 1) { ret 1; }
    if (res_ok(builder_reserve(?b, 2)) || b.len != max - 1) { ret 1; }

    b.len = 3;
    b.cap = 8;
    if (enc_ok(builder_write_bytes(?b, nil, 1)) || b.len != 3) { ret 1; }
    if (enc_ok(builder_align(?b, 0)) || b.len != 3) { ret 1; }
    if (enc_ok(builder_align(?b, 3)) || b.len != 3) { ret 1; }

    b.epoch = max;
    if (res_ok(builder_reserve(?b, 0))) { ret 1; }
    if (b.len != 3 || b.reserved || b.epoch != max) { ret 1; }

    var e: Encoder = encoder(nil, LITTLE);
    e.data = ?data[0];
    e.len = max;
    e.cap = max;
    if (enc_ok(reserve(?e, 1)) || e.len != max || e.cap != max) { ret 1; }
    if (enc_ok(align(?e, 8)) || e.len != max || e.cap != max) { ret 1; }
    ret 0;
}

use std.allocator.testing;

# the encoder's only acquisition is its growth: a refusal is the allocator's
# own error, the encoder is exactly as it was, and a release balances it
test "binary encoder: refused growth is alloc and leaves the encoder unchanged" {
    var tracker: testing.Testing;
    val made: err[A.Error] = testing.make(?tracker);
    if (sel made.err) { ret 1; }
    fin { testing.dnit(?tracker); }
    val a: *A.Allocator = testing.allocator_of(?tracker);

    var e: Encoder = encoder(a, LITTLE);
    if (!enc_ok(write_u32(?e, 0x11223344))) { ret 2; }
    if (e.len != 4 || e.cap != 256) { ret 3; }

    testing.fail_at_ordinal(?tracker, testing.attempt_count(?tracker) + 1);
    var big: [512]u8;
    val refused: res[usize, EncodeError] = write_bytes(?e, ?big[0], 512);
    if (!sel refused.err) { ret 4; }
    if (!sel refused.err.alloc) { ret 5; }
    if (!sel refused.err.alloc.exhausted) { ret 6; }
    if (e.len != 4 || e.cap != 256 || e.data[0] != 0x44) { ret 7; }
    testing.clear_failure(?tracker);

    val grown: res[usize, EncodeError] = write_bytes(?e, ?big[0], 512);
    if (!sel grown.ok) { ret 8; }
    if (grown.ok != 516 || e.cap != 1024) { ret 9; }

    val released: err[A.Error] = encoder_dnit(?e);
    if (sel released.err) { ret 10; }
    if (e.cap != 0 || e.data != nil || testing.live_count(?tracker) != 0) { ret 11; }
    val again: err[A.Error] = encoder_dnit(?e);
    if (sel again.err) { ret 12; }
    ret 0;
}

# every builder refusal is its own case, and the payload-bearing ones carry
# the fact a caller acts on: the room that is left, the bad boundary
test "binary builder: refusals are classified" {
    var data: [8]u8;
    var b: Builder = builder(?data[0], 8, LITTLE);
    if (!enc_ok(builder_write_u32(?b, 1))) { ret 1; }

    val full: res[usize, EncodeError] = builder_write_u64(?b, 2);
    if (!sel full.err) { ret 2; }
    if (!sel full.err.full) { ret 3; }
    if (full.err.full != 4) { ret 3; }

    val aligned: res[usize, EncodeError] = builder_align(?b, 6);
    if (!sel aligned.err) { ret 4; }
    if (!sel aligned.err.alignment) { ret 5; }
    if (aligned.err.alignment != 6) { ret 5; }

    val out: res[usize, EncodeError] = builder_patch_u32(?b, 2, 9);
    if (!sel out.err) { ret 6; }
    if (!sel out.err.bounds) { ret 7; }

    val back: res[usize, EncodeError] = builder_rollback(?b, 5);
    if (!sel back.err) { ret 8; }
    if (!sel back.err.bounds) { ret 9; }

    val rr: res[Reservation, EncodeError] = builder_reserve(?b, 2);
    if (!sel rr.ok) { ret 10; }
    var r: Reservation = rr.ok;
    val locked: res[usize, EncodeError] = builder_write_u8(?b, 1);
    if (!sel locked.err) { ret 11; }
    if (!sel locked.err.reserved) { ret 12; }
    val mark: res[Checkpoint, EncodeError] = builder_checkpoint(?b);
    if (!sel mark.err) { ret 13; }
    if (!sel mark.err.reserved) { ret 13; }

    val inner: res[Reservation, EncodeError] = builder_reserve(?r.body, 1);
    if (!sel inner.ok) { ret 14; }
    var child: Reservation = inner.ok;
    val busy: res[usize, EncodeError] = builder_commit(?r);
    if (!sel busy.err) { ret 15; }
    if (!sel busy.err.busy) { ret 16; }
    if (!enc_ok(reservation_rollback(?child))) { ret 17; }

    var stale: Reservation = r;
    if (!enc_ok(builder_commit(?r))) { ret 18; }
    val gone: res[usize, EncodeError] = builder_commit(?r);
    if (!sel gone.err) { ret 19; }
    if (!sel gone.err.inactive) { ret 20; }
    val old: res[usize, EncodeError] = reservation_rollback(?stale);
    if (!sel old.err) { ret 21; }
    if (!sel old.err.stale) { ret 22; }

    b.len = 9;
    val broken: res[usize, EncodeError] = builder_write_u8(?b, 1);
    if (!sel broken.err) { ret 23; }
    if (!sel broken.err.invalid) { ret 24; }
    ret 0;
}

# a short read names the bytes that remain, distinct from a malformed cursor,
# a bad boundary, a checkpoint outside the past, and a missing terminator
test "binary cursor: refusals are classified" {
    var data: [8]u8;
    memory.fill[u8](?data[0], 0x41, 8);
    var d: Decoder = decoder(?data[0], 8, LITTLE);
    if (!dec_ok(skip(?d, 5))) { ret 1; }

    val short: res[u64, DecodeError] = read_u64(?d);
    if (!sel short.err) { ret 2; }
    if (!sel short.err.short) { ret 3; }
    if (short.err.short != 3) { ret 3; }
    if (d.pos != 5) { ret 4; }

    val aligned: res[usize, DecodeError] = align_read(?d, 3);
    if (!sel aligned.err) { ret 5; }
    if (!sel aligned.err.alignment) { ret 6; }
    if (aligned.err.alignment != 3) { ret 6; }

    val back: res[usize, DecodeError] = cursor_rollback(?d, 6);
    if (!sel back.err) { ret 7; }
    if (!sel back.err.bounds) { ret 8; }

    val text: res[str, DecodeError] = read_str(?d);
    if (!sel text.err) { ret 9; }
    if (!sel text.err.unterminated) { ret 10; }
    if (d.pos != 5) { ret 11; }

    d.pos = 9;
    val broken: res[u8, DecodeError] = read_u8(?d);
    if (!sel broken.err) { ret 12; }
    if (!sel broken.err.invalid) { ret 13; }
    val mark: res[Checkpoint, DecodeError] = cursor_checkpoint(?d);
    if (!sel mark.err) { ret 14; }
    if (!sel mark.err.invalid) { ret 14; }

    var empty: Decoder = decoder(nil, 3, LITTLE);
    val missing: res[*u8, DecodeError] = read_bytes(?empty, 1);
    if (!sel missing.err) { ret 15; }
    if (!sel missing.err.invalid) { ret 16; }
    val none: res[*u8, DecodeError] = read_bytes(?empty, 0);
    if (!sel none.ok) { ret 17; }
    ret 0;
}
