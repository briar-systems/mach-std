# little-endian base 128 variable-length integers
#
# the integer encoding of dwarf, webassembly and mach-o: seven bits per byte,
# the low group first, and the high bit of every byte but the last set. an
# unsigned value ends once the rest is zero, a signed one once the rest is the
# sign extension of the bit 6 it ends on, so every value has one shortest
# form, which put_unsigned and put_signed write.
#
# the put_* operations write into storage the caller sized with the matching
# *_size, or with MAX_BYTES for any value. the get_* operations read from a
# bounded span and report how many bytes the value took. a reader accepts a
# longer form of a value, padded with continuation bytes, up to MAX_BYTES, and
# refuses one whose bits do not fit 64.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

# the most bytes a 64-bit value takes
pub val MAX_BYTES: usize = 10;

# every way a read can fail
# ---
# short:    the span ends before the value's last byte
# overflow: the value does not fit 64 bits, or runs past MAX_BYTES
pub tag Error: u8 {
    short;
    overflow;
}

# an unsigned value read and the bytes it took
pub rec Unsigned {
    value: u64;
    size:  usize;
}

# a signed value read and the bytes it took
pub rec Signed {
    value: i64;
    size:  usize;
}

# the bytes put_unsigned writes for v
# ---
# v:   value to measure
# ret: 1 to MAX_BYTES
pub fun unsigned_size(v: u64) usize {
    var rest: u64   = v >> 7;
    var n:    usize = 1;
    for (rest != 0) {
        rest = rest >> 7;
        n    = n + 1;
    }
    ret n;
}

# the bytes put_signed writes for v
# ---
# v:   value to measure
# ret: 1 to MAX_BYTES
pub fun signed_size(v: i64) usize {
    var rest: i64   = v;
    var n:    usize = 0;
    var more: bool  = true;
    for (more) {
        val sign: bool = (rest & 0x40) != 0;
        rest = rest >> 7;
        n    = n + 1;
        if ((rest == 0 && !sign) || (rest == -1 && sign)) { more = false; }
    }
    ret n;
}

# write the shortest encoding of an unsigned value
# ---
# dst: storage for unsigned_size(v) bytes
# v:   value to encode
# ret: bytes written
pub fun put_unsigned(dst: *u8, v: u64) usize {
    var rest: u64   = v;
    var n:    usize = 0;
    var more: bool  = true;
    for (more) {
        var byte: u8 = (rest & 0x7F)::u8;
        rest = rest >> 7;
        if (rest != 0) { byte = byte | 0x80; }
        or             { more = false; }
        dst[n] = byte;
        n      = n + 1;
    }
    ret n;
}

# write the shortest encoding of a signed value
# ---
# dst: storage for signed_size(v) bytes
# v:   value to encode
# ret: bytes written
pub fun put_signed(dst: *u8, v: i64) usize {
    var rest: i64   = v;
    var n:    usize = 0;
    var more: bool  = true;
    for (more) {
        var byte: u8 = (rest::u64 & 0x7F)::u8;
        rest = rest >> 7;
        val sign: bool = (byte & 0x40) != 0;
        if ((rest == 0 && !sign) || (rest == -1 && sign)) { more = false; }
        or                                                { byte = byte | 0x80; }
        dst[n] = byte;
        n      = n + 1;
    }
    ret n;
}

# read an unsigned value from the start of a span
# ---
# src: the span's bytes
# len: the span's length
# ret: the value and the bytes it took, or the failure
pub fun get_unsigned(src: *u8, len: usize) res[Unsigned, Error] {
    var value: u64   = 0;
    var n:     usize = 0;
    for (n < MAX_BYTES) {
        if (n >= len) { ret res[Unsigned, Error].err{Error.short{}}; }
        val byte:  u8  = src[n];
        val group: u64 = (byte & 0x7F)::u64;
        # the tenth byte holds bit 63 alone
        if (n == MAX_BYTES - 1 && group > 1) { ret res[Unsigned, Error].err{Error.overflow{}}; }
        value = value | (group << (n * 7));
        n     = n + 1;
        if ((byte & 0x80) == 0) { ret res[Unsigned, Error].ok{Unsigned{value: value, size: n}}; }
    }
    ret res[Unsigned, Error].err{Error.overflow{}};
}

# read a signed value from the start of a span
# ---
# src: the span's bytes
# len: the span's length
# ret: the value and the bytes it took, or the failure
pub fun get_signed(src: *u8, len: usize) res[Signed, Error] {
    var value: u64   = 0;
    var n:     usize = 0;
    for (n < MAX_BYTES) {
        if (n >= len) { ret res[Signed, Error].err{Error.short{}}; }
        val byte:  u8  = src[n];
        val group: u64 = (byte & 0x7F)::u64;
        # the tenth byte holds bit 63, and its other bits extend it
        if (n == MAX_BYTES - 1 && group != 0 && group != 0x7F) { ret res[Signed, Error].err{Error.overflow{}}; }
        value = value | (group << (n * 7));
        n     = n + 1;
        if ((byte & 0x80) == 0) {
            if (n < MAX_BYTES && (byte & 0x40) != 0) { value = value | (~(0::u64) << (n * 7)); }
            ret res[Signed, Error].ok{Signed{value: value::i64, size: n}};
        }
    }
    ret res[Signed, Error].err{Error.overflow{}};
}

#[testing]
fun t_unsigned_round_trips(v: u64, size: usize) bool {
    var buf: [10]u8;
    if (unsigned_size(v) != size || put_unsigned(?buf[0], v) != size) { ret false; }
    val got: res[Unsigned, Error] = get_unsigned(?buf[0], size);
    if (sel got.err)                              { ret false; }
    if (got.ok.value != v || got.ok.size != size) { ret false; }
    # every shorter span ends before the last byte
    var cut: usize = 0;
    for (cut < size) {
        val short: res[Unsigned, Error] = get_unsigned(?buf[0], cut);
        if (!sel short.err)       { ret false; }
        if (!sel short.err.short) { ret false; }
        cut = cut + 1;
    }
    ret true;
}

#[testing]
fun t_signed_round_trips(v: i64, size: usize) bool {
    var buf: [10]u8;
    if (signed_size(v) != size || put_signed(?buf[0], v) != size) { ret false; }
    val got: res[Signed, Error] = get_signed(?buf[0], size);
    if (sel got.err)                              { ret false; }
    if (got.ok.value != v || got.ok.size != size) { ret false; }
    var cut: usize = 0;
    for (cut < size) {
        val short: res[Signed, Error] = get_signed(?buf[0], cut);
        if (sel short.ok) { ret false; }
        cut = cut + 1;
    }
    ret true;
}

test leb128__unsigned_round_trips_at_every_group_boundary {
    if (!t_unsigned_round_trips(0, 1))              { ret 1; }
    if (!t_unsigned_round_trips(0x7F, 1))           { ret 2; }
    if (!t_unsigned_round_trips(0x80, 2))           { ret 3; }
    if (!t_unsigned_round_trips(624485, 3))         { ret 4; }
    if (!t_unsigned_round_trips(0xFFFFFFFF, 5))     { ret 5; }
    if (!t_unsigned_round_trips(~(0::u64) >> 1, 9)) { ret 6; }
    if (!t_unsigned_round_trips(~(0::u64), 10))     { ret 7; }
    var buf: [10]u8;
    put_unsigned(?buf[0], 624485);
    if (buf[0] != 0xE5 || buf[1] != 0x8E || buf[2] != 0x26) { ret 8; }
    ret 0;
}

test leb128__signed_round_trips_at_every_sign_boundary {
    if (!t_signed_round_trips(0, 1))                            { ret 1; }
    if (!t_signed_round_trips(63, 1))                           { ret 2; }
    if (!t_signed_round_trips(64, 2))                           { ret 3; }
    if (!t_signed_round_trips(-64, 1))                          { ret 4; }
    if (!t_signed_round_trips(-65, 2))                          { ret 5; }
    if (!t_signed_round_trips(-123456, 3))                      { ret 6; }
    if (!t_signed_round_trips((~(0::u64) >> 1)::i64, 10))       { ret 7; }
    if (!t_signed_round_trips(((~(0::u64) >> 1) + 1)::i64, 10)) { ret 8; }
    var buf: [10]u8;
    put_signed(?buf[0], -123456);
    if (buf[0] != 0xC0 || buf[1] != 0xBB || buf[2] != 0x78) { ret 9; }
    ret 0;
}

test leb128__padded_forms_read_and_overlong_forms_refuse {
    # 1 padded to three bytes
    var padded: [3]u8                = [3]u8{0x81, 0x80, 0x00};
    val one:    res[Unsigned, Error] = get_unsigned(?padded[0], 3);
    if (sel one.err)                           { ret 1; }
    if (one.ok.value != 1 || one.ok.size != 3) { ret 1; }
    # -1 padded to two bytes
    var minus: [2]u8              = [2]u8{0xFF, 0x7F};
    val m:     res[Signed, Error] = get_signed(?minus[0], 2);
    if (sel m.err)                          { ret 2; }
    if (m.ok.value != -1 || m.ok.size != 2) { ret 2; }
    # a tenth byte carrying more than bit 63, and an eleventh byte
    var wide: [11]u8;
    var i:    usize = 0;
    for (i < 9) {
        wide[i] = 0xFF;
        i       = i + 1;
    }
    wide[9] = 0x02;
    val over: res[Unsigned, Error] = get_unsigned(?wide[0], 10);
    if (!sel over.err)          { ret 3; }
    if (!sel over.err.overflow) { ret 3; }
    wide[9]  = 0x80;
    wide[10] = 0x00;
    val long: res[Unsigned, Error] = get_unsigned(?wide[0], 11);
    if (!sel long.err)          { ret 4; }
    if (!sel long.err.overflow) { ret 4; }
    wide[9] = 0x3F;
    val sover: res[Signed, Error] = get_signed(?wide[0], 10);
    if (!sel sover.err)          { ret 5; }
    if (!sel sover.err.overflow) { ret 5; }
    ret 0;
}
