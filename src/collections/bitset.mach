# dynamic bitset backed by allocator

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.memory;
use std.math.bits;
use std.allocator;
use std.allocator.page;
use std.allocator.testing;

# dynamic bitset storing nbits bits in an array of u64 words
# ---
# alloc:  allocator for backing storage
# words:  pointer to the u64 word array
# nbits:  number of bits
# nwords: number of u64 words
pub rec Bitset {
    alloc:  *allocator.Allocator;
    words:  *u64;
    nbits:  usize;
    nwords: usize;
}

# create a bitset with all bits cleared
#
# the value owns its word array from here until `dnit`; it holds no pointer
# to itself, so it may be copied into its final storage. a refused allocation
# leaves nothing owned.
# ---
# alloc: allocator for backing storage
# nbits: number of bits
# ret:   a new zeroed Bitset, or the allocator's refusal
pub fun init(alloc: *allocator.Allocator, nbits: usize) res[Bitset, allocator.Error] {
    var bs: Bitset;
    bs.alloc  = alloc;
    bs.nbits  = nbits;
    bs.nwords = (nbits + 63) / 64;

    if (bs.nwords == 0) {
        bs.words = nil;
        ret res[Bitset, allocator.Error].ok{bs};
    }

    val r: res[*u64, allocator.Error] = allocator.zallocate[u64](alloc, bs.nwords);
    if (sel r.err) { ret res[Bitset, allocator.Error].err{r.err}; }
    bs.words = r.ok;
    ret res[Bitset, allocator.Error].ok{bs};
}

# free the backing word array
# ---
# ret: ok when the words were released (or there were none), or the refusal
pub fun dnit(bs: *Bitset) err[allocator.Error] {
    if (bs == nil) { ret err[allocator.Error].ok{}; }
    if (bs.nwords == 0) {
        bs.words = nil;
        bs.nbits = 0;
        ret err[allocator.Error].ok{};
    }
    val freed: err[allocator.Error] = allocator.deallocate[u64](bs.alloc, bs.words, bs.nwords);
    bs.words  = nil;
    bs.nbits  = 0;
    bs.nwords = 0;
    ret freed;
}

# set the bit at the given index
# ---
# idx: bit index
pub fun set(bs: *Bitset, idx: usize) {
    if (idx >= bs.nbits) { ret; }
    val word: usize = idx / 64;
    val bit:  usize = idx % 64;
    bs.words[word] = bs.words[word] | (1::u64 << bit);
}

# clear the bit at the given index
# ---
# idx: bit index
pub fun clear(bs: *Bitset, idx: usize) {
    if (idx >= bs.nbits) { ret; }
    val word: usize = idx / 64;
    val bit:  usize = idx % 64;
    bs.words[word] = bs.words[word] & ~(1::u64 << bit);
}

# test the bit at the given index
# ---
# idx: bit index
# ret: true if the bit is set, false if cleared or out of range
pub fun get(bs: *Bitset, idx: usize) bool {
    if (idx >= bs.nbits) { ret false; }
    val word: usize = idx / 64;
    val bit:  usize = idx % 64;
    ret (bs.words[word] & (1::u64 << bit)) != 0;
}

# flip the bit at the given index
# ---
# idx: bit index
pub fun toggle(bs: *Bitset, idx: usize) {
    if (idx >= bs.nbits) { ret; }
    val word: usize = idx / 64;
    val bit:  usize = idx % 64;
    bs.words[word] = bs.words[word] ^ (1::u64 << bit);
}

# count the number of set bits
# ---
# ret: population count
pub fun count(bs: *Bitset) usize {
    var total: usize = 0;
    var i: usize = 0;
    for (i < bs.nwords) {
        total = total + bits.popcount(bs.words[i])::usize;
        i = i + 1;
    }
    ret total;
}

# clear all bits to zero
pub fun clear_all(bs: *Bitset) {
    if (bs.nwords == 0) { ret; }
    memory.zero[u64](bs.words, bs.nwords);
}

# set all bits to one, masking the trailing word
pub fun set_all(bs: *Bitset) {
    if (bs.nwords == 0) { ret; }
    memory.fill[u64](bs.words, 0xffffffffffffffff, bs.nwords);
    val tail: usize = bs.nbits % 64;
    if (tail != 0) {
        bs.words[bs.nwords - 1] = (1::u64 << tail) - 1;
    }
}

test "bitset: init and dnit" {
    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Bitset, allocator.Error] = init(?a, 128);
    if (sel r.err) { ret 1; }
    var bs: Bitset = r.ok;
    if (bs.nbits != 128) { ret 1; }
    if (bs.nwords != 2) { ret 1; }
    val freed: err[allocator.Error] = dnit(?bs);
    if (sel freed.err) { ret 1; }
    if (bs.words != nil || bs.nbits != 0) { ret 1; }
    ret 0;
}

test "bitset: set and get" {
    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Bitset, allocator.Error] = init(?a, 256);
    if (sel r.err) { ret 1; }
    var bs: Bitset = r.ok;

    set(?bs, 0);
    set(?bs, 63);
    set(?bs, 64);
    set(?bs, 255);

    if (!get(?bs, 0)) { ret 1; }
    if (!get(?bs, 63)) { ret 1; }
    if (!get(?bs, 64)) { ret 1; }
    if (!get(?bs, 255)) { ret 1; }
    if (get(?bs, 1)) { ret 1; }
    if (get(?bs, 100)) { ret 1; }

    dnit(?bs);
    ret 0;
}

test "bitset: clear bit" {
    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Bitset, allocator.Error] = init(?a, 64);
    if (sel r.err) { ret 1; }
    var bs: Bitset = r.ok;

    set(?bs, 10);
    if (!get(?bs, 10)) { ret 1; }
    clear(?bs, 10);
    if (get(?bs, 10)) { ret 1; }

    dnit(?bs);
    ret 0;
}

test "bitset: toggle" {
    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Bitset, allocator.Error] = init(?a, 64);
    if (sel r.err) { ret 1; }
    var bs: Bitset = r.ok;

    if (get(?bs, 5)) { ret 1; }
    toggle(?bs, 5);
    if (!get(?bs, 5)) { ret 1; }
    toggle(?bs, 5);
    if (get(?bs, 5)) { ret 1; }

    dnit(?bs);
    ret 0;
}

test "bitset: count" {
    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Bitset, allocator.Error] = init(?a, 128);
    if (sel r.err) { ret 1; }
    var bs: Bitset = r.ok;

    if (count(?bs) != 0) { ret 1; }

    set(?bs, 0);
    set(?bs, 1);
    set(?bs, 64);
    set(?bs, 127);
    if (count(?bs) != 4) { ret 1; }

    dnit(?bs);
    ret 0;
}

test "bitset: clear_all" {
    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Bitset, allocator.Error] = init(?a, 128);
    if (sel r.err) { ret 1; }
    var bs: Bitset = r.ok;

    set(?bs, 0);
    set(?bs, 50);
    set(?bs, 127);
    clear_all(?bs);
    if (count(?bs) != 0) { ret 1; }

    dnit(?bs);
    ret 0;
}

test "bitset: set_all" {
    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Bitset, allocator.Error] = init(?a, 100);
    if (sel r.err) { ret 1; }
    var bs: Bitset = r.ok;

    set_all(?bs);
    if (count(?bs) != 100) { ret 1; }
    if (!get(?bs, 0)) { ret 1; }
    if (!get(?bs, 99)) { ret 1; }

    dnit(?bs);
    ret 0;
}

test "bitset: out of range is safe" {
    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Bitset, allocator.Error] = init(?a, 64);
    if (sel r.err) { ret 1; }
    var bs: Bitset = r.ok;

    set(?bs, 100);
    if (get(?bs, 100)) { ret 1; }
    clear(?bs, 200);
    toggle(?bs, 300);

    dnit(?bs);
    ret 0;
}

test "bitset: zero bits" {
    var a: allocator.Allocator;
    page.make(?a);
    val r: res[Bitset, allocator.Error] = init(?a, 0);
    if (sel r.err) { ret 1; }
    var bs: Bitset = r.ok;
    if (bs.nwords != 0) { ret 1; }
    if (count(?bs) != 0) { ret 1; }
    dnit(?bs);
    ret 0;
}

# a refused allocation is the allocator's refusal with nothing left owned,
# and the same allocator serves a bitset cleanly once it is not refusing
test "bitset: a refused init owns nothing" {
    var t: testing.Testing;
    val mr: err[allocator.Error] = testing.make(?t);
    if (sel mr.err) { ret 1; }
    testing.fail_at_ordinal(?t, 1);

    val refused: res[Bitset, allocator.Error] = init(?t.a, 128);
    if (!sel refused.err)           { testing.dnit(?t); ret 2; }
    if (!sel refused.err.exhausted) { testing.dnit(?t); ret 3; }
    if (testing.live_count(?t) != 0) { testing.dnit(?t); ret 4; }

    testing.clear_failure(?t);
    val served: res[Bitset, allocator.Error] = init(?t.a, 128);
    if (sel served.err) { testing.dnit(?t); ret 7; }
    var bs: Bitset = served.ok;
    set(?bs, 127);
    if (count(?bs) != 1) { testing.dnit(?t); ret 8; }
    val freed: err[allocator.Error] = dnit(?bs);
    if (sel freed.err)      { testing.dnit(?t); ret 9; }
    if (testing.leaked(?t)) { testing.dnit(?t); ret 10; }
    testing.dnit(?t);
    ret 0;
}
