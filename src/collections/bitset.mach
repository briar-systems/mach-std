# dynamic bitset backed by allocator

use std.allocator;
use std.allocator.fixed;
use std.system.capability;

$if (capability.HOSTED) {
    use std.allocator.page;
}

use std.math.bits;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

# dynamic bitset storing nbits bits in an array of u64 words
# ---
# alloc:  allocator for backing storage
# words:  pointer to the u64 word array
# nbits:  number of bits
# nwords: number of u64 words
pub rec Bitset {
    alloc:  *allocator.Allocator;
    words:  *u64;
    nbits:  usize;
    nwords: usize;
}

# create a bitset with all bits cleared
#
# the value owns its word array from here until `dnit`; it holds no pointer
# to itself, so it may be copied into its final storage. a refused allocation
# leaves nothing owned.
# ---
# alloc: allocator for backing storage
# nbits: number of bits
# ret:   a new zeroed Bitset, or the allocator's refusal
pub fun init(alloc: *allocator.Allocator, nbits: usize) res[Bitset, allocator.Error] {
    var bs: Bitset;
    bs.alloc  = alloc;
    bs.nbits  = nbits;
    bs.nwords = nbits / 64;
    if (nbits % 64 != 0) { bs.nwords = bs.nwords + 1; }

    if (bs.nwords == 0) {
        bs.words = nil;
        ret res[Bitset, allocator.Error].ok{bs};
    }

    val res_zallocate: res[*u64, allocator.Error] = allocator.zallocate[u64](alloc, bs.nwords);
    if (sel res_zallocate.err) { ret res[Bitset, allocator.Error].err{res_zallocate.err}; }
    bs.words = res_zallocate.ok;
    ret res[Bitset, allocator.Error].ok{bs};
}

# free the backing word array
# ---
# ret: ok when the words were released (or there were none), or the refusal
pub fun dnit(bs: *Bitset) err[allocator.Error] {
    if (bs == nil) { ret err[allocator.Error].ok{}; }
    if (bs.nwords == 0) {
        bs.words = nil;
        bs.nbits = 0;
        ret err[allocator.Error].ok{};
    }
    val err_freed: err[allocator.Error] = allocator.deallocate[u64](bs.alloc, bs.words, bs.nwords);
    bs.words  = nil;
    bs.nbits  = 0;
    bs.nwords = 0;
    ret err_freed;
}

# set the bit at the given index
# ---
# idx: bit index
pub fun set(bs: *Bitset, idx: usize) {
    if (idx >= bs.nbits) { ret; }
    val word: usize = idx / 64;
    val bit:  usize = idx % 64;
    bs.words[word] = bs.words[word] | (1::u64 << bit);
}

# clear the bit at the given index
# ---
# idx: bit index
pub fun clear(bs: *Bitset, idx: usize) {
    if (idx >= bs.nbits) { ret; }
    val word: usize = idx / 64;
    val bit:  usize = idx % 64;
    bs.words[word] = bs.words[word] & ~(1::u64 << bit);
}

# test the bit at the given index
# ---
# idx: bit index
# ret: true if the bit is set, false if cleared or out of range
pub fun get(bs: *Bitset, idx: usize) bool {
    if (idx >= bs.nbits) { ret false; }
    val word: usize = idx / 64;
    val bit:  usize = idx % 64;
    ret (bs.words[word] & (1::u64 << bit)) != 0;
}

# flip the bit at the given index
# ---
# idx: bit index
pub fun toggle(bs: *Bitset, idx: usize) {
    if (idx >= bs.nbits) { ret; }
    val word: usize = idx / 64;
    val bit:  usize = idx % 64;
    bs.words[word] = bs.words[word] ^ (1::u64 << bit);
}

# count the number of set bits
# ---
# ret: population count
pub fun count(bs: *Bitset) usize {
    var total: usize = 0;
    var i:     usize = 0;
    for (i < bs.nwords) {
        total = total + bits.popcount(bs.words[i])::usize;
        i     = i + 1;
    }
    ret total;
}

# clear all bits to zero
pub fun clear_all(bs: *Bitset) {
    if (bs.nwords == 0) { ret; }
    memory.zero[u64](bs.words, bs.nwords);
}

# set all bits to one, masking the trailing word
pub fun set_all(bs: *Bitset) {
    if (bs.nwords == 0) { ret; }
    memory.fill[u64](bs.words, 0xffffffffffffffff, bs.nwords);
    val tail: usize = bs.nbits % 64;
    if (tail != 0) {
        bs.words[bs.nwords - 1] = (1::u64 << tail) - 1;
    }
}

$if (capability.HOSTED) {
    # set_all leaves the bits past nbits clear, and a zero-bit set owns no words
    test bitset__set_all_masks_the_tail {
        var a: allocator.Allocator;
        page.make(?a);
        val res_made: res[Bitset, allocator.Error] = init(?a, 100);
        if (sel res_made.err) { ret 1; }
        var bs: Bitset = res_made.ok;
        set_all(?bs);
        if (count(?bs) != 100)              { ret 2; }
        if (!get(?bs, 99) || get(?bs, 100)) { ret 3; }
        clear_all(?bs);
        if (count(?bs) != 0) { ret 4; }
        dnit(?bs);

        val res_empty_made: res[Bitset, allocator.Error] = init(?a, 0);
        if (sel res_empty_made.err) { ret 5; }
        var empty: Bitset = res_empty_made.ok;
        set_all(?empty);
        if (empty.nwords != 0 || count(?empty) != 0) { ret 6; }
        dnit(?empty);

        # a bit count within a word of the top still needs its last word, so the
        # words cannot be had from a small buffer
        var small: [64]u8;
        var state: fixed.FixedState;
        var fa:    allocator.Allocator;
        fixed.make(?fa, ?state, ?small[0], 64);
        val res_vast_made: res[Bitset, allocator.Error] = init(?fa, ~(0::usize) - 10);
        if (sel res_vast_made.ok) { ret 7; }
        ret 0;
    }

    # set, clear, get and toggle on both sides of a word boundary and at the last bit of
    # a size that is not a multiple of 64, with the index one past it ignored
    test bitset__bits_on_both_sides_of_a_word_boundary {
        var a: allocator.Allocator;
        page.make(?a);
        val res_made: res[Bitset, allocator.Error] = init(?a, 100);
        if (sel res_made.err) { ret 1; }
        var bs: Bitset = res_made.ok;
        set(?bs, 63);
        set(?bs, 64);
        set(?bs, 99);
        set(?bs, 100);
        if (!get(?bs, 63) || !get(?bs, 64) || !get(?bs, 99)) { ret 2; }
        if (get(?bs, 62) || get(?bs, 65) || get(?bs, 100))   { ret 3; }
        if (count(?bs) != 3)                                 { ret 4; }
        clear(?bs, 63);
        toggle(?bs, 64);
        toggle(?bs, 99);
        toggle(?bs, 0);
        if (get(?bs, 63) || get(?bs, 64) || get(?bs, 99) || !get(?bs, 0)) { ret 5; }
        if (count(?bs) != 1)                                              { ret 6; }
        dnit(?bs);
        ret 0;
    }
}
