# the natural order, equality and hash of a type, resolved at compile time
#
# every collection that orders or hashes its elements reads this module rather
# than carrying its own notion, so `sort`, `Heap`, `Map` and `Set` agree on what
# "less than" and "equal" mean for a `T`. each operation is a generic whose body
# is decided per instantiation: an integer or float compares with the operator,
# a `str` compares by content, and a record compares lexicographically over its
# fields in declaration order, descending into nested records. nothing here is a
# function value, so the compare a collection emits is the operator itself, not
# a call through a pointer.
#
# WHAT HAS A NATURAL ORDER. integers and floats (by `<`, so a NaN is unordered
# and a sort over NaNs has an unspecified but bounded result), `str` (by
# `str_compare`, and equality by `str_equals`), and records whose fields all
# classify under `std.derive`'s contract: scalars and nested records. a record
# is ordered by its first differing field, so a caller that wants "by priority,
# then by id" declares the fields in that order. a union, a tag, an array, a
# vector or a `^` secret field is refused at compile time with `derive.check`'s
# message. any other pointer type is refused here: address order is a choice,
# and a caller who wants it says so through a comparator.
#
# `str` IS `*char`. the type comparison cannot tell them apart, so a `*char`
# element is compared and hashed by the string it points at. a record field of
# type `str` is a pointer field and falls to `derive.check`'s refusal, which is
# the same rule `derive.eq` and `derive.hash` apply.
#
# THE HASH. a scalar is finalized with the murmur3 `fmix64` mixer; a string is
# folded eight bytes at a time and finalized the same way; a record folds each
# scalar field as one word in declaration order, so a nested record contributes
# exactly what a flattened one would. two values that are `eq` hash alike. the
# hash is not stable across std versions and is not a cryptographic one.

use std.derive;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;

# the natural strict order of `T`
# ---
# [T]: the element type
# a:   left operand
# b:   right operand
# ret: true when `a` sorts before `b`
#[inline]
pub fun less[T](a: *T, b: *T) bool {
    $if ($is_integer(T) || $is_float(T)) { ret @a < @b; }
    $or ($type_of(@a) == str)            { ret str_compare(@a, @b) < 0; }
    $or ($is_record(T))                  { ret less_fields[T](a, b); }
    $or ($is_pointer(T))                 { $error("std.collections.natural: a pointer has no natural order -- address order is a choice, so order it through a comparator (`sort_by`, `HeapBy`)"); }
    $or                                  { $error("std.collections.natural: this type has no natural order -- a union, a tag, an array, a vector or a ^ secret needs a comparator"); }
}

# the natural equality of `T`
# ---
# [T]: the element type
# a:   left operand
# b:   right operand
# ret: true when `a` and `b` are equal
#[inline]
pub fun eq[T](a: *T, b: *T) bool {
    $if ($is_integer(T) || $is_float(T)) { ret @a == @b; }
    $or ($type_of(@a) == str)            { ret str_equals(@a, @b); }
    $or ($is_record(T))                  { ret derive.eq[T](a, b); }
    $or ($is_pointer(T))                 { $error("std.collections.natural: a pointer has no natural equality -- address equality is a choice, so key it through a hash and an equality function (`MapBy`)"); }
    $or                                  { $error("std.collections.natural: this type has no natural equality -- a union, a tag, an array, a vector or a ^ secret needs its own equality"); }
}

# the natural hash of `T`
# ---
# [T]: the element type
# v:   the value to hash
# ret: a 64-bit hash, equal for values that are `eq`
#[inline]
pub fun hash[T](v: *T) u64 {
    $if ($is_integer(T))      { ret mix((@v)::u64); }
    $or ($is_float(T))        { ret mix(float_word[T](@v)); }
    $or ($type_of(@v) == str) { ret hash_str(@v); }
    $or ($is_record(T)) {
        derive.check[T]();
        ret mix(fold_fields[T](SEED, v));
    }
    $or ($is_pointer(T)) { $error("std.collections.natural: a pointer has no natural hash -- address hashing is a choice, so key it through a hash and an equality function (`MapBy`)"); }
    $or                  { $error("std.collections.natural: this type has no natural hash -- a union, a tag, an array, a vector or a ^ secret needs its own hash"); }
}

# lexicographic order over a record's fields
fun less_fields[T](a: *T, b: *T) bool {
    derive.check[T]();
    $each f in $fields(T) {
        $if ($is_record(f.type)) {
            if (less_fields[f.type](?a.[f], ?b.[f])) { ret true; }
            if (less_fields[f.type](?b.[f], ?a.[f])) { ret false; }
        }
        $or ($is_integer(f.type) || $is_float(f.type)) {
            if (a.[f] < b.[f]) { ret true; }
            if (b.[f] < a.[f]) { ret false; }
        }
        $or {}
    }
    ret false;
}

# a float's bits as one hash word, with -0.0 folded onto +0.0 so equal floats hash alike
fun float_word[T](x: T) u64 {
    $if ($type_of(x) == f64) { ret (x + 0.0):~u64; }
    $or                      { ret ((x::f64) + 0.0):~u64; }
}

# fold a record's scalar fields into the accumulator, one word per field
fun fold_fields[T](h0: u64, v: *T) u64 {
    var h: u64 = h0;
    $each f in $fields(T) {
        $if ($is_record(f.type))  { h = fold_fields[f.type](h, ?v.[f]); }
        $or ($is_integer(f.type)) { h = fold(h, (v.[f])::u64); }
        $or ($is_float(f.type))   { h = fold(h, float_word[f.type](v.[f])); }
        $or                       {}
    }
    ret h;
}

val SEED: u64 = 0x9e3779b97f4a7c15;
val K:    u64 = 0xff51afd7ed558ccd;

# fold one word into the accumulator
#[inline]
fun fold(h: u64, word: u64) u64 {
    var x: u64 = (h ^ word) * K;
    x = x ^ (x >> 29);
    ret x;
}

# murmur3's fmix64 finalizer
#[inline]
fun mix(v: u64) u64 {
    var x: u64 = v;
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    x = x ^ (x >> 33);
    ret x;
}

# eight bytes at `p` as a little-endian word
#[inline]
fun load_word(p: *u8) u64 {
    ret (p[0]::u64)
        | (p[1]::u64 << 8)
        | (p[2]::u64 << 16)
        | (p[3]::u64 << 24)
        | (p[4]::u64 << 32)
        | (p[5]::u64 << 40)
        | (p[6]::u64 << 48)
        | (p[7]::u64 << 56);
}

# hash a NUL-terminated string eight bytes at a time
#
# the length is measured first so the fold never reads past the terminator,
# and the tail is folded as a partial word. the length itself seeds the fold,
# so `"a"` and `"a\0..."` are distinct from a padded word. a nil string hashes
# as the empty one, matching `str_equals`.
# ---
# s:   the string
# ret: the hash
pub fun hash_str(s: str) u64 {
    if (s == nil) { ret mix(fold(SEED, 0)); }
    val n: usize = str_len(s);
    var h: u64   = fold(SEED, n::u64);
    var i: usize = 0;
    for (i + 8 <= n) {
        h = fold(h, load_word((?s[i])::*u8));
        i = i + 8;
    }
    if (i < n) {
        var tail:  u64 = 0;
        var shift: u64 = 0;
        for (i < n) {
            tail  = tail | (s[i]::u64 << shift);
            shift = shift + 8;
            i     = i + 1;
        }
        h = fold(h, tail);
    }
    ret mix(h);
}

rec Pair { a: i64; b: u8; }
rec Nest { p: Pair; z: f64; }

test "natural: integers and floats order with the operator" {
    val a: i64 = -3;
    val b: i64 = 4;
    if (!less[i64](?a, ?b)) { ret 1; }
    if (less[i64](?b, ?a))  { ret 1; }
    if (less[i64](?a, ?a))  { ret 1; }
    if (!eq[i64](?a, ?a))   { ret 1; }
    if (eq[i64](?a, ?b))    { ret 1; }
    val x: f64 = 1.5;
    val y: f64 = 2.5;
    if (!less[f64](?x, ?y))             { ret 1; }
    if (hash[i64](?a) != hash[i64](?a)) { ret 1; }
    if (hash[i64](?a) == hash[i64](?b)) { ret 1; }
    ret 0;
}

test "natural: str orders and hashes by content" {
    var s: str = "apple";
    var t: str = "banana";
    var u: str = "apple";
    if (!less[str](?s, ?t))             { ret 1; }
    if (less[str](?t, ?s))              { ret 1; }
    if (!eq[str](?s, ?u))               { ret 1; }
    if (eq[str](?s, ?t))                { ret 1; }
    if (hash[str](?s) != hash[str](?u)) { ret 1; }
    if (hash[str](?s) == hash[str](?t)) { ret 1; }
    var e: str = "";
    var n: str = nil;
    if (hash[str](?e) != hash[str](?n)) { ret 1; }
    if (!eq[str](?e, ?n))               { ret 1; }
    var long1: str = "0123456789abcdef0123456789abcdefX";
    var long2: str = "0123456789abcdef0123456789abcdefY";
    if (hash[str](?long1) == hash[str](?long2)) { ret 1; }
    if (!less[str](?long1, ?long2))             { ret 1; }
    ret 0;
}

test "natural: records order lexicographically and hash by field" {
    var p: Pair = Pair{a: 1, b: 9};
    var q: Pair = Pair{a: 1, b: 3};
    var r: Pair = Pair{a: 0, b: 200};
    if (less[Pair](?p, ?q))               { ret 1; }
    if (!less[Pair](?q, ?p))              { ret 1; }
    if (!less[Pair](?r, ?q))              { ret 1; }
    if (less[Pair](?p, ?p))               { ret 1; }
    if (!eq[Pair](?p, ?p))                { ret 1; }
    if (eq[Pair](?p, ?q))                 { ret 1; }
    if (hash[Pair](?p) != hash[Pair](?p)) { ret 1; }
    if (hash[Pair](?p) == hash[Pair](?q)) { ret 1; }

    var n1: Nest = Nest{p: p, z: 0.5};
    var n2: Nest = Nest{p: p, z: 1.5};
    if (!less[Nest](?n1, ?n2))              { ret 1; }
    if (less[Nest](?n2, ?n1))               { ret 1; }
    if (hash[Nest](?n1) == hash[Nest](?n2)) { ret 1; }
    var n3: Nest = Nest{p: p, z: 0.5};
    if (hash[Nest](?n1) != hash[Nest](?n3)) { ret 1; }
    ret 0;
}
