# binary heap (priority queue)
#
# THE ORDERING CONTRACT. `Heap[T, D]` orders by the element's natural order,
# `std.collections.natural.less[T]`, and `D` says which end is on top:
# `Min` pops the least element first, `Max` the greatest. the compare in the
# emitted sift is the operator on `T` itself, resolved at compile time, with no
# call per comparison and nothing stored in the record. `HeapBy[T]` is the
# spelling for an order the type does not carry: it stores a comparator and
# calls it through its pointer per comparison, so a reader can tell from the
# type name whether a sift is direct or indirect.
#
# one core serves the three records. the policy is a zero-size value: each
# record carries it as its `order` field, the public entry point hands that
# value to the core, and every routine in the core is generic over the record
# and the policy and dispatches on `$type_of(d)`. the value costs nothing to
# pass, the gate folds per instantiation, and the sift bodies exist once. this
# is the same shape `sort` uses for its `Natural` / `ByCmp` markers.

use std.allocator;
use std.collections.natural;
use std.system.capability;

$if (capability.HOSTED) {
    use std.allocator.page;
    use std.collections.sort;
}

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

# the least element is on top
pub rec Min {}

# the greatest element is on top
pub rec Max {}

# the order is a stored comparator (the policy `HeapBy` carries)
rec By {}

# a heap ordered by the element's natural order
# ---
# [T]:   the element type
# [D]:   `Min` or `Max`
# alloc: allocator for the backing buffer
# data:  the backing buffer
# len:   number of elements
# cap:   capacity in elements
# order: the policy, a zero-size marker
pub rec Heap[T, D] {
    alloc: *allocator.Allocator;
    data:  *T;
    len:   usize;
    cap:   usize;
    order: D;
}

# a heap ordered by a comparator
#
# the least element under the comparator is on top; a max-heap is a
# comparator with its arguments swapped.
# ---
# [T]:   the element type
# alloc: allocator for the backing buffer
# data:  the backing buffer
# len:   number of elements
# cap:   capacity in elements
# order: the policy, a zero-size marker
# cmp:   the comparator, negative if a < b, zero if equal, positive if a > b
pub rec HeapBy[T] {
    alloc: *allocator.Allocator;
    data:  *T;
    len:   usize;
    cap:   usize;
    order: By;
    cmp:   fun(*T, *T) i64;
}

# create an empty heap by the natural order
# ---
# [T]:   the element type
# [D]:   `Min` or `Max`
# alloc: allocator to use for allocations
# ret:   a new empty Heap[T, D]
pub fun init[T, D](alloc: *allocator.Allocator) Heap[T, D] {
    var h: Heap[T, D];
    h.alloc = alloc;
    h.data  = nil;
    h.len   = 0;
    h.cap   = 0;
    ret h;
}

# create an empty heap by a comparator
# ---
# [T]:   the element type
# alloc: allocator to use for allocations
# cmp:   comparison function (negative if a < b, 0 if equal, positive if a > b)
# ret:   a new empty HeapBy[T]
pub fun init_by[T](alloc: *allocator.Allocator, cmp: fun(*T, *T) i64) HeapBy[T] {
    var h: HeapBy[T];
    h.alloc = alloc;
    h.data  = nil;
    h.len   = 0;
    h.cap   = 0;
    h.cmp   = cmp;
    ret h;
}

# free the backing buffer
#
# elements are not visited: an element that owns storage is the caller's to
# release before this runs.
# ---
# ret: ok when the buffer was released (or there was none), or the refusal,
#      in which case the heap is left as it was
pub fun dnit[T, D](h: *Heap[T, D]) err[allocator.Error] {
    ret core_dnit[T, Heap[T, D], D](h, h.order);
}

# free the backing buffer of a comparator heap; see `dnit`
pub fun dnit_by[T](h: *HeapBy[T]) err[allocator.Error] {
    ret core_dnit[T, HeapBy[T], By](h, h.order);
}

# check if the heap is empty
# ---
# ret: true if the heap has no elements
pub fun is_empty[T, D](h: Heap[T, D]) bool {
    ret h.len == 0;
}

# check if a comparator heap is empty
# ---
# ret: true if the heap has no elements
pub fun is_empty_by[T](h: HeapBy[T]) bool {
    ret h.len == 0;
}

# return the number of elements in the heap
# ---
# ret: number of elements
pub fun length[T, D](h: Heap[T, D]) usize {
    ret h.len;
}

# return the number of elements in a comparator heap
# ---
# ret: number of elements
pub fun length_by[T](h: HeapBy[T]) usize {
    ret h.len;
}

# add an element to the heap
#
# the value is copied in; a refused growth leaves the heap unchanged and the
# value the caller's.
# ---
# value: value to insert
# ret:   the new length, or the allocator's refusal
pub fun push[T, D](h: *Heap[T, D], value: T) res[usize, allocator.Error] {
    ret core_push[T, Heap[T, D], D](h, h.order, value);
}

# add an element to a comparator heap; see `push`
pub fun push_by[T](h: *HeapBy[T], value: T) res[usize, allocator.Error] {
    ret core_push[T, HeapBy[T], By](h, h.order, value);
}

# remove and return the top element
#
# the element is copied out; one that owns storage is now the caller's.
# ---
# ret: the top value, or none when the heap is empty
pub fun pop[T, D](h: *Heap[T, D]) opt[T] {
    ret core_pop[T, Heap[T, D], D](h, h.order);
}

# remove and return the top element of a comparator heap; see `pop`
pub fun pop_by[T](h: *HeapBy[T]) opt[T] {
    ret core_pop[T, HeapBy[T], By](h, h.order);
}

# return a pointer to the top element without removing it
#
# the pointer is into the heap's storage and is invalidated by any growth.
# ---
# ret: pointer to the top element, or none when the heap is empty
pub fun peek[T, D](h: *Heap[T, D]) opt[*T] {
    ret core_peek[T, Heap[T, D], D](h, h.order);
}

# return a pointer to the top element of a comparator heap; see `peek`
pub fun peek_by[T](h: *HeapBy[T]) opt[*T] {
    ret core_peek[T, HeapBy[T], By](h, h.order);
}

# whether `a` belongs above `b`, under the heap's policy
#[inline]
fun above[T, H, D](h: *H, d: D, a: *T, b: *T) bool {
    $if ($type_of(d) == Min) { ret natural.less[T](a, b); }
    $or ($type_of(d) == Max) { ret natural.less[T](b, a); }
    $or ($type_of(d) == By)  { ret h.cmp(a, b) < 0; }
    $or                      { $error("std.collections.heap: D must be heap.Min or heap.Max"); }
}

fun core_dnit[T, H, D](h: *H, d: D) err[allocator.Error] {
    if (h == nil) { ret err[allocator.Error].ok{}; }
    if (h.cap == 0) {
        h.data = nil;
        h.len  = 0;
        ret err[allocator.Error].ok{};
    }

    val freed: err[allocator.Error] = allocator.deallocate[T](h.alloc, h.data, h.cap);
    if (sel freed.err) { ret freed; }
    h.data = nil;
    h.len  = 0;
    h.cap  = 0;
    ret err[allocator.Error].ok{};
}

# grow the backing buffer to at least double capacity
#
# a refused growth leaves the heap exactly as it was.
# ---
# ret: the new capacity, or the allocator's refusal
fun grow[T, H, D](h: *H, d: D) res[usize, allocator.Error] {
    var new_cap: usize;
    if (h.cap == 0) {
        new_cap = 8;
    }
    or {
        new_cap = h.cap * 2;
        if (new_cap < h.cap) {
            ret res[usize, allocator.Error].err{allocator.Error.overflow{}};
        }
    }

    val r: res[*T, allocator.Error] = allocator.reallocate[T](h.alloc, h.data, h.cap, new_cap);
    if (sel r.err) { ret res[usize, allocator.Error].err{r.err}; }

    h.data = r.ok;
    h.cap  = new_cap;

    ret res[usize, allocator.Error].ok{new_cap};
}

# restore the heap property upward from the given index
fun sift_up[T, H, D](h: *H, d: D, start: usize) {
    val held: T     = h.data[start];
    var i:    usize = start;
    for (i > 0) {
        val parent: usize = (i - 1) / 2;
        if (!above[T, H, D](h, d, ?held, ?h.data[parent])) { brk; }
        h.data[i] = h.data[parent];
        i         = parent;
    }
    h.data[i] = held;
}

# restore the heap property downward from the given index
fun sift_down[T, H, D](h: *H, d: D, start: usize) {
    val held: T     = h.data[start];
    var i:    usize = start;
    for {
        val left: usize = 2 * i + 1;
        if (left >= h.len) { brk; }
        var child: usize = left;
        if (left + 1 < h.len && above[T, H, D](h, d, ?h.data[left + 1], ?h.data[left])) {
            child = left + 1;
        }
        if (!above[T, H, D](h, d, ?h.data[child], ?held)) { brk; }
        h.data[i] = h.data[child];
        i         = child;
    }
    h.data[i] = held;
}

fun core_push[T, H, D](h: *H, d: D, value: T) res[usize, allocator.Error] {
    if (h == nil) { ret res[usize, allocator.Error].err{allocator.Error.invalid{}}; }
    if (h.len == h.cap) {
        val r: res[usize, allocator.Error] = grow[T, H, D](h, d);
        if (sel r.err) { ret r; }
    }

    h.data[h.len] = value;
    h.len         = h.len + 1;
    sift_up[T, H, D](h, d, h.len - 1);
    ret res[usize, allocator.Error].ok{h.len};
}

fun core_pop[T, H, D](h: *H, d: D) opt[T] {
    if (h == nil)   { ret opt[T].none{}; }
    if (h.len == 0) { ret opt[T].none{}; }

    val top: T = h.data[0];
    h.len = h.len - 1;

    if (h.len > 0) {
        h.data[0] = h.data[h.len];
        sift_down[T, H, D](h, d, 0);
    }

    ret opt[T].some{top};
}

fun core_peek[T, H, D](h: *H, d: D) opt[*T] {
    if (h == nil)   { ret opt[*T].none{}; }
    if (h.len == 0) { ret opt[*T].none{}; }

    ret opt[*T].some{?h.data[0]};
}

$if (capability.HOSTED) {
    fun cmp_i64(a: *i64, b: *i64) i64 {
        if (@a < @b) { ret -1; }
        if (@a > @b) { ret 1; }
        ret 0;
    }

    test "heap: init creates empty heap" {
        var a: allocator.Allocator;
        page.make(?a);
        val h: Heap[i64, Min] = init[i64, Min](?a);
        if (!is_empty[i64, Min](h))   { ret 1; }
        if (length[i64, Min](h) != 0) { ret 1; }
        ret 0;
    }

    test "heap: push and pop returns ascending order" {
        var a: allocator.Allocator;
        page.make(?a);
        var h: Heap[i64, Min] = init[i64, Min](?a);

        push[i64, Min](?h, 30);
        push[i64, Min](?h, 10);
        push[i64, Min](?h, 50);
        push[i64, Min](?h, 20);
        push[i64, Min](?h, 40);

        val p1: opt[i64] = pop[i64, Min](?h);
        if (!sel p1.some)  { ret 1; }
        if (p1.some != 10) { ret 1; }

        val p2: opt[i64] = pop[i64, Min](?h);
        if (!sel p2.some)  { ret 1; }
        if (p2.some != 20) { ret 1; }

        val p3: opt[i64] = pop[i64, Min](?h);
        if (!sel p3.some)  { ret 1; }
        if (p3.some != 30) { ret 1; }

        val p4: opt[i64] = pop[i64, Min](?h);
        if (!sel p4.some)  { ret 1; }
        if (p4.some != 40) { ret 1; }

        val p5: opt[i64] = pop[i64, Min](?h);
        if (!sel p5.some)  { ret 1; }
        if (p5.some != 50) { ret 1; }

        if (!is_empty[i64, Min](h)) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, Min](?h);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "heap: peek returns minimum without removing" {
        var a: allocator.Allocator;
        page.make(?a);
        var h: Heap[i64, Min] = init[i64, Min](?a);

        push[i64, Min](?h, 5);
        push[i64, Min](?h, 3);
        push[i64, Min](?h, 7);

        val r: opt[*i64] = peek[i64, Min](?h);
        if (!sel r.some)              { ret 1; }
        if (@r.some != 3)             { ret 1; }
        if (length[i64, Min](h) != 3) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, Min](?h);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "heap: pop from empty returns none" {
        var a: allocator.Allocator;
        page.make(?a);
        var h: Heap[i64, Min] = init[i64, Min](?a);

        val r: opt[i64] = pop[i64, Min](?h);
        if (!sel r.none) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, Min](?h);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "heap: peek on empty returns none" {
        var a: allocator.Allocator;
        page.make(?a);
        var h: Heap[i64, Min] = init[i64, Min](?a);

        val r: opt[*i64] = peek[i64, Min](?h);
        if (!sel r.none) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, Min](?h);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "heap: push many and verify sorted extraction" {
        var a: allocator.Allocator;
        page.make(?a);
        var h: Heap[i64, Min] = init[i64, Min](?a);

        push[i64, Min](?h, 99);
        push[i64, Min](?h, 1);
        push[i64, Min](?h, 50);
        push[i64, Min](?h, 25);
        push[i64, Min](?h, 75);
        push[i64, Min](?h, 12);
        push[i64, Min](?h, 88);
        push[i64, Min](?h, 6);

        var prev:  i64   = -1;
        var count: usize = 0;
        for (count < 8) {
            val r: opt[i64] = pop[i64, Min](?h);
            if (!sel r.some) { ret 1; }
            val v: i64 = r.some;
            if (v < prev) { ret 1; }
            prev  = v;
            count = count + 1;
        }

        if (!is_empty[i64, Min](h)) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, Min](?h);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "heap: dnit on empty heap succeeds" {
        var a: allocator.Allocator;
        page.make(?a);
        var h:     Heap[i64, Min]       = init[i64, Min](?a);
        val freed: err[allocator.Error] = dnit[i64, Min](?h);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "heap: duplicate values maintained" {
        var a: allocator.Allocator;
        page.make(?a);
        var h: Heap[i64, Min] = init[i64, Min](?a);

        push[i64, Min](?h, 5);
        push[i64, Min](?h, 5);
        push[i64, Min](?h, 3);
        push[i64, Min](?h, 3);

        val p6: opt[i64] = pop[i64, Min](?h);
        if (!sel p6.some) { ret 1; }
        if (p6.some != 3) { ret 1; }

        val p7: opt[i64] = pop[i64, Min](?h);
        if (!sel p7.some) { ret 1; }
        if (p7.some != 3) { ret 1; }

        val p8: opt[i64] = pop[i64, Min](?h);
        if (!sel p8.some) { ret 1; }
        if (p8.some != 5) { ret 1; }

        val p9: opt[i64] = pop[i64, Min](?h);
        if (!sel p9.some) { ret 1; }
        if (p9.some != 5) { ret 1; }

        if (!is_empty[i64, Min](h)) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, Min](?h);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    fun cmp_desc(a: *i64, b: *i64) i64 {
        if (@a > @b) { ret -1; }
        if (@a < @b) { ret 1; }
        ret 0;
    }

    test "heap: Max pops the greatest first" {
        var a: allocator.Allocator;
        page.make(?a);
        var h: Heap[i64, Max] = init[i64, Max](?a);
        push[i64, Max](?h, 30);
        push[i64, Max](?h, 10);
        push[i64, Max](?h, 50);
        push[i64, Max](?h, 20);
        val top: opt[*i64] = peek[i64, Max](?h);
        if (!sel top.some)   { ret 1; }
        if (@top.some != 50) { ret 1; }
        var prev: i64   = 100;
        var n:    usize = 0;
        for (n < 4) {
            val r: opt[i64] = pop[i64, Max](?h);
            if (!sel r.some)   { ret 1; }
            if (r.some > prev) { ret 1; }
            prev = r.some;
            n    = n + 1;
        }
        if (!is_empty[i64, Max](h)) { ret 1; }
        val freed: err[allocator.Error] = dnit[i64, Max](?h);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "heap: HeapBy orders by its comparator" {
        var a: allocator.Allocator;
        page.make(?a);
        var h: HeapBy[i64] = init_by[i64](?a, cmp_desc);
        if (!is_empty_by[i64](h)) { ret 1; }
        push_by[i64](?h, 3);
        push_by[i64](?h, 9);
        push_by[i64](?h, 1);
        if (length_by[i64](h) != 3) { ret 1; }
        val top: opt[*i64] = peek_by[i64](?h);
        if (!sel top.some)  { ret 1; }
        if (@top.some != 9) { ret 1; }
        val p1: opt[i64] = pop_by[i64](?h);
        if (!sel p1.some) { ret 1; }
        if (p1.some != 9) { ret 1; }
        val p2: opt[i64] = pop_by[i64](?h);
        if (!sel p2.some) { ret 1; }
        if (p2.some != 3) { ret 1; }
        val p3: opt[i64] = pop_by[i64](?h);
        if (!sel p3.some) { ret 1; }
        if (p3.some != 1) { ret 1; }
        val p4: opt[i64] = pop_by[i64](?h);
        if (sel p4.some) { ret 1; }
        val freed: err[allocator.Error] = dnit_by[i64](?h);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    rec Task { prio: u8; id: u32; }

    test "heap: records order by their fields in declaration order" {
        var a: allocator.Allocator;
        page.make(?a);
        var h: Heap[Task, Min] = init[Task, Min](?a);
        push[Task, Min](?h, Task{prio: 2, id: 7});
        push[Task, Min](?h, Task{prio: 1, id: 9});
        push[Task, Min](?h, Task{prio: 1, id: 4});
        push[Task, Min](?h, Task{prio: 0, id: 8});
        val p1: opt[Task] = pop[Task, Min](?h);
        if (!sel p1.some)      { ret 1; }
        if (p1.some.prio != 0) { ret 1; }
        val p2: opt[Task] = pop[Task, Min](?h);
        if (!sel p2.some)      { ret 1; }
        if (p2.some.prio != 1) { ret 1; }
        if (p2.some.id != 4)   { ret 1; }
        val p3: opt[Task] = pop[Task, Min](?h);
        if (!sel p3.some)      { ret 1; }
        if (p3.some.prio != 1) { ret 1; }
        if (p3.some.id != 9)   { ret 1; }
        val p4: opt[Task] = pop[Task, Min](?h);
        if (!sel p4.some)      { ret 1; }
        if (p4.some.prio != 2) { ret 1; }
        dnit[Task, Min](?h);
        ret 0;
    }

    fun step(s: *u64) u64 {
        var x: u64 = @s;
        x  = x ^ (x << 13);
        x  = x ^ (x >> 7);
        x  = x ^ (x << 17);
        @s = x;
        ret x;
    }

    # the reference: the pushed values kept sorted, popped from the front
    test "heap: randomized push and pop against a sorted reference" {
        var a: allocator.Allocator;
        page.make(?a);
        val n:  usize                      = 20000;
        val r1: res[*i64, allocator.Error] = allocator.allocate[i64](?a, n);
        if (sel r1.err) { ret 1; }
        val r2: res[*i64, allocator.Error] = allocator.allocate[i64](?a, n);
        if (sel r2.err) { ret 1; }
        val pushed: *i64 = r1.ok;
        val popped: *i64 = r2.ok;

        var s:     u64            = 0x2545F4914F6CDD1D;
        var min_h: Heap[i64, Min] = init[i64, Min](?a);
        var max_h: Heap[i64, Max] = init[i64, Max](?a);
        var by_h:  HeapBy[i64]    = init_by[i64](?a, cmp_desc);
        var i:     usize          = 0;
        for (i < n) {
            val v: i64 = (step(?s) % 500)::i64;
            pushed[i] = v;
            push[i64, Min](?min_h, v);
            push[i64, Max](?max_h, v);
            push_by[i64](?by_h, v);
            i = i + 1;
        }
        sort.sort[i64](pushed, n);

        i = 0;
        for (i < n) {
            val r: opt[i64] = pop[i64, Min](?min_h);
            if (!sel r.some)         { ret 2; }
            if (r.some != pushed[i]) { ret 3; }
            i = i + 1;
        }
        i = 0;
        for (i < n) {
            val r: opt[i64] = pop[i64, Max](?max_h);
            if (!sel r.some)                 { ret 4; }
            if (r.some != pushed[n - 1 - i]) { ret 5; }
            val q: opt[i64] = pop_by[i64](?by_h);
            if (!sel q.some)                 { ret 6; }
            if (q.some != pushed[n - 1 - i]) { ret 7; }
            i = i + 1;
        }
        if (!is_empty[i64, Min](min_h) || !is_empty[i64, Max](max_h) || !is_empty_by[i64](by_h)) { ret 8; }

        # interleaved: every pop returns the least element the heap holds
        var live: usize = 0;
        var k:    usize = 0;
        for (k < 20000) {
            val roll: u64 = step(?s) % 3;
            if (roll != 0 || live == 0) {
                val v: i64 = (step(?s) % 1000)::i64;
                push[i64, Min](?min_h, v);
                popped[live] = v;
                live         = live + 1;
            }
            or {
                val r: opt[i64] = pop[i64, Min](?min_h);
                if (!sel r.some) { ret 9; }
                var least: usize = 0;
                var j:     usize = 1;
                for (j < live) {
                    if (popped[j] < popped[least]) { least = j; }
                    j = j + 1;
                }
                if (r.some != popped[least]) { ret 10; }
                popped[least] = popped[live - 1];
                live          = live - 1;
            }
            if (length[i64, Min](min_h) != live) { ret 11; }
            k = k + 1;
        }

        dnit[i64, Min](?min_h);
        dnit[i64, Max](?max_h);
        dnit_by[i64](?by_h);
        allocator.deallocate[i64](?a, pushed, n);
        allocator.deallocate[i64](?a, popped, n);
        ret 0;
    }
}
