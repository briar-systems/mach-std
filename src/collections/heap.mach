# binary min-heap (priority queue)

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use std.allocator;
use std.allocator.page;

pub rec Heap[T] {
    alloc: *allocator.Allocator;
    data:  *T;
    len:   usize;
    cap:   usize;
    cmp:   fun(*T, *T) i64;
}

# create an empty min-heap
# ---
# alloc: allocator to use for allocations
# cmp:   comparison function (negative if a < b, 0 if equal, positive if a > b)
# ret:   a new empty Heap[T]
pub fun init[T](alloc: *allocator.Allocator, cmp: fun(*T, *T) i64) Heap[T] {
    var h: Heap[T];
    h.alloc = alloc;
    h.data = nil;
    h.len = 0;
    h.cap = 0;
    h.cmp = cmp;
    ret h;
}

# free the backing buffer
#
# elements are not visited: an element that owns storage is the caller's to
# release before this runs.
# ---
# ret: ok when the buffer was released (or there was none), or the refusal,
#      in which case the heap is left as it was
pub fun dnit[T](h: *Heap[T]) err[allocator.Error] {
    if (h == nil) { ret err[allocator.Error].ok{}; }
    if (h.cap == 0) {
        h.data = nil;
        h.len = 0;
        ret err[allocator.Error].ok{};
    }

    val freed: err[allocator.Error] = allocator.deallocate[T](h.alloc, h.data, h.cap);
    if (sel freed.err) { ret freed; }
    h.data = nil;
    h.len = 0;
    h.cap = 0;
    ret err[allocator.Error].ok{};
}

# check if the heap is empty
# ---
# ret: true if the heap has no elements
pub fun is_empty[T](h: Heap[T]) bool {
    ret h.len == 0;
}

# return the number of elements in the heap
# ---
# ret: number of elements
pub fun length[T](h: Heap[T]) usize {
    ret h.len;
}

# grow the backing buffer to at least double capacity
#
# a refused growth leaves the heap exactly as it was.
# ---
# ret: the new capacity, or the allocator's refusal
fun grow[T](h: *Heap[T]) res[usize, allocator.Error] {
    var new_cap: usize;
    if (h.cap == 0) {
        new_cap = 8;
    } or {
        new_cap = h.cap * 2;
        if (new_cap < h.cap) {
            ret res[usize, allocator.Error].err{allocator.Error.overflow{}};
        }
    }

    val r: res[*T, allocator.Error] = allocator.reallocate[T](h.alloc, h.data, h.cap, new_cap);
    if (sel r.err) { ret res[usize, allocator.Error].err{r.err}; }

    h.data = r.ok;
    h.cap = new_cap;

    ret res[usize, allocator.Error].ok{new_cap};
}

# restore heap property upward from the given index
fun sift_up[T](h: *Heap[T], start: usize) {
    var i: usize = start;
    for (i > 0) {
        val parent: usize = (i - 1) / 2;
        if (h.cmp(?h.data[i], ?h.data[parent]) < 0) {
            val tmp: T = h.data[i];
            h.data[i] = h.data[parent];
            h.data[parent] = tmp;
            i = parent;
        } or {
            brk;
        }
    }
}

# restore heap property downward from the given index
fun sift_down[T](h: *Heap[T], start: usize) {
    var i: usize = start;
    for (i < h.len) {
        val left: usize = 2 * i + 1;
        val right: usize = 2 * i + 2;
        var smallest: usize = i;

        if (left < h.len) {
            if (h.cmp(?h.data[left], ?h.data[smallest]) < 0) {
                smallest = left;
            }
        }

        if (right < h.len) {
            if (h.cmp(?h.data[right], ?h.data[smallest]) < 0) {
                smallest = right;
            }
        }

        if (smallest == i) {
            brk;
        }

        val tmp: T = h.data[i];
        h.data[i] = h.data[smallest];
        h.data[smallest] = tmp;
        i = smallest;
    }
}

# add an element to the heap
#
# the value is copied in; a refused growth leaves the heap unchanged and the
# value the caller's.
# ---
# value: value to insert
# ret:   the new length, or the allocator's refusal
pub fun push[T](h: *Heap[T], value: T) res[usize, allocator.Error] {
    if (h == nil) { ret res[usize, allocator.Error].err{allocator.Error.invalid{}}; }
    if (h.len == h.cap) {
        val r: res[usize, allocator.Error] = grow[T](h);
        if (sel r.err) { ret r; }
    }

    h.data[h.len] = value;
    h.len = h.len + 1;
    sift_up[T](h, h.len - 1);
    ret res[usize, allocator.Error].ok{h.len};
}

# remove and return the minimum element
#
# the element is copied out; one that owns storage is now the caller's.
# ---
# ret: the minimum value, or none when the heap is empty
pub fun pop[T](h: *Heap[T]) opt[T] {
    if (h == nil)   { ret opt[T].none{}; }
    if (h.len == 0) { ret opt[T].none{}; }

    val min_val: T = h.data[0];
    h.len = h.len - 1;

    if (h.len > 0) {
        h.data[0] = h.data[h.len];
        sift_down[T](h, 0);
    }

    ret opt[T].some{min_val};
}

# return a pointer to the minimum element without removing it
#
# the pointer is into the heap's storage and is invalidated by any growth.
# ---
# ret: pointer to the minimum element, or none when the heap is empty
pub fun peek[T](h: *Heap[T]) opt[*T] {
    if (h == nil)   { ret opt[*T].none{}; }
    if (h.len == 0) { ret opt[*T].none{}; }

    ret opt[*T].some{?h.data[0]};
}

fun cmp_i64(a: *i64, b: *i64) i64 {
    if (@a < @b) { ret -1; }
    if (@a > @b) { ret 1; }
    ret 0;
}

test "heap: init creates empty heap" {
    var a: allocator.Allocator;
    page.make(?a);
    val h: Heap[i64] = init[i64](?a, cmp_i64);
    if (!is_empty[i64](h)) { ret 1; }
    if (length[i64](h) != 0) { ret 1; }
    ret 0;
}

test "heap: push and pop returns ascending order" {
    var a: allocator.Allocator;
    page.make(?a);
    var h: Heap[i64] = init[i64](?a, cmp_i64);

    push[i64](?h, 30);
    push[i64](?h, 10);
    push[i64](?h, 50);
    push[i64](?h, 20);
    push[i64](?h, 40);

    val p1: opt[i64] = pop[i64](?h);
    if (!sel p1.some) { ret 1; }
    if (p1.some != 10) { ret 1; }

    val p2: opt[i64] = pop[i64](?h);
    if (!sel p2.some) { ret 1; }
    if (p2.some != 20) { ret 1; }

    val p3: opt[i64] = pop[i64](?h);
    if (!sel p3.some) { ret 1; }
    if (p3.some != 30) { ret 1; }

    val p4: opt[i64] = pop[i64](?h);
    if (!sel p4.some) { ret 1; }
    if (p4.some != 40) { ret 1; }

    val p5: opt[i64] = pop[i64](?h);
    if (!sel p5.some) { ret 1; }
    if (p5.some != 50) { ret 1; }

    if (!is_empty[i64](h)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?h);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "heap: peek returns minimum without removing" {
    var a: allocator.Allocator;
    page.make(?a);
    var h: Heap[i64] = init[i64](?a, cmp_i64);

    push[i64](?h, 5);
    push[i64](?h, 3);
    push[i64](?h, 7);

    val r: opt[*i64] = peek[i64](?h);
    if (!sel r.some) { ret 1; }
    if (@r.some != 3) { ret 1; }
    if (length[i64](h) != 3) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?h);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "heap: pop from empty returns none" {
    var a: allocator.Allocator;
    page.make(?a);
    var h: Heap[i64] = init[i64](?a, cmp_i64);

    val r: opt[i64] = pop[i64](?h);
    if (!sel r.none) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?h);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "heap: peek on empty returns none" {
    var a: allocator.Allocator;
    page.make(?a);
    var h: Heap[i64] = init[i64](?a, cmp_i64);

    val r: opt[*i64] = peek[i64](?h);
    if (!sel r.none) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?h);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "heap: push many and verify sorted extraction" {
    var a: allocator.Allocator;
    page.make(?a);
    var h: Heap[i64] = init[i64](?a, cmp_i64);

    push[i64](?h, 99);
    push[i64](?h, 1);
    push[i64](?h, 50);
    push[i64](?h, 25);
    push[i64](?h, 75);
    push[i64](?h, 12);
    push[i64](?h, 88);
    push[i64](?h, 6);

    var prev: i64 = -1;
    var count: usize = 0;
    for (count < 8) {
        val r: opt[i64] = pop[i64](?h);
        if (!sel r.some) { ret 1; }
        val v: i64 = r.some;
        if (v < prev) { ret 1; }
        prev = v;
        count = count + 1;
    }

    if (!is_empty[i64](h)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?h);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "heap: dnit on empty heap succeeds" {
    var a: allocator.Allocator;
    page.make(?a);
    var h: Heap[i64] = init[i64](?a, cmp_i64);
    val freed: err[allocator.Error] = dnit[i64](?h);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "heap: duplicate values maintained" {
    var a: allocator.Allocator;
    page.make(?a);
    var h: Heap[i64] = init[i64](?a, cmp_i64);

    push[i64](?h, 5);
    push[i64](?h, 5);
    push[i64](?h, 3);
    push[i64](?h, 3);

    val p6: opt[i64] = pop[i64](?h);
    if (!sel p6.some) { ret 1; }
    if (p6.some != 3) { ret 1; }

    val p7: opt[i64] = pop[i64](?h);
    if (!sel p7.some) { ret 1; }
    if (p7.some != 3) { ret 1; }

    val p8: opt[i64] = pop[i64](?h);
    if (!sel p8.some) { ret 1; }
    if (p8.some != 5) { ret 1; }

    val p9: opt[i64] = pop[i64](?h);
    if (!sel p9.some) { ret 1; }
    if (p9.some != 5) { ret 1; }

    if (!is_empty[i64](h)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?h);
    if (sel freed.err) { ret 1; }
    ret 0;
}
