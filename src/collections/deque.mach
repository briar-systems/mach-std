# double-ended queue (ring buffer)

use std.allocator;
use std.system.capability;

$if (capability.HOSTED) {
    use std.allocator.page;
}

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

pub rec Deque[T] {
    alloc: *allocator.Allocator;
    data:  *T;
    head:  usize;
    len:   usize;
    cap:   usize;
}

# create an empty deque
# ---
# alloc: allocator to use for allocations
# ret:   a new empty Deque[T]
pub fun init[T](alloc: *allocator.Allocator) Deque[T] {
    var dq: Deque[T];
    dq.alloc = alloc;
    dq.data  = nil;
    dq.head  = 0;
    dq.len   = 0;
    dq.cap   = 0;
    ret dq;
}

# free the backing buffer
#
# elements are not visited: an element that owns storage is the caller's to
# release before this runs.
# ---
# ret: ok when the buffer was released (or there was none), or the refusal,
#      in which case the deque is left as it was
pub fun dnit[T](dq: *Deque[T]) err[allocator.Error] {
    if (dq == nil) { ret err[allocator.Error].ok{}; }
    if (dq.cap == 0) {
        dq.data = nil;
        dq.len  = 0;
        dq.head = 0;
        ret err[allocator.Error].ok{};
    }

    val freed: err[allocator.Error] = allocator.deallocate[T](dq.alloc, dq.data, dq.cap);
    if (sel freed.err) { ret freed; }
    dq.data = nil;
    dq.len  = 0;
    dq.head = 0;
    dq.cap  = 0;
    ret err[allocator.Error].ok{};
}

# check if the deque is empty
# ---
# ret: true if the deque has no elements
pub fun is_empty[T](dq: Deque[T]) bool {
    ret dq.len == 0;
}

# return the number of elements in the deque
# ---
# ret: number of elements
pub fun length[T](dq: Deque[T]) usize {
    ret dq.len;
}

# grow the ring buffer to at least double its current capacity
#
# a refused growth leaves the deque exactly as it was.
# ---
# ret: the new capacity, or the allocator's refusal
fun grow[T](dq: *Deque[T]) res[usize, allocator.Error] {
    var new_cap: usize;
    if (dq.cap == 0) {
        new_cap = 8;
    }
    or {
        new_cap = dq.cap * 2;
        if (new_cap < dq.cap) {
            ret res[usize, allocator.Error].err{allocator.Error.overflow{}};
        }
    }

    val r: res[*T, allocator.Error] = allocator.allocate[T](dq.alloc, new_cap);
    if (sel r.err) { ret res[usize, allocator.Error].err{r.err}; }

    val new_data: *T = r.ok;

    var i: usize = 0;
    for (i < dq.len) {
        val src_idx: usize = (dq.head + i) % dq.cap;
        new_data[i] = dq.data[src_idx];
        i           = i + 1;
    }

    if (dq.cap > 0) {
        allocator.deallocate[T](dq.alloc, dq.data, dq.cap);
    }

    dq.data = new_data;
    dq.head = 0;
    dq.cap  = new_cap;

    ret res[usize, allocator.Error].ok{new_cap};
}

# append a value to the back of the deque
# ---
# value: value to append
# ret:   the new length, or the allocator's refusal, which leaves the deque
#        unchanged and the value the caller's
pub fun push_back[T](dq: *Deque[T], value: T) res[usize, allocator.Error] {
    if (dq == nil) { ret res[usize, allocator.Error].err{allocator.Error.invalid{}}; }
    if (dq.len == dq.cap) {
        val r: res[usize, allocator.Error] = grow[T](dq);
        if (sel r.err) { ret r; }
    }

    val idx: usize = (dq.head + dq.len) % dq.cap;
    dq.data[idx] = value;
    dq.len       = dq.len + 1;
    ret res[usize, allocator.Error].ok{dq.len};
}

# prepend a value to the front of the deque
# ---
# value: value to prepend
# ret:   the new length, or the allocator's refusal, which leaves the deque
#        unchanged and the value the caller's
pub fun push_front[T](dq: *Deque[T], value: T) res[usize, allocator.Error] {
    if (dq == nil) { ret res[usize, allocator.Error].err{allocator.Error.invalid{}}; }
    if (dq.len == dq.cap) {
        val r: res[usize, allocator.Error] = grow[T](dq);
        if (sel r.err) { ret r; }
    }

    dq.head          = (dq.head + dq.cap - 1) % dq.cap;
    dq.data[dq.head] = value;
    dq.len           = dq.len + 1;
    ret res[usize, allocator.Error].ok{dq.len};
}

# remove and return the element at the back
#
# the element is copied out; one that owns storage is now the caller's.
# ---
# ret: the value, or none when the deque is empty
pub fun pop_back[T](dq: *Deque[T]) opt[T] {
    if (dq == nil)   { ret opt[T].none{}; }
    if (dq.len == 0) { ret opt[T].none{}; }

    dq.len = dq.len - 1;
    val idx: usize = (dq.head + dq.len) % dq.cap;
    ret opt[T].some{dq.data[idx]};
}

# remove and return the element at the front
#
# the element is copied out; one that owns storage is now the caller's.
# ---
# ret: the value, or none when the deque is empty
pub fun pop_front[T](dq: *Deque[T]) opt[T] {
    if (dq == nil)   { ret opt[T].none{}; }
    if (dq.len == 0) { ret opt[T].none{}; }

    val value: T = dq.data[dq.head];
    dq.head = (dq.head + 1) % dq.cap;
    dq.len  = dq.len - 1;
    ret opt[T].some{value};
}

# get a pointer to the element at the given logical index
#
# the pointer is into the deque's storage and is invalidated by any growth.
# ---
# index: logical index (0 = front)
# ret:   pointer to element, or none when the index is out of range
pub fun get[T](dq: *Deque[T], index: usize) opt[*T] {
    if (dq == nil)       { ret opt[*T].none{}; }
    if (index >= dq.len) { ret opt[*T].none{}; }

    val phys: usize = (dq.head + index) % dq.cap;
    ret opt[*T].some{?dq.data[phys]};
}

# reset the deque to empty without freeing memory
pub fun clear[T](dq: *Deque[T]) {
    if (dq == nil) { ret; }
    dq.len  = 0;
    dq.head = 0;
}

$if (capability.HOSTED) {
    # both ends through a head that wraps below zero, then growth while the
    # contents wrap the buffer end, which must keep logical order
    test deque__both_ends_across_wrap_and_growth {
        var a: allocator.Allocator;
        page.make(?a);
        var dq: Deque[i64] = init[i64](?a);
        val e1: opt[i64]   = pop_front[i64](?dq);
        val e2: opt[i64]   = pop_back[i64](?dq);
        if (sel e1.some) { ret 1; }
        if (sel e2.some) { ret 1; }

        # logical order -4..3, stored wrapped around the end of an 8-slot buffer
        var i: i64 = 0;
        for (i < 4) {
            push_back[i64](?dq, i);
            push_front[i64](?dq, -1 - i);
            i = i + 1;
        }
        if (dq.cap != 8 || dq.head == 0) { ret 2; }
        push_back[i64](?dq, 4);
        if (dq.cap != 16 || length[i64](dq) != 9) { ret 3; }

        var k: usize = 0;
        for (k < 9) {
            val g: opt[*i64] = get[i64](?dq, k);
            if (!sel g.some)             { ret 4; }
            if (@g.some != (k::i64) - 4) { ret 5; }
            k = k + 1;
        }
        val oob: opt[*i64] = get[i64](?dq, 9);
        if (sel oob.some) { ret 6; }

        val f: opt[i64] = pop_front[i64](?dq);
        if (!sel f.some)  { ret 7; }
        if (f.some != -4) { ret 7; }
        val b: opt[i64] = pop_back[i64](?dq);
        if (!sel b.some) { ret 8; }
        if (b.some != 4) { ret 8; }
        dnit[i64](?dq);
        ret 0;
    }
}
