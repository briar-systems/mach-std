# double-ended queue (ring buffer)

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use std.allocator;
use std.allocator.page;

pub rec Deque[T] {
    alloc: *allocator.Allocator;
    data:  *T;
    head:  usize;
    len:   usize;
    cap:   usize;
}

# create an empty deque
# ---
# alloc: allocator to use for allocations
# ret:   a new empty Deque[T]
pub fun init[T](alloc: *allocator.Allocator) Deque[T] {
    var dq: Deque[T];
    dq.alloc = alloc;
    dq.data = nil;
    dq.head = 0;
    dq.len = 0;
    dq.cap = 0;
    ret dq;
}

# free the backing buffer
#
# elements are not visited: an element that owns storage is the caller's to
# release before this runs.
# ---
# ret: ok when the buffer was released (or there was none), or the refusal,
#      in which case the deque is left as it was
pub fun dnit[T](dq: *Deque[T]) err[allocator.Error] {
    if (dq == nil) { ret err[allocator.Error].ok{}; }
    if (dq.cap == 0) {
        dq.data = nil;
        dq.len = 0;
        dq.head = 0;
        ret err[allocator.Error].ok{};
    }

    val freed: err[allocator.Error] = allocator.deallocate[T](dq.alloc, dq.data, dq.cap);
    if (sel freed.err) { ret freed; }
    dq.data = nil;
    dq.len = 0;
    dq.head = 0;
    dq.cap = 0;
    ret err[allocator.Error].ok{};
}

# check if the deque is empty
# ---
# ret: true if the deque has no elements
pub fun is_empty[T](dq: Deque[T]) bool {
    ret dq.len == 0;
}

# return the number of elements in the deque
# ---
# ret: number of elements
pub fun length[T](dq: Deque[T]) usize {
    ret dq.len;
}

# grow the ring buffer to at least double its current capacity
#
# a refused growth leaves the deque exactly as it was.
# ---
# ret: the new capacity, or the allocator's refusal
fun grow[T](dq: *Deque[T]) res[usize, allocator.Error] {
    var new_cap: usize;
    if (dq.cap == 0) {
        new_cap = 8;
    } or {
        new_cap = dq.cap * 2;
        if (new_cap < dq.cap) {
            ret res[usize, allocator.Error].err{allocator.Error.overflow{}};
        }
    }

    val r: res[*T, allocator.Error] = allocator.allocate[T](dq.alloc, new_cap);
    if (sel r.err) { ret res[usize, allocator.Error].err{r.err}; }

    val new_data: *T = r.ok;

    var i: usize = 0;
    for (i < dq.len) {
        val src_idx: usize = (dq.head + i) % dq.cap;
        new_data[i] = dq.data[src_idx];
        i = i + 1;
    }

    if (dq.cap > 0) {
        allocator.deallocate[T](dq.alloc, dq.data, dq.cap);
    }

    dq.data = new_data;
    dq.head = 0;
    dq.cap = new_cap;

    ret res[usize, allocator.Error].ok{new_cap};
}

# append a value to the back of the deque
# ---
# value: value to append
# ret:   the new length, or the allocator's refusal, which leaves the deque
#        unchanged and the value the caller's
pub fun push_back[T](dq: *Deque[T], value: T) res[usize, allocator.Error] {
    if (dq == nil) { ret res[usize, allocator.Error].err{allocator.Error.invalid{}}; }
    if (dq.len == dq.cap) {
        val r: res[usize, allocator.Error] = grow[T](dq);
        if (sel r.err) { ret r; }
    }

    val idx: usize = (dq.head + dq.len) % dq.cap;
    dq.data[idx] = value;
    dq.len = dq.len + 1;
    ret res[usize, allocator.Error].ok{dq.len};
}

# prepend a value to the front of the deque
# ---
# value: value to prepend
# ret:   the new length, or the allocator's refusal, which leaves the deque
#        unchanged and the value the caller's
pub fun push_front[T](dq: *Deque[T], value: T) res[usize, allocator.Error] {
    if (dq == nil) { ret res[usize, allocator.Error].err{allocator.Error.invalid{}}; }
    if (dq.len == dq.cap) {
        val r: res[usize, allocator.Error] = grow[T](dq);
        if (sel r.err) { ret r; }
    }

    dq.head = (dq.head + dq.cap - 1) % dq.cap;
    dq.data[dq.head] = value;
    dq.len = dq.len + 1;
    ret res[usize, allocator.Error].ok{dq.len};
}

# remove and return the element at the back
#
# the element is copied out; one that owns storage is now the caller's.
# ---
# ret: the value, or none when the deque is empty
pub fun pop_back[T](dq: *Deque[T]) opt[T] {
    if (dq == nil)   { ret opt[T].none{}; }
    if (dq.len == 0) { ret opt[T].none{}; }

    dq.len = dq.len - 1;
    val idx: usize = (dq.head + dq.len) % dq.cap;
    ret opt[T].some{dq.data[idx]};
}

# remove and return the element at the front
#
# the element is copied out; one that owns storage is now the caller's.
# ---
# ret: the value, or none when the deque is empty
pub fun pop_front[T](dq: *Deque[T]) opt[T] {
    if (dq == nil)   { ret opt[T].none{}; }
    if (dq.len == 0) { ret opt[T].none{}; }

    val value: T = dq.data[dq.head];
    dq.head = (dq.head + 1) % dq.cap;
    dq.len = dq.len - 1;
    ret opt[T].some{value};
}

# get a pointer to the element at the given logical index
#
# the pointer is into the deque's storage and is invalidated by any growth.
# ---
# index: logical index (0 = front)
# ret:   pointer to element, or none when the index is out of range
pub fun get[T](dq: *Deque[T], index: usize) opt[*T] {
    if (dq == nil)       { ret opt[*T].none{}; }
    if (index >= dq.len) { ret opt[*T].none{}; }

    val phys: usize = (dq.head + index) % dq.cap;
    ret opt[*T].some{?dq.data[phys]};
}

# reset the deque to empty without freeing memory
pub fun clear[T](dq: *Deque[T]) {
    if (dq == nil) { ret; }
    dq.len = 0;
    dq.head = 0;
}

test "deque: init creates empty deque" {
    var a: allocator.Allocator;
    page.make(?a);
    val dq: Deque[i64] = init[i64](?a);
    if (!is_empty[i64](dq)) { ret 1; }
    if (length[i64](dq) != 0) { ret 1; }
    ret 0;
}

test "deque: push_back and pop_front (FIFO)" {
    var a: allocator.Allocator;
    page.make(?a);
    var dq: Deque[i64] = init[i64](?a);

    push_back[i64](?dq, 10);
    push_back[i64](?dq, 20);
    push_back[i64](?dq, 30);

    val p1: opt[i64] = pop_front[i64](?dq);
    if (!sel p1.some) { ret 1; }
    if (p1.some != 10) { ret 1; }

    val p2: opt[i64] = pop_front[i64](?dq);
    if (!sel p2.some) { ret 1; }
    if (p2.some != 20) { ret 1; }

    val p3: opt[i64] = pop_front[i64](?dq);
    if (!sel p3.some) { ret 1; }
    if (p3.some != 30) { ret 1; }

    if (!is_empty[i64](dq)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?dq);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "deque: push_front and pop_back (FIFO reversed)" {
    var a: allocator.Allocator;
    page.make(?a);
    var dq: Deque[i64] = init[i64](?a);

    push_front[i64](?dq, 10);
    push_front[i64](?dq, 20);
    push_front[i64](?dq, 30);

    val p4: opt[i64] = pop_back[i64](?dq);
    if (!sel p4.some) { ret 1; }
    if (p4.some != 10) { ret 1; }

    val p5: opt[i64] = pop_back[i64](?dq);
    if (!sel p5.some) { ret 1; }
    if (p5.some != 20) { ret 1; }

    val p6: opt[i64] = pop_back[i64](?dq);
    if (!sel p6.some) { ret 1; }
    if (p6.some != 30) { ret 1; }

    if (!is_empty[i64](dq)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?dq);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "deque: mixed push and pop" {
    var a: allocator.Allocator;
    page.make(?a);
    var dq: Deque[i64] = init[i64](?a);

    push_back[i64](?dq, 1);
    push_back[i64](?dq, 2);
    push_front[i64](?dq, 0);

    if (length[i64](dq) != 3) { ret 1; }

    val p7: opt[i64] = pop_front[i64](?dq);
    if (!sel p7.some) { ret 1; }
    if (p7.some != 0) { ret 1; }

    val p8: opt[i64] = pop_back[i64](?dq);
    if (!sel p8.some) { ret 1; }
    if (p8.some != 2) { ret 1; }

    val p9: opt[i64] = pop_front[i64](?dq);
    if (!sel p9.some) { ret 1; }
    if (p9.some != 1) { ret 1; }

    if (!is_empty[i64](dq)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?dq);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "deque: get by index" {
    var a: allocator.Allocator;
    page.make(?a);
    var dq: Deque[i64] = init[i64](?a);

    push_back[i64](?dq, 100);
    push_back[i64](?dq, 200);
    push_back[i64](?dq, 300);

    val r0: opt[*i64] = get[i64](?dq, 0);
    if (!sel r0.some) { ret 1; }
    if (@r0.some != 100) { ret 1; }

    val r1: opt[*i64] = get[i64](?dq, 1);
    if (!sel r1.some) { ret 1; }
    if (@r1.some != 200) { ret 1; }

    val r2: opt[*i64] = get[i64](?dq, 2);
    if (!sel r2.some) { ret 1; }
    if (@r2.some != 300) { ret 1; }

    val r_oob: opt[*i64] = get[i64](?dq, 3);
    if (!sel r_oob.none) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?dq);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "deque: pop from empty returns none" {
    var a: allocator.Allocator;
    page.make(?a);
    var dq: Deque[i64] = init[i64](?a);

    val r1: opt[i64] = pop_front[i64](?dq);
    if (!sel r1.none) { ret 1; }

    val r2: opt[i64] = pop_back[i64](?dq);
    if (!sel r2.none) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?dq);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "deque: wrap-around behavior" {
    var a: allocator.Allocator;
    page.make(?a);
    var dq: Deque[i64] = init[i64](?a);

    var i: i64 = 0;
    for (i < 8) {
        push_back[i64](?dq, i);
        i = i + 1;
    }

    var j: i64 = 0;
    for (j < 4) {
        pop_front[i64](?dq);
        j = j + 1;
    }

    var k: i64 = 8;
    for (k < 12) {
        push_back[i64](?dq, k);
        k = k + 1;
    }

    if (length[i64](dq) != 8) { ret 1; }

    val p10: opt[i64] = pop_front[i64](?dq);
    if (!sel p10.some) { ret 1; }
    if (p10.some != 4) { ret 1; }

    val p11: opt[i64] = pop_front[i64](?dq);
    if (!sel p11.some) { ret 1; }
    if (p11.some != 5) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?dq);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "deque: clear resets length and head" {
    var a: allocator.Allocator;
    page.make(?a);
    var dq: Deque[i64] = init[i64](?a);

    push_back[i64](?dq, 1);
    push_back[i64](?dq, 2);
    push_back[i64](?dq, 3);

    clear[i64](?dq);

    if (length[i64](dq) != 0) { ret 1; }
    if (!is_empty[i64](dq)) { ret 1; }

    push_back[i64](?dq, 42);
    val r: opt[i64] = pop_front[i64](?dq);
    if (!sel r.some) { ret 1; }
    if (r.some != 42) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64](?dq);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "deque: dnit on empty deque succeeds" {
    var a: allocator.Allocator;
    page.make(?a);
    var dq: Deque[i64] = init[i64](?a);
    val freed: err[allocator.Error] = dnit[i64](?dq);
    if (sel freed.err) { ret 1; }
    ret 0;
}
