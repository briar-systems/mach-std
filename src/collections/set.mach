# hash set backed by Map
#
# `Set[K]` keys by the natural hash and equality of `K` and `SetBy[K]` by
# stored functions, exactly as `Map` and `MapBy` do; see `map` for the
# contract.

use std.allocator;
use std.system.capability;

$if (capability.HOSTED) {
    use std.allocator.page;
}

use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# hash set of unique keys by the natural hash and equality of `K`
# ---
# inner: backing hash map with u8 dummy values
pub rec Set[K] {
    inner: map.Map[K, u8];
}

# hash set of unique keys by caller-supplied hash and equality functions
# ---
# inner: backing hash map with u8 dummy values
pub rec SetBy[K] {
    inner: map.MapBy[K, u8];
}

# create an empty set
# ---
# alloc: allocator for backing storage
# ret:   a new empty Set[K]
pub fun init[K](alloc: *allocator.Allocator) Set[K] {
    var s: Set[K];
    s.inner = map.init[K, u8](alloc);
    ret s;
}

# create an empty set keyed by the given functions
# ---
# alloc:   allocator for backing storage
# hash_fn: hash function over a key
# eq_fn:   equality function over two keys
# ret:     a new empty SetBy[K]
pub fun init_by[K](alloc: *allocator.Allocator, hash_fn: fun(*K) u64, eq_fn: fun(*K, *K) bool) SetBy[K] {
    var s: SetBy[K];
    s.inner = map.init_by[K, u8](alloc, hash_fn, eq_fn);
    ret s;
}

# free all backing storage and reset the set
# ---
# ret: ok when the backing storage was released, or the first refusal
pub fun dnit[K](s: *Set[K]) err[allocator.Error] {
    ret map.dnit[K, u8](?s.inner);
}

# free all backing storage of a `SetBy`; see `dnit`
pub fun dnit_by[K](s: *SetBy[K]) err[allocator.Error] {
    ret map.dnit_by[K, u8](?s.inner);
}

# check if the set has no entries
# ---
# ret: true if the set is empty
pub fun is_empty[K](s: Set[K]) bool {
    ret map.is_empty[K, u8](s.inner);
}

# check if a `SetBy` has no entries; see `is_empty`
pub fun is_empty_by[K](s: SetBy[K]) bool {
    ret map.is_empty_by[K, u8](s.inner);
}

# return the number of entries in the set
# ---
# ret: number of entries
pub fun length[K](s: Set[K]) usize {
    ret map.length[K, u8](s.inner);
}

# return the number of entries in a `SetBy`; see `length`
pub fun length_by[K](s: SetBy[K]) usize {
    ret map.length_by[K, u8](s.inner);
}

# add a key to the set
# ---
# key: key to insert
# ret: true if the key was new, false if it already existed, or the
#      allocator's refusal
pub fun insert[K](s: *Set[K], key: K) res[bool, allocator.Error] {
    ret map.insert[K, u8](?s.inner, key, 0);
}

# add a key to a `SetBy`; see `insert`
pub fun insert_by[K](s: *SetBy[K], key: K) res[bool, allocator.Error] {
    ret map.insert_by[K, u8](?s.inner, key, 0);
}

# check if the set contains a key
# ---
# key: pointer to the key to check
# ret: true if the key exists
pub fun contains[K](s: *Set[K], key: *K) bool {
    ret map.contains[K, u8](?s.inner, key);
}

# check if a `SetBy` contains a key; see `contains`
pub fun contains_by[K](s: *SetBy[K], key: *K) bool {
    ret map.contains_by[K, u8](?s.inner, key);
}

# remove a key from the set
# ---
# key: pointer to the key to remove
# ret: true if removed, false if the key was not found
pub fun remove[K](s: *Set[K], key: *K) bool {
    ret map.remove[K, u8](?s.inner, key);
}

# remove a key from a `SetBy`; see `remove`
pub fun remove_by[K](s: *SetBy[K], key: *K) bool {
    ret map.remove_by[K, u8](?s.inner, key);
}

# a copy of the set on another allocator, without rehashing; see `map.clone`
# ---
# alloc: allocator for the copy's backing storage
# ret:   the copy, or the allocator's refusal
pub fun clone[K](s: *Set[K], alloc: *allocator.Allocator) res[Set[K], allocator.Error] {
    val r: res[map.Map[K, u8], allocator.Error] = map.clone[K, u8](?s.inner, alloc);
    if (sel r.err) { ret res[Set[K], allocator.Error].err{r.err}; }
    var c: Set[K];
    c.inner = r.ok;
    ret res[Set[K], allocator.Error].ok{c};
}

# a copy of a `SetBy` on another allocator, carrying its functions; see `clone`
pub fun clone_by[K](s: *SetBy[K], alloc: *allocator.Allocator) res[SetBy[K], allocator.Error] {
    val r: res[map.MapBy[K, u8], allocator.Error] = map.clone_by[K, u8](?s.inner, alloc);
    if (sel r.err) { ret res[SetBy[K], allocator.Error].err{r.err}; }
    var c: SetBy[K];
    c.inner = r.ok;
    ret res[SetBy[K], allocator.Error].ok{c};
}

# begin a walk over the set's keys; see `map.iter` for the walk's rules
# ---
# ret: a cursor at the first slot
pub fun iter[K](s: *Set[K]) map.Iter {
    ret map.iter[K, u8](?s.inner);
}

# begin a walk over a `SetBy`'s keys; see `iter`
pub fun iter_by[K](s: *SetBy[K]) map.Iter {
    ret map.iter_by[K, u8](?s.inner);
}

# advance to the next live key
# ---
# it:  the cursor, advanced past the key yielded
# out: filled with a pointer to the key, into the set's storage
# ret: true with `out` filled, or false when the walk is over
pub fun next[K](s: *Set[K], it: *map.Iter, out: **K) bool {
    var e: map.Entry[K, u8];
    if (!map.next[K, u8](?s.inner, it, ?e)) { ret false; }
    @out = e.key;
    ret true;
}

# advance to the next live key of a `SetBy`; see `next`
pub fun next_by[K](s: *SetBy[K], it: *map.Iter, out: **K) bool {
    var e: map.Entry[K, u8];
    if (!map.next_by[K, u8](?s.inner, it, ?e)) { ret false; }
    @out = e.key;
    ret true;
}

# remove all entries but keep allocated capacity
pub fun clear[K](s: *Set[K]) {
    map.clear[K, u8](?s.inner);
}

# remove all entries of a `SetBy` but keep allocated capacity; see `clear`
pub fun clear_by[K](s: *SetBy[K]) {
    map.clear_by[K, u8](?s.inner);
}

$if (capability.HOSTED) {
    test set__clone_and_iteration {
        var a: allocator.Allocator;
        page.make(?a);
        var s: Set[i64] = init[i64](?a);
        var i: i64      = 0;
        for (i < 100) {
            insert[i64](?s, i);
            i = i + 1;
        }
        i = 0;
        for (i < 100) {
            if (i % 5 == 0) { remove[i64](?s, ?i); }
            i = i + 1;
        }
        val r: res[Set[i64], allocator.Error] = clone[i64](?s, ?a);
        if (sel r.err) { ret 1; }
        var c: Set[i64] = r.ok;
        if (length[i64](c) != 80) { ret 2; }
        val five: i64 = 5;
        insert[i64](?c, 5);
        if (contains[i64](?s, ?five)) { ret 3; }

        var seen: [100]u8;
        var j:    usize = 0;
        for (j < 100) {
            seen[j] = 0;
            j       = j + 1;
        }
        var n:  usize    = 0;
        var it: map.Iter = iter[i64](?s);
        var k:  *i64;
        for (next[i64](?s, ?it, ?k)) {
            if (@k < 0 || @k >= 100 || @k % 5 == 0) { ret 4; }
            if (seen[(@k)::usize] != 0)             { ret 5; }
            seen[(@k)::usize] = 1;
            n                 = n + 1;
        }
        if (n != 80) { ret 6; }
        dnit[i64](?s);
        dnit[i64](?c);
        ret 0;
    }
}
