# generic hash map using open addressing with linear probing
#
# keys and values are stored in parallel arrays. a separate "state" array tracks
# which slots are empty, occupied, or tombstones (deleted).

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.allocator;
use std.allocator.page;
use std.allocator.testing;
use std.memory;

val SLOT_EMPTY:     u8 = 0;
val SLOT_OCCUPIED:  u8 = 1;
val SLOT_TOMBSTONE: u8 = 2;

val DEFAULT_CAPACITY:    usize = 16;
val LOAD_FACTOR_PERCENT: usize = 70;

# generic hash map with user-provided hash and equality functions
# ---
# alloc:      allocator for backing storage
# keys:       key buffer
# values:     value buffer
# states:     per-slot state (empty/occupied/tombstone)
# len:        number of entries
# tombstones: number of tombstone slots
# cap:        total slot count
# hash_fn:    hash function taking a ptr, returning u64
# eq_fn:      equality function taking two ptrs, returning bool
pub rec Map[K, V] {
    alloc:      *allocator.Allocator;
    keys:       *K;
    values:     *V;
    states:     *u8;
    len:        usize;
    tombstones: usize;
    cap:        usize;
    hash_fn:    fun(ptr) u64;
    eq_fn:      fun(ptr, ptr) bool;
}

# create an empty map
# ---
# alloc:   allocator to use for backing storage
# hash_fn: hash function for keys
# eq_fn:   equality function for keys
# ret:     a new empty Map[K, V]
pub fun init[K, V](alloc: *allocator.Allocator, hash_fn: fun(ptr) u64, eq_fn: fun(ptr, ptr) bool) Map[K, V] {
    var m: Map[K, V];
    m.alloc      = alloc;
    m.keys       = nil;
    m.values     = nil;
    m.states     = nil;
    m.len        = 0;
    m.tombstones = 0;
    m.cap        = 0;
    m.hash_fn    = hash_fn;
    m.eq_fn      = eq_fn;
    ret m;
}

# free all backing storage and reset the map
#
# entries are not visited: a key or value that owns storage is the caller's
# to release before this runs. all three buffers are released even when one
# release fails, and the first failure is what is reported.
# ---
# ret: ok when every buffer was released (or there were none), or the first
#      refusal
pub fun dnit[K, V](m: *Map[K, V]) err[allocator.Error] {
    if (m == nil) { ret err[allocator.Error].ok{}; }
    if (m.cap == 0) {
        m.keys       = nil;
        m.values     = nil;
        m.states     = nil;
        m.len        = 0;
        m.tombstones = 0;
        ret err[allocator.Error].ok{};
    }

    var first: err[allocator.Error] = err[allocator.Error].ok{};
    val keys_r: err[allocator.Error] = allocator.deallocate[K](m.alloc, m.keys, m.cap);
    if (sel keys_r.err) { first = keys_r; }
    val values_r: err[allocator.Error] = allocator.deallocate[V](m.alloc, m.values, m.cap);
    if (sel values_r.err && sel first.ok) { first = values_r; }
    val states_r: err[allocator.Error] = allocator.deallocate[u8](m.alloc, m.states, m.cap);
    if (sel states_r.err && sel first.ok) { first = states_r; }

    m.keys       = nil;
    m.values     = nil;
    m.states     = nil;
    m.len        = 0;
    m.tombstones = 0;
    m.cap        = 0;

    ret first;
}

# check if the map has no entries
# ---
# ret: true if the map has no entries
pub fun is_empty[K, V](m: Map[K, V]) bool {
    ret m.len == 0;
}

# return the number of entries in the map
# ---
# ret: number of entries
pub fun length[K, V](m: Map[K, V]) usize {
    ret m.len;
}

# return the current capacity in slots
# ---
# ret: capacity in slots
pub fun capacity[K, V](m: Map[K, V]) usize {
    ret m.cap;
}

# remove all entries but keep allocated capacity
pub fun clear[K, V](m: *Map[K, V]) {
    if (m == nil || m.cap == 0) { ret; }
    memory.raw_fill(m.states::ptr, SLOT_EMPTY, m.cap);
    m.len        = 0;
    m.tombstones = 0;
}

# locate the slot for a key, or the first available slot
# ---
# key: pointer to the key to find
# ret: (idx, found) where found indicates an exact match
fun find_slot[K, V](m: *Map[K, V], key: *K) rec { idx: usize; found: bool; } {
    var result: rec { idx: usize; found: bool; };
    result.found = false;
    result.idx   = 0;

    if (m.cap == 0) { ret result; }

    val hash:            u64   = m.hash_fn(key::ptr);
    var idx:             usize = hash % m.cap;
    var first_tombstone: usize = m.cap;

    var probes: usize = 0;
    for (probes < m.cap) {
        val state: u8 = m.states[idx];

        if (state == SLOT_EMPTY) {
            if (first_tombstone < m.cap) {
                result.idx = first_tombstone;
            }
            or {
                result.idx = idx;
            }
            ret result;
        }

        if (state == SLOT_TOMBSTONE) {
            if (first_tombstone >= m.cap) {
                first_tombstone = idx;
            }
        }

        if (state == SLOT_OCCUPIED) {
            if (m.eq_fn(key::ptr, (?m.keys[idx])::ptr)) {
                result.idx   = idx;
                result.found = true;
                ret result;
            }
        }

        idx    = (idx + 1) % m.cap;
        probes = probes + 1;
    }

    if (first_tombstone < m.cap) {
        result.idx = first_tombstone;
    }
    or {
        result.idx = 0;
    }
    ret result;
}

# resize the map and rehash all entries
#
# the three new buffers are acquired before anything is moved, so a refusal
# part way through releases what was acquired and leaves the map as it was.
# ---
# new_cap: target capacity
# ret:     the new capacity, or the allocator's refusal
fun grow[K, V](m: *Map[K, V], new_cap: usize) res[usize, allocator.Error] {
    if (new_cap < m.cap) {
        ret res[usize, allocator.Error].ok{m.cap};
    }

    val keys_r: res[*K, allocator.Error] = allocator.allocate[K](m.alloc, new_cap);
    if (sel keys_r.err) { ret res[usize, allocator.Error].err{keys_r.err}; }
    val new_keys: *K = keys_r.ok;

    val values_r: res[*V, allocator.Error] = allocator.allocate[V](m.alloc, new_cap);
    if (sel values_r.err) {
        allocator.deallocate[K](m.alloc, new_keys, new_cap);
        ret res[usize, allocator.Error].err{values_r.err};
    }
    val new_values: *V = values_r.ok;

    val states_r: res[*u8, allocator.Error] = allocator.zallocate[u8](m.alloc, new_cap);
    if (sel states_r.err) {
        allocator.deallocate[K](m.alloc, new_keys, new_cap);
        allocator.deallocate[V](m.alloc, new_values, new_cap);
        ret res[usize, allocator.Error].err{states_r.err};
    }
    val new_states: *u8 = states_r.ok;

    val old_keys:   *K    = m.keys;
    val old_values: *V    = m.values;
    val old_states: *u8   = m.states;
    val old_cap:    usize = m.cap;

    m.keys       = new_keys;
    m.values     = new_values;
    m.states     = new_states;
    m.cap        = new_cap;
    m.len        = 0;
    m.tombstones = 0;

    if (old_cap > 0) {
        var i: usize = 0;
        for (i < old_cap) {
            if (old_states[i] == SLOT_OCCUPIED) {
                val hash: u64   = m.hash_fn((?old_keys[i])::ptr);
                var idx:  usize = hash % new_cap;

                for (m.states[idx] != SLOT_EMPTY) {
                    idx = (idx + 1) % new_cap;
                }

                m.keys[idx]   = old_keys[i];
                m.values[idx] = old_values[i];
                m.states[idx] = SLOT_OCCUPIED;
                m.len         = m.len + 1;
            }
            i = i + 1;
        }

        allocator.deallocate[K](m.alloc, old_keys, old_cap);
        allocator.deallocate[V](m.alloc, old_values, old_cap);
        allocator.deallocate[u8](m.alloc, old_states, old_cap);
    }

    ret res[usize, allocator.Error].ok{new_cap};
}

# ensure room for at least one more entry
# ---
# ret: the current capacity, or the allocator's refusal
fun ensure_capacity[K, V](m: *Map[K, V]) res[usize, allocator.Error] {
    if (m.cap == 0) {
        ret grow[K, V](m, DEFAULT_CAPACITY);
    }

    val threshold: usize = (m.cap * LOAD_FACTOR_PERCENT) / 100;
    if ((m.len + m.tombstones) >= threshold) {
        val new_cap: usize = m.cap * 2;
        if (new_cap < m.cap) {
            ret res[usize, allocator.Error].err{allocator.Error.overflow{}};
        }
        ret grow[K, V](m, new_cap);
    }

    if (m.tombstones > m.len) {
        ret grow[K, V](m, m.cap);
    }

    ret res[usize, allocator.Error].ok{m.cap};
}

# insert or update a key-value pair
#
# key and value are copied into the map. updating an existing key overwrites
# the stored value in place and does not touch the stored key: a value that
# owns storage must be read back with `get` and released by the caller before
# it is replaced. a refused growth leaves the map unchanged.
# ---
# key:   key to insert
# value: value to associate
# ret:   true if a new entry was inserted, false if an existing entry was
#        updated, or the allocator's refusal
pub fun insert[K, V](m: *Map[K, V], key: K, value: V) res[bool, allocator.Error] {
    if (m == nil) { ret res[bool, allocator.Error].err{allocator.Error.invalid{}}; }
    val room: res[usize, allocator.Error] = ensure_capacity[K, V](m);
    if (sel room.err) { ret res[bool, allocator.Error].err{room.err}; }

    val slot: rec { idx: usize; found: bool; } = find_slot[K, V](m, ?key);

    if (slot.found) {
        m.values[slot.idx] = value;
        ret res[bool, allocator.Error].ok{false};
    }

    if (m.states[slot.idx] == SLOT_TOMBSTONE) {
        m.tombstones = m.tombstones - 1;
    }
    m.keys[slot.idx]   = key;
    m.values[slot.idx] = value;
    m.states[slot.idx] = SLOT_OCCUPIED;
    m.len              = m.len + 1;

    ret res[bool, allocator.Error].ok{true};
}

# get a pointer to the value associated with a key
#
# the pointer is into the map's storage and is invalidated by any growth.
# ---
# key: pointer to the key to look up
# ret: pointer to the value, or none when the key is absent
pub fun get[K, V](m: *Map[K, V], key: *K) opt[*V] {
    if (m == nil)   { ret opt[*V].none{}; }
    if (m.cap == 0) { ret opt[*V].none{}; }

    val slot: rec { idx: usize; found: bool; } = find_slot[K, V](m, key);
    if (!slot.found) { ret opt[*V].none{}; }

    ret opt[*V].some{?m.values[slot.idx]};
}

# check if the map contains a key
# ---
# key: pointer to the key to check
# ret: true if the key exists
pub fun contains[K, V](m: *Map[K, V], key: *K) bool {
    if (m == nil) { ret false; }
    if (m.cap == 0) { ret false; }
    val slot: rec { idx: usize; found: bool; } = find_slot[K, V](m, key);
    ret slot.found;
}

# remove a key-value pair from the map
#
# the entry's slot is released; a key or value that owns storage must be read
# back with `get` and released by the caller before it is removed. removal
# never allocates, so it cannot be refused.
# ---
# key: pointer to the key to remove
# ret: true if removed, false if the key was not found
pub fun remove[K, V](m: *Map[K, V], key: *K) bool {
    if (m == nil)   { ret false; }
    if (m.cap == 0) { ret false; }

    val slot: rec { idx: usize; found: bool; } = find_slot[K, V](m, key);
    if (!slot.found) { ret false; }

    m.states[slot.idx] = SLOT_TOMBSTONE;
    m.len              = m.len - 1;
    m.tombstones       = m.tombstones + 1;

    ret true;
}

# FNV-1a hash for strings
pub fun hash_str(p: ptr) u64 {
    val s: *str = p::*str;
    val FNV_OFFSET: u64 = 14695981039346656037;
    val FNV_PRIME:  u64 = 1099511628211;

    var hash: u64 = FNV_OFFSET;
    val sp: str = @s;

    if (sp == nil) { ret hash; }

    var i: usize = 0;
    for (sp[i] != 0) {
        val byte: u64 = sp[i]::u64;
        hash = hash ^ byte;
        hash = hash * FNV_PRIME;
        i = i + 1;
    }

    ret hash;
}

# equality function for strings
pub fun eq_str(pa: ptr, pb: ptr) bool {
    val a: *str = pa::*str;
    val b: *str = pb::*str;
    ret str_equals(@a, @b);
}

# splitmix64 hash for i64
pub fun hash_i64(p: ptr) u64 {
    val n: *i64 = p::*i64;
    var x: u64 = (@n)::u64;
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    x = x ^ (x >> 33);
    ret x;
}

# equality function for i64
pub fun eq_i64(pa: ptr, pb: ptr) bool {
    val a: *i64 = pa::*i64;
    val b: *i64 = pb::*i64;
    ret @a == @b;
}

# splitmix64 hash for u64
pub fun hash_u64(p: ptr) u64 {
    val n: *u64 = p::*u64;
    var x: u64 = @n;
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    x = x ^ (x >> 33);
    ret x;
}

# equality function for u64
pub fun eq_u64(pa: ptr, pb: ptr) bool {
    val a: *u64 = pa::*u64;
    val b: *u64 = pb::*u64;
    ret @a == @b;
}

# splitmix64 hash for u32
pub fun hash_u32(p: ptr) u64 {
    val n: *u32 = p::*u32;
    var x: u64 = (@n)::u64;
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    x = x ^ (x >> 33);
    ret x;
}

# equality function for u32
pub fun eq_u32(pa: ptr, pb: ptr) bool {
    val a: *u32 = pa::*u32;
    val b: *u32 = pb::*u32;
    ret @a == @b;
}

test "map: init creates empty map" {
    var a: allocator.Allocator;
    page.make(?a);
    val m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);
    if (!is_empty[i64, i64](m)) { ret 1; }
    if (length[i64, i64](m) != 0) { ret 1; }
    if (capacity[i64, i64](m) != 0) { ret 1; }
    ret 0;
}

test "map: insert and get" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    val r: res[bool, allocator.Error] = insert[i64, i64](?m, 42, 100);
    if (sel r.err) { ret 1; }
    if (!r.ok) { ret 1; }

    if (length[i64, i64](m) != 1) { ret 1; }
    if (is_empty[i64, i64](m)) { ret 1; }

    val key: i64 = 42;
    val gr: opt[*i64] = get[i64, i64](?m, ?key);
    if (!sel gr.some) { ret 1; }
    if (@gr.some != 100) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: insert updates existing" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    insert[i64, i64](?m, 10, 100);
    val r: res[bool, allocator.Error] = insert[i64, i64](?m, 10, 200);
    if (sel r.err) { ret 1; }
    if (r.ok) { ret 1; }

    if (length[i64, i64](m) != 1) { ret 1; }

    val key: i64 = 10;
    val gr: opt[*i64] = get[i64, i64](?m, ?key);
    if (!sel gr.some) { ret 1; }
    if (@gr.some != 200) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: contains" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    insert[i64, i64](?m, 5, 50);
    insert[i64, i64](?m, 10, 100);

    val k1: i64 = 5;
    val k2: i64 = 10;
    val k3: i64 = 15;

    if (!contains[i64, i64](?m, ?k1)) { ret 1; }
    if (!contains[i64, i64](?m, ?k2)) { ret 1; }
    if (contains[i64, i64](?m, ?k3)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: remove" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    insert[i64, i64](?m, 1, 10);
    insert[i64, i64](?m, 2, 20);
    insert[i64, i64](?m, 3, 30);

    if (length[i64, i64](m) != 3) { ret 1; }

    val k2: i64 = 2;
    if (!remove[i64, i64](?m, ?k2)) { ret 1; }

    if (length[i64, i64](m) != 2) { ret 1; }
    if (contains[i64, i64](?m, ?k2)) { ret 1; }

    val k1: i64 = 1;
    val k3: i64 = 3;
    if (!contains[i64, i64](?m, ?k1)) { ret 1; }
    if (!contains[i64, i64](?m, ?k3)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: remove non-existent" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    insert[i64, i64](?m, 1, 10);

    val k: i64 = 999;
    if (remove[i64, i64](?m, ?k)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: get non-existent returns none" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    insert[i64, i64](?m, 1, 10);

    val k: i64 = 999;
    val gr: opt[*i64] = get[i64, i64](?m, ?k);
    if (!sel gr.none) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: clear" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    insert[i64, i64](?m, 1, 10);
    insert[i64, i64](?m, 2, 20);
    insert[i64, i64](?m, 3, 30);

    val cap_before: usize = capacity[i64, i64](m);
    clear[i64, i64](?m);

    if (length[i64, i64](m) != 0) { ret 1; }
    if (!is_empty[i64, i64](m)) { ret 1; }
    if (capacity[i64, i64](m) != cap_before) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: many insertions trigger growth" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    var i: i64 = 0;
    for (i < 100) {
        val r: res[bool, allocator.Error] = insert[i64, i64](?m, i, i * 10);
        if (sel r.err) { ret 1; }
        i = i + 1;
    }

    if (length[i64, i64](m) != 100) { ret 1; }
    if (capacity[i64, i64](m) < 100) { ret 1; }

    var j: i64 = 0;
    for (j < 100) {
        val gr: opt[*i64] = get[i64, i64](?m, ?j);
        if (!sel gr.some) { ret 1; }
        if (@gr.some != j * 10) { ret 1; }
        j = j + 1;
    }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: insert after remove reuses tombstone" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    insert[i64, i64](?m, 1, 10);
    insert[i64, i64](?m, 2, 20);

    val k: i64 = 1;
    remove[i64, i64](?m, ?k);

    insert[i64, i64](?m, 3, 30);

    if (length[i64, i64](m) != 2) { ret 1; }

    val k2: i64 = 2;
    val k3: i64 = 3;
    if (!contains[i64, i64](?m, ?k2)) { ret 1; }
    if (!contains[i64, i64](?m, ?k3)) { ret 1; }
    if (contains[i64, i64](?m, ?k)) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: dnit on empty map" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);
    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: string keys" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[str, i64] = init[str, i64](?a, hash_str, eq_str);

    insert[str, i64](?m, "hello", 1);
    insert[str, i64](?m, "world", 2);
    insert[str, i64](?m, "foo", 3);

    if (length[str, i64](m) != 3) { ret 1; }

    val k1: str = "hello";
    val k2: str = "world";
    val k3: str = "bar";

    val r1: opt[*i64] = get[str, i64](?m, ?k1);
    if (!sel r1.some) { ret 1; }
    if (@r1.some != 1) { ret 1; }

    val r2: opt[*i64] = get[str, i64](?m, ?k2);
    if (!sel r2.some) { ret 1; }
    if (@r2.some != 2) { ret 1; }

    if (contains[str, i64](?m, ?k3)) { ret 1; }

    val freed: err[allocator.Error] = dnit[str, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

test "map: get allows mutation" {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Map[i64, i64] = init[i64, i64](?a, hash_i64, eq_i64);

    insert[i64, i64](?m, 42, 100);

    val k: i64 = 42;
    val r: opt[*i64] = get[i64, i64](?m, ?k);
    if (!sel r.some) { ret 1; }

    val p: *i64 = r.some;
    @p = 999;

    val r2: opt[*i64] = get[i64, i64](?m, ?k);
    if (!sel r2.some) { ret 1; }
    if (@r2.some != 999) { ret 1; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err) { ret 1; }
    ret 0;
}

# growing acquires three buffers; when the second or third is refused, the
# ones already acquired are released and the map is left as it was, so a
# refused insert is a clean `err` with nothing leaked and nothing moved
test "map: a refused growth releases the partial acquisition" {
    var t: testing.Testing;
    val mr: err[allocator.Error] = testing.make(?t);
    if (sel mr.err) { ret 1; }
    var m: Map[i64, i64] = init[i64, i64](?t.a, hash_i64, eq_i64);

    # the first insert grows from nothing: keys, values, states
    var ordinal: usize = 1;
    for (ordinal <= 3) {
        testing.fail_at_ordinal(?t, testing.attempt_count(?t) + ordinal);
        val refused: res[bool, allocator.Error] = insert[i64, i64](?m, 1, 10);
        if (!sel refused.err)           { testing.dnit(?t); ret 2; }
        if (!sel refused.err.exhausted) { testing.dnit(?t); ret 3; }
        if (m.cap != 0 || m.len != 0)   { testing.dnit(?t); ret 4; }
        if (testing.live_count(?t) != 0) { testing.dnit(?t); ret 5; }
        ordinal = ordinal + 1;
    }

    testing.clear_failure(?t);
    val inserted: res[bool, allocator.Error] = insert[i64, i64](?m, 1, 10);
    if (sel inserted.err) { testing.dnit(?t); ret 6; }
    if (testing.live_count(?t) != 3) { testing.dnit(?t); ret 7; }

    val freed: err[allocator.Error] = dnit[i64, i64](?m);
    if (sel freed.err)      { testing.dnit(?t); ret 8; }
    if (testing.leaked(?t)) { testing.dnit(?t); ret 9; }
    testing.dnit(?t);
    ret 0;
}

# a value that owns storage is replaced by reading the old owner back through
# `get` and releasing it; insert overwrites the slot and does not release
test "map: replacing an owning value is the caller's release" {
    var t: testing.Testing;
    val mr: err[allocator.Error] = testing.make(?t);
    if (sel mr.err) { ret 1; }
    var m: Map[i64, *u8] = init[i64, *u8](?t.a, hash_i64, eq_i64);

    val first: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel first.err) { testing.dnit(?t); ret 2; }
    val put: res[bool, allocator.Error] = insert[i64, *u8](?m, 7, first.ok);
    if (sel put.err) { testing.dnit(?t); ret 3; }

    val second: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel second.err) { testing.dnit(?t); ret 4; }

    val key: i64 = 7;
    val old: opt[**u8] = get[i64, *u8](?m, ?key);
    if (!sel old.some) { testing.dnit(?t); ret 5; }
    if (@old.some != first.ok) { testing.dnit(?t); ret 6; }
    val released: err[allocator.Error] = allocator.deallocate[u8](?t.a, @old.some, 8);
    if (sel released.err) { testing.dnit(?t); ret 7; }

    val replaced: res[bool, allocator.Error] = insert[i64, *u8](?m, 7, second.ok);
    if (sel replaced.err) { testing.dnit(?t); ret 8; }
    if (replaced.ok)      { testing.dnit(?t); ret 9; }

    val now: opt[**u8] = get[i64, *u8](?m, ?key);
    if (!sel now.some) { testing.dnit(?t); ret 10; }
    if (@now.some != second.ok) { testing.dnit(?t); ret 11; }

    # cleanup releases the owner, then the map's buffers
    allocator.deallocate[u8](?t.a, @now.some, 8);
    if (!remove[i64, *u8](?m, ?key)) { testing.dnit(?t); ret 12; }
    dnit[i64, *u8](?m);
    if (testing.leaked(?t)) { testing.dnit(?t); ret 13; }
    testing.dnit(?t);
    ret 0;
}
