# generic hash map, open addressing with linear probing over control bytes
#
# THE KEY CONTRACT. `Map[K, V]` hashes and compares its keys by the key type's
# natural equality and hash, `std.collections.natural.eq[K]` and `hash[K]`,
# resolved at compile time: an integer key hashes with a multiply-xorshift
# mixer and compares with `==`, a `str` key by content, a record key field by
# field. nothing is stored in the record and no call is made per probe.
# `MapBy[K, V]` is the spelling for a key the type does not carry a hash or
# equality for: it stores the two functions and calls them through their
# pointers, so a reader can tell from the type name whether a probe is direct
# or indirect. they are runtime values because mach cannot yet take a
# function as a comptime parameter of a generic (briar-systems/mach#3706,
# #3707).
#
# THE LAYOUT. three buffers of `cap` slots: keys, values, and one control
# byte per slot. a control byte is `EMPTY`, `DELETED` (a tombstone), or the
# top seven bits of the key's hash with the high bit clear, which marks the
# slot full. a probe compares control bytes first, so a mismatch is rejected
# without touching the key buffer, and a miss on a full table walks one byte
# per slot. this is the groundwork for matching a group of control bytes at
# once with a vector compare; the byte layout is what that needs and it costs
# nothing to adopt now.
#
# capacity is always a power of two, so the slot for a hash and every probe
# step is a mask rather than a divide. the invariant is asserted where the
# capacity is set.
#
# one core serves the two records: each carries a zero-size `policy` field,
# the public entry point hands its value to the core, and the core is
# generic over the record and the policy and dispatches on `$type_of(p)`, the
# same shape `sort` and `heap` use. every routine in the core, the two
# one-line policy readers included, is generic over exactly `[K, V, M, P]` in
# that order, so a call from one to another forwards the whole list unchanged.

use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.natural;

$if (capability.HOSTED) {
    use std.allocator.page;
    use std.allocator.testing;
}

use std.memory;

# control byte of a slot that has never held a key
val EMPTY: u8 = 0x80;

# control byte of a slot whose key was removed
val DELETED: u8 = 0xFE;

# the smallest capacity a map grows to
val DEFAULT_CAPACITY: usize = 16;

# the map grows when full and deleted slots pass this share of the capacity
val LOAD_FACTOR_PERCENT: usize = 70;

# the policy of `Map`: the natural hash and equality of `K`
rec Natural {}

# the policy of `MapBy`: stored functions
rec Custom {}

# a map keyed by the natural hash and equality of `K`
# ---
# alloc:      allocator for backing storage
# keys:       key buffer
# values:     value buffer
# ctrl:       one control byte per slot
# len:        number of entries
# tombstones: number of deleted slots
# cap:        total slot count, a power of two or zero
# policy:     the policy, a zero-size marker
pub rec Map[K, V] {
    alloc:      *allocator.Allocator;
    keys:       *K;
    values:     *V;
    ctrl:       *u8;
    len:        usize;
    tombstones: usize;
    cap:        usize;
    policy:     Natural;
}

# a map keyed by caller-supplied hash and equality functions
# ---
# alloc:      allocator for backing storage
# keys:       key buffer
# values:     value buffer
# ctrl:       one control byte per slot
# len:        number of entries
# tombstones: number of deleted slots
# cap:        total slot count, a power of two or zero
# policy:     the policy, a zero-size marker
# hash_fn:    hash function over a key
# eq_fn:      equality function over two keys
pub rec MapBy[K, V] {
    alloc:      *allocator.Allocator;
    keys:       *K;
    values:     *V;
    ctrl:       *u8;
    len:        usize;
    tombstones: usize;
    cap:        usize;
    policy:     Custom;
    hash_fn:    fun(*K) u64;
    eq_fn:      fun(*K, *K) bool;
}

# create an empty map keyed by the natural hash and equality of `K`
# ---
# alloc: allocator to use for backing storage
# ret:   a new empty Map[K, V]
pub fun init[K, V](alloc: *allocator.Allocator) Map[K, V] {
    var m: Map[K, V];
    m.alloc      = alloc;
    m.keys       = nil;
    m.values     = nil;
    m.ctrl       = nil;
    m.len        = 0;
    m.tombstones = 0;
    m.cap        = 0;
    ret m;
}

# create an empty map keyed by the given functions
# ---
# alloc:   allocator to use for backing storage
# hash_fn: hash function over a key
# eq_fn:   equality function over two keys
# ret:     a new empty MapBy[K, V]
pub fun init_by[K, V](alloc: *allocator.Allocator, hash_fn: fun(*K) u64, eq_fn: fun(*K, *K) bool) MapBy[K, V] {
    var m: MapBy[K, V];
    m.alloc      = alloc;
    m.keys       = nil;
    m.values     = nil;
    m.ctrl       = nil;
    m.len        = 0;
    m.tombstones = 0;
    m.cap        = 0;
    m.hash_fn    = hash_fn;
    m.eq_fn      = eq_fn;
    ret m;
}

# free all backing storage and reset the map
#
# entries are not visited: a key or value that owns storage is the caller's
# to release before this runs. all three buffers are released even when one
# release fails, and the first failure is what is reported.
# ---
# ret: ok when every buffer was released (or there were none), or the first
#      refusal
pub fun dnit[K, V](m: *Map[K, V]) err[allocator.Error] {
    ret core_dnit[K, V, Map[K, V]](m);
}

# free all backing storage of a `MapBy`; see `dnit`
pub fun dnit_by[K, V](m: *MapBy[K, V]) err[allocator.Error] {
    ret core_dnit[K, V, MapBy[K, V]](m);
}

# check if the map has no entries
# ---
# ret: true if the map has no entries
pub fun is_empty[K, V](m: Map[K, V]) bool {
    ret m.len == 0;
}

# check if a `MapBy` has no entries; see `is_empty`
pub fun is_empty_by[K, V](m: MapBy[K, V]) bool {
    ret m.len == 0;
}

# return the number of entries in the map
# ---
# ret: number of entries
pub fun length[K, V](m: Map[K, V]) usize {
    ret m.len;
}

# return the number of entries in a `MapBy`; see `length`
pub fun length_by[K, V](m: MapBy[K, V]) usize {
    ret m.len;
}

# return the current capacity in slots
# ---
# ret: capacity in slots
pub fun capacity[K, V](m: Map[K, V]) usize {
    ret m.cap;
}

# return the current capacity of a `MapBy` in slots; see `capacity`
pub fun capacity_by[K, V](m: MapBy[K, V]) usize {
    ret m.cap;
}

# remove all entries but keep allocated capacity
pub fun clear[K, V](m: *Map[K, V]) {
    core_clear[K, V, Map[K, V]](m);
}

# remove all entries of a `MapBy` but keep allocated capacity; see `clear`
pub fun clear_by[K, V](m: *MapBy[K, V]) {
    core_clear[K, V, MapBy[K, V]](m);
}

# insert or update a key-value pair
#
# key and value are copied into the map. updating an existing key overwrites
# the stored value in place and does not touch the stored key: a value that
# owns storage must be read back with `get` and released by the caller before
# it is replaced. a refused growth leaves the map unchanged.
# ---
# key:   key to insert
# value: value to associate
# ret:   true if a new entry was inserted, false if an existing entry was
#        updated, or the allocator's refusal
pub fun insert[K, V](m: *Map[K, V], key: K, value: V) res[bool, allocator.Error] {
    ret core_insert[K, V, Map[K, V], Natural](m, m.policy, key, value);
}

# insert or update a key-value pair in a `MapBy`; see `insert`
pub fun insert_by[K, V](m: *MapBy[K, V], key: K, value: V) res[bool, allocator.Error] {
    ret core_insert[K, V, MapBy[K, V], Custom](m, m.policy, key, value);
}

# get a pointer to the value associated with a key
#
# the pointer is into the map's storage and is invalidated by any growth.
# ---
# key: pointer to the key to look up
# ret: pointer to the value, or none when the key is absent
pub fun get[K, V](m: *Map[K, V], key: *K) opt[*V] {
    ret core_get[K, V, Map[K, V], Natural](m, m.policy, key);
}

# get a pointer to the value for a key in a `MapBy`; see `get`
pub fun get_by[K, V](m: *MapBy[K, V], key: *K) opt[*V] {
    ret core_get[K, V, MapBy[K, V], Custom](m, m.policy, key);
}

# check if the map contains a key
# ---
# key: pointer to the key to check
# ret: true if the key exists
pub fun contains[K, V](m: *Map[K, V], key: *K) bool {
    ret core_contains[K, V, Map[K, V], Natural](m, m.policy, key);
}

# check if a `MapBy` contains a key; see `contains`
pub fun contains_by[K, V](m: *MapBy[K, V], key: *K) bool {
    ret core_contains[K, V, MapBy[K, V], Custom](m, m.policy, key);
}

# remove a key-value pair from the map
#
# the entry's slot is released; a key or value that owns storage must be read
# back with `get` and released by the caller before it is removed. removal
# never allocates, so it cannot be refused.
# ---
# key: pointer to the key to remove
# ret: true if removed, false if the key was not found
pub fun remove[K, V](m: *Map[K, V], key: *K) bool {
    ret core_remove[K, V, Map[K, V], Natural](m, m.policy, key);
}

# remove a key-value pair from a `MapBy`; see `remove`
pub fun remove_by[K, V](m: *MapBy[K, V], key: *K) bool {
    ret core_remove[K, V, MapBy[K, V], Custom](m, m.policy, key);
}

# the hash of a key under the map's policy
#[inline]
fun hash_key[K, V, M, P](m: *M, p: P, key: *K) u64 {
    $if ($type_of(p) == Natural) { ret natural.hash[K](key); }
    $or ($type_of(p) == Custom)  { ret m.hash_fn(key); }
    $or                          { $error("std.collections.map: the policy must be Natural or Custom"); }
}

# whether two keys are equal under the map's policy
#[inline]
fun keys_equal[K, V, M, P](m: *M, p: P, a: *K, b: *K) bool {
    $if ($type_of(p) == Natural) { ret natural.eq[K](a, b); }
    $or ($type_of(p) == Custom)  { ret m.eq_fn(a, b); }
    $or                          { $error("std.collections.map: the policy must be Natural or Custom"); }
}

# the control byte a full slot holding this hash carries
#[inline]
fun h2_of(hash: u64) u8 {
    ret (hash & 0x7F)::u8;
}

# the first slot the probe for this hash visits
#[inline]
fun home_of(hash: u64, cap: usize) usize {
    ret ((hash >> 7)::usize) & (cap - 1);
}

fun core_dnit[K, V, M](m: *M) err[allocator.Error] {
    if (m == nil) { ret err[allocator.Error].ok{}; }
    if (m.cap == 0) {
        m.keys       = nil;
        m.values     = nil;
        m.ctrl       = nil;
        m.len        = 0;
        m.tombstones = 0;
        ret err[allocator.Error].ok{};
    }

    var first:  err[allocator.Error] = err[allocator.Error].ok{};
    val keys_r: err[allocator.Error] = allocator.deallocate[K](m.alloc, m.keys, m.cap);
    if (sel keys_r.err) { first = keys_r; }
    val values_r: err[allocator.Error] = allocator.deallocate[V](m.alloc, m.values, m.cap);
    if (sel values_r.err && sel first.ok) { first = values_r; }
    val ctrl_r: err[allocator.Error] = allocator.deallocate[u8](m.alloc, m.ctrl, m.cap);
    if (sel ctrl_r.err && sel first.ok) { first = ctrl_r; }

    m.keys       = nil;
    m.values     = nil;
    m.ctrl       = nil;
    m.len        = 0;
    m.tombstones = 0;
    m.cap        = 0;

    ret first;
}

fun core_clear[K, V, M](m: *M) {
    if (m == nil || m.cap == 0) { ret; }
    memory.raw_fill(m.ctrl::ptr, EMPTY, m.cap);
    m.len        = 0;
    m.tombstones = 0;
}

# where a probe ended: the slot, and whether it holds the key
#
# filled in place rather than returned: a returned record is copied word by
# word, and reading the word that holds `found` right after the byte store
# that set it stalls the store-forwarding path on every lookup.
rec Slot {
    idx:   usize;
    found: bool;
}

# locate the slot for a key, or the slot an insert of it would take
#
# a full slot is compared by control byte before its key is read. the first
# tombstone met is remembered so an insert reuses it, and an empty slot ends
# the probe. the walk is bounded by the capacity, so a table with no empty
# slot (which the load factor prevents) still terminates.
# ---
# key: pointer to the key to find
# out: the slot, with `found` set when it holds the key
fun find_slot[K, V, M, P](m: *M, p: P, key: *K, out: *Slot) {
    out.idx   = 0;
    out.found = false;
    if (m.cap == 0) { ret; }

    val hash: u64   = hash_key[K, V, M, P](m, p, key);
    val h2:   u8    = h2_of(hash);
    val mask: usize = m.cap - 1;
    var idx:  usize = home_of(hash, m.cap);

    var first_tombstone: usize = m.cap;
    var probes:          usize = 0;
    for (probes < m.cap) {
        val c: u8 = m.ctrl[idx];

        if (c == h2) {
            if (keys_equal[K, V, M, P](m, p, key, ?m.keys[idx])) {
                out.idx   = idx;
                out.found = true;
                ret;
            }
        }
        or (c == EMPTY) {
            if (first_tombstone < m.cap) {
                out.idx = first_tombstone;
            }
            or {
                out.idx = idx;
            }
            ret;
        }
        or (c == DELETED) {
            if (first_tombstone >= m.cap) {
                first_tombstone = idx;
            }
        }

        idx    = (idx + 1) & mask;
        probes = probes + 1;
    }

    if (first_tombstone < m.cap) {
        out.idx = first_tombstone;
    }
}

# resize the map and rehash all entries
#
# the three new buffers are acquired before anything is moved, so a refusal
# part way through releases what was acquired and leaves the map as it was.
# the new table has no tombstones, so the rehash probes only for empty slots.
# ---
# new_cap: target capacity, a power of two
# ret:     the new capacity, or the allocator's refusal
fun grow[K, V, M, P](m: *M, p: P, new_cap: usize) res[usize, allocator.Error] {
    if (new_cap < m.cap) {
        ret res[usize, allocator.Error].ok{m.cap};
    }
    if ((new_cap & (new_cap - 1)) != 0) {
        ret res[usize, allocator.Error].err{allocator.Error.invalid{}};
    }

    val keys_r: res[*K, allocator.Error] = allocator.allocate[K](m.alloc, new_cap);
    if (sel keys_r.err) { ret res[usize, allocator.Error].err{keys_r.err}; }
    val new_keys: *K = keys_r.ok;

    val values_r: res[*V, allocator.Error] = allocator.allocate[V](m.alloc, new_cap);
    if (sel values_r.err) {
        allocator.deallocate[K](m.alloc, new_keys, new_cap);
        ret res[usize, allocator.Error].err{values_r.err};
    }
    val new_values: *V = values_r.ok;

    val ctrl_r: res[*u8, allocator.Error] = allocator.allocate[u8](m.alloc, new_cap);
    if (sel ctrl_r.err) {
        allocator.deallocate[K](m.alloc, new_keys, new_cap);
        allocator.deallocate[V](m.alloc, new_values, new_cap);
        ret res[usize, allocator.Error].err{ctrl_r.err};
    }
    val new_ctrl: *u8 = ctrl_r.ok;
    memory.raw_fill(new_ctrl::ptr, EMPTY, new_cap);

    val old_keys:   *K    = m.keys;
    val old_values: *V    = m.values;
    val old_ctrl:   *u8   = m.ctrl;
    val old_cap:    usize = m.cap;

    m.keys       = new_keys;
    m.values     = new_values;
    m.ctrl       = new_ctrl;
    m.cap        = new_cap;
    m.len        = 0;
    m.tombstones = 0;

    if (old_cap > 0) {
        val mask: usize = new_cap - 1;
        var i:    usize = 0;
        for (i < old_cap) {
            if ((old_ctrl[i] & 0x80) == 0) {
                val hash: u64   = hash_key[K, V, M, P](m, p, ?old_keys[i]);
                var idx:  usize = home_of(hash, new_cap);
                for (m.ctrl[idx] != EMPTY) {
                    idx = (idx + 1) & mask;
                }
                m.keys[idx]   = old_keys[i];
                m.values[idx] = old_values[i];
                m.ctrl[idx]   = h2_of(hash);
                m.len         = m.len + 1;
            }
            i = i + 1;
        }

        allocator.deallocate[K](m.alloc, old_keys, old_cap);
        allocator.deallocate[V](m.alloc, old_values, old_cap);
        allocator.deallocate[u8](m.alloc, old_ctrl, old_cap);
    }

    ret res[usize, allocator.Error].ok{new_cap};
}

# ensure room for at least one more entry
# ---
# ret: the current capacity, or the allocator's refusal
fun ensure_capacity[K, V, M, P](m: *M, p: P) res[usize, allocator.Error] {
    if (m.cap == 0) {
        ret grow[K, V, M, P](m, p, DEFAULT_CAPACITY);
    }

    val threshold: usize = (m.cap * LOAD_FACTOR_PERCENT) / 100;
    if ((m.len + m.tombstones) >= threshold) {
        if (m.tombstones > m.len) {
            ret grow[K, V, M, P](m, p, m.cap);
        }
        val new_cap: usize = m.cap * 2;
        if (new_cap < m.cap) {
            ret res[usize, allocator.Error].err{allocator.Error.overflow{}};
        }
        ret grow[K, V, M, P](m, p, new_cap);
    }

    ret res[usize, allocator.Error].ok{m.cap};
}

fun core_insert[K, V, M, P](m: *M, p: P, key: K, value: V) res[bool, allocator.Error] {
    if (m == nil) { ret res[bool, allocator.Error].err{allocator.Error.invalid{}}; }
    val room: res[usize, allocator.Error] = ensure_capacity[K, V, M, P](m, p);
    if (sel room.err) { ret res[bool, allocator.Error].err{room.err}; }

    var slot: Slot;
    find_slot[K, V, M, P](m, p, ?key, ?slot);

    if (slot.found) {
        m.values[slot.idx] = value;
        ret res[bool, allocator.Error].ok{false};
    }

    if (m.ctrl[slot.idx] == DELETED) {
        m.tombstones = m.tombstones - 1;
    }
    m.keys[slot.idx]   = key;
    m.values[slot.idx] = value;
    m.ctrl[slot.idx]   = h2_of(hash_key[K, V, M, P](m, p, ?key));
    m.len              = m.len + 1;

    ret res[bool, allocator.Error].ok{true};
}

fun core_get[K, V, M, P](m: *M, p: P, key: *K) opt[*V] {
    if (m == nil)   { ret opt[*V].none{}; }
    if (m.cap == 0) { ret opt[*V].none{}; }

    var slot: Slot;
    find_slot[K, V, M, P](m, p, key, ?slot);
    if (!slot.found) { ret opt[*V].none{}; }

    ret opt[*V].some{?m.values[slot.idx]};
}

fun core_contains[K, V, M, P](m: *M, p: P, key: *K) bool {
    if (m == nil)   { ret false; }
    if (m.cap == 0) { ret false; }
    var slot: Slot;
    find_slot[K, V, M, P](m, p, key, ?slot);
    ret slot.found;
}

fun core_remove[K, V, M, P](m: *M, p: P, key: *K) bool {
    if (m == nil)   { ret false; }
    if (m.cap == 0) { ret false; }

    var slot: Slot;
    find_slot[K, V, M, P](m, p, key, ?slot);
    if (!slot.found) { ret false; }

    m.ctrl[slot.idx] = DELETED;
    m.len            = m.len - 1;
    m.tombstones     = m.tombstones + 1;

    ret true;
}

$if (capability.HOSTED) {
    test "map: init creates empty map" {
        var a: allocator.Allocator;
        page.make(?a);
        val m: Map[i64, i64] = init[i64, i64](?a);
        if (!is_empty[i64, i64](m))     { ret 1; }
        if (length[i64, i64](m) != 0)   { ret 1; }
        if (capacity[i64, i64](m) != 0) { ret 1; }
        ret 0;
    }

    test "map: insert and get" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        val r: res[bool, allocator.Error] = insert[i64, i64](?m, 42, 100);
        if (sel r.err) { ret 1; }
        if (!r.ok)     { ret 1; }

        if (length[i64, i64](m) != 1) { ret 1; }
        if (is_empty[i64, i64](m))    { ret 1; }

        val key: i64       = 42;
        val gr:  opt[*i64] = get[i64, i64](?m, ?key);
        if (!sel gr.some)    { ret 1; }
        if (@gr.some != 100) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: insert updates existing" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        insert[i64, i64](?m, 10, 100);
        val r: res[bool, allocator.Error] = insert[i64, i64](?m, 10, 200);
        if (sel r.err) { ret 1; }
        if (r.ok)      { ret 1; }

        if (length[i64, i64](m) != 1) { ret 1; }

        val key: i64       = 10;
        val gr:  opt[*i64] = get[i64, i64](?m, ?key);
        if (!sel gr.some)    { ret 1; }
        if (@gr.some != 200) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: contains" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        insert[i64, i64](?m, 5, 50);
        insert[i64, i64](?m, 10, 100);

        val k1: i64 = 5;
        val k2: i64 = 10;
        val k3: i64 = 15;

        if (!contains[i64, i64](?m, ?k1)) { ret 1; }
        if (!contains[i64, i64](?m, ?k2)) { ret 1; }
        if (contains[i64, i64](?m, ?k3))  { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: remove" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        insert[i64, i64](?m, 1, 10);
        insert[i64, i64](?m, 2, 20);
        insert[i64, i64](?m, 3, 30);

        if (length[i64, i64](m) != 3) { ret 1; }

        val k2: i64 = 2;
        if (!remove[i64, i64](?m, ?k2)) { ret 1; }

        if (length[i64, i64](m) != 2)    { ret 1; }
        if (contains[i64, i64](?m, ?k2)) { ret 1; }

        val k1: i64 = 1;
        val k3: i64 = 3;
        if (!contains[i64, i64](?m, ?k1)) { ret 1; }
        if (!contains[i64, i64](?m, ?k3)) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: remove non-existent" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        insert[i64, i64](?m, 1, 10);

        val k: i64 = 999;
        if (remove[i64, i64](?m, ?k)) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: get non-existent returns none" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        insert[i64, i64](?m, 1, 10);

        val k:  i64       = 999;
        val gr: opt[*i64] = get[i64, i64](?m, ?k);
        if (!sel gr.none) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: clear" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        insert[i64, i64](?m, 1, 10);
        insert[i64, i64](?m, 2, 20);
        insert[i64, i64](?m, 3, 30);

        val cap_before: usize = capacity[i64, i64](m);
        clear[i64, i64](?m);

        if (length[i64, i64](m) != 0)            { ret 1; }
        if (!is_empty[i64, i64](m))              { ret 1; }
        if (capacity[i64, i64](m) != cap_before) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: many insertions trigger growth" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        var i: i64 = 0;
        for (i < 100) {
            val r: res[bool, allocator.Error] = insert[i64, i64](?m, i, i * 10);
            if (sel r.err) { ret 1; }
            i = i + 1;
        }

        if (length[i64, i64](m) != 100)  { ret 1; }
        if (capacity[i64, i64](m) < 100) { ret 1; }

        var j: i64 = 0;
        for (j < 100) {
            val gr: opt[*i64] = get[i64, i64](?m, ?j);
            if (!sel gr.some)       { ret 1; }
            if (@gr.some != j * 10) { ret 1; }
            j = j + 1;
        }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: insert after remove reuses tombstone" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        insert[i64, i64](?m, 1, 10);
        insert[i64, i64](?m, 2, 20);

        val k: i64 = 1;
        remove[i64, i64](?m, ?k);

        insert[i64, i64](?m, 3, 30);

        if (length[i64, i64](m) != 2) { ret 1; }

        val k2: i64 = 2;
        val k3: i64 = 3;
        if (!contains[i64, i64](?m, ?k2)) { ret 1; }
        if (!contains[i64, i64](?m, ?k3)) { ret 1; }
        if (contains[i64, i64](?m, ?k))   { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: dnit on empty map" {
        var a: allocator.Allocator;
        page.make(?a);
        var m:     Map[i64, i64]        = init[i64, i64](?a);
        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: string keys" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[str, i64] = init[str, i64](?a);

        insert[str, i64](?m, "hello", 1);
        insert[str, i64](?m, "world", 2);
        insert[str, i64](?m, "foo", 3);

        if (length[str, i64](m) != 3) { ret 1; }

        val k1: str = "hello";
        val k2: str = "world";
        val k3: str = "bar";

        val r1: opt[*i64] = get[str, i64](?m, ?k1);
        if (!sel r1.some)  { ret 1; }
        if (@r1.some != 1) { ret 1; }

        val r2: opt[*i64] = get[str, i64](?m, ?k2);
        if (!sel r2.some)  { ret 1; }
        if (@r2.some != 2) { ret 1; }

        if (contains[str, i64](?m, ?k3)) { ret 1; }

        val freed: err[allocator.Error] = dnit[str, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    test "map: get allows mutation" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, i64] = init[i64, i64](?a);

        insert[i64, i64](?m, 42, 100);

        val k: i64       = 42;
        val r: opt[*i64] = get[i64, i64](?m, ?k);
        if (!sel r.some) { ret 1; }

        val p: *i64 = r.some;
        @p = 999;

        val r2: opt[*i64] = get[i64, i64](?m, ?k);
        if (!sel r2.some)    { ret 1; }
        if (@r2.some != 999) { ret 1; }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) { ret 1; }
        ret 0;
    }

    # growing acquires three buffers; when the second or third is refused, the
    # ones already acquired are released and the map is left as it was, so a
    # refused insert is a clean `err` with nothing leaked and nothing moved
    test "map: a refused growth releases the partial acquisition" {
        var t:  testing.Testing;
        val mr: err[allocator.Error] = testing.make(?t);
        if (sel mr.err) { ret 1; }
        var m: Map[i64, i64] = init[i64, i64](?t.a);

        # the first insert grows from nothing: keys, values, states
        var ordinal: usize = 1;
        for (ordinal <= 3) {
            testing.fail_at_ordinal(?t, testing.attempt_count(?t) + ordinal);
            val refused: res[bool, allocator.Error] = insert[i64, i64](?m, 1, 10);
            if (!sel refused.err) {
                testing.dnit(?t);
                ret 2;
            }
            if (!sel refused.err.exhausted) {
                testing.dnit(?t);
                ret 3;
            }
            if (m.cap != 0 || m.len != 0) {
                testing.dnit(?t);
                ret 4;
            }
            if (testing.live_count(?t) != 0) {
                testing.dnit(?t);
                ret 5;
            }
            ordinal = ordinal + 1;
        }

        testing.clear_failure(?t);
        val inserted: res[bool, allocator.Error] = insert[i64, i64](?m, 1, 10);
        if (sel inserted.err) {
            testing.dnit(?t);
            ret 6;
        }
        if (testing.live_count(?t) != 3) {
            testing.dnit(?t);
            ret 7;
        }

        val freed: err[allocator.Error] = dnit[i64, i64](?m);
        if (sel freed.err) {
            testing.dnit(?t);
            ret 8;
        }
        if (testing.leaked(?t)) {
            testing.dnit(?t);
            ret 9;
        }
        testing.dnit(?t);
        ret 0;
    }

    # a value that owns storage is replaced by reading the old owner back through
    # `get` and releasing it; insert overwrites the slot and does not release
    test "map: replacing an owning value is the caller's release" {
        var t:  testing.Testing;
        val mr: err[allocator.Error] = testing.make(?t);
        if (sel mr.err) { ret 1; }
        var m: Map[i64, *u8] = init[i64, *u8](?t.a);

        val first: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
        if (sel first.err) {
            testing.dnit(?t);
            ret 2;
        }
        val put: res[bool, allocator.Error] = insert[i64, *u8](?m, 7, first.ok);
        if (sel put.err) {
            testing.dnit(?t);
            ret 3;
        }

        val second: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
        if (sel second.err) {
            testing.dnit(?t);
            ret 4;
        }

        val key: i64       = 7;
        val old: opt[**u8] = get[i64, *u8](?m, ?key);
        if (!sel old.some) {
            testing.dnit(?t);
            ret 5;
        }
        if (@old.some != first.ok) {
            testing.dnit(?t);
            ret 6;
        }
        val released: err[allocator.Error] = allocator.deallocate[u8](?t.a, @old.some, 8);
        if (sel released.err) {
            testing.dnit(?t);
            ret 7;
        }

        val replaced: res[bool, allocator.Error] = insert[i64, *u8](?m, 7, second.ok);
        if (sel replaced.err) {
            testing.dnit(?t);
            ret 8;
        }
        if (replaced.ok) {
            testing.dnit(?t);
            ret 9;
        }

        val now: opt[**u8] = get[i64, *u8](?m, ?key);
        if (!sel now.some) {
            testing.dnit(?t);
            ret 10;
        }
        if (@now.some != second.ok) {
            testing.dnit(?t);
            ret 11;
        }

        # cleanup releases the owner, then the map's buffers
        allocator.deallocate[u8](?t.a, @now.some, 8);
        if (!remove[i64, *u8](?m, ?key)) {
            testing.dnit(?t);
            ret 12;
        }
        dnit[i64, *u8](?m);
        if (testing.leaked(?t)) {
            testing.dnit(?t);
            ret 13;
        }
        testing.dnit(?t);
        ret 0;
    }

    # a map holds canonical tags as values: insert, overwrite and get keep the
    # selected case and its payload
    test "map: values of canonical tag type round-trip" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[i64, opt[i64]] = init[i64, opt[i64]](?a);

        val absent: res[bool, allocator.Error] = insert[i64, opt[i64]](?m, 1, opt[i64].none{});
        if (sel absent.err) { ret 1; }
        val present: res[bool, allocator.Error] = insert[i64, opt[i64]](?m, 2, opt[i64].some{42});
        if (sel present.err)               { ret 2; }
        if (length[i64, opt[i64]](m) != 2) { ret 3; }

        val k1: i64            = 1;
        val g1: opt[*opt[i64]] = get[i64, opt[i64]](?m, ?k1);
        if (!sel g1.some)      { ret 4; }
        if (!sel g1.some.none) { ret 5; }

        val k2: i64            = 2;
        val g2: opt[*opt[i64]] = get[i64, opt[i64]](?m, ?k2);
        if (!sel g2.some)       { ret 6; }
        if (!sel g2.some.some)  { ret 7; }
        if (g2.some.some != 42) { ret 8; }

        val replaced: res[bool, allocator.Error] = insert[i64, opt[i64]](?m, 1, opt[i64].some{9});
        if (sel replaced.err) { ret 9; }
        if (replaced.ok)      { ret 10; }
        val g1b: opt[*opt[i64]] = get[i64, opt[i64]](?m, ?k1);
        if (!sel g1b.some)      { ret 11; }
        if (!sel g1b.some.some) { ret 12; }
        if (g1b.some.some != 9) { ret 13; }

        val freed: err[allocator.Error] = dnit[i64, opt[i64]](?m);
        if (sel freed.err) { ret 14; }

        var outcomes: Map[i64, res[i64, allocator.Error]] = init[i64, res[i64, allocator.Error]](?a);
        val ok_in:    res[bool, allocator.Error]          = insert[i64, res[i64, allocator.Error]](?outcomes, 5, res[i64, allocator.Error].ok{500});
        if (sel ok_in.err) { ret 15; }
        val err_in: res[bool, allocator.Error] = insert[i64, res[i64, allocator.Error]](?outcomes, 6, res[i64, allocator.Error].err{allocator.Error.exhausted{}});
        if (sel err_in.err) { ret 16; }
        val k6: i64                             = 6;
        val g6: opt[*res[i64, allocator.Error]] = get[i64, res[i64, allocator.Error]](?outcomes, ?k6);
        if (!sel g6.some)               { ret 17; }
        if (!sel g6.some.err)           { ret 18; }
        if (!sel g6.some.err.exhausted) { ret 19; }
        val k5: i64                             = 5;
        val g5: opt[*res[i64, allocator.Error]] = get[i64, res[i64, allocator.Error]](?outcomes, ?k5);
        if (!sel g5.some)      { ret 20; }
        if (!sel g5.some.ok)   { ret 21; }
        if (g5.some.ok != 500) { ret 22; }
        val freed2: err[allocator.Error] = dnit[i64, res[i64, allocator.Error]](?outcomes);
        if (sel freed2.err) { ret 23; }
        ret 0;
    }

    fun step(s: *u64) u64 {
        var x: u64 = @s;
        x  = x ^ (x << 13);
        x  = x ^ (x >> 7);
        x  = x ^ (x << 17);
        @s = x;
        ret x;
    }

    # the reference model: one slot per key in [0, KEYS), holding presence and value
    val KEYS: usize = 4096;

    # randomized insert, remove and lookup against the model, through several
    # doublings and heavy tombstone churn
    test "map: randomized operations agree with a reference model" {
        var a: allocator.Allocator;
        page.make(?a);
        val pr: res[*bool, allocator.Error] = allocator.zallocate[bool](?a, KEYS);
        if (sel pr.err) { ret 1; }
        val vr: res[*i64, allocator.Error] = allocator.zallocate[i64](?a, KEYS);
        if (sel vr.err) { ret 1; }
        val present: *bool = pr.ok;
        val values:  *i64  = vr.ok;
        var live:    usize = 0;

        var m:       Map[u64, i64] = init[u64, i64](?a);
        var s:       u64           = 0x853C49E6748FEA9B;
        var step_no: usize         = 0;
        for (step_no < 400000) {
            val roll: u64   = step(?s) % 10;
            val key:  u64   = step(?s) % (KEYS::u64);
            val k:    usize = key::usize;
            if (roll < 5) {
                val v: i64                        = (step(?s) >> 1)::i64;
                val r: res[bool, allocator.Error] = insert[u64, i64](?m, key, v);
                if (sel r.err)          { ret 2; }
                if (r.ok == present[k]) { ret 3; }
                if (!present[k])        { live = live + 1; }
                present[k] = true;
                values[k]  = v;
            }
            or (roll < 8) {
                val removed: bool = remove[u64, i64](?m, ?key);
                if (removed != present[k]) { ret 4; }
                if (present[k])            { live = live - 1; }
                present[k] = false;
            }
            or {
                val g: opt[*i64] = get[u64, i64](?m, ?key);
                if (sel g.some != present[k])                   { ret 5; }
                if (sel g.some && @g.some != values[k])         { ret 6; }
                if (contains[u64, i64](?m, ?key) != present[k]) { ret 7; }
            }
            if (length[u64, i64](m) != live)              { ret 8; }
            if (m.cap != 0 && (m.cap & (m.cap - 1)) != 0) { ret 9; }
            step_no = step_no + 1;
        }

        # every key the model holds is found with its value, every other is absent
        var k: usize = 0;
        for (k < KEYS) {
            val key: u64       = k::u64;
            val g:   opt[*i64] = get[u64, i64](?m, ?key);
            if (sel g.some != present[k])           { ret 10; }
            if (sel g.some && @g.some != values[k]) { ret 11; }
            k = k + 1;
        }

        dnit[u64, i64](?m);
        allocator.deallocate[bool](?a, present, KEYS);
        allocator.deallocate[i64](?a, values, KEYS);
        ret 0;
    }

    test "map: growth across several doublings keeps every entry" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[u64, u64] = init[u64, u64](?a);
        val n: u64           = 200000;
        var i: u64           = 0;
        for (i < n) {
            val r: res[bool, allocator.Error] = insert[u64, u64](?m, i * 2654435761, i);
            if (sel r.err) { ret 1; }
            if (!r.ok)     { ret 2; }
            i = i + 1;
        }
        if (length[u64, u64](m) != n::usize)  { ret 3; }
        if (capacity[u64, u64](m) < n::usize) { ret 4; }
        i = 0;
        for (i < n) {
            val key: u64       = i * 2654435761;
            val g:   opt[*u64] = get[u64, u64](?m, ?key);
            if (!sel g.some)  { ret 5; }
            if (@g.some != i) { ret 6; }
            i = i + 1;
        }
        dnit[u64, u64](?m);
        ret 0;
    }

    # tombstone churn: the same few keys inserted and removed far more times
    # than the table has slots, which must rehash rather than fill with
    # tombstones
    test "map: tombstone churn stays bounded" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[u64, u8] = init[u64, u8](?a);
        var i: u64          = 0;
        for (i < 100000) {
            val key: u64 = i % 8;
            insert[u64, u8](?m, key, 1);
            remove[u64, u8](?m, ?key);
            if (length[u64, u8](m) != 0)   { ret 1; }
            if (capacity[u64, u8](m) > 64) { ret 2; }
            if (m.tombstones > m.cap)      { ret 3; }
            i = i + 1;
        }
        val key: u64 = 3;
        if (contains[u64, u8](?m, ?key)) { ret 4; }
        dnit[u64, u8](?m);
        ret 0;
    }

    rec Point { x: i32; y: i32; }

    test "map: record keys hash and compare by field" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: Map[Point, i64] = init[Point, i64](?a);
        insert[Point, i64](?m, Point{x: 1, y: 2}, 12);
        insert[Point, i64](?m, Point{x: 2, y: 1}, 21);
        val k1: Point     = Point{x: 1, y: 2};
        val k2: Point     = Point{x: 2, y: 1};
        val k3: Point     = Point{x: 1, y: 1};
        val g1: opt[*i64] = get[Point, i64](?m, ?k1);
        if (!sel g1.some)   { ret 1; }
        if (@g1.some != 12) { ret 1; }
        val g2: opt[*i64] = get[Point, i64](?m, ?k2);
        if (!sel g2.some)                  { ret 1; }
        if (@g2.some != 21)                { ret 1; }
        if (contains[Point, i64](?m, ?k3)) { ret 1; }
        dnit[Point, i64](?m);
        ret 0;
    }

    # a key whose hash and equality the type does not carry: keyed by the
    # string a pointer refers to, through stored functions
    fun hash_by_len(k: *str) u64 {
        var n: u64 = 0;
        val s: str = @k;
        for (s[n] != 0) { n = n + 1; }
        ret n;
    }

    fun eq_by_len(a: *str, b: *str) bool {
        ret hash_by_len(a) == hash_by_len(b);
    }

    test "map: MapBy keys through its functions" {
        var a: allocator.Allocator;
        page.make(?a);
        var m: MapBy[str, i64] = init_by[str, i64](?a, hash_by_len, eq_by_len);
        if (!is_empty_by[str, i64](m)) { ret 1; }
        val r1: res[bool, allocator.Error] = insert_by[str, i64](?m, "abc", 3);
        if (sel r1.err) { ret 2; }
        if (!r1.ok)     { ret 2; }
        val r2: res[bool, allocator.Error] = insert_by[str, i64](?m, "xyz", 30);
        if (sel r2.err)                  { ret 3; }
        if (r2.ok)                       { ret 4; }
        if (length_by[str, i64](m) != 1) { ret 5; }
        val k: str       = "qqq";
        val g: opt[*i64] = get_by[str, i64](?m, ?k);
        if (!sel g.some)                    { ret 6; }
        if (@g.some != 30)                  { ret 7; }
        if (!contains_by[str, i64](?m, ?k)) { ret 8; }
        if (!remove_by[str, i64](?m, ?k))   { ret 9; }
        if (contains_by[str, i64](?m, ?k))  { ret 10; }
        var i: i64 = 0;
        for (i < 1000) {
            insert_by[str, i64](?m, "abcd", i);
            i = i + 1;
        }
        if (length_by[str, i64](m) != 1) { ret 11; }
        clear_by[str, i64](?m);
        if (length_by[str, i64](m) != 0)   { ret 12; }
        if (capacity_by[str, i64](m) == 0) { ret 13; }
        val freed: err[allocator.Error] = dnit_by[str, i64](?m);
        if (sel freed.err) { ret 14; }
        ret 0;
    }
}
