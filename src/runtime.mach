# program entrypoint contract
# ---
# provides the platform/arch-specific `_start` symbol that the linker uses as
# the program entrypoint. user code must define a `main` function as follows:
#
#   use std.runtime;
#
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 {
#       ret 0;
#   }
#
# the `_start` entrypoint gathers argc/argv from the host and calls the user's
# `main`. argv holds argc arguments and a closing nil. on windows it is the wide
# command line split into UTF-8 (std.runtime.windows.cmdline). before main it also
# keeps the arguments in the host's native units (std.runtime.native). on
# return, it terminates the process with the exit code returned by `main`.
#
# on a freestanding target there is no host. `_start` sets the stack pointer to
# `__run_stop_.stack`, copies `.data` to where it runs and zeroes `.bss`, all
# before any mach code, then calls `main(0, nil)` and parks the core when it
# returns (std.runtime.freestanding).
#
# note: `use std.runtime;` is required to link the entrypoint into the binary.

$if ($mach.build.sys == $mach.sys.linux) {
    use std.runtime.linux;
}
$or ($mach.build.sys == $mach.sys.darwin) {
    use std.runtime.darwin;
}
$or ($mach.build.sys == $mach.sys.windows) {
    use std.runtime.windows;
}
$or ($mach.build.sys == $mach.sys.freestanding) {
    use std.runtime.freestanding;
}
$or {
    $error("std.runtime needs a linux, darwin, windows or freestanding target");
}
