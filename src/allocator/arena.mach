# arena allocator implementation
#
# bump allocator with chunked growth. allocation is O(1) amortized.
# deallocate is a no-op except for the most recent allocation which
# can be rolled back. reallocate is in-place for the most recent
# allocation when space permits, otherwise alloc+copy. grows
# automatically by allocating new chunks from the backing allocator.
# the Allocator it makes sets retains, since only a rollback is reused.

use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

$if (capability.HOSTED) {
    use std.allocator.page;
}

use std.memory;

# header for each backing allocation
# ---
# prev: previous chunk in the linked list
# cap:  data capacity in bytes (data follows the header)
pub rec Chunk {
    prev: *Chunk;
    cap:  usize;
}

val CHUNK_HDR: usize = 16;

# bump allocator state with chunked growth
# ---
# backing:     allocator used for chunk allocations
# buf:         current chunk data pointer (cached for fast-path)
# cap:         current chunk data capacity (cached)
# off:         current allocation offset within current chunk
# last_off:    offset of most recent allocation (for rollback/resize)
# last_size:   size of most recent allocation (for rollback/resize)
# chunk:       current chunk header
# first_chunk: first chunk (for reset/dnit)
# default_cap: minimum chunk capacity for growth
pub rec Arena {
    backing: A.Allocator;

    buf: ptr;
    cap: usize;
    off: usize;

    last_off:  usize;
    last_size: usize;

    chunk:       *Chunk;
    first_chunk: *Chunk;
    default_cap: usize;
}

fun align_up(value: usize, align: usize) usize {
    val mask: usize = align - 1;
    ret (value + mask) & ~mask;
}

fun min_usize(x: usize, y: usize) usize {
    if (x < y) { ret x; }
    ret y;
}

fun max_usize(x: usize, y: usize) usize {
    if (x > y) { ret x; }
    ret y;
}

# get data pointer for a chunk (data follows header)
fun chunk_data(c: *Chunk) ptr {
    ret (c::usize + CHUNK_HDR)::ptr;
}

# allocate a new chunk with at least min_cap data bytes
fun alloc_chunk(ar: *Arena, min_cap: usize) *Chunk {
    if (min_cap > ~(0::usize) - CHUNK_HDR) { ret nil; }
    val total:            usize             = CHUNK_HDR + min_cap;
    val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(?ar.backing, total, CHUNK_HDR);
    if (sel res_allocate_raw.err) { ret nil; }

    val c: *Chunk = res_allocate_raw.ok::*Chunk;
    c.prev = nil;
    c.cap  = min_cap;
    ret c;
}

# deallocate a chunk through the backing allocator
fun free_chunk(ar: *Arena, c: *Chunk) err[A.Error] {
    val total: usize = CHUNK_HDR + c.cap;
    ret A.deallocate_raw(?ar.backing, c::ptr, total, CHUNK_HDR);
}

# allocate a new chunk and make it current
fun grow(ar: *Arena, min_size: usize) bool {
    var new_cap: usize = min_size;
    if (ar.cap <= ~(0::usize) / 2) { new_cap = max_usize(ar.cap * 2, min_size); }
    new_cap = max_usize(new_cap, ar.default_cap);

    val c: *Chunk = alloc_chunk(ar, new_cap);
    if (c == nil) { ret false; }

    c.prev       = ar.chunk;
    ar.chunk     = c;
    ar.buf       = chunk_data(c);
    ar.cap       = new_cap;
    ar.off       = 0;
    ar.last_off  = 0;
    ar.last_size = 0;
    if (ar.first_chunk == nil) {
        ar.first_chunk = c;
    }
    ret true;
}

# initialize an Arena with a backing allocator and optional initial capacity
# ---
# ar:      Arena to initialize
# backing: allocator used to provide backing storage
# cap:     initial chunk capacity in bytes (0 = lazy allocation on first use)
# ret:     ok, `invalid` for a nil arena or backing allocator, or the refusal
#          of the first chunk
pub fun init(ar: *Arena, backing: *A.Allocator, cap: usize) err[A.Error] {
    if (ar == nil)      { ret err[A.Error].err{A.Error.invalid{}}; }
    if (backing == nil) { ret err[A.Error].err{A.Error.invalid{}}; }

    ar.backing     = @backing;
    ar.buf         = nil;
    ar.cap         = 0;
    ar.off         = 0;
    ar.last_off    = 0;
    ar.last_size   = 0;
    ar.chunk       = nil;
    ar.first_chunk = nil;
    ar.default_cap = cap;

    if (cap == 0) {
        ret err[A.Error].ok{};
    }

    val c: *Chunk = alloc_chunk(ar, cap);
    if (c == nil) {
        ret err[A.Error].err{A.Error.exhausted{}};
    }

    ar.chunk       = c;
    ar.first_chunk = c;
    ar.buf         = chunk_data(c);
    ar.cap         = cap;

    ret err[A.Error].ok{};
}

# free all chunks and zero the Arena state
#
# every chunk is released even when one release fails; the first failure is
# what is reported, so a combined failure stays observable.
# ---
# ar:  Arena to destroy
# ret: ok if all backing frees succeeded, or the first negative backend native code as `release`
pub fun dnit(ar: *Arena) err[A.Error] {
    if (ar == nil) {
        ret err[A.Error].ok{};
    }

    var err_first: err[A.Error] = err[A.Error].ok{};
    var c:         *Chunk       = ar.chunk;
    for (c != nil) {
        val prev:      *Chunk       = c.prev;
        val err_freed: err[A.Error] = free_chunk(ar, c);
        if (sel err_freed.err && sel err_first.ok) { err_first = err_freed; }
        c = prev;
    }

    ar.buf         = nil;
    ar.cap         = 0;
    ar.off         = 0;
    ar.last_off    = 0;
    ar.last_size   = 0;
    ar.chunk       = nil;
    ar.first_chunk = nil;

    ret err_first;
}

# wire up an Allocator backed by this Arena
# ---
# a:   Allocator to initialize
# ar:  initialized Arena (must outlive the Allocator)
# ret: ok, or `invalid` when either pointer is nil
pub fun allocator(a: *A.Allocator, ar: *Arena) err[A.Error] {
    if (a == nil)  { ret err[A.Error].err{A.Error.invalid{}}; }
    if (ar == nil) { ret err[A.Error].err{A.Error.invalid{}}; }

    a.ctx           = ar::ptr;
    a.fn_allocate   = allocate;
    a.fn_reallocate = reallocate;
    a.fn_deallocate = deallocate;
    a.retains       = true;

    ret err[A.Error].ok{};
}

# reset the Arena to empty, freeing all chunks except the first
#
# existing allocations become invalid after reset.
# ---
# ar: Arena to reset
pub fun reset(ar: *Arena) {
    if (ar == nil) { ret; }

    if (ar.first_chunk != nil) {
        var c: *Chunk = ar.chunk;
        for (c != nil && c != ar.first_chunk) {
            val prev: *Chunk = c.prev;
            free_chunk(ar, c);
            c = prev;
        }

        ar.chunk = ar.first_chunk;
        ar.buf   = chunk_data(ar.first_chunk);
        ar.cap   = ar.first_chunk.cap;
    }

    ar.off       = 0;
    ar.last_off  = 0;
    ar.last_size = 0;
}

# arena bump allocation callback
fun allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }

    val ar: *Arena = ctx::*Arena;
    if (size == 0) {
        ret opt[ptr].some{nil};
    }

    # the address is aligned, not the offset: a chunk's data starts a header
    # past its backing allocation and carries only the header's alignment
    if (ar.buf != nil) {
        val start: usize = align_up(ar.buf::usize + ar.off, align) - ar.buf::usize;
        if (start <= ar.cap && size <= ar.cap - start) {
            ar.last_off  = start;
            ar.last_size = size;
            ar.off       = start + size;
            ret opt[ptr].some{(ar.buf::usize + start)::ptr};
        }
    }

    if (size > ~(0::usize) - align) { ret opt[ptr].none{}; }
    val padded: usize = size + align;
    if (!grow(ar, padded)) {
        ret opt[ptr].none{};
    }

    val start: usize = align_up(ar.buf::usize + ar.off, align) - ar.buf::usize;
    val end:   usize = start + size;
    if (end > ar.cap) {
        ret opt[ptr].none{};
    }

    ar.last_off  = start;
    ar.last_size = size;
    ar.off       = end;

    ret opt[ptr].some{(ar.buf::usize + start)::ptr};
}

# arena resize callback. in-place for the most recent allocation if space permits
fun reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }

    val ar: *Arena = ctx::*Arena;

    if (p == nil) {
        ret allocate(ctx, new_size, align);
    }

    if (new_size == 0) {
        ret opt[ptr].some{nil};
    }

    if (ar.buf != nil) {
        val last_ptr: ptr = (ar.buf::usize + ar.last_off)::ptr;
        if (p == last_ptr && old_size == ar.last_size) {
            if (new_size <= ar.cap - ar.last_off) {
                ar.off       = ar.last_off + new_size;
                ar.last_size = new_size;
                ret opt[ptr].some{p};
            }
        }
    }

    val opt_fresh: opt[ptr] = allocate(ctx, new_size, align);
    if (!sel opt_fresh.some) { ret opt_fresh; }

    val q: ptr = opt_fresh.some;

    memory.raw_copy(q, p, min_usize(old_size, new_size));

    ret opt[ptr].some{q};
}

# arena free callback. rolls back the most recent allocation if matched
fun deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (ctx == nil) { ret -1; }

    val ar: *Arena = ctx::*Arena;
    if (p == nil) { ret 0; }

    if (ar.buf != nil) {
        val last_ptr: ptr = (ar.buf::usize + ar.last_off)::ptr;
        if (p == last_ptr && size == ar.last_size) {
            ar.off       = ar.last_off;
            ar.last_off  = 0;
            ar.last_size = 0;
        }
    }

    ret 0;
}

$if (capability.HOSTED) {
    # allocations bump forward, freeing an earlier block reclaims nothing,
    # freeing the last one rolls it back, the last one resizes in place, an
    # earlier one moves with its bytes, and reset starts over at the first chunk
    test arena__bump_rollback_resize_and_reset {
        var pa: A.Allocator;
        page.make(?pa);
        var ar:             Arena;
        var aa:             A.Allocator;
        val err_arena_made: err[A.Error] = init(?ar, ?pa, 4096);
        if (sel err_arena_made.err) { ret 1; }
        fin { dnit(?ar); }
        val err_allocator_made: err[A.Error] = allocator(?aa, ?ar);
        if (sel err_allocator_made.err) { ret 1; }

        val res_lower_allocated: res[*i64, A.Error] = A.allocate[i64](?aa, 2);
        val res_upper_allocated: res[*i64, A.Error] = A.allocate[i64](?aa, 2);
        if (sel res_lower_allocated.err)                                    { ret 2; }
        if (sel res_upper_allocated.err)                                    { ret 2; }
        if (res_upper_allocated.ok::usize <= res_lower_allocated.ok::usize) { ret 3; }
        res_lower_allocated.ok[0] = 111;
        res_lower_allocated.ok[1] = 222;

        val err_lower_freed: err[A.Error] = A.deallocate[i64](?aa, res_lower_allocated.ok, 2);
        if (sel err_lower_freed.err) { ret 4; }
        val res_bumped_allocated: res[*i64, A.Error] = A.allocate[i64](?aa, 2);
        if (sel res_bumped_allocated.err)                                    { ret 5; }
        if (res_bumped_allocated.ok::usize <= res_upper_allocated.ok::usize) { ret 5; }

        val err_top_freed: err[A.Error] = A.deallocate[i64](?aa, res_bumped_allocated.ok, 2);
        if (sel err_top_freed.err) { ret 6; }
        val res_rolled_back_allocated: res[*i64, A.Error] = A.allocate[i64](?aa, 2);
        if (sel res_rolled_back_allocated.err)                       { ret 7; }
        if (res_rolled_back_allocated.ok != res_bumped_allocated.ok) { ret 7; }

        res_rolled_back_allocated.ok[0] = 7;
        val res_grown: res[*i64, A.Error] = A.reallocate[i64](?aa, res_rolled_back_allocated.ok, 2, 4);
        if (sel res_grown.err)                                                    { ret 8; }
        if (res_grown.ok != res_rolled_back_allocated.ok || res_grown.ok[0] != 7) { ret 8; }

        val res_moved: res[*i64, A.Error] = A.reallocate[i64](?aa, res_lower_allocated.ok, 2, 4);
        if (sel res_moved.err)                                { ret 9; }
        if (res_moved.ok == res_lower_allocated.ok)           { ret 9; }
        if (res_moved.ok[0] != 111 || res_moved.ok[1] != 222) { ret 10; }

        reset(?ar);
        val res_again: res[*i64, A.Error] = A.allocate[i64](?aa, 100);
        if (sel res_again.err)                      { ret 11; }
        if (res_again.ok != res_lower_allocated.ok) { ret 11; }
        ret 0;
    }

    # a lazy arena grows on its first allocation, and a full chunk grows into a
    # new one without disturbing the blocks already handed out
    test arena__grows_lazily_and_when_full {
        var pa: A.Allocator;
        page.make(?pa);
        var lazy:                    Arena;
        var la:                      A.Allocator;
        val err_lazy_made:           err[A.Error] = init(?lazy, ?pa, 0);
        val err_lazy_allocator_made: err[A.Error] = allocator(?la, ?lazy);
        if (sel err_lazy_made.err)           { ret 1; }
        if (sel err_lazy_allocator_made.err) { ret 1; }
        val res_first: res[*i64, A.Error] = A.allocate[i64](?la, 2);
        if (sel res_first.err)   { ret 2; }
        if (res_first.ok == nil) { ret 2; }
        res_first.ok[1] = 42;
        val err_dnit: err[A.Error] = dnit(?lazy);
        if (sel err_dnit.err) { ret 3; }

        var ar:             Arena;
        var aa:             A.Allocator;
        val err_arena_made: err[A.Error] = init(?ar, ?pa, 64);
        if (sel err_arena_made.err) { ret 4; }
        fin { dnit(?ar); }
        val err_allocator_made: err[A.Error] = allocator(?aa, ?ar);
        if (sel err_allocator_made.err) { ret 4; }
        var held: [3]*i64;
        var i:    usize = 0;
        for (i < 3) {
            val res_allocate: res[*i64, A.Error] = A.allocate[i64](?aa, 4);
            if (sel res_allocate.err) { ret 5; }
            held[i]    = res_allocate.ok;
            held[i][0] = (100 + i)::i64;
            i          = i + 1;
        }
        i = 0;
        for (i < 3) {
            if (held[i][0] != (100 + i)::i64) { ret 6; }
            i = i + 1;
        }
        ret 0;
    }

    test arena__align_honored_in_place_and_after_growth {
        var pa: A.Allocator;
        page.make(?pa);

        var ar:             Arena;
        var aa:             A.Allocator;
        val err_arena_made: err[A.Error] = init(?ar, ?pa, 4096);
        if (sel err_arena_made.err) { ret 1; }
        fin { dnit(?ar); }
        val err_allocator_made: err[A.Error] = allocator(?aa, ?ar);
        if (sel err_allocator_made.err) { ret 2; }

        # an odd first block puts the offset off every alignment
        val res_first: res[ptr, A.Error] = A.allocate_raw(?aa, 13, 1);
        if (sel res_first.err) { ret 3; }

        var align: usize = 2;
        for (align <= 65536) {
            # a size that is not a multiple of the alignment on purpose
            val size:             usize             = align + 1;
            val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(?aa, size, align);
            if (sel res_allocate_raw.err)                        { ret 4; }
            if (res_allocate_raw.ok == nil)                      { ret 5; }
            if ((res_allocate_raw.ok::usize & (align - 1)) != 0) { ret 6; }
            memory.raw_zero(res_allocate_raw.ok, size);
            align = align * 2;
        }
        ret 0;
    }
}
