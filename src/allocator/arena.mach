# arena allocator implementation
#
# bump allocator with chunked growth. allocation is O(1) amortized.
# deallocate is a no-op except for the most recent allocation which
# can be rolled back. reallocate is in-place for the most recent
# allocation when space permits, otherwise alloc+copy. grows
# automatically by allocating new chunks from the backing allocator.
# the Allocator it makes sets retains, since only a rollback is reused.

use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;

$if (capability.HOSTED) {
    use std.allocator.page;
}

use std.memory;

# header for each backing allocation
# ---
# prev: previous chunk in the linked list
# cap:  data capacity in bytes (data follows the header)
pub rec Chunk {
    prev: *Chunk;
    cap:  usize;
}

val CHUNK_HDR: usize = 16;

# bump allocator state with chunked growth
# ---
# backing:     allocator used for chunk allocations
# buf:         current chunk data pointer (cached for fast-path)
# cap:         current chunk data capacity (cached)
# off:         current allocation offset within current chunk
# last_off:    offset of most recent allocation (for rollback/resize)
# last_size:   size of most recent allocation (for rollback/resize)
# chunk:       current chunk header
# first_chunk: first chunk (for reset/dnit)
# default_cap: minimum chunk capacity for growth
pub rec Arena {
    backing: allocator.Allocator;

    buf: ptr;
    cap: usize;
    off: usize;

    last_off:  usize;
    last_size: usize;

    chunk:       *Chunk;
    first_chunk: *Chunk;
    default_cap: usize;
}

fun align_up(value: usize, align: usize) usize {
    val mask: usize = align - 1;
    ret (value + mask) & ~mask;
}

fun min_usize(x: usize, y: usize) usize {
    if (x < y) { ret x; }
    ret y;
}

fun max_usize(x: usize, y: usize) usize {
    if (x > y) { ret x; }
    ret y;
}

# get data pointer for a chunk (data follows header)
fun chunk_data(c: *Chunk) ptr {
    ret (c::usize + CHUNK_HDR)::ptr;
}

# allocate a new chunk with at least min_cap data bytes
fun alloc_chunk(ar: *Arena, min_cap: usize) *Chunk {
    val total: usize                     = CHUNK_HDR + min_cap;
    val got:   res[ptr, allocator.Error] = allocator.allocate_raw(?ar.backing, total, CHUNK_HDR);
    if (sel got.err) { ret nil; }

    val c: *Chunk = got.ok::*Chunk;
    c.prev = nil;
    c.cap  = min_cap;
    ret c;
}

# deallocate a chunk through the backing allocator
fun free_chunk(ar: *Arena, c: *Chunk) err[allocator.Error] {
    val total: usize = CHUNK_HDR + c.cap;
    ret allocator.deallocate_raw(?ar.backing, c::ptr, total, CHUNK_HDR);
}

# allocate a new chunk and make it current
fun grow(ar: *Arena, min_size: usize) bool {
    var new_cap: usize = max_usize(ar.cap * 2, min_size);
    new_cap = max_usize(new_cap, ar.default_cap);

    val c: *Chunk = alloc_chunk(ar, new_cap);
    if (c == nil) { ret false; }

    c.prev       = ar.chunk;
    ar.chunk     = c;
    ar.buf       = chunk_data(c);
    ar.cap       = new_cap;
    ar.off       = 0;
    ar.last_off  = 0;
    ar.last_size = 0;
    if (ar.first_chunk == nil) {
        ar.first_chunk = c;
    }
    ret true;
}

# initialize an Arena with a backing allocator and optional initial capacity
# ---
# ar:      Arena to initialize
# backing: allocator used to provide backing storage
# cap:     initial chunk capacity in bytes (0 = lazy allocation on first use)
# ret:     ok, `invalid` for a nil arena or backing allocator, or the refusal
#          of the first chunk
pub fun init(ar: *Arena, backing: *allocator.Allocator, cap: usize) err[allocator.Error] {
    if (ar == nil)      { ret err[allocator.Error].err{allocator.Error.invalid{}}; }
    if (backing == nil) { ret err[allocator.Error].err{allocator.Error.invalid{}}; }

    ar.backing     = @backing;
    ar.buf         = nil;
    ar.cap         = 0;
    ar.off         = 0;
    ar.last_off    = 0;
    ar.last_size   = 0;
    ar.chunk       = nil;
    ar.first_chunk = nil;
    ar.default_cap = cap;

    if (cap == 0) {
        ret err[allocator.Error].ok{};
    }

    val c: *Chunk = alloc_chunk(ar, cap);
    if (c == nil) {
        ret err[allocator.Error].err{allocator.Error.exhausted{}};
    }

    ar.chunk       = c;
    ar.first_chunk = c;
    ar.buf         = chunk_data(c);
    ar.cap         = cap;

    ret err[allocator.Error].ok{};
}

# free all chunks and zero the Arena state
#
# every chunk is released even when one release fails; the first failure is
# what is reported, so a combined failure stays observable.
# ---
# ar:  Arena to destroy
# ret: ok if all backing frees succeeded, or the first negative backend native code as `release`
pub fun dnit(ar: *Arena) err[allocator.Error] {
    if (ar == nil) {
        ret err[allocator.Error].ok{};
    }

    var first: err[allocator.Error] = err[allocator.Error].ok{};
    var c:     *Chunk               = ar.chunk;
    for (c != nil) {
        val prev:  *Chunk               = c.prev;
        val freed: err[allocator.Error] = free_chunk(ar, c);
        if (sel freed.err && sel first.ok) { first = freed; }
        c = prev;
    }

    ar.buf         = nil;
    ar.cap         = 0;
    ar.off         = 0;
    ar.last_off    = 0;
    ar.last_size   = 0;
    ar.chunk       = nil;
    ar.first_chunk = nil;

    ret first;
}

# wire up an Allocator backed by this Arena
# ---
# a:   Allocator to initialize
# ar:  initialized Arena (must outlive the Allocator)
# ret: ok, or `invalid` when either pointer is nil
pub fun make(a: *allocator.Allocator, ar: *Arena) err[allocator.Error] {
    if (a == nil)  { ret err[allocator.Error].err{allocator.Error.invalid{}}; }
    if (ar == nil) { ret err[allocator.Error].err{allocator.Error.invalid{}}; }

    a.ctx           = ar::ptr;
    a.fn_allocate   = allocate;
    a.fn_reallocate = reallocate;
    a.fn_deallocate = deallocate;
    a.retains       = true;

    ret err[allocator.Error].ok{};
}

# reset the Arena to empty, freeing all chunks except the first
#
# existing allocations become invalid after reset.
# ---
# ar: Arena to reset
pub fun reset(ar: *Arena) {
    if (ar == nil) { ret; }

    if (ar.first_chunk != nil) {
        var c: *Chunk = ar.chunk;
        for (c != nil && c != ar.first_chunk) {
            val prev: *Chunk = c.prev;
            free_chunk(ar, c);
            c = prev;
        }

        ar.chunk = ar.first_chunk;
        ar.buf   = chunk_data(ar.first_chunk);
        ar.cap   = ar.first_chunk.cap;
    }

    ar.off       = 0;
    ar.last_off  = 0;
    ar.last_size = 0;
}

# arena bump allocation callback
fun allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }

    val ar: *Arena = ctx::*Arena;
    if (size == 0) {
        ret opt[ptr].some{nil};
    }

    # the address is aligned, not the offset: a chunk's data starts a header
    # past its backing allocation and carries only the header's alignment
    if (ar.buf != nil) {
        val start: usize = align_up(ar.buf::usize + ar.off, align) - ar.buf::usize;
        val end:   usize = start + size;
        if (end <= ar.cap) {
            ar.last_off  = start;
            ar.last_size = size;
            ar.off       = end;
            ret opt[ptr].some{(ar.buf::usize + start)::ptr};
        }
    }

    val padded: usize = size + align;
    if (!grow(ar, padded)) {
        ret opt[ptr].none{};
    }

    val start: usize = align_up(ar.buf::usize + ar.off, align) - ar.buf::usize;
    val end:   usize = start + size;
    if (end > ar.cap) {
        ret opt[ptr].none{};
    }

    ar.last_off  = start;
    ar.last_size = size;
    ar.off       = end;

    ret opt[ptr].some{(ar.buf::usize + start)::ptr};
}

# arena resize callback. in-place for the most recent allocation if space permits
fun reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }

    val ar: *Arena = ctx::*Arena;

    if (p == nil) {
        ret allocate(ctx, new_size, align);
    }

    if (new_size == 0) {
        ret opt[ptr].some{nil};
    }

    if (ar.buf != nil) {
        val last_ptr: ptr = (ar.buf::usize + ar.last_off)::ptr;
        if (p == last_ptr && old_size == ar.last_size) {
            val end: usize = ar.last_off + new_size;
            if (end <= ar.cap) {
                ar.off       = end;
                ar.last_size = new_size;
                ret opt[ptr].some{p};
            }
        }
    }

    val fresh: opt[ptr] = allocate(ctx, new_size, align);
    if (!sel fresh.some) { ret fresh; }

    val q: ptr = fresh.some;

    memory.raw_copy(q, p, min_usize(old_size, new_size));

    ret opt[ptr].some{q};
}

# arena free callback. rolls back the most recent allocation if matched
fun deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (ctx == nil) { ret -1; }

    val ar: *Arena = ctx::*Arena;
    if (p == nil) { ret 0; }

    if (ar.buf != nil) {
        val last_ptr: ptr = (ar.buf::usize + ar.last_off)::ptr;
        if (p == last_ptr && size == ar.last_size) {
            ar.off       = ar.last_off;
            ar.last_off  = 0;
            ar.last_size = 0;
        }
    }

    ret 0;
}

$if (capability.HOSTED) {
    # allocations bump forward, freeing an earlier block reclaims nothing,
    # freeing the last one rolls it back, the last one resizes in place, an
    # earlier one moves with its bytes, and reset starts over at the first chunk
    test arena__bump_rollback_resize_and_reset {
        var pa: allocator.Allocator;
        page.make(?pa);
        var ar: Arena;
        var aa: allocator.Allocator;
        val ir: err[allocator.Error] = init(?ar, ?pa, 4096);
        if (sel ir.err) { ret 1; }
        fin { dnit(?ar); }
        val mr: err[allocator.Error] = make(?aa, ?ar);
        if (sel mr.err) { ret 1; }

        val r1: res[*i64, allocator.Error] = allocator.allocate[i64](?aa, 2);
        val r2: res[*i64, allocator.Error] = allocator.allocate[i64](?aa, 2);
        if (sel r1.err || sel r2.err)     { ret 2; }
        if (r2.ok::usize <= r1.ok::usize) { ret 3; }
        r1.ok[0] = 111;
        r1.ok[1] = 222;

        val f1: err[allocator.Error] = allocator.deallocate[i64](?aa, r1.ok, 2);
        if (sel f1.err) { ret 4; }
        val r3: res[*i64, allocator.Error] = allocator.allocate[i64](?aa, 2);
        if (sel r3.err || r3.ok::usize <= r2.ok::usize) { ret 5; }

        val f3: err[allocator.Error] = allocator.deallocate[i64](?aa, r3.ok, 2);
        if (sel f3.err) { ret 6; }
        val r4: res[*i64, allocator.Error] = allocator.allocate[i64](?aa, 2);
        if (sel r4.err || r4.ok != r3.ok) { ret 7; }

        r4.ok[0] = 7;
        val grown: res[*i64, allocator.Error] = allocator.reallocate[i64](?aa, r4.ok, 2, 4);
        if (sel grown.err || grown.ok != r4.ok || grown.ok[0] != 7) { ret 8; }

        val moved: res[*i64, allocator.Error] = allocator.reallocate[i64](?aa, r1.ok, 2, 4);
        if (sel moved.err || moved.ok == r1.ok)       { ret 9; }
        if (moved.ok[0] != 111 || moved.ok[1] != 222) { ret 10; }

        reset(?ar);
        val again: res[*i64, allocator.Error] = allocator.allocate[i64](?aa, 100);
        if (sel again.err || again.ok != r1.ok) { ret 11; }
        ret 0;
    }

    # a lazy arena grows on its first allocation, and a full chunk grows into a
    # new one without disturbing the blocks already handed out
    test arena__grows_lazily_and_when_full {
        var pa: allocator.Allocator;
        page.make(?pa);
        var lazy: Arena;
        var la:   allocator.Allocator;
        val li: err[allocator.Error] = init(?lazy, ?pa, 0);
        val lm: err[allocator.Error] = make(?la, ?lazy);
        if (sel li.err || sel lm.err) { ret 1; }
        val first: res[*i64, allocator.Error] = allocator.allocate[i64](?la, 2);
        if (sel first.err || first.ok == nil) { ret 2; }
        first.ok[1] = 42;
        val ld: err[allocator.Error] = dnit(?lazy);
        if (sel ld.err) { ret 3; }

        var ar: Arena;
        var aa: allocator.Allocator;
        val ir: err[allocator.Error] = init(?ar, ?pa, 64);
        if (sel ir.err) { ret 4; }
        fin { dnit(?ar); }
        val mr: err[allocator.Error] = make(?aa, ?ar);
        if (sel mr.err) { ret 4; }
        var held: [3]*i64;
        var i:    usize = 0;
        for (i < 3) {
            val got: res[*i64, allocator.Error] = allocator.allocate[i64](?aa, 4);
            if (sel got.err) { ret 5; }
            held[i]    = got.ok;
            held[i][0] = (100 + i)::i64;
            i          = i + 1;
        }
        i = 0;
        for (i < 3) {
            if (held[i][0] != (100 + i)::i64) { ret 6; }
            i = i + 1;
        }
        ret 0;
    }

    test arena__align_honored_in_place_and_after_growth {
        var pa: allocator.Allocator;
        page.make(?pa);

        var ar: Arena;
        var aa: allocator.Allocator;
        val ir: err[allocator.Error] = init(?ar, ?pa, 4096);
        if (sel ir.err) { ret 1; }
        fin { dnit(?ar); }
        val mr: err[allocator.Error] = make(?aa, ?ar);
        if (sel mr.err) { ret 2; }

        # an odd first block puts the offset off every alignment
        val first: res[ptr, allocator.Error] = allocator.allocate_raw(?aa, 13, 1);
        if (sel first.err) { ret 3; }

        var align: usize = 2;
        for (align <= 65536) {
            # a size that is not a multiple of the alignment on purpose
            val size: usize                     = align + 1;
            val got:  res[ptr, allocator.Error] = allocator.allocate_raw(?aa, size, align);
            if (sel got.err)                        { ret 4; }
            if (got.ok == nil)                      { ret 5; }
            if ((got.ok::usize & (align - 1)) != 0) { ret 6; }
            memory.raw_zero(got.ok, size);
            align = align * 2;
        }
        ret 0;
    }

}
