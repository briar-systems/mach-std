# page allocator adapter
#
# wraps platform page allocation functions for the Allocator interface. a
# page allocation is page-aligned by nature, so an alignment up to the page
# costs nothing. above the page the mapping is widened by the alignment and
# the block placed inside it: posix trims the pages on either side, and
# windows, which releases a reservation only whole, stashes the raw base in
# the word ahead of the block.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.memory;
use std.system.capability;

$if (capability.HAS_PAGES) {
    use std.system.os;
}
$or {
    $error("std.allocator.page needs the pages capability (std.system.capability.HAS_PAGES)");
}

fun align_up(value: usize, align: usize) usize {
    val mask: usize = align - 1;
    ret (value + mask) & ~mask;
}

# a block aligned past the page, inside a mapping widened by `align`
fun allocate_aligned(size: usize, align: usize) ptr {
    if (size > ~(0::usize) - align) { ret nil; }
    val raw: ptr = os.allocate(size + align);
    if (raw == nil) { ret nil; }

    $if ($mach.build.os == $mach.os.windows) {
        # never at the raw base, so the stash word has a home
        val base: usize = align_up(raw::usize + 1, align);
        @((base - 8)::*usize) = base - raw::usize;
        ret base::ptr;
    }
    $or {
        val page: usize = os.page_size();
        val base: usize = align_up(raw::usize, align);
        val head: usize = base - raw::usize;
        val keep: usize = align_up(base + size, page);
        val tail: usize = raw::usize + size + align - keep;

        if (head != 0) { os.deallocate(raw, head); }
        if (tail != 0) { os.deallocate(keep::ptr, tail); }
        ret base::ptr;
    }
}

fun deallocate_aligned(p: ptr, size: usize, align: usize) i64 {
    $if ($mach.build.os == $mach.os.windows) {
        val back: usize = @((p::usize - 8)::*usize);
        ret os.deallocate((p::usize - back)::ptr, size + align);
    }
    $or {
        ret os.deallocate(p, align_up(size, os.page_size()));
    }
}

# initialize a page-backed Allocator
# ---
# a:   Allocator to initialize
# ret: ok, or `invalid` when a is nil
pub fun make(a: *allocator.Allocator) err[allocator.Error] {
    if (a == nil) { ret err[allocator.Error].err{allocator.Error.invalid{}}; }

    a.ctx           = nil;
    a.fn_allocate   = allocate;
    a.fn_reallocate = reallocate;
    a.fn_deallocate = deallocate;

    ret err[allocator.Error].ok{};
}

# allocate size bytes via platform page allocator
# ---
# ctx:   unused context pointer
# size:  number of bytes to allocate
# align: alignment of the returned address, a power of two
# ret:   allocated pointer or none on failure
fun allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    var p: ptr = nil;
    if (align > os.page_size()) { p = allocate_aligned(size, align); }
    or                          { p = os.allocate(size); }
    if (p == nil) {
        ret opt[ptr].none{};
    }
    ret opt[ptr].some{p};
}

# reallocate a page-backed allocation
#
# a block aligned past the page moves to a fresh block, since the platform
# resize may relocate it to any page
# ---
# ctx:      unused context pointer
# p:        pointer to existing allocation
# old_size: current size in bytes
# new_size: desired size in bytes
# align:    alignment of the returned address, a power of two
# ret:      reallocated pointer or none on failure
fun reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (align > os.page_size()) {
        if (p == nil) { ret allocate(ctx, new_size, align); }
        if (new_size == 0) {
            deallocate_aligned(p, old_size, align);
            ret opt[ptr].none{};
        }
        val fresh: ptr = allocate_aligned(new_size, align);
        if (fresh == nil) { ret opt[ptr].none{}; }
        var copy: usize = old_size;
        if (new_size < copy) { copy = new_size; }
        memory.raw_copy(fresh, p, copy);
        deallocate_aligned(p, old_size, align);
        ret opt[ptr].some{fresh};
    }

    val result: ptr = os.reallocate(p, old_size, new_size);
    if (result == nil) {
        ret opt[ptr].none{};
    }
    ret opt[ptr].some{result};
}

# deallocate a page-backed allocation
# ---
# ctx:   unused context pointer
# p:     pointer to deallocate
# size:  size of allocation in bytes
# align: the alignment it was allocated at
# ret:   0 on success, or a negative backend native code
fun deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (p == nil || size == 0)  { ret 0; }
    if (align > os.page_size()) { ret deallocate_aligned(p, size, align); }
    ret os.deallocate(p, size);
}

test "page: alignment above the page is honored" {
    var a:  allocator.Allocator;
    val mr: err[allocator.Error] = make(?a);
    if (sel mr.err) { ret 1; }

    var kept:  [8]ptr;
    var align: usize = 1;
    for (align <= 131072) {
        var n: usize = 0;
        for (n < 8) {
            # a size that is not a multiple of the alignment on purpose
            val size: usize                     = align + 1 + n;
            val got:  res[ptr, allocator.Error] = allocator.allocate_raw(?a, size, align);
            if (sel got.err)                        { ret 2; }
            if (got.ok == nil)                      { ret 3; }
            if ((got.ok::usize & (align - 1)) != 0) { ret 4; }

            # every byte asked for is writable
            memory.raw_zero(got.ok, size);
            (got.ok::*u8)[size - 1] = 0x5A;
            kept[n]                 = got.ok;
            n                       = n + 1;
        }

        n = 0;
        for (n < 8) {
            val size: usize                = align + 1 + n;
            val gone: err[allocator.Error] = allocator.deallocate_raw(?a, kept[n], size, align);
            if (sel gone.err) { ret 5; }
            n = n + 1;
        }
        align = align * 2;
    }
    ret 0;
}

test "page: reallocate keeps an alignment above the page" {
    var a:  allocator.Allocator;
    val mr: err[allocator.Error] = make(?a);
    if (sel mr.err) { ret 1; }

    val align: usize                     = 131072;
    val got:   res[ptr, allocator.Error] = allocator.allocate_raw(?a, 100, align);
    if (sel got.err) { ret 2; }
    val b: *u8   = got.ok::*u8;
    var i: usize = 0;
    for (i < 100) {
        b[i] = (i + 3)::u8;
        i    = i + 1;
    }

    val grew: res[ptr, allocator.Error] = allocator.reallocate_raw(?a, got.ok, 100, 300000, align);
    if (sel grew.err)                        { ret 3; }
    if ((grew.ok::usize & (align - 1)) != 0) { ret 4; }
    val g: *u8 = grew.ok::*u8;
    i = 0;
    for (i < 100) {
        if (g[i] != (i + 3)::u8) { ret 5; }
        i = i + 1;
    }
    g[299999] = 1;

    val gone: err[allocator.Error] = allocator.deallocate_raw(?a, grew.ok, 300000, align);
    if (sel gone.err) { ret 6; }
    ret 0;
}
