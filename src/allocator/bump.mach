# brk-based bump allocator
#
# monotonically advances a brk pointer for small allocations (< 128KB),
# falls back to mmap for large allocations. a mapping is only page aligned, so
# a large request aligned past the page size is bumped from the brk region
# like a small one. deallocate is a no-op for brk-backed memory, individual
# brk allocations cannot be freed, only reclaimed on program exit. use an arena allocator for bulk-freeable
# allocation patterns, or a real heap allocator for general-purpose use.
# the Allocator it makes sets retains, since freed brk memory is never reused.

use A: std.allocator;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;

use std.memory;
use std.system.capability;
use std.types.size.usize;

$if (capability.HAS_PAGES) {
    use std.system.os;
}
$or {
    $error("std.allocator.bump needs the pages capability (std.system.capability.HAS_PAGES)");
}

val MMAP_THRESHOLD: usize = 131072;
val MIN_BRK_EXTEND: usize = 65536;

# brk bump allocator tracking state
# ---
# current: current bump pointer position
# end:     current end of the brk region
pub rec BumpState {
    current: usize;
    end:     usize;
}

# initialize a bump-backed Allocator and its BumpState
# ---
# a:     Allocator to initialize
# state: BumpState to initialize (must outlive the Allocator)
# ret:   ok, or `invalid` when either pointer is nil
pub fun make(a: *A.Allocator, state: *BumpState) err[A.Error] {
    if (a == nil)     { ret err[A.Error].err{A.Error.invalid{}}; }
    if (state == nil) { ret err[A.Error].err{A.Error.invalid{}}; }

    val base: usize = os.heap_region_base();
    state.current = base;
    state.end     = base;

    a.ctx           = state::ptr;
    a.fn_allocate   = allocate;
    a.fn_reallocate = reallocate;
    a.fn_deallocate = deallocate;
    a.retains       = true;

    ret err[A.Error].ok{};
}

# whether a block of this size and alignment lives in its own mapping, which
# allocate, reallocate and deallocate all decide from the same size and align
fun mapped(size: usize, align: usize) bool {
    ret size >= MMAP_THRESHOLD && align <= os.page_size();
}

# align a value up to the given alignment (must be a power of two)
fun align_up(value: usize, align: usize) usize {
    val mask: usize = align - 1;
    ret (value + mask) & ~mask;
}

# allocate size bytes from the brk heap, or a mapping of their own for a large
# request no more than page aligned
# ---
# ctx:   BumpState pointer
# size:  number of bytes to allocate
# align: requested alignment in bytes
# ret:   allocated pointer or none on failure
fun allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    if (size == 0) {
        ret opt[ptr].some{nil};
    }

    if (mapped(size, align)) {
        val p: ptr = os.allocate(size);
        if (p == nil) {
            ret opt[ptr].none{};
        }
        ret opt[ptr].some{p};
    }

    val state:   *BumpState = ctx::*BumpState;
    val aligned: usize      = align_up(state.current, align);
    val needed:  usize      = aligned + size;

    # an alignment or an end past the top of the address space wraps
    if (aligned < state.current || needed < aligned) {
        ret opt[ptr].none{};
    }

    if (needed > state.end) {
        var extend: usize = needed - state.end;
        if (extend < MIN_BRK_EXTEND) {
            extend = MIN_BRK_EXTEND;
        }

        val target: usize = state.end + extend;
        val actual: usize = os.heap_region_extend(target);

        if (actual < needed) {
            ret opt[ptr].none{};
        }

        state.end = actual;
    }

    state.current = needed;
    ret opt[ptr].some{aligned::ptr};
}

# reallocate a heap allocation, copying data to a new location if needed
# ---
# ctx:      BumpState pointer
# p:        pointer to existing allocation
# old_size: current size in bytes
# new_size: desired size in bytes
# align:    requested alignment in bytes
# ret:      reallocated pointer or none on failure
fun reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (p == nil) {
        ret allocate(ctx, new_size, align);
    }

    if (new_size == 0) {
        deallocate(ctx, p, old_size, align);
        ret opt[ptr].some{nil};
    }

    if (mapped(old_size, align) && mapped(new_size, align)) {
        val result: ptr = os.reallocate(p, old_size, new_size);
        if (result == nil) {
            ret opt[ptr].none{};
        }
        ret opt[ptr].some{result};
    }

    val opt_fresh: opt[ptr] = allocate(ctx, new_size, align);
    if (!sel opt_fresh.some) { ret opt_fresh; }

    val new_p:     ptr   = opt_fresh.some;
    var copy_size: usize = old_size;
    if (new_size < copy_size) {
        copy_size = new_size;
    }
    memory.raw_copy(new_p, p, copy_size);

    deallocate(ctx, p, old_size, align);
    ret opt[ptr].some{new_p};
}

# deallocate a heap allocation. no-op for brk-backed memory
# ---
# ctx:   BumpState pointer
# p:     pointer to deallocate
# size:  size of allocation in bytes
# align: alignment, which with size tells a mapping from brk memory
# ret:   0 on success, or a negative backend native code
fun deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (p == nil || size == 0) {
        ret 0;
    }

    if (mapped(size, align)) {
        ret os.deallocate(p, size);
    }

    # brk-backed allocations cannot be individually freed
    ret 0;
}
