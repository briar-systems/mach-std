# an allocator built to make memory bugs fail loudly in tests
#
# the production allocators are forgiving in ways that hide defects. a page
# allocator hands back kernel-zeroed memory, so reading an uninitialized field
# looks like reading a zero. it rounds every request up to a page, so reading
# one byte past the end of a small object lands in slack that is still mapped
# and still readable. and it never runs out, so the failure path of every
# allocating function goes untested. this allocator removes all three
# forgivenesses.
#
# ## strict sizes
#
# an allocation is placed as close to the end of a mapped page as its
# alignment allows, and the page immediately after it is mapped unreadable.
# a request whose size is a multiple of its alignment ends on the last byte
# of the page, so reading or writing even one byte past it faults at the exact
# moment it happens; any other request leaves fewer than `align` bytes of
# slack before the guard. the cost is one guard page per live allocation,
# which is why this belongs in tests and not in production.
#
# ## poison
#
# fresh memory is filled with `POISON_NEW` rather than left zeroed, so code that
# reads a field it never wrote sees an implausible value instead of a plausible
# zero. freed memory is overwritten with `POISON_FREE` before the mapping is
# torn down, so a use-after-free that happens to reach still-mapped memory reads
# an implausible value too.
#
# ## fail at N
#
# `fail_at_ordinal` makes the Nth allocation from this allocator fail, counting
# from one. `fail_from_ordinal` refuses the Nth and every later one, so
# `fail_from_ordinal(t, 1)` gives an allocator that refuses everything and
# only counts what it was asked. a test that runs the same operation once per
# ordinal, from one to the number of allocations the operation makes,
# exercises every allocation-failure path in it. `live` and `leaked` then say
# whether the operation cleaned up after itself on each of those paths, which
# is the property that matters and the one that is otherwise almost impossible
# to check.
#
# ## the walk
#
# `walk` does that loop. it runs an attempt at ordinal zero to learn how many
# requests the operation makes, then once per ordinal from one to that count,
# with a fresh instance each time. the attempt builds its fixture through the
# instance, calls `arm`, runs the operation, asserts what the operation
# promised and tears the fixture down. `arm` starts the counted window, so a
# fixture built before it does not shift the ordinal the operation is refused
# at. after every attempt the walk checks that nothing is outstanding, nothing
# was released wrongly, tracking never filled, and the armed refusal fired
# exactly once.
#
# ## accounting
#
# every allocation is recorded until it is freed. `live` is how many are
# outstanding, `leaked` is whether any are, and a free of a pointer this
# allocator did not hand out, or handed out and already took back, is counted
# as a double free rather than being ignored. a free or a reallocate that
# names a block with a size other than the one it was handed out at is counted
# as a size mismatch.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.system.capability;

$if (capability.HAS_PAGES) {
    use std.allocator.page;
    use std.system.os;
}
$or {
    $error("std.allocator.testing needs the pages capability (std.system.capability.HAS_PAGES)");
}

# filled into memory as it is handed out, so an uninitialized read is visible
pub val POISON_NEW: u8 = 0xAA;
# written over memory as it is taken back, so a use-after-free is visible
pub val POISON_FREE: u8 = 0xDE;

# how many live allocations one instance can track at once
pub val MAX_TRACKED: usize = 4096;
# the open-addressed table holding them, twice the cap so a lookup stays short
val SLOTS: usize = 8192;

# the attempt made no request at ordinal zero
pub val WALK_NONALLOCATING: i32 = -1;
# the attempt left an allocation outstanding
pub val WALK_LEAK: i32 = -2;
# the attempt released a block it did not own, twice, or with the wrong size
pub val WALK_MISMATCH: i32 = -3;
# the attempt held more live allocations than one instance tracks
pub val WALK_OVERFLOW: i32 = -4;
# the armed ordinal was never reached, or was refused more than once
pub val WALK_UNFIRED: i32 = -5;

rec Block {
    # the address handed to the caller
    base: ptr;
    # what the caller asked for
    size: usize;
    # the start of the whole mapping, which is where the guard lives
    map: ptr;
    # the total mapped length, payload pages plus the guard page
    span: usize;
    # 0 empty, 1 live, 2 released (a tombstone a lookup walks past)
    state: u8;
}

# a tracking, guarding, failing allocator
#
# create with `make`, hand `?state.a` to the code under test, and read the
# counters afterwards. one instance is not safe to share across threads.
pub rec Testing {
    # the interface to hand to code under test
    a: allocator.Allocator;

    # the ordinal of the allocation that must fail, counting from one; zero
    # means never fail
    fail_at: usize;
    # keep refusing every request after `fail_at`
    sticky: bool;
    # how many allocation requests have been made
    attempts: usize;
    # how many requests failure injection refused
    refused: usize;
    # the size of the most recent allocate or reallocate request
    last_size: usize;

    # refuse every reallocate of an existing block
    refuse_reallocates: bool;
    # reallocates of an existing block to a nonzero size, refused or not
    reallocates: usize;
    # the block and the old size the most recent such reallocate named
    last_reallocated: ptr;
    last_old_size:    usize;

    # the walk's ordinal for this attempt, zero for the baseline
    ordinal: usize;
    # `attempts` when `arm` ran
    armed_at: usize;

    # how many allocations are outstanding
    live: usize;
    # the most that were outstanding at once
    peak_live: usize;
    # the bytes they hold, as requested
    live_bytes: usize;
    # how many allocations have ever been made
    total: usize;
    # frees of a pointer this allocator did not currently own
    double_frees: usize;
    # frees and reallocates of an owned block that named another size
    size_mismatches: usize;
    # allocations refused because tracking is full rather than because of
    # `fail_at`; a test that trips this needs a bigger `MAX_TRACKED`
    exhausted: usize;

    blocks: [8192]Block;
}

fun page_span(size: usize) usize {
    val ps:    usize = os.page_size();
    var pages: usize = size / ps;
    if (size % ps != 0) { pages = pages + 1; }
    if (pages == 0)     { pages = 1; }
    ret pages * ps;
}

fun fill(p: ptr, len: usize, b: u8) {
    val bytes: *u8   = p::*u8;
    var i:     usize = 0;
    for (i < len) {
        bytes[i] = b;
        i        = i + 1;
    }
}

fun align_down(value: usize, align: usize) usize {
    ret value & ~(align - 1);
}

# map payload pages followed by one unreadable guard page, and return the
# aligned address closest to the guard whose block still ends before it
fun map_guarded(size: usize, align: usize, out_map: *ptr, out_span: *usize) ptr {
    val ps:      usize = os.page_size();
    var payload: usize = page_span(size);
    # an alignment past the page needs that much room to place the base
    if (align > ps) { payload = payload + align; }
    val span: usize = payload + ps;

    val map: ptr = os.allocate(span);
    if (map == nil) { ret nil; }

    # the trailing page is the guard: unreadable, so a one-byte overrun faults
    if (os.protect((map::usize + payload)::ptr, ps, os.PROT_NONE::u32) < 0) {
        os.deallocate(map, span);
        ret nil;
    }

    @out_map  = map;
    @out_span = span;
    # the END of the allocation sits as close to the guard as align allows
    ret align_down(map::usize + payload - size, align)::ptr;
}

fun hash(p: ptr) usize {
    val h: usize = (p::usize >> 4) * 0x9E3779B97F4A7C15;
    ret (h >> 20) & (SLOTS - 1);
}

fun find_block(t: *Testing, p: ptr) usize {
    var i:     usize = hash(p);
    var steps: usize = 0;
    for (steps < SLOTS) {
        val state: u8 = t.blocks[i].state;
        if (state == 0)                          { ret SLOTS; }
        if (state == 1 && t.blocks[i].base == p) { ret i; }
        i     = (i + 1) & (SLOTS - 1);
        steps = steps + 1;
    }
    ret SLOTS;
}

fun record(t: *Testing, base: ptr, size: usize, map: ptr, span: usize) bool {
    if (t.live >= MAX_TRACKED) { ret false; }
    var i:     usize = hash(base);
    var steps: usize = 0;
    for (steps < SLOTS) {
        if (t.blocks[i].state != 1) {
            t.blocks[i] = Block{base: base, size: size, map: map, span: span, state: 1};
            ret true;
        }
        i     = (i + 1) & (SLOTS - 1);
        steps = steps + 1;
    }
    ret false;
}

# one request in the ordinal sequence: true when this one is refused
fun refuse(t: *Testing) bool {
    t.attempts = t.attempts + 1;
    if (t.fail_at == 0) { ret false; }
    if (t.attempts == t.fail_at || (t.sticky && t.attempts > t.fail_at)) {
        t.refused = t.refused + 1;
        ret true;
    }
    ret false;
}

fun do_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val t: *Testing = ctx::*Testing;
    if (size == 0) { ret opt[ptr].none{}; }

    t.last_size = size;
    if (refuse(t)) { ret opt[ptr].none{}; }

    var map:  ptr   = nil;
    var span: usize = 0;
    val base: ptr   = map_guarded(size, align, ?map, ?span);
    if (base == nil) { ret opt[ptr].none{}; }

    if (!record(t, base, size, map, span)) {
        os.deallocate(map, span);
        t.exhausted = t.exhausted + 1;
        ret opt[ptr].none{};
    }

    fill(base, size, POISON_NEW);
    t.live       = t.live + 1;
    t.live_bytes = t.live_bytes + size;
    if (t.live > t.peak_live) { t.peak_live = t.live; }
    t.total = t.total + 1;
    ret opt[ptr].some{base};
}

fun do_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    val t: *Testing = ctx::*Testing;
    if (p == nil) { ret 0; }

    val idx: usize = find_block(t, p);
    if (idx == SLOTS) {
        # either never handed out, or handed out and already taken back
        t.double_frees = t.double_frees + 1;
        ret -1;
    }

    val b: Block = t.blocks[idx];
    if (b.size != size) { t.size_mismatches = t.size_mismatches + 1; }
    fill(b.base, b.size, POISON_FREE);
    t.blocks[idx].state = 2;
    t.live              = t.live - 1;
    t.live_bytes        = t.live_bytes - b.size;
    os.deallocate(b.map, b.span);
    ret 0;
}

fun do_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val t: *Testing = ctx::*Testing;
    if (p == nil) { ret do_allocate(ctx, new_size, align); }
    if (new_size == 0) {
        do_deallocate(ctx, p, old_size, align);
        ret opt[ptr].none{};
    }

    t.reallocates      = t.reallocates + 1;
    t.last_reallocated = p;
    t.last_old_size    = old_size;
    if (t.refuse_reallocates) {
        t.attempts  = t.attempts + 1;
        t.refused   = t.refused + 1;
        t.last_size = new_size;
        ret opt[ptr].none{};
    }

    # the copy never reads past what the block really holds, whatever size
    # the caller named
    var copy: usize = old_size;
    val idx:  usize = find_block(t, p);
    if (idx != SLOTS && t.blocks[idx].size != old_size) {
        t.size_mismatches = t.size_mismatches + 1;
        if (t.blocks[idx].size < copy) { copy = t.blocks[idx].size; }
    }
    if (new_size < copy) { copy = new_size; }

    # a fresh mapping every time: growing in place would silently widen the
    # gap to the guard page and lose the overrun check
    val fresh: opt[ptr] = do_allocate(ctx, new_size, align);
    if (!sel fresh.some) { ret fresh; }
    val dst: ptr   = fresh.some;
    val s:   *u8   = p::*u8;
    val d:   *u8   = dst::*u8;
    var i:   usize = 0;
    for (i < copy) {
        d[i] = s[i];
        i    = i + 1;
    }

    var old_recorded: usize = old_size;
    if (idx != SLOTS) { old_recorded = t.blocks[idx].size; }
    do_deallocate(ctx, p, old_recorded, align);
    ret opt[ptr].some{dst};
}

# initialize a testing allocator
#
# the instance owns the mappings it hands out, so it must outlive every
# allocation made through it, and `dnit` must run while those are still
# reachable.
# ---
# t:   the instance to initialize
# ret: ok, or `invalid` when t is nil
pub fun make(t: *Testing) err[allocator.Error] {
    if (t == nil) { ret err[allocator.Error].err{allocator.Error.invalid{}}; }

    t.fail_at            = 0;
    t.sticky             = false;
    t.attempts           = 0;
    t.refused            = 0;
    t.refuse_reallocates = false;
    t.reallocates        = 0;
    t.last_reallocated   = nil;
    t.last_old_size      = 0;
    t.peak_live          = 0;
    t.last_size          = 0;
    t.ordinal            = 0;
    t.armed_at           = 0;
    t.live               = 0;
    t.live_bytes         = 0;
    t.total              = 0;
    t.double_frees       = 0;
    t.size_mismatches    = 0;
    t.exhausted          = 0;
    var i: usize = 0;
    for (i < SLOTS) {
        t.blocks[i].state = 0;
        i                 = i + 1;
    }

    t.a.ctx           = (t)::ptr;
    t.a.fn_allocate   = do_allocate;
    t.a.fn_reallocate = do_reallocate;
    t.a.fn_deallocate = do_deallocate;
    t.a.retains       = false;
    ret err[allocator.Error].ok{};
}

# the allocator interface to hand to the code under test
pub fun allocator_of(t: *Testing) *allocator.Allocator {
    ret ?t.a;
}

# make the `n`th allocation from now fail, counting the allocations this
# instance has already served
#
# passing zero disables failure injection.
pub fun fail_at_ordinal(t: *Testing, n: usize) {
    t.fail_at = n;
    t.sticky  = false;
}

# make the `n`th allocation and every one after it fail, counting as
# `fail_at_ordinal` does
#
# passing zero disables failure injection. on a fresh instance, one refuses
# every request while still counting them.
pub fun fail_from_ordinal(t: *Testing, n: usize) {
    t.fail_at = n;
    t.sticky  = n != 0;
}

# refuse every reallocate of an existing block while `on`, leaving allocates to
# the ordinal rules
#
# a refused reallocate still counts as an attempt and as a reallocate.
pub fun refuse_reallocates(t: *Testing, on: bool) {
    t.refuse_reallocates = on;
}

# stop failing allocations
pub fun clear_failure(t: *Testing) {
    t.fail_at = 0;
    t.sticky  = false;
}

# start the counted window of a walk attempt
#
# requests made before this are the fixture's. from here `counted` measures,
# and the attempt's ordinal, when it has one, is refused counting from here.
pub fun arm(t: *Testing) {
    t.armed_at = t.attempts;
    if (t.ordinal == 0) { clear_failure(t); }
    or                  { fail_at_ordinal(t, t.attempts + t.ordinal); }
}

# how many allocation requests have been made since `arm`
pub fun counted(t: *Testing) usize {
    ret t.attempts - t.armed_at;
}

# how many reallocates of an existing block to a nonzero size were requested,
# refused or not
#
# a reallocate from nil is an allocate and one to zero is a free; neither
# counts here.
pub fun reallocate_count(t: *Testing) usize {
    ret t.reallocates;
}

# the block the most recent counted reallocate named, nil before any
pub fun last_reallocated(t: *Testing) ptr {
    ret t.last_reallocated;
}

# the old size the most recent counted reallocate named
pub fun last_old_size(t: *Testing) usize {
    ret t.last_old_size;
}

# how many requests failure injection refused
pub fun refused_count(t: *Testing) usize {
    ret t.refused;
}

# the size of the most recent allocate or reallocate request, refused or not
pub fun last_request_size(t: *Testing) usize {
    ret t.last_size;
}

# true when `p` is an allocation this instance currently holds
pub fun owns(t: *Testing, p: ptr) bool {
    if (p == nil) { ret false; }
    ret find_block(t, p) != SLOTS;
}

# how many allocations are outstanding
pub fun live_count(t: *Testing) usize {
    ret t.live;
}

# the most allocations that were outstanding at once since `make`
#
# a reallocate holds the old and the new block together for a moment, so it
# counts one more.
pub fun peak_live_count(t: *Testing) usize {
    ret t.peak_live;
}

# how many bytes the outstanding allocations hold, at the sizes requested
pub fun live_byte_count(t: *Testing) usize {
    ret t.live_bytes;
}

# how many allocations this instance has ever served
pub fun total_count(t: *Testing) usize {
    ret t.total;
}

# how many allocation requests have been made, including the refused ones
pub fun attempt_count(t: *Testing) usize {
    ret t.attempts;
}

# true when anything allocated through this instance was never freed
pub fun leaked(t: *Testing) bool {
    ret t.live != 0;
}

# how many frees named a pointer this instance did not currently own
pub fun double_free_count(t: *Testing) usize {
    ret t.double_frees;
}

# how many frees and reallocates named an owned block with another size
pub fun size_mismatch_count(t: *Testing) usize {
    ret t.size_mismatches;
}

# true when tracking filled up, which makes the other counters unreliable
pub fun tracking_exhausted(t: *Testing) bool {
    ret t.exhausted != 0;
}

# nothing outstanding, nothing released wrongly, and tracking never filled
pub fun clean(t: *Testing) bool {
    ret t.live == 0 && t.double_frees == 0 && t.size_mismatches == 0 && t.exhausted == 0;
}

# release everything still outstanding and reset the counters
#
# leaks are reported by `leaked` before this runs; afterwards the instance is
# clean and can be reused.
# ---
# ret: how many live allocations had to be reclaimed, which is the leak count
pub fun dnit(t: *Testing) usize {
    if (t == nil) { ret 0; }
    var reclaimed: usize = 0;
    var i:         usize = 0;
    for (i < SLOTS) {
        if (t.blocks[i].state == 1) {
            os.deallocate(t.blocks[i].map, t.blocks[i].span);
            reclaimed = reclaimed + 1;
        }
        t.blocks[i].state = 0;
        i                 = i + 1;
    }
    t.live       = 0;
    t.live_bytes = 0;
    ret reclaimed;
}

# how a walk ended
pub rec Outcome {
    # zero when every attempt passed, else the failing attempt's own code or
    # one of the WALK_ codes
    code: i32;
    # the ordinal that failed, zero when the walk passed
    ordinal: usize;
    # the requests the operation made at ordinal zero
    attempts: usize;
}

fun check(t: *Testing, code: i32) i32 {
    if (code != 0)                        { ret code; }
    if (t.exhausted != 0)                 { ret WALK_OVERFLOW; }
    if (t.double_frees != 0)              { ret WALK_MISMATCH; }
    if (t.size_mismatches != 0)           { ret WALK_MISMATCH; }
    if (t.live != 0)                      { ret WALK_LEAK; }
    if (t.ordinal != 0 && t.refused != 1) { ret WALK_UNFIRED; }
    ret 0;
}

# run `attempt` once per ordinal: zero first, then one to the count the
# baseline made
#
# each attempt gets a fresh instance, builds its fixture through it, calls
# `arm`, runs the operation, asserts its promises and tears the fixture down,
# returning zero on a pass. the walk stops at the first failing ordinal. an
# operation that makes no request at ordinal zero ends the walk with
# `WALK_NONALLOCATING`, so the test can say so instead of probing nothing.
# ---
# context: handed to every attempt unchanged
# attempt: one run of the operation under the instance
# ret:     how the walk ended
pub fun walk[C](context: *C, attempt: fun(*C, *Testing) i32) Outcome {
    var out:     Outcome = Outcome{code: 0, ordinal: 0, attempts: 0};
    var ordinal: usize   = 0;
    for (ordinal == 0 || ordinal <= out.attempts) {
        var t:    Testing;
        val made: err[allocator.Error] = make(?t);
        if (sel made.err) {
            out.code    = WALK_OVERFLOW;
            out.ordinal = ordinal;
            ret out;
        }
        t.ordinal = ordinal;
        val code: i32 = check(?t, attempt(context, ?t));
        if (ordinal == 0) { out.attempts = counted(?t); }
        dnit(?t);
        out.ordinal = ordinal;
        if (code != 0) {
            out.code = code;
            ret out;
        }
        if (ordinal == 0 && out.attempts == 0) {
            out.code = WALK_NONALLOCATING;
            ret out;
        }
        ordinal = ordinal + 1;
    }
    out.ordinal = 0;
    ret out;
}

# a count of the bytes an allocator has handed out and not taken back
#
# `counting_make` counts over a page allocator, `counting_wrap` over whatever
# `inner` already is. hand `a` to the code under test and read `live`.
#[testing]
pub rec Counting {
    inner:       allocator.Allocator;
    live:        usize;
    allocations: usize;
}

#[testing]
fun counting_allocate(context: ptr, size: usize, align: usize) opt[ptr] {
    val counting: *Counting = context::*Counting;
    val got:      opt[ptr]  = counting.inner.fn_allocate(counting.inner.ctx, size, align);
    if (sel got.some) {
        counting.live        = counting.live + size;
        counting.allocations = counting.allocations + 1;
    }
    ret got;
}

#[testing]
fun counting_reallocate(context: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val counting: *Counting = context::*Counting;
    val got:      opt[ptr]  = counting.inner.fn_reallocate(counting.inner.ctx, p, old_size, new_size, align);
    if (sel got.some) {
        counting.live        = counting.live - old_size + new_size;
        counting.allocations = counting.allocations + 1;
    }
    ret got;
}

#[testing]
fun counting_deallocate(context: ptr, p: ptr, size: usize, align: usize) i64 {
    val counting: *Counting = context::*Counting;
    val code:     i64       = counting.inner.fn_deallocate(counting.inner.ctx, p, size, align);
    if (code == 0) { counting.live = counting.live - size; }
    ret code;
}

# the count over a page allocator
#[testing]
pub fun counting_make(counting: *Counting, a: *allocator.Allocator) {
    page.make(?counting.inner);
    counting_wrap(counting, a);
}

# the count over whatever counting.inner already is, reclaiming as it does
#[testing]
pub fun counting_wrap(counting: *Counting, a: *allocator.Allocator) {
    counting.live        = 0;
    counting.allocations = 0;
    a.ctx                = counting::ptr;
    a.fn_allocate        = counting_allocate;
    a.fn_reallocate      = counting_reallocate;
    a.fn_deallocate      = counting_deallocate;
    a.retains            = counting.inner.retains;
}

test fail_at__refuses_exactly_the_named_ordinal {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }
    fail_at_ordinal(?t, 2);

    val first: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel first.err) {
        dnit(?t);
        ret 2;
    }

    # the refusal is an `exhausted` error the caller holds, never a nil ok
    val second: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (!sel second.err) {
        dnit(?t);
        ret 3;
    }
    if (!sel second.err.exhausted) {
        dnit(?t);
        ret 3;
    }

    val third: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel third.err) {
        dnit(?t);
        ret 4;
    }

    # the refused request counts as an attempt but not as an allocation
    if (attempt_count(?t) != 3) {
        dnit(?t);
        ret 5;
    }
    if (total_count(?t) != 2) {
        dnit(?t);
        ret 6;
    }
    if (live_count(?t) != 2) {
        dnit(?t);
        ret 7;
    }

    if (dnit(?t) != 2) { ret 8; }
    ret 0;
}

test leaks__live_count_and_report_track_every_block {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }

    val a: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 32);
    val b: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 64);
    if (sel a.err) {
        dnit(?t);
        ret 2;
    }
    if (sel b.err) {
        dnit(?t);
        ret 2;
    }
    if (live_count(?t) != 2) {
        dnit(?t);
        ret 3;
    }
    if (!leaked(?t)) {
        dnit(?t);
        ret 4;
    }

    allocator.deallocate[u8](?t.a, a.ok, 32);
    if (live_count(?t) != 1) {
        dnit(?t);
        ret 5;
    }
    allocator.deallocate[u8](?t.a, b.ok, 64);
    if (live_count(?t) != 0) {
        dnit(?t);
        ret 6;
    }
    if (leaked(?t)) {
        dnit(?t);
        ret 7;
    }

    # nothing outstanding, so nothing to reclaim
    if (dnit(?t) != 0) { ret 8; }
    ret 0;
}

test allocate__fresh_memory_is_poisoned_not_zeroed {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }

    val a: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel a.err) {
        dnit(?t);
        ret 2;
    }
    val p: *u8 = a.ok;

    # a page allocator would hand back zeroes here and hide an uninitialized read
    var i: usize = 0;
    for (i < 8) {
        if (p[i] != POISON_NEW) {
            dnit(?t);
            ret 3;
        }
        i = i + 1;
    }
    dnit(?t);
    ret 0;
}

test allocate__align_honored_flush_against_the_guard {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }
    fin { dnit(?t); }

    val ps:    usize = os.page_size();
    var align: usize = 1;
    for (align <= ps * 2) {
        var n: usize = 0;
        for (n < 4) {
            # a size that is not a multiple of the alignment on purpose
            val size: usize                     = align + 1 + n;
            val got:  res[ptr, allocator.Error] = allocator.allocate_raw(?t.a, size, align);
            if (sel got.err)                        { ret 2; }
            if ((got.ok::usize & (align - 1)) != 0) { ret 3; }

            # the slack before the guard is below the alignment, and the
            # block is still writable to its last byte
            val end: usize = got.ok::usize + size;
            if (ps - end % ps >= align && end % ps != 0) { ret 4; }
            (got.ok::*u8)[size - 1] = 1;

            val gone: err[allocator.Error] = allocator.deallocate_raw(?t.a, got.ok, size, align);
            if (sel gone.err) { ret 5; }
            n = n + 1;
        }
        align = align * 2;
    }

    if (leaked(?t)) { ret 6; }
    ret 0;
}

# reallocate takes a fresh block, so it must be refusable the same way a plain
# allocation is: a caller growing a buffer has an allocation-failure path too,
# and a fail_at that only reached allocate would leave it untested.
test reallocate__honors_fail_at {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }

    val a: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 1);
    if (sel a.err) {
        dnit(?t);
        ret 2;
    }
    val p: *u8 = a.ok;

    # the next request is the one that must be refused
    fail_at_ordinal(?t, attempt_count(?t) + 1);
    val g: res[*u8, allocator.Error] = allocator.reallocate[u8](?t.a, p, 1, 2);
    if (sel g.ok) {
        dnit(?t);
        ret 3;
    }

    # a refused growth leaves the original block alone, not freed
    if (live_count(?t) != 1) {
        dnit(?t);
        ret 4;
    }
    if (double_free_count(?t) != 0) {
        dnit(?t);
        ret 5;
    }

    clear_failure(?t);
    allocator.deallocate[u8](?t.a, p, 1);
    if (leaked(?t)) {
        dnit(?t);
        ret 6;
    }

    dnit(?t);
    ret 0;
}

test reallocate__preserves_content_and_keeps_the_guard {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }

    val a: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 4);
    if (sel a.err) {
        dnit(?t);
        ret 2;
    }
    val p: *u8 = a.ok;
    p[0] = 1;
    p[1] = 2;
    p[2] = 3;
    p[3] = 4;

    val g: res[*u8, allocator.Error] = allocator.reallocate[u8](?t.a, p, 4, 16);
    if (sel g.err) {
        dnit(?t);
        ret 3;
    }
    val q: *u8 = g.ok;
    if (q[0] != 1 || q[1] != 2 || q[2] != 3 || q[3] != 4) {
        dnit(?t);
        ret 4;
    }

    val ps: usize = os.page_size();
    if (((q::usize) + 16) % ps != 0) {
        dnit(?t);
        ret 5;
    }

    # the old block was handed back as part of the move
    if (live_count(?t) != 1) {
        dnit(?t);
        ret 6;
    }

    dnit(?t);
    ret 0;
}

# an empty request succeeds without asking the backend, and releasing nothing
# is a success too: neither is a refusal and neither counts as an attempt
test contract__empty_success_is_ok_with_nil_and_no_attempt {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }
    fail_at_ordinal(?t, 1);

    val empty: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 0);
    if (!sel empty.ok) {
        dnit(?t);
        ret 2;
    }
    if (empty.ok != nil) {
        dnit(?t);
        ret 3;
    }
    if (attempt_count(?t) != 0) {
        dnit(?t);
        ret 4;
    }

    val none: err[allocator.Error] = allocator.deallocate[u8](?t.a, nil::*u8, 8);
    if (!sel none.ok) {
        dnit(?t);
        ret 5;
    }
    val zero: err[allocator.Error] = allocator.deallocate[u8](?t.a, empty.ok, 0);
    if (!sel zero.ok) {
        dnit(?t);
        ret 6;
    }
    if (double_free_count(?t) != 0) {
        dnit(?t);
        ret 7;
    }
    dnit(?t);
    ret 0;
}

# a byte count that does not fit usize is refused as `overflow` before the
# backend is asked, so it is distinct from the backend running out
test contract__overflow_is_reported_before_the_backend_is_asked {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }

    val big: res[*u64, allocator.Error] = allocator.allocate[u64](?t.a, ~(0::usize));
    if (!sel big.err) {
        dnit(?t);
        ret 2;
    }
    if (!sel big.err.overflow) {
        dnit(?t);
        ret 3;
    }
    if (attempt_count(?t) != 0) {
        dnit(?t);
        ret 4;
    }

    var p:     [1]u64;
    val grown: res[*u64, allocator.Error] = allocator.reallocate[u64](?t.a, ?p[0], 1, ~(0::usize));
    if (!sel grown.err) {
        dnit(?t);
        ret 5;
    }
    if (!sel grown.err.overflow) {
        dnit(?t);
        ret 6;
    }
    if (attempt_count(?t) != 0) {
        dnit(?t);
        ret 7;
    }
    dnit(?t);
    ret 0;
}

# a nil allocator is invalid use, and it is reported as such rather than as
# exhaustion, on every entry point that takes one
test contract__a_nil_allocator_is_invalid_use {
    val a: res[*u8, allocator.Error] = allocator.allocate[u8](nil, 8);
    if (!sel a.err)         { ret 1; }
    if (!sel a.err.invalid) { ret 2; }

    val z: res[*u8, allocator.Error] = allocator.zallocate[u8](nil, 8);
    if (!sel z.err)         { ret 3; }
    if (!sel z.err.invalid) { ret 4; }

    var buf: [8]u8;
    val g:   res[*u8, allocator.Error] = allocator.reallocate[u8](nil, ?buf[0], 8, 16);
    if (!sel g.err)         { ret 5; }
    if (!sel g.err.invalid) { ret 6; }

    val d: err[allocator.Error] = allocator.deallocate[u8](nil, ?buf[0], 8);
    if (!sel d.err)         { ret 7; }
    if (!sel d.err.invalid) { ret 8; }

    val raw: res[ptr, allocator.Error] = allocator.allocate_raw(nil, 8, 1);
    if (!sel raw.err)         { ret 9; }
    if (!sel raw.err.invalid) { ret 10; }

    val raw_free: err[allocator.Error] = allocator.deallocate_raw(nil, ?buf[0], 8, 1);
    if (!sel raw_free.err)         { ret 11; }
    if (!sel raw_free.err.invalid) { ret 12; }
    ret 0;
}

# an alignment that is zero or not a power of two is invalid use, refused
# before the backend is asked
test contract__a_bad_alignment_is_invalid_use {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }

    val zero: res[ptr, allocator.Error] = allocator.allocate_raw(?t.a, 8, 0);
    if (!sel zero.err) {
        dnit(?t);
        ret 2;
    }
    if (!sel zero.err.invalid) {
        dnit(?t);
        ret 3;
    }

    val odd: res[ptr, allocator.Error] = allocator.allocate_raw(?t.a, 8, 12);
    if (!sel odd.err) {
        dnit(?t);
        ret 4;
    }
    if (!sel odd.err.invalid) {
        dnit(?t);
        ret 5;
    }

    var buf:   [8]u8;
    val grown: res[ptr, allocator.Error] = allocator.reallocate_raw(?t.a, (?buf[0])::ptr, 8, 16, 3);
    if (!sel grown.err) {
        dnit(?t);
        ret 6;
    }
    if (!sel grown.err.invalid) {
        dnit(?t);
        ret 7;
    }
    if (attempt_count(?t) != 0) {
        dnit(?t);
        ret 8;
    }

    val fine: res[ptr, allocator.Error] = allocator.allocate_raw(?t.a, 16, 16);
    if (!sel fine.ok) {
        dnit(?t);
        ret 9;
    }
    if ((fine.ok::usize % 16) != 0) {
        dnit(?t);
        ret 10;
    }
    allocator.deallocate_raw(?t.a, fine.ok, 16, 16);
    if (leaked(?t)) {
        dnit(?t);
        ret 11;
    }
    dnit(?t);
    ret 0;
}

# a release the backend refuses carries the backend's status in the `release`
# payload, so a double free is observable as the cause and not as a plain false
test contract__a_failed_release_carries_the_backend_status {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }

    val a: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 16);
    if (sel a.err) {
        dnit(?t);
        ret 2;
    }

    val first: err[allocator.Error] = allocator.deallocate[u8](?t.a, a.ok, 16);
    if (!sel first.ok) {
        dnit(?t);
        ret 3;
    }

    val again: err[allocator.Error] = allocator.deallocate[u8](?t.a, a.ok, 16);
    if (!sel again.err) {
        dnit(?t);
        ret 4;
    }
    if (!sel again.err.release) {
        dnit(?t);
        ret 5;
    }
    if (again.err.release != -1) {
        dnit(?t);
        ret 6;
    }
    if (double_free_count(?t) != 1) {
        dnit(?t);
        ret 7;
    }

    # reallocating to zero is a release, and reports the same way
    val shrink: res[*u8, allocator.Error] = allocator.reallocate[u8](?t.a, a.ok, 16, 0);
    if (!sel shrink.err) {
        dnit(?t);
        ret 8;
    }
    if (!sel shrink.err.release) {
        dnit(?t);
        ret 9;
    }
    dnit(?t);
    ret 0;
}

# zallocate is allocate followed by a fill, so its refusal is the same value
# allocate produced and nothing is left live behind it
test contract__zallocate_refuses_exactly_as_allocate_does {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }
    fail_at_ordinal(?t, 1);

    val refused: res[*u32, allocator.Error] = allocator.zallocate[u32](?t.a, 4);
    if (!sel refused.err) {
        dnit(?t);
        ret 2;
    }
    if (!sel refused.err.exhausted) {
        dnit(?t);
        ret 3;
    }
    if (live_count(?t) != 0) {
        dnit(?t);
        ret 4;
    }

    val served: res[*u32, allocator.Error] = allocator.zallocate[u32](?t.a, 4);
    if (!sel served.ok) {
        dnit(?t);
        ret 5;
    }
    var i: usize = 0;
    for (i < 4) {
        if (served.ok[i] != 0) {
            dnit(?t);
            ret 6;
        }
        i = i + 1;
    }
    allocator.deallocate[u32](?t.a, served.ok, 4);
    if (leaked(?t)) {
        dnit(?t);
        ret 7;
    }
    dnit(?t);
    ret 0;
}

test fail_from_ordinal__keeps_refusing_until_cleared {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }
    fin { dnit(?t); }
    fail_from_ordinal(?t, 2);
    val first: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel first.err) { ret 2; }
    val second: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    val third:  res[*u8, allocator.Error] = allocator.reallocate[u8](?t.a, first.ok, 8, 16);
    if (sel second.ok || sel third.ok)                         { ret 3; }
    if (refused_count(?t) != 2 || last_request_size(?t) != 16) { ret 4; }
    clear_failure(?t);
    val fourth: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel fourth.err) { ret 5; }
    allocator.deallocate[u8](?t.a, first.ok, 8);
    allocator.deallocate[u8](?t.a, fourth.ok, 8);
    if (!clean(?t)) { ret 6; }
    ret 0;
}

test fail_from_ordinal__one_refuses_everything_and_counts_it {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }
    fail_from_ordinal(?t, 1);
    val got: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel got.ok) { ret 2; }
    val grown: res[*u8, allocator.Error] = allocator.reallocate[u8](?t.a, nil, 0, 8);
    if (sel grown.ok)                                     { ret 3; }
    if (attempt_count(?t) != 2 || refused_count(?t) != 2) { ret 4; }
    if (total_count(?t) != 0)                             { ret 5; }
    ret 0;
}

test size_mismatch__a_release_at_another_size_is_counted {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }
    fin { dnit(?t); }
    val a: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 24);
    if (sel a.err)            { ret 2; }
    if (!owns(?t, a.ok::ptr)) { ret 3; }
    if (owns(?t, (?t)::ptr))  { ret 3; }
    val g: res[*u8, allocator.Error] = allocator.reallocate[u8](?t.a, a.ok, 16, 40);
    if (sel g.err)                                                 { ret 4; }
    if (size_mismatch_count(?t) != 1 || live_byte_count(?t) != 40) { ret 5; }
    if (owns(?t, a.ok::ptr))                                       { ret 6; }
    allocator.deallocate[u8](?t.a, g.ok, 32);
    if (size_mismatch_count(?t) != 2 || leaked(?t)) { ret 7; }
    if (clean(?t))                                  { ret 8; }
    ret 0;
}

rec Walked {
    depth: usize;
}

fun t_walked(w: *Walked, t: *Testing) i32 {
    val a:       *allocator.Allocator      = allocator_of(t);
    val fixture: res[*u8, allocator.Error] = allocator.allocate[u8](a, 16);
    if (sel fixture.err) { ret 1; }
    arm(t);
    var held:       [4]*u64;
    var n:          usize = 0;
    var refused_at: usize = 0;
    for (n < w.depth) {
        val got: res[*u64, allocator.Error] = allocator.allocate[u64](a, 1);
        if (sel got.err) {
            if (!sel got.err.exhausted) { ret 2; }
            refused_at = n + 1;
            brk;
        }
        held[n] = got.ok;
        n       = n + 1;
    }
    var k: usize = 0;
    for (k < n) {
        allocator.deallocate[u64](a, held[k], 1);
        k = k + 1;
    }
    allocator.deallocate[u8](a, fixture.ok, 16);
    if (t.ordinal == 0 && refused_at != 0)         { ret 3; }
    if (t.ordinal != 0 && refused_at != t.ordinal) { ret 4; }
    ret 0;
}

test walk__refuses_each_ordinal_after_the_arm_point {
    var w:   Walked  = Walked{depth: 4};
    val out: Outcome = walk[Walked](?w, t_walked);
    if (out.code != 0 || out.ordinal != 0) { ret 1; }
    if (out.attempts != 4)                 { ret 2; }
    ret 0;
}

fun t_leaky(w: *Walked, t: *Testing) i32 {
    arm(t);
    val got: res[*u64, allocator.Error] = allocator.allocate[u64](allocator_of(t), 1);
    if (sel got.err)  { ret 0; }
    if (w.depth == 0) { allocator.deallocate[u64](allocator_of(t), got.ok, 1); }
    ret 0;
}

fun t_nothing(w: *Walked, t: *Testing) i32 {
    arm(t);
    ret 0;
}

test walk__reports_a_leak_and_a_nonallocating_attempt {
    var leaky: Walked  = Walked{depth: 1};
    val leak:  Outcome = walk[Walked](?leaky, t_leaky);
    if (leak.code != WALK_LEAK || leak.ordinal != 0) { ret 1; }
    var quiet: Walked  = Walked{depth: 0};
    val none:  Outcome = walk[Walked](?quiet, t_nothing);
    if (none.code != WALK_NONALLOCATING) { ret 2; }
    ret 0;
}

test refuse_reallocates__refuses_growth_and_records_what_it_named {
    var t:  Testing;
    val mr: err[allocator.Error] = make(?t);
    if (sel mr.err) { ret 1; }
    fin { dnit(?t); }
    val a: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel a.err) { ret 2; }
    refuse_reallocates(?t, true);
    val g: res[*u8, allocator.Error] = allocator.reallocate[u8](?t.a, a.ok, 8, 24);
    if (sel g.ok)                                                    { ret 3; }
    if (reallocate_count(?t) != 1 || refused_count(?t) != 1)         { ret 4; }
    if (last_reallocated(?t) != a.ok::ptr || last_old_size(?t) != 8) { ret 5; }
    val b: res[*u8, allocator.Error] = allocator.allocate[u8](?t.a, 8);
    if (sel b.err)                                       { ret 6; }
    if (live_count(?t) != 2 || peak_live_count(?t) != 2) { ret 7; }
    refuse_reallocates(?t, false);
    val h: res[*u8, allocator.Error] = allocator.reallocate[u8](?t.a, b.ok, 8, 16);
    if (sel h.err)                                                      { ret 8; }
    if (reallocate_count(?t) != 2 || last_reallocated(?t) != b.ok::ptr) { ret 9; }
    if (peak_live_count(?t) != 3)                                       { ret 10; }
    allocator.deallocate[u8](?t.a, a.ok, 8);
    allocator.deallocate[u8](?t.a, h.ok, 16);
    if (!clean(?t) || peak_live_count(?t) != 3) { ret 11; }
    ret 0;
}
