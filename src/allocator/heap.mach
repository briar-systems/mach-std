# general-purpose size-class heap
#
# small requests are rounded up to a size class and carved from a span that
# serves that one class. every span keeps its own free list, so a release is
# a push and an acquire is a pop. a span that runs empty goes back to a cache
# shared by all classes, which is what lets a class give memory back to
# another class. requests above the largest class get a span of their own.
#
# the backing memory comes from a `Source`, a two-call contract the core never
# looks past. the native member maps and unmaps, and on wasi, whose linear memory
# only grows, the OS layer keeps what is unmapped for the next map. a member that
# cannot take memory back leaves `fn_release` nil and the core retains spans
# instead of returning them. the core never assumes memory can come back.
#
# a Heap is safe to share between threads: one lock covers the core. a heap
# one thread owns, as one per unit of work, takes the allocator `allocator_owned`
# wires, which takes no lock.
#
# a thread std started keeps a cache of small blocks for each heap it uses
# through the allocator `allocator` wires, up to BOUND heaps at once, so most of
# its requests and releases there take no lock: a class it has no block of is
# refilled with a batch under one lock, and a class it holds too many of gives a
# batch back. the cache goes back to its heap when the thread ends
# (thread.at_exit), when the thread binds more heaps than it keeps caches for,
# and when the heap is torn down. a thread std did not start takes the lock
# every time, since nothing would give its cache back when it ends, and until
# std has started a thread (thread.any_started) no request reads the thread's
# bindings at all, so a process that never spawns touches no thread-local. a block a
# cache holds counts as live, and a release is checked against its span as it
# would be under the lock.
#
# it satisfies the std.allocator interface, so it drops in wherever an Allocator
# is taken:
#
#   var src: heap.Source;
#   var h:   heap.Heap;
#   var a:   allocator.Allocator;
#   heap.native_source(?src);
#   heap.init(?h, ?src, 0);
#   heap.allocator(?a, ?h);
#
# requests up to MAX_SMALL (8 KiB) round to one of 32 classes carved from
# 64 KiB spans. a larger request gets a span of its own, from its size up to
# that rounded to 64 KiB, the address range the span takes in any case.
#
# alignment is honoured for every request. a small request aligned beyond 16
# bytes is served by the first class that is a multiple of it, and one aligned
# beyond a span is placed by address in a span of its own. a resize stays in
# place while the block still holds the request and uses at least half of it,
# and otherwise moves to the right class and copies the overlap.
#
# zallocate_raw skips zeroing for a block carved from a region the source
# delivered zero-filled, and zeroes anything reused.
#
# native_source maps through the platform, allocator_source draws spans from
# another Allocator, and region_source carves them from one region of memory the
# program states, which is the source on a target with no page mapper:
#
#   var r: heap.Region;
#   heap.region_source(?src, ?r, base, len);
#
# a program that makes one heap after another, each torn down whole, gives
# them a Pool to share: pool_source draws spans from it and gives them back to
# it, so the next heap is handed the spans the last one used. the program states
# how many bytes the pool may hold:
#
#   var pool: heap.Pool;
#   heap.pool_init(?pool, ?src, budget);
#   heap.pool_source(?pooled, ?pool);
#   heap.init(?h, ?pooled, 0);
#
# native_source is only on a target with the pages capability. init's budget bounds the retained empty spans. a heap
# over a source that cannot release keeps them past the budget, because there
# is nowhere else for them to go, and one whose release is refused is kept too,
# so dnit tries it again and reports the failure. allocator_source makes that choice once: over
# a backing that does not reclaim it leaves fn_release nil, so the heap keeps
# every span it obtained and reuses it, and mapped_bytes still counts them
# after dnit because the backing never took them back.
#
# the span header, not the caller's arguments, decides a block's class. a size
# larger than the block's class is refused. releasing a pointer this heap never
# handed out is refused as allocator.Error.release(-22): the heap checks that
# the address starts a block in a span it owns, so another heap's pointer, an
# interior address or a span header is rejected without disturbing the heap.
# this is detection, not a guarantee: a pointer into an unrelated mapping can
# fault when the heap probes for a span header, as with any allocator. check
# walks every span and verifies the heap's own invariants.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.memory;
use std.sync.atomic;
use std.sync.mutex;
use std.system.capability;

$if (capability.HAS_PAGES) {
    use std.system.os;
}

$if (capability.HAS_THREADS) {
    use std.sync.thread;
}

$if (capability.HAS_PAGES && capability.HAS_THREADS) {
    #[testing]
    use std.allocator.fixed;
    use std.allocator.page;
    #[testing]
    use std.allocator.testing;
}

# where a heap's backing memory comes from
#
# fn_obtain(ctx, least, most) returns a span of `least` to `most` bytes at an
# address that is a multiple of SPAN_ALIGN, zero-filled unless the source is
# `stale`, and the size it granted. every granted byte is the holder's to use.
# `least` and `most` are always multiples of the host page size, or of
# PAGE_FLOOR on a target with no pages, and `least` is never above `most`.
#
# fn_release(ctx, span, size) returns a span obtained earlier, at the size it
# was granted, 0 on success or a negative backend native code. it is nil for a
# source that cannot return memory; the core then retains every span for reuse
# and never calls it. a source that `cuts` also takes a granted span back in
# pieces cut at multiples of SPAN_ALIGN from its base, each piece on its own.
# ---
# ctx:        opaque context passed to both callbacks
# fn_obtain:  acquire a span, or none when the source is exhausted
# fn_release: return a span, or nil when the source cannot reclaim
# stale:      a span it gives may hold what was written to it before
# cuts:       a span it gives may come back in pieces
pub rec Source {
    ctx:        ptr;
    fn_obtain:  fun(ptr, usize, usize) opt[Grant];
    fn_release: fun(ptr, ptr, usize) i64;
    stale:      bool;
    cuts:       bool;
}

# a span a source granted
# ---
# base: its first byte, a multiple of SPAN_ALIGN
# size: the bytes it holds, from the least to the most asked for
pub rec Grant {
    base: ptr;
    size: usize;
}

# number of small size classes
pub val CLASS_COUNT: usize = 32;

# largest request served from a size class
pub val MAX_SMALL: usize = 8192;

# span size for size-class spans, and the address granularity of every span
pub val SPAN_SIZE:  usize = 65536;
pub val SPAN_ALIGN: usize = 65536;

# default byte budget for retained empty spans
pub val DEFAULT_CACHE: usize = 4194304;

# the granule a span's size rounds to on a target with no host page size
pub val PAGE_FLOOR: usize = 4096;

# class index reserved for a block that owns its span
val CLASS_LARGE: usize = 32;

# a block that owns its span asks the source for one up to an eighth larger
# than it needs, or up to its size rounded to SPAN_ALIGN when that is more, the
# address range its span takes in any case, and every byte it is granted is the
# block's capacity
val LARGE_SPARE_SHIFT: usize = 3;

# alignment every size class satisfies without being widened
val MIN_ALIGN: usize = 16;

# "HEAPSN01", or "HEAP" where a word holds four bytes
$if ($mach.build.pointer_width == 8) {
    val SPAN_MAGIC: usize = 0x48454150534E3031;
}
$or {
    val SPAN_MAGIC: usize = 0x48454150;
}

# status returned for a pointer this heap did not hand out
val EINVAL: i64 = -22;

val CLASS_SIZE: [32]usize = [32]usize{
    16, 32, 48, 64, 80, 96, 112, 128,
    160, 192, 224, 256, 320, 384, 448, 512,
    640, 768, 896, 1024, 1280, 1536, 1792, 2048,
    2560, 3072, 3584, 4096, 5120, 6144, 7168, 8192
};

# header at the base of every span
#
# the header is the span's identity: the class it serves, the blocks handed
# out of it and the free list of blocks returned to it. a small block's span
# is found by masking its address down to SPAN_ALIGN, so the header is the one
# authority on a block's class and `size` arguments are only cross-checked
# against it.
# ---
# magic:  SPAN_MAGIC once initialized
# owner:  heap the span belongs to
# class:  size class index, or CLASS_LARGE for a span holding one block
# size:   the span bytes the heap uses: the least it asked the source for,
#         never more, so what it does and counts depends on its own requests
#         alone and not on how much larger a span a source granted
# grant:  the span bytes the source granted, given back whole
# data:   offset of the first block
# cap:    block count for a class span, payload bytes for a large span
# used:   live blocks
# bump:   offset past the last block ever carved
# free:   head of the intrusive free list of returned blocks
# zeroed: the region past `bump` is still as the source delivered it
# next:   next span in whichever list holds it
# prev:   previous span in whichever list holds it
rec Span {
    magic:  usize;
    owner:  ptr;
    class:  usize;
    size:   usize;
    grant:  usize;
    data:   usize;
    cap:    usize;
    used:   usize;
    bump:   usize;
    free:   ptr;
    zeroed: usize;
    next:   *Span;
    prev:   *Span;
}

# size-class heap state
#
# `partial` holds spans of a class with a block to give, `full` the rest.
# `spans` caches empty class spans for any class, `cache` freed large spans,
# and `large` and `huge` track live spans that own a single block. a heap is
# initialized once and then shared; every field below is under `lock`.
# ---
# src:          span source
# lock:         covers the whole core
# partial:      per class, spans with a free block
# full:         per class, spans with none
# spans:        empty class spans held for reuse
# cache:        freed large spans held for reuse
# large:        live spans holding one block reachable by address masking
# huge:         live spans holding one block aligned at or past SPAN_ALIGN
# held:         bytes in `spans` and `cache`
# budget:       byte ceiling for `held` before a span is handed back to the source
# live:         bytes in live blocks, counted as class size or payload capacity
# mapped:       bytes of the spans obtained from the source and not yet
#               released, each counted at the size the heap uses
# peak:         high water mark of `mapped`
# blocks:       live block count
# total_blocks: blocks handed out over the heap's life, never decremented
# total_bytes:  bytes charged for them, counted as `live` counts and never decremented
# idx_small:    class index for each 16 byte step of a size up to 1024
# idx_mid:      class index for each 128 byte step of a size up to MAX_SMALL
# id:           the heap's identity, never shared with another heap of the process
# caches:       the thread caches bound to the heap
# spare:        cache records given back, for the next thread that binds
# records:      the span cache records are carved from, nil before the first
# carved:       records carved from it
pub rec Heap {
    src:  Source;
    lock: mutex.Mutex;

    partial: [32]*Span;
    full:    [32]*Span;

    spans: *Span;
    cache: *Span;
    large: *Span;
    huge:  *Span;

    held:   usize;
    budget: usize;

    live:   usize;
    mapped: usize;
    peak:   usize;
    blocks: usize;

    total_blocks: usize;
    total_bytes:  usize;

    idx_small: [64]u8;
    idx_mid:   [64]u8;

    id:      usize;
    caches:  *Cache;
    spare:   *Cache;
    records: *Span;
    carved:  usize;
}

# the small blocks one thread holds of one heap, carved from the heap's record span
# ---
# heap:   the heap the blocks belong to
# slot:   the binding of the thread that holds it
# next:   the record after it among the heap's caches or its spare records
# prev:   the record before it among the heap's caches
# heads:  per class, the blocks held, linked through their first word
# counts: per class, how many are held
rec Cache {
    heap:   *Heap;
    slot:   *Binding;
    next:   *Cache;
    prev:   *Cache;
    heads:  [32]ptr;
    counts: [32]u32;
}

# a thread's cache for one heap, or an empty binding for id 0. a binding with no
# cache marks a heap the thread found it could not cache for
# ---
# id:    the heap's identity
# cache: the thread's cache of it
rec Binding {
    id:    usize;
    cache: *Cache;
}

# the identity the last heap initialized took
var heap_ids: usize;

# the most shared heaps a thread keeps a cache for at once
val BOUND: usize = 4;

# a cache holds a batch of a class's blocks of about CACHE_BATCH_BYTES, at least
# two and at most CACHE_BATCH_MOST blocks, and gives a batch back at twice that
val CACHE_BATCH_BYTES: usize = 16384;
val CACHE_BATCH_MOST:  usize = 32;

$if (capability.HAS_THREADS) {
    # the calling thread's caches
    #[thread]
    var bound: [4]Binding;

    # serializes binding, unbinding and a heap's teardown detaching its caches,
    # since a teardown writes the bindings of the threads whose caches it drops
    var bind_lock: mutex.Mutex;

    # 0 before the first binding, 1 once caches_end is an exit routine, 2 when it
    # could not be registered and no thread caches. under bind_lock
    var exits_hooked: u8;
}

# the granule a span's size rounds to: the host page, or PAGE_FLOOR on a target
# with no pages
fun granule() usize {
    $if (capability.HAS_PAGES) {
        ret os.page_size();
    }
    $or {
        ret PAGE_FLOOR;
    }
}

fun align_up(value: usize, align: usize) usize {
    val mask: usize = align - 1;
    ret (value + mask) & ~mask;
}

# the largest power of two dividing a class size, which is the alignment every
# block of that class carries once the first block starts there
fun granularity(size: usize) usize {
    ret size & (0 - size);
}

fun span_header_size() usize {
    ret align_up($size_of(Span), 64);
}

# offset of the first block of a class span
fun class_data_offset(class_size: usize) usize {
    ret align_up(span_header_size(), granularity(class_size));
}

# the span a block belongs to, for every block whose alignment is below
# SPAN_ALIGN
fun span_of(p: ptr) *Span {
    ret ((p::usize) & ~(SPAN_ALIGN - 1))::*Span;
}

fun list_push(head: **Span, s: *Span) {
    s.prev = nil;
    s.next = @head;
    if (@head != nil) { (@head).prev = s; }
    @head = s;
}

fun list_remove(head: **Span, s: *Span) {
    if (s.prev != nil) { s.prev.next = s.next; }
    or                 { @head = s.next; }
    if (s.next != nil) { s.next.prev = s.prev; }
    s.next = nil;
    s.prev = nil;
}

# smallest class index that serves `size` bytes at `align`, or CLASS_LARGE
fun class_of(h: *Heap, size: usize, align: usize) usize {
    if (size > MAX_SMALL) { ret CLASS_LARGE; }

    var c: usize = 0;
    if (size <= 1024) { c = h.idx_small[(size - 1) >> 4]::usize; }
    or                { c = h.idx_mid[(size - 1) >> 7]::usize; }

    # a class serves an alignment only when its size is a multiple of it, since
    # blocks sit at multiples of the class size from an aligned span base
    if (align > MIN_ALIGN) {
        for (c < CLASS_COUNT && (CLASS_SIZE[c] & (align - 1)) != 0) { c = c + 1; }
        if (c >= CLASS_COUNT) { ret CLASS_LARGE; }
    }

    ret c;
}

# a span of `least` to `most` bytes, of which the heap uses `least`
fun obtain(h: *Heap, least: usize, most: usize) *Span {
    if (h.src.fn_obtain == nil) { ret nil; }

    val opt_granted: opt[Grant] = h.src.fn_obtain(h.src.ctx, least, most);
    if (!sel opt_granted.some) { ret nil; }

    # the base is the contract the small-block lookup is built on, and the size
    # the one a class span's geometry is, so a span that breaks either is
    # handed straight back and the request refused
    val g:    Grant = opt_granted.some;
    val size: usize = g.size;
    if ((g.base::usize & (SPAN_ALIGN - 1)) != 0 || size < least || size > most) {
        if (h.src.fn_release != nil) { h.src.fn_release(h.src.ctx, g.base, size); }
        ret nil;
    }

    val s: *Span = g.base::*Span;
    s.magic  = SPAN_MAGIC;
    s.owner  = h::ptr;
    s.size   = least;
    s.grant  = size;
    s.zeroed = 1;
    if (h.src.stale) { s.zeroed = 0; }
    s.free = nil;
    s.used = 0;
    s.next = nil;
    s.prev = nil;

    h.mapped = h.mapped + least;
    if (h.mapped > h.peak) { h.peak = h.mapped; }

    ret s;
}

# hand a span back to the source, or keep it when the source cannot reclaim
fun release(h: *Heap, s: *Span) i64 {
    if (h.src.fn_release == nil) { ret 0; }

    # a source may write over the header once it holds the span
    val size: usize = s.size;
    s.magic = 0;
    val code: i64 = h.src.fn_release(h.src.ctx, s::ptr, s.grant);
    if (code != 0) {
        s.magic = SPAN_MAGIC;
        ret code;
    }

    h.mapped = h.mapped - size;
    ret 0;
}

# whether a retired span went back to the source: only once the cache is over
# budget, and never when the source cannot reclaim or refuses
fun retire_released(h: *Heap, s: *Span) bool {
    if (h.held + s.size <= h.budget || h.src.fn_release == nil) { ret false; }
    ret release(h, s) == 0;
}

# retire an empty class span: give it back once the cache is over budget, else
# hold it for any class. a span the source cannot reclaim or refuses is held
# past the budget, so dnit still releases it and reports a failure there.
fun retire_span(h: *Heap, s: *Span) {
    if (retire_released(h, s)) { ret; }

    s.used   = 0;
    s.free   = nil;
    s.bump   = 0;
    s.zeroed = 0;
    list_push(?h.spans, s);
    h.held = h.held + s.size;
}

# retire a large span the same way, keyed by its own size
fun retire_large(h: *Heap, s: *Span) {
    if (retire_released(h, s)) { ret; }

    s.used   = 0;
    s.zeroed = 0;
    list_push(?h.cache, s);
    h.held = h.held + s.size;
}

# a fresh span for a class, from the cache when one is held
fun span_for_class(h: *Heap, c: usize) *Span {
    val class_size: usize = CLASS_SIZE[c];

    var s: *Span = h.spans;
    if (s != nil) {
        list_remove(?h.spans, s);
        h.held = h.held - s.size;
    }
    or {
        s = obtain(h, SPAN_SIZE, SPAN_SIZE);
        if (s == nil) { ret nil; }
    }

    s.class = c;
    s.data  = class_data_offset(class_size);
    s.cap   = (s.size - s.data) / class_size;
    s.used  = 0;
    s.bump  = s.data;
    s.free  = nil;

    list_push(?h.partial[c], s);
    ret s;
}

# take one block of class c, reporting whether it is still source-zeroed
fun take_small(h: *Heap, c: usize, zeroed: *bool) ptr {
    var s: *Span = h.partial[c];
    if (s == nil) {
        s = span_for_class(h, c);
        if (s == nil) { ret nil; }
    }

    val class_size: usize = CLASS_SIZE[c];
    var p:          ptr   = nil;

    if (s.free != nil) {
        p       = s.free;
        s.free  = (@(p::*usize))::ptr;
        @zeroed = false;
    }
    or {
        p       = (s::usize + s.bump)::ptr;
        s.bump  = s.bump + class_size;
        @zeroed = s.zeroed != 0;
    }

    s.used = s.used + 1;
    if (s.used == s.cap) {
        list_remove(?h.partial[c], s);
        list_push(?h.full[c], s);
    }

    h.live         = h.live + class_size;
    h.blocks       = h.blocks + 1;
    h.total_blocks = h.total_blocks + 1;
    h.total_bytes  = h.total_bytes + class_size;
    ret p;
}

# take a span holding a single block of `size` bytes at `align`
fun take_large(h: *Heap, size: usize, align: usize, zeroed: *bool) ptr {
    var want: usize = align;
    if (want < MIN_ALIGN) { want = MIN_ALIGN; }

    val page: usize = granule();

    # the source promises a base at SPAN_ALIGN and the header is smaller
    # than that, so a payload offset of at most `want` always fits, for an
    # alignment above SPAN_ALIGN too
    val head: usize = align_up(span_header_size(), want);

    # refuse a request whose span geometry would wrap usize
    if (head < want)              { ret nil; }
    if (size > (0 - head) - page) { ret nil; }

    val total: usize = align_up(head + size, page);
    var data:  usize = head;

    var spare: usize = (total >> LARGE_SPARE_SHIFT) & ~(page - 1);
    if (spare > ~(0::usize) - total) { spare = 0; }
    var most: usize = total + spare;
    if (total <= ~(0::usize) - SPAN_ALIGN) {
        val slot: usize = align_up(total, SPAN_ALIGN);
        if (slot > most) { most = slot; }
    }

    var s: *Span = nil;

    # reuse a cached span when the block fits and does not waste half of it
    if (want < SPAN_ALIGN) {
        var c: *Span = h.cache;
        for (c != nil) {
            if (c.size >= total && total * 2 >= c.size) {
                list_remove(?h.cache, c);
                h.held = h.held - c.size;
                s      = c;
                brk;
            }
            c = c.next;
        }
    }

    if (s == nil) {
        s = obtain(h, total, most);
        if (s == nil) { ret nil; }
        @zeroed = !h.src.stale;
    }
    or {
        @zeroed = false;
    }

    # the payload is placed by address, since only the span base is promised
    # aligned and an over-aligned block needs more than that
    if (want > SPAN_ALIGN) {
        data = align_up(s::usize + span_header_size(), want) - s::usize;
    }

    s.class = CLASS_LARGE;
    s.data  = data;
    s.cap   = s.size - data;
    s.used  = 1;
    s.bump  = s.size;
    s.free  = nil;

    if (want >= SPAN_ALIGN) { list_push(?h.huge, s); }
    or                      { list_push(?h.large, s); }

    h.live         = h.live + s.cap;
    h.blocks       = h.blocks + 1;
    h.total_blocks = h.total_blocks + 1;
    h.total_bytes  = h.total_bytes + s.cap;
    ret (s::usize + data)::ptr;
}

# the span holding p, or nil when p is not a block of this heap
#
# alignment decides the lookup: a block aligned below SPAN_ALIGN is found by
# masking its address down to its span header, and one aligned at or above it
# masks down to its own payload, so those are tracked in a list instead.
fun find_span(h: *Heap, p: ptr, align: usize) *Span {
    if (align >= SPAN_ALIGN) {
        var s: *Span = h.huge;
        for (s != nil) {
            if ((s::usize + s.data)::ptr == p) { ret s; }
            s = s.next;
        }
        ret nil;
    }

    val s: *Span = span_of(p);
    if (s.magic != SPAN_MAGIC) { ret nil; }
    if (s.owner != h::ptr)     { ret nil; }
    ret s;
}

# 0 when p starts a live block of span s that `size` bytes fit, else EINVAL
fun check_block(s: *Span, p: ptr, size: usize) i64 {
    if (s.class == CLASS_LARGE) {
        if ((s::usize + s.data)::ptr != p) { ret EINVAL; }
        if (size > s.cap)                  { ret EINVAL; }
        ret 0;
    }

    val class_size: usize = CLASS_SIZE[s.class];
    val off:        usize = p::usize - s::usize;

    # the block must be one this span carved, not an interior address
    if (off < s.data || off >= s.bump)    { ret EINVAL; }
    if ((off - s.data) % class_size != 0) { ret EINVAL; }
    if (size > class_size)                { ret EINVAL; }
    if (s.used == 0)                      { ret EINVAL; }
    ret 0;
}

# release a block check_block accepted, unwinding the span when it runs empty
fun give_back(h: *Heap, s: *Span, p: ptr) {
    if (s.class == CLASS_LARGE) {
        if (s.data >= SPAN_ALIGN) { list_remove(?h.huge, s); }
        or                        { list_remove(?h.large, s); }

        h.live   = h.live - s.cap;
        h.blocks = h.blocks - 1;
        retire_large(h, s);
        ret;
    }

    val class_size: usize = CLASS_SIZE[s.class];

    @(p::*usize) = s.free::usize;
    s.free       = p;

    if (s.used == s.cap) {
        list_remove(?h.full[s.class], s);
        list_push(?h.partial[s.class], s);
    }
    s.used = s.used - 1;

    h.live   = h.live - class_size;
    h.blocks = h.blocks - 1;

    if (s.used == 0) {
        list_remove(?h.partial[s.class], s);
        retire_span(h, s);
    }
}

fun do_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }
    val h: *Heap = ctx::*Heap;
    $if (capability.HAS_THREADS) {
        if (size != 0 && size <= MAX_SMALL) {
            val c: usize = class_of(h, size, align);
            if (c != CLASS_LARGE) {
                val k: *Cache = cache_of(h);
                if (k != nil) { ret cached_take(h, k, c); }
            }
        }
    }
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret acquire(h, size, align);
}

fun owned_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }
    ret acquire(ctx::*Heap, size, align);
}

# acquire a block of `size` bytes at `align`, the lock held or the heap owned
fun acquire(h: *Heap, size: usize, align: usize) opt[ptr] {
    if (size == 0) { ret opt[ptr].some{nil}; }
    var zeroed: bool = false;
    val p:      ptr  = take(h, size, align, ?zeroed);
    if (p == nil) { ret opt[ptr].none{}; }
    ret opt[ptr].some{p};
}

# acquire a block of `size` bytes at `align`, the lock held or the heap owned
fun take(h: *Heap, size: usize, align: usize, zeroed: *bool) ptr {
    val c: usize = class_of(h, size, align);
    if (c == CLASS_LARGE) { ret take_large(h, size, align, zeroed); }
    ret take_small(h, c, zeroed);
}

fun do_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (ctx == nil) { ret EINVAL; }
    val h: *Heap = ctx::*Heap;
    $if (capability.HAS_THREADS) {
        if (p != nil && align < SPAN_ALIGN) {
            val k: *Cache = cache_of(h);
            if (k != nil) { ret cached_give(h, k, p, size, align); }
        }
    }
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret free_block(h, p, size, align);
}

fun owned_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (ctx == nil) { ret EINVAL; }
    ret free_block(ctx::*Heap, p, size, align);
}

# release a block, the lock held or the heap owned
fun free_block(h: *Heap, p: ptr, size: usize, align: usize) i64 {
    if (p == nil) { ret 0; }
    val s: *Span = find_span(h, p, align);
    if (s == nil) { ret EINVAL; }
    val code: i64 = check_block(s, p, size);
    if (code != 0) { ret code; }
    give_back(h, s, p);
    ret 0;
}

fun do_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }
    val h: *Heap = ctx::*Heap;
    $if (capability.HAS_THREADS) {
        if (p != nil && new_size != 0 && align < SPAN_ALIGN) {
            val k: *Cache = cache_of(h);
            if (k != nil) { ret cached_resize(h, k, p, old_size, new_size, align); }
        }
    }
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret resize(h, p, old_size, new_size, align);
}

fun owned_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }
    ret resize(ctx::*Heap, p, old_size, new_size, align);
}

# resize a block, the lock held or the heap owned
fun resize(h: *Heap, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (p == nil) { ret acquire(h, new_size, align); }

    val s: *Span = find_span(h, p, align);
    if (s == nil)                         { ret opt[ptr].none{}; }
    if (check_block(s, p, old_size) != 0) { ret opt[ptr].none{}; }

    # capacity of the block as its span sees it, which outranks old_size
    var room: usize = s.cap;
    if (s.class != CLASS_LARGE) { room = CLASS_SIZE[s.class]; }

    # in place while the request still fits and either keeps its class or
    # still uses half the block, so a caller that walks a size up and down
    # does not copy on every step
    val want: usize = class_of(h, new_size, align);
    if (new_size <= room) {
        val keeps: bool = s.class != CLASS_LARGE && want == s.class;
        if (keeps || new_size * 2 > room) { ret opt[ptr].some{p}; }
    }

    var zeroed: bool = false;
    val fresh:  ptr  = take(h, new_size, align, ?zeroed);
    if (fresh == nil) { ret opt[ptr].none{}; }

    var copy: usize = old_size;
    if (copy > room)     { copy = room; }
    if (new_size < copy) { copy = new_size; }
    memory.raw_copy(fresh, p, copy);
    give_back(h, s, p);

    ret opt[ptr].some{fresh};
}

$if (capability.HAS_THREADS) {
    # the blocks of a class a cache takes or gives back at once
    fun cache_batch(c: usize) usize {
        val n: usize = CACHE_BATCH_BYTES / CLASS_SIZE[c];
        if (n < 2)                { ret 2; }
        if (n > CACHE_BATCH_MOST) { ret CACHE_BATCH_MOST; }
        ret n;
    }

    # the calling thread's cache of h, bound on its first use, or nil when the
    # thread does not cache h. only a thread std started caches, so before std
    # has started one the bindings are not read at all
    fun cache_of(h: *Heap) *Cache {
        if (!thread.any_started()) { ret nil; }
        var i: usize = 0;
        for (i < BOUND) {
            if (bound[i].id == h.id) { ret bound[i].cache; }
            i = i + 1;
        }
        if (!thread.runs_at_exit()) { ret nil; }
        ret cache_bind(h);
    }

    # bind a cache of h to the calling thread, giving up its last binding when
    # every one is taken. a heap the thread cannot cache for is bound with no cache,
    # so the thread does not ask again
    fun cache_bind(h: *Heap) *Cache {
        mutex.lock(?bind_lock);
        fin { mutex.unlock(?bind_lock); }

        if (exits_hooked == 0) {
            exits_hooked = 2;
            if (thread.at_exit(caches_end)) { exits_hooked = 1; }
        }

        var i: usize = 0;
        for (i < BOUND && bound[i].id != 0) { i = i + 1; }
        if (i == BOUND) {
            i = BOUND - 1;
            cache_unbind(?bound[i]);
        }

        var k: *Cache = nil;
        if (exits_hooked == 1) {
            mutex.lock(?h.lock);
            k = record_take(h);
            if (k != nil) {
                k.heap = h;
                k.slot = ?bound[i];
                k.prev = nil;
                k.next = h.caches;
                if (k.next != nil) { k.next.prev = k; }
                h.caches = k;
            }
            mutex.unlock(?h.lock);
        }
        bound[i] = Binding{id: h.id, cache: k};
        ret k;
    }

    # a cache record of h, empty, from its spare records or carved from its record
    # span, or nil when there is none. under h's lock
    fun record_take(h: *Heap) *Cache {
        var k: *Cache = h.spare;
        if (k != nil) {
            h.spare = k.next;
        }
        or {
            val step: usize = align_up($size_of(Cache), 64);
            if (h.records == nil) {
                h.records = obtain(h, SPAN_SIZE, SPAN_SIZE);
                if (h.records == nil) { ret nil; }
                # no block lookup may take the record span for a span of blocks
                h.records.magic = 0;
                h.carved        = 0;
            }
            val at: usize = span_header_size() + h.carved * step;
            if (at + step > h.records.size) { ret nil; }
            h.carved = h.carved + 1;
            k        = (h.records::usize + at)::*Cache;
        }
        var c: usize = 0;
        for (c < CLASS_COUNT) {
            k.heads[c]  = nil;
            k.counts[c] = 0;
            c           = c + 1;
        }
        ret k;
    }

    # give a binding's cache back to its heap and empty the binding. under bind_lock,
    # which keeps the heap from being torn down while a binding names its cache
    fun cache_unbind(b: *Binding) {
        val k: *Cache = b.cache;
        b.id    = 0;
        b.cache = nil;
        if (k == nil) { ret; }
        val h: *Heap = k.heap;
        mutex.lock(?h.lock);
        var c: usize = 0;
        for (c < CLASS_COUNT) {
            cache_drain(h, k, c, k.counts[c]::usize);
            c = c + 1;
        }
        if (k.prev != nil) { k.prev.next = k.next; }
        or                 { h.caches = k.next; }
        if (k.next != nil) { k.next.prev = k.prev; }
        k.next  = h.spare;
        h.spare = k;
        mutex.unlock(?h.lock);
    }

    # the exit routine: an ending thread gives every cache back
    fun caches_end() {
        mutex.lock(?bind_lock);
        var i: usize = 0;
        for (i < BOUND) {
            cache_unbind(?bound[i]);
            i = i + 1;
        }
        mutex.unlock(?bind_lock);
    }

    # drop h's caches before its teardown: each holding thread's binding is emptied,
    # its blocks go with their spans, and the record span goes back to the source.
    # a thread holding one is alive, since an ending thread unbinds under bind_lock
    # ---
    # ret: 0, or the source's status refusing the record span
    fun caches_detach(h: *Heap) i64 {
        mutex.lock(?h.lock);
        val held: bool = h.caches != nil || h.records != nil;
        mutex.unlock(?h.lock);
        if (!held) { ret 0; }

        mutex.lock(?bind_lock);
        mutex.lock(?h.lock);
        var k: *Cache = h.caches;
        for (k != nil) {
            k.slot.id    = 0;
            k.slot.cache = nil;
            k            = k.next;
        }
        h.caches = nil;
        h.spare  = nil;
        var code: i64 = 0;
        if (h.records != nil) {
            code = release(h, h.records);
            # a refused record span stays the heap's, still no span of blocks
            if (code == 0) { h.records = nil; }
            or             { h.records.magic = 0; }
        }
        mutex.unlock(?h.lock);
        mutex.unlock(?bind_lock);
        ret code;
    }

    # a block of class c from the cache, refilling the class under one lock when
    # it holds none
    fun cached_take(h: *Heap, k: *Cache, c: usize) opt[ptr] {
        if (k.heads[c] == nil) {
            mutex.lock(?h.lock);
            val n: usize = cache_batch(c);
            var i: usize = 0;
            for (i < n) {
                var zeroed: bool = false;
                val p:      ptr  = take_small(h, c, ?zeroed);
                if (p == nil) { brk; }
                @(p::*usize) = k.heads[c]::usize;
                k.heads[c]   = p;
                i            = i + 1;
            }
            mutex.unlock(?h.lock);
            k.counts[c] = i::u32;
            if (i == 0) { ret opt[ptr].none{}; }
        }
        val p: ptr = k.heads[c];
        k.heads[c]  = (@(p::*usize))::ptr;
        k.counts[c] = k.counts[c] - 1;
        ret opt[ptr].some{p};
    }

    # hold a block of class c, a batch going back once the class holds two
    fun cache_hold(h: *Heap, k: *Cache, c: usize, p: ptr) {
        @(p::*usize) = k.heads[c]::usize;
        k.heads[c]   = p;
        k.counts[c]  = k.counts[c] + 1;
        val n: usize = cache_batch(c);
        if (k.counts[c]::usize >= 2 * n) {
            mutex.lock(?h.lock);
            cache_drain(h, k, c, n);
            mutex.unlock(?h.lock);
        }
    }

    # give n held blocks of class c back to their spans. under h's lock
    fun cache_drain(h: *Heap, k: *Cache, c: usize, n: usize) {
        var i: usize = 0;
        for (i < n && k.heads[c] != nil) {
            val p: ptr = k.heads[c];
            k.heads[c] = (@(p::*usize))::ptr;
            give_back(h, span_of(p), p);
            i = i + 1;
        }
        k.counts[c] = k.counts[c] - i::u32;
    }

    # release a block into the cache, checked against its span first. the span
    # fields the check reads stay as they are while the block is live, so for a
    # block of h it needs no lock, and for any other pointer it is the same
    # detection the locked path makes. a block that owns its span goes to the core
    fun cached_give(h: *Heap, k: *Cache, p: ptr, size: usize, align: usize) i64 {
        val s: *Span = find_span(h, p, align);
        if (s == nil) { ret EINVAL; }
        if (s.class == CLASS_LARGE) {
            mutex.lock(?h.lock);
            fin { mutex.unlock(?h.lock); }
            ret free_block(h, p, size, align);
        }
        val code: i64 = check_block(s, p, size);
        if (code != 0) { ret code; }
        cache_hold(h, k, s.class, p);
        ret 0;
    }

    # resize a small block through the cache, by the rule resize keeps; a block
    # that owns its span is resized by the core
    fun cached_resize(h: *Heap, k: *Cache, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
        val s: *Span = find_span(h, p, align);
        if (s == nil) { ret opt[ptr].none{}; }
        if (s.class == CLASS_LARGE) {
            mutex.lock(?h.lock);
            fin { mutex.unlock(?h.lock); }
            ret resize(h, p, old_size, new_size, align);
        }
        if (check_block(s, p, old_size) != 0) { ret opt[ptr].none{}; }

        val room: usize = CLASS_SIZE[s.class];
        val want: usize = class_of(h, new_size, align);
        if (new_size <= room) {
            if (want == s.class || new_size * 2 > room) { ret opt[ptr].some{p}; }
        }

        var fresh: ptr = nil;
        if (want != CLASS_LARGE) {
            val opt_taken: opt[ptr] = cached_take(h, k, want);
            if (!sel opt_taken.some) { ret opt[ptr].none{}; }
            fresh = opt_taken.some;
        }
        or {
            var zeroed: bool = false;
            mutex.lock(?h.lock);
            fresh = take(h, new_size, align, ?zeroed);
            mutex.unlock(?h.lock);
            if (fresh == nil) { ret opt[ptr].none{}; }
        }

        var copy: usize = old_size;
        if (copy > room)     { copy = room; }
        if (new_size < copy) { copy = new_size; }
        memory.raw_copy(fresh, p, copy);
        cache_hold(h, k, s.class, p);
        ret opt[ptr].some{fresh};
    }
}

# initialize a Heap over a span source
#
# the source is copied into the heap, so the caller's Source may be discarded;
# whatever the source's ctx points at must outlive the heap.
# ---
# h:      Heap to initialize
# src:    span source the heap draws from
# budget: byte ceiling for retained empty spans, 0 for the default
# ret:    ok, or `invalid` for a nil heap, a nil source, or a source with no
#         obtain callback
pub fun init(h: *Heap, src: *Source, budget: usize) err[A.Error] {
    if (h == nil)             { ret err[A.Error].err{A.Error.invalid{}}; }
    if (src == nil)           { ret err[A.Error].err{A.Error.invalid{}}; }
    if (src.fn_obtain == nil) { ret err[A.Error].err{A.Error.invalid{}}; }

    h.src  = @src;
    h.lock = mutex.make();

    var i: usize = 0;
    for (i < CLASS_COUNT) {
        h.partial[i] = nil;
        h.full[i]    = nil;
        i            = i + 1;
    }

    h.spans = nil;
    h.cache = nil;
    h.large = nil;
    h.huge  = nil;

    h.held   = 0;
    h.budget = budget;
    if (h.budget == 0) { h.budget = DEFAULT_CACHE; }

    h.live         = 0;
    h.mapped       = 0;
    h.peak         = 0;
    h.blocks       = 0;
    h.total_blocks = 0;
    h.total_bytes  = 0;

    h.id      = atomic.fetch_add_word(?heap_ids, 1) + 1;
    h.caches  = nil;
    h.spare   = nil;
    h.records = nil;
    h.carved  = 0;

    # size to class, by 16 byte steps up to 1024 and 128 byte steps beyond
    var c: usize = 0;
    i = 0;
    for (i < 64) {
        val want: usize = (i + 1) * 16;
        for (CLASS_SIZE[c] < want) { c = c + 1; }
        h.idx_small[i] = c::u8;
        i              = i + 1;
    }

    c = 0;
    i = 0;
    for (i < 64) {
        val want: usize = (i + 1) * 128;
        for (CLASS_SIZE[c] < want) { c = c + 1; }
        h.idx_mid[i] = c::u8;
        i            = i + 1;
    }

    ret err[A.Error].ok{};
}

# wire up an Allocator backed by this Heap
# ---
# a:   Allocator to initialize
# h:   initialized Heap (must outlive the Allocator)
# ret: ok, or `invalid` when either pointer is nil
pub fun allocator(a: *A.Allocator, h: *Heap) err[A.Error] {
    if (a == nil) { ret err[A.Error].err{A.Error.invalid{}}; }
    if (h == nil) { ret err[A.Error].err{A.Error.invalid{}}; }

    a.ctx           = h::ptr;
    a.fn_allocate   = do_allocate;
    a.fn_reallocate = do_reallocate;
    a.fn_deallocate = do_deallocate;
    a.retains       = false;

    ret err[A.Error].ok{};
}

# wire up an Allocator backed by this Heap for one owner, taking no lock, so
# only one thread at a time may call it or anything else on the heap
# ---
# a:   Allocator to initialize
# h:   initialized Heap (must outlive the Allocator)
# ret: ok, or `invalid` when either pointer is nil
pub fun allocator_owned(a: *A.Allocator, h: *Heap) err[A.Error] {
    if (a == nil) { ret err[A.Error].err{A.Error.invalid{}}; }
    if (h == nil) { ret err[A.Error].err{A.Error.invalid{}}; }

    a.ctx           = h::ptr;
    a.fn_allocate   = owned_allocate;
    a.fn_reallocate = owned_reallocate;
    a.fn_deallocate = owned_deallocate;
    a.retains       = false;

    ret err[A.Error].ok{};
}

# release every span back to the source and zero the heap state
#
# live blocks are abandoned, so this is a teardown of the whole heap and not a
# way to free one allocation. every span is attempted even when one release
# fails, and the first failure is what is reported.
# ---
# h:   Heap to destroy
# ret: ok, or the first negative backend native code as `release`
pub fun dnit(h: *Heap) err[A.Error] {
    if (h == nil) { ret err[A.Error].ok{}; }

    var first: i64 = 0;
    $if (capability.HAS_THREADS) {
        first = caches_detach(h);
    }

    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }

    var i: usize = 0;
    for (i < CLASS_COUNT) {
        first = drain(h, ?h.partial[i], first);
        first = drain(h, ?h.full[i], first);
        i     = i + 1;
    }

    first  = drain(h, ?h.spans, first);
    first  = drain(h, ?h.cache, first);
    first  = drain(h, ?h.large, first);
    first  = drain(h, ?h.huge, first);
    h.held = 0;

    h.live   = 0;
    h.blocks = 0;

    if (first != 0) { ret err[A.Error].err{A.Error.release{first}}; }
    ret err[A.Error].ok{};
}

# release every span on a list, keeping the first failing status
fun drain(h: *Heap, head: **Span, first: i64) i64 {
    var kept: i64   = first;
    var s:    *Span = @head;
    for (s != nil) {
        val next: *Span = s.next;
        val code: i64   = release(h, s);
        if (code != 0 && kept == 0) { kept = code; }
        s = next;
    }
    @head = nil;
    ret kept;
}

# allocate `size` bytes of zeroed memory at `align`
#
# a block carved from a region the source delivered zeroed is returned as is,
# so a fresh span costs no write. anything reused is zeroed explicitly.
# ---
# h:     Heap to allocate from
# size:  number of bytes (0 returns nil)
# align: alignment in bytes, a power of two
# ret:   ptr to zeroed memory, or the refusal
pub fun zallocate_raw(h: *Heap, size: usize, align: usize) res[ptr, A.Error] {
    if (h == nil)                   { ret res[ptr, A.Error].err{A.Error.invalid{}}; }
    if (align == 0)                 { ret res[ptr, A.Error].err{A.Error.invalid{}}; }
    if ((align & (align - 1)) != 0) { ret res[ptr, A.Error].err{A.Error.invalid{}}; }
    if (size == 0)                  { ret res[ptr, A.Error].ok{nil}; }

    mutex.lock(?h.lock);

    var zeroed: bool = false;
    val p:      ptr  = take(h, size, align, ?zeroed);

    mutex.unlock(?h.lock);

    if (p == nil) { ret res[ptr, A.Error].err{A.Error.exhausted{}}; }
    if (!zeroed)  { memory.raw_zero(p, size); }

    ret res[ptr, A.Error].ok{p};
}

# bytes in live blocks, counted as the class size or payload capacity charged
# for each one rather than the size requested
pub fun live_bytes(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.live;
}

# bytes of the spans obtained from the source and not yet returned, each
# counted at the size the heap asked for, never at a larger grant
pub fun mapped_bytes(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.mapped;
}

# high water mark of mapped_bytes over the heap's life
pub fun peak_mapped_bytes(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.peak;
}

# live block count
pub fun live_blocks(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.blocks;
}

# blocks handed out over the heap's life, never decremented
pub fun allocated_blocks(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.total_blocks;
}

# bytes handed out over the heap's life, counted as the class size or payload
# capacity charged for each block as live_bytes counts it, never decremented
pub fun allocated_bytes(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.total_bytes;
}

# verify the heap's own invariants
#
# walks every span the heap holds and checks its header, its position, its
# free list and the accounting totals against what the spans say. intended
# for tests and for a caller that suspects heap corruption.
# ---
# h:   Heap to check
# ret: true when every invariant holds
pub fun check(h: *Heap) bool {
    if (h == nil) { ret false; }

    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }

    var live:   usize = 0;
    var blocks: usize = 0;
    var held:   usize = 0;

    var i: usize = 0;
    for (i < CLASS_COUNT) {
        if (!check_class(h, h.partial[i], i, true, ?live, ?blocks)) { ret false; }
        if (!check_class(h, h.full[i], i, false, ?live, ?blocks))   { ret false; }
        i = i + 1;
    }

    var s: *Span = h.spans;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC) { ret false; }
        if (s.owner != h::ptr)     { ret false; }
        if (s.used != 0)           { ret false; }
        held = held + s.size;
        s    = s.next;
    }

    s = h.cache;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC) { ret false; }
        if (s.owner != h::ptr)     { ret false; }
        if (s.used != 0)           { ret false; }
        held = held + s.size;
        s    = s.next;
    }

    s = h.large;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC)    { ret false; }
        if (s.owner != h::ptr)        { ret false; }
        if (s.class != CLASS_LARGE)   { ret false; }
        if (s.used != 1)              { ret false; }
        if (s.data >= SPAN_ALIGN)     { ret false; }
        if (s.data + s.cap != s.size) { ret false; }
        live   = live + s.cap;
        blocks = blocks + 1;
        s      = s.next;
    }

    s = h.huge;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC)  { ret false; }
        if (s.owner != h::ptr)      { ret false; }
        if (s.class != CLASS_LARGE) { ret false; }
        if (s.used != 1)            { ret false; }
        if (s.data < SPAN_ALIGN)    { ret false; }
        live   = live + s.cap;
        blocks = blocks + 1;
        s      = s.next;
    }

    if (live != h.live)     { ret false; }
    if (blocks != h.blocks) { ret false; }
    if (held != h.held)     { ret false; }

    ret true;
}

# check every span on one class list and accumulate its live accounting
fun check_class(h: *Heap, head: *Span, c: usize, partial: bool, live: *usize, blocks: *usize) bool {
    val class_size: usize = CLASS_SIZE[c];
    val data:       usize = class_data_offset(class_size);

    var s: *Span = head;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC)                 { ret false; }
        if (s.owner != h::ptr)                     { ret false; }
        if (s.class != c)                          { ret false; }
        if (s.size != SPAN_SIZE)                   { ret false; }
        if (s.data != data)                        { ret false; }
        if (s.cap != (s.size - data) / class_size) { ret false; }
        if (s.used > s.cap)                        { ret false; }
        if (s.bump < data || s.bump > s.size)      { ret false; }
        if ((s.bump - data) % class_size != 0)     { ret false; }

        # a partial span has a block to give, a full one does not
        val carved: usize = (s.bump - data) / class_size;
        if (partial && s.used == s.cap)  { ret false; }
        if (!partial && s.used != s.cap) { ret false; }
        if (s.used == 0)                 { ret false; }
        if (carved < s.used)             { ret false; }

        # the free list holds exactly the carved blocks not handed out, each
        # of them a block start inside the carved region
        var want:  usize = carved - s.used;
        var seen:  usize = 0;
        var block: ptr   = s.free;
        for (block != nil) {
            if (seen > want) { ret false; }
            val off: usize = block::usize - s::usize;
            if (off < data || off >= s.bump)    { ret false; }
            if ((off - data) % class_size != 0) { ret false; }
            seen  = seen + 1;
            block = (@(block::*usize))::ptr;
        }
        if (seen != want) { ret false; }

        @live   = @live + s.used * class_size;
        @blocks = @blocks + s.used;
        s       = s.next;
    }

    ret true;
}

$if (capability.HAS_PAGES) {
    # fill in a Source backed by the host's page mapper
    #
    # spans come from the platform mapper over-mapped and trimmed to SPAN_ALIGN,
    # and are returned to it whole.
    # ---
    # s: Source to initialize
    pub fun native_source(s: *Source) {
        if (s == nil) { ret; }
        s.ctx        = nil;
        s.fn_obtain  = native_obtain;
        s.fn_release = native_release;
        s.stale      = false;
        # a windows reservation goes back whole, from its own base
        s.cuts = $mach.build.sys != $mach.sys.windows;
    }

    # a span of exactly `least` bytes, since the mapper grants any page multiple
    fun native_obtain(ctx: ptr, least: usize, most: usize) opt[Grant] {
        val size: usize = least;
        if (size > ~(0::usize) - SPAN_ALIGN) { ret opt[Grant].none{}; }
        $if ($mach.build.sys == $mach.sys.windows) {
            # a windows reservation is released whole from its own base, so the
            # padding cannot be trimmed and the base is stashed ahead of the span
            val raw: ptr = os.allocate(size + SPAN_ALIGN);
            if (raw == nil) { ret opt[Grant].none{}; }

            val base: usize = align_up(raw::usize + 1, SPAN_ALIGN);
            @((base - 8)::*usize) = base - raw::usize;
            ret opt[Grant].some{Grant{base: base::ptr, size: size}};
        }
        $or {
            val raw: ptr = os.allocate(size + SPAN_ALIGN);
            if (raw == nil) { ret opt[Grant].none{}; }

            val base: usize = align_up(raw::usize, SPAN_ALIGN);
            val head: usize = base - raw::usize;
            val tail: usize = SPAN_ALIGN - head;

            if (head != 0) { os.deallocate(raw, head); }
            if (tail != 0) { os.deallocate((base + size)::ptr, tail); }

            ret opt[Grant].some{Grant{base: base::ptr, size: size}};
        }
    }

    fun native_release(ctx: ptr, span: ptr, size: usize) i64 {
        $if ($mach.build.sys == $mach.sys.windows) {
            val back: usize = @((span::usize - 8)::*usize);
            ret os.deallocate((span::usize - back)::ptr, size + SPAN_ALIGN);
        }
        $or {
            ret os.deallocate(span, size);
        }
    }
}

# fill in a Source backed by another allocator
#
# spans are requested at SPAN_ALIGN and zeroed on the way out, so any backing
# allocator that honors alignment can host a heap: a fixed buffer, an arena,
# the page allocator, or the testing allocator for span-level accounting. a
# backing that hands back a span off the SPAN_ALIGN grid gets it straight back
# and the request is refused.
#
# over a backing that does not reclaim (`allocator.reclaims` is false), giving
# a span back would only spend the backing, so the source cannot release: the
# heap keeps its spans, reuses them for any class, and growing past the budget
# again takes nothing more from the backing. the backing's retains flag is read
# here, so it must be settled before this call.
# ---
# s:       Source to initialize
# backing: allocator spans are drawn from (must outlive the heap)
pub fun allocator_source(s: *Source, backing: *A.Allocator) {
    if (s == nil) { ret; }
    s.ctx        = backing::ptr;
    s.fn_obtain  = backed_obtain;
    s.fn_release = nil;
    s.stale      = false;
    s.cuts       = false;
    if (A.reclaims(backing)) { s.fn_release = backed_release; }
}

fun backed_obtain(ctx: ptr, least: usize, most: usize) opt[Grant] {
    val a:                *A.Allocator      = ctx::*A.Allocator;
    val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(a, least, SPAN_ALIGN);
    if (sel res_allocate_raw.err)   { ret opt[Grant].none{}; }
    if (res_allocate_raw.ok == nil) { ret opt[Grant].none{}; }

    memory.raw_zero(res_allocate_raw.ok, least);
    ret opt[Grant].some{Grant{base: res_allocate_raw.ok, size: least}};
}

fun backed_release(ctx: ptr, span: ptr, size: usize) i64 {
    val a:        *A.Allocator = ctx::*A.Allocator;
    val err_gone: err[A.Error] = A.deallocate_raw(a, span, size, SPAN_ALIGN);
    if (sel err_gone.err) {
        if (sel err_gone.err.release) { ret err_gone.err.release; }
        ret EINVAL;
    }
    ret 0;
}

# the state of a region source: the part of the region not yet handed out
# ---
# next: first byte not yet handed out
# stop: one past the region's last byte
pub rec Region {
    next: usize;
    stop: usize;
}

# fill in a Source that carves spans from one region of memory
#
# the program states the region, such as a RAM range on bare metal that its
# manifest leaves free, and every span comes from it in address order at
# SPAN_ALIGN. a span is zeroed on the way out, since the region holds whatever
# was there before. the region cannot take a span back, so fn_release is nil
# and the heap keeps every span it obtained and reuses it, the way it does over
# a backing that does not reclaim. a request the rest of the region cannot
# hold is refused.
# ---
# s:    Source to initialize
# r:    region state the source keeps (must outlive the heap)
# base: first byte of the region
# len:  region length in bytes
pub fun region_source(s: *Source, r: *Region, base: ptr, len: usize) {
    if (s == nil || r == nil) { ret; }
    r.next       = base::usize;
    r.stop       = base::usize + len;
    s.ctx        = r::ptr;
    s.fn_obtain  = region_obtain;
    s.fn_release = nil;
    s.stale      = false;
    s.cuts       = true;
}

fun region_obtain(ctx: ptr, least: usize, most: usize) opt[Grant] {
    val r:     *Region = ctx::*Region;
    val start: usize   = align_up(r.next, SPAN_ALIGN);
    if (start < r.next || start > r.stop) { ret opt[Grant].none{}; }
    if (least > r.stop - start)           { ret opt[Grant].none{}; }

    r.next = start + least;
    memory.raw_zero(start::ptr, least);
    ret opt[Grant].some{Grant{base: start::ptr, size: least}};
}

# a pool keeps each page count below 1 << EXACT_SHIFT pages in a bin of its
# own, and each doubling of the size above it in 1 << STEP_SHIFT bins
val EXACT_SHIFT: usize = 6;
val STEP_SHIFT:  usize = 3;

# bins for sizes up to 1 << 31 pages: the exact ones, then eight to a doubling
val POOL_BINS: usize = 264;

# a span a pool holds, its record in its own first bytes
# ---
# size:  bytes the span holds
# next:  the span after it in its bin, given back before it
# prev:  the span before it in its bin
# newer: the span given back after it
# older: the span given back before it
rec Held {
    size:  usize;
    next:  *Held;
    prev:  *Held;
    newer: *Held;
    older: *Held;
}

# spans kept between heaps
#
# a heap gives its spans back to its source when it is torn down or runs past
# its budget. over the host mapper that unmaps them, and the next heap maps and
# faults the same memory in again. a pool stands between heaps and their real
# source: a span given back is held at the size it was granted and granted
# again, whole, to the next request whose range takes it, the smallest such
# span and of those the last given back. a heap uses only the least of a
# grant, so which span a heap is handed, which depends on what other heaps
# gave back, never changes what the heap does or counts. nothing is rounded, so no byte of a
# span lies past what its holder was granted. when no held span is in range and
# the source cuts, the smallest span past the range is cut: its first bytes,
# the request rounded to SPAN_ALIGN when the range takes that, are granted and
# the rest stays held, so a pool holding large spans serves a smaller request
# without going to its source. when a span given back would
# take the held bytes past the budget, the spans held longest go back to the
# source first, since the next requests take the last given back. a request no
# held span fits goes to the source as it is, and so does a span past the
# largest bin. a held span keeps what was written to it, so a pool's source is
# stale.
# ---
# src:    where spans come from and go back to
# lock:   covers every field below
# bins:   held spans by size, latest given back first
# newest: the span given back last
# oldest: the span held longest
# held:   bytes in the bins
# budget: byte ceiling for `held`, past which the oldest spans go back to the source
pub rec Pool {
    src:    Source;
    lock:   mutex.Mutex;
    bins:   [POOL_BINS]*Held;
    newest: *Held;
    oldest: *Held;
    held:   usize;
    budget: usize;
}

# initialize a Pool over a span source
#
# the source is copied into the pool, and whatever its ctx points at must
# outlive the pool. a pool over a source that cannot release holds every span
# given back to it, whatever the budget.
# ---
# p:      Pool to initialize
# src:    span source the pool draws from
# budget: byte ceiling for held spans, 0 for no ceiling
# ret:    ok, or `invalid` for a nil pool, a nil source, or a source with no
#         obtain callback
pub fun pool_init(p: *Pool, src: *Source, budget: usize) err[A.Error] {
    if (p == nil)             { ret err[A.Error].err{A.Error.invalid{}}; }
    if (src == nil)           { ret err[A.Error].err{A.Error.invalid{}}; }
    if (src.fn_obtain == nil) { ret err[A.Error].err{A.Error.invalid{}}; }

    p.src  = @src;
    p.lock = mutex.make();
    var k: usize = 0;
    for (k < POOL_BINS) {
        p.bins[k] = nil;
        k         = k + 1;
    }
    p.newest = nil;
    p.oldest = nil;
    p.held   = 0;
    p.budget = budget;
    if (p.budget == 0) { p.budget = ~(0::usize); }
    ret err[A.Error].ok{};
}

# give every held span back to the source. every heap drawing from the pool
# must be torn down first
# ---
# p:   Pool to tear down
# ret: ok, or the first status the source refused a span with
pub fun pool_dnit(p: *Pool) err[A.Error] {
    if (p == nil) { ret err[A.Error].ok{}; }

    mutex.lock(?p.lock);
    fin { mutex.unlock(?p.lock); }

    var first: i64   = 0;
    var s:     *Held = p.oldest;
    for (s != nil) {
        val newer: *Held = s.newer;
        if (p.src.fn_release != nil) {
            val code: i64 = p.src.fn_release(p.src.ctx, s::ptr, s.size);
            if (code != 0 && first == 0) { first = code; }
        }
        s = newer;
    }
    var k: usize = 0;
    for (k < POOL_BINS) {
        p.bins[k] = nil;
        k         = k + 1;
    }
    p.newest = nil;
    p.oldest = nil;
    p.held   = 0;

    if (first != 0) { ret err[A.Error].err{A.Error.release{first}}; }
    ret err[A.Error].ok{};
}

# fill in a Source that draws spans from a pool and gives them back to it
# ---
# s: Source to initialize
# p: pool the spans are drawn from (must outlive the heap)
pub fun pool_source(s: *Source, p: *Pool) {
    if (s == nil) { ret; }
    s.ctx        = p::ptr;
    s.fn_obtain  = pooled_obtain;
    s.fn_release = pooled_release;
    s.stale      = true;
    s.cuts       = p.src.cuts;
}

# the bin a span of `size` bytes is held in, POOL_BINS for one past the largest
fun pool_bin(size: usize) usize {
    val pages: usize = size / PAGE_FLOOR;
    if (pages < (1 << EXACT_SHIFT)) { ret pages; }
    var top: usize = EXACT_SHIFT;
    for ((pages >> (top + 1)) != 0) { top = top + 1; }
    val k: usize = (1 << EXACT_SHIFT) + ((top - EXACT_SHIFT) << STEP_SHIFT) + ((pages >> (top - STEP_SHIFT)) & ((1 << STEP_SHIFT) - 1));
    if (k >= POOL_BINS) { ret POOL_BINS; }
    ret k;
}

# hold a span as the one given back last
fun held_link(p: *Pool, s: *Held, size: usize) {
    val k: usize = pool_bin(size);
    s.size = size;
    s.prev = nil;
    s.next = p.bins[k];
    if (s.next != nil) { s.next.prev = s; }
    p.bins[k] = s;
    s.newer   = nil;
    s.older   = p.newest;
    if (s.older != nil) { s.older.newer = s; }
    or                  { p.oldest = s; }
    p.newest = s;
    p.held   = p.held + size;
}

# stop holding a span
fun held_unlink(p: *Pool, s: *Held) {
    if (s.prev != nil)  { s.prev.next = s.next; }
    or                  { p.bins[pool_bin(s.size)] = s.next; }
    if (s.next != nil)  { s.next.prev = s.prev; }
    if (s.newer != nil) { s.newer.older = s.older; }
    or                  { p.newest = s.older; }
    if (s.older != nil) { s.older.newer = s.newer; }
    or                  { p.oldest = s.newer; }
    p.held = p.held - s.size;
}

# the smallest span bin k holds of `least` to `most` bytes, of those the last given
# back, or nil. a bin below 1 << EXACT_SHIFT pages holds one size, so its first
# span answers
fun bin_smallest(p: *Pool, k: usize, least: usize, most: usize) *Held {
    var s: *Held = p.bins[k];
    if (k < (1 << EXACT_SHIFT)) {
        if (s != nil && s.size >= least && s.size <= most) { ret s; }
        ret nil;
    }
    var best: *Held = nil;
    for (s != nil) {
        if (s.size >= least && s.size <= most && (best == nil || s.size < best.size)) {
            best = s;
            if (s.size == least) { brk; }
        }
        s = s.next;
    }
    ret best;
}

fun pooled_obtain(ctx: ptr, least: usize, most: usize) opt[Grant] {
    val p:     *Pool = ctx::*Pool;
    val first: usize = pool_bin(least);
    if (first == POOL_BINS) { ret p.src.fn_obtain(p.src.ctx, least, most); }
    var last: usize = pool_bin(most);
    if (last == POOL_BINS) { last = POOL_BINS - 1; }

    # the bins hold disjoint ranges in order, so the first bin with a span in
    # range holds the smallest
    mutex.lock(?p.lock);
    var best: *Held = nil;
    var k:    usize = first;
    for (k <= last && best == nil) {
        best = bin_smallest(p, k, least, most);
        k    = k + 1;
    }
    if (best != nil) { held_unlink(p, best); }
    or               { best = pool_cut(p, last, least, most); }
    mutex.unlock(?p.lock);

    if (best != nil) { ret opt[Grant].some{Grant{base: best::ptr, size: best.size}}; }
    ret p.src.fn_obtain(p.src.ctx, least, most);
}

# the first `least` bytes rounded to SPAN_ALIGN of the smallest span held in a bin
# past `last`, its record naming that size and the rest of it held again, or nil
# when the source does not cut, the rounded size is past `most`, or no such span
# is held. under the lock
fun pool_cut(p: *Pool, last: usize, least: usize, most: usize) *Held {
    if (!p.src.cuts)                      { ret nil; }
    if (least > ~(0::usize) - SPAN_ALIGN) { ret nil; }
    val cut: usize = align_up(least, SPAN_ALIGN);
    if (cut > most) { ret nil; }

    var best: *Held = nil;
    var k:    usize = last + 1;
    for (k < POOL_BINS && best == nil) {
        best = bin_smallest(p, k, cut + 1, ~(0::usize));
        k    = k + 1;
    }
    if (best == nil) { ret nil; }

    held_unlink(p, best);
    val rest: usize = best.size - cut;
    held_link(p, (best::usize + cut)::*Held, rest);
    best.size = cut;
    ret best;
}

fun pooled_release(ctx: ptr, span: ptr, size: usize) i64 {
    val p:        *Pool = ctx::*Pool;
    val reclaims: bool  = p.src.fn_release != nil;
    if (pool_bin(size) == POOL_BINS || (reclaims && size > p.budget)) {
        if (!reclaims) { ret 0; }
        ret p.src.fn_release(p.src.ctx, span, size);
    }

    # the spans held longest make room, and go back to the source once the lock is let go
    var gone: *Held = nil;
    mutex.lock(?p.lock);
    if (reclaims) {
        for (p.held > p.budget - size) {
            val old: *Held = p.oldest;
            held_unlink(p, old);
            old.next = gone;
            gone     = old;
        }
    }
    held_link(p, span::*Held, size);
    mutex.unlock(?p.lock);

    # a span the source refuses stays held
    for (gone != nil) {
        val next: *Held = gone.next;
        if (p.src.fn_release(p.src.ctx, gone::ptr, gone.size) != 0) {
            mutex.lock(?p.lock);
            held_link(p, gone, gone.size);
            mutex.unlock(?p.lock);
        }
        gone = next;
    }
    ret 0;
}

$if (capability.HAS_PAGES && capability.HAS_THREADS) {
    # the Source members every behavioural case runs against
    #
    # a member is a row here and a branch in bed_init: the host mapper, the
    # allocator adapter over a fixed buffer, over the page allocator and over the
    # testing allocator, and a mapper that hands out the weakest base the
    # contract allows. a new Source member is one more row.
    #[testing]
    val MEMBER_NATIVE:  usize = 0;
    #[testing]
    val MEMBER_FIXED:   usize = 1;
    #[testing]
    val MEMBER_PAGE:    usize = 2;
    #[testing]
    val MEMBER_TESTING: usize = 3;
    #[testing]
    val MEMBER_WEAK:    usize = 4;
    #[testing]
    val MEMBER_COUNT:   usize = 5;

    # the fixed buffer never reclaims, so the heap over it keeps every span it
    # obtains and reuses them: the million-operation case peaks near 170 MiB
    #[testing]
    val FIXED_BYTES: usize = 512 * 1024 * 1024;

    # a mapper at the weakest legal base: every span is a multiple of SPAN_ALIGN
    # and never a multiple of 2 * SPAN_ALIGN, so an alignment above SPAN_ALIGN
    # has to come from the heap and cannot be inherited from the mapper. the raw
    # base is stashed ahead of the span, the shape native_obtain uses on windows.
    #[testing]
    fun weak_obtain(ctx: ptr, least: usize, most: usize) opt[Grant] {
        if (least > ~(0::usize) - 2 * SPAN_ALIGN) { ret opt[Grant].none{}; }
        val raw: ptr = os.allocate(least + 2 * SPAN_ALIGN);
        if (raw == nil) { ret opt[Grant].none{}; }

        var base: usize = align_up(raw::usize + 1, SPAN_ALIGN);
        if (base % (2 * SPAN_ALIGN) == 0) { base = base + SPAN_ALIGN; }
        @((base - 8)::*usize) = base - raw::usize;
        ret opt[Grant].some{Grant{base: base::ptr, size: least}};
    }

    #[testing]
    fun weak_release(ctx: ptr, span: ptr, size: usize) i64 {
        val back: usize = @((span::usize - 8)::*usize);
        ret os.deallocate((span::usize - back)::ptr, size + 2 * SPAN_ALIGN);
    }

    # one member's source and whatever it stands on
    #[testing]
    rec Bed {
        member:  usize;
        src:     Source;
        region:  ptr;
        state:   fixed.FixedState;
        tracker: testing.Testing;
        backing: A.Allocator;
    }

    #[testing]
    fun bed_init(bed: *Bed, member: usize) bool {
        bed.member = member;
        bed.region = nil;

        if (member == MEMBER_NATIVE) {
            native_source(?bed.src);
            ret true;
        }
        if (member == MEMBER_FIXED) {
            bed.region = os.allocate(FIXED_BYTES);
            if (bed.region == nil) { ret false; }
            val err_fixed_made: err[A.Error] = fixed.make(?bed.backing, ?bed.state, bed.region::*u8, FIXED_BYTES);
            if (sel err_fixed_made.err) { ret false; }
            allocator_source(?bed.src, ?bed.backing);
            ret true;
        }
        if (member == MEMBER_PAGE) {
            val err_page_made: err[A.Error] = page.make(?bed.backing);
            if (sel err_page_made.err) { ret false; }
            allocator_source(?bed.src, ?bed.backing);
            ret true;
        }
        if (member == MEMBER_TESTING) {
            val err_testing_made: err[A.Error] = testing.init(?bed.tracker);
            if (sel err_testing_made.err) { ret false; }
            allocator_source(?bed.src, testing.allocator_of(?bed.tracker));
            ret true;
        }
        if (member == MEMBER_WEAK) {
            bed.src.ctx        = nil;
            bed.src.fn_obtain  = weak_obtain;
            bed.src.fn_release = weak_release;
            ret true;
        }
        ret false;
    }

    # false when the member's own accounting says a span was leaked or freed twice
    #[testing]
    fun bed_dnit(bed: *Bed) bool {
        var clean: bool = true;
        if (bed.region != nil) { os.deallocate(bed.region, FIXED_BYTES); }
        if (bed.member == MEMBER_TESTING) {
            if (testing.leaked(?bed.tracker))                 { clean = false; }
            if (testing.double_free_count(?bed.tracker) != 0) { clean = false; }
            testing.dnit(?bed.tracker);
        }
        bed.region = nil;
        ret clean;
    }

    # a heap over one member, wired to an Allocator
    #[testing]
    fun heap_on(bed: *Bed, member: usize, h: *Heap, a: *A.Allocator) bool {
        if (!bed_init(bed, member)) { ret false; }
        val err_src_made: err[A.Error] = init(h, ?bed.src, 0);
        if (sel err_src_made.err) {
            bed_dnit(bed);
            ret false;
        }
        val err_made: err[A.Error] = allocator(a, h);
        if (sel err_made.err) {
            dnit(h);
            bed_dnit(bed);
            ret false;
        }
        ret true;
    }

    # run one behavioural case against every member
    #
    # a failure is reported as member * 100 + the case's own code; a case that
    # leaves spans the source refuses to take back, or that the member's own
    # accounting reports as leaked or freed twice, fails too. the fixed member
    # never reclaims, so its heap must still count every span it held at dnit
    #[testing]
    fun each(body: fun(*Heap, *A.Allocator) i32) i32 {
        var member: usize = 0;
        for (member < MEMBER_COUNT) {
            var bed: Bed;
            var h:   Heap;
            var a:   A.Allocator;
            if (!heap_on(?bed, member, ?h, ?a)) { ret (member * 100 + 1)::i32; }

            val code:     i32          = body(?h, ?a);
            val held:     usize        = mapped_bytes(?h);
            val err_dnit: err[A.Error] = dnit(?h);
            val clean:    bool         = bed_dnit(?bed);

            if (code != 0)        { ret (member * 100)::i32 + code; }
            if (sel err_dnit.err) { ret (member * 100 + 97)::i32; }
            if (!clean)           { ret (member * 100 + 98)::i32; }

            # a retaining backing keeps its spans by design, so dnit leaves them counted
            var want: usize = 0;
            if (member == MEMBER_FIXED)   { want = held; }
            if (mapped_bytes(?h) != want) { ret (member * 100 + 99)::i32; }
            member = member + 1;
        }
        ret 0;
    }

    #[testing]
    fun rand(state: *usize) usize {
        var x: usize = @state;
        x      = x ^ (x << 13);
        x      = x ^ (x >> 7);
        x      = x ^ (x << 17);
        @state = x;
        ret x;
    }

    # the eight pattern bytes that start at `first`, as the word a store of them holds
    #[testing]
    fun paint_word(first: u8) u64 {
        var w: u64 = 0;
        var k: u64 = 0;
        for (k < 8) {
            w = w | (((first + k::u8)::u64) << (8 * k));
            k = k + 1;
        }
        ret w;
    }

    # a pattern word with every byte moved on by eight
    #[testing]
    fun paint_next(w: u64) u64 {
        ret ((w & 0x7f7f7f7f7f7f7f7f) + 0x0808080808080808) ^ (w & 0x8080808080808080);
    }

    # write a byte pattern derived from a seed over a block
    #[testing]
    fun paint(p: ptr, size: usize, seed: u8) {
        val b: *u8   = p::*u8;
        var i: usize = 0;
        for (i < size && ((p::usize + i) & 7) != 0) {
            b[i] = (seed + i::u8);
            i    = i + 1;
        }
        var w: u64 = paint_word(seed + i::u8);
        for (i + 8 <= size) {
            @((p::usize + i)::*u64) = w;
            w                       = paint_next(w);
            i                       = i + 8;
        }
        for (i < size) {
            b[i] = (seed + i::u8);
            i    = i + 1;
        }
    }

    #[testing]
    fun painted(p: ptr, size: usize, seed: u8) bool {
        val b: *u8   = p::*u8;
        var i: usize = 0;
        for (i < size && ((p::usize + i) & 7) != 0) {
            if (b[i] != (seed + i::u8)) { ret false; }
            i = i + 1;
        }
        var w: u64 = paint_word(seed + i::u8);
        for (i + 8 <= size) {
            if (@((p::usize + i)::*u64) != w) { ret false; }
            w = paint_next(w);
            i = i + 8;
        }
        for (i < size) {
            if (b[i] != (seed + i::u8)) { ret false; }
            i = i + 1;
        }
        ret true;
    }

    #[testing]
    fun case_every_size_straddling_a_class_boundary_is_served(h: *Heap, a: *A.Allocator) i32 {
        # one byte under, on, and one byte over every class boundary
        var c: usize = 0;
        for (c < CLASS_COUNT) {
            val cs: usize = CLASS_SIZE[c];

            var d: usize = 0;
            for (d < 3) {
                val size: usize = (cs - 1) + d;
                if (size == 0) { cnt; }

                val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(a, size, 8);
                if (sel res_allocate_raw.err)   { ret 2; }
                if (res_allocate_raw.ok == nil) { ret 3; }

                # a block must hold every byte it was asked for
                paint(res_allocate_raw.ok, size, 3);
                if (!painted(res_allocate_raw.ok, size, 3)) { ret 4; }

                # the charge is the class that covers the size
                val charged: usize = live_bytes(h);
                if (size <= MAX_SMALL && charged < size) { ret 5; }

                val err_gone: err[A.Error] = A.deallocate_raw(a, res_allocate_raw.ok, size, 8);
                if (sel err_gone.err)   { ret 6; }
                if (live_bytes(h) != 0) { ret 7; }
                d = d + 1;
            }

            if (!check(h)) { ret 8; }
            c = c + 1;
        }
        ret 0;
    }

    test heap__every_size_straddling_a_class_boundary_is_served {
        ret each(case_every_size_straddling_a_class_boundary_is_served);
    }

    #[testing]
    fun case_alignment_is_honored_above_class_granularity(h: *Heap, a: *A.Allocator) i32 {
        var kept:  [16]ptr;
        var sizes: [16]usize;

        var align: usize = 1;
        for (align <= 131072) {
            var n: usize = 0;
            for (n < 16) {
                # a size that is not a multiple of the alignment on purpose
                val size:             usize             = align + 1 + n;
                val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(a, size, align);
                if (sel res_allocate_raw.err)                        { ret 2; }
                if (res_allocate_raw.ok == nil)                      { ret 3; }
                if ((res_allocate_raw.ok::usize & (align - 1)) != 0) { ret 4; }

                paint(res_allocate_raw.ok, size, 11);
                kept[n]  = res_allocate_raw.ok;
                sizes[n] = size;
                n        = n + 1;
            }

            if (!check(h)) { ret 5; }

            n = 0;
            for (n < 16) {
                if (!painted(kept[n], sizes[n], 11)) { ret 6; }
                val err_gone: err[A.Error] = A.deallocate_raw(a, kept[n], sizes[n], align);
                if (sel err_gone.err) { ret 7; }
                n = n + 1;
            }

            if (live_bytes(h) != 0) { ret 8; }
            if (!check(h))          { ret 9; }
            align = align * 2;
        }
        ret 0;
    }

    test heap__alignment_is_honored_above_class_granularity {
        ret each(case_alignment_is_honored_above_class_granularity);
    }

    #[testing]
    fun case_a_block_above_the_largest_class_owns_its_span(h: *Heap, a: *A.Allocator) i32 {
        val size:             usize             = MAX_SMALL * 9 + 17;
        val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(a, size, 16);
        if (sel res_allocate_raw.err)   { ret 2; }
        if (res_allocate_raw.ok == nil) { ret 3; }

        paint(res_allocate_raw.ok, size, 5);
        if (!painted(res_allocate_raw.ok, size, 5)) { ret 4; }

        # its span is sized for the block, not rounded to a class span
        if (mapped_bytes(h) < size)             { ret 5; }
        if (mapped_bytes(h) > size + SPAN_SIZE) { ret 6; }
        if (live_blocks(h) != 1)                { ret 7; }
        if (!check(h))                          { ret 8; }

        val err_gone: err[A.Error] = A.deallocate_raw(a, res_allocate_raw.ok, size, 16);
        if (sel err_gone.err)    { ret 9; }
        if (live_blocks(h) != 0) { ret 10; }
        if (!check(h))           { ret 11; }
        ret 0;
    }

    test heap__a_block_above_the_largest_class_owns_its_span {
        ret each(case_a_block_above_the_largest_class_owns_its_span);
    }

    #[testing]
    fun case_reallocate_grows_across_classes_and_keeps_the_bytes(h: *Heap, a: *A.Allocator) i32 {
        var size:             usize             = 24;
        val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(a, size, 8);
        if (sel res_allocate_raw.err) { ret 2; }
        paint(res_allocate_raw.ok, size, 9);

        var p: ptr = res_allocate_raw.ok;
        for (size < MAX_SMALL * 4) {
            val next:     usize             = size * 2 + 1;
            val res_grew: res[ptr, A.Error] = A.reallocate_raw(a, p, size, next, 8);
            if (sel res_grew.err)   { ret 3; }
            if (res_grew.ok == nil) { ret 4; }

            # the prefix survives the move
            if (!painted(res_grew.ok, size, 9)) { ret 5; }
            paint(res_grew.ok, next, 9);

            p    = res_grew.ok;
            size = next;
            if (!check(h)) { ret 6; }
        }

        val err_gone: err[A.Error] = A.deallocate_raw(a, p, size, 8);
        if (sel err_gone.err)    { ret 7; }
        if (live_blocks(h) != 0) { ret 8; }
        if (!check(h))           { ret 9; }
        ret 0;
    }

    test heap__reallocate_grows_across_classes_and_keeps_the_bytes {
        ret each(case_reallocate_grows_across_classes_and_keeps_the_bytes);
    }

    #[testing]
    fun case_reallocate_shrinking_hands_the_class_back(h: *Heap, a: *A.Allocator) i32 {
        val res_big: res[ptr, A.Error] = A.allocate_raw(a, 4096, 8);
        if (sel res_big.err) { ret 2; }
        paint(res_big.ok, 4096, 13);

        val before: usize = live_bytes(h);
        if (before != 4096) { ret 3; }

        # a shrink to a fraction of the block relocates and returns the difference
        val res_small: res[ptr, A.Error] = A.reallocate_raw(a, res_big.ok, 4096, 100, 8);
        if (sel res_small.err)               { ret 4; }
        if (!painted(res_small.ok, 100, 13)) { ret 5; }
        if (live_bytes(h) >= before)         { ret 6; }
        if (live_bytes(h) != 112)            { ret 7; }
        if (!check(h))                       { ret 8; }

        val err_gone: err[A.Error] = A.deallocate_raw(a, res_small.ok, 100, 8);
        if (sel err_gone.err)   { ret 9; }
        if (live_bytes(h) != 0) { ret 10; }

        # a large block shrinking below the class ceiling lands in a class
        val res_huge: res[ptr, A.Error] = A.allocate_raw(a, 200000, 16);
        if (sel res_huge.err) { ret 11; }
        paint(res_huge.ok, 4096, 21);

        val res_cut: res[ptr, A.Error] = A.reallocate_raw(a, res_huge.ok, 200000, 300, 16);
        if (sel res_cut.err)               { ret 12; }
        if (!painted(res_cut.ok, 300, 21)) { ret 13; }
        if (live_bytes(h) != 320)          { ret 14; }
        if (!check(h))                     { ret 15; }

        val err_last: err[A.Error] = A.deallocate_raw(a, res_cut.ok, 300, 16);
        if (sel err_last.err)   { ret 16; }
        if (live_bytes(h) != 0) { ret 17; }
        ret 0;
    }

    test heap__reallocate_shrinking_hands_the_class_back {
        ret each(case_reallocate_shrinking_hands_the_class_back);
    }

    #[testing]
    fun case_reallocate_inside_a_class_stays_in_place(h: *Heap, a: *A.Allocator) i32 {
        val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(a, 200, 8);
        if (sel res_allocate_raw.err) { ret 2; }

        # 200 and 224 are the same class, so neither step moves the block
        val res_reallocate_raw: res[ptr, A.Error] = A.reallocate_raw(a, res_allocate_raw.ok, 200, 224, 8);
        if (sel res_reallocate_raw.err)                   { ret 3; }
        if (res_reallocate_raw.ok != res_allocate_raw.ok) { ret 4; }

        val res_down: res[ptr, A.Error] = A.reallocate_raw(a, res_reallocate_raw.ok, 224, 201, 8);
        if (sel res_down.err)                   { ret 5; }
        if (res_down.ok != res_allocate_raw.ok) { ret 6; }
        if (live_bytes(h) != 224)               { ret 7; }

        val err_gone: err[A.Error] = A.deallocate_raw(a, res_down.ok, 201, 8);
        if (sel err_gone.err) { ret 8; }
        if (!check(h))        { ret 9; }
        ret 0;
    }

    test heap__reallocate_inside_a_class_stays_in_place {
        ret each(case_reallocate_inside_a_class_stays_in_place);
    }

    #[testing]
    fun case_foreign_pointer_refused(ha: *Heap, aa: *A.Allocator) i32 {
        # the other heap stands on the host mapper whichever member ha is on
        var bed: Bed;
        var hb:  Heap;
        var ab:  A.Allocator;
        if (!heap_on(?bed, MEMBER_NATIVE, ?hb, ?ab)) { ret 2; }
        fin {
            dnit(?hb);
            bed_dnit(?bed);
        }

        val res_mine: res[ptr, A.Error] = A.allocate_raw(aa, 64, 8);
        if (sel res_mine.err) { ret 3; }

        val res_theirs: res[ptr, A.Error] = A.allocate_raw(?ab, 64, 8);
        if (sel res_theirs.err) { ret 4; }

        # another heap's block sits in a span this heap does not own
        val err_foreign: err[A.Error] = A.deallocate_raw(aa, res_theirs.ok, 64, 8);
        if (!sel err_foreign.err)              { ret 5; }
        if (!sel err_foreign.err.release)      { ret 6; }
        if (err_foreign.err.release != EINVAL) { ret 7; }

        # an address inside a block of this heap is not a block of this heap
        val err_interior: err[A.Error] =
            A.deallocate_raw(aa, (res_mine.ok::usize + 8)::ptr, 64, 8);
        if (!sel err_interior.err) { ret 8; }

        # the span header is not a block either
        val err_header: err[A.Error] =
            A.deallocate_raw(aa, span_of(res_mine.ok)::ptr, 64, 8);
        if (!sel err_header.err) { ret 9; }

        # a size larger than the block's class is a contract violation
        val err_oversize: err[A.Error] = A.deallocate_raw(aa, res_mine.ok, 4096, 8);
        if (!sel err_oversize.err) { ret 10; }

        # none of the refusals disturbed either heap
        if (!check(ha))            { ret 11; }
        if (!check(?hb))           { ret 12; }
        if (live_blocks(ha) != 1)  { ret 13; }
        if (live_blocks(?hb) != 1) { ret 14; }

        val err_a_gone: err[A.Error] = A.deallocate_raw(aa, res_mine.ok, 64, 8);
        if (sel err_a_gone.err) { ret 15; }
        val err_b_gone: err[A.Error] = A.deallocate_raw(?ab, res_theirs.ok, 64, 8);
        if (sel err_b_gone.err) { ret 16; }
        ret 0;
    }

    test heap__a_pointer_it_never_handed_out_is_refused {
        ret each(case_foreign_pointer_refused);
    }

    #[testing]
    fun case_an_empty_span_goes_back_for_another_class(h: *Heap, a: *A.Allocator) i32 {
        var kept: [8]ptr;
        var i:    usize = 0;
        for (i < 8) {
            val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(a, 16, 8);
            if (sel res_allocate_raw.err) { ret 2; }
            kept[i] = res_allocate_raw.ok;
            i       = i + 1;
        }

        val mapped: usize = mapped_bytes(h);
        if (mapped != SPAN_SIZE) { ret 3; }

        i = 0;
        for (i < 8) {
            val err_gone: err[A.Error] = A.deallocate_raw(a, kept[i], 16, 8);
            if (sel err_gone.err) { ret 4; }
            i = i + 1;
        }

        # the emptied span is held, not returned, and serves the next class asked for
        if (mapped_bytes(h) != mapped) { ret 5; }
        if (!check(h))                 { ret 6; }

        val res_other: res[ptr, A.Error] = A.allocate_raw(a, 4096, 8);
        if (sel res_other.err)         { ret 7; }
        if (mapped_bytes(h) != mapped) { ret 8; }
        if (!check(h))                 { ret 9; }

        val err_gone: err[A.Error] = A.deallocate_raw(a, res_other.ok, 4096, 8);
        if (sel err_gone.err) { ret 10; }
        ret 0;
    }

    test heap__an_empty_span_goes_back_for_another_class {
        ret each(case_an_empty_span_goes_back_for_another_class);
    }

    #[testing]
    fun case_zallocate_raw_zeroes_a_reused_block(h: *Heap, a: *A.Allocator) i32 {
        # a block off a fresh span is already zero
        val res_first: res[ptr, A.Error] = zallocate_raw(h, 300, 8);
        if (sel res_first.err) { ret 2; }
        var i: usize = 0;
        for (i < 300) {
            if ((res_first.ok::*u8)[i] != 0) { ret 3; }
            i = i + 1;
        }

        paint(res_first.ok, 300, 0x5A);
        val err_gone: err[A.Error] = A.deallocate_raw(a, res_first.ok, 300, 8);
        if (sel err_gone.err) { ret 4; }

        # the same block handed out again is zeroed explicitly
        val res_again: res[ptr, A.Error] = zallocate_raw(h, 300, 8);
        if (sel res_again.err)            { ret 5; }
        if (res_again.ok != res_first.ok) { ret 6; }
        i = 0;
        for (i < 300) {
            if ((res_again.ok::*u8)[i] != 0) { ret 7; }
            i = i + 1;
        }

        val err_last: err[A.Error] = A.deallocate_raw(a, res_again.ok, 300, 8);
        if (sel err_last.err) { ret 8; }
        if (!check(h))        { ret 9; }
        ret 0;
    }

    test heap__zallocate_raw_zeroes_a_reused_block {
        ret each(case_zallocate_raw_zeroes_a_reused_block);
    }

    #[testing]
    fun case_interleaved_mixed_sizes_keep_the_invariants(h: *Heap, a: *A.Allocator) i32 {
        val slots: usize = 512;
        var live:  [512]ptr;
        var sizes: [512]usize;
        var i:     usize = 0;
        for (i < slots) {
            live[i]  = nil;
            sizes[i] = 0;
            i        = i + 1;
        }

        var state: usize = 0x9E3779B97F4A7C15::u64::usize;
        var step:  usize = 0;
        for (step < 60000) {
            val slot: usize = rand(?state) % slots;
            val roll: usize = rand(?state) % 100;

            if (live[slot] != nil) {
                if (!painted(live[slot], sizes[slot], slot::u8)) { ret 2; }

                # a third of the revisits resize instead of releasing
                if (roll < 33) {
                    val next:     usize             = 1 + (rand(?state) % 9000);
                    val res_grew: res[ptr, A.Error] =
                        A.reallocate_raw(a, live[slot], sizes[slot], next, 16);
                    if (sel res_grew.err) { ret 3; }

                    var keep: usize = sizes[slot];
                    if (next < keep)                           { keep = next; }
                    if (!painted(res_grew.ok, keep, slot::u8)) { ret 4; }

                    live[slot]  = res_grew.ok;
                    sizes[slot] = next;
                    paint(res_grew.ok, next, slot::u8);
                    step = step + 1;
                    cnt;
                }

                val err_gone: err[A.Error] =
                    A.deallocate_raw(a, live[slot], sizes[slot], 16);
                if (sel err_gone.err) { ret 5; }
                live[slot]  = nil;
                sizes[slot] = 0;
                step        = step + 1;
                cnt;
            }

            var size: usize = 1 + (rand(?state) % 9000);
            if (roll < 5) { size = size * 40; }

            val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(a, size, 16);
            if (sel res_allocate_raw.err)   { ret 6; }
            if (res_allocate_raw.ok == nil) { ret 7; }
            paint(res_allocate_raw.ok, size, slot::u8);
            live[slot]  = res_allocate_raw.ok;
            sizes[slot] = size;
            step        = step + 1;
        }

        if (!check(h)) { ret 8; }

        i = 0;
        for (i < slots) {
            if (live[i] != nil) {
                if (!painted(live[i], sizes[i], i::u8)) { ret 9; }
                val err_gone: err[A.Error] = A.deallocate_raw(a, live[i], sizes[i], 16);
                if (sel err_gone.err) { ret 10; }
            }
            i = i + 1;
        }

        if (!check(h))           { ret 11; }
        if (live_bytes(h) != 0)  { ret 12; }
        if (live_blocks(h) != 0) { ret 13; }
        ret 0;
    }

    test heap__interleaved_mixed_sizes_keep_the_invariants {
        ret each(case_interleaved_mixed_sizes_keep_the_invariants);
    }

    # a grow-only span source: it hands out spans from one region and can never
    # take one back, which is the shape a wasm `memory.grow` host has
    #[testing]
    rec Grow {
        next: usize;
        end:  usize;
    }

    #[testing]
    fun grow_obtain(ctx: ptr, least: usize, most: usize) opt[Grant] {
        val g:  *Grow = ctx::*Grow;
        val at: usize = align_up(g.next, SPAN_ALIGN);
        if (at + least > g.end) { ret opt[Grant].none{}; }
        g.next = at + least;
        ret opt[Grant].some{Grant{base: at::ptr, size: least}};
    }

    #[testing]
    fun grow_source(s: *Source, g: *Grow, region: ptr, size: usize) {
        g.next       = region::usize;
        g.end        = region::usize + size;
        s.ctx        = g::ptr;
        s.fn_obtain  = grow_obtain;
        s.fn_release = nil;
    }

    test heap__a_source_that_cannot_release_keeps_its_spans {
        val bytes:  usize = SPAN_SIZE * 8;
        val region: ptr   = os.allocate(bytes);
        if (region == nil) { ret 1; }
        fin { os.deallocate(region, bytes); }

        var g: Grow;
        var s: Source;
        grow_source(?s, ?g, region, bytes);

        var h: Heap;
        # a budget of one byte: a source that could release would release here
        val err_heap_made: err[A.Error] = init(?h, ?s, 1);
        if (sel err_heap_made.err) { ret 2; }

        var a:                  A.Allocator;
        val err_allocator_made: err[A.Error] = allocator(?a, ?h);
        if (sel err_allocator_made.err) { ret 3; }

        var kept: [8]ptr;
        var i:    usize = 0;
        for (i < 8) {
            val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(?a, 16, 8);
            if (sel res_allocate_raw.err) { ret 4; }
            kept[i] = res_allocate_raw.ok;
            i       = i + 1;
        }

        val mapped: usize = mapped_bytes(?h);
        if (mapped != SPAN_SIZE) { ret 5; }

        i = 0;
        for (i < 8) {
            val err_gone: err[A.Error] = A.deallocate_raw(?a, kept[i], 16, 8);
            if (sel err_gone.err) { ret 6; }
            i = i + 1;
        }

        # the span is held past the budget, because the source has nowhere to
        # put it, and serves the next class instead of a fresh grow
        if (mapped_bytes(?h) != mapped) { ret 7; }
        if (!check(?h))                 { ret 8; }

        val res_other: res[ptr, A.Error] = A.allocate_raw(?a, 2048, 8);
        if (sel res_other.err)          { ret 9; }
        if (mapped_bytes(?h) != mapped) { ret 10; }

        val err_gone: err[A.Error] = A.deallocate_raw(?a, res_other.ok, 2048, 8);
        if (sel err_gone.err) { ret 11; }
        if (!check(?h))       { ret 12; }

        val err_dnit: err[A.Error] = dnit(?h);
        if (sel err_dnit.err) { ret 13; }
        ret 0;
    }

    # a source that breaks the base contract: pages, but not SPAN_ALIGN
    #[testing]
    rec Skewed {
        region:   ptr;
        bytes:    usize;
        obtained: usize;
        released: ptr;
    }

    #[testing]
    fun skewed_obtain(ctx: ptr, least: usize, most: usize) opt[Grant] {
        val k: *Skewed = ctx::*Skewed;
        if (least + os.page_size() > k.bytes) { ret opt[Grant].none{}; }
        k.obtained = k.obtained + 1;
        ret opt[Grant].some{Grant{base: (align_up(k.region::usize, SPAN_ALIGN) + os.page_size())::ptr, size: least}};
    }

    #[testing]
    fun skewed_release(ctx: ptr, span: ptr, size: usize) i64 {
        val k: *Skewed = ctx::*Skewed;
        k.released = span;
        ret 0;
    }

    test heap__a_span_off_the_span_align_grid_is_handed_back_and_refused {
        var k: Skewed;
        k.bytes    = SPAN_SIZE * 3;
        k.region   = os.allocate(k.bytes);
        k.obtained = 0;
        k.released = nil;
        if (k.region == nil) { ret 1; }
        fin { os.deallocate(k.region, k.bytes); }

        var s: Source;
        s.ctx        = (?k)::ptr;
        s.fn_obtain  = skewed_obtain;
        s.fn_release = skewed_release;

        var h:             Heap;
        val err_heap_made: err[A.Error] = init(?h, ?s, 0);
        if (sel err_heap_made.err) { ret 2; }
        fin { dnit(?h); }

        var a:                  A.Allocator;
        val err_allocator_made: err[A.Error] = allocator(?a, ?h);
        if (sel err_allocator_made.err) { ret 3; }

        val res_small: res[ptr, A.Error] = A.allocate_raw(?a, 64, 8);
        if (!sel res_small.err)           { ret 4; }
        if (!sel res_small.err.exhausted) { ret 5; }

        # the span went back to the source before the refusal was reported
        if (k.obtained != 1)       { ret 6; }
        if (k.released == nil)     { ret 7; }
        if (mapped_bytes(?h) != 0) { ret 8; }
        if (live_blocks(?h) != 0)  { ret 9; }
        if (!check(?h))            { ret 10; }

        val res_large: res[ptr, A.Error] = A.allocate_raw(?a, MAX_SMALL * 2, 8);
        if (!sel res_large.err)    { ret 11; }
        if (k.obtained != 2)       { ret 12; }
        if (mapped_bytes(?h) != 0) { ret 13; }
        ret 0;
    }

    test heap__an_exhausted_source_is_reported_as_a_refusal {
        val bytes:  usize = SPAN_SIZE * 3;
        val region: ptr   = os.allocate(bytes);
        if (region == nil) { ret 1; }
        fin { os.deallocate(region, bytes); }

        var g: Grow;
        var s: Source;
        grow_source(?s, ?g, region, bytes);

        var h:             Heap;
        val err_heap_made: err[A.Error] = init(?h, ?s, 0);
        if (sel err_heap_made.err) { ret 2; }
        fin { dnit(?h); }

        var a:                  A.Allocator;
        val err_allocator_made: err[A.Error] = allocator(?a, ?h);
        if (sel err_allocator_made.err) { ret 3; }

        # one class span per class drains the region after three classes
        var refused: bool  = false;
        var c:       usize = 0;
        for (c < 8) {
            val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(?a, CLASS_SIZE[c], 8);
            if (sel res_allocate_raw.err) {
                if (!sel res_allocate_raw.err.exhausted) { ret 4; }
                refused = true;
                brk;
            }
            c = c + 1;
        }

        if (!refused)   { ret 5; }
        if (!check(?h)) { ret 6; }

        # a refusal leaves the heap usable for a size it can still serve
        val res_again: res[ptr, A.Error] = A.allocate_raw(?a, CLASS_SIZE[0], 8);
        if (sel res_again.err) { ret 7; }
        val err_gone: err[A.Error] = A.deallocate_raw(?a, res_again.ok, CLASS_SIZE[0], 8);
        if (sel err_gone.err) { ret 8; }
        if (!check(?h))       { ret 9; }

        # a padding source refuses a span whose padding would pass the top of usize
        val padded: [2]usize = [2]usize{MEMBER_NATIVE, MEMBER_WEAK};
        var k:      usize    = 0;
        for (k < 2) {
            var bed: Bed;
            var nh:  Heap;
            var na:  A.Allocator;
            if (!heap_on(?bed, padded[k], ?nh, ?na)) { ret 10; }
            val res_vast: res[ptr, A.Error] = A.allocate_raw(?na, ~(0::usize) - 8192, 8);
            val held:     usize             = mapped_bytes(?nh);
            if (!sel res_vast.err)           { ret 11; }
            if (!sel res_vast.err.exhausted) { ret 11; }
            if (held != 0)                   { ret 12; }
            dnit(?nh);
            bed_dnit(?bed);
            k = k + 1;
        }
        ret 0;
    }

    # spans come from the region in address order on the SPAN_ALIGN grid, zeroed over
    # whatever the region held, and a request past what is left is refused, a grid
    # point past the end of the region included
    test heap__a_region_source_carves_zeroed_spans_on_the_grid_until_it_runs_out {
        val bytes: usize = SPAN_ALIGN * 4;
        val map:   ptr   = os.allocate(bytes);
        if (map == nil) { ret 1; }
        fin { os.deallocate(map, bytes); }
        memory.raw_fill(map, 0xAA, bytes);

        var r:    Region;
        var s:    Source;
        val base: usize = map::usize + 100;
        region_source(?s, ?r, base::ptr, SPAN_ALIGN * 3);
        if (s.fn_release != nil) { ret 2; }

        val opt_whole: opt[Grant] = s.fn_obtain(s.ctx, SPAN_ALIGN * 3, SPAN_ALIGN * 3);
        if (sel opt_whole.some) { ret 3; }
        val opt_first: opt[Grant] = s.fn_obtain(s.ctx, SPAN_ALIGN, SPAN_ALIGN * 2);
        if (sel opt_first.none) { ret 4; }
        val first: usize = opt_first.some.base::usize;
        if (first < base || first % SPAN_ALIGN != 0 || opt_first.some.size != SPAN_ALIGN) { ret 4; }
        var i: usize = 0;
        for (i < SPAN_ALIGN) {
            if ((first::*u8)[i] != 0) { ret 5; }
            i = i + 1;
        }
        val opt_second: opt[Grant] = s.fn_obtain(s.ctx, SPAN_ALIGN, SPAN_ALIGN);
        if (sel opt_second.none)                               { ret 6; }
        if (opt_second.some.base::usize != first + SPAN_ALIGN) { ret 6; }

        # less than a span is left past the next grid point, and one byte taken
        # there leaves the grid point after it outside the region
        val opt_third: opt[Grant] = s.fn_obtain(s.ctx, SPAN_ALIGN, SPAN_ALIGN);
        if (sel opt_third.some) { ret 7; }
        val opt_byte: opt[Grant] = s.fn_obtain(s.ctx, 1, 1);
        if (sel opt_byte.none) { ret 8; }
        val opt_past: opt[Grant] = s.fn_obtain(s.ctx, 1, 1);
        if (sel opt_past.some) { ret 9; }
        ret 0;
    }

    # a span given back to a pool is held at its size and granted whole to the next
    # request whose range takes it, the smallest that fits. a span given back past
    # the budget sends the spans held longest back to the source, and a pooled span
    # is stale, so zallocate_raw zeroes what was written to it
    test heap__a_pool_grants_the_smallest_held_span_in_range_within_its_budget_and_stale {
        val one:    usize = SPAN_SIZE;
        val two:    usize = SPAN_SIZE * 2;
        var native: Source;
        native_source(?native);
        var pool:          Pool;
        val err_pool_made: err[A.Error] = pool_init(?pool, ?native, one * 3);
        if (sel err_pool_made.err) { ret 1; }
        fin { pool_dnit(?pool); }
        var ps: Source;
        pool_source(?ps, ?pool);
        if (!ps.stale) { ret 2; }

        val opt_wide: opt[Grant] = ps.fn_obtain(ps.ctx, two, two);
        if (sel opt_wide.none)         { ret 3; }
        if (opt_wide.some.size != two) { ret 3; }
        val opt_narrow: opt[Grant] = ps.fn_obtain(ps.ctx, one, one);
        if (sel opt_narrow.none)                                                           { ret 3; }
        if (opt_narrow.some.size != one)                                                   { ret 3; }
        if (ps.fn_release(ps.ctx, opt_wide.some.base, two) != 0 || pool.held != two)       { ret 4; }
        if (ps.fn_release(ps.ctx, opt_narrow.some.base, one) != 0 || pool.held != one * 3) { ret 4; }

        # the narrow span is under the range and the wide one in it, granted at its size
        val opt_ranged: opt[Grant] = ps.fn_obtain(ps.ctx, one + PAGE_FLOOR, two);
        if (sel opt_ranged.none)                                                       { ret 5; }
        if (opt_ranged.some.base != opt_wide.some.base || opt_ranged.some.size != two) { ret 5; }
        if (pool.held != one)                                                          { ret 5; }

        # no held span is in range, so the source grants a fresh one
        val opt_fresh: opt[Grant] = ps.fn_obtain(ps.ctx, two, two);
        if (sel opt_fresh.none) { ret 6; }
        if (pool.held != one)   { ret 6; }

        # the second wide span given back passes the budget, so the narrow span and
        # the first wide one, held longest, go back to the source
        if (ps.fn_release(ps.ctx, opt_ranged.some.base, two) != 0 || pool.held != one * 3) { ret 7; }
        if (ps.fn_release(ps.ctx, opt_fresh.some.base, two) != 0 || pool.held != two)      { ret 8; }
        val opt_again: opt[Grant] = ps.fn_obtain(ps.ctx, two, two);
        if (sel opt_again.none)                                           { ret 9; }
        if (opt_again.some.base != opt_fresh.some.base || pool.held != 0) { ret 9; }
        paint(opt_again.some.base, two, 0x5A);
        if (ps.fn_release(ps.ctx, opt_again.some.base, two) != 0) { ret 10; }

        # a block that spares up to an eighth of its span takes the painted one,
        # and uses only what it asked for
        var h:             Heap;
        val err_heap_made: err[A.Error] = init(?h, ?ps, 0);
        if (sel err_heap_made.err) { ret 11; }
        fin { dnit(?h); }
        val size:       usize             = two - two / 8;
        val res_zeroed: res[ptr, A.Error] = zallocate_raw(?h, size, 16);
        if (sel res_zeroed.err) { ret 12; }
        val at: usize = res_zeroed.ok::usize;
        if (at < opt_again.some.base::usize || at >= opt_again.some.base::usize + two) { ret 13; }
        if (mapped_bytes(?h) < size || mapped_bytes(?h) >= two)                        { ret 14; }
        var i: usize = 0;
        for (i < size) {
            if ((res_zeroed.ok::*u8)[i] != 0) { ret 15; }
            i = i + 1;
        }
        ret 0;
    }

    #[testing]
    rec Share {
        a:     *A.Allocator;
        seed:  usize;
        fault: i64;
    }

    #[testing]
    fun share_worker(arg: *u8) {
        val w: *Share = arg::*Share;

        var kept:  [32]ptr;
        var sizes: [32]usize;
        var i:     usize = 0;
        for (i < 32) {
            kept[i]  = nil;
            sizes[i] = 0;
            i        = i + 1;
        }

        var state: usize = w.seed;
        var step:  usize = 0;
        for (step < 20000) {
            val slot: usize = rand(?state) % 32;
            val seed: u8    = (w.seed + slot)::u8;

            if (kept[slot] != nil) {
                if (!painted(kept[slot], sizes[slot], seed)) {
                    w.fault = 1;
                    ret;
                }
                val err_gone: err[A.Error] =
                    A.deallocate_raw(w.a, kept[slot], sizes[slot], 16);
                if (sel err_gone.err) {
                    w.fault = 2;
                    ret;
                }
                kept[slot]  = nil;
                sizes[slot] = 0;
                step        = step + 1;
                cnt;
            }

            val size:             usize             = 1 + (rand(?state) % 3000);
            val res_allocate_raw: res[ptr, A.Error] = A.allocate_raw(w.a, size, 16);
            if (sel res_allocate_raw.err) {
                w.fault = 3;
                ret;
            }
            paint(res_allocate_raw.ok, size, seed);
            kept[slot]  = res_allocate_raw.ok;
            sizes[slot] = size;
            step        = step + 1;
        }

        i = 0;
        for (i < 32) {
            if (kept[i] != nil) {
                val seed: u8 = (w.seed + i)::u8;
                if (!painted(kept[i], sizes[i], seed)) {
                    w.fault = 4;
                    ret;
                }
                val err_gone: err[A.Error] =
                    A.deallocate_raw(w.a, kept[i], sizes[i], 16);
                if (sel err_gone.err) {
                    w.fault = 5;
                    ret;
                }
            }
            i = i + 1;
        }
    }

    #[testing]
    fun case_threads_share_one_heap_without_corrupting_it(h: *Heap, a: *A.Allocator) i32 {
        var work:    [4]Share;
        var threads: [4]thread.Thread;

        var i: usize = 0;
        for (i < 4) {
            work[i].a     = a;
            work[i].seed  = 0x2545F4914F6CDD1D::u64::usize + i * 7919;
            work[i].fault = 0;
            val err_spawn_with: thread.Operation = thread.spawn_with(share_worker, (?work[i])::*u8, ?threads[i]);
            if (sel err_spawn_with.err) { ret 2; }
            i = i + 1;
        }

        i = 0;
        for (i < 4) {
            val err_down: thread.Operation = thread.join(?threads[i]);
            if (sel err_down.err)   { ret 3; }
            if (work[i].fault != 0) { ret 4; }
            i = i + 1;
        }

        if (!check(h))           { ret 5; }
        if (live_blocks(h) != 0) { ret 6; }
        if (live_bytes(h) != 0)  { ret 7; }
        ret 0;
    }

    test heap__threads_share_one_heap_without_corrupting_it {
        ret each(case_threads_share_one_heap_without_corrupting_it);
    }
}
