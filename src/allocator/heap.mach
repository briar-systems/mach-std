# general-purpose size-class heap
#
# small requests are rounded up to a size class and carved from a span that
# serves that one class. every span keeps its own free list, so a release is
# a push and an acquire is a pop. a span that runs empty goes back to a cache
# shared by all classes, which is what lets a class give memory back to
# another class. requests above the largest class get a span of their own.
#
# the backing memory comes from a `Source`, a two-call contract the core never
# looks past. the native member maps and unmaps; a grow-only member (wasm
# `memory.grow`) leaves `fn_release` nil and the core retains spans instead of
# returning them. the core never assumes memory can come back.
#
# a Heap is safe to share between threads: one lock covers the core.
#
# it satisfies the std.allocator interface, so it drops in wherever an Allocator
# is taken:
#
#   var src: heap.Source;
#   var h:   heap.Heap;
#   var a:   allocator.Allocator;
#   heap.native_source(?src);
#   heap.init(?h, ?src, 0);
#   heap.make(?a, ?h);
#
# requests up to MAX_SMALL (8 KiB) round to one of 32 classes carved from
# 64 KiB spans. a larger request gets a span sized to the request.
#
# alignment is honoured for every request. a small request aligned beyond 16
# bytes is served by the first class that is a multiple of it, and one aligned
# beyond a span is placed by address in a span of its own. a resize stays in
# place while the block still holds the request and uses at least half of it,
# and otherwise moves to the right class and copies the overlap.
#
# zallocate_raw skips zeroing for a block carved from a region the source
# delivered zero-filled, and zeroes anything reused.
#
# native_source maps through the platform, and allocator_source draws spans
# from another Allocator. init's budget bounds the retained empty spans. a heap
# over a source that cannot release keeps them past the budget, because there
# is nowhere else for them to go.
#
# the span header, not the caller's arguments, decides a block's class. a size
# larger than the block's class is refused. releasing a pointer this heap never
# handed out is refused as allocator.Error.release(-22): the heap checks that
# the address starts a block in a span it owns, so another heap's pointer, an
# interior address or a span header is rejected without disturbing the heap.
# this is detection, not a guarantee: a pointer into an unrelated mapping can
# fault when the heap probes for a span header, as with any allocator. check
# walks every span and verifies the heap's own invariants.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.memory;
use std.system.capability;

$if (capability.HAS_PAGES) {
    use std.allocator.fixed;
    use std.allocator.page;
    use std.allocator.testing;
    use std.sync.mutex;
    use std.sync.thread;
    use std.system.os;
}
$or {
    $error("std.allocator.heap needs the pages capability (std.system.capability.HAS_PAGES)");
}

# where a heap's backing memory comes from
#
# fn_obtain(ctx, size) returns a span of exactly `size` bytes, zero-filled,
# at an address that is a multiple of SPAN_ALIGN. `size` is always a multiple
# of the host page size.
#
# fn_release(ctx, span, size) returns a span obtained earlier, 0 on success or
# a negative backend native code. it is nil for a source that cannot return memory; the core
# then retains every span for reuse and never calls it.
# ---
# ctx:        opaque context passed to both callbacks
# fn_obtain:  acquire a span, or none when the source is exhausted
# fn_release: return a span, or nil when the source cannot reclaim
pub rec Source {
    ctx:        ptr;
    fn_obtain:  fun(ptr, usize) opt[ptr];
    fn_release: fun(ptr, ptr, usize) i64;
}

# number of small size classes
pub val CLASS_COUNT: usize = 32;

# largest request served from a size class
pub val MAX_SMALL: usize = 8192;

# span size for size-class spans, and the address granularity of every span
pub val SPAN_SIZE:  usize = 65536;
pub val SPAN_ALIGN: usize = 65536;

# default byte budget for retained empty spans
pub val DEFAULT_CACHE: usize = 4194304;

# class index reserved for a block that owns its span
val CLASS_LARGE: usize = 32;

# alignment every size class satisfies without being widened
val MIN_ALIGN: usize = 16;

val SPAN_MAGIC: usize = 0x48454150534E3031;

# status returned for a pointer this heap did not hand out
val EINVAL: i64 = -22;

val CLASS_SIZE: [32]usize = [32]usize{
    16, 32, 48, 64, 80, 96, 112, 128,
    160, 192, 224, 256, 320, 384, 448, 512,
    640, 768, 896, 1024, 1280, 1536, 1792, 2048,
    2560, 3072, 3584, 4096, 5120, 6144, 7168, 8192
};

# header at the base of every span
#
# the header is the span's identity: the class it serves, the blocks handed
# out of it and the free list of blocks returned to it. a small block's span
# is found by masking its address down to SPAN_ALIGN, so the header is the one
# authority on a block's class and `size` arguments are only cross-checked
# against it.
# ---
# magic:  SPAN_MAGIC once initialized
# owner:  heap the span belongs to
# class:  size class index, or CLASS_LARGE for a span holding one block
# size:   total span bytes as obtained from the source
# data:   offset of the first block
# cap:    block count for a class span, payload bytes for a large span
# used:   live blocks
# bump:   offset past the last block ever carved
# free:   head of the intrusive free list of returned blocks
# zeroed: the region past `bump` is still as the source delivered it
# next:   next span in whichever list holds it
# prev:   previous span in whichever list holds it
rec Span {
    magic:  usize;
    owner:  ptr;
    class:  usize;
    size:   usize;
    data:   usize;
    cap:    usize;
    used:   usize;
    bump:   usize;
    free:   ptr;
    zeroed: usize;
    next:   *Span;
    prev:   *Span;
}

# size-class heap state
#
# `partial` holds spans of a class with a block to give, `full` the rest.
# `spans` caches empty class spans for any class, `cache` freed large spans,
# and `large` and `huge` track live spans that own a single block. a heap is
# initialized once and then shared; every field below is under `lock`.
# ---
# src:     span source
# lock:    covers the whole core
# partial: per class, spans with a free block
# full:    per class, spans with none
# spans:   empty class spans held for reuse
# cache:   freed large spans held for reuse
# large:   live spans holding one block reachable by address masking
# huge:    live spans holding one block aligned past SPAN_ALIGN
# held:    bytes in `spans` and `cache`
# budget:  byte ceiling for `held` before a span is handed back to the source
# live:    bytes in live blocks, counted as class size or payload capacity
# mapped:  bytes obtained from the source and not yet released
# peak:    high water mark of `mapped`
# blocks:  live block count
pub rec Heap {
    src:  Source;
    lock: mutex.Mutex;

    partial: [32]*Span;
    full:    [32]*Span;

    spans: *Span;
    cache: *Span;
    large: *Span;
    huge:  *Span;

    held:   usize;
    budget: usize;

    live:   usize;
    mapped: usize;
    peak:   usize;
    blocks: usize;

    idx_small: [64]u8;
    idx_mid:   [64]u8;
}

fun align_up(value: usize, align: usize) usize {
    val mask: usize = align - 1;
    ret (value + mask) & ~mask;
}

# the largest power of two dividing a class size, which is the alignment every
# block of that class carries once the first block starts there
fun granularity(size: usize) usize {
    ret size & (0 - size);
}

fun span_header_size() usize {
    ret align_up($size_of(Span), 64);
}

# offset of the first block of a class span
fun class_data_offset(class_size: usize) usize {
    ret align_up(span_header_size(), granularity(class_size));
}

# the span a block belongs to, for every block whose alignment is below
# SPAN_ALIGN
fun span_of(p: ptr) *Span {
    ret ((p::usize) & ~(SPAN_ALIGN - 1))::*Span;
}

fun list_push(head: **Span, s: *Span) {
    s.prev = nil;
    s.next = @head;
    if (@head != nil) { (@head).prev = s; }
    @head = s;
}

fun list_remove(head: **Span, s: *Span) {
    if (s.prev != nil) { s.prev.next = s.next; }
    or                 { @head = s.next; }
    if (s.next != nil) { s.next.prev = s.prev; }
    s.next = nil;
    s.prev = nil;
}

# smallest class index that serves `size` bytes at `align`, or CLASS_LARGE
fun class_of(h: *Heap, size: usize, align: usize) usize {
    if (size > MAX_SMALL) { ret CLASS_LARGE; }

    var c: usize = 0;
    if (size <= 1024) { c = h.idx_small[(size - 1) >> 4]::usize; }
    or                { c = h.idx_mid[(size - 1) >> 7]::usize; }

    # a class serves an alignment only when its size is a multiple of it, since
    # blocks sit at multiples of the class size from an aligned span base
    if (align > MIN_ALIGN) {
        for (c < CLASS_COUNT && (CLASS_SIZE[c] & (align - 1)) != 0) { c = c + 1; }
        if (c >= CLASS_COUNT) { ret CLASS_LARGE; }
    }

    ret c;
}

fun obtain(h: *Heap, size: usize) *Span {
    if (h.src.fn_obtain == nil) { ret nil; }

    val got: opt[ptr] = h.src.fn_obtain(h.src.ctx, size);
    if (!sel got.some) { ret nil; }

    # the base is the contract the small-block lookup is built on, so a
    # span that breaks it is handed straight back and the request refused
    if ((got.some::usize & (SPAN_ALIGN - 1)) != 0) {
        if (h.src.fn_release != nil) { h.src.fn_release(h.src.ctx, got.some, size); }
        ret nil;
    }

    val s: *Span = got.some::*Span;
    s.magic  = SPAN_MAGIC;
    s.owner  = h::ptr;
    s.size   = size;
    s.zeroed = 1;
    s.free   = nil;
    s.used   = 0;
    s.next   = nil;
    s.prev   = nil;

    h.mapped = h.mapped + size;
    if (h.mapped > h.peak) { h.peak = h.mapped; }

    ret s;
}

# hand a span back to the source, or keep it when the source cannot reclaim
fun release(h: *Heap, s: *Span) i64 {
    if (h.src.fn_release == nil) { ret 0; }

    val size: usize = s.size;
    s.magic = 0;
    val code: i64 = h.src.fn_release(h.src.ctx, s::ptr, size);
    if (code != 0) {
        s.magic = SPAN_MAGIC;
        ret code;
    }

    h.mapped = h.mapped - size;
    ret 0;
}

# retire an empty class span: hold it for any class, or give it back once the
# cache is over budget. a source that cannot reclaim keeps it regardless,
# which is the only shape a grow-only host can have.
fun retire_span(h: *Heap, s: *Span) {
    if (h.held + s.size <= h.budget || h.src.fn_release == nil) {
        s.used   = 0;
        s.free   = nil;
        s.bump   = 0;
        s.zeroed = 0;
        list_push(?h.spans, s);
        h.held = h.held + s.size;
        ret;
    }

    release(h, s);
}

# retire a large span the same way, keyed by its own size
fun retire_large(h: *Heap, s: *Span) {
    if (h.held + s.size <= h.budget || h.src.fn_release == nil) {
        s.used   = 0;
        s.zeroed = 0;
        list_push(?h.cache, s);
        h.held = h.held + s.size;
        ret;
    }

    release(h, s);
}

# a fresh span for a class, from the cache when one is held
fun span_for_class(h: *Heap, c: usize) *Span {
    val class_size: usize = CLASS_SIZE[c];

    var s: *Span = h.spans;
    if (s != nil) {
        list_remove(?h.spans, s);
        h.held = h.held - s.size;
    }
    or {
        s = obtain(h, SPAN_SIZE);
        if (s == nil) { ret nil; }
    }

    s.class = c;
    s.data  = class_data_offset(class_size);
    s.cap   = (s.size - s.data) / class_size;
    s.used  = 0;
    s.bump  = s.data;
    s.free  = nil;

    list_push(?h.partial[c], s);
    ret s;
}

# take one block of class c, reporting whether it is still source-zeroed
fun take_small(h: *Heap, c: usize, zeroed: *bool) ptr {
    var s: *Span = h.partial[c];
    if (s == nil) {
        s = span_for_class(h, c);
        if (s == nil) { ret nil; }
    }

    val class_size: usize = CLASS_SIZE[c];
    var p:          ptr   = nil;

    if (s.free != nil) {
        p       = s.free;
        s.free  = (@(p::*usize))::ptr;
        @zeroed = false;
    }
    or {
        p       = (s::usize + s.bump)::ptr;
        s.bump  = s.bump + class_size;
        @zeroed = s.zeroed != 0;
    }

    s.used = s.used + 1;
    if (s.used == s.cap) {
        list_remove(?h.partial[c], s);
        list_push(?h.full[c], s);
    }

    h.live   = h.live + class_size;
    h.blocks = h.blocks + 1;
    ret p;
}

# take a span holding a single block of `size` bytes at `align`
fun take_large(h: *Heap, size: usize, align: usize, zeroed: *bool) ptr {
    var want: usize = align;
    if (want < MIN_ALIGN) { want = MIN_ALIGN; }

    val page: usize = os.page_size();

    # the source promises a base at SPAN_ALIGN and the header is smaller
    # than that, so a payload offset of at most `want` always fits, for an
    # alignment above SPAN_ALIGN too
    val head: usize = align_up(span_header_size(), want);

    # refuse a request whose span geometry would wrap usize
    if (head < want)              { ret nil; }
    if (size > (0 - head) - page) { ret nil; }

    val total: usize = align_up(head + size, page);
    var data:  usize = head;

    var s: *Span = nil;

    # reuse a cached span when the block fits and does not waste half of it
    if (want < SPAN_ALIGN) {
        var c: *Span = h.cache;
        for (c != nil) {
            if (c.size >= total && total * 2 >= c.size) {
                list_remove(?h.cache, c);
                h.held = h.held - c.size;
                s      = c;
                brk;
            }
            c = c.next;
        }
    }

    if (s == nil) {
        s = obtain(h, total);
        if (s == nil) { ret nil; }
        @zeroed = true;
    }
    or {
        @zeroed = false;
    }

    # the payload is placed by address, since only the span base is promised
    # aligned and an over-aligned block needs more than that
    if (want > SPAN_ALIGN) {
        data = align_up(s::usize + span_header_size(), want) - s::usize;
    }

    s.class = CLASS_LARGE;
    s.data  = data;
    s.cap   = s.size - data;
    s.used  = 1;
    s.bump  = s.size;
    s.free  = nil;

    if (want >= SPAN_ALIGN) { list_push(?h.huge, s); }
    or                      { list_push(?h.large, s); }

    h.live   = h.live + s.cap;
    h.blocks = h.blocks + 1;
    ret (s::usize + data)::ptr;
}

# the span holding p, or nil when p is not a block of this heap
#
# alignment decides the lookup: a block aligned below SPAN_ALIGN is found by
# masking its address down to its span header, and one aligned at or above it
# masks down to its own payload, so those are tracked in a list instead.
fun find_span(h: *Heap, p: ptr, align: usize) *Span {
    if (align >= SPAN_ALIGN) {
        var s: *Span = h.huge;
        for (s != nil) {
            if ((s::usize + s.data)::ptr == p) { ret s; }
            s = s.next;
        }
        ret nil;
    }

    val s: *Span = span_of(p);
    if (s.magic != SPAN_MAGIC) { ret nil; }
    if (s.owner != h::ptr)     { ret nil; }
    ret s;
}

# release a block back to its span, unwinding the span when it runs empty
fun give_back(h: *Heap, s: *Span, p: ptr, size: usize) i64 {
    if (s.class == CLASS_LARGE) {
        if ((s::usize + s.data)::ptr != p) { ret EINVAL; }
        if (size > s.cap)                  { ret EINVAL; }

        if (s.data >= SPAN_ALIGN) { list_remove(?h.huge, s); }
        or                        { list_remove(?h.large, s); }

        h.live   = h.live - s.cap;
        h.blocks = h.blocks - 1;
        retire_large(h, s);
        ret 0;
    }

    val class_size: usize = CLASS_SIZE[s.class];
    val off:        usize = p::usize - s::usize;

    # the block must be one this span carved, not an interior address
    if (off < s.data || off >= s.bump)    { ret EINVAL; }
    if ((off - s.data) % class_size != 0) { ret EINVAL; }
    if (size > class_size)                { ret EINVAL; }
    if (s.used == 0)                      { ret EINVAL; }

    @(p::*usize) = s.free::usize;
    s.free = p;

    if (s.used == s.cap) {
        list_remove(?h.full[s.class], s);
        list_push(?h.partial[s.class], s);
    }
    s.used = s.used - 1;

    h.live   = h.live - class_size;
    h.blocks = h.blocks - 1;

    if (s.used == 0) {
        list_remove(?h.partial[s.class], s);
        retire_span(h, s);
    }

    ret 0;
}

fun do_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }
    if (size == 0)  { ret opt[ptr].some{nil}; }

    val h: *Heap = ctx::*Heap;
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }

    var zeroed: bool = false;
    val p:      ptr  = take(h, size, align, ?zeroed);
    if (p == nil) { ret opt[ptr].none{}; }
    ret opt[ptr].some{p};
}

# acquire a block of `size` bytes at `align`, under the lock
fun take(h: *Heap, size: usize, align: usize, zeroed: *bool) ptr {
    val c: usize = class_of(h, size, align);
    if (c == CLASS_LARGE) { ret take_large(h, size, align, zeroed); }
    ret take_small(h, c, zeroed);
}

fun do_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (ctx == nil) { ret EINVAL; }
    if (p == nil)   { ret 0; }

    val h: *Heap = ctx::*Heap;
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }

    val s: *Span = find_span(h, p, align);
    if (s == nil) { ret EINVAL; }
    ret give_back(h, s, p, size);
}

fun do_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (ctx == nil) { ret opt[ptr].none{}; }
    if (p == nil)   { ret do_allocate(ctx, new_size, align); }

    val h: *Heap = ctx::*Heap;

    if (new_size == 0) {
        val code: i64 = do_deallocate(ctx, p, old_size, align);
        if (code != 0) { ret opt[ptr].none{}; }
        ret opt[ptr].some{nil};
    }

    mutex.lock(?h.lock);

    val s: *Span = find_span(h, p, align);
    if (s == nil) {
        mutex.unlock(?h.lock);
        ret opt[ptr].none{};
    }

    # capacity of the block as its span sees it, which outranks old_size
    var room: usize = s.cap;
    if (s.class != CLASS_LARGE) { room = CLASS_SIZE[s.class]; }

    # in place while the request still fits and either keeps its class or
    # still uses half the block, so a caller that walks a size up and down
    # does not copy on every step
    val want: usize = class_of(h, new_size, align);
    if (new_size <= room) {
        val keeps: bool = s.class != CLASS_LARGE && want == s.class;
        if (keeps || new_size * 2 > room) {
            mutex.unlock(?h.lock);
            ret opt[ptr].some{p};
        }
    }

    var zeroed: bool = false;
    val fresh:  ptr  = take(h, new_size, align, ?zeroed);
    if (fresh == nil) {
        mutex.unlock(?h.lock);
        ret opt[ptr].none{};
    }

    var copy: usize = old_size;
    if (copy > room)     { copy = room; }
    if (new_size < copy) { copy = new_size; }
    memory.raw_copy(fresh, p, copy);

    val code: i64 = give_back(h, s, p, old_size);
    mutex.unlock(?h.lock);
    if (code != 0) { ret opt[ptr].none{}; }

    ret opt[ptr].some{fresh};
}

# initialize a Heap over a span source
#
# the source is copied into the heap, so the caller's Source may be discarded;
# whatever the source's ctx points at must outlive the heap.
# ---
# h:      Heap to initialize
# src:    span source the heap draws from
# budget: byte ceiling for retained empty spans, 0 for the default
# ret:    ok, or `invalid` for a nil heap, a nil source, or a source with no
#         obtain callback
pub fun init(h: *Heap, src: *Source, budget: usize) err[allocator.Error] {
    if (h == nil)             { ret err[allocator.Error].err{allocator.Error.invalid{}}; }
    if (src == nil)           { ret err[allocator.Error].err{allocator.Error.invalid{}}; }
    if (src.fn_obtain == nil) { ret err[allocator.Error].err{allocator.Error.invalid{}}; }

    h.src  = @src;
    h.lock = mutex.make();

    var i: usize = 0;
    for (i < CLASS_COUNT) {
        h.partial[i] = nil;
        h.full[i]    = nil;
        i            = i + 1;
    }

    h.spans = nil;
    h.cache = nil;
    h.large = nil;
    h.huge  = nil;

    h.held   = 0;
    h.budget = budget;
    if (h.budget == 0) { h.budget = DEFAULT_CACHE; }

    h.live   = 0;
    h.mapped = 0;
    h.peak   = 0;
    h.blocks = 0;

    # size to class, by 16 byte steps up to 1024 and 128 byte steps beyond
    var c: usize = 0;
    i = 0;
    for (i < 64) {
        val want: usize = (i + 1) * 16;
        for (CLASS_SIZE[c] < want) { c = c + 1; }
        h.idx_small[i] = c::u8;
        i              = i + 1;
    }

    c = 0;
    i = 0;
    for (i < 64) {
        val want: usize = (i + 1) * 128;
        for (CLASS_SIZE[c] < want) { c = c + 1; }
        h.idx_mid[i] = c::u8;
        i            = i + 1;
    }

    ret err[allocator.Error].ok{};
}

# wire up an Allocator backed by this Heap
# ---
# a:   Allocator to initialize
# h:   initialized Heap (must outlive the Allocator)
# ret: ok, or `invalid` when either pointer is nil
pub fun make(a: *allocator.Allocator, h: *Heap) err[allocator.Error] {
    if (a == nil) { ret err[allocator.Error].err{allocator.Error.invalid{}}; }
    if (h == nil) { ret err[allocator.Error].err{allocator.Error.invalid{}}; }

    a.ctx           = h::ptr;
    a.fn_allocate   = do_allocate;
    a.fn_reallocate = do_reallocate;
    a.fn_deallocate = do_deallocate;
    a.retains       = false;

    ret err[allocator.Error].ok{};
}

# release every span back to the source and zero the heap state
#
# live blocks are abandoned, so this is a teardown of the whole heap and not a
# way to free one allocation. every span is attempted even when one release
# fails, and the first failure is what is reported.
# ---
# h:   Heap to destroy
# ret: ok, or the first negative backend native code as `release`
pub fun dnit(h: *Heap) err[allocator.Error] {
    if (h == nil) { ret err[allocator.Error].ok{}; }

    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }

    var first: i64 = 0;

    var i: usize = 0;
    for (i < CLASS_COUNT) {
        first = drain(h, ?h.partial[i], first);
        first = drain(h, ?h.full[i], first);
        i     = i + 1;
    }

    first  = drain(h, ?h.spans, first);
    first  = drain(h, ?h.cache, first);
    first  = drain(h, ?h.large, first);
    first  = drain(h, ?h.huge, first);
    h.held = 0;

    h.live   = 0;
    h.blocks = 0;

    if (first != 0) { ret err[allocator.Error].err{allocator.Error.release{first}}; }
    ret err[allocator.Error].ok{};
}

# release every span on a list, keeping the first failing status
fun drain(h: *Heap, head: **Span, first: i64) i64 {
    var kept: i64   = first;
    var s:    *Span = @head;
    for (s != nil) {
        val next: *Span = s.next;
        val code: i64   = release(h, s);
        if (code != 0 && kept == 0) { kept = code; }
        s = next;
    }
    @head = nil;
    ret kept;
}

# allocate `size` bytes of zeroed memory at `align`
#
# a block carved from a region the source delivered zeroed is returned as is,
# so a fresh span costs no write. anything reused is zeroed explicitly.
# ---
# h:     Heap to allocate from
# size:  number of bytes (0 returns nil)
# align: alignment in bytes, a power of two
# ret:   ptr to zeroed memory, or the refusal
pub fun zallocate_raw(h: *Heap, size: usize, align: usize) res[ptr, allocator.Error] {
    if (h == nil)                   { ret res[ptr, allocator.Error].err{allocator.Error.invalid{}}; }
    if (align == 0)                 { ret res[ptr, allocator.Error].err{allocator.Error.invalid{}}; }
    if ((align & (align - 1)) != 0) { ret res[ptr, allocator.Error].err{allocator.Error.invalid{}}; }
    if (size == 0)                  { ret res[ptr, allocator.Error].ok{nil}; }

    mutex.lock(?h.lock);

    var zeroed: bool = false;
    val p:      ptr  = take(h, size, align, ?zeroed);

    mutex.unlock(?h.lock);

    if (p == nil) { ret res[ptr, allocator.Error].err{allocator.Error.exhausted{}}; }
    if (!zeroed)  { memory.raw_zero(p, size); }

    ret res[ptr, allocator.Error].ok{p};
}

# bytes in live blocks, counted as the class size or payload capacity charged
# for each one rather than the size requested
pub fun live_bytes(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.live;
}

# bytes obtained from the source and not yet returned
pub fun mapped_bytes(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.mapped;
}

# high water mark of mapped_bytes over the heap's life
pub fun peak_mapped_bytes(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.peak;
}

# live block count
pub fun live_blocks(h: *Heap) usize {
    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }
    ret h.blocks;
}

# verify the heap's own invariants
#
# walks every span the heap holds and checks its header, its position, its
# free list and the accounting totals against what the spans say. intended
# for tests and for a caller that suspects heap corruption.
# ---
# h:   Heap to check
# ret: true when every invariant holds
pub fun check(h: *Heap) bool {
    if (h == nil) { ret false; }

    mutex.lock(?h.lock);
    fin { mutex.unlock(?h.lock); }

    var live:   usize = 0;
    var blocks: usize = 0;
    var held:   usize = 0;

    var i: usize = 0;
    for (i < CLASS_COUNT) {
        if (!check_class(h, h.partial[i], i, true, ?live, ?blocks)) { ret false; }
        if (!check_class(h, h.full[i], i, false, ?live, ?blocks))   { ret false; }
        i = i + 1;
    }

    var s: *Span = h.spans;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC) { ret false; }
        if (s.owner != h::ptr)     { ret false; }
        if (s.used != 0)           { ret false; }
        held = held + s.size;
        s    = s.next;
    }

    s = h.cache;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC) { ret false; }
        if (s.owner != h::ptr)     { ret false; }
        if (s.used != 0)           { ret false; }
        held = held + s.size;
        s    = s.next;
    }

    s = h.large;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC)    { ret false; }
        if (s.owner != h::ptr)        { ret false; }
        if (s.class != CLASS_LARGE)   { ret false; }
        if (s.used != 1)              { ret false; }
        if (s.data >= SPAN_ALIGN)     { ret false; }
        if (s.data + s.cap != s.size) { ret false; }
        live   = live + s.cap;
        blocks = blocks + 1;
        s      = s.next;
    }

    s = h.huge;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC)  { ret false; }
        if (s.owner != h::ptr)      { ret false; }
        if (s.class != CLASS_LARGE) { ret false; }
        if (s.used != 1)            { ret false; }
        if (s.data < SPAN_ALIGN)    { ret false; }
        live   = live + s.cap;
        blocks = blocks + 1;
        s      = s.next;
    }

    if (live != h.live)     { ret false; }
    if (blocks != h.blocks) { ret false; }
    if (held != h.held)     { ret false; }

    ret true;
}

# check every span on one class list and accumulate its live accounting
fun check_class(h: *Heap, head: *Span, c: usize, partial: bool, live: *usize, blocks: *usize) bool {
    val class_size: usize = CLASS_SIZE[c];
    val data:       usize = class_data_offset(class_size);

    var s: *Span = head;
    for (s != nil) {
        if (s.magic != SPAN_MAGIC)                 { ret false; }
        if (s.owner != h::ptr)                     { ret false; }
        if (s.class != c)                          { ret false; }
        if (s.size != SPAN_SIZE)                   { ret false; }
        if (s.data != data)                        { ret false; }
        if (s.cap != (s.size - data) / class_size) { ret false; }
        if (s.used > s.cap)                        { ret false; }
        if (s.bump < data || s.bump > s.size)      { ret false; }
        if ((s.bump - data) % class_size != 0)     { ret false; }

        # a partial span has a block to give, a full one does not
        val carved: usize = (s.bump - data) / class_size;
        if (partial && s.used == s.cap)  { ret false; }
        if (!partial && s.used != s.cap) { ret false; }
        if (s.used == 0)                 { ret false; }
        if (carved < s.used)             { ret false; }

        # the free list holds exactly the carved blocks not handed out, each
        # of them a block start inside the carved region
        var want:  usize = carved - s.used;
        var seen:  usize = 0;
        var block: ptr   = s.free;
        for (block != nil) {
            if (seen > want) { ret false; }
            val off: usize = block::usize - s::usize;
            if (off < data || off >= s.bump)    { ret false; }
            if ((off - data) % class_size != 0) { ret false; }
            seen  = seen + 1;
            block = (@(block::*usize))::ptr;
        }
        if (seen != want) { ret false; }

        @live   = @live + s.used * class_size;
        @blocks = @blocks + s.used;
        s       = s.next;
    }

    ret true;
}

# fill in a Source backed by the host's page mapper
#
# spans come from the platform mapper over-mapped and trimmed to SPAN_ALIGN,
# and are returned to it whole.
# ---
# s: Source to initialize
pub fun native_source(s: *Source) {
    if (s == nil) { ret; }
    s.ctx        = nil;
    s.fn_obtain  = native_obtain;
    s.fn_release = native_release;
}

fun native_obtain(ctx: ptr, size: usize) opt[ptr] {
    $if ($mach.build.os == $mach.os.windows) {
        # a windows reservation is released whole from its own base, so the
        # padding cannot be trimmed and the base is stashed ahead of the span
        val raw: ptr = os.allocate(size + SPAN_ALIGN);
        if (raw == nil) { ret opt[ptr].none{}; }

        val base: usize = align_up(raw::usize + 1, SPAN_ALIGN);
        @((base - 8)::*usize) = base - raw::usize;
        ret opt[ptr].some{base::ptr};
    }
    $or {
        val raw: ptr = os.allocate(size + SPAN_ALIGN);
        if (raw == nil) { ret opt[ptr].none{}; }

        val base: usize = align_up(raw::usize, SPAN_ALIGN);
        val head: usize = base - raw::usize;
        val tail: usize = SPAN_ALIGN - head;

        if (head != 0) { os.deallocate(raw, head); }
        if (tail != 0) { os.deallocate((base + size)::ptr, tail); }

        ret opt[ptr].some{base::ptr};
    }
}

fun native_release(ctx: ptr, span: ptr, size: usize) i64 {
    $if ($mach.build.os == $mach.os.windows) {
        val back: usize = @((span::usize - 8)::*usize);
        ret os.deallocate((span::usize - back)::ptr, size + SPAN_ALIGN);
    }
    $or {
        ret os.deallocate(span, size);
    }
}

# fill in a Source backed by another allocator
#
# spans are requested at SPAN_ALIGN and zeroed on the way out, so any backing
# allocator that honors alignment can host a heap: a fixed buffer, an arena,
# the page allocator, or the testing allocator for span-level accounting. a
# backing that hands back a span off the SPAN_ALIGN grid gets it straight back
# and the request is refused.
# ---
# s:       Source to initialize
# backing: allocator spans are drawn from (must outlive the heap)
pub fun allocator_source(s: *Source, backing: *allocator.Allocator) {
    if (s == nil) { ret; }
    s.ctx        = backing::ptr;
    s.fn_obtain  = backed_obtain;
    s.fn_release = backed_release;
}

fun backed_obtain(ctx: ptr, size: usize) opt[ptr] {
    val a:   *allocator.Allocator      = ctx::*allocator.Allocator;
    val got: res[ptr, allocator.Error] = allocator.allocate_raw(a, size, SPAN_ALIGN);
    if (sel got.err)   { ret opt[ptr].none{}; }
    if (got.ok == nil) { ret opt[ptr].none{}; }

    memory.raw_zero(got.ok, size);
    ret opt[ptr].some{got.ok};
}

fun backed_release(ctx: ptr, span: ptr, size: usize) i64 {
    val a:    *allocator.Allocator = ctx::*allocator.Allocator;
    val gone: err[allocator.Error] = allocator.deallocate_raw(a, span, size, SPAN_ALIGN);
    if (sel gone.err) {
        if (sel gone.err.release) { ret gone.err.release; }
        ret EINVAL;
    }
    ret 0;
}

# the Source members every behavioural case runs against
#
# a member is a row here and a branch in test_bed_open: the host mapper, the
# allocator adapter over a fixed buffer, over the page allocator and over the
# testing allocator, and a mapper that hands out the weakest base the
# contract allows. a new Source member is one more row.
val TEST_MEMBER_NATIVE:  usize = 0;
val TEST_MEMBER_FIXED:   usize = 1;
val TEST_MEMBER_PAGE:    usize = 2;
val TEST_MEMBER_TESTING: usize = 3;
val TEST_MEMBER_WEAK:    usize = 4;
val TEST_MEMBER_COUNT:   usize = 5;

# the fixed buffer never reclaims, so it holds every span the heaviest case
# ever obtains: the million-operation case runs through about 170 MiB
val TEST_FIXED_BYTES: usize = 512 * 1024 * 1024;

# a mapper at the weakest legal base: every span is a multiple of SPAN_ALIGN
# and never a multiple of 2 * SPAN_ALIGN, so an alignment above SPAN_ALIGN
# has to come from the heap and cannot be inherited from the mapper. the raw
# base is stashed ahead of the span, the shape native_obtain uses on windows.
fun test_weak_obtain(ctx: ptr, size: usize) opt[ptr] {
    val raw: ptr = os.allocate(size + 2 * SPAN_ALIGN);
    if (raw == nil) { ret opt[ptr].none{}; }

    var base: usize = align_up(raw::usize + 1, SPAN_ALIGN);
    if (base % (2 * SPAN_ALIGN) == 0) { base = base + SPAN_ALIGN; }
    @((base - 8)::*usize) = base - raw::usize;
    ret opt[ptr].some{base::ptr};
}

fun test_weak_release(ctx: ptr, span: ptr, size: usize) i64 {
    val back: usize = @((span::usize - 8)::*usize);
    ret os.deallocate((span::usize - back)::ptr, size + 2 * SPAN_ALIGN);
}

# one member's source and whatever it stands on
rec TestBed {
    member:  usize;
    src:     Source;
    region:  ptr;
    state:   fixed.FixedState;
    tracker: *testing.Testing;
    backing: allocator.Allocator;
}

fun test_bed_open(bed: *TestBed, member: usize) bool {
    bed.member  = member;
    bed.region  = nil;
    bed.tracker = nil;

    if (member == TEST_MEMBER_NATIVE) {
        native_source(?bed.src);
        ret true;
    }
    if (member == TEST_MEMBER_FIXED) {
        bed.region = os.allocate(TEST_FIXED_BYTES);
        if (bed.region == nil) { ret false; }
        val mr: err[allocator.Error] = fixed.make(?bed.backing, ?bed.state, bed.region::*u8, TEST_FIXED_BYTES);
        if (sel mr.err) { ret false; }
        allocator_source(?bed.src, ?bed.backing);
        ret true;
    }
    if (member == TEST_MEMBER_PAGE) {
        val mr: err[allocator.Error] = page.make(?bed.backing);
        if (sel mr.err) { ret false; }
        allocator_source(?bed.src, ?bed.backing);
        ret true;
    }
    if (member == TEST_MEMBER_TESTING) {
        # the tracker is too large for the stack, so it lives on the mapper
        bed.tracker = os.allocate($size_of(testing.Testing))::*testing.Testing;
        if (bed.tracker == nil) { ret false; }
        val mr: err[allocator.Error] = testing.make(bed.tracker);
        if (sel mr.err) {
            os.deallocate(bed.tracker::ptr, $size_of(testing.Testing));
            ret false;
        }
        allocator_source(?bed.src, testing.allocator_of(bed.tracker));
        ret true;
    }
    if (member == TEST_MEMBER_WEAK) {
        bed.src.ctx        = nil;
        bed.src.fn_obtain  = test_weak_obtain;
        bed.src.fn_release = test_weak_release;
        ret true;
    }
    ret false;
}

# false when the member's own accounting says a span was leaked or freed twice
fun test_bed_close(bed: *TestBed) bool {
    var clean: bool = true;
    if (bed.region != nil) { os.deallocate(bed.region, TEST_FIXED_BYTES); }
    if (bed.tracker != nil) {
        if (testing.leaked(bed.tracker))                 { clean = false; }
        if (testing.double_free_count(bed.tracker) != 0) { clean = false; }
        testing.dnit(bed.tracker);
        os.deallocate(bed.tracker::ptr, $size_of(testing.Testing));
    }
    bed.region  = nil;
    bed.tracker = nil;
    ret clean;
}

# a heap over one member, wired to an Allocator
fun test_heap_on(bed: *TestBed, member: usize, h: *Heap, a: *allocator.Allocator) bool {
    if (!test_bed_open(bed, member)) { ret false; }
    val ir: err[allocator.Error] = init(h, ?bed.src, 0);
    if (sel ir.err) {
        test_bed_close(bed);
        ret false;
    }
    val mr: err[allocator.Error] = make(a, h);
    if (sel mr.err) {
        dnit(h);
        test_bed_close(bed);
        ret false;
    }
    ret true;
}

# run one behavioural case against every member
#
# a failure is reported as member * 100 + the case's own code; a case that
# leaves spans the source refuses to take back, or that the member's own
# accounting reports as leaked or freed twice, fails too
fun test_each(body: fun(*Heap, *allocator.Allocator) i32) i32 {
    var member: usize = 0;
    for (member < TEST_MEMBER_COUNT) {
        var bed: TestBed;
        var h:   Heap;
        var a:   allocator.Allocator;
        if (!test_heap_on(?bed, member, ?h, ?a)) { ret (member * 100 + 1)::i32; }

        val code:  i32                  = body(?h, ?a);
        val dr:    err[allocator.Error] = dnit(?h);
        val clean: bool                 = test_bed_close(?bed);

        if (code != 0)             { ret (member * 100)::i32 + code; }
        if (sel dr.err)            { ret (member * 100 + 97)::i32; }
        if (!clean)                { ret (member * 100 + 98)::i32; }
        if (mapped_bytes(?h) != 0) { ret (member * 100 + 99)::i32; }
        member = member + 1;
    }
    ret 0;
}

fun test_rand(state: *usize) usize {
    var x: usize = @state;
    x      = x ^ (x << 13);
    x      = x ^ (x >> 7);
    x      = x ^ (x << 17);
    @state = x;
    ret x;
}

# write a byte pattern derived from a seed over a block
fun test_paint(p: ptr, size: usize, seed: u8) {
    val b: *u8   = p::*u8;
    var i: usize = 0;
    for (i < size) {
        b[i] = (seed + i::u8);
        i    = i + 1;
    }
}

fun test_painted(p: ptr, size: usize, seed: u8) bool {
    val b: *u8   = p::*u8;
    var i: usize = 0;
    for (i < size) {
        if (b[i] != (seed + i::u8)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun test_case_init_and_dnit_with_no_allocations(h: *Heap, a: *allocator.Allocator) i32 {
    if (!check(h))            { ret 2; }
    if (live_bytes(h) != 0)   { ret 3; }
    if (mapped_bytes(h) != 0) { ret 4; }

    val dr: err[allocator.Error] = dnit(h);
    if (sel dr.err) { ret 5; }
    ret 0;
}

test heap_init_and_dnit_with_no_allocations {
    ret test_each(test_case_init_and_dnit_with_no_allocations);
}

fun test_case_allocator_round_trip(h: *Heap, a: *allocator.Allocator) i32 {
    val got: res[ptr, allocator.Error] = allocator.allocate_raw(a, 64, 8);
    if (sel got.err)   { ret 2; }
    if (got.ok == nil) { ret 3; }

    test_paint(got.ok, 64, 7);
    if (!test_painted(got.ok, 64, 7)) { ret 4; }

    if (live_blocks(h) != 1)          { ret 5; }
    if (live_bytes(h) != 64)          { ret 6; }
    if (mapped_bytes(h) != SPAN_SIZE) { ret 7; }
    if (!check(h))                    { ret 8; }

    val gone: err[allocator.Error] = allocator.deallocate_raw(a, got.ok, 64, 8);
    if (sel gone.err)        { ret 9; }
    if (live_blocks(h) != 0) { ret 10; }
    if (live_bytes(h) != 0)  { ret 11; }
    if (!check(h))           { ret 12; }
    ret 0;
}

test heap_allocator_round_trip {
    ret test_each(test_case_allocator_round_trip);
}

fun test_case_every_size_straddling_a_class_boundary_is_served(h: *Heap, a: *allocator.Allocator) i32 {
    # one byte under, on, and one byte over every class boundary
    var c: usize = 0;
    for (c < CLASS_COUNT) {
        val cs: usize = CLASS_SIZE[c];

        var d: usize = 0;
        for (d < 3) {
            val size: usize = (cs - 1) + d;
            if (size == 0) { cnt; }

            val got: res[ptr, allocator.Error] = allocator.allocate_raw(a, size, 8);
            if (sel got.err)   { ret 2; }
            if (got.ok == nil) { ret 3; }

            # a block must hold every byte it was asked for
            test_paint(got.ok, size, 3);
            if (!test_painted(got.ok, size, 3)) { ret 4; }

            # the charge is the class that covers the size
            val charged: usize = live_bytes(h);
            if (size <= MAX_SMALL && charged < size) { ret 5; }

            val gone: err[allocator.Error] = allocator.deallocate_raw(a, got.ok, size, 8);
            if (sel gone.err)       { ret 6; }
            if (live_bytes(h) != 0) { ret 7; }
            d = d + 1;
        }

        if (!check(h)) { ret 8; }
        c = c + 1;
    }
    ret 0;
}

test heap_every_size_straddling_a_class_boundary_is_served {
    ret test_each(test_case_every_size_straddling_a_class_boundary_is_served);
}

fun test_case_alignment_is_honored_above_class_granularity(h: *Heap, a: *allocator.Allocator) i32 {
    var kept:  [16]ptr;
    var sizes: [16]usize;

    var align: usize = 1;
    for (align <= 131072) {
        var n: usize = 0;
        for (n < 16) {
            # a size that is not a multiple of the alignment on purpose
            val size: usize                     = align + 1 + n;
            val got:  res[ptr, allocator.Error] = allocator.allocate_raw(a, size, align);
            if (sel got.err)                        { ret 2; }
            if (got.ok == nil)                      { ret 3; }
            if ((got.ok::usize & (align - 1)) != 0) { ret 4; }

            test_paint(got.ok, size, 11);
            kept[n]  = got.ok;
            sizes[n] = size;
            n        = n + 1;
        }

        if (!check(h)) { ret 5; }

        n = 0;
        for (n < 16) {
            if (!test_painted(kept[n], sizes[n], 11)) { ret 6; }
            val gone: err[allocator.Error] = allocator.deallocate_raw(a, kept[n], sizes[n], align);
            if (sel gone.err) { ret 7; }
            n = n + 1;
        }

        if (live_bytes(h) != 0) { ret 8; }
        if (!check(h))          { ret 9; }
        align = align * 2;
    }
    ret 0;
}

test heap_alignment_is_honored_above_class_granularity {
    ret test_each(test_case_alignment_is_honored_above_class_granularity);
}

fun test_case_zero_size_allocates_nil(h: *Heap, a: *allocator.Allocator) i32 {
    val got: res[ptr, allocator.Error] = allocator.allocate_raw(a, 0, 8);
    if (sel got.err)   { ret 2; }
    if (got.ok != nil) { ret 3; }

    val direct: opt[ptr] = do_allocate(h::ptr, 0, 8);
    if (!sel direct.some)   { ret 4; }
    if (direct.some != nil) { ret 5; }

    val zero: res[ptr, allocator.Error] = zallocate_raw(h, 0, 8);
    if (sel zero.err)   { ret 6; }
    if (zero.ok != nil) { ret 7; }

    val gone: err[allocator.Error] = allocator.deallocate_raw(a, nil, 0, 8);
    if (sel gone.err)         { ret 8; }
    if (mapped_bytes(h) != 0) { ret 9; }
    ret 0;
}

test heap_zero_size_allocates_nil {
    ret test_each(test_case_zero_size_allocates_nil);
}

fun test_case_a_block_above_the_largest_class_owns_its_span(h: *Heap, a: *allocator.Allocator) i32 {
    val size: usize                     = MAX_SMALL * 9 + 17;
    val got:  res[ptr, allocator.Error] = allocator.allocate_raw(a, size, 16);
    if (sel got.err)   { ret 2; }
    if (got.ok == nil) { ret 3; }

    test_paint(got.ok, size, 5);
    if (!test_painted(got.ok, size, 5)) { ret 4; }

    # its span is sized for the block, not rounded to a class span
    if (mapped_bytes(h) < size)             { ret 5; }
    if (mapped_bytes(h) > size + SPAN_SIZE) { ret 6; }
    if (live_blocks(h) != 1)                { ret 7; }
    if (!check(h))                          { ret 8; }

    val gone: err[allocator.Error] = allocator.deallocate_raw(a, got.ok, size, 16);
    if (sel gone.err)        { ret 9; }
    if (live_blocks(h) != 0) { ret 10; }
    if (!check(h))           { ret 11; }
    ret 0;
}

test heap_a_block_above_the_largest_class_owns_its_span {
    ret test_each(test_case_a_block_above_the_largest_class_owns_its_span);
}

fun test_case_reallocate_grows_across_classes_and_keeps_the_bytes(h: *Heap, a: *allocator.Allocator) i32 {
    var size: usize                     = 24;
    val got:  res[ptr, allocator.Error] = allocator.allocate_raw(a, size, 8);
    if (sel got.err) { ret 2; }
    test_paint(got.ok, size, 9);

    var p: ptr = got.ok;
    for (size < MAX_SMALL * 4) {
        val next: usize                     = size * 2 + 1;
        val grew: res[ptr, allocator.Error] = allocator.reallocate_raw(a, p, size, next, 8);
        if (sel grew.err)   { ret 3; }
        if (grew.ok == nil) { ret 4; }

        # the prefix survives the move
        if (!test_painted(grew.ok, size, 9)) { ret 5; }
        test_paint(grew.ok, next, 9);

        p    = grew.ok;
        size = next;
        if (!check(h)) { ret 6; }
    }

    val gone: err[allocator.Error] = allocator.deallocate_raw(a, p, size, 8);
    if (sel gone.err)        { ret 7; }
    if (live_blocks(h) != 0) { ret 8; }
    if (!check(h))           { ret 9; }
    ret 0;
}

test heap_reallocate_grows_across_classes_and_keeps_the_bytes {
    ret test_each(test_case_reallocate_grows_across_classes_and_keeps_the_bytes);
}

fun test_case_reallocate_shrinking_hands_the_class_back(h: *Heap, a: *allocator.Allocator) i32 {
    val big: res[ptr, allocator.Error] = allocator.allocate_raw(a, 4096, 8);
    if (sel big.err) { ret 2; }
    test_paint(big.ok, 4096, 13);

    val before: usize = live_bytes(h);
    if (before != 4096) { ret 3; }

    # a shrink to a fraction of the block relocates and returns the difference
    val small: res[ptr, allocator.Error] = allocator.reallocate_raw(a, big.ok, 4096, 100, 8);
    if (sel small.err)                    { ret 4; }
    if (!test_painted(small.ok, 100, 13)) { ret 5; }
    if (live_bytes(h) >= before)          { ret 6; }
    if (live_bytes(h) != 112)             { ret 7; }
    if (!check(h))                        { ret 8; }

    val gone: err[allocator.Error] = allocator.deallocate_raw(a, small.ok, 100, 8);
    if (sel gone.err)       { ret 9; }
    if (live_bytes(h) != 0) { ret 10; }

    # a large block shrinking below the class ceiling lands in a class
    val huge: res[ptr, allocator.Error] = allocator.allocate_raw(a, 200000, 16);
    if (sel huge.err) { ret 11; }
    test_paint(huge.ok, 4096, 21);

    val cut: res[ptr, allocator.Error] = allocator.reallocate_raw(a, huge.ok, 200000, 300, 16);
    if (sel cut.err)                    { ret 12; }
    if (!test_painted(cut.ok, 300, 21)) { ret 13; }
    if (live_bytes(h) != 320)           { ret 14; }
    if (!check(h))                      { ret 15; }

    val last: err[allocator.Error] = allocator.deallocate_raw(a, cut.ok, 300, 16);
    if (sel last.err)       { ret 16; }
    if (live_bytes(h) != 0) { ret 17; }
    ret 0;
}

test heap_reallocate_shrinking_hands_the_class_back {
    ret test_each(test_case_reallocate_shrinking_hands_the_class_back);
}

fun test_case_reallocate_inside_a_class_stays_in_place(h: *Heap, a: *allocator.Allocator) i32 {
    val got: res[ptr, allocator.Error] = allocator.allocate_raw(a, 200, 8);
    if (sel got.err) { ret 2; }

    # 200 and 224 are the same class, so neither step moves the block
    val up: res[ptr, allocator.Error] = allocator.reallocate_raw(a, got.ok, 200, 224, 8);
    if (sel up.err)      { ret 3; }
    if (up.ok != got.ok) { ret 4; }

    val down: res[ptr, allocator.Error] = allocator.reallocate_raw(a, up.ok, 224, 201, 8);
    if (sel down.err)         { ret 5; }
    if (down.ok != got.ok)    { ret 6; }
    if (live_bytes(h) != 224) { ret 7; }

    val gone: err[allocator.Error] = allocator.deallocate_raw(a, down.ok, 201, 8);
    if (sel gone.err) { ret 8; }
    if (!check(h))    { ret 9; }
    ret 0;
}

test heap_reallocate_inside_a_class_stays_in_place {
    ret test_each(test_case_reallocate_inside_a_class_stays_in_place);
}

fun test_case_reallocate_to_zero_frees_the_block(h: *Heap, a: *allocator.Allocator) i32 {
    val got: res[ptr, allocator.Error] = allocator.allocate_raw(a, 900, 8);
    if (sel got.err) { ret 2; }

    val gone: res[ptr, allocator.Error] = allocator.reallocate_raw(a, got.ok, 900, 0, 8);
    if (sel gone.err)        { ret 3; }
    if (gone.ok != nil)      { ret 4; }
    if (live_blocks(h) != 0) { ret 5; }
    if (!check(h))           { ret 6; }

    # a nil pointer into reallocate is an allocation
    val fresh: res[ptr, allocator.Error] = allocator.reallocate_raw(a, nil, 0, 48, 8);
    if (sel fresh.err)       { ret 7; }
    if (fresh.ok == nil)     { ret 8; }
    if (live_blocks(h) != 1) { ret 9; }

    val last: err[allocator.Error] = allocator.deallocate_raw(a, fresh.ok, 48, 8);
    if (sel last.err) { ret 10; }
    if (!check(h))    { ret 11; }
    ret 0;
}

test heap_reallocate_to_zero_frees_the_block {
    ret test_each(test_case_reallocate_to_zero_frees_the_block);
}

fun test_case_foreign_pointer_refused(ha: *Heap, aa: *allocator.Allocator) i32 {
    # the other heap stands on the host mapper whichever member ha is on
    var bed: TestBed;
    var hb:  Heap;
    var ab:  allocator.Allocator;
    if (!test_heap_on(?bed, TEST_MEMBER_NATIVE, ?hb, ?ab)) { ret 2; }
    fin {
        dnit(?hb);
        test_bed_close(?bed);
    }

    val mine: res[ptr, allocator.Error] = allocator.allocate_raw(aa, 64, 8);
    if (sel mine.err) { ret 3; }

    val theirs: res[ptr, allocator.Error] = allocator.allocate_raw(?ab, 64, 8);
    if (sel theirs.err) { ret 4; }

    # another heap's block sits in a span this heap does not own
    val foreign: err[allocator.Error] = allocator.deallocate_raw(aa, theirs.ok, 64, 8);
    if (!sel foreign.err)              { ret 5; }
    if (!sel foreign.err.release)      { ret 6; }
    if (foreign.err.release != EINVAL) { ret 7; }

    # an address inside a block of this heap is not a block of this heap
    val interior: err[allocator.Error] =
        allocator.deallocate_raw(aa, (mine.ok::usize + 8)::ptr, 64, 8);
    if (!sel interior.err) { ret 8; }

    # the span header is not a block either
    val header: err[allocator.Error] =
        allocator.deallocate_raw(aa, span_of(mine.ok)::ptr, 64, 8);
    if (!sel header.err) { ret 9; }

    # a size larger than the block's class is a contract violation
    val oversize: err[allocator.Error] = allocator.deallocate_raw(aa, mine.ok, 4096, 8);
    if (!sel oversize.err) { ret 10; }

    # none of the refusals disturbed either heap
    if (!check(ha))            { ret 11; }
    if (!check(?hb))           { ret 12; }
    if (live_blocks(ha) != 1)  { ret 13; }
    if (live_blocks(?hb) != 1) { ret 14; }

    val a_gone: err[allocator.Error] = allocator.deallocate_raw(aa, mine.ok, 64, 8);
    if (sel a_gone.err) { ret 15; }
    val b_gone: err[allocator.Error] = allocator.deallocate_raw(?ab, theirs.ok, 64, 8);
    if (sel b_gone.err) { ret 16; }
    ret 0;
}

test heap_a_pointer_it_never_handed_out_is_refused {
    ret test_each(test_case_foreign_pointer_refused);
}

fun test_case_an_empty_span_goes_back_for_another_class(h: *Heap, a: *allocator.Allocator) i32 {
    var kept: [8]ptr;
    var i:    usize = 0;
    for (i < 8) {
        val got: res[ptr, allocator.Error] = allocator.allocate_raw(a, 16, 8);
        if (sel got.err) { ret 2; }
        kept[i] = got.ok;
        i       = i + 1;
    }

    val mapped: usize = mapped_bytes(h);
    if (mapped != SPAN_SIZE) { ret 3; }

    i = 0;
    for (i < 8) {
        val gone: err[allocator.Error] = allocator.deallocate_raw(a, kept[i], 16, 8);
        if (sel gone.err) { ret 4; }
        i = i + 1;
    }

    # the emptied span is held, not returned, and serves the next class asked for
    if (mapped_bytes(h) != mapped) { ret 5; }
    if (!check(h))                 { ret 6; }

    val other: res[ptr, allocator.Error] = allocator.allocate_raw(a, 4096, 8);
    if (sel other.err)             { ret 7; }
    if (mapped_bytes(h) != mapped) { ret 8; }
    if (!check(h))                 { ret 9; }

    val gone: err[allocator.Error] = allocator.deallocate_raw(a, other.ok, 4096, 8);
    if (sel gone.err) { ret 10; }
    ret 0;
}

test heap_an_empty_span_goes_back_for_another_class {
    ret test_each(test_case_an_empty_span_goes_back_for_another_class);
}

fun test_case_zallocate_raw_zeroes_a_reused_block(h: *Heap, a: *allocator.Allocator) i32 {
    # a block off a fresh span is already zero
    val first: res[ptr, allocator.Error] = zallocate_raw(h, 300, 8);
    if (sel first.err) { ret 2; }
    var i: usize = 0;
    for (i < 300) {
        if ((first.ok::*u8)[i] != 0) { ret 3; }
        i = i + 1;
    }

    test_paint(first.ok, 300, 0x5A);
    val gone: err[allocator.Error] = allocator.deallocate_raw(a, first.ok, 300, 8);
    if (sel gone.err) { ret 4; }

    # the same block handed out again is zeroed explicitly
    val again: res[ptr, allocator.Error] = zallocate_raw(h, 300, 8);
    if (sel again.err)        { ret 5; }
    if (again.ok != first.ok) { ret 6; }
    i = 0;
    for (i < 300) {
        if ((again.ok::*u8)[i] != 0) { ret 7; }
        i = i + 1;
    }

    val last: err[allocator.Error] = allocator.deallocate_raw(a, again.ok, 300, 8);
    if (sel last.err) { ret 8; }
    if (!check(h))    { ret 9; }
    ret 0;
}

test heap_zallocate_raw_zeroes_a_reused_block {
    ret test_each(test_case_zallocate_raw_zeroes_a_reused_block);
}

fun test_case_interleaved_mixed_sizes_keep_the_invariants(h: *Heap, a: *allocator.Allocator) i32 {
    val slots: usize = 512;
    var live:  [512]ptr;
    var sizes: [512]usize;
    var i:     usize = 0;
    for (i < slots) {
        live[i]  = nil;
        sizes[i] = 0;
        i        = i + 1;
    }

    var state: usize = 0x9E3779B97F4A7C15;
    var step:  usize = 0;
    for (step < 60000) {
        val slot: usize = test_rand(?state) % slots;
        val roll: usize = test_rand(?state) % 100;

        if (live[slot] != nil) {
            if (!test_painted(live[slot], sizes[slot], slot::u8)) { ret 2; }

            # a third of the revisits resize instead of releasing
            if (roll < 33) {
                val next: usize                     = 1 + (test_rand(?state) % 9000);
                val grew: res[ptr, allocator.Error] =
                    allocator.reallocate_raw(a, live[slot], sizes[slot], next, 16);
                if (sel grew.err) { ret 3; }

                var keep: usize = sizes[slot];
                if (next < keep)                            { keep = next; }
                if (!test_painted(grew.ok, keep, slot::u8)) { ret 4; }

                live[slot]  = grew.ok;
                sizes[slot] = next;
                test_paint(grew.ok, next, slot::u8);
                step = step + 1;
                cnt;
            }

            val gone: err[allocator.Error] =
                allocator.deallocate_raw(a, live[slot], sizes[slot], 16);
            if (sel gone.err) { ret 5; }
            live[slot]  = nil;
            sizes[slot] = 0;
            step        = step + 1;
            cnt;
        }

        var size: usize = 1 + (test_rand(?state) % 9000);
        if (roll < 5) { size = size * 40; }

        val got: res[ptr, allocator.Error] = allocator.allocate_raw(a, size, 16);
        if (sel got.err)   { ret 6; }
        if (got.ok == nil) { ret 7; }
        test_paint(got.ok, size, slot::u8);
        live[slot]  = got.ok;
        sizes[slot] = size;
        step        = step + 1;
    }

    if (!check(h)) { ret 8; }

    i = 0;
    for (i < slots) {
        if (live[i] != nil) {
            if (!test_painted(live[i], sizes[i], i::u8)) { ret 9; }
            val gone: err[allocator.Error] = allocator.deallocate_raw(a, live[i], sizes[i], 16);
            if (sel gone.err) { ret 10; }
        }
        i = i + 1;
    }

    if (!check(h))           { ret 11; }
    if (live_bytes(h) != 0)  { ret 12; }
    if (live_blocks(h) != 0) { ret 13; }
    ret 0;
}

test heap_interleaved_mixed_sizes_keep_the_invariants {
    ret test_each(test_case_interleaved_mixed_sizes_keep_the_invariants);
}

# a grow-only span source: it hands out spans from one region and can never
# take one back, which is the shape a wasm `memory.grow` host has
rec TestGrow {
    next: usize;
    end:  usize;
}

fun test_grow_obtain(ctx: ptr, size: usize) opt[ptr] {
    val g:  *TestGrow = ctx::*TestGrow;
    val at: usize     = align_up(g.next, SPAN_ALIGN);
    if (at + size > g.end) { ret opt[ptr].none{}; }
    g.next = at + size;
    ret opt[ptr].some{at::ptr};
}

fun test_grow_source(s: *Source, g: *TestGrow, region: ptr, size: usize) {
    g.next       = region::usize;
    g.end        = region::usize + size;
    s.ctx        = g::ptr;
    s.fn_obtain  = test_grow_obtain;
    s.fn_release = nil;
}

test heap_a_source_that_cannot_release_keeps_its_spans {
    val bytes:  usize = SPAN_SIZE * 8;
    val region: ptr   = os.allocate(bytes);
    if (region == nil) { ret 1; }
    fin { os.deallocate(region, bytes); }

    var g: TestGrow;
    var s: Source;
    test_grow_source(?s, ?g, region, bytes);

    var h: Heap;
    # a budget of one byte: a source that could release would release here
    val ir: err[allocator.Error] = init(?h, ?s, 1);
    if (sel ir.err) { ret 2; }

    var a:  allocator.Allocator;
    val mr: err[allocator.Error] = make(?a, ?h);
    if (sel mr.err) { ret 3; }

    var kept: [8]ptr;
    var i:    usize = 0;
    for (i < 8) {
        val got: res[ptr, allocator.Error] = allocator.allocate_raw(?a, 16, 8);
        if (sel got.err) { ret 4; }
        kept[i] = got.ok;
        i       = i + 1;
    }

    val mapped: usize = mapped_bytes(?h);
    if (mapped != SPAN_SIZE) { ret 5; }

    i = 0;
    for (i < 8) {
        val gone: err[allocator.Error] = allocator.deallocate_raw(?a, kept[i], 16, 8);
        if (sel gone.err) { ret 6; }
        i = i + 1;
    }

    # the span is held past the budget, because the source has nowhere to
    # put it, and serves the next class instead of a fresh grow
    if (mapped_bytes(?h) != mapped) { ret 7; }
    if (!check(?h))                 { ret 8; }

    val other: res[ptr, allocator.Error] = allocator.allocate_raw(?a, 2048, 8);
    if (sel other.err)              { ret 9; }
    if (mapped_bytes(?h) != mapped) { ret 10; }

    val gone: err[allocator.Error] = allocator.deallocate_raw(?a, other.ok, 2048, 8);
    if (sel gone.err) { ret 11; }
    if (!check(?h))   { ret 12; }

    val dr: err[allocator.Error] = dnit(?h);
    if (sel dr.err) { ret 13; }
    ret 0;
}

# a source that breaks the base contract: pages, but not SPAN_ALIGN
rec TestSkewed {
    region:   ptr;
    bytes:    usize;
    obtained: usize;
    released: ptr;
}

fun test_skewed_obtain(ctx: ptr, size: usize) opt[ptr] {
    val k: *TestSkewed = ctx::*TestSkewed;
    if (size + os.page_size() > k.bytes) { ret opt[ptr].none{}; }
    k.obtained = k.obtained + 1;
    ret opt[ptr].some{(align_up(k.region::usize, SPAN_ALIGN) + os.page_size())::ptr};
}

fun test_skewed_release(ctx: ptr, span: ptr, size: usize) i64 {
    val k: *TestSkewed = ctx::*TestSkewed;
    k.released = span;
    ret 0;
}

test heap_a_span_off_the_span_align_grid_is_handed_back_and_refused {
    var k: TestSkewed;
    k.bytes    = SPAN_SIZE * 3;
    k.region   = os.allocate(k.bytes);
    k.obtained = 0;
    k.released = nil;
    if (k.region == nil) { ret 1; }
    fin { os.deallocate(k.region, k.bytes); }

    var s: Source;
    s.ctx        = (?k)::ptr;
    s.fn_obtain  = test_skewed_obtain;
    s.fn_release = test_skewed_release;

    var h:  Heap;
    val ir: err[allocator.Error] = init(?h, ?s, 0);
    if (sel ir.err) { ret 2; }
    fin { dnit(?h); }

    var a:  allocator.Allocator;
    val mr: err[allocator.Error] = make(?a, ?h);
    if (sel mr.err) { ret 3; }

    val small: res[ptr, allocator.Error] = allocator.allocate_raw(?a, 64, 8);
    if (!sel small.err)           { ret 4; }
    if (!sel small.err.exhausted) { ret 5; }

    # the span went back to the source before the refusal was reported
    if (k.obtained != 1)       { ret 6; }
    if (k.released == nil)     { ret 7; }
    if (mapped_bytes(?h) != 0) { ret 8; }
    if (live_blocks(?h) != 0)  { ret 9; }
    if (!check(?h))            { ret 10; }

    val large: res[ptr, allocator.Error] = allocator.allocate_raw(?a, MAX_SMALL * 2, 8);
    if (!sel large.err)        { ret 11; }
    if (k.obtained != 2)       { ret 12; }
    if (mapped_bytes(?h) != 0) { ret 13; }
    ret 0;
}

test heap_an_exhausted_source_is_reported_as_a_refusal {
    val bytes:  usize = SPAN_SIZE * 3;
    val region: ptr   = os.allocate(bytes);
    if (region == nil) { ret 1; }
    fin { os.deallocate(region, bytes); }

    var g: TestGrow;
    var s: Source;
    test_grow_source(?s, ?g, region, bytes);

    var h:  Heap;
    val ir: err[allocator.Error] = init(?h, ?s, 0);
    if (sel ir.err) { ret 2; }
    fin { dnit(?h); }

    var a:  allocator.Allocator;
    val mr: err[allocator.Error] = make(?a, ?h);
    if (sel mr.err) { ret 3; }

    # one class span per class drains the region after three classes
    var refused: bool  = false;
    var c:       usize = 0;
    for (c < 8) {
        val got: res[ptr, allocator.Error] = allocator.allocate_raw(?a, CLASS_SIZE[c], 8);
        if (sel got.err) {
            if (!sel got.err.exhausted) { ret 4; }
            refused = true;
            brk;
        }
        c = c + 1;
    }

    if (!refused)   { ret 5; }
    if (!check(?h)) { ret 6; }

    # a refusal leaves the heap usable for a size it can still serve
    val again: res[ptr, allocator.Error] = allocator.allocate_raw(?a, CLASS_SIZE[0], 8);
    if (sel again.err) { ret 7; }
    val gone: err[allocator.Error] = allocator.deallocate_raw(?a, again.ok, CLASS_SIZE[0], 8);
    if (sel gone.err) { ret 8; }
    if (!check(?h))   { ret 9; }
    ret 0;
}

rec TestShare {
    a:     *allocator.Allocator;
    seed:  usize;
    fault: i64;
}

fun test_share_worker(arg: *u8) {
    val w: *TestShare = arg::*TestShare;

    var kept:  [32]ptr;
    var sizes: [32]usize;
    var i:     usize = 0;
    for (i < 32) {
        kept[i]  = nil;
        sizes[i] = 0;
        i        = i + 1;
    }

    var state: usize = w.seed;
    var step:  usize = 0;
    for (step < 20000) {
        val slot: usize = test_rand(?state) % 32;
        val seed: u8    = (w.seed + slot)::u8;

        if (kept[slot] != nil) {
            if (!test_painted(kept[slot], sizes[slot], seed)) {
                w.fault = 1;
                ret;
            }
            val gone: err[allocator.Error] =
                allocator.deallocate_raw(w.a, kept[slot], sizes[slot], 16);
            if (sel gone.err) {
                w.fault = 2;
                ret;
            }
            kept[slot]  = nil;
            sizes[slot] = 0;
            step        = step + 1;
            cnt;
        }

        val size: usize                     = 1 + (test_rand(?state) % 3000);
        val got:  res[ptr, allocator.Error] = allocator.allocate_raw(w.a, size, 16);
        if (sel got.err) {
            w.fault = 3;
            ret;
        }
        test_paint(got.ok, size, seed);
        kept[slot]  = got.ok;
        sizes[slot] = size;
        step        = step + 1;
    }

    i = 0;
    for (i < 32) {
        if (kept[i] != nil) {
            val seed: u8 = (w.seed + i)::u8;
            if (!test_painted(kept[i], sizes[i], seed)) {
                w.fault = 4;
                ret;
            }
            val gone: err[allocator.Error] =
                allocator.deallocate_raw(w.a, kept[i], sizes[i], 16);
            if (sel gone.err) {
                w.fault = 5;
                ret;
            }
        }
        i = i + 1;
    }
}

fun test_case_threads_share_one_heap_without_corrupting_it(h: *Heap, a: *allocator.Allocator) i32 {
    var work:    [4]TestShare;
    var threads: [4]thread.Thread;

    var i: usize = 0;
    for (i < 4) {
        work[i].a     = a;
        work[i].seed  = 0x2545F4914F6CDD1D + i * 7919;
        work[i].fault = 0;
        val up: thread.Operation = thread.spawn_with(test_share_worker, (?work[i])::*u8, ?threads[i]);
        if (sel up.err) { ret 2; }
        i = i + 1;
    }

    i = 0;
    for (i < 4) {
        val down: thread.Operation = thread.join(?threads[i]);
        if (sel down.err)       { ret 3; }
        if (work[i].fault != 0) { ret 4; }
        i = i + 1;
    }

    if (!check(h))           { ret 5; }
    if (live_blocks(h) != 0) { ret 6; }
    if (live_bytes(h) != 0)  { ret 7; }
    ret 0;
}

test heap_threads_share_one_heap_without_corrupting_it {
    ret test_each(test_case_threads_share_one_heap_without_corrupting_it);
}

fun test_case_a_million_mixed_operations_stay_within_twice_the_live_bytes(h: *Heap, a: *allocator.Allocator) i32 {
    val slots: usize = 65536;
    val table: ptr   = os.allocate(slots * 16);
    if (table == nil) { ret 2; }
    fin { os.deallocate(table, slots * 16); }

    val live:  *usize = table::*usize;
    val sizes: *usize = (table::usize + slots * 8)::*usize;

    var wanted: usize = 0;
    var peak:   usize = 0;
    var state:  usize = 0x853C49E6748FEA9B;

    var step: usize = 0;
    for (step < 1000000) {
        val slot: usize = test_rand(?state) % slots;

        if (live[slot] != 0) {
            val gone: err[allocator.Error] =
                allocator.deallocate_raw(a, live[slot]::ptr, sizes[slot], 16);
            if (sel gone.err) { ret 3; }
            wanted      = wanted - sizes[slot];
            live[slot]  = 0;
            sizes[slot] = 0;
            step        = step + 1;
            cnt;
        }

        var size: usize = 1 + (test_rand(?state) % 2048);
        if (test_rand(?state) % 100 < 5) { size = size * 32; }

        val got: res[ptr, allocator.Error] = allocator.allocate_raw(a, size, 16);
        if (sel got.err)   { ret 4; }
        if (got.ok == nil) { ret 5; }

        live[slot]  = got.ok::usize;
        sizes[slot] = size;
        wanted      = wanted + size;
        if (wanted > peak) { peak = wanted; }
        step = step + 1;
    }

    # the mapping never ran past twice the bytes the caller asked for
    if (peak_mapped_bytes(h) > peak * 2) { ret 6; }
    if (!check(h))                       { ret 7; }

    var i: usize = 0;
    for (i < slots) {
        if (live[i] != 0) {
            val gone: err[allocator.Error] =
                allocator.deallocate_raw(a, live[i]::ptr, sizes[i], 16);
            if (sel gone.err) { ret 8; }
        }
        i = i + 1;
    }

    if (!check(h))           { ret 9; }
    if (live_blocks(h) != 0) { ret 10; }
    ret 0;
}

test heap_a_million_mixed_operations_stay_within_twice_the_live_bytes {
    ret test_each(test_case_a_million_mixed_operations_stay_within_twice_the_live_bytes);
}
