# terminal keyboard input: raw single-key polling for game loops
#
# raw mode turns off line buffering and local echo so keystrokes arrive one
# byte at a time without waiting for enter; poll_key / poll_key_decoded then
# read at most one key per call without blocking, suiting a per-frame loop.
# plain press-enter line input is not a terminal concern and lives in
# std.input (it needs no tty and works over pipes and redirects).
#
# lifecycle: enable_raw once, poll each frame, disable_raw on exit. always pair
# the two -- e.g. `fin { terminal.disable_raw(); }` -- so the terminal is
# restored even on an early return. raw-mode state is a single process-global
# toggle: not thread-safe, not reentrant. all i/o targets the stdin fd.
#
# outcomes: the mode and queue controls return err[TermError] and a poll
# returns res[opt[Key], TermError], where an empty queue is absence and a
# native read failure is the error. TermError nests the native io failure with
# its operation.
#
# the Key type, its kinds, and the special-key constants come from
# std.terminal.key and the outcome tags from std.terminal.error; both are
# re-exported here.

use std.types.option.opt;
use std.types.size.usize;

use io_error: std.io.error;
use std.system.capability;
use terr: std.terminal.error;
use std.terminal.key;

$if (capability.HAS_FILES) {
    use std.system.os;

    $if ($mach.build.sys == $mach.sys.linux) {
        use impl: std.terminal.linux;
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        use impl: std.terminal.darwin;
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        use impl: std.terminal.windows;
    }
    $or {
        $error("std.terminal: unsupported target");
    }
}
$or {
    $error("std.terminal needs the files capability (std.system.capability.HAS_FILES)");
}

# key representation (from std.terminal.key)
fwd key.KeyKind;
fwd key.KIND_NONE;
fwd key.KIND_BYTE;
fwd key.KIND_SPECIAL;
fwd key.Special;
fwd key.KEY_UP;
fwd key.KEY_DOWN;
fwd key.KEY_LEFT;
fwd key.KEY_RIGHT;
fwd key.Key;
fwd key.key_none;
fwd key.key_byte;
fwd key.key_special;
fwd key.is_none;
fwd key.is_byte;
fwd key.is_special;

# outcomes (from std.terminal.error)
fwd terr.TermError;
fwd terr.Operation;
fwd terr.Poll;
fwd terr.code;

# a native refusal on a mode or queue control call
pub fun control_failure(code: i64) terr.TermError {
    ret terr.TermError.native{os.error(code, io_error.OP_OPTION)};
}

# a native refusal on a poll
pub fun read_failure(code: i64) terr.TermError {
    ret terr.TermError.native{os.error(code, io_error.OP_READ)};
}

# whether a descriptor is a terminal, as os.stdout() or any other handle
#
# a pipe, a file or a closed descriptor reads false. on windows a terminal is a
# console handle, so a pty that is not a console reads false
fwd impl.is_terminal;

# mode control (per-os backend)
fwd impl.enable_raw;
fwd impl.disable_raw;
fwd impl.is_raw;

# bytes poll_key_decoded read past the key it returned, delivered before any
# new read. a decode looks at most three bytes ahead and consumes at least one
var _ahead:     [3]u8;
var _ahead_len: usize = 0;

# drop whatever's sitting unread in the input queue, read-ahead bytes included
#
# worth calling right before enable_raw / disable_raw so a burst of stale
# keystrokes from the old mode doesn't leak into the new one.
# ---
# ret: ok, or the native refusal
pub fun flush_input() terr.Operation {
    _ahead_len = 0;
    ret impl.flush_input();
}

# read one key without blocking
#
# a byte poll_key_decoded read ahead and did not consume comes first, then the
# backend's own poll. requires raw mode (enable_raw).
# ---
# ret: some{key} if one was waiting, none when the queue was empty, or the
#      native read failure
pub fun poll_key() terr.Poll {
    if (_ahead_len > 0) { ret waiting(key.key_byte(take_ahead())); }
    ret impl.poll_key();
}

$if ($mach.build.sys == $mach.sys.windows) {
    # poll_key, which already decodes arrows on windows
    # ---
    # ret: some{key} -- a special arrow or an ordinary byte -- none when nothing
    #      was waiting, or the native read failure
    pub fun poll_key_decoded() terr.Poll {
        ret poll_key();
    }
}
$or {
    # poll_key, decoding an arrow escape into a special key
    #
    # an arrow arrives as the 3-byte sequence ESC '[' 'A'..'D', which this
    # consumes whole and returns as the matching special key. any other byte,
    # including a bare ESC, is returned as-is, and the bytes read ahead to rule
    # out an arrow are delivered by the following polls.
    #
    # caveat: on a slow link the follow-up bytes could arrive a poll later than
    # the ESC, which then reads as a bare ESC. requires raw mode.
    # ---
    # ret: some{key} -- a special arrow or an ordinary byte -- none when nothing
    #      was waiting, or the native failure of whichever read refused
    pub fun poll_key_decoded() terr.Poll {
        val err_first: terr.Operation = read_ahead(1);
        if (sel err_first.err) { ret terr.Poll.err{err_first.err}; }
        if (_ahead_len == 0)   { ret terr.Poll.ok{opt[key.Key].none{}}; }
        if (_ahead[0] != 27)   { ret waiting(key.key_byte(take_ahead())); }

        val err_rest: terr.Operation = read_ahead(3);
        if (sel err_rest.err)                  { ret terr.Poll.err{err_rest.err}; }
        if (_ahead_len < 3 || _ahead[1] != 91) { ret waiting(key.key_byte(take_ahead())); } # not '['

        val arrow: u8 = _ahead[2];
        if (arrow < 65 || arrow > 68) { ret waiting(key.key_byte(take_ahead())); }
        _ahead_len = 0;

        if (arrow == 65) { ret waiting(key.key_special(key.KEY_UP)); }
        if (arrow == 66) { ret waiting(key.key_special(key.KEY_DOWN)); }
        if (arrow == 67) { ret waiting(key.key_special(key.KEY_RIGHT)); }
        ret waiting(key.key_special(key.KEY_LEFT));
    }
}

# poll the backend until n bytes are read ahead or nothing more is waiting
# ---
# n:   how many read-ahead bytes to hold, at most three
# ret: ok, or the native read failure
fun read_ahead(n: usize) terr.Operation {
    for (_ahead_len < n) {
        val res_polled: terr.Poll = impl.poll_key();
        if (sel res_polled.err)      { ret terr.Operation.err{res_polled.err}; }
        if (!sel res_polled.ok.some) { ret terr.Operation.ok{}; }
        val polled: key.Key = res_polled.ok.some;
        _ahead[_ahead_len] = polled.byte;
        _ahead_len         = _ahead_len + 1;
    }
    ret terr.Operation.ok{};
}

# remove and return the oldest read-ahead byte
fun take_ahead() u8 {
    val b: u8    = _ahead[0];
    var i: usize = 1;
    for (i < _ahead_len) {
        _ahead[i - 1] = _ahead[i];
        i             = i + 1;
    }
    _ahead_len = _ahead_len - 1;
    ret b;
}

fun waiting(k: key.Key) terr.Poll {
    ret terr.Poll.ok{opt[key.Key].some{k}};
}
