pub fun parse_u256(s: str, base: u8) res[u256, ParseError] {
    var out: u256                   = 0;
    val r:   res[usize, ParseError] = parse_words(s, base, (?out)::*u64, 4, false);
    if (sel r.err) { ret res[u256, ParseError].err{r.err}; }
    ret res[u256, ParseError].ok{out};
}

