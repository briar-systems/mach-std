# ret:  the parsed value, or the error
pub fun parse_i128(s: str, base: u8) res[i128, ParseError] {
    var out:                   u128                   = 0;
    val res_parse_wide_signed: res[usize, ParseError] = parse_wide_signed[u128](s, base, ?out, false);
    if (sel res_parse_wide_signed.err) { ret res[i128, ParseError].err{res_parse_wide_signed.err}; }
    ret res[i128, ParseError].ok{out::i128};
}

