# number parsing utilities
# ---
# parse integers and floats from strings with various bases and options. every
# parser reports a ParseError: invalid syntax and overflow are distinct, and
# both carry the byte offset at which the parse stopped.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char_digit_val;
use std.types.char.char_is_space;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.math.bignum.nat;
use std.math.ieee;
use std.memory;

# every way a number parse can fail
# ---
# empty:    nothing to parse (an empty string, or only whitespace)
# syntax:   the byte at the payload offset is not part of a valid number
# overflow: the value does not fit; payload is the offset at which the
#           overflow was detected
# base:     the requested base is outside 2..36; payload is that base
pub tag ParseError: u8 {
    empty;
    syntax:   usize;
    overflow: usize;
    base:     u8;
}

# move a delegated parser's offset to the caller's string
fun shifted(e: ParseError, by: usize) ParseError {
    if (sel e.syntax)   { ret ParseError.syntax{e.syntax + by}; }
    if (sel e.overflow) { ret ParseError.overflow{e.overflow + by}; }
    ret e;
}

# parse an unsigned 64-bit integer prefix from a string
#
# stops at the first character that is not a valid digit for the given base,
# returning the value parsed so far. use parse_u64_exact to require full
# input consumption.
# ---
# s:    string to parse
# base: numeric base (2-36), or 0 for auto-detect (0x, 0b, 0o prefixes)
# ret:  the parsed value, or an error message
pub fun parse_u64(s: str, base: u8) res[u64, ParseError] {
    val len: usize = str_len(s);
    if (len == 0) {
        ret res[u64, ParseError].err{ParseError.empty{}};
    }

    var i:           usize = 0;
    var actual_base: u8    = base;

    # skip leading whitespace
    for (i < len && char_is_space(s[i])) {
        i = i + 1;
    }

    if (i >= len) {
        ret res[u64, ParseError].err{ParseError.empty{}};
    }

    # auto-detect base if base == 0
    if (actual_base == 0) {
        if (s[i] == '0' && i + 1 < len) {
            val next: u8 = s[i + 1];
            if (next == 'x' || next == 'X') {
                actual_base = 16;
                i           = i + 2;
            }
            or (next == 'b' || next == 'B') {
                actual_base = 2;
                i           = i + 2;
            }
            or (next == 'o' || next == 'O') {
                actual_base = 8;
                i           = i + 2;
            }
            or {
                actual_base = 10;
            }
        }
        or {
            actual_base = 10;
        }
    }

    # validate base
    if (actual_base < 2 || actual_base > 36) {
        ret res[u64, ParseError].err{ParseError.base{actual_base}};
    }

    if (i >= len) {
        ret res[u64, ParseError].err{ParseError.syntax{i}};
    }

    var result:    u64  = 0;
    var has_digit: bool = false;
    val base_u64:  u64  = actual_base::u64;

    for (i < len) {
        val c: u8 = s[i];

        # allow underscore separators
        if (c == '_') {
            i = i + 1;
            cnt;
        }

        val dv: i32 = char_digit_val(c);
        if (dv < 0 || dv >= actual_base::u32::i32) {
            # invalid character for this base
            if (has_digit) {
                # stop at first invalid char (might be end of number)
                brk;
            }
            ret res[u64, ParseError].err{ParseError.syntax{i}};
        }

        val digit: u64 = (dv::u8)::u64;
        has_digit = true;

        # check for overflow before multiply
        val max_before_mul: u64 = 18446744073709551615 / base_u64;
        if (result > max_before_mul) {
            ret res[u64, ParseError].err{ParseError.overflow{i}};
        }

        val new_result: u64 = result * base_u64;

        # check for overflow before add
        val max_add: u64 = 18446744073709551615 - new_result;
        if (digit > max_add) {
            ret res[u64, ParseError].err{ParseError.overflow{i}};
        }

        result = new_result + digit;
        i      = i + 1;
    }

    if (!has_digit) {
        ret res[u64, ParseError].err{ParseError.syntax{i}};
    }

    ret res[u64, ParseError].ok{result};
}

# parse an unsigned 64-bit integer from a string, requiring full consumption
#
# returns an error if there are any characters remaining after the number.
# leading whitespace is also rejected.
# ---
# s:    string to parse
# base: numeric base (2-36), or 0 for auto-detect (0x, 0b, 0o prefixes)
# ret:  the parsed value, or an error message
pub fun parse_u64_exact(s: str, base: u8) res[u64, ParseError] {
    val len: usize = str_len(s);
    if (len == 0) {
        ret res[u64, ParseError].err{ParseError.empty{}};
    }

    var i:           usize = 0;
    var actual_base: u8    = base;

    if (actual_base == 0) {
        if (s[i] == '0' && i + 1 < len) {
            val next: u8 = s[i + 1];
            if (next == 'x' || next == 'X') {
                actual_base = 16;
                i           = i + 2;
            }
            or (next == 'b' || next == 'B') {
                actual_base = 2;
                i           = i + 2;
            }
            or (next == 'o' || next == 'O') {
                actual_base = 8;
                i           = i + 2;
            }
            or {
                actual_base = 10;
            }
        }
        or {
            actual_base = 10;
        }
    }

    if (actual_base < 2 || actual_base > 36) {
        ret res[u64, ParseError].err{ParseError.base{actual_base}};
    }

    if (i >= len) {
        ret res[u64, ParseError].err{ParseError.syntax{i}};
    }

    var result:    u64  = 0;
    var has_digit: bool = false;
    val base_u64:  u64  = actual_base::u64;

    for (i < len) {
        val c: u8 = s[i];

        if (c == '_') {
            i = i + 1;
            cnt;
        }

        val dv: i32 = char_digit_val(c);
        if (dv < 0 || dv >= actual_base::u32::i32) {
            ret res[u64, ParseError].err{ParseError.syntax{i}};
        }

        val digit: u64 = (dv::u8)::u64;
        has_digit = true;

        val max_before_mul: u64 = 18446744073709551615 / base_u64;
        if (result > max_before_mul) {
            ret res[u64, ParseError].err{ParseError.overflow{i}};
        }

        val new_result: u64 = result * base_u64;

        val max_add: u64 = 18446744073709551615 - new_result;
        if (digit > max_add) {
            ret res[u64, ParseError].err{ParseError.overflow{i}};
        }

        result = new_result + digit;
        i      = i + 1;
    }

    if (!has_digit) {
        ret res[u64, ParseError].err{ParseError.syntax{i}};
    }

    ret res[u64, ParseError].ok{result};
}

# parse a signed 64-bit integer prefix from a string
#
# delegates to parse_u64 for the unsigned portion, so it inherits the same
# prefix-parsing behavior. use parse_i64_exact to require full input
# consumption.
# ---
# s:    string to parse
# base: numeric base (2-36), or 0 for auto-detect (0x, 0b, 0o prefixes)
# ret:  the parsed value, or an error message
pub fun parse_i64(s: str, base: u8) res[i64, ParseError] {
    val len: usize = str_len(s);
    if (len == 0) {
        ret res[i64, ParseError].err{ParseError.empty{}};
    }

    var i: usize = 0;

    # skip leading whitespace
    for (i < len && char_is_space(s[i])) {
        i = i + 1;
    }

    if (i >= len) {
        ret res[i64, ParseError].err{ParseError.empty{}};
    }

    # check for sign
    var negative: bool = false;
    if (s[i] == '-') {
        negative = true;
        i        = i + 1;
    }
    or (s[i] == '+') {
        i = i + 1;
    }

    if (i >= len) {
        ret res[i64, ParseError].err{ParseError.syntax{i}};
    }

    # parse remaining as unsigned using pointer arithmetic
    val remaining: str                  = (?s[i])::str;
    val u_result:  res[u64, ParseError] = parse_u64(remaining, base);

    if (sel u_result.err) { ret res[i64, ParseError].err{shifted(u_result.err, i)}; }
    val u_val: u64 = u_result.ok;

    # i64 range: -9223372036854775808 to 9223372036854775807
    if (negative) {
        # for negative, magnitude can be up to 9223372036854775808
        if (u_val > 9223372036854775808) {
            ret res[i64, ParseError].err{ParseError.overflow{i}};
        }
        # special case: exactly i64 min
        if (u_val == 9223372036854775808) {
            ret res[i64, ParseError].ok{-9223372036854775808};
        }
        val signed: i64 = u_val::i64;
        ret res[i64, ParseError].ok{-signed};
    }

    # for positive, max is 9223372036854775807
    if (u_val > 9223372036854775807) {
        ret res[i64, ParseError].err{ParseError.overflow{i}};
    }
    ret res[i64, ParseError].ok{u_val::i64};
}

# parse a signed 64-bit integer from a string, requiring full consumption
#
# returns an error if there are any characters remaining after the number.
# leading whitespace is also rejected.
# ---
# s:    string to parse
# base: numeric base (2-36), or 0 for auto-detect (0x, 0b, 0o prefixes)
# ret:  the parsed value, or an error message
pub fun parse_i64_exact(s: str, base: u8) res[i64, ParseError] {
    val len: usize = str_len(s);
    if (len == 0) {
        ret res[i64, ParseError].err{ParseError.empty{}};
    }

    var i: usize = 0;

    var negative: bool = false;
    if (s[i] == '-') {
        negative = true;
        i        = i + 1;
    }
    or (s[i] == '+') {
        i = i + 1;
    }

    if (i >= len) {
        ret res[i64, ParseError].err{ParseError.syntax{i}};
    }

    val remaining: str                  = (?s[i])::str;
    val u_result:  res[u64, ParseError] = parse_u64_exact(remaining, base);

    if (sel u_result.err) { ret res[i64, ParseError].err{shifted(u_result.err, i)}; }
    val u_val: u64 = u_result.ok;

    if (negative) {
        if (u_val > 9223372036854775808) {
            ret res[i64, ParseError].err{ParseError.overflow{i}};
        }
        if (u_val == 9223372036854775808) {
            ret res[i64, ParseError].ok{-9223372036854775808};
        }
        val signed: i64 = u_val::i64;
        ret res[i64, ParseError].ok{-signed};
    }

    if (u_val > 9223372036854775807) {
        ret res[i64, ParseError].err{ParseError.overflow{i}};
    }
    ret res[i64, ParseError].ok{u_val::i64};
}

# the most 64-bit words a wide integer holds
val WIDE_WORDS: usize = 8;

# parse an unsigned integer of count 64-bit words into words, low word first
#
# the prefix form skips leading whitespace and stops at the first character that
# is not a digit of the base, as parse_u64 does. the exact form, as
# parse_u64_exact does, takes no whitespace and refuses any character left over.
# each digit multiplies and adds word by word through u128, so no arithmetic
# wider than 128 bits is asked of the backend
# ---
# s:     string to parse
# base:  numeric base (2-36), or 0 for auto-detect (0x, 0b, 0o prefixes)
# words: receives the value, count words
# count: the width in 64-bit words, at most WIDE_WORDS
# exact: whether the whole string must be the number
# ret:   the offset the parse stopped at, or the error
fun parse_words(s: str, base: u8, words: *u64, count: usize, exact: bool) res[usize, ParseError] {
    val len: usize = str_len(s);
    if (len == 0) { ret res[usize, ParseError].err{ParseError.empty{}}; }

    var i:           usize = 0;
    var actual_base: u8    = base;
    if (!exact) {
        for (i < len && char_is_space(s[i])) { i = i + 1; }
        if (i >= len) { ret res[usize, ParseError].err{ParseError.empty{}}; }
    }

    if (actual_base == 0) {
        actual_base = 10;
        if (s[i] == '0' && i + 1 < len) {
            val next: u8 = s[i + 1];
            if (next == 'x' || next == 'X') {
                actual_base = 16;
                i           = i + 2;
            }
            or (next == 'b' || next == 'B') {
                actual_base = 2;
                i           = i + 2;
            }
            or (next == 'o' || next == 'O') {
                actual_base = 8;
                i           = i + 2;
            }
        }
    }

    if (actual_base < 2 || actual_base > 36) { ret res[usize, ParseError].err{ParseError.base{actual_base}}; }
    if (i >= len)                            { ret res[usize, ParseError].err{ParseError.syntax{i}}; }

    var k: usize = 0;
    for (k < count) {
        words[k] = 0;
        k        = k + 1;
    }
    val radix:     u128 = actual_base::u128;
    var has_digit: bool = false;
    for (i < len) {
        val c: u8 = s[i];
        if (c == '_') {
            i = i + 1;
            cnt;
        }

        val dv: i32 = char_digit_val(c);
        if (dv < 0 || dv >= actual_base::u32::i32) {
            if (has_digit && !exact) { brk; }
            ret res[usize, ParseError].err{ParseError.syntax{i}};
        }
        has_digit = true;

        var carry: u128 = (dv::u8)::u128;
        k = 0;
        for (k < count) {
            val cur: u128 = words[k]::u128 * radix + carry;
            words[k] = cur::u64;
            carry    = cur >> 64;
            k        = k + 1;
        }
        if (carry != 0) { ret res[usize, ParseError].err{ParseError.overflow{i}}; }
        i = i + 1;
    }

    if (!has_digit) { ret res[usize, ParseError].err{ParseError.syntax{i}}; }
    ret res[usize, ParseError].ok{i};
}

# parse a signed integer of count 64-bit words into words, as parse_i64 does
#
# the magnitude is parsed by parse_words, up to 2^(64 count - 1) behind a '-'
# and one less without, then negated in place behind a '-'
# ---
# ret: the offset the parse stopped at, or the error
fun parse_words_signed(s: str, base: u8, words: *u64, count: usize, exact: bool) res[usize, ParseError] {
    val len: usize = str_len(s);
    if (len == 0) { ret res[usize, ParseError].err{ParseError.empty{}}; }

    var i: usize = 0;
    if (!exact) {
        for (i < len && char_is_space(s[i])) { i = i + 1; }
        if (i >= len) { ret res[usize, ParseError].err{ParseError.empty{}}; }
    }

    var negative: bool = false;
    if (s[i] == '-') {
        negative = true;
        i        = i + 1;
    }
    or (s[i] == '+') {
        i = i + 1;
    }
    if (i >= len) { ret res[usize, ParseError].err{ParseError.syntax{i}}; }

    val u: res[usize, ParseError] = parse_words((?s[i])::str, base, words, count, exact);
    if (sel u.err) { ret res[usize, ParseError].err{shifted(u.err, i)}; }

    val top: u64 = words[count - 1];
    if ((top >> 63) != 0) {
        # only 2^(64 count - 1) itself fits, and only behind a '-'
        var rest: bool  = top == (1::u64 << 63);
        var k:    usize = 0;
        for (k + 1 < count) {
            if (words[k] != 0) { rest = false; }
            k = k + 1;
        }
        if (!negative || !rest) { ret res[usize, ParseError].err{ParseError.overflow{i}}; }
    }
    if (negative) {
        var carry: u64   = 1;
        var k:     usize = 0;
        for (k < count) {
            val v: u64 = ~words[k] + carry;
            if (carry == 1 && v != 0) { carry = 0; }
            words[k] = v;
            k        = k + 1;
        }
    }
    ret res[usize, ParseError].ok{u.ok + i};
}

# parse an unsigned 128-bit integer prefix from a string, as parse_u64 does
# ---
# s:    string to parse
# base: numeric base (2-36), or 0 for auto-detect (0x, 0b, 0o prefixes)
# ret:  the parsed value, or the error
pub fun parse_u128(s: str, base: u8) res[u128, ParseError] {
    var out: u128                   = 0;
    val r:   res[usize, ParseError] = parse_words(s, base, (?out)::*u64, 2, false);
    if (sel r.err) { ret res[u128, ParseError].err{r.err}; }
    ret res[u128, ParseError].ok{out};
}

# parse an unsigned 128-bit integer from a string, requiring full consumption, as parse_u64_exact does
# ---
# s:    string to parse
# base: numeric base (2-36), or 0 for auto-detect (0x, 0b, 0o prefixes)
# ret:  the parsed value, or the error
pub fun parse_u128_exact(s: str, base: u8) res[u128, ParseError] {
    var out: u128                   = 0;
    val r:   res[usize, ParseError] = parse_words(s, base, (?out)::*u64, 2, true);
    if (sel r.err) { ret res[u128, ParseError].err{r.err}; }
    ret res[u128, ParseError].ok{out};
}

# parse an unsigned 256-bit integer prefix from a string, as parse_u64 does
# ---
# s:    string to parse
# base: numeric base (2-36), or 0 for auto-detect (0x, 0b, 0o prefixes)
