# sign of (num/den - 2^p), comparing the rational num/den to 2^p in a and b
fun cmp_ratio_pow2(num: *nat.Nat, den: *nat.Nat, p: i64, a: *nat.Nat, b: *nat.Nat) i64 {
    nat.copy(a, num);
    nat.copy(b, den);
    if (p >= 0) { nat.shl(b, p::usize); }
    or          { nat.shl(a, (0 - p)::usize); }
    ret nat.cmp(a, b);
}

# bignums a decimal parse holds at once, each of ieee.bignum_limbs limbs
val PARSE_BIGNUMS: usize = 4;

# the u32 words of work storage parse_float needs for format f
# ---
# f:   the format a parse rounds into
# ret: the words, PARSE_BIGNUMS bignums of ieee.bignum_limbs(f) limbs
pub fun parse_float_work(f: ieee.Format) usize {
    ret PARSE_BIGNUMS * ieee.bignum_limbs(f);
}

# nearest pattern of format f (sign excluded) to num * 10^D, ties to even
#
# exact bignum arithmetic at f's own precision: the quotient is taken one bit
# below the result's lsb and ieee.pack rounds it once, the remainder and any
# digits the scan dropped (trunc) making the sticky bit. handles subnormals,
# overflow to inf and underflow to zero. num is consumed, and spare holds the
# other three bignums, each of limbs limbs.
fun decimal_to_bits(f: ieee.Format, num: *nat.Nat, D: i64, trunc: bool, spare: *u32, limbs: usize) u128 {
    if (nat.is_zero(num)) { ret 0; }

    # out-of-range magnitudes short-circuit, which keeps the bignum bounded
    val approx: i64 = D + (nat.bitlen(num)::i64 * 1233) / 4096;
    if (approx > ieee.max_decimal_exp(f)) { ret ieee.inf_bits(f); }
    if (approx < ieee.min_decimal_exp(f)) { ret 0; }

    # exact rational num/den, the value
    var den: nat.Nat = nat.over(spare);
    var a:   nat.Nat = nat.over(?spare[limbs]);
    var b:   nat.Nat = nat.over(?spare[limbs * 2]);
    nat.from_u64(?den, 1);
    if (D >= 0) { nat.mul_pow10(num, D::usize); }
    or          { nat.mul_pow10(?den, (0 - D)::usize); }

    # find e2 with 2^(e2+p-1) <= value < 2^(e2+p), the normal significand window
    val p:    i64  = ieee.precision(f);
    var e2:   i64  = nat.bitlen(num)::i64 - nat.bitlen(?den)::i64 - p;
    var done: bool = false;
    for (!done) {
        if (cmp_ratio_pow2(num, ?den, e2 + p, ?a, ?b) >= 0) {
            e2 = e2 + 1;
            cnt;
        }
        if (cmp_ratio_pow2(num, ?den, e2 + p - 1, ?a, ?b) < 0) {
            e2 = e2 - 1;
            cnt;
        }
        done = true;
    }

    # the lsb clamps at the subnormal floor; the quotient keeps one bit below it
    var lsb: i64 = e2;
    if (lsb < ieee.min_lsb(f)) { lsb = ieee.min_lsb(f); }
    val at: i64 = lsb - 1;

    # num/den = value / 2^at
    if (at >= 0) { nat.shl(?den, at::usize); }
    or           { nat.shl(num, (0 - at)::usize); }

    # q = floor(num / den) by binary long division, under 2^(p+1) by the window,
    # leaving the remainder in num
    var q:   u128 = 0;
    var bit: i64  = p + 1;
    for (bit >= 0) {
        nat.copy(?a, ?den);
        nat.shl(?a, bit::usize);
        if (nat.cmp(num, ?a) >= 0) {
            nat.sub(num, ?a);
            q = q | (1::u128 << bit::u128);
        }
        bit = bit - 1;
    }

    ret ieee.pack(f, false, q, at, trunc || !nat.is_zero(num));
}

# scan integer + fractional digits from s at @i into M
#
# keeps at most maxsig significant digits, past which no digit can change a
# rounding of the target format; the dropped digits only report whether any was
# nonzero (out_trunc). advances @i and writes the decimal-exponent contribution
# to @out_dexp (value-so-far = M * 10^out_dexp). returns true iff at least one
# digit was seen.
fun collect_significand(s: str, len: usize, i: *usize, M: *nat.Nat, out_dexp: *i64, out_trunc: *bool, maxsig: i64) bool {
    nat.zero(M);
    var sig:       i64  = 0;
    var dexp:      i64  = 0;
    var seen:      bool = false;
    var truncated: bool = false;
    for (@i < len) {
        val c: u8 = s[@i];
        if (c == '_') {
            @i = @i + 1;
            cnt;
        }
        if (c < '0' || c > '9') { brk; }
        seen = true;
        if (sig < maxsig) {
            nat.mul_small(M, 10);
            nat.add_small(M, (c - '0')::u32);
            if (!nat.is_zero(M)) { sig = sig + 1; }
        }
        or {
            dexp = dexp + 1;
            if (c != '0') { truncated = true; }
        }
        @i = @i + 1;
    }
    if (@i < len && s[@i] == '.') {
        @i = @i + 1;
        for (@i < len) {
            val c: u8 = s[@i];
            if (c == '_') {
                @i = @i + 1;
                cnt;
            }
            if (c < '0' || c > '9') { brk; }
            seen = true;
            if (sig < maxsig) {
                nat.mul_small(M, 10);
                nat.add_small(M, (c - '0')::u32);
                if (!nat.is_zero(M)) { sig = sig + 1; }
                dexp = dexp - 1;
            }
            or {
                if (c != '0') { truncated = true; }
            }
            @i = @i + 1;
        }
    }
    @out_dexp  = dexp;
    @out_trunc = truncated;
    ret seen;
}

# exponents saturate here, far past where every format is inf or zero
val EXP_LIMIT: i64 = 1000000000;

# scan an optionally signed decimal exponent at @i into @out
#
# saturates at EXP_LIMIT so a huge exponent cannot wrap. returns false when no
# digit follows, leaving @i at the offending byte.
fun scan_exp(s: str, len: usize, i: *usize, out: *i64) bool {
    var sign: i64 = 1;
    if (@i < len && s[@i] == '+') { @i = @i + 1; }
    or (@i < len && s[@i] == '-') {
        sign = -1;
        @i   = @i + 1;
    }
    var e:    i64  = 0;
    var seen: bool = false;
    for (@i < len) {
        val c: u8 = s[@i];
        if (c == '_') {
            @i = @i + 1;
            cnt;
        }
        if (c < '0' || c > '9') { brk; }
        seen = true;
        if (e < EXP_LIMIT) { e = e * 10 + (c - '0')::u64::i64; }
        @i = @i + 1;
    }
    @out = e * sign;
    ret seen;
}

# the value of a hex digit, or -1
fun hex_digit(c: u8) i32 {
    val d: i32 = char_digit_val(c);
    if (d >= 16) { ret -1; }
    ret d;
}

# whether s at i opens a hex float: 0x or 0X then a hex digit, or a point and one
fun hex_opens(s: str, len: usize, i: usize) bool {
    if (i + 2 >= len || s[i] != '0' || (s[i + 1] != 'x' && s[i + 1] != 'X')) { ret false; }
    if (hex_digit(s[i + 2]) >= 0)                                            { ret true; }
    ret s[i + 2] == '.' && i + 3 < len && hex_digit(s[i + 3]) >= 0;
}

# scan a hex significand and optional binary exponent at @i, rounding into f
#
# the significand gathers exactly while it has room for 124 bits, more than any
# row's precision; later digits only scale it or mark the sticky bit, so
# ieee.pack rounds the whole literal once.
fun scan_hex(f: ieee.Format, s: str, len: usize, i: *usize, neg: bool) res[u128, ParseError] {
    var acc:    u128 = 0;
    var exp:    i64  = 0;
    var sticky: bool = false;
    var point:  bool = false;
    for (@i < len) {
        val c: u8 = s[@i];
        if (c == '_') {
            @i = @i + 1;
            cnt;
        }
        if (c == '.' && !point) {
            point = true;
            @i    = @i + 1;
            cnt;
        }
        val d: i32 = hex_digit(c);
        if (d < 0) { brk; }
        if ((acc >> 124) == 0) {
            acc = (acc << 4) | (d::u8)::u128;
            if (point) { exp = exp - 4; }
        }
        or {
            if (d != 0) { sticky = true; }
            if (!point) { exp = exp + 4; }
        }
        @i = @i + 1;
    }
    if (@i < len && (s[@i] == 'p' || s[@i] == 'P')) {
        @i = @i + 1;
        var e: i64 = 0;
        if (!scan_exp(s, len, i, ?e)) { ret res[u128, ParseError].err{ParseError.syntax{@i}}; }
        exp = exp + e;
    }
    ret res[u128, ParseError].ok{ieee.pack(f, neg, acc, exp, sticky)};
}

# which literal form a float parse reads
# ---
# decimal: digits with an optional point and an optional `e` exponent
# hex:     a C99 hex float, `0x` or `0X` then hex digits with an optional point
#          and an optional `p` exponent
pub tag Radix: u8 {
    decimal;
    hex;
}

# the offset where s at i stops being `0x` then a hex digit or a point and one
fun hex_stop(s: str, len: usize, i: usize) usize {
    var j: usize = i;
    if (j < len && s[j] == '0') {
        j = j + 1;
        if (j < len && (s[j] == 'x' || s[j] == 'X')) {
            j = j + 1;
            if (j < len && s[j] == '.') { j = j + 1; }
        }
    }
    ret j;
}

# parse a float of any ieee.Format row from the first `len` bytes of `s`
#
# the one parse every width and radix runs. accepts an optional sign, then `inf`,
# `nan`, or a literal of the given radix, with `_` separators between digits.
# both radices round to nearest, ties to even, at the format's own precision,
# into the subnormal range and to inf. a sign before `nan` is ignored. a decimal
# parse never reads hex: `0x1p3` is the decimal 0 followed by a stray `x`.
# ---
# f:     the format to round into
# radix: the literal form to read
# s:     the bytes to parse
# len:   the number of bytes available in s
# whole: require the span be the number exactly, with no leading whitespace or
#        trailing byte; otherwise skip leading whitespace and stop at the first
#        byte that is not part of a float
# work:  storage a decimal parse works in, a row's ParseWork type (F64ParseWork
#        for ieee.F64) or parse_float_work(f) u32 words; a hex parse never
#        touches it
# ret:   the pattern in the low end, or the failure
pub fun parse_float(f: ieee.Format, radix: Radix, s: str, len: usize, whole: bool, work: *u32) res[u128, ParseError] {
    if (len == 0) { ret res[u128, ParseError].err{ParseError.empty{}}; }

    var i: usize = 0;
    if (!whole) {
        for (i < len && char_is_space(s[i])) {
            i = i + 1;
        }
        if (i >= len) { ret res[u128, ParseError].err{ParseError.empty{}}; }
    }

    var neg: bool = false;
    if (s[i] == '-') {
        neg = true;
        i   = i + 1;
    }
    or (s[i] == '+') { i = i + 1; }

    if (i >= len) { ret res[u128, ParseError].err{ParseError.syntax{i}}; }

    var sign: u128 = 0;
    if (neg) { sign = ieee.sign_bit(f); }

    if (i + 3 <= len && s[i] == 'i' && s[i + 1] == 'n' && s[i + 2] == 'f') {
        if (whole && i + 3 != len) { ret res[u128, ParseError].err{ParseError.syntax{i}}; }
        ret res[u128, ParseError].ok{sign | ieee.inf_bits(f)};
    }
    if (i + 3 <= len && s[i] == 'n' && s[i + 1] == 'a' && s[i + 2] == 'n') {
        if (whole && i + 3 != len) { ret res[u128, ParseError].err{ParseError.syntax{i}}; }
        ret res[u128, ParseError].ok{ieee.nan_bits(f)};
    }

    var bits: u128 = 0;
    if (sel radix.hex) {
        if (!hex_opens(s, len, i)) { ret res[u128, ParseError].err{ParseError.syntax{hex_stop(s, len, i)}}; }
        i = i + 2;
        val h: res[u128, ParseError] = scan_hex(f, s, len, ?i, neg);
        if (sel h.err) { ret h; }
        bits = h.ok;
    }
    or {
        val limbs: usize   = ieee.bignum_limbs(f);
        var M:     nat.Nat = nat.over(work);
        var dexp:  i64     = 0;
        var trunc: bool    = false;
        if (!collect_significand(s, len, ?i, ?M, ?dexp, ?trunc, ieee.max_sig_digits(f))) {
            ret res[u128, ParseError].err{ParseError.syntax{i}};
        }
        var exp: i64 = 0;
        if (i < len && (s[i] == 'e' || s[i] == 'E')) {
            i = i + 1;
            if (!scan_exp(s, len, ?i, ?exp)) { ret res[u128, ParseError].err{ParseError.syntax{i}}; }
        }
        bits = sign | decimal_to_bits(f, ?M, dexp + exp, trunc, ?work[limbs], limbs);
    }

    if (whole && i != len) { ret res[u128, ParseError].err{ParseError.syntax{i}}; }
    ret res[u128, ParseError].ok{bits};
}

# parse_float work storage for each row, a u32 array a caller declares and
# passes as ?work[0]: PARSE_BIGNUMS bignums of the row's committed limbs, the
# length parse_float_work gives
pub def F16ParseWork:  [PARSE_BIGNUMS * ieee.F16_LIMBS]u32;
pub def F32ParseWork:  [PARSE_BIGNUMS * ieee.F32_LIMBS]u32;
pub def F64ParseWork:  [PARSE_BIGNUMS * ieee.F64_LIMBS]u32;
#[testing]
pub def BF16ParseWork: [PARSE_BIGNUMS * ieee.BF16_LIMBS]u32;
#[testing]
pub def F128ParseWork: [PARSE_BIGNUMS * ieee.F128_LIMBS]u32;

# a decimal parse of f in stack storage of type W, a u32 array sized for f
fun decimal_in[W](f: ieee.Format, s: str, len: usize, whole: bool) res[u128, ParseError] {
    var work: W;
    ret parse_float(f, Radix.decimal{}, s, len, whole, (?work)::*u32);
}

# the f64 a binary64 parse names
fun as_f64(r: res[u128, ParseError]) res[f64, ParseError] {
    if (sel r.err) { ret res[f64, ParseError].err{r.err}; }
    val bits: u64 = r.ok::u64;
    var v:    f64;
    memory.raw_copy(?v, ?bits, 8);
    ret res[f64, ParseError].ok{v};
}

# the f32 a binary32 parse names
fun as_f32(r: res[u128, ParseError]) res[f32, ParseError] {
    if (sel r.err) { ret res[f32, ParseError].err{r.err}; }
    val bits: u32 = r.ok::u32;
    var v:    f32;
    memory.raw_copy(?v, ?bits, 4);
    ret res[f32, ParseError].ok{v};
}

# the f16 a binary16 parse names
fun as_f16(r: res[u128, ParseError]) res[f16, ParseError] {
    if (sel r.err) { ret res[f16, ParseError].err{r.err}; }
    val bits: u16 = r.ok::u16;
    var v:    f16;
    memory.raw_copy(?v, ?bits, 2);
    ret res[f16, ParseError].ok{v};
}

# parse a 64-bit floating point number prefix from a string
#
# decimal, correctly rounded, as parse_float describes. skips leading whitespace
# and stops at the first character that is not part of a valid float.
# use parse_f64_exact to require full input consumption, or parse_f64_len for a
# span that is not null-terminated.
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f64(s: str) res[f64, ParseError] {
    ret parse_f64_len(s, str_len(s));
}

# parse a 64-bit floating point number prefix from the first `len` bytes of `s`
#
# like parse_f64 but bounded by an explicit length instead of a null terminator,
# so it is safe on a byte span embedded in a larger buffer (e.g. a zero-copy
# slice into a parse input). stops at the first byte that is not part of a valid
# float, or at `len`.
# ---
# s:   the bytes to parse
# len: the number of bytes available in s
# ret: the parsed value, or an error message
pub fun parse_f64_len(s: str, len: usize) res[f64, ParseError] {
    ret as_f64(decimal_in[F64ParseWork](ieee.F64, s, len, false));
}

# parse a 64-bit floating point number from a string, requiring full consumption
#
# handles optional sign, integer part, fractional part, and exponent.
# also handles special values inf, -inf, nan, +inf, +nan. returns an error if there are any
# characters remaining after the number. leading whitespace is also rejected.
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f64_exact(s: str) res[f64, ParseError] {
    ret as_f64(decimal_in[F64ParseWork](ieee.F64, s, str_len(s), true));
}

# parse a 32-bit floating point number prefix from a string
#
# correctly rounded at f32's own precision, never through f64. otherwise as
# parse_f64.
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f32(s: str) res[f32, ParseError] {
    ret parse_f32_len(s, str_len(s));
}

# parse a 32-bit floating point number prefix from the first `len` bytes of `s`
# ---
# s:   the bytes to parse
# len: the number of bytes available in s
# ret: the parsed value, or an error message
pub fun parse_f32_len(s: str, len: usize) res[f32, ParseError] {
    ret as_f32(decimal_in[F32ParseWork](ieee.F32, s, len, false));
}

# parse a 32-bit floating point number from a string, requiring full consumption
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f32_exact(s: str) res[f32, ParseError] {
    ret as_f32(decimal_in[F32ParseWork](ieee.F32, s, str_len(s), true));
}

# parse a 16-bit floating point number prefix from a string
#
# correctly rounded at f16's own precision, never through a wider format.
# otherwise as parse_f64.
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f16(s: str) res[f16, ParseError] {
    ret parse_f16_len(s, str_len(s));
}

# parse a 16-bit floating point number prefix from the first `len` bytes of `s`
# ---
# s:   the bytes to parse
# len: the number of bytes available in s
# ret: the parsed value, or an error message
pub fun parse_f16_len(s: str, len: usize) res[f16, ParseError] {
    ret as_f16(decimal_in[F16ParseWork](ieee.F16, s, len, false));
}

# parse a 16-bit floating point number from a string, requiring full consumption
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f16_exact(s: str) res[f16, ParseError] {
    ret as_f16(decimal_in[F16ParseWork](ieee.F16, s, str_len(s), true));
}

# parse a 64-bit C99 hex float prefix from a string
#
# `0x` then hex digits with an optional point and an optional `p` exponent, as
# parse_float describes, rounded half to even at f64's own precision. skips
# leading whitespace and stops at the first character past the float.
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f64_hex(s: str) res[f64, ParseError] {
    ret parse_f64_hex_len(s, str_len(s));
}

# parse a 64-bit C99 hex float prefix from the first `len` bytes of `s`
# ---
# s:   the bytes to parse
# len: the number of bytes available in s
# ret: the parsed value, or an error message
pub fun parse_f64_hex_len(s: str, len: usize) res[f64, ParseError] {
    ret as_f64(parse_float(ieee.F64, Radix.hex{}, s, len, false, nil));
}

# parse a 64-bit C99 hex float from a string, requiring full consumption
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f64_hex_exact(s: str) res[f64, ParseError] {
    ret as_f64(parse_float(ieee.F64, Radix.hex{}, s, str_len(s), true, nil));
}

# parse a 32-bit C99 hex float prefix from a string
#
# `0x` then hex digits with an optional point and an optional `p` exponent, as
# parse_float describes, rounded half to even at f32's own precision. skips
# leading whitespace and stops at the first character past the float.
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f32_hex(s: str) res[f32, ParseError] {
    ret parse_f32_hex_len(s, str_len(s));
}

# parse a 32-bit C99 hex float prefix from the first `len` bytes of `s`
# ---
# s:   the bytes to parse
# len: the number of bytes available in s
# ret: the parsed value, or an error message
pub fun parse_f32_hex_len(s: str, len: usize) res[f32, ParseError] {
    ret as_f32(parse_float(ieee.F32, Radix.hex{}, s, len, false, nil));
}

# parse a 32-bit C99 hex float from a string, requiring full consumption
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f32_hex_exact(s: str) res[f32, ParseError] {
    ret as_f32(parse_float(ieee.F32, Radix.hex{}, s, str_len(s), true, nil));
}

# parse a 16-bit C99 hex float prefix from a string
#
# `0x` then hex digits with an optional point and an optional `p` exponent, as
# parse_float describes, rounded half to even at f16's own precision. skips
# leading whitespace and stops at the first character past the float.
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f16_hex(s: str) res[f16, ParseError] {
    ret parse_f16_hex_len(s, str_len(s));
}

# parse a 16-bit C99 hex float prefix from the first `len` bytes of `s`
# ---
# s:   the bytes to parse
# len: the number of bytes available in s
# ret: the parsed value, or an error message
pub fun parse_f16_hex_len(s: str, len: usize) res[f16, ParseError] {
    ret as_f16(parse_float(ieee.F16, Radix.hex{}, s, len, false, nil));
}

# parse a 16-bit C99 hex float from a string, requiring full consumption
# ---
# s:   string to parse
# ret: the parsed value, or an error message
pub fun parse_f16_hex_exact(s: str) res[f16, ParseError] {
    ret as_f16(parse_float(ieee.F16, Radix.hex{}, s, str_len(s), true, nil));
}

# whether parse_u64(s, base) succeeds with want
#[testing]
fun u64_is(s: str, base: u8, want: u64) bool {
    val r: res[u64, ParseError] = parse_u64(s, base);
    if (sel r.err) { ret false; }
    ret r.ok == want;
}

# whether parse_i64(s, base) succeeds with want
#[testing]
fun i64_is(s: str, base: u8, want: i64) bool {
    val r: res[i64, ParseError] = parse_i64(s, base);
    if (sel r.err) { ret false; }
    ret r.ok == want;
}

# each base by name and by prefix, either hex case, underscores, leading
# whitespace, the maximum, and a stop at the first byte that is not a digit
test parse_u64__bases_and_bounds {
    if (!u64_is("0", 10, 0))                                       { ret 1; }
    if (!u64_is("12345", 10, 12345))                               { ret 2; }
    if (!u64_is("ff", 16, 255) || !u64_is("FF", 16, 255))          { ret 3; }
    if (!u64_is("1010", 2, 10) || !u64_is("77", 8, 63))            { ret 4; }
    if (!u64_is("0xff", 0, 255) || !u64_is("0b1010", 0, 10))       { ret 5; }
    if (!u64_is("0o77", 0, 63) || !u64_is("999", 0, 999))          { ret 6; }
    if (!u64_is("1_000_000", 10, 1000000))                         { ret 7; }
    if (!u64_is("  42", 10, 42))                                   { ret 8; }
    if (!u64_is("18446744073709551615", 10, 18446744073709551615)) { ret 9; }
    if (!u64_is("12g45", 10, 12))                                  { ret 10; }
    ret 0;
}

# either sign, a signed prefix, underscores, whitespace, and both bounds, one
# past the negative bound refused
test parse_i64__signs_and_bounds {
    if (!i64_is("-12345", 10, -12345) || !i64_is("+42", 10, 42))   { ret 1; }
    if (!i64_is("-0", 10, 0))                                      { ret 2; }
    if (!i64_is("-0xff", 0, -255))                                 { ret 3; }
    if (!i64_is("-1_000_000", 10, -1000000))                       { ret 4; }
    if (!i64_is("  -42", 10, -42))                                 { ret 5; }
    if (!i64_is("9223372036854775807", 10, 9223372036854775807))   { ret 6; }
    if (!i64_is("-9223372036854775808", 10, -9223372036854775808)) { ret 7; }
    val under: res[i64, ParseError] = parse_i64("-9223372036854775809", 10);
    if (!sel under.err) { ret 8; }
    ret 0;
}

# the exact forms accept what the prefix forms accept and refuse any byte left
# over, whitespace included
test parse__exact_forms_refuse_leftover_bytes {
    val u: res[u64, ParseError] = parse_u64_exact("0x1_0", 0);
    if (sel u.err)  { ret 1; }
    if (u.ok != 16) { ret 1; }
    val u_tail: res[u64, ParseError] = parse_u64_exact("12g45", 10);
    if (sel u_tail.ok) { ret 2; }
    val u_lead: res[u64, ParseError] = parse_u64_exact(" 42", 10);
    if (sel u_lead.ok) { ret 3; }

    val i: res[i64, ParseError] = parse_i64_exact("-12345", 10);
    if (sel i.err)      { ret 4; }
    if (i.ok != -12345) { ret 4; }
    val i_tail: res[i64, ParseError] = parse_i64_exact("42 ", 10);
    if (sel i_tail.ok) { ret 5; }

    val f: res[f64, ParseError] = parse_f64_exact("1.5e2");
    if (sel f.err)     { ret 6; }
    if (f.ok != 150.0) { ret 6; }
    val f_tail: res[f64, ParseError] = parse_f64_exact("3.14abc");
    if (sel f_tail.ok) { ret 7; }
    val inf: res[f64, ParseError] = parse_f64_exact("inf");
    if (sel inf.err) { ret 8; }
    val inf_tail: res[f64, ParseError] = parse_f64_exact("inf ");
    if (sel inf_tail.ok) { ret 9; }
    ret 0;
}

# parse_f64_len stops at `len` and never reads a trailing null, so a float span
# embedded in a larger buffer parses without consuming its neighbours.
test parse__f64_len_bounded_span {
    # only the first 3 bytes ("1.5") are in scope; the "e9" must be ignored.
    val r: res[f64, ParseError] = parse_f64_len("1.5e9", 3);
    if (sel r.err)   { ret 1; }
    if (r.ok != 1.5) { ret 1; }
    ret 0;
}

# parse s and return its f64 bit pattern (0xDEADBEEF sentinel on error)
#[testing]
fun pbits(s: str) u64 {
    val r: res[f64, ParseError] = parse_f64(s);
    if (sel r.err) { ret 0xDEADBEEF; }
    val v:    f64 = r.ok;
    var bits: u64;
    memory.raw_copy(?bits, ?v, 8);
    ret bits;
}

test parse_f64__correctly_rounded_golden_bits {
    if (pbits("0") != 0)                                        { ret 1; }
    if (pbits("1") != 0x3FF0000000000000)                       { ret 1; }
    if (pbits("-1") != 0xBFF0000000000000)                      { ret 1; }
    if (pbits("0.5") != 0x3FE0000000000000)                     { ret 1; }
    if (pbits("1.5") != 0x3FF8000000000000)                     { ret 1; }
    if (pbits("0.1") != 0x3FB999999999999A)                     { ret 1; }
    if (pbits("3.141592653589793") != 0x400921FB54442D18)       { ret 1; }
    if (pbits("10000000000000000") != 0x4341C37937E08000)       { ret 1; }
    if (pbits("1e100") != 0x54B249AD2594C37D)                   { ret 1; }
    if (pbits("1.7976931348623157e308") != 0x7FEFFFFFFFFFFFFF)  { ret 1; }
    if (pbits("2.2250738585072014e-308") != 0x0010000000000000) { ret 1; }
    if (pbits("5e-324") != 1)                                   { ret 1; }
    if (pbits("1_000.5") != 0x408F440000000000)                 { ret 2; }
    ret 0;
}

test parse_f64__special_and_out_of_range {
    if (pbits("-0") != 0x8000000000000000)    { ret 1; }
    if (pbits("inf") != 0x7FF0000000000000)   { ret 1; }
    if (pbits("-inf") != 0xFFF0000000000000)  { ret 1; }
    if (pbits("nan") != 0x7FF8000000000000)   { ret 1; }
    if (pbits("1e400") != 0x7FF0000000000000) { ret 1; }
    if (pbits("1e-400") != 0)                 { ret 1; }
    if (pbits("1e320") != 0x7FF0000000000000) { ret 2; }
    if (pbits("1e-340") != 0)                 { ret 2; }
    if (pbits("4.9e-324") != 1)               { ret 2; }
    if (pbits("2.4e-324") != 0)               { ret 2; }
    ret 0;
}

test parse_f64__round_to_even_ties_and_carry_out {
    # exact midpoint 1.0 <-> 1+2^-52 -> round to even (down) = 1.0
    if (pbits("1.00000000000000011102230246251565404236316680908203125") != 0x3FF0000000000000) { ret 1; }
    # exact midpoint 1+2^-52 <-> 1+2*2^-52 -> round to even (up) = ...0002
    if (pbits("1.00000000000000033306690738754696212708950042724609375") != 0x3FF0000000000002) { ret 1; }
    # exact midpoint just below 1.0 -> round to even = 1.0 (exercises the q==2^53 carry-out)
    if (pbits("0.99999999999999994448884876874217606037855148315429687500") != 0x3FF0000000000000) { ret 1; }
    ret 0;
}

# the truncation tie: matches the 1.0 <-> 1+2^-52 midpoint to 768 significant
# digits, then a nonzero 769th digit -> strictly above the midpoint, must round UP.
# without the sticky bit this is misread as an exact tie and rounds to-even (down).
test parse_f64__768_digit_truncation_tie_rounds_up_sticky {
    var buf:    [1024]u8;
    val prefix: str   = "1.00000000000000011102230246251565404236316680908203125";
    var n:      usize = 0;
    var k:      usize = 0;
    for (prefix[k] != 0) {
        buf[n] = prefix[k];
        n      = n + 1;
        k      = k + 1;
    }
    var z: usize = 0;
    for (z < 714) {
        buf[n] = '0';
        n      = n + 1;
        z      = z + 1;
    }
    buf[n] = '1';
    n      = n + 1;
    buf[n] = 0;
    if (pbits(?buf[0]) != 0x3FF0000000000001) { ret 1; }
    ret 0;
}

test parse_f64__subnormal_ties_and_sticky_oracle {
    # subnormal tie-to-even up
    if (pbits("0.") != 0x0000000000000002) { ret 1; }
    # subnormal->normal carry tie
    if (pbits("0.") != 0x0010000000000000) { ret 1; }
    # subnormal sticky pushes up
    if (pbits("0.") != 0x000FFFFFFFFFFFFF) { ret 1; }
    ret 0;
}

# each failure is classified, not described: absence, syntax, overflow and a
# bad base are distinct cases, and syntax and overflow carry the offset
test parse__failures_carry_offsets {
    val e1: res[u64, ParseError] = parse_u64("", 10);
    if (!sel e1.err)       { ret 1; }
    if (!sel e1.err.empty) { ret 1; }

    val e2: res[u64, ParseError] = parse_u64("   ", 10);
    if (!sel e2.err)       { ret 2; }
    if (!sel e2.err.empty) { ret 2; }

    val b: res[u64, ParseError] = parse_u64("12", 1);
    if (!sel b.err)      { ret 3; }
    if (!sel b.err.base) { ret 3; }
    if (b.err.base != 1) { ret 3; }

    val s1: res[u64, ParseError] = parse_u64("  abc", 10);
    if (!sel s1.err)        { ret 4; }
    if (!sel s1.err.syntax) { ret 4; }
    if (s1.err.syntax != 2) { ret 4; }

    val o: res[u64, ParseError] = parse_u64("18446744073709551616", 10);
    if (!sel o.err)           { ret 5; }
    if (!sel o.err.overflow)  { ret 5; }
    if (o.err.overflow != 19) { ret 5; }

    val s2: res[u64, ParseError] = parse_u64_exact("42 ", 10);
    if (!sel s2.err)        { ret 6; }
    if (!sel s2.err.syntax) { ret 6; }
    if (s2.err.syntax != 2) { ret 6; }

    # a delegated parse reports the offset in the caller's string
    val s3: res[i64, ParseError] = parse_i64("  -x", 10);
    if (!sel s3.err)        { ret 7; }
    if (!sel s3.err.syntax) { ret 7; }
    if (s3.err.syntax != 3) { ret 7; }
    val s4: res[i64, ParseError] = parse_i64_exact("-1x", 10);
    if (!sel s4.err)        { ret 7; }
    if (!sel s4.err.syntax) { ret 7; }
    if (s4.err.syntax != 2) { ret 7; }

    val o2: res[i64, ParseError] = parse_i64("9223372036854775808", 10);
    if (!sel o2.err)          { ret 8; }
    if (!sel o2.err.overflow) { ret 8; }

    val f1: res[f64, ParseError] = parse_f64("1e");
    if (!sel f1.err)        { ret 9; }
    if (!sel f1.err.syntax) { ret 9; }
    if (f1.err.syntax != 2) { ret 9; }

    val f2: res[f64, ParseError] = parse_f64_exact("3.14 ");
    if (!sel f2.err)        { ret 10; }
    if (!sel f2.err.syntax) { ret 10; }
    if (f2.err.syntax != 4) { ret 10; }

    val f3: res[f64, ParseError] = parse_f64_len("3.14", 0);
    if (!sel f3.err)       { ret 11; }
    if (!sel f3.err.empty) { ret 11; }
    ret 0;
}

# parse all of s as an f32 and return its pattern, a sentinel past 32 bits on error
#[testing]
fun t32(s: str) u64 {
    val r: res[f32, ParseError] = parse_f32_exact(s);
    if (sel r.err) { ret 0xDEADBEEF00; }
    val v:    f32 = r.ok;
    var bits: u32;
    memory.raw_copy(?bits, ?v, 4);
    ret bits::u64;
}

# parse all of s as an f16 and return its pattern, a sentinel past 16 bits on error
#[testing]
fun t16(s: str) u64 {
    val r: res[f16, ParseError] = parse_f16_exact(s);
    if (sel r.err) { ret 0xDEADBEEF00; }
    val v:    f16 = r.ok;
    var bits: u16;
    memory.raw_copy(?bits, ?v, 2);
    ret bits::u64;
}

# parse all of s as an f32 hex float and return its pattern, a sentinel on error
#[testing]
fun x32(s: str) u64 {
    val r: res[f32, ParseError] = parse_f32_hex_exact(s);
    if (sel r.err) { ret 0xDEADBEEF00; }
    val v:    f32 = r.ok;
    var bits: u32;
    memory.raw_copy(?bits, ?v, 4);
    ret bits::u64;
}

# parse all of s as an f16 hex float and return its pattern, a sentinel on error
#[testing]
fun x16(s: str) u64 {
    val r: res[f16, ParseError] = parse_f16_hex_exact(s);
    if (sel r.err) { ret 0xDEADBEEF00; }
    val v:    f16 = r.ok;
    var bits: u16;
    memory.raw_copy(?bits, ?v, 2);
    ret bits::u64;
}

# parse all of s as an f64 hex float and return its pattern, a sentinel on error
#[testing]
fun x64(s: str) u128 {
    val r: res[f64, ParseError] = parse_f64_hex_exact(s);
    if (sel r.err) { ret 1::u128 << 100; }
    val v:    f64 = r.ok;
    var bits: u64;
    memory.raw_copy(?bits, ?v, 8);
    ret bits::u128;
}

# 1 + 2^-24 + 10^-29 sits above the f32 midpoint 1 + 2^-24 by far less than half
# an f64 ulp, so f64 rounds it onto the midpoint and the cast then ties to even,
# down. the f32 parse rounds once, up. glibc strtof gives 0x3F800001 and
# (float)strtod gives 0x3F800000.
test parse_f32__rounds_once_where_f64_then_a_cast_rounds_twice {
    val s: str = "1.00000005960464477539062500001";
    if (t32(s) != 0x3F800001) { ret 1; }
    val wide: res[f64, ParseError] = parse_f64_exact(s);
    if (sel wide.err) { ret 2; }
    val narrowed: f32 = wide.ok::f32;
    var bits:     u32;
    memory.raw_copy(?bits, ?narrowed, 4);
    if (bits != 0x3F800000) { ret 3; }
    ret 0;
}

# every expected pattern is glibc strtof's, and agrees with rounding the literal's
# exact rational value half to even at 24 bits. the long literals are the exact
# decimal expansions of the dyadic values the comments name.
test parse_f32__correctly_rounded_edges {
    # 1 + 2^-24, the midpoint above 1: even is 1
    if (t32("1.000000059604644775390625") != 0x3F800000) { ret 1; }
    # 1 + 3 * 2^-24, the midpoint below 1 + 2^-22: even is up
    if (t32("1.000000178813934326171875") != 0x3F800002) { ret 2; }
    # 2^-149, the smallest subnormal
    if (t32("0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125") != 0x00000001) { ret 3; }
    # 2^-149 shortest
    if (t32("1e-45") != 0x00000001) { ret 4; }
    # 2^-150, half the smallest subnormal: even is zero
    if (t32("0.000000000000000000000000000000000000000000000700649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625") != 0x00000000) { ret 5; }
    # 2^-150 and a nonzero digit past it: up
    if (t32("0.0000000000000000000000000000000000000000000007006492321624085354618647916449580656401309709382578858785341419448955413429303007433190941810607910156250000001") != 0x00000001) { ret 6; }
    # 3 * 2^-150 between subnormals 1 and 2: even is 2
    if (t32("0.000000000000000000000000000000000000000000002101947696487225606385594374934874196920392912814773657635602425834686624028790902229957282543182373046875") != 0x00000002) { ret 7; }
    # (2^23 - 1) * 2^-149, the largest subnormal
    if (t32("0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875") != 0x007FFFFF) { ret 8; }
    # (2^24 - 1) * 2^-150, between the largest subnormal and 2^-126: even is up
    if (t32("0.000000000000000000000000000000000000011754942807573642917278829910357665133228589927589904276829631184250030649651730385585324256680905818939208984375") != 0x00800000) { ret 9; }
    # 2^-126, the smallest normal
    if (t32("0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625") != 0x00800000) { ret 10; }
    # 2^-126 shortest
    if (t32("1.1754944e-38") != 0x00800000) { ret 11; }
    # (2^24 - 1) * 2^104, the largest finite
    if (t32("340282346638528859811704183484516925440") != 0x7F7FFFFF) { ret 12; }
    # the largest finite, shortest
    if (t32("3.4028235e38") != 0x7F7FFFFF) { ret 13; }
    # (2^25 - 1) * 2^103, the midpoint past the largest finite: even is inf
    if (t32("340282356779733661637539395458142568448") != 0x7F800000) { ret 14; }
    # just under that midpoint: the largest finite
    if (t32("340282356779733661637539395458142568447.999") != 0x7F7FFFFF) { ret 15; }
    # 1e39, past the overflow boundary
    if (t32("1e39") != 0x7F800000) { ret 16; }
    # negative zero
    if (t32("-0") != 0x80000000) { ret 17; }
    # a negative value under half the smallest subnormal is negative zero
    if (t32("-1e-60") != 0x80000000) { ret 18; }
    # 0.1
    if (t32("0.1") != 0x3DCCCCCD) { ret 19; }
    ret 0;
}

# every expected pattern is glibc strtof's, and agrees with rounding the
# literal's exact binary value half to even at 24 bits
test parse_f32__hex_rounds_half_to_even {
    # 2^-149
    if (x32("0x1p-149") != 0x00000001) { ret 1; }
    # 0x1.998p-4 is exact in f32
    if (x32("0x1.998p-4") != 0x3DCCC000) { ret 2; }
    # 1 + 2^-24, a tie: even is 1
    if (x32("0x1.000001p0") != 0x3F800000) { ret 3; }
    # 1 + 3 * 2^-24, a tie: even is up
    if (x32("0x1.000003p0") != 0x3F800002) { ret 4; }
    # just over 1 + 2^-24: up
    if (x32("0x1.0000010000000000000000001p0") != 0x3F800001) { ret 5; }
    # 2^-150, a tie at the subnormal floor: even is zero
    if (x32("0x1p-150") != 0x00000000) { ret 6; }
    # just over 2^-150: up to the smallest subnormal
    if (x32("0x1.0000000000000000000000001p-150") != 0x00000001) { ret 7; }
    # 1.5 * 2^-149, a subnormal tie: even is 2
    if (x32("0x1.8p-149") != 0x00000002) { ret 8; }
    # (2^23 - 1) * 2^-149, the largest subnormal
    if (x32("0x1.fffffcp-127") != 0x007FFFFF) { ret 9; }
    # 2^-126, the smallest normal
    if (x32("0x1p-126") != 0x00800000) { ret 10; }
    # the largest finite
    if (x32("0x1.fffffep127") != 0x7F7FFFFF) { ret 11; }
    # the midpoint past the largest finite: even is inf
    if (x32("0x1.ffffffp127") != 0x7F800000) { ret 12; }
    # just under that midpoint: the largest finite
    if (x32("0x1.fffffefffp127") != 0x7F7FFFFF) { ret 13; }
    # 2^128 overflows
    if (x32("0x1p128") != 0x7F800000) { ret 14; }
    # negative zero
    if (x32("-0x0p0") != 0x80000000) { ret 15; }
    # upper case and a signed exponent
    if (x32("0X1P+3") != 0x41000000) { ret 16; }
    # a leading point
    if (x32("0x.8p1") != 0x3F800000) { ret 17; }
    # no exponent
    if (x32("0x10") != 0x41800000) { ret 18; }
    # a negative value
    if (x32("-0x1.8p1") != 0xC0400000) { ret 19; }
    ret 0;
}

# glibc has no f16 parse: every expected pattern rounds the literal's exact
# rational value half to even at 11 bits (bias 15, subnormal lsb 2^-24) by exact
# fraction arithmetic, and numpy's binary64 to binary16 conversion agrees on each
# literal exact in binary64. 0.1 is 1638.4 * 2^-14, so 1638 = 0x666 and field 11.
test parse_f16__correctly_rounded_edges {
    # 1 + 2^-11, the midpoint above 1: even is 1
    if (t16("1.00048828125") != 0x3C00) { ret 1; }
    # 1 + 3 * 2^-11, a midpoint: even is up
    if (t16("1.00146484375") != 0x3C02) { ret 2; }
    # 2^-24, the smallest subnormal
    if (t16("0.000000059604644775390625") != 0x0001) { ret 3; }
    # 2^-25, half the smallest subnormal: even is zero
    if (t16("0.0000000298023223876953125") != 0x0000) { ret 4; }
    # 2^-25 and a nonzero digit past it: up
    if (t16("0.00000002980232238769531250000001") != 0x0001) { ret 5; }
    # 3 * 2^-25 between subnormals 1 and 2: even is 2
    if (t16("0.0000000894069671630859375") != 0x0002) { ret 6; }
    # 1023 * 2^-24, the largest subnormal
    if (t16("0.000060975551605224609375") != 0x03FF) { ret 7; }
    # 2047 * 2^-25, between the largest subnormal and 2^-14: even is up
    if (t16("0.0000610053539276123046875") != 0x0400) { ret 8; }
    # 2^-14, the smallest normal
    if (t16("0.00006103515625") != 0x0400) { ret 9; }
    # 65504, the largest finite
    if (t16("65504") != 0x7BFF) { ret 10; }
    # 65520, the midpoint past the largest finite: even is inf
    if (t16("65520") != 0x7C00) { ret 11; }
    # just under that midpoint: the largest finite
    if (t16("65519.999") != 0x7BFF) { ret 12; }
    # 1e5, past the overflow boundary
    if (t16("1e5") != 0x7C00) { ret 13; }
    # negative zero
    if (t16("-0") != 0x8000) { ret 14; }
    # 0.1
    if (t16("0.1") != 0x2E66) { ret 15; }
    # 1 + 2^-11 + 10^-20, which f64 rounds onto the midpoint: up
    if (t16("1.00048828125000000001") != 0x3C01) { ret 16; }
    ret 0;
}

# the expected patterns round the literal's exact binary value half to even at 11
# bits: 0x1.ffcp15 is 2047 * 2^5 = 65504, and 0x1.998p-4 keeps 0x266 of 0x998
test parse_f16__hex_rounds_half_to_even {
    # 2^-24
    if (x16("0x1p-24") != 0x0001) { ret 1; }
    # 2^-25, a tie at the floor: even is zero
    if (x16("0x1p-25") != 0x0000) { ret 2; }
    # 1.5 * 2^-24, a subnormal tie: even is 2
    if (x16("0x1.8p-24") != 0x0002) { ret 3; }
    # 1 + 2^-11, a tie: even is 1
    if (x16("0x1.002p0") != 0x3C00) { ret 4; }
    # 1 + 3 * 2^-11, a tie: even is up
    if (x16("0x1.006p0") != 0x3C02) { ret 5; }
    # just over 1 + 2^-11: up
    if (x16("0x1.0020001p0") != 0x3C01) { ret 6; }
    # 1023 * 2^-24, the largest subnormal
    if (x16("0x1.ff8p-15") != 0x03FF) { ret 7; }
    # 2^-14, the smallest normal
    if (x16("0x1p-14") != 0x0400) { ret 8; }
    # the largest finite
    if (x16("0x1.ffcp15") != 0x7BFF) { ret 9; }
    # the midpoint past the largest finite: even is inf
    if (x16("0x1.ffep15") != 0x7C00) { ret 10; }
    # just under that midpoint: the largest finite
    if (x16("0x1.ffdfp15") != 0x7BFF) { ret 11; }
    # negative zero
    if (x16("-0x0p+0") != 0x8000) { ret 12; }
    # 0x1.998p-4 keeps 10 of its 12 fraction bits, the dropped two zero
    if (x16("0x1.998p-4") != 0x2E66) { ret 13; }
    ret 0;
}

# every expected pattern is glibc strtod's, and agrees with rounding the exact
# rational half to even at 53 bits
test parse_f64__subnormal_and_overflow_edges {
    # (2^52 - 1) * 2^-1074, the largest subnormal
    if (pbits("0.") != 0x000FFFFFFFFFFFFF) { ret 1; }
    # (2^54 - 1) * 2^970, the midpoint past the largest finite: even is inf
    if (pbits("") != 0x7FF0000000000000) { ret 2; }
    # just under that midpoint: the largest finite
    if (pbits(".5") != 0x7FEFFFFFFFFFFFFF) { ret 3; }
    # negative zero
    if (pbits("-0.0e10") != 0x8000000000000000) { ret 4; }
    ret 0;
}

# every expected pattern is glibc strtod's
test parse_f64__hex_rounds_half_to_even {
    # 2^-1074
    if (x64("0x1p-1074") != 0x0000000000000001) { ret 1; }
    # 2^-1075, a tie at the floor: even is zero
    if (x64("0x1p-1075") != 0x0000000000000000) { ret 2; }
    # 1.5 * 2^-1074, a subnormal tie: even is 2
    if (x64("0x1.8p-1074") != 0x0000000000000002) { ret 3; }
    # the largest subnormal
    if (x64("0x0.fffffffffffffp-1022") != 0x000FFFFFFFFFFFFF) { ret 4; }
    # 1 + 2^-53, a tie: even is 1
    if (x64("0x1.00000000000008p0") != 0x3FF0000000000000) { ret 5; }
    # 1 + 3 * 2^-53, a tie: even is up
    if (x64("0x1.00000000000018p0") != 0x3FF0000000000002) { ret 6; }
    # the largest finite
    if (x64("0x1.fffffffffffffp1023") != 0x7FEFFFFFFFFFFFFF) { ret 7; }
    # the midpoint past the largest finite: even is inf
    if (x64("0x1.fffffffffffff8p1023") != 0x7FF0000000000000) { ret 8; }
    # just under that midpoint: the largest finite
    if (x64("0x1.fffffffffffff7ffp1023") != 0x7FEFFFFFFFFFFFFF) { ret 9; }
    # 0x1.998p-4
    if (x64("0x1.998p-4") != 0x3FB9980000000000) { ret 10; }
    ret 0;
}

# underscores separate hex digits as they do decimal ones, a huge exponent
# saturates rather than wrapping, the prefix forms skip whitespace and stop at the
# first byte past the number, and a `0x` with no digit after it is the decimal 0
test parse_float__hex_grammar_and_bounds {
    if (x32("0x1_0p0") != 0x41800000)                          { ret 1; }
    if (t32("1e99999999999999999999") != 0x7F800000)           { ret 2; }
    if (t32("-1e-99999999999999999999") != 0x80000000)         { ret 3; }
    if (x16("0x1p-99999999999999999999") != 0)                 { ret 4; }
    if (x16("0x1p99999999999999999999") != 0x7C00)             { ret 5; }
    if (pbits("1e99999999999999999999") != 0x7FF0000000000000) { ret 6; }

    val p: res[f32, ParseError] = parse_f32_hex("  0x1.8p1 tail");
    if (sel p.err)   { ret 7; }
    if (p.ok != 3.0) { ret 7; }
    val q: res[f64, ParseError] = parse_f64_hex_len("0x1p3p9", 5);
    if (sel q.err)   { ret 8; }
    if (q.ok != 8.0) { ret 8; }

    val e1: res[f32, ParseError] = parse_f32_hex_exact("0x1p");
    if (!sel e1.err)        { ret 9; }
    if (!sel e1.err.syntax) { ret 9; }
    if (e1.err.syntax != 4) { ret 9; }
    # a hex parse needs the prefix and a digit after it
    val e2: res[f32, ParseError] = parse_f32_hex_exact("0x");
    if (!sel e2.err)        { ret 10; }
    if (!sel e2.err.syntax) { ret 10; }
    if (e2.err.syntax != 2) { ret 10; }
    val e3: res[f16, ParseError] = parse_f16_hex_exact("0x1.8p1x");
    if (!sel e3.err)        { ret 11; }
    if (!sel e3.err.syntax) { ret 11; }
    if (e3.err.syntax != 7) { ret 11; }
    val e4: res[f16, ParseError] = parse_f16_hex("-1.5");
    if (!sel e4.err)        { ret 12; }
    if (!sel e4.err.syntax) { ret 12; }
    if (e4.err.syntax != 1) { ret 12; }
    val e5: res[f64, ParseError] = parse_f64_hex_exact("0x.p1");
    if (!sel e5.err)                                                               { ret 13; }
    if (!sel e5.err.syntax)                                                        { ret 13; }
    if (e5.err.syntax != 3)                                                        { ret 13; }
    if (x16("inf") != 0x7C00 || x16("-inf") != 0xFC00 || x32("nan") != 0x7FC00000) { ret 14; }
    ret 0;
}

# the decimal parsers keep their grammar: `0x1p3` is the decimal 0 then a stray
# `x`, so a prefix parse gives 0 and an exact one refuses the `x` at offset 1,
# exactly as before hex parsing existed. the hex parsers read it as 8.
test parse_float__decimal_parsers_never_read_hex {
    val d: res[f64, ParseError] = parse_f64("0x1p3");
    if (sel d.err)   { ret 1; }
    if (d.ok != 0.0) { ret 1; }
    val e: res[f64, ParseError] = parse_f64_exact("0x1p3");
    if (!sel e.err)        { ret 2; }
    if (!sel e.err.syntax) { ret 2; }
    if (e.err.syntax != 1) { ret 2; }
    val l: res[f64, ParseError] = parse_f64_len("0x1p3", 5);
    if (sel l.err)                                                    { ret 3; }
    if (l.ok != 0.0)                                                  { ret 3; }
    if (t32("0x1p3") != 0xDEADBEEF00 || t16("0x1p3") != 0xDEADBEEF00) { ret 4; }

    val h: res[f64, ParseError] = parse_f64_hex_exact("0x1p3");
    if (sel h.err)                                            { ret 5; }
    if (h.ok != 8.0)                                          { ret 5; }
    if (x32("0x1p3") != 0x41000000 || x16("0x1p3") != 0x4800) { ret 6; }
    ret 0;
}

# a row no conversion was written for parses through the same path: bfloat16
# keeps 8 bits, so 1 + 2^-8 is a tie to 1 and 1 + 3 * 2^-8 a tie up, and 2^-133
# is its smallest subnormal
test parse_float__a_new_row_is_data_only {
    var work: BF16ParseWork;
    val bf16: ieee.Format           = ieee.BF16;
    val a:    res[u128, ParseError] = parse_float(bf16, Radix.decimal{}, "1.00390625", 10, true, ?work[0]);
    if (sel a.err)      { ret 1; }
    if (a.ok != 0x3F80) { ret 1; }
    val b: res[u128, ParseError] = parse_float(bf16, Radix.decimal{}, "1.01171875", 10, true, ?work[0]);
    if (sel b.err)      { ret 2; }
    if (b.ok != 0x3F82) { ret 2; }
    val c: res[u128, ParseError] = parse_float(bf16, Radix.hex{}, "0x1p-133", 8, true, ?work[0]);
    if (sel c.err)      { ret 3; }
    if (c.ok != 0x0001) { ret 3; }
    val d: res[u128, ParseError] = parse_float(bf16, Radix.decimal{}, "-3.0e38", 7, true, ?work[0]);
    if (sel d.err)      { ret 4; }
    if (d.ok != 0xFF62) { ret 4; }
    ret 0;
}

# each row's stack storage is exactly what parse_float asks for
test parse_float__every_row_sizes_its_storage {
    if (parse_float_work(ieee.F16) != $length_of(F16ParseWork))   { ret 1; }
    if (parse_float_work(ieee.F32) != $length_of(F32ParseWork))   { ret 2; }
    if (parse_float_work(ieee.F64) != $length_of(F64ParseWork))   { ret 3; }
    if (parse_float_work(ieee.BF16) != $length_of(BF16ParseWork)) { ret 4; }
    if (parse_float_work(ieee.F128) != $length_of(F128ParseWork)) { ret 5; }
    ret 0;
}

# the binary128 pattern hi:lo
#[testing]
fun b128(hi: u64, lo: u64) u128 {
    ret (hi::u128 << 64) | lo::u128;
}

# whether all of s parses as binary128 to want, in storage sized for that row
#[testing]
fun q128_is(radix: Radix, s: str, want: u128) bool {
    var work: F128ParseWork;
    val r:    res[u128, ParseError] = parse_float(ieee.F128, radix, s, str_len(s), true, ?work[0]);
    ret sel r.ok && r.ok == want;
}

# binary128, a row no parse was written for, at every rounding edge. each
# expected pattern is libquadmath's strtoflt128 of the same literal, and each
# literal near an edge is that edge's exact value rounded to 40 digits
test parse_float__binary128_rounds_at_every_edge {
    val dec: Radix = Radix.decimal{};
    val hex: Radix = Radix.hex{};
    # 1 + 2^-113 and 1 + 3 * 2^-113, exact midpoints: even is down, then up
    if (!q128_is(dec, "1.00000000000000000000000000000000009629649721936179265279889712924636592690508241076940976199693977832794189453125", b128(0x3FFF000000000000, 0)))  { ret 2; }
    if (!q128_is(dec, "1.00000000000000000000000000000000028888949165808537795839669138773909778071524723230822928599081933498382568359375", b128(0x3FFF000000000000, 2)))  { ret 3; }
    if (!q128_is(dec, "-1.00000000000000000000000000000000009629649721936179265279889712924636592690508241076940976199693977832794189453125", b128(0xBFFF000000000000, 0))) { ret 4; }
    # half the smallest subnormal 2^-16495: just above is 2^-16494, just below zero
    if (!q128_is(dec, "3.237587559719012555462219479113823276250e-4966", b128(0, 1))) { ret 5; }
    if (!q128_is(dec, "3.237587559719012555462219479113823276249e-4966", b128(0, 0))) { ret 6; }
    if (!q128_is(dec, "6.475175119438025110924438958227646552e-4966", b128(0, 1)))    { ret 7; }
    # the exact ties there, 2^-16495 and 3 * 2^-16495, go to even
    if (!q128_is(hex, "0x1p-16495", b128(0, 0))) { ret 8; }
    if (!q128_is(hex, "0x3p-16495", b128(0, 2))) { ret 8; }
    # the largest subnormal, then just past its midpoint with 2^-16382
    if (!q128_is(hex, "0x0.ffffffffffffffffffffffffffffp-16382", b128(0x0000FFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF))) { ret 9; }
    if (!q128_is(dec, "3.362103143112093506262677817321752278840e-4932", b128(0x0001000000000000, 0)))          { ret 10; }
    if (!q128_is(dec, "3.36210314311209350626267781732175260e-4932", b128(0x0001000000000000, 0)))              { ret 11; }
    # the largest finite, then either side of its midpoint with 2^16384
    if (!q128_is(dec, "1.18973149535723176508575932662800702e4932", b128(0x7FFEFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF)))     { ret 12; }
    if (!q128_is(dec, "1.189731495357231765085759326628007073479e4932", b128(0x7FFEFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF))) { ret 13; }
    if (!q128_is(dec, "1.189731495357231765085759326628007073480e4932", b128(0x7FFF000000000000, 0)))                  { ret 14; }
    # the exact tie there goes to even, which is inf
    if (!q128_is(hex, "0x1.ffffffffffffffffffffffffffff8p16383", b128(0x7FFF000000000000, 0)))                      { ret 15; }
    if (!q128_is(hex, "-0x1.ffffffffffffffffffffffffffff7fffp16383", b128(0xFFFEFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF))) { ret 16; }
    if (!q128_is(dec, "0.1", b128(0x3FFB999999999999, 0x999999999999999A)))                                         { ret 17; }
    ret 0;
}

# the 1 + 2^-113 midpoint, then zeros past binary128's 11565 deciding digits and
# a final 1: strictly above the midpoint, so up, which only the sticky bit sees
test parse_float__binary128_truncation_keeps_the_sticky_bit {
    var buf:    [12160]u8;
    val prefix: str   = "1.00000000000000000000000000000000009629649721936179265279889712924636592690508241076940976199693977832794189453125";
    var n:      usize = 0;
    for (prefix[n] != 0) {
        buf[n] = prefix[n];
        n      = n + 1;
    }
    for (n < 12150) {
        buf[n] = '0';
        n      = n + 1;
    }
    buf[n]     = '1';
    buf[n + 1] = 0;
    if (!q128_is(Radix.decimal{}, ?buf[0], b128(0x3FFF000000000000, 1))) { ret 1; }
    ret 0;
}
