# environment variable access

use std.collections.vector;
use std.collections.vector.Vector;
use std.runtime.native.view.NativeName;
use std.runtime.native.view.Unit;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.owned_adopt;
use std.types.string.owned_dup;
use std.types.string.owned_release;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use io_error: std.io.error;
use std.system.capability;

$if (capability.HAS_FILES && capability.HAS_PROCESS) {
    use std.allocator.testing;
    use std.system.os;
}
$or {
    $error("std.process.env needs the files and process capabilities (std.system.capability.HAS_FILES, HAS_PROCESS)");
}

$if ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}
$or ($mach.build.os == $mach.os.linux) {
    use native: std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use native: std.system.os.darwin;
}

# why an environment read failed
# ---
# native:      the platform refused the read; the negative errno
# alloc:       the owned copy could not be acquired
# changed:     the variable changed between the probe and the exact read
# unavailable: there is no environment capture to list, before runtime
#              init or when windows cannot read its block
pub tag EnvError: u8 {
    native: i64;
    alloc:  A.Error;
    changed;
    unavailable;
}

# one entry of the UTF-8 environment listing, mirroring std.filesystem's Listed
# ---
# variable:    the entry as NAME=value in UTF-8
# unspellable: an entry with no UTF-8 spelling, which only windows can hold,
#              as its variable name in native units, which get_native reads
pub tag Listed: u8 {
    variable:    str;
    unspellable: NativeName;
}

# compare complete variable names in UTF-8, returning -1, 0, or 1
#
# each name is converted once into native units and compared by
# compare_names_native, so the two forms order every pair alike. a nil name is
# empty. on windows a name that is not UTF-8 or too long to convert, or a
# refused allocation, is the native error
pub fun compare_names(left: str, right: str) res[i32, EnvError] {
    $if ($mach.build.os == $mach.os.windows) {
        var order: i32 = 0;
        ret ordered(windows.environment_name_compare(left, right, ?order), order);
    }
    $or {
        ret compare_names_native(left, str_len(left), right, str_len(right));
    }
}

# compare complete variable names in native units as given, returning -1, 0,
# or 1, the one order every name comparison runs
#
# linux and darwin compare bytes, a shorter name first when it prefixes the
# other. windows compares UTF-16 units with the operating system's ordinal
# case table, case ignored and nothing converted, so a name holding unpaired
# surrogates compares like any other
# ---
# left:         the left name in std.runtime.native units, not terminated
# left_length:  its length in units, any pointer when zero
# right:        the right name in std.runtime.native units, not terminated
# right_length: its length in units, any pointer when zero
# ret:          the order, or the native E2BIG for a length past the
#               platform limit: the i32 maximum on windows, the isize maximum
#               elsewhere
pub fun compare_names_native(left: *Unit, left_length: usize, right: *Unit, right_length: usize) res[i32, EnvError] {
    $if ($mach.build.os == $mach.os.windows) {
        var order: i32 = 0;
        ret ordered(windows.environment_name_compare_native(left, left_length, right, right_length, ?order), order);
    }
    $or {
        if (left_length > NAME_LIMIT || right_length > NAME_LIMIT) { ret res[i32, EnvError].err{EnvError.native{native.E2BIG}}; }
        var i: usize = 0;
        for (i < left_length && i < right_length && left[i] == right[i]) { i = i + 1; }
        if (i < left_length && i < right_length) {
            if (left[i] < right[i]) { ret res[i32, EnvError].ok{-1}; }
            ret res[i32, EnvError].ok{1};
        }
        if (left_length < right_length) { ret res[i32, EnvError].ok{-1}; }
        if (left_length > right_length) { ret res[i32, EnvError].ok{1}; }
        ret res[i32, EnvError].ok{0};
    }
}

$if ($mach.build.os == $mach.os.windows) {
    fun ordered(compared: i64, order: i32) res[i32, EnvError] {
        if (compared < 0) { ret res[i32, EnvError].err{EnvError.native{compared}}; }
        ret res[i32, EnvError].ok{order};
    }
}
$or {
    # the largest object a pointer spans
    val NAME_LIMIT: usize = 0x7fffffffffffffff;
}

# read an environment variable into a buffer
#
# when the value fits (length < cap) it is copied and null-terminated.
# the full value length is always reported, so length >= cap signals
# truncation (buffer contents unspecified) and length + 1 is the capacity
# to retry with. an unset variable is absence, not a failure.
# ---
# name: variable name
# buf:  destination buffer
# cap:  buffer capacity in bytes
# ret:  the full length of the value excluding the terminator, absent when
#       the variable is unset, or the native failure
pub fun get(name: str, buf: *u8, cap: usize) res[opt[usize], EnvError] {
    val n: i64 = os.getenv(name, buf, cap);
    if (n < 0 && os.error_kind(n) == io_error.NOT_FOUND) { ret res[opt[usize], EnvError].ok{opt[usize].none{}}; }
    if (n < 0)                                           { ret res[opt[usize], EnvError].err{EnvError.native{n}}; }
    ret res[opt[usize], EnvError].ok{opt[usize].some{n::usize}};
}

# get in the host's native units: name and value are std.runtime.native units
# and cap and the length count units, so a value with no UTF-8 spelling, which
# get refuses, is read as it is. linux and darwin units are bytes, so there the
# two are one read
# ---
# name: nul-terminated variable name in native units
# buf:  destination buffer
# cap:  buffer capacity in units
# ret:  the full length of the value in units excluding the terminator,
#       absent when the variable is unset, or the native failure
pub fun get_native(name: *Unit, buf: *Unit, cap: usize) res[opt[usize], EnvError] {
    val n: i64 = os.getenv_native(name, buf, cap);
    if (n < 0 && os.error_kind(n) == io_error.NOT_FOUND) { ret res[opt[usize], EnvError].ok{opt[usize].none{}}; }
    if (n < 0)                                           { ret res[opt[usize], EnvError].err{EnvError.native{n}}; }
    ret res[opt[usize], EnvError].ok{opt[usize].some{n::usize}};
}

# read an environment variable into a freshly allocated string
#
# probes with a small stack buffer and retries once with an exact allocation
# when the value is larger, so the common case costs one read and values of
# any length resolve correctly. the retry is bounded: a variable that is
# unset or longer at the second read is reported as `changed` rather than
# read a third time.
# ---
# a:    allocator for the result
# name: variable name
# ret:  the owned value (extent is the length plus the terminator), absent
#       when the variable is unset, or the failure
pub fun value(a: *A.Allocator, name: str) res[opt[OwnedString], EnvError] {
    var probe:  [256]u8;
    val probed: res[opt[usize], EnvError] = get(name, ?probe[0], 256);
    if (sel probed.err)     { ret res[opt[OwnedString], EnvError].err{probed.err}; }
    if (sel probed.ok.none) { ret res[opt[OwnedString], EnvError].ok{opt[OwnedString].none{}}; }
    val n: usize = probed.ok.some;
    if (n < 256) {
        val copied: res[OwnedString, A.Error] = owned_dup(a, (?probe[0])::str);
        if (sel copied.err) { ret res[opt[OwnedString], EnvError].err{EnvError.alloc{copied.err}}; }
        ret res[opt[OwnedString], EnvError].ok{opt[OwnedString].some{copied.ok}};
    }

    # larger than the probe: allocate exactly and read again
    val cap:   usize             = n + 1;
    val buf_r: res[*u8, A.Error] = A.allocate[u8](a, cap);
    if (sel buf_r.err) { ret res[opt[OwnedString], EnvError].err{EnvError.alloc{buf_r.err}}; }
    val buf: *u8 = buf_r.ok;

    val again: res[opt[usize], EnvError] = get(name, buf, cap);
    if (sel again.err) {
        A.deallocate[u8](a, buf, cap);
        ret res[opt[OwnedString], EnvError].err{again.err};
    }
    if (sel again.ok.none) {
        A.deallocate[u8](a, buf, cap);
        ret res[opt[OwnedString], EnvError].err{EnvError.changed{}};
    }
    val m: usize = again.ok.some;
    if (m >= cap) {
        A.deallocate[u8](a, buf, cap);
        ret res[opt[OwnedString], EnvError].err{EnvError.changed{}};
    }
    ret res[opt[OwnedString], EnvError].ok{opt[OwnedString].some{owned_adopt(a, buf::str, m, cap)}};
}

# the retry capacity when the platform reports only ERANGE for a working
# directory longer than the probe: past the longest path any target admits
val CWD_RETRY_CAP: usize = 65536;

# read the current working directory into a freshly allocated string
#
# probes with a stack buffer and retries once with an exact allocation when
# the path is longer; a path that grew again between the reads is `changed`.
# ---
# a:   allocator for the result
# ret: the owned working directory path, or the native or allocation failure
pub fun current_dir(a: *A.Allocator) res[OwnedString, EnvError] {
    var probe: [4096]u8;
    val n:     i64 = os.getcwd(?probe[0], 4096);
    if (n < 0 && os.error_kind(n) != io_error.RANGE) { ret res[OwnedString, EnvError].err{EnvError.native{n}}; }
    if (n >= 0 && n::usize < 4096) {
        val copied: res[OwnedString, A.Error] = owned_dup(a, (?probe[0])::str);
        if (sel copied.err) { ret res[OwnedString, EnvError].err{EnvError.alloc{copied.err}}; }
        ret res[OwnedString, EnvError].ok{copied.ok};
    }

    # longer than the probe: the platform reports the length or only ERANGE,
    # so retry with the reported length or a path-maximum sized buffer
    var cap: usize = CWD_RETRY_CAP;
    if (n >= 0) { cap = n::usize + 1; }
    val buf_r: res[*u8, A.Error] = A.allocate[u8](a, cap);
    if (sel buf_r.err) { ret res[OwnedString, EnvError].err{EnvError.alloc{buf_r.err}}; }
    val buf: *u8 = buf_r.ok;
    val m:   i64 = os.getcwd(buf, cap);
    if (m < 0) {
        A.deallocate[u8](a, buf, cap);
        if (os.error_kind(m) == io_error.RANGE) { ret res[OwnedString, EnvError].err{EnvError.changed{}}; }
        ret res[OwnedString, EnvError].err{EnvError.native{m}};
    }
    if (m::usize >= cap) {
        A.deallocate[u8](a, buf, cap);
        ret res[OwnedString, EnvError].err{EnvError.changed{}};
    }
    ret res[OwnedString, EnvError].ok{owned_adopt(a, buf::str, m::usize, cap)};
}

# the environment in native units, the one capture: at startup on linux and
# darwin, at first use on windows, where hidden drive-current-directory entries
# are left out (see std.system.os.environ_native)
# ---
# ret: nil-terminated array of nul-terminated NAME=value entries in
#      std.runtime.native units, kept for the life of the process, or nil
#      when the environment is unavailable (e.g. before runtime init)
pub fun environ_native() **Unit {
    ret os.environ_native();
}

# the environment in UTF-8, one projection of environ_native
#
# for reading and editing variables. it is not for passing the environment on:
# std.process.exec.Environment.inherit hands a child this process's own,
# unconverted. every entry of the capture is listed, in its order. on windows
# an entry with no UTF-8 spelling is listed in place as unspellable with its
# native name, never dropped and never failing the listing. linux and darwin
# entries are bytes and are listed as given. the vector, every variable and
# every native name are owned by the caller and released with environ_free
# ---
# a:   allocator for the vector and every entry
# ret: the entries in order, or why they could not be listed, with nothing
#      left allocated
pub fun environ(a: *A.Allocator) res[Vector[Listed], EnvError] {
    val native: **Unit = os.environ_native();
    if (native == nil) { ret res[Vector[Listed], EnvError].err{EnvError.unavailable{}}; }
    var listed: Vector[Listed] = vector.init[Listed](a);
    var i:      usize          = 0;
    for (native[i] != nil) {
        val entry: res[Listed, EnvError] = listed_entry(a, native[i]);
        if (sel entry.err) {
            environ_free(?listed);
            ret res[Vector[Listed], EnvError].err{entry.err};
        }
        val pushed: res[usize, A.Error] = vector.push[Listed](?listed, entry.ok);
        if (sel pushed.err) {
            listed_release(a, entry.ok);
            environ_free(?listed);
            ret res[Vector[Listed], EnvError].err{EnvError.alloc{pushed.err}};
        }
        i = i + 1;
    }
    ret res[Vector[Listed], EnvError].ok{listed};
}

# release a listing environ returned: every entry, then the vector
pub fun environ_free(listed: *Vector[Listed]) {
    var i: usize = 0;
    for (i < listed.len) {
        listed_release(listed.a, listed.data[i]);
        i = i + 1;
    }
    vector.dnit[Listed](listed);
}

# one native entry spelled in UTF-8 through os.native_spelling, or its native
# name when it has none
fun listed_entry(a: *A.Allocator, entry: *Unit) res[Listed, EnvError] {
    var units: usize = 0;
    for (entry[units] != 0) { units = units + 1; }
    val measured: i64 = os.native_spelling(entry, units, nil, 0);
    if (measured < 0 && os.error_kind(measured) == io_error.INVALID) { ret unspellable_entry(a, entry); }
    if (measured < 0)                                                { ret res[Listed, EnvError].err{EnvError.native{measured}}; }
    val length: usize             = measured::usize;
    val buf_r:  res[*u8, A.Error] = A.allocate[u8](a, length + 1);
    if (sel buf_r.err) { ret res[Listed, EnvError].err{EnvError.alloc{buf_r.err}}; }
    val buf:       *u8 = buf_r.ok;
    val converted: i64 = os.native_spelling(entry, units, buf, length);
    if (converted != measured) {
        A.deallocate[u8](a, buf, length + 1);
        if (converted < 0) { ret res[Listed, EnvError].err{EnvError.native{converted}}; }
        ret res[Listed, EnvError].err{EnvError.changed{}};
    }
    buf[length] = 0;
    ret res[Listed, EnvError].ok{Listed.variable{buf::str}};
}

# the name of a native entry, the units before its first '=' past the first,
# copied and terminated
fun unspellable_entry(a: *A.Allocator, entry: *Unit) res[Listed, EnvError] {
    var length: usize = 1;
    if (entry[0] == 0) { length = 0; }
    for (length > 0 && entry[length] != 0 && entry[length] != '='::Unit) { length = length + 1; }
    val units_r: res[*Unit, A.Error] = A.allocate[Unit](a, length + 1);
    if (sel units_r.err) { ret res[Listed, EnvError].err{EnvError.alloc{units_r.err}}; }
    val units: *Unit = units_r.ok;
    var i:     usize = 0;
    for (i < length) {
        units[i] = entry[i];
        i        = i + 1;
    }
    units[length] = 0;
    ret res[Listed, EnvError].ok{Listed.unspellable{NativeName{units: units, length: length}}};
}

fun listed_release(a: *A.Allocator, entry: Listed) {
    if (sel entry.variable) {
        A.deallocate[u8](a, entry.variable, str_len(entry.variable) + 1);
        ret;
    }
    A.deallocate[Unit](a, entry.unspellable.units, entry.unspellable.length + 1);
}

#[testing]
var test_buf:   [4096]u8;
#[testing]
var test_small: [4]u8;

# an unset variable is absence. PATH, when the harness passes it, is
# terminated when it fits and reports its full length when it does not, so a
# caller can size the retry
test get__absence_termination_and_truncation {
    val missing: res[opt[usize], EnvError] = get("UNLIKELY_VAR_THAT_DOES_NOT_EXIST_12345", ?test_buf[0], 4096);
    if (!sel missing.ok)      { ret 1; }
    if (!sel missing.ok.none) { ret 1; }

    val got: res[opt[usize], EnvError] = get("PATH", ?test_buf[0], 4096);
    if (!sel got.ok)      { ret 2; }
    if (!sel got.ok.some) { ret 0; }
    val len: usize = got.ok.some;
    if (len < 4096 && test_buf[len] != 0) { ret 3; }
    if (len < 4)                          { ret 0; }
    val truncated: res[opt[usize], EnvError] = get("PATH", ?test_small[0], 4);
    if (!sel truncated.ok)        { ret 4; }
    if (!sel truncated.ok.some)   { ret 4; }
    if (truncated.ok.some != len) { ret 5; }
    ret 0;
}

# the copy is owned and exact, and a refused copy is the allocator's error
# with nothing acquired
test current_dir__owned_copy_and_refusal {
    var tracking: testing.Testing;
    val tracked:  err[A.Error] = testing.make(?tracking);
    if (sel tracked.err) { ret 1; }
    fin { testing.dnit(?tracking); }

    var r: res[OwnedString, EnvError] = current_dir(?tracking.a);
    if (!sel r.ok)                      { ret 2; }
    if (str_len(r.ok.data) == 0)        { ret 3; }
    if (r.ok.len != str_len(r.ok.data)) { ret 4; }
    if (r.ok.extent != r.ok.len + 1)    { ret 5; }
    val released: err[A.Error] = owned_release(?r.ok);
    if (sel released.err) { ret 6; }

    testing.fail_at_ordinal(?tracking, testing.attempt_count(?tracking) + 1);
    val refused: res[OwnedString, EnvError] = current_dir(?tracking.a);
    if (!sel refused.err)       { ret 7; }
    if (!sel refused.err.alloc) { ret 7; }
    if (tracking.live != 0)     { ret 8; }
    ret 0;
}

# an unset variable is absence. PATH, when present, is copied exactly, and a
# refusal at whichever acquisition the length selects leaves nothing behind
test value__absence_copy_and_refusal {
    var tracking: testing.Testing;
    val tracked:  err[A.Error] = testing.make(?tracking);
    if (sel tracked.err) { ret 1; }
    fin { testing.dnit(?tracking); }

    val missing: res[opt[OwnedString], EnvError] = value(?tracking.a, "UNLIKELY_VAR_THAT_DOES_NOT_EXIST_12345");
    if (!sel missing.ok)      { ret 2; }
    if (!sel missing.ok.none) { ret 2; }

    val got: res[opt[usize], EnvError] = get("PATH", ?test_buf[0], 4096);
    if (!sel got.ok)      { ret 3; }
    if (!sel got.ok.some) { ret 0; }
    val len: usize = got.ok.some;
    if (len >= 4096) { ret 0; }

    var r: res[opt[OwnedString], EnvError] = value(?tracking.a, "PATH");
    if (!sel r.ok)                                        { ret 4; }
    if (!sel r.ok.some)                                   { ret 4; }
    if (r.ok.some.len != len)                             { ret 5; }
    if (r.ok.some.extent != len + 1)                      { ret 6; }
    if (!str_equals(r.ok.some.data, (?test_buf[0])::str)) { ret 7; }
    if (tracking.live != 1)                               { ret 8; }
    val released: err[A.Error] = owned_release(?r.ok.some);
    if (sel released.err)   { ret 9; }
    if (tracking.live != 0) { ret 9; }

    testing.fail_at_ordinal(?tracking, testing.attempt_count(?tracking) + 1);
    val refused: res[opt[OwnedString], EnvError] = value(?tracking.a, "PATH");
    if (!sel refused.err)       { ret 10; }
    if (!sel refused.err.alloc) { ret 10; }
    if (tracking.live != 0)     { ret 11; }
    ret 0;
}

# every captured entry is listed in order as NAME=value, the bytes as given
# on linux and darwin. the listing is owned and released whole, and a refused
# allocation leaves nothing behind. an empty environment lists nothing
test environ__lists_every_entry_owned_in_order {
    var tracking: testing.Testing;
    val tracked:  err[A.Error] = testing.make(?tracking);
    if (sel tracked.err) { ret 1; }
    fin { testing.dnit(?tracking); }

    val native: **Unit = environ_native();
    if (native == nil) { ret 0; }
    var count: usize = 0;
    for (native[count] != nil) { count = count + 1; }
    var r: res[Vector[Listed], EnvError] = environ(?tracking.a);
    if (!sel r.ok)         { ret 2; }
    if (r.ok.len != count) { ret 3; }
    var i: usize = 0;
    for (i < count) {
        val entry: Listed = r.ok.data[i];
        if (sel entry.variable) {
            var j:      usize = 1;
            var has_eq: bool  = false;
            for (entry.variable[0] != 0 && entry.variable[j] != 0) {
                if (entry.variable[j] == '=') { has_eq = true; }
                j = j + 1;
            }
            if (!has_eq) { ret 4; }
            $if ($mach.build.os != $mach.os.windows) {
                if (!str_equals(entry.variable, native[i]::str)) { ret 5; }
            }
        }
        i = i + 1;
    }
    environ_free(?r.ok);
    if (tracking.live != 0) { ret 7; }

    if (count == 0) { ret 0; }
    testing.fail_at_ordinal(?tracking, testing.attempt_count(?tracking) + 2);
    val refused: res[Vector[Listed], EnvError] = environ(?tracking.a);
    if (!sel refused.err)       { ret 8; }
    if (!sel refused.err.alloc) { ret 8; }
    if (tracking.live != 0)     { ret 9; }
    ret 0;
}

$if ($mach.build.os == $mach.os.windows) {
    #[library("kernel32")]
    ext fun SetEnvironmentVariableW(name: *u16, value: *u16) i32;

    #[testing]
    fun env_test_wide(text: str, out: *u16) {
        var i: usize = 0;
        for (text[i] != 0) {
            out[i] = text[i]::u16;
            i      = i + 1;
        }
        out[i] = 0;
    }
}

# a value with no UTF-8 spelling reads back unit for unit through get_native,
# and the listing names its entry in place by its native name while it still
# lists the entries beside it. get refuses only that value
test environ__an_unspellable_entry_is_listed_in_place {
    $if ($mach.build.os == $mach.os.windows) {
        var name: [8]u16;
        env_test_wide("M1065L", ?name[0]);
        var value: [3]u16;
        value[0] = 'a'::u16;
        value[1] = 0xd800;
        value[2] = 0;
        var good: [8]u16;
        env_test_wide("M1065M", ?good[0]);
        var ok: [3]u16;
        env_test_wide("ok", ?ok[0]);
        if (SetEnvironmentVariableW(?name[0], ?value[0]) == 0) { ret 1; }
        if (SetEnvironmentVariableW(?good[0], ?ok[0]) == 0)    { ret 1; }

        var units: [4]u16;
        val read:  res[opt[usize], EnvError] = get_native(?name[0], ?units[0], 4);
        if (!sel read.ok)                                                { ret 2; }
        if (!sel read.ok.some)                                           { ret 2; }
        if (read.ok.some != 2)                                           { ret 2; }
        if (units[0] != 'a'::u16 || units[1] != 0xd800 || units[2] != 0) { ret 3; }
        var bytes:   [8]u8;
        val refused: res[opt[usize], EnvError] = get("M1065L", ?bytes[0], 8);
        if (!(sel refused.err && sel refused.err.native)) { ret 4; }

        var tracking: testing.Testing;
        val tracked:  err[A.Error] = testing.make(?tracking);
        if (sel tracked.err) { ret 5; }
        fin { testing.dnit(?tracking); }
        var r: res[Vector[Listed], EnvError] = environ(?tracking.a);
        if (!sel r.ok) { ret 6; }
        val native: **Unit = environ_native();
        var count:  usize  = 0;
        for (native[count] != nil) { count = count + 1; }
        if (r.ok.len != count) { ret 7; }
        var unspelled: usize = 0;
        var spelled:   bool  = false;
        var i:         usize = 0;
        for (i < r.ok.len) {
            val entry: Listed = r.ok.data[i];
            if (sel entry.unspellable) {
                unspelled = unspelled + 1;
                if (entry.unspellable.length != 6 || native[i][6] != '='::u16) { ret 8; }
                var j: usize = 0;
                for (j <= 6) {
                    if (entry.unspellable.units[j] != name[j]) { ret 9; }
                    j = j + 1;
                }
            }
            or (sel entry.variable && str_equals(entry.variable, "M1065M=ok")) { spelled = true; }
            i = i + 1;
        }
        if (unspelled != 1 || !spelled) { ret 10; }
        environ_free(?r.ok);
        if (tracking.live != 0) { ret 12; }
        SetEnvironmentVariableW(?name[0], nil);
        SetEnvironmentVariableW(?good[0], nil);
        ret 0;
    }
    $or {
        ret 0;
    }
}

fun compared(r: res[i32, EnvError], want_zero: bool) bool {
    if (!sel r.ok) { ret false; }
    ret (r.ok == 0) == want_zero;
}

#[testing]
fun order_is(r: res[i32, EnvError], want: i32) bool {
    if (!sel r.ok) { ret false; }
    ret r.ok == want;
}

#[testing]
fun refused_with(r: res[i32, EnvError], code: i64) bool {
    if (!sel r.err)        { ret false; }
    if (!sel r.err.native) { ret false; }
    ret r.err.native == code;
}

# a UTF-8 name in native units for the native comparison, the empty name as
# zero units
#[testing]
fun native_name(name: str, out: *os.NativePath) usize {
    out.units = nil;
    out.size  = 0;
    if (str_len(name) == 0)             { ret 0; }
    if (os.native_path(name, out) != 0) { ret 0; }
    var length: usize = 0;
    for (out.units[length] != 0) { length = length + 1; }
    ret length;
}

#[testing]
fun native_compare(left: str, right: str) res[i32, EnvError] {
    var lhs:    os.NativePath;
    var rhs:    os.NativePath;
    val l:      usize              = native_name(left, ?lhs);
    val r:      usize              = native_name(right, ?rhs);
    val result: res[i32, EnvError] = compare_names_native(lhs.units, l, rhs.units, r);
    if (lhs.units != nil) { os.native_path_release(?lhs); }
    if (rhs.units != nil) { os.native_path_release(?rhs); }
    ret result;
}

# a nil name is empty, and windows refuses a name that is not UTF-8 with
# exactly EINVAL, which linux and darwin compare as bytes
test compare_names__host_identity_unicode_and_error_codes {
    if (!compared(compare_names(nil, ""), true))     { ret 7; }
    if (!compared(compare_names("環境", "環境"), true))  { ret 1; }
    if (!compared(compare_names("環境", "環界"), false)) { ret 2; }
    val case_pair: res[i32, EnvError] = compare_names("MACH_ÄΩ", "mach_äω");
    if (!sel case_pair.ok) { ret 3; }
    var invalid: [2]u8;
    invalid[0] = 255;
    invalid[1] = 0;
    val rejected: res[i32, EnvError] = compare_names((?invalid[0])::str, "valid");
    $if ($mach.build.os == $mach.os.windows) {
        if (case_pair.ok != 0)                       { ret 4; }
        if (!refused_with(rejected, windows.EINVAL)) { ret 5; }
    }
    $or {
        if (case_pair.ok == 0)      { ret 6; }
        if (!order_is(rejected, 1)) { ret 8; }
    }
    ret 0;
}

# names that differ only in case compare equal on windows and unequal
# elsewhere, in either form
test compare_names_native__case {
    val ascii:   res[i32, EnvError] = native_compare("Path", "PATH");
    val unicode: res[i32, EnvError] = native_compare("MACH_ÄΩ", "mach_äω");
    $if ($mach.build.os == $mach.os.windows) {
        if (!order_is(ascii, 0) || !order_is(unicode, 0)) { ret 1; }
    }
    $or {
        if (!order_is(ascii, 1) || !order_is(unicode, -1)) { ret 2; }
    }
    ret 0;
}

# every pair with a UTF-8 spelling orders alike through both forms, and on
# linux and darwin that order is unsigned bytes with a prefix first
test compare_names_native__orders_as_compare_names {
    var names: [16]str;
    names[0]  = "";
    names[1]  = "A";
    names[2]  = "a";
    names[3]  = "AB";
    names[4]  = "ab";
    names[5]  = "abc";
    names[6]  = "a_";
    names[7]  = "_";
    names[8]  = "Z";
    names[9]  = "PATH";
    names[10] = "PATHEXT";
    names[11] = "é";
    names[12] = "É";
    names[13] = "環境";
    names[14] = "環界";
    names[15] = "MACH_ÄΩ";
    var i: usize = 0;
    for (i < 16) {
        var j: usize = 0;
        for (j < 16) {
            val utf8: res[i32, EnvError] = compare_names(names[i], names[j]);
            val unit: res[i32, EnvError] = native_compare(names[i], names[j]);
            if (!sel utf8.ok)             { ret 1; }
            if (!order_is(unit, utf8.ok)) { ret 2; }
            $if ($mach.build.os != $mach.os.windows) {
                if ((i == j) != (utf8.ok == 0)) { ret 3; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    $if ($mach.build.os != $mach.os.windows) {
        if (!order_is(compare_names("ab", "abc"), -1)) { ret 4; }
        if (!order_is(compare_names("b", "abc"), 1))   { ret 5; }
        if (!order_is(compare_names("é", "z"), 1))     { ret 6; }
        if (!order_is(compare_names("", "a"), -1))     { ret 7; }
    }
    ret 0;
}

# windows compares unpaired surrogates as units, with no conversion to refuse
test compare_names_native__unpaired_surrogates {
    $if ($mach.build.os == $mach.os.windows) {
        var high: [2]u16;
        high[0] = 'a'::u16;
        high[1] = 0xd800;
        var upper: [2]u16;
        upper[0] = 'A'::u16;
        upper[1] = 0xd800;
        var low: [2]u16;
        low[0] = 'a'::u16;
        low[1] = 0xdc00;
        if (!order_is(compare_names_native(?high[0], 2, ?upper[0], 2), 0)) { ret 1; }
        if (!order_is(compare_names_native(?high[0], 2, ?low[0], 2), -1))  { ret 2; }
        if (!order_is(compare_names_native(?high[0], 2, ?high[0], 1), 1))  { ret 3; }
    }
    ret 0;
}

# a length past the platform limit is refused before any unit is read
test compare_names_native__refuses_lengths_past_the_limit {
    var unit:  [1]Unit;
    var limit: usize = 0;
    var code:  i64   = 0;
    $if ($mach.build.os == $mach.os.windows) {
        limit = 0x7fffffff;
        code  = windows.E2BIG;
    }
    $or {
        limit = 0x7fffffffffffffff;
        code  = native.E2BIG;
    }
    if (!refused_with(compare_names_native(?unit[0], limit + 1, ?unit[0], 1), code)) { ret 1; }
    if (!refused_with(compare_names_native(?unit[0], 1, ?unit[0], limit + 1), code)) { ret 2; }
    if (!order_is(compare_names_native(nil, 0, nil, 0), 0))                          { ret 3; }
    ret 0;
}
