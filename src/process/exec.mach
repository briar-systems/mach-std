# process spawning and management

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.size.isize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_empty;
use std.types.string.str_copy;
use std.types.string.StrError;
use std.types.string.str_equals;
use std.types.string.str_copy_slice;
use std.types.string.str_join;
use std.types.string.str_contains_char;
use std.types.string.OwnedString;
use std.types.string.owned_release;
use std.collections.vector.Vector;
use std.collections.vector;
use std.allocator.fixed;
use std.allocator.page;

use A: std.allocator;

use std.types.path;
use std.process.env;

use std.filesystem;
use m_reader: std.io.reader;
use std.io.reader.ReadError;
use io_error: std.io.error;
use io_handle: std.io.handle;

use std.system.os;
use cancel: std.sync.cancel;
use tm: std.chrono.time;
use duration: std.chrono.duration;

# spawn_grouped, spawn_redirected_grouped, and terminate_group below give
# every target the same signature; the underlying primitive is platform-
# specific (posix setpgid/kill(-pgid) vs a tracked windows job object), so the actual
# implementation is per-platform in each function body.
$if ($mach.build.os == $mach.os.linux) {
    use std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use std.system.os.darwin;
}
$or ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}

fwd ExitStatus: os.ProcessStatus;
fwd os.PROCESS_EXITED;
fwd os.PROCESS_SIGNALED;
fwd os.PROCESS_STOPPED;
fwd os.PROCESS_CONTINUED;

# handle to a spawned child process
# ---
# pid:  process id of the child
# pgid: 0 if the child was not placed in its own group (see spawn_grouped /
#       spawn_redirected_grouped); otherwise the group token needed to signal
#       the whole group - on linux/darwin this is the posix process group id
#       (pgid == pid, since the child is its own group's leader); on windows
#       it is a tracked group token backed by the retained child process
pub rec Child {
    pid:  i64;
    pgid: i64;
}

# a failed native process operation
# ---
# code:        the negative mapped OS error
# native_code: the exact windows GetLastError; zero on posix, whose errno is `code`
# operation:   the os.PROCESS_OP_* stage that failed
# child:       the unreaped child transferred to the caller, pid zero for none
pub rec Failure {
    code: i64;
    native_code: u32;
    operation: u8;
    child: Child;
}

# the drain of a captured child's output failed
# ---
# read:  the reader's failure, with the bytes delivered before it
# child: the unreaped child transferred to the caller when the wait that
#        followed the drain failed too, pid zero when the wait reaped it
# wait:  that wait's native failure, absent when the wait succeeded
pub rec OutputFailure {
    read: ReadError;
    child: Child;
    wait: opt[os.ProcessWaitError];
}

# why a process operation failed
# ---
# native:      a spawn, pipe, wait, status query, close or termination refused
#              by the platform; the child it retains is the caller's to wait
#              for again, or to terminate first, before releasing ownership
# output:      the capture drain failed (the wait's outcome is inside)
# alloc:       an owned path copy was refused
# env:         the PATH read failed
# empty_name:  the program name is empty
# unset:       PATH is not set
# not_found:   the name is on no directory of the search list
# ungrouped:   the child was not spawned into a group, so no group can be signalled
# unsupported: process groups do not exist on this platform
# query:       the name was found nowhere, and at least one candidate could not
#              be examined (the last such failure); the search continues past
#              a refused query the way execvp does, so a hit still wins
pub tag Error: u8 {
    native: Failure;
    output: OutputFailure;
    alloc: A.Error;
    env: env.EnvError;
    empty_name;
    unset;
    not_found;
    ungrouped;
    unsupported;
    query: io_error.Error;
}

# the child an error still owns: pid zero when none was retained. do not
# discard an error while it owns a child; wait for it or terminate it first
pub fun retained(error: Error) Child {
    if (sel error.native) { ret error.native.child; }
    if (sel error.output) { ret error.output.child; }
    ret Child{};
}

# a rendering of the error for diagnostics
pub fun error_message(error: Error) str {
    if (sel error.native) { ret os.message(error.native.code); }
    if (sel error.output) {
        if (sel error.output.read.native) { ret io_error.message(error.output.read.native.error); }
        if (sel error.output.read.alloc) { ret "out of memory"; }
        if (sel error.output.read.would_block) { ret "would block"; }
        ret "end of file";
    }
    if (sel error.alloc) { ret "out of memory"; }
    if (sel error.env) { ret "environment read failed"; }
    if (sel error.empty_name) { ret "empty program name"; }
    if (sel error.unset) { ret "PATH unset"; }
    if (sel error.not_found) { ret "not found on PATH"; }
    if (sel error.ungrouped) { ret "child is not in a process group"; }
    if (sel error.query) { ret io_error.message(error.query); }
    ret "process groups are not supported on this platform";
}

fun process_error(code: i64, operation: u8) Error {
    ret Error.native{Failure{code: code, operation: operation}};
}

fun wait_error(error: os.ProcessWaitError, child: Child) Error {
    var pending: Child = Child{};
    if (child.pid > 0 && error.code != os.ECHILD) { pending = child; }
    ret Error.native{Failure{code: error.code, native_code: error.native_code, operation: error.operation, child: pending}};
}

# a child reaped by wait_any
# ---
# child:  the reaped child's handle
# status: its exit status
pub rec Reaped {
    child:  Child;
    status: ExitStatus;
}

# result of running a child process and collecting its stdout
# ---
# status: exit status of the child process
# bytes:  the child's complete stdout, owned by the caller's allocator
pub rec Output {
    status: ExitStatus;
    bytes:  Vector[u8];
}

# spawn a process and wait for it to exit
# ---
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     null-terminated environment array
# ret:      exit status, or an error retaining an unreaped child
pub fun run(pathname: str, argv: **u8, envp: **u8) res[ExitStatus, Error] {
    val pid: i64 = os.spawn(pathname, argv, envp);
    if (pid < 0) { ret res[ExitStatus, Error].err{process_error(pid, os.PROCESS_OP_SPAWN)}; }
    ret wait(Child{pid: pid});
}

# run a command through the host command interpreter, from `cwd`
#
# The interpreter and its command-line conventions are the platform's, not the
# caller's: posix hands `sh -c <command>` straight to execve, while windows
# resolves %ComSpec% and emits `"<comspec>" /s /c "<command verbatim>"`. That
# split matters because a command line's encoding is a property of the program
# being spawned - the CRT argv convention every other spawn here uses is not
# what cmd.exe parses, so a caller assembling its own shell invocation would
# have to know which convention applies and would get it wrong.
#
# `cwd` is applied in the child, so the caller's own working directory is
# untouched and the directory never enters the command line.
# ---
# command: the command line to run
# cwd:     working directory for the child, or nil to inherit
# envp:    null-terminated environment array, or nil to inherit
# ret:     exit status, or an error retaining an unreaped child
pub fun run_shell(command: str, cwd: str, envp: **u8) res[ExitStatus, Error] {
    val pid: i64 = os.spawn_shell(command, envp, cwd);
    if (pid < 0) { ret res[ExitStatus, Error].err{process_error(pid, os.PROCESS_OP_SPAWN)}; }
    ret wait(Child{pid: pid});
}

# run a process and collect its complete standard output
#
# spawns the child with stdout bound to a pipe and drains it to end-of-file
# through io.read_all over the pipe's read end, so output of any length is
# captured and the child never blocks on a full pipe. a wait is attempted even
# when the drain fails, and a failed wait returns the remaining child owner.
# ---
# a:        allocator for the captured output
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     null-terminated environment array
# ret:      the exit status and captured stdout, or an error
pub fun output(a: *A.Allocator, pathname: str, argv: **u8, envp: **u8) res[Output, Error] {
    var fds: [2]i32;
    val piped: i64 = os.pipe(?fds[0]);
    if (piped < 0) { ret res[Output, Error].err{process_error(piped, os.PROCESS_OP_PIPE)}; }

    val pid: i64 = os.spawn_redirected(pathname, argv, envp, -1, fds[1], -1);
    if (pid < 0) {
        os.close(fds[0]);
        os.close(fds[1]);
        ret res[Output, Error].err{process_error(pid, os.PROCESS_OP_SPAWN)};
    }

    # the parent never writes; closing its write end lets the drain see EOF
    # once the child's stdout closes
    os.close(fds[1]);

    val pipe_file: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: fds[0]::usize}};
    var rd: m_reader.Reader = filesystem.reader(pipe_file);
    val bytes_r: res[Vector[u8], ReadError] = m_reader.read_all(a, ?rd);
    os.close(fds[0]);

    val waited: res[ExitStatus, Error] = wait(Child{pid: pid});
    ret finish_output(bytes_r, waited);
}

# combine the drain and the wait: a failed drain is primary and carries the
# wait's outcome beside it; a failed wait after a good drain releases the
# capture and passes the wait's error, with its retained child, through
fun finish_output(bytes_r: res[Vector[u8], ReadError], waited: res[ExitStatus, Error]) res[Output, Error] {
    if (sel bytes_r.err) {
        var failure: OutputFailure = OutputFailure{read: bytes_r.err, wait: opt[os.ProcessWaitError].none{}};
        if (sel waited.err) {
            val secondary: Child = retained(waited.err);
            failure.child = secondary;
            if (sel waited.err.native) {
                val cause: Failure = waited.err.native;
                failure.wait = opt[os.ProcessWaitError].some{os.ProcessWaitError{
                    code: cause.code, native_code: cause.native_code, operation: cause.operation}};
            }
        }
        ret res[Output, Error].err{Error.output{failure}};
    }
    var bytes: Vector[u8] = bytes_r.ok;
    if (sel waited.err) {
        vector.dnit[u8](?bytes);
        ret res[Output, Error].err{waited.err};
    }
    ret res[Output, Error].ok{Output{status: waited.ok, bytes: bytes}};
}

fun spawned(pid: i64, pgid: i64) res[Child, Error] {
    if (pid < 0) { ret res[Child, Error].err{process_error(pid, os.PROCESS_OP_SPAWN)}; }
    ret res[Child, Error].ok{Child{pid: pid, pgid: pgid}};
}

# start a process without waiting
# ---
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     null-terminated environment array
# ret:      child handle, or the spawn failure
pub fun spawn(pathname: str, argv: **u8, envp: **u8) res[Child, Error] {
    ret spawned(os.spawn(pathname, argv, envp), 0);
}

# start a process without waiting, with its stdout and/or
# stderr bound to caller-supplied descriptors.
#
# the parent keeps ownership of the passed descriptors (close them after the
# child exits, or after the spawn to let a pipe's read end see EOF); -1 leaves
# that stream inherited. stdin is always inherited.
# ---
# pathname:  path to executable
# argv:      null-terminated argument array
# envp:      null-terminated environment array
# stdout_fd: descriptor for the child's stdout, or -1 to inherit
# stderr_fd: descriptor for the child's stderr, or -1 to inherit
# ret:       child handle, or the spawn failure
pub fun spawn_redirected(pathname: str, argv: **u8, envp: **u8, stdout_fd: i32, stderr_fd: i32) res[Child, Error] {
    ret spawned(os.spawn_redirected(pathname, argv, envp, -1, stdout_fd, stderr_fd), 0);
}

# start a process without waiting, placed as the leader of its own new
# process group
#
# a caller that spawns a tree of children (a test runner, a build-step
# executor) uses this instead of spawn so terminate_group can later reach the
# whole tree at once: any descendant that does not itself call setpgid
# inherits this group from its parent.
# ---
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     null-terminated environment array
# ret:      child handle, or the spawn failure
pub fun spawn_grouped(pathname: str, argv: **u8, envp: **u8) res[Child, Error] {
    $if ($mach.build.os == $mach.os.linux) {
        val pid: i64 = linux.spawn_grouped(pathname, argv, envp);
        ret spawned(pid, pid);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        val pid: i64 = darwin.spawn_grouped(pathname, argv, envp);
        ret spawned(pid, pid);
    }
    $or ($mach.build.os == $mach.os.windows) {
        var job: isize = 0;
        val pid: i64 = windows.spawn_grouped(pathname, argv, envp, ?job);
        ret spawned(pid, job::i64);
    }
    $or {
        ret res[Child, Error].err{Error.unsupported{}};
    }
}

# start a process without waiting, with its stdout and/or stderr bound to
# caller-supplied descriptors, placed as the leader of its own new process
# group (see spawn_grouped)
# ---
# pathname:  path to executable
# argv:      null-terminated argument array
# envp:      null-terminated environment array
# stdout_fd: descriptor for the child's stdout, or -1 to inherit
# stderr_fd: descriptor for the child's stderr, or -1 to inherit
# ret:       child handle, or the spawn failure
pub fun spawn_redirected_grouped(pathname: str, argv: **u8, envp: **u8, stdout_fd: i32, stderr_fd: i32) res[Child, Error] {
    $if ($mach.build.os == $mach.os.linux) {
        val pid: i64 = linux.spawn_redirected_grouped(pathname, argv, envp, -1, stdout_fd, stderr_fd);
        ret spawned(pid, pid);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        val pid: i64 = darwin.spawn_redirected_grouped(pathname, argv, envp, -1, stdout_fd, stderr_fd);
        ret spawned(pid, pid);
    }
    $or ($mach.build.os == $mach.os.windows) {
        var job: isize = 0;
        val pid: i64 = windows.spawn_redirected_grouped(pathname, argv, envp, -1, stdout_fd, stderr_fd, ?job);
        ret spawned(pid, job::i64);
    }
    $or {
        ret res[Child, Error].err{Error.unsupported{}};
    }
}

# the spawn primitives take a nil cwd to mean "inherit this process's", and a
# caller with nothing to say is far more likely to have an empty string in hand
# than a nil pointer. chdir("") fails, so passing the empty string straight
# through would kill the child with a 126 rather than inheriting.
fun cwd_or_inherit(cwd: str) *u8 {
    if (str_empty(cwd)) { ret nil; }
    ret cwd::*u8;
}

# start a process in a given working directory without waiting
#
# the directory is applied in the CHILD after the fork and before the exec, so
# this process's own working directory is never disturbed and two spawns into
# different directories cannot race each other.
# ---
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     null-terminated environment array
# cwd:      directory to run in, or empty to inherit this process's
# ret:      child handle, or the spawn failure
pub fun spawn_in(pathname: str, argv: **u8, envp: **u8, cwd: str) res[Child, Error] {
    ret spawned(os.spawn_in(pathname, argv, envp, cwd_or_inherit(cwd)), 0);
}

# start a process in a given working directory with its standard streams bound
# to caller-supplied descriptors
# ---
# cwd:       directory to run in, or empty to inherit this process's
# stdin_fd:  descriptor for the child's stdin, or -1 to inherit
# stdout_fd: descriptor for the child's stdout, or -1 to inherit
# stderr_fd: descriptor for the child's stderr, or -1 to inherit
# ret:       child handle, or the spawn failure
pub fun spawn_redirected_in(pathname: str, argv: **u8, envp: **u8, cwd: str,
                            stdin_fd: i32, stdout_fd: i32,
                            stderr_fd: i32) res[Child, Error] {
    ret spawned(os.spawn_redirected_in(pathname, argv, envp, cwd_or_inherit(cwd), stdin_fd, stdout_fd, stderr_fd), 0);
}

# start a process in a given working directory, with redirected streams, as the
# leader of its own group
#
# this is the form to reach for when the child may spawn children of its own: a
# build step running a shell that runs a compiler. terminate_group then reaches
# the whole tree, where terminate_child would leave the grandchildren orphaned
# and still running.
# ---
# ret: child handle whose pgid identifies the group, or the spawn failure
pub fun spawn_redirected_in_grouped(pathname: str, argv: **u8, envp: **u8, cwd: str,
                                    stdin_fd: i32, stdout_fd: i32,
                                    stderr_fd: i32) res[Child, Error] {
    $if ($mach.build.os == $mach.os.linux) {
        val pid: i64 = linux.spawn_redirected_in_grouped(pathname, argv, envp, cwd_or_inherit(cwd), stdin_fd, stdout_fd, stderr_fd);
        ret spawned(pid, pid);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        val pid: i64 = darwin.spawn_redirected_in_grouped(pathname, argv, envp, cwd_or_inherit(cwd), stdin_fd, stdout_fd, stderr_fd);
        ret spawned(pid, pid);
    }
    $or ($mach.build.os == $mach.os.windows) {
        var job: isize = 0;
        val pid: i64 = windows.spawn_redirected_in_grouped(pathname, argv, envp, cwd_or_inherit(cwd), stdin_fd, stdout_fd, stderr_fd, ?job);
        ret spawned(pid, job::i64);
    }
    $or {
        ret res[Child, Error].err{Error.unsupported{}};
    }
}

# a termination refused by the platform keeps the child with the caller
fun terminated(code: i64, child: Child) err[Error] {
    if (code < 0) {
        ret err[Error].err{Error.native{Failure{code: code, operation: os.PROCESS_OP_TERMINATE, child: child}}};
    }
    ret err[Error].ok{};
}

# forcefully stop a child without reaping it
#
# the child remains waitable after this succeeds. callers must still pass it
# to wait (or collect it through wait_any) to obtain its status and release
# retained platform resources.
#
# terminate_child, wait, and wait_any must not run concurrently for the same
# child. once one of the wait operations begins reaping a child, its numeric
# process ID can be released for reuse.
# ---
# child: child handle from spawn
# ret:   the native failure, which keeps the child with the caller
pub fun terminate_child(child: Child) err[Error] {
    ret terminated(os.terminate_child(child.pid), child);
}

# signal every process in a child's group, reaching descendants that spawned
# their own children in turn
#
# `ungrouped` when `child` was not created through spawn_grouped /
# spawn_redirected_grouped (child.pgid == 0): there is no group to signal.
# member processes remain individually waitable afterward, exactly as
# terminate_child leaves a single child waitable.
# ---
# child: child handle from spawn_grouped or spawn_redirected_grouped
# ret:   the native failure, which keeps the child with the caller
pub fun terminate_group(child: Child) err[Error] {
    if (child.pgid == 0) { ret err[Error].err{Error.ungrouped{}}; }
    $if ($mach.build.os == $mach.os.linux) {
        ret terminated(linux.terminate_group(child.pgid), child);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        ret terminated(darwin.terminate_group(child.pgid), child);
    }
    $or ($mach.build.os == $mach.os.windows) {
        ret terminated(windows.terminate_group(child.pgid), child);
    }
    $or {
        ret err[Error].err{Error.unsupported{}};
    }
}

# wait for a child process to exit
#
# a signal that interrupts the wait is not a failure and is not reported as
# one: the wait is reissued until the child is reaped. the os layer bounds its
# own retries and surfaces exhaustion as EINTR, so a wrapper that treated that
# sentinel as terminal would turn a transient interruption into a permanent
# error and leave the child unreaped.
# ---
# child: child handle from spawn
# ret:   exit status, or a typed error retaining any unreaped child
pub fun wait(child: Child) res[ExitStatus, Error] {
    if (child.pid <= 0) { ret res[ExitStatus, Error].err{process_error(os.EINVAL, os.PROCESS_OP_WAIT)}; }
    for {
        var status: ExitStatus;
        val result: os.WaitResult = os.wait_pid(child.pid, ?status, 0);
        if (result.error.code == os.EINTR) { cnt; }
        if (result.error.code < 0) { ret res[ExitStatus, Error].err{wait_error(result.error, child)}; }
        if (result.pid > 0 && (exited(status) || signaled(status))) { ret res[ExitStatus, Error].ok{status}; }
    }
}

# reap a child if it has already exited, without blocking
#
# this is the piece a caller needs to enforce a deadline: blocking in wait
# gives up the ability to notice that a scope expired, so a supervisor polls
# with this instead and keeps its own timing.
#
# a child that is still running is not an error; the result is simply absent.
# an interrupted probe is likewise not an error: it is reissued, so absent
# always means still running and never means interrupted.
# ---
# child: child handle from any spawn
# ret:   the exit status if it has terminated, absent if it is still running,
#        or a typed error retaining any unreaped child
pub fun try_wait(child: Child) res[opt[ExitStatus], Error] {
    if (child.pid <= 0) { ret res[opt[ExitStatus], Error].err{process_error(os.EINVAL, os.PROCESS_OP_WAIT)}; }
    for {
        var status: ExitStatus;
        val result: os.WaitResult = os.wait_pid(child.pid, ?status, os.WNOHANG);
        if (result.error.code == os.EINTR) { cnt; }
        if (result.error.code < 0) { ret res[opt[ExitStatus], Error].err{wait_error(result.error, child)}; }
        if (result.pid > 0 && (exited(status) || signaled(status))) {
            ret res[opt[ExitStatus], Error].ok{opt[ExitStatus].some{status}};
        }
        ret res[opt[ExitStatus], Error].ok{opt[ExitStatus].none{}};
    }
}

# block until any child of this process exits
#
# POSIX wait(-1) semantics on every platform (the windows layer emulates the
# -1 pid by waiting across its tracked child handles). the returned pair
# identifies which child was reaped and how it exited, so a caller juggling
# several children can map the exit back to its work item. errs when there is
# no child to wait for.
#
# serialize waits on the same child, and wait_any with all waits and termination
# an error without a selected child leaves every existing child owner with its caller
#
# an interrupting signal is retried rather than reported, as in wait.
# ---
# ret: the reaped child and its exit status, or a typed wait error
pub fun wait_any() res[Reaped, Error] {
    for {
        var status: ExitStatus;
        val result: os.WaitResult = os.wait_pid(-1, ?status, 0);
        if (result.error.code == os.EINTR) { cnt; }
        if (result.error.code < 0) { ret res[Reaped, Error].err{wait_error(result.error, Child{})}; }
        if (result.pid > 0 && (exited(status) || signaled(status))) {
            ret res[Reaped, Error].ok{Reaped{child: Child{pid: result.pid}, status: status}};
        }
    }
}

# how a supervised child ended
pub rec Supervised {
    status: ExitStatus;
    # true when the deadline or a cancellation ended it rather than the child
    # finishing on its own
    terminated: bool;
    # the reason the scope carried when it ended, ACTIVE when the child won
    reason: cancel.Reason;
}

# how often a supervised wait looks at the child and the clock
val SUPERVISE_POLL_NSEC: i64 = 2000000;

# run a child to completion under a cancellation scope, terminating its whole
# group if the scope ends first
#
# this is the piece that makes a deadline mean something for a process. a scope
# with a deadline is only a promise until somebody enforces it, and enforcing it
# on a single child is not enough when that child spawned children of its own: a
# build step that runs a shell that runs a compiler leaves the compiler running
# if only the shell is signalled. so the group is what gets terminated, which is
# why the child should come from one of the grouped spawns.
#
# successful supervision reaps the child. a wait or termination failure returns
# its retained child for explicit retry or cleanup, alongside the original cause.
#
# a child that is not in a group is still supervised; expiry then terminates
# just that child, and any grandchildren it started survive. that is a weaker
# guarantee, not a silent one: prefer a grouped spawn when the child may spawn.
# ---
# child: child handle, ideally from a grouped spawn
# scope: the scope whose deadline or cancellation bounds the child
# ret:   how it ended, or a typed error retaining any unreaped child
pub fun wait_within(child: Child, scope: *cancel.Scope) res[Supervised, Error] {
    if (scope == nil) {
        ret res[Supervised, Error].err{Error.native{Failure{code: os.EINVAL, operation: os.PROCESS_OP_WAIT, child: child}}};
    }

    var terminated: bool = false;
    for {
        val probe: res[opt[ExitStatus], Error] = try_wait(child);
        if (sel probe.err) { ret res[Supervised, Error].err{probe.err}; }
        if (sel probe.ok.some) {
            ret res[Supervised, Error].ok{Supervised{
                status: probe.ok.some,
                terminated: terminated,
                reason: cancel.reason(scope)}};
        }

        # the child is still running, so ask whether it is still allowed to
        cancel.expire(scope, tm.monotonic());
        val why: cancel.Reason = cancel.reason(scope);
        if (why != cancel.ACTIVE && !terminated) {
            var stopped: err[Error];
            if (child.pgid != 0) { stopped = terminate_group(child); }
            or { stopped = terminate_child(child); }
            if (sel stopped.err) { ret res[Supervised, Error].err{stopped.err}; }
            terminated = true;
            # fall through and keep polling: the child still has to be reaped
        }
        os.sleep(SUPERVISE_POLL_NSEC);
    }
}

# check if the process exited normally
# ---
# status: exit status to inspect
# ret:    true if the process called exit
pub fun exited(status: ExitStatus) bool {
    ret os.has_exited(status);
}

# get the exit code of a normally exited process
# ---
# status: exit status to inspect
# ret:    full u32 exit code, only valid if exited() is true
pub fun code(status: ExitStatus) u32 {
    ret os.exit_code(status);
}

# check if the process was killed by a signal
# ---
# status: exit status to inspect
# ret:    true if terminated by signal
pub fun signaled(status: ExitStatus) bool {
    ret os.was_signaled(status);
}

# get the signal number that killed the process
# ---
# status: exit status to inspect
# ret:    signal number
pub fun signal(status: ExitStatus) i32 {
    ret os.term_signal(status);
}

# terminate the current process
# ---
# code: exit code
pub fun exit(code: i64) {
    os.terminate(code);
}

# the most candidate spellings one PATH directory is probed for. posix uses
# one; windows uses one per PATHEXT entry, and the cmd default has four.
val CAND_MAX: usize = 16;

# a refused string copy; a slice this module computes is always inside its
# string, so a bounds refusal is invalid use rather than a reachable outcome
fun copy_refused(failure: StrError) Error {
    if (sel failure.alloc) { ret Error.alloc{failure.alloc}; }
    ret Error.alloc{A.Error.invalid{}};
}

# resolve a user-named program to a spawnable path using PATH
#
# none of the spawn entry points searches PATH: execve resolves nothing, and
# the windows layer passes a non-NULL lpApplicationName. a caller spawning a
# program the USER names rather than a fixed path resolves it here first.
#
# PATH is the only source. the current directory is never consulted, so a
# binary committed into a working tree cannot shadow the real tool.
# ---
# a:    allocator for the result
# name: program name, bare or already pathed
# ret:  an owned spawnable path (extent is its length plus the terminator,
#       released with text.string.str_free), or the failure
pub fun resolve(a: *A.Allocator, name: str) res[str, Error] {
    if (str_empty(name)) { ret res[str, Error].err{Error.empty_name{}}; }
    if (path.has_separator(name)) { ret owned_copy(a, name); }

    val paths_r: res[opt[OwnedString], env.EnvError] = env.value(a, "PATH");
    if (sel paths_r.err) { ret res[str, Error].err{Error.env{paths_r.err}}; }
    if (sel paths_r.ok.none) { ret res[str, Error].err{Error.unset{}}; }
    var paths: OwnedString = paths_r.ok.some;

    val out: res[str, Error] = resolve_in(a, name, paths.data);
    owned_release(?paths);
    ret out;
}

# the candidate spellings are owned only when PATHEXT built them; the
# single-spelling case aliases `name`, which belongs to the caller
fun release_candidates(a: *A.Allocator, cand: *str, ncand: usize, exts: str, exts_extent: usize) {
    if (str_empty(exts)) { ret; }
    var k: usize = 0;
    for (k < ncand) { A.deallocate[u8](a, cand[k], str_len(cand[k]) + 1); k = k + 1; }
    A.deallocate[u8](a, exts, exts_extent);
}

# resolve a program name against a caller-supplied search list
#
# the search policy, with the environment read left to `resolve`. a caller with
# its own list - a configured toolchain directory, a sandbox - searches it here
# without going through PATH, and the policy stays testable without a way to
# set an environment variable.
#
# `search` is PATH-shaped and is NOT modified: entries separated by `;` on
# windows and `:` elsewhere. an EMPTY entry is skipped rather than treated as
# the current directory, which is the whole point of this function existing -
# letting the OS search would put the working directory ahead of the real tool
# on windows.
#
# a name that already spells a path is returned unresolved and unprobed. the
# result is owned by the caller in BOTH cases, so the free is unconditional.
# returning the borrowed argument for pathed names would make ownership depend
# on the value, which is how a caller ends up leaking one path and double
# freeing the other.
#
# a refused copy anywhere in the walk is the allocator's error, never a
# directory silently skipped: a search that could not look everywhere does
# not get to answer `not_found`.
# ---
# a:      allocator for the result
# name:   program name, bare or already pathed
# search: PATH-shaped list of directories, searched in order
# ret:    an owned spawnable path, or the failure
pub fun resolve_in(a: *A.Allocator, name: str, search: str) res[str, Error] {
    if (str_empty(name)) { ret res[str, Error].err{Error.empty_name{}}; }
    if (path.has_separator(name)) { ret owned_copy(a, name); }

    var list_sep: u8 = ':';
    $if ($mach.build.os == $mach.os.windows) {
        list_sep = ';';
    }

    # windows spells an executable with an extension: `git` is not a file,
    # `git.exe` is. joining the bare name alone would resolve nothing there, so
    # a bare name is tried against each PATHEXT suffix, in order, within a
    # directory before moving to the next. a name that already carries an
    # extension is tried as written, and posix always has exactly one spelling.
    var cand: [CAND_MAX]str;
    var ncand: usize = 1;
    cand[0] = name;

    var exts: str = 0::str;
    var exts_extent: usize = 0;
    $if ($mach.build.os == $mach.os.windows) {
        if (!str_contains_char(name, '.')) {
            val exts_r: res[opt[OwnedString], env.EnvError] = env.value(a, "PATHEXT");
            if (sel exts_r.err) { ret res[str, Error].err{Error.env{exts_r.err}}; }
            if (sel exts_r.ok.some) {
                exts = exts_r.ok.some.data;
                exts_extent = exts_r.ok.some.extent;
            }

            # the set cmd.exe assumes when PATHEXT is unset
            if (str_empty(exts)) {
                if (exts != 0::str) { A.deallocate[u8](a, exts, exts_extent); }
                val d_r: res[str, StrError] = str_copy(a, ".COM;.EXE;.BAT;.CMD");
                if (sel d_r.err) { ret res[str, Error].err{copy_refused(d_r.err)}; }
                exts = d_r.ok;
                exts_extent = str_len(exts) + 1;
            }

            val elen: usize = str_len(exts);
            ncand = 0;
            var e: usize = 0;
            for (e < elen && ncand < CAND_MAX) {
                val estart: usize = e;
                for (e < elen && exts[e] != ';') { e = e + 1; }
                val eseg: usize = e - estart;
                exts[e] = 0;
                e = e + 1;
                if (eseg == 0) { cnt; }

                val j_r: res[str, StrError] = str_join(a, name, (?exts[estart])::str);
                if (sel j_r.err) {
                    release_candidates(a, ?cand[0], ncand, exts, exts_extent);
                    ret res[str, Error].err{copy_refused(j_r.err)};
                }
                cand[ncand] = j_r.ok;
                ncand = ncand + 1;
            }
        }
    }

    val slen: usize = str_len(search);
    var found: str = 0::str;
    var refused_query: opt[io_error.Error];
    var i: usize = 0;
    for (i < slen && str_empty(found)) {
        val start: usize = i;
        for (i < slen && search[i] != list_sep) { i = i + 1; }
        val seg_len: usize = i - start;
        i = i + 1;

        # an empty entry means the current directory on both posix and windows,
        # which is exactly what must never be searched
        if (seg_len == 0) { cnt; }

        # `search` belongs to the caller and may be a literal in read-only
        # memory, so the entry is copied out rather than terminated in place
        val dir_r: res[str, StrError] = str_copy_slice(a, search, start, seg_len);
        if (sel dir_r.err) {
            release_candidates(a, ?cand[0], ncand, exts, exts_extent);
            ret res[str, Error].err{copy_refused(dir_r.err)};
        }
        val dir: str = dir_r.ok;

        var c: usize = 0;
        for (c < ncand) {
            val cand_r: res[path.Path, A.Error] = path.join(a, dir, cand[c]);
            if (sel cand_r.err) {
                A.deallocate[u8](a, dir, seg_len + 1);
                release_candidates(a, ?cand[0], ncand, exts, exts_extent);
                ret res[str, Error].err{Error.alloc{cand_r.err}};
            }
            val full: str = cand_r.ok;
            val present: res[bool, io_error.Error] = filesystem.is_file(full);
            if (sel present.ok && present.ok) { found = full; brk; }
            if (sel present.err) { refused_query = opt[io_error.Error].some{present.err}; }
            A.deallocate[u8](a, full, str_len(full) + 1);
            c = c + 1;
        }
        A.deallocate[u8](a, dir, seg_len + 1);
    }

    release_candidates(a, ?cand[0], ncand, exts, exts_extent);

    if (str_empty(found)) {
        if (sel refused_query.some) { ret res[str, Error].err{Error.query{refused_query.some}}; }
        ret res[str, Error].err{Error.not_found{}};
    }
    ret res[str, Error].ok{found};
}

# an owned copy of a pathed name
fun owned_copy(a: *A.Allocator, name: str) res[str, Error] {
    val copied: res[str, StrError] = str_copy(a, name);
    if (sel copied.err) { ret res[str, Error].err{copy_refused(copied.err)}; }
    ret res[str, Error].ok{copied.ok};
}

# the exec contract is platform-neutral, but the test programs are not;
# the $if blocks confine the differences to program paths, argv shapes,
# and echo's line ending (cmd appends CRLF where posix echo appends LF).
$if ($mach.build.os == $mach.os.windows) {
    var comspec_buf: [260]u8;

    # %ComSpec% names the command interpreter; fall back to the canonical
    # path when unset
    fun shell_path() str {
        val n: i64 = os.getenv("ComSpec", ?comspec_buf[0], 260);
        if (n > 0 && n < 260) {
            ret (?comspec_buf[0])::str;
        }
        ret "C:\\Windows\\System32\\cmd.exe";
    }

    fun make_shell_argv(command: str) [4]usize {
        var buf: [4]usize;
        buf[0] = ("cmd")::usize;
        buf[1] = ("/c")::usize;
        buf[2] = command::usize;
        buf[3] = 0;
        ret buf;
    }

    fun prog_ok() str { ret shell_path(); }
    fun argv_ok() [4]usize { ret make_shell_argv("exit 0"); }
    fun prog_fail() str { ret shell_path(); }
    fun argv_fail() [4]usize { ret make_shell_argv("exit 1"); }
    fun prog_echo() str { ret shell_path(); }
    fun argv_echo() [4]usize { ret make_shell_argv("echo hello"); }

    # cmd's echo appends CRLF: "hello\r\n"
    val ECHO_LEN: usize = 7;

    # a scratch directory that is not the test process's own cwd, so a marker
    # created by the child proves the child actually moved there
    var temp_buf: [260]u8;
    fun scratch_dir() str {
        val n: i64 = os.getenv("TEMP", ?temp_buf[0], 260);
        if (n > 0 && n < 260) { ret (?temp_buf[0])::str; }
        ret "C:\\Windows\\Temp";
    }
    fun probe_cmd() str { ret "echo x>std_exec_cwd_probe.tmp"; }
    # a bare name that PATH resolves on any windows install. it carries no
    # extension, so it also exercises the PATHEXT spelling walk.
    fun known_program() str { ret "cmd"; }
    # a command whose quoting only survives if the interpreter's own rules are
    # honoured: the CRT convention mangles the embedded quotes
    fun probe_quoted_cmd() str { ret "copy \"std exec seed.txt\" std_exec_quoted_probe.tmp"; }
    fun seed_cmd() str { ret "echo seeded>\"std exec seed.txt\""; }

    # regression for the handle-inheritance leak: a child spawned while a
    # prior child's pipe write end is open must not inherit that handle,
    # or the pipe only reaches EOF once the unrelated child exits. the
    # sleeper runs ~2s; the drain must complete while it is still alive.
    test "std.process.exec.spawn:no_pipe_handle_leak" {
        var leak_buf: [64]u8;
        var fds: [2]i32;
        if (os.pipe(?fds[0]) != 0) { ret 1; }
        var av1: [4]usize = argv_echo();
        val pid1: i64 = os.spawn_redirected(shell_path(), (?av1[0])::**u8, nil, -1, fds[1], -1);
        if (pid1 < 0) {
            os.close(fds[0]);
            os.close(fds[1]);
            ret 1;
        }
        var av2: [4]usize = make_shell_argv("ping -n 3 127.0.0.1 > NUL");
        val pid2: i64 = os.spawn(shell_path(), (?av2[0])::**u8, nil);
        os.close(fds[1]);
        var st: os.ProcessStatus;
        if (pid2 < 0) {
            os.close(fds[0]);
            os.wait_pid(pid1, ?st, 0);
            ret 1;
        }
        var total: usize = 0;
        for (true) {
            val n: i64 = os.read(fds[0], ?leak_buf[0], 64);
            if (n < 0) { ret 1; }
            if (n == 0) { brk; }
            total = total + n::usize;
        }
        os.close(fds[0]);
        val still_running: os.WaitResult = os.wait_pid(pid2, ?st, os.WNOHANG);
        os.wait_pid(pid1, ?st, 0);
        os.wait_pid(pid2, ?st, 0);
        if (still_running.pid != 0 || still_running.error.code != 0) { ret 1; }
        if (total != ECHO_LEN) { ret 1; }
        ret 0;
    }
}
$or {
    fun make_argv1(prog: str) [4]usize {
        var buf: [4]usize;
        buf[0] = prog::usize;
        buf[1] = 0;
        buf[2] = 0;
        buf[3] = 0;
        ret buf;
    }

    fun make_argv2(prog: str, a1: str) [4]usize {
        var buf: [4]usize;
        buf[0] = prog::usize;
        buf[1] = a1::usize;
        buf[2] = 0;
        buf[3] = 0;
        ret buf;
    }

    fun prog_ok() str {
        $if ($mach.build.os == $mach.os.darwin) { ret "/usr/bin/true"; }
        $or { ret "/bin/true"; }
    }
    fun argv_ok() [4]usize { ret make_argv1(prog_ok()); }
    fun prog_fail() str {
        $if ($mach.build.os == $mach.os.darwin) { ret "/usr/bin/false"; }
        $or { ret "/bin/false"; }
    }
    fun argv_fail() [4]usize { ret make_argv1(prog_fail()); }
    fun prog_echo() str { ret "/bin/echo"; }
    fun argv_echo() [4]usize { ret make_argv2("/bin/echo", "hello"); }

    # echo emits "hello\n"
    val ECHO_LEN: usize = 6;

    # a scratch directory that is not the test process's own cwd, so a marker
    # created by the child proves the child actually moved there
    fun scratch_dir() str { ret "/tmp"; }
    # a bare name that PATH resolves on any posix install
    fun known_program() str { ret "sh"; }
    fun probe_cmd() str { ret "echo x>std_exec_cwd_probe.tmp"; }
    # a command whose quoting only survives if the interpreter's own rules are
    # honoured: the CRT convention mangles the embedded quotes
    fun probe_quoted_cmd() str { ret "cp \"std exec seed.txt\" std_exec_quoted_probe.tmp"; }
    fun seed_cmd() str { ret "echo seeded>\"std exec seed.txt\""; }
}

# test predicates: `sel` takes a place, so an inline call is tested through these
fun exited_zero(r: res[ExitStatus, Error]) bool {
    if (!sel r.ok) { ret false; }
    ret exited(r.ok) && code(r.ok) == 0;
}
fun present(p: str) bool {
    val queried: res[bool, io_error.Error] = filesystem.is_file(p);
    ret sel queried.ok && queried.ok;
}

fun exited_with(r: res[ExitStatus, Error], want: u32) bool {
    if (!sel r.ok) { ret false; }
    ret exited(r.ok) && code(r.ok) == want;
}

fun stopped(r: err[Error]) bool { ret sel r.ok; }

fun still_running(r: res[opt[ExitStatus], Error]) bool {
    if (!sel r.ok) { ret false; }
    ret sel r.ok.none;
}

fun resolved_to(r: res[str, Error], want: str) bool {
    if (!sel r.ok) { ret false; }
    ret str_equals(r.ok, want);
}

test "std.process.exec.run:success_exits_zero" {
    var argv: [4]usize = argv_ok();
    val r: res[ExitStatus, Error] = run(prog_ok(), (?argv[0])::**u8, nil);
    if (!exited_zero(r)) { ret 1; }
    ret 0;
}

test "std.process.exec.run:failure_exits_one" {
    var argv: [4]usize = argv_fail();
    val r: res[ExitStatus, Error] = run(prog_fail(), (?argv[0])::**u8, nil);
    if (!exited_with(r, 1)) { ret 1; }
    ret 0;
}

test "std.process.exec.spawn:wait_matches_run" {
    var argv: [4]usize = argv_ok();
    val sr: res[Child, Error] = spawn(prog_ok(), (?argv[0])::**u8, nil);
    if (sel sr.err) { ret 1; }
    val child: Child = sr.ok;
    val wr: res[ExitStatus, Error] = wait(child);
    if (!exited_zero(wr)) { ret 2; }
    ret 0;
}

# a handle that names no child is invalid use, reported as the native EINVAL
# wait failure with no child retained
test "std.process.exec.wait:no_child_is_invalid_use" {
    val wr: res[ExitStatus, Error] = wait(Child{pid: 0});
    if (!sel wr.err) { ret 1; }
    if (!sel wr.err.native) { ret 2; }
    if (wr.err.native.code != os.EINVAL || wr.err.native.operation != os.PROCESS_OP_WAIT) { ret 3; }
    if (retained(wr.err).pid != 0) { ret 4; }
    val probed: res[opt[ExitStatus], Error] = try_wait(Child{pid: 0});
    if (!sel probed.err) { ret 5; }
    if (!sel probed.err.native) { ret 6; }
    if (probed.err.native.code != os.EINVAL) { ret 7; }
    ret 0;
}

# output drains the child's whole stdout into owned bytes
test "std.process.exec.output:captures_echo" {
    var buf: [32768]u8;
    var fst: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 32768);

    var argv: [4]usize = argv_echo();
    val r: res[Output, Error] = output(?a, prog_echo(), (?argv[0])::**u8, nil);
    if (sel r.err) { ret 1; }
    val o: Output = r.ok;
    if (!exited(o.status)) { ret 1; }
    if (code(o.status) != 0) { ret 1; }
    if (o.bytes.len != ECHO_LEN) { ret 1; }
    if (o.bytes.data[0] != 'h') { ret 1; }
    if (o.bytes.data[4] != 'o') { ret 1; }
    if (o.bytes.data[ECHO_LEN - 1] != '\n') { ret 1; }
    ret 0;
}

# fork-heavy regression (issue mach#1487): spawn now clones the child onto a
# private stack with a shared address space (CLONE_VM|CLONE_VFORK) instead of
# fork()ing, allocating and freeing that stack per call. exercise it across
# many iterations to catch a leaked or corrupted child stack.
test "std.process.exec.run:repeated_spawns_stay_correct" {
    var i: usize = 0;
    for (i < 64) {
        var argv: [4]usize = argv_ok();
        val r: res[ExitStatus, Error] = run(prog_ok(), (?argv[0])::**u8, nil);
        if (!exited_zero(r)) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "std.process.exec.spawn_redirected:pipes_child_stdout" {
    var redir_buf: [64]u8;
    var fds: [2]i32;
    if (os.pipe(?fds[0]) < 0) { ret 1; }

    var argv: [4]usize = argv_echo();
    val sr: res[Child, Error] = spawn_redirected(prog_echo(), (?argv[0])::**u8, nil, fds[1], -1);
    if (sel sr.err) {
        os.close(fds[0]);
        os.close(fds[1]);
        ret 1;
    }
    # closing the parent's write end lets read see EOF once the child exits
    os.close(fds[1]);

    var total: usize = 0;
    for (true) {
        val n: i64 = os.read(fds[0], (?redir_buf[total])::*u8, 64 - total);
        if (n <= 0) { brk; }
        total = total + n::usize;
    }
    os.close(fds[0]);

    val wr: res[ExitStatus, Error] = wait(sr.ok);
    if (!exited_zero(wr)) { ret 1; }

    if (total != ECHO_LEN) { ret 1; }
    if (redir_buf[0] != 'h') { ret 1; }
    if (redir_buf[4] != 'o') { ret 1; }
    ret 0;
}

# spawn_grouped makes the child the leader of its own group. on linux/darwin
# that means its pgid equals its own pid, checked both by the returned Child
# record and by an independent getpgid read against the live process; on
# windows there is no pid-keyed query to cross-check against (Child.pgid IS
# the job handle, not a lookup key), so the check is that a real job handle
# came back and the child still runs to completion normally afterward -
# proof the CREATE_SUSPENDED child actually got resumed.
test "std.process.exec.spawn_grouped:child_pgid_equals_pid" {
    $if ($mach.build.os == $mach.os.windows) {
        var argv: [4]usize = argv_ok();
        val sr: res[Child, Error] = spawn_grouped(prog_ok(), (?argv[0])::**u8, nil);
        if (sel sr.err) { ret 1; }
        val child: Child = sr.ok;

        var bad: u8 = 0;
        if (child.pgid == 0) { bad = 1; }

        val wr: res[ExitStatus, Error] = wait(child);
        if (!exited_zero(wr)) { bad = 1; }
        ret bad::i32;
    }
    $or {
        var argv: [4]usize = argv_ok();
        val sr: res[Child, Error] = spawn_grouped(prog_ok(), (?argv[0])::**u8, nil);
        if (sel sr.err) { ret 1; }
        val child: Child = sr.ok;

        var bad: u8 = 0;
        if (child.pgid != child.pid) { bad = 1; }
        $if ($mach.build.os == $mach.os.linux) {
            if (linux.getpgid(child.pid) != child.pgid) { bad = 1; }
        }
        $or ($mach.build.os == $mach.os.darwin) {
            if (darwin.getpgid(child.pid) != child.pgid) { bad = 1; }
        }

        val wr: res[ExitStatus, Error] = wait(child);
        if (sel wr.err) { bad = 1; }
        ret bad::i32;
    }
}

# terminate_group reaches a grandchild the direct child never told us about:
# the shell backgrounds `sleep 30`, reports its pid over a pipe, then blocks
# in `wait` - both processes share the group terminate_group signals, and
# neither is individually reachable through terminate_child (the sleep is not
# even our own child). the grandchild's liveness is polled through getpgid
# (ESRCH once gone) since wait_pid only works on this process's own children;
# the shell's is polled through a non-blocking wait_pid, which also reaps it.
#
# windows has no equivalent of `&` backgrounding with a `$!`-style way to
# recover the new pid from a plain cmd.exe one-liner, so the windows branch
# below proves the narrower but still load-bearing half of the same claim:
# TerminateJobObject actually reaches and kills the member process, not just
# that the API calls return success. a real cross-process grandchild case
# would need more windows-specific test plumbing than is justified here.
test "std.process.exec.terminate_group:kills_a_grandchild" {
    $if ($mach.build.os == $mach.os.windows) {
        var argv: [4]usize = make_shell_argv("ping -n 30 127.0.0.1 >NUL");
        val sr: res[Child, Error] = spawn_grouped(shell_path(), (?argv[0])::**u8, nil);
        if (sel sr.err) { ret 1; }
        val child: Child = sr.ok;
        if (child.pgid == 0) { terminate_child(child); wait(child); ret 1; }

        if (!stopped(terminate_group(child))) { terminate_child(child); wait(child); ret 1; }

        var wstatus: os.ProcessStatus;
        val w: os.WaitResult = os.wait_pid(child.pid, ?wstatus, 0);
        if (w.pid != child.pid || w.error.code != 0) { ret 1; }
        # TerminateJobObject's uExitCode becomes every member's exit code,
        # same TERMINATE_CHILD_EXIT_CODE terminate_child already uses -
        # confirms this reaped exit came from the group kill, not a ping that
        # happened to finish its own 30-second run on its own
        if (!exited(wstatus) || code(wstatus) != 137) { ret 1; }
        ret 0;
    }
    $or {
        var out_buf: [32]u8;
        var fds: [2]i32;
        if (os.pipe(?fds[0]) < 0) { ret 1; }

        var argv: [4]usize;
        argv[0] = ("/bin/sh")::usize;
        argv[1] = ("-c")::usize;
        argv[2] = ("sleep 30 & echo $!; wait")::usize;
        argv[3] = 0;

        val sr: res[Child, Error] = spawn_redirected_grouped("/bin/sh", (?argv[0])::**u8, nil, fds[1], -1);
        if (sel sr.err) {
            os.close(fds[0]);
            os.close(fds[1]);
            ret 1;
        }
        os.close(fds[1]);
        val shell: Child = sr.ok;

        # read the grandchild's pid, echoed as decimal text followed by '\n'
        var total: usize = 0;
        for (total < 31) {
            val n: i64 = os.read(fds[0], (?out_buf[total])::*u8, 32 - total);
            if (n <= 0) { brk; }
            total = total + n::usize;
            if (out_buf[total - 1] == '\n'::u8) { brk; }
        }
        os.close(fds[0]);
        if (total == 0) { terminate_child(shell); wait(shell); ret 1; }

        var grandchild: i64 = 0;
        var i: usize = 0;
        for (i < total && out_buf[i] >= '0'::u8 && out_buf[i] <= '9'::u8) {
            grandchild = grandchild * 10 + (out_buf[i] - '0'::u8)::i64;
            i = i + 1;
        }
        if (grandchild <= 0) { terminate_child(shell); wait(shell); ret 1; }

        if (!stopped(terminate_group(shell))) { wait(shell); ret 1; }

        # bounded poll (at most 1s total): both the shell and the grandchild
        # must disappear, not merely the one this process can wait() on
        var shell_reaped: u8 = 0;
        var grandchild_gone: u8 = 0;
        var tries: usize = 0;
        for (tries < 50 && (shell_reaped == 0 || grandchild_gone == 0)) {
            if (shell_reaped == 0) {
                var wstatus: os.ProcessStatus;
                if (os.wait_pid(shell.pid, ?wstatus, os.WNOHANG).pid == shell.pid) { shell_reaped = 1; }
            }
            if (grandchild_gone == 0) {
                $if ($mach.build.os == $mach.os.linux) {
                    if (linux.getpgid(grandchild) < 0) { grandchild_gone = 1; }
                }
                $or ($mach.build.os == $mach.os.darwin) {
                    if (darwin.getpgid(grandchild) < 0) { grandchild_gone = 1; }
                }
            }
            if (shell_reaped == 0 || grandchild_gone == 0) { os.sleep(20000000); }
            tries = tries + 1;
        }

        if (shell_reaped == 0) {
            var final_status: os.ProcessStatus;
            os.wait_pid(shell.pid, ?final_status, 0);
        }
        if (shell_reaped == 0 || grandchild_gone == 0) { ret 1; }
        ret 0;
    }
}

# a child spawned through plain spawn (not spawn_grouped) carries pgid == 0;
# there is no group to signal.
test "std.process.exec.terminate_group:ungrouped_child_errs" {
    var argv: [4]usize = argv_ok();
    val sr: res[Child, Error] = spawn(prog_ok(), (?argv[0])::**u8, nil);
    if (sel sr.err) { ret 1; }
    val child: Child = sr.ok;

    val tr: err[Error] = terminate_group(child);
    wait(child);
    if (!sel tr.err) { ret 1; }
    if (!sel tr.err.ungrouped) { ret 2; }
    ret 0;
}

# a termination the platform refuses keeps the child with the caller: a
# reaped pid is ECHILD, and the error names the child it was asked about
test "std.process.exec.terminate_child:refusal_is_native_and_keeps_the_child" {
    var argv: [4]usize = argv_ok();
    val sr: res[Child, Error] = spawn(prog_ok(), (?argv[0])::**u8, nil);
    if (sel sr.err) { ret 1; }
    val child: Child = sr.ok;
    val wr: res[ExitStatus, Error] = wait(child);
    if (!exited_zero(wr)) { ret 2; }
    val tr: err[Error] = terminate_child(child);
    if (!sel tr.err) { ret 3; }
    if (!sel tr.err.native) { ret 4; }
    if (tr.err.native.code != os.ECHILD || tr.err.native.operation != os.PROCESS_OP_TERMINATE) { ret 5; }
    if (retained(tr.err).pid != child.pid) { ret 6; }
    ret 0;
}

test "std.process.exec.wait_any:reaps_each_child_once" {
    var argv_a: [4]usize = argv_ok();
    val ra: res[Child, Error] = spawn(prog_ok(), (?argv_a[0])::**u8, nil);
    if (sel ra.err) { ret 1; }
    var argv_b: [4]usize = argv_ok();
    val rb: res[Child, Error] = spawn(prog_ok(), (?argv_b[0])::**u8, nil);
    if (sel rb.err) { ret 1; }
    val pa: i64 = ra.ok.pid;
    val pb: i64 = rb.ok.pid;

    val w1: res[Reaped, Error] = wait_any();
    if (sel w1.err) { ret 1; }
    val r1: Reaped = w1.ok;
    if (!exited(r1.status) || code(r1.status) != 0) { ret 1; }

    val w2: res[Reaped, Error] = wait_any();
    if (sel w2.err) { ret 1; }
    val r2: Reaped = w2.ok;
    if (!exited(r2.status) || code(r2.status) != 0) { ret 1; }

    # both children reaped, each exactly once, in either order
    if (r1.child.pid == r2.child.pid) { ret 1; }
    if (r1.child.pid != pa && r1.child.pid != pb) { ret 1; }
    if (r2.child.pid != pa && r2.child.pid != pb) { ret 1; }
    ret 0;
}

test "std.process.exec.wait_any:errs_with_no_children" {
    val w: res[Reaped, Error] = wait_any();
    if (!sel w.err) { ret 1; }
    if (!sel w.err.native) { ret 2; }
    if (w.err.native.code != os.ECHILD || retained(w.err).pid != 0) { ret 3; }
    ret 0;
}

# run_shell starts the child in the requested directory: a relative path the
# child creates lands there and not in the parent's cwd. the chdir happens after
# the fork/clone, so the parent's own cwd is untouched - the check that would
# catch a CLONE_FS-style leak into the caller.
# build "<dir><sep><leaf>" into buf
fun join_scratch(buf: *u8, dir: str, leaf: str) {
    var n: usize = 0;
    var i: usize = 0;
    for (dir[i] != 0) { buf[n] = dir[i]; n = n + 1; i = i + 1; }
    buf[n] = os.separator; n = n + 1;
    i = 0;
    for (leaf[i] != 0) { buf[n] = leaf[i]; n = n + 1; i = i + 1; }
    buf[n] = 0;
}

test "std.process.exec.run_shell:child_starts_in_cwd" {
    var before: [4096]u8;
    if (os.getcwd(?before[0], 4096) < 0) { ret 1; }

    val dir: str = scratch_dir();
    val leaf: str = "std_exec_cwd_probe.tmp";
    # a marker left in the parent cwd by an earlier failure would mask the
    # negative half of this test, so clear both sites before spawning
    filesystem.remove_file(leaf);

    val r: res[ExitStatus, Error] = run_shell(probe_cmd(), dir, nil);
    if (!exited_zero(r)) { ret 1; }

    var joined: [4160]u8;
    join_scratch(?joined[0], dir, leaf);

    var bad: u8 = 0;
    if (!present((?joined[0])::str)) { bad = 1; }
    # the marker must not have landed in the parent's cwd
    or (present(leaf))               { bad = 1; }

    filesystem.remove_file((?joined[0])::str);

    # the parent's cwd must be exactly what it was
    var after: [4096]u8;
    if (os.getcwd(?after[0], 4096) < 0) { ret 1; }
    var i: usize = 0;
    for (before[i] != 0 || after[i] != 0) {
        if (before[i] != after[i]) { bad = 1; brk; }
        i = i + 1;
    }
    ret bad::i32;
}

# a command containing quotes survives intact. this is the shape the CRT argv
# convention corrupts on windows, where an embedded `"` is escaped to `\"` and
# cmd.exe takes those bytes literally - and it is how anyone writes a path that
# contains a space, so it is the common case rather than an exotic one.
test "std.process.exec.run_shell:quoted_command_survives" {
    val dir: str = scratch_dir();
    val seed: str = "std exec seed.txt";
    val out:  str = "std_exec_quoted_probe.tmp";

    var seed_path: [4160]u8;
    join_scratch(?seed_path[0], dir, seed);
    var out_path: [4160]u8;
    join_scratch(?out_path[0], dir, out);
    filesystem.remove_file((?seed_path[0])::str);
    filesystem.remove_file((?out_path[0])::str);

    val mk: res[ExitStatus, Error] = run_shell(seed_cmd(), dir, nil);
    if (sel mk.err) { ret 1; }
    if (!present((?seed_path[0])::str)) { ret 1; }

    val r: res[ExitStatus, Error] = run_shell(probe_quoted_cmd(), dir, nil);
    var bad: u8 = 0;
    if (!exited_zero(r))                            { bad = 1; }
    or (!present((?out_path[0])::str))              { bad = 1; }

    filesystem.remove_file((?seed_path[0])::str);
    filesystem.remove_file((?out_path[0])::str);
    ret bad::i32;
}

# resolve tests
#
# the search list is supplied directly rather than through PATH: there is no
# way to set an environment variable in-process, and a test that read the real
# PATH could only assert that some program somewhere resolved, which passes
# against an implementation that ignores order and against one that searches
# the current directory.

# a pathed name comes back unchanged AND unprobed. the name deliberately does
# not exist, so an implementation that stats before returning fails here.
test "std.process.exec.resolve_in:pathed_name_is_verbatim_and_unprobed" {
    var buf: [8192]u8;
    var fst: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 8192);

    var probe: [4160]u8;
    join_scratch(?probe[0], scratch_dir(), "std_exec_resolve_absent.tmp");
    val want: str = (?probe[0])::str;
    if (present(want)) { ret 1; }

    val r: res[str, Error] = resolve_in(?a, want, "");
    if (!resolved_to(r, want)) { ret 1; }
    ret 0;
}

# the FIRST matching entry wins. the same leaf exists in both directories, so
# an implementation that searches in the wrong order, or that returns any hit
# rather than the earliest, gets the other one and fails. running it in both
# orders is what makes that mutation detectable - a single order would pass
# against an implementation that always returned the last hit.
test "std.process.exec.resolve_in:first_entry_wins" {
    var buf: [16384]u8;
    var fst: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 16384);

    val leaf: str = "std_exec_resolve_dup.tmp";
    var da: [4160]u8;
    var db: [4160]u8;
    join_scratch(?da[0], scratch_dir(), "std_exec_resolve_a");
    join_scratch(?db[0], scratch_dir(), "std_exec_resolve_b");
    val dir_a: str = (?da[0])::str;
    val dir_b: str = (?db[0])::str;

    filesystem.create_dir(dir_a, 0o755);
    filesystem.create_dir(dir_b, 0o755);

    var fa: [4288]u8;
    var fb: [4288]u8;
    join_scratch(?fa[0], dir_a, leaf);
    join_scratch(?fb[0], dir_b, leaf);
    filesystem.write_bytes((?fa[0])::str, "a", 1, 0o644);
    filesystem.write_bytes((?fb[0])::str, "b", 1, 0o644);

    var bad: u8 = 0;

    val ab_r: res[str, Error] = resolve_in(?a, leaf, list_of(?a, dir_a, dir_b));
    if (!resolved_to(ab_r, (?fa[0])::str)) { bad = 1; }

    val ba_r: res[str, Error] = resolve_in(?a, leaf, list_of(?a, dir_b, dir_a));
    if (!resolved_to(ba_r, (?fb[0])::str)) { bad = 1; }

    filesystem.remove_file((?fa[0])::str);
    filesystem.remove_file((?fb[0])::str);
    filesystem.remove_dir(dir_a);
    filesystem.remove_dir(dir_b);
    ret bad::i32;
}

fun not_found(r: res[str, Error]) bool {
    if (!sel r.err) { ret false; }
    ret sel r.err.not_found;
}

# a program sitting in the CURRENT directory must not resolve. this is the
# whole reason the lookup is written rather than delegated to the OS: on
# windows CreateProcess with a NULL lpApplicationName searches the working
# directory ahead of System32, so a binary committed into a repository would
# be spawned in preference to the real tool.
#
# the empty entries are the shape that expresses "current directory" in a PATH
# on both posix and windows, so this also pins that they are skipped.
test "std.process.exec.resolve_in:current_directory_is_never_searched" {
    var buf: [8192]u8;
    var fst: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 8192);

    val leaf: str = "std_exec_resolve_cwd.tmp";
    filesystem.write_bytes(leaf, "x", 1, 0o644);

    var bad: u8 = 0;
    # a bare empty list, a leading empty entry, an interior one, a trailing one
    if (!not_found(resolve_in(?a, leaf, "")))       { bad = 1; }
    if (!not_found(resolve_in(?a, leaf, sep1(?a)))) { bad = 1; }
    if (!not_found(resolve_in(?a, leaf, sep2(?a)))) { bad = 1; }

    filesystem.remove_file(leaf);
    ret bad::i32;
}

# a name that is nowhere on the list is `not_found`, not a silent pass-through
# of the bare name. returning the name unresolved would hand execve something
# it cannot run and turn a clear lookup failure into a spawn failure.
test "std.process.exec.resolve_in:missing_name_errs" {
    var buf: [8192]u8;
    var fst: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 8192);

    val r: res[str, Error] = resolve_in(?a, "std_exec_no_such_program", scratch_dir());
    if (!not_found(r)) { ret 1; }
    ret 0;
}

# a directory the process may not search does not hide a program further
# along the list, and a name found nowhere past such a directory reports the
# refused query rather than `not_found`. the fixture is a mode-000 directory,
# which only refuses to a non-root caller on posix; when the probe shows the
# platform answers the query anyway, the fixture cannot exhibit either rule
# and the test passes vacuously
test "std.process.exec.resolve_in:unsearchable_entry_is_query_unless_a_later_entry_hits" {
    var buf: [16384]u8;
    var fst: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 16384);

    val leaf: str = "std_exec_resolve_denied.tmp";
    var dd: [4160]u8;
    var dr: [4160]u8;
    join_scratch(?dd[0], scratch_dir(), "std_exec_resolve_denied");
    join_scratch(?dr[0], scratch_dir(), "std_exec_resolve_readable");
    val denied: str = (?dd[0])::str;
    val readable: str = (?dr[0])::str;
    filesystem.create_dir(denied, 0o000);
    filesystem.create_dir(readable, 0o755);
    var fr: [4288]u8;
    join_scratch(?fr[0], readable, leaf);
    filesystem.write_bytes((?fr[0])::str, "r", 1, 0o644);
    fin {
        filesystem.remove_file((?fr[0])::str);
        filesystem.remove_dir(readable);
        filesystem.remove_dir(denied);
    }

    var fd: [4288]u8;
    join_scratch(?fd[0], denied, leaf);
    val probe: res[bool, io_error.Error] = filesystem.is_file((?fd[0])::str);
    if (!sel probe.err) { ret 0; }

    val alone: res[str, Error] = resolve_in(?a, leaf, denied);
    if (!sel alone.err) { ret 1; }
    if (!sel alone.err.query) { ret 2; }
    if (alone.err.query.code != probe.err.code) { ret 3; }

    val after: res[str, Error] = resolve_in(?a, leaf, list_of(?a, denied, readable));
    if (!resolved_to(after, (?fr[0])::str)) { ret 4; }
    ret 0;
}

test "std.process.exec.resolve_in:empty_name_errs" {
    var buf: [8192]u8;
    var fst: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 8192);

    val r: res[str, Error] = resolve_in(?a, "", scratch_dir());
    if (!sel r.err) { ret 1; }
    if (!sel r.err.empty_name) { ret 2; }
    ret 0;
}

use process_testing: std.allocator.testing;

# a refused copy is the allocator's error and leaves nothing behind, at the
# pathed-name copy and at the directory copy inside the walk alike
test "std.process.exec.resolve_in:refused_copies_are_alloc_and_leak_nothing" {
    var tracking: process_testing.Testing;
    val tracked: err[A.Error] = process_testing.make(?tracking);
    if (sel tracked.err) { ret 1; }
    fin { process_testing.dnit(?tracking); }

    var probe: [4160]u8;
    join_scratch(?probe[0], scratch_dir(), "std_exec_resolve_absent.tmp");
    process_testing.fail_at_ordinal(?tracking, process_testing.attempt_count(?tracking) + 1);
    val pathed: res[str, Error] = resolve_in(?tracking.a, (?probe[0])::str, "");
    if (!sel pathed.err) { ret 2; }
    if (!sel pathed.err.alloc) { ret 3; }
    if (tracking.live != 0) { ret 4; }

    # the walk copies each directory entry; the refusal of that copy is not a
    # skipped directory followed by `not_found`. the name carries an extension
    # so that on windows the PATHEXT read does not come first: the directory
    # copy is the first acquisition on every platform
    process_testing.fail_at_ordinal(?tracking, process_testing.attempt_count(?tracking) + 1);
    val walked: res[str, Error] = resolve_in(?tracking.a, "std_exec_no_such_program.tmp", scratch_dir());
    if (!sel walked.err) { ret 5; }
    if (!sel walked.err.alloc) { ret 6; }
    if (tracking.live != 0) { ret 7; }

    # a bare name on windows reads PATHEXT before anything else, so its first
    # acquisition is the environment value's copy and the refusal is `env`
    # carrying the allocator's refusal, not a search that found nothing
    $if ($mach.build.os == $mach.os.windows) {
        process_testing.fail_at_ordinal(?tracking, process_testing.attempt_count(?tracking) + 1);
        val bare: res[str, Error] = resolve_in(?tracking.a, "std_exec_no_such_program", scratch_dir());
        if (!sel bare.err) { ret 10; }
        if (!sel bare.err.env) { ret 11; }
        if (!sel bare.err.env.alloc) { ret 12; }
        if (tracking.live != 0) { ret 13; }
    }

    process_testing.clear_failure(?tracking);
    val searched: res[str, Error] = resolve_in(?tracking.a, "std_exec_no_such_program", scratch_dir());
    if (!not_found(searched)) { ret 8; }
    if (tracking.live != 0) { ret 9; }
    ret 0;
}

# `resolve` reads PATH and finds a real program. this is the only test that
# touches the environment, and it is deliberately weak: it asserts the wrapper
# reaches the search, and the search itself is pinned by the tests above.
test "std.process.exec.resolve:finds_a_real_program_on_path" {
    var a: A.Allocator;
    page.make(?a);

    val r: res[str, Error] = resolve(?a, known_program());
    if (sel r.err) { ret 1; }
    val resolved: str = r.ok;
    val exists: bool = present(resolved);
    A.deallocate[u8](?a, resolved, str_len(resolved) + 1);
    if (!exists) { ret 1; }
    ret 0;
}

# build a two-entry search list using the platform separator
fun list_of(a: *A.Allocator, first: str, second: str) str {
    var sep: str = ":";
    $if ($mach.build.os == $mach.os.windows) { sep = ";"; }
    val r: res[str, StrError] = str_join(a, first, sep, second);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

# a list that is a single empty entry, and one with a leading and a trailing
# empty entry around a directory that does not hold the leaf
fun sep1(a: *A.Allocator) str { ret list_of(a, "", ""); }
fun sep2(a: *A.Allocator) str { ret list_of(a, "", scratch_dir()); }


# a command that runs long enough to still be alive when the deadline fires,
# spelled for whichever shell the platform has
fun long_running_argv() [4]usize {
    $if ($mach.build.os == $mach.os.windows) {
        ret make_shell_argv("ping -n 30 127.0.0.1 >NUL");
    }
    $or {
        var buf: [4]usize;
        buf[0] = ("/bin/sh")::usize;
        buf[1] = ("-c")::usize;
        buf[2] = ("sleep 30")::usize;
        buf[3] = 0;
        ret buf;
    }
}

fun long_running_path() str {
    $if ($mach.build.os == $mach.os.windows) { ret shell_path(); }
    $or { ret "/bin/sh"; }
}

fun exit_seven_argv() [4]usize {
    $if ($mach.build.os == $mach.os.windows) {
        ret make_shell_argv("exit 7");
    }
    $or {
        var buf: [4]usize;
        buf[0] = ("/bin/sh")::usize;
        buf[1] = ("-c")::usize;
        buf[2] = ("exit 7")::usize;
        buf[3] = 0;
        ret buf;
    }
}

# try_wait must not block on a live child, and must report the same termination
# wait would once the child is gone
test "std.process.exec.try_wait:absent_while_running_then_present" {
    var argv: [4]usize = long_running_argv();
    val sr: res[Child, Error] = spawn(long_running_path(), (?argv[0])::**u8, nil);
    if (sel sr.err) { ret 1; }
    val child: Child = sr.ok;

    # the child is still running, so the answer is absent rather than a block
    val first: res[opt[ExitStatus], Error] = try_wait(child);
    if (sel first.err) { terminate_child(child); wait(child); ret 2; }
    if (!still_running(first)) { terminate_child(child); wait(child); ret 3; }

    terminate_child(child);
    var seen: bool = false;
    var spins: i32 = 0;
    for (spins < 500 && !seen) {
        val probe: res[opt[ExitStatus], Error] = try_wait(child);
        if (sel probe.err) { ret 4; }
        if (sel probe.ok.some) { seen = true; }
        or { os.sleep(2000000); }
        spins = spins + 1;
    }
    if (!seen) { ret 5; }
    ret 0;
}

# a child that finishes inside its deadline is reported as its own outcome, not
# as a termination
test "std.process.exec.wait_within:a_child_that_finishes_first_is_not_terminated" {
    var scope: cancel.Scope;
    val deadline: tm.Time = tm.time_add(tm.monotonic(), 30000 * duration.MILLISECOND);
    if (!cancel.make_root(?scope, true, deadline)) { ret 1; }

    var argv: [4]usize = exit_seven_argv();
    val sr: res[Child, Error] =
        spawn_redirected_in_grouped(long_running_path(), (?argv[0])::**u8, nil, "", -1, -1, -1);
    if (sel sr.err) { cancel.destroy(?scope); ret 2; }
    val child: Child = sr.ok;

    val wr: res[Supervised, Error] = wait_within(child, ?scope);
    cancel.destroy(?scope);
    if (sel wr.err) { ret 3; }
    val sup: Supervised = wr.ok;

    if (sup.terminated) { ret 4; }
    if (sup.reason != cancel.ACTIVE) { ret 5; }
    if (!exited(sup.status) || code(sup.status) != 7) { ret 6; }
    ret 0;
}

# the deadline is what makes a scope mean anything for a process: a child that
# outlives it is terminated, is still reaped rather than left a zombie, and on
# a grouped spawn takes its grandchildren with it
test "std.process.exec.wait_within:an_expired_deadline_terminates_and_reaps" {
    var scope: cancel.Scope;
    val deadline: tm.Time = tm.time_add(tm.monotonic(), 50 * duration.MILLISECOND);
    if (!cancel.make_root(?scope, true, deadline)) { ret 1; }

    var argv: [4]usize = long_running_argv();
    val sr: res[Child, Error] =
        spawn_redirected_in_grouped(long_running_path(), (?argv[0])::**u8, nil, "", -1, -1, -1);
    if (sel sr.err) { cancel.destroy(?scope); ret 2; }
    val child: Child = sr.ok;
    if (child.pgid == 0) { cancel.destroy(?scope); terminate_child(child); wait(child); ret 3; }

    # the child would run for 30 seconds; the deadline is 50ms, so returning at
    # all is the first half of the claim
    val wr: res[Supervised, Error] = wait_within(child, ?scope);
    cancel.destroy(?scope);
    if (sel wr.err) { ret 4; }
    val sup: Supervised = wr.ok;
    if (!sup.terminated) { ret 5; }
    if (sup.reason != cancel.TIMED_OUT) { ret 6; }

    # and it was reaped on the way out, so a second wait finds nothing rather
    # than a zombie
    var wstatus: os.ProcessStatus;
    val consumed: os.WaitResult = os.wait_pid(child.pid, ?wstatus, os.WNOHANG);
    if (consumed.pid != 0 || consumed.error.code != os.ECHILD) { ret 7; }
    ret 0;
}

# the grandchild half of the same claim: a shell that backgrounds another
# process and then blocks is not individually reachable, so only terminating
# the GROUP on expiry reaches the process the deadline was really about
test "std.process.exec.wait_within:an_expired_deadline_reaches_a_grandchild" {
    $if ($mach.build.os == $mach.os.windows) {
        # cmd.exe has no `&` backgrounding with a `$!`-style way to recover the
        # new pid, so the windows leg is covered by the group test above
        ret 0;
    }
    $or {
        var out_buf: [32]u8;
        var fds: [2]i32;
        if (os.pipe(?fds[0]) < 0) { ret 1; }

        var argv: [4]usize;
        argv[0] = ("/bin/sh")::usize;
        argv[1] = ("-c")::usize;
        argv[2] = ("sleep 30 & echo $!; wait")::usize;
        argv[3] = 0;

        val sr: res[Child, Error] =
            spawn_redirected_in_grouped("/bin/sh", (?argv[0])::**u8, nil, "", -1, fds[1], -1);
        if (sel sr.err) { os.close(fds[0]); os.close(fds[1]); ret 2; }
        os.close(fds[1]);
        val shell: Child = sr.ok;
        if (shell.pgid == 0) { os.close(fds[0]); terminate_child(shell); wait(shell); ret 3; }

        val n: i64 = os.read(fds[0], ?out_buf[0], 32);
        os.close(fds[0]);
        if (n <= 0) { terminate_group(shell); wait(shell); ret 4; }
        var grandchild: i64 = 0;
        var i: usize = 0;
        for (i < n::usize) {
            val c: u8 = out_buf[i];
            if (c >= '0'::u8 && c <= '9'::u8) { grandchild = grandchild * 10 + (c - '0'::u8)::i64; }
            i = i + 1;
        }
        if (grandchild <= 0) { terminate_group(shell); wait(shell); ret 5; }

        var scope: cancel.Scope;
        val deadline: tm.Time = tm.time_add(tm.monotonic(), 50 * duration.MILLISECOND);
        if (!cancel.make_root(?scope, true, deadline)) { terminate_group(shell); wait(shell); ret 6; }

        val wr: res[Supervised, Error] = wait_within(shell, ?scope);
        cancel.destroy(?scope);
        if (sel wr.err) { ret 7; }
        val sup: Supervised = wr.ok;
        if (!sup.terminated || sup.reason != cancel.TIMED_OUT) { ret 8; }

        # the grandchild was never our own child, so its disappearance is proof
        # the whole group was signalled and not just the process we waited on
        var gone: bool = false;
        var spins: i32 = 0;
        for (spins < 500 && !gone) {
            $if ($mach.build.os == $mach.os.linux) {
                if (linux.getpgid(grandchild) < 0) { gone = true; }
            }
            $or ($mach.build.os == $mach.os.darwin) {
                if (darwin.getpgid(grandchild) < 0) { gone = true; }
            }
            if (!gone) { os.sleep(2000000); }
            spins = spins + 1;
        }
        if (!gone) { ret 9; }
        ret 0;
    }
}

# a nil scope is invalid use that still names the child, which stays the
# caller's to wait for
test "std.process.exec.wait_within:nil_scope_keeps_the_child" {
    var argv: [4]usize = argv_ok();
    val sr: res[Child, Error] = spawn(prog_ok(), (?argv[0])::**u8, nil);
    if (sel sr.err) { ret 1; }
    val child: Child = sr.ok;
    val wr: res[Supervised, Error] = wait_within(child, nil);
    val reaped: res[ExitStatus, Error] = wait(child);
    if (!sel wr.err) { ret 2; }
    if (!sel wr.err.native) { ret 3; }
    if (wr.err.native.code != os.EINVAL || retained(wr.err).pid != child.pid) { ret 4; }
    if (!exited_zero(reaped)) { ret 5; }
    ret 0;
}

test "std.process.exec.output: failed wait releases capture and retains child ownership" {
    var tracking: process_testing.Testing;
    val tracked: err[A.Error] = process_testing.make(?tracking);
    if (sel tracked.err) { ret 1; }
    fin { process_testing.dnit(?tracking); }
    var bytes: Vector[u8] = vector.init[u8](?tracking.a);
    val pushed: res[usize, A.Error] = vector.push[u8](?bytes, 42);
    if (sel pushed.err) { ret 2; }
    if (tracking.live != 1) { ret 3; }
    val cause: Error = Error.native{Failure{code: os.EACCES, native_code: 5, operation: os.PROCESS_OP_STATUS,
        child: Child{pid: 123, pgid: 123}}};
    val failed: res[Output, Error] = finish_output(
        res[Vector[u8], ReadError].ok{bytes}, res[ExitStatus, Error].err{cause});
    if (!sel failed.err) { ret 4; }
    if (!sel failed.err.native) { ret 5; }
    val error: Failure = failed.err.native;
    if (error.code != os.EACCES || error.native_code != 5 || error.operation != os.PROCESS_OP_STATUS
        || error.child.pid != 123 || error.child.pgid != 123) { ret 6; }
    if (tracking.live != 0 || tracking.double_frees != 0) { ret 7; }

    # a failed drain is primary; the wait's failure and its child ride beside it
    val both: res[Output, Error] = finish_output(
        res[Vector[u8], ReadError].err{ReadError.eof{3}}, res[ExitStatus, Error].err{cause});
    if (!sel both.err) { ret 8; }
    if (!sel both.err.output) { ret 9; }
    val primary: OutputFailure = both.err.output;
    if (!sel primary.read.eof) { ret 10; }
    if (primary.read.eof != 3 || primary.child.pid != 123 || retained(both.err).pid != 123) { ret 11; }
    if (!sel primary.wait.some) { ret 12; }
    if (primary.wait.some.code != os.EACCES || primary.wait.some.native_code != 5
        || primary.wait.some.operation != os.PROCESS_OP_STATUS) { ret 13; }

    # a failed drain after a good wait retains no child and no wait failure
    val drained: res[Output, Error] = finish_output(
        res[Vector[u8], ReadError].err{ReadError.eof{0}}, res[ExitStatus, Error].ok{ExitStatus{kind: PROCESS_EXITED}});
    if (!sel drained.err) { ret 14; }
    if (!sel drained.err.output) { ret 15; }
    if (retained(drained.err).pid != 0) { ret 16; }
    if (!sel drained.err.output.wait.none) { ret 17; }
    ret 0;
}
