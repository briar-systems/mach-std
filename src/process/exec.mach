# process spawning and management

use std.allocator.fixed;
use std.collections.vector;
use std.collections.vector.Vector;
use std.runtime.native.view.Unit;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.isize;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.StrError;
use std.types.string.owned_dnit;
use std.types.string.str;
use std.types.string.str_contains_char;
use std.types.string.str_copy;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;

use std.types.path;

use io_error:  std.io.error;
use io_handle: std.io.handle;
use m_reader:  std.io.reader;
use std.io.reader.ReadError;

use std.chrono.duration;
use tm: std.chrono.time;
use std.system.capability;

$if (capability.HAS_CLOCK && capability.HAS_FILES && capability.HAS_PROCESS && capability.HAS_THREADS) {
    use std.allocator.page;
    use process_testing: std.allocator.testing;
    use std.filesystem;
    use std.process.env;
    use std.sync.cancel;
    use std.system.os;
}
$or {
    $error("std.process.exec needs the clock, files, process and threads capabilities (std.system.capability.HAS_CLOCK, HAS_FILES, HAS_PROCESS, HAS_THREADS)");
}

# a grouped spawn and the group functions below give every target the same
# signature; the underlying primitive is platform-specific (posix
# setpgid/kill(-pgid) vs a tracked windows job object), so the actual
# implementation is per-platform in each function body.
$if ($mach.build.sys == $mach.sys.linux) {
    use std.system.os.linux;
}
$or ($mach.build.sys == $mach.sys.darwin) {
    use std.system.os.darwin;
}
$or ($mach.build.sys == $mach.sys.windows) {
    use std.system.os.windows;
}

fwd ExitStatus: os.ProcessStatus;
fwd os.PROCESS_EXITED;
fwd os.PROCESS_SIGNALED;
fwd os.PROCESS_STOPPED;
fwd os.PROCESS_CONTINUED;

# the environment a spawn hands its child, given or inherited
#
# Environment.inherit{} is the one way to pass this process's environment on.
# the child gets it in native units with no conversion: CreateProcessW's NULL
# environment on windows, the envp the kernel gave this process on linux and
# darwin, so a variable with no UTF-8 spelling reaches the child as it is.
# Environment.given{envp} hands the child exactly the NAME=value entries of a
# nil-terminated array, and a nil array is refused with an INVALID error.
# NativeEnvironment is the native spawns' form, its entries in
# std.runtime.native units
fwd os.Environment;
fwd os.NativeEnvironment;

# handle to a spawned child process
# ---
# pid:  process id of the child
# pgid: 0 if the child was not placed in its own group (see
#       SpawnOptions.grouped); otherwise the group token needed to signal
#       the whole group - on linux/darwin this is the posix process group id
#       (pgid == pid, since the child is its own group's leader); on windows
#       it is a tracked group token backed by the retained child process
pub rec Child {
    pid:  i64;
    pgid: i64;
}

# a failed process operation
# ---
# kind:        the portable classification
# code:        the native code behind the failure, zero when the refusal is this
#              module's own
# native_code: the exact windows GetLastError; zero on posix
# operation:   the os.PROCESS_OP_* stage that failed
# child:       the unreaped child transferred to the caller, pid zero for none
pub rec Failure {
    kind:        io_error.Kind;
    code:        i64;
    native_code: u32;
    operation:   u8;
    child:       Child;
}

# the drain of a captured child's output failed
# ---
# read:  the reader's failure, with the bytes delivered before it
# child: the unreaped child transferred to the caller when the wait that
#        followed the drain failed too, pid zero when the wait reaped it
# wait:  that wait's native failure, absent when the wait succeeded
pub rec OutputFailure {
    read:  ReadError;
    child: Child;
    wait:  opt[os.ProcessWaitError];
}

# why a process operation failed
# ---
# native:      a spawn, pipe, wait, status query, close or termination refused
#              by the platform; the child it retains is the caller's to wait
#              for again, or to terminate first, before releasing ownership
# output:      the capture drain failed (the wait's outcome is inside)
# alloc:       an owned path copy was refused
# env:         the PATH read failed
# empty_name:  the program name is empty
# unset:       PATH is not set
# not_found:   the name is on no directory of the search list
# ungrouped:   the child was not spawned into a group, so no group can be signalled
# unsupported: process groups do not exist on this platform
# query:       the name was found nowhere, and at least one candidate could not
#              be examined (the last such failure); the search continues past
#              a refused query the way execvp does, so a hit still wins
pub tag Error: u8 {
    native: Failure;
    output: OutputFailure;
    alloc:  A.Error;
    env:    env.EnvError;
    empty_name;
    unset;
    not_found;
    ungrouped;
    unsupported;
    query: io_error.Error;
}

# the child an error still owns: pid zero when none was retained. do not
# discard an error while it owns a child; wait for it or terminate it first
pub fun retained(error: Error) Child {
    if (sel error.native) { ret error.native.child; }
    if (sel error.output) { ret error.output.child; }
    ret Child{};
}

# a rendering of the error for diagnostics
pub fun error_message(error: Error) str {
    if (sel error.native) {
        if (error.native.code < 0) { ret os.error_message(error.native.code); }
        ret io_error.kind_name(error.native.kind);
    }
    if (sel error.output) {
        if (sel error.output.read.native)      { ret os.message(error.output.read.native.error); }
        if (sel error.output.read.alloc)       { ret "out of memory"; }
        if (sel error.output.read.would_block) { ret "would block"; }
        ret "end of file";
    }
    if (sel error.alloc)      { ret "out of memory"; }
    if (sel error.env)        { ret "environment read failed"; }
    if (sel error.empty_name) { ret "empty program name"; }
    if (sel error.unset)      { ret "PATH unset"; }
    if (sel error.not_found)  { ret "not found on PATH"; }
    if (sel error.ungrouped)  { ret "child is not in a process group"; }
    if (sel error.query)      { ret os.message(error.query); }
    ret "process groups are not supported on this platform";
}

fun process_error(code: i64, operation: u8) Error {
    ret Error.native{Failure{kind: os.error_kind(code), code: code, operation: operation}};
}

fun refusal(kind: io_error.Kind, operation: u8) Error {
    ret Error.native{Failure{kind: kind, operation: operation}};
}

fun wait_error(error: os.ProcessWaitError, child: Child) Error {
    var pending: Child         = Child{};
    val kind:    io_error.Kind = os.error_kind(error.code);
    if (child.pid > 0 && kind != io_error.NO_CHILD) { pending = child; }
    ret Error.native{Failure{kind: kind, code: error.code, native_code: error.native_code, operation: error.operation, child: pending}};
}

# a child reaped by wait_any
# ---
# child:  the reaped child's handle
# status: its exit status
pub rec Reaped {
    child:  Child;
    status: ExitStatus;
}

# result of running a child process and collecting its stdout
# ---
# status: exit status of the child process
# bytes:  the child's complete stdout, owned by the caller's allocator
pub rec Output {
    status: ExitStatus;
    bytes:  Vector[u8];
}

# spawn a process and wait for it to exit
# ---
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     the child's environment, given entries or inherited
# ret:      exit status, or an error retaining an unreaped child
pub fun run(pathname: str, argv: **u8, envp: os.Environment) res[ExitStatus, Error] {
    val res_child: res[Child, Error] = spawn(pathname, argv, envp);
    if (sel res_child.err) { ret res[ExitStatus, Error].err{res_child.err}; }
    ret wait(res_child.ok);
}

# spawn a process from native units and wait for it to exit (see spawn_native)
# ---
# ret: exit status, or an error retaining an unreaped child
pub fun run_native(pathname: *Unit, argv: **Unit, envp: os.NativeEnvironment) res[ExitStatus, Error] {
    val res_child: res[Child, Error] = spawn_native(pathname, argv, envp);
    if (sel res_child.err) { ret res[ExitStatus, Error].err{res_child.err}; }
    ret wait(res_child.ok);
}

# run a command through the host command interpreter, from `cwd`
#
# The interpreter and its command-line conventions are the platform's, not the
# caller's: posix hands `sh -c <command>` straight to execve, while windows
# resolves %ComSpec% and emits `"<comspec>" /s /c "<command verbatim>"`. That
# split matters because a command line's encoding is a property of the program
# being spawned - the CRT argv convention every other spawn here uses is not
# what cmd.exe parses, so a caller assembling its own shell invocation would
# have to know which convention applies and would get it wrong.
#
# `cwd` is applied in the child, so the caller's own working directory is
# untouched and the directory never enters the command line.
# ---
# command: the command line to run
# cwd:     working directory for the child, or nil to inherit
# envp:    the child's environment, given entries or inherited
# ret:     exit status, or an error retaining an unreaped child
pub fun run_shell(command: str, cwd: str, envp: os.Environment) res[ExitStatus, Error] {
    val res_child: res[Child, Error] = spawn_shell(command, cwd, envp);
    if (sel res_child.err) { ret res[ExitStatus, Error].err{res_child.err}; }
    ret wait(res_child.ok);
}

# start a command through the host command interpreter, from `cwd`
#
# the same interpreter and conventions as run_shell, without waiting
# ---
# command: the command line to run
# cwd:     working directory for the child, or nil to inherit
# envp:    the child's environment, given entries or inherited
# ret:     the running child, or the refusal
pub fun spawn_shell(command: str, cwd: str, envp: os.Environment) res[Child, Error] {
    if (command == nil) { ret res[Child, Error].err{refusal(io_error.INVALID, os.PROCESS_OP_SPAWN)}; }
    ret shell_spawn(command, cwd, envp);
}

# the longest native command line a shell spawn builds
val SHELL_LINE_CAPACITY: usize = 98304;

# cmd.exe's line for a verbatim command: `"<shell>" /s /c "<command>"`. /s makes
# cmd strip exactly the first and last quote of the remainder and keep
# everything between as written, so the command needs no escaping. the CRT
# convention the argv spawns use would escape an embedded quote as `\"`, which
# cmd does not honour
# ---
# ret: false when the line does not fit in cap bytes with its terminator
fun cmd_shell_line(shell: str, command: str, line: *u8, cap: usize) bool {
    var off: usize = 0;
    if (!line_put(line, cap, ?off, '"'::u8))          { ret false; }
    if (!line_append(line, cap, ?off, shell))         { ret false; }
    if (!line_append(line, cap, ?off, "\" /s /c \"")) { ret false; }
    if (!line_append(line, cap, ?off, command))       { ret false; }
    if (!line_put(line, cap, ?off, '"'::u8))          { ret false; }
    line[off] = 0;
    ret true;
}

fun line_put(line: *u8, cap: usize, off: *usize, byte: u8) bool {
    if (@off + 1 >= cap) { ret false; }
    line[@off] = byte;
    @off       = @off + 1;
    ret true;
}

fun line_append(line: *u8, cap: usize, off: *usize, text: str) bool {
    var i: usize = 0;
    for (text[i] != 0) {
        if (!line_put(line, cap, off, text[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the host interpreter, one row per OS
$if ($mach.build.sys == $mach.sys.windows) {
    val SHELL_FALLBACK: str   = "C:\\Windows\\System32\\cmd.exe";
    val SHELL_CAPACITY: usize = 512;

    # %ComSpec% names the interpreter, and the canonical path is the fallback
    # when it is unset. this is deliberately not a PATH search: the
    # interpreter's location is known, and PATH may name directories an
    # untrusted project controls
    fun host_shell(buf: *u8) bool {
        val n: i64 = os.getenv("ComSpec", buf, SHELL_CAPACITY);
        if (n > 0 && n::usize < SHELL_CAPACITY) { ret true; }
        var off: usize = 0;
        if (!line_append(buf, SHELL_CAPACITY, ?off, SHELL_FALLBACK)) { ret false; }
        buf[off] = 0;
        ret true;
    }

    # the application is the resolved interpreter, so no PATH or
    # current-directory search happens either
    fun shell_spawn(command: str, cwd: str, envp: os.Environment) res[Child, Error] {
        var shell: [512]u8;
        if (!host_shell(?shell[0])) { ret res[Child, Error].err{refusal(io_error.NAME_TOO_LONG, os.PROCESS_OP_SPAWN)}; }
        var line: [98304]u8;
        if (!cmd_shell_line((?shell[0])::str, command, ?line[0], SHELL_LINE_CAPACITY)) {
            ret res[Child, Error].err{refusal(io_error.RESOURCE_EXHAUSTED, os.PROCESS_OP_SPAWN)};
        }
        ret spawned(windows.spawn_command_line(?shell[0], ?line[0], envp, cwd), 0);
    }
}
$or {
    val SHELL_PATH: str = "/bin/sh";

    # posix hands argv straight to execve, so the command is one argument and
    # there is no command-line encoding to get wrong
    fun shell_spawn(command: str, cwd: str, envp: os.Environment) res[Child, Error] {
        var argv: [4]*u8;
        argv[0] = SHELL_PATH;
        argv[1] = "-c";
        argv[2] = command;
        argv[3] = nil;
        var options: SpawnOptions = spawn_options();
        options.cwd = cwd;
        ret spawn_with_options(SHELL_PATH, ?argv[0], envp, options);
    }
}

test cmd_shell_line__keeps_the_command_verbatim {
    var line: [64]u8;
    if (!cmd_shell_line("C:\\cmd.exe", "echo \"a b\" & exit 3", ?line[0], 64))           { ret 1; }
    if (!str_equals((?line[0])::str, "\"C:\\cmd.exe\" /s /c \"echo \"a b\" & exit 3\"")) { ret 2; }
    var small: [8]u8;
    if (cmd_shell_line("C:\\cmd.exe", "x", ?small[0], 8)) { ret 3; }
    var exact: [12]u8;
    if (!cmd_shell_line("", "", ?exact[0], 12))           { ret 4; }
    if (!str_equals((?exact[0])::str, "\"\" /s /c \"\"")) { ret 5; }
    if (cmd_shell_line("", "", ?exact[0], 11))            { ret 6; }
    ret 0;
}

# run a process and collect its complete standard output
#
# spawns the child with stdout bound to a pipe and drains it to end-of-file
# through io.read_all over the pipe's read end, so output of any length is
# captured and the child never blocks on a full pipe. a wait is attempted even
# when the drain fails, and a failed wait returns the remaining child owner.
# ---
# a:        allocator for the captured output
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     the child's environment, given entries or inherited
# ret:      the exit status and captured stdout, or an error
pub fun output(a: *A.Allocator, pathname: str, argv: **u8, envp: os.Environment) res[Output, Error] {
    var fds:   [2]usize;
    val piped: i64 = os.pipe(?fds[0], ?fds[1]);
    if (piped < 0) { ret res[Output, Error].err{process_error(piped, os.PROCESS_OP_PIPE)}; }
    var options: SpawnOptions = spawn_options();
    options.stdout = fds[1];
    ret captured(a, spawn_with_options(pathname, argv, envp, options), fds);
}

# run a process from native units and collect its stdout, as output does (see
# spawn_native)
# ---
# ret: the exit status and captured stdout, or an error
pub fun output_native(a: *A.Allocator, pathname: *Unit, argv: **Unit, envp: os.NativeEnvironment) res[Output, Error] {
    var fds:   [2]usize;
    val piped: i64 = os.pipe(?fds[0], ?fds[1]);
    if (piped < 0) { ret res[Output, Error].err{process_error(piped, os.PROCESS_OP_PIPE)}; }
    var options: NativeSpawnOptions = native_spawn_options();
    options.stdout = fds[1];
    ret captured(a, spawn_native_with_options(pathname, argv, envp, options), fds);
}

# drain a child spawned onto the write end of fds, then wait for it
fun captured(a: *A.Allocator, child: res[Child, Error], fds: [2]usize) res[Output, Error] {
    if (sel child.err) {
        os.close(fds[0]);
        os.close(fds[1]);
        ret res[Output, Error].err{child.err};
    }

    # the parent never writes; closing its write end lets the drain see EOF
    # once the child's stdout closes
    os.close(fds[1]);

    val pipe_file: filesystem.File            = filesystem.File{handle: io_handle.FileHandle{value: fds[0]}};
    var rd:        m_reader.Reader            = filesystem.reader(pipe_file);
    val res_bytes: res[Vector[u8], ReadError] = m_reader.read_all(a, ?rd);
    os.close(fds[0]);

    val res_waited: res[ExitStatus, Error] = wait(child.ok);
    ret finish_output(res_bytes, res_waited);
}

# combine the drain and the wait: a failed drain is primary and carries the
# wait's outcome beside it; a failed wait after a good drain releases the
# capture and passes the wait's error, with its retained child, through
fun finish_output(bytes_r: res[Vector[u8], ReadError], waited: res[ExitStatus, Error]) res[Output, Error] {
    if (sel bytes_r.err) {
        var failure: OutputFailure = OutputFailure{read: bytes_r.err, wait: opt[os.ProcessWaitError].none{}};
        if (sel waited.err) {
            val secondary: Child = retained(waited.err);
            failure.child = secondary;
            if (sel waited.err.native) {
                val cause: Failure = waited.err.native;
                failure.wait = opt[os.ProcessWaitError].some{os.ProcessWaitError{
                    code: cause.code, native_code: cause.native_code, operation: cause.operation
                }};
            }
        }
        ret res[Output, Error].err{Error.output{failure}};
    }
    var bytes: Vector[u8] = bytes_r.ok;
    if (sel waited.err) {
        vector.dnit[u8](?bytes);
        ret res[Output, Error].err{waited.err};
    }
    ret res[Output, Error].ok{Output{status: waited.ok, bytes: bytes}};
}

fun spawned(pid: i64, pgid: i64) res[Child, Error] {
    if (pid < 0) { ret res[Child, Error].err{process_error(pid, os.PROCESS_OP_SPAWN)}; }
    ret res[Child, Error].ok{Child{pid: pid, pgid: pgid}};
}

# how spawn_with_options starts a child, spawn_options giving the defaults
#
# the working directory is applied in the child after the fork and before the
# exec, so this process's own directory is never disturbed and two spawns into
# different directories cannot race. the parent keeps ownership of every
# redirected handle: close it after the child exits, or right after the spawn
# to let a pipe's read end see end-of-file.
#
# a grouped child leads a new process group (a job object on windows), so
# terminate_group later reaches the whole tree at once. a caller whose child
# may spawn children of its own, such as a shell running a compiler, wants
# this: terminate_child would leave the grandchildren orphaned and running.
# ---
# cwd:     directory to run in, or empty to inherit this process's
# stdin:   handle for the child's stdin, or os.INVALID_HANDLE to inherit
# stdout:  handle for the child's stdout, or os.INVALID_HANDLE to inherit
# stderr:  handle for the child's stderr, or os.INVALID_HANDLE to inherit
# grouped: place the child as the leader of its own new process group
pub rec SpawnOptions {
    cwd:     str;
    stdin:   usize;
    stdout:  usize;
    stderr:  usize;
    grouped: bool;
}

# the options of a plain spawn: this process's directory, every stream
# inherited, and this process's group
pub fun spawn_options() SpawnOptions {
    ret SpawnOptions{
        cwd:     "",
        stdin:   os.INVALID_HANDLE,
        stdout:  os.INVALID_HANDLE,
        stderr:  os.INVALID_HANDLE,
        grouped: false,
    };
}

# start a process without waiting, as `options` describes
#
# every spawn of this module is this one with some options set.
# ---
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     the child's environment, given entries or inherited
# options:  directory, stream redirections and grouping (see SpawnOptions)
# ret:      child handle, whose pgid names the group when grouped, or the
#           spawn failure
pub fun spawn_with_options(pathname: str, argv: **u8, envp: os.Environment, options: SpawnOptions) res[Child, Error] {
    val cwd: *u8 = cwd_or_inherit(options.cwd);
    if (!options.grouped) {
        ret spawned(os.spawn_redirected_in(pathname, argv, envp, cwd, options.stdin, options.stdout, options.stderr), 0);
    }
    val stdin_fd:  i32 = native_fd(options.stdin);
    val stdout_fd: i32 = native_fd(options.stdout);
    val stderr_fd: i32 = native_fd(options.stderr);
    $if ($mach.build.sys == $mach.sys.linux) {
        val pid: i64 = linux.spawn_redirected_in_grouped(pathname, argv, envp, cwd, stdin_fd, stdout_fd, stderr_fd);
        ret spawned(pid, pid);
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        val pid: i64 = darwin.spawn_redirected_in_grouped(pathname, argv, envp, cwd, stdin_fd, stdout_fd, stderr_fd);
        ret spawned(pid, pid);
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        var job: isize = 0;
        val pid: i64   = windows.spawn_redirected_in_grouped(pathname, argv, envp, cwd, stdin_fd, stdout_fd, stderr_fd, ?job);
        ret spawned(pid, job::i64);
    }
    $or {
        ret res[Child, Error].err{Error.unsupported{}};
    }
}

# how spawn_native_with_options starts a child: SpawnOptions with the working
# directory in native units
# ---
# cwd:     nul-terminated directory to run in, or nil or empty to inherit
# stdin:   handle for the child's stdin, or os.INVALID_HANDLE to inherit
# stdout:  handle for the child's stdout, or os.INVALID_HANDLE to inherit
# stderr:  handle for the child's stderr, or os.INVALID_HANDLE to inherit
# grouped: place the child as the leader of its own new process group
pub rec NativeSpawnOptions {
    cwd:     *Unit;
    stdin:   usize;
    stdout:  usize;
    stderr:  usize;
    grouped: bool;
}

# the native options of a plain spawn, as spawn_options gives them
pub fun native_spawn_options() NativeSpawnOptions {
    ret NativeSpawnOptions{
        cwd:     nil,
        stdin:   os.INVALID_HANDLE,
        stdout:  os.INVALID_HANDLE,
        stderr:  os.INVALID_HANDLE,
        grouped: false,
    };
}

# start a process without waiting, from an executable, arguments, environment
# and working directory in std.runtime.native units, as `options` describes
#
# the units reach the kernel unchanged: bytes on linux and darwin, valid UTF-8
# or not, and UTF-16 on windows, where an unpaired surrogate launches, starts
# in or reaches the child as given. an argument read from std.runtime.native
# passes to a child exactly. spawn_with_options is this call for UTF-8, and on
# windows it converts each string once and runs this
# ---
# pathname: nul-terminated path to executable
# argv:     null-terminated array of nul-terminated arguments
# envp:     the child's environment, given native entries or inherited
# options:  directory, stream redirections and grouping
# ret:      child handle, whose pgid names the group when grouped, or the
#           spawn failure
pub fun spawn_native_with_options(pathname: *Unit, argv: **Unit, envp: os.NativeEnvironment, options: NativeSpawnOptions) res[Child, Error] {
    var cwd: *Unit = options.cwd;
    if (cwd != nil && cwd[0] == 0) { cwd = nil; }
    if (!options.grouped) {
        ret spawned(os.spawn_redirected_in_native(pathname, argv, envp, cwd, options.stdin, options.stdout, options.stderr), 0);
    }
    val stdin_fd:  i32 = native_fd(options.stdin);
    val stdout_fd: i32 = native_fd(options.stdout);
    val stderr_fd: i32 = native_fd(options.stderr);
    $if ($mach.build.sys == $mach.sys.linux) {
        val pid: i64 = linux.spawn_redirected_in_grouped_native(pathname, argv, envp, cwd, stdin_fd, stdout_fd, stderr_fd);
        ret spawned(pid, pid);
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        val pid: i64 = darwin.spawn_redirected_in_grouped_native(pathname, argv, envp, cwd, stdin_fd, stdout_fd, stderr_fd);
        ret spawned(pid, pid);
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        var job: isize = 0;
        val pid: i64   = windows.spawn_redirected_in_grouped_native(pathname, argv, envp, cwd, stdin_fd, stdout_fd, stderr_fd, ?job);
        ret spawned(pid, job::i64);
    }
    $or {
        ret res[Child, Error].err{Error.unsupported{}};
    }
}

# start a process from native units without waiting (see
# spawn_native_with_options)
# ---
# ret: child handle, or the spawn failure
pub fun spawn_native(pathname: *Unit, argv: **Unit, envp: os.NativeEnvironment) res[Child, Error] {
    ret spawn_native_with_options(pathname, argv, envp, native_spawn_options());
}

# start a process without waiting
# ---
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     the child's environment, given entries or inherited
# ret:      child handle, or the spawn failure
pub fun spawn(pathname: str, argv: **u8, envp: os.Environment) res[Child, Error] {
    ret spawn_with_options(pathname, argv, envp, spawn_options());
}

# start a process without waiting, with its stdout and/or stderr bound to
# caller-supplied descriptors, stdin inherited (see SpawnOptions)
# ---
# pathname:  path to executable
# argv:      null-terminated argument array
# envp:      the child's environment, given entries or inherited
# stdout_fd: handle for the child's stdout, or os.INVALID_HANDLE to inherit
# stderr_fd: handle for the child's stderr, or os.INVALID_HANDLE to inherit
# ret:       child handle, or the spawn failure
pub fun spawn_redirected(pathname: str, argv: **u8, envp: os.Environment, stdout_fd: usize, stderr_fd: usize) res[Child, Error] {
    var options: SpawnOptions = spawn_options();
    options.stdout = stdout_fd;
    options.stderr = stderr_fd;
    ret spawn_with_options(pathname, argv, envp, options);
}

# start a process without waiting, placed as the leader of its own new
# process group (see SpawnOptions)
# ---
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     the child's environment, given entries or inherited
# ret:      child handle, or the spawn failure
pub fun spawn_grouped(pathname: str, argv: **u8, envp: os.Environment) res[Child, Error] {
    var options: SpawnOptions = spawn_options();
    options.grouped = true;
    ret spawn_with_options(pathname, argv, envp, options);
}

# start a process without waiting, with its stdout and/or stderr bound to
# caller-supplied descriptors, placed as the leader of its own new process
# group (see SpawnOptions)
# ---
# pathname:  path to executable
# argv:      null-terminated argument array
# envp:      the child's environment, given entries or inherited
# stdout_fd: handle for the child's stdout, or os.INVALID_HANDLE to inherit
# stderr_fd: handle for the child's stderr, or os.INVALID_HANDLE to inherit
# ret:       child handle, or the spawn failure
pub fun spawn_redirected_grouped(pathname: str, argv: **u8, envp: os.Environment, stdout_fd: usize, stderr_fd: usize) res[Child, Error] {
    var options: SpawnOptions = spawn_options();
    options.stdout  = stdout_fd;
    options.stderr  = stderr_fd;
    options.grouped = true;
    ret spawn_with_options(pathname, argv, envp, options);
}

# the spawn primitives take a nil cwd to mean "inherit this process's", and a
# caller with nothing to say is far more likely to have an empty string in hand
# than a nil pointer. chdir("") fails, so passing the empty string straight
# through would kill the child with a 126 rather than inheriting.
fun cwd_or_inherit(cwd: str) *u8 {
    if (str_is_empty(cwd)) { ret nil; }
    ret cwd::*u8;
}

# start a process in a given working directory without waiting (see
# SpawnOptions)
# ---
# pathname: path to executable
# argv:     null-terminated argument array
# envp:     the child's environment, given entries or inherited
# cwd:      directory to run in, or empty to inherit this process's
# ret:      child handle, or the spawn failure
pub fun spawn_in(pathname: str, argv: **u8, envp: os.Environment, cwd: str) res[Child, Error] {
    var options: SpawnOptions = spawn_options();
    options.cwd = cwd;
    ret spawn_with_options(pathname, argv, envp, options);
}

# start a process in a given working directory with its standard streams bound
# to caller-supplied descriptors
# ---
# cwd:       directory to run in, or empty to inherit this process's
# stdin_fd:  handle for the child's stdin, or os.INVALID_HANDLE to inherit
# stdout_fd: handle for the child's stdout, or os.INVALID_HANDLE to inherit
# stderr_fd: handle for the child's stderr, or os.INVALID_HANDLE to inherit
# ret:       child handle, or the spawn failure
pub fun spawn_redirected_in(pathname: str, argv: **u8, envp: os.Environment, cwd: str,
    stdin_fd: usize, stdout_fd: usize,
    stderr_fd: usize) res[Child, Error] {
    ret spawn_with_options(pathname, argv, envp, SpawnOptions{
        cwd: cwd, stdin: stdin_fd, stdout: stdout_fd, stderr: stderr_fd, grouped: false,
    });
}

# start a process in a given working directory, with redirected streams, as the
# leader of its own group (see SpawnOptions)
# ---
# ret: child handle whose pgid identifies the group, or the spawn failure
pub fun spawn_redirected_in_grouped(pathname: str, argv: **u8, envp: os.Environment, cwd: str,
    stdin_fd: usize, stdout_fd: usize,
    stderr_fd: usize) res[Child, Error] {
    ret spawn_with_options(pathname, argv, envp, SpawnOptions{
        cwd: cwd, stdin: stdin_fd, stdout: stdout_fd, stderr: stderr_fd, grouped: true,
    });
}

# the native descriptor behind a redirection handle, -1 for inherit
fun native_fd(handle: usize) i32 {
    ret handle::isize::i32;
}

# a termination refused by the platform keeps the child with the caller
fun terminated(code: i64, child: Child) err[Error] {
    if (code < 0) {
        ret err[Error].err{Error.native{Failure{kind: os.error_kind(code), code: code, operation: os.PROCESS_OP_TERMINATE, child: child}}};
    }
    ret err[Error].ok{};
}

# forcefully stop a child without reaping it
#
# the child remains waitable after this succeeds. callers must still pass it
# to wait (or collect it through wait_any) to obtain its status and release
# retained platform resources.
#
# terminate_child, wait, and wait_any must not run concurrently for the same
# child. once one of the wait operations begins reaping a child, its numeric
# process ID can be released for reuse.
# ---
# child: child handle from spawn
# ret:   the native failure, which keeps the child with the caller
pub fun terminate_child(child: Child) err[Error] {
    ret terminated(os.terminate_child(child.pid), child);
}

# signal every process in a child's group, reaching descendants that spawned
# their own children in turn
#
# `ungrouped` when `child` was not spawned grouped (child.pgid == 0): there is
# no group to signal.
# member processes remain individually waitable afterward, exactly as
# terminate_child leaves a single child waitable.
# ---
# child: child handle from a grouped spawn
# ret:   the native failure, which keeps the child with the caller
pub fun terminate_group(child: Child) err[Error] {
    if (child.pgid == 0) { ret err[Error].err{Error.ungrouped{}}; }
    $if ($mach.build.sys == $mach.sys.linux) {
        ret terminated(linux.terminate_group(child.pgid), child);
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        ret terminated(darwin.terminate_group(child.pgid), child);
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        ret terminated(windows.terminate_group(child.pgid), child);
    }
    $or {
        ret err[Error].err{Error.unsupported{}};
    }
}

# forcefully stop every process in a child's group without reaping any of them
#
# what terminate_group asks of the group, this forces: SIGKILL on linux and
# darwin. on windows the job object's termination terminate_group performs is
# already forceful, so this terminates the job the same way. a group with no
# process left has nothing to stop, which is no failure.
# `ungrouped` when `child` was not spawned grouped (child.pgid == 0).
# member processes remain individually waitable afterward.
# ---
# child: child handle from a grouped spawn
# ret:   the native failure, which keeps the child with the caller
pub fun kill_group(child: Child) err[Error] {
    if (child.pgid == 0) { ret err[Error].err{Error.ungrouped{}}; }
    $if ($mach.build.sys == $mach.sys.linux) {
        val killed: i64 = linux.kill_group(child.pgid);
        if (killed == linux.ESRCH) { ret err[Error].ok{}; }
        ret terminated(killed, child);
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        val killed: i64 = darwin.kill_group(child.pgid);
        if (killed == darwin.ESRCH) { ret err[Error].ok{}; }
        ret terminated(killed, child);
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        val killed: i64 = windows.terminate_group(child.pgid);
        if (killed == windows.ESRCH) { ret err[Error].ok{}; }
        ret terminated(killed, child);
    }
    $or {
        ret err[Error].err{Error.unsupported{}};
    }
}

# whether any process is left in a child's group, the child itself included
# until it is reaped
#
# nothing is signalled. on windows reaping the child closes its job, which
# ends every process left in it.
# `ungrouped` when `child` was not spawned grouped (child.pgid == 0).
# ---
# child: child handle from a grouped spawn
# ret:   true while a process is left, or the native failure
pub fun group_alive(child: Child) res[bool, Error] {
    if (child.pgid == 0) { ret res[bool, Error].err{Error.ungrouped{}}; }
    var probed: i64;
    var absent: i64;
    $if ($mach.build.sys == $mach.sys.linux) {
        probed = linux.probe_group(child.pgid);
        absent = linux.ESRCH;
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        probed = darwin.probe_group(child.pgid);
        absent = darwin.ESRCH;
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        probed = windows.probe_group(child.pgid);
        absent = windows.ESRCH;
    }
    $or {
        ret res[bool, Error].err{Error.unsupported{}};
    }
    if (probed == absent) { ret res[bool, Error].ok{false}; }
    val err_probed: err[Error] = terminated(probed, child);
    if (sel err_probed.err) { ret res[bool, Error].err{err_probed.err}; }
    ret res[bool, Error].ok{true};
}

# wait for a child process to exit
#
# a signal that interrupts the wait is not a failure and is not reported as
# one: the wait is reissued until the child is reaped. the os layer bounds its
# own retries and surfaces exhaustion as EINTR, so a wrapper that treated that
# sentinel as terminal would turn a transient interruption into a permanent
# error and leave the child unreaped.
# ---
# child: child handle from spawn
# ret:   exit status, or a typed error retaining any unreaped child
pub fun wait(child: Child) res[ExitStatus, Error] {
    if (child.pid <= 0) { ret res[ExitStatus, Error].err{refusal(io_error.INVALID, os.PROCESS_OP_WAIT)}; }
    for {
        var status: ExitStatus;
        val result: os.WaitResult = os.wait_pid(child.pid, ?status, 0);
        if (os.error_kind(result.error.code) == io_error.INTERRUPTED) { cnt; }
        if (result.error.code < 0)                                    { ret res[ExitStatus, Error].err{wait_error(result.error, child)}; }
        if (result.pid > 0 && (exited(status) || signaled(status)))   { ret res[ExitStatus, Error].ok{status}; }
    }
}

# reap a child if it has already exited, without blocking
#
# this is the piece a caller needs to enforce a deadline: blocking in wait
# gives up the ability to notice that a scope expired, so a supervisor polls
# with this instead and keeps its own timing.
#
# a child that is still running is not an error; the result is simply absent.
# an interrupted probe is likewise not an error: it is reissued, so absent
# always means still running and never means interrupted.
# ---
# child: child handle from any spawn
# ret:   the exit status if it has terminated, absent if it is still running,
#        or a typed error retaining any unreaped child
pub fun try_wait(child: Child) res[opt[ExitStatus], Error] {
    if (child.pid <= 0) { ret res[opt[ExitStatus], Error].err{refusal(io_error.INVALID, os.PROCESS_OP_WAIT)}; }
    for {
        var status: ExitStatus;
        val result: os.WaitResult = os.wait_pid(child.pid, ?status, os.WNOHANG);
        if (os.error_kind(result.error.code) == io_error.INTERRUPTED) { cnt; }
        if (result.error.code < 0)                                    { ret res[opt[ExitStatus], Error].err{wait_error(result.error, child)}; }
        if (result.pid > 0 && (exited(status) || signaled(status))) {
            ret res[opt[ExitStatus], Error].ok{opt[ExitStatus].some{status}};
        }
        ret res[opt[ExitStatus], Error].ok{opt[ExitStatus].none{}};
    }
}

# block until any child of this process exits
#
# POSIX wait(-1) semantics on every platform (the windows layer emulates the
# -1 pid by waiting across its tracked child handles). the returned pair
# identifies which child was reaped and how it exited, so a caller juggling
# several children can map the exit back to its work item. errs when there is
# no child to wait for.
#
# serialize waits on the same child, and wait_any with all waits and termination
# an error without a selected child leaves every existing child owner with its caller
#
# an interrupting signal is retried rather than reported, as in wait.
# ---
# ret: the reaped child and its exit status, or a typed wait error
pub fun wait_any() res[Reaped, Error] {
    for {
        var status: ExitStatus;
        val result: os.WaitResult = os.wait_pid(-1, ?status, 0);
        if (os.error_kind(result.error.code) == io_error.INTERRUPTED) { cnt; }
        if (result.error.code < 0)                                    { ret res[Reaped, Error].err{wait_error(result.error, Child{})}; }
        if (result.pid > 0 && (exited(status) || signaled(status))) {
            ret res[Reaped, Error].ok{Reaped{child: Child{pid: result.pid}, status: status}};
        }
    }
}

# how a supervised child ended
pub rec Supervised {
    status: ExitStatus;
    # true when the deadline or a cancellation ended it rather than the child
    # finishing on its own
    terminated: bool;
    # the reason the scope carried when it ended, ACTIVE when the child won
    reason: cancel.Reason;
}

# how often a supervised wait looks at the child and the clock
val SUPERVISE_POLL_NSEC: i64 = 2000000;

# run a child to completion under a cancellation scope, terminating its whole
# group if the scope ends first
#
# this is the piece that makes a deadline mean something for a process. a scope
# with a deadline is only a promise until somebody enforces it, and enforcing it
# on a single child is not enough when that child spawned children of its own: a
# build step that runs a shell that runs a compiler leaves the compiler running
# if only the shell is signalled. so the group is what gets terminated, which is
# why the child should come from one of the grouped spawns.
#
# successful supervision reaps the child. a wait or termination failure returns
# its retained child for explicit retry or cleanup, alongside the original cause.
#
# a child that is not in a group is still supervised; expiry then terminates
# just that child, and any grandchildren it started survive. that is a weaker
# guarantee, not a silent one: prefer a grouped spawn when the child may spawn.
# ---
# child: child handle, ideally from a grouped spawn
# scope: the scope whose deadline or cancellation bounds the child
# ret:   how it ended, or a typed error retaining any unreaped child
pub fun wait_within(child: Child, scope: *cancel.Scope) res[Supervised, Error] {
    if (scope == nil) {
        ret res[Supervised, Error].err{Error.native{Failure{kind: io_error.INVALID, operation: os.PROCESS_OP_WAIT, child: child}}};
    }

    var terminated: bool = false;
    for {
        val res_probe: res[opt[ExitStatus], Error] = try_wait(child);
        if (sel res_probe.err) { ret res[Supervised, Error].err{res_probe.err}; }
        if (sel res_probe.ok.some) {
            ret res[Supervised, Error].ok{Supervised{
                status:     res_probe.ok.some,
                terminated: terminated,
                reason:     cancel.reason(scope)
            }};
        }

        # the child is still running, so ask whether it is still allowed to
        val res_now: tm.InstantClock = tm.instant();
        # a clock failure only skips this poll's expiry check, the next poll retries and an explicit cancel still ends the scope
        if (sel res_now.ok) { cancel.expire(scope, res_now.ok); }
        val why: cancel.Reason = cancel.reason(scope);
        if (!sel why.active && !terminated) {
            var err_stopped: err[Error];
            if (child.pgid != 0)     { err_stopped = terminate_group(child); }
            or                       { err_stopped = terminate_child(child); }
            if (sel err_stopped.err) { ret res[Supervised, Error].err{err_stopped.err}; }
            terminated = true;
            # fall through and keep polling: the child still has to be reaped
        }
        os.sleep(SUPERVISE_POLL_NSEC);
    }
}

# check if the process exited normally
# ---
# status: exit status to inspect
# ret:    true if the process called exit
pub fun exited(status: ExitStatus) bool {
    ret status.kind == PROCESS_EXITED;
}

# get the exit code of a normally exited process
# ---
# status: exit status to inspect
# ret:    full u32 exit code, only valid if exited() is true
pub fun code(status: ExitStatus) u32 {
    ret status.code;
}

# check if the process was killed by a signal
# ---
# status: exit status to inspect
# ret:    true if terminated by signal
pub fun signaled(status: ExitStatus) bool {
    ret status.kind == PROCESS_SIGNALED;
}

# get the signal number that killed the process
# ---
# status: exit status to inspect
# ret:    signal number
pub fun signal(status: ExitStatus) i32 {
    ret status.signal;
}

# check if the process was stopped by a signal
# ---
# status: exit status to inspect
# ret:    true for a stop observation
pub fun stopped(status: ExitStatus) bool {
    ret status.kind == PROCESS_STOPPED;
}

# get the signal number that stopped the process
# ---
# status: exit status to inspect
# ret:    signal number, only valid if stopped() is true
pub fun stop_signal(status: ExitStatus) i32 {
    ret status.signal;
}

# check if a stopped process was continued
# ---
# status: exit status to inspect
# ret:    true for a continuation observation
pub fun continued(status: ExitStatus) bool {
    ret status.kind == PROCESS_CONTINUED;
}

# terminate the current process
# ---
# code: exit code
pub fun exit(code: i64) {
    os.exit(code::u32);
}

# the most candidate spellings one PATH directory is probed for. posix uses
# one; windows uses one per PATHEXT entry, and the cmd default has four.
val CAND_MAX: usize = 16;

# a refused string copy; a slice this module computes is always inside its
# string, so a bounds refusal is invalid use rather than a reachable outcome
fun copy_refused(failure: StrError) Error {
    if (sel failure.alloc) { ret Error.alloc{failure.alloc}; }
    ret Error.alloc{A.Error.invalid{}};
}

# resolve a user-named program to a spawnable path using PATH
#
# none of the spawn entry points searches PATH: execve resolves nothing, and
# the windows layer passes a non-NULL lpApplicationName. a caller spawning a
# program the USER names rather than a fixed path resolves it here first.
#
# PATH is the only source. the current directory is never consulted, so a
# binary committed into a working tree cannot shadow the real tool.
# ---
# a:    allocator for the result
# name: program name, bare or already pathed
# ret:  an owned spawnable path (extent is its length plus the terminator,
#       released with text.string.str_free), or the failure
pub fun resolve(a: *A.Allocator, name: str) res[str, Error] {
    if (str_is_empty(name))       { ret res[str, Error].err{Error.empty_name{}}; }
    if (path.has_separator(name)) { ret owned_copy(a, name); }

    val res_paths: res[opt[OwnedString], env.EnvError] = env.value(a, "PATH");
    if (sel res_paths.err)     { ret res[str, Error].err{Error.env{res_paths.err}}; }
    if (sel res_paths.ok.none) { ret res[str, Error].err{Error.unset{}}; }
    var paths: OwnedString = res_paths.ok.some;

    val res_out: res[str, Error] = resolve_in(a, name, paths.data);
    owned_dnit(?paths);
    ret res_out;
}

# the candidate spellings are owned only when PATHEXT built them; the
# single-spelling case aliases `name`, which belongs to the caller
fun candidates_dnit(a: *A.Allocator, cand: *str, ncand: usize, exts: str, exts_extent: usize) {
    if (str_is_empty(exts)) { ret; }
    var k: usize = 0;
    for (k < ncand) {
        A.deallocate[u8](a, cand[k], str_len(cand[k]) + 1);
        k = k + 1;
    }
    A.deallocate[u8](a, exts, exts_extent);
}

# resolve a program name against a caller-supplied search list
#
# the search policy, with the environment read left to `resolve`. a caller with
# its own list - a configured toolchain directory, a sandbox - searches it here
# without going through PATH, and the policy stays testable without a way to
# set an environment variable.
#
# `search` is PATH-shaped and is NOT modified: entries separated by `;` on
# windows and `:` elsewhere. an EMPTY entry is skipped rather than treated as
# the current directory, which is the whole point of this function existing -
# letting the OS search would put the working directory ahead of the real tool
# on windows.
#
# a name that already spells a path is returned unresolved and unprobed. the
# result is owned by the caller in BOTH cases, so the free is unconditional.
# returning the borrowed argument for pathed names would make ownership depend
# on the value, which is how a caller ends up leaking one path and double
# freeing the other.
#
# a refused copy anywhere in the walk is the allocator's error, never a
# directory silently skipped: a search that could not look everywhere does
# not get to answer `not_found`.
# ---
# a:      allocator for the result
# name:   program name, bare or already pathed
# search: PATH-shaped list of directories, searched in order
# ret:    an owned spawnable path, or the failure
pub fun resolve_in(a: *A.Allocator, name: str, search: str) res[str, Error] {
    if (str_is_empty(name))       { ret res[str, Error].err{Error.empty_name{}}; }
    if (path.has_separator(name)) { ret owned_copy(a, name); }

    var list_sep: u8 = ':';
    $if ($mach.build.sys == $mach.sys.windows) {
        list_sep = ';';
    }

    # windows spells an executable with an extension: `git` is not a file,
    # `git.exe` is. joining the bare name alone would resolve nothing there, so
    # a bare name is tried against each PATHEXT suffix, in order, within a
    # directory before moving to the next. a name that already carries an
    # extension is tried as written, and posix always has exactly one spelling.
    var cand:  [CAND_MAX]str;
    var ncand: usize = 1;
    cand[0] = name;

    var exts:        str   = 0::usize::str;
    var exts_extent: usize = 0;
    $if ($mach.build.sys == $mach.sys.windows) {
        if (!str_contains_char(name, '.')) {
            val res_exts: res[opt[OwnedString], env.EnvError] = env.value(a, "PATHEXT");
            if (sel res_exts.err) { ret res[str, Error].err{Error.env{res_exts.err}}; }
            if (sel res_exts.ok.some) {
                exts        = res_exts.ok.some.data;
                exts_extent = res_exts.ok.some.extent;
            }

            # the set cmd.exe assumes when PATHEXT is unset
            if (str_is_empty(exts)) {
                if (exts != 0::usize::str) { A.deallocate[u8](a, exts, exts_extent); }
                val res_str_copy: res[str, StrError] = str_copy(a, ".COM;.EXE;.BAT;.CMD");
                if (sel res_str_copy.err) { ret res[str, Error].err{copy_refused(res_str_copy.err)}; }
                exts        = res_str_copy.ok;
                exts_extent = str_len(exts) + 1;
            }

            val elen: usize = str_len(exts);
            ncand = 0;
            var e: usize = 0;
            for (e < elen && ncand < CAND_MAX) {
                val estart: usize = e;
                for (e < elen && exts[e] != ';') { e = e + 1; }
                val eseg: usize = e - estart;
                exts[e] = 0;
                e       = e + 1;
                if (eseg == 0) { cnt; }

                val res_str_join: res[str, StrError] = str_join(a, name, (?exts[estart])::str);
                if (sel res_str_join.err) {
                    candidates_dnit(a, ?cand[0], ncand, exts, exts_extent);
                    ret res[str, Error].err{copy_refused(res_str_join.err)};
                }
                cand[ncand] = res_str_join.ok;
                ncand       = ncand + 1;
            }
        }
    }

    val slen:              usize = str_len(search);
    var found:             str   = 0::usize::str;
    var opt_refused_query: opt[io_error.Error];
    var i:                 usize = 0;
    for (i < slen && str_is_empty(found)) {
        val start: usize = i;
        for (i < slen && search[i] != list_sep) { i = i + 1; }
        val seg_len: usize = i - start;
        i = i + 1;

        # an empty entry means the current directory on both posix and windows,
        # which is exactly what must never be searched
        if (seg_len == 0) { cnt; }

        # `search` belongs to the caller and may be a literal in read-only
        # memory, so the entry is copied out rather than terminated in place
        val res_dir: res[str, StrError] = str_copy_slice(a, search, start, seg_len);
        if (sel res_dir.err) {
            candidates_dnit(a, ?cand[0], ncand, exts, exts_extent);
            ret res[str, Error].err{copy_refused(res_dir.err)};
        }
        val dir: str = res_dir.ok;

        var c: usize = 0;
        for (c < ncand) {
            val res_cand: res[path.Path, A.Error] = path.join(a, dir, cand[c]);
            if (sel res_cand.err) {
                A.deallocate[u8](a, dir, seg_len + 1);
                candidates_dnit(a, ?cand[0], ncand, exts, exts_extent);
                ret res[str, Error].err{Error.alloc{res_cand.err}};
            }
            val full:        str                       = res_cand.ok;
            val res_present: res[bool, io_error.Error] = filesystem.is_file(full);
            if (sel res_present.ok && res_present.ok) {
                found = full;
                brk;
            }
            if (sel res_present.err) { opt_refused_query = opt[io_error.Error].some{res_present.err}; }
            A.deallocate[u8](a, full, str_len(full) + 1);
            c = c + 1;
        }
        A.deallocate[u8](a, dir, seg_len + 1);
    }

    candidates_dnit(a, ?cand[0], ncand, exts, exts_extent);

    if (str_is_empty(found)) {
        if (sel opt_refused_query.some) { ret res[str, Error].err{Error.query{opt_refused_query.some}}; }
        ret res[str, Error].err{Error.not_found{}};
    }
    ret res[str, Error].ok{found};
}

# an owned copy of a pathed name
fun owned_copy(a: *A.Allocator, name: str) res[str, Error] {
    val res_copied: res[str, StrError] = str_copy(a, name);
    if (sel res_copied.err) { ret res[str, Error].err{copy_refused(res_copied.err)}; }
    ret res[str, Error].ok{res_copied.ok};
}

# the exec contract is platform-neutral, but the test programs are not;
# the $if blocks confine the differences to program paths, argv shapes,
# and echo's line ending (cmd appends CRLF where posix echo appends LF).
$if ($mach.build.sys == $mach.sys.windows) {
    #[testing]
    var comspec_buf: [260]u8;

    # %ComSpec% names the command interpreter; fall back to the canonical
    # path when unset
    #[testing]
    fun shell_path() str {
        val n: i64 = os.getenv("ComSpec", ?comspec_buf[0], 260);
        if (n > 0 && n < 260) {
            ret (?comspec_buf[0])::str;
        }
        ret "C:\\Windows\\System32\\cmd.exe";
    }

    #[testing]
    fun make_shell_argv(command: str) [4]usize {
        var buf: [4]usize;
        buf[0] = ("cmd")::usize;
        buf[1] = ("/c")::usize;
        buf[2] = command::usize;
        buf[3] = 0;
        ret buf;
    }

    #[testing]
    fun prog_ok() str {
        ret shell_path();
    }
    #[testing]
    fun argv_ok() [4]usize {
        ret make_shell_argv("exit 0");
    }
    #[testing]
    fun prog_fail() str {
        ret shell_path();
    }
    #[testing]
    fun argv_fail() [4]usize {
        ret make_shell_argv("exit 1");
    }
    #[testing]
    fun prog_echo() str {
        ret shell_path();
    }
    #[testing]
    fun argv_echo() [4]usize {
        ret make_shell_argv("echo hello");
    }

    # cmd's echo appends CRLF: "hello\r\n"
    #[testing]
    val ECHO_LEN: usize = 7;

    #[testing]
    fun probe_cmd() str {
        ret "echo x>std_exec_cwd_probe.tmp";
    }
    # a bare name that PATH resolves on any windows install. it carries no
    # extension, so it also exercises the PATHEXT spelling walk.
    #[testing]
    fun known_program() str {
        ret "cmd";
    }
    # a command whose quoting only survives if the interpreter's own rules are
    # honoured: the CRT convention mangles the embedded quotes
    #[testing]
    fun probe_quoted_cmd() str {
        ret "copy \"std exec seed.txt\" std_exec_quoted_probe.tmp";
    }
    #[testing]
    fun seed_cmd() str {
        ret "echo seeded>\"std exec seed.txt\"";
    }
}
$or {
    #[testing]
    fun make_argv1(prog: str) [4]usize {
        var buf: [4]usize;
        buf[0] = prog::usize;
        buf[1] = 0;
        buf[2] = 0;
        buf[3] = 0;
        ret buf;
    }

    #[testing]
    fun make_argv2(prog: str, a1: str) [4]usize {
        var buf: [4]usize;
        buf[0] = prog::usize;
        buf[1] = a1::usize;
        buf[2] = 0;
        buf[3] = 0;
        ret buf;
    }

    #[testing]
    fun prog_ok() str {
        $if ($mach.build.sys == $mach.sys.darwin) { ret "/usr/bin/true"; }
        $or                                       { ret "/bin/true"; }
    }
    #[testing]
    fun argv_ok() [4]usize {
        ret make_argv1(prog_ok());
    }
    #[testing]
    fun prog_fail() str {
        $if ($mach.build.sys == $mach.sys.darwin) { ret "/usr/bin/false"; }
        $or                                       { ret "/bin/false"; }
    }
    #[testing]
    fun argv_fail() [4]usize {
        ret make_argv1(prog_fail());
    }
    #[testing]
    fun prog_echo() str {
        ret "/bin/echo";
    }
    #[testing]
    fun argv_echo() [4]usize {
        ret make_argv2("/bin/echo", "hello");
    }

    # echo emits "hello\n"
    #[testing]
    val ECHO_LEN: usize = 6;

    # a bare name that PATH resolves on any posix install
    #[testing]
    fun known_program() str {
        ret "sh";
    }
    #[testing]
    fun probe_cmd() str {
        ret "echo x>std_exec_cwd_probe.tmp";
    }
    # a command whose quoting only survives if the interpreter's own rules are
    # honoured: the CRT convention mangles the embedded quotes
    #[testing]
    fun probe_quoted_cmd() str {
        ret "cp \"std exec seed.txt\" std_exec_quoted_probe.tmp";
    }
    #[testing]
    fun seed_cmd() str {
        ret "echo seeded>\"std exec seed.txt\"";
    }
}

# test predicates: `sel` takes a place, so an inline call is tested through these
#[testing]
fun exited_zero(r: res[ExitStatus, Error]) bool {
    if (!sel r.ok) { ret false; }
    ret exited(r.ok) && code(r.ok) == 0;
}

fun present(p: str) bool {
    val res_queried: res[bool, io_error.Error] = filesystem.is_file(p);
    ret sel res_queried.ok && res_queried.ok;
}

#[testing]
fun exited_with(r: res[ExitStatus, Error], want: u32) bool {
    if (!sel r.ok) { ret false; }
    ret exited(r.ok) && code(r.ok) == want;
}

#[testing]
fun terminated_ok(r: err[Error]) bool {
    ret sel r.ok;
}

#[testing]
fun still_running(r: res[opt[ExitStatus], Error]) bool {
    if (!sel r.ok) { ret false; }
    ret sel r.ok.none;
}

#[testing]
fun resolved_to(r: res[str, Error], want: str) bool {
    if (!sel r.ok) { ret false; }
    ret str_equals(r.ok, want);
}

# run and spawn-then-wait both report the child's own exit code
test run__and_spawn_report_the_exit_code {
    var ok: [4]usize = argv_ok();
    if (!exited_zero(run(prog_ok(), (?ok[0])::**u8, Environment.inherit{}))) { ret 1; }
    var bad: [4]usize = argv_fail();
    if (!exited_with(run(prog_fail(), (?bad[0])::**u8, Environment.inherit{}), 1)) { ret 2; }
    val res_spawn: res[Child, Error] = spawn(prog_ok(), (?ok[0])::**u8, Environment.inherit{});
    if (sel res_spawn.err)                { ret 3; }
    if (!exited_zero(wait(res_spawn.ok))) { ret 4; }
    ret 0;
}

# output drains the child's whole stdout into owned bytes
test output__captures_stdout {
    var buf: [32768]u8;
    var fst: fixed.FixedState;
    var a:   A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 32768);

    var argv:       [4]usize           = argv_echo();
    val res_output: res[Output, Error] = output(?a, prog_echo(), (?argv[0])::**u8, Environment.inherit{});
    if (sel res_output.err) { ret 1; }
    val o: Output = res_output.ok;
    if (!exited(o.status))                  { ret 1; }
    if (code(o.status) != 0)                { ret 1; }
    if (o.bytes.len != ECHO_LEN)            { ret 1; }
    if (o.bytes.data[0] != 'h')             { ret 1; }
    if (o.bytes.data[4] != 'o')             { ret 1; }
    if (o.bytes.data[ECHO_LEN - 1] != '\n') { ret 1; }
    ret 0;
}

# terminate_group reaches a grandchild the direct child never told us about:
# the shell backgrounds `sleep 3600`, reports its pid over a pipe, then blocks
# in `wait` - both processes share the group terminate_group signals, and
# neither is individually reachable through terminate_child (the sleep is not
# even our own child). the grandchild's liveness is polled through getpgid
# (ESRCH once gone) since wait_pid only works on this process's own children;
# the shell's is polled through a non-blocking wait_pid, which also reaps it.
#
# windows has no equivalent of `&` backgrounding with a `$!`-style way to
# recover the new pid from a plain cmd.exe one-liner, so the windows branch
# below proves the narrower but still load-bearing half of the same claim:
# TerminateJobObject actually reaches and kills the member process, not just
# that the API calls return success. a real cross-process grandchild case
# would need more windows-specific test plumbing than is justified here.
test terminate_group__kills_a_grandchild {
    $if ($mach.build.sys == $mach.sys.windows) {
        var argv:              [4]usize          = make_shell_argv("ping -n 3600 127.0.0.1 >NUL");
        val res_spawn_grouped: res[Child, Error] = spawn_grouped(shell_path(), (?argv[0])::**u8, Environment.inherit{});
        if (sel res_spawn_grouped.err) { ret 1; }
        val child: Child = res_spawn_grouped.ok;
        if (child.pgid == 0) {
            terminate_child(child);
            wait(child);
            ret 1;
        }

        if (!terminated_ok(terminate_group(child))) {
            terminate_child(child);
            wait(child);
            ret 1;
        }

        var wstatus: os.ProcessStatus;
        val w:       os.WaitResult = os.wait_pid(child.pid, ?wstatus, 0);
        if (w.pid != child.pid || w.error.code != 0) { ret 1; }
        # TerminateJobObject's uExitCode becomes every member's exit code,
        # same TERMINATE_CHILD_EXIT_CODE terminate_child already uses -
        # confirms this reaped exit came from the group kill, not a ping that
        # happened to finish its own hour-long run on its own
        if (!exited(wstatus) || code(wstatus) != 137) { ret 1; }
        ret 0;
    }
    $or {
        var out_buf: [32]u8;
        var fds:     [2]usize;
        if (os.pipe(?fds[0], ?fds[1]) < 0) { ret 1; }

        var argv: [4]usize;
        argv[0] = ("/bin/sh")::usize;
        argv[1] = ("-c")::usize;
        argv[2] = ("sleep 3600 & echo $!; wait")::usize;
        argv[3] = 0;

        val res_spawn_redirected_grouped: res[Child, Error] = spawn_redirected_grouped("/bin/sh", (?argv[0])::**u8, Environment.inherit{}, fds[1], os.INVALID_HANDLE);
        if (sel res_spawn_redirected_grouped.err) {
            os.close(fds[0]);
            os.close(fds[1]);
            ret 1;
        }
        os.close(fds[1]);
        val shell: Child = res_spawn_redirected_grouped.ok;

        # read the grandchild's pid, echoed as decimal text followed by '\n'
        var total: usize = 0;
        for (total < 31) {
            val n: i64 = os.read(fds[0], (?out_buf[total])::*u8, 32 - total);
            if (n <= 0) { brk; }
            total = total + n::usize;
            if (out_buf[total - 1] == '\n'::u8) { brk; }
        }
        os.close(fds[0]);
        if (total == 0) {
            terminate_child(shell);
            wait(shell);
            ret 1;
        }

        var grandchild: i64   = 0;
        var i:          usize = 0;
        for (i < total && out_buf[i] >= '0'::u8 && out_buf[i] <= '9'::u8) {
            grandchild = grandchild * 10 + (out_buf[i] - '0'::u8)::i64;
            i          = i + 1;
        }
        if (grandchild <= 0) {
            terminate_child(shell);
            wait(shell);
            ret 1;
        }

        if (!terminated_ok(terminate_group(shell))) {
            wait(shell);
            ret 1;
        }

        # poll until both the shell and the grandchild are gone, not merely the
        # one this process can wait() on
        var shell_reaped:    u8    = 0;
        var grandchild_gone: u8    = 0;
        var polls:           usize = 0;
        for (shell_reaped == 0 || grandchild_gone == 0) {
            # 20 seconds at most, so a group signal that missed one fails here
            if (polls >= 1000) { ret 2; }
            polls = polls + 1;
            if (shell_reaped == 0) {
                var wstatus: os.ProcessStatus;
                if (os.wait_pid(shell.pid, ?wstatus, os.WNOHANG).pid == shell.pid) { shell_reaped = 1; }
            }
            if (grandchild_gone == 0) {
                $if ($mach.build.sys == $mach.sys.linux) {
                    if (linux.getpgid(grandchild) < 0) { grandchild_gone = 1; }
                }
                $or ($mach.build.sys == $mach.sys.darwin) {
                    if (darwin.getpgid(grandchild) < 0) { grandchild_gone = 1; }
                }
            }
            if (shell_reaped == 0 || grandchild_gone == 0) { os.sleep(20000000); }
        }
        ret 0;
    }
}

# a termination the platform refuses keeps the child with the caller: a
# reaped pid is ECHILD, and the error names the child it was asked about
test terminate_child__refusal_keeps_the_child {
    var argv:      [4]usize          = argv_ok();
    val res_spawn: res[Child, Error] = spawn(prog_ok(), (?argv[0])::**u8, Environment.inherit{});
    if (sel res_spawn.err) { ret 1; }
    val child:    Child                  = res_spawn.ok;
    val res_wait: res[ExitStatus, Error] = wait(child);
    if (!exited_zero(res_wait)) { ret 2; }
    val err_terminate_child: err[Error] = terminate_child(child);
    if (!sel err_terminate_child.err)                                                                                                    { ret 3; }
    if (!sel err_terminate_child.err.native)                                                                                             { ret 4; }
    if (err_terminate_child.err.native.kind != io_error.NO_CHILD || err_terminate_child.err.native.operation != os.PROCESS_OP_TERMINATE) { ret 5; }
    if (retained(err_terminate_child.err).pid != child.pid)                                                                              { ret 6; }
    ret 0;
}

# each child is reaped exactly once, in either order, and with none left the
# wait is the native no-child failure
test wait_any__reaps_each_child_once_then_no_child {
    var argv_a:    [4]usize          = argv_ok();
    val res_spawn: res[Child, Error] = spawn(prog_ok(), (?argv_a[0])::**u8, Environment.inherit{});
    if (sel res_spawn.err) { ret 1; }
    var argv_b:            [4]usize          = argv_ok();
    val res_spawn_prog_ok: res[Child, Error] = spawn(prog_ok(), (?argv_b[0])::**u8, Environment.inherit{});
    if (sel res_spawn_prog_ok.err) { ret 1; }
    val pa: i64 = res_spawn.ok.pid;
    val pb: i64 = res_spawn_prog_ok.ok.pid;

    val res_one_reaped: res[Reaped, Error] = wait_any();
    if (sel res_one_reaped.err) { ret 2; }
    val r1: Reaped = res_one_reaped.ok;
    if (!exited(r1.status) || code(r1.status) != 0) { ret 3; }

    val res_other_reaped: res[Reaped, Error] = wait_any();
    if (sel res_other_reaped.err) { ret 4; }
    val r2: Reaped = res_other_reaped.ok;
    if (!exited(r2.status) || code(r2.status) != 0) { ret 5; }

    if (r1.child.pid == r2.child.pid)             { ret 6; }
    if (r1.child.pid != pa && r1.child.pid != pb) { ret 7; }
    if (r2.child.pid != pa && r2.child.pid != pb) { ret 8; }

    val res_none: res[Reaped, Error] = wait_any();
    if (!sel res_none.err)                                                                { ret 9; }
    if (!sel res_none.err.native)                                                         { ret 9; }
    if (res_none.err.native.kind != io_error.NO_CHILD || retained(res_none.err).pid != 0) { ret 10; }
    ret 0;
}

# run_shell starts the child in the requested directory: a relative path the
# child creates lands there and not in the parent's cwd. the chdir happens after
# the fork/clone, so the parent's own cwd is untouched - the check that would
# catch a CLONE_FS-style leak into the caller.
test run_shell__child_starts_in_cwd {
    var before: [4096]u8;
    if (os.getcwd(?before[0], 4096) < 0) { ret 1; }

    var scratch: os.Scratch;
    if (os.scratch_make(?scratch) < 0) { ret 2; }
    fin { filesystem.scratch_remove(?scratch); }
    val dir:  str = os.scratch_dir(?scratch);
    val leaf: str = "std_exec_cwd_probe.tmp";

    val res_run_shell: res[ExitStatus, Error] = run_shell(probe_cmd(), dir, Environment.inherit{});
    if (!exited_zero(res_run_shell)) { ret 1; }

    var joined: os.ScratchPath;
    os.scratch_path(?scratch, leaf, ?joined);

    var bad: u8 = 0;
    if (!present((?joined[0])::str)) { bad = 1; }
    # the marker must not have landed in the parent's cwd
    or (present(leaf)) { bad = 1; }

    # the parent's cwd must be exactly what it was
    var after: [4096]u8;
    if (os.getcwd(?after[0], 4096) < 0) { ret 1; }
    var i: usize = 0;
    for (before[i] != 0 || after[i] != 0) {
        if (before[i] != after[i]) {
            bad = 1;
            brk;
        }
        i = i + 1;
    }
    ret bad::i32;
}

# a command containing quotes survives intact. this is the shape the CRT argv
# convention corrupts on windows, where an embedded `"` is escaped to `\"` and
# cmd.exe takes those bytes literally - and it is how anyone writes a path that
# contains a space, so it is the common case rather than an exotic one.
test run_shell__quoted_command_survives {
    var scratch: os.Scratch;
    if (os.scratch_make(?scratch) < 0) { ret 2; }
    fin { filesystem.scratch_remove(?scratch); }
    val dir:       str = os.scratch_dir(?scratch);
    var seed_path: os.ScratchPath;
    os.scratch_path(?scratch, "std exec seed.txt", ?seed_path);
    var out_path: os.ScratchPath;
    os.scratch_path(?scratch, "std_exec_quoted_probe.tmp", ?out_path);

    val res_run_shell: res[ExitStatus, Error] = run_shell(seed_cmd(), dir, Environment.inherit{});
    if (sel res_run_shell.err)          { ret 1; }
    if (!present((?seed_path[0])::str)) { ret 1; }

    val res_run_shell_probe_quoted_cmd: res[ExitStatus, Error] = run_shell(probe_quoted_cmd(), dir, Environment.inherit{});
    var bad:                            u8                     = 0;
    if (!exited_zero(res_run_shell_probe_quoted_cmd)) { bad = 1; }
    or (!present((?out_path[0])::str))                { bad = 1; }
    ret bad::i32;
}

# resolve tests
#
# the search list is supplied directly rather than through PATH: there is no
# way to set an environment variable in-process, and a test that read the real
# PATH could only assert that some program somewhere resolved, which passes
# against an implementation that ignores order and against one that searches
# the current directory.

# a pathed name comes back unchanged AND unprobed. the name deliberately does
# not exist, so an implementation that stats before returning fails here.
test resolve_in__pathed_name_is_verbatim_and_unprobed {
    var buf: [8192]u8;
    var fst: fixed.FixedState;
    var a:   A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 8192);

    var scratch: os.Scratch;
    if (os.scratch_make(?scratch) < 0) { ret 2; }
    fin { filesystem.scratch_remove(?scratch); }
    var probe: os.ScratchPath;
    val want:  str = os.scratch_path(?scratch, "std_exec_resolve_absent.tmp", ?probe);
    if (present(want)) { ret 1; }

    val res_resolve_in: res[str, Error] = resolve_in(?a, want, "");
    if (!resolved_to(res_resolve_in, want)) { ret 1; }
    ret 0;
}

# the FIRST matching entry wins. the same leaf exists in both directories, so
# an implementation that searches in the wrong order, or that returns any hit
# rather than the earliest, gets the other one and fails. running it in both
# orders is what makes that mutation detectable - a single order would pass
# against an implementation that always returned the last hit.
test resolve_in__first_entry_wins {
    var buf: [16384]u8;
    var fst: fixed.FixedState;
    var a:   A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 16384);

    var scratch: os.Scratch;
    if (os.scratch_make(?scratch) < 0) { ret 2; }
    fin { filesystem.scratch_remove(?scratch); }
    val leaf:  str = "std_exec_resolve_dup.tmp";
    var da:    os.ScratchPath;
    var db:    os.ScratchPath;
    val dir_a: str = os.scratch_path(?scratch, "a", ?da);
    val dir_b: str = os.scratch_path(?scratch, "b", ?db);

    filesystem.create_dir(dir_a, 0o755);
    filesystem.create_dir(dir_b, 0o755);

    var fa: os.ScratchPath;
    var fb: os.ScratchPath;
    os.scratch_path(?scratch, "a/std_exec_resolve_dup.tmp", ?fa);
    os.scratch_path(?scratch, "b/std_exec_resolve_dup.tmp", ?fb);
    filesystem.write_bytes((?fa[0])::str, "a", 1, 0o644);
    filesystem.write_bytes((?fb[0])::str, "b", 1, 0o644);

    var bad: u8 = 0;

    val res_resolve_in: res[str, Error] = resolve_in(?a, leaf, list_of(?a, dir_a, dir_b));
    if (!resolved_to(res_resolve_in, (?fa[0])::str)) { bad = 1; }

    val res_resolve_in_leaf: res[str, Error] = resolve_in(?a, leaf, list_of(?a, dir_b, dir_a));
    if (!resolved_to(res_resolve_in_leaf, (?fb[0])::str)) { bad = 1; }
    ret bad::i32;
}

fun not_found(r: res[str, Error]) bool {
    if (!sel r.err) { ret false; }
    ret sel r.err.not_found;
}

# a program sitting in the CURRENT directory must not resolve. this is the
# whole reason the lookup is written rather than delegated to the OS: on
# windows CreateProcess with a NULL lpApplicationName searches the working
# directory ahead of System32, so a binary committed into a repository would
# be spawned in preference to the real tool.
#
# the empty entries are the shape that expresses "current directory" in a PATH
# on both posix and windows, so this also pins that they are skipped.
test resolve_in__current_directory_is_never_searched {
    var buf: [8192]u8;
    var fst: fixed.FixedState;
    var a:   A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 8192);

    var scratch: os.Scratch;
    if (os.scratch_make(?scratch) < 0) { ret 2; }
    fin { filesystem.scratch_remove(?scratch); }
    # the file must sit in the working directory to show it is not searched: it
    # takes the scratch directory's name, which no other process holds
    val leaf:        str                     = path.filename(os.scratch_dir(?scratch));
    val err_written: err[filesystem.FsError] = filesystem.write_bytes(leaf, "x", 1, 0o644);
    if (sel err_written.err) { ret 3; }
    fin { filesystem.remove_file(leaf); }

    var bad: u8 = 0;
    # a bare empty list, a leading empty entry, an interior one, a trailing one
    if (!not_found(resolve_in(?a, leaf, "")))                                 { bad = 1; }
    if (!not_found(resolve_in(?a, leaf, sep1(?a))))                           { bad = 1; }
    if (!not_found(resolve_in(?a, leaf, sep2(?a, os.scratch_dir(?scratch))))) { bad = 1; }
    ret bad::i32;
}

# a directory the process may not search does not hide a program further
# along the list, and a name found nowhere past such a directory reports the
# refused query rather than `not_found`. the fixture is a mode-000 directory,
# which only refuses to a non-root caller on posix; when the probe shows the
# platform answers the query anyway, the fixture cannot exhibit either rule
# and the test passes vacuously
test resolve_in__unsearchable_entry_is_query_unless_a_later_entry_hits {
    var buf: [16384]u8;
    var fst: fixed.FixedState;
    var a:   A.Allocator;
    fixed.make(?a, ?fst, ?buf[0], 16384);

    var scratch: os.Scratch;
    if (os.scratch_make(?scratch) < 0) { ret 5; }
    fin { filesystem.scratch_remove(?scratch); }
    val leaf:     str = "std_exec_resolve_denied.tmp";
    var dd:       os.ScratchPath;
    var dr:       os.ScratchPath;
    val denied:   str = os.scratch_path(?scratch, "denied", ?dd);
    val readable: str = os.scratch_path(?scratch, "readable", ?dr);
    filesystem.create_dir(denied, 0o000);
    # the mode comes back first, since a host may refuse to remove what it may not open
    fin {
        os.set_mode_at(os.working_dir(), denied, 0o700);
        filesystem.remove_dir(denied);
    }
    filesystem.create_dir(readable, 0o755);
    var fr: os.ScratchPath;
    os.scratch_path(?scratch, "readable/std_exec_resolve_denied.tmp", ?fr);
    filesystem.write_bytes((?fr[0])::str, "r", 1, 0o644);

    var fd: os.ScratchPath;
    os.scratch_path(?scratch, "denied/std_exec_resolve_denied.tmp", ?fd);
    val res_probe: res[bool, io_error.Error] = filesystem.is_file((?fd[0])::str);
    if (!sel res_probe.err) { ret 77; }

    val res_alone: res[str, Error] = resolve_in(?a, leaf, denied);
    if (!sel res_alone.err)                             { ret 1; }
    if (!sel res_alone.err.query)                       { ret 2; }
    if (res_alone.err.query.code != res_probe.err.code) { ret 3; }

    val res_after: res[str, Error] = resolve_in(?a, leaf, list_of(?a, denied, readable));
    if (!resolved_to(res_after, (?fr[0])::str)) { ret 4; }
    ret 0;
}

# a refused copy is the allocator's error and leaves nothing behind, at the
# pathed-name copy and at the directory copy inside the walk alike
test resolve_in__refused_copies_leak_nothing {
    var tracking:    process_testing.Testing;
    val err_tracked: err[A.Error] = process_testing.init(?tracking);
    if (sel err_tracked.err) { ret 1; }
    fin { process_testing.dnit(?tracking); }

    var scratch: os.Scratch;
    if (os.scratch_make(?scratch) < 0) { ret 14; }
    fin { filesystem.scratch_remove(?scratch); }
    var probe: os.ScratchPath;
    os.scratch_path(?scratch, "std_exec_resolve_absent.tmp", ?probe);
    process_testing.fail_at_ordinal(?tracking, process_testing.attempt_count(?tracking) + 1);
    val res_pathed: res[str, Error] = resolve_in(?tracking.a, (?probe[0])::str, "");
    if (!sel res_pathed.err)       { ret 2; }
    if (!sel res_pathed.err.alloc) { ret 3; }
    if (tracking.live != 0)        { ret 4; }

    # the walk copies each directory entry; the refusal of that copy is not a
    # skipped directory followed by `not_found`. the name carries an extension
    # so that on windows the PATHEXT read does not come first: the directory
    # copy is the first acquisition on every platform
    process_testing.fail_at_ordinal(?tracking, process_testing.attempt_count(?tracking) + 1);
    val res_walked: res[str, Error] = resolve_in(?tracking.a, "std_exec_no_such_program.tmp", os.scratch_dir(?scratch));
    if (!sel res_walked.err)       { ret 5; }
    if (!sel res_walked.err.alloc) { ret 6; }
    if (tracking.live != 0)        { ret 7; }

    # a bare name on windows reads PATHEXT before anything else, so its first
    # acquisition is the environment value's copy and the refusal is `env`
    # carrying the allocator's refusal, not a search that found nothing
    $if ($mach.build.sys == $mach.sys.windows) {
        process_testing.fail_at_ordinal(?tracking, process_testing.attempt_count(?tracking) + 1);
        val res_bare: res[str, Error] = resolve_in(?tracking.a, "std_exec_no_such_program", os.scratch_dir(?scratch));
        if (!sel res_bare.err)           { ret 10; }
        if (!sel res_bare.err.env)       { ret 11; }
        if (!sel res_bare.err.env.alloc) { ret 12; }
        if (tracking.live != 0)          { ret 13; }
    }

    process_testing.clear_failure(?tracking);
    val res_searched: res[str, Error] = resolve_in(?tracking.a, "std_exec_no_such_program", os.scratch_dir(?scratch));
    if (!not_found(res_searched)) { ret 8; }
    if (tracking.live != 0)       { ret 9; }
    ret 0;
}

# `resolve` reads PATH and finds a real program. this is the only test that
# touches the environment, and it is deliberately weak: it asserts the wrapper
# reaches the search, and the search itself is pinned by the tests above.
test resolve__finds_a_real_program_on_path {
    var a: A.Allocator;
    page.make(?a);

    val res_resolve: res[str, Error] = resolve(?a, known_program());
    if (sel res_resolve.err) { ret 1; }
    val resolved: str  = res_resolve.ok;
    val exists:   bool = present(resolved);
    A.deallocate[u8](?a, resolved, str_len(resolved) + 1);
    if (!exists) { ret 1; }
    ret 0;
}

# build a two-entry search list using the platform separator
#[testing]
fun list_of(a: *A.Allocator, first: str, second: str) str {
    var sep: str = ":";
    $if ($mach.build.sys == $mach.sys.windows) { sep = ";"; }
    val res_str_join: res[str, StrError] = str_join(a, first, sep, second);
    if (sel res_str_join.err) { ret ""; }
    ret res_str_join.ok;
}

# a list that is a single empty entry, and one with a leading and a trailing
# empty entry around a directory that does not hold the leaf
#[testing]
fun sep1(a: *A.Allocator) str {
    ret list_of(a, "", "");
}

#[testing]
fun sep2(a: *A.Allocator, dir: str) str {
    ret list_of(a, "", dir);
}

# a command that runs long enough to still be alive when the deadline fires,
# spelled for whichever shell the platform has
#[testing]
fun long_running_argv() [4]usize {
    $if ($mach.build.sys == $mach.sys.windows) {
        ret make_shell_argv("ping -n 30 127.0.0.1 >NUL");
    }
    $or {
        var buf: [4]usize;
        buf[0] = ("/bin/sh")::usize;
        buf[1] = ("-c")::usize;
        buf[2] = ("exec sleep 3600")::usize;
        buf[3] = 0;
        ret buf;
    }
}

#[testing]
fun long_running_path() str {
    $if ($mach.build.sys == $mach.sys.windows) { ret shell_path(); }
    $or                                        { ret "/bin/sh"; }
}

#[testing]
fun exit_seven_argv() [4]usize {
    $if ($mach.build.sys == $mach.sys.windows) {
        ret make_shell_argv("exit 7");
    }
    $or {
        var buf: [4]usize;
        buf[0] = ("/bin/sh")::usize;
        buf[1] = ("-c")::usize;
        buf[2] = ("exit 7")::usize;
        buf[3] = 0;
        ret buf;
    }
}

# try_wait must not block on a live child, and must report the same termination
# wait would once the child is gone
test try_wait__absent_while_running_then_present {
    var argv:      [4]usize          = long_running_argv();
    val res_spawn: res[Child, Error] = spawn(long_running_path(), (?argv[0])::**u8, Environment.inherit{});
    if (sel res_spawn.err) { ret 1; }
    val child: Child = res_spawn.ok;

    # the child is still running, so the answer is absent rather than a block
    val res_first: res[opt[ExitStatus], Error] = try_wait(child);
    if (sel res_first.err) {
        terminate_child(child);
        wait(child);
        ret 2;
    }
    if (!still_running(res_first)) {
        terminate_child(child);
        wait(child);
        ret 3;
    }

    terminate_child(child);
    var seen:  bool  = false;
    var polls: usize = 0;
    for (!seen) {
        # 20 seconds at most, so a status that never arrives fails here
        if (polls >= 10000) { ret 5; }
        val res_probe: res[opt[ExitStatus], Error] = try_wait(child);
        if (sel res_probe.err)     { ret 4; }
        if (sel res_probe.ok.some) { seen = true; }
        or                         { os.sleep(2000000); }
        polls = polls + 1;
    }
    ret 0;
}

# a grouped child's group is alive until it is killed and its child reaped, a
# group with no process left is nothing to kill, and an ungrouped child has no
# group to kill or probe
test kill_group__stops_the_group_and_group_alive_follows_it {
    var plain_argv: [4]usize          = argv_ok();
    val res_plain:  res[Child, Error] = spawn(prog_ok(), (?plain_argv[0])::**u8, Environment.inherit{});
    if (sel res_plain.err) { ret 1; }
    val err_plain_killed: err[Error]       = kill_group(res_plain.ok);
    val res_plain_alive:  res[bool, Error] = group_alive(res_plain.ok);
    wait(res_plain.ok);
    if (!(sel err_plain_killed.err && sel err_plain_killed.err.ungrouped)) { ret 2; }
    if (!(sel res_plain_alive.err && sel res_plain_alive.err.ungrouped))   { ret 3; }

    var argv:        [4]usize          = long_running_argv();
    val res_grouped: res[Child, Error] = spawn_grouped(long_running_path(), (?argv[0])::**u8, Environment.inherit{});
    if (sel res_grouped.err) { ret 4; }
    val child:     Child            = res_grouped.ok;
    val res_alive: res[bool, Error] = group_alive(child);
    if (!(sel res_alive.ok && res_alive.ok)) {
        terminate_group(child);
        wait(child);
        ret 5;
    }
    val err_killed: err[Error] = kill_group(child);
    if (sel err_killed.err) {
        terminate_child(child);
        wait(child);
        ret 6;
    }
    val res_waited: res[ExitStatus, Error] = wait(child);
    if (sel res_waited.err) { ret 7; }
    $if ($mach.build.sys == $mach.sys.windows) {
        if (!exited(res_waited.ok) || code(res_waited.ok) != 137) { ret 8; }
    }
    $or {
        if (!signaled(res_waited.ok) || signal(res_waited.ok) != 9) { ret 8; }
    }
    val res_gone: res[bool, Error] = group_alive(child);
    if (!sel res_gone.ok) { ret 9; }
    if (res_gone.ok)      { ret 10; }
    # the group is empty once its only member is reaped: no failure
    val err_again: err[Error] = kill_group(child);
    if (!sel err_again.ok) { ret 11; }
    ret 0;
}

# a child that finishes inside its deadline is reported as its own outcome, not
# as a termination
test wait_within__child_finishing_first_is_not_terminated {
    var scope:     cancel.Scope;
    val res_clock: tm.InstantClock = tm.instant();
    if (sel res_clock.err) { ret 1; }
    val deadline: tm.Instant       = tm.instant_add(res_clock.ok, 3600000 * duration.MILLISECOND);
    val err_made: cancel.Operation = cancel.make_root(?scope, opt[tm.Instant].some{deadline});
    if (sel err_made.err) { ret 1; }

    var argv:                            [4]usize          = exit_seven_argv();
    val res_spawn_redirected_in_grouped: res[Child, Error] =
        spawn_redirected_in_grouped(long_running_path(), (?argv[0])::**u8, Environment.inherit{}, "", os.INVALID_HANDLE, os.INVALID_HANDLE, os.INVALID_HANDLE);
    if (sel res_spawn_redirected_in_grouped.err) {
        cancel.dnit(?scope);
        ret 2;
    }
    val child: Child = res_spawn_redirected_in_grouped.ok;

    val res_wait_within: res[Supervised, Error] = wait_within(child, ?scope);
    cancel.dnit(?scope);
    if (sel res_wait_within.err) { ret 3; }
    val sup: Supervised = res_wait_within.ok;

    if (sup.terminated)                               { ret 4; }
    if (!sel sup.reason.active)                       { ret 5; }
    if (!exited(sup.status) || code(sup.status) != 7) { ret 6; }
    ret 0;
}

# the deadline is what makes a scope mean anything for a process: a child that
# outlives it is terminated, is still reaped rather than left a zombie, and on
# a grouped spawn takes its grandchildren with it. on linux and darwin the
# child is a shell that backgrounds a grandchild and blocks, so only a group
# termination reaches the grandchild. cmd has no `&` with a way to recover the
# new pid, so on windows the child is a plain long runner
test wait_within__expired_deadline_terminates_and_reaps {
    var argv: [4]usize = long_running_argv();
    var fds:  [2]usize;
    fds[0] = os.INVALID_HANDLE;
    fds[1] = os.INVALID_HANDLE;
    $if ($mach.build.sys != $mach.sys.windows) {
        if (os.pipe(?fds[0], ?fds[1]) < 0) { ret 1; }
        argv[2] = ("sleep 3600 & echo $!; wait")::usize;
    }
    val res_spawn_redirected_in_grouped: res[Child, Error] =
        spawn_redirected_in_grouped(long_running_path(), (?argv[0])::**u8, Environment.inherit{}, "", os.INVALID_HANDLE, fds[1], os.INVALID_HANDLE);
    $if ($mach.build.sys != $mach.sys.windows) { os.close(fds[1]); }
    if (sel res_spawn_redirected_in_grouped.err) {
        $if ($mach.build.sys != $mach.sys.windows) { os.close(fds[0]); }
        ret 2;
    }
    val child: Child = res_spawn_redirected_in_grouped.ok;
    if (child.pgid == 0) {
        $if ($mach.build.sys != $mach.sys.windows) { os.close(fds[0]); }
        terminate_child(child);
        wait(child);
        ret 3;
    }

    # the grandchild's pid, echoed as decimal text
    var grandchild: i64 = 0;
    $if ($mach.build.sys != $mach.sys.windows) {
        var out_buf: [32]u8;
        val n:       i64 = os.read(fds[0], ?out_buf[0], 32);
        os.close(fds[0]);
        var i: usize = 0;
        for (n > 0 && i < n::usize) {
            val c: u8 = out_buf[i];
            if (c >= '0'::u8 && c <= '9'::u8) { grandchild = grandchild * 10 + (c - '0'::u8)::i64; }
            i = i + 1;
        }
        if (grandchild <= 0) {
            terminate_group(child);
            wait(child);
            ret 4;
        }
    }

    var scope:     cancel.Scope;
    val res_clock: tm.InstantClock = tm.instant();
    if (sel res_clock.err) {
        terminate_group(child);
        wait(child);
        ret 5;
    }
    val deadline: tm.Instant       = tm.instant_add(res_clock.ok, 50 * duration.MILLISECOND);
    val err_made: cancel.Operation = cancel.make_root(?scope, opt[tm.Instant].some{deadline});
    if (sel err_made.err) {
        terminate_group(child);
        wait(child);
        ret 5;
    }

    # the child would run for an hour; the deadline is 50ms, so returning at
    # all is the first half of the claim
    val res_wait_within: res[Supervised, Error] = wait_within(child, ?scope);
    cancel.dnit(?scope);
    if (sel res_wait_within.err) { ret 6; }
    val sup: Supervised = res_wait_within.ok;
    if (!sup.terminated)           { ret 7; }
    if (!sel sup.reason.timed_out) { ret 8; }

    # and it was reaped on the way out, so a second wait finds nothing rather
    # than a zombie
    var wstatus:  os.ProcessStatus;
    val consumed: os.WaitResult = os.wait_pid(child.pid, ?wstatus, os.WNOHANG);
    if (consumed.pid != 0 || os.error_kind(consumed.error.code) != io_error.NO_CHILD) { ret 9; }

    # the grandchild was never our own child, so its disappearance is proof
    # the whole group was signalled and not just the process we waited on
    $if ($mach.build.sys != $mach.sys.windows) {
        var gone:  bool  = false;
        var polls: usize = 0;
        for (!gone) {
            # 20 seconds at most, so a grandchild the group signal missed fails here
            if (polls >= 10000) { ret 10; }
            polls = polls + 1;
            $if ($mach.build.sys == $mach.sys.linux) {
                if (linux.getpgid(grandchild) < 0) { gone = true; }
            }
            $or ($mach.build.sys == $mach.sys.darwin) {
                if (darwin.getpgid(grandchild) < 0) { gone = true; }
            }
            if (!gone) { os.sleep(2000000); }
        }
    }
    ret 0;
}

test output__failed_wait_releases_capture_and_retains_the_child {
    var tracking:    process_testing.Testing;
    val err_tracked: err[A.Error] = process_testing.init(?tracking);
    if (sel err_tracked.err) { ret 1; }
    fin { process_testing.dnit(?tracking); }
    var bytes:      Vector[u8]          = vector.init[u8](?tracking.a);
    val res_pushed: res[usize, A.Error] = vector.push[u8](?bytes, 42);
    if (sel res_pushed.err) { ret 2; }
    if (tracking.live != 1) { ret 3; }
    val cause: Error = Error.native{Failure{kind: io_error.PERMISSION, code: -1234, native_code: 5, operation: os.PROCESS_OP_STATUS,
        child: Child{pid: 123, pgid: 123}}};
    val res_failed: res[Output, Error] = finish_output(
        res[Vector[u8], ReadError].ok{bytes}, res[ExitStatus, Error].err{cause});
    if (!sel res_failed.err)        { ret 4; }
    if (!sel res_failed.err.native) { ret 5; }
    val error: Failure = res_failed.err.native;
    if (error.kind != io_error.PERMISSION || error.code != -1234 || error.native_code != 5 || error.operation != os.PROCESS_OP_STATUS
        || error.child.pid != 123 || error.child.pgid != 123) { ret 6; }
    if (tracking.live != 0 || tracking.double_frees != 0) { ret 7; }

    # a failed drain is primary; the wait's failure and its child ride beside it
    val res_both: res[Output, Error] = finish_output(
        res[Vector[u8], ReadError].err{ReadError.eof{3}}, res[ExitStatus, Error].err{cause});
    if (!sel res_both.err)        { ret 8; }
    if (!sel res_both.err.output) { ret 9; }
    val primary: OutputFailure = res_both.err.output;
    if (!sel primary.read.eof)                                                                  { ret 10; }
    if (primary.read.eof != 3 || primary.child.pid != 123 || retained(res_both.err).pid != 123) { ret 11; }
    if (!sel primary.wait.some)                                                                 { ret 12; }
    if (primary.wait.some.code != -1234 || primary.wait.some.native_code != 5
        || primary.wait.some.operation != os.PROCESS_OP_STATUS) { ret 13; }

    # a failed drain after a good wait retains no child and no wait failure
    val res_drained: res[Output, Error] = finish_output(
        res[Vector[u8], ReadError].err{ReadError.eof{0}}, res[ExitStatus, Error].ok{ExitStatus{kind: PROCESS_EXITED}});
    if (!sel res_drained.err)                  { ret 14; }
    if (!sel res_drained.err.output)           { ret 15; }
    if (retained(res_drained.err).pid != 0)    { ret 16; }
    if (!sel res_drained.err.output.wait.none) { ret 17; }
    ret 0;
}

# one spawn applies the directory, the redirection and the group together. on
# linux and darwin the child leads its group, checked by the returned record and
# by an independent getpgid read. on windows Child.pgid is the job handle, not a
# lookup key, so the check is that a job came back and the child, created
# suspended, was resumed and ran to completion
test spawn_with_options__applies_the_directory_the_redirection_and_the_group {
    $if ($mach.build.sys == $mach.sys.windows) {
        var argv:    [4]usize     = argv_ok();
        var options: SpawnOptions = spawn_options();
        options.grouped = true;
        val res_spawn_with_options: res[Child, Error] = spawn_with_options(prog_ok(), (?argv[0])::**u8, Environment.inherit{}, options);
        if (sel res_spawn_with_options.err) { ret 1; }
        val child: Child = res_spawn_with_options.ok;
        var bad:   u8    = 0;
        if (child.pgid == 0)           { bad = 1; }
        if (!exited_zero(wait(child))) { bad = 1; }
        ret bad::i32;
    }
    $or {
        var fds: [2]usize;
        if (os.pipe(?fds[0], ?fds[1]) < 0) { ret 1; }
        var argv: [4]usize;
        argv[0] = ("/bin/sh")::usize;
        argv[1] = ("-c")::usize;
        argv[2] = ("pwd")::usize;
        argv[3] = 0;
        var options: SpawnOptions = spawn_options();
        options.cwd     = "/";
        options.stdout  = fds[1];
        options.grouped = true;
        val res_spawn_with_options: res[Child, Error] = spawn_with_options("/bin/sh", (?argv[0])::**u8, Environment.inherit{}, options);
        os.close(fds[1]);
        if (sel res_spawn_with_options.err) {
            os.close(fds[0]);
            ret 2;
        }
        var out:   [8]u8;
        var total: usize = 0;
        for (total < 8) {
            val n: i64 = os.read(fds[0], (?out[total])::*u8, 8 - total);
            if (n <= 0) { brk; }
            total = total + n::usize;
        }
        os.close(fds[0]);
        val child: Child = res_spawn_with_options.ok;
        # the child is not reaped yet, so its group is still readable
        var native_pgid: i64 = 0;
        $if ($mach.build.sys == $mach.sys.linux) {
            native_pgid = linux.getpgid(child.pid);
        }
        $or ($mach.build.sys == $mach.sys.darwin) {
            native_pgid = darwin.getpgid(child.pid);
        }
        val res_waited: res[ExitStatus, Error] = wait(child);
        if (sel res_waited.err)                                    { ret 3; }
        if (!exited(res_waited.ok) || code(res_waited.ok) != 0)    { ret 4; }
        if (child.pgid != child.pid)                               { ret 5; }
        if (native_pgid != child.pgid)                             { ret 6; }
        if (total != 2 || out[0] != '/'::u8 || out[1] != '\n'::u8) { ret 7; }
        ret 0;
    }
}

#[testing]
fun native_append(buf: *Unit, offset: usize, text: str) usize {
    var i: usize = 0;
    for (text[i] != 0) {
        buf[offset + i] = text[i]::Unit;
        i               = i + 1;
    }
    buf[offset + i] = 0;
    ret offset + i;
}

# the child finds a file named by an argument and by an environment value,
# each with no UTF-8 spelling. on linux the executable is a link to sh and the
# child starts in a directory, both named by bytes that are not UTF-8.
# darwin's filesystems refuse such names
test spawn_native__a_name_with_no_utf_8_spelling_reaches_the_child {
    $if ($mach.build.sys == $mach.sys.linux) {
        var scratch: os.Scratch;
        if (os.scratch_make(?scratch) < 0) { ret 1; }
        fin { filesystem.scratch_remove(?scratch); }
        var directory: [1200]u8;
        var end:       usize = native_append(?directory[0], 0, os.scratch_dir(?scratch));
        end                = native_append(?directory[0], end, "/exec_native_");
        directory[end]     = 0xff;
        directory[end + 1] = 0;
        var program: [1210]u8;
        end              = native_append(?program[0], 0, (?directory[0])::str);
        program[end]     = '/';
        program[end + 1] = 0xfe;
        program[end + 2] = 0;
        var leaf: [2]u8;
        leaf[0] = 0xfe;
        leaf[1] = 0;
        var entry: [8]u8;
        end            = native_append(?entry[0], 0, "M1060=");
        entry[end]     = 0xfe;
        entry[end + 1] = 0;
        var envp: [2]usize;
        envp[0] = (?entry[0])::usize;
        envp[1] = 0;
        if (os.make_dir(os.working_dir(), ?directory[0], 0o700) < 0) { ret 2; }
        var bad: i32 = 0;
        if (os.symlink("/bin/sh", ?program[0]) < 0) { bad = 3; }
        or {
            var argv: [6]usize;
            argv[0] = (?program[0])::usize;
            argv[1] = ("-c")::usize;
            argv[2] = ("test -L \"$1\" && test \"$M1060\" = \"$1\"")::usize;
            argv[3] = ("sh")::usize;
            argv[4] = (?leaf[0])::usize;
            argv[5] = 0;
            var options: NativeSpawnOptions = native_spawn_options();
            options.cwd = ?directory[0];
            val res_child: res[Child, Error] = spawn_native_with_options(?program[0], (?argv[0])::**Unit, NativeEnvironment.given{(?envp[0])::**Unit}, options);
            if (sel res_child.ok) {
                if (!exited_zero(wait(res_child.ok))) { bad = 5; }
            }
            or { bad = 4; }
            os.unlink(os.working_dir(), ?program[0], 0);
        }
        os.unlink(os.working_dir(), ?directory[0], os.AT_REMOVEDIR);
        ret bad;
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        var scratch: os.Scratch;
        if (os.scratch_make(?scratch) < 0) { ret 4; }
        fin { filesystem.scratch_remove(?scratch); }
        var directory: os.ScratchNative;
        if (os.scratch_dir_native(?scratch, ?directory) < 0) { ret 5; }
        var name: [1100]Unit;
        var end:  usize = 0;
        for (directory[end] != 0) {
            name[end] = directory[end];
            end       = end + 1;
        }
        end           = native_append(?name[0], end, "\\mach_std_exec_native_");
        name[end]     = 0xd800;
        name[end + 1] = 0;
        var shell: [32]Unit;
        native_append(?shell[0], 0, "C:\\Windows\\System32\\cmd.exe");
        var flag: [3]Unit;
        native_append(?flag[0], 0, "/c");
        var command: [128]Unit;
        end          = native_append(?command[0], 0, "if not exist mach_std_exec_native_");
        command[end] = 0xd800;
        native_append(?command[0], end + 1, " (exit 9) else if not exist %M1060% (exit 8) else (exit 0)");
        var entry: [48]Unit;
        end            = native_append(?entry[0], 0, "M1060=mach_std_exec_native_");
        entry[end]     = 0xd800;
        entry[end + 1] = 0;
        var root: [24]Unit;
        native_append(?root[0], 0, "SystemRoot=C:\\Windows");
        var envp: [3]usize;
        envp[0] = (?entry[0])::usize;
        envp[1] = (?root[0])::usize;
        envp[2] = 0;
        val res_created: res[filesystem.File, io_error.Error] = filesystem.create_native(?name[0], 0o600);
        if (sel res_created.err) { ret 1; }
        var file: filesystem.File = res_created.ok;
        filesystem.close(?file);
        var argv: [4]usize;
        argv[0] = (?shell[0])::usize;
        argv[1] = (?flag[0])::usize;
        argv[2] = (?command[0])::usize;
        argv[3] = 0;
        var bad:     i32                = 0;
        var options: NativeSpawnOptions = native_spawn_options();
        options.cwd = ?directory[0];
        val res_child: res[Child, Error] = spawn_native_with_options(?shell[0], (?argv[0])::**Unit, NativeEnvironment.given{(?envp[0])::**Unit}, options);
        if (sel res_child.ok) {
            if (!exited_zero(wait(res_child.ok))) { bad = 2; }
        }
        or { bad = 6; }
        val err_removed: err[io_error.Error] = filesystem.remove_file_native(?name[0]);
        if (sel err_removed.err) { bad = 3; }
        ret bad;
    }
    $or {
        ret 77;
    }
}

# a valid environment value reaches the child the same from its UTF-8 and its
# native spelling, which the child compares with an argument
test run_native__a_valid_environment_reaches_the_child_as_its_utf_8_spelling {
    $if ($mach.build.sys == $mach.sys.linux || $mach.build.sys == $mach.sys.darwin) {
        var argv: [6]usize;
        argv[0] = ("/bin/sh")::usize;
        argv[1] = ("-c")::usize;
        argv[2] = ("test \"$M1060\" = \"$1\"")::usize;
        argv[3] = ("sh")::usize;
        argv[4] = ("é😀")::usize;
        argv[5] = 0;
        var envp: [2]usize;
        envp[0] = ("M1060=é😀")::usize;
        envp[1] = 0;
        if (!exited_zero(run("/bin/sh", (?argv[0])::**u8, Environment.given{(?envp[0])::**u8}))) { ret 1; }
        var units: [8]Unit;
        native_append(?units[0], 0, "/bin/sh");
        if (!exited_zero(run_native(?units[0], (?argv[0])::**Unit, NativeEnvironment.given{(?envp[0])::**Unit}))) { ret 2; }
        ret 0;
    }
    $or ($mach.build.sys == $mach.sys.windows) {
        val shell: str = "C:\\Windows\\System32\\cmd.exe";
        var argv:  [4]usize;
        argv[0] = shell::usize;
        argv[1] = ("/c")::usize;
        argv[2] = ("if %M1060%==é😀 (exit 0) else (exit 9)")::usize;
        argv[3] = 0;
        var envp: [3]usize;
        envp[0] = ("M1060=é😀")::usize;
        envp[1] = ("SystemRoot=C:\\Windows")::usize;
        envp[2] = 0;
        if (!exited_zero(run(shell, (?argv[0])::**u8, Environment.given{(?envp[0])::**u8}))) { ret 1; }
        var program: [32]Unit;
        native_append(?program[0], 0, shell);
        var flag: [3]Unit;
        native_append(?flag[0], 0, "/c");
        var command: [48]Unit;
        var end:     usize = native_append(?command[0], 0, "if %M1060%==");
        command[end]     = 0x00e9;
        command[end + 1] = 0xd83d;
        command[end + 2] = 0xde00;
        native_append(?command[0], end + 3, " (exit 0) else (exit 9)");
        var entry: [16]Unit;
        end            = native_append(?entry[0], 0, "M1060=");
        entry[end]     = 0x00e9;
        entry[end + 1] = 0xd83d;
        entry[end + 2] = 0xde00;
        entry[end + 3] = 0;
        var root: [24]Unit;
        native_append(?root[0], 0, "SystemRoot=C:\\Windows");
        var native_argv: [4]usize;
        native_argv[0] = (?program[0])::usize;
        native_argv[1] = (?flag[0])::usize;
        native_argv[2] = (?command[0])::usize;
        native_argv[3] = 0;
        var native_envp: [3]usize;
        native_envp[0] = (?entry[0])::usize;
        native_envp[1] = (?root[0])::usize;
        native_envp[2] = 0;
        if (!exited_zero(run_native(?program[0], (?native_argv[0])::**Unit, NativeEnvironment.given{(?native_envp[0])::**Unit}))) { ret 2; }
        ret 0;
    }
    $or {
        ret 77;
    }
}

#[testing]
fun refused_as_invalid(r: res[Child, Error]) bool {
    if (!sel r.err)        { ret false; }
    if (!sel r.err.native) { ret false; }
    ret r.err.native.kind == io_error.INVALID && r.err.native.child.pid == 0;
}

# a nil given environment is no environment: each spawn and exec refuses it
# as invalid use and starts nothing, in both forms and through the shell
test spawn__a_nil_environment_is_refused {
    var ok: [4]usize = argv_ok();
    if (!refused_as_invalid(spawn(prog_ok(), (?ok[0])::**u8, Environment.given{nil})))         { ret 1; }
    if (!refused_as_invalid(spawn_grouped(prog_ok(), (?ok[0])::**u8, Environment.given{nil}))) { ret 2; }
    if (!refused_as_invalid(spawn_shell("exit 0", nil, Environment.given{nil})))               { ret 3; }
    var program: [64]Unit;
    native_append(?program[0], 0, prog_ok());
    var argv: [2]usize;
    argv[0] = (?program[0])::usize;
    argv[1] = 0;
    if (!refused_as_invalid(spawn_native(?program[0], (?argv[0])::**Unit, NativeEnvironment.given{nil}))) { ret 4; }
    $if ($mach.build.sys == $mach.sys.linux) {
        if (os.error_kind(linux.exec(prog_ok(), (?ok[0])::**u8, Environment.given{nil})) != io_error.INVALID) { ret 5; }
    }
    $or ($mach.build.sys == $mach.sys.darwin) {
        if (os.error_kind(darwin.exec(prog_ok(), (?ok[0])::**u8, Environment.given{nil})) != io_error.INVALID) { ret 5; }
    }
    ret 0;
}

$if ($mach.build.sys == $mach.sys.windows) {
    #[library("kernel32")]
    ext fun SetEnvironmentVariableW(name: *u16, value: *u16) i32;
}

# inherit hands a child this process's own environment unconverted.
# on windows a variable holding an unpaired surrogate reaches the child unit
# for unit through it, and through spawn_native with environ_native, and the
# child finds the file the value names. on linux and darwin the child sees
# PATH as this process holds it
test spawn__the_inherit_form_passes_the_environment_unconverted {
    $if ($mach.build.sys == $mach.sys.windows) {
        var scratch: os.Scratch;
        if (os.scratch_make(?scratch) < 0) { ret 7; }
        fin { filesystem.scratch_remove(?scratch); }
        var directory: os.ScratchNative;
        if (os.scratch_dir_native(?scratch, ?directory) < 0) { ret 8; }
        var name: [1100]Unit;
        var end:  usize = 0;
        for (directory[end] != 0) {
            name[end] = directory[end];
            end       = end + 1;
        }
        end           = native_append(?name[0], end, "\\mach_std_exec_inherit_");
        name[end]     = 0xd800;
        name[end + 1] = 0;
        var variable: [8]Unit;
        native_append(?variable[0], 0, "M1065");
        if (SetEnvironmentVariableW(?variable[0], ?name[0]) == 0) { ret 1; }
        val res_created: res[filesystem.File, io_error.Error] = filesystem.create_native(?name[0], 0o600);
        if (sel res_created.err) { ret 2; }
        var file: filesystem.File = res_created.ok;
        filesystem.close(?file);
        val shell: str = "C:\\Windows\\System32\\cmd.exe";
        val check: str = "if exist \"%M1065%\" (exit 0) else (exit 9)";
        var argv:  [4]usize;
        argv[0] = shell::usize;
        argv[1] = ("/c")::usize;
        argv[2] = check::usize;
        argv[3] = 0;
        var program: [32]Unit;
        native_append(?program[0], 0, shell);
        var flag: [3]Unit;
        native_append(?flag[0], 0, "/c");
        var command: [48]Unit;
        native_append(?command[0], 0, check);
        var native_argv: [4]usize;
        native_argv[0] = (?program[0])::usize;
        native_argv[1] = (?flag[0])::usize;
        native_argv[2] = (?command[0])::usize;
        native_argv[3] = 0;
        var bad: i32 = 0;
        if (!exited_zero(run(shell, (?argv[0])::**u8, Environment.inherit{})))                                                           { bad = 3; }
        if (bad == 0 && !exited_zero(run_native(?program[0], (?native_argv[0])::**Unit, NativeEnvironment.inherit{})))                   { bad = 4; }
        if (bad == 0 && !exited_zero(run_native(?program[0], (?native_argv[0])::**Unit, NativeEnvironment.given{env.environ_native()}))) { bad = 5; }
        val err_removed: err[io_error.Error] = filesystem.remove_file_native(?name[0]);
        if (sel err_removed.err && bad == 0) { bad = 6; }
        SetEnvironmentVariableW(?variable[0], nil);
        ret bad;
    }
    $or {
        var path:           [4096]u8;
        val res_path_entry: res[opt[usize], env.EnvError] = env.get("PATH", ?path[0], 4096);
        if (!sel res_path_entry.ok)         { ret 1; }
        if (!sel res_path_entry.ok.some)    { ret 77; }
        if (res_path_entry.ok.some >= 4096) { ret 77; }
        var argv: [6]usize;
        argv[0] = ("/bin/sh")::usize;
        argv[1] = ("-c")::usize;
        argv[2] = ("test \"$PATH\" = \"$1\"")::usize;
        argv[3] = ("sh")::usize;
        argv[4] = (?path[0])::usize;
        argv[5] = 0;
        if (!exited_zero(run("/bin/sh", (?argv[0])::**u8, Environment.inherit{}))) { ret 2; }
        var program: [8]Unit;
        native_append(?program[0], 0, "/bin/sh");
        if (!exited_zero(run_native(?program[0], (?argv[0])::**Unit, NativeEnvironment.inherit{})))                   { ret 3; }
        if (!exited_zero(run_native(?program[0], (?argv[0])::**Unit, NativeEnvironment.given{env.environ_native()}))) { ret 4; }
        ret 0;
    }
}
