# per-process resource limits
#
# the open-file limit bounds how many descriptors a process may hold, so a
# server that expects many connections raises it at startup. the limit itself
# is read and set through the os contract; this module holds no OS knowledge

use std.types.error.err;
use std.types.result.res;

use io_error: std.io.error;
use std.system.os;

fwd os.FileLimit;
fwd os.MemoryLimit;
fwd os.LIMIT_UNLIMITED;

# read the open-file limit
# ---
# ret: the soft limit in force, the hard limit, and the highest soft limit
#      this process may set, or the failure. UNSUPPORTED where the platform
#      has no such limit
pub fun open_files() res[os.FileLimit, io_error.Error] {
    var limit:  os.FileLimit;
    val result: i64 = os.open_file_limit(?limit);
    if (result < 0) { ret res[os.FileLimit, io_error.Error].err{os.error(result, io_error.OP_OPTION)}; }
    ret res[os.FileLimit, io_error.Error].ok{limit};
}

# set the open-file limit
#
# a soft limit above the hard one is INVALID, and raising the hard limit
# without privilege is PERMISSION. the record's ceiling is ignored
# ---
# limit: the soft and hard limits to set
# ret:   success, or the failure
pub fun set_open_files(limit: os.FileLimit) err[io_error.Error] {
    val result: i64 = os.set_open_file_limit(limit);
    if (result < 0) { ret err[io_error.Error].err{os.error(result, io_error.OP_OPTION)}; }
    ret err[io_error.Error].ok{};
}

# raise the soft open-file limit as far as this process may, leaving the hard
# limit unchanged
# ---
# ret: the limit now in force, or the failure
pub fun raise_open_files() res[os.FileLimit, io_error.Error] {
    val res_current: res[os.FileLimit, io_error.Error] = open_files();
    if (sel res_current.err) { ret res_current; }
    var raised: os.FileLimit = res_current.ok;
    raised.soft = raised.ceiling;
    val err_set: err[io_error.Error] = set_open_files(raised);
    if (sel err_set.err) { ret res[os.FileLimit, io_error.Error].err{err_set.err}; }
    ret open_files();
}

# read the locked-memory limit in bytes
# ---
# ret: the soft and hard limits in force, or the failure. UNSUPPORTED where the
#      platform has no per-process lock limit
pub fun locked_memory() res[os.MemoryLimit, io_error.Error] {
    var limit:  os.MemoryLimit;
    val result: i64 = os.locked_memory_limit(?limit);
    if (result < 0) { ret res[os.MemoryLimit, io_error.Error].err{os.error(result, io_error.OP_OPTION)}; }
    ret res[os.MemoryLimit, io_error.Error].ok{limit};
}

$if ($mach.build.sys != $mach.sys.windows) {
    test process_limits__the_soft_limit_lowers_and_rises_within_the_hard_one {
        val res_original: res[os.FileLimit, io_error.Error] = open_files();
        # a host with no open-file limit cannot run this
        if (sel res_original.err && res_original.err.kind == io_error.UNSUPPORTED) { ret 77; }
        if (sel res_original.err)                                                  { ret 1; }
        val start: os.FileLimit = res_original.ok;
        if (start.soft > start.hard || start.ceiling > start.hard || start.soft < 64) { ret 2; }
        var lowered: os.FileLimit = start;
        lowered.soft = 64;
        val err_applied1: err[io_error.Error] = set_open_files(lowered);
        if (sel err_applied1.err) { ret 3; }
        val res_low: res[os.FileLimit, io_error.Error] = open_files();
        if (sel res_low.err)                                           { ret 4; }
        if (!(res_low.ok.soft == 64 && res_low.ok.hard == start.hard)) { ret 4; }
        val err_applied2: err[io_error.Error] = set_open_files(start);
        if (sel err_applied2.err) { ret 5; }
        val res_back: res[os.FileLimit, io_error.Error] = open_files();
        if (sel res_back.err)                                                    { ret 6; }
        if (!(res_back.ok.soft == start.soft && res_back.ok.hard == start.hard)) { ret 6; }
        ret 0;
    }

    test process_limits__raising_the_soft_limit_reaches_the_ceiling {
        val res_original: res[os.FileLimit, io_error.Error] = open_files();
        # a host with no open-file limit cannot run this
        if (sel res_original.err && res_original.err.kind == io_error.UNSUPPORTED) { ret 77; }
        if (sel res_original.err)                                                  { ret 1; }
        val start:      os.FileLimit                      = res_original.ok;
        val res_raised: res[os.FileLimit, io_error.Error] = raise_open_files();
        if (sel res_raised.err)                                                      { ret 2; }
        if (res_raised.ok.soft != start.ceiling || res_raised.ok.hard != start.hard) { ret 3; }
        val err_applied4: err[io_error.Error] = set_open_files(start);
        if (sel err_applied4.err) { ret 4; }
        ret 0;
    }

    test process_limits__locked_memory_reports_soft_within_hard {
        val res_limit: res[os.MemoryLimit, io_error.Error] = locked_memory();
        if (sel res_limit.err && res_limit.err.kind == io_error.UNSUPPORTED) { ret 77; }
        if (sel res_limit.err)                                               { ret 1; }
        if (res_limit.ok.soft > res_limit.ok.hard)                           { ret 2; }
        ret 0;
    }
}
