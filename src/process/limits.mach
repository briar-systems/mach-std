# per-process resource limits
#
# the open-file limit bounds how many descriptors a process may hold, so a
# server that expects many connections raises it at startup. the limit itself
# is read and set through the os contract; this module holds no OS knowledge

use std.types.error.err;
use std.types.result.res;

use io_error: std.io.error;
use std.system.os;

fwd os.FileLimit;
fwd os.LIMIT_UNLIMITED;

# read the open-file limit
# ---
# ret: the soft limit in force, the hard limit, and the highest soft limit
#      this process may set, or the failure. UNSUPPORTED where the platform
#      has no such limit
pub fun open_files() res[os.FileLimit, io_error.Error] {
    var limit:  os.FileLimit;
    val result: i64 = os.open_file_limit(?limit);
    if (result < 0) { ret res[os.FileLimit, io_error.Error].err{os.error(result, io_error.OP_OPTION)}; }
    ret res[os.FileLimit, io_error.Error].ok{limit};
}

# set the open-file limit
#
# a soft limit above the hard one is INVALID, and raising the hard limit
# without privilege is PERMISSION. the record's ceiling is ignored
# ---
# limit: the soft and hard limits to set
# ret:   success, or the failure
pub fun set_open_files(limit: os.FileLimit) err[io_error.Error] {
    val result: i64 = os.set_open_file_limit(limit);
    if (result < 0) { ret err[io_error.Error].err{os.error(result, io_error.OP_OPTION)}; }
    ret err[io_error.Error].ok{};
}

# raise the soft open-file limit as far as this process may, leaving the hard
# limit unchanged
# ---
# ret: the limit now in force, or the failure
pub fun raise_open_files() res[os.FileLimit, io_error.Error] {
    val current: res[os.FileLimit, io_error.Error] = open_files();
    if (sel current.err) { ret current; }
    var raised: os.FileLimit = current.ok;
    raised.soft = raised.ceiling;
    val set: err[io_error.Error] = set_open_files(raised);
    if (sel set.err) { ret res[os.FileLimit, io_error.Error].err{set.err}; }
    ret open_files();
}

$if ($mach.build.os == $mach.os.windows) {
    test process_limits__windows_has_no_open_file_limit {
        val read: res[os.FileLimit, io_error.Error] = open_files();
        if (!sel read.err)                         { ret 1; }
        if (read.err.kind != io_error.UNSUPPORTED) { ret 1; }
        var limit: os.FileLimit;
        val set:   err[io_error.Error] = set_open_files(limit);
        if (!sel set.err)                         { ret 2; }
        if (set.err.kind != io_error.UNSUPPORTED) { ret 2; }
        val raised: res[os.FileLimit, io_error.Error] = raise_open_files();
        if (!sel raised.err)                         { ret 3; }
        if (raised.err.kind != io_error.UNSUPPORTED) { ret 3; }
        ret 0;
    }
}
$or {
    test process_limits__the_soft_limit_lowers_and_rises_within_the_hard_one {
        val original: res[os.FileLimit, io_error.Error] = open_files();
        if (sel original.err) { ret 1; }
        val start: os.FileLimit = original.ok;
        if (start.soft > start.hard || start.ceiling > start.hard || start.soft < 64) { ret 2; }
        var lowered: os.FileLimit = start;
        lowered.soft = 64;
        val applied1: err[io_error.Error] = set_open_files(lowered);
        if (sel applied1.err) { ret 3; }
        val low: res[os.FileLimit, io_error.Error] = open_files();
        if (sel low.err)                                       { ret 4; }
        if (!(low.ok.soft == 64 && low.ok.hard == start.hard)) { ret 4; }
        val applied2: err[io_error.Error] = set_open_files(start);
        if (sel applied2.err) { ret 5; }
        val back: res[os.FileLimit, io_error.Error] = open_files();
        if (sel back.err)                                                { ret 6; }
        if (!(back.ok.soft == start.soft && back.ok.hard == start.hard)) { ret 6; }
        ret 0;
    }

    test process_limits__a_soft_limit_above_the_hard_one_is_invalid {
        val original: res[os.FileLimit, io_error.Error] = open_files();
        if (sel original.err) { ret 1; }
        val start: os.FileLimit = original.ok;
        if (start.hard == os.LIMIT_UNLIMITED) { ret 0; }
        var over: os.FileLimit = start;
        over.soft = start.hard + 1;
        val set: err[io_error.Error] = set_open_files(over);
        if (!sel set.err)                     { ret 2; }
        if (set.err.kind != io_error.INVALID) { ret 2; }
        val after: res[os.FileLimit, io_error.Error] = open_files();
        if (sel after.err)                                                 { ret 3; }
        if (!(after.ok.soft == start.soft && after.ok.hard == start.hard)) { ret 3; }
        ret 0;
    }

    # an unprivileged process may not raise its hard limit. a privileged one
    # may, and then the test restores the limit and has nothing to refute
    test process_limits__raising_the_hard_limit_needs_privilege {
        val original: res[os.FileLimit, io_error.Error] = open_files();
        if (sel original.err) { ret 1; }
        val start: os.FileLimit = original.ok;
        if (start.hard == os.LIMIT_UNLIMITED) { ret 0; }
        var higher: os.FileLimit = start;
        higher.hard = start.hard + 1;
        val set: err[io_error.Error] = set_open_files(higher);
        if (sel set.err) {
            if (set.err.kind != io_error.PERMISSION) { ret 2; }
            ret 0;
        }
        val applied3: err[io_error.Error] = set_open_files(start);
        if (sel applied3.err) { ret 3; }
        ret 0;
    }

    test process_limits__raising_the_soft_limit_reaches_the_ceiling {
        val original: res[os.FileLimit, io_error.Error] = open_files();
        if (sel original.err) { ret 1; }
        val start:  os.FileLimit                      = original.ok;
        val raised: res[os.FileLimit, io_error.Error] = raise_open_files();
        if (sel raised.err)                                                  { ret 2; }
        if (raised.ok.soft != start.ceiling || raised.ok.hard != start.hard) { ret 3; }
        val applied4: err[io_error.Error] = set_open_files(start);
        if (sel applied4.err) { ret 4; }
        ret 0;
    }
}
