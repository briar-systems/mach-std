# portable process lifecycle events

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.system.os;
use std.sync.atomic;
use std.io.lifecycle;
use io_runtime: std.io.runtime;
use io_error: std.io.error;


$if ($mach.build.os == $mach.os.linux) {
    use std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use std.system.os.darwin.libsystem;
}
$or ($mach.build.os == $mach.os.windows) {
    #[library("kernel32.dll")]
    ext fun SetConsoleCtrlHandler(handler: usize, add: i32) i32;
}
$or {
    $error("std.process.events: unsupported target");
}

pub def Kind: u8;
pub val SERVICE_STOP: Kind = 0;
pub val CONSOLE_CLOSE: Kind = 1;
pub val TERMINATE: Kind = 2;
pub val INTERRUPT: Kind = 3;
pub val RELOAD: Kind = 4;

pub rec Event {
    kind: Kind;
}

pub rec Capabilities {
    terminate: bool;
    interrupt: bool;
    reload: bool;
    console_close: bool;
    service_stop: bool;
}

pub rec Source {
    generation: i64;
    owns_queue: bool;
    runtime: *io_runtime.Runtime;
    registration: io_runtime.SourceToken;
    registered: bool;
}

val STATE_IDLE: i64 = 0;
val STATE_CONFIGURING: i64 = 1;
val STATE_OPEN: i64 = 2;
val STATE_CLOSING: i64 = 3;

val BIT_SERVICE_STOP: i64 = 1;
val BIT_CONSOLE_CLOSE: i64 = 2;
val BIT_TERMINATE: i64 = 4;
val BIT_INTERRUPT: i64 = 8;
val BIT_RELOAD: i64 = 16;

var global_state: i64 = STATE_IDLE;
var global_generation: i64 = 0;
var global_pending: i64 = 0;
var global_handlers: i64 = 0;
var global_queue: i64 = 0;
var global_owned_queue: os.IoQueue;
var global_native: [12]usize;

fun source_open(source: *Source) bool {
    if (source == nil || atomic.load(?global_state) != STATE_OPEN) { ret false; }
    ret source.generation == atomic.load(?global_generation);
}

fun event_bit(code: i32) i64 {
    $if ($mach.build.os == $mach.os.windows) {
        if (code == 0) { ret BIT_INTERRUPT; }
        if (code == 1) { ret BIT_TERMINATE; }
        if (code == 2 || code == 5 || code == 6) { ret BIT_CONSOLE_CLOSE; }
        ret 0;
    }
    $or {
        if (code == 1) { ret BIT_RELOAD; }
        if (code == 2) { ret BIT_INTERRUPT; }
        if (code == 15) { ret BIT_TERMINATE; }
        ret 0;
    }
}

fun publish_bit(bit: i64) bool {
    var current: i64 = atomic.load(?global_pending);
    for ((current & bit) == 0) {
        var expected: i64 = current;
        if (atomic.cas(?global_pending, ?expected, current | bit)) { ret current == 0; }
        current = expected;
    }
    ret false;
}

# native handlers only publish bits and wake the configured wait queue
fun native_event(code: i32) i32 {
    if (atomic.load(?global_state) != STATE_OPEN) { ret 0; }
    atomic.fetch_add(?global_handlers, 1);
    if (atomic.load(?global_state) != STATE_OPEN) {
        atomic.fetch_add(?global_handlers, -1);
        ret 0;
    }
    val bit: i64 = event_bit(code);
    if (bit != 0) {
        if (publish_bit(bit)) {
            val queue: i64 = atomic.load(?global_queue);
            if (queue != 0) { os.io_queue_wake(queue::*os.IoQueue); }
        }
    }
    atomic.fetch_add(?global_handlers, -1);
    if (bit != 0) { ret 1; }
    ret 0;
}

# test predicates: `sel` takes a place, so an inline call is tested through these
fun ok_err(r: err[io_error.Error]) bool { ret sel r.ok; }
fun ok_bool(r: res[bool, io_error.Error]) bool { ret sel r.ok; }

$if ($mach.build.os == $mach.os.linux && $mach.build.arch == $mach.arch.x86_64) {
    #[symbol("_std_process_rt_sigreturn")]
    fun linux_sigreturn() {
        asm x86_64 {
            mov rax, 15
            syscall
        }
    }
}

fun native_install() i64 {
    $if ($mach.build.os == $mach.os.linux) {
        var syscall_number: usize = 134;
        var mask_index: usize = 2;
        var flags: usize = 0;
        var restorer: usize = 0;
        $if ($mach.build.arch == $mach.arch.x86_64) {
            syscall_number = 13;
            mask_index = 3;
            flags = 0x04000000;
            restorer = linux_sigreturn::usize;
        }
        $or ($mach.build.arch == $mach.arch.aarch64) {
            mask_index = 3;
        }
        var action: [4]usize;
        action[0] = native_event::usize;
        action[1] = flags;
        action[2] = restorer;
        action[3] = 0;
        action[mask_index] = (1 << (1 - 1)) | (1 << (2 - 1)) | (1 << (15 - 1));
        var installed: usize = 0;
        var signals: [3]usize;
        signals[0] = 15;
        signals[1] = 2;
        signals[2] = 1;
        var i: usize = 0;
        for (i < 3) {
            val result: i64 = linux.syscall4(syscall_number, signals[i], (?action[0])::usize, (?global_native[i * 4])::usize, 8);
            if (result < 0) {
                for (installed > 0) {
                    installed = installed - 1;
                    linux.syscall4(syscall_number, signals[installed], (?global_native[installed * 4])::usize, 0, 8);
                }
                ret result;
            }
            installed = installed + 1;
            i = i + 1;
        }
        ret 0;
    }
    $or ($mach.build.os == $mach.os.darwin) {
        var action: [2]usize;
        action[0] = native_event::usize;
        action[1] = ((1 << (1 - 1)) | (1 << (2 - 1)) | (1 << (15 - 1)))::usize;
        var signals: [3]i32;
        signals[0] = 15;
        signals[1] = 2;
        signals[2] = 1;
        var installed: usize = 0;
        var i: usize = 0;
        for (i < 3) {
            if (libsystem.sigaction(signals[i], ?action[0], ?global_native[i * 2]) != 0) {
                val result: i64 = libsystem.fail_errno();
                for (installed > 0) {
                    installed = installed - 1;
                    libsystem.sigaction(signals[installed], ?global_native[installed * 2], nil);
                }
                ret result;
            }
            installed = installed + 1;
            i = i + 1;
        }
        ret 0;
    }
    $or {
        if (SetConsoleCtrlHandler(native_event::usize, 1) == 0) { ret os.EINVAL; }
        ret 0;
    }
}

fun native_restore() i64 {
    $if ($mach.build.os == $mach.os.linux) {
        var syscall_number: usize = 134;
        $if ($mach.build.arch == $mach.arch.x86_64) { syscall_number = 13; }
        var signals: [3]usize;
        signals[0] = 15;
        signals[1] = 2;
        signals[2] = 1;
        var result: i64 = 0;
        var i: usize = 3;
        for (i > 0) {
            i = i - 1;
            val restored: i64 = linux.syscall4(syscall_number, signals[i], (?global_native[i * 4])::usize, 0, 8);
            if (restored < 0 && result == 0) { result = restored; }
        }
        ret result;
    }
    $or ($mach.build.os == $mach.os.darwin) {
        var signals: [3]i32;
        signals[0] = 15;
        signals[1] = 2;
        signals[2] = 1;
        var result: i64 = 0;
        var i: usize = 3;
        for (i > 0) {
            i = i - 1;
            if (libsystem.sigaction(signals[i], ?global_native[i * 2], nil) != 0 && result == 0) { result = libsystem.fail_errno(); }
        }
        ret result;
    }
    $or {
        if (SetConsoleCtrlHandler(native_event::usize, 0) == 0) { ret os.EINVAL; }
        ret 0;
    }
}

fun native_raise(code: i32) i64 {
    $if ($mach.build.os == $mach.os.linux) {
        var syscall_number: usize = 129;
        $if ($mach.build.arch == $mach.arch.x86_64) { syscall_number = 62; }
        ret linux.syscall2(syscall_number, os.getpid()::usize, code::usize);
    }
    $or ($mach.build.os == $mach.os.darwin) {
        if (libsystem.raise(code) != 0) { ret libsystem.fail_errno(); }
        ret 0;
    }
    $or {
        ret native_event(code)::i64 - 1;
    }
}

fun configure_claimed(source: *Source, queue: *os.IoQueue, owned: bool) i64 {
    if (source == nil || queue == nil) { ret os.EINVAL; }
    atomic.store(?global_pending, 0);
    atomic.store(?global_handlers, 0);
    atomic.store(?global_queue, queue::i64);
    val generation: i64 = atomic.fetch_add(?global_generation, 1) + 1;
    source.generation = generation;
    source.owns_queue = owned;
    atomic.store(?global_state, STATE_OPEN);
    val installed: i64 = native_install();
    if (installed < 0) {
        atomic.store(?global_state, STATE_CLOSING);
        for (atomic.load(?global_handlers) != 0) { atomic.spin_hint(); }
        atomic.store(?global_queue, 0);
        atomic.store(?global_state, STATE_IDLE);
        ret installed;
    }
    ret 0;
}

fun failure(code: i64, operation: io_error.Operation) err[io_error.Error] {
    ret err[io_error.Error].err{io_error.from_code(code, operation)};
}

# claim the process's event source with its own wait queue
# ---
# ret: EBUSY when another source owns the process, or the native failure
pub fun make(source: *Source) err[io_error.Error] {
    if (source == nil) { ret failure(os.EINVAL, io_error.OP_CREATE); }
    source.runtime = nil;
    source.registered = false;
    var expected: i64 = STATE_IDLE;
    if (!atomic.cas(?global_state, ?expected, STATE_CONFIGURING)) { ret failure(os.EBUSY, io_error.OP_CREATE); }
    val created: i64 = os.io_queue_create(?global_owned_queue);
    if (created < 0) {
        atomic.store(?global_state, STATE_IDLE);
        ret failure(created, io_error.OP_CREATE);
    }
    val configured: i64 = configure_claimed(source, ?global_owned_queue, true);
    if (configured < 0) {
        os.io_queue_close(?global_owned_queue);
        ret failure(configured, io_error.OP_CREATE);
    }
    ret err[io_error.Error].ok{};
}

fun runtime_dispatch(context: ptr, native_context: usize, events: u32, status: i64, flags: u64) bool {
    ret false;
}

fun runtime_cancel(context: ptr, token: io_runtime.Token, reason: io_error.Error) i64 {
    ret 0;
}

fun runtime_release(context: ptr, completion: *io_runtime.Completion) {
}

# the source must close before the runtime whose queue it borrows
pub fun make_runtime(source: *Source, runtime: *io_runtime.Runtime) err[io_error.Error] {
    if (source == nil || runtime == nil) { ret failure(os.EINVAL, io_error.OP_CREATE); }
    if (io_runtime.snapshot(runtime).state != io_runtime.OPEN) { ret failure(os.EBADF, io_error.OP_CREATE); }
    var expected: i64 = STATE_IDLE;
    if (!atomic.cas(?global_state, ?expected, STATE_CONFIGURING)) { ret failure(os.EBUSY, io_error.OP_CREATE); }
    source.runtime = runtime;
    source.registered = false;
    val registered: res[io_runtime.SourceToken, io_error.Error] = io_runtime.register_source(
        runtime,
        source::ptr,
        runtime_dispatch,
        runtime_cancel,
        runtime_release,
    );
    if (sel registered.err) {
        source.runtime = nil;
        atomic.store(?global_state, STATE_IDLE);
        ret err[io_error.Error].err{registered.err};
    }
    source.registration = registered.ok;
    source.registered = true;
    val configured: i64 = configure_claimed(source, ?runtime.queue, false);
    if (configured < 0) {
        io_runtime.unregister_source(runtime, source.registration);
        source.runtime = nil;
        source.registered = false;
        ret failure(configured, io_error.OP_CREATE);
    }
    ret err[io_error.Error].ok{};
}

pub fun capabilities() Capabilities {
    $if ($mach.build.os == $mach.os.windows) {
        ret Capabilities{terminate: true, interrupt: true, reload: false, console_close: true, service_stop: true};
    }
    $or {
        ret Capabilities{terminate: true, interrupt: true, reload: true, console_close: false, service_stop: false};
    }
}

# windows service handlers call this for stop, shutdown, or preshutdown control
pub fun notify_service_stop(source: *Source) err[io_error.Error] {
    $if ($mach.build.os == $mach.os.windows) {
        if (!source_open(source)) { ret failure(os.EBADF, io_error.OP_WAKE); }
        if (publish_bit(BIT_SERVICE_STOP)) {
            val queue: i64 = atomic.load(?global_queue);
            if (queue != 0) {
                val woken: i64 = os.io_queue_wake(queue::*os.IoQueue);
                if (woken < 0) { ret failure(woken, io_error.OP_WAKE); }
            }
        }
        ret err[io_error.Error].ok{};
    }
    $or {
        ret failure(os.ENOTSUP, io_error.OP_WAKE);
    }
}

fun take_bit(bit: i64) bool {
    var current: i64 = atomic.load(?global_pending);
    for ((current & bit) != 0) {
        var expected: i64 = current;
        if (atomic.cas(?global_pending, ?expected, current & ~bit)) { ret true; }
        current = expected;
    }
    ret false;
}

fun taken(kind: Kind) res[opt[Event], io_error.Error] {
    ret res[opt[Event], io_error.Error].ok{opt[Event].some{Event{kind: kind}}};
}

# events are coalesced by kind and drained in service-to-reload priority order
# ---
# ret: the next pending event, absent when none is pending, or EBADF for a
#      source that is not the open owner
pub fun next(source: *Source) res[opt[Event], io_error.Error] {
    if (!source_open(source)) {
        ret res[opt[Event], io_error.Error].err{io_error.from_code(os.EBADF, io_error.OP_READ)};
    }
    if (take_bit(BIT_SERVICE_STOP)) { ret taken(SERVICE_STOP); }
    if (take_bit(BIT_CONSOLE_CLOSE)) { ret taken(CONSOLE_CLOSE); }
    if (take_bit(BIT_TERMINATE)) { ret taken(TERMINATE); }
    if (take_bit(BIT_INTERRUPT)) { ret taken(INTERRUPT); }
    if (take_bit(BIT_RELOAD)) { ret taken(RELOAD); }
    ret res[opt[Event], io_error.Error].ok{opt[Event].none{}};
}

pub fun begin_runtime_drain(
    source: *Source,
    runtime: *io_runtime.Runtime,
    event: Event,
) res[lifecycle.CloseResult, io_error.Error] {
    if (!source_open(source) || runtime == nil || event.kind == RELOAD) {
        ret res[lifecycle.CloseResult, io_error.Error].err{io_error.from_code(os.EINVAL, io_error.OP_CLOSE)};
    }
    ret io_runtime.begin_close(runtime, lifecycle.GRACEFUL, lifecycle.PROCESS_TERMINATION);
}

# standalone sources may wait directly, runtime-attached sources use runtime wait
# ---
# ret: whether an event is pending after the wait, or the failure
pub fun wait(source: *Source, timeout_ms: i32) res[bool, io_error.Error] {
    if (!source_open(source) || !source.owns_queue || timeout_ms < -1) {
        ret res[bool, io_error.Error].err{io_error.from_code(os.EINVAL, io_error.OP_WAIT)};
    }
    if (atomic.load(?global_pending) != 0) { ret res[bool, io_error.Error].ok{true}; }
    val waited: i64 = os.io_queue_wait(?global_owned_queue, timeout_ms);
    if (waited < 0) { ret res[bool, io_error.Error].err{io_error.from_code(waited, io_error.OP_WAIT)}; }
    ret res[bool, io_error.Error].ok{atomic.load(?global_pending) != 0};
}

# release the process's event source: the native handlers are restored, the
# owned queue closed and the runtime registration released; the first
# refusal is reported after every step has run
pub fun close(source: *Source) err[io_error.Error] {
    if (!source_open(source)) { ret failure(os.EBADF, io_error.OP_CLOSE); }
    var expected: i64 = STATE_OPEN;
    if (!atomic.cas(?global_state, ?expected, STATE_CLOSING)) { ret failure(os.EBUSY, io_error.OP_CLOSE); }
    val restored: i64 = native_restore();
    for (atomic.load(?global_handlers) != 0) { atomic.spin_hint(); }
    atomic.store(?global_queue, 0);
    atomic.store(?global_pending, 0);
    var queue_result: i64 = 0;
    if (source.owns_queue) { queue_result = os.io_queue_close(?global_owned_queue); }
    source.owns_queue = false;
    atomic.store(?global_state, STATE_IDLE);
    if (restored < 0) { ret failure(restored, io_error.OP_CLOSE); }
    if (source.registered) {
        val unregistered: err[io_error.Error] = io_runtime.unregister_source(source.runtime, source.registration);
        if (sel unregistered.err) { ret unregistered; }
        source.runtime = nil;
        source.registered = false;
    }
    if (queue_result < 0) { ret failure(queue_result, io_error.OP_CLOSE); }
    ret err[io_error.Error].ok{};
}

fun next_is(source: *Source, kind: Kind) bool {
    val got: res[opt[Event], io_error.Error] = next(source);
    if (!sel got.ok) { ret false; }
    if (!sel got.ok.some) { ret false; }
    ret got.ok.some.kind == kind;
}

fun next_is_absent(source: *Source) bool {
    val got: res[opt[Event], io_error.Error] = next(source);
    if (!sel got.ok) { ret false; }
    ret sel got.ok.none;
}

fun waited_pending(source: *Source, timeout_ms: i32) bool {
    val waited: res[bool, io_error.Error] = wait(source, timeout_ms);
    ret sel waited.ok && waited.ok;
}

fun closed(source: *Source) bool {
    val done: err[io_error.Error] = close(source);
    ret sel done.ok;
}

test "process events: coalescing and priority are deterministic" {
    var source: Source;
    if (!ok_err(make(?source))) { ret 1; }
    publish_bit(BIT_RELOAD);
    publish_bit(BIT_INTERRUPT);
    publish_bit(BIT_TERMINATE);
    publish_bit(BIT_TERMINATE);
    publish_bit(BIT_CONSOLE_CLOSE);
    publish_bit(BIT_SERVICE_STOP);
    if (!next_is(?source, SERVICE_STOP)) { close(?source); ret 2; }
    if (!next_is(?source, CONSOLE_CLOSE)) { close(?source); ret 3; }
    if (!next_is(?source, TERMINATE)) { close(?source); ret 4; }
    if (!next_is(?source, INTERRUPT)) { close(?source); ret 5; }
    if (!next_is(?source, RELOAD)) { close(?source); ret 6; }
    if (!next_is_absent(?source)) { close(?source); ret 7; }
    if (!closed(?source)) { ret 8; }
    # a closed source is no longer the owner: next and close are EBADF
    val stale: res[opt[Event], io_error.Error] = next(?source);
    if (!sel stale.err) { ret 9; }
    if (stale.err.code != os.EBADF) { ret 10; }
    val again: err[io_error.Error] = close(?source);
    if (!sel again.err) { ret 11; }
    if (again.err.code != os.EBADF) { ret 12; }
    ret 0;
}

test "process events: only one process owner can register" {
    var first: Source;
    var second: Source;
    if (!ok_err(make(?first))) { ret 1; }
    val refused: err[io_error.Error] = make(?second);
    if (!sel refused.err) { close(?first); ret 2; }
    if (refused.err.code != os.EBUSY) { close(?first); ret 3; }
    if (!closed(?first)) { ret 4; }
    ret 0;
}

test "process events: native delivery wakes a standalone source" {
    var source: Source;
    if (!ok_err(make(?source))) { ret 1; }
    var signals: [3]i32;
    var kinds: [3]Kind;
    var count: usize = 3;
    signals[0] = 15;
    signals[1] = 2;
    signals[2] = 1;
    kinds[0] = TERMINATE;
    kinds[1] = INTERRUPT;
    kinds[2] = RELOAD;
    $if ($mach.build.os == $mach.os.windows) {
        count = 2;
        signals[0] = 1;
        signals[1] = 0;
    }
    # nothing pending: the wait reports false rather than an event
    if (waited_pending(?source, 0)) { close(?source); ret 2; }
    var i: usize = 0;
    for (i < count) {
        if (native_raise(signals[i]) < 0 || !waited_pending(?source, 1000)) { close(?source); ret 3; }
        if (!next_is(?source, kinds[i])) { close(?source); ret 4; }
        i = i + 1;
    }
    $if ($mach.build.os == $mach.os.windows) {
        if (!ok_err(notify_service_stop(?source)) || !waited_pending(?source, 1000)) { close(?source); ret 5; }
        if (!next_is(?source, SERVICE_STOP)) { close(?source); ret 6; }
    }
    if (!closed(?source)) { ret 7; }
    ret 0;
}

test "process events: native delivery wakes the standard runtime" {
    var runtime: io_runtime.Runtime;
    val made: err[io_error.Error] = io_runtime.make(?runtime, 2);
    if (sel made.err) { ret 1; }
    var source: Source;
    if (!ok_err(make_runtime(?source, ?runtime))) { io_runtime.close(?runtime); io_runtime.destroy(?runtime); ret 1; }
    # a runtime-attached source has no queue of its own to wait on
    val direct: res[bool, io_error.Error] = wait(?source, 0);
    if (!sel direct.err) { close(?source); io_runtime.close(?runtime); io_runtime.destroy(?runtime); ret 2; }
    var native_code: i32 = 15;
    $if ($mach.build.os == $mach.os.windows) { native_code = 1; }
    if (native_raise(native_code) < 0) { close(?source); io_runtime.close(?runtime); io_runtime.destroy(?runtime); ret 3; }
    var completions: [2]io_runtime.Completion;
    val waited: res[usize, io_error.Error] = io_runtime.wait(?runtime, ?completions[0], 2, 1000);
    if (sel waited.err) { close(?source); io_runtime.close(?runtime); io_runtime.destroy(?runtime); ret 4; }
    if (waited.ok != 0) { close(?source); io_runtime.close(?runtime); io_runtime.destroy(?runtime); ret 5; }
    if (!next_is(?source, TERMINATE)) { close(?source); io_runtime.close(?runtime); io_runtime.destroy(?runtime); ret 6; }
    if (!closed(?source) || !ok_bool(io_runtime.close(?runtime)) || !ok_err(io_runtime.destroy(?runtime))) { ret 7; }
    ret 0;
}

test "process events: termination begins the runtime drain hierarchy" {
    var runtime: io_runtime.Runtime;
    if (!ok_err(io_runtime.make(?runtime, 1))) { ret 1; }
    var source: Source;
    if (!ok_err(make_runtime(?source, ?runtime))) { ret 2; }
    val reload: res[lifecycle.CloseResult, io_error.Error] = begin_runtime_drain(?source, ?runtime, Event{kind: RELOAD});
    if (!sel reload.err) { ret 3; }
    val drained: res[lifecycle.CloseResult, io_error.Error] = begin_runtime_drain(?source, ?runtime, Event{kind: TERMINATE});
    if (!sel drained.ok) { ret 4; }
    val result: lifecycle.CloseResult = drained.ok;
    if (!result.started
        || result.complete
        || result.snapshot.mode != lifecycle.GRACEFUL
        || result.snapshot.cause != lifecycle.PROCESS_TERMINATION
        || result.snapshot.outstanding != 1) {
        ret 5;
    }
    if (!closed(?source)
        || io_runtime.snapshot(?runtime).state != lifecycle.CLOSED
        || !ok_err(io_runtime.destroy(?runtime))) {
        ret 6;
    }
    ret 0;
}
