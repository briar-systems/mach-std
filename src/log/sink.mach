# serialized record sinks with direct atomic publication

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.io.writer;
use std.io.writer.WriteError;
use io_error: std.io.error;
use io_handle: std.io.handle;
use std.filesystem;
use std.system.os;
use std.sync.atomic;
use std.sync.channel;
use std.sync.condition;
use std.sync.mutex;
use std.sync.thread;
use std.log.record;

# every way a sink, a logger or one publication can fail
# ---
# invalid:      a nil, uninitialized or malformed argument, or a sink that was
#               never made
# contract:     the delivery contract's parameters are inconsistent
# malformed:    an adapter's report broke the delivery contract
# clock:        the logger's clock could not be sampled; nothing was published
# encode:       the record could not be encoded; nothing was published
# too_large:    the record exceeds the contract's max_record; payload is its
#               size and nothing was published
# write:        the adapter's write failed; payload carries the persisted
#               prefix and the cause
# queue_full:   the bounded queue had no capacity under OVERLOAD_REJECT_NEW
# queue_closed: the queue no longer accepts records
# open:         the queue must be closed before it is joined
# unjoined:     the queue must be joined before it is destroyed
# busy:         joiners are still waiting on the queue
# queue:        the queue refused a state operation
# thread:       the worker could not be spawned or joined
pub tag SinkError: u8 {
    invalid;
    contract;
    malformed;
    clock:        record.ClockError;
    encode:       record.EncodeError;
    too_large:    usize;
    write:        WriteError;
    queue_full;
    queue_closed;
    open;
    unjoined;
    busy;
    queue:        channel.StateError;
    thread:       thread.ThreadError;
}

# a made sink, or why it could not be made
pub def Created: res[Sink, SinkError];
# a state operation's outcome
pub def Operation: err[SinkError];
# an abort's outcome: the undelivered records transferred to the caller
pub def Aborted: res[usize, SinkError];

val QUEUE_JOIN_OPEN: i64 = 0;
val QUEUE_JOINING:   i64 = 1;
val QUEUE_JOINED:    i64 = 2;
val QUEUE_JOIN_FAILED: i64 = 3;

# the outcome of one publication; the cases that failed carry their cause
# ---
# persisted:  every offered byte was confirmed by the adapter
# partial:    the adapter confirmed a prefix and then stalled or failed
# failed:     the adapter failed; the confirmed prefix may be zero
# rejected:   nothing was accepted (too large, queue full or closed, or an
#             encoding refusal); the caller retains the record
# dropped:    the queue discarded the record under OVERLOAD_DROP_NEW
# enqueued:   the queue accepted the record for later publication
# suppressed: the record was below the level and never encoded
pub tag WriteStatus: u8 {
    persisted;
    partial:  SinkError;
    failed:   SinkError;
    rejected: SinkError;
    dropped;
    enqueued;
    suppressed;
}

# offered is the full logical size before truncation
# persisted is the byte count confirmed by the adapter
pub rec WriteReport {
    status:    WriteStatus;
    offered:   usize;
    persisted: usize;
    truncated: bool;
}

pub def Delivery: u8;
pub val DELIVERY_DIRECT:         Delivery = 0;
pub val DELIVERY_BOUNDED_QUEUED: Delivery = 1;

pub def OverloadPolicy: u8;
pub val OVERLOAD_REJECT_NEW: OverloadPolicy = 0;
pub val OVERLOAD_DROP_NEW:   OverloadPolicy = 1;
pub val OVERLOAD_BLOCK:      OverloadPolicy = 2;

pub def AdapterKind: u8;
pub val ADAPTER_CONSOLE: AdapterKind = 0;
pub val ADAPTER_PIPE:    AdapterKind = 1;
pub val ADAPTER_FILE:    AdapterKind = 2;
pub val ADAPTER_CUSTOM:  AdapterKind = 3;

# target_atomic_limit is zero when the target offers no cross-process limit
# every direct adapter still serializes callbacks within this process
pub rec Contract {
    delivery:            Delivery;
    max_record:          usize;
    oversize:            record.OversizePolicy;
    adapter:             AdapterKind;
    target_atomic_limit: usize;
    queue_capacity:      usize;
    overload:            OverloadPolicy;
}

pub def PublishFun: fun(ptr, *u8, usize) WriteReport;

# sink ctx is borrowed and must outlive every publish
# publish callbacks must consume or copy the borrowed bytes before returning
pub rec Sink {
    ctx:       ptr;
    f_publish: PublishFun;
    contract:  Contract;
}

# direct sinks must remain at a stable address and must not be copied in use
# reinitialization requires every current publication to stop first
# existing sinks retarget to the new adapter but retain their copied contract and must be discarded
# direct owns no resources and requires no destruction
pub rec Direct {
    lock:        mutex.Mutex;
    adapter_ctx: ptr;
    f_write:     PublishFun;
    writer:      writer.Writer;
    initialized: bool;
}

pub rec QueuedRecord {
    data: [record.MAX_RECORD_BYTES]u8;
    len:  usize;
}

pub rec QueueStats {
    enqueued:  usize;
    persisted: usize;
    partial:   usize;
    failed:    usize;
    rejected:  usize;
    dropped:   usize;
    aborted:   usize;
    last:      WriteReport;
}

# queued and its caller-owned records remain stable through join
pub rec Queued {
    queue:       channel.Channel[QueuedRecord];
    downstream:  *Sink;
    worker:      thread.Thread;
    overload:    OverloadPolicy;
    enqueued:    i64;
    persisted:   i64;
    partial:     i64;
    failed:      i64;
    rejected:    i64;
    dropped:     i64;
    aborted:     i64;
    last:        WriteReport;
    lock:        mutex.Mutex;
    state_lock:  mutex.Mutex;
    joined:      condition.Condition;
    initialized: bool;
    join_state:  i64;
    join_error:  thread.ThreadError;
}

pub fun report(status: WriteStatus, offered: usize, persisted: usize, truncated: bool) WriteReport {
    ret WriteReport{
        status: status,
        offered: offered,
        persisted: persisted,
        truncated: truncated,
    };
}

pub fun persisted(bytes: usize) WriteReport {
    ret report(WriteStatus.persisted{}, bytes, bytes, false);
}

pub fun partial(offered: usize, persisted_bytes: usize, error: SinkError) WriteReport {
    ret report(WriteStatus.partial{error}, offered, persisted_bytes, false);
}

pub fun failed(offered: usize, persisted_bytes: usize, error: SinkError) WriteReport {
    ret report(WriteStatus.failed{error}, offered, persisted_bytes, false);
}

pub fun rejected(offered: usize, error: SinkError) WriteReport {
    ret report(WriteStatus.rejected{error}, offered, 0, false);
}

pub fun dropped(offered: usize) WriteReport {
    ret report(WriteStatus.dropped{}, offered, 0, false);
}

pub fun enqueued(offered: usize) WriteReport {
    ret report(WriteStatus.enqueued{}, offered, 0, false);
}

pub fun suppressed() WriteReport {
    ret report(WriteStatus.suppressed{}, 0, 0, false);
}

# the cause carried by a report, or none for the cases that have no failure
pub fun cause(r: WriteReport) opt[SinkError] {
    if (sel r.status.partial)  { ret opt[SinkError].some{r.status.partial}; }
    if (sel r.status.failed)   { ret opt[SinkError].some{r.status.failed}; }
    if (sel r.status.rejected) { ret opt[SinkError].some{r.status.rejected}; }
    ret opt[SinkError].none{};
}

fun malformed(len: usize) WriteReport {
    ret failed(len, 0, SinkError.malformed{});
}

# fold a writer outcome into a report: the persisted prefix is kept and the
# writer's failure is the cause; a short accept is the stalled prefix
pub fun report_write(len: usize, outcome: res[usize, WriteError]) WriteReport {
    if (sel outcome.ok) {
        val written: usize = outcome.ok;
        if (written > len) { ret malformed(len); }
        if (written < len) { ret partial(len, written, SinkError.write{WriteError.stalled{written}}); }
        ret persisted(len);
    }
    val prefix: usize = writer.persisted(outcome.err);
    if (prefix > len) { ret malformed(len); }
    if (prefix == 0) { ret failed(len, 0, SinkError.write{outcome.err}); }
    ret partial(len, prefix, SinkError.write{outcome.err});
}

pub fun contract_valid(contract: Contract) bool {
    if (contract.delivery > DELIVERY_BOUNDED_QUEUED) { ret false; }
    if (contract.max_record == 0 || contract.max_record > record.MAX_RECORD_BYTES) { ret false; }
    if (contract.oversize > record.OVERSIZE_TRUNCATE) { ret false; }
    if (contract.oversize == record.OVERSIZE_TRUNCATE && contract.max_record < record.MIN_TRUNCATED_BYTES) { ret false; }
    if (contract.adapter > ADAPTER_CUSTOM) { ret false; }
    if (contract.overload > OVERLOAD_BLOCK) { ret false; }
    if (contract.delivery == DELIVERY_DIRECT && contract.queue_capacity != 0) { ret false; }
    if (contract.delivery == DELIVERY_BOUNDED_QUEUED && contract.queue_capacity == 0) { ret false; }
    ret true;
}

fun direct_contract(max_record: usize, oversize: record.OversizePolicy, adapter: AdapterKind, target_atomic_limit: usize) res[Contract, SinkError] {
    val contract: Contract = Contract{
        delivery: DELIVERY_DIRECT,
        max_record: max_record,
        oversize: oversize,
        adapter: adapter,
        target_atomic_limit: target_atomic_limit,
        queue_capacity: 0,
        overload: OVERLOAD_REJECT_NEW,
    };
    if (!contract_valid(contract)) { ret res[Contract, SinkError].err{SinkError.contract{}}; }
    ret res[Contract, SinkError].ok{contract};
}

# describe a bounded queued delivery contract
pub fun queued_contract(max_record: usize, oversize: record.OversizePolicy, capacity: usize, overload: OverloadPolicy, adapter: AdapterKind, target_atomic_limit: usize) res[Contract, SinkError] {
    val contract: Contract = Contract{
        delivery: DELIVERY_BOUNDED_QUEUED,
        max_record: max_record,
        oversize: oversize,
        adapter: adapter,
        target_atomic_limit: target_atomic_limit,
        queue_capacity: capacity,
        overload: overload,
    };
    if (!contract_valid(contract)) { ret res[Contract, SinkError].err{SinkError.contract{}}; }
    ret res[Contract, SinkError].ok{contract};
}

# construct a sink from an implementation and a validated contract
pub fun make(ctx: ptr, f_publish: PublishFun, contract: Contract) Created {
    if (f_publish::usize == 0) { ret Created.err{SinkError.invalid{}}; }
    if (!contract_valid(contract)) { ret Created.err{SinkError.contract{}}; }
    ret Created.ok{Sink{ctx: ctx, f_publish: f_publish, contract: contract}};
}

pub fun publish(sink: *Sink, data: *u8, len: usize) WriteReport {
    if (sink == nil || sink.f_publish::usize == 0 || !contract_valid(sink.contract)) {
        ret failed(len, 0, SinkError.invalid{});
    }
    if (len > 0 && data == nil) { ret failed(len, 0, SinkError.invalid{}); }
    if (len > sink.contract.max_record) { ret rejected(len, SinkError.too_large{len}); }
    val result: WriteReport = sink.f_publish(sink.ctx, data, len);
    if (sink.contract.delivery == DELIVERY_DIRECT) { ret validate_direct(result, len); }
    if (!validate_queued(result, len)) { ret malformed(len); }
    ret result;
}

fun validate_queued(result: WriteReport, len: usize) bool {
    if (result.offered != len || result.persisted != 0 || result.truncated) { ret false; }
    if (sel result.status.enqueued) { ret true; }
    if (sel result.status.dropped)  { ret true; }
    if (sel result.status.rejected) { ret true; }
    ret false;
}

# a write cause must agree with the report about the persisted prefix
fun prefix_consistent(error: SinkError, persisted_bytes: usize) bool {
    if (sel error.write) { ret writer.persisted(error.write) == persisted_bytes; }
    ret true;
}

# direct atomicity is one callback while confirmed short-write bytes remain observable
fun validate_direct(result: WriteReport, len: usize) WriteReport {
    if (result.offered != len || result.persisted > len) { ret malformed(len); }
    if (sel result.status.persisted) {
        if (result.persisted != len) { ret malformed(len); }
        ret result;
    }
    if (sel result.status.partial) {
        if (result.persisted == 0 || result.persisted == len) { ret malformed(len); }
        if (!prefix_consistent(result.status.partial, result.persisted)) { ret malformed(len); }
        ret result;
    }
    if (sel result.status.failed) {
        if (len > 0 && result.persisted == len) { ret malformed(len); }
        if (!prefix_consistent(result.status.failed, result.persisted)) { ret malformed(len); }
        ret result;
    }
    ret malformed(len);
}

fun direct_publish(ctx: ptr, data: *u8, len: usize) WriteReport {
    val direct: *Direct = ctx::*Direct;
    if (!direct.initialized || direct.f_write::usize == 0) {
        ret failed(len, 0, SinkError.invalid{});
    }

    mutex.lock(?direct.lock);
    val result: WriteReport = direct.f_write(direct.adapter_ctx, data, len);
    mutex.unlock(?direct.lock);
    ret result;
}

fun writer_publish(ctx: ptr, data: *u8, len: usize) WriteReport {
    val output: *writer.Writer = ctx::*writer.Writer;
    ret report_write(len, writer.write(output, data, len));
}

fun init_custom(direct: *Direct, ctx: ptr, f_write: PublishFun) {
    direct.lock = mutex.make();
    direct.adapter_ctx = ctx;
    direct.f_write = f_write;
    direct.initialized = true;
}

fun init_writer(direct: *Direct, output: writer.Writer) {
    direct.writer = output;
    init_custom(direct, (?direct.writer)::ptr, writer_publish);
}

fun direct_sink(direct: *Direct, contract: Contract) Created {
    if (direct == nil || !direct.initialized) { ret Created.err{SinkError.invalid{}}; }
    if (contract.delivery != DELIVERY_DIRECT) { ret Created.err{SinkError.contract{}}; }
    ret make(direct::ptr, direct_publish, contract);
}

# ctx is borrowed and must outlive direct and every sink created from it
# the custom callback is serialized by direct before each invocation
pub fun custom(direct: *Direct, ctx: ptr, f_write: PublishFun, max_record: usize, oversize: record.OversizePolicy, target_atomic_limit: usize) Created {
    if (direct == nil || f_write::usize == 0) { ret Created.err{SinkError.invalid{}}; }
    val cr: res[Contract, SinkError] = direct_contract(max_record, oversize, ADAPTER_CUSTOM, target_atomic_limit);
    if (sel cr.err) { ret Created.err{cr.err}; }
    init_custom(direct, ctx, f_write);
    ret direct_sink(direct, cr.ok);
}

# the writer value is copied while its ctx remains borrowed for every sink created from direct
# io writers report a failed call or a partial successful call
pub fun from_writer(direct: *Direct, output: writer.Writer, max_record: usize, oversize: record.OversizePolicy, target_atomic_limit: usize) Created {
    if (direct == nil) { ret Created.err{SinkError.invalid{}}; }
    val cr: res[Contract, SinkError] = direct_contract(max_record, oversize, ADAPTER_CUSTOM, target_atomic_limit);
    if (sel cr.err) { ret Created.err{cr.err}; }
    init_writer(direct, output);
    ret direct_sink(direct, cr.ok);
}

# consoles guarantee one in-process callback but no cross-process byte limit
pub fun console(direct: *Direct, stderr: bool, max_record: usize, oversize: record.OversizePolicy) Created {
    if (direct == nil) { ret Created.err{SinkError.invalid{}}; }
    var file: filesystem.File = filesystem.STDOUT;
    if (stderr) { file = filesystem.STDERR; }
    val cr: res[Contract, SinkError] = direct_contract(max_record, oversize, ADAPTER_CONSOLE, 0);
    if (sel cr.err) { ret Created.err{cr.err}; }
    init_writer(direct, filesystem.writer(file));
    ret direct_sink(direct, cr.ok);
}

# the caller owns the file handle and closes it only after sink use stops
# regular files guarantee one in-process callback but no cross-process limit
pub fun file(direct: *Direct, output: filesystem.File, max_record: usize, oversize: record.OversizePolicy) Created {
    if (direct == nil) { ret Created.err{SinkError.invalid{}}; }
    val cr: res[Contract, SinkError] = direct_contract(max_record, oversize, ADAPTER_FILE, 0);
    if (sel cr.err) { ret Created.err{cr.err}; }
    init_writer(direct, filesystem.writer(output));
    ret direct_sink(direct, cr.ok);
}

pub fun pipe_target_atomic_limit() usize {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    $if ($mach.build.os == $mach.os.darwin) { ret 512; }
    ret 4096;
}

# linux pipe writes through 4096 bytes are cross-process atomic
# darwin exposes the posix minimum of 512 bytes through this contract
# windows anonymous byte pipes publish once but expose no portable byte limit
# the caller owns the pipe handle and closes it only after sink use stops
pub fun pipe(direct: *Direct, output: filesystem.File, max_record: usize, oversize: record.OversizePolicy) Created {
    if (direct == nil) { ret Created.err{SinkError.invalid{}}; }
    val cr: res[Contract, SinkError] = direct_contract(max_record, oversize, ADAPTER_PIPE, pipe_target_atomic_limit());
    if (sel cr.err) { ret Created.err{cr.err}; }
    init_writer(direct, filesystem.writer(output));
    ret direct_sink(direct, cr.ok);
}

fun queued_result(status: channel.Status[QueuedRecord], len: usize, overload: OverloadPolicy) WriteReport {
    if (sel status.sent) { ret enqueued(len); }
    if (sel status.full) {
        if (overload == OVERLOAD_DROP_NEW) { ret dropped(len); }
        ret rejected(len, SinkError.queue_full{});
    }
    if (sel status.closed) { ret rejected(len, SinkError.queue_closed{}); }
    ret rejected(len, SinkError.invalid{});
}

fun queued_publish(ctx: ptr, data: *u8, len: usize) WriteReport {
    val queued: *Queued = ctx::*Queued;
    if (!queued.initialized || atomic.load(?queued.join_state) != QUEUE_JOIN_OPEN) { ret rejected(len, SinkError.queue_closed{}); }
    var entry: QueuedRecord;
    entry.len = len;
    var i: usize = 0;
    for (i < len) {
        entry.data[i] = data[i];
        i = i + 1;
    }

    var status: channel.Status[QueuedRecord] = channel.Status[QueuedRecord].full{};
    if (queued.overload == OVERLOAD_BLOCK) {
        status = channel.send[QueuedRecord](?queued.queue, entry);
    }
    or {
        status = channel.try_send[QueuedRecord](?queued.queue, entry);
    }
    val result: WriteReport = queued_result(status, len, queued.overload);
    if (sel result.status.enqueued) { atomic.fetch_add(?queued.enqueued, 1); }
    or (sel result.status.dropped) { atomic.fetch_add(?queued.dropped, 1); }
    or { atomic.fetch_add(?queued.rejected, 1); }
    ret result;
}

fun queued_worker(arg: *u8) {
    val queued: *Queued = arg::*Queued;
    var running: bool = true;
    for (running) {
        val status: channel.Status[QueuedRecord] = channel.receive[QueuedRecord](?queued.queue);
        if (sel status.received) {
            val entry: QueuedRecord = status.received;
            val result: WriteReport = publish(queued.downstream, (?entry.data)::*u8, entry.len);
            if (sel result.status.persisted) { atomic.fetch_add(?queued.persisted, 1); }
            or (sel result.status.partial) { atomic.fetch_add(?queued.partial, 1); }
            or { atomic.fetch_add(?queued.failed, 1); }
            mutex.lock(?queued.lock);
            queued.last = result;
            mutex.unlock(?queued.lock);
        }
        or {
            running = false;
        }
    }
}

# initialize the queued sink in place: queued is address-bound and stays
# uninitialized after any refusal, with the channel released
#
# the downstream sink and every borrowed adapter context outlive queued join
# downstream publication failure is recorded and does not stop queue service
pub fun queued_with_config(queued: *Queued, storage: *QueuedRecord, capacity: usize, downstream: *Sink, max_record: usize, oversize: record.OversizePolicy, overload: OverloadPolicy, config: *thread.Config) Created {
    if (queued == nil || storage == nil || capacity == 0 || downstream == nil || downstream.f_publish::usize == 0 || config == nil) {
        ret Created.err{SinkError.invalid{}};
    }
    if (!contract_valid(downstream.contract) || downstream.contract.delivery != DELIVERY_DIRECT || max_record > downstream.contract.max_record) {
        ret Created.err{SinkError.contract{}};
    }
    val cr: res[Contract, SinkError] = queued_contract(max_record, oversize, capacity, overload, downstream.contract.adapter, downstream.contract.target_atomic_limit);
    if (sel cr.err) { ret Created.err{cr.err}; }
    val made: channel.Operation = channel.make[QueuedRecord](?queued.queue, storage, capacity);
    if (sel made.err) { ret Created.err{SinkError.queue{made.err}}; }
    queued.downstream = downstream;
    queued.overload = overload;
    queued.enqueued = 0;
    queued.persisted = 0;
    queued.partial = 0;
    queued.failed = 0;
    queued.rejected = 0;
    queued.dropped = 0;
    queued.aborted = 0;
    queued.last = suppressed();
    queued.lock = mutex.make();
    queued.state_lock = mutex.make();
    queued.joined = condition.make();
    queued.initialized = true;
    queued.join_state = QUEUE_JOIN_OPEN;
    queued.join_error = thread.ThreadError.invalid{};
    val spawned: thread.Operation = thread.spawn_with_config(queued_worker, queued::*u8, config, ?queued.worker);
    if (sel spawned.err) {
        channel.close[QueuedRecord](?queued.queue);
        channel.destroy[QueuedRecord](?queued.queue);
        queued.initialized = false;
        ret Created.err{SinkError.thread{spawned.err}};
    }
    ret make(queued::ptr, queued_publish, cr.ok);
}

pub fun queued(queued: *Queued, storage: *QueuedRecord, capacity: usize, downstream: *Sink, max_record: usize, oversize: record.OversizePolicy, overload: OverloadPolicy) Created {
    var config: thread.Config;
    thread.config_default(?config);
    ret queued_with_config(queued, storage, capacity, downstream, max_record, oversize, overload, ?config);
}

# stop accepting records; the worker drains what was enqueued. idempotent
pub fun queued_close_drain(queued: *Queued) Operation {
    if (queued == nil || !queued.initialized) { ret Operation.err{SinkError.invalid{}}; }
    val closed: channel.Transition = channel.close[QueuedRecord](?queued.queue);
    if (sel closed.err) { ret Operation.err{SinkError.queue{closed.err}}; }
    ret Operation.ok{};
}

# abort transfers every unpublished record to caller storage in fifo order
# ---
# ret: the records transferred, or invalid when the storage cannot hold them
#      (the queue keeps them)
pub fun queued_close_abort(queued: *Queued, rejected_storage: *QueuedRecord, rejected_capacity: usize) Aborted {
    if (queued == nil || !queued.initialized) { ret Aborted.err{SinkError.invalid{}}; }
    var rejected_len: usize = 0;
    val status: channel.Status[QueuedRecord] = channel.close_abort[QueuedRecord](?queued.queue, rejected_storage, rejected_capacity, ?rejected_len);
    if (!sel status.aborted) { ret Aborted.err{SinkError.invalid{}}; }
    atomic.fetch_add(?queued.aborted, rejected_len::i64);
    ret Aborted.ok{rejected_len};
}

# wait for the worker after close; concurrent joins share one native join and
# a failed join is replayed to every later caller
# downstream callbacks must not join their own queue
pub fun queued_join(queued: *Queued) Operation {
    if (queued == nil || !queued.initialized) { ret Operation.err{SinkError.invalid{}}; }
    if (!channel.is_closed[QueuedRecord](?queued.queue)) { ret Operation.err{SinkError.open{}}; }
    mutex.lock(?queued.state_lock);
    for (atomic.load(?queued.join_state) == QUEUE_JOINING) {
        condition.wait(?queued.joined, ?queued.state_lock);
    }
    if (atomic.load(?queued.join_state) == QUEUE_JOINED) {
        mutex.unlock(?queued.state_lock);
        ret Operation.ok{};
    }
    if (atomic.load(?queued.join_state) == QUEUE_JOIN_FAILED) {
        val replayed: thread.ThreadError = queued.join_error;
        mutex.unlock(?queued.state_lock);
        ret Operation.err{SinkError.thread{replayed}};
    }
    atomic.store(?queued.join_state, QUEUE_JOINING);
    mutex.unlock(?queued.state_lock);

    val joined: thread.Operation = thread.join(?queued.worker);
    mutex.lock(?queued.state_lock);
    if (sel joined.err) {
        queued.join_error = joined.err;
        atomic.store(?queued.join_state, QUEUE_JOIN_FAILED);
    }
    or { atomic.store(?queued.join_state, QUEUE_JOINED); }
    condition.broadcast(?queued.joined);
    mutex.unlock(?queued.state_lock);
    if (sel joined.err) { ret Operation.err{SinkError.thread{joined.err}}; }
    ret Operation.ok{};
}

pub fun queued_stats(queued: *Queued) QueueStats {
    if (queued == nil || !queued.initialized) {
        ret QueueStats{enqueued: 0, persisted: 0, partial: 0, failed: 0, rejected: 0, dropped: 0, aborted: 0, last: failed(0, 0, SinkError.invalid{})};
    }
    mutex.lock(?queued.lock);
    val last: WriteReport = queued.last;
    mutex.unlock(?queued.lock);
    ret QueueStats{
        enqueued: atomic.load(?queued.enqueued)::usize,
        persisted: atomic.load(?queued.persisted)::usize,
        partial: atomic.load(?queued.partial)::usize,
        failed: atomic.load(?queued.failed)::usize,
        rejected: atomic.load(?queued.rejected)::usize,
        dropped: atomic.load(?queued.dropped)::usize,
        aborted: atomic.load(?queued.aborted)::usize,
        last: last,
    };
}

# the native code of the worker's join failure, 0 when the join succeeded or
# has not run, ERROR_INVALID for a sink that was never made
pub fun queued_thread_error(queued: *Queued) i64 {
    if (queued == nil || !queued.initialized) { ret thread.ERROR_INVALID; }
    mutex.lock(?queued.state_lock);
    var code: i64 = 0;
    if (atomic.load(?queued.join_state) == QUEUE_JOIN_FAILED) { code = thread.code(queued.join_error); }
    mutex.unlock(?queued.state_lock);
    ret code;
}

# release the queue after a completed join; refused while joiners wait
pub fun queued_destroy(queued: *Queued) Operation {
    if (queued == nil || !queued.initialized) { ret Operation.err{SinkError.invalid{}}; }
    mutex.lock(?queued.state_lock);
    if (atomic.load(?queued.join_state) != QUEUE_JOINED) {
        mutex.unlock(?queued.state_lock);
        ret Operation.err{SinkError.unjoined{}};
    }
    if (condition.waiter_count(?queued.joined) != 0) {
        mutex.unlock(?queued.state_lock);
        ret Operation.err{SinkError.busy{}};
    }
    val released: channel.Operation = channel.destroy[QueuedRecord](?queued.queue);
    if (sel released.err) {
        mutex.unlock(?queued.state_lock);
        ret Operation.err{SinkError.queue{released.err}};
    }
    queued.downstream = nil;
    queued.initialized = false;
    mutex.unlock(?queued.state_lock);
    ret Operation.ok{};
}

rec Capture {
    data:       [256]u8;
    len:        usize;
    calls:      usize;
    fail_calls: usize;
    partial_at: usize;
}

val DIRECT_WRITE_FAILED: i64 = -5;

fun direct_failure(persisted_bytes: usize) SinkError {
    ret SinkError.write{writer.native_failure(persisted_bytes, io_error.from_code(DIRECT_WRITE_FAILED, io_error.OP_WRITE))};
}

fun short_write(persisted_bytes: usize) SinkError {
    ret SinkError.write{WriteError.stalled{persisted_bytes}};
}

fun capture_write(ctx: ptr, data: *u8, len: usize) WriteReport {
    val capture: *Capture = ctx::*Capture;
    capture.calls = capture.calls + 1;
    if (capture.fail_calls > 0) {
        capture.fail_calls = capture.fail_calls - 1;
        ret failed(len, 0, direct_failure(0));
    }

    var count: usize = len;
    if (capture.partial_at < count) { count = capture.partial_at; }
    if (count > 256 - capture.len) { count = 256 - capture.len; }
    var i: usize = 0;
    for (i < count) {
        capture.data[capture.len + i] = data[i];
        i = i + 1;
    }
    capture.len = capture.len + count;
    if (count < len) { ret partial(len, count, short_write(count)); }
    ret persisted(len);
}

fun bytes_equal(data: *u8, len: usize, expected: str) bool {
    if (str_len(expected) != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the native code carried by a report's write cause, 0 when it has none
fun write_code(r: WriteReport) i64 {
    val c: opt[SinkError] = cause(r);
    if (!sel c.some) { ret 0; }
    if (!sel c.some.write) { ret 0; }
    if (!sel c.some.write.native) { ret 0; }
    ret c.some.write.native.error.code;
}

fun is_short_write(r: WriteReport, prefix: usize) bool {
    val c: opt[SinkError] = cause(r);
    if (!sel c.some) { ret false; }
    if (!sel c.some.write) { ret false; }
    if (!sel c.some.write.stalled) { ret false; }
    ret c.some.write.stalled == prefix;
}

fun is_malformed(r: WriteReport, len: usize) bool {
    if (!sel r.status.failed) { ret false; }
    if (!sel r.status.failed.malformed) { ret false; }
    ret r.offered == len && r.persisted == 0;
}

fun ok_op(o: Operation) bool { ret sel o.ok; }

test "log.sink: custom adapter reports partial writes and recovers after failure" {
    var capture: Capture;
    capture.len = 0;
    capture.calls = 0;
    capture.fail_calls = 1;
    capture.partial_at = 256;
    var direct: Direct;
    val sr: Created = custom(?direct, ?capture, capture_write, 128, record.OVERSIZE_REJECT, 0);
    if (sel sr.err) { ret 1; }
    var sink: Sink = sr.ok;

    val first: WriteReport = publish(?sink, "first", 5);
    if (!sel first.status.failed) { ret 2; }
    if (first.persisted != 0 || write_code(first) != DIRECT_WRITE_FAILED) { ret 3; }
    val second: WriteReport = publish(?sink, "second", 6);
    if (!sel second.status.persisted) { ret 4; }
    if (second.persisted != 6) { ret 5; }

    capture.partial_at = 2;
    val third: WriteReport = publish(?sink, "third", 5);
    if (!sel third.status.partial) { ret 6; }
    if (third.offered != 5 || third.persisted != 2 || !is_short_write(third, 2)) { ret 7; }
    if (capture.calls != 3 || !bytes_equal((?capture.data)::*u8, capture.len, "secondth")) { ret 8; }
    ret 0;
}

test "log.sink: invalid arguments and contracts are told apart" {
    var direct: Direct;
    var capture: Capture;
    val no_callback: Created = custom(?direct, ?capture, nil::PublishFun, 128, record.OVERSIZE_REJECT, 0);
    if (!sel no_callback.err) { ret 1; }
    if (!sel no_callback.err.invalid) { ret 2; }
    val no_direct: Created = custom(nil, ?capture, capture_write, 128, record.OVERSIZE_REJECT, 0);
    if (!sel no_direct.err) { ret 3; }
    if (!sel no_direct.err.invalid) { ret 4; }
    val zero_record: Created = custom(?direct, ?capture, capture_write, 0, record.OVERSIZE_REJECT, 0);
    if (!sel zero_record.err) { ret 5; }
    if (!sel zero_record.err.contract) { ret 6; }
    val short_truncate: Created = custom(?direct, ?capture, capture_write, record.MIN_TRUNCATED_BYTES - 1, record.OVERSIZE_TRUNCATE, 0);
    if (!sel short_truncate.err) { ret 7; }
    if (!sel short_truncate.err.contract) { ret 8; }

    val unmade: WriteReport = publish(nil, "x", 1);
    if (!sel unmade.status.failed) { ret 9; }
    if (!sel unmade.status.failed.invalid) { ret 10; }

    capture.len = 0;
    capture.calls = 0;
    capture.fail_calls = 0;
    capture.partial_at = 256;
    val sr: Created = custom(?direct, ?capture, capture_write, 4, record.OVERSIZE_REJECT, 0);
    if (sel sr.err) { ret 11; }
    var sink: Sink = sr.ok;
    val oversize: WriteReport = publish(?sink, "12345", 5);
    if (!sel oversize.status.rejected) { ret 12; }
    if (!sel oversize.status.rejected.too_large) { ret 13; }
    if (oversize.status.rejected.too_large != 5 || oversize.offered != 5 || capture.calls != 0) { ret 14; }
    val no_data: WriteReport = publish(?sink, nil, 1);
    if (!sel no_data.status.failed) { ret 15; }
    if (!sel no_data.status.failed.invalid) { ret 16; }
    val empty: WriteReport = publish(?sink, "", 0);
    if (!sel empty.status.persisted) { ret 17; }
    if (empty.offered != 0 || empty.persisted != 0 || capture.calls != 1) { ret 18; }
    ret 0;
}

rec ShortWriter {
    count: usize;
    code:  i64;
}

fun short_writer(ctx: ptr, data: *u8, len: usize) res[usize, WriteError] {
    val state: *ShortWriter = ctx::*ShortWriter;
    if (state.code != 0) {
        ret res[usize, WriteError].err{writer.native_failure(state.count, io_error.from_code(state.code, io_error.OP_WRITE))};
    }
    ret res[usize, WriteError].ok{state.count};
}

test "log.sink: writer adapter preserves confirmed short-write bytes" {
    var state: ShortWriter = ShortWriter{count: 2, code: 0};
    val output: writer.Writer = writer.Writer{ctx: ?state, f_write: short_writer};
    var direct: Direct;
    val sr: Created = from_writer(?direct, output, 128, record.OVERSIZE_REJECT, 0);
    if (sel sr.err) { ret 1; }
    var sink: Sink = sr.ok;

    val partial_result: WriteReport = publish(?sink, "short", 5);
    if (!sel partial_result.status.partial) { ret 2; }
    if (partial_result.persisted != 2 || !is_short_write(partial_result, 2)) { ret 3; }

    state.count = 0;
    val stalled: WriteReport = publish(?sink, "stalled", 7);
    if (!sel stalled.status.failed) { ret 4; }
    if (stalled.persisted != 0 || !is_short_write(stalled, 0)) { ret 5; }

    # a native failure after a prefix keeps the prefix and the cause
    state.count = 3;
    state.code = os.EPIPE;
    val broken: WriteReport = publish(?sink, "broken", 6);
    if (!sel broken.status.partial) { ret 6; }
    if (broken.persisted != 3 || write_code(broken) != os.EPIPE) { ret 7; }

    state.count = 0;
    val dead: WriteReport = publish(?sink, "dead", 4);
    if (!sel dead.status.failed) { ret 8; }
    if (dead.persisted != 0 || write_code(dead) != os.EPIPE) { ret 9; }
    ret 0;
}

rec DirectReportCase {
    result: WriteReport;
    valid:  bool;
}

rec MalformedCapture {
    result: WriteReport;
}

fun malformed_write(ctx: ptr, data: *u8, len: usize) WriteReport {
    val capture: *MalformedCapture = ctx::*MalformedCapture;
    ret capture.result;
}

test "log.sink: direct adapter report status and count matrix" {
    val cr: res[Contract, SinkError] = direct_contract(128, record.OVERSIZE_REJECT, ADAPTER_CUSTOM, 0);
    if (sel cr.err) { ret 1; }
    var capture: MalformedCapture;
    val sr: Created = make(?capture, malformed_write, cr.ok);
    if (sel sr.err) { ret 2; }
    var sink: Sink = sr.ok;

    var cases: [17]DirectReportCase;
    cases[0] = DirectReportCase{result: persisted(4), valid: true};
    cases[1] = DirectReportCase{result: partial(4, 2, short_write(2)), valid: true};
    cases[2] = DirectReportCase{result: failed(4, 0, direct_failure(0)), valid: true};
    cases[3] = DirectReportCase{result: failed(4, 2, direct_failure(2)), valid: true};
    cases[4] = DirectReportCase{result: report(WriteStatus.persisted{}, 4, 3, false), valid: false};
    cases[5] = DirectReportCase{result: partial(4, 0, short_write(0)), valid: false};
    cases[6] = DirectReportCase{result: partial(4, 4, short_write(4)), valid: false};
    cases[7] = DirectReportCase{result: failed(4, 4, direct_failure(4)), valid: false};
    cases[8] = DirectReportCase{result: rejected(4, SinkError.queue_full{}), valid: false};
    cases[9] = DirectReportCase{result: dropped(4), valid: false};
    cases[10] = DirectReportCase{result: enqueued(4), valid: false};
    cases[11] = DirectReportCase{result: report(WriteStatus.suppressed{}, 4, 0, false), valid: false};
    cases[12] = DirectReportCase{result: report(WriteStatus.persisted{}, 4, 5, false), valid: false};
    cases[13] = DirectReportCase{result: persisted(3), valid: false};
    # a write cause that disagrees with the report about the prefix
    cases[14] = DirectReportCase{result: partial(4, 2, short_write(1)), valid: false};
    cases[15] = DirectReportCase{result: failed(4, 2, direct_failure(0)), valid: false};
    # a non-write cause carries no prefix to disagree with
    cases[16] = DirectReportCase{result: failed(4, 1, SinkError.invalid{}), valid: true};

    var i: usize = 0;
    for (i < 17) {
        capture.result = cases[i].result;
        val result: WriteReport = publish(?sink, "test", 4);
        if (cases[i].valid) {
            if (result.offered != cases[i].result.offered || result.persisted != cases[i].result.persisted) { ret 3; }
            if (write_code(result) != write_code(cases[i].result)) { ret 4; }
            if (sel result.status.persisted) { if (!sel cases[i].result.status.persisted) { ret 5; } }
            or (sel result.status.partial) { if (!sel cases[i].result.status.partial) { ret 6; } }
            or (sel result.status.failed) { if (!sel cases[i].result.status.failed) { ret 7; } }
            or { ret 8; }
        }
        or {
            if (!is_malformed(result, 4)) { ret 9; }
        }
        i = i + 1;
    }
    ret 0;
}

rec ConcurrentCapture {
    active:  i64;
    overlap: i64;
    calls:   i64;
}

fun concurrent_write(ctx: ptr, data: *u8, len: usize) WriteReport {
    val capture: *ConcurrentCapture = ctx::*ConcurrentCapture;
    if (atomic.exchange(?capture.active, 1) != 0) { atomic.store(?capture.overlap, 1); }
    var i: usize = 0;
    for (i < 1000) { atomic.spin_hint(); i = i + 1; }
    capture.calls = capture.calls + 1;
    atomic.store(?capture.active, 0);
    ret persisted(len);
}

rec PublishContext {
    sink: *Sink;
    runs: usize;
}

fun publish_worker(arg: *u8) {
    val context: *PublishContext = arg::*PublishContext;
    var i: usize = 0;
    for (i < context.runs) {
        publish(context.sink, "one-record\n", 11);
        i = i + 1;
    }
}

test "log.sink: concurrent direct publishers never overlap one callback" {
    var capture: ConcurrentCapture = ConcurrentCapture{active: 0, overlap: 0, calls: 0};
    var direct: Direct;
    val sr: Created = custom(?direct, ?capture, concurrent_write, 128, record.OVERSIZE_REJECT, 0);
    if (sel sr.err) { ret 1; }
    var sink: Sink = sr.ok;
    var contexts: [4]PublishContext;
    var threads: [4]thread.Thread;
    var i: usize = 0;
    for (i < 4) {
        contexts[i] = PublishContext{sink: ?sink, runs: 25};
        val spawned: thread.Operation = thread.spawn_with(publish_worker, (?contexts[i])::*u8, ?threads[i]);
        if (sel spawned.err) {
            var joined: usize = 0;
            for (joined < i) { thread.join(?threads[joined]); joined = joined + 1; }
            ret 2;
        }
        i = i + 1;
    }
    i = 0;
    for (i < 4) { thread.join(?threads[i]); i = i + 1; }
    if (atomic.load(?capture.overlap) != 0 || capture.calls != 100) { ret 3; }
    ret 0;
}

test "log.sink: file adapter publishes one complete region" {
    val path: str = ".mach-log-sink-497.tmp";
    filesystem.remove_file(path);
    val created: res[filesystem.File, io_error.Error] = filesystem.create(path, 0o600);
    if (sel created.err) { ret 1; }
    var output: filesystem.File = created.ok;

    var direct: Direct;
    val sr: Created = file(?direct, output, 128, record.OVERSIZE_REJECT);
    if (sel sr.err) { filesystem.close(?output); filesystem.remove_file(path); ret 2; }
    var sink: Sink = sr.ok;
    val result: WriteReport = publish(?sink, "file-record\n", 12);
    filesystem.close(?output);
    if (!sel result.status.persisted) { filesystem.remove_file(path); ret 3; }
    if (result.persisted != 12) { filesystem.remove_file(path); ret 4; }

    val opened: res[filesystem.File, io_error.Error] = filesystem.open(path);
    if (sel opened.err) { filesystem.remove_file(path); ret 5; }
    var input: filesystem.File = opened.ok;
    var data: [32]u8;
    val read: res[usize, io_error.Error] = filesystem.read(input, (?data)::*u8, 32);
    filesystem.close(?input);
    filesystem.remove_file(path);
    if (sel read.err) { ret 6; }
    val len: usize = read.ok;
    if (!bytes_equal((?data)::*u8, len, "file-record\n")) { ret 7; }
    ret 0;
}

test "log.sink: pipe adapter publishes one complete region" {
    var fds: [2]i32;
    if (os.pipe(?fds[0]) < 0) { ret 1; }
    var input: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: fds[0]::usize}};
    var output: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: fds[1]::usize}};
    var direct: Direct;
    val sr: Created = pipe(?direct, output, 128, record.OVERSIZE_REJECT);
    if (sel sr.err) { filesystem.close(?input); filesystem.close(?output); ret 2; }
    var sink: Sink = sr.ok;
    if (sink.contract.target_atomic_limit != pipe_target_atomic_limit()) { filesystem.close(?input); filesystem.close(?output); ret 3; }
    val result: WriteReport = publish(?sink, "pipe-record\n", 12);
    filesystem.close(?output);
    if (!sel result.status.persisted) { filesystem.close(?input); ret 4; }
    var data: [32]u8;
    val read: res[usize, io_error.Error] = filesystem.read(input, (?data)::*u8, 32);
    filesystem.close(?input);
    if (sel read.err) { ret 5; }
    val len: usize = read.ok;
    if (!bytes_equal((?data)::*u8, len, "pipe-record\n")) { ret 6; }
    ret 0;
}

test "log.sink: a closed file reports the native failure with no prefix" {
    var fds: [2]i32;
    if (os.pipe(?fds[0]) < 0) { ret 1; }
    var input: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: fds[0]::usize}};
    var output: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: fds[1]::usize}};
    var direct: Direct;
    val sr: Created = pipe(?direct, output, 128, record.OVERSIZE_REJECT);
    if (sel sr.err) { filesystem.close(?input); filesystem.close(?output); ret 2; }
    var sink: Sink = sr.ok;
    filesystem.close(?output);
    filesystem.close(?input);
    val result: WriteReport = publish(?sink, "gone\n", 5);
    if (!sel result.status.failed) { ret 3; }
    if (result.persisted != 0 || result.offered != 5) { ret 4; }
    if (write_code(result) != os.EBADF) { ret 5; }
    ret 0;
}

test "log.sink: console adapter publishes through the native stream" {
    var direct: Direct;
    val sr: Created = console(?direct, true, 128, record.OVERSIZE_REJECT);
    if (sel sr.err) { ret 1; }
    var sink: Sink = sr.ok;
    val result: WriteReport = publish(?sink, "log console adapter ok\n", 23);
    if (!sel result.status.persisted) { ret 2; }
    if (result.persisted != 23) { ret 3; }
    ret 0;
}

test "log.sink: queued extension requires capacity and overload policy" {
    val invalid: res[Contract, SinkError] = queued_contract(128, record.OVERSIZE_REJECT, 0, OVERLOAD_DROP_NEW, ADAPTER_FILE, 0);
    if (!sel invalid.err) { ret 1; }
    if (!sel invalid.err.contract) { ret 2; }
    val valid: res[Contract, SinkError] = queued_contract(128, record.OVERSIZE_REJECT, 64, OVERLOAD_REJECT_NEW, ADAPTER_FILE, 0);
    if (sel valid.err) { ret 3; }
    val contract: Contract = valid.ok;
    if (contract.delivery != DELIVERY_BOUNDED_QUEUED || contract.queue_capacity != 64 || contract.overload != OVERLOAD_REJECT_NEW) { ret 4; }
    ret 0;
}

test "log.sink: queued sink drains records and reports downstream failure" {
    var capture: Capture;
    capture.len = 0;
    capture.calls = 0;
    capture.fail_calls = 1;
    capture.partial_at = 256;
    var direct: Direct;
    val dr: Created = custom(?direct, ?capture, capture_write, 128, record.OVERSIZE_REJECT, 0);
    if (sel dr.err) { ret 1; }
    var downstream: Sink = dr.ok;

    var storage: [2]QueuedRecord;
    var queue: Queued;
    val qr: Created = queued(?queue, (?storage)::*QueuedRecord, 2, ?downstream, 128, record.OVERSIZE_REJECT, OVERLOAD_BLOCK);
    if (sel qr.err) { ret 2; }
    var output: Sink = qr.ok;
    val first: WriteReport = publish(?output, "failed", 6);
    if (!sel first.status.enqueued) { ret 3; }
    val second: WriteReport = publish(?output, "persisted", 9);
    if (!sel second.status.enqueued) { ret 4; }
    if (!ok_op(queued_close_drain(?queue)) || !ok_op(queued_join(?queue))) { ret 5; }
    val result: QueueStats = queued_stats(?queue);
    if (result.enqueued != 2 || result.failed != 1 || result.persisted != 1) { ret 6; }
    if (!sel result.last.status.persisted) { ret 7; }
    if (!bytes_equal((?capture.data)::*u8, capture.len, "persisted")) { ret 8; }
    if (queued_thread_error(?queue) != 0) { ret 9; }
    if (!ok_op(queued_destroy(?queue))) { ret 10; }
    if (queue.initialized) { ret 11; }
    val after: WriteReport = publish(?output, "late", 4);
    if (!sel after.status.rejected) { ret 12; }
    if (!sel after.status.rejected.queue_closed) { ret 13; }
    ret 0;
}

test "log.sink: queued spawn failure releases channel ownership" {
    var capture: Capture;
    capture.len = 0;
    capture.calls = 0;
    capture.fail_calls = 0;
    capture.partial_at = 256;
    var direct: Direct;
    val dr: Created = custom(?direct, ?capture, capture_write, 128, record.OVERSIZE_REJECT, 0);
    if (sel dr.err) { ret 1; }
    var downstream: Sink = dr.ok;
    var storage: [1]QueuedRecord;
    var queue: Queued;
    var config: thread.Config;
    thread.config_default(?config);
    config.stack_reserve = 1;
    val result: Created = queued_with_config(?queue, (?storage)::*QueuedRecord, 1, ?downstream, 128, record.OVERSIZE_REJECT, OVERLOAD_BLOCK, ?config);
    if (!sel result.err) { ret 2; }
    if (!sel result.err.thread) { ret 3; }
    if (!sel result.err.thread.invalid) { ret 4; }
    if (queue.initialized) { ret 5; }
    val destroyed: Operation = queued_destroy(?queue);
    if (!sel destroyed.err) { ret 6; }
    if (!sel destroyed.err.invalid) { ret 7; }
    ret 0;
}

test "log.sink: queued refusals name the argument, the contract and the state" {
    var capture: Capture;
    capture.len = 0;
    capture.calls = 0;
    capture.fail_calls = 0;
    capture.partial_at = 256;
    var direct: Direct;
    val dr: Created = custom(?direct, ?capture, capture_write, 64, record.OVERSIZE_REJECT, 0);
    if (sel dr.err) { ret 1; }
    var downstream: Sink = dr.ok;
    var storage: [1]QueuedRecord;
    var queue: Queued;

    val no_storage: Created = queued(?queue, nil, 1, ?downstream, 64, record.OVERSIZE_REJECT, OVERLOAD_BLOCK);
    if (!sel no_storage.err) { ret 2; }
    if (!sel no_storage.err.invalid) { ret 3; }
    # a queue may not promise more than its downstream can take
    val wider: Created = queued(?queue, (?storage)::*QueuedRecord, 1, ?downstream, 128, record.OVERSIZE_REJECT, OVERLOAD_BLOCK);
    if (!sel wider.err) { ret 4; }
    if (!sel wider.err.contract) { ret 5; }
    if (queue.initialized) { ret 6; }

    val qr: Created = queued(?queue, (?storage)::*QueuedRecord, 1, ?downstream, 64, record.OVERSIZE_REJECT, OVERLOAD_BLOCK);
    if (sel qr.err) { ret 7; }
    # join before close is a state refusal, and destroy before join another
    val early_join: Operation = queued_join(?queue);
    if (!sel early_join.err) { ret 8; }
    if (!sel early_join.err.open) { ret 9; }
    val early_destroy: Operation = queued_destroy(?queue);
    if (!sel early_destroy.err) { ret 10; }
    if (!sel early_destroy.err.unjoined) { ret 11; }
    if (!ok_op(queued_close_drain(?queue))) { ret 12; }
    # close is idempotent
    if (!ok_op(queued_close_drain(?queue))) { ret 13; }
    if (!ok_op(queued_join(?queue))) { ret 14; }
    # a second join after completion is ok, not a second native join
    if (!ok_op(queued_join(?queue))) { ret 15; }
    if (!ok_op(queued_destroy(?queue))) { ret 16; }
    # every operation on a destroyed queue is invalid
    val gone: Operation = queued_close_drain(?queue);
    if (!sel gone.err) { ret 17; }
    if (!sel gone.err.invalid) { ret 18; }
    if (queued_thread_error(?queue) != thread.ERROR_INVALID) { ret 19; }
    ret 0;
}

rec BlockingCapture {
    entered: *i64;
    release: *i64;
    calls:   i64;
}

fun blocking_write(ctx: ptr, data: *u8, len: usize) WriteReport {
    val capture: *BlockingCapture = ctx::*BlockingCapture;
    atomic.fetch_add(?capture.calls, 1);
    atomic.store(capture.entered, 1);
    os.thread_wake(capture.entered);
    for (atomic.load(capture.release) == 0) { os.thread_wait(capture.release, 0); }
    ret persisted(len);
}

test "log.sink: queued overload rejects new records without consuming them" {
    var entered: i64 = 0;
    var release: i64 = 0;
    var capture: BlockingCapture = BlockingCapture{entered: ?entered, release: ?release, calls: 0};
    var direct: Direct;
    val dr: Created = custom(?direct, ?capture, blocking_write, 128, record.OVERSIZE_REJECT, 0);
    if (sel dr.err) { ret 1; }
    var downstream: Sink = dr.ok;

    var storage: [1]QueuedRecord;
    var queue: Queued;
    val qr: Created = queued(?queue, (?storage)::*QueuedRecord, 1, ?downstream, 128, record.OVERSIZE_REJECT, OVERLOAD_REJECT_NEW);
    if (sel qr.err) { ret 2; }
    var output: Sink = qr.ok;
    val active: WriteReport = publish(?output, "active", 6);
    if (!sel active.status.enqueued) { ret 3; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    val waiting: WriteReport = publish(?output, "queued", 6);
    if (!sel waiting.status.enqueued) { ret 4; }
    val rejected_result: WriteReport = publish(?output, "caller-retains", 14);
    if (!sel rejected_result.status.rejected) { ret 5; }
    if (!sel rejected_result.status.rejected.queue_full) { ret 6; }
    if (rejected_result.offered != 14 || rejected_result.persisted != 0) { ret 7; }

    atomic.store(?release, 1);
    os.thread_wake(?release);
    if (!ok_op(queued_close_drain(?queue)) || !ok_op(queued_join(?queue))) { ret 8; }
    val result: QueueStats = queued_stats(?queue);
    if (result.enqueued != 2 || result.persisted != 2 || result.rejected != 1 || atomic.load(?capture.calls) != 2) { ret 9; }
    if (!ok_op(queued_destroy(?queue))) { ret 10; }
    ret 0;
}

test "log.sink: queued overload drops new records under the drop policy" {
    var entered: i64 = 0;
    var release: i64 = 0;
    var capture: BlockingCapture = BlockingCapture{entered: ?entered, release: ?release, calls: 0};
    var direct: Direct;
    val dr: Created = custom(?direct, ?capture, blocking_write, 128, record.OVERSIZE_REJECT, 0);
    if (sel dr.err) { ret 1; }
    var downstream: Sink = dr.ok;

    var storage: [1]QueuedRecord;
    var queue: Queued;
    val qr: Created = queued(?queue, (?storage)::*QueuedRecord, 1, ?downstream, 128, record.OVERSIZE_REJECT, OVERLOAD_DROP_NEW);
    if (sel qr.err) { ret 2; }
    var output: Sink = qr.ok;
    val active: WriteReport = publish(?output, "active", 6);
    if (!sel active.status.enqueued) { ret 3; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    val waiting: WriteReport = publish(?output, "queued", 6);
    if (!sel waiting.status.enqueued) { ret 4; }
    val dropped_result: WriteReport = publish(?output, "discarded", 9);
    if (!sel dropped_result.status.dropped) { ret 5; }
    if (dropped_result.offered != 9 || dropped_result.persisted != 0) { ret 6; }

    atomic.store(?release, 1);
    os.thread_wake(?release);
    if (!ok_op(queued_close_drain(?queue)) || !ok_op(queued_join(?queue))) { ret 7; }
    val result: QueueStats = queued_stats(?queue);
    if (result.enqueued != 2 || result.persisted != 2 || result.dropped != 1 || result.rejected != 0) { ret 8; }
    if (!ok_op(queued_destroy(?queue))) { ret 9; }
    ret 0;
}

rec QueuedJoinContext {
    queue:     *Queued;
    succeeded: *i64;
}

fun queued_join_worker(arg: *u8) {
    val context: *QueuedJoinContext = arg::*QueuedJoinContext;
    if (ok_op(queued_join(context.queue))) { atomic.fetch_add(context.succeeded, 1); }
}

test "log.sink: concurrent queued joins share one native join" {
    var entered: i64 = 0;
    var release: i64 = 0;
    var capture: BlockingCapture = BlockingCapture{entered: ?entered, release: ?release, calls: 0};
    var direct: Direct;
    val dr: Created = custom(?direct, ?capture, blocking_write, 128, record.OVERSIZE_REJECT, 0);
    if (sel dr.err) { ret 1; }
    var downstream: Sink = dr.ok;

    var storage: [1]QueuedRecord;
    var queue: Queued;
    val qr: Created = queued(?queue, (?storage)::*QueuedRecord, 1, ?downstream, 128, record.OVERSIZE_REJECT, OVERLOAD_BLOCK);
    if (sel qr.err) { ret 2; }
    var output: Sink = qr.ok;
    val active: WriteReport = publish(?output, "active", 6);
    if (!sel active.status.enqueued) { ret 3; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    if (!ok_op(queued_close_drain(?queue))) { ret 4; }

    var succeeded: i64 = 0;
    var context: QueuedJoinContext = QueuedJoinContext{queue: ?queue, succeeded: ?succeeded};
    var joins: [2]thread.Thread;
    val first: thread.Operation = thread.spawn_with(queued_join_worker, (?context)::*u8, ?joins[0]);
    if (sel first.err) { ret 5; }
    val second: thread.Operation = thread.spawn_with(queued_join_worker, (?context)::*u8, ?joins[1]);
    if (sel second.err) { thread.join(?joins[0]); ret 6; }
    var attempts: usize = 0;
    for (condition.waiter_count(?queue.joined) == 0 && attempts < 1000) {
        os.sleep(1000000);
        attempts = attempts + 1;
    }
    # destroy while a joiner waits is busy, not a release
    val busy: Operation = queued_destroy(?queue);
    if (!sel busy.err) { ret 7; }
    if (!sel busy.err.unjoined) { if (!sel busy.err.busy) { ret 8; } }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    thread.join(?joins[0]);
    thread.join(?joins[1]);
    if (condition.waiter_count(?queue.joined) != 0 || atomic.load(?succeeded) != 2) { ret 9; }
    if (!ok_op(queued_destroy(?queue))) { ret 10; }
    ret 0;
}

test "log.sink: queued abort returns unpublished records in fifo order" {
    var entered: i64 = 0;
    var release: i64 = 0;
    var capture: BlockingCapture = BlockingCapture{entered: ?entered, release: ?release, calls: 0};
    var direct: Direct;
    val dr: Created = custom(?direct, ?capture, blocking_write, 128, record.OVERSIZE_REJECT, 0);
    if (sel dr.err) { ret 1; }
    var downstream: Sink = dr.ok;

    var storage: [2]QueuedRecord;
    var queue: Queued;
    val qr: Created = queued(?queue, (?storage)::*QueuedRecord, 2, ?downstream, 128, record.OVERSIZE_REJECT, OVERLOAD_BLOCK);
    if (sel qr.err) { ret 2; }
    var output: Sink = qr.ok;
    val active: WriteReport = publish(?output, "active", 6);
    if (!sel active.status.enqueued) { ret 3; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    val first: WriteReport = publish(?output, "first", 5);
    val second: WriteReport = publish(?output, "second", 6);
    if (!sel first.status.enqueued) { ret 4; }
    if (!sel second.status.enqueued) { ret 5; }

    # storage too small keeps the records queued and reports the refusal
    var rejected_records: [2]QueuedRecord;
    val refused: Aborted = queued_close_abort(?queue, (?rejected_records)::*QueuedRecord, 1);
    if (!sel refused.err) { ret 6; }
    if (!sel refused.err.invalid) { ret 7; }
    if (queued_stats(?queue).aborted != 0) { ret 8; }

    val aborted: Aborted = queued_close_abort(?queue, (?rejected_records)::*QueuedRecord, 2);
    if (sel aborted.err) { ret 9; }
    if (aborted.ok != 2) { ret 10; }
    if (!bytes_equal((?rejected_records[0].data)::*u8, rejected_records[0].len, "first") || !bytes_equal((?rejected_records[1].data)::*u8, rejected_records[1].len, "second")) { ret 11; }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    if (!ok_op(queued_join(?queue))) { ret 12; }
    val result: QueueStats = queued_stats(?queue);
    if (result.aborted != 2 || result.persisted != 1 || atomic.load(?capture.calls) != 1) { ret 13; }
    if (!ok_op(queued_destroy(?queue))) { ret 14; }
    ret 0;
}
