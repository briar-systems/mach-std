# help pages rendered from the records std.args reads a command line against
#
# a page is written straight to a writer and nothing is allocated, so a program
# that writes to an unbuffered stream wraps it in io.writer.buffered first. every
# render checks the set and refuses a malformed one, since its pages would not be
# the contract parse enforces. text wraps at word boundaries to the width given,
# clamped to 56 through 240 columns.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.args;
use std.format;
use io_writer: std.io.writer;
use std.io.writer.WriteError;
use std.io.writer.Writer;
use std.process.env;

val DEFAULT_WIDTH: usize = 100;
val MIN_WIDTH:     usize = 56;
val MAX_WIDTH:     usize = 240;
val FLAG_COL:      usize = 24;
val EXIT_COL:      usize = 5;

# why a page was not written
# ---
# malformed: the set breaks the contract args.check states
# write:     the writer failed
pub tag HelpError: u8 {
    malformed: args.Malformed;
    write:     WriteError;
}

# a page help renders
# ---
# command: the command whose page it is, or nil for the overview
# action:  the action whose block it is, or nil for the whole page
pub rec Page {
    command: *args.CommandSpec;
    action:  *args.ActionSpec;
}

# the page an invocation that asks for help names: its command's page, its action's block, or
# the overview when it read no command or the set's help command
# ---
# inv: the invocation
# ret: the page
pub fun page_of(inv: *args.Invocation) Page {
    if (inv.command == nil || inv.command == inv.set.help) { ret Page{command: nil, action: nil}; }
    ret Page{command: inv.command, action: inv.action};
}

# a writer that keeps its first failure and the column it stands at
rec Out {
    w:      *Writer;
    failed: bool;
    error:  WriteError;
}

fun put_range(o: *Out, s: str, start: usize, end: usize) {
    if (o.failed || s == nil || end <= start) { ret; }
    val r: err[WriteError] = io_writer.write_all(o.w, ?s[start], end - start);
    if (sel r.err) {
        o.failed = true;
        o.error  = r.err;
    }
}

fun put(o: *Out, s: str) {
    put_range(o, s, 0, str_len(s));
}

fun spaces(o: *Out, n: usize) {
    var i: usize = 0;
    for (i < n) {
        put(o, " ");
        i = i + 1;
    }
}

fun len(s: str) usize {
    ret str_len(s);
}

fun filled(s: str) bool {
    ret s != nil && s[0] != 0;
}

# a wrapped line being written
# ---
# col:          the column the next byte lands in
# continuation: the column a wrapped line starts at
# width:        the column no word passes
# has_text:     a word stands on the line, so the next takes a space first
rec Wrap {
    col:          usize;
    continuation: usize;
    width:        usize;
    has_text:     bool;
}

fun wrap_at(col: usize, continuation: usize, width: usize, has_text: bool) Wrap {
    ret Wrap{col: col, continuation: continuation, width: width, has_text: has_text};
}

# the word from start to end of text with suffix stuck to it, as a comma is, on this line when
# both fit and on the next otherwise
fun wrap_word(o: *Out, w: *Wrap, text: str, start: usize, end: usize, suffix: str) {
    val word: usize = end - start + len(suffix);
    var need: usize = word;
    if (w.has_text) { need = need + 1; }
    if (w.has_text && w.col + need > w.width) {
        put(o, "\n");
        spaces(o, w.continuation);
        w.col      = w.continuation;
        w.has_text = false;
    }
    if (w.has_text) {
        put(o, " ");
        w.col = w.col + 1;
    }
    put_range(o, text, start, end);
    put(o, suffix);
    w.col      = w.col + word;
    w.has_text = true;
}

fun blank_byte(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

fun wrap_text(o: *Out, w: *Wrap, text: str) {
    val n: usize = len(text);
    var i: usize = 0;
    for (i < n) {
        for (i < n && blank_byte(text[i])) { i = i + 1; }
        if (i >= n) { ret; }
        val start: usize = i;
        for (i < n && !blank_byte(text[i])) { i = i + 1; }
        wrap_word(o, w, text, start, i, "");
    }
}

fun width_of(width: usize) usize {
    if (width < MIN_WIDTH) { ret MIN_WIDTH; }
    if (width > MAX_WIDTH) { ret MAX_WIDTH; }
    ret width;
}

# the terminal width COLUMNS names, clamped to 56 through 240, and 100 when it is unset or not a
# number
pub fun terminal_width() usize {
    var buf:  [16]u8;
    val read: res[opt[usize], env.EnvError] = env.get("COLUMNS", ?buf[0], 16);
    if (sel read.err)     { ret DEFAULT_WIDTH; }
    if (sel read.ok.none) { ret DEFAULT_WIDTH; }
    val n: usize = read.ok.some;
    if (n == 0 || n >= 16) { ret DEFAULT_WIDTH; }
    var width: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (buf[i] < '0' || buf[i] > '9') { ret DEFAULT_WIDTH; }
        width = width * 10 + (buf[i] - '0')::usize;
        i     = i + 1;
    }
    ret width_of(width);
}

# where a page's relations come from: the command page, or one action's block
rec Scope {
    set:     *args.CommandSet;
    command: *args.CommandSpec;
    action:  *args.ActionSpec;
}

# whether a shared relation belongs to a scope: in force on the command page, or in force in the
# action's schema only
fun shared_in_scope(s: *Scope, rel: *args.Relation) bool {
    if (s.action == nil) { ret args.relation_active(s.set, s.command, nil, rel); }
    ret args.relation_active(s.set, s.command, s.action, rel) && !args.relation_active(s.set, s.command, nil, rel);
}

# the relation at i of the scope's relations, shared ones first. nil past the end or for a shared
# relation the scope does not hold
fun scope_relation(s: *Scope, i: usize) *args.Relation {
    if (i < s.set.relation_n) {
        val shared: *args.Relation = ?s.set.relations[i];
        if (shared_in_scope(s, shared)) { ret shared; }
        ret nil;
    }
    val j: usize = i - s.set.relation_n;
    if (s.action == nil) {
        if (j < s.command.relation_n) { ret ?s.command.relations[j]; }
        ret nil;
    }
    if (j < s.action.relation_n) { ret ?s.action.relations[j]; }
    ret nil;
}

fun scope_relation_n(s: *Scope) usize {
    if (s.action == nil) { ret s.set.relation_n + s.command.relation_n; }
    ret s.set.relation_n + s.action.relation_n;
}

# the row a relation of kind at i of the scope binds row to, or nil. a conflict binds both ways,
# a requirement and an implication only from their own row
fun related_at(s: *Scope, i: usize, row: *args.FlagSpec, kind: args.RelationKind) *args.FlagSpec {
    val rel: *args.Relation = scope_relation(s, i);
    if (rel == nil || rel.kind != kind)                      { ret nil; }
    if (rel.row == row)                                      { ret rel.other; }
    if (kind == args.RELATION_CONFLICTS && rel.other == row) { ret rel.row; }
    ret nil;
}

fun option_lead(o: *Out, w: *Wrap, indent: str, label: str, width: usize) {
    put(o, indent);
    put(o, "  ");
    put(o, label);
    @w = wrap_at(len(indent) + 2 + len(label), len(indent) + 4, width, filled(label));
}

fun option_meta(o: *Out, indent: str, label: str, text: str, width: usize) {
    var w: Wrap;
    option_lead(o, ?w, indent, label, width);
    wrap_text(o, ?w, text);
    put(o, "\n");
}

# the rows a relation of kind binds row to in a scope, after label and joined with commas
fun related(o: *Out, s: *Scope, row: *args.FlagSpec, kind: args.RelationKind, label: str, indent: str, width: usize) {
    var w:    Wrap;
    var held: *args.FlagSpec = nil;
    var i:    usize          = 0;
    for (i < scope_relation_n(s)) {
        val other: *args.FlagSpec = related_at(s, i, row, kind);
        i = i + 1;
        if (other == nil) { cnt; }
        if (held == nil)  { option_lead(o, ?w, indent, label, width); }
        or                { wrap_word(o, ?w, held.name, 0, len(held.name), ","); }
        held = other;
    }
    if (held != nil) {
        wrap_word(o, ?w, held.name, 0, len(held.name), "");
        put(o, "\n");
    }
}

fun option(o: *Out, s: *Scope, table: *args.TableRef, j: usize, indent: str, width: usize) {
    val flag: *args.FlagSpec = table.rows[j];
    put(o, indent);
    put(o, flag.name);
    var label: usize = len(indent) + len(flag.name);
    if (flag.arity == args.ARITY_ATTACHED) {
        if (flag.name[1] == '-') { put(o, "[="); }
        or                       { put(o, "["); }
        put(o, flag.value);
        put(o, "]");
        label = label + len(flag.value) + 3;
    }
    or (filled(flag.value)) {
        put(o, " <");
        put(o, flag.value);
        put(o, ">");
        label = label + len(flag.value) + 3;
    }
    var col: usize = FLAG_COL + len(indent) - 2;
    if (col + 12 > width) { col = len(indent) + 4; }
    if (label < col)      { spaces(o, col - label); }
    or {
        put(o, "\n");
        spaces(o, col);
    }
    var w: Wrap = wrap_at(col, col, width, false);
    wrap_text(o, ?w, args.row_doc(table, j));
    put(o, "\n");
    if (filled(flag.default))     { option_meta(o, indent, "default:", flag.default, width); }
    if (flag.negatable)           { option_meta(o, indent, "", "negatable with --no-", width); }
    if (sel flag.occurs.collect)  { option_meta(o, indent, "", "repeatable", width); }
    if (sel flag.occurs.override) { option_meta(o, indent, "", "repeatable, the last wins", width); }
    related(o, s, flag, args.RELATION_CONFLICTS, "conflicts:", indent, width);
    related(o, s, flag, args.RELATION_REQUIRES, "requires:", indent, width);
    related(o, s, flag, args.RELATION_IMPLIES, "implies:", indent, width);
    if (flag.alias_of != nil) { option_meta(o, indent, "alias of:", flag.alias_of.name, width); }
}

fun tables(o: *Out, s: *Scope, list: *args.TableRef, n: usize, indent: str, width: usize) {
    var i: usize = 0;
    for (i < n) {
        val table: *args.TableRef = ?list[i];
        var j:     usize          = 0;
        for (j < table.n) {
            if (table.accepted == nil || table.accepted[j]) { option(o, s, table, j, indent, width); }
            j = j + 1;
        }
        i = i + 1;
    }
}

fun examples(o: *Out, list: *str, n: usize, indent: str, width: usize) {
    if (n == 0) { ret; }
    put(o, "\n");
    put(o, indent);
    put(o, "examples:\n");
    var i: usize = 0;
    for (i < n) {
        put(o, indent);
        put(o, "  ");
        var w: Wrap = wrap_at(len(indent) + 2, len(indent) + 2, width, false);
        wrap_text(o, ?w, list[i]);
        put(o, "\n");
        i = i + 1;
    }
}

fun constraint_lead(o: *Out, w: *Wrap, heading: *bool, indent: str, width: usize) {
    if (!@heading) {
        put(o, "\n");
        put(o, indent);
        put(o, "constraints:\n");
        @heading = true;
    }
    put(o, indent);
    put(o, "  ");
    @w = wrap_at(len(indent) + 2, len(indent) + 2, width, false);
}

# the constraints of a scope: the sentence of each relation that can be broken, which is the text
# a refusal of it prints, then the scope's own sentences
fun constraints(o: *Out, s: *Scope, list: *str, n: usize, indent: str, width: usize) {
    var heading: bool  = false;
    var w:       Wrap;
    var i:       usize = 0;
    for (i < scope_relation_n(s)) {
        val rel: *args.Relation = scope_relation(s, i);
        i = i + 1;
        if (rel == nil) { cnt; }
        val said: args.Sentence = args.relation_sentence(rel);
        if (!filled(said.row)) { cnt; }
        constraint_lead(o, ?w, ?heading, indent, width);
        wrap_text(o, ?w, said.row);
        wrap_text(o, ?w, said.joint);
        wrap_text(o, ?w, said.other);
        wrap_text(o, ?w, said.tail);
        put(o, "\n");
    }
    var c: usize = 0;
    for (c < n) {
        val text: str = list[c];
        c = c + 1;
        if (!filled(text)) { cnt; }
        constraint_lead(o, ?w, ?heading, indent, width);
        wrap_text(o, ?w, text);
        put(o, "\n");
    }
}

# one exit row: the code, or `any` for the codes a command forwards, then its meaning and, when a
# command refines a shared code, `or` and the refinement
fun exit_row(o: *Out, code: i64, meaning: str, refinement: str, indent: str, width: usize) {
    var label: [format.DECIMAL_MAX + 1]u8;
    var n:     usize = 3;
    if (code == args.PASSTHROUGH) {
        label[0] = 'a';
        label[1] = 'n';
        label[2] = 'y';
    }
    or { n = format.put_i64(?label[0], code); }
    label[n] = 0;
    put(o, indent);
    put(o, (?label[0])::str);
    if (n < EXIT_COL) { spaces(o, EXIT_COL - n); }
    or                { put(o, " "); }
    var w: Wrap = wrap_at(len(indent) + EXIT_COL, len(indent) + EXIT_COL, width, false);
    wrap_text(o, ?w, meaning);
    if (filled(refinement)) {
        wrap_text(o, ?w, "or");
        wrap_text(o, ?w, refinement);
    }
    put(o, "\n");
}

fun shared_code(set: *args.CommandSet, code: i64) bool {
    var i: usize = 0;
    for (i < set.exit_n) {
        if (set.exits[i].code == code) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the exit rows of a page: a forwarded code first, then the set's codes with the command's
# refinements, then the command's own codes
fun exits(o: *Out, set: *args.CommandSet, own: *args.Exit, own_n: usize, indent: str, width: usize) {
    var i: usize = 0;
    for (i < own_n) {
        if (own[i].code == args.PASSTHROUGH) { exit_row(o, own[i].code, own[i].meaning, "", indent, width); }
        i = i + 1;
    }
    var si: usize = 0;
    for (si < set.exit_n) {
        val shared:     *args.Exit = ?set.exits[si];
        var refinement: str        = "";
        var j:          usize      = 0;
        for (j < own_n) {
            if (own[j].code == shared.code) { refinement = own[j].meaning; }
            j = j + 1;
        }
        exit_row(o, shared.code, shared.meaning, refinement, indent, width);
        si = si + 1;
    }
    i = 0;
    for (i < own_n) {
        val code: i64 = own[i].code;
        if (code != args.PASSTHROUGH && !shared_code(set, code)) { exit_row(o, code, own[i].meaning, "", indent, width); }
        i = i + 1;
    }
}

# one entry of the overview's list: its name in the label column, then its text wrapped
fun listed(o: *Out, w: *Wrap, name: str, width: usize) {
    put(o, "  ");
    put(o, name);
    val label: usize = 2 + len(name);
    if (label < 12) { spaces(o, 12 - label); }
    or              { put(o, "\n            "); }
    @w = wrap_at(12, 12, width, false);
}

fun overview_body(o: *Out, set: *args.CommandSet, width: usize) {
    var head: Wrap = wrap_at(0, 0, width, false);
    wrap_text(o, ?head, set.title);
    put(o, "\n\nusage: ");
    put(o, set.program);
    put(o, " <command> [options]\n\ncommands:\n");
    var i: usize = 0;
    for (i < set.n) {
        val command: *args.CommandSpec = set.specs[i];
        var w:       Wrap;
        listed(o, ?w, command.name, width);
        wrap_text(o, ?w, command.summary);
        if (command.alias_n > 0) {
            wrap_text(o, ?w, "(aliases:");
            var j: usize = 0;
            for (j < command.alias_n) {
                wrap_text(o, ?w, command.aliases[j]);
                j = j + 1;
            }
            wrap_text(o, ?w, ")");
        }
        put(o, "\n");
        i = i + 1;
    }
    if (set.global_n > 0) { put(o, "\noptions:\n"); }
    var g: usize = 0;
    for (g < set.global_n) {
        val row: *args.FlagSpec = set.globals[g].row;
        var w:   Wrap;
        listed(o, ?w, row.name, width);
        wrap_text(o, ?w, row.doc);
        put(o, "\n");
        g = g + 1;
    }
    if (filled(set.footer)) {
        put(o, "\n");
        var foot: Wrap = wrap_at(0, 0, width, false);
        wrap_text(o, ?foot, set.footer);
        put(o, "\n");
    }
}

# one action's block, as the command page lists it and as a page of its own prints it
fun action_block(o: *Out, set: *args.CommandSet, command: *args.CommandSpec, action: *args.ActionSpec, width: usize) {
    var s: Scope = Scope{set: set, command: command, action: action};
    put(o, "  ");
    var heading: Wrap = wrap_at(2, 4, width, false);
    wrap_text(o, ?heading, action.name);
    wrap_text(o, ?heading, action.grammar);
    put(o, "\n    ");
    var effect: Wrap = wrap_at(4, 4, width, false);
    wrap_text(o, ?effect, action.effect);
    put(o, "\n    exit:\n");
    exits(o, set, action.exits, action.exit_n, "      ", width);
    if (action.table_n > 0) {
        put(o, "    options:\n");
        tables(o, ?s, action.tables, action.table_n, "      ", width);
    }
    constraints(o, ?s, action.constraints, action.constraint_n, "    ", width);
    examples(o, action.examples, action.example_n, "    ", width);
}

fun command_body(o: *Out, set: *args.CommandSet, command: *args.CommandSpec, width: usize) {
    if (command == set.help) {
        overview_body(o, set, width);
        ret;
    }
    put(o, "usage: ");
    put(o, set.program);
    var s:     Scope = Scope{set: set, command: command, action: nil};
    var usage: Wrap  = wrap_at(7 + len(set.program), 2, width, true);
    wrap_text(o, ?usage, command.name);
    wrap_text(o, ?usage, command.grammar);
    put(o, "\n\n");
    if (command.alias_n > 0) {
        put(o, "aliases:\n");
        var i: usize = 0;
        for (i < command.alias_n) {
            put(o, "  ");
            put(o, command.aliases[i]);
            put(o, "\n");
            i = i + 1;
        }
    }
    put(o, "effect:");
    var effect: Wrap = wrap_at(7, 8, width, true);
    wrap_text(o, ?effect, command.effect);
    put(o, "\n");
    if (filled(command.terminator)) {
        put(o, "terminator:");
        var terminator: Wrap = wrap_at(11, 12, width, true);
        wrap_text(o, ?terminator, command.terminator);
        put(o, "\n");
    }
    if (command.table_n > 0) {
        put(o, "\noptions:\n");
        tables(o, ?s, command.tables, command.table_n, "  ", width);
    }
    constraints(o, ?s, command.constraints, command.constraint_n, "", width);
    if (command.action_n > 0) {
        put(o, "\nactions:\n");
        var k: usize = 0;
        for (k < command.action_n) {
            action_block(o, set, command, ?command.actions[k], width);
            k = k + 1;
        }
    }
    examples(o, command.examples, command.example_n, "", width);
    put(o, "\nexit:\n");
    exits(o, set, command.exits, command.exit_n, "  ", width);
}

fun ended(o: *Out) err[HelpError] {
    if (o.failed) { ret err[HelpError].err{HelpError.write{o.error}}; }
    ret err[HelpError].ok{};
}

# write a page of a command set wrapped to a width: the overview, a command's page or an action's
# block
# ---
# set:   the commands
# w:     the destination
# p:     the page, its command a member of the set and its action one of the command's
# width: columns, clamped to 56 through 240
# ret:   ok, or the set's flaw, or the write that failed
pub fun render(set: *args.CommandSet, w: *Writer, p: Page, width: usize) err[HelpError] {
    val bad: opt[args.Malformed] = args.check(set);
    if (sel bad.some) { ret err[HelpError].err{HelpError.malformed{bad.some}}; }
    var o: Out;
    o.w = w;
    val cols: usize = width_of(width);
    if (p.command == nil) { overview_body(?o, set, cols); }
    or (p.action == nil)  { command_body(?o, set, p.command, cols); }
    or                    { action_block(?o, set, p.command, p.action, cols); }
    ret ended(?o);
}
