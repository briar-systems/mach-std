# a neutral help page rendered from the records std.args reads a command line against
#
# the page of a command is its usage line, its help text, the commands nested
# under it and its flag table, wrapped at word boundaries to the width given,
# clamped to 56 through 240 columns. it is written straight to a writer and
# nothing is allocated, so a program that writes to an unbuffered stream wraps
# it in io.writer.buffered first. the page is opt-in: a program decides when to
# print it and what follows.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.args;
use io_writer: std.io.writer;
use std.io.writer.WriteError;
use std.io.writer.Writer;
use std.process.env;

val DEFAULT_WIDTH: usize = 100;
val MIN_WIDTH:     usize = 56;
val MAX_WIDTH:     usize = 240;
val FLAG_COL:      usize = 24;
val NAME_COL:      usize = 12;

# a writer that keeps its first failure and the column it stands at
rec Out {
    w:      *Writer;
    failed: bool;
    error:  WriteError;
}

fun put_range(o: *Out, s: str, start: usize, end: usize) {
    if (o.failed || s == nil || end <= start) { ret; }
    val r: err[WriteError] = io_writer.write_all(o.w, ?s[start], end - start);
    if (sel r.err) {
        o.failed = true;
        o.error  = r.err;
    }
}

fun put(o: *Out, s: str) {
    put_range(o, s, 0, str_len(s));
}

fun spaces(o: *Out, n: usize) {
    var i: usize = 0;
    for (i < n) {
        put(o, " ");
        i = i + 1;
    }
}

fun len(s: str) usize {
    ret str_len(s);
}

fun filled(s: str) bool {
    ret s != nil && s[0] != 0;
}

# a wrapped line being written
# ---
# col:          the column the next byte lands in
# continuation: the column a wrapped line starts at
# width:        the column no word passes
# has_text:     a word stands on the line, so the next takes a space first
rec Wrap {
    col:          usize;
    continuation: usize;
    width:        usize;
    has_text:     bool;
}

fun wrap_at(col: usize, continuation: usize, width: usize, has_text: bool) Wrap {
    ret Wrap{col: col, continuation: continuation, width: width, has_text: has_text};
}

# the word from start to end of text with suffix stuck to it, as a comma is, on this line when
# both fit and on the next otherwise
fun wrap_word(o: *Out, w: *Wrap, text: str, start: usize, end: usize, suffix: str) {
    val word: usize = end - start + len(suffix);
    var need: usize = word;
    if (w.has_text) { need = need + 1; }
    if (w.has_text && w.col + need > w.width) {
        put(o, "\n");
        spaces(o, w.continuation);
        w.col      = w.continuation;
        w.has_text = false;
    }
    if (w.has_text) {
        put(o, " ");
        w.col = w.col + 1;
    }
    put_range(o, text, start, end);
    put(o, suffix);
    w.col      = w.col + word;
    w.has_text = true;
}

fun blank_byte(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

fun wrap_text(o: *Out, w: *Wrap, text: str) {
    val n: usize = len(text);
    var i: usize = 0;
    for (i < n) {
        for (i < n && blank_byte(text[i])) { i = i + 1; }
        if (i >= n) { ret; }
        val start: usize = i;
        for (i < n && !blank_byte(text[i])) { i = i + 1; }
        wrap_word(o, w, text, start, i, "");
    }
}

fun width_of(width: usize) usize {
    if (width < MIN_WIDTH) { ret MIN_WIDTH; }
    if (width > MAX_WIDTH) { ret MAX_WIDTH; }
    ret width;
}

# the terminal width COLUMNS names, clamped to 56 through 240, and 100 when it is unset or not a
# number
pub fun terminal_width() usize {
    var buf:  [16]u8;
    val read: res[opt[usize], env.EnvError] = env.get("COLUMNS", ?buf[0], 16);
    if (sel read.err)     { ret DEFAULT_WIDTH; }
    if (sel read.ok.none) { ret DEFAULT_WIDTH; }
    val n: usize = read.ok.some;
    if (n == 0 || n >= 16) { ret DEFAULT_WIDTH; }
    var width: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (buf[i] < '0' || buf[i] > '9') { ret DEFAULT_WIDTH; }
        width = width * 10 + (buf[i] - '0')::usize;
        i     = i + 1;
    }
    ret width_of(width);
}

fun put_byte(o: *Out, c: u8) {
    var b: [2]u8;
    b[0] = c;
    put(o, (?b[0])::str);
}

# a label written at the start of a row, then its text wrapped from col, on the next line when the
# label reaches col
fun row(o: *Out, label: usize, col: usize, text: str, width: usize) {
    if (label < col) { spaces(o, col - label); }
    or {
        put(o, "\n");
        spaces(o, col);
    }
    var w: Wrap = wrap_at(col, col, width, false);
    wrap_text(o, ?w, text);
    put(o, "\n");
}

# one flag of the table: `-c, --[no-]name <value>`, `...` when it repeats, then its help text
fun flag_row(o: *Out, f: *args.Flag, width: usize) {
    var label: usize = 2;
    put(o, "  ");
    if (f.short != 0) {
        put_byte(o, '-');
        put_byte(o, f.short);
        label = label + 2;
        if (filled(f.long)) {
            put(o, ", ");
            label = label + 2;
        }
    }
    or {
        put(o, "    ");
        label = label + 4;
    }
    if (filled(f.long)) {
        put(o, "--");
        label = label + 2;
        if (f.negatable) {
            put(o, "[no-]");
            label = label + 5;
        }
        put(o, f.long);
        label = label + len(f.long);
    }
    if (args.takes_value(f)) {
        put(o, " <");
        put(o, f.value);
        put(o, ">");
        label = label + len(f.value) + 3;
    }
    if (f.repeat) {
        put(o, "...");
        label = label + 3;
    }
    var col: usize = FLAG_COL;
    if (col + 12 > width) { col = 6; }
    row(o, label, col, f.help, width);
}

# one nested command: its name, its help text, then its aliases
fun command_row(o: *Out, c: *args.Command, width: usize) {
    put(o, "  ");
    put(o, c.name);
    val label: usize = 2 + len(c.name);
    if (label < NAME_COL) { spaces(o, NAME_COL - label); }
    or {
        put(o, "\n");
        spaces(o, NAME_COL);
    }
    var w: Wrap = wrap_at(NAME_COL, NAME_COL, width, false);
    wrap_text(o, ?w, c.help);
    if (c.aliases.size > 0) {
        wrap_text(o, ?w, "(aliases:");
        var j: usize = 0;
        for (j < c.aliases.size) {
            if (j + 1 < c.aliases.size) { wrap_word(o, ?w, c.aliases.data[j], 0, len(c.aliases.data[j]), ","); }
            or                          { wrap_word(o, ?w, c.aliases.data[j], 0, len(c.aliases.data[j]), ")"); }
            j = j + 1;
        }
    }
    put(o, "\n");
}

# write the page of the command a parsed line matched, wrapped to a width: the usage line of the
# path's command words, the command's help text, its nested commands and its flags
# ---
# p:     the parsed line
# w:     the destination
# width: columns, clamped to 56 through 240
# ret:   ok, or the write that failed
pub fun render(p: *args.Parsed, w: *Writer, width: usize) err[WriteError] {
    var o: Out;
    o.w = w;
    val cols: usize         = width_of(width);
    val c:    *args.Command = p.command;
    put(?o, "usage:");
    var usage: Wrap  = wrap_at(6, 2, cols, false);
    var d:     usize = 0;
    for (d <= p.depth) {
        val at: *args.Command = args.command_at(p, d);
        if (at != nil) { wrap_text(?o, ?usage, at.name); }
        d = d + 1;
    }
    if (c.commands.size > 0) { wrap_text(?o, ?usage, "<command>"); }
    if (c.flags.size > 0)    { wrap_text(?o, ?usage, "[options]"); }
    wrap_text(?o, ?usage, c.usage);
    put(?o, "\n");
    if (filled(c.help)) {
        put(?o, "\n");
        var text: Wrap = wrap_at(0, 0, cols, false);
        wrap_text(?o, ?text, c.help);
        put(?o, "\n");
    }
    if (c.commands.size > 0) {
        put(?o, "\ncommands:\n");
        var i: usize = 0;
        for (i < c.commands.size) {
            command_row(?o, c.commands.data[i], cols);
            i = i + 1;
        }
    }
    if (c.flags.size > 0) {
        put(?o, "\noptions:\n");
        var j: usize = 0;
        for (j < c.flags.size) {
            flag_row(?o, c.flags.data[j], cols);
            j = j + 1;
        }
    }
    if (o.failed) { ret err[WriteError].err{o.error}; }
    ret err[WriteError].ok{};
}
