# quaternions over f32x4
#
# a quaternion is stored in an f32x4 as {x, y, z, w}: the vector part in lanes
# 0-2 and the real part in lane 3. operations are algorithms over the lane-wise
# vector operators and scalar lane reads — no bit reinterpret at vector width,
# so correct on every target.
#
# the reciprocal square root normalization needs, and the acos/sin true slerp
# needs, come from the shared std.math.float module.

use std.math.float.acos_f32;
use std.math.float.rsqrt_f32;
use std.math.float.sin_f32;
use std.math.float.sqrt_f32;
use std.simd.reduce.dot_f32x4;
use std.simd.shuffle.splat_f32x4;
use std.types.bool.bool;

# the identity quaternion (no rotation)
# ---
# ret: {0, 0, 0, 1}
pub fun quat_identity() f32x4 {
    ret f32x4{0.0, 0.0, 0.0, 1.0};
}

# Hamilton product of two quaternions (composition of rotations)
# ---
# a:   left quaternion, applied second
# b:   right quaternion, applied first
# ret: the composed quaternion a*b
pub fun quat_mul(a: f32x4, b: f32x4) f32x4 {
    val ax: f32 = a[0];
    val ay: f32 = a[1];
    val az: f32 = a[2];
    val aw: f32 = a[3];
    val bx: f32 = b[0];
    val by: f32 = b[1];
    val bz: f32 = b[2];
    val bw: f32 = b[3];
    ret f32x4{
        aw * bx + ax * bw + ay * bz - az * by,
        aw * by - ax * bz + ay * bw + az * bx,
        aw * bz + ax * by - ay * bx + az * bw,
        aw * bw - ax * bx - ay * by - az * bz
    };
}

# conjugate of a quaternion (negate the vector part)
#
# for a unit quaternion this is the inverse rotation.
# ---
# q:   input quaternion
# ret: {-x, -y, -z, w}
pub fun quat_conjugate(q: f32x4) f32x4 {
    ret q * f32x4{-1.0, -1.0, -1.0, 1.0};
}

# dot product of two quaternions
# ---
# a:   first quaternion
# b:   second quaternion
# ret: a . b
pub fun quat_dot(a: f32x4, b: f32x4) f32 {
    ret dot_f32x4(a, b);
}

# length (magnitude) of a quaternion
# ---
# q:   input quaternion
# ret: sqrt(q . q)
pub fun quat_length(q: f32x4) f32 {
    ret sqrt_f32(dot_f32x4(q, q));
}

# normalize a quaternion to unit length
#
# scaling by the reciprocal length is a single lane-wise vector multiply.
# ---
# q:   input quaternion (must be non-zero)
# ret: q / |q|
pub fun quat_normalize(q: f32x4) f32x4 {
    ret q * splat_f32x4(rsqrt_f32(dot_f32x4(q, q)));
}

# normalized linear interpolation between two quaternions
#
# lerps the components then renormalizes, taking the shortest arc by flipping b
# when the quaternions face opposite hemispheres. cheaper than true slerp and a
# close approximation for nearby rotations; `quat_slerp` is the exact,
# constant-angular-velocity interpolation.
# ---
# a:   start quaternion (unit)
# b:   end quaternion (unit)
# t:   interpolation factor in [0, 1]
# ret: the interpolated unit quaternion
pub fun quat_nlerp(a: f32x4, b: f32x4, t: f32) f32x4 {
    var bb: f32x4 = b;
    if (dot_f32x4(a, b) < 0.0) {
        bb = b * splat_f32x4(-1.0);
    }
    val ta: f32x4 = splat_f32x4(1.0 - t);
    val tb: f32x4 = splat_f32x4(t);
    ret quat_normalize(a * ta + bb * tb);
}

# spherical linear interpolation between two unit quaternions
#
# traces the shortest great-circle arc at constant angular velocity: flips b to
# the near hemisphere, then weights the endpoints by sin((1-t)*theta)/sin(theta)
# and sin(t*theta)/sin(theta) where theta is the angle between them. as the two
# quaternions approach coincidence sin(theta) -> 0 and the weights are
# ill-conditioned, so a near-parallel arc falls back to the normalized lerp —
# the exact limit there, not an approximation.
# ---
# a:   start quaternion (unit)
# b:   end quaternion (unit)
# t:   interpolation factor in [0, 1]
# ret: the interpolated unit quaternion
pub fun quat_slerp(a: f32x4, b: f32x4, t: f32) f32x4 {
    var bb: f32x4 = b;
    var d:  f32   = dot_f32x4(a, b);
    if (d < 0.0) {
        bb = b * splat_f32x4(-1.0);
        d  = 0.0 - d;
    }
    if (d > 0.9995) {
        ret quat_normalize(a * splat_f32x4(1.0 - t) + bb * splat_f32x4(t));
    }
    val theta: f32 = acos_f32(d);
    val st:    f32 = sin_f32(theta);
    val wa:    f32 = sin_f32((1.0 - t) * theta) / st;
    val wb:    f32 = sin_f32(t * theta) / st;
    ret a * splat_f32x4(wa) + bb * splat_f32x4(wb);
}

# per-lane absolute difference within tolerance
fun near(a: f32, b: f32) bool {
    var d: f32 = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    ret d < 0.0005;
}

test quat_mul__composes_rotations_and_inverts_by_conjugate {
    val s: f32   = 0.70710678; # sin/cos of 45 degrees
    val a: f32x4 = f32x4{0.0, 0.0, s, s};
    val r: f32x4 = quat_mul(a, a);
    # two 90-degree z rotations compose to (0, 0, 1, 0)
    if (!near(r[0], 0.0)) { ret 1; }
    if (!near(r[1], 0.0)) { ret 2; }
    if (!near(r[2], 1.0)) { ret 3; }
    if (!near(r[3], 0.0)) { ret 4; }
    val q: f32x4 = quat_normalize(f32x4{0.3, -0.5, 0.2, 0.8});
    val i: f32x4 = quat_mul(q, quat_conjugate(q));
    if (!near(i[0], 0.0)) { ret 5; }
    if (!near(i[1], 0.0)) { ret 6; }
    if (!near(i[2], 0.0)) { ret 7; }
    if (!near(i[3], 1.0)) { ret 8; }
    ret 0;
}

test quat_normalize__unit_length_same_direction {
    val q: f32x4 = f32x4{1.0, 2.0, 2.0, 4.0};
    # |q| = sqrt(1+4+4+16) = 5
    if (!near(quat_length(q), 5.0)) { ret 1; }
    val n: f32x4 = quat_normalize(q);
    if (!near(quat_length(n), 1.0)) { ret 2; }
    if (!near(n[0], 0.2))           { ret 3; }
    if (!near(n[3], 0.8))           { ret 4; }
    ret 0;
}

test quat_nlerp__endpoints_and_unit_result {
    val a:   f32x4 = quat_identity();
    val b:   f32x4 = quat_normalize(f32x4{0.0, 0.0, 0.70710678, 0.70710678});
    val at0: f32x4 = quat_nlerp(a, b, 0.0);
    if (!near(at0[3], 1.0)) { ret 1; }
    val at1: f32x4 = quat_nlerp(a, b, 1.0);
    if (!near(at1[2], 0.70710678)) { ret 2; }
    val mid: f32x4 = quat_nlerp(a, b, 0.5);
    if (!near(quat_length(mid), 1.0)) { ret 3; }
    ret 0;
}

test quat_slerp__arc_midpoint_and_near_parallel_fallback {
    val a: f32x4 = quat_identity();
    # b is a 90-degree rotation about z
    val b:   f32x4 = f32x4{0.0, 0.0, 0.70710678, 0.70710678};
    val at1: f32x4 = quat_slerp(a, b, 1.0);
    if (!near(at1[2], 0.70710678)) { ret 1; }
    if (!near(at1[3], 0.70710678)) { ret 2; }
    # halfway is a 45-degree rotation about z: {0, 0, sin22.5, cos22.5}
    val mid: f32x4 = quat_slerp(a, b, 0.5);
    if (!near(mid[2], 0.38268343))    { ret 3; }
    if (!near(mid[3], 0.92387953))    { ret 4; }
    if (!near(quat_length(mid), 1.0)) { ret 5; }
    val c:        f32x4 = quat_normalize(f32x4{0.0, 0.0, 0.001, 1.0});
    val near_mid: f32x4 = quat_slerp(a, c, 0.5);
    if (!near(quat_length(near_mid), 1.0)) { ret 6; }
    ret 0;
}
