# scalar floating-point math: roots and transcendentals in plain Mach
#
# every routine is a portable algorithm over the scalar float operators: no
# hardware sqrt or transcendental instruction, since the compiler has no
# SIMD-capable inline-asm encoders yet (a flagged gap, briar-systems/mach#2021).
#
# the public surface is single-precision (f32); each wrapper widens to f64,
# evaluates in double precision, and narrows the result, so the f32 answer is
# accurate to well under one f32 ulp. f64-precision entry points are a follow-up.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

val HALF_PI:   f64 = 1.5707963267948966;
val INV_PIO2:  f64 = 0.6366197723675814;
val PIO2_1:    f64 = 1.5707963109016418; # first 25 bits of pi/2
val PIO2_1T:   f64 = 1.5893254773528196e-8; # pi/2 - PIO2_1
val PIO2_2P62: f64 = 3.4061215800865545e-19; # pi/2 * 2^-62

# bits of 2/pi, word i holding the 32 bits that end 8i+8 bits after the point
val INV_PIO2_BITS: [24]u32 = [24]u32{
    0x000000a2, 0x0000a2f9, 0x00a2f983, 0xa2f9836e, 0xf9836e4e, 0x836e4e44,
    0x6e4e4415, 0x4e441529, 0x441529fc, 0x1529fc27, 0x29fc2757, 0xfc2757d1,
    0x2757d1f5, 0x57d1f534, 0xd1f534dd, 0xf534ddc0, 0x34ddc0db, 0xddc0db62,
    0xc0db6295, 0xdb629599, 0x6295993c, 0x95993c43, 0x993c4390, 0x3c439041
};

# an angle split into whole quarter turns and a remainder
rec Quadrant {
    n: u64;
    r: f64;
}

# reciprocal square root of a positive f64, bit-seed estimate refined by Newton
fun rsqrt64(x: f64) f64 {
    var i: u64 = x:~u64;
    i = 0x5fe6eb50c7b537a9 - (i >> 1);
    var y: f64 = i:~f64;
    val h: f64 = x * 0.5;
    y = y * (1.5 - h * y * y);
    y = y * (1.5 - h * y * y);
    y = y * (1.5 - h * y * y);
    y = y * (1.5 - h * y * y);
    y = y * (1.5 - h * y * y);
    ret y;
}

# square root of a non-negative f64
fun sqrt64(x: f64) f64 {
    if (x == 0.0) { ret 0.0; }
    ret x * rsqrt64(x);
}

# reduce a finite non-negative f32 to n quarter turns plus r in [-pi/4, pi/4]
#
# below 2^28 * pi/2 the quarter-turn count times a two-part pi/2 is exact in
# f64. above it the f32 significand multiplies a 96-bit window of 2/pi chosen by
# the exponent, so the dropped high bits only add whole turns.
fun reduce(a: f32) Quadrant {
    val bits: u32 = a:~u32;
    if (bits < 0x4dc90fdb) {
        val n:  u64 = (a::f64 * INV_PIO2 + 0.5)::u64;
        val nf: f64 = n::f64;
        ret Quadrant{n: n, r: a::f64 - nf * PIO2_1 - nf * PIO2_1T};
    }
    val j:     usize = ((bits >> 26) & 15)::usize;
    val shift: u32   = (bits >> 23) & 7;
    val m:     u64   = (((bits & 0x7fffff) | 0x800000) << shift)::u64;
    val hi:    u64   = (m * INV_PIO2_BITS[j]::u64) << 32;
    val mid:   u64   = m * INV_PIO2_BITS[j + 4]::u64;
    val lo:    u64   = (m * INV_PIO2_BITS[j + 8]::u64) >> 32;
    # f is x * 2/pi mod 4 in units of 2^-62
    var f: u64 = hi + mid + lo;
    val n: u64 = (f + (1::u64 << 61)) >> 62;
    f = f - (n << 62);
    ret Quadrant{n: n, r: (f:~i64)::f64 * PIO2_2P62};
}

# sine of n quarter turns plus r, for r in [-pi/4, pi/4]
fun quadrant_sin(n: u64, r: f64) f64 {
    val x2: f64 = r * r;
    var v:  f64 = 0.0;
    if ((n & 1) == 0) {
        v = r * (1.0 + x2 * (-0.16666666666666666 + x2 * (0.008333333333333333
            + x2 * (-0.0001984126984126984 + x2 * (0.0000027557319223985893
            + x2 * (-0.00000002505210838544172))))));
    }
    or {
        v = 1.0 + x2 * (-0.5 + x2 * (0.041666666666666664 + x2 * (-0.001388888888888889
            + x2 * (0.0000248015873015873 + x2 * (-0.0000002755731922398589
            + x2 * 0.00000000208767569878681)))));
    }
    if ((n & 2) != 0) { ret 0.0 - v; }
    ret v;
}

# arcsine of an f64 in [0, 0.5] via its odd Taylor series
fun asin_poly(x: f64) f64 {
    val x2: f64 = x * x;
    ret x * (1.0 + x2 * (0.16666666666666666 + x2 * (0.075 + x2 * (0.044642857142857144
        + x2 * (0.030381944444444444 + x2 * (0.022372159090909092 + x2 * (0.017352764423076924
        + x2 * (0.01396484375 + x2 * 0.011551800896139964))))))));
}

# arcsine of an f64 in [-1, 1]; folds |x| > 0.5 onto the small-argument series
fun asin64(x: f64) f64 {
    var neg: bool = false;
    var a:   f64  = x;
    if (a < 0.0) {
        neg = true;
        a   = 0.0 - a;
    }
    var r: f64 = 0.0;
    if (a <= 0.5) {
        r = asin_poly(a);
    }
    or {
        val s: f64 = sqrt64((1.0 - a) * 0.5);
        r = HALF_PI - 2.0 * asin_poly(s);
    }
    if (neg) { ret 0.0 - r; }
    ret r;
}

# square root of a non-negative scalar
#
# a Newton refinement in double precision, accurate to under one f32 ulp; a
# hardware sqrt awaits SIMD-capable inline-asm encoders in the compiler.
# ---
# x:   non-negative value
# ret: sqrt(x), or 0 for x == 0
pub fun sqrt_f32(x: f32) f32 {
    ret sqrt64(x::f64)::f32;
}

# reciprocal square root of a positive scalar
# ---
# x:   positive value
# ret: 1 / sqrt(x)
pub fun rsqrt_f32(x: f32) f32 {
    ret rsqrt64(x::f64)::f32;
}

# sine of an angle in radians
# ---
# x:   angle in radians
# ret: sin(x), or nan for an infinite or nan x
pub fun sin_f32(x: f32) f32 {
    val bits: u32 = x:~u32;
    if ((bits & 0x7fffffff) >= 0x7f800000) { ret x - x; }
    val q: Quadrant = reduce((bits & 0x7fffffff):~f32);
    val s: f64      = quadrant_sin(q.n, q.r);
    if ((bits >> 31) != 0) { ret (0.0 - s)::f32; }
    ret s::f32;
}

# cosine of an angle in radians
# ---
# x:   angle in radians
# ret: cos(x), or nan for an infinite or nan x
pub fun cos_f32(x: f32) f32 {
    val bits: u32 = x:~u32;
    if ((bits & 0x7fffffff) >= 0x7f800000) { ret x - x; }
    val q: Quadrant = reduce((bits & 0x7fffffff):~f32);
    ret quadrant_sin(q.n + 1, q.r)::f32;
}

# arcsine of a value in [-1, 1]
# ---
# x:   value in [-1, 1]
# ret: asin(x) in [-pi/2, pi/2]
pub fun asin_f32(x: f32) f32 {
    ret asin64(x::f64)::f32;
}

# arccosine of a value in [-1, 1]
# ---
# x:   value in [-1, 1]
# ret: acos(x) in [0, pi]
pub fun acos_f32(x: f32) f32 {
    ret (HALF_PI - asin64(x::f64))::f32;
}

# absolute difference within an f32 tolerance
#[testing]
fun near(a: f32, b: f32) bool {
    var d: f32 = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    ret d < 0.00005;
}

test sqrt__exact_squares_irrationals_and_reciprocal {
    if (sqrt_f32(0.0) != 0.0)            { ret 1; }
    if (sqrt_f32(144.0) != 12.0)         { ret 2; }
    if (!near(sqrt_f32(2.0), 1.4142135)) { ret 3; }
    if (!near(sqrt_f32(0.25), 0.5))      { ret 4; }
    if (!near(rsqrt_f32(100.0), 0.1))    { ret 5; }
    ret 0;
}

test sin_cos__known_angles_and_range_reduction {
    if (!near(sin_f32(0.5235988), 0.5))              { ret 1; } # pi/6
    if (!near(sin_f32(0.0 - 1.0), 0.0 - 0.84147096)) { ret 2; }
    if (!near(sin_f32(3.0), 0.14112002))             { ret 3; } # folded past pi/2
    if (!near(sin_f32(10.0), 0.0 - 0.5440211))       { ret 4; } # far-out reduction
    if (!near(cos_f32(3.1415927), 0.0 - 1.0))        { ret 5; } # pi
    if (!near(cos_f32(1.0), 0.54030234))             { ret 6; }
    ret 0;
}

test asin_acos__endpoints_and_folded_arguments {
    if (!near(asin_f32(0.5), 0.5235988))             { ret 1; } # pi/6
    if (!near(asin_f32(0.0 - 1.0), 0.0 - 1.5707963)) { ret 2; }
    if (!near(asin_f32(0.8), 0.9272952))             { ret 3; } # folded branch
    if (!near(acos_f32(0.0 - 1.0), 3.1415927))       { ret 4; } # pi
    if (!near(acos_f32(0.9), 0.4510268))             { ret 5; } # folded branch
    ret 0;
}
