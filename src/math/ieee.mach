# ieee 754 binary interchange formats as data
#
# every float conversion in std (std.text.parse and std.format) reads its width
# from a Format row rather than from code: one exact decimal parse, one hex
# parse, one shortest writer and one fixed-precision writer serve every row, so a
# further binary format (bfloat16, binary128) is one more row. a value travels as
# its bit pattern in the low end of a u128, wide enough for any row up to
# binary128. everything rounding and the subnormal range need is derived from
# the three fields here.
#
# the exact conversions hold their intermediates in std.math.bignum.nat numbers
# over storage the caller sizes from the row: bignum_limbs gives the limbs one
# number of a row needs and max_sig_digits the digits a row can decide, so each
# width pays only for its own need. a row's literal sizes (F64_LIMBS and the
# like) are those derivations committed, for storage declared on the stack.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use std.math.bignum.nat;

# one ieee 754 binary interchange format
#
# every conversion accepts any row, with storage sized from it.
# ---
# mant_bits: stored fraction bits, the hidden leading bit excluded (52 for f64)
# exp_bits:  width of the biased exponent field (11 for f64)
# bias:      exponent bias (1023 for f64)
pub rec Format {
    mant_bits: u32;
    exp_bits:  u32;
    bias:      i64;
}

# binary16, the f16 type
pub val F16: Format = Format{mant_bits: 10, exp_bits: 5, bias: 15};

# binary32, the f32 type
pub val F32: Format = Format{mant_bits: 23, exp_bits: 8, bias: 127};

# binary64, the f64 type
pub val F64: Format = Format{mant_bits: 52, exp_bits: 11, bias: 1023};

# bignum_limbs of each row, committed so storage can be declared from it
pub val F16_LIMBS: usize = 5;
pub val F32_LIMBS: usize = 19;
pub val F64_LIMBS: usize = 117;

# max_sig_digits of each row, committed so storage can be declared from it
pub val F16_SIG_DIGITS: usize = 23;
pub val F32_SIG_DIGITS: usize = 114;
pub val F64_SIG_DIGITS: usize = 769;

# significand precision in bits, the hidden bit included
pub fun precision(f: Format) i64 {
    ret f.mant_bits::i64 + 1;
}

# the all-ones biased exponent field that marks inf and nan
pub fun exp_field_max(f: Format) i64 {
    ret ((1::u64 << f.exp_bits::u64) - 1)::i64;
}

# exponent of the smallest subnormal's single bit, the floor every lsb rounds at
pub fun min_lsb(f: Format) i64 {
    ret 1 - f.bias - f.mant_bits::i64;
}

# the hidden bit of a normal significand
pub fun hidden(f: Format) u128 {
    ret 1::u128 << f.mant_bits::u128;
}

# the sign bit of a pattern
pub fun sign_bit(f: Format) u128 {
    ret 1::u128 << (f.mant_bits + f.exp_bits)::u128;
}

# the positive infinity pattern
pub fun inf_bits(f: Format) u128 {
    ret exp_field_max(f)::u128 << f.mant_bits::u128;
}

# the positive quiet nan pattern
pub fun nan_bits(f: Format) u128 {
    ret inf_bits(f) | (1::u128 << (f.mant_bits - 1)::u128);
}

# significant decimal digits that can decide a rounding
#
# a midpoint between adjacent values is an odd multiple of 2^(min_lsb-1), so its
# decimal expansion ends bias + mant_bits places after the point, and the longest
# sits just under 2^(2-bias); 1233/4096 under-estimates log10(2), so this bound is
# never short. digits past it only ever matter as nonzero or not.
pub fun max_sig_digits(f: Format) i64 {
    ret f.bias + f.mant_bits::i64 + 1 - ((f.bias - 2) * 1233) / 4096;
}

# decimal magnitude past which a value is certainly inf
#
# a value M * 10^D with D + floor(bitlen(M) * log10(2)) above this exceeds
# 2^(bias+1), since that estimate exceeds log10 of the value by less than 1/3.
pub fun max_decimal_exp(f: Format) i64 {
    ret ((f.bias + 1) * 1233) / 4096 + 3;
}

# decimal magnitude below which a value certainly rounds to zero
#
# the same estimate below this puts the value under half the smallest subnormal,
# 2^(min_lsb-1), since it falls short of log10 of the value by less than 1.02.
pub fun min_decimal_exp(f: Format) i64 {
    ret 0 - ((f.bias + f.mant_bits::i64 + 1) * 1233) / 4096 - 3;
}

# a bound on the bits any exact conversion of f holds in one bignum
#
# the power of ten scaling the smallest full significand of max_sig_digits digits
# (each under 3.33 bits) with a quotient's worth of bits on top.
pub fun bignum_bits(f: Format) i64 {
    # every ieee shape holds more here than the significand at the subnormal floor
    val scale: i64 = max_sig_digits(f) - min_decimal_exp(f);
    ret (scale * 3402) / 1024 + precision(f) + 3 + 32;
}

# the 32-bit limbs one bignum of an exact conversion of f needs
pub fun bignum_limbs(f: Format) usize {
    ret ((bignum_bits(f) + 31) / 32)::usize;
}

# a pattern taken apart into sign, biased exponent field and stored fraction
# ---
# neg:   the sign bit
# field: the biased exponent field
# frac:  the stored fraction bits
pub rec Fields {
    neg:   bool;
    field: i64;
    frac:  u128;
}

# take a pattern apart
# ---
# f:    the pattern's format
# bits: the pattern in the low end
# ret:  its sign, exponent field and fraction
pub fun fields(f: Format, bits: u128) Fields {
    val mask: u128 = hidden(f) - 1;
    ret Fields{
        neg:   (bits & sign_bit(f)) != 0,
        field: ((bits >> f.mant_bits::u128) & exp_field_max(f)::u128)::i64,
        frac:  bits & mask
    };
}

# the finite value of a pattern's fields as sig * 2^exp
# ---
# f:       the pattern's format
# p:       fields of a finite pattern
# out_sig: the significand, hidden bit included for a normal
# out_exp: the exponent of the significand's lowest bit
pub fun value(f: Format, p: Fields, out_sig: *u128, out_exp: *i64) {
    if (p.field == 0) {
        @out_sig = p.frac;
        @out_exp = min_lsb(f);
        ret;
    }
    @out_sig = p.frac | hidden(f);
    @out_exp = p.field + min_lsb(f) - 1;
}

# number of significant bits in v (0 when v == 0)
fun bitlen_u128(v: u128) i64 {
    var n: i64  = 0;
    var x: u128 = v;
    for (x > 0) {
        n = n + 1;
        x = x >> 1;
    }
    ret n;
}

# the nearest pattern to (sig + d) * 2^exp, 0 <= d < 1, ties to even
#
# the one rounding every parse ends in. sticky says d > 0, and is only set when
# sig carries at least one bit below the result's lsb, so the bits dropped there
# and sticky decide the rounding exactly. a zero sig packs to zero, so a caller
# passes it only for a value under half the smallest subnormal. a value past the
# largest finite by half an ulp or more is inf.
# ---
# f:      the target format
# neg:    the sign of the result
# sig:    the significand
# exp:    the exponent of sig's lowest bit
# sticky: whether nonzero bits lie below sig
# ret:    the correctly rounded pattern
pub fun pack(f: Format, neg: bool, sig: u128, exp: i64, sticky: bool) u128 {
    var sign: u128 = 0;
    if (neg)      { sign = sign_bit(f); }
    if (sig == 0) { ret sign; }

    val top: i64 = exp + bitlen_u128(sig) - 1;
    var lsb: i64 = top - f.mant_bits::i64;
    if (lsb < min_lsb(f)) { lsb = min_lsb(f); }

    var m: u128 = 0;
    if (lsb <= exp) {
        m = sig << (exp - lsb)::u128;
    }
    or {
        val shift: i64  = lsb - exp;
        var up:    bool = false;
        if (shift > 128) {
            m = 0;
        }
        or (shift == 128) {
            m  = 0;
            up = sig > (1::u128 << 127) || (sig == (1::u128 << 127) && sticky);
        }
        or {
            m = sig >> shift::u128;
            val rest: u128 = sig & ((1::u128 << shift::u128) - 1);
            val half: u128 = 1::u128 << (shift - 1)::u128;
            up = rest > half || (rest == half && (sticky || (m & 1) == 1));
        }
        if (up) { m = m + 1; }
    }

    if (m < hidden(f)) { ret sign | m; }
    var field: i64 = lsb - min_lsb(f) + 1;
    if (m == hidden(f) << 1) {
        m     = m >> 1;
        field = field + 1;
    }
    if (field >= exp_field_max(f)) { ret sign | inf_bits(f); }
    ret sign | (field::u128 << f.mant_bits::u128) | (m & (hidden(f) - 1));
}

# bfloat16, a row no conversion is written for, proving a new row is data only
#[testing]
pub val BF16: Format = Format{mant_bits: 7, exp_bits: 8, bias: 127};

# binary128, the widest row a u128 pattern carries, also written for by no code
#[testing]
pub val F128: Format = Format{mant_bits: 112, exp_bits: 15, bias: 16383};

# the committed sizes of the test rows, as the shipped rows have
#[testing]
pub val BF16_LIMBS:      usize = 16;
#[testing]
pub val BF16_SIG_DIGITS: usize = 98;
#[testing]
pub val F128_LIMBS:      usize = 1722;
#[testing]
pub val F128_SIG_DIGITS: usize = 11565;

# every row's derived constants against their published values
test ieee__rows_derive_their_constants {
    if (min_lsb(F16) != -24 || min_lsb(F32) != -149 || min_lsb(F64) != -1074) { ret 1; }
    if (inf_bits(F16) != 0x7C00 || inf_bits(F32) != 0x7F800000)               { ret 2; }
    if (inf_bits(F64) != 0x7FF0000000000000)                                  { ret 2; }
    if (nan_bits(F16) != 0x7E00 || nan_bits(F32) != 0x7FC00000)               { ret 3; }
    if (nan_bits(F64) != 0x7FF8000000000000 || inf_bits(BF16) != 0x7F80)      { ret 3; }
    if (sign_bit(F16) != 0x8000 || sign_bit(F64) != 0x8000000000000000)       { ret 4; }
    if (min_lsb(F128) != -16494 || inf_bits(F128) != (0x7FFF::u128 << 112))   { ret 4; }
    if (sign_bit(F128) != (1::u128 << 127))                                   { ret 4; }
    if (nan_bits(F128) != (0xFFFF::u128 << 111))                              { ret 4; }
    # the longest midpoints, (2^(p+1) - 1) * 2^(min_lsb-1): 22 digits for f16,
    # 113 for f32, 768 for f64 and 11564 for binary128
    if (max_sig_digits(F16) < 22 || max_sig_digits(F16) > 24)         { ret 5; }
    if (max_sig_digits(F32) < 113 || max_sig_digits(F32) > 116)       { ret 5; }
    if (max_sig_digits(F64) < 768 || max_sig_digits(F64) > 771)       { ret 5; }
    if (max_sig_digits(F128) < 11564 || max_sig_digits(F128) > 11568) { ret 5; }
    ret 0;
}

# pack rounds half to even at every boundary a parse can reach: a tie either way,
# a sticky tie, the subnormal floor, a subnormal carrying into the smallest normal,
# the largest finite carrying into inf, and a shift wider than the significand
test ieee__pack_rounds_half_to_even {
    # 1 + 2^-11 is the f16 midpoint between 1 and its successor: even is 1
    if (pack(F16, false, 0x801, -11, false) != 0x3C00) { ret 1; }
    if (pack(F16, false, 0x801, -11, true) != 0x3C01)  { ret 2; }
    # 1 + 3*2^-11 sits between 0x3C01 and 0x3C02: even is up
    if (pack(F16, false, 0x803, -11, false) != 0x3C02) { ret 3; }
    # 2^-25 is half the smallest subnormal: even is zero, sticky lifts it
    if (pack(F16, true, 1, -25, false) != 0x8000) { ret 4; }
    if (pack(F16, false, 1, -25, true) != 0x0001) { ret 5; }
    # 3 * 2^-25 is between subnormals 1 and 2: even is 2
    if (pack(F16, false, 3, -25, false) != 0x0002) { ret 6; }
    # (2^11 - 1) * 2^-25 rounds up past the largest subnormal to 2^-14
    if (pack(F16, false, 0x7FF, -25, false) != 0x0400) { ret 7; }
    # (2^12 - 1) * 2^4 = 65520 is the midpoint past 65504: even is inf
    if (pack(F16, false, 0xFFF, 4, false) != 0x7C00) { ret 8; }
    if (pack(F16, false, 0xFFE, 4, true) != 0x7BFF)  { ret 9; }
    # 2^127 * 2^-200 is far below any f32 subnormal
    if (pack(F32, false, 1::u128 << 127, -400, true) != 0) { ret 10; }
    ret 0;
}

# the largest power of ten a parse divides by
#[testing]
fun widest_power(f: Format) i64 {
    ret max_sig_digits(f) - min_decimal_exp(f);
}

# bits of 10^k, exactly
#[testing]
fun pow10_bits(d: *u32, k: i64) i64 {
    var x: nat.Nat = nat.over(d);
    nat.from_u64(?x, 1);
    nat.mul_pow10(?x, k::usize);
    ret nat.bitlen(?x)::i64;
}

# every row's bignum covers its two widest values, computed exactly: a full
# significand of max_sig_digits digits shifted to the subnormal floor, and the
# widest power of ten with a quotient's bits on top. each row's committed sizes
# match their derivations.
test ieee__every_row_sizes_its_own_storage {
    var d:      [F128_LIMBS]u32;
    val rows:   [5]Format = [5]Format{F16, F32, F64, BF16, F128};
    val limbs:  [5]usize  = [5]usize{F16_LIMBS, F32_LIMBS, F64_LIMBS, BF16_LIMBS, F128_LIMBS};
    val digits: [5]usize  = [5]usize{F16_SIG_DIGITS, F32_SIG_DIGITS, F64_SIG_DIGITS, BF16_SIG_DIGITS, F128_SIG_DIGITS};
    var i:      usize     = 0;
    for (i < 5) {
        val f:    Format = rows[i];
        val bits: i64    = bignum_bits(f);
        if (bignum_limbs(f) != limbs[i] || max_sig_digits(f)::usize != digits[i])        { ret 1; }
        if (bignum_limbs(f) * 32 < bits::usize)                                          { ret 2; }
        if (pow10_bits(?d[0], max_sig_digits(f)) + f.bias + f.mant_bits::i64 + 1 > bits) { ret 3; }
        if (pow10_bits(?d[0], widest_power(f)) + precision(f) + 2 > bits)                { ret 4; }
        i = i + 1;
    }
    ret 0;
}
