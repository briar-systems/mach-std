# filesystem access over the platform namespace
#
# three layers: handle operations on an open File; whole-file convenience
# composing std.io (a File adapts to a Reader/Writer, so content flows through
# io.read_all/read_exact/write_all rather than hand-rolled loops); and
# namespace operations on a Path.
#
# errors are str messages, matching std.io: producers return R.Result[T, str],
# effects return O.Option[str] (none = success). predicates are total and
# answer false for a nil or missing path.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.path.Path;
use std.chrono.time.Time;
use std.collections.vector.Vector;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_copy;
use std.system.os;
use identities: std.system.file_identity;
fwd identities.Identity;
use removal: std.filesystem.removal;
use std.chrono.time;
use std.types.path;
use std.collections.vector;
use std.crypto.rand;
use std.memory;
use std.allocator.fixed;
use io_error: std.io.error;
use io_handle: std.io.handle;

use A: std.allocator;
use R: std.types.result;
use O: std.types.option;

use m_reader: std.io.reader;
use m_writer: std.io.writer;

# an open file with a native-width opaque handle
pub rec File {
    handle: io_handle.FileHandle;
}

fun error_text(error: io_error.Error) str {
    ret io_error.message(error);
}

fun error_option_text(error: O.Option[io_error.Error]) O.Option[str] {
    if (O.is_some[io_error.Error](error)) {
        ret O.some[str](error_text(O.unwrap[io_error.Error](error)));
    }
    ret O.none[str]();
}

# what a path resolves to
pub def Kind: u8;
pub val KIND_OTHER:   Kind = 0;
pub val KIND_FILE:    Kind = 1;
pub val KIND_DIR:     Kind = 2;
pub val KIND_SYMLINK: Kind = 3;

# portable file metadata
# ---
# kind:     file, directory, symlink, or other
# size:     size in bytes
# mode:     raw permission/type bits (POSIX; synthesized elsewhere)
# modified: last modification time
# accessed: last access time
# created:  birth time when the platform provides it, else none
pub rec Metadata {
    kind:     Kind;
    size:     usize;
    mode:     u32;
    modified: Time;
    accessed: Time;
    created:  O.Option[Time];
}

# the standard streams, as already-open files
pub val STDIN:  File = File{handle: io_handle.FileHandle{value: 0}};
pub val STDOUT: File = File{handle: io_handle.FileHandle{value: 1}};
pub val STDERR: File = File{handle: io_handle.FileHandle{value: 2}};

# seek anchors for `seek`
fwd os.SEEK_SET;
fwd os.SEEK_CUR;
fwd os.SEEK_END;

# open a file for reading
# ---
# p:   file path
# ret: the open file, or an error
pub fun open(p: Path) R.Result[File, io_error.Error] {
    if (p == nil) { ret R.err[File, io_error.Error](io_error.from_code(os.EINVAL, io_error.OP_OPEN)); }

    val raw: i64 = os.open(os.AT_FDCWD, p, os.O_RDONLY, 0);
    if (raw < 0) { ret R.err[File, io_error.Error](io_error.from_code(raw, io_error.OP_OPEN)); }

    ret R.ok[File, io_error.Error](File{handle: io_handle.FileHandle{value: raw::usize}});
}

# create or truncate a file for writing
# ---
# p:    file path
# mode: permission bits for a newly created file
# ret:  the open file, or an error
pub fun create(p: Path, mode: i32) R.Result[File, io_error.Error] {
    if (p == nil) { ret R.err[File, io_error.Error](io_error.from_code(os.EINVAL, io_error.OP_CREATE)); }

    val flags: i32 = os.O_CREAT | os.O_TRUNC | os.O_WRONLY;
    val raw:   i64 = os.open(os.AT_FDCWD, p, flags, mode);
    if (raw < 0) { ret R.err[File, io_error.Error](io_error.from_code(raw, io_error.OP_CREATE)); }

    ret R.ok[File, io_error.Error](File{handle: io_handle.FileHandle{value: raw::usize}});
}

# close an open file
# ---
# f:   file to close
# ret: none on success, or an error
pub fun close(f: *File) O.Option[io_error.Error] {
    if (f == nil || !io_handle.file_is_valid(f.handle)) {
        ret O.some[io_error.Error](io_error.from_code(os.EBADF, io_error.OP_CLOSE));
    }
    val value: usize = f.handle.value;
    f.handle = io_handle.invalid_file();
    val raw: i64 = os.close(value::i32);
    if (raw < 0) { ret O.some[io_error.Error](io_error.from_code(raw, io_error.OP_CLOSE)); }

    ret O.none[io_error.Error]();
}

# flush an open file's data and metadata to its backing storage
# ---
# f:   file to flush
# ret: none on success, or an error
pub fun sync(f: File) O.Option[io_error.Error] {
    val raw: i64 = os.sync_fd(f.handle.value::i32);
    if (raw < 0) { ret O.some[io_error.Error](io_error.from_code(raw, io_error.OP_SYNC)); }

    ret O.none[io_error.Error]();
}

# read up to len bytes into buf
# ---
# f:   file to read from
# buf: destination buffer
# len: maximum bytes to read
# ret: bytes read (0 at end of file), or an error
pub fun read(f: File, buf: *u8, len: usize) R.Result[usize, io_error.Error] {
    val n: i64 = os.read(f.handle.value::i32, buf, len);
    if (n < 0) { ret R.err[usize, io_error.Error](io_error.from_code(n, io_error.OP_READ)); }

    ret R.ok[usize, io_error.Error](n::usize);
}

# write up to len bytes from buf
# ---
# f:   file to write to
# buf: source buffer
# len: bytes to write
# ret: bytes written, or an error
pub fun write(f: File, buf: *u8, len: usize) R.Result[usize, io_error.Error] {
    val n: i64 = os.write(f.handle.value::i32, buf, len);
    if (n < 0) { ret R.err[usize, io_error.Error](io_error.from_code(n, io_error.OP_WRITE)); }

    ret R.ok[usize, io_error.Error](n::usize);
}

# reposition the file offset
# ---
# f:      file to seek
# offset: byte offset relative to whence
# whence: SEEK_SET, SEEK_CUR, or SEEK_END
# ret:    the resulting absolute offset, or an error
pub fun seek(f: File, offset: i64, whence: i32) R.Result[i64, io_error.Error] {
    val n: i64 = os.seek(f.handle.value::i32, offset, whence);
    if (n < 0) { ret R.err[i64, io_error.Error](io_error.from_code(n, io_error.OP_SEEK)); }

    ret R.ok[i64, io_error.Error](n);
}

# io read callback; the file's fd rides in the ctx slot
fun file_read_cb(ctx: ptr, buf: *u8, len: usize) R.Result[usize, str] {
    val file: File = File{handle: io_handle.FileHandle{value: ctx::usize}};
    val result: R.Result[usize, io_error.Error] = read(file, buf, len);
    if (R.is_err[usize, io_error.Error](result)) {
        ret R.err[usize, str](io_error.message(R.unwrap_err[usize, io_error.Error](result)));
    }
    ret R.ok[usize, str](R.unwrap_ok[usize, io_error.Error](result));
}

# io write callback; the file's fd rides in the ctx slot
fun file_write_cb(ctx: ptr, buf: *u8, len: usize) R.Result[usize, str] {
    val file: File = File{handle: io_handle.FileHandle{value: ctx::usize}};
    val result: R.Result[usize, io_error.Error] = write(file, buf, len);
    if (R.is_err[usize, io_error.Error](result)) {
        ret R.err[usize, str](io_error.message(R.unwrap_err[usize, io_error.Error](result)));
    }
    ret R.ok[usize, str](R.unwrap_ok[usize, io_error.Error](result));
}

# adapt a file to an io.Reader (the file must outlive the reader)
# ---
# f:   file to read from
# ret: a Reader drawing from f
pub fun reader(f: File) m_reader.Reader {
    var r: m_reader.Reader;
    r.ctx    = f.handle.value::ptr;
    r.f_read = file_read_cb;
    ret r;
}

# adapt a file to an io.Writer (the file must outlive the writer)
# ---
# f:   file to write to
# ret: a Writer feeding f
pub fun writer(f: File) m_writer.Writer {
    var w: m_writer.Writer;
    w.ctx     = f.handle.value::ptr;
    w.f_write = file_write_cb;
    ret w;
}

# read an entire file into an allocated byte buffer
#
# composes io.read_all over the file's Reader: grows as it reads, so it needs
# no size assumption. the caller owns the returned vector.
# ---
# a:   allocator for the result
# p:   file path
# ret: the file contents, or an error
pub fun read_bytes(a: *A.Allocator, p: Path) R.Result[Vector[u8], str] {
    val ro: R.Result[File, io_error.Error] = open(p);
    if (R.is_err[File, io_error.Error](ro)) { ret R.err[Vector[u8], str](error_text(R.unwrap_err[File, io_error.Error](ro))); }
    var f: File = R.unwrap_ok[File, io_error.Error](ro);

    var rd: m_reader.Reader = reader(f);
    val res: R.Result[Vector[u8], str] = m_reader.read_all(a, ?rd);
    close(?f);

    ret res;
}

# read an entire file into an allocated, null-terminated string
#
# stats the file for its size and composes io.read_exact into an exact buffer,
# allocating once with no growth. for text; binary content with embedded NUL
# bytes loses its length to the first NUL when read through str_len.
# ---
# a:   allocator for the result
# p:   file path
# ret: the file contents, or an error
pub fun read_string(a: *A.Allocator, p: Path) R.Result[str, str] {
    if (a == nil) { ret R.err[str, str]("allocator is nil"); }
    val ro: R.Result[File, io_error.Error] = open(p);
    if (R.is_err[File, io_error.Error](ro)) { ret R.err[str, str](error_text(R.unwrap_err[File, io_error.Error](ro))); }
    var f: File = R.unwrap_ok[File, io_error.Error](ro);

    # size the buffer from the open handle
    var st: os.stat_t;
    val sr: i64 = os.stat(f.handle.value::i32, ?st);
    if (sr < 0) { close(?f); ret R.err[str, str](os.message(sr)); }
    if (st.st_size < 0 || st.st_size::u64 >= (-1)::usize::u64) {
        close(?f);
        ret R.err[str, str]("file size is not representable");
    }
    val size: usize = st.st_size::usize;

    val ar: R.Result[*u8, *u8] = A.allocate[u8](a, size + 1);
    if (R.is_err[*u8, *u8](ar)) { close(?f); ret R.err[str, str]("out of memory"); }
    val buf: *u8 = R.unwrap_ok[*u8, *u8](ar);

    var rd: m_reader.Reader = reader(f);
    val e: O.Option[str] = m_reader.read_exact(?rd, buf, size);
    val closed: O.Option[io_error.Error] = close(?f);
    if (O.is_some[str](e) || O.is_some[io_error.Error](closed)) {
        A.deallocate[u8](a, buf, size + 1);
        if (O.is_some[str](e)) { ret R.err[str, str](O.unwrap[str](e)); }
        ret R.err[str, str](error_text(O.unwrap[io_error.Error](closed)));
    }

    buf[size] = 0;
    ret R.ok[str, str](buf::str);
}

# write bytes to a file, creating or truncating it
#
# composes io.write_all over the file's Writer.
# ---
# p:    file path
# data: bytes to write
# len:  number of bytes
# mode: permission bits for a newly created file
# ret:  none on success, or an error
pub fun write_bytes(p: Path, data: *u8, len: usize, mode: i32) O.Option[str] {
    val co: R.Result[File, io_error.Error] = create(p, mode);
    if (R.is_err[File, io_error.Error](co)) { ret O.some[str](error_text(R.unwrap_err[File, io_error.Error](co))); }
    var f: File = R.unwrap_ok[File, io_error.Error](co);

    var w: m_writer.Writer = writer(f);
    val e: O.Option[str] = m_writer.write_all(?w, data, len);
    close(?f);

    ret e;
}

# replace a file with complete bytes through a durable sibling temporary
#
# missing parent directories are created before the temporary. the temporary is
# created beside the destination with O_EXCL, flushed, and closed before rename,
# so readers see either the old file or the complete replacement and a
# cross-device rename cannot occur. after rename, the parent directory is
# flushed through the platform durability contract. if that final flush
# fails, the replacement is already visible even though this function reports
# the durability failure.
# ---
# a:    allocator for temporary paths
# p:    destination path
# data: bytes to write
# len:  number of bytes
# file_mode: permission bits for the replacement file
# dir_mode:  permission bits for newly created parent directories
# ret:       none on success, or an error
pub fun replace_bytes_atomic(a: *A.Allocator, p: Path, data: *u8, len: usize, file_mode: i32, dir_mode: i32) O.Option[str] {
    if (a == nil)         { ret O.some[str]("allocator is nil"); }
    if (path.is_empty(p)) { ret O.some[str]("path is empty"); }
    if (data == nil && len > 0) { ret O.some[str]("data is nil"); }

    val pr: R.Result[Path, str] = path.parent(a, p);
    if (R.is_err[Path, str](pr)) { ret O.some[str](R.unwrap_err[Path, str](pr)); }
    val parent: Path = R.unwrap_ok[Path, str](pr);

    val de: O.Option[str] = create_dir_all(a, parent, dir_mode);
    if (O.is_some[str](de)) {
        A.deallocate[u8](a, parent, str_len(parent) + 1);
        ret de;
    }

    val tr: R.Result[TempFile, str] = sibling_temp_create(a, parent, path.filename(p), file_mode);
    if (R.is_err[TempFile, str](tr)) {
        A.deallocate[u8](a, parent, str_len(parent) + 1);
        ret O.some[str](R.unwrap_err[TempFile, str](tr));
    }
    var temp: TempFile = R.unwrap_ok[TempFile, str](tr);

    var w: m_writer.Writer = writer(temp.file);
    val we: O.Option[str] = m_writer.write_all(?w, data, len);
    if (O.is_some[str](we)) {
        close(?temp.file);
        remove_file(temp.path);
        atomic_paths_free(a, parent, temp.path);
        ret we;
    }

    val se: O.Option[io_error.Error] = sync(temp.file);
    if (O.is_some[io_error.Error](se)) {
        close(?temp.file);
        remove_file(temp.path);
        atomic_paths_free(a, parent, temp.path);
        ret error_option_text(se);
    }

    val ce: O.Option[io_error.Error] = close(?temp.file);
    if (O.is_some[io_error.Error](ce)) {
        remove_file(temp.path);
        atomic_paths_free(a, parent, temp.path);
        ret error_option_text(ce);
    }

    val re: O.Option[str] = rename(temp.path, p);
    if (O.is_some[str](re)) {
        remove_file(temp.path);
        atomic_paths_free(a, parent, temp.path);
        ret re;
    }

    val synced: O.Option[str] = sync_directory(parent);
    atomic_paths_free(a, parent, temp.path);
    ret synced;
}

# classify a raw stat mode into a Kind
fun kind_from_mode(mode: u32) Kind {
    val t: u32 = mode & os.S_IFMT;
    if (t == os.S_IFDIR) { ret KIND_DIR; }
    if (t == os.S_IFREG) { ret KIND_FILE; }
    if (t == os.S_IFLNK) { ret KIND_SYMLINK; }

    ret KIND_OTHER;
}

# build Metadata from a filled stat buffer
fun meta_from_stat(st: *os.stat_t) Metadata {
    ret Metadata{
        kind:     kind_from_mode(os.stat_mode(st)),
        size:     st.st_size::usize,
        mode:     os.stat_mode(st),
        modified: time.unix(st.st_mtime, st.st_mtime_nsec),
        accessed: time.unix(st.st_atime, st.st_atime_nsec),
        created:  O.none[Time](),
    };
}

pub fun identity_equal(a: Identity, b: Identity) bool {
    ret identities.equal(a, b);
}

# observations do not retain an object or imply unchanged contents
pub fun identity_of(f: File) R.Result[Identity, io_error.Error] {
    var identity: Identity;
    val observed: i64 = os.file_identity(f.handle.value::i32, ?identity);
    if (observed < 0) { ret R.err[Identity, io_error.Error](io_error.from_code(observed, io_error.OP_OPTION)); }
    ret R.ok[Identity, io_error.Error](identity);
}

# the final symlink itself is observed and unsupported domains remain explicit
pub fun identity_link(p: Path) R.Result[Identity, io_error.Error] {
    if (p == nil) { ret R.err[Identity, io_error.Error](io_error.from_code(os.EINVAL, io_error.OP_OPTION)); }
    var identity: Identity;
    val observed: i64 = os.identity_at(os.AT_FDCWD, p, ?identity);
    if (observed < 0) { ret R.err[Identity, io_error.Error](io_error.from_code(observed, io_error.OP_OPTION)); }
    ret R.ok[Identity, io_error.Error](identity);
}

# metadata for an open file with normalized target detail
pub fun stat_of_error(f: File) R.Result[Metadata, io_error.Error] {
    var st: os.stat_t;
    val raw: i64 = os.stat(f.handle.value::i32, ?st);
    if (raw < 0) { ret R.err[Metadata, io_error.Error](io_error.from_code(raw, io_error.OP_OPTION)); }

    ret R.ok[Metadata, io_error.Error](meta_from_stat(?st));
}

# metadata for an open file
pub fun stat_of(f: File) R.Result[Metadata, str] {
    val result: R.Result[Metadata, io_error.Error] = stat_of_error(f);
    if (R.is_err[Metadata, io_error.Error](result)) {
        ret R.err[Metadata, str](io_error.message(R.unwrap_err[Metadata, io_error.Error](result)));
    }

    ret R.ok[Metadata, str](R.unwrap_ok[Metadata, io_error.Error](result));
}

# metadata for a path, following a final symbolic link
# ---
# p:   path to query
# ret: the metadata, or an error
pub fun metadata(p: Path) R.Result[Metadata, str] {
    if (p == nil) { ret R.err[Metadata, str]("path is nil"); }

    var st: os.stat_t;
    val raw: i64 = os.stat_path(os.AT_FDCWD, p, ?st, 0);
    if (raw < 0) { ret R.err[Metadata, str](os.message(raw)); }

    ret R.ok[Metadata, str](meta_from_stat(?st));
}

# metadata for a path without following a final symbolic link
# ---
# p:   path to query
# ret: the metadata (a symlink reports itself), or an error
pub fun metadata_link(p: Path) R.Result[Metadata, str] {
    if (p == nil) { ret R.err[Metadata, str]("path is nil"); }

    var st: os.stat_t;
    val raw: i64 = os.stat_path(os.AT_FDCWD, p, ?st, os.AT_SYMLINK_NOFOLLOW);
    if (raw < 0) { ret R.err[Metadata, str](os.message(raw)); }

    ret R.ok[Metadata, str](meta_from_stat(?st));
}

# check whether metadata describes a directory
pub fun meta_is_dir(m: *Metadata) bool {
    ret m.kind == KIND_DIR;
}

# check whether metadata describes a regular file
pub fun meta_is_file(m: *Metadata) bool {
    ret m.kind == KIND_FILE;
}

# check whether metadata describes a symbolic link
pub fun meta_is_symlink(m: *Metadata) bool {
    ret m.kind == KIND_SYMLINK;
}

# check whether a path exists (as any entry, including a broken symlink)
pub fun exists(p: Path) bool {
    ret R.is_ok[Metadata, str](metadata_link(p));
}

# check whether a path is an existing regular file (following symlinks)
pub fun is_file(p: Path) bool {
    val r: R.Result[Metadata, str] = metadata(p);
    if (R.is_err[Metadata, str](r)) { ret false; }

    ret R.unwrap_ok[Metadata, str](r).kind == KIND_FILE;
}

# check whether a path is an existing directory (following symlinks)
pub fun is_dir(p: Path) bool {
    val r: R.Result[Metadata, str] = metadata(p);
    if (R.is_err[Metadata, str](r)) { ret false; }

    ret R.unwrap_ok[Metadata, str](r).kind == KIND_DIR;
}

# check whether a path is a symbolic link (not following it)
pub fun is_symlink(p: Path) bool {
    val r: R.Result[Metadata, str] = metadata_link(p);
    if (R.is_err[Metadata, str](r)) { ret false; }

    ret R.unwrap_ok[Metadata, str](r).kind == KIND_SYMLINK;
}

# create a single directory
# ---
# p:    directory path
# mode: permission bits
# ret:  none on success, or an error
pub fun create_dir(p: Path, mode: i32) O.Option[str] {
    if (p == nil) { ret O.some[str]("path is nil"); }

    val raw: i64 = os.make_dir(os.AT_FDCWD, p, mode);
    if (raw < 0) { ret O.some[str](os.message(raw)); }

    ret O.none[str]();
}

# remove a single file or symbolic link
# ---
# p:   path to remove
# ret: none on success, or an error
pub fun remove_file(p: Path) O.Option[str] {
    if (p == nil) { ret O.some[str]("path is nil"); }

    val raw: i64 = os.unlink(os.AT_FDCWD, p, 0);
    if (raw < 0) { ret O.some[str](os.message(raw)); }

    ret O.none[str]();
}

# remove an empty directory
# ---
# p:   directory path to remove
# ret: none on success, or an error
pub fun remove_dir(p: Path) O.Option[str] {
    if (p == nil) { ret O.some[str]("path is nil"); }

    val raw: i64 = os.unlink(os.AT_FDCWD, p, os.AT_REMOVEDIR);
    if (raw < 0) { ret O.some[str](os.message(raw)); }

    ret O.none[str]();
}

# rename or move a file or directory
#
# An existing destination file is replaced, as POSIX rename does. Replacing an
# existing *directory* is not portable: POSIX allows it when the destination is
# an empty directory and windows refuses it outright, so callers should not rely
# on it.
# windows retains open destination handles on supporting local filesystems,
# while smb refuses replacement until destination handles close.
# ---
# from: source path
# to:   destination path
# ret:  none on success, or an error
pub fun rename(from: Path, to: Path) O.Option[str] {
    if (from == nil || to == nil) { ret O.some[str]("path is nil"); }

    val raw: i64 = os.rename(os.AT_FDCWD, from, os.AT_FDCWD, to);
    if (raw < 0) { ret O.some[str](os.message(raw)); }

    ret O.none[str]();
}

# create a symbolic link at linkpath pointing to target
# ---
# target:   path the link points to (stored verbatim)
# linkpath: path of the link to create
# ret:      none on success, or an error
pub fun symlink(target: Path, linkpath: Path) O.Option[str] {
    if (target == nil || linkpath == nil) { ret O.some[str]("path is nil"); }

    val raw: i64 = os.symlink(target, linkpath);
    if (raw < 0) { ret O.some[str](os.message(raw)); }

    ret O.none[str]();
}

val REMOVE_MAX_DEPTH:  usize = 1024;
val DIRENT_BUF_SIZE:   usize = 8192;
val TEMP_MAX_ATTEMPTS: usize = 100;
val HEX_CHARS:         str   = "0123456789abcdef";

# list the entries of a directory, excluding "." and ".."
#
# each name is a freshly allocated string owned by the caller's allocator; the
# returned vector owns them and is released with vector.dnit (or wholesale by
# an arena). names are returned in directory order.
# ---
# a:   allocator for the vector and each name
# p:   directory path
# ret: the child names, or an error
pub fun read_dir(a: *A.Allocator, p: Path) R.Result[Vector[str], str] {
    if (a == nil) { ret R.err[Vector[str], str]("allocator is nil"); }

    val raw: i64 = os.open(os.AT_FDCWD, p, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (raw < 0) { ret R.err[Vector[str], str](os.message(raw)); }
    val dfd: i32 = raw::i32;

    var names: Vector[str] = vector.init[str](a);
    var dbuf:  [DIRENT_BUF_SIZE]u8;

    for {
        val n: i64 = os.read_dir(dfd, (?dbuf[0])::*os.dirent64, DIRENT_BUF_SIZE);
        if (n < 0) {
            os.close(dfd);
            vector.dnit[str](?names);
            ret R.err[Vector[str], str](os.message(n));
        }
        if (n == 0) { brk; }

        var pos: usize = 0;
        for (pos < n::usize) {
            val ent:    *os.dirent64 = ((?dbuf[0])::usize + pos)::*os.dirent64;
            val reclen: usize        = ent.d_reclen::usize;
            val name:   *u8          = ?ent.d_name[0];

            if (!is_dot_name(name)) {
                val copied: R.Result[str, str] = str_copy(a, name::str);
                if (R.is_err[str, str](copied)) {
                    os.close(dfd);
                    vector.dnit[str](?names);
                    ret R.err[Vector[str], str](R.unwrap_err[str, str](copied));
                }
                val pushed: R.Result[usize, str] = vector.push[str](?names, R.unwrap_ok[str, str](copied));
                if (R.is_err[usize, str](pushed)) {
                    os.close(dfd);
                    vector.dnit[str](?names);
                    ret R.err[Vector[str], str](R.unwrap_err[usize, str](pushed));
                }
            }

            # a zero record length would never advance; guard a malformed buffer
            if (reclen == 0) { brk; }
            pos = pos + reclen;
        }
    }

    os.close(dfd);
    ret R.ok[Vector[str], str](names);
}

# check whether a directory entry name is "." or ".."
fun is_dot_name(name: *u8) bool {
    if (name[0] != '.') { ret false; }
    if (name[1] == 0) { ret true; }
    if (name[1] == '.' && name[2] == 0) { ret true; }

    ret false;
}

# create a directory and every missing parent (mkdir -p)
# ---
# a:    allocator for transient parent paths
# p:    directory path
# mode: permission bits for created directories
# ret:  none on success, or an error
pub fun create_dir_all(a: *A.Allocator, p: Path, mode: i32) O.Option[str] {
    if (a == nil)         { ret O.some[str]("allocator is nil"); }
    if (path.is_empty(p)) { ret O.some[str]("path is empty"); }
    if (path.is_root(p))  { ret O.none[str](); }
    if (is_dir(p))        { ret O.none[str](); }

    if (O.is_none[str](create_dir(p, mode))) { ret O.none[str](); }

    val pr: R.Result[Path, str] = path.parent(a, p);
    if (R.is_err[Path, str](pr)) { ret O.some[str](R.unwrap_err[Path, str](pr)); }
    val up: Path = R.unwrap_ok[Path, str](pr);

    val made: O.Option[str] = create_dir_all(a, up, mode);
    A.deallocate[u8](a, up, str_len(up) + 1);
    if (O.is_some[str](made)) { ret made; }

    if (O.is_none[str](create_dir(p, mode))) { ret O.none[str](); }
    if (is_dir(p)) { ret O.none[str](); }

    ret O.some[str]("cannot create directory");
}

# recursively remove a file, directory tree, or symbolic link (rm -rf)
#
# directories are removed depth-first. symbolic links are removed as links and
# never followed, so a link pointing outside the tree leaves its target intact.
# a missing path succeeds, making the operation idempotent.
# windows force deletion preserves alias attributes and reports unsupported
# for read-only entries on filesystems without native posix deletion.
# roots and dot entries are refused before mutation.
# ---
# a:   allocator for the owned input and parent paths
# p:   path naming the child entry to remove
# ret: none on success, or an error
pub fun remove_all(a: *A.Allocator, p: Path) O.Option[str] {
    if (a == nil) { ret O.some[str]("allocator is nil"); }
    if (p == nil) { ret O.some[str]("path is nil"); }
    if (str_len(p) == 0) { ret O.none[str](); }
    val owned_r: R.Result[Path, str] = path.clone(a, p);
    if (R.is_err[Path, str](owned_r)) { ret O.some[str](R.unwrap_err[Path, str](owned_r)); }
    val owned: Path = R.unwrap_ok[Path, str](owned_r);
    val length: usize = str_len(owned);
    fin { A.deallocate[u8](a, owned, length + 1); }
    var end: usize = length;
    val root_length: usize = path.root(owned).len;
    for (end > root_length && path.is_separator(owned[end - 1])) { end = end - 1; }
    owned[end] = 0;
    val name: str = path.filename(owned);
    if (name == nil || name[0] == 0 || str_equals(name, ".") || str_equals(name, "..")) {
        ret O.some[str]("removal requires a named child entry");
    }
    val parent_r: R.Result[Path, str] = path.parent(a, owned);
    if (R.is_err[Path, str](parent_r)) { ret O.some[str](R.unwrap_err[Path, str](parent_r)); }
    val parent: Path = R.unwrap_ok[Path, str](parent_r);
    fin { A.deallocate[u8](a, parent, str_len(parent) + 1); }
    val raw: i64 = os.open(os.AT_FDCWD, parent, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (raw == os.ENOENT) { ret O.none[str](); }
    if (raw < 0) { ret O.some[str](os.message(raw)); }
    val fd: i32 = raw::i32;
    var removed: usize = 0;
    val result: O.Option[removal.Error] = removal.tree(fd, name, ?removed, REMOVE_MAX_DEPTH - 1);
    val closed: i64 = os.close(fd);
    if (O.is_some[removal.Error](result)) { ret O.some[str](removal.message(O.unwrap[removal.Error](result))); }
    if (closed < 0) { ret O.some[str](os.message(closed)); }
    ret O.none[str]();
}

# a created temporary file and its path
# ---
# file: the open handle
# path: the allocated path (freed with the caller's allocator)
pub rec TempFile {
    file: File;
    path: Path;
}

# create a uniquely named temporary file under the OS temp directory
#
# the file is opened O_CREAT|O_EXCL, so the returned path is exclusively owned.
# ---
# a:      allocator for the path
# prefix: name prefix (e.g. "build" -> "<tmp>/build_<hex>")
# ret:    the created temporary file, or an error
pub fun temp_create(a: *A.Allocator, prefix: str) R.Result[TempFile, str] {
    if (a == nil) { ret R.err[TempFile, str]("allocator is nil"); }

    var attempt: usize = 0;
    for (attempt < TEMP_MAX_ATTEMPTS) {
        var rnd: [8]u8;
        if (rand.fill(?rnd[0], 8) < 0) { ret R.err[TempFile, str]("entropy source failed"); }

        val built: R.Result[Path, str] = temp_build_path(a, prefix, ?rnd[0]);
        if (R.is_err[Path, str](built)) { ret R.err[TempFile, str](R.unwrap_err[Path, str](built)); }
        val tp: Path = R.unwrap_ok[Path, str](built);

        val flags: i32 = os.O_CREAT | os.O_EXCL | os.O_RDWR;
        val raw: i64 = os.open(os.AT_FDCWD, tp, flags, 0o600);
        if (raw >= 0) {
            ret R.ok[TempFile, str](TempFile{file: File{handle: io_handle.FileHandle{value: raw::usize}}, path: tp});
        }

        A.deallocate[u8](a, tp, str_len(tp) + 1);
        if (raw != os.EEXIST) { ret R.err[TempFile, str](os.message(raw)); }
        attempt = attempt + 1;
    }

    ret R.err[TempFile, str]("temp file: max attempts exceeded");
}

# the path of a temporary file
pub fun temp_path(tf: *TempFile) Path {
    ret tf.path;
}

# close a temporary file without removing it
pub fun temp_close(tf: *TempFile) O.Option[str] {
    ret error_option_text(close(?tf.file));
}

# remove a temporary file from disk
pub fun temp_remove(tf: *TempFile) O.Option[str] {
    ret remove_file(tf.path);
}

# close and remove a temporary file
pub fun temp_close_and_remove(tf: *TempFile) O.Option[str] {
    val cr: O.Option[str] = error_option_text(close(?tf.file));
    val rr: O.Option[str] = remove_file(tf.path);
    if (O.is_some[str](cr)) { ret cr; }

    ret rr;
}

# assemble "<tempdir>/<prefix>_<hex>" into a freshly allocated path
fun temp_build_path(a: *A.Allocator, prefix: str, rnd: *u8) R.Result[Path, str] {
    var buf: [512]u8;

    val dir: i64 = os.temp_dir(?buf[0], 512);
    if (dir < 0)           { ret R.err[Path, str]("temp directory unavailable"); }
    if (dir::usize >= 512) { ret R.err[Path, str]("temp path too long"); }
    var off: usize = dir::usize;

    # some temp dirs end with a separator, some do not; insert exactly one
    if (off == 0 || !path.is_separator(buf[off - 1])) {
        buf[off] = os.separator;
        off = off + 1;
    }

    var plen: usize = 0;
    if (prefix != nil) { plen = str_len(prefix); }

    # dir + sep + prefix + '_' + 16 hex digits + NUL
    if (off + plen + 1 + 16 + 1 > 512) { ret R.err[Path, str]("temp path too long"); }

    if (prefix != nil) {
        memory.raw_copy(?buf[off], prefix, plen);
        off = off + plen;
    }

    buf[off] = '_';
    off = off + 1;

    val hex: *u8 = HEX_CHARS::*u8;
    var i: usize = 0;
    for (i < 8) {
        buf[off]     = hex[rnd[i]::usize >> 4];
        buf[off + 1] = hex[rnd[i]::usize & 0x0F];
        off = off + 2;
        i = i + 1;
    }
    buf[off] = 0;

    ret str_copy(a, (?buf[0])::str);
}

# create an exclusive temporary beside a destination
fun sibling_temp_create(a: *A.Allocator, parent: Path, name: str, mode: i32) R.Result[TempFile, str] {
    var attempt: usize = 0;
    for (attempt < TEMP_MAX_ATTEMPTS) {
        var rnd: [8]u8;
        if (rand.fill(?rnd[0], 8) < 0) { ret R.err[TempFile, str]("entropy source failed"); }

        val nr: R.Result[Path, str] = sibling_temp_name(a, name, ?rnd[0]);
        if (R.is_err[Path, str](nr)) { ret R.err[TempFile, str](R.unwrap_err[Path, str](nr)); }
        val temp_name: Path = R.unwrap_ok[Path, str](nr);

        val jr: R.Result[Path, str] = path.join(a, parent, temp_name);
        A.deallocate[u8](a, temp_name, str_len(temp_name) + 1);
        if (R.is_err[Path, str](jr)) { ret R.err[TempFile, str](R.unwrap_err[Path, str](jr)); }
        val temp_path: Path = R.unwrap_ok[Path, str](jr);

        val flags: i32 = os.O_CREAT | os.O_EXCL | os.O_WRONLY;
        val raw: i64 = os.open(os.AT_FDCWD, temp_path, flags, mode);
        if (raw >= 0) {
            ret R.ok[TempFile, str](TempFile{file: File{handle: io_handle.FileHandle{value: raw::usize}}, path: temp_path});
        }

        A.deallocate[u8](a, temp_path, str_len(temp_path) + 1);
        if (raw != os.EEXIST) { ret R.err[TempFile, str](os.message(raw)); }
        attempt = attempt + 1;
    }

    ret R.err[TempFile, str]("atomic write: max temporary attempts exceeded");
}

# assemble ".<name>.tmp-<hex>" into an allocated filename
fun sibling_temp_name(a: *A.Allocator, name: str, rnd: *u8) R.Result[Path, str] {
    var name_len: usize = 0;
    if (name != nil) { name_len = str_len(name); }
    val len: usize = 1 + name_len + 5 + 16;

    val ar: R.Result[*u8, str] = A.allocate[u8](a, len + 1);
    if (R.is_err[*u8, str](ar)) { ret R.err[Path, str](R.unwrap_err[*u8, str](ar)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](ar);

    var off: usize = 0;
    buf[off] = '.';
    off = off + 1;
    if (name_len > 0) {
        memory.raw_copy(?buf[off], name, name_len);
        off = off + name_len;
    }
    memory.raw_copy(?buf[off], ".tmp-", 5);
    off = off + 5;

    val hex: *u8 = HEX_CHARS::*u8;
    var i: usize = 0;
    for (i < 8) {
        buf[off]     = hex[rnd[i]::usize >> 4];
        buf[off + 1] = hex[rnd[i]::usize & 0x0F];
        off = off + 2;
        i = i + 1;
    }
    buf[off] = 0;
    ret R.ok[Path, str](buf::Path);
}

fun sync_directory(p: Path) O.Option[str] {
    val raw: i64 = os.open(os.AT_FDCWD, p, os.O_RDONLY | os.O_DIRECTORY, 0);
    if (raw < 0) { ret O.some[str](os.message(raw)); }
    var f: File = File{handle: io_handle.FileHandle{value: raw::usize}};
    val se: O.Option[str] = error_option_text(sync(f));
    val ce: O.Option[str] = error_option_text(close(?f));
    if (O.is_some[str](se)) { ret se; }
    ret ce;
}

fun atomic_paths_free(a: *A.Allocator, parent: Path, temp: Path) {
    A.deallocate[u8](a, temp, str_len(temp) + 1);
    A.deallocate[u8](a, parent, str_len(parent) + 1);
}

# the tests use distinct relative paths and remove what they create
# what it creates

# write_bytes then read_string round-trips content through the io adapters
test "std.filesystem.write_bytes:read_string_roundtrip" {
    var buf: [4096]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 4096);

    val p: Path = "mach_std_fs_roundtrip";
    if (O.is_some[str](write_bytes(p, "hello, mach", 11, 0o644))) { ret 1; }

    val r: R.Result[str, str] = read_string(?a, p);
    remove_file(p);
    if (R.is_err[str, str](r))                            { ret 1; }
    if (!str_equals(R.unwrap_ok[str, str](r), "hello, mach")) { ret 1; }
    ret 0;
}

# atomic writes create a destination, replace it whole, and leave no sibling
# temporary behind
test "std.filesystem.replace_bytes_atomic:create_replace_and_cleanup" {
    var buf: [32768]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 32768);

    val d: Path = "mach_std_fs_atomic";
    val p: Path = "mach_std_fs_atomic/nested/state.dat";
    remove_all(?a, d);
    if (O.is_some[str](replace_bytes_atomic(?a, p, "first", 5, 0o600, 0o700))) { remove_all(?a, d); ret 1; }
    if (O.is_some[str](replace_bytes_atomic(?a, p, "second", 6, 0o600, 0o700))) { remove_all(?a, d); ret 2; }

    var bad: i32 = 0;
    val rr: R.Result[str, str] = read_string(?a, p);
    if (R.is_err[str, str](rr)) { bad = 4; }
    or (!str_equals(R.unwrap_ok[str, str](rr), "second")) { bad = 5; }

    val lr: R.Result[Vector[str], str] = read_dir(?a, "mach_std_fs_atomic/nested");
    if (R.is_err[Vector[str], str](lr)) { bad = 6; }
    or {
        var names: Vector[str] = R.unwrap_ok[Vector[str], str](lr);
        if (names.len != 1 || !str_equals(names.data[0], "state.dat")) { bad = 7; }
        vector.dnit[str](?names);
    }

    remove_all(?a, d);
    ret bad;
}

# a failed namespace replacement preserves the destination and removes the
# completed temporary
test "std.filesystem.replace_bytes_atomic:rename_failure_cleans_temp" {
    var buf: [32768]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 32768);

    val d: Path = "mach_std_fs_atomic_fail";
    val p: Path = "mach_std_fs_atomic_fail/destination";
    remove_all(?a, d);
    if (O.is_some[str](create_dir(d, 0o700))) { ret 1; }
    if (O.is_some[str](create_dir(p, 0o700))) { remove_all(?a, d); ret 2; }
    if (O.is_none[str](replace_bytes_atomic(?a, p, "bytes", 5, 0o600, 0o700))) { remove_all(?a, d); ret 3; }

    var bad: i32 = 0;
    if (!is_dir(p)) { bad = 4; }
    val lr: R.Result[Vector[str], str] = read_dir(?a, d);
    if (R.is_err[Vector[str], str](lr)) { bad = 5; }
    or {
        var names: Vector[str] = R.unwrap_ok[Vector[str], str](lr);
        if (names.len != 1 || !str_equals(names.data[0], "destination")) { bad = 6; }
        vector.dnit[str](?names);
    }

    remove_all(?a, d);
    ret bad;
}

# read_bytes returns the exact byte count and content. read_all reserves in
# CHUNK_SIZE steps and doubles once before seeing EOF, so the arena must hold
# two chunks even for a tiny file
test "std.filesystem.read_bytes:content_and_len" {
    var buf: [32768]u8;
    var st: fixed.FixedState;
    var a: A.Allocator;
    fixed.make(?a, ?st, ?buf[0], 32768);

    val p: Path = "mach_std_fs_bytes";
    if (O.is_some[str](write_bytes(p, "abc", 3, 0o644))) { ret 1; }

    val r: R.Result[Vector[u8], str] = read_bytes(?a, p);
    remove_file(p);
    if (R.is_err[Vector[u8], str](r)) { ret 1; }

    val v: Vector[u8] = R.unwrap_ok[Vector[u8], str](r);
    if (v.len != 3)      { ret 1; }
    if (v.data[0] != 'a') { ret 1; }
    if (v.data[2] != 'c') { ret 1; }
    ret 0;
}

# a missing path fails open and answers false to every predicate
test "std.filesystem.open:missing_path" {
    val p: Path = "mach_std_fs_missing";
    if (R.is_ok[File, io_error.Error](open(p))) { ret 1; }
    if (exists(p))                   { ret 1; }
    if (is_file(p))                  { ret 1; }
    if (is_dir(p))                   { ret 1; }
    ret 0;
}

test "std.filesystem.close:duplicate_is_normalized" {
    val p: Path = "mach_std_fs_close";
    if (O.is_some[str](write_bytes(p, "x", 1, 0o600))) { ret 1; }
    val opened: R.Result[File, io_error.Error] = open(p);
    if (R.is_err[File, io_error.Error](opened)) { remove_file(p); ret 1; }
    var file: File = R.unwrap_ok[File, io_error.Error](opened);
    if (O.is_some[io_error.Error](close(?file))) { remove_file(p); ret 1; }
    val second: O.Option[io_error.Error] = close(?file);
    remove_file(p);
    if (!O.is_some[io_error.Error](second)) { ret 1; }
    if (O.unwrap[io_error.Error](second).kind != io_error.CLOSED) { ret 1; }
    ret 0;
}

# metadata reports a regular file's kind and size
test "std.filesystem.metadata:file_kind_and_size" {
    val p: Path = "mach_std_fs_meta";
    if (O.is_some[str](write_bytes(p, "12345", 5, 0o644))) { ret 1; }

    val r: R.Result[Metadata, str] = metadata(p);
    var bad: i32 = 0;
    if (R.is_err[Metadata, str](r)) { bad = 1; }
    or {
        var m: Metadata = R.unwrap_ok[Metadata, str](r);
        if (m.kind != KIND_FILE)  { bad = 1; }
        if (m.size != 5)          { bad = 1; }
        if (!meta_is_file(?m))    { bad = 1; }
        if (meta_is_dir(?m))      { bad = 1; }
    }

    remove_file(p);
    if (!exists(p)) { ret bad; }
    ret 1;
}

# create_dir and remove_dir round-trip, with predicates agreeing in between
test "std.filesystem.create_dir:remove_dir_roundtrip" {
    val p: Path = "mach_std_fs_dir";
    if (O.is_some[str](create_dir(p, 0o755))) { ret 1; }

    var bad: i32 = 0;
    if (!is_dir(p))  { bad = 1; }
    if (is_file(p))  { bad = 1; }

    if (O.is_some[str](remove_dir(p))) { ret 1; }
    if (exists(p))                     { ret 1; }
    ret bad;
}

# rename moves the entry: the old path vanishes, the new one exists
test "std.filesystem.rename:moves_entry" {
    val from: Path = "mach_std_fs_ren_a";
    val to:   Path = "mach_std_fs_ren_b";
    if (O.is_some[str](write_bytes(from, "x", 1, 0o644))) { ret 1; }

    var bad: i32 = 0;
    if (O.is_some[str](rename(from, to))) { bad = 1; }
    if (exists(from))                     { bad = 1; }
    if (!is_file(to))                     { bad = 1; }

    remove_file(to);
    remove_file(from);
    ret bad;
}

# replacing a closed destination retains the source bytes
test "std.filesystem.rename:replaces_existing_destination" {
    val from: Path = "mach_std_fs_ren_r_a";
    val to:   Path = "mach_std_fs_ren_r_b";
    if (O.is_some[str](write_bytes(from, "new", 3, 0o644))) { ret 1; }
    if (O.is_some[str](write_bytes(to,   "old", 3, 0o644))) { remove_file(from); ret 1; }

    var bad: i32 = 0;
    if (O.is_some[str](rename(from, to))) { bad = 1; }
    if (exists(from))                     { bad = 1; }
    if (!is_file(to))                     { bad = 1; }

    # the destination carries the source's bytes, not the ones it had
    var scratch: [3]u8;
    val ro: R.Result[File, io_error.Error] = open(to);
    if (R.is_err[File, io_error.Error](ro)) { bad = 1; }
    or {
        var f: File = R.unwrap_ok[File, io_error.Error](ro);
        val rr: R.Result[usize, io_error.Error] = read(f, ?scratch[0], 3);
        if (R.is_err[usize, io_error.Error](rr))         { bad = 1; }
        or (R.unwrap_ok[usize, io_error.Error](rr) != 3) { bad = 1; }
        or (scratch[0] != 'n' || scratch[1] != 'e' || scratch[2] != 'w') { bad = 1; }
        close(?f);
    }

    remove_file(to);
    remove_file(from);
    ret bad;
}

# read_dir lists a directory's children
#
# the regression for the O_DIRECTORY value, which arm swaps with O_DIRECT relative to
# asm-generic. riscv64 had been given arm's value, so the open failed EINVAL and
# read_dir could not list anything there. nothing exercised it, so it went unnoticed
# until a riscv64 self-host build tried to enumerate a source tree
test "std.filesystem.read_dir:lists_children" {
    var buf: [8192]u8;
    var st:  fixed.FixedState;
    var alloc: A.Allocator;
    if (O.is_some[*u8](fixed.make(?alloc, ?st, ?buf[0], 8192))) { ret 1; }

    val d: Path = "mach_std_fs_rd";
    remove_all(?alloc, d);
    if (O.is_some[str](create_dir(d, 0o755))) { ret 1; }

    # distinct codes per step: a bare 1 says only that something went wrong, which is
    # close to no check at all when the run is on a machine you cannot reach
    var bad: i32 = 0;
    if (O.is_some[str](write_bytes("mach_std_fs_rd/a.txt", "a", 1, 0o644))) { ret 2; }
    if (O.is_some[str](write_bytes("mach_std_fs_rd/b.txt", "b", 1, 0o644))) { ret 3; }

    val rr: R.Result[Vector[str], str] = read_dir(?alloc, d);
    if (R.is_err[Vector[str], str](rr)) { bad = 4; }
    or {
        var names: Vector[str] = R.unwrap_ok[Vector[str], str](rr);
        # both children present, and "." / ".." not reported as children
        var saw_a: bool = false;
        var saw_b: bool = false;
        var extra: i32  = 0;
        var i: usize = 0;
        for (i < names.len) {
            if (str_equals(names.data[i], "a.txt"))      { saw_a = true; }
            or (str_equals(names.data[i], "b.txt"))      { saw_b = true; }
            or                                           { extra = extra + 1; }
            i = i + 1;
        }
        if (names.len == 0)   { bad = 5; }
        or (!saw_a || !saw_b) { bad = 6; }
        or (extra != 0)       { bad = 7; }
        vector.dnit[str](?names);
    }

    remove_all(?alloc, d);
    ret bad;
}

# seek repositions the read offset within an open file
test "std.filesystem.seek:reposition_and_read" {
    var scratch: [16]u8;

    val p: Path = "mach_std_fs_seek";
    if (O.is_some[str](write_bytes(p, "hello", 5, 0o644))) { ret 1; }

    val ro: R.Result[File, io_error.Error] = open(p);
    if (R.is_err[File, io_error.Error](ro)) { remove_file(p); ret 1; }
    var f: File = R.unwrap_ok[File, io_error.Error](ro);

    var bad: i32 = 0;
    val sk: R.Result[i64, io_error.Error] = seek(f, 1, SEEK_SET);
    if (R.is_err[i64, io_error.Error](sk))                 { bad = 1; }
    or (R.unwrap_ok[i64, io_error.Error](sk) != 1)         { bad = 1; }

    val rd: R.Result[usize, io_error.Error] = read(f, ?scratch[0], 4);
    if (R.is_err[usize, io_error.Error](rd))               { bad = 1; }
    or (R.unwrap_ok[usize, io_error.Error](rd) != 4)       { bad = 1; }
    or (scratch[0] != 'e' || scratch[3] != 'o') { bad = 1; }

    close(?f);
    remove_file(p);
    ret bad;
}

# a symlink reports as a link unfollowed and as its target followed
test "std.filesystem.symlink:link_vs_target" {
    val target: Path = "mach_std_fs_sl_target";
    val link:   Path = "mach_std_fs_sl_link";
    if (O.is_some[str](write_bytes(target, "t", 1, 0o644))) { ret 1; }

    var bad: i32 = 0;
    if (O.is_some[str](symlink(target, link))) { bad = 1; }
    or {
        if (!is_symlink(link)) { bad = 1; }
        if (!is_file(link))    { bad = 1; }

        val r: R.Result[Metadata, str] = metadata_link(link);
        if (R.is_err[Metadata, str](r)) { bad = 1; }
        or (R.unwrap_ok[Metadata, str](r).kind != KIND_SYMLINK) { bad = 1; }
    }

    remove_file(link);
    remove_file(target);
    ret bad;
}

fun rename_held_contents(file: File, expected: str) bool {
    if (R.is_err[i64, io_error.Error](seek(file, 0, os.SEEK_SET))) { ret false; }
    var bytes: [3]u8;
    val got: R.Result[usize, io_error.Error] = read(file, ?bytes[0], 3);
    if (R.is_err[usize, io_error.Error](got)) { ret false; }
    if (R.unwrap_ok[usize, io_error.Error](got) != 3) { ret false; }
    ret bytes[0] == expected[0] && bytes[1] == expected[1] && bytes[2] == expected[2];
}

fun rename_held_pair(from: Path, to: Path) i32 {
    if (O.is_some[str](write_bytes(from, "new", 3, 0o600))) { ret 1; }
    fin { remove_file(from); }
    if (O.is_some[str](write_bytes(to, "old", 3, 0o600))) { ret 2; }
    fin { remove_file(to); }
    val sr: R.Result[File, io_error.Error] = open(from);
    if (R.is_err[File, io_error.Error](sr)) { ret 3; }
    var source: File = R.unwrap_ok[File, io_error.Error](sr);
    fin { close(?source); }
    val dr: R.Result[File, io_error.Error] = open(to);
    if (R.is_err[File, io_error.Error](dr)) { ret 4; }
    var destination: File = R.unwrap_ok[File, io_error.Error](dr);
    fin { close(?destination); }
    if (O.is_some[str](rename(from, to))) { ret 73; }
    if (exists(from)) { ret 6; }
    if (!rename_held_contents(destination, "old")) { ret 7; }
    if (!rename_held_contents(source, "new")) { ret 8; }
    val nr: R.Result[File, io_error.Error] = open(to);
    if (R.is_err[File, io_error.Error](nr)) { ret 9; }
    var next: File = R.unwrap_ok[File, io_error.Error](nr);
    fin { close(?next); }
    if (!rename_held_contents(next, "new")) { ret 10; }
    ret 0;
}

test "std.filesystem.rename: held destinations preserve old handles with relative paths" {
    ret rename_held_pair("mach_std_held_é_from", "mach_std_held_é_to");
}

test "std.filesystem.rename: held destinations preserve old handles with absolute paths" {
    var bytes: [8192]u8;
    var state: fixed.FixedState;
    var alloc: A.Allocator;
    if (O.is_some[*u8](fixed.make(?alloc, ?state, ?bytes[0], 8192))) { ret 1; }
    val sr: R.Result[TempFile, str] = temp_create(?alloc, "mach_held_source");
    if (R.is_err[TempFile, str](sr)) { ret 2; }
    var source: TempFile = R.unwrap_ok[TempFile, str](sr);
    fin { temp_close_and_remove(?source); A.deallocate[u8](?alloc, source.path, str_len(source.path) + 1); }
    val dr: R.Result[TempFile, str] = temp_create(?alloc, "mach_held_destination");
    if (R.is_err[TempFile, str](dr)) { ret 3; }
    var destination: TempFile = R.unwrap_ok[TempFile, str](dr);
    fin { temp_close_and_remove(?destination); A.deallocate[u8](?alloc, destination.path, str_len(destination.path) + 1); }
    if (!path.is_abs(source.path) || !path.is_abs(destination.path)) { ret 4; }
    ret rename_held_pair(source.path, destination.path);
}

test "std.filesystem.rename: source symlinks move without moving their targets" {
    val target: str = "mach_std_rename_symlink_target";
    val from: str = "mach_std_rename_symlink_from";
    val to: str = "mach_std_rename_symlink_to";
    if (O.is_some[str](write_bytes(target, "old", 3, 0o600))) { ret 1; }
    fin { remove_file(target); }
    if (O.is_some[str](symlink(target, from))) { ret 2; }
    fin { remove_file(from); remove_file(to); }
    if (O.is_some[str](rename(from, to))) { ret 3; }
    val moved: R.Result[Metadata, str] = metadata_link(to);
    if (R.is_err[Metadata, str](moved)) { ret 4; }
    if (R.unwrap_ok[Metadata, str](moved).kind != KIND_SYMLINK) { ret 5; }
    if (!is_file(target) || exists(from)) { ret 6; }
    val opened: R.Result[File, io_error.Error] = open(to);
    if (R.is_err[File, io_error.Error](opened)) { ret 7; }
    var file: File = R.unwrap_ok[File, io_error.Error](opened);
    fin { close(?file); }
    if (!rename_held_contents(file, "old")) { ret 8; }
    ret 0;
}

fun rename_type_conflicts(rooted: bool) i32 {
    var file_path: str = "mach_std_rename_type_file";
    var dir_path: str = "mach_std_rename_type_directory";
    if (rooted) {
        file_path = "mach_std_rename_rooted_type_file";
        dir_path = "mach_std_rename_rooted_type_directory";
    }
    if (O.is_some[str](write_bytes(file_path, "old", 3, 0o600))) { ret 1; }
    fin { remove_file(file_path); remove_dir(file_path); }
    if (O.is_some[str](create_dir(dir_path, 0o700))) { ret 2; }
    fin { remove_dir(dir_path); remove_file(dir_path); }
    var dirfd: i32 = os.AT_FDCWD;
    if (rooted) {
        val opened: i64 = os.open(os.AT_FDCWD, ".", os.O_RDONLY | os.O_DIRECTORY, 0);
        if (opened < 0) { ret 9; }
        dirfd = opened::i32;
    }
    fin { if (rooted) { os.close(dirfd); } }
    if (os.rename(dirfd, file_path, dirfd, dir_path) >= 0) { ret 3; }
    if (!is_file(file_path) || !is_dir(dir_path)) { ret 4; }
    if (os.rename(dirfd, dir_path, dirfd, file_path) >= 0) { ret 5; }
    if (!is_file(file_path) || !is_dir(dir_path)) { ret 6; }
    val opened: R.Result[File, io_error.Error] = open(file_path);
    if (R.is_err[File, io_error.Error](opened)) { ret 7; }
    var file: File = R.unwrap_ok[File, io_error.Error](opened);
    fin { close(?file); }
    if (!rename_held_contents(file, "old")) { ret 8; }
    ret 0;
}

test "std.filesystem.rename: type conflicts preserve both entries" {
    ret rename_type_conflicts(false);
}

test "std.filesystem.rename: rooted type conflicts preserve both entries" {
    ret rename_type_conflicts(true);
}


fun rename_directory_symlink(existing: bool) i32 {
    var target: str = "mach_607_dirlink_absent_target";
    var from: str = "mach_607_dirlink_absent_from";
    var to: str = "mach_607_dirlink_absent_to";
    if (existing) {
        target = "mach_607_dirlink_existing_target";
        from = "mach_607_dirlink_existing_from";
        to = "mach_607_dirlink_existing_to";
    }
    if (O.is_some[str](create_dir(target, 0o700))) { ret 97; }
    fin { remove_dir(target); }
    if (O.is_some[str](symlink(target, from))) { ret 98; }
    fin { remove_dir(from); remove_file(from); remove_dir(to); remove_file(to); }
    val before: R.Result[Metadata, str] = metadata_link(from);
    if (R.is_err[Metadata, str](before)) { ret 96; }
    if (R.unwrap_ok[Metadata, str](before).kind != KIND_SYMLINK) { ret 95; }
    if (existing && O.is_some[str](write_bytes(to, "old", 3, 0o600))) { ret 94; }
    val raw: i64 = os.rename(os.AT_FDCWD, from, os.AT_FDCWD, to);
    if (raw < 0) { ret (0 - raw)::i32; }
    val moved: R.Result[Metadata, str] = metadata_link(to);
    if (R.is_err[Metadata, str](moved)) { ret 93; }
    if (R.unwrap_ok[Metadata, str](moved).kind != KIND_SYMLINK) { ret 92; }
    if (!is_dir(target) || exists(from)) { ret 91; }
    ret 0;
}
test "std.filesystem.rename: directory symlink source to absent destination" { ret rename_directory_symlink(false); }
test "std.filesystem.rename: directory symlink source to regular file destination" { ret rename_directory_symlink(true); }

$if ($mach.build.os == $mach.os.windows) {
    test "std.filesystem.rename: drive-relative destinations preserve held handles" {
        var bytes: [8192]u8;
        var state: fixed.FixedState;
        var alloc: A.Allocator;
        if (O.is_some[*u8](fixed.make(?alloc, ?state, ?bytes[0], 8192))) { ret 1; }
        val sr: R.Result[TempFile, str] = temp_create(?alloc, "mach_held_drive_source");
        if (R.is_err[TempFile, str](sr)) { ret 2; }
        var source: TempFile = R.unwrap_ok[TempFile, str](sr);
        fin { temp_close_and_remove(?source); A.deallocate[u8](?alloc, source.path, str_len(source.path) + 1); }
        if (source.path[1] != ':') { ret 3; }
        val leaf: str = path.filename(source.path);
        val length: usize = str_len(leaf) + 7;
        val ar: R.Result[*u8, str] = A.allocate[u8](?alloc, length);
        if (R.is_err[*u8, str](ar)) { ret 4; }
        val to: *u8 = R.unwrap_ok[*u8, str](ar);
        fin { A.deallocate[u8](?alloc, to, length); }
        to[0] = source.path[0];
        to[1] = ':';
        memory.raw_copy(?to[2], leaf, length - 7);
        memory.raw_copy(?to[length - 5], ".dst", 4);
        to[length - 1] = 0;
        ret rename_held_pair(source.path, to);
    }
}

test "std.filesystem.remove_all: removes nested entries and preserves external link targets" {
    var bytes: [8192]u8;
    var state: fixed.FixedState;
    var alloc: A.Allocator;
    if (O.is_some[*u8](fixed.make(?alloc, ?state, ?bytes[0], 8192))) { ret 1; }
    val tree: str = "mach_613_remove_tree";
    val outside: str = "mach_613_remove_outside";
    if (O.is_some[str](create_dir(tree, 0o700))) { ret 2; }
    fin { remove_all(?alloc, tree); }
    if (O.is_some[str](create_dir(outside, 0o700))) { ret 3; }
    fin { remove_all(?alloc, outside); }
    if (O.is_some[str](write_bytes("mach_613_remove_outside/kept", "kept", 4, 0o600))) { ret 4; }
    if (O.is_some[str](create_dir("mach_613_remove_tree/nested", 0o700))) { ret 5; }
    if (O.is_some[str](write_bytes("mach_613_remove_tree/nested/empty_mode", "private", 7, 0))) { ret 6; }
    if (O.is_some[str](symlink("../mach_613_remove_outside", "mach_613_remove_tree/directory_link"))) { ret 7; }
    if (O.is_some[str](symlink("../mach_613_remove_outside/kept", "mach_613_remove_tree/file_link"))) { ret 8; }
    if (O.is_some[str](remove_all(?alloc, tree))) { ret 9; }
    if (exists(tree) || !is_file("mach_613_remove_outside/kept")) { ret 10; }
    if (O.is_some[str](remove_all(?alloc, tree))) { ret 11; }
    ret 0;
}

$if ($mach.build.os == $mach.os.windows) {
    #[library("kernel32.dll")]
    ext fun SetFileAttributesW(path: *u16, attributes: u32) i32;
    #[library("kernel32.dll")]
    ext fun GetFileAttributesW(path: *u16) u32;
    #[library("kernel32.dll")]
    ext fun CreateHardLinkW(path: *u16, existing: *u16, security: ptr) i32;

    fun removal_test_wide(name: str, out: *u16) {
        var i: usize = 0;
        for (name[i] != 0) { out[i] = name[i]::u16; i = i + 1; }
        out[i] = 0;
    }

    test "std.filesystem.remove_all: forces readonly entries without changing surviving aliases" {
        var bytes: [8192]u8;
        var state: fixed.FixedState;
        var alloc: A.Allocator;
        if (O.is_some[*u8](fixed.make(?alloc, ?state, ?bytes[0], 8192))) { ret 1; }
        val tree: str = "mach_613_readonly_tree";
        val alias: str = "mach_613_readonly_alias";
        val file: str = "mach_613_readonly_tree/file";
        if (O.is_some[str](create_dir(tree, 0o700))) { ret 2; }
        fin { remove_all(?alloc, tree); }
        if (O.is_some[str](write_bytes(file, "kept", 4, 0o600))) { ret 3; }
        var wide_file: [128]u16;
        var wide_alias: [128]u16;
        removal_test_wide(file, ?wide_file[0]);
        removal_test_wide(alias, ?wide_alias[0]);
        if (CreateHardLinkW(?wide_alias[0], ?wide_file[0], nil) == 0) { ret 4; }
        fin { remove_all(?alloc, alias); }
        if (SetFileAttributesW(?wide_file[0], 0x21) == 0) { ret 5; }
        val before: u32 = GetFileAttributesW(?wide_alias[0]);
        if (before == 0xffffffff || (before & 1) == 0) { ret 6; }
        if (O.is_none[str](remove_file(file))) { ret 7; }
        if (!is_file(file) || GetFileAttributesW(?wide_alias[0]) != before) { ret 8; }
        if (O.is_some[str](symlink("../mach_613_readonly_alias", "mach_613_readonly_tree/link"))) { ret 9; }
        if (O.is_some[str](remove_all(?alloc, tree))) { ret 10; }
        if (exists(tree) || !is_file(alias) || GetFileAttributesW(?wide_alias[0]) != before) { ret 11; }
        val opened: R.Result[File, io_error.Error] = open(alias);
        if (R.is_err[File, io_error.Error](opened)) { ret 12; }
        var held: File = R.unwrap_ok[File, io_error.Error](opened);
        fin { close(?held); }
        if (!rename_held_contents(held, "kept")) { ret 13; }
        if (O.is_some[str](remove_all(?alloc, alias))) { ret 14; }
        if (exists(alias) || !rename_held_contents(held, "kept")) { ret 15; }
        ret 0;
    }
}

use read_string_testing: std.allocator.testing;

rec ReadStringProbe {
    backing: *read_string_testing.Testing;
    path: Path;
    truncate: bool;
    failed: bool;
}

fun read_string_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val probe: *ReadStringProbe = ctx::*ReadStringProbe;
    if (probe.truncate) {
        val opened: i64 = os.open(os.AT_FDCWD, probe.path, os.O_WRONLY | os.O_TRUNC, 0);
        if (opened < 0) { probe.failed = true; ret O.none[ptr](); }
        if (os.close(opened::i32) < 0) { probe.failed = true; ret O.none[ptr](); }
    }
    ret probe.backing.a.fn_allocate(probe.backing.a.ctx, size, align);
}

fun read_string_probe_deallocate(ctx: ptr, data: ptr, size: usize, align: usize) i64 {
    val probe: *ReadStringProbe = ctx::*ReadStringProbe;
    ret probe.backing.a.fn_deallocate(probe.backing.a.ctx, data, size, align);
}

test "std.filesystem.read_string: truncation releases the exact allocation before returning" {
    val name: Path = "mach_std_read_string_truncation";
    if (O.is_some[str](write_bytes(name, "content", 7, 0o600))) { ret 1; }
    fin { remove_file(name); }
    var tracking: read_string_testing.Testing;
    if (O.is_some[str](read_string_testing.make(?tracking))) { ret 2; }
    fin { read_string_testing.dnit(?tracking); }
    var probe: ReadStringProbe = ReadStringProbe{backing: ?tracking, path: name, truncate: true};
    var alloc: A.Allocator = A.Allocator{ctx: (?probe)::ptr,
        fn_allocate: read_string_probe_allocate, fn_deallocate: read_string_probe_deallocate};
    val failed: R.Result[str, str] = read_string(?alloc, name);
    if (probe.failed || R.is_ok[str, str](failed)) { ret 3; }
    if (!str_equals(R.unwrap_err[str, str](failed), m_reader.ERR_EOF)) { ret 4; }
    if (tracking.attempts != 1 || tracking.total != 1 || tracking.live != 0 || tracking.double_frees != 0) { ret 5; }
    probe.truncate = false;
    val empty: R.Result[str, str] = read_string(?alloc, name);
    if (R.is_err[str, str](empty)) { ret 6; }
    val data: str = R.unwrap_ok[str, str](empty);
    if (data == nil || data[0] != 0 || tracking.live != 1) { ret 7; }
    if (R.is_err[bool, *u8](A.deallocate[u8](?alloc, data, 1))) { ret 8; }
    if (tracking.live != 0 || tracking.double_frees != 0) { ret 9; }
    tracking.fail_at = tracking.attempts + 1;
    val refused: R.Result[str, str] = read_string(?alloc, name);
    if (R.is_ok[str, str](refused) || tracking.live != 0) { ret 10; }
    ret 0;
}
