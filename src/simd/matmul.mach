# widening integer dot products and matrix multiplication
#
# mach has no widening vector operator, so a narrow element never multiplies
# into a wider lane on its own. each routine here widens both operands into
# the accumulator's lane type first, then multiplies and adds at that one
# width. the accumulator width is also the result width.
#
# lane widths and signedness, one row per element type:
#
#   element  lanes   result  largest |product|   TERMS_* (exactness bound)
#   i8       i32x4   i32     (-128)^2   = 2^14   131071
#   u8       u32x4   u32     255^2      = 65025  66051
#   i16      i64x2   i64     (-32768)^2 = 2^30   8589934591
#   u16      u64x2   u64     65535^2             4295098371
#
# signed elements accumulate in signed lanes and unsigned in unsigned. there is
# no mixed-signedness form. i32 and u32 elements are not offered: their largest
# product needs 62 or 64 bits, so an i64 or u64 accumulator is exact for a
# single term only, and there is no wider lane to accumulate into. i16 into
# i32 lanes is not offered for the same reason ((-32768)^2 = 2^30, so two such
# terms already overflow i32).
#
# overflow policy: a result is exact, never wrapped, when every sum it is built
# from has at most TERMS_* terms. TERMS_* is the largest count for which that
# many worst-case products still fit the result type. the bound is checked
# before any work: a dot product over more than TERMS_* elements, or a matmul
# whose inner dimension exceeds it, returns `Error.terms` and reads and writes
# nothing. a caller with a longer sum splits it into chunks of at most TERMS_*
# and adds the chunk results in a type it has proven wide enough. nothing here
# accumulates without bound.
#
# layouts: matrices are dense, row-major and contiguous, the same order as
# `std.math.mat4`. `a` is rows x inner, `b` is inner x cols and `out` is
# rows x cols, so element (r, c) of a matrix with n columns is at `r * n + c`.
# `out` must not overlap `a` or `b`. every element of `out` is written.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.simd.reduce.hsum_i32x4;
use std.simd.reduce.hsum_i64x2;
use std.simd.reduce.hsum_u32x4;
use std.simd.reduce.hsum_u64x2;

# terms: a sum would have more terms than the element type's TERMS_* bound
# size:  rows * inner, inner * cols or rows * cols does not fit usize
pub tag Error: u8 {
    terms;
    size;
}

# the most i8 products an i32 sum holds exactly
pub val TERMS_I8: u64 = 131071;
# the most u8 products a u32 sum holds exactly
pub val TERMS_U8: u64 = 66051;
# the most i16 products an i64 sum holds exactly
pub val TERMS_I16: u64 = 8589934591;
# the most u16 products a u64 sum holds exactly
pub val TERMS_U16: u64 = 4295098371;

fun product_fits(x: usize, y: usize) bool {
    if (x == 0) { ret true; }
    val zero: usize = 0;
    val max:  usize = ~zero;
    ret y <= max / x;
}

fun check_terms(n: usize, bound: u64) err[Error] {
    if (n::u64 > bound) { ret err[Error].err{Error.terms{}}; }
    ret err[Error].ok{};
}

fun check_shape(rows: usize, inner: usize, cols: usize, bound: u64) err[Error] {
    if (!product_fits(rows, inner) || !product_fits(inner, cols) || !product_fits(rows, cols)) {
        ret err[Error].err{Error.size{}};
    }
    ret check_terms(inner, bound);
}

fun widen_i8(p: *i8, at: usize) i32x4 {
    ret i32x4{p[at]::i32, p[at + 1]::i32, p[at + 2]::i32, p[at + 3]::i32};
}

fun widen_u8(p: *u8, at: usize) u32x4 {
    ret u32x4{p[at]::u32, p[at + 1]::u32, p[at + 2]::u32, p[at + 3]::u32};
}

fun widen_i16(p: *i16, at: usize) i64x2 {
    ret i64x2{p[at]::i64, p[at + 1]::i64};
}

fun widen_u16(p: *u16, at: usize) u64x2 {
    ret u64x2{p[at]::u64, p[at + 1]::u64};
}

fun load_i32x4(p: *i32, at: usize) i32x4 {
    ret i32x4{p[at], p[at + 1], p[at + 2], p[at + 3]};
}

fun load_u32x4(p: *u32, at: usize) u32x4 {
    ret u32x4{p[at], p[at + 1], p[at + 2], p[at + 3]};
}

fun load_i64x2(p: *i64, at: usize) i64x2 {
    ret i64x2{p[at], p[at + 1]};
}

fun load_u64x2(p: *u64, at: usize) u64x2 {
    ret u64x2{p[at], p[at + 1]};
}

fun store_i32x4(p: *i32, at: usize, v: i32x4) {
    p[at]     = v[0];
    p[at + 1] = v[1];
    p[at + 2] = v[2];
    p[at + 3] = v[3];
}

fun store_u32x4(p: *u32, at: usize, v: u32x4) {
    p[at]     = v[0];
    p[at + 1] = v[1];
    p[at + 2] = v[2];
    p[at + 3] = v[3];
}

fun store_i64x2(p: *i64, at: usize, v: i64x2) {
    p[at]     = v[0];
    p[at + 1] = v[1];
}

fun store_u64x2(p: *u64, at: usize, v: u64x2) {
    p[at]     = v[0];
    p[at + 1] = v[1];
}

# exact dot product of two i8 sequences, accumulated in i32x4 lanes
# ---
# a:   first sequence, n elements
# b:   second sequence, n elements
# n:   element count, at most TERMS_I8
# ret: the sum of a[k] * b[k], or `Error.terms` when n exceeds TERMS_I8
pub fun dot_i8(a: *i8, b: *i8, n: usize) res[i32, Error] {
    val checked: err[Error] = check_terms(n, TERMS_I8);
    if (sel checked.err) { ret res[i32, Error].err{checked.err}; }
    var acc: i32x4 = i32x4{0, 0, 0, 0};
    var k:   usize = 0;
    for (k + 4 <= n) {
        acc = acc + widen_i8(a, k) * widen_i8(b, k);
        k   = k + 4;
    }
    var sum: i32 = hsum_i32x4(acc);
    for (k < n) {
        sum = sum + (a[k]::i32) * (b[k]::i32);
        k   = k + 1;
    }
    ret res[i32, Error].ok{sum};
}

# exact dot product of two u8 sequences, accumulated in u32x4 lanes
# ---
# a:   first sequence, n elements
# b:   second sequence, n elements
# n:   element count, at most TERMS_U8
# ret: the sum of a[k] * b[k], or `Error.terms` when n exceeds TERMS_U8
pub fun dot_u8(a: *u8, b: *u8, n: usize) res[u32, Error] {
    val checked: err[Error] = check_terms(n, TERMS_U8);
    if (sel checked.err) { ret res[u32, Error].err{checked.err}; }
    var acc: u32x4 = u32x4{0, 0, 0, 0};
    var k:   usize = 0;
    for (k + 4 <= n) {
        acc = acc + widen_u8(a, k) * widen_u8(b, k);
        k   = k + 4;
    }
    var sum: u32 = hsum_u32x4(acc);
    for (k < n) {
        sum = sum + (a[k]::u32) * (b[k]::u32);
        k   = k + 1;
    }
    ret res[u32, Error].ok{sum};
}

# exact dot product of two i16 sequences, accumulated in i64x2 lanes
# ---
# a:   first sequence, n elements
# b:   second sequence, n elements
# n:   element count, at most TERMS_I16
# ret: the sum of a[k] * b[k], or `Error.terms` when n exceeds TERMS_I16
pub fun dot_i16(a: *i16, b: *i16, n: usize) res[i64, Error] {
    val checked: err[Error] = check_terms(n, TERMS_I16);
    if (sel checked.err) { ret res[i64, Error].err{checked.err}; }
    var acc: i64x2 = i64x2{0, 0};
    var k:   usize = 0;
    for (k + 2 <= n) {
        acc = acc + widen_i16(a, k) * widen_i16(b, k);
        k   = k + 2;
    }
    var sum: i64 = hsum_i64x2(acc);
    if (k < n) { sum = sum + (a[k]::i64) * (b[k]::i64); }
    ret res[i64, Error].ok{sum};
}

# exact dot product of two u16 sequences, accumulated in u64x2 lanes
# ---
# a:   first sequence, n elements
# b:   second sequence, n elements
# n:   element count, at most TERMS_U16
# ret: the sum of a[k] * b[k], or `Error.terms` when n exceeds TERMS_U16
pub fun dot_u16(a: *u16, b: *u16, n: usize) res[u64, Error] {
    val checked: err[Error] = check_terms(n, TERMS_U16);
    if (sel checked.err) { ret res[u64, Error].err{checked.err}; }
    var acc: u64x2 = u64x2{0, 0};
    var k:   usize = 0;
    for (k + 2 <= n) {
        acc = acc + widen_u16(a, k) * widen_u16(b, k);
        k   = k + 2;
    }
    var sum: u64 = hsum_u64x2(acc);
    if (k < n) { sum = sum + (a[k]::u64) * (b[k]::u64); }
    ret res[u64, Error].ok{sum};
}

# exact product of two i8 matrices into i32, accumulated in i32x4 lanes
#
# the kernel runs in i-k-j order: for each (row, k) it widens a[row, k] once
# and adds its product with row k of b to the output row, four lanes a step.
# ---
# out:   rows x cols output, written in full
# a:     rows x inner left operand
# b:     inner x cols right operand
# rows:  rows of a and out
# inner: columns of a and rows of b, at most TERMS_I8
# cols:  columns of b and out
# ret:   ok, or `Error.terms` or `Error.size` with out untouched
pub fun matmul_i8(out: *i32, a: *i8, b: *i8, rows: usize, inner: usize, cols: usize) err[Error] {
    val checked: err[Error] = check_shape(rows, inner, cols, TERMS_I8);
    if (sel checked.err) { ret checked; }
    var r: usize = 0;
    for (r < rows) {
        val row: usize = r * cols;
        var j:   usize = 0;
        for (j < cols) {
            out[row + j] = 0;
            j            = j + 1;
        }
        var k: usize = 0;
        for (k < inner) {
            val s:    i32   = a[r * inner + k]::i32;
            val sv:   i32x4 = i32x4{s, s, s, s};
            val from: usize = k * cols;
            j = 0;
            for (j + 4 <= cols) {
                store_i32x4(out, row + j, load_i32x4(out, row + j) + sv * widen_i8(b, from + j));
                j = j + 4;
            }
            for (j < cols) {
                out[row + j] = out[row + j] + s * (b[from + j]::i32);
                j            = j + 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    ret err[Error].ok{};
}

# exact product of two u8 matrices into u32, accumulated in u32x4 lanes
# ---
# out:   rows x cols output, written in full
# a:     rows x inner left operand
# b:     inner x cols right operand
# rows:  rows of a and out
# inner: columns of a and rows of b, at most TERMS_U8
# cols:  columns of b and out
# ret:   ok, or `Error.terms` or `Error.size` with out untouched
pub fun matmul_u8(out: *u32, a: *u8, b: *u8, rows: usize, inner: usize, cols: usize) err[Error] {
    val checked: err[Error] = check_shape(rows, inner, cols, TERMS_U8);
    if (sel checked.err) { ret checked; }
    var r: usize = 0;
    for (r < rows) {
        val row: usize = r * cols;
        var j:   usize = 0;
        for (j < cols) {
            out[row + j] = 0;
            j            = j + 1;
        }
        var k: usize = 0;
        for (k < inner) {
            val s:    u32   = a[r * inner + k]::u32;
            val sv:   u32x4 = u32x4{s, s, s, s};
            val from: usize = k * cols;
            j = 0;
            for (j + 4 <= cols) {
                store_u32x4(out, row + j, load_u32x4(out, row + j) + sv * widen_u8(b, from + j));
                j = j + 4;
            }
            for (j < cols) {
                out[row + j] = out[row + j] + s * (b[from + j]::u32);
                j            = j + 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    ret err[Error].ok{};
}

# exact product of two i16 matrices into i64, accumulated in i64x2 lanes
# ---
# out:   rows x cols output, written in full
# a:     rows x inner left operand
# b:     inner x cols right operand
# rows:  rows of a and out
# inner: columns of a and rows of b, at most TERMS_I16
# cols:  columns of b and out
# ret:   ok, or `Error.terms` or `Error.size` with out untouched
pub fun matmul_i16(out: *i64, a: *i16, b: *i16, rows: usize, inner: usize, cols: usize) err[Error] {
    val checked: err[Error] = check_shape(rows, inner, cols, TERMS_I16);
    if (sel checked.err) { ret checked; }
    var r: usize = 0;
    for (r < rows) {
        val row: usize = r * cols;
        var j:   usize = 0;
        for (j < cols) {
            out[row + j] = 0;
            j            = j + 1;
        }
        var k: usize = 0;
        for (k < inner) {
            val s:    i64   = a[r * inner + k]::i64;
            val sv:   i64x2 = i64x2{s, s};
            val from: usize = k * cols;
            j = 0;
            for (j + 2 <= cols) {
                store_i64x2(out, row + j, load_i64x2(out, row + j) + sv * widen_i16(b, from + j));
                j = j + 2;
            }
            if (j < cols) { out[row + j] = out[row + j] + s * (b[from + j]::i64); }
            k = k + 1;
        }
        r = r + 1;
    }
    ret err[Error].ok{};
}

# exact product of two u16 matrices into u64, accumulated in u64x2 lanes
# ---
# out:   rows x cols output, written in full
# a:     rows x inner left operand
# b:     inner x cols right operand
# rows:  rows of a and out
# inner: columns of a and rows of b, at most TERMS_U16
# cols:  columns of b and out
# ret:   ok, or `Error.terms` or `Error.size` with out untouched
pub fun matmul_u16(out: *u64, a: *u16, b: *u16, rows: usize, inner: usize, cols: usize) err[Error] {
    val checked: err[Error] = check_shape(rows, inner, cols, TERMS_U16);
    if (sel checked.err) { ret checked; }
    var r: usize = 0;
    for (r < rows) {
        val row: usize = r * cols;
        var j:   usize = 0;
        for (j < cols) {
            out[row + j] = 0;
            j            = j + 1;
        }
        var k: usize = 0;
        for (k < inner) {
            val s:    u64   = a[r * inner + k]::u64;
            val sv:   u64x2 = u64x2{s, s};
            val from: usize = k * cols;
            j = 0;
            for (j + 2 <= cols) {
                store_u64x2(out, row + j, load_u64x2(out, row + j) + sv * widen_u16(b, from + j));
                j = j + 2;
            }
            if (j < cols) { out[row + j] = out[row + j] + s * (b[from + j]::u64); }
            k = k + 1;
        }
        r = r + 1;
    }
    ret err[Error].ok{};
}

# deterministic test values with the type's extremes mixed in
fun sample(seed: u64, k: usize) u64 {
    var x: u64 = seed ^ (k::u64 * 0x9E3779B97F4A7C15);
    x = x ^ (x >> 29);
    x = x * 0xBF58476D1CE4E5B9;
    x = x ^ (x >> 32);
    ret x;
}

fun sample_i8(seed: u64, k: usize) i8 {
    val x: u64 = sample(seed, k);
    if (x % 5 == 0) { ret -128; }
    if (x % 5 == 1) { ret 127; }
    ret (x & 0xFF)::u8:~i8;
}

fun sample_u8(seed: u64, k: usize) u8 {
    val x: u64 = sample(seed, k);
    if (x % 4 == 0) { ret 255; }
    ret (x & 0xFF)::u8;
}

fun sample_i16(seed: u64, k: usize) i16 {
    val x: u64 = sample(seed, k);
    if (x % 5 == 0) { ret -32768; }
    if (x % 5 == 1) { ret 32767; }
    ret (x & 0xFFFF)::u16:~i16;
}

fun sample_u16(seed: u64, k: usize) u16 {
    val x: u64 = sample(seed, k);
    if (x % 4 == 0) { ret 65535; }
    ret (x & 0xFFFF)::u16;
}

test "dot_i8: every tail length matches a scalar i64 reference" {
    var a: [11]i8;
    var b: [11]i8;
    var k: usize = 0;
    for (k < 11) {
        a[k] = sample_i8(1, k);
        b[k] = sample_i8(2, k);
        k    = k + 1;
    }
    var n: usize = 0;
    for (n <= 11) {
        var want: i64 = 0;
        k = 0;
        for (k < n) {
            want = want + (a[k]::i64) * (b[k]::i64);
            k    = k + 1;
        }
        val got: res[i32, Error] = dot_i8(?a[0], ?b[0], n);
        if (sel got.err)         { ret 1; }
        if (got.ok::i64 != want) { ret 2; }
        n = n + 1;
    }
    ret 0;
}

test "dot_i8: exact at TERMS_I8 worst-case terms, refused one past it" {
    var a: [131072]i8;
    var k: usize = 0;
    for (k < 131072) {
        a[k] = -128;
        k    = k + 1;
    }
    # 131071 * 16384 = 2147467264, beyond i16 and within 16384 of i32 max
    val got: res[i32, Error] = dot_i8(?a[0], ?a[0], 131071);
    if (sel got.err)          { ret 1; }
    if (got.ok != 2147467264) { ret 2; }
    val over: res[i32, Error] = dot_i8(?a[0], ?a[0], 131072);
    if (!sel over.err)       { ret 3; }
    if (!sel over.err.terms) { ret 4; }
    ret 0;
}

test "dot_u8: every tail length matches a scalar u64 reference" {
    var a: [9]u8;
    var b: [9]u8;
    var k: usize = 0;
    for (k < 9) {
        a[k] = sample_u8(3, k);
        b[k] = sample_u8(4, k);
        k    = k + 1;
    }
    var n: usize = 0;
    for (n <= 9) {
        var want: u64 = 0;
        k = 0;
        for (k < n) {
            want = want + (a[k]::u64) * (b[k]::u64);
            k    = k + 1;
        }
        val got: res[u32, Error] = dot_u8(?a[0], ?b[0], n);
        if (sel got.err)         { ret 1; }
        if (got.ok::u64 != want) { ret 2; }
        n = n + 1;
    }
    ret 0;
}

test "dot_u8: exact at TERMS_U8 worst-case terms, refused one past it" {
    var a: [66052]u8;
    var k: usize = 0;
    for (k < 66052) {
        a[k] = 255;
        k    = k + 1;
    }
    # 66051 * 65025 = 4294966275, within 1020 of u32 max
    val got: res[u32, Error] = dot_u8(?a[0], ?a[0], 66051);
    if (sel got.err)          { ret 1; }
    if (got.ok != 4294966275) { ret 2; }
    val over: res[u32, Error] = dot_u8(?a[0], ?a[0], 66052);
    if (!sel over.err) { ret 3; }
    ret 0;
}

test "dot_i16: sums past i32 exactly, with every tail length" {
    var a: [7]i16;
    var b: [7]i16;
    var k: usize = 0;
    for (k < 7) {
        a[k] = -32768;
        b[k] = -32768;
        k    = k + 1;
    }
    # 7 * 2^30 = 7516192768, which no i32 accumulator can hold
    val big: res[i64, Error] = dot_i16(?a[0], ?b[0], 7);
    if (sel big.err)          { ret 1; }
    if (big.ok != 7516192768) { ret 2; }
    k = 0;
    for (k < 7) {
        a[k] = sample_i16(5, k);
        b[k] = sample_i16(6, k);
        k    = k + 1;
    }
    var n: usize = 0;
    for (n <= 7) {
        var want: i64 = 0;
        k = 0;
        for (k < n) {
            want = want + (a[k]::i64) * (b[k]::i64);
            k    = k + 1;
        }
        val got: res[i64, Error] = dot_i16(?a[0], ?b[0], n);
        if (sel got.err)    { ret 3; }
        if (got.ok != want) { ret 4; }
        n = n + 1;
    }
    ret 0;
}

test "dot_i16 / dot_u16: refuse a count past the bound without reading" {
    # nil is never read: the bound is checked first
    val n16: usize           = (TERMS_I16 + 1)::usize;
    val i:   res[i64, Error] = dot_i16(nil, nil, n16);
    if (!sel i.err) { ret 1; }
    val nu: usize           = (TERMS_U16 + 1)::usize;
    val u:  res[u64, Error] = dot_u16(nil, nil, nu);
    if (!sel u.err) { ret 2; }
    ret 0;
}

test "dot_u16: sums past u32 exactly, with every tail length" {
    var a: [5]u16;
    var k: usize = 0;
    for (k < 5) {
        a[k] = 65535;
        k    = k + 1;
    }
    # 5 * 4294836225 = 21474181125
    val big: res[u64, Error] = dot_u16(?a[0], ?a[0], 5);
    if (sel big.err)           { ret 1; }
    if (big.ok != 21474181125) { ret 2; }
    var b: [5]u16;
    k = 0;
    for (k < 5) {
        a[k] = sample_u16(7, k);
        b[k] = sample_u16(8, k);
        k    = k + 1;
    }
    var n: usize = 0;
    for (n <= 5) {
        var want: u64 = 0;
        k = 0;
        for (k < n) {
            want = want + (a[k]::u64) * (b[k]::u64);
            k    = k + 1;
        }
        val got: res[u64, Error] = dot_u16(?a[0], ?b[0], n);
        if (sel got.err)    { ret 3; }
        if (got.ok != want) { ret 4; }
        n = n + 1;
    }
    ret 0;
}

test "matmul_i8: 3x5x7 matches a scalar reference, tails included" {
    var a:   [15]i8;
    var b:   [35]i8;
    var out: [21]i32;
    var k:   usize = 0;
    for (k < 15) {
        a[k] = sample_i8(9, k);
        k    = k + 1;
    }
    k = 0;
    for (k < 35) {
        b[k] = sample_i8(10, k);
        k    = k + 1;
    }
    val done: err[Error] = matmul_i8(?out[0], ?a[0], ?b[0], 3, 5, 7);
    if (!sel done.ok) { ret 1; }
    var r: usize = 0;
    for (r < 3) {
        var c: usize = 0;
        for (c < 7) {
            var want: i64   = 0;
            var m:    usize = 0;
            for (m < 5) {
                want = want + (a[r * 5 + m]::i64) * (b[m * 7 + c]::i64);
                m    = m + 1;
            }
            if (out[r * 7 + c]::i64 != want) { ret 2; }
            c = c + 1;
        }
        r = r + 1;
    }
    ret 0;
}

test "matmul_u8: 2x3x5 matches a scalar reference and overwrites out" {
    var a:   [6]u8;
    var b:   [15]u8;
    var out: [10]u32;
    var k:   usize = 0;
    for (k < 10) {
        out[k] = 0xDEADBEEF;
        k      = k + 1;
    }
    k = 0;
    for (k < 6) {
        a[k] = sample_u8(11, k);
        k    = k + 1;
    }
    k = 0;
    for (k < 15) {
        b[k] = sample_u8(12, k);
        k    = k + 1;
    }
    val done: err[Error] = matmul_u8(?out[0], ?a[0], ?b[0], 2, 3, 5);
    if (!sel done.ok) { ret 1; }
    var r: usize = 0;
    for (r < 2) {
        var c: usize = 0;
        for (c < 5) {
            var want: u64   = 0;
            var m:    usize = 0;
            for (m < 3) {
                want = want + (a[r * 3 + m]::u64) * (b[m * 5 + c]::u64);
                m    = m + 1;
            }
            if (out[r * 5 + c]::u64 != want) { ret 2; }
            c = c + 1;
        }
        r = r + 1;
    }
    ret 0;
}

test "matmul_i16: 4x3x3 of extremes sums past i32 exactly" {
    var a:   [12]i16;
    var b:   [9]i16;
    var out: [12]i64;
    var k:   usize = 0;
    for (k < 12) {
        a[k] = sample_i16(13, k);
        k    = k + 1;
    }
    k = 0;
    for (k < 9) {
        b[k] = sample_i16(14, k);
        k    = k + 1;
    }
    # row 0 of a and column 0 of b all at i16 min: out[0] = 3 * 2^30
    a[0] = -32768;
    a[1] = -32768;
    a[2] = -32768;
    b[0] = -32768;
    b[3] = -32768;
    b[6] = -32768;
    val done: err[Error] = matmul_i16(?out[0], ?a[0], ?b[0], 4, 3, 3);
    if (!sel done.ok)         { ret 1; }
    if (out[0] != 3221225472) { ret 2; }
    var r: usize = 0;
    for (r < 4) {
        var c: usize = 0;
        for (c < 3) {
            var want: i64   = 0;
            var m:    usize = 0;
            for (m < 3) {
                want = want + (a[r * 3 + m]::i64) * (b[m * 3 + c]::i64);
                m    = m + 1;
            }
            if (out[r * 3 + c] != want) { ret 3; }
            c = c + 1;
        }
        r = r + 1;
    }
    ret 0;
}

test "matmul_u16: 3x5x3 of extremes sums past u32 exactly" {
    var a:   [15]u16;
    var b:   [15]u16;
    var out: [9]u64;
    var k:   usize = 0;
    for (k < 15) {
        a[k] = sample_u16(15, k);
        b[k] = sample_u16(16, k);
        k    = k + 1;
    }
    k = 0;
    for (k < 5) {
        a[k]         = 65535;
        b[k * 3 + 2] = 65535;
        k            = k + 1;
    }
    val done: err[Error] = matmul_u16(?out[0], ?a[0], ?b[0], 3, 5, 3);
    if (!sel done.ok) { ret 1; }
    # row 0 of a and column 2 of b all at u16 max: 5 * 4294836225
    if (out[2] != 21474181125) { ret 2; }
    var r: usize = 0;
    for (r < 3) {
        var c: usize = 0;
        for (c < 3) {
            var want: u64   = 0;
            var m:    usize = 0;
            for (m < 5) {
                want = want + (a[r * 5 + m]::u64) * (b[m * 3 + c]::u64);
                m    = m + 1;
            }
            if (out[r * 3 + c] != want) { ret 3; }
            c = c + 1;
        }
        r = r + 1;
    }
    ret 0;
}

test "matmul: empty inner dimension writes zeros, bad shapes leave out untouched" {
    var out:   [4]i32     = [4]i32{7, 7, 7, 7};
    val empty: err[Error] = matmul_i8(?out[0], nil, nil, 2, 0, 2);
    if (!sel empty.ok) { ret 1; }
    var k: usize = 0;
    for (k < 4) {
        if (out[k] != 0) { ret 2; }
        out[k] = 7;
        k      = k + 1;
    }
    val zero: usize      = 0;
    val huge: usize      = ~zero;
    val size: err[Error] = matmul_i8(?out[0], nil, nil, 2, huge, 2);
    if (!sel size.err)      { ret 3; }
    if (!sel size.err.size) { ret 4; }
    val terms: err[Error] = matmul_i8(?out[0], nil, nil, 1, (TERMS_I8 + 1)::usize, 1);
    if (!sel terms.err)       { ret 5; }
    if (!sel terms.err.terms) { ret 6; }
    k = 0;
    for (k < 4) {
        if (out[k] != 7) { ret 7; }
        k = k + 1;
    }
    ret 0;
}
