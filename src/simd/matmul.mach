# widening integer dot products and matrix multiplication
#
# a narrow element never multiplies into a wider lane on its own. each
# routine here widens both operands first, then multiplies and adds. the
# accumulator width is also the result width.
#
# element widths and signedness, one row per element type:
#
#   element  result  largest |product|   TERMS_* (exactness bound)
#   i8       i32     (-128)^2   = 2^14   131071
#   u8       u32     255^2      = 65025  66051
#   i16      i64     (-32768)^2 = 2^30   8589934591
#   u16      u64     65535^2             4295098371
#
# signed elements accumulate in signed sums and unsigned in unsigned. there is
# no mixed-signedness form. i32 and u32 elements are not offered: their largest
# product needs 62 or 64 bits, so an i64 or u64 accumulator is exact for a
# single term only, and there is no wider type to accumulate into. i16 into
# i32 is not offered for the same reason ((-32768)^2 = 2^30, so two such
# terms already overflow i32).
#
# overflow policy: a result is exact, never wrapped, when every sum it is built
# from has at most TERMS_* terms. TERMS_* is the largest count for which that
# many worst-case products still fit the result type. the bound is checked
# before any work: a dot product over more than TERMS_* elements, or a matmul
# whose inner dimension exceeds it, returns `Error.terms` and reads and writes
# nothing. a caller with a longer sum splits it into chunks of at most TERMS_*
# and adds the chunk results in a type it has proven wide enough. nothing here
# accumulates without bound.
#
# the kernels run in lane form: whole-vector loads and stores are ranges
# (`p[k, 4]::i32x4`), widening is the lane-wise `::` between vectors, and a
# product that fits a narrower lane is taken there (i8 and u8 in 16-bit lanes,
# i16 and u16 in 32-bit lanes) and widened into the accumulator. the tail of
# each kernel is the plain scalar loop.
#
# layouts: matrices are dense, row-major and contiguous, so element (r, c) of a
# matrix with n columns is at `r * n + c`. `a` is rows x inner, `b` is inner x
# cols and `out` is rows x cols. `out` must not overlap `a` or `b`. every
# element of `out` is written.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

# terms: a sum would have more terms than the element type's TERMS_* bound
# size:  rows * inner, inner * cols or rows * cols does not fit usize
pub tag Error: u8 {
    terms;
    size;
}

# the most i8 products an i32 sum holds exactly
pub val TERMS_I8: u64 = 131071;
# the most u8 products a u32 sum holds exactly
pub val TERMS_U8: u64 = 66051;
# the most i16 products an i64 sum holds exactly
pub val TERMS_I16: u64 = 8589934591;
# the most u16 products a u64 sum holds exactly
pub val TERMS_U16: u64 = 4295098371;

fun product_fits(x: usize, y: usize) bool {
    if (x == 0) { ret true; }
    val zero: usize = 0;
    val max:  usize = ~zero;
    ret y <= max / x;
}

fun check_terms(n: usize, bound: u64) err[Error] {
    if (n::u64 > bound) { ret err[Error].err{Error.terms{}}; }
    ret err[Error].ok{};
}

fun check_shape(rows: usize, inner: usize, cols: usize, bound: u64) err[Error] {
    if (!product_fits(rows, inner) || !product_fits(inner, cols) || !product_fits(rows, cols)) {
        ret err[Error].err{Error.size{}};
    }
    ret check_terms(inner, bound);
}

# exact dot product of two i8 sequences, accumulated in i32
# ---
# a:   first sequence, n elements
# b:   second sequence, n elements
# n:   element count, at most TERMS_I8
# ret: the sum of a[k] * b[k], or `Error.terms` when n exceeds TERMS_I8
pub fun dot_i8(a: *i8, b: *i8, n: usize) res[i32, Error] {
    val checked: err[Error] = check_terms(n, TERMS_I8);
    if (sel checked.err) { ret res[i32, Error].err{checked.err}; }
    var lanes: i32x4 = i32x4{0, 0, 0, 0};
    val body:  usize = n - n % 16;
    var k:     usize = 0;
    for (k < body) {
        val x:  i8x16 = a[k, 16]::i8x16;
        val y:  i8x16 = b[k, 16]::i8x16;
        val lo: i16x8 = x[0, 8]::i16x8 * y[0, 8]::i16x8;
        val hi: i16x8 = x[8, 8]::i16x8 * y[8, 8]::i16x8;
        lanes = lanes + lo[0, 4]::i32x4 + lo[4, 4]::i32x4 + hi[0, 4]::i32x4 + hi[4, 4]::i32x4;
        k     = k + 16;
    }
    var part: [4]i32 = lanes::[4]i32;
    var sum:  i32    = part[0] + part[1] + part[2] + part[3];
    for (k < n) {
        sum = sum + (a[k]::i32) * (b[k]::i32);
        k   = k + 1;
    }
    ret res[i32, Error].ok{sum};
}

# exact dot product of two u8 sequences, accumulated in u32
# ---
# a:   first sequence, n elements
# b:   second sequence, n elements
# n:   element count, at most TERMS_U8
# ret: the sum of a[k] * b[k], or `Error.terms` when n exceeds TERMS_U8
pub fun dot_u8(a: *u8, b: *u8, n: usize) res[u32, Error] {
    val checked: err[Error] = check_terms(n, TERMS_U8);
    if (sel checked.err) { ret res[u32, Error].err{checked.err}; }
    var lanes: u32x4 = u32x4{0, 0, 0, 0};
    val body:  usize = n - n % 16;
    var k:     usize = 0;
    for (k < body) {
        val x:  u8x16 = a[k, 16]::u8x16;
        val y:  u8x16 = b[k, 16]::u8x16;
        val lo: u16x8 = x[0, 8]::u16x8 * y[0, 8]::u16x8;
        val hi: u16x8 = x[8, 8]::u16x8 * y[8, 8]::u16x8;
        lanes = lanes + lo[0, 4]::u32x4 + lo[4, 4]::u32x4 + hi[0, 4]::u32x4 + hi[4, 4]::u32x4;
        k     = k + 16;
    }
    var part: [4]u32 = lanes::[4]u32;
    var sum:  u32    = part[0] + part[1] + part[2] + part[3];
    for (k < n) {
        sum = sum + (a[k]::u32) * (b[k]::u32);
        k   = k + 1;
    }
    ret res[u32, Error].ok{sum};
}

# exact dot product of two i16 sequences, accumulated in i64
# ---
# a:   first sequence, n elements
# b:   second sequence, n elements
# n:   element count, at most TERMS_I16
# ret: the sum of a[k] * b[k], or `Error.terms` when n exceeds TERMS_I16
pub fun dot_i16(a: *i16, b: *i16, n: usize) res[i64, Error] {
    val checked: err[Error] = check_terms(n, TERMS_I16);
    if (sel checked.err) { ret res[i64, Error].err{checked.err}; }
    var lanes: i64x2 = i64x2{0, 0};
    val body:  usize = n - n % 4;
    var k:     usize = 0;
    for (k < body) {
        val x: i32x4 = a[k, 4]::i16x4::i32x4;
        val y: i32x4 = b[k, 4]::i16x4::i32x4;
        val p: i32x4 = x * y;
        lanes = lanes + p[0, 2]::i64x2 + p[2, 2]::i64x2;
        k     = k + 4;
    }
    var part: [2]i64 = lanes::[2]i64;
    var sum:  i64    = part[0] + part[1];
    for (k < n) {
        sum = sum + (a[k]::i64) * (b[k]::i64);
        k   = k + 1;
    }
    ret res[i64, Error].ok{sum};
}

# exact dot product of two u16 sequences, accumulated in u64
# ---
# a:   first sequence, n elements
# b:   second sequence, n elements
# n:   element count, at most TERMS_U16
# ret: the sum of a[k] * b[k], or `Error.terms` when n exceeds TERMS_U16
pub fun dot_u16(a: *u16, b: *u16, n: usize) res[u64, Error] {
    val checked: err[Error] = check_terms(n, TERMS_U16);
    if (sel checked.err) { ret res[u64, Error].err{checked.err}; }
    var lanes: u64x2 = u64x2{0, 0};
    val body:  usize = n - n % 4;
    var k:     usize = 0;
    for (k < body) {
        val x: u32x4 = a[k, 4]::u16x4::u32x4;
        val y: u32x4 = b[k, 4]::u16x4::u32x4;
        val p: u32x4 = x * y;
        lanes = lanes + p[0, 2]::u64x2 + p[2, 2]::u64x2;
        k     = k + 4;
    }
    var part: [2]u64 = lanes::[2]u64;
    var sum:  u64    = part[0] + part[1];
    for (k < n) {
        sum = sum + (a[k]::u64) * (b[k]::u64);
        k   = k + 1;
    }
    ret res[u64, Error].ok{sum};
}

# exact product of two i8 matrices into i32, accumulated in i32
#
# the kernel runs in i-k-j order: for each (row, k) it widens a[row, k] once
# and adds its product with row k of b to the output row.
# ---
# out:   rows x cols output, written in full
# a:     rows x inner left operand
# b:     inner x cols right operand
# rows:  rows of a and out
# inner: columns of a and rows of b, at most TERMS_I8
# cols:  columns of b and out
# ret:   ok, or `Error.terms` or `Error.size` with out untouched
pub fun matmul_i8(out: *i32, a: *i8, b: *i8, rows: usize, inner: usize, cols: usize) err[Error] {
    val checked: err[Error] = check_shape(rows, inner, cols, TERMS_I8);
    if (sel checked.err) { ret checked; }
    var r: usize = 0;
    for (r < rows) {
        val row: usize = r * cols;
        var j:   usize = 0;
        for (j < cols) {
            out[row + j] = 0;
            j            = j + 1;
        }
        var k: usize = 0;
        for (k < inner) {
            val s:    i32   = a[r * inner + k]::i32;
            val from: usize = k * cols;
            val sv:   i32x4 = i32x4{s, s, s, s};
            val wide: usize = cols - cols % 4;
            j = 0;
            for (j < wide) {
                val o: i32x4 = out[row + j, 4]::i32x4;
                val y: i32x4 = b[from + j, 4]::i8x4::i32x4;
                out[row + j, 4] = (o + sv * y)::[4]i32;
                j               = j + 4;
            }
            for (j < cols) {
                out[row + j] = out[row + j] + s * (b[from + j]::i32);
                j            = j + 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    ret err[Error].ok{};
}

# exact product of two u8 matrices into u32, accumulated in u32
# ---
# out:   rows x cols output, written in full
# a:     rows x inner left operand
# b:     inner x cols right operand
# rows:  rows of a and out
# inner: columns of a and rows of b, at most TERMS_U8
# cols:  columns of b and out
# ret:   ok, or `Error.terms` or `Error.size` with out untouched
pub fun matmul_u8(out: *u32, a: *u8, b: *u8, rows: usize, inner: usize, cols: usize) err[Error] {
    val checked: err[Error] = check_shape(rows, inner, cols, TERMS_U8);
    if (sel checked.err) { ret checked; }
    var r: usize = 0;
    for (r < rows) {
        val row: usize = r * cols;
        var j:   usize = 0;
        for (j < cols) {
            out[row + j] = 0;
            j            = j + 1;
        }
        var k: usize = 0;
        for (k < inner) {
            val s:    u32   = a[r * inner + k]::u32;
            val from: usize = k * cols;
            val sv:   u32x4 = u32x4{s, s, s, s};
            val wide: usize = cols - cols % 4;
            j = 0;
            for (j < wide) {
                val o: u32x4 = out[row + j, 4]::u32x4;
                val y: u32x4 = b[from + j, 4]::u8x4::u32x4;
                out[row + j, 4] = (o + sv * y)::[4]u32;
                j               = j + 4;
            }
            for (j < cols) {
                out[row + j] = out[row + j] + s * (b[from + j]::u32);
                j            = j + 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    ret err[Error].ok{};
}

# exact product of two i16 matrices into i64, accumulated in i64
# ---
# out:   rows x cols output, written in full
# a:     rows x inner left operand
# b:     inner x cols right operand
# rows:  rows of a and out
# inner: columns of a and rows of b, at most TERMS_I16
# cols:  columns of b and out
# ret:   ok, or `Error.terms` or `Error.size` with out untouched
pub fun matmul_i16(out: *i64, a: *i16, b: *i16, rows: usize, inner: usize, cols: usize) err[Error] {
    val checked: err[Error] = check_shape(rows, inner, cols, TERMS_I16);
    if (sel checked.err) { ret checked; }
    var r: usize = 0;
    for (r < rows) {
        val row: usize = r * cols;
        var j:   usize = 0;
        for (j < cols) {
            out[row + j] = 0;
            j            = j + 1;
        }
        var k: usize = 0;
        for (k < inner) {
            val s:    i64   = a[r * inner + k]::i64;
            val from: usize = k * cols;
            val s32:  i32   = a[r * inner + k]::i32;
            val sv:   i32x4 = i32x4{s32, s32, s32, s32};
            val wide: usize = cols - cols % 4;
            j = 0;
            for (j < wide) {
                val y:  i32x4 = b[from + j, 4]::i16x4::i32x4;
                val p:  i32x4 = sv * y;
                val lo: i64x2 = out[row + j, 2]::i64x2;
                val hi: i64x2 = out[row + j + 2, 2]::i64x2;
                out[row + j, 2]     = (lo + p[0, 2]::i64x2)::[2]i64;
                out[row + j + 2, 2] = (hi + p[2, 2]::i64x2)::[2]i64;
                j                   = j + 4;
            }
            for (j < cols) {
                out[row + j] = out[row + j] + s * (b[from + j]::i64);
                j            = j + 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    ret err[Error].ok{};
}

# exact product of two u16 matrices into u64, accumulated in u64
# ---
# out:   rows x cols output, written in full
# a:     rows x inner left operand
# b:     inner x cols right operand
# rows:  rows of a and out
# inner: columns of a and rows of b, at most TERMS_U16
# cols:  columns of b and out
# ret:   ok, or `Error.terms` or `Error.size` with out untouched
pub fun matmul_u16(out: *u64, a: *u16, b: *u16, rows: usize, inner: usize, cols: usize) err[Error] {
    val checked: err[Error] = check_shape(rows, inner, cols, TERMS_U16);
    if (sel checked.err) { ret checked; }
    var r: usize = 0;
    for (r < rows) {
        val row: usize = r * cols;
        var j:   usize = 0;
        for (j < cols) {
            out[row + j] = 0;
            j            = j + 1;
        }
        var k: usize = 0;
        for (k < inner) {
            val s:    u64   = a[r * inner + k]::u64;
            val from: usize = k * cols;
            val s32:  u32   = a[r * inner + k]::u32;
            val sv:   u32x4 = u32x4{s32, s32, s32, s32};
            val wide: usize = cols - cols % 4;
            j = 0;
            for (j < wide) {
                val y:  u32x4 = b[from + j, 4]::u16x4::u32x4;
                val p:  u32x4 = sv * y;
                val lo: u64x2 = out[row + j, 2]::u64x2;
                val hi: u64x2 = out[row + j + 2, 2]::u64x2;
                out[row + j, 2]     = (lo + p[0, 2]::u64x2)::[2]u64;
                out[row + j + 2, 2] = (hi + p[2, 2]::u64x2)::[2]u64;
                j                   = j + 4;
            }
            for (j < cols) {
                out[row + j] = out[row + j] + s * (b[from + j]::u64);
                j            = j + 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    ret err[Error].ok{};
}

# deterministic test values with the type's extremes mixed in
#[testing]
fun sample(seed: u64, k: usize) u64 {
    var x: u64 = seed ^ (k::u64 * 0x9E3779B97F4A7C15);
    x = x ^ (x >> 29);
    x = x * 0xBF58476D1CE4E5B9;
    x = x ^ (x >> 32);
    ret x;
}

#[testing]
fun sample_i8(seed: u64, k: usize) i8 {
    val x: u64 = sample(seed, k);
    if (x % 5 == 0) { ret -128; }
    if (x % 5 == 1) { ret 127; }
    ret (x & 0xFF)::u8:~i8;
}

#[testing]
fun sample_i16(seed: u64, k: usize) i16 {
    val x: u64 = sample(seed, k);
    if (x % 5 == 0) { ret -32768; }
    if (x % 5 == 1) { ret 32767; }
    ret (x & 0xFFFF)::u16:~i16;
}

test dot_i8__exact_at_the_terms_bound_refused_past_it {
    var a: [131072]i8;
    var k: usize = 0;
    for (k < 131072) {
        a[k] = -128;
        k    = k + 1;
    }
    # 131071 * 16384 = 2147467264, beyond i16 and within 16384 of i32 max
    val got: res[i32, Error] = dot_i8(?a[0], ?a[0], 131071);
    if (sel got.err)          { ret 1; }
    if (got.ok != 2147467264) { ret 2; }
    val over: res[i32, Error] = dot_i8(?a[0], ?a[0], 131072);
    if (!sel over.err)       { ret 3; }
    if (!sel over.err.terms) { ret 4; }
    ret 0;
}

test dot_u8__exact_at_the_terms_bound_refused_past_it {
    var a: [66052]u8;
    var k: usize = 0;
    for (k < 66052) {
        a[k] = 255;
        k    = k + 1;
    }
    # 66051 * 65025 = 4294966275, within 1020 of u32 max
    val got: res[u32, Error] = dot_u8(?a[0], ?a[0], 66051);
    if (sel got.err)          { ret 1; }
    if (got.ok != 4294966275) { ret 2; }
    val over: res[u32, Error] = dot_u8(?a[0], ?a[0], 66052);
    if (!sel over.err) { ret 3; }
    ret 0;
}

test dot_16__sums_past_32_bits_and_refuses_past_the_bound_without_reading {
    var a: [7]i16;
    var b: [7]u16;
    var k: usize = 0;
    for (k < 7) {
        a[k] = -32768;
        b[k] = 65535;
        k    = k + 1;
    }
    # 7 * 2^30 = 7516192768, which no i32 accumulator can hold
    val i: res[i64, Error] = dot_i16(?a[0], ?a[0], 7);
    if (sel i.err)          { ret 1; }
    if (i.ok != 7516192768) { ret 2; }
    # 5 * 4294836225 = 21474181125
    val u: res[u64, Error] = dot_u16(?b[0], ?b[0], 5);
    if (sel u.err)           { ret 3; }
    if (u.ok != 21474181125) { ret 4; }
    # nil is never read: the bound is checked first
    val io: res[i64, Error] = dot_i16(nil, nil, (TERMS_I16 + 1)::usize);
    if (!sel io.err) { ret 5; }
    val uo: res[u64, Error] = dot_u16(nil, nil, (TERMS_U16 + 1)::usize);
    if (!sel uo.err) { ret 6; }
    ret 0;
}

test matmul_i8__matches_a_scalar_reference {
    var a:   [15]i8;
    var b:   [35]i8;
    var out: [21]i32;
    var k:   usize = 0;
    for (k < 15) {
        a[k] = sample_i8(9, k);
        k    = k + 1;
    }
    k = 0;
    for (k < 35) {
        b[k] = sample_i8(10, k);
        k    = k + 1;
    }
    val done: err[Error] = matmul_i8(?out[0], ?a[0], ?b[0], 3, 5, 7);
    if (!sel done.ok) { ret 1; }
    var r: usize = 0;
    for (r < 3) {
        var c: usize = 0;
        for (c < 7) {
            var want: i64   = 0;
            var m:    usize = 0;
            for (m < 5) {
                want = want + (a[r * 5 + m]::i64) * (b[m * 7 + c]::i64);
                m    = m + 1;
            }
            if (out[r * 7 + c]::i64 != want) { ret 2; }
            c = c + 1;
        }
        r = r + 1;
    }
    ret 0;
}

test matmul_i16__extremes_sum_past_i32_exactly {
    var a:   [12]i16;
    var b:   [9]i16;
    var out: [12]i64;
    var k:   usize = 0;
    for (k < 12) {
        a[k] = sample_i16(13, k);
        k    = k + 1;
    }
    k = 0;
    for (k < 9) {
        b[k] = sample_i16(14, k);
        k    = k + 1;
    }
    # row 0 of a and column 0 of b all at i16 min: out[0] = 3 * 2^30
    a[0] = -32768;
    a[1] = -32768;
    a[2] = -32768;
    b[0] = -32768;
    b[3] = -32768;
    b[6] = -32768;
    val done: err[Error] = matmul_i16(?out[0], ?a[0], ?b[0], 4, 3, 3);
    if (!sel done.ok)         { ret 1; }
    if (out[0] != 3221225472) { ret 2; }
    var r: usize = 0;
    for (r < 4) {
        var c: usize = 0;
        for (c < 3) {
            var want: i64   = 0;
            var m:    usize = 0;
            for (m < 3) {
                want = want + (a[r * 3 + m]::i64) * (b[m * 3 + c]::i64);
                m    = m + 1;
            }
            if (out[r * 3 + c] != want) { ret 3; }
            c = c + 1;
        }
        r = r + 1;
    }
    ret 0;
}

test matmul__empty_inner_writes_zeros_bad_shapes_leave_out_untouched {
    var out:   [4]i32     = [4]i32{7, 7, 7, 7};
    val empty: err[Error] = matmul_i8(?out[0], nil, nil, 2, 0, 2);
    if (!sel empty.ok) { ret 1; }
    var k: usize = 0;
    for (k < 4) {
        if (out[k] != 0) { ret 2; }
        out[k] = 7;
        k      = k + 1;
    }
    val zero: usize      = 0;
    val huge: usize      = ~zero;
    val size: err[Error] = matmul_i8(?out[0], nil, nil, 2, huge, 2);
    if (!sel size.err)      { ret 3; }
    if (!sel size.err.size) { ret 4; }
    val terms: err[Error] = matmul_i8(?out[0], nil, nil, 1, (TERMS_I8 + 1)::usize, 1);
    if (!sel terms.err)       { ret 5; }
    if (!sel terms.err.terms) { ret 6; }
    k = 0;
    for (k < 4) {
        if (out[k] != 7) { ret 7; }
        k = k + 1;
    }
    ret 0;
}

test dot__every_length_matches_a_scalar_reference {
    var a: [41]i8;
    var u: [41]u8;
    var s: [41]i16;
    var w: [41]u16;
    var k: usize = 0;
    for (k < 41) {
        a[k] = sample_i8(21, k);
        u[k] = (sample(22, k) & 0xFF)::u8;
        s[k] = sample_i16(23, k);
        w[k] = (sample(24, k) & 0xFFFF)::u16;
        k    = k + 1;
    }
    var n: usize = 0;
    for (n < 41) {
        var wi8:  i64 = 0;
        var wu8:  u64 = 0;
        var wi16: i64 = 0;
        var wu16: u64 = 0;
        k = 0;
        for (k < n) {
            wi8  = wi8 + (a[k]::i64) * (a[k]::i64);
            wu8  = wu8 + (u[k]::u64) * (u[k]::u64);
            wi16 = wi16 + (s[k]::i64) * (s[k]::i64);
            wu16 = wu16 + (w[k]::u64) * (w[k]::u64);
            k    = k + 1;
        }
        val gi8:  res[i32, Error] = dot_i8(?a[0], ?a[0], n);
        val gu8:  res[u32, Error] = dot_u8(?u[0], ?u[0], n);
        val gi16: res[i64, Error] = dot_i16(?s[0], ?s[0], n);
        val gu16: res[u64, Error] = dot_u16(?w[0], ?w[0], n);
        if (sel gi8.err)        { ret 1; }
        if (gi8.ok::i64 != wi8) { ret 5; }
        if (sel gu8.err)        { ret 2; }
        if (gu8.ok::u64 != wu8) { ret 6; }
        if (sel gi16.err)       { ret 3; }
        if (gi16.ok != wi16)    { ret 7; }
        if (sel gu16.err)       { ret 4; }
        if (gu16.ok != wu16)    { ret 8; }
        n = n + 1;
    }
    ret 0;
}
