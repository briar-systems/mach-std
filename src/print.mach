# formatted output to stdout/stderr
#
# print, println, eprint and eprintln hand their text, and the newline, to the
# file in one gather write. the rest format through std.format into a staging
# buffer drained to the file. checked printing stays checked: every function
# reports the writer's outcome, and the printf family adds the format string's
# failures on top.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
#[testing]
use std.types.string.str_equals;
use std.types.string.str_len;

use std.format;
use std.format.FormatError;
use io_error: std.io.error;
use std.io.writer;
use std.io.writer.WriteError;
use std.system.capability;

$if (capability.HAS_FILES) {
    use std.filesystem;
    #[testing]
    use io_handle: std.io.handle;
    #[testing]
    use std.system.os;
}
$or {
    $error("std.print needs the files capability (std.system.capability.HAS_FILES)");
}

# staging capacity a printf-family call formats into before reaching the fd
#
# sized so a typical log or diagnostic line lands in one write. output larger
# than this still reaches the fd whole for the part that fills the buffer, and
# ordering is unaffected: the buffer lives on the call's stack frame and is
# drained before the call returns, so nothing is held across calls and stdout
# and stderr interleave exactly as unbuffered writes do.
val STAGE: usize = 512;

# a printf-family call's staging: the file's writer, the buffer in front of it,
# and the writer the format reaches through that buffer
rec Stage {
    out:     writer.Writer;
    b:       writer.Buffered;
    w:       writer.Writer;
    storage: [STAGE]u8;
}

# point the stage's writer at out through its buffer
fun stage(s: *Stage, out: writer.Writer) {
    s.out = out;
    s.w   = writer.buffered(?s.b, ?s.out, ?s.storage[0], STAGE);
}

# drain the staging buffer and report the bytes that actually reached the fd
# ---
# a byte count from the staging writer is provisional, so the call's outcome is
# restated against writer.pushed: a failure carries the true persisted prefix
# and a success reports the bytes the fd took.
fun settle(s: *Stage, outcome: res[usize, FormatError]) res[usize, FormatError] {
    val err_drained: err[WriteError] = writer.flush(?s.b);
    val done:        usize           = writer.pushed(?s.b);

    if (sel outcome.err) {
        if (sel outcome.err.write) {
            ret res[usize, FormatError].err{FormatError.write{writer.reprefix(outcome.err.write, done)}};
        }
        ret outcome;
    }
    if (sel err_drained.err) {
        ret res[usize, FormatError].err{FormatError.write{writer.reprefix(err_drained.err, done)}};
    }
    ret res[usize, FormatError].ok{done};
}

# add a newline after a format that succeeded, then settle the stage, reporting
# the persisted prefix across both
fun settle_line(s: *Stage, outcome: res[usize, FormatError]) res[usize, FormatError] {
    if (sel outcome.err) { ret settle(s, outcome); }

    val res_newline_written: res[usize, WriteError] = format.write_newline(?s.w);
    if (sel res_newline_written.err) { ret settle(s, res[usize, FormatError].err{FormatError.write{writer.advance(res_newline_written.err, outcome.ok)}}); }

    ret settle(s, res[usize, FormatError].ok{outcome.ok + res_newline_written.ok});
}

# write the pieces to f in order: one gather write takes them all unless the
# file takes a short count, and then the rest follows from where it stopped
# ---
# f:      file to write to
# pieces: the buffers, trimmed in place as they are written
# count:  number of pieces
# ret:    bytes written, or the failure with the persisted prefix
fun write_pieces(f: filesystem.File, pieces: *filesystem.IoVector, count: usize) res[usize, WriteError] {
    var first: usize = 0;
    var taken: usize = 0;
    var done:  usize = 0;
    for {
        for (first < count && taken >= pieces[first].length) {
            taken = taken - pieces[first].length;
            first = first + 1;
        }
        if (first == count) { ret res[usize, WriteError].ok{done}; }
        pieces[first].data   = ?pieces[first].data[taken];
        pieces[first].length = pieces[first].length - taken;

        val res_written: res[usize, io_error.Error] = filesystem.write_vector(f, ?pieces[first], count - first);
        if (sel res_written.err) { ret res[usize, WriteError].err{writer.classify(writer.native_failure(done, res_written.err))}; }
        if (res_written.ok == 0) { ret res[usize, WriteError].err{WriteError.stalled{done}}; }
        taken = res_written.ok;
        done  = done + taken;
    }
}

# write s to f, and a newline after it when line is true, in one gather write
fun write_text(f: filesystem.File, s: str, line: bool) res[usize, WriteError] {
    var pieces: [2]filesystem.IoVector = [2]filesystem.IoVector{
        filesystem.IoVector{data: s, length: str_len(s)},
        filesystem.IoVector{data: "\n", length: 1}
    };
    var count: usize = 1;
    if (line) { count = 2; }
    ret write_pieces(f, ?pieces[0], count);
}

# write s to stdout
# ---
# s:   string to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun print(s: str) res[usize, WriteError] {
    ret write_text(filesystem.STDOUT, s, false);
}

# write s followed by a newline to stdout
# ---
# s:   string to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun println(s: str) res[usize, WriteError] {
    ret write_text(filesystem.STDOUT, s, true);
}

# write s to stderr
# ---
# s:   string to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun eprint(s: str) res[usize, WriteError] {
    ret write_text(filesystem.STDERR, s, false);
}

# write s followed by a newline to stderr
# ---
# s:   string to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun eprintln(s: str) res[usize, WriteError] {
    ret write_text(filesystem.STDERR, s, true);
}

# write unsigned 64-bit integer to stdout
# ---
# n:   value to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun u64(n: u64) res[usize, WriteError] {
    var w: writer.Writer = filesystem.writer(filesystem.STDOUT);
    ret format.write_u64(?w, n);
}

# write unsigned 64-bit integer to stderr
# ---
# n:   value to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun eu64(n: u64) res[usize, WriteError] {
    var w: writer.Writer = filesystem.writer(filesystem.STDERR);
    ret format.write_u64(?w, n);
}

# formatted output to stdout
# ---
# fmt: format string (see std.format.vformat for hole syntax)
# va:  comptime variadic argument pack
# ret: bytes written, or the format's failure
pub fun printf(fmt: str, va: ...) res[usize, FormatError] {
    var s: Stage;
    stage(?s, filesystem.writer(filesystem.STDOUT));
    ret settle(?s, format.vformat(?s.w, fmt, va...));
}

# formatted output to stderr
# ---
# fmt: format string (see std.format.vformat for hole syntax)
# va:  comptime variadic argument pack
# ret: bytes written, or the format's failure
pub fun eprintf(fmt: str, va: ...) res[usize, FormatError] {
    var s: Stage;
    stage(?s, filesystem.writer(filesystem.STDERR));
    ret settle(?s, format.vformat(?s.w, fmt, va...));
}

# formatted output to stdout followed by a newline
# ---
# fmt: format string (see std.format.vformat for hole syntax)
# va:  comptime variadic argument pack
# ret: bytes written, or the format's failure
pub fun printlnf(fmt: str, va: ...) res[usize, FormatError] {
    var s: Stage;
    stage(?s, filesystem.writer(filesystem.STDOUT));
    ret settle_line(?s, format.vformat(?s.w, fmt, va...));
}

# formatted output to stderr followed by a newline
# ---
# fmt: format string (see std.format.vformat for hole syntax)
# va:  comptime variadic argument pack
# ret: bytes written, or the format's failure
pub fun eprintlnf(fmt: str, va: ...) res[usize, FormatError] {
    var s: Stage;
    stage(?s, filesystem.writer(filesystem.STDERR));
    ret settle_line(?s, format.vformat(?s.w, fmt, va...));
}

# a sink that records how many times it was called and what it received, so a
# test can assert the syscall shape of a print call, not just its bytes
#[testing]
rec CallSink {
    data:  *u8;
    len:   usize;
    cap:   usize;
    calls: usize;
}

#[testing]
fun call_write(ctx: ptr, p: *u8, len: usize) res[usize, WriteError] {
    val cs: *CallSink = ctx::*CallSink;
    cs.calls = cs.calls + 1;
    var i: usize = 0;
    for (i < len) {
        if (cs.len >= cs.cap) { ret res[usize, WriteError].ok{i}; }
        cs.data[cs.len] = p[i];
        cs.len          = cs.len + 1;
        i               = i + 1;
    }
    ret res[usize, WriteError].ok{len};
}

#[testing]
fun call_sink(cs: *CallSink, storage: *u8, cap: usize) writer.Writer {
    cs.data  = storage;
    cs.len   = 0;
    cs.cap   = cap;
    cs.calls = 0;
    var w: writer.Writer;
    w.ctx      = cs::ptr;
    w.fn_write = call_write;
    ret w;
}

#[testing]
fun sunk(cs: *CallSink, want: str) bool {
    cs.data[cs.len] = 0;
    ret str_equals(cs.data::str, want);
}

# a format and a formatted line that fit the staging buffer each reach the sink
# in one call, and the reported count is the bytes the sink took
test print__staged_output_reaches_the_sink_once {
    var out: [1024]u8;
    var cs:  CallSink;

    var s: Stage;
    stage(?s, call_sink(?cs, ?out[0], 1024));
    val res_staged_format: res[usize, FormatError] = settle(?s, format.vformat(?s.w, "hello {}, {} and {:x}!\n", "world", 42::i64, 255::u64));
    if (sel res_staged_format.err)               { ret 1; }
    if (cs.calls != 1)                           { ret 2; }
    if (res_staged_format.ok != 24)              { ret 3; }
    if (!sunk(?cs, "hello world, 42 and ff!\n")) { ret 4; }

    stage(?s, call_sink(?cs, ?out[0], 1024));
    val res_fmt: res[usize, FormatError] = settle_line(?s, format.vformat(?s.w, "n={}", 7::i64));
    if (sel res_fmt.err)     { ret 5; }
    if (cs.calls != 1)       { ret 6; }
    if (res_fmt.ok != 4)     { ret 7; }
    if (!sunk(?cs, "n=7\n")) { ret 8; }
    ret 0;
}

# output past the staging buffer still arrives whole and in order, in the
# fewest calls the buffer allows
test print__output_larger_than_the_staging_buffer {
    var out:  [4096]u8;
    var want: [2048]u8;
    var cs:   CallSink;
    var s:    Stage;
    stage(?s, call_sink(?cs, ?out[0], 4096));

    var i: usize = 0;
    for (i < 1500) {
        want[i] = 'z';
        i       = i + 1;
    }
    want[1500] = 0;

    val res_staged_format: res[usize, FormatError] = settle(?s, format.vformat(?s.w, "<{}>\n", ?want[0]));
    if (sel res_staged_format.err)             { ret 1; }
    if (res_staged_format.ok != 1503)          { ret 2; }
    if (cs.len != 1503)                        { ret 3; }
    if (out[0] != '<')                         { ret 4; }
    if (out[1501] != '>' || out[1502] != '\n') { ret 5; }
    i = 1;
    for (i < 1501) {
        if (out[i] != 'z') { ret 6; }
        i = i + 1;
    }
    ret 0;
}

# a sink that refuses partway reports the bytes it actually took, not the bytes
# the staging buffer accepted
test print__staged_failure_reports_the_bytes_taken {
    var out: [16]u8;
    var cs:  CallSink;
    var s:   Stage;
    stage(?s, call_sink(?cs, ?out[0], 6));

    val res_staged_format: res[usize, FormatError] = settle(?s, format.vformat(?s.w, "abcdefghij {}", 1::i64));
    if (!sel res_staged_format.err)                         { ret 1; }
    if (!sel res_staged_format.err.write)                   { ret 2; }
    if (writer.persisted(res_staged_format.err.write) != 6) { ret 3; }
    if (cs.len != 6)                                        { ret 4; }
    if (!sunk(?cs, "abcdef"))                               { ret 5; }
    ret 0;
}

# a line and its newline reach the file whole, and the count is the bytes taken
test print__line_reaches_the_file_whole {
    var read_end:  usize = 0;
    var write_end: usize = 0;
    val piped:     i64   = os.pipe(?read_end, ?write_end);
    # a host with no pipes cannot run this
    if (os.error_kind(piped) == io_error.UNSUPPORTED) { ret 77; }
    if (piped < 0)                                    { ret 1; }
    var reading: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: read_end}};
    var writing: filesystem.File = filesystem.File{handle: io_handle.FileHandle{value: write_end}};
    fin {
        filesystem.close(?reading);
        filesystem.close(?writing);
    }

    val res_line: res[usize, WriteError] = write_text(writing, "plain text", true);
    if (sel res_line.err)  { ret 2; }
    if (res_line.ok != 11) { ret 3; }

    var received: [16]u8;
    val res_read: res[usize, io_error.Error] = filesystem.read(reading, ?received[0], 15);
    if (sel res_read.err)  { ret 4; }
    if (res_read.ok != 11) { ret 5; }
    received[11] = 0;
    if (!str_equals((?received[0])::str, "plain text\n")) { ret 6; }
    ret 0;
}
