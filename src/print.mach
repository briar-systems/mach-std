# formatted output to stdout/stderr
#
# convenience wrappers around std.format backed by filesystem stdout/stderr.
# checked printing stays checked: every function reports the writer's outcome,
# and the printf family adds the format string's failures on top.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.filesystem;
use std.format;
use std.format.FormatError;
use std.io.writer;
use std.io.writer.WriteError;

# staging capacity a printf-family call formats into before reaching the fd
#
# sized so a typical log or diagnostic line lands in one write. output larger
# than this still reaches the fd whole for the part that fills the buffer, and
# ordering is unaffected: the buffer lives on the call's stack frame and is
# drained before the call returns, so nothing is held across calls and stdout
# and stderr interleave exactly as unbuffered writes do.
val STAGE: usize = 512;

fun stdout_writer(w: *writer.Writer) {
    @w = filesystem.writer(filesystem.STDOUT);
}

fun stderr_writer(w: *writer.Writer) {
    @w = filesystem.writer(filesystem.STDERR);
}

# drain the staging buffer and report the bytes that actually reached the fd
# ---
# a byte count from the staging writer is provisional, so the call's outcome is
# restated against writer.pushed: a failure carries the true persisted prefix
# and a success reports the bytes the fd took.
fun settle(b: *writer.Buffered, outcome: res[usize, FormatError]) res[usize, FormatError] {
    val drained: err[WriteError] = writer.flush(b);
    val done:    usize           = writer.pushed(b);

    if (sel outcome.err) {
        if (sel outcome.err.write) {
            ret res[usize, FormatError].err{FormatError.write{writer.reprefix(outcome.err.write, done)}};
        }
        ret outcome;
    }
    if (sel drained.err) {
        ret res[usize, FormatError].err{FormatError.write{writer.reprefix(drained.err, done)}};
    }
    ret res[usize, FormatError].ok{done};
}

# the writer half of settle, for the calls that report a WriteError directly
fun settle_write(b: *writer.Buffered, outcome: res[usize, WriteError]) res[usize, WriteError] {
    val drained: err[WriteError] = writer.flush(b);
    val done:    usize           = writer.pushed(b);

    if (sel outcome.err) { ret res[usize, WriteError].err{writer.reprefix(outcome.err, done)}; }
    if (sel drained.err) { ret res[usize, WriteError].err{writer.reprefix(drained.err, done)}; }
    ret res[usize, WriteError].ok{done};
}

# write s and a newline to inner in one staged pass
fun staged_line(inner: *writer.Writer, s: str) res[usize, WriteError] {
    var storage: [STAGE]u8;
    var b:       writer.Buffered;
    var w:       writer.Writer = writer.buffered(?b, inner, ?storage[0], STAGE);
    ret settle_write(?b, write_line(?w, s));
}

# format the pack into inner in one staged pass
fun staged_format(inner: *writer.Writer, fmt: str, va: ...) res[usize, FormatError] {
    var storage: [STAGE]u8;
    var b:       writer.Buffered;
    var w:       writer.Writer = writer.buffered(?b, inner, ?storage[0], STAGE);
    ret settle(?b, format.vformat(?w, fmt, va...));
}

# format the pack and a newline into inner in one staged pass
fun staged_format_line(inner: *writer.Writer, fmt: str, va: ...) res[usize, FormatError] {
    var storage: [STAGE]u8;
    var b:       writer.Buffered;
    var w:       writer.Writer = writer.buffered(?b, inner, ?storage[0], STAGE);
    ret settle(?b, format_line(?w, fmt, va...));
}

# write s and a newline, reporting the persisted prefix across both
fun write_line(w: *writer.Writer, s: str) res[usize, WriteError] {
    val r1: res[usize, WriteError] = format.write_str(w, s);
    if (sel r1.err) { ret r1; }

    val r2: res[usize, WriteError] = format.write_newline(w);
    if (sel r2.err) { ret res[usize, WriteError].err{writer.advance(r2.err, r1.ok)}; }

    ret res[usize, WriteError].ok{r1.ok + r2.ok};
}

# format the pack and a newline, reporting the persisted prefix across both
fun format_line(w: *writer.Writer, fmt: str, va: ...) res[usize, FormatError] {
    val r1: res[usize, FormatError] = format.vformat(w, fmt, va...);
    if (sel r1.err) { ret r1; }

    val r2: res[usize, WriteError] = format.write_newline(w);
    if (sel r2.err) { ret res[usize, FormatError].err{FormatError.write{writer.advance(r2.err, r1.ok)}}; }

    ret res[usize, FormatError].ok{r1.ok + r2.ok};
}

# write s to stdout
# ---
# s:   string to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun print(s: str) res[usize, WriteError] {
    var w: writer.Writer;
    stdout_writer(?w);
    ret format.write_str(?w, s);
}

# write s followed by a newline to stdout
# ---
# s:   string to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun println(s: str) res[usize, WriteError] {
    var w: writer.Writer;
    stdout_writer(?w);
    ret staged_line(?w, s);
}

# write s to stderr
# ---
# s:   string to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun eprint(s: str) res[usize, WriteError] {
    var w: writer.Writer;
    stderr_writer(?w);
    ret format.write_str(?w, s);
}

# write s followed by a newline to stderr
# ---
# s:   string to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun eprintln(s: str) res[usize, WriteError] {
    var w: writer.Writer;
    stderr_writer(?w);
    ret staged_line(?w, s);
}

# write unsigned 64-bit integer to stdout
# ---
# n:   value to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun u64(n: u64) res[usize, WriteError] {
    var w: writer.Writer;
    stdout_writer(?w);
    ret format.write_u64(?w, n);
}

# write unsigned 64-bit integer to stderr
# ---
# n:   value to write
# ret: bytes written, or the writer's failure with the persisted prefix
pub fun eu64(n: u64) res[usize, WriteError] {
    var w: writer.Writer;
    stderr_writer(?w);
    ret format.write_u64(?w, n);
}

# formatted output to stdout
# ---
# fmt: format string (see std.format.vformat for hole syntax)
# va:  comptime variadic argument pack
# ret: bytes written, or the format's failure
pub fun printf(fmt: str, va: ...) res[usize, FormatError] {
    var w: writer.Writer;
    stdout_writer(?w);
    ret staged_format(?w, fmt, va...);
}

# formatted output to stderr
# ---
# fmt: format string (see std.format.vformat for hole syntax)
# va:  comptime variadic argument pack
# ret: bytes written, or the format's failure
pub fun eprintf(fmt: str, va: ...) res[usize, FormatError] {
    var w: writer.Writer;
    stderr_writer(?w);
    ret staged_format(?w, fmt, va...);
}

# formatted output to stdout followed by a newline
# ---
# fmt: format string (see std.format.vformat for hole syntax)
# va:  comptime variadic argument pack
# ret: bytes written, or the format's failure
pub fun printlnf(fmt: str, va: ...) res[usize, FormatError] {
    var w: writer.Writer;
    stdout_writer(?w);
    ret staged_format_line(?w, fmt, va...);
}

# formatted output to stderr followed by a newline
# ---
# fmt: format string (see std.format.vformat for hole syntax)
# va:  comptime variadic argument pack
# ret: bytes written, or the format's failure
pub fun eprintlnf(fmt: str, va: ...) res[usize, FormatError] {
    var w: writer.Writer;
    stderr_writer(?w);
    ret staged_format_line(?w, fmt, va...);
}

# smoke: a pack-tailed printf forwards its (empty) pack to vformat end-to-end on
# every target, writing nothing for an empty format.
test "printf: forwards pack to stdout" {
    val r: res[usize, FormatError] = printf("");
    if (sel r.err) { ret 1; }
    if (r.ok != 0) { ret 2; }
    ret 0;
}

# an empty print and println write nothing and one byte
test "print: empty strings" {
    val none: res[usize, WriteError] = print("");
    if (sel none.err) { ret 1; }
    if (none.ok != 0) { ret 2; }
    ret 0;
}

# a sink that records how many times it was called and what it received, so a
# test can assert the syscall shape of a print call, not just its bytes
rec CallSink {
    data:  *u8;
    len:   usize;
    cap:   usize;
    calls: usize;
}

fun call_write(ctx: ptr, p: *u8, len: usize) res[usize, WriteError] {
    val cs: *CallSink = ctx::*CallSink;
    cs.calls = cs.calls + 1;
    var i: usize = 0;
    for (i < len) {
        if (cs.len >= cs.cap) { ret res[usize, WriteError].ok{i}; }
        cs.data[cs.len] = p[i];
        cs.len          = cs.len + 1;
        i               = i + 1;
    }
    ret res[usize, WriteError].ok{len};
}

fun call_sink(cs: *CallSink, storage: *u8, cap: usize) writer.Writer {
    cs.data  = storage;
    cs.len   = 0;
    cs.cap   = cap;
    cs.calls = 0;
    var w: writer.Writer;
    w.ctx     = cs::ptr;
    w.f_write = call_write;
    ret w;
}

fun sunk(cs: *CallSink, want: str) bool {
    cs.data[cs.len] = 0;
    ret str_equals(cs.data::str, want);
}

# the acceptance criterion for per-call buffering: a format of literal text and
# scalar holes that fits the staging buffer reaches the sink exactly once, and
# the reported count is the bytes the sink took.
test "print: a staged format reaches the sink once" {
    var out: [1024]u8;
    var cs:  CallSink;
    var w:   writer.Writer = call_sink(?cs, ?out[0], 1024);

    val r: res[usize, FormatError] = staged_format(?w, "hello {}, {} and {:x}!\n", "world", 42::i64, 255::u64);
    if (sel r.err)                               { ret 1; }
    if (cs.calls != 1)                           { ret 2; }
    if (r.ok != 24)                              { ret 3; }
    if (!sunk(?cs, "hello world, 42 and ff!\n")) { ret 4; }
    ret 0;
}

# the newline-appending forms are one call too, where the unbuffered path took
# one per literal byte plus one for the newline
test "print: a staged line reaches the sink once" {
    var out: [1024]u8;
    var cs:  CallSink;

    var w:    writer.Writer          = call_sink(?cs, ?out[0], 1024);
    val line: res[usize, WriteError] = staged_line(?w, "plain text");
    if (sel line.err)               { ret 1; }
    if (cs.calls != 1)              { ret 2; }
    if (line.ok != 11)              { ret 3; }
    if (!sunk(?cs, "plain text\n")) { ret 4; }

    w = call_sink(?cs, ?out[0], 1024);
    val fmt: res[usize, FormatError] = staged_format_line(?w, "n={}", 7::i64);
    if (sel fmt.err)         { ret 5; }
    if (cs.calls != 1)       { ret 6; }
    if (fmt.ok != 4)         { ret 7; }
    if (!sunk(?cs, "n=7\n")) { ret 8; }
    ret 0;
}

# output past the staging buffer still arrives whole and in order, in the
# fewest calls the buffer allows
test "print: output larger than the staging buffer is byte-identical" {
    var out:  [4096]u8;
    var want: [2048]u8;
    var cs:   CallSink;
    var w:    writer.Writer = call_sink(?cs, ?out[0], 4096);

    var i: usize = 0;
    for (i < 1500) {
        want[i] = 'z';
        i       = i + 1;
    }
    want[1500] = 0;

    val r: res[usize, FormatError] = staged_format(?w, "<{}>\n", ?want[0]);
    if (sel r.err)                             { ret 1; }
    if (r.ok != 1503)                          { ret 2; }
    if (cs.len != 1503)                        { ret 3; }
    if (out[0] != '<')                         { ret 4; }
    if (out[1501] != '>' || out[1502] != '\n') { ret 5; }
    i = 1;
    for (i < 1501) {
        if (out[i] != 'z') { ret 6; }
        i = i + 1;
    }
    ret 0;
}

# a sink that refuses partway reports the bytes it actually took, not the bytes
# the staging buffer accepted
test "print: a staged format reports the bytes the sink took" {
    var out: [16]u8;
    var cs:  CallSink;
    var w:   writer.Writer = call_sink(?cs, ?out[0], 6);

    val r: res[usize, FormatError] = staged_format(?w, "abcdefghij {}", 1::i64);
    if (!sel r.err)                         { ret 1; }
    if (!sel r.err.write)                   { ret 2; }
    if (writer.persisted(r.err.write) != 6) { ret 3; }
    if (cs.len != 6)                        { ret 4; }
    if (!sunk(?cs, "abcdef"))               { ret 5; }
    ret 0;
}
