# repeating period-10 pattern used to recompute a large procedural fixture
# without embedding its expected output
val REPEAT_PAT: [10]u8 = [10]u8{
    0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6A
};

fun expected_repeat(i: usize) u8 {
    ret REPEAT_PAT[i % 10];
}

var obuf: [4096]u8;

fun check(comp: *u8, comp_len: usize, orig: *u8, orig_len: usize) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: res[usize, I.InflateError] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (sel r.err) { ret 1; }

    val n: usize = r.ok;
    if (n != orig_len) { ret 2; }

    var i: usize = 0;
    for (i < n) {
        if (obuf[i] != orig[i]) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

# verify a decompressed stream against a byte generator rather than an
# embedded array, and via the allocating API since the output is too large
# for obuf
fun gen_check_alloc(comp: *u8, comp_len: usize, orig_len: usize, gen: fun(usize) u8) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: res[V.Vector[u8], I.InflateError] = decompress_alloc(?a, comp, comp_len);
    if (sel r.err) { ret 1; }

    var v: V.Vector[u8] = r.ok;
    if (v.len != orig_len) { V.dnit[u8](?v); ret 2; }

    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] != gen(i)) { V.dnit[u8](?v); ret 3; }
        i = i + 1;
    }

    V.dnit[u8](?v);
    ret 0;
}

# drive the streaming API with small, awkward chunk sizes so decoding must
# suspend and resume mid-symbol, mid-match, and across the header and trailer
fun stream_check(comp: *u8, comp_len: usize, in_chunk: usize, out_chunk: usize, orig: *u8, orig_len: usize) i32 {
    var a: A.Allocator;
    page.make(?a);

    val ri: res[Decompressor, I.InflateError] = init(?a);
    if (sel ri.err) { ret 1; }
    var z: Decompressor = ri.ok;

    var in_off:  usize = 0;
    var out_off: usize = 0;
    var guard:   usize = 0;

    for (guard < 200000 && !is_done(?z)) {
        guard = guard + 1;

        var feed: usize = in_chunk;
        if (in_off + feed > comp_len) { feed = comp_len - in_off; }

        var room: usize = out_chunk;
        if (out_off + room > 4096) { room = 4096 - out_off; }

        val r: res[I.Progress, I.InflateError] = decompress(?z, ?comp[in_off], feed, ?obuf[out_off], room);
        if (sel r.err) { dnit(?z); ret 2; }

        val p: I.Progress = r.ok;
        in_off  = in_off + p.consumed;
        out_off = out_off + p.written;

        if (p.status == I.NEED_INPUT && in_off >= comp_len) { dnit(?z); ret 3; }
    }

    val f: err[I.InflateError] = finish(?z);
    dnit(?z);
    if (sel f.err) { ret 4; }
    if (in_off != comp_len)  { ret 5; }
    if (out_off != orig_len) { ret 6; }

    var i: usize = 0;
    for (i < out_off) {
        if (obuf[i] != orig[i]) { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test "zlib: round trip at level 0 (stored)" {
    ret check(?C_Z_L0[0], 53, ?D_Z_MSG[0], 42);
}

test "zlib: round trip at level 1" {
    ret check(?C_Z_L1[0], 45, ?D_Z_MSG[0], 42);
}

test "zlib: round trip at level 6" {
    ret check(?C_Z_L6[0], 45, ?D_Z_MSG[0], 42);
}

test "zlib: round trip at level 9" {
    ret check(?C_Z_L9[0], 44, ?D_Z_MSG[0], 42);
}

test "zlib: exactly-sized output reaches the trailer" {
    var a: A.Allocator;
    page.make(?a);

    val r: res[usize, I.InflateError] = decompress_into(?a, ?C_Z_L6[0], 45, ?obuf[0], 42);
    if (sel r.err) { ret 1; }
    if (r.ok != 42) { ret 2; }
    ret 0;
}

val C_Z_EMPTY: [8]u8 = [8]u8{
    0x78, 0x9C, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01
};

test "zlib: empty stream fits a zero-length output buffer" {
    var a: A.Allocator;
    page.make(?a);

    val r: res[usize, I.InflateError] = decompress_into(?a, ?C_Z_EMPTY[0], 8, ?obuf[0], 0);
    if (sel r.err) { ret 1; }
    if (r.ok != 0) { ret 2; }
    ret 0;
}

test "zlib: large repetitive stream round trip" {
    ret gen_check_alloc(?C_Z_LARGE[0], 90, 10000, expected_repeat);
}

test "zlib: streaming with 3-byte input and 5-byte output chunks" {
    ret stream_check(?C_Z_STREAM[0], 43, 3, 5, ?D_Z_STREAM[0], 280);
}

val N_Z_BAD_ADLER: [42]u8 = [42]u8{
    0x78, 0x9C, 0xAB, 0xCA, 0xC9, 0x4C, 0x52, 0x28, 0x2F, 0x4A, 0x2C, 0x28, 0x48, 0x2D, 0x52, 0xC8,
    0x4B, 0x4D, 0x4F, 0x2C, 0xC9, 0x2C, 0x4B, 0x55, 0x48, 0x4E, 0x2C, 0x4E, 0x55, 0x28, 0x48, 0xAC,
    0xCC, 0xC9, 0x4F, 0x4C, 0x01, 0x00, 0xE5, 0x59, 0x0D, 0xF3
};
val N_Z_BAD_METHOD: [42]u8 = [42]u8{
    0x77, 0x09, 0xAB, 0xCA, 0xC9, 0x4C, 0x52, 0x28, 0x2F, 0x4A, 0x2C, 0x28, 0x48, 0x2D, 0x52, 0xC8,
    0x4B, 0x4D, 0x4F, 0x2C, 0xC9, 0x2C, 0x4B, 0x55, 0x48, 0x4E, 0x2C, 0x4E, 0x55, 0x28, 0x48, 0xAC,
    0xCC, 0xC9, 0x4F, 0x4C, 0x01, 0x00, 0xE5, 0x59, 0x0D, 0x0C
};
val N_Z_BAD_CHECK: [42]u8 = [42]u8{
    0x78, 0x9D, 0xAB, 0xCA, 0xC9, 0x4C, 0x52, 0x28, 0x2F, 0x4A, 0x2C, 0x28, 0x48, 0x2D, 0x52, 0xC8,
    0x4B, 0x4D, 0x4F, 0x2C, 0xC9, 0x2C, 0x4B, 0x55, 0x48, 0x4E, 0x2C, 0x4E, 0x55, 0x28, 0x48, 0xAC,
    0xCC, 0xC9, 0x4F, 0x4C, 0x01, 0x00, 0xE5, 0x59, 0x0D, 0x0C
