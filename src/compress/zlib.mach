    0x78, 0x9C, 0xAB, 0xCA, 0xC9, 0x4C, 0x52, 0x28, 0x2F, 0x4A, 0x2C, 0x28, 0x48, 0x2D, 0x52, 0xC8,
    0x4B, 0x4D, 0x4F, 0x2C, 0xC9, 0x2C, 0x4B, 0x55, 0x48, 0x4E, 0x2C, 0x4E, 0x55, 0x28, 0x48, 0xAC,
    0xCC, 0xC9, 0x4F, 0x4C
};

fun defect_code(d: I.Defect) u8 {
    var x: I.Defect = d;
    val p: *u8 = (?x)::*u8;
    ret p[0];
}

# a malformed stream must be refused, and refused for the stated defect
fun rejects(comp: *u8, comp_len: usize, want: I.Defect) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: res[usize, I.InflateError] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (!sel r.err) { ret 1; }
    if (!sel r.err.malformed) { ret 2; }
    if (defect_code(r.err.malformed.defect) != defect_code(want)) { ret 3; }
    ret 0;
}

# a stream that ends early is truncated, with every input byte consumed
fun rejects_truncated(comp: *u8, comp_len: usize) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: res[usize, I.InflateError] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (!sel r.err) { ret 1; }
    if (!sel r.err.truncated) { ret 2; }
    if (r.err.truncated.consumed != comp_len) { ret 3; }
    ret 0;
}
test "zlib: corrupt adler32 trailer is rejected" {
    ret rejects(?N_Z_BAD_ADLER[0], 42, I.Defect.checksum{});
}
test "zlib: compression method that is not deflate is rejected" {
    ret rejects(?N_Z_BAD_METHOD[0], 42, I.Defect.method{});
}
test "zlib: bad header check value is rejected" {
    ret rejects(?N_Z_BAD_CHECK[0], 42, I.Defect.header_check{});
}
test "zlib: preset dictionary flag is rejected" {
    ret rejects(?N_Z_PRESET_DICT[0], 46, I.Defect.dictionary{});
}
test "zlib: stream cut before its trailer is rejected" {
    ret rejects_truncated(?N_Z_TRUNC[0], 36);
}

var scratch: [32768]u8;

# freestanding callers carve the window out of their own buffer rather than
# reaching an OS-backed allocator; mach-image decodes PNG this way
test "zlib: decodes with a fixed-buffer allocator and no OS involvement" {
    var st: fixed.FixedState;
    var a:  A.Allocator;
    fixed.make(?a, ?st, ?scratch[0], I.WINDOW);

    val r: res[usize, I.InflateError] = decompress_into(?a, ?C_Z_L6[0], 45, ?obuf[0], 4096);
    if (sel r.err) { ret 1; }

    val n: usize = r.ok;
    if (n != 42) { ret 2; }

    var i: usize = 0;
    for (i < n) {
        if (obuf[i] != D_Z_MSG[i]) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

# so the scratch requirement is exactly inflate.WINDOW, not merely at least it
test "zlib: scratch one byte short of the window is refused" {
    var st: fixed.FixedState;
    var a:  A.Allocator;
    fixed.make(?a, ?st, ?scratch[0], I.WINDOW - 1);

    val r: res[usize, I.InflateError] = decompress_into(?a, ?C_Z_L6[0], 45, ?obuf[0], 4096);
    if (!sel r.err) { ret 1; }
    ret 0;
}

# the window and the output vector are the two acquisitions: each refused in
# turn is alloc, nothing leaks, and the failure names the allocator's refusal
test "zlib: allocation refusal at the window and the output vector is alloc" {
    var ordinal: usize = 1;
    for (ordinal <= 8) {
        var tracker: testing.Testing;
        val made: err[A.Error] = testing.make(?tracker);
        if (sel made.err) { ret 1; }
        testing.fail_at_ordinal(?tracker, ordinal);
        val r: res[V.Vector[u8], I.InflateError] = decompress_alloc(testing.allocator_of(?tracker), ?C_Z_LARGE[0], 90);
        var accepted: bool = false;
        if (sel r.err) {
            if (!sel r.err.alloc) { testing.dnit(?tracker); ret 2; }
            if (!sel r.err.alloc.exhausted) { testing.dnit(?tracker); ret 3; }
        }
        if (sel r.ok) {
            var out: V.Vector[u8] = r.ok;
            accepted = out.len == 10000;
            V.dnit[u8](?out);
        }
        val leaked: bool = testing.live_count(?tracker) != 0 || testing.double_free_count(?tracker) != 0;
        val attempts: usize = testing.attempt_count(?tracker);
        testing.dnit(?tracker);
        if (leaked) { ret 4; }
        if (accepted) { if (attempts >= ordinal || ordinal < 3) { ret 5; } ret 0; }
        if (attempts != ordinal) { ret 6; }
        ordinal = ordinal + 1;
    }
    ret 7;
}

# a failure after progress carries what the call committed: the corrupt
# trailer is met only after the whole 34-byte body was decoded and written
test "zlib: a failure after progress carries the committed counts" {
    var a: A.Allocator;
    page.make(?a);
    val r: res[usize, I.InflateError] = decompress_into(?a, ?N_Z_BAD_ADLER[0], 42, ?obuf[0], 4096);
    if (!sel r.err) { ret 1; }
    if (!sel r.err.malformed) { ret 2; }
    if (r.err.malformed.consumed != 42) { ret 3; }
    if (r.err.malformed.written != 34) { ret 4; }

    val small: res[usize, I.InflateError] = decompress_into(?a, ?C_Z_L6[0], 45, ?obuf[0], 10);
    if (!sel small.err) { ret 5; }
    if (!sel small.err.full) { ret 6; }
    if (small.err.full.written != 10) { ret 7; }
    ret 0;
}
