# zlib stream decompression (RFC 1950)
#
# a zlib stream is a two-byte header, a raw deflate stream, and a big-endian
# adler32 of the decompressed bytes. this wraps std.compress.inflate with that
# framing and verifies the checksum, so a mismatch is reported rather than
# silently returning corrupt output.
#
# preset dictionaries (the FDICT header flag) are rejected; no caller in std
# produces them and honouring one would require a dictionary channel in the API.
# Progress, its status constants, WINDOW and the InflateError family are
# re-exported from inflate so a caller needs only this module to drive a
# stream, size its scratch storage and read its outcome.

use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use V: std.collections.vector;
use I: std.compress.inflate;
use std.allocator.page;
use std.allocator.fixed;
use std.allocator.testing;
use std.crypto.hash.adler32;

fwd I.Progress;
fwd I.Status;
fwd I.NEED_INPUT;
fwd I.OUTPUT_FULL;
fwd I.DONE;
fwd I.WINDOW;
fwd I.InflateError;
fwd I.Defect;
fwd I.Fault;
fwd I.Committed;

val W_HEAD:    u8 = 0;
val W_DATA:    u8 = 1;
val W_TRAILER: u8 = 2;
val W_DONE:    u8 = 3;

# streaming zlib decoder state
#
# create with init, drive with decompress, confirm with finish, release with
# dnit. all fields are internal; the surface is the functions below.
pub rec Decompressor {
    inf:   I.Inflater;
    state: u8;
    have:  usize;
    buf:   [4]u8;
    adler: u32;
}

fun progress(st: I.Status, consumed: usize, written: usize) res[I.Progress, I.InflateError] {
    var p: I.Progress;
    p.status   = st;
    p.consumed = consumed;
    p.written  = written;
    ret res[I.Progress, I.InflateError].ok{p};
}

fun fault(defect: I.Defect, consumed: usize, written: usize) res[I.Progress, I.InflateError] {
    ret res[I.Progress, I.InflateError].err{I.malformed(defect, consumed, written)};
}

# reset the decoder to the start of a new stream, keeping the window allocation
# ---
# z: decoder to reset
pub fun reset(z: *Decompressor) {
    I.reset(?z.inf);
    z.state = W_HEAD;
    z.have  = 0;
    z.adler = adler32.init();
}

# create a decoder, allocating the inflater's window from a
# ---
# a:   allocator used for the window and nothing else
# ret: a ready decoder, or the allocator's refusal of the window
pub fun init(a: *A.Allocator) res[Decompressor, I.InflateError] {
    val ri: res[I.Inflater, I.InflateError] = I.init(a);
    if (sel ri.err) { ret res[Decompressor, I.InflateError].err{ri.err}; }

    var z: Decompressor;
    z.inf = ri.ok;
    reset(?z);

    ret res[Decompressor, I.InflateError].ok{z};
}

# release the inflater's window
# ---
# z:   decoder to deinitialize
# ret: ok, or the allocator's refusal
pub fun dnit(z: *Decompressor) err[A.Error] {
    ret I.dnit(?z.inf);
}

# check whether the stream finished and its checksum verified
# ---
# z:   decoder to query
# ret: true once the trailer has been read and matched
pub fun is_done(z: *Decompressor) bool {
    if (z == nil) { ret false; }
    ret z.state == W_DONE;
}

# confirm the stream ended rather than simply running out of input
# ---
# z:   decoder to check
# ret: ok if the stream completed, or truncated
pub fun finish(z: *Decompressor) err[I.InflateError] {
    if (z.inf.win == nil) { ret err[I.InflateError].err{I.InflateError.closed{}}; }
    if (z.state != W_DONE) { ret err[I.InflateError].err{I.truncated(0, 0)}; }
    ret err[I.InflateError].ok{};
}

# decode as much as src and dst allow
#
# returns when src runs out (NEED_INPUT), dst fills (OUTPUT_FULL), or the stream
# ends and its adler32 matches (DONE). advance src by consumed and dst by
# written, then call again.
# ---
# z:       decoder created by init
# src:     next chunk of the zlib stream
# src_len: length of that chunk
# dst:     where decompressed bytes go
# dst_len: space available at dst
# ret:     what the call accomplished, or the failure with the counts this
#          call committed before it
pub fun decompress(z: *Decompressor, src: *u8, src_len: usize, dst: *u8, dst_len: usize) res[I.Progress, I.InflateError] {
    if (z.inf.win == nil) { ret res[I.Progress, I.InflateError].err{I.InflateError.closed{}}; }

    var consumed: usize = 0;
    var written:  usize = 0;

    if (z.state == W_HEAD) {
        for (z.have < 2 && consumed < src_len) {
            z.buf[z.have] = src[consumed];
            z.have   = z.have + 1;
            consumed = consumed + 1;
        }
        if (z.have < 2) { ret progress(I.NEED_INPUT, consumed, 0); }

        val cmf: u32 = z.buf[0]::u32;
        val flg: u32 = z.buf[1]::u32;

        if ((cmf & 0x0F) != 8) { ret fault(I.Defect.method{}, consumed, 0); }
        if (((cmf >> 4) & 0x0F) > 7) { ret fault(I.Defect.window{}, consumed, 0); }
        if ((cmf * 256 + flg) % 31 != 0) { ret fault(I.Defect.header_check{}, consumed, 0); }
        if ((flg & 0x20) != 0) { ret fault(I.Defect.dictionary{}, consumed, 0); }

        z.state = W_DATA;
        z.have  = 0;
    }

    if (z.state == W_DATA) {
        val r: res[I.Progress, I.InflateError] = I.decompress(?z.inf, ?src[consumed], src_len - consumed, dst, dst_len);
        if (sel r.err) { ret res[I.Progress, I.InflateError].err{I.advance(r.err, consumed, 0)}; }

        val p: I.Progress = r.ok;
        consumed = consumed + p.consumed;
        written  = p.written;
        z.adler  = adler32.update(z.adler, dst, written);

        if (p.status != I.DONE) { ret progress(p.status, consumed, written); }

        # the trailer is byte-aligned and the inflater reads ahead, so some of
        # it may already be sitting in its bit buffer
        I.align_to_byte(?z.inf);
        z.state = W_TRAILER;
        z.have  = 0;
    }

    if (z.state == W_TRAILER) {
        for (z.have < 4 && I.buffered_bytes(?z.inf) > 0) {
            z.buf[z.have] = I.pop_buffered(?z.inf);
            z.have = z.have + 1;
        }
        for (z.have < 4 && consumed < src_len) {
            z.buf[z.have] = src[consumed];
            z.have   = z.have + 1;
            consumed = consumed + 1;
        }
        if (z.have < 4) { ret progress(I.NEED_INPUT, consumed, written); }

        val want: u32 = (z.buf[0]::u32 << 24) | (z.buf[1]::u32 << 16)
                      | (z.buf[2]::u32 << 8)  |  z.buf[3]::u32;
        if (want != z.adler) { ret fault(I.Defect.checksum{}, consumed, written); }

        z.state = W_DONE;
    }

    ret progress(I.DONE, consumed, written);
}

fun drive(z: *Decompressor, src: *u8, src_len: usize, dst: *u8, dst_len: usize) res[usize, I.InflateError] {
    var in_off:  usize = 0;
    var out_off: usize = 0;

    for (!is_done(z)) {
        val r: res[I.Progress, I.InflateError] = decompress(z, ?src[in_off], src_len - in_off,
                                                              ?dst[out_off], dst_len - out_off);
        if (sel r.err) { ret res[usize, I.InflateError].err{I.advance(r.err, in_off, out_off)}; }

        val p: I.Progress = r.ok;
        in_off  = in_off + p.consumed;
        out_off = out_off + p.written;

        if (p.status == I.OUTPUT_FULL) {
            ret res[usize, I.InflateError].err{I.InflateError.full{I.Committed{consumed: in_off, written: out_off}}};
        }
        if (p.status == I.NEED_INPUT && in_off >= src_len) {
            ret res[usize, I.InflateError].err{I.truncated(in_off, out_off)};
        }
    }

    ret res[usize, I.InflateError].ok{out_off};
}

# decompress a whole zlib stream into a caller-provided buffer
# ---
# a:       allocator for the decoder's window
# src:     the complete zlib stream
# src_len: length of that stream
# dst:     where decompressed bytes go
# dst_len: space available at dst
# ret:     bytes written, or the failure; malformed, truncated and full carry
#          the counts committed over the whole call
pub fun decompress_into(a: *A.Allocator, src: *u8, src_len: usize, dst: *u8, dst_len: usize) res[usize, I.InflateError] {
    val ri: res[Decompressor, I.InflateError] = init(a);
    if (sel ri.err) { ret res[usize, I.InflateError].err{ri.err}; }

    var z: Decompressor = ri.ok;
    val out: res[usize, I.InflateError] = drive(?z, src, src_len, dst, dst_len);
    dnit(?z);

    ret out;
}

fun grow(z: *Decompressor, out: *V.Vector[u8], src: *u8, src_len: usize) res[usize, I.InflateError] {
    var in_off: usize = 0;

    for (!is_done(z)) {
        if (out.len == out.cap) {
            var next: usize = out.cap * 2;
            if (next < 4096) { next = 4096; }

            val e: res[usize, A.Error] = V.ensure[u8](out, next);
            if (sel e.err) { ret res[usize, I.InflateError].err{I.InflateError.alloc{e.err}}; }
        }

        val r: res[I.Progress, I.InflateError] = decompress(z, ?src[in_off], src_len - in_off,
                                                              ?out.data[out.len], out.cap - out.len);
        if (sel r.err) { ret res[usize, I.InflateError].err{I.advance(r.err, in_off, out.len)}; }

        val p: I.Progress = r.ok;
        in_off  = in_off + p.consumed;
        out.len = out.len + p.written;

        if (p.status == I.NEED_INPUT && in_off >= src_len) {
            ret res[usize, I.InflateError].err{I.truncated(in_off, out.len)};
        }
    }

    ret res[usize, I.InflateError].ok{out.len};
}

# decompress a whole zlib stream into a vector that grows as needed
# ---
# a:       allocator for the decoder's window and the output vector
# src:     the complete zlib stream
# src_len: length of that stream
# ret:     a vector owning the decompressed bytes, which the caller must dnit,
#          or the failure; on failure the vector is already released
pub fun decompress_alloc(a: *A.Allocator, src: *u8, src_len: usize) res[V.Vector[u8], I.InflateError] {
    val ri: res[Decompressor, I.InflateError] = init(a);
    if (sel ri.err) { ret res[V.Vector[u8], I.InflateError].err{ri.err}; }

    var z: Decompressor = ri.ok;
    var out: V.Vector[u8] = V.init[u8](a);

    val grown: res[usize, I.InflateError] = grow(?z, ?out, src, src_len);
    dnit(?z);

    if (sel grown.err) {
        V.dnit[u8](?out);
        ret res[V.Vector[u8], I.InflateError].err{grown.err};
    }

    ret res[V.Vector[u8], I.InflateError].ok{out};
}

