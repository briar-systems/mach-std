# zlib stream decompression (RFC 1950)
#
# a zlib stream is a two-byte header, a raw deflate stream, and a big-endian
# adler32 of the decompressed bytes. this wraps std.compress.inflate with that
# framing and verifies the checksum, so a mismatch is reported rather than
# silently returning corrupt output.
#
# preset dictionaries (the FDICT header flag) are rejected; no caller in std
# produces them and honouring one would require a dictionary channel in the API.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use R: std.types.result;
use V: std.collections.vector;
use I: std.compress.inflate;
use std.allocator.page;
use std.crypto.hash.adler32;

fwd I.Progress;
fwd I.Status;
fwd I.NEED_INPUT;
fwd I.OUTPUT_FULL;
fwd I.DONE;

val W_HEAD:    u8 = 0;
val W_DATA:    u8 = 1;
val W_TRAILER: u8 = 2;
val W_DONE:    u8 = 3;

# streaming zlib decoder state
#
# create with init, drive with decompress, confirm with finish, release with
# dnit. all fields are internal; the surface is the functions below.
pub rec Decompressor {
    inf:   I.Inflater;
    state: u8;
    have:  usize;
    buf:   [4]u8;
    adler: u32;
}

fun progress(st: I.Status, consumed: usize, written: usize) R.Result[I.Progress, str] {
    var p: I.Progress;
    p.status   = st;
    p.consumed = consumed;
    p.written  = written;
    ret R.ok[I.Progress, str](p);
}

# reset the decoder to the start of a new stream, keeping the window allocation
# ---
# z: decoder to reset
pub fun reset(z: *Decompressor) {
    if (z == nil) { ret; }

    I.reset(?z.inf);
    z.state = W_HEAD;
    z.have  = 0;
    z.adler = adler32.init();
}

# create a decoder, allocating the inflater's window from a
# ---
# a:   allocator used for the window and nothing else
# ret: a ready decoder, or an error if the window could not be allocated
pub fun init(a: *A.Allocator) R.Result[Decompressor, str] {
    val ri: R.Result[I.Inflater, str] = I.init(a);
    if (R.is_err[I.Inflater, str](ri)) {
        ret R.err[Decompressor, str](R.unwrap_err[I.Inflater, str](ri));
    }

    var z: Decompressor;
    z.inf = R.unwrap_ok[I.Inflater, str](ri);
    reset(?z);

    ret R.ok[Decompressor, str](z);
}

# release the inflater's window
# ---
# z:   decoder to deinitialize
# ret: true if the window was released
pub fun dnit(z: *Decompressor) bool {
    if (z == nil) { ret true; }
    ret I.dnit(?z.inf);
}

# check whether the stream finished and its checksum verified
# ---
# z:   decoder to query
# ret: true once the trailer has been read and matched
pub fun is_done(z: *Decompressor) bool {
    if (z == nil) { ret false; }
    ret z.state == W_DONE;
}

# confirm the stream ended rather than simply running out of input
# ---
# z:   decoder to check
# ret: true if the stream completed, or an error describing why it did not
pub fun finish(z: *Decompressor) R.Result[bool, str] {
    if (z == nil) { ret R.err[bool, str]("decompressor is nil"); }
    if (z.state != W_DONE) { ret R.err[bool, str]("truncated zlib stream"); }
    ret R.ok[bool, str](true);
}

# decode as much as src and dst allow
#
# returns when src runs out (NEED_INPUT), dst fills (OUTPUT_FULL), or the stream
# ends and its adler32 matches (DONE). advance src by consumed and dst by
# written, then call again.
# ---
# z:       decoder created by init
# src:     next chunk of the zlib stream
# src_len: length of that chunk
# dst:     where decompressed bytes go
# dst_len: space available at dst
# ret:     what the call accomplished, or an error describing the malformed stream
pub fun decompress(z: *Decompressor, src: *u8, src_len: usize, dst: *u8, dst_len: usize) R.Result[I.Progress, str] {
    if (z == nil) { ret R.err[I.Progress, str]("decompressor is nil"); }

    var consumed: usize = 0;
    var written:  usize = 0;

    if (z.state == W_HEAD) {
        for (z.have < 2 && consumed < src_len) {
            z.buf[z.have] = src[consumed];
            z.have   = z.have + 1;
            consumed = consumed + 1;
        }
        if (z.have < 2) { ret progress(I.NEED_INPUT, consumed, 0); }

        val cmf: u32 = z.buf[0]::u32;
        val flg: u32 = z.buf[1]::u32;

        if ((cmf & 0x0F) != 8) {
            ret R.err[I.Progress, str]("zlib compression method is not deflate");
        }
        if (((cmf >> 4) & 0x0F) > 7) {
            ret R.err[I.Progress, str]("zlib window size exceeds 32 KiB");
        }
        if ((cmf * 256 + flg) % 31 != 0) {
            ret R.err[I.Progress, str]("zlib header check failed");
        }
        if ((flg & 0x20) != 0) {
            ret R.err[I.Progress, str]("zlib preset dictionary is not supported");
        }

        z.state = W_DATA;
        z.have  = 0;
    }

    if (z.state == W_DATA) {
        val r: R.Result[I.Progress, str] = I.decompress(?z.inf, ?src[consumed], src_len - consumed, dst, dst_len);
        if (R.is_err[I.Progress, str](r)) { ret r; }

        val p: I.Progress = R.unwrap_ok[I.Progress, str](r);
        consumed = consumed + p.consumed;
        written  = p.written;
        z.adler  = adler32.update(z.adler, dst, written);

        if (p.status != I.DONE) { ret progress(p.status, consumed, written); }

        # the trailer is byte-aligned and the inflater reads ahead, so some of
        # it may already be sitting in its bit buffer
        I.align_to_byte(?z.inf);
        z.state = W_TRAILER;
        z.have  = 0;
    }

    if (z.state == W_TRAILER) {
        for (z.have < 4 && I.buffered_bytes(?z.inf) > 0) {
            z.buf[z.have] = I.pop_buffered(?z.inf);
            z.have = z.have + 1;
        }
        for (z.have < 4 && consumed < src_len) {
            z.buf[z.have] = src[consumed];
            z.have   = z.have + 1;
            consumed = consumed + 1;
        }
        if (z.have < 4) { ret progress(I.NEED_INPUT, consumed, written); }

        val want: u32 = (z.buf[0]::u32 << 24) | (z.buf[1]::u32 << 16)
                      | (z.buf[2]::u32 << 8)  |  z.buf[3]::u32;
        if (want != z.adler) {
            ret R.err[I.Progress, str]("zlib checksum mismatch");
        }

        z.state = W_DONE;
    }

    ret progress(I.DONE, consumed, written);
}

fun drive(z: *Decompressor, src: *u8, src_len: usize, dst: *u8, dst_len: usize) R.Result[usize, str] {
    var in_off:  usize = 0;
    var out_off: usize = 0;

    for (!is_done(z)) {
        val r: R.Result[I.Progress, str] = decompress(z, ?src[in_off], src_len - in_off,
                                                         ?dst[out_off], dst_len - out_off);
        if (R.is_err[I.Progress, str](r)) {
            ret R.err[usize, str](R.unwrap_err[I.Progress, str](r));
        }

        val p: I.Progress = R.unwrap_ok[I.Progress, str](r);
        in_off  = in_off + p.consumed;
        out_off = out_off + p.written;

        if (p.status == I.OUTPUT_FULL) { ret R.err[usize, str]("output buffer too small"); }
        if (p.status == I.NEED_INPUT && in_off >= src_len) {
            ret R.err[usize, str]("truncated zlib stream");
        }
    }

    ret R.ok[usize, str](out_off);
}

# decompress a whole zlib stream into a caller-provided buffer
# ---
# a:       allocator for the decoder's window
# src:     the complete zlib stream
# src_len: length of that stream
# dst:     where decompressed bytes go
# dst_len: space available at dst
# ret:     bytes written, or an error if the stream is malformed or does not fit
pub fun decompress_into(a: *A.Allocator, src: *u8, src_len: usize, dst: *u8, dst_len: usize) R.Result[usize, str] {
    val ri: R.Result[Decompressor, str] = init(a);
    if (R.is_err[Decompressor, str](ri)) {
        ret R.err[usize, str](R.unwrap_err[Decompressor, str](ri));
    }

    var z: Decompressor = R.unwrap_ok[Decompressor, str](ri);
    val out: R.Result[usize, str] = drive(?z, src, src_len, dst, dst_len);
    dnit(?z);

    ret out;
}

fun grow(z: *Decompressor, out: *V.Vector[u8], src: *u8, src_len: usize) R.Result[usize, str] {
    var in_off: usize = 0;

    for (!is_done(z)) {
        if (out.len == out.cap) {
            var next: usize = out.cap * 2;
            if (next < 4096) { next = 4096; }

            val e: R.Result[usize, str] = V.ensure[u8](out, next);
            if (R.is_err[usize, str](e)) { ret e; }
        }

        val r: R.Result[I.Progress, str] = decompress(z, ?src[in_off], src_len - in_off,
                                                         ?out.data[out.len], out.cap - out.len);
        if (R.is_err[I.Progress, str](r)) {
            ret R.err[usize, str](R.unwrap_err[I.Progress, str](r));
        }

        val p: I.Progress = R.unwrap_ok[I.Progress, str](r);
        in_off  = in_off + p.consumed;
        out.len = out.len + p.written;

        if (p.status == I.NEED_INPUT && in_off >= src_len) {
            ret R.err[usize, str]("truncated zlib stream");
        }
    }

    ret R.ok[usize, str](out.len);
}

# decompress a whole zlib stream into a vector that grows as needed
# ---
# a:       allocator for the decoder's window and the output vector
# src:     the complete zlib stream
# src_len: length of that stream
# ret:     a vector owning the decompressed bytes, which the caller must dnit,
#          or an error if the stream is malformed
pub fun decompress_alloc(a: *A.Allocator, src: *u8, src_len: usize) R.Result[V.Vector[u8], str] {
    val ri: R.Result[Decompressor, str] = init(a);
    if (R.is_err[Decompressor, str](ri)) {
        ret R.err[V.Vector[u8], str](R.unwrap_err[Decompressor, str](ri));
    }

    var z: Decompressor = R.unwrap_ok[Decompressor, str](ri);
    var out: V.Vector[u8] = V.init[u8](a);

    val res: R.Result[usize, str] = grow(?z, ?out, src, src_len);
    dnit(?z);

    if (R.is_err[usize, str](res)) {
        V.dnit[u8](?out);
        ret R.err[V.Vector[u8], str](R.unwrap_err[usize, str](res));
    }

    ret R.ok[V.Vector[u8], str](out);
}

