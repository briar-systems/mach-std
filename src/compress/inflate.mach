    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};
val N_INCOMPLETE_LITLEN: [42]u8 = [42]u8{
    0x05, 0xE0, 0x01, 0x04, 0x00, 0x00, 0x00, 0x40, 0x00, 0x0C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};
val N_TOO_MANY_LIT: [10]u8 = [10]u8{
    0xFD, 0xE0, 0x01, 0x04, 0x00, 0x00, 0x00, 0x00, 0x10, 0x00
};
val N_REPEAT_NO_PREV: [10]u8 = [10]u8{
    0x05, 0xE0, 0x03, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04
};
val N_TRUNC_DYNAMIC: [27]u8 = [27]u8{
    0x2B, 0xC9, 0x48, 0x55, 0x28, 0x2C, 0xCD, 0x4C, 0xCE, 0x56, 0x48, 0x2A, 0xCA, 0x2F, 0xCF, 0x53,
    0x48, 0xCB, 0xAF, 0x50, 0xC8, 0x2A, 0xCD, 0x2D, 0x28, 0x56, 0xC8
};

# a malformed stream must be refused, and refused for the stated reason
fun rejects(comp: *u8, comp_len: usize, want: str) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[usize, str] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (!R.is_err[usize, str](r)) { ret 1; }
    if (!str_equals(R.unwrap_err[usize, str](r), want)) { ret 2; }
    ret 0;
}
test "inflate: reserved block type 3 is rejected" {
    ret rejects(?N_BAD_BTYPE[0], 1, "invalid deflate block type");
}
test "inflate: stored block with a bad length check is rejected" {
    ret rejects(?N_BAD_STORED_NLEN[0], 10, "stored block length check failed");
}
test "inflate: stored block cut short is rejected" {
    ret rejects(?N_TRUNC_STORED[0], 8, "truncated deflate stream");
}
test "inflate: distance reaching before the stream is rejected" {
    ret rejects(?N_DIST_TOO_FAR[0], 4, "distance reaches past the start of the window");
}
test "inflate: unassigned distance symbol 30 is rejected" {
    ret rejects(?N_BAD_DIST_CODE[0], 5, "invalid distance code");
}
test "inflate: over-subscribed code length code is rejected" {
    ret rejects(?N_OVERSUB_CLEN[0], 10, "invalid code length code set");
}
test "inflate: over-subscribed literal/length code is rejected" {
    ret rejects(?N_OVERSUB_LITLEN[0], 42, "over-subscribed literal/length code");
}
test "inflate: incomplete literal/length code is rejected" {
    ret rejects(?N_INCOMPLETE_LITLEN[0], 42, "incomplete literal/length code");
}
test "inflate: too many literal/length codes is rejected" {
    ret rejects(?N_TOO_MANY_LIT[0], 10, "too many length or distance codes");
}
test "inflate: code length repeat with nothing to repeat is rejected" {
    ret rejects(?N_REPEAT_NO_PREV[0], 10, "code length repeat with no previous length");
}
test "inflate: dynamic stream cut in half is rejected" {
    ret rejects(?N_TRUNC_DYNAMIC[0], 27, "truncated deflate stream");
}

var fuzz_buf: [512]u8;

# feed C_DYNAMIC as two chunks split at `at`, checking the whole output
fun split_check(at: usize) i32 {
    var a: A.Allocator;
    page.make(?a);

    val ri: R.Result[Inflater, str] = init(?a);
    if (R.is_err[Inflater, str](ri)) { ret 1; }
    var z: Inflater = R.unwrap_ok[Inflater, str](ri);

    var in_off:  usize = 0;
    var out_off: usize = 0;
    var limit:   usize = at;
    var guard:   usize = 0;

    for (guard < 10000 && !is_done(?z)) {
        guard = guard + 1;

        val r: R.Result[Progress, str] = decompress(?z, ?C_DYNAMIC[in_off], limit - in_off,
                                                       ?obuf[out_off], 4096 - out_off);
        if (R.is_err[Progress, str](r)) { dnit(?z); ret 2; }

        val p: Progress = R.unwrap_ok[Progress, str](r);
        in_off  = in_off + p.consumed;
        out_off = out_off + p.written;

        if (p.status == NEED_INPUT) {
            if (limit == 402) { dnit(?z); ret 3; }
            limit = 402;
        }
    }

    val f: R.Result[bool, str] = finish(?z);
    dnit(?z);
    if (R.is_err[bool, str](f)) { ret 4; }
    if (out_off != 2253) { ret 5; }

    var i: usize = 0;
    for (i < 2253) {
        if (obuf[i] != D_DYNAMIC[i]) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test "inflate: output is identical for every two-chunk split point" {
    var at: usize = 0;
    for (at <= 402) {
        val rc: i32 = split_check(at);
        if (rc != 0) { ret rc; }
        at = at + 1;
    }
    ret 0;
}

test "inflate: every truncated prefix is rejected" {
    var a: A.Allocator;
    page.make(?a);

    var n: usize = 0;
    for (n < 402) {
        val r: R.Result[usize, str] = decompress_into(?a, ?C_DYNAMIC[0], n, ?obuf[0], 4096);
        if (!R.is_err[usize, str](r)) { ret 1; }
        n = n + 1;
    }
    ret 0;
}

test "inflate: every single-bit corruption is contained" {
    var a: A.Allocator;
    page.make(?a);

    var i: usize = 0;
    for (i < 402) {
        var b: usize = 0;
        for (b < 8) {
            var k: usize = 0;
            for (k < 402) {
                fuzz_buf[k] = C_DYNAMIC[k];
                k = k + 1;
            }
            fuzz_buf[i] = fuzz_buf[i] ^ (1::u32 << b::u32)::u8;

            # a flipped bit may still form a valid stream, so either outcome is
            # allowed; what matters is that the call returns and stays in bounds
            val r: R.Result[usize, str] = decompress_into(?a, ?fuzz_buf[0], 402, ?obuf[0], 4096);
            if (!R.is_err[usize, str](r)) {
                if (R.unwrap_ok[usize, str](r) > 4096) { ret 1; }
            }

            b = b + 1;
        }
        i = i + 1;
    }
    ret 0;
}
