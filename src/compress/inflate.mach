var obuf: [4096]u8;
var max_distance_comp: [32778]u8;

fun check(comp: *u8, comp_len: usize, orig: *u8, orig_len: usize) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[usize, str] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (R.is_err[usize, str](r)) { ret 1; }

    val n: usize = R.unwrap_ok[usize, str](r);
    if (n != orig_len) { ret 2; }

    var i: usize = 0;
    for (i < n) {
        if (obuf[i] != orig[i]) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

test "inflate: fixed huffman block" {
    ret check(?C_FIXED[0], 10, ?D_FIXED[0], 23);
}

test "inflate: stored block" {
    ret check(?C_STORED[0], 26, ?D_STORED[0], 21);
}

test "inflate: dynamic huffman block" {
    ret check(?C_DYNAMIC[0], 402, ?D_DYNAMIC[0], 2253);
}

test "inflate: one byte in one byte out streaming" {
    var a: A.Allocator;
    page.make(?a);

    val ri: R.Result[Inflater, str] = init(?a);
    if (R.is_err[Inflater, str](ri)) { ret 1; }
    var z: Inflater = R.unwrap_ok[Inflater, str](ri);

    var in_off:  usize = 0;
    var out_off: usize = 0;
    var guard:   usize = 0;

    for (guard < 100000 && !is_done(?z)) {
        guard = guard + 1;

        var feed: usize = 1;
        if (in_off + feed > 402) { feed = 402 - in_off; }

        val r: R.Result[Progress, str] = decompress(?z, ?C_DYNAMIC[in_off], feed, ?obuf[out_off], 1);
        if (R.is_err[Progress, str](r)) { dnit(?z); ret 2; }

        val p: Progress = R.unwrap_ok[Progress, str](r);
        in_off  = in_off + p.consumed;
        out_off = out_off + p.written;

        if (p.status == NEED_INPUT && in_off >= 402) { dnit(?z); ret 3; }
    }

    val f: R.Result[bool, str] = finish(?z);
    dnit(?z);
    if (R.is_err[bool, str](f)) { ret 4; }
    if (out_off != 2253) { ret 5; }

    var i: usize = 0;
    for (i < 2253) {
        if (obuf[i] != D_DYNAMIC[i]) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test "inflate: truncated stream is rejected" {
    var a: A.Allocator;
    page.make(?a);
    val r: R.Result[usize, str] = decompress_into(?a, ?C_DYNAMIC[0], 200, ?obuf[0], 4096);
    if (!R.is_err[usize, str](r)) { ret 1; }
    ret 0;
}

test "inflate: output buffer too small is rejected" {
    var a: A.Allocator;
    page.make(?a);
    val r: R.Result[usize, str] = decompress_into(?a, ?C_DYNAMIC[0], 402, ?obuf[0], 100);
    if (!R.is_err[usize, str](r)) { ret 1; }
    ret 0;
}

test "inflate: exactly-sized output reaches the end of block" {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[usize, str] = decompress_into(?a, ?C_FIXED[0], 10, ?obuf[0], 23);
    if (R.is_err[usize, str](r)) { ret 1; }
    if (R.unwrap_ok[usize, str](r) != 23) { ret 2; }
    ret 0;
}

test "inflate: streaming with an exact output budget reaches done" {
    var a: A.Allocator;
    page.make(?a);

    val ri: R.Result[Inflater, str] = init(?a);
    if (R.is_err[Inflater, str](ri)) { ret 1; }
    var z: Inflater = R.unwrap_ok[Inflater, str](ri);

    val r: R.Result[Progress, str] = decompress(?z, ?C_FIXED[0], 10, ?obuf[0], 23);
    if (R.is_err[Progress, str](r)) { dnit(?z); ret 2; }

    val p: Progress = R.unwrap_ok[Progress, str](r);
    val done: bool = is_done(?z);
    dnit(?z);

    if (p.status != DONE || !done) { ret 3; }
    if (p.written != 23) { ret 4; }
    ret 0;
}

