# repeating period-10 pattern used to recompute large procedural fixtures
# without embedding their expected output
val REPEAT_PAT: [10]u8 = [10]u8{
    0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6A
};

# distinctive 32-byte marker placed at offset 0 and again near offset 32768 in
# C_WRAP, so the second occurrence is encoded as a back-reference near the
# largest distance the format allows
val MARKER: [32]u8 = [32]u8{
    0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46,
    0x47, 0x48, 0x49, 0x4A, 0x4B, 0x4C, 0x4D, 0x4E, 0x4F, 0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0x56
};

fun expected_repeat(i: usize) u8 {
    ret REPEAT_PAT[i % 10];
}

fun expected_rle(i: usize) u8 {
    ret 0x78;
}

fun expected_pseudo(i: usize) u8 {
    ret ((i * 37 + i / 251) % 256)::u8;
}

fun expected_multi(i: usize) u8 {
    ret D_MULTI[i];
}

# C_WRAP is MARKER, then filler out to just under the second marker, then
# MARKER again at distance 32760, then more filler past 32 KiB
fun expected_wrap(i: usize) u8 {
    if (i < 32) { ret MARKER[i]; }
    if (i >= 32760 && i < 32792) { ret MARKER[i - 32760]; }
    ret REPEAT_PAT[i % 10];
}

# verify a decompressed stream against a byte generator rather than an
# embedded array, for fixtures whose expected output is procedural
fun gen_check(comp: *u8, comp_len: usize, orig_len: usize, gen: fun(usize) u8) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[usize, str] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (R.is_err[usize, str](r)) { ret 1; }

    val n: usize = R.unwrap_ok[usize, str](r);
    if (n != orig_len) { ret 2; }

    var i: usize = 0;
    for (i < n) {
        if (obuf[i] != gen(i)) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

# same as gen_check but for output too large for obuf, via the allocating API
fun gen_check_alloc(comp: *u8, comp_len: usize, orig_len: usize, gen: fun(usize) u8) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[V.Vector[u8], str] = decompress_alloc(?a, comp, comp_len);
    if (R.is_err[V.Vector[u8], str](r)) { ret 1; }

    var v: V.Vector[u8] = R.unwrap_ok[V.Vector[u8], str](r);
    if (v.len != orig_len) { V.dnit[u8](?v); ret 2; }

    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] != gen(i)) { V.dnit[u8](?v); ret 3; }
        i = i + 1;
    }

    V.dnit[u8](?v);
    ret 0;
}

# drive the streaming API with small, awkward chunk sizes so decoding must
# suspend and resume mid-symbol and mid-match, then verify against a generator
fun stream_check(comp: *u8, comp_len: usize, in_chunk: usize, out_chunk: usize, orig_len: usize, gen: fun(usize) u8) i32 {
    var a: A.Allocator;
    page.make(?a);

    val ri: R.Result[Inflater, str] = init(?a);
    if (R.is_err[Inflater, str](ri)) { ret 1; }
    var z: Inflater = R.unwrap_ok[Inflater, str](ri);

    var in_off:  usize = 0;
    var out_off: usize = 0;
    var guard:   usize = 0;

    for (guard < 200000 && !is_done(?z)) {
        guard = guard + 1;

        var feed: usize = in_chunk;
        if (in_off + feed > comp_len) { feed = comp_len - in_off; }

        var room: usize = out_chunk;
        if (out_off + room > 4096) { room = 4096 - out_off; }

        val r: R.Result[Progress, str] = decompress(?z, ?comp[in_off], feed, ?obuf[out_off], room);
        if (R.is_err[Progress, str](r)) { dnit(?z); ret 2; }

        val p: Progress = R.unwrap_ok[Progress, str](r);
        in_off  = in_off + p.consumed;
        out_off = out_off + p.written;

        if (p.status == NEED_INPUT && in_off >= comp_len) { dnit(?z); ret 3; }
    }

    val f: R.Result[bool, str] = finish(?z);
    dnit(?z);
    if (R.is_err[bool, str](f)) { ret 4; }
    if (in_off != comp_len)  { ret 5; }
    if (out_off != orig_len) { ret 6; }

    var i: usize = 0;
    for (i < out_off) {
        if (obuf[i] != gen(i)) { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test "inflate: empty input round trip" {
    ret check(?C_EMPTY[0], 2, ?C_EMPTY[0], 0);
}

test "inflate: single byte round trip" {
    ret check(?C_SINGLE[0], 3, ?D_SINGLE[0], 1);
}

test "inflate: all 256 byte values round trip" {
    ret check(?C_ALL256[0], 261, ?D_ALL256[0], 256);
}

test "inflate: multi-block stream via sync flush" {
    ret check(?C_MULTI[0], 58, ?D_MULTI[0], 135);
}

test "inflate: repetitive data with matches up to the maximum length" {
    ret gen_check(?C_REPEAT[0], 36, 4000, expected_repeat);
}

test "inflate: RLE data with distance-1 back-references" {
    ret gen_check(?C_RLE[0], 20, 4000, expected_rle);
}

test "inflate: incompressible pseudo-random data forces a stored block" {
    ret gen_check(?C_PSEUDO_STORED[0], 4005, 4000, expected_pseudo);
}

test "inflate: window wrap and large back-reference distance near 32 KiB" {
    ret gen_check_alloc(?C_WRAP[0], 170, 40000, expected_wrap);
}

# the first stored block fills the window; the fixed block that follows copies
# three bytes using distance symbol 29 with all thirteen extra bits set
test "inflate: accepts the maximum back-reference distance of 32768" {
    max_distance_comp[0] = 0x00;
    max_distance_comp[1] = 0x00;
    max_distance_comp[2] = 0x80;
    max_distance_comp[3] = 0xFF;
    max_distance_comp[4] = 0x7F;

    var i: usize = 0;
    for (i < WINDOW) {
        max_distance_comp[5 + i] = expected_pseudo(i);
        i = i + 1;
    }

    max_distance_comp[32773] = 0x03;
    max_distance_comp[32774] = 0xDE;
    max_distance_comp[32775] = 0xFF;
    max_distance_comp[32776] = 0x0F;
    max_distance_comp[32777] = 0x00;

    var a: A.Allocator;
    page.make(?a);
    val r: R.Result[V.Vector[u8], str] = decompress_alloc(?a, ?max_distance_comp[0], 32778);
    if (R.is_err[V.Vector[u8], str](r)) { ret 1; }

    var v: V.Vector[u8] = R.unwrap_ok[V.Vector[u8], str](r);
    if (v.len != WINDOW + 3) { V.dnit[u8](?v); ret 2; }

    i = 0;
    for (i < WINDOW) {
        if (v.data[i] != expected_pseudo(i)) { V.dnit[u8](?v); ret 3; }
        i = i + 1;
    }
    i = 0;
    for (i < 3) {
        if (v.data[WINDOW + i] != expected_pseudo(i)) { V.dnit[u8](?v); ret 4; }
        i = i + 1;
    }

    V.dnit[u8](?v);
    ret 0;
}

test "inflate: streaming with 1-byte input and 5-byte output chunks" {
    ret stream_check(?C_REPEAT[0], 36, 1, 5, 4000, expected_repeat);
}

test "inflate: streaming with 3-byte input and 13-byte output chunks" {
    ret stream_check(?C_RLE[0], 20, 3, 13, 4000, expected_rle);
}

test "inflate: streaming with 7-byte input and 1-byte output chunks" {
    ret stream_check(?C_MULTI[0], 58, 7, 1, 135, expected_multi);
}

