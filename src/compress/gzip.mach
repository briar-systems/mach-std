# a malformed stream must be refused, and refused for the stated reason
fun rejects(comp: *u8, comp_len: usize, want: str) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[usize, str] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (!R.is_err[usize, str](r)) { ret 1; }
    if (!str_equals(R.unwrap_err[usize, str](r), want)) { ret 2; }
    ret 0;
}
test "gzip: wrong magic bytes is rejected" {
    ret rejects(?N_G_BAD_MAGIC[0], 54, "not a gzip stream");
}
test "gzip: a reserved header flag is rejected" {
    ret rejects(?N_G_RESERVED_FLAG[0], 54, "gzip reserved header flags are set");
}
test "gzip: corrupt crc32 trailer is rejected" {
    ret rejects(?N_G_BAD_CRC[0], 54, "gzip checksum mismatch");
}
test "gzip: corrupt length trailer is rejected" {
    ret rejects(?N_G_BAD_ISIZE[0], 54, "gzip length mismatch");
}
test "gzip: member cut before its trailer is rejected" {
    ret rejects(?N_G_TRUNC[0], 44, "truncated gzip stream");
}
test "gzip: bad FHCRC header checksum is rejected" {
    ret rejects(?N_G_BAD_HCRC[0], 56, "gzip header checksum mismatch");
}
