fun defect_code(d: I.Defect) u8 {
    var x: I.Defect = d;
    val p: *u8 = (?x)::*u8;
    ret p[0];
}

# a malformed stream must be refused, and refused for the stated defect
fun rejects(comp: *u8, comp_len: usize, want: I.Defect) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: res[usize, I.InflateError] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (!sel r.err) { ret 1; }
    if (!sel r.err.malformed) { ret 2; }
    if (defect_code(r.err.malformed.defect) != defect_code(want)) { ret 3; }
    ret 0;
}

# a stream that ends early is truncated, with every input byte consumed
fun rejects_truncated(comp: *u8, comp_len: usize) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: res[usize, I.InflateError] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (!sel r.err) { ret 1; }
    if (!sel r.err.truncated) { ret 2; }
    if (r.err.truncated.consumed != comp_len) { ret 3; }
    ret 0;
}
test "gzip: wrong magic bytes is rejected" {
    ret rejects(?N_G_BAD_MAGIC[0], 54, I.Defect.magic{});
}
test "gzip: a reserved header flag is rejected" {
    ret rejects(?N_G_RESERVED_FLAG[0], 54, I.Defect.flags{});
}
test "gzip: corrupt crc32 trailer is rejected" {
    ret rejects(?N_G_BAD_CRC[0], 54, I.Defect.checksum{});
}
test "gzip: corrupt length trailer is rejected" {
    ret rejects(?N_G_BAD_ISIZE[0], 54, I.Defect.length{});
}
test "gzip: member cut before its trailer is rejected" {
    ret rejects_truncated(?N_G_TRUNC[0], 44);
}
test "gzip: bad FHCRC header checksum is rejected" {
    ret rejects(?N_G_BAD_HCRC[0], 56, I.Defect.header_checksum{});
}
val N_G_GOOD_HCRC: [56]u8 = [56]u8{
    0x1F, 0x8B, 0x08, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0xA7, 0x77, 0x4B, 0xAF, 0xCA, 0x2C,
    0x50, 0x28, 0x2F, 0x4A, 0x2C, 0x28, 0x48, 0x2D, 0x52, 0xC8, 0x4B, 0x4D, 0x4F, 0x2C, 0xC9, 0x2C,
    0x4B, 0x55, 0x48, 0x4E, 0x2C, 0x4E, 0x55, 0x28, 0x48, 0xAC, 0xCC, 0xC9, 0x4F, 0x4C, 0x01, 0x00,
    0xAD, 0x4B, 0x33, 0x4C, 0x22, 0x00, 0x00, 0x00
};

val D_GOOD_HCRC: [34]u8 = [34]u8{
    0x67, 0x7A, 0x69, 0x70, 0x20, 0x77, 0x72, 0x61, 0x70, 0x70, 0x65, 0x72, 0x20, 0x6E, 0x65, 0x67,
    0x61, 0x74, 0x69, 0x76, 0x65, 0x20, 0x63, 0x61, 0x73, 0x65, 0x20, 0x70, 0x61, 0x79, 0x6C, 0x6F,
    0x61, 0x64
};
test "gzip: header with a valid FHCRC is accepted" {
    var a: A.Allocator;
    page.make(?a);

    val r: res[usize, I.InflateError] = decompress_into(?a, ?N_G_GOOD_HCRC[0], 56, ?obuf[0], 4096);
    if (sel r.err) { ret 1; }

    val n: usize = r.ok;
    if (n != 34) { ret 2; }

    var i: usize = 0;
    for (i < n) {
        if (obuf[i] != D_GOOD_HCRC[i]) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

fun t_copy(dst: *u8, src: *u8, count: usize) {
    var i: usize = 0;
    for (i < count) { dst[i] = src[i]; i = i + 1; }
}

fun t_split(comp: *u8, count: usize, split: usize, room: usize, expected: *u8, expected_len: usize) i32 {
    var a: A.Allocator;
    page.make(?a);
    val created: res[Decompressor, I.InflateError] = init(?a);
    if (sel created.err) { ret 1; }
    var z: Decompressor = created.ok;
    fin { dnit(?z); }
    var read: usize = 0;
    var written: usize = 0;
    var steps: usize = 0;
    for (!is_done(?z) && steps < 4096) {
        var feed: usize = count - read;
        if (read < split) { feed = split - read; }
        var available: usize = room;
        if (available > 4096 - written) { available = 4096 - written; }
        var result: res[I.Progress, I.InflateError];
        if (read == count) { result = finish(?z, ?obuf[written], available); }
        or { result = decompress(?z, ?comp[read], feed, ?obuf[written], available); }
        if (sel result.err) { ret 2; }
        val p: I.Progress = result.ok;
        if (p.consumed > feed || p.written > available) { ret 3; }
        if (read == count && p.status == I.NEED_INPUT) { ret 4; }
        if (p.status == I.DONE && !z.eof) { ret 5; }
        if (p.status != I.DONE && p.consumed == 0 && p.written == 0) { ret 6; }
        read = read + p.consumed;
        written = written + p.written;
        steps = steps + 1;
    }
    if (!is_done(?z) || read != count || written != expected_len) { ret 7; }
    var i: usize = 0;
    for (i < written) {
        if (obuf[i] != expected[i]) { ret 8; }
        i = i + 1;
    }
    ret 0;
}

test "gzip: all member split points preserve output and independent framing" {
    var comp: [242]u8;
    t_copy(?comp[0], ?C_G_PY6[0], 71);
    t_copy(?comp[71], ?C_G_EMPTY[0], 20);
    t_copy(?comp[91], ?C_G_CLI[0], 95);
    t_copy(?comp[186], ?N_G_GOOD_HCRC[0], 56);
    var expected: [152]u8;
    t_copy(?expected[0], ?D_G_PY6[0], 51);
    t_copy(?expected[51], ?D_G_CLI[0], 67);
    t_copy(?expected[118], ?D_GOOD_HCRC[0], 34);
    var split: usize = 0;
    for (split <= 242) {
        if (t_split(?comp[0], 242, split, 1, ?expected[0], 152) != 0) { ret 1; }
        if (t_split(?comp[0], 242, split, 17, ?expected[0], 152) != 0) { ret 2; }
        if (t_split(?comp[0], 242, split, 4096, ?expected[0], 152) != 0) { ret 3; }
        split = split + 1;
    }
    ret check(?comp[0], 242, ?expected[0], 152);
}

test "gzip: later corruption truncation and trailing junk never return prefix success" {
    var comp: [127]u8;
    t_copy(?comp[0], ?C_G_PY6[0], 71);
    t_copy(?comp[71], ?N_G_BAD_CRC[0], 54);
    if (rejects(?comp[0], 125, I.Defect.checksum{}) != 0) { ret 1; }
    t_copy(?comp[71], ?N_G_BAD_ISIZE[0], 54);
    if (rejects(?comp[0], 125, I.Defect.length{}) != 0) { ret 2; }
    t_copy(?comp[71], ?N_G_BAD_MAGIC[0], 54);
    if (rejects(?comp[0], 125, I.Defect.magic{}) != 0) { ret 3; }
    t_copy(?comp[71], ?N_G_RESERVED_FLAG[0], 54);
    if (rejects(?comp[0], 125, I.Defect.flags{}) != 0) { ret 4; }
    t_copy(?comp[71], ?N_G_BAD_HCRC[0], 56);
    if (rejects(?comp[0], 127, I.Defect.header_checksum{}) != 0) { ret 5; }
    t_copy(?comp[71], ?N_G_GOOD_HCRC[0], 56);
    var cut: usize = 72;
    for (cut < 127) {
        if (rejects_truncated(?comp[0], cut) != 0) { ret 6; }
        cut = cut + 1;
    }
    comp[71] = 0;
    if (rejects_truncated(?comp[0], 72) != 0) { ret 7; }
    ret rejects_truncated(nil, 0);
}

test "gzip: EOF completion failure reset and destruction have explicit states" {
    var a: A.Allocator;
    page.make(?a);
    val created: res[Decompressor, I.InflateError] = init(?a);
    if (sel created.err) { ret 1; }
    var z: Decompressor = created.ok;
    fin { dnit(?z); }
    val fed: res[I.Progress, I.InflateError] = decompress(?z, ?C_G_EMPTY[0], 20, nil, 0);
    if (sel fed.err) { ret 2; }
    val first: I.Progress = fed.ok;
    if (first.status != I.NEED_INPUT || first.consumed != 20 || first.written != 0 || is_done(?z)) { ret 3; }
    var repeat: u32 = 0;
    for (repeat < 2) {
        val ended: res[I.Progress, I.InflateError] = finish(?z, nil, 0);
        if (sel ended.err) { ret 4; }
        val p: I.Progress = ended.ok;
        if (p.status != I.DONE || p.consumed != 0 || p.written != 0 || !is_done(?z)) { ret 5; }
        repeat = repeat + 1;
    }
    val late: res[I.Progress, I.InflateError] = decompress(?z, ?C_G_EMPTY[0], 20, nil, 0);
    if (!sel late.err) { ret 6; }
    if (!sel late.err.finished) { ret 6; }
    reset(?z);
    val empty: res[I.Progress, I.InflateError] = finish(?z, nil, 0);
    if (!sel empty.err) { ret 7; }
    if (!sel empty.err.truncated) { ret 7; }
    val failed: res[I.Progress, I.InflateError] = decompress(?z, ?C_G_EMPTY[0], 20, nil, 0);
    if (!sel failed.err) { ret 8; }
    if (!sel failed.err.truncated) { ret 8; }
    reset(?z);
    val driven: res[usize, I.InflateError] = drive(?z, ?C_G_PY6[0], 71, ?obuf[0], 51);
    if (sel driven.err) { ret 9; }
    val first_release: err[A.Error] = dnit(?z);
    if (sel first_release.err) { ret 10; }
    val second_release: err[A.Error] = dnit(?z);
    if (sel second_release.err) { ret 10; }
    reset(?z);
    if (is_done(?z)) { ret 11; }
    val closed: res[I.Progress, I.InflateError] = finish(?z, nil, 0);
    if (!sel closed.err) { ret 11; }
    if (!sel closed.err.closed) { ret 11; }
    ret 0;
}

test "gzip: empty members need no output and full buffers can resume" {
    var a: A.Allocator;
    page.make(?a);
    var empty: [40]u8;
    t_copy(?empty[0], ?C_G_EMPTY[0], 20);
    t_copy(?empty[20], ?C_G_EMPTY[0], 20);
    val nothing: res[usize, I.InflateError] = decompress_into(?a, ?empty[0], 40, nil, 0);
    if (sel nothing.err) { ret 1; }
    if (nothing.ok != 0) { ret 1; }
    val created: res[Decompressor, I.InflateError] = init(?a);
    if (sel created.err) { ret 2; }
    var z: Decompressor = created.ok;
    fin { dnit(?z); }
    val first: res[I.Progress, I.InflateError] = decompress(?z, ?C_G_PY6[0], 71, nil, 0);
    if (sel first.err) { ret 3; }
    val p: I.Progress = first.ok;
    if (p.status != I.OUTPUT_FULL || p.written != 0 || p.consumed > 71) { ret 4; }
    val second: res[I.Progress, I.InflateError] = decompress(?z, ?C_G_PY6[p.consumed], 71 - p.consumed, nil, 0);
    if (sel second.err) { ret 5; }
    val q: I.Progress = second.ok;
    if (q.status != I.OUTPUT_FULL || q.written != 0 || q.consumed > 71 - p.consumed) { ret 6; }
    val read: usize = p.consumed + q.consumed;
    val restored: res[usize, I.InflateError] = drive(?z, ?C_G_PY6[read], 71 - read, ?obuf[0], 51);
    if (sel restored.err) { ret 7; }
    if (restored.ok != 51) { ret 7; }
    var i: usize = 0;
    for (i < 51) { if (obuf[i] != D_G_PY6[i]) { ret 8; } i = i + 1; }
    ret 0;
}

test "gzip: finishing drains buffered matches through output backpressure" {
    var a: A.Allocator;
    page.make(?a);
    val created: res[Decompressor, I.InflateError] = init(?a);
    if (sel created.err) { ret 1; }
    var z: Decompressor = created.ok;
    fin { dnit(?z); }
    var read: usize = 0;
    var written: usize = 0;
    var drains: usize = 0;
    for (!is_done(?z) && written <= 276) {
        var result: res[I.Progress, I.InflateError];
        if (read == 69) { result = finish(?z, ?obuf[written], 1); drains = drains + 1; }
        or { result = decompress(?z, ?C_G_STREAM[read], 69 - read, ?obuf[written], 1); }
        if (sel result.err) { ret 2; }
        val p: I.Progress = result.ok;
        if (p.consumed > 69 - read || p.written > 1) { ret 3; }
        if (p.status != I.DONE && p.consumed == 0 && p.written == 0) { ret 4; }
        if (read == 69 && p.status == I.NEED_INPUT) { ret 5; }
        read = read + p.consumed;
        written = written + p.written;
    }
    if (!is_done(?z) || drains == 0 || written != 276) { ret 6; }
    var i: usize = 0;
    for (i < 276) { if (obuf[i] != D_G_STREAM[i]) { ret 7; } i = i + 1; }

    var most_drains: usize = 0;
    var cut: usize = 1;
    for (cut < 69) {
        reset(?z);
        read = 0;
        written = 0;
        drains = 0;
        var failed: bool = false;
        var steps: usize = 0;
        for (!failed && written <= 276 && steps < 400) {
            steps = steps + 1;
            val eof: bool = read == cut;
            var result: res[I.Progress, I.InflateError];
            if (eof) { result = finish(?z, ?obuf[written], 1); }
            or { result = decompress(?z, ?C_G_STREAM[read], cut - read, ?obuf[written], 1); }
            if (sel result.err) {
                if (!eof) { ret 8; }
                if (!sel result.err.truncated) { ret 8; }
                failed = true;
                brk;
            }
            val p: I.Progress = result.ok;
            if (p.consumed > cut - read || p.written > 1 || p.status == I.DONE) { ret 9; }
            if (p.consumed == 0 && p.written == 0) { ret 10; }
            if (eof) {
                if (p.status != I.OUTPUT_FULL || p.consumed != 0) { ret 11; }
                drains = drains + 1;
            }
            read = read + p.consumed;
            written = written + p.written;
        }
        if (!failed || is_done(?z) || written > 276) { ret 12; }
        i = 0;
        for (i < written) { if (obuf[i] != D_G_STREAM[i]) { ret 13; } i = i + 1; }
        val repeated: res[I.Progress, I.InflateError] = finish(?z, nil, 0);
        if (!sel repeated.err) { ret 14; }
        if (!sel repeated.err.truncated) { ret 14; }
        if (repeated.err.truncated.consumed != 0 || repeated.err.truncated.written != 0) { ret 14; }
        if (drains > most_drains) { most_drains = drains; }
        cut = cut + 1;
    }
    if (most_drains < 2) { ret 15; }
    ret 0;
}

test "gzip: allocation refusal frees the window and cumulative output" {
    var comp: [1054]u8;
    t_copy(?comp[0], ?C_G_LARGE[0], 527);
    t_copy(?comp[527], ?C_G_LARGE[0], 527);
    var ordinal: usize = 1;
    for (ordinal <= 32) {
        var tracker: T.Testing;
        val made: err[A.Error] = T.make(?tracker);
        if (sel made.err) { ret 1; }
        T.fail_at_ordinal(?tracker, ordinal);
        val result: res[V.Vector[u8], I.InflateError] = decompress_alloc(T.allocator_of(?tracker), ?comp[0], 1054);
        var accepted: bool = false;
        var refused: bool = false;
        if (sel result.err) {
            if (sel result.err.alloc) { refused = sel result.err.alloc.exhausted; }
        }
        if (sel result.ok) {
            var out: V.Vector[u8] = result.ok;
            accepted = out.len == 24000;
            var i: usize = 0;
            for (i < out.len) {
                if (out.data[i] != expected_pseudo(i % 12000)) { accepted = false; }
                i = i + 1;
            }
            V.dnit[u8](?out);
        }
        val leaked: bool = T.live_count(?tracker) != 0 || T.double_free_count(?tracker) != 0;
        val attempts: usize = T.attempt_count(?tracker);
        T.dnit(?tracker);
        if (leaked) { ret 2; }
        if (accepted) { if (attempts >= ordinal) { ret 3; } ret 0; }
        if (!refused || attempts != ordinal) { ret 4; }
        ordinal = ordinal + 1;
    }
    ret 5;
}

test "gzip: a malformed later member releases allocated prefix output" {
    var comp: [581]u8;
    t_copy(?comp[0], ?C_G_LARGE[0], 527);
    t_copy(?comp[527], ?N_G_BAD_CRC[0], 54);
    var tracker: T.Testing;
    val made: err[A.Error] = T.make(?tracker);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?tracker); }
    val result: res[V.Vector[u8], I.InflateError] = decompress_alloc(T.allocator_of(?tracker), ?comp[0], 581);
    if (sel result.ok) {
        var unexpected: V.Vector[u8] = result.ok;
        V.dnit[u8](?unexpected);
        ret 2;
    }
    if (!sel result.err.malformed) { ret 3; }
    if (defect_code(result.err.malformed.defect) != defect_code(I.Defect.checksum{})) { ret 3; }
    if (T.live_count(?tracker) != 0 || T.double_free_count(?tracker) != 0) { ret 4; }
    ret 0;
}

# a failure after progress carries the counts committed by the call that
# failed: over a whole-stream call that is both members, over a streaming
# call only the bytes of that call, and a re-report after the failure has
# settled commits nothing
test "gzip: a failure after progress carries the committed counts across members" {
    var comp: [125]u8;
    t_copy(?comp[0], ?C_G_PY6[0], 71);
    t_copy(?comp[71], ?N_G_BAD_CRC[0], 54);
    var a: A.Allocator;
    page.make(?a);

    val whole: res[usize, I.InflateError] = decompress_into(?a, ?comp[0], 125, ?obuf[0], 4096);
    if (!sel whole.err) { ret 1; }
    if (!sel whole.err.malformed) { ret 2; }
    if (whole.err.malformed.consumed != 125) { ret 3; }
    if (whole.err.malformed.written != 85) { ret 4; }

    val created: res[Decompressor, I.InflateError] = init(?a);
    if (sel created.err) { ret 5; }
    var z: Decompressor = created.ok;
    fin { dnit(?z); }
    val first: res[I.Progress, I.InflateError] = decompress(?z, ?comp[0], 71, ?obuf[0], 4096);
    if (sel first.err) { ret 6; }
    if (first.ok.consumed != 71 || first.ok.written != 51) { ret 7; }
    val second: res[I.Progress, I.InflateError] = decompress(?z, ?comp[71], 54, ?obuf[51], 4096 - 51);
    if (!sel second.err) { ret 8; }
    if (!sel second.err.malformed) { ret 9; }
    if (second.err.malformed.consumed != 54) { ret 10; }
    if (second.err.malformed.written != 34) { ret 11; }
    val again: res[I.Progress, I.InflateError] = finish(?z, ?obuf[85], 4096 - 85);
    if (!sel again.err) { ret 12; }
    if (!sel again.err.malformed) { ret 13; }
    if (again.err.malformed.consumed != 0 || again.err.malformed.written != 0) { ret 14; }
    if (defect_code(again.err.malformed.defect) != defect_code(I.Defect.checksum{})) { ret 15; }
    ret 0;
}

# a stream failure is stored: every later decompress or finish re-reports the
# same cause with nothing committed, whatever input or output it is offered,
# until reset clears it. the truncated case is the discriminating one: without
# the re-report a decompress after the declared end would answer `finished`,
# and a finish would run the stream again instead of reporting it settled
test "gzip: a stored failure is re-reported settled by every later call" {
    var a: A.Allocator;
    page.make(?a);
    val created: res[Decompressor, I.InflateError] = init(?a);
    if (sel created.err) { ret 1; }
    var z: Decompressor = created.ok;
    fin { dnit(?z); }

    val partial: res[I.Progress, I.InflateError] = decompress(?z, ?C_G_PY6[0], 40, ?obuf[0], 4096);
    if (sel partial.err) { ret 2; }
    if (partial.ok.status != I.NEED_INPUT || partial.ok.consumed != 40) { ret 3; }
    val cut: res[I.Progress, I.InflateError] = finish(?z, ?obuf[partial.ok.written], 4096 - partial.ok.written);
    if (!sel cut.err) { ret 4; }
    if (!sel cut.err.truncated) { ret 4; }
    if (cut.err.truncated.consumed != 0) { ret 4; }
    var round: usize = 0;
    for (round < 2) {
        val fed: res[I.Progress, I.InflateError] = decompress(?z, ?C_G_PY6[40], 31, ?obuf[0], 4096);
        if (!sel fed.err) { ret 5; }
        if (!sel fed.err.truncated) { ret 5; }
        if (fed.err.truncated.consumed != 0 || fed.err.truncated.written != 0) { ret 6; }
        val ended: res[I.Progress, I.InflateError] = finish(?z, ?obuf[0], 4096);
        if (!sel ended.err) { ret 7; }
        if (!sel ended.err.truncated) { ret 7; }
        if (ended.err.truncated.consumed != 0 || ended.err.truncated.written != 0) { ret 8; }
        round = round + 1;
    }
    if (is_done(?z)) { ret 9; }

    reset(?z);
    var comp: [125]u8;
    t_copy(?comp[0], ?C_G_PY6[0], 71);
    t_copy(?comp[71], ?N_G_BAD_CRC[0], 54);
    val broken: res[I.Progress, I.InflateError] = decompress(?z, ?comp[0], 125, ?obuf[0], 4096);
    if (!sel broken.err) { ret 10; }
    if (!sel broken.err.malformed) { ret 10; }
    if (broken.err.malformed.consumed != 125 || broken.err.malformed.written != 85) { ret 11; }
    round = 0;
    for (round < 2) {
        val fed: res[I.Progress, I.InflateError] = decompress(?z, ?C_G_PY6[0], 71, ?obuf[0], 4096);
        if (!sel fed.err) { ret 12; }
        if (!sel fed.err.malformed) { ret 12; }
        if (defect_code(fed.err.malformed.defect) != defect_code(I.Defect.checksum{})) { ret 13; }
        if (fed.err.malformed.consumed != 0 || fed.err.malformed.written != 0) { ret 14; }
        val ended: res[I.Progress, I.InflateError] = finish(?z, ?obuf[0], 4096);
        if (!sel ended.err) { ret 15; }
        if (!sel ended.err.malformed) { ret 15; }
        if (defect_code(ended.err.malformed.defect) != defect_code(I.Defect.checksum{})) { ret 16; }
        if (ended.err.malformed.consumed != 0 || ended.err.malformed.written != 0) { ret 17; }
        round = round + 1;
    }
    if (is_done(?z)) { ret 18; }

    reset(?z);
    val driven: res[usize, I.InflateError] = drive(?z, ?C_G_PY6[0], 71, ?obuf[0], 51);
    if (sel driven.err) { ret 19; }
    if (driven.ok != 51) { ret 19; }
    ret 0;
}

# a truncated later member is the truncated verdict over the whole call, with
# every byte consumed and the prefix output counted, and the vector that held
# that output is already released: after a failed decompress_alloc the caller
# owns nothing
test "gzip: a truncated later member releases allocated prefix output" {
    var comp: [827]u8;
    t_copy(?comp[0], ?C_G_LARGE[0], 527);
    t_copy(?comp[527], ?C_G_LARGE[0], 300);
    var tracker: T.Testing;
    val made: err[A.Error] = T.make(?tracker);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?tracker); }
    val result: res[V.Vector[u8], I.InflateError] = decompress_alloc(T.allocator_of(?tracker), ?comp[0], 827);
    if (sel result.ok) {
        var unexpected: V.Vector[u8] = result.ok;
        V.dnit[u8](?unexpected);
        ret 2;
    }
    if (!sel result.err.truncated) { ret 3; }
    if (result.err.truncated.consumed != 827) { ret 4; }
    if (result.err.truncated.written < 12000) { ret 5; }
    if (T.live_count(?tracker) != 0 || T.double_free_count(?tracker) != 0) { ret 6; }
    ret 0;
}

# an allocator that can be told to refuse releases, over the page allocator
rec Refusing {
    backing: A.Allocator;
    refuse:  bool;
}

val REFUSED_RELEASE: i64 = -16;

fun refusing_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val r: *Refusing = ctx::*Refusing;
    ret r.backing.fn_allocate(r.backing.ctx, size, align);
}

fun refusing_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val r: *Refusing = ctx::*Refusing;
    ret r.backing.fn_reallocate(r.backing.ctx, p, old_size, new_size, align);
}

fun refusing_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    val r: *Refusing = ctx::*Refusing;
    if (r.refuse) { ret REFUSED_RELEASE; }
    ret r.backing.fn_deallocate(r.backing.ctx, p, size, align);
}

fun refusing_make(r: *Refusing, a: *A.Allocator) {
    page.make(?r.backing);
    r.refuse        = false;
    a.ctx           = r::ptr;
    a.fn_allocate   = refusing_allocate;
    a.fn_reallocate = refusing_reallocate;
    a.fn_deallocate = refusing_deallocate;
}

# the window is the decoder's only acquisition: a refused init is `alloc`
# with nothing held, through init and through both one-shot wrappers. a
# refused release is the allocator's status, and the decoder keeps its window
# and stays usable until a release is accepted; a released decoder is closed
test "gzip: init and dnit under a refusing allocator" {
    var tracker: T.Testing;
    val made: err[A.Error] = T.make(?tracker);
    if (sel made.err) { ret 1; }
    T.fail_at_ordinal(?tracker, 1);
    val refused: res[Decompressor, I.InflateError] = init(T.allocator_of(?tracker));
    if (!sel refused.err) { T.dnit(?tracker); ret 2; }
    if (!sel refused.err.alloc) { T.dnit(?tracker); ret 3; }
    if (!sel refused.err.alloc.exhausted) { T.dnit(?tracker); ret 3; }
    if (T.attempt_count(?tracker) != 1 || T.live_count(?tracker) != 0) { T.dnit(?tracker); ret 4; }
    T.fail_at_ordinal(?tracker, T.attempt_count(?tracker) + 1);
    val into: res[usize, I.InflateError] = decompress_into(T.allocator_of(?tracker), ?C_G_PY6[0], 71, ?obuf[0], 4096);
    if (!sel into.err) { T.dnit(?tracker); ret 5; }
    if (!sel into.err.alloc) { T.dnit(?tracker); ret 5; }
    T.fail_at_ordinal(?tracker, T.attempt_count(?tracker) + 1);
    val grown: res[V.Vector[u8], I.InflateError] = decompress_alloc(T.allocator_of(?tracker), ?C_G_PY6[0], 71);
    if (sel grown.ok) {
        var unexpected: V.Vector[u8] = grown.ok;
        V.dnit[u8](?unexpected);
        T.dnit(?tracker);
        ret 6;
    }
    if (!sel grown.err.alloc) { T.dnit(?tracker); ret 6; }
    val leaked: bool = T.live_count(?tracker) != 0 || T.double_free_count(?tracker) != 0;
    T.dnit(?tracker);
    if (leaked) { ret 7; }

    var r: Refusing;
    var a: A.Allocator;
    refusing_make(?r, ?a);
    val created: res[Decompressor, I.InflateError] = init(?a);
    if (sel created.err) { ret 8; }
    var z: Decompressor = created.ok;
    r.refuse = true;
    val held: err[A.Error] = dnit(?z);
    if (!sel held.err) { ret 9; }
    if (!sel held.err.release) { ret 9; }
    if (held.err.release != REFUSED_RELEASE) { ret 10; }
    val driven: res[usize, I.InflateError] = drive(?z, ?C_G_PY6[0], 71, ?obuf[0], 51);
    if (sel driven.err) { ret 11; }
    if (driven.ok != 51) { ret 11; }
    r.refuse = false;
    val released: err[A.Error] = dnit(?z);
    if (sel released.err) { ret 12; }
    val again: err[A.Error] = dnit(?z);
    if (sel again.err) { ret 12; }
    val closed: res[I.Progress, I.InflateError] = decompress(?z, ?C_G_PY6[0], 71, ?obuf[0], 4096);
    if (!sel closed.err) { ret 13; }
    if (!sel closed.err.closed) { ret 13; }
    val ended: res[I.Progress, I.InflateError] = finish(?z, ?obuf[0], 4096);
    if (!sel ended.err) { ret 14; }
    if (!sel ended.err.closed) { ret 14; }
    ret 0;
}
