# gzip stream decompression (RFC 1952)
#
# a gzip member is a variable-length header, a raw deflate stream, and a trailer
# carrying a little-endian crc32 of the decompressed bytes and their length mod
# 2^32. this wraps std.compress.inflate with that framing and verifies both, so
# a mismatch is reported rather than silently returning corrupt output. the
# optional FHCRC header checksum is verified too when present.
#
# all concatenated members are decoded and checked independently. after every
# input byte has been consumed, finish declares end-of-input and drains output.
# DONE means the complete stream was verified after that declaration.
# Progress, its status constants, WINDOW and the InflateError family are
# re-exported from inflate so a caller needs only this module to drive a
# stream, size its scratch storage and read its outcome.
#
# a failure is sticky: the first one is stored and every later call re-reports
# it with nothing committed, until reset or dnit.

use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;
use V: std.collections.vector;
use I: std.compress.inflate;
use std.allocator.page;
use std.crypto.hash.crc32;

fwd I.Progress;
fwd I.Status;
fwd I.NEED_INPUT;
fwd I.OUTPUT_FULL;
fwd I.DONE;
fwd I.WINDOW;
fwd I.InflateError;
fwd I.Defect;
fwd I.Fault;
fwd I.Committed;

val G_HEAD:    u8 = 0;
val G_XLEN:    u8 = 1;
val G_EXTRA:   u8 = 2;
val G_NAME:    u8 = 3;
val G_COMMENT: u8 = 4;
val G_HCRC:    u8 = 5;
val G_DATA:    u8 = 6;
val G_TRAILER: u8 = 7;
val G_BETWEEN: u8 = 8;
val G_DONE:    u8 = 9;
val G_CLOSED:  u8 = 10;

val F_HCRC:    u8 = 2;
val F_EXTRA:   u8 = 4;
val F_NAME:    u8 = 8;
val F_COMMENT: u8 = 16;

# streaming gzip decoder state
#
# create with init, feed with decompress, drain with finish, release with
# dnit. all fields are internal; the surface is the functions below.
pub rec Decompressor {
    inf:   I.Inflater;
    state: u8;
    have:  usize;
    skip:  usize;
    flg:   u8;
    hcrc:  u32;
    crc:   u32;
    isize: u64;
    buf:   [10]u8;
    eof:   bool;
    failure: opt[I.InflateError];
}

fun progress(st: I.Status, consumed: usize, written: usize) res[I.Progress, I.InflateError] {
    var p: I.Progress;
    p.status   = st;
    p.consumed = consumed;
    p.written  = written;
    ret res[I.Progress, I.InflateError].ok{p};
}

fun fault(defect: I.Defect, consumed: usize, written: usize) res[I.Progress, I.InflateError] {
    ret res[I.Progress, I.InflateError].err{I.malformed(defect, consumed, written)};
}

# fold one header byte into the running header crc
fun hdr_fold(z: *Decompressor, b: u8) {
    var v: u8 = b;
    z.hcrc = crc32.update(z.hcrc, ?v, 1);
}

# pick the next state after the fixed header, in the field order of RFC 1952
fun after_comment(z: *Decompressor) {
    if ((z.flg & F_HCRC) != 0) { z.state = G_HCRC; z.have = 0; ret; }
    z.state = G_DATA;
}

fun after_name(z: *Decompressor) {
    if ((z.flg & F_COMMENT) != 0) { z.state = G_COMMENT; ret; }
    after_comment(z);
}

fun after_extra(z: *Decompressor) {
    if ((z.flg & F_NAME) != 0) { z.state = G_NAME; ret; }
    after_name(z);
}

fun after_head(z: *Decompressor) {
    if ((z.flg & F_EXTRA) != 0) { z.state = G_XLEN; z.have = 0; ret; }
    after_extra(z);
}

# begin another member without changing the stream lifecycle
fun member_reset(z: *Decompressor) {
    I.reset(?z.inf);
    z.state = G_HEAD;
    z.have  = 0;
    z.skip  = 0;
    z.flg   = 0;
    z.hcrc  = crc32.init();
    z.crc   = crc32.init();
    z.isize = 0;
}

# restart a live decoder after completion or failure, retaining its window
pub fun reset(z: *Decompressor) {
    if (z.inf.win == nil) { ret; }
    z.eof = false;
    z.failure = opt[I.InflateError].none{};
    member_reset(z);
}

# create a decoder, allocating the inflater's window from a
# ---
# a:   allocator used for the window and nothing else
# ret: a ready decoder, or the allocator's refusal of the window
pub fun init(a: *A.Allocator) res[Decompressor, I.InflateError] {
    val ri: res[I.Inflater, I.InflateError] = I.init(a);
    if (sel ri.err) { ret res[Decompressor, I.InflateError].err{ri.err}; }

    var z: Decompressor;
    z.inf = ri.ok;
    reset(?z);

    ret res[Decompressor, I.InflateError].ok{z};
}

# release the inflater's window
#
# a decoder that holds no window is already released. a refused release
# leaves the decoder owning its window.
# ---
# z:   decoder to deinitialize
# ret: ok, or the allocator's refusal
pub fun dnit(z: *Decompressor) err[A.Error] {
    val freed: err[A.Error] = I.dnit(?z.inf);
    if (sel freed.err) { ret freed; }
    z.state = G_CLOSED;
    ret err[A.Error].ok{};
}

# check whether end-of-input and every member have been verified
# ---
# z:   decoder to query
# ret: true once the complete stream has been verified
pub fun is_done(z: *Decompressor) bool {
    ret z.state == G_DONE;
}

fun member(z: *Decompressor, src: *u8, src_len: usize, dst: *u8, dst_len: usize) res[I.Progress, I.InflateError] {
    var consumed: usize = 0;
    var written:  usize = 0;

    if (z.state == G_HEAD) {
        for (z.have < 10 && consumed < src_len) {
            val b: u8 = src[consumed];
            z.buf[z.have] = b;
            hdr_fold(z, b);
            z.have   = z.have + 1;
            consumed = consumed + 1;
        }
        if (z.have < 10) { ret progress(I.NEED_INPUT, consumed, 0); }

        if (z.buf[0] != 0x1F || z.buf[1] != 0x8B) { ret fault(I.Defect.magic{}, consumed, 0); }
        if (z.buf[2] != 8) { ret fault(I.Defect.method{}, consumed, 0); }

        z.flg = z.buf[3];
        if ((z.flg & 0xE0) != 0) { ret fault(I.Defect.flags{}, consumed, 0); }

        after_head(z);
    }

    if (z.state == G_XLEN) {
        for (z.have < 2 && consumed < src_len) {
            val b: u8 = src[consumed];
            z.buf[z.have] = b;
            hdr_fold(z, b);
            z.have   = z.have + 1;
            consumed = consumed + 1;
        }
        if (z.have < 2) { ret progress(I.NEED_INPUT, consumed, 0); }

        z.skip  = z.buf[0]::usize | (z.buf[1]::usize << 8);
        z.state = G_EXTRA;
    }

    if (z.state == G_EXTRA) {
        for (z.skip > 0 && consumed < src_len) {
            hdr_fold(z, src[consumed]);
            z.skip   = z.skip - 1;
            consumed = consumed + 1;
        }
        if (z.skip > 0) { ret progress(I.NEED_INPUT, consumed, 0); }

        after_extra(z);
    }

    if (z.state == G_NAME) {
        var done: bool = false;
        for (!done && consumed < src_len) {
            val b: u8 = src[consumed];
            hdr_fold(z, b);
            consumed = consumed + 1;
            if (b == 0) { done = true; }
        }
        if (!done) { ret progress(I.NEED_INPUT, consumed, 0); }

        after_name(z);
    }

    if (z.state == G_COMMENT) {
        var done: bool = false;
        for (!done && consumed < src_len) {
            val b: u8 = src[consumed];
            hdr_fold(z, b);
            consumed = consumed + 1;
            if (b == 0) { done = true; }
        }
        if (!done) { ret progress(I.NEED_INPUT, consumed, 0); }

        after_comment(z);
    }

    if (z.state == G_HCRC) {
        # the stored value covers the header up to but not including itself
        val want: u32 = crc32.final(z.hcrc) & 0xFFFF;

        for (z.have < 2 && consumed < src_len) {
            z.buf[z.have] = src[consumed];
            z.have   = z.have + 1;
            consumed = consumed + 1;
        }
        if (z.have < 2) { ret progress(I.NEED_INPUT, consumed, 0); }

        val got: u32 = z.buf[0]::u32 | (z.buf[1]::u32 << 8);
        if (got != want) { ret fault(I.Defect.header_checksum{}, consumed, 0); }

        z.state = G_DATA;
    }

    if (z.state == G_DATA) {
        val r: res[I.Progress, I.InflateError] = I.decompress(?z.inf, ?src[consumed], src_len - consumed, dst, dst_len);
        if (sel r.err) { ret res[I.Progress, I.InflateError].err{I.advance(r.err, consumed, 0)}; }

        val p: I.Progress = r.ok;
        consumed = consumed + p.consumed;
        written  = p.written;
        z.crc    = crc32.update(z.crc, dst, written);
        z.isize  = z.isize + written::u64;

        if (p.status != I.DONE) { ret progress(p.status, consumed, written); }

        # the trailer is byte-aligned and the inflater reads ahead, so some of
        # it may already be sitting in its bit buffer
        I.align_to_byte(?z.inf);
        z.state = G_TRAILER;
        z.have  = 0;
    }

    if (z.state == G_TRAILER) {
        for (z.have < 8 && I.buffered_bytes(?z.inf) > 0) {
            z.buf[z.have] = I.pop_buffered(?z.inf);
            z.have = z.have + 1;
        }
        for (z.have < 8 && consumed < src_len) {
            z.buf[z.have] = src[consumed];
            z.have   = z.have + 1;
            consumed = consumed + 1;
        }
        if (z.have < 8) { ret progress(I.NEED_INPUT, consumed, written); }

        val want_crc: u32 = z.buf[0]::u32 | (z.buf[1]::u32 << 8)
                          | (z.buf[2]::u32 << 16) | (z.buf[3]::u32 << 24);
        if (want_crc != crc32.final(z.crc)) { ret fault(I.Defect.checksum{}, consumed, written); }

        val want_size: u32 = z.buf[4]::u32 | (z.buf[5]::u32 << 8)
                           | (z.buf[6]::u32 << 16) | (z.buf[7]::u32 << 24);
        if (want_size != (z.isize & 0xFFFFFFFF)::u32) { ret fault(I.Defect.length{}, consumed, written); }

        z.state = G_BETWEEN;
    }

    ret progress(I.DONE, consumed, written);
}

# record the first failure and report it with the counts this call committed
fun fail(z: *Decompressor, e: I.InflateError, consumed: usize, written: usize) res[I.Progress, I.InflateError] {
    val whole: I.InflateError = I.advance(e, consumed, written);
    z.failure = opt[I.InflateError].some{whole};
    ret res[I.Progress, I.InflateError].err{whole};
}

fun pump(z: *Decompressor, src: *u8, src_len: usize, dst: *u8, dst_len: usize) res[I.Progress, I.InflateError] {
    var consumed: usize = 0;
    var written: usize = 0;
    for (z.state != G_DONE) {
        if (z.state == G_BETWEEN) {
            if (consumed == src_len) {
                if (!z.eof) { ret progress(I.NEED_INPUT, consumed, written); }
                z.state = G_DONE;
                brk;
            }
            member_reset(z);
        }
        val step: res[I.Progress, I.InflateError] = member(z, ?src[consumed], src_len - consumed,
            ?dst[written], dst_len - written);
        if (sel step.err) { ret fail(z, step.err, consumed, written); }
        val p: I.Progress = step.ok;
        consumed = consumed + p.consumed;
        written = written + p.written;
        if (p.status == I.NEED_INPUT && z.eof) { ret fail(z, I.truncated(0, 0), consumed, written); }
        if (p.status != I.DONE) { ret progress(p.status, consumed, written); }
    }
    ret progress(I.DONE, consumed, written);
}

# feed input, advancing buffers by the returned consumed and written counts
# member boundaries require more input until finish declares end-of-input
# output remains unverified until DONE and must be discarded on stream failure
# a zero-capacity output may return OUTPUT_FULL without progress
# ---
# ret: what the call accomplished, or the failure with the counts this call
#      committed before it; a stored failure is re-reported with none, and
#      input after finish is `finished`
pub fun decompress(z: *Decompressor, src: *u8, src_len: usize, dst: *u8, dst_len: usize) res[I.Progress, I.InflateError] {
    if (z.inf.win == nil) { ret res[I.Progress, I.InflateError].err{I.InflateError.closed{}}; }
    if (sel z.failure.some) { ret res[I.Progress, I.InflateError].err{I.settled(z.failure.some)}; }
    if (z.eof) { ret res[I.Progress, I.InflateError].err{I.InflateError.finished{}}; }
    ret pump(z, src, src_len, dst, dst_len);
}

# declare end-of-input after all supplied input has been consumed, then drain
# repeat with output space on OUTPUT_FULL, DONE is idempotent, NEED_INPUT never occurs
# an empty or truncated stream is `truncated`, and the failure persists until
# reset or dnit
pub fun finish(z: *Decompressor, dst: *u8, dst_len: usize) res[I.Progress, I.InflateError] {
    if (z.inf.win == nil) { ret res[I.Progress, I.InflateError].err{I.InflateError.closed{}}; }
    if (sel z.failure.some) { ret res[I.Progress, I.InflateError].err{I.settled(z.failure.some)}; }
    z.eof = true;
    ret pump(z, nil, 0, dst, dst_len);
}

fun drive(z: *Decompressor, src: *u8, src_len: usize, dst: *u8, dst_len: usize) res[usize, I.InflateError] {
    var in_off:  usize = 0;
    var out_off: usize = 0;

    for (!is_done(z)) {
        var r: res[I.Progress, I.InflateError];
        if (in_off == src_len) { r = finish(z, ?dst[out_off], dst_len - out_off); }
        or { r = decompress(z, ?src[in_off], src_len - in_off, ?dst[out_off], dst_len - out_off); }
        if (sel r.err) { ret res[usize, I.InflateError].err{I.advance(r.err, in_off, out_off)}; }

        val p: I.Progress = r.ok;
        in_off  = in_off + p.consumed;
        out_off = out_off + p.written;

        if (p.status == I.OUTPUT_FULL) {
            ret res[usize, I.InflateError].err{I.InflateError.full{I.Committed{consumed: in_off, written: out_off}}};
        }
    }

    ret res[usize, I.InflateError].ok{out_off};
}

# decompress a complete gzip stream into a caller-provided buffer
# ---
# a:       allocator for the decoder's window
# src:     the complete gzip stream, including all members
# src_len: length of that stream
# dst:     where decompressed bytes go
# dst_len: space available at dst
# ret:     bytes written, or the failure; malformed, truncated and full carry
#          the counts committed over the whole call
pub fun decompress_into(a: *A.Allocator, src: *u8, src_len: usize, dst: *u8, dst_len: usize) res[usize, I.InflateError] {
    val ri: res[Decompressor, I.InflateError] = init(a);
    if (sel ri.err) { ret res[usize, I.InflateError].err{ri.err}; }

    var z: Decompressor = ri.ok;
    val out: res[usize, I.InflateError] = drive(?z, src, src_len, dst, dst_len);
    dnit(?z);

    ret out;
}

fun grow(z: *Decompressor, out: *V.Vector[u8], src: *u8, src_len: usize) res[usize, I.InflateError] {
    var in_off: usize = 0;

    for (!is_done(z)) {
        var r: res[I.Progress, I.InflateError];
        if (in_off == src_len) { r = finish(z, ?out.data[out.len], out.cap - out.len); }
        or { r = decompress(z, ?src[in_off], src_len - in_off, ?out.data[out.len], out.cap - out.len); }
        if (sel r.err) { ret res[usize, I.InflateError].err{I.advance(r.err, in_off, out.len)}; }

        val p: I.Progress = r.ok;
        in_off  = in_off + p.consumed;
        out.len = out.len + p.written;

        if (p.status == I.OUTPUT_FULL) {
            var next: usize = out.cap * 2;
            if (out.cap != 0 && next <= out.cap) {
                ret res[usize, I.InflateError].err{I.InflateError.alloc{A.Error.overflow{}}};
            }
            if (next < 4096) { next = 4096; }
            val expanded: res[usize, A.Error] = V.ensure[u8](out, next);
            if (sel expanded.err) { ret res[usize, I.InflateError].err{I.InflateError.alloc{expanded.err}}; }
        }
    }

    ret res[usize, I.InflateError].ok{out.len};
}

# decompress a complete gzip stream into a vector that grows as needed
# ---
# a:       allocator for the decoder's window and the output vector
# src:     the complete gzip stream, including all members
# src_len: length of that stream
# ret:     a vector owning the decompressed bytes, which the caller must dnit,
#          or the failure; on failure the vector is already released, so the
#          committed counts describe output that no longer exists
pub fun decompress_alloc(a: *A.Allocator, src: *u8, src_len: usize) res[V.Vector[u8], I.InflateError] {
    val ri: res[Decompressor, I.InflateError] = init(a);
    if (sel ri.err) { ret res[V.Vector[u8], I.InflateError].err{ri.err}; }

    var z: Decompressor = ri.ok;
    var out: V.Vector[u8] = V.init[u8](a);

    val grown: res[usize, I.InflateError] = grow(?z, ?out, src, src_len);
    dnit(?z);

    if (sel grown.err) {
        V.dnit[u8](?out);
        ret res[V.Vector[u8], I.InflateError].err{grown.err};
    }

    ret res[V.Vector[u8], I.InflateError].ok{out};
}
