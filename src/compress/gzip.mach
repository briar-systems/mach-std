    0xAD, 0x4B, 0x33, 0x4C, 0x22, 0x00, 0x00, 0x00
};

val D_GOOD_HCRC: [34]u8 = [34]u8{
    0x67, 0x7A, 0x69, 0x70, 0x20, 0x77, 0x72, 0x61, 0x70, 0x70, 0x65, 0x72, 0x20, 0x6E, 0x65, 0x67,
    0x61, 0x74, 0x69, 0x76, 0x65, 0x20, 0x63, 0x61, 0x73, 0x65, 0x20, 0x70, 0x61, 0x79, 0x6C, 0x6F,
    0x61, 0x64
};
test "gzip: header with a valid FHCRC is accepted" {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[usize, str] = decompress_into(?a, ?N_G_GOOD_HCRC[0], 56, ?obuf[0], 4096);
    if (R.is_err[usize, str](r)) { ret 1; }

    val n: usize = R.unwrap_ok[usize, str](r);
    if (n != 34) { ret 2; }

    var i: usize = 0;
    for (i < n) {
        if (obuf[i] != D_GOOD_HCRC[i]) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

fun t_copy(dst: *u8, src: *u8, count: usize) {
    var i: usize = 0;
    for (i < count) { dst[i] = src[i]; i = i + 1; }
}

fun t_split(comp: *u8, count: usize, split: usize, room: usize, expected: *u8, expected_len: usize) i32 {
    var a: A.Allocator;
    page.make(?a);
    val created: R.Result[Decompressor, str] = init(?a);
    if (R.is_err[Decompressor, str](created)) { ret 1; }
    var z: Decompressor = R.unwrap_ok[Decompressor, str](created);
    fin { dnit(?z); }
    var read: usize = 0;
    var written: usize = 0;
    var steps: usize = 0;
    for (!is_done(?z) && steps < 4096) {
        var feed: usize = count - read;
        if (read < split) { feed = split - read; }
        var available: usize = room;
        if (available > 4096 - written) { available = 4096 - written; }
        var result: R.Result[I.Progress, str];
        if (read == count) { result = finish(?z, ?obuf[written], available); }
        or { result = decompress(?z, ?comp[read], feed, ?obuf[written], available); }
        if (R.is_err[I.Progress, str](result)) { ret 2; }
        val p: I.Progress = R.unwrap_ok[I.Progress, str](result);
        if (p.consumed > feed || p.written > available) { ret 3; }
        if (read == count && p.status == I.NEED_INPUT) { ret 4; }
        if (p.status == I.DONE && !z.eof) { ret 5; }
        if (p.status != I.DONE && p.consumed == 0 && p.written == 0) { ret 6; }
        read = read + p.consumed;
        written = written + p.written;
        steps = steps + 1;
    }
    if (!is_done(?z) || read != count || written != expected_len) { ret 7; }
    var i: usize = 0;
    for (i < written) {
        if (obuf[i] != expected[i]) { ret 8; }
        i = i + 1;
    }
    ret 0;
}

test "gzip: all member split points preserve output and independent framing" {
    var comp: [242]u8;
    t_copy(?comp[0], ?C_G_PY6[0], 71);
    t_copy(?comp[71], ?C_G_EMPTY[0], 20);
    t_copy(?comp[91], ?C_G_CLI[0], 95);
    t_copy(?comp[186], ?N_G_GOOD_HCRC[0], 56);
    var expected: [152]u8;
    t_copy(?expected[0], ?D_G_PY6[0], 51);
    t_copy(?expected[51], ?D_G_CLI[0], 67);
    t_copy(?expected[118], ?D_GOOD_HCRC[0], 34);
    var split: usize = 0;
    for (split <= 242) {
        if (t_split(?comp[0], 242, split, 1, ?expected[0], 152) != 0) { ret 1; }
        if (t_split(?comp[0], 242, split, 17, ?expected[0], 152) != 0) { ret 2; }
        if (t_split(?comp[0], 242, split, 4096, ?expected[0], 152) != 0) { ret 3; }
        split = split + 1;
    }
    ret check(?comp[0], 242, ?expected[0], 152);
}

test "gzip: later corruption truncation and trailing junk never return prefix success" {
    var comp: [127]u8;
    t_copy(?comp[0], ?C_G_PY6[0], 71);
    t_copy(?comp[71], ?N_G_BAD_CRC[0], 54);
    if (rejects(?comp[0], 125, "gzip checksum mismatch") != 0) { ret 1; }
    t_copy(?comp[71], ?N_G_BAD_ISIZE[0], 54);
    if (rejects(?comp[0], 125, "gzip length mismatch") != 0) { ret 2; }
    t_copy(?comp[71], ?N_G_BAD_MAGIC[0], 54);
    if (rejects(?comp[0], 125, "not a gzip stream") != 0) { ret 3; }
    t_copy(?comp[71], ?N_G_RESERVED_FLAG[0], 54);
    if (rejects(?comp[0], 125, "gzip reserved header flags are set") != 0) { ret 4; }
    t_copy(?comp[71], ?N_G_BAD_HCRC[0], 56);
    if (rejects(?comp[0], 127, "gzip header checksum mismatch") != 0) { ret 5; }
    t_copy(?comp[71], ?N_G_GOOD_HCRC[0], 56);
    var cut: usize = 72;
    for (cut < 127) {
        if (rejects(?comp[0], cut, "truncated gzip stream") != 0) { ret 6; }
        cut = cut + 1;
    }
    comp[71] = 0;
    if (rejects(?comp[0], 72, "truncated gzip stream") != 0) { ret 7; }
    ret rejects(nil, 0, "truncated gzip stream");
}

test "gzip: EOF completion failure reset and destruction have explicit states" {
    var a: A.Allocator;
    page.make(?a);
    val created: R.Result[Decompressor, str] = init(?a);
    if (R.is_err[Decompressor, str](created)) { ret 1; }
    var z: Decompressor = R.unwrap_ok[Decompressor, str](created);
    fin { dnit(?z); }
    val fed: R.Result[I.Progress, str] = decompress(?z, ?C_G_EMPTY[0], 20, nil, 0);
    if (R.is_err[I.Progress, str](fed)) { ret 2; }
    val first: I.Progress = R.unwrap_ok[I.Progress, str](fed);
    if (first.status != I.NEED_INPUT || first.consumed != 20 || first.written != 0 || is_done(?z)) { ret 3; }
    var repeat: u32 = 0;
    for (repeat < 2) {
        val ended: R.Result[I.Progress, str] = finish(?z, nil, 0);
        if (R.is_err[I.Progress, str](ended)) { ret 4; }
        val p: I.Progress = R.unwrap_ok[I.Progress, str](ended);
        if (p.status != I.DONE || p.consumed != 0 || p.written != 0 || !is_done(?z)) { ret 5; }
        repeat = repeat + 1;
    }
    val late: R.Result[I.Progress, str] = decompress(?z, ?C_G_EMPTY[0], 20, nil, 0);
    if (R.is_ok[I.Progress, str](late) || !str_equals(R.unwrap_err[I.Progress, str](late), "gzip input is already finished")) { ret 6; }
    reset(?z);
    val empty: R.Result[I.Progress, str] = finish(?z, nil, 0);
    if (R.is_ok[I.Progress, str](empty) || !str_equals(R.unwrap_err[I.Progress, str](empty), "truncated gzip stream")) { ret 7; }
    val failed: R.Result[I.Progress, str] = decompress(?z, ?C_G_EMPTY[0], 20, nil, 0);
    if (R.is_ok[I.Progress, str](failed) || !str_equals(R.unwrap_err[I.Progress, str](failed), "truncated gzip stream")) { ret 8; }
    reset(?z);
    if (R.is_err[usize, str](drive(?z, ?C_G_PY6[0], 71, ?obuf[0], 51))) { ret 9; }
    if (!dnit(?z) || !dnit(?z)) { ret 10; }
    reset(?z);
    if (is_done(?z) || R.is_ok[I.Progress, str](finish(?z, nil, 0))) { ret 11; }
    ret 0;
}

test "gzip: empty members need no output and full buffers can resume" {
    var a: A.Allocator;
    page.make(?a);
    var empty: [40]u8;
    t_copy(?empty[0], ?C_G_EMPTY[0], 20);
    t_copy(?empty[20], ?C_G_EMPTY[0], 20);
    val nothing: R.Result[usize, str] = decompress_into(?a, ?empty[0], 40, nil, 0);
    if (R.is_err[usize, str](nothing) || R.unwrap_ok[usize, str](nothing) != 0) { ret 1; }
    val created: R.Result[Decompressor, str] = init(?a);
    if (R.is_err[Decompressor, str](created)) { ret 2; }
    var z: Decompressor = R.unwrap_ok[Decompressor, str](created);
    fin { dnit(?z); }
    val first: R.Result[I.Progress, str] = decompress(?z, ?C_G_PY6[0], 71, nil, 0);
    if (R.is_err[I.Progress, str](first)) { ret 3; }
    val p: I.Progress = R.unwrap_ok[I.Progress, str](first);
    if (p.status != I.OUTPUT_FULL || p.written != 0 || p.consumed > 71) { ret 4; }
    val second: R.Result[I.Progress, str] = decompress(?z, ?C_G_PY6[p.consumed], 71 - p.consumed, nil, 0);
    if (R.is_err[I.Progress, str](second)) { ret 5; }
    val q: I.Progress = R.unwrap_ok[I.Progress, str](second);
    if (q.status != I.OUTPUT_FULL || q.written != 0 || q.consumed > 71 - p.consumed) { ret 6; }
    val read: usize = p.consumed + q.consumed;
    val restored: R.Result[usize, str] = drive(?z, ?C_G_PY6[read], 71 - read, ?obuf[0], 51);
    if (R.is_err[usize, str](restored) || R.unwrap_ok[usize, str](restored) != 51) { ret 7; }
    var i: usize = 0;
    for (i < 51) { if (obuf[i] != D_G_PY6[i]) { ret 8; } i = i + 1; }
    ret 0;
}

test "gzip: finishing drains buffered matches through output backpressure" {
    var a: A.Allocator;
    page.make(?a);
    val created: R.Result[Decompressor, str] = init(?a);
    if (R.is_err[Decompressor, str](created)) { ret 1; }
    var z: Decompressor = R.unwrap_ok[Decompressor, str](created);
    fin { dnit(?z); }
    var read: usize = 0;
    var written: usize = 0;
    var drains: usize = 0;
    for (!is_done(?z) && written <= 276) {
        var result: R.Result[I.Progress, str];
        if (read == 69) { result = finish(?z, ?obuf[written], 1); drains = drains + 1; }
        or { result = decompress(?z, ?C_G_STREAM[read], 69 - read, ?obuf[written], 1); }
        if (R.is_err[I.Progress, str](result)) { ret 2; }
        val p: I.Progress = R.unwrap_ok[I.Progress, str](result);
        if (p.consumed > 69 - read || p.written > 1) { ret 3; }
        if (p.status != I.DONE && p.consumed == 0 && p.written == 0) { ret 4; }
        if (read == 69 && p.status == I.NEED_INPUT) { ret 5; }
        read = read + p.consumed;
        written = written + p.written;
    }
    if (!is_done(?z) || drains == 0 || written != 276) { ret 6; }
    var i: usize = 0;
    for (i < 276) { if (obuf[i] != D_G_STREAM[i]) { ret 7; } i = i + 1; }

    var most_drains: usize = 0;
    var cut: usize = 1;
    for (cut < 69) {
        reset(?z);
        read = 0;
        written = 0;
        drains = 0;
        var failed: bool = false;
        var steps: usize = 0;
        for (!failed && written <= 276 && steps < 400) {
            steps = steps + 1;
            val eof: bool = read == cut;
            var result: R.Result[I.Progress, str];
            if (eof) { result = finish(?z, ?obuf[written], 1); }
            or { result = decompress(?z, ?C_G_STREAM[read], cut - read, ?obuf[written], 1); }
            if (R.is_err[I.Progress, str](result)) {
                if (!eof || !str_equals(R.unwrap_err[I.Progress, str](result), "truncated gzip stream")) { ret 8; }
                failed = true;
                brk;
            }
            val p: I.Progress = R.unwrap_ok[I.Progress, str](result);
            if (p.consumed > cut - read || p.written > 1 || p.status == I.DONE) { ret 9; }
            if (p.consumed == 0 && p.written == 0) { ret 10; }
            if (eof) {
                if (p.status != I.OUTPUT_FULL || p.consumed != 0) { ret 11; }
                drains = drains + 1;
            }
            read = read + p.consumed;
            written = written + p.written;
        }
        if (!failed || is_done(?z) || written > 276) { ret 12; }
        i = 0;
        for (i < written) { if (obuf[i] != D_G_STREAM[i]) { ret 13; } i = i + 1; }
        val repeated: R.Result[I.Progress, str] = finish(?z, nil, 0);
        if (R.is_ok[I.Progress, str](repeated) || !str_equals(R.unwrap_err[I.Progress, str](repeated), "truncated gzip stream")) { ret 14; }
        if (drains > most_drains) { most_drains = drains; }
        cut = cut + 1;
    }
    if (most_drains < 2) { ret 15; }
    ret 0;
}

test "gzip: allocation refusal frees the window and cumulative output" {
    var comp: [1054]u8;
    t_copy(?comp[0], ?C_G_LARGE[0], 527);
    t_copy(?comp[527], ?C_G_LARGE[0], 527);
    var ordinal: usize = 1;
    for (ordinal <= 32) {
        var tracker: T.Testing;
        val made: err[A.Error] = T.make(?tracker);
        if (sel made.err) { ret 1; }
        T.fail_at_ordinal(?tracker, ordinal);
        val result: R.Result[V.Vector[u8], str] = decompress_alloc(T.allocator_of(?tracker), ?comp[0], 1054);
        var accepted: bool = false;
        if (R.is_ok[V.Vector[u8], str](result)) {
            var out: V.Vector[u8] = R.unwrap_ok[V.Vector[u8], str](result);
            accepted = out.len == 24000;
            var i: usize = 0;
            for (i < out.len) {
                if (out.data[i] != expected_pseudo(i % 12000)) { accepted = false; }
                i = i + 1;
            }
            V.dnit[u8](?out);
        }
        val leaked: bool = T.live_count(?tracker) != 0 || T.double_free_count(?tracker) != 0;
        val attempts: usize = T.attempt_count(?tracker);
        T.dnit(?tracker);
        if (leaked) { ret 2; }
        if (accepted) { if (attempts >= ordinal) { ret 3; } ret 0; }
        if (R.is_ok[V.Vector[u8], str](result) || attempts != ordinal) { ret 4; }
        ordinal = ordinal + 1;
    }
    ret 5;
}

test "gzip: a malformed later member releases allocated prefix output" {
    var comp: [581]u8;
    t_copy(?comp[0], ?C_G_LARGE[0], 527);
    t_copy(?comp[527], ?N_G_BAD_CRC[0], 54);
    var tracker: T.Testing;
    val made: err[A.Error] = T.make(?tracker);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?tracker); }
    val result: R.Result[V.Vector[u8], str] = decompress_alloc(T.allocator_of(?tracker), ?comp[0], 581);
    if (R.is_ok[V.Vector[u8], str](result)) {
        var unexpected: V.Vector[u8] = R.unwrap_ok[V.Vector[u8], str](result);
        V.dnit[u8](?unexpected);
        ret 2;
    }
    if (!str_equals(R.unwrap_err[V.Vector[u8], str](result), "gzip checksum mismatch")) { ret 3; }
    if (T.live_count(?tracker) != 0 || T.double_free_count(?tracker) != 0) { ret 4; }
    ret 0;
}
