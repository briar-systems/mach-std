# pseudo-random formula used to recompute a large procedural fixture without
# embedding its expected output
fun expected_pseudo(i: usize) u8 {
    ret ((i * 37 + i / 251) % 256)::u8;
}

var obuf: [4096]u8;

fun check(comp: *u8, comp_len: usize, orig: *u8, orig_len: usize) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[usize, str] = decompress_into(?a, comp, comp_len, ?obuf[0], 4096);
    if (R.is_err[usize, str](r)) { ret 1; }

    val n: usize = R.unwrap_ok[usize, str](r);
    if (n != orig_len) { ret 2; }

    var i: usize = 0;
    for (i < n) {
        if (obuf[i] != orig[i]) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

# verify a decompressed stream against a byte generator rather than an
# embedded array, and via the allocating API since the output is too large
# for obuf
fun gen_check_alloc(comp: *u8, comp_len: usize, orig_len: usize, gen: fun(usize) u8) i32 {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[V.Vector[u8], str] = decompress_alloc(?a, comp, comp_len);
    if (R.is_err[V.Vector[u8], str](r)) { ret 1; }

    var v: V.Vector[u8] = R.unwrap_ok[V.Vector[u8], str](r);
    if (v.len != orig_len) { V.dnit[u8](?v); ret 2; }

    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] != gen(i)) { V.dnit[u8](?v); ret 3; }
        i = i + 1;
    }

    V.dnit[u8](?v);
    ret 0;
}

# drive the streaming API with small, awkward chunk sizes so decoding must
# suspend and resume across the header fields, the deflate body, and the
# trailer
fun stream_check(comp: *u8, comp_len: usize, in_chunk: usize, out_chunk: usize, orig: *u8, orig_len: usize) i32 {
    var a: A.Allocator;
    page.make(?a);

    val ri: R.Result[Decompressor, str] = init(?a);
    if (R.is_err[Decompressor, str](ri)) { ret 1; }
    var z: Decompressor = R.unwrap_ok[Decompressor, str](ri);

    var in_off:  usize = 0;
    var out_off: usize = 0;
    var guard:   usize = 0;

    for (guard < 200000 && !is_done(?z)) {
        guard = guard + 1;

        var feed: usize = in_chunk;
        if (in_off + feed > comp_len) { feed = comp_len - in_off; }

        var room: usize = out_chunk;
        if (out_off + room > 4096) { room = 4096 - out_off; }

        var r: R.Result[I.Progress, str];
        if (in_off == comp_len) { r = finish(?z, ?obuf[out_off], room); }
        or { r = decompress(?z, ?comp[in_off], feed, ?obuf[out_off], room); }
        if (R.is_err[I.Progress, str](r)) { dnit(?z); ret 2; }

        val p: I.Progress = R.unwrap_ok[I.Progress, str](r);
        in_off  = in_off + p.consumed;
        out_off = out_off + p.written;

        if (p.consumed > feed || p.written > room) { dnit(?z); ret 3; }
    }

    val done: bool = is_done(?z);
    dnit(?z);
    if (!done) { ret 4; }
    if (in_off != comp_len)  { ret 5; }
    if (out_off != orig_len) { ret 6; }

    var i: usize = 0;
    for (i < out_off) {
        if (obuf[i] != orig[i]) { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test "gzip: round trip from python at level 6" {
    ret check(?C_G_PY6[0], 71, ?D_G_PY6[0], 51);
}

test "gzip: round trip from python at level 9" {
    ret check(?C_G_PY9[0], 71, ?D_G_PY9[0], 54);
}

test "gzip: exactly-sized output reaches the trailer" {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[usize, str] = decompress_into(?a, ?C_G_PY6[0], 71, ?obuf[0], 51);
    if (R.is_err[usize, str](r)) { ret 1; }
    if (R.unwrap_ok[usize, str](r) != 51) { ret 2; }
    ret 0;
}

val C_G_EMPTY: [20]u8 = [20]u8{
    0x1F, 0x8B, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0xFF,
    0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};

test "gzip: empty member fits a zero-length output buffer" {
    var a: A.Allocator;
    page.make(?a);

    val r: R.Result[usize, str] = decompress_into(?a, ?C_G_EMPTY[0], 20, ?obuf[0], 0);
    if (R.is_err[usize, str](r)) { ret 1; }
    if (R.unwrap_ok[usize, str](r) != 0) { ret 2; }
    ret 0;
}

test "gzip: round trip from the gzip CLI with a stored filename" {
    ret check(?C_G_CLI[0], 95, ?D_G_CLI[0], 67);
}

test "gzip: large pseudo-random stream round trip" {
    ret gen_check_alloc(?C_G_LARGE[0], 527, 12000, expected_pseudo);
}

test "gzip: streaming with 3-byte input and 5-byte output chunks" {
    ret stream_check(?C_G_STREAM[0], 69, 3, 5, ?D_G_STREAM[0], 276);
}

