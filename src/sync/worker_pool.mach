# bounded caller-owned worker pool

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.canonical.res;
use std.types.canonical.err;
use std.chrono.time;
use std.sync.atomic;
use std.sync.cancel;
use std.sync.channel;
use std.sync.condition;
use std.sync.mutex;
use std.sync.thread;
use std.system.os;

$if ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}

pub def TaskFun: fun(ptr) bool;

# context is borrowed after acceptance and returned by completion or abort
pub rec Task {
    context: ptr;
    run:     TaskFun;
}

# the outcome of a pool operation, and the pool's lifecycle state
# ---
# invalid:      nil operands, an unmade pool, a task without a run function,
#               an abort output too small, or an operation the state refuses
# accepted:     the task is queued (submit) or the pool is open (make, state)
# queue_full:   no slot was free (try_submit)
# pool_closed:  the queue no longer accepts work
# timed_out:    the absolute deadline passed first
# cancelled:    the scope was cancelled first
# spawn_failed: a worker could not be spawned; the pool is joined and holds
#               the refusal, ready for destroy
# draining:     new work is refused while workers finish accepted tasks
# aborting:     queued tasks were returned; in-flight tasks finish
# joined:       every worker resource is released
# join_failed:  a worker join was refused; the first refusal is carried
# joining:      another caller is joining
pub tag Status: u8 {
    invalid;
    accepted;
    queue_full;
    pool_closed;
    timed_out;
    cancelled;
    spawn_failed: thread.ThreadError;
    draining;
    aborting;
    joined;
    join_failed: thread.ThreadError;
    joining;
}

# a refused pool destruction
# ---
# invalid:  a nil or unmade pool
# unjoined: the pool has not reached joined
# busy:     callers are still waiting on join
# queue:    the queue refused destruction
pub tag StateError: u8 { invalid; unjoined; busy; queue: channel.StateError; }

pub def Operation: err[StateError];

val STATE_OPEN:     u8 = 0;
val STATE_DRAINING: u8 = 1;
val STATE_ABORTING: u8 = 2;
val STATE_JOINED:   u8 = 3;
val STATE_JOIN_FAILED: u8 = 4;
val STATE_JOINING:     u8 = 5;

pub rec Worker {
    pool:  *Pool;
    index: usize;
}

# all backing arrays and task contexts are caller-owned
pub rec Pool {
    queue:        channel.Channel[Task];
    threads:      *thread.Thread;
    workers:      *Worker;
    worker_count: usize;
    started:      usize;
    state:        u8;
    completed:    i64;
    failed:       i64;
    thread_error: thread.ThreadError;
    has_error:    bool;
    initialized:  bool;
    lock:         mutex.Mutex;
    joined:       condition.Condition;
}

pub rec Stats {
    completed: usize;
    failed:    usize;
    queued:    usize;
}

fun worker_entry(arg: *u8) {
    val worker: *Worker = arg::*Worker;
    val pool: *Pool = worker.pool;
    var running: bool = true;
    for (running) {
        val status: channel.Status[Task] = channel.receive[Task](?pool.queue);
        if (sel status.received) {
            val task: Task = status.received;
            val succeeded: bool = task.run(task.context);
            atomic.fetch_add(?pool.completed, 1);
            if (!succeeded) { atomic.fetch_add(?pool.failed, 1); }
        }
        or {
            running = false;
        }
    }
}

fun task_valid(task: Task) bool {
    ret task.run::usize != 0;
}

fun channel_status(status: channel.Status[Task]) Status {
    if (sel status.sent)      { ret Status.accepted{}; }
    if (sel status.full)      { ret Status.queue_full{}; }
    if (sel status.closed)    { ret Status.pool_closed{}; }
    if (sel status.timed_out) { ret Status.timed_out{}; }
    if (sel status.cancelled) { ret Status.cancelled{}; }
    ret Status.invalid{};
}

fun record_error(pool: *Pool, e: thread.ThreadError) {
    if (pool.has_error) { ret; }
    pool.thread_error = e;
    pool.has_error = true;
}

# workers are unfair, task failure is counted, and the worker continues
# callbacks must not unwind or reclaim their context before pool ownership ends
pub fun make_with_config(pool: *Pool, queue_storage: *Task, queue_capacity: usize, threads: *thread.Thread, workers: *Worker, worker_count: usize, config: *thread.Config) Status {
    if (pool == nil || queue_storage == nil || queue_capacity == 0 || threads == nil || workers == nil || worker_count == 0 || config == nil) { ret Status.invalid{}; }
    val queue: channel.Operation = channel.make[Task](?pool.queue, queue_storage, queue_capacity);
    if (sel queue.err) { ret Status.invalid{}; }
    pool.threads = threads;
    pool.workers = workers;
    pool.worker_count = worker_count;
    pool.started = 0;
    pool.state = STATE_OPEN;
    pool.completed = 0;
    pool.failed = 0;
    pool.thread_error = thread.ThreadError.invalid{};
    pool.has_error = false;
    pool.initialized = true;
    pool.lock = mutex.make();
    pool.joined = condition.make();

    var i: usize = 0;
    for (i < worker_count) {
        pool.workers[i] = Worker{pool: pool, index: i};
        val spawned: thread.Operation = thread.spawn_with_config(worker_entry, (?pool.workers[i])::*u8, config, ?pool.threads[i]);
        if (sel spawned.err) {
            channel.close[Task](?pool.queue);
            var joined: usize = 0;
            var join_failed: bool = false;
            for (joined < i) {
                val result: thread.Operation = thread.join(?pool.threads[joined]);
                if (sel result.err) {
                    record_error(pool, result.err);
                    join_failed = true;
                }
                joined = joined + 1;
            }
            pool.started = i;
            record_error(pool, spawned.err);
            if (join_failed) { pool.state = STATE_JOIN_FAILED; }
            or { pool.state = STATE_JOINED; }
            ret Status.spawn_failed{spawned.err};
        }
        pool.started = i + 1;
        i = i + 1;
    }
    ret Status.accepted{};
}

pub fun make(pool: *Pool, queue_storage: *Task, queue_capacity: usize, threads: *thread.Thread, workers: *Worker, worker_count: usize) Status {
    var config: thread.Config;
    thread.config_default(?config);
    ret make_with_config(pool, queue_storage, queue_capacity, threads, workers, worker_count, ?config);
}

# rejected tasks and their contexts remain submitter-owned
pub fun try_submit(pool: *Pool, task: Task) Status {
    if (pool == nil || !pool.initialized || !task_valid(task)) { ret Status.invalid{}; }
    ret channel_status(channel.try_send[Task](?pool.queue, task));
}

pub fun submit(pool: *Pool, task: Task) Status {
    if (pool == nil || !pool.initialized || !task_valid(task)) { ret Status.invalid{}; }
    ret channel_status(channel.send[Task](?pool.queue, task));
}

pub fun submit_until(pool: *Pool, task: Task, deadline: time.Time) Status {
    if (pool == nil || !pool.initialized || !task_valid(task)) { ret Status.invalid{}; }
    ret channel_status(channel.send_until[Task](?pool.queue, task, deadline));
}

pub fun submit_scoped(pool: *Pool, scope: *cancel.Scope, task: Task) Status {
    if (pool == nil || !pool.initialized || !task_valid(task)) { ret Status.invalid{}; }
    ret channel_status(channel.send_scoped[Task](?pool.queue, scope, task));
}

# drain rejects new work while workers finish every accepted task
pub fun close_drain(pool: *Pool) Status {
    if (pool == nil || !pool.initialized) { ret Status.invalid{}; }
    mutex.lock(?pool.lock);
    if (pool.state != STATE_OPEN) {
        val status: Status = state_locked(pool);
        mutex.unlock(?pool.lock);
        ret status;
    }
    pool.state = STATE_DRAINING;
    channel.close[Task](?pool.queue);
    mutex.unlock(?pool.lock);
    ret Status.draining{};
}

# abort returns every task still owned by the queue in fifo order
# a task already owned by a worker runs to completion before join returns
pub fun close_abort(pool: *Pool, rejected: *Task, rejected_capacity: usize, rejected_len: *usize) Status {
    if (pool == nil || rejected_len == nil || !pool.initialized) { ret Status.invalid{}; }
    mutex.lock(?pool.lock);
    if (pool.state == STATE_ABORTING || pool.state == STATE_JOINED || pool.state == STATE_JOIN_FAILED || pool.state == STATE_JOINING) {
        val status: Status = state_locked(pool);
        mutex.unlock(?pool.lock);
        ret status;
    }
    val result: channel.Status[Task] = channel.close_abort[Task](?pool.queue, rejected, rejected_capacity, rejected_len);
    if (!sel result.aborted) {
        mutex.unlock(?pool.lock);
        ret Status.invalid{};
    }
    pool.state = STATE_ABORTING;
    mutex.unlock(?pool.lock);
    ret Status.aborting{};
}

# join is valid after drain or abort and releases every worker resource
# callbacks must not join their own pool
pub fun join(pool: *Pool) Status {
    if (pool == nil || !pool.initialized) { ret Status.invalid{}; }
    mutex.lock(?pool.lock);
    for (pool.state == STATE_JOINING) {
        condition.wait(?pool.joined, ?pool.lock);
    }
    if (pool.state == STATE_OPEN) {
        mutex.unlock(?pool.lock);
        ret Status.invalid{};
    }
    if (pool.state == STATE_JOINED) {
        mutex.unlock(?pool.lock);
        ret Status.joined{};
    }
    pool.state = STATE_JOINING;
    mutex.unlock(?pool.lock);

    var failed: bool = false;
    var first: thread.ThreadError = thread.ThreadError.invalid{};
    var i: usize = 0;
    for (i < pool.started) {
        if (pool.threads[i].done == 0) {
            val result: thread.Operation = thread.join(?pool.threads[i]);
            if (sel result.err) {
                if (!failed) { first = result.err; }
                failed = true;
            }
        }
        i = i + 1;
    }
    mutex.lock(?pool.lock);
    if (failed) {
        pool.thread_error = first;
        pool.has_error = true;
        pool.state = STATE_JOIN_FAILED;
        condition.broadcast(?pool.joined);
        mutex.unlock(?pool.lock);
        ret Status.join_failed{first};
    }
    pool.has_error = false;
    pool.state = STATE_JOINED;
    condition.broadcast(?pool.joined);
    mutex.unlock(?pool.lock);
    ret Status.joined{};
}

pub fun shutdown_drain(pool: *Pool) Status {
    val closing: Status = close_drain(pool);
    if (!sel closing.draining && !sel closing.aborting && !sel closing.joined) { ret closing; }
    ret join(pool);
}

pub fun shutdown_abort(pool: *Pool, rejected: *Task, rejected_capacity: usize, rejected_len: *usize) Status {
    val closing: Status = close_abort(pool, rejected, rejected_capacity, rejected_len);
    if (!sel closing.aborting && !sel closing.joined) { ret closing; }
    ret join(pool);
}

fun state_locked(pool: *Pool) Status {
    if (pool.state == STATE_DRAINING)    { ret Status.draining{}; }
    if (pool.state == STATE_ABORTING)    { ret Status.aborting{}; }
    if (pool.state == STATE_JOINED)      { ret Status.joined{}; }
    if (pool.state == STATE_JOIN_FAILED) { ret Status.join_failed{pool.thread_error}; }
    if (pool.state == STATE_JOINING)     { ret Status.joining{}; }
    ret Status.accepted{};
}

pub fun state(pool: *Pool) Status {
    if (pool == nil || !pool.initialized) { ret Status.invalid{}; }
    mutex.lock(?pool.lock);
    val result: Status = state_locked(pool);
    mutex.unlock(?pool.lock);
    ret result;
}

# the portable code of the first retained worker refusal, 0 when none
pub fun last_thread_error(pool: *Pool) i64 {
    if (pool == nil || !pool.initialized) { ret thread.ERROR_INVALID; }
    mutex.lock(?pool.lock);
    var result: i64 = 0;
    if (pool.has_error) { result = thread.code(pool.thread_error); }
    mutex.unlock(?pool.lock);
    ret result;
}

pub fun stats(pool: *Pool) Stats {
    if (pool == nil || !pool.initialized) { ret Stats{completed: 0, failed: 0, queued: 0}; }
    ret Stats{
        completed: atomic.load(?pool.completed)::usize,
        failed: atomic.load(?pool.failed)::usize,
        queued: channel.count[Task](?pool.queue),
    };
}

# destruction is valid only after join and does not own caller storage
# ---
# ret: ok once destroyed, invalid for a nil or unmade pool, unjoined before
#      join completed, busy while joiners wait, or the queue's own refusal
pub fun destroy(pool: *Pool) Operation {
    if (pool == nil || !pool.initialized) { ret Operation.err{StateError.invalid{}}; }
    mutex.lock(?pool.lock);
    if (pool.state != STATE_JOINED) {
        mutex.unlock(?pool.lock);
        ret Operation.err{StateError.unjoined{}};
    }
    if (condition.waiter_count(?pool.joined) != 0) {
        mutex.unlock(?pool.lock);
        ret Operation.err{StateError.busy{}};
    }
    val queue: channel.Operation = channel.destroy[Task](?pool.queue);
    if (sel queue.err) {
        mutex.unlock(?pool.lock);
        ret Operation.err{StateError.queue{queue.err}};
    }
    pool.threads = nil;
    pool.workers = nil;
    pool.worker_count = 0;
    pool.started = 0;
    pool.initialized = false;
    mutex.unlock(?pool.lock);
    ret Operation.ok{};
}

fun native_threads_supported() bool {
    $if ($mach.build.os == $mach.os.windows) {
        if (windows.running_under_wine()) { ret false; }
    }
    ret true;
}

fun accepted(s: Status) bool { ret sel s.accepted; }
fun is_joined(s: Status) bool { ret sel s.joined; }
fun is_draining(s: Status) bool { ret sel s.draining; }
fun is_aborting(s: Status) bool { ret sel s.aborting; }
fun is_joining(s: Status) bool { ret sel s.joining; }
fun is_queue_full(s: Status) bool { ret sel s.queue_full; }
fun is_timed_out(s: Status) bool { ret sel s.timed_out; }
fun is_cancelled(s: Status) bool { ret sel s.cancelled; }
fun destroyed(r: Operation) bool { ret sel r.ok; }

rec CountTask {
    count:   *i64;
    succeed: bool;
}

fun count_task(context: ptr) bool {
    val task: *CountTask = context::*CountTask;
    atomic.fetch_add(task.count, 1);
    ret task.succeed;
}

test "worker pool: drain runs every accepted task and records failures" {
    if (!native_threads_supported()) { ret 0; }
    var queue_storage: [4]Task;
    var threads: [2]thread.Thread;
    var workers: [2]Worker;
    var pool: Pool;
    if (!accepted(make(?pool, (?queue_storage)::*Task, 4, (?threads)::*thread.Thread, (?workers)::*Worker, 2))) { ret 1; }

    var count: i64 = 0;
    var contexts: [6]CountTask;
    var i: usize = 0;
    for (i < 6) {
        contexts[i] = CountTask{count: ?count, succeed: i != 3};
        val task: Task = Task{context: ?contexts[i], run: count_task};
        if (!accepted(submit(?pool, task))) { ret 2; }
        i = i + 1;
    }
    val before_join: Operation = destroy(?pool);
    if (!sel before_join.err) { ret 3; }
    if (!sel before_join.err.unjoined) { ret 4; }
    if (!is_joined(shutdown_drain(?pool))) { ret 5; }
    val result: Stats = stats(?pool);
    if (atomic.load(?count) != 6 || result.completed != 6 || result.failed != 1 || result.queued != 0) { ret 6; }
    if (last_thread_error(?pool) != 0) { ret 7; }
    if (!destroyed(destroy(?pool))) { ret 8; }
    val again: Operation = destroy(?pool);
    if (!sel again.err) { ret 9; }
    if (!sel again.err.invalid) { ret 10; }
    ret 0;
}

test "worker pool: spawn failure retains an initialized pool for destruction" {
    var queue_storage: [1]Task;
    var threads: [1]thread.Thread;
    var workers: [1]Worker;
    var config: thread.Config;
    thread.config_default(?config);
    config.stack_reserve = 1;
    var pool: Pool;
    val made: Status = make_with_config(?pool, (?queue_storage)::*Task, 1, (?threads)::*thread.Thread, (?workers)::*Worker, 1, ?config);
    if (!sel made.spawn_failed) { ret 1; }
    if (!sel made.spawn_failed.invalid) { ret 2; }
    if (!is_joined(state(?pool)) || last_thread_error(?pool) != thread.ERROR_INVALID) { ret 3; }
    if (!destroyed(destroy(?pool))) { ret 4; }
    ret 0;
}

rec BlockingTask {
    entered: *i64;
    release: *i64;
}

fun blocking_task(context: ptr) bool {
    val task: *BlockingTask = context::*BlockingTask;
    atomic.store(task.entered, 1);
    os.thread_wake(task.entered);
    for (atomic.load(task.release) == 0) { os.thread_wait(task.release, 0); }
    ret true;
}

rec JoinStateTask {
    pool:     *Pool;
    observed: *i64;
}

fun observe_joining_task(context: ptr) bool {
    val task: *JoinStateTask = context::*JoinStateTask;
    for (!is_joining(state(task.pool))) { os.sleep(1000000); }
    atomic.store(task.observed, 1);
    ret true;
}

test "worker pool: join releases the pool lock while callbacks finish" {
    if (!native_threads_supported()) { ret 0; }
    var queue_storage: [1]Task;
    var threads: [1]thread.Thread;
    var workers: [1]Worker;
    var pool: Pool;
    if (!accepted(make(?pool, (?queue_storage)::*Task, 1, (?threads)::*thread.Thread, (?workers)::*Worker, 1))) { ret 1; }

    var observed: i64 = 0;
    var context: JoinStateTask = JoinStateTask{pool: ?pool, observed: ?observed};
    if (!accepted(submit(?pool, Task{context: ?context, run: observe_joining_task}))) { ret 2; }
    if (!is_draining(close_drain(?pool)) || !is_joined(join(?pool))) { ret 3; }
    if (atomic.load(?observed) != 1) { ret 4; }
    if (!destroyed(destroy(?pool))) { ret 5; }
    ret 0;
}

test "worker pool: abort returns queued tasks while in-flight work completes" {
    if (!native_threads_supported()) { ret 0; }
    var queue_storage: [3]Task;
    var threads: [1]thread.Thread;
    var workers: [1]Worker;
    var pool: Pool;
    if (!accepted(make(?pool, (?queue_storage)::*Task, 3, (?threads)::*thread.Thread, (?workers)::*Worker, 1))) { ret 1; }

    var entered: i64 = 0;
    var release: i64 = 0;
    var blocker: BlockingTask = BlockingTask{entered: ?entered, release: ?release};
    if (!accepted(submit(?pool, Task{context: ?blocker, run: blocking_task}))) { ret 2; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }

    var count: i64 = 0;
    var contexts: [4]CountTask;
    var i: usize = 0;
    for (i < 3) {
        contexts[i] = CountTask{count: ?count, succeed: true};
        if (!accepted(try_submit(?pool, Task{context: ?contexts[i], run: count_task}))) { ret 3; }
        i = i + 1;
    }
    contexts[3] = CountTask{count: ?count, succeed: true};
    if (!is_queue_full(try_submit(?pool, Task{context: ?contexts[3], run: count_task}))) { ret 4; }
    val started: time.Clock = time.monotonic();
    if (sel started.err) { ret 4; }
    val deadline: time.Time = time.time_add(started.ok, 1000000);
    if (!is_timed_out(submit_until(?pool, Task{context: ?contexts[3], run: count_task}, deadline))) { ret 4; }
    var scope: cancel.Scope;
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    val made_scope: cancel.Operation = cancel.make_root(?scope, false, none);
    if (sel made_scope.err) { ret 4; }
    val cancelled: cancel.Transition = cancel.cancel(?scope);
    if (sel cancelled.err) { ret 4; }
    if (!is_cancelled(submit_scoped(?pool, ?scope, Task{context: ?contexts[3], run: count_task}))) { ret 4; }
    val scope_destroyed: cancel.Operation = cancel.destroy(?scope);
    if (sel scope_destroyed.err) { ret 4; }

    var rejected: [3]Task;
    var rejected_len: usize = 0;
    if (!is_aborting(close_abort(?pool, (?rejected)::*Task, 3, ?rejected_len)) || rejected_len != 3) { ret 5; }
    i = 0;
    for (i < 3) {
        if (rejected[i].context != (?contexts[i])::ptr) { ret 6; }
        i = i + 1;
    }
    atomic.store(?release, 1);
    os.thread_wake(?release);
    if (!is_joined(join(?pool)) || atomic.load(?count) != 0) { ret 7; }
    val result: Stats = stats(?pool);
    if (result.completed != 1 || result.failed != 0 || result.queued != 0) { ret 8; }
    if (!destroyed(destroy(?pool))) { ret 9; }
    ret 0;
}
