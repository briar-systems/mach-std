# condition variable over a generation word

use std.chrono.time;
use io_error: std.io.error;
use std.sync.atomic;
use std.system.capability;
use std.types.size.usize;

$if (capability.HAS_CLOCK && capability.HAS_THREADS) {
    use std.sync.mutex;
    use std.sync.thread;
    use std.system.os;
}
$or {
    $error("std.sync.condition needs the clock and threads capabilities (std.system.capability.HAS_CLOCK, HAS_THREADS)");
}

pub rec Condition {
    generation: i64;
    waiters:    i64;
}

# the outcome of a timed wait
# ---
# invalid:   a nil condition or mutex, or a deadline outside the target range
# failed:    the native wait refused, with its negative code
# timed_out: the absolute deadline passed before a notification
# notified:  woken by signal, broadcast or a spurious target wakeup
pub tag WaitStatus: u8 { invalid; failed: i64; timed_out; notified; }

# conditions are unfair and callers must always wait in a predicate loop
# target waits may wake spuriously and signal may be observed by any waiter
# predicate access and notification must use the same caller-owned mutex
# failure while holding the paired mutex does not poison the condition
# conditions own no target handle and may be discarded only without waiters
pub fun make() Condition {
    ret Condition{generation: 0, waiters: 0};
}

# generation closes the race between releasing the mutex and sleeping
pub fun wait(c: *Condition, m: *mutex.Mutex) {
    val observed: i64 = atomic.load(?c.generation);
    atomic.fetch_add(?c.waiters, 1);
    mutex.unlock(m);
    os.thread_wait(?c.generation, observed);
    mutex.lock(m);
    atomic.fetch_sub(?c.waiters, 1);
}

# the deadline is an absolute monotonic instant and never expires early
pub fun wait_until(c: *Condition, m: *mutex.Mutex, deadline: time.Instant) WaitStatus {
    if (c == nil || m == nil || deadline.sec < 0 || deadline.nsec < 0 || deadline.nsec >= 1000000000) { ret WaitStatus.invalid{}; }
    val observed: i64 = atomic.load(?c.generation);
    atomic.fetch_add(?c.waiters, 1);
    mutex.unlock(m);
    var native_deadline: os.Timespec = os.Timespec{sec: deadline.sec, nsec: deadline.nsec};
    val result:          i64         = os.thread_wait_until(?c.generation, observed, ?native_deadline);
    mutex.lock(m);
    atomic.fetch_sub(?c.waiters, 1);
    if (os.error_kind(result) == io_error.TIMEOUT) { ret WaitStatus.timed_out{}; }
    if (result < 0)                                { ret WaitStatus.failed{result}; }
    ret WaitStatus.notified{};
}

pub fun signal(c: *Condition) {
    atomic.fetch_add(?c.generation, 1);
    if (atomic.load(?c.waiters) > 0) {
        os.thread_wake(?c.generation);
    }
}

pub fun broadcast(c: *Condition) {
    val count: i64 = atomic.load(?c.waiters);
    atomic.fetch_add(?c.generation, 1);
    var i: i64 = 0;
    for (i < count) {
        os.thread_wake(?c.generation);
        i = i + 1;
    }
}

# this diagnostic result is stale as soon as it is returned
pub fun waiter_count(c: *Condition) i64 {
    ret atomic.load(?c.waiters);
}

rec WaitContext {
    mutex:    *mutex.Mutex;
    cond:     *Condition;
    ready:    *i64;
    observed: *i64;
}

fun predicate_worker(arg: *u8) {
    val ctx: *WaitContext = arg::*WaitContext;
    mutex.lock(ctx.mutex);
    for (atomic.load(ctx.ready) == 0) {
        wait(ctx.cond, ctx.mutex);
    }
    atomic.fetch_add(ctx.observed, 1);
    mutex.unlock(ctx.mutex);
}

test condition__wait_releases_and_reacquires_its_mutex {
    var m:        mutex.Mutex = mutex.make();
    var c:        Condition   = make();
    var ready:    i64         = 0;
    var observed: i64         = 0;
    var ctx:      WaitContext = WaitContext{mutex: ?m, cond: ?c, ready: ?ready, observed: ?observed};
    var t:        thread.Thread;

    thread.spawn_with(predicate_worker, (?ctx)::*u8, ?t);
    if (t.tid < 0) { ret 1; }
    for (waiter_count(?c) != 1) { atomic.spin_hint(); }

    mutex.lock(?m);
    atomic.store(?ready, 1);
    signal(?c);
    mutex.unlock(?m);

    thread.join(?t);
    if (atomic.load(?observed) != 1) { ret 1; }
    if (waiter_count(?c) != 0)       { ret 1; }
    ret 0;
}

test condition__broadcast_releases_every_predicate_waiter {
    var m:        mutex.Mutex = mutex.make();
    var c:        Condition   = make();
    var ready:    i64         = 0;
    var observed: i64         = 0;
    var ctx:      WaitContext = WaitContext{mutex: ?m, cond: ?c, ready: ?ready, observed: ?observed};
    var threads:  [3]thread.Thread;
    var i:        usize       = 0;

    for (i < 3) {
        thread.spawn_with(predicate_worker, (?ctx)::*u8, ?threads[i]);
        if (threads[i].tid < 0) {
            mutex.lock(?m);
            atomic.store(?ready, 1);
            broadcast(?c);
            mutex.unlock(?m);
            var j: usize = 0;
            for (j < i) {
                thread.join(?threads[j]);
                j = j + 1;
            }
            ret 1;
        }
        i = i + 1;
    }

    for (waiter_count(?c) != 3) { atomic.spin_hint(); }
    mutex.lock(?m);
    atomic.store(?ready, 1);
    broadcast(?c);
    mutex.unlock(?m);

    i = 0;
    for (i < 3) {
        thread.join(?threads[i]);
        i = i + 1;
    }
    if (atomic.load(?observed) != 3) { ret 1; }
    if (waiter_count(?c) != 0)       { ret 1; }
    ret 0;
}

# a timed wait sleeps to an absolute monotonic deadline, and a deadline that is
# not a valid instant is refused without waiting
test condition__timed_wait_honours_or_refuses_its_deadline {
    var m:       mutex.Mutex       = mutex.make();
    var c:       Condition         = make();
    val started: time.InstantClock = time.instant();
    if (sel started.err) { ret 1; }
    val deadline: time.Instant = time.instant_add(started.ok, 20000000);
    mutex.lock(?m);
    val status:   WaitStatus        = wait_until(?c, ?m, deadline);
    val finished: time.InstantClock = time.instant();
    mutex.unlock(?m);
    if (sel finished.err)                                                    { ret 2; }
    if (!sel status.timed_out || time.instant_before(finished.ok, deadline)) { ret 3; }
    if (waiter_count(?c) != 0)                                               { ret 4; }

    mutex.lock(?m);
    val invalid: WaitStatus = wait_until(?c, ?m, time.Instant{sec: 0, nsec: 1000000000});
    mutex.unlock(?m);
    if (!sel invalid.invalid || waiter_count(?c) != 0) { ret 5; }
    ret 0;
}
