# atomic operations for lock-free programming
#
# all operations have sequential-consistency ordering, implemented with
# real per-arch instruction sequences selected at comptime on
# $mach.build.arch:
#   - x86_64: aligned MOV loads and memory XCHG stores implement the
#     load/store pair; LOCK XADD / XCHG / CMPXCHG carry an implicit full barrier
#     for the read-modify-write ops; MFENCE is the standalone full barrier;
#     PAUSE is the spin hint.
#   - aarch64: LDAR / STLR give acquire/release; the LDAXR/STLXR loop with a
#     trailing DMB ISH provides seq-cst read-modify-write; DMB ISH is the
#     standalone full barrier; YIELD is the spin hint.
#   - riscv64: the A extension provides seq-cst read-modify-write via the
#     .aqrl-suffixed AMOs (amoadd/amoswap) and the lr.d/sc.d reservation loop;
#     a plain aligned ld bracketed by full FENCEs is the seq-cst load; FENCE is
#     the standalone full barrier; PAUSE, spelled as its base-I encoding
#     `fence w, 0`, is the spin hint.
#   - riscv32: the A extension's atomics are one word wide, so every 64-bit
#     operation runs under one of a table of word spinlocks, picked by the
#     target's address and taken and released with .aqrl AMOs, which order the
#     plain accesses between them. FENCE is the standalone full barrier and
#     `fence w, 0` (PAUSE) the spin hint.
#
# the word operations (load_word and the rest, on usize) are one native
# instruction or reservation loop on every target, so they never take a lock.
# state a signal handler touches must be word-sized and use them: a 64-bit
# operation that takes a lock its own thread already holds would spin forever.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

$if ($mach.build.arch == $mach.arch.riscv32) {
    # the spinlocks, one per 8-byte slot modulo the table, so operations on one
    # word always meet the same lock and unrelated words rarely share one
    val LOCK_COUNT: usize = 64;
    var locks:      [64]u32;

    fun lock_of(ptr: *i64) *u32 {
        ret ?locks[(ptr::usize >> 3) & (LOCK_COUNT - 1)];
    }

    # spin until the lock reads free, then claim it
    fun acquire(lock: *u32) {
        asm riscv32 {
            lw a0, {lock}
            li a1, 1
        1:
            lw a2, 0(a0)
            beqz a2, 2f
            fence w, 0           # pause
            j 1b
        2:
            amoswap.w.aqrl a2, a1, (a0)
            bnez a2, 1b
        }
    }

    fun release(lock: *u32) {
        asm riscv32 {
            lw a0, {lock}
            amoswap.w.aqrl zero, zero, (a0)
        }
    }
}

# atomic 64-bit load with sequential consistency
# ---
# ptr: address to load from
# ret: loaded value
#[inline("always")]
pub fun load(ptr: *i64) i64 {
    var result: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        # aligned MOV is ordered under x86-TSO; gives seq-cst load semantics
        # {ptr} binds to a stack slot, so stage the address in rcx first
        asm x86_64 {
            mov rcx, {ptr}
            mov rax, [rcx]
            mov {result}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        # load-acquire pairs with STLR stores for seq-cst ordering
        # {ptr} binds to a stack slot, so stage the address in x12 first
        asm aarch64 {
            ldr x12, {ptr}
            ldar x9, [x12]
            str x9, {result}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        # full fences bracket a plain aligned ld for a seq-cst load
        # {ptr} binds to a stack slot, so stage the address in a0 first
        asm riscv64 {
            ld a0, {ptr}
            fence
            ld a1, 0(a0)
            fence
            sd a1, {result}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        val lock: *u32 = lock_of(ptr);
        acquire(lock);
        result = @ptr;
        release(lock);
    }
    $or {
        $error("std.sync.atomic.load: unsupported architecture");
    }
    ret result;
}

# atomic 64-bit store with sequential consistency
# ---
# ptr: address to store to
# v:   value to store
#[inline("always")]
pub fun store(ptr: *i64, v: i64) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        # XCHG to memory carries an implicit LOCK, giving a seq-cst store
        # {ptr} binds to a stack slot, so stage the address in rcx first
        asm x86_64 {
            mov rax, {v}
            mov rcx, {ptr}
            xchg [rcx], rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        # store-release pairs with LDAR loads for seq-cst ordering
        # {ptr} binds to a stack slot, so stage the address in x12 first
        asm aarch64 {
            ldr x12, {ptr}
            ldr x9, {v}
            stlr x9, [x12]
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        # amoswap.d.aqrl discarding the old value is a seq-cst store
        # {ptr} binds to a stack slot, so stage the address in a0 first
        asm riscv64 {
            ld a0, {ptr}
            ld a1, {v}
            amoswap.d.aqrl zero, a1, (a0)
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        val lock: *u32 = lock_of(ptr);
        acquire(lock);
        @ptr = v;
        release(lock);
    }
    $or {
        $error("std.sync.atomic.store: unsupported architecture");
    }
}

# atomic compare-and-swap
# if *ptr == *expected, stores desired and returns true.
# otherwise, writes actual value to *expected and returns false.
# ---
# ptr:      address of the atomic variable
# expected: pointer to expected value (updated on failure)
# desired:  value to store on success
# ret:      true if the swap succeeded
#[inline("always")]
pub fun cas(ptr: *i64, expected: *i64, desired: i64) bool {
    var old: i64 = 0;
    val exp: i64 = @expected;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        # LOCK CMPXCHG: RAX holds the comparand and receives the prior value
        # {ptr} binds to a stack slot, so stage the address in rcx first
        asm x86_64 {
            mov rax, {exp}
            mov rdx, {desired}
            mov rcx, {ptr}
            lock cmpxchg [rcx], rdx
            mov {old}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        # LDAXR/STLXR retry loop; trailing DMB ISH gives full seq-cst order
        # {ptr} binds to a stack slot, so stage the address in x12 first
        asm aarch64 {
            ldr x9, {exp}
            ldr x12, {ptr}
            ldr x13, {desired}
        1:
            ldaxr x10, [x12]
            cmp x10, x9
            b.ne 2f
            stlxr w11, x13, [x12]
            cbnz w11, 1b
        2:
            str x10, {old}
            dmb ish
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        # lr.d/sc.d retry loop; .aqrl on both gives full seq-cst order
        # {ptr} binds to a stack slot, so stage the address in a0 first
        asm riscv64 {
            ld a0, {ptr}
            ld a1, {exp}
            ld a2, {desired}
        1:
            lr.d.aqrl a3, (a0)
            bne a3, a1, 2f
            sc.d.aqrl a4, a2, (a0)
            bnez a4, 1b
        2:
            sd a3, {old}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        val lock: *u32 = lock_of(ptr);
        acquire(lock);
        old = @ptr;
        if (old == exp) { @ptr = desired; }
        release(lock);
    }
    $or {
        $error("std.sync.atomic.cas: unsupported architecture");
    }
    if (old == exp) { ret true; }
    @expected = old;
    ret false;
}

# atomic fetch-and-add. returns the old value
# ---
# ptr: address of the atomic variable
# v:   value to add
# ret: previous value
#[inline("always")]
pub fun fetch_add(ptr: *i64, v: i64) i64 {
    var old: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        # LOCK XADD returns the prior value in the source register
        # {ptr} binds to a stack slot, so stage the address in rcx first
        asm x86_64 {
            mov rax, {v}
            mov rcx, {ptr}
            lock xadd [rcx], rax
            mov {old}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        # LDAXR/STLXR add loop; trailing DMB ISH gives full seq-cst order
        # {ptr} binds to a stack slot, so stage the address in x12 first
        asm aarch64 {
            ldr x12, {ptr}
            ldr x14, {v}
        1:
            ldaxr x9, [x12]
            add x10, x9, x14
            stlxr w11, x10, [x12]
            cbnz w11, 1b
            str x9, {old}
            dmb ish
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        # amoadd.d.aqrl returns the prior value with full seq-cst order
        # {ptr} binds to a stack slot, so stage the address in a0 first
        asm riscv64 {
            ld a0, {ptr}
            ld a1, {v}
            amoadd.d.aqrl a2, a1, (a0)
            sd a2, {old}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        val lock: *u32 = lock_of(ptr);
        acquire(lock);
        old  = @ptr;
        @ptr = old + v;
        release(lock);
    }
    $or {
        $error("std.sync.atomic.fetch_add: unsupported architecture");
    }
    ret old;
}

# atomic fetch-and-subtract. returns the old value
# ---
# ptr: address of the atomic variable
# v:   value to subtract
# ret: previous value
#[inline("always")]
pub fun fetch_sub(ptr: *i64, v: i64) i64 {
    var old: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        # negate then LOCK XADD; returns the prior value
        # {ptr} binds to a stack slot, so stage the address in rcx first
        asm x86_64 {
            mov rax, {v}
            neg rax
            mov rcx, {ptr}
            lock xadd [rcx], rax
            mov {old}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        # LDAXR/STLXR sub loop; trailing DMB ISH gives full seq-cst order
        # {ptr} binds to a stack slot, so stage the address in x12 first
        asm aarch64 {
            ldr x12, {ptr}
            ldr x14, {v}
        1:
            ldaxr x9, [x12]
            sub x10, x9, x14
            stlxr w11, x10, [x12]
            cbnz w11, 1b
            str x9, {old}
            dmb ish
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        # no amosub: negate then amoadd.d.aqrl, returning the prior value
        # {ptr} binds to a stack slot, so stage the address in a0 first
        asm riscv64 {
            ld a0, {ptr}
            ld a1, {v}
            neg a1, a1
            amoadd.d.aqrl a2, a1, (a0)
            sd a2, {old}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        val lock: *u32 = lock_of(ptr);
        acquire(lock);
        old  = @ptr;
        @ptr = old - v;
        release(lock);
    }
    $or {
        $error("std.sync.atomic.fetch_sub: unsupported architecture");
    }
    ret old;
}

# atomic exchange. returns the old value
# ---
# ptr: address of the atomic variable
# v:   new value
# ret: previous value
#[inline("always")]
pub fun exchange(ptr: *i64, v: i64) i64 {
    var old: i64 = 0;
    $if ($mach.build.arch == $mach.arch.x86_64) {
        # XCHG with memory carries an implicit LOCK (full barrier)
        # {ptr} binds to a stack slot, so stage the address in rcx first
        asm x86_64 {
            mov rax, {v}
            mov rcx, {ptr}
            xchg [rcx], rax
            mov {old}, rax
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        # LDAXR/STLXR swap loop; trailing DMB ISH gives full seq-cst order
        # {ptr} binds to a stack slot, so stage the address in x12 first
        asm aarch64 {
            ldr x12, {ptr}
            ldr x14, {v}
        1:
            ldaxr x9, [x12]
            stlxr w11, x14, [x12]
            cbnz w11, 1b
            str x9, {old}
            dmb ish
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        # amoswap.d.aqrl returns the prior value with full seq-cst order
        # {ptr} binds to a stack slot, so stage the address in a0 first
        asm riscv64 {
            ld a0, {ptr}
            ld a1, {v}
            amoswap.d.aqrl a2, a1, (a0)
            sd a2, {old}
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        val lock: *u32 = lock_of(ptr);
        acquire(lock);
        old  = @ptr;
        @ptr = v;
        release(lock);
    }
    $or {
        $error("std.sync.atomic.exchange: unsupported architecture");
    }
    ret old;
}

# whether the 64-bit operations are lock-free. false on riscv32, where they
# run under spinlocks and so must not be reached from a signal handler. the
# word operations are lock-free everywhere
pub val LOCK_FREE_64: bool = $mach.build.arch != $mach.arch.riscv32;

# atomic word load with sequential consistency
# ---
# ptr: address to load from
# ret: loaded value
#[inline("always")]
pub fun load_word(ptr: *usize) usize {
    $if ($mach.build.arch == $mach.arch.riscv32) {
        var result: usize = 0;
        # full fences bracket a plain aligned lw for a seq-cst load
        asm riscv32 {
            lw a0, {ptr}
            fence
            lw a1, 0(a0)
            fence
            sw a1, {result}
        }
        ret result;
    }
    $or {
        ret load(ptr::*i64)::usize;
    }
}

# atomic word store with sequential consistency
# ---
# ptr: address to store to
# v:   value to store
#[inline("always")]
pub fun store_word(ptr: *usize, v: usize) {
    $if ($mach.build.arch == $mach.arch.riscv32) {
        asm riscv32 {
            lw a0, {ptr}
            lw a1, {v}
            amoswap.w.aqrl zero, a1, (a0)
        }
    }
    $or {
        store(ptr::*i64, v::i64);
    }
}

# atomic word compare-and-swap, as cas
# ---
# ptr:      address of the atomic word
# expected: pointer to expected value (updated on failure)
# desired:  value to store on success
# ret:      true if the swap succeeded
#[inline("always")]
pub fun cas_word(ptr: *usize, expected: *usize, desired: usize) bool {
    $if ($mach.build.arch == $mach.arch.riscv32) {
        var old: usize = 0;
        val exp: usize = @expected;
        # lr.w/sc.w retry loop; .aqrl on both gives full seq-cst order
        asm riscv32 {
            lw a0, {ptr}
            lw a1, {exp}
            lw a2, {desired}
        1:
            lr.w.aqrl a3, (a0)
            bne a3, a1, 2f
            sc.w.aqrl a4, a2, (a0)
            bnez a4, 1b
        2:
            sw a3, {old}
        }
        if (old == exp) { ret true; }
        @expected = old;
        ret false;
    }
    $or {
        ret cas(ptr::*i64, expected::*i64, desired::i64);
    }
}

# atomic word fetch-and-add, wrapping. returns the old value
# ---
# ptr: address of the atomic word
# v:   value to add
# ret: previous value
#[inline("always")]
pub fun fetch_add_word(ptr: *usize, v: usize) usize {
    $if ($mach.build.arch == $mach.arch.riscv32) {
        var old: usize = 0;
        asm riscv32 {
            lw a0, {ptr}
            lw a1, {v}
            amoadd.w.aqrl a2, a1, (a0)
            sw a2, {old}
        }
        ret old;
    }
    $or {
        ret fetch_add(ptr::*i64, v::i64)::usize;
    }
}

# atomic word fetch-and-subtract, wrapping. returns the old value
# ---
# ptr: address of the atomic word
# v:   value to subtract
# ret: previous value
#[inline("always")]
pub fun fetch_sub_word(ptr: *usize, v: usize) usize {
    $if ($mach.build.arch == $mach.arch.riscv32) {
        var old: usize = 0;
        asm riscv32 {
            lw a0, {ptr}
            lw a1, {v}
            neg a1, a1
            amoadd.w.aqrl a2, a1, (a0)
            sw a2, {old}
        }
        ret old;
    }
    $or {
        ret fetch_sub(ptr::*i64, v::i64)::usize;
    }
}

# atomic word exchange. returns the old value
# ---
# ptr: address of the atomic word
# v:   new value
# ret: previous value
#[inline("always")]
pub fun exchange_word(ptr: *usize, v: usize) usize {
    $if ($mach.build.arch == $mach.arch.riscv32) {
        var old: usize = 0;
        asm riscv32 {
            lw a0, {ptr}
            lw a1, {v}
            amoswap.w.aqrl a2, a1, (a0)
            sw a2, {old}
        }
        ret old;
    }
    $or {
        ret exchange(ptr::*i64, v::i64)::usize;
    }
}

# full memory barrier
#[inline("always")]
pub fun fence() {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mfence
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            dmb ish
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        asm riscv64 {
            fence
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        asm riscv32 {
            fence
        }
    }
    $or {
        $error("std.sync.atomic.fence: unsupported architecture");
    }
}

# cpu yield hint for spin loops
#[inline("always")]
pub fun spin_hint() {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            pause
        }
    }
    $or ($mach.build.arch == $mach.arch.aarch64) {
        asm aarch64 {
            yield
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv64) {
        # pause's own encoding, a no-op hint where Zihintpause is absent, so the
        # base floor assembles it
        asm riscv64 {
            fence w, 0
        }
    }
    $or ($mach.build.arch == $mach.arch.riscv32) {
        # pause's own encoding, a no-op hint where Zihintpause is absent, so the
        # base floor assembles it
        asm riscv32 {
            fence w, 0
        }
    }
    $or {
        $error("std.sync.atomic.spin_hint: unsupported architecture");
    }
}

# each read-modify-write returns the old value and leaves the new one, and a
# plain store is seen by a load
test atomic__load_store_and_read_modify_write {
    var x: i64 = 0;
    store(?x, 42);
    if (x != 42 || load(?x) != 42)         { ret 1; }
    if (exchange(?x, 7) != 42 || x != 7)   { ret 2; }
    if (fetch_add(?x, 3) != 7 || x != 10)  { ret 3; }
    if (fetch_add(?x, -3) != 10 || x != 7) { ret 4; }
    if (fetch_sub(?x, 4) != 7 || x != 3)   { ret 5; }
    ret 0;
}

# cas swaps when the expected value matches, and otherwise leaves the target
# alone and reports its current value through expected
test atomic__cas_swaps_or_reports_the_current_value {
    var x:        i64 = 0;
    var expected: i64 = 0;
    if (!cas(?x, ?expected, 20) || x != 20 || expected != 0) { ret 1; }
    expected = 10;
    if (cas(?x, ?expected, 30) || x != 20 || expected != 20) { ret 2; }
    ret 0;
}
