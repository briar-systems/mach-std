# caller-owned hierarchical cancellation

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.chrono.time;
use std.sync.atomic;
use std.sync.mutex;
use std.sync.thread;
use std.system.os;

# why a scope is no longer active, or that it still is
# ---
# active:    no cancellation has been requested
# cancelled: cancelled explicitly through this scope or an ancestor
# timed_out: an absolute deadline owned by this scope or an ancestor passed
# destroyed: the scope was destroyed, or the call reached a destroyed scope
# invalid:   the call was refused (nil operands, a registration in use)
pub tag Reason: u8 { active; cancelled; timed_out; destroyed; invalid; }

# a refused scope or registration operation
# ---
# invalid:   nil operands, a deadline outside the target range, a scope
#            parented to itself, or a scope that was never made
# destroyed: the scope (or the parent) has already been destroyed
# busy:      destruction refused while children, registrations, waiters,
#            running callbacks or in-flight callers remain
pub tag StateError: u8 { invalid; destroyed; busy; }

# the effective absolute monotonic deadline of a scope
# ---
# at:    the earliest deadline along the ancestor chain
# owner: the scope that declared it, borrowed from the tree
pub rec Deadline {
    at:    time.Time;
    owner: *Scope;
}

pub def CancelFun: fun(ptr, Reason);

pub def Transition: res[bool, StateError];
pub def Operation:  err[StateError];
pub def DeadlineQuery: res[opt[Deadline], StateError];

val ACTIVE:    i64 = 0;
val CANCELLED: i64 = 1;
val TIMED_OUT: i64 = 2;
val DESTROYED: i64 = 3;
val INVALID:   i64 = 4;

fun reason_of(state: i64) Reason {
    if (state == ACTIVE)    { ret Reason.active{}; }
    if (state == CANCELLED) { ret Reason.cancelled{}; }
    if (state == TIMED_OUT) { ret Reason.timed_out{}; }
    if (state == DESTROYED) { ret Reason.destroyed{}; }
    ret Reason.invalid{};
}

fun state_of(reason: Reason) i64 {
    if (sel reason.active)    { ret ACTIVE; }
    if (sel reason.cancelled) { ret CANCELLED; }
    if (sel reason.timed_out) { ret TIMED_OUT; }
    if (sel reason.destroyed) { ret DESTROYED; }
    ret INVALID;
}

val REG_UNUSED:    i64 = 0;
val REG_ACTIVE:    i64 = 1;
val REG_CANCELLED: i64 = 2;
val REG_COMPLETED: i64 = 3;
val REG_CLAIMING:  i64 = 4;
val REG_DETACHING: i64 = 5;
val GATE_CLOSED:   i64 = -1;

pub rec Registration {
    root: *Scope;
    scope: *Scope;
    prev: *Registration;
    next: *Registration;
    callback: CancelFun;
    completion: CancelFun;
    context: ptr;
    reason: i64;
    state: i64;
}

pub rec Scope {
    root: *Scope;
    parent: *Scope;
    first_child: *Scope;
    prev_sibling: *Scope;
    next_sibling: *Scope;
    first_registration: *Registration;
    deadline: time.Time;
    deadline_owner: *Scope;
    has_deadline: bool;
    state: i64;
    waiters: i64;
    gate: i64;
    callback_count: usize;
    lock: mutex.Mutex;
}

fun valid_deadline(has_deadline: bool, deadline: time.Time) bool {
    if (!has_deadline) { ret true; }
    ret deadline.sec >= 0 && deadline.nsec >= 0 && deadline.nsec < 1000000000;
}

# scopes are fixed in memory and own no target handle or allocation
# callers stop starting new calls before reclaiming a destroyed scope
pub fun make_root(scope: *Scope, has_deadline: bool, deadline: time.Time) Operation {
    if (scope == nil || !valid_deadline(has_deadline, deadline)) { ret Operation.err{StateError.invalid{}}; }
    scope.root = scope;
    scope.parent = nil;
    scope.first_child = nil;
    scope.prev_sibling = nil;
    scope.next_sibling = nil;
    scope.first_registration = nil;
    scope.deadline = deadline;
    scope.deadline_owner = nil;
    scope.has_deadline = has_deadline;
    if (has_deadline) { scope.deadline_owner = scope; }
    scope.state = ACTIVE;
    scope.waiters = 0;
    scope.gate = 0;
    scope.callback_count = 0;
    scope.lock = mutex.make();
    ret Operation.ok{};
}

# child deadlines inherit the earliest absolute monotonic ancestor deadline
fun scope_enter(scope: *Scope) bool {
    if (scope == nil) { ret false; }
    for (true) {
        val current: i64 = atomic.load(?scope.gate);
        if (current == GATE_CLOSED) { ret false; }
        var expected: i64 = current;
        if (atomic.cas(?scope.gate, ?expected, current + 1)) { ret true; }
    }
    ret false;
}

fun scope_leave(scope: *Scope) {
    atomic.fetch_sub(?scope.gate, 1);
}

pub fun make_child(scope: *Scope, parent: *Scope, has_deadline: bool, deadline: time.Time) Operation {
    if (scope == nil || parent == nil || scope == parent || !valid_deadline(has_deadline, deadline)) { ret Operation.err{StateError.invalid{}}; }
    if (!scope_enter(parent)) { ret Operation.err{StateError.destroyed{}}; }
    val root: *Scope = parent.root;
    mutex.lock(?root.lock);
    if (atomic.load(?parent.state) == DESTROYED) {
        mutex.unlock(?root.lock);
        scope_leave(parent);
        ret Operation.err{StateError.destroyed{}};
    }
    scope.root = root;
    scope.parent = parent;
    scope.first_child = nil;
    scope.prev_sibling = nil;
    scope.next_sibling = parent.first_child;
    if (parent.first_child != nil) { parent.first_child.prev_sibling = scope; }
    parent.first_child = scope;
    scope.first_registration = nil;
    scope.has_deadline = has_deadline;
    scope.deadline = deadline;
    scope.deadline_owner = nil;
    if (parent.has_deadline && (!has_deadline || !time.time_before(deadline, parent.deadline))) {
        scope.has_deadline = true;
        scope.deadline = parent.deadline;
        scope.deadline_owner = parent.deadline_owner;
    } or (has_deadline) {
        scope.deadline_owner = scope;
    }
    scope.state = atomic.load(?parent.state);
    scope.waiters = 0;
    scope.gate = 0;
    scope.callback_count = 0;
    scope.lock = mutex.make();
    mutex.unlock(?root.lock);
    scope_leave(parent);
    ret Operation.ok{};
}

# initialization is valid before first attachment or after terminal completion
pub fun init_registration(registration: *Registration) Operation {
    if (registration == nil) { ret Operation.err{StateError.invalid{}}; }
    registration.root = nil;
    registration.scope = nil;
    registration.prev = nil;
    registration.next = nil;
    registration.callback = (0::usize)::CancelFun;
    registration.completion = (0::usize)::CancelFun;
    registration.context = nil;
    registration.reason = ACTIVE;
    registration.state = REG_UNUSED;
    ret Operation.ok{};
}

fun registration_remove(registration: *Registration) {
    val scope: *Scope = registration.scope;
    if (registration.prev != nil) {
        registration.prev.next = registration.next;
    } or {
        scope.first_registration = registration.next;
    }
    if (registration.next != nil) { registration.next.prev = registration.prev; }
}

fun attach_internal(scope: *Scope, registration: *Registration, callback: CancelFun, completion: CancelFun, context: ptr) Reason {
    if (scope == nil || registration == nil || callback::usize == 0) { ret Reason.invalid{}; }
    if (!scope_enter(scope)) { ret Reason.destroyed{}; }
    val registration_state: i64 = atomic.load(?registration.state);
    if (registration_state != REG_UNUSED && registration_state != REG_COMPLETED) {
        scope_leave(scope);
        ret Reason.invalid{};
    }
    var expected: i64 = registration_state;
    if (!atomic.cas(?registration.state, ?expected, REG_CLAIMING)) {
        scope_leave(scope);
        ret Reason.invalid{};
    }
    val root: *Scope = scope.root;
    mutex.lock(?root.lock);
    val state: i64 = atomic.load(?scope.state);
    if (state != ACTIVE) {
        atomic.store(?registration.state, registration_state);
        mutex.unlock(?root.lock);
        scope_leave(scope);
        ret reason_of(state);
    }
    registration.root = root;
    registration.scope = scope;
    registration.prev = nil;
    registration.next = scope.first_registration;
    if (scope.first_registration != nil) { scope.first_registration.prev = registration; }
    registration.callback = callback;
    registration.completion = completion;
    registration.context = context;
    registration.reason = ACTIVE;
    atomic.store(?registration.state, REG_ACTIVE);
    scope.first_registration = registration;
    mutex.unlock(?root.lock);
    scope_leave(scope);
    ret Reason.active{};
}

# successful registration is the ownership linearization point
pub fun attach(scope: *Scope, registration: *Registration, callback: CancelFun, context: ptr) Reason {
    ret attach_internal(scope, registration, callback, (0::usize)::CancelFun, context);
}

# completion publishes external work and must call finish under its lifetime lock
pub fun attach_with_completion(scope: *Scope, registration: *Registration, callback: CancelFun, completion: CancelFun, context: ptr) Reason {
    if (completion::usize == 0) { ret Reason.invalid{}; }
    ret attach_internal(scope, registration, callback, completion, context);
}

# this must be the completion hook's final registration operation
# ---
# ret: true when this call completed a cancelled registration, false when the
#      registration was not awaiting completion, invalid for nil
pub fun finish(registration: *Registration) Transition {
    if (registration == nil) { ret Transition.err{StateError.invalid{}}; }
    var expected: i64 = REG_CANCELLED;
    ret Transition.ok{atomic.cas(?registration.state, ?expected, REG_COMPLETED)};
}

# completion wins only while the registration remains owned by its scope
# ---
# ret: true when this call detached the registration, false when cancellation
#      already claimed it (the completion hook owns it), invalid for nil
pub fun unregister(registration: *Registration) Transition {
    if (registration == nil) { ret Transition.err{StateError.invalid{}}; }
    var expected: i64 = REG_ACTIVE;
    if (!atomic.cas(?registration.state, ?expected, REG_DETACHING)) { ret Transition.ok{false}; }
    val root: *Scope = registration.root;
    mutex.lock(?root.lock);
    registration_remove(registration);
    registration.scope = nil;
    registration.root = nil;
    registration.reason = ACTIVE;
    atomic.store(?registration.state, REG_COMPLETED);
    mutex.unlock(?root.lock);
    ret Transition.ok{true};
}

fun wake_scope(scope: *Scope) {
    val waiters: i64 = atomic.load(?scope.waiters);
    var i: i64 = 0;
    for (i < waiters) {
        os.thread_wake(?scope.state);
        i = i + 1;
    }
}

fun mark_tree_locked(scope: *Scope, reason: i64, callbacks: **Registration, callback_count: *usize) {
    var current: *Scope = scope;
    for (current != nil) {
        if (atomic.load(?current.state) == ACTIVE) {
            atomic.store(?current.state, reason);
            wake_scope(current);
            var registration: *Registration = current.first_registration;
            current.first_registration = nil;
            for (registration != nil) {
                val next: *Registration = registration.next;
                var expected: i64 = REG_ACTIVE;
                if (atomic.cas(?registration.state, ?expected, REG_CANCELLED)) {
                    registration.prev = nil;
                    registration.next = @callbacks;
                    registration.scope = nil;
                    registration.reason = reason;
                    @callbacks = registration;
                    @callback_count = @callback_count + 1;
                } or {
                    registration.prev = nil;
                    registration.next = current.first_registration;
                    if (current.first_registration != nil) { current.first_registration.prev = registration; }
                    current.first_registration = registration;
                }
                registration = next;
            }
        }

        if (current.first_child != nil) {
            current = current.first_child;
        } or {
            for (current != scope && current.next_sibling == nil) { current = current.parent; }
            if (current == scope) { ret; }
            current = current.next_sibling;
        }
    }
}

# ret: true when this call moved the scope out of active, false when it was
#      already cancelled or timed out, destroyed once the scope is gone
fun transition(scope: *Scope, reason: i64) Transition {
    if (scope == nil) { ret Transition.err{StateError.invalid{}}; }
    if (!scope_enter(scope)) { ret Transition.err{StateError.destroyed{}}; }
    val root: *Scope = scope.root;
    var callbacks: *Registration = nil;
    var callback_count: usize = 0;
    mutex.lock(?root.lock);
    if (atomic.load(?scope.state) != ACTIVE) {
        mutex.unlock(?root.lock);
        scope_leave(scope);
        ret Transition.ok{false};
    }
    mark_tree_locked(scope, reason, ?callbacks, ?callback_count);
    root.callback_count = root.callback_count + callback_count;
    mutex.unlock(?root.lock);

    var registration: *Registration = callbacks;
    for (registration != nil) {
        val next: *Registration = registration.next;
        val callback: CancelFun = registration.callback;
        val completion: CancelFun = registration.completion;
        val context: ptr = registration.context;
        val callback_reason: Reason = reason_of(registration.reason);
        registration.root = nil;
        callback(context, callback_reason);
        if (completion::usize == 0) {
            var expected: i64 = REG_CANCELLED;
            atomic.cas(?registration.state, ?expected, REG_COMPLETED);
        } or {
            completion(context, callback_reason);
        }
        registration = next;
    }

    mutex.lock(?root.lock);
    root.callback_count = root.callback_count - callback_count;
    mutex.unlock(?root.lock);
    scope_leave(scope);
    ret Transition.ok{true};
}

# ret: true when this call cancelled the scope, false when it was already
#      cancelled or timed out
pub fun cancel(scope: *Scope) Transition {
    ret transition(scope, CANCELLED);
}

# ret: true when this call timed the scope out, false when it was already
#      cancelled or timed out
pub fun timeout(scope: *Scope) Transition {
    ret transition(scope, TIMED_OUT);
}

# callers without a runtime may drive absolute deadlines explicitly
# ---
# ret: true when now reached the effective deadline and this call timed its
#      owner out, false when there is no deadline, it has not passed, or the
#      owner had already left active
pub fun expire(scope: *Scope, now: time.Time) Transition {
    if (scope == nil) { ret Transition.err{StateError.invalid{}}; }
    if (!scope_enter(scope)) { ret Transition.err{StateError.destroyed{}}; }
    val has_deadline: bool = scope.has_deadline;
    val deadline: time.Time = scope.deadline;
    val owner: *Scope = scope.deadline_owner;
    if (!has_deadline || time.time_before(now, deadline)) {
        scope_leave(scope);
        ret Transition.ok{false};
    }
    val expired: Transition = timeout(owner);
    scope_leave(scope);
    ret expired;
}

# returns the effective deadline and the ancestor that owns it
# ---
# ret: some{deadline} when the scope or an ancestor declared one, none when
#      the scope has no deadline, destroyed once the scope is gone
pub fun get_deadline(scope: *Scope) DeadlineQuery {
    if (scope == nil) { ret DeadlineQuery.err{StateError.invalid{}}; }
    if (!scope_enter(scope)) { ret DeadlineQuery.err{StateError.destroyed{}}; }
    if (!scope.has_deadline) {
        scope_leave(scope);
        ret DeadlineQuery.ok{opt[Deadline].none{}};
    }
    val found: Deadline = Deadline{at: scope.deadline, owner: scope.deadline_owner};
    scope_leave(scope);
    ret DeadlineQuery.ok{opt[Deadline].some{found}};
}

pub fun reason(scope: *Scope) Reason {
    if (scope == nil || !scope_enter(scope)) { ret Reason.destroyed{}; }
    val state: i64 = atomic.load(?scope.state);
    scope_leave(scope);
    ret reason_of(state);
}

pub fun wait(scope: *Scope) Reason {
    if (scope == nil || !scope_enter(scope)) { ret Reason.destroyed{}; }
    for (true) {
        val observed: i64 = atomic.load(?scope.state);
        if (observed != ACTIVE) {
            scope_leave(scope);
            ret reason_of(observed);
        }
        atomic.fetch_add(?scope.waiters, 1);
        if (atomic.load(?scope.state) == ACTIVE) { os.thread_wait(?scope.state, ACTIVE); }
        atomic.fetch_sub(?scope.waiters, 1);
    }
    ret Reason.destroyed{};
}

pub fun waiter_count(scope: *Scope) i64 {
    if (scope == nil || !scope_enter(scope)) { ret 0; }
    val count: i64 = atomic.load(?scope.waiters);
    scope_leave(scope);
    ret count;
}

# destruction rejects children, live registrations, waiters, and callbacks
# ---
# ret: ok once the scope is destroyed, invalid for a nil or never-made scope,
#      destroyed when it already was, busy while children, registrations,
#      waiters, running callbacks or in-flight callers remain
pub fun destroy(scope: *Scope) Operation {
    if (scope == nil || scope.root == nil) { ret Operation.err{StateError.invalid{}}; }
    val root: *Scope = scope.root;
    mutex.lock(?root.lock);
    if (atomic.load(?scope.state) == DESTROYED) {
        mutex.unlock(?root.lock);
        ret Operation.err{StateError.destroyed{}};
    }
    if (scope.first_child != nil || scope.first_registration != nil || atomic.load(?scope.waiters) != 0 || root.callback_count != 0) {
        mutex.unlock(?root.lock);
        ret Operation.err{StateError.busy{}};
    }
    var expected: i64 = 0;
    if (!atomic.cas(?scope.gate, ?expected, GATE_CLOSED)) {
        mutex.unlock(?root.lock);
        ret Operation.err{StateError.busy{}};
    }
    if (scope.parent != nil) {
        if (scope.prev_sibling != nil) {
            scope.prev_sibling.next_sibling = scope.next_sibling;
        } or {
            scope.parent.first_child = scope.next_sibling;
        }
        if (scope.next_sibling != nil) { scope.next_sibling.prev_sibling = scope.prev_sibling; }
    }
    atomic.store(?scope.state, DESTROYED);
    mutex.unlock(?root.lock);
    ret Operation.ok{};
}

fun made(r: Operation) bool { ret sel r.ok; }
fun changed(r: Transition) bool { if (sel r.ok) { ret r.ok; } ret false; }
fun refused(r: Transition) bool { ret sel r.err; }
fun is_active(r: Reason) bool { ret sel r.active; }
fun is_invalid(r: Reason) bool { ret sel r.invalid; }
fun is_timed_out(r: Reason) bool { ret sel r.timed_out; }

rec TestCallback {
    count: *i64;
    reason: *i64;
}

fun test_callback(context: ptr, why: Reason) {
    val callback: *TestCallback = context::*TestCallback;
    atomic.fetch_add(callback.count, 1);
    atomic.store(callback.reason, state_of(why));
}

test "cancel scope: parent cancellation reaches every descendant once" {
    var root: Scope;
    var child: Scope;
    var grandchild: Scope;
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    if (!made(make_root(?root, false, none))) { ret 1; }
    if (!made(make_child(?child, ?root, false, none))) { ret 1; }
    if (!made(make_child(?grandchild, ?child, false, none))) { ret 1; }
    var counts: [3]i64;
    var reasons: [3]i64;
    var callbacks: [3]TestCallback;
    var registrations: [3]Registration;
    callbacks[0] = TestCallback{count: ?counts[0], reason: ?reasons[0]};
    callbacks[1] = TestCallback{count: ?counts[1], reason: ?reasons[1]};
    callbacks[2] = TestCallback{count: ?counts[2], reason: ?reasons[2]};
    init_registration(?registrations[0]);
    init_registration(?registrations[1]);
    init_registration(?registrations[2]);
    if (!is_active(attach(?root, ?registrations[0], test_callback, (?callbacks[0])::ptr))) { ret 1; }
    if (!is_active(attach(?child, ?registrations[1], test_callback, (?callbacks[1])::ptr))) { ret 1; }
    if (!is_active(attach(?grandchild, ?registrations[2], test_callback, (?callbacks[2])::ptr))) { ret 1; }
    if (!changed(cancel(?root)) || changed(cancel(?root))) { ret 1; }
    var i: usize = 0;
    for (i < 3) {
        if (atomic.load(?counts[i]) != 1 || atomic.load(?reasons[i]) != CANCELLED || changed(unregister(?registrations[i]))) { ret 1; }
        i = i + 1;
    }
    if (made(destroy(?root)) || made(destroy(?child))) { ret 1; }
    if (!made(destroy(?grandchild)) || !made(destroy(?child)) || !made(destroy(?root))) { ret 1; }
    ret 0;
}

test "cancel scope: registration and destruction have one owner" {
    var scope: Scope;
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    if (!made(make_root(?scope, false, none))) { ret 1; }
    var count: i64 = 0;
    var why: i64 = ACTIVE;
    var callback: TestCallback = TestCallback{count: ?count, reason: ?why};
    var registration: Registration;
    init_registration(?registration);
    if (!is_active(attach(?scope, ?registration, test_callback, (?callback)::ptr))) { ret 1; }
    if (made(destroy(?scope)) || !changed(unregister(?registration)) || changed(unregister(?registration))) { ret 1; }
    if (!made(destroy(?scope)) || atomic.load(?count) != 0 || scope_enter(?scope)) { ret 1; }
    if (!made(make_root(?scope, false, none)) || !made(destroy(?scope))) { ret 1; }
    ret 0;
}

test "cancel scope: refusals name their cause" {
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    val nil_scope: Operation = make_root(nil, false, none);
    if (!sel nil_scope.err) { ret 1; }
    if (!sel nil_scope.err.invalid) { ret 2; }
    var scope: Scope;
    val bad_deadline: Operation = make_root(?scope, true, time.Time{sec: 0, nsec: 1000000000});
    if (!sel bad_deadline.err) { ret 3; }
    if (!sel bad_deadline.err.invalid) { ret 4; }
    val never_made: Operation = destroy(?scope);
    if (!sel never_made.err) { ret 5; }
    if (!sel never_made.err.invalid) { ret 6; }
    if (!made(make_root(?scope, false, none))) { ret 7; }
    var count: i64 = 0;
    var why: i64 = ACTIVE;
    var callback: TestCallback = TestCallback{count: ?count, reason: ?why};
    var registration: Registration;
    init_registration(?registration);
    if (!is_active(attach(?scope, ?registration, test_callback, (?callback)::ptr))) { ret 8; }
    val busy: Operation = destroy(?scope);
    if (!sel busy.err) { ret 9; }
    if (!sel busy.err.busy) { ret 10; }
    if (!changed(unregister(?registration))) { ret 11; }
    val first: Transition = cancel(?scope);
    if (!sel first.ok) { ret 12; }
    if (!first.ok) { ret 13; }
    val second: Transition = cancel(?scope);
    if (!sel second.ok) { ret 14; }
    if (second.ok) { ret 15; }
    if (!made(destroy(?scope))) { ret 16; }
    val again: Operation = destroy(?scope);
    if (!sel again.err) { ret 17; }
    if (!sel again.err.destroyed) { ret 18; }
    val after: Transition = cancel(?scope);
    if (!sel after.err) { ret 19; }
    if (!sel after.err.destroyed) { ret 20; }
    val query: DeadlineQuery = get_deadline(?scope);
    if (!sel query.err) { ret 21; }
    if (!sel query.err.destroyed) { ret 22; }
    var child: Scope;
    val orphan: Operation = make_child(?child, ?scope, false, none);
    if (!sel orphan.err) { ret 23; }
    if (!sel orphan.err.destroyed) { ret 24; }
    ret 0;
}

test "cancel scope: deadline query reports absence and the owning ancestor" {
    var root: Scope;
    var child: Scope;
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    val at: time.Time = time.Time{sec: 10, nsec: 0};
    if (!made(make_root(?root, true, at))) { ret 1; }
    if (!made(make_child(?child, ?root, false, none))) { ret 2; }
    val inherited: DeadlineQuery = get_deadline(?child);
    if (!sel inherited.ok) { ret 3; }
    if (!sel inherited.ok.some) { ret 4; }
    if (inherited.ok.some.owner != ?root || !time.time_equal(inherited.ok.some.at, at)) { ret 5; }
    if (!made(destroy(?child)) || !made(destroy(?root))) { ret 6; }
    var plain: Scope;
    if (!made(make_root(?plain, false, none))) { ret 7; }
    val absent: DeadlineQuery = get_deadline(?plain);
    if (!sel absent.ok) { ret 8; }
    if (!sel absent.ok.none) { ret 9; }
    if (!made(destroy(?plain))) { ret 10; }
    ret 0;
}

test "cancel scope: active registrations cannot be attached twice" {
    var root: Scope;
    var other: Scope;
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    if (!made(make_root(?root, false, none)) || !made(make_root(?other, false, none))) { ret 1; }
    var count: i64 = 0;
    var why: i64 = ACTIVE;
    var callback: TestCallback = TestCallback{count: ?count, reason: ?why};
    var registration: Registration;
    init_registration(?registration);
    if (!is_active(attach(?root, ?registration, test_callback, (?callback)::ptr))) { ret 1; }
    if (!is_invalid(attach(?root, ?registration, test_callback, (?callback)::ptr))) { ret 1; }
    if (!is_invalid(attach(?other, ?registration, test_callback, (?callback)::ptr))) { ret 1; }
    if (!changed(cancel(?root)) || atomic.load(?count) != 1 || atomic.load(?why) != CANCELLED) { ret 1; }
    if (!made(destroy(?root)) || !made(destroy(?other))) { ret 1; }
    ret 0;
}

rec AttachRaceContext {
    scope: *Scope;
    registration: *Registration;
    callback: *TestCallback;
    ready: *i64;
    go: *i64;
    result: *i64;
}

fun attach_race_worker(arg: *u8) {
    val context: *AttachRaceContext = arg::*AttachRaceContext;
    atomic.fetch_add(context.ready, 1);
    for (atomic.load(context.go) == 0) { atomic.spin_hint(); }
    val attached: Reason = attach(context.scope, context.registration, test_callback, context.callback::ptr);
    atomic.store(context.result, state_of(attached));
}

rec UnregisterRaceContext {
    registration: *Registration;
    ready: *i64;
    go: *i64;
    result: *i64;
}

fun unregister_race_worker(arg: *u8) {
    val context: *UnregisterRaceContext = arg::*UnregisterRaceContext;
    atomic.store(context.ready, 1);
    for (atomic.load(context.go) == 0) { atomic.spin_hint(); }
    var result: i64 = 0;
    if (changed(unregister(context.registration))) { result = 1; }
    atomic.store(context.result, result);
}

rec CallbackBlockContext {
    count: *i64;
    reason: *i64;
    started: *i64;
    release: *i64;
}

fun blocking_callback(context: ptr, why: Reason) {
    val block: *CallbackBlockContext = context::*CallbackBlockContext;
    atomic.store(block.started, 1);
    for (atomic.load(block.release) == 0) { atomic.spin_hint(); }
    atomic.fetch_add(block.count, 1);
    atomic.store(block.reason, state_of(why));
}

rec CancelRaceContext {
    scope: *Scope;
    result: *i64;
}

fun cancel_race_worker(arg: *u8) {
    val context: *CancelRaceContext = arg::*CancelRaceContext;
    var result: i64 = 0;
    if (changed(cancel(context.scope))) { result = 1; }
    atomic.store(context.result, result);
}

test "cancel scope: concurrent roots cannot claim one registration" {
    var first: Scope;
    var second: Scope;
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    if (!made(make_root(?first, false, none)) || !made(make_root(?second, false, none))) { ret 1; }
    var count: i64 = 0;
    var why: i64 = ACTIVE;
    var callback: TestCallback = TestCallback{count: ?count, reason: ?why};
    var registration: Registration;
    init_registration(?registration);
    var ready: i64 = 0;
    var go: i64 = 0;
    var results: [2]i64;
    var contexts: [2]AttachRaceContext;
    contexts[0] = AttachRaceContext{scope: ?first, registration: ?registration, callback: ?callback, ready: ?ready, go: ?go, result: ?results[0]};
    contexts[1] = AttachRaceContext{scope: ?second, registration: ?registration, callback: ?callback, ready: ?ready, go: ?go, result: ?results[1]};
    var workers: [2]thread.Thread;
    thread.spawn_with(attach_race_worker, (?contexts[0])::*u8, ?workers[0]);
    thread.spawn_with(attach_race_worker, (?contexts[1])::*u8, ?workers[1]);
    if (workers[0].tid < 0 || workers[1].tid < 0) { ret 1; }
    for (atomic.load(?ready) != 2) { atomic.spin_hint(); }
    atomic.store(?go, 1);
    thread.join(?workers[0]);
    thread.join(?workers[1]);
    val first_result: i64 = atomic.load(?results[0]);
    val second_result: i64 = atomic.load(?results[1]);
    if (!((first_result == ACTIVE && second_result == INVALID) || (first_result == INVALID && second_result == ACTIVE))) { ret 1; }
    cancel(?first);
    cancel(?second);
    if (atomic.load(?count) != 1 || !made(destroy(?first)) || !made(destroy(?second))) { ret 1; }
    ret 0;
}

test "cancel scope: unregister pins scope lifetime until removal" {
    var round: usize = 0;
    for (round < 256) {
        var scope: Scope;
        if (!made(make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
        var count: i64 = 0;
        var why: i64 = ACTIVE;
        var callback: TestCallback = TestCallback{count: ?count, reason: ?why};
        var registration: Registration;
        init_registration(?registration);
        if (!is_active(attach(?scope, ?registration, test_callback, (?callback)::ptr))) { ret 1; }
        var ready: i64 = 0;
        var go: i64 = 0;
        var result: i64 = -1;
        var context: UnregisterRaceContext = UnregisterRaceContext{registration: ?registration, ready: ?ready, go: ?go, result: ?result};
        var worker: thread.Thread;
        thread.spawn_with(unregister_race_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        for (atomic.load(?ready) == 0) { atomic.spin_hint(); }
        atomic.store(?go, 1);
        if (!changed(cancel(?scope))) { ret 1; }
        val destroyed: bool = made(destroy(?scope));
        thread.join(?worker);
        val unregistered: bool = atomic.load(?result) == 1;
        if (!destroyed && !made(destroy(?scope))) { ret 1; }
        if ((unregistered && atomic.load(?count) != 0) || (!unregistered && (atomic.load(?count) != 1 || atomic.load(?why) != CANCELLED))) { ret 1; }
        round = round + 1;
    }
    ret 0;
}

test "cancel scope: registration reuse waits for callback return" {
    var first: Scope;
    var second: Scope;
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    if (!made(make_root(?first, false, none)) || !made(make_root(?second, false, none))) { ret 1; }
    var count: i64 = 0;
    var why: i64 = ACTIVE;
    var started: i64 = 0;
    var release: i64 = 0;
    var block: CallbackBlockContext = CallbackBlockContext{count: ?count, reason: ?why, started: ?started, release: ?release};
    var registration: Registration;
    init_registration(?registration);
    if (!is_active(attach(?first, ?registration, blocking_callback, (?block)::ptr))) { ret 1; }
    var cancel_result: i64 = 0;
    var context: CancelRaceContext = CancelRaceContext{scope: ?first, result: ?cancel_result};
    var worker: thread.Thread;
    thread.spawn_with(cancel_race_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 1; }
    for (atomic.load(?started) == 0) { atomic.spin_hint(); }
    if (!is_invalid(attach(?second, ?registration, blocking_callback, (?block)::ptr))) { ret 1; }
    atomic.store(?release, 1);
    thread.join(?worker);
    if (atomic.load(?cancel_result) != 1 || atomic.load(?count) != 1 || atomic.load(?why) != CANCELLED) { ret 1; }
    if (!is_active(attach(?second, ?registration, blocking_callback, (?block)::ptr))) { ret 1; }
    if (!changed(cancel(?second)) || atomic.load(?count) != 2 || !made(destroy(?first)) || !made(destroy(?second))) { ret 1; }
    ret 0;
}

test "cancel scope: inherited monotonic deadlines preserve the first reason" {
    var root: Scope;
    var child: Scope;
    val parent_deadline: time.Time = time.Time{sec: 10, nsec: 0};
    val child_deadline: time.Time = time.Time{sec: 20, nsec: 0};
    if (!made(make_root(?root, true, parent_deadline))) { ret 1; }
    if (!made(make_child(?child, ?root, true, child_deadline))) { ret 1; }
    if (changed(expire(?child, time.Time{sec: 9, nsec: 999999999}))) { ret 1; }
    if (!changed(expire(?child, parent_deadline)) || !is_timed_out(reason(?root)) || !is_timed_out(reason(?child))) { ret 1; }
    if (changed(cancel(?root))) { ret 1; }
    if (!made(destroy(?child)) || !made(destroy(?root))) { ret 1; }
    ret 0;
}

rec WaitContext {
    scope: *Scope;
    result: *i64;
}

fun wait_worker(arg: *u8) {
    val context: *WaitContext = arg::*WaitContext;
    atomic.store(context.result, state_of(wait(context.scope)));
}

test "cancel scope: native wait observes cancellation without spinning" {
    var scope: Scope;
    if (!made(make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
    var result: i64 = ACTIVE;
    var context: WaitContext = WaitContext{scope: ?scope, result: ?result};
    var worker: thread.Thread;
    thread.spawn_with(wait_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 1; }
    for (waiter_count(?scope) == 0) { atomic.spin_hint(); }
    if (made(destroy(?scope))) { ret 1; }
    if (!changed(cancel(?scope))) { ret 1; }
    thread.join(?worker);
    if (atomic.load(?result) != CANCELLED || waiter_count(?scope) != 0 || !made(destroy(?scope))) { ret 1; }
    ret 0;
}

test "cancel scope: native broadcast loses no waiters under stress" {
    var round: usize = 0;
    for (round < 16) {
        var scope: Scope;
        if (!made(make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
        var results: [4]i64;
        var contexts: [4]WaitContext;
        var workers: [4]thread.Thread;
        var i: usize = 0;
        for (i < 4) {
            contexts[i] = WaitContext{scope: ?scope, result: ?results[i]};
            thread.spawn_with(wait_worker, (?contexts[i])::*u8, ?workers[i]);
            if (workers[i].tid < 0) { ret 1; }
            i = i + 1;
        }
        for (waiter_count(?scope) != 4) { atomic.spin_hint(); }
        if (!changed(cancel(?scope))) { ret 1; }
        i = 0;
        for (i < 4) {
            thread.join(?workers[i]);
            if (atomic.load(?results[i]) != CANCELLED) { ret 1; }
            i = i + 1;
        }
        if (waiter_count(?scope) != 0 || !made(destroy(?scope))) { ret 1; }
        round = round + 1;
    }
    ret 0;
}
