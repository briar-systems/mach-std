# caller-owned hierarchical cancellation
#
# threading model
# each scope's lock guards its state, its registrations and its children's
# sibling links. attach and unregister take only their scope's lock, and
# make_child and dnit take the parent's (dnit then the scope's own).
# a cancel walks the subtree top-down, holding a parent's lock while it visits
# that parent's children. locks are only ever taken parent before child.
# finish and reason take no lock.
#
# a shared scope serializes attach and unregister across every thread using
# it, and a shared parent serializes make_child and dnit. servers should
# give each worker its own root and each connection its own child scope. on a
# ryzen 7 5800x3d at -O2, attach plus unregister totals about 3.8M/s on one
# scope shared by 8 threads, against about 78M/s on 8 per-thread children

use std.chrono.time;
use std.sync.atomic;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

$if (capability.HAS_THREADS) {
    use std.sync.mutex;
    use std.sync.thread;
    use std.system.os;
}
$or {
    $error("std.sync.cancel needs the threads capability (std.system.capability.HAS_THREADS)");
}

# why a scope is no longer active, or that it still is
# ---
# active:    no cancellation has been requested
# cancelled: cancelled explicitly through this scope or an ancestor
# timed_out: an absolute deadline owned by this scope or an ancestor passed
# destroyed: the scope was destroyed, or the call reached a destroyed scope
# invalid:   the call was refused (nil operands, a registration in use)
pub tag Reason: u8 { active; cancelled; timed_out; destroyed; invalid; }

# a refused scope or registration operation
# ---
# invalid:   nil operands, a deadline outside the target range, a scope
#            parented to itself, or a scope that was never made
# destroyed: the scope (or the parent) has already been destroyed
# busy:      destruction refused while children, registrations, waiters,
#            running callbacks or in-flight callers remain
pub tag StateError: u8 { invalid; destroyed; busy; }

# the effective absolute monotonic deadline of a scope
# ---
# at:    the earliest deadline along the ancestor chain
# owner: the scope that declared it, borrowed from the tree
pub rec Deadline {
    at:    time.Instant;
    owner: *Scope;
}

pub def CancelFun: fun(ptr, Reason);

pub def Transition:    res[bool, StateError];
pub def Operation:     err[StateError];
pub def DeadlineQuery: res[opt[Deadline], StateError];

val ACTIVE:    i64 = 0;
val CANCELLED: i64 = 1;
val TIMED_OUT: i64 = 2;
val DESTROYED: i64 = 3;
#[testing]
val INVALID:   i64 = 4;

fun reason_of(state: i64) Reason {
    if (state == ACTIVE)    { ret Reason.active{}; }
    if (state == CANCELLED) { ret Reason.cancelled{}; }
    if (state == TIMED_OUT) { ret Reason.timed_out{}; }
    if (state == DESTROYED) { ret Reason.destroyed{}; }
    ret Reason.invalid{};
}

#[testing]
fun state_of(reason: Reason) i64 {
    if (sel reason.active)    { ret ACTIVE; }
    if (sel reason.cancelled) { ret CANCELLED; }
    if (sel reason.timed_out) { ret TIMED_OUT; }
    if (sel reason.destroyed) { ret DESTROYED; }
    ret INVALID;
}

val REG_UNUSED:    i64 = 0;
val REG_ACTIVE:    i64 = 1;
val REG_CANCELLED: i64 = 2;
val REG_COMPLETED: i64 = 3;
val REG_CLAIMING:  i64 = 4;
val REG_DETACHING: i64 = 5;
val GATE_CLOSED:   i64 = -1;

# a caller-owned slot that ties a cancellation callback to a scope
#
# prepare it with registration_make, then attach it. the fields are internal.
# ---
# root:       root of the scope it is attached to, nil while unattached
# scope:      scope it is listed on, nil while unattached or once claimed
# prev:       previous registration on the scope's list
# next:       next registration on the scope's list, or on a cancel's claim list
# callback:   hook run when the scope is cancelled or times out
# completion: optional hook run after callback, nil when absent
# context:    caller pointer passed to both hooks
# reason:     state the claiming cancel moved the scope to
# state:      lifecycle state of the registration, changed atomically
pub rec Registration {
    root:       *Scope;
    scope:      *Scope;
    prev:       *Registration;
    next:       *Registration;
    callback:   CancelFun;
    completion: CancelFun;
    context:    ptr;
    reason:     i64;
    state:      i64;
}

# a caller-owned node in a cancellation tree, fixed in memory once made
#
# prepare it with make_root or make_child and release it with dnit. the fields
# are internal.
# ---
# root:               root of the tree, the scope itself for a root
# parent:             parent scope, nil for a root
# first_child:        head of the list of child scopes
# prev_sibling:       previous child of the same parent
# next_sibling:       next child of the same parent
# first_registration: head of the list of attached registrations
# deadline:           effective absolute monotonic deadline, none when absent
# deadline_owner:     scope that declared the effective deadline
# state:              active, cancelled, timed out or destroyed, changed atomically
# waiters:            threads blocked in wait on this scope
# gate:               in-flight callers, or GATE_CLOSED once destroyed
# callback_count:     claimed callbacks still running, kept on the root
# lock:               guards state, registrations and the children's sibling links
pub rec Scope {
    root:               *Scope;
    parent:             *Scope;
    first_child:        *Scope;
    prev_sibling:       *Scope;
    next_sibling:       *Scope;
    first_registration: *Registration;
    deadline:           opt[time.Instant];
    deadline_owner:     *Scope;
    state:              i64;
    waiters:            i64;
    gate:               i64;
    callback_count:     i64;
    lock:               mutex.Mutex;
}

fun valid_deadline(deadline: opt[time.Instant]) bool {
    if (sel deadline.none) { ret true; }
    ret deadline.some.sec >= 0 && deadline.some.nsec >= 0 && deadline.some.nsec < 1000000000;
}

# scopes are fixed in memory and own no target handle or allocation
# callers stop starting new calls before reclaiming a destroyed scope
#
# a deadline is an absolute monotonic Instant, for example
# `time.instant_add(time.instant().ok, timeout)`
# ---
# scope:    storage to make into a root scope
# deadline: absolute monotonic deadline, or none
# ret:      ok, or invalid for a nil scope or a malformed deadline
pub fun make_root(scope: *Scope, deadline: opt[time.Instant]) Operation {
    if (scope == nil || !valid_deadline(deadline)) { ret Operation.err{StateError.invalid{}}; }
    scope.root               = scope;
    scope.parent             = nil;
    scope.first_child        = nil;
    scope.prev_sibling       = nil;
    scope.next_sibling       = nil;
    scope.first_registration = nil;
    scope.deadline           = deadline;
    scope.deadline_owner     = nil;
    if (sel deadline.some) { scope.deadline_owner = scope; }
    scope.state          = ACTIVE;
    scope.waiters        = 0;
    scope.gate           = 0;
    scope.callback_count = 0;
    scope.lock           = mutex.make();
    ret Operation.ok{};
}

fun scope_enter(scope: *Scope) bool {
    if (scope == nil) { ret false; }
    for (true) {
        val current: i64 = atomic.load(?scope.gate);
        if (current == GATE_CLOSED) { ret false; }
        var expected: i64 = current;
        if (atomic.cas(?scope.gate, ?expected, current + 1)) { ret true; }
    }
    ret false;
}

fun scope_leave(scope: *Scope) {
    atomic.fetch_sub(?scope.gate, 1);
}

# child deadlines inherit the earliest absolute monotonic ancestor deadline
#
# a deadline is an absolute monotonic Instant, for example
# `time.instant_add(time.instant().ok, timeout)`
# a child made under a parent that already left active starts in the same state
# ---
# scope:    storage to make into a child scope
# parent:   live scope to attach the child under
# deadline: absolute monotonic deadline of the child, or none
# ret:      ok, invalid for nil operands, scope equal to parent or a malformed
#           deadline, destroyed when the parent has been destroyed
pub fun make_child(scope: *Scope, parent: *Scope, deadline: opt[time.Instant]) Operation {
    if (scope == nil || parent == nil || scope == parent || !valid_deadline(deadline)) { ret Operation.err{StateError.invalid{}}; }
    if (!scope_enter(parent))                                                          { ret Operation.err{StateError.destroyed{}}; }
    mutex.lock(?parent.lock);
    if (atomic.load(?parent.state) == DESTROYED) {
        mutex.unlock(?parent.lock);
        scope_leave(parent);
        ret Operation.err{StateError.destroyed{}};
    }
    scope.root               = parent.root;
    scope.parent             = parent;
    scope.first_child        = nil;
    scope.prev_sibling       = nil;
    scope.next_sibling       = parent.first_child;
    scope.first_registration = nil;
    scope.deadline           = deadline;
    scope.deadline_owner     = nil;
    val opt_inherited: opt[time.Instant] = parent.deadline;
    var inherit:       bool              = sel opt_inherited.some;
    if (sel opt_inherited.some) {
        if (sel deadline.some) { inherit = !time.instant_before(deadline.some, opt_inherited.some); }
    }
    if (inherit) {
        scope.deadline       = opt_inherited;
        scope.deadline_owner = parent.deadline_owner;
    }
    or (sel deadline.some) {
        scope.deadline_owner = scope;
    }
    scope.state          = atomic.load(?parent.state);
    scope.waiters        = 0;
    scope.gate           = 0;
    scope.callback_count = 0;
    scope.lock           = mutex.make();
    if (parent.first_child != nil) { parent.first_child.prev_sibling = scope; }
    parent.first_child = scope;
    mutex.unlock(?parent.lock);
    scope_leave(parent);
    ret Operation.ok{};
}

# initialization is valid before first attachment or after terminal completion
# ---
# registration: storage to reset to the unused state
# ret:          ok, or invalid for nil
pub fun registration_make(registration: *Registration) Operation {
    if (registration == nil) { ret Operation.err{StateError.invalid{}}; }
    registration.root       = nil;
    registration.scope      = nil;
    registration.prev       = nil;
    registration.next       = nil;
    registration.callback   = (0::usize)::CancelFun;
    registration.completion = (0::usize)::CancelFun;
    registration.context    = nil;
    registration.reason     = ACTIVE;
    registration.state      = REG_UNUSED;
    ret Operation.ok{};
}

fun registration_remove(registration: *Registration) {
    val scope: *Scope = registration.scope;
    if (registration.prev != nil) {
        registration.prev.next = registration.next;
    }
    or {
        scope.first_registration = registration.next;
    }
    if (registration.next != nil) { registration.next.prev = registration.prev; }
}

fun attach_internal(scope: *Scope, registration: *Registration, callback: CancelFun, completion: CancelFun, context: ptr) Reason {
    if (scope == nil || registration == nil || callback::usize == 0) { ret Reason.invalid{}; }
    if (!scope_enter(scope))                                         { ret Reason.destroyed{}; }
    val registration_state: i64 = atomic.load(?registration.state);
    if (registration_state != REG_UNUSED && registration_state != REG_COMPLETED) {
        scope_leave(scope);
        ret Reason.invalid{};
    }
    var expected: i64 = registration_state;
    if (!atomic.cas(?registration.state, ?expected, REG_CLAIMING)) {
        scope_leave(scope);
        ret Reason.invalid{};
    }
    mutex.lock(?scope.lock);
    val state: i64 = atomic.load(?scope.state);
    if (state != ACTIVE) {
        atomic.store(?registration.state, registration_state);
        mutex.unlock(?scope.lock);
        scope_leave(scope);
        ret reason_of(state);
    }
    registration.root  = scope.root;
    registration.scope = scope;
    registration.prev  = nil;
    registration.next  = scope.first_registration;
    if (scope.first_registration != nil) { scope.first_registration.prev = registration; }
    registration.callback   = callback;
    registration.completion = completion;
    registration.context    = context;
    registration.reason     = ACTIVE;
    atomic.store(?registration.state, REG_ACTIVE);
    scope.first_registration = registration;
    mutex.unlock(?scope.lock);
    scope_leave(scope);
    ret Reason.active{};
}

# successful registration is the ownership linearization point
# ---
# scope:        scope to attach to
# registration: unused or completed registration to attach
# callback:     hook run once if the scope is cancelled or times out
# context:      caller pointer passed to callback
# ret:          active once attached, the scope's reason when it already left
#               active, destroyed for a destroyed scope, invalid for nil
#               operands, a nil callback or a registration in use
pub fun attach(scope: *Scope, registration: *Registration, callback: CancelFun, context: ptr) Reason {
    ret attach_internal(scope, registration, callback, (0::usize)::CancelFun, context);
}

# completion publishes external work and must call finish under its lifetime lock
# ---
# scope:        scope to attach to
# registration: unused or completed registration to attach
# callback:     hook run once if the scope is cancelled or times out
# completion:   hook run right after callback, it must end with finish
# context:      caller pointer passed to both hooks
# ret:          as attach, and invalid for a nil completion
pub fun attach_with_completion(scope: *Scope, registration: *Registration, callback: CancelFun, completion: CancelFun, context: ptr) Reason {
    if (completion::usize == 0) { ret Reason.invalid{}; }
    ret attach_internal(scope, registration, callback, completion, context);
}

# this must be the completion hook's final registration operation
# ---
# registration: registration whose completion hook is running
# ret:          true when this call completed a cancelled registration, false
#               when the registration was not awaiting completion, invalid for
#               nil
pub fun finish(registration: *Registration) Transition {
    if (registration == nil) { ret Transition.err{StateError.invalid{}}; }
    var expected: i64 = REG_CANCELLED;
    ret Transition.ok{atomic.cas(?registration.state, ?expected, REG_COMPLETED)};
}

# completion wins only while the registration remains owned by its scope
# ---
# registration: registration to detach from its scope
# ret:          true when this call detached the registration, false when
#               cancellation already claimed it (the completion hook owns it),
#               invalid for nil
pub fun unregister(registration: *Registration) Transition {
    if (registration == nil) { ret Transition.err{StateError.invalid{}}; }
    var expected: i64 = REG_ACTIVE;
    if (!atomic.cas(?registration.state, ?expected, REG_DETACHING)) { ret Transition.ok{false}; }
    # a detaching registration stays listed, which keeps its scope alive
    val scope: *Scope = registration.scope;
    mutex.lock(?scope.lock);
    registration_remove(registration);
    registration.scope  = nil;
    registration.root   = nil;
    registration.reason = ACTIVE;
    atomic.store(?registration.state, REG_COMPLETED);
    mutex.unlock(?scope.lock);
    ret Transition.ok{true};
}

fun wake_scope(scope: *Scope) {
    val waiters: i64 = atomic.load(?scope.waiters);
    var i:       i64 = 0;
    for (i < waiters) {
        os.thread_wake(?scope.state);
        i = i + 1;
    }
}

fun mark_scope_locked(current: *Scope, reason: i64, callbacks: **Registration) {
    if (atomic.load(?current.state) != ACTIVE) { ret; }
    atomic.store(?current.state, reason);
    wake_scope(current);
    var claimed:      i64           = 0;
    var registration: *Registration = current.first_registration;
    current.first_registration = nil;
    for (registration != nil) {
        val next:     *Registration = registration.next;
        var expected: i64           = REG_ACTIVE;
        if (atomic.cas(?registration.state, ?expected, REG_CANCELLED)) {
            registration.prev   = nil;
            registration.next   = @callbacks;
            registration.scope  = nil;
            registration.reason = reason;
            @callbacks          = registration;
            claimed             = claimed + 1;
        }
        or {
            registration.prev = nil;
            registration.next = current.first_registration;
            if (current.first_registration != nil) { current.first_registration.prev = registration; }
            current.first_registration = registration;
        }
        registration = next;
    }
    # counted before the lock drops so destroy never sees an unlisted claim uncounted
    atomic.fetch_add(?current.root.callback_count, claimed);
}

# entered holding scope's lock, returns having released it
# locks are taken parent before child, and a sibling link is read under its
# parent's lock, which the walk holds while it visits that parent's children
fun mark_tree_locked(scope: *Scope, reason: i64, callbacks: **Registration) {
    var current: *Scope = scope;
    for (true) {
        mark_scope_locked(current, reason, callbacks);
        val child: *Scope = current.first_child;
        if (child != nil) {
            mutex.lock(?child.lock);
            current = child;
        }
        or {
            var climbing: bool = true;
            for (climbing) {
                if (current == scope) {
                    mutex.unlock(?current.lock);
                    ret;
                }
                val sibling: *Scope = current.next_sibling;
                val parent:  *Scope = current.parent;
                mutex.unlock(?current.lock);
                if (sibling != nil) {
                    mutex.lock(?sibling.lock);
                    current  = sibling;
                    climbing = false;
                }
                or {
                    current = parent;
                }
            }
        }
    }
}

# ret: true when this call moved the scope out of active, false when it was
#      already cancelled or timed out, destroyed once the scope is gone
fun transition(scope: *Scope, reason: i64) Transition {
    if (scope == nil)        { ret Transition.err{StateError.invalid{}}; }
    if (!scope_enter(scope)) { ret Transition.err{StateError.destroyed{}}; }
    val root:      *Scope        = scope.root;
    var callbacks: *Registration = nil;
    mutex.lock(?scope.lock);
    if (atomic.load(?scope.state) != ACTIVE) {
        mutex.unlock(?scope.lock);
        scope_leave(scope);
        ret Transition.ok{false};
    }
    mark_tree_locked(scope, reason, ?callbacks);

    var ran:          i64           = 0;
    var registration: *Registration = callbacks;
    for (registration != nil) {
        val next:            *Registration = registration.next;
        val callback:        CancelFun     = registration.callback;
        val completion:      CancelFun     = registration.completion;
        val context:         ptr           = registration.context;
        val callback_reason: Reason        = reason_of(registration.reason);
        registration.root = nil;
        callback(context, callback_reason);
        if (completion::usize == 0) {
            var expected: i64 = REG_CANCELLED;
            atomic.cas(?registration.state, ?expected, REG_COMPLETED);
        }
        or {
            completion(context, callback_reason);
        }
        ran          = ran + 1;
        registration = next;
    }
    atomic.fetch_sub(?root.callback_count, ran);

    scope_leave(scope);
    ret Transition.ok{true};
}

# cancel a scope and its whole subtree, running each claimed callback
# ---
# scope: scope to cancel
# ret:   true when this call cancelled the scope, false when it was already
#        cancelled or timed out
pub fun cancel(scope: *Scope) Transition {
    ret transition(scope, CANCELLED);
}

# time a scope and its whole subtree out, running each claimed callback
# ---
# scope: scope to time out
# ret:   true when this call timed the scope out, false when it was already
#        cancelled or timed out
pub fun timeout(scope: *Scope) Transition {
    ret transition(scope, TIMED_OUT);
}

# callers without a runtime may drive absolute deadlines explicitly
# ---
# scope: scope whose effective deadline is checked
# now:   current absolute monotonic instant
# ret:   true when now reached the effective deadline and this call timed its
#        owner out, false when there is no deadline, it has not passed, or the
#        owner had already left active
pub fun expire(scope: *Scope, now: time.Instant) Transition {
    if (scope == nil)        { ret Transition.err{StateError.invalid{}}; }
    if (!scope_enter(scope)) { ret Transition.err{StateError.destroyed{}}; }
    val opt_deadline: opt[time.Instant] = scope.deadline;
    val owner:        *Scope            = scope.deadline_owner;
    var pending:      bool              = true;
    if (sel opt_deadline.some) { pending = time.instant_before(now, opt_deadline.some); }
    if (pending) {
        scope_leave(scope);
        ret Transition.ok{false};
    }
    val res_expired: Transition = timeout(owner);
    scope_leave(scope);
    ret res_expired;
}

# returns the effective deadline and the ancestor that owns it
# ---
# scope: scope to query
# ret:   some{deadline} when the scope or an ancestor declared one, none when
#        the scope has no deadline, destroyed once the scope is gone
pub fun get_deadline(scope: *Scope) DeadlineQuery {
    if (scope == nil)        { ret DeadlineQuery.err{StateError.invalid{}}; }
    if (!scope_enter(scope)) { ret DeadlineQuery.err{StateError.destroyed{}}; }
    val opt_deadline: opt[time.Instant] = scope.deadline;
    if (sel opt_deadline.none) {
        scope_leave(scope);
        ret DeadlineQuery.ok{opt[Deadline].none{}};
    }
    val found: Deadline = Deadline{at: opt_deadline.some, owner: scope.deadline_owner};
    scope_leave(scope);
    ret DeadlineQuery.ok{opt[Deadline].some{found}};
}

# read why a scope is no longer active, or that it still is
# ---
# scope: scope to read
# ret:   the scope's reason, destroyed for nil or a destroyed scope
pub fun reason(scope: *Scope) Reason {
    if (scope == nil || !scope_enter(scope)) { ret Reason.destroyed{}; }
    val state: i64 = atomic.load(?scope.state);
    scope_leave(scope);
    ret reason_of(state);
}

# block until a scope leaves active
# ---
# scope: scope to wait on
# ret:   the reason it left active, destroyed for nil or a destroyed scope
pub fun wait(scope: *Scope) Reason {
    if (scope == nil || !scope_enter(scope)) { ret Reason.destroyed{}; }
    for (true) {
        val observed: i64 = atomic.load(?scope.state);
        if (observed != ACTIVE) {
            scope_leave(scope);
            ret reason_of(observed);
        }
        atomic.fetch_add(?scope.waiters, 1);
        if (atomic.load(?scope.state) == ACTIVE) { os.thread_wait(?scope.state, ACTIVE); }
        atomic.fetch_sub(?scope.waiters, 1);
    }
    ret Reason.destroyed{};
}

# count the threads blocked in wait on a scope
# ---
# scope: scope to read
# ret:   waiter count, 0 for nil or a destroyed scope
pub fun waiter_count(scope: *Scope) i64 {
    if (scope == nil || !scope_enter(scope)) { ret 0; }
    val count: i64 = atomic.load(?scope.waiters);
    scope_leave(scope);
    ret count;
}

fun unlock_family(scope: *Scope) {
    mutex.unlock(?scope.lock);
    if (scope.parent != nil) { mutex.unlock(?scope.parent.lock); }
}

# destruction rejects children, live registrations, waiters, and callbacks
# ---
# ret: ok once the scope is destroyed, invalid for a nil or never-made scope,
#      destroyed when it already was, busy while children, registrations,
#      waiters, running callbacks or in-flight callers remain
pub fun dnit(scope: *Scope) Operation {
    if (scope == nil || scope.root == nil) { ret Operation.err{StateError.invalid{}}; }
    # the parent's lock guards the sibling links, taken before the scope's own
    val parent: *Scope = scope.parent;
    if (parent != nil) { mutex.lock(?parent.lock); }
    mutex.lock(?scope.lock);
    if (atomic.load(?scope.state) == DESTROYED) {
        unlock_family(scope);
        ret Operation.err{StateError.destroyed{}};
    }
    if (scope.first_child != nil || scope.first_registration != nil || atomic.load(?scope.waiters) != 0 || atomic.load(?scope.root.callback_count) != 0) {
        unlock_family(scope);
        ret Operation.err{StateError.busy{}};
    }
    var expected: i64 = 0;
    if (!atomic.cas(?scope.gate, ?expected, GATE_CLOSED)) {
        unlock_family(scope);
        ret Operation.err{StateError.busy{}};
    }
    if (parent != nil) {
        if (scope.prev_sibling != nil) {
            scope.prev_sibling.next_sibling = scope.next_sibling;
        }
        or {
            parent.first_child = scope.next_sibling;
        }
        if (scope.next_sibling != nil) { scope.next_sibling.prev_sibling = scope.prev_sibling; }
    }
    atomic.store(?scope.state, DESTROYED);
    unlock_family(scope);
    ret Operation.ok{};
}

#[testing]
fun made(r: Operation) bool {
    ret sel r.ok;
}

#[testing]
fun changed(r: Transition) bool {
    if (sel r.ok) { ret r.ok; }
    ret false;
}

#[testing]
fun is_active(r: Reason) bool {
    ret sel r.active;
}

#[testing]
fun is_invalid(r: Reason) bool {
    ret sel r.invalid;
}

#[testing]
fun is_timed_out(r: Reason) bool {
    ret sel r.timed_out;
}

#[testing]
rec Callback {
    count:  *i64;
    reason: *i64;
}

#[testing]
fun on_cancel(context: ptr, why: Reason) {
    val callback: *Callback = context::*Callback;
    atomic.fetch_add(callback.count, 1);
    atomic.store(callback.reason, state_of(why));
}

test cancel_scope__parent_cancellation_reaches_every_descendant_once {
    var root:       Scope;
    var child:      Scope;
    var grandchild: Scope;
    if (!made(make_root(?root, opt[time.Instant].none{})))                { ret 1; }
    if (!made(make_child(?child, ?root, opt[time.Instant].none{})))       { ret 1; }
    if (!made(make_child(?grandchild, ?child, opt[time.Instant].none{}))) { ret 1; }
    var counts:        [3]i64;
    var reasons:       [3]i64;
    var callbacks:     [3]Callback;
    var registrations: [3]Registration;
    callbacks[0] = Callback{count: ?counts[0], reason: ?reasons[0]};
    callbacks[1] = Callback{count: ?counts[1], reason: ?reasons[1]};
    callbacks[2] = Callback{count: ?counts[2], reason: ?reasons[2]};
    registration_make(?registrations[0]);
    registration_make(?registrations[1]);
    registration_make(?registrations[2]);
    if (!is_active(attach(?root, ?registrations[0], on_cancel, (?callbacks[0])::ptr)))       { ret 1; }
    if (!is_active(attach(?child, ?registrations[1], on_cancel, (?callbacks[1])::ptr)))      { ret 1; }
    if (!is_active(attach(?grandchild, ?registrations[2], on_cancel, (?callbacks[2])::ptr))) { ret 1; }
    if (!changed(cancel(?root)) || changed(cancel(?root)))                                   { ret 1; }
    var i: usize = 0;
    for (i < 3) {
        if (atomic.load(?counts[i]) != 1 || atomic.load(?reasons[i]) != CANCELLED || changed(unregister(?registrations[i]))) { ret 1; }
        i = i + 1;
    }
    if (made(dnit(?root)) || made(dnit(?child)))                               { ret 1; }
    if (!made(dnit(?grandchild)) || !made(dnit(?child)) || !made(dnit(?root))) { ret 1; }
    ret 0;
}

test cancel_scope__refusals_name_their_cause {
    val err_nil_scope: Operation = make_root(nil, opt[time.Instant].none{});
    if (!sel err_nil_scope.err)         { ret 1; }
    if (!sel err_nil_scope.err.invalid) { ret 2; }
    var scope:            Scope;
    val err_bad_deadline: Operation = make_root(?scope, opt[time.Instant].some{time.Instant{sec: 0, nsec: 1000000000}});
    if (!sel err_bad_deadline.err)         { ret 3; }
    if (!sel err_bad_deadline.err.invalid) { ret 4; }
    val err_never_made: Operation = dnit(?scope);
    if (!sel err_never_made.err)                            { ret 5; }
    if (!sel err_never_made.err.invalid)                    { ret 6; }
    if (!made(make_root(?scope, opt[time.Instant].none{}))) { ret 7; }
    var count:        i64      = 0;
    var why:          i64      = ACTIVE;
    var callback:     Callback = Callback{count: ?count, reason: ?why};
    var registration: Registration;
    registration_make(?registration);
    if (!is_active(attach(?scope, ?registration, on_cancel, (?callback)::ptr))) { ret 8; }
    val err_busy: Operation = dnit(?scope);
    if (!sel err_busy.err)                   { ret 9; }
    if (!sel err_busy.err.busy)              { ret 10; }
    if (!changed(unregister(?registration))) { ret 11; }
    val res_first: Transition = cancel(?scope);
    if (!sel res_first.ok) { ret 12; }
    if (!res_first.ok)     { ret 13; }
    val res_second: Transition = cancel(?scope);
    if (!sel res_second.ok)  { ret 14; }
    if (res_second.ok)       { ret 15; }
    if (!made(dnit(?scope))) { ret 16; }
    val err_again: Operation = dnit(?scope);
    if (!sel err_again.err)           { ret 17; }
    if (!sel err_again.err.destroyed) { ret 18; }
    val res_after: Transition = cancel(?scope);
    if (!sel res_after.err)           { ret 19; }
    if (!sel res_after.err.destroyed) { ret 20; }
    val res_query: DeadlineQuery = get_deadline(?scope);
    if (!sel res_query.err)           { ret 21; }
    if (!sel res_query.err.destroyed) { ret 22; }
    var child:      Scope;
    val err_orphan: Operation = make_child(?child, ?scope, opt[time.Instant].none{});
    if (!sel err_orphan.err)           { ret 23; }
    if (!sel err_orphan.err.destroyed) { ret 24; }
    ret 0;
}

test cancel_scope__deadline_query_reports_absence_and_the_owning_ancestor {
    var root:  Scope;
    var child: Scope;
    val at:    time.Instant = time.Instant{sec: 10, nsec: 0};
    if (!made(make_root(?root, opt[time.Instant].some{at})))        { ret 1; }
    if (!made(make_child(?child, ?root, opt[time.Instant].none{}))) { ret 2; }
    val res_inherited: DeadlineQuery = get_deadline(?child);
    if (!sel res_inherited.ok)                                                                     { ret 3; }
    if (!sel res_inherited.ok.some)                                                                { ret 4; }
    if (res_inherited.ok.some.owner != ?root || !time.instant_equal(res_inherited.ok.some.at, at)) { ret 5; }
    if (!made(dnit(?child)) || !made(dnit(?root)))                                                 { ret 6; }
    var plain: Scope;
    if (!made(make_root(?plain, opt[time.Instant].none{}))) { ret 7; }
    val res_absent: DeadlineQuery = get_deadline(?plain);
    if (!sel res_absent.ok)      { ret 8; }
    if (!sel res_absent.ok.none) { ret 9; }
    if (!made(dnit(?plain)))     { ret 10; }

    # a child's own deadline earlier than its parent's is its own
    var parent: Scope;
    var early:  Scope;
    val sooner: time.Instant = time.Instant{sec: 5, nsec: 0};
    if (!made(make_root(?parent, opt[time.Instant].some{at})))              { ret 11; }
    if (!made(make_child(?early, ?parent, opt[time.Instant].some{sooner}))) { ret 11; }
    val res_own: DeadlineQuery = get_deadline(?early);
    if (!sel res_own.ok)                                                                    { ret 12; }
    if (!sel res_own.ok.some)                                                               { ret 12; }
    if (res_own.ok.some.owner != ?early || !time.instant_equal(res_own.ok.some.at, sooner)) { ret 13; }
    if (!made(dnit(?early)) || !made(dnit(?parent)))                                        { ret 14; }
    ret 0;
}

test cancel_scope__active_registrations_cannot_be_attached_twice {
    var root:  Scope;
    var other: Scope;
    if (!made(make_root(?root, opt[time.Instant].none{})) || !made(make_root(?other, opt[time.Instant].none{}))) { ret 1; }
    var count:        i64      = 0;
    var why:          i64      = ACTIVE;
    var callback:     Callback = Callback{count: ?count, reason: ?why};
    var registration: Registration;
    registration_make(?registration);
    if (!is_active(attach(?root, ?registration, on_cancel, (?callback)::ptr)))                 { ret 1; }
    if (!is_invalid(attach(?root, ?registration, on_cancel, (?callback)::ptr)))                { ret 1; }
    if (!is_invalid(attach(?other, ?registration, on_cancel, (?callback)::ptr)))               { ret 1; }
    if (!changed(cancel(?root)) || atomic.load(?count) != 1 || atomic.load(?why) != CANCELLED) { ret 1; }
    if (!made(dnit(?root)) || !made(dnit(?other)))                                             { ret 1; }
    ret 0;
}

#[testing]
rec AttachRaceContext {
    scope:        *Scope;
    registration: *Registration;
    callback:     *Callback;
    ready:        *i64;
    go:           *i64;
    result:       *i64;
}

#[testing]
fun attach_race_worker(arg: *u8) {
    val context: *AttachRaceContext = arg::*AttachRaceContext;
    atomic.fetch_add(context.ready, 1);
    for (atomic.load(context.go) == 0) { atomic.spin_hint(); }
    val attached: Reason = attach(context.scope, context.registration, on_cancel, context.callback::ptr);
    atomic.store(context.result, state_of(attached));
}

#[testing]
rec UnregisterRaceContext {
    registration: *Registration;
    ready:        *i64;
    go:           *i64;
    result:       *i64;
}

#[testing]
fun unregister_race_worker(arg: *u8) {
    val context: *UnregisterRaceContext = arg::*UnregisterRaceContext;
    atomic.store(context.ready, 1);
    for (atomic.load(context.go) == 0) { atomic.spin_hint(); }
    var result: i64 = 0;
    if (changed(unregister(context.registration))) { result = 1; }
    atomic.store(context.result, result);
}

#[testing]
rec CallbackBlockContext {
    count:   *i64;
    reason:  *i64;
    started: *i64;
    release: *i64;
}

#[testing]
fun blocking_callback(context: ptr, why: Reason) {
    val block: *CallbackBlockContext = context::*CallbackBlockContext;
    atomic.store(block.started, 1);
    for (atomic.load(block.release) == 0) { atomic.spin_hint(); }
    atomic.fetch_add(block.count, 1);
    atomic.store(block.reason, state_of(why));
}

#[testing]
rec CancelRaceContext {
    scope:  *Scope;
    result: *i64;
}

#[testing]
fun cancel_race_worker(arg: *u8) {
    val context: *CancelRaceContext = arg::*CancelRaceContext;
    var result:  i64                = 0;
    if (changed(cancel(context.scope))) { result = 1; }
    atomic.store(context.result, result);
}

test cancel_scope__concurrent_roots_cannot_claim_one_registration {
    var first:  Scope;
    var second: Scope;
    if (!made(make_root(?first, opt[time.Instant].none{})) || !made(make_root(?second, opt[time.Instant].none{}))) { ret 1; }
    var count:        i64      = 0;
    var why:          i64      = ACTIVE;
    var callback:     Callback = Callback{count: ?count, reason: ?why};
    var registration: Registration;
    registration_make(?registration);
    var ready:    i64 = 0;
    var go:       i64 = 0;
    var results:  [2]i64;
    var contexts: [2]AttachRaceContext;
    contexts[0] = AttachRaceContext{scope: ?first, registration: ?registration, callback: ?callback, ready: ?ready, go: ?go, result: ?results[0]};
    contexts[1] = AttachRaceContext{scope: ?second, registration: ?registration, callback: ?callback, ready: ?ready, go: ?go, result: ?results[1]};
    var workers: [2]thread.Thread;
    thread.spawn_with(attach_race_worker, (?contexts[0])::*u8, ?workers[0]);
    thread.spawn_with(attach_race_worker, (?contexts[1])::*u8, ?workers[1]);
    if (workers[0].tid < 0 || workers[1].tid < 0) { ret 1; }
    for (atomic.load(?ready) != 2) { atomic.spin_hint(); }
    atomic.store(?go, 1);
    thread.join(?workers[0]);
    thread.join(?workers[1]);
    val first_result:  i64 = atomic.load(?results[0]);
    val second_result: i64 = atomic.load(?results[1]);
    if (!((first_result == ACTIVE && second_result == INVALID) || (first_result == INVALID && second_result == ACTIVE))) { ret 1; }
    cancel(?first);
    cancel(?second);
    if (atomic.load(?count) != 1 || !made(dnit(?first)) || !made(dnit(?second))) { ret 1; }
    ret 0;
}

test cancel_scope__unregister_pins_scope_lifetime_until_removal {
    var round: usize = 0;
    for (round < 256) {
        var scope: Scope;
        if (!made(make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
        var count:        i64      = 0;
        var why:          i64      = ACTIVE;
        var callback:     Callback = Callback{count: ?count, reason: ?why};
        var registration: Registration;
        registration_make(?registration);
        if (!is_active(attach(?scope, ?registration, on_cancel, (?callback)::ptr))) { ret 1; }
        var ready:   i64                   = 0;
        var go:      i64                   = 0;
        var result:  i64                   = -1;
        var context: UnregisterRaceContext = UnregisterRaceContext{registration: ?registration, ready: ?ready, go: ?go, result: ?result};
        var worker:  thread.Thread;
        thread.spawn_with(unregister_race_worker, (?context)::*u8, ?worker);
        if (worker.tid < 0) { ret 1; }
        for (atomic.load(?ready) == 0) { atomic.spin_hint(); }
        atomic.store(?go, 1);
        if (!changed(cancel(?scope))) { ret 1; }
        val destroyed: bool = made(dnit(?scope));
        thread.join(?worker);
        val unregistered: bool = atomic.load(?result) == 1;
        if (!destroyed && !made(dnit(?scope)))                                                                                             { ret 1; }
        if ((unregistered && atomic.load(?count) != 0) || (!unregistered && (atomic.load(?count) != 1 || atomic.load(?why) != CANCELLED))) { ret 1; }
        round = round + 1;
    }
    ret 0;
}

test cancel_scope__registration_reuse_waits_for_callback_return {
    var first:  Scope;
    var second: Scope;
    if (!made(make_root(?first, opt[time.Instant].none{})) || !made(make_root(?second, opt[time.Instant].none{}))) { ret 1; }
    var count:        i64                  = 0;
    var why:          i64                  = ACTIVE;
    var started:      i64                  = 0;
    var release:      i64                  = 0;
    var block:        CallbackBlockContext = CallbackBlockContext{count: ?count, reason: ?why, started: ?started, release: ?release};
    var registration: Registration;
    registration_make(?registration);
    if (!is_active(attach(?first, ?registration, blocking_callback, (?block)::ptr))) { ret 1; }
    var cancel_result: i64               = 0;
    var context:       CancelRaceContext = CancelRaceContext{scope: ?first, result: ?cancel_result};
    var worker:        thread.Thread;
    thread.spawn_with(cancel_race_worker, (?context)::*u8, ?worker);
    if (worker.tid < 0) { ret 1; }
    for (atomic.load(?started) == 0) { atomic.spin_hint(); }
    if (!is_invalid(attach(?second, ?registration, blocking_callback, (?block)::ptr))) { ret 1; }
    atomic.store(?release, 1);
    thread.join(?worker);
    if (atomic.load(?cancel_result) != 1 || atomic.load(?count) != 1 || atomic.load(?why) != CANCELLED)       { ret 1; }
    if (!is_active(attach(?second, ?registration, blocking_callback, (?block)::ptr)))                         { ret 1; }
    if (!changed(cancel(?second)) || atomic.load(?count) != 2 || !made(dnit(?first)) || !made(dnit(?second))) { ret 1; }
    ret 0;
}

test cancel_scope__inherited_monotonic_deadlines_preserve_the_first_reason {
    var root:            Scope;
    var child:           Scope;
    val parent_deadline: time.Instant = time.Instant{sec: 10, nsec: 0};
    val child_deadline:  time.Instant = time.Instant{sec: 20, nsec: 0};
    if (!made(make_root(?root, opt[time.Instant].some{parent_deadline})))                                           { ret 1; }
    if (!made(make_child(?child, ?root, opt[time.Instant].some{child_deadline})))                                   { ret 1; }
    if (changed(expire(?child, time.Instant{sec: 9, nsec: 999999999})))                                             { ret 1; }
    if (!changed(expire(?child, parent_deadline)) || !is_timed_out(reason(?root)) || !is_timed_out(reason(?child))) { ret 1; }
    if (changed(cancel(?root)))                                                                                     { ret 1; }
    if (!made(dnit(?child)) || !made(dnit(?root)))                                                                  { ret 1; }
    ret 0;
}

#[testing]
rec WaitContext {
    scope:  *Scope;
    result: *i64;
}

#[testing]
fun wait_worker(arg: *u8) {
    val context: *WaitContext = arg::*WaitContext;
    atomic.store(context.result, state_of(wait(context.scope)));
}

test cancel_scope__native_broadcast_loses_no_waiters_under_stress {
    var round: usize = 0;
    for (round < 16) {
        var scope: Scope;
        if (!made(make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
        var results:  [4]i64;
        var contexts: [4]WaitContext;
        var workers:  [4]thread.Thread;
        var i:        usize = 0;
        for (i < 4) {
            contexts[i] = WaitContext{scope: ?scope, result: ?results[i]};
            thread.spawn_with(wait_worker, (?contexts[i])::*u8, ?workers[i]);
            if (workers[i].tid < 0) { ret 1; }
            i = i + 1;
        }
        for (waiter_count(?scope) != 4) { atomic.spin_hint(); }
        if (made(dnit(?scope)))       { ret 1; }
        if (!changed(cancel(?scope))) { ret 1; }
        i = 0;
        for (i < 4) {
            thread.join(?workers[i]);
            if (atomic.load(?results[i]) != CANCELLED) { ret 1; }
            i = i + 1;
        }
        if (waiter_count(?scope) != 0 || !made(dnit(?scope))) { ret 1; }
        round = round + 1;
    }
    ret 0;
}

#[testing]
rec ChildChurnContext {
    scope:  *Scope;
    rounds: usize;
    go:     *i64;
    done:   *i64;
    result: *i64;
}

#[testing]
fun ignore_cancel(context: ptr, why: Reason) {}

#[testing]
fun child_churn_worker(arg: *u8) {
    val context: *ChildChurnContext = arg::*ChildChurnContext;
    for (atomic.load(context.go) == 0) { atomic.spin_hint(); }
    var registration: Registration;
    registration_make(?registration);
    var result: i64   = 0;
    var i:      usize = 0;
    for (i < context.rounds) {
        val attached: Reason = attach(context.scope, ?registration, ignore_cancel, nil);
        if (!is_active(attached)) {
            if (sel attached.cancelled) { i = context.rounds; }
            or                          { result = 1; }
        }
        or (!changed(unregister(?registration))) {
            # the cancel owns the registration until it completes it
            if (atomic.load(?registration.state) == REG_ACTIVE) { result = 1; }
            for (atomic.load(?registration.state) != REG_COMPLETED) { atomic.spin_hint(); }
            i = context.rounds;
        }
        i = i + 1;
    }
    atomic.store(context.result, result);
    atomic.store(context.done, 1);
}

test cancel_scope__a_root_cancel_reaches_every_child_under_concurrent_churn {
    var round: usize = 0;
    for (round < 32) {
        var root:     Scope;
        var children: [8]Scope;
        if (!made(make_root(?root, opt[time.Instant].none{}))) { ret 1; }
        var go:       i64   = 0;
        var dones:    [8]i64;
        var results:  [8]i64;
        var contexts: [8]ChildChurnContext;
        var workers:  [8]thread.Thread;
        var i:        usize = 0;
        for (i < 8) {
            if (!made(make_child(?children[i], ?root, opt[time.Instant].none{}))) { ret 2; }
            dones[i]    = 0;
            results[i]  = -1;
            contexts[i] = ChildChurnContext{scope: ?children[i], rounds: 100000000, go: ?go, done: ?dones[i], result: ?results[i]};
            thread.spawn_with(child_churn_worker, (?contexts[i])::*u8, ?workers[i]);
            if (workers[i].tid < 0) {
                # the spawned workers borrow this frame, so stop them first
                atomic.store(?go, 1);
                cancel(?root);
                var j: usize = 0;
                for (j < i) {
                    thread.join(?workers[j]);
                    j = j + 1;
                }
                ret 3;
            }
            i = i + 1;
        }
        atomic.store(?go, 1);
        if (!changed(cancel(?root))) { ret 4; }
        i = 0;
        for (i < 8) {
            thread.join(?workers[i]);
            if (atomic.load(?results[i]) != 0)   { ret 5; }
            if (is_active(reason(?children[i]))) { ret 6; }
            i = i + 1;
        }
        i = 0;
        for (i < 8) {
            if (!made(dnit(?children[i]))) { ret 7; }
            i = i + 1;
        }
        if (!made(dnit(?root))) { ret 8; }
        round = round + 1;
    }
    ret 0;
}
