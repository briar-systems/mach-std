# bounded caller-owned multi-producer multi-consumer channel

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.chrono.time;
use std.sync.atomic;
use std.sync.cancel;
use std.sync.condition;
use std.sync.mutex;
use std.sync.thread;
use std.system.os;
use std.system.panic;

pub def Status: u8;
pub val SENT:       Status = 0;
pub val RECEIVED:   Status = 1;
pub val FULL:       Status = 2;
pub val EMPTY:      Status = 3;
pub val CLOSED:     Status = 4;
pub val TIMED_OUT:  Status = 5;
pub val CANCELLED:  Status = 6;
pub val INVALID:    Status = 7;
pub val ABORTED:    Status = 8;

val GATE_CLOSED: i64 = -1;

pub rec Channel[T] {
    storage:     *T;
    capacity:    usize;
    head:        usize;
    len:         usize;
    open:        bool;
    initialized: bool;
    gate:        i64;
    lock:        mutex.Mutex;
    readable:    condition.Condition;
    writable:    condition.Condition;
}

rec CancelWait {
    condition:    *condition.Condition;
    lock:         *mutex.Mutex;
    registration: *cancel.Registration;
    done:         i64;
}

fun cancellation_wake(context: ptr, reason: cancel.Reason) {
    val wait: *CancelWait = context::*CancelWait;
    mutex.lock(wait.lock);
    condition.broadcast(wait.condition);
    mutex.unlock(wait.lock);
}

fun cancellation_complete(context: ptr, reason: cancel.Reason) {
    val wait: *CancelWait = context::*CancelWait;
    val lock: *mutex.Mutex = wait.lock;
    val registration: *cancel.Registration = wait.registration;
    val done: *i64 = ?wait.done;
    mutex.lock(lock);
    atomic.store(done, 1);
    os.thread_wake(done);
    val finished: bool = cancel.finish(registration);
    mutex.unlock(lock);
    if (!finished) { panic.panic("std.sync.channel: cancellation completion lost ownership\n"); }
}

fun cancellation_status(reason: cancel.Reason) Status {
    if (reason == cancel.TIMED_OUT) { ret TIMED_OUT; }
    if (reason == cancel.CANCELLED) { ret CANCELLED; }
    ret INVALID;
}

fun deadline_valid(deadline: time.Time) bool {
    ret deadline.sec >= 0 && deadline.nsec >= 0 && deadline.nsec < 1000000000;
}

fun enter[T](channel: *Channel[T]) bool {
    if (channel == nil) { ret false; }
    for (true) {
        val current: i64 = atomic.load(?channel.gate);
        if (current == GATE_CLOSED) { ret false; }
        var expected: i64 = current;
        if (atomic.cas(?channel.gate, ?expected, current + 1)) { ret true; }
    }
    ret false;
}

fun leave[T](channel: *Channel[T]) {
    atomic.fetch_sub(?channel.gate, 1);
}

# channels are unfair, unpoisoned, and own no storage or target handles
# storage and the channel address remain stable until close and waiter exit
pub fun make[T](channel: *Channel[T], storage: *T, capacity: usize) bool {
    if (channel == nil || storage == nil || capacity == 0) { ret false; }
    channel.storage = storage;
    channel.capacity = capacity;
    channel.head = 0;
    channel.len = 0;
    channel.open = true;
    channel.initialized = true;
    channel.gate = 0;
    channel.lock = mutex.make();
    channel.readable = condition.make();
    channel.writable = condition.make();
    ret true;
}

fun send_locked[T](channel: *Channel[T], value: T) Status {
    if (!channel.open) { ret CLOSED; }
    if (channel.len == channel.capacity) { ret FULL; }
    val index: usize = (channel.head + channel.len) % channel.capacity;
    channel.storage[index] = value;
    channel.len = channel.len + 1;
    condition.signal(?channel.readable);
    ret SENT;
}

# the caller retains value unless the send succeeds
pub fun try_send[T](channel: *Channel[T], value: T) Status {
    if (!enter[T](channel)) { ret INVALID; }
    mutex.lock(?channel.lock);
    val status: Status = send_locked[T](channel, value);
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret status;
}

# blocking send sleeps until one slot is owned or the channel closes
pub fun send[T](channel: *Channel[T], value: T) Status {
    if (!enter[T](channel)) { ret INVALID; }
    mutex.lock(?channel.lock);
    for (channel.open && channel.len == channel.capacity) {
        condition.wait(?channel.writable, ?channel.lock);
    }
    val status: Status = send_locked[T](channel, value);
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret status;
}

# deadlines are absolute monotonic instants and never fire early
pub fun send_until[T](channel: *Channel[T], value: T, deadline: time.Time) Status {
    if (!deadline_valid(deadline) || !enter[T](channel)) { ret INVALID; }
    mutex.lock(?channel.lock);
    var result: Status = FULL;
    for (channel.open && channel.len == channel.capacity && result == FULL) {
        if (!time.time_before(time.monotonic(), deadline)) {
            result = TIMED_OUT;
        }
        or {
            val waited: condition.WaitStatus = condition.wait_until(?channel.writable, ?channel.lock, deadline);
            if (waited == condition.TIMED_OUT) { result = TIMED_OUT; }
            or (waited == condition.WAIT_FAILED) { result = INVALID; }
        }
    }
    if (result == FULL) { result = send_locked[T](channel, value); }
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret result;
}

# cancellation owns the registration until unregister or completion returns
pub fun send_scoped[T](channel: *Channel[T], scope: *cancel.Scope, value: T) Status {
    if (scope == nil || !enter[T](channel)) { ret INVALID; }
    cancel.expire(scope, time.monotonic());
    var registration: cancel.Registration;
    cancel.init_registration(?registration);
    var wait: CancelWait = CancelWait{condition: ?channel.writable, lock: ?channel.lock, registration: ?registration, done: 0};
    val attached: cancel.Reason = cancel.attach_with_completion(scope, ?registration, cancellation_wake, cancellation_complete, (?wait)::ptr);
    if (attached != cancel.ACTIVE) {
        leave[T](channel);
        ret cancellation_status(attached);
    }

    var has_deadline: bool = false;
    var deadline: time.Time;
    var owner: *cancel.Scope;
    has_deadline = cancel.get_deadline(scope, ?deadline, ?owner);
    var result: Status = INVALID;
    var complete: bool = false;
    for (!complete) {
        cancel.expire(scope, time.monotonic());
        val reason: cancel.Reason = cancel.reason(scope);
        if (reason != cancel.ACTIVE) {
            result = cancellation_status(reason);
            complete = true;
        }
        or {
            mutex.lock(?channel.lock);
            val locked_reason: cancel.Reason = cancel.reason(scope);
            if (locked_reason != cancel.ACTIVE) {
                result = cancellation_status(locked_reason);
            }
            or {
                result = send_locked[T](channel, value);
            }
            if (result != FULL) {
                mutex.unlock(?channel.lock);
                complete = true;
            }
            or (has_deadline) {
                val waited: condition.WaitStatus = condition.wait_until(?channel.writable, ?channel.lock, deadline);
                mutex.unlock(?channel.lock);
                if (waited == condition.TIMED_OUT) {
                    cancel.expire(scope, time.monotonic());
                }
                or (waited == condition.WAIT_FAILED) {
                    result = INVALID;
                    complete = true;
                }
            }
            or {
                condition.wait(?channel.writable, ?channel.lock);
                mutex.unlock(?channel.lock);
            }
        }
    }

    if (!cancel.unregister(?registration)) {
        for (atomic.load(?wait.done) == 0) { os.thread_wait(?wait.done, 0); }
        mutex.lock(wait.lock);
        mutex.unlock(wait.lock);
    }
    leave[T](channel);
    ret result;
}

fun receive_locked[T](channel: *Channel[T], output: *T) Status {
    if (channel.len == 0) {
        if (!channel.open) { ret CLOSED; }
        ret EMPTY;
    }
    @output = channel.storage[channel.head];
    channel.head = (channel.head + 1) % channel.capacity;
    channel.len = channel.len - 1;
    condition.signal(?channel.writable);
    ret RECEIVED;
}

# output is written only when receive succeeds
pub fun try_receive[T](channel: *Channel[T], output: *T) Status {
    if (output == nil || !enter[T](channel)) { ret INVALID; }
    mutex.lock(?channel.lock);
    val status: Status = receive_locked[T](channel, output);
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret status;
}

# close drains accepted values before receivers observe closure
pub fun receive[T](channel: *Channel[T], output: *T) Status {
    if (output == nil || !enter[T](channel)) { ret INVALID; }
    mutex.lock(?channel.lock);
    for (channel.open && channel.len == 0) {
        condition.wait(?channel.readable, ?channel.lock);
    }
    val status: Status = receive_locked[T](channel, output);
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret status;
}

pub fun receive_until[T](channel: *Channel[T], output: *T, deadline: time.Time) Status {
    if (output == nil || !deadline_valid(deadline) || !enter[T](channel)) { ret INVALID; }
    mutex.lock(?channel.lock);
    var result: Status = EMPTY;
    for (channel.open && channel.len == 0 && result == EMPTY) {
        if (!time.time_before(time.monotonic(), deadline)) {
            result = TIMED_OUT;
        }
        or {
            val waited: condition.WaitStatus = condition.wait_until(?channel.readable, ?channel.lock, deadline);
            if (waited == condition.TIMED_OUT) { result = TIMED_OUT; }
            or (waited == condition.WAIT_FAILED) { result = INVALID; }
        }
    }
    if (result == EMPTY) { result = receive_locked[T](channel, output); }
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret result;
}

pub fun receive_scoped[T](channel: *Channel[T], scope: *cancel.Scope, output: *T) Status {
    if (output == nil || scope == nil || !enter[T](channel)) { ret INVALID; }
    cancel.expire(scope, time.monotonic());
    var registration: cancel.Registration;
    cancel.init_registration(?registration);
    var wait: CancelWait = CancelWait{condition: ?channel.readable, lock: ?channel.lock, registration: ?registration, done: 0};
    val attached: cancel.Reason = cancel.attach_with_completion(scope, ?registration, cancellation_wake, cancellation_complete, (?wait)::ptr);
    if (attached != cancel.ACTIVE) {
        leave[T](channel);
        ret cancellation_status(attached);
    }

    var has_deadline: bool = false;
    var deadline: time.Time;
    var owner: *cancel.Scope;
    has_deadline = cancel.get_deadline(scope, ?deadline, ?owner);
    var result: Status = INVALID;
    var complete: bool = false;
    for (!complete) {
        cancel.expire(scope, time.monotonic());
        val reason: cancel.Reason = cancel.reason(scope);
        if (reason != cancel.ACTIVE) {
            result = cancellation_status(reason);
            complete = true;
        }
        or {
            mutex.lock(?channel.lock);
            val locked_reason: cancel.Reason = cancel.reason(scope);
            if (locked_reason != cancel.ACTIVE) {
                result = cancellation_status(locked_reason);
            }
            or {
                result = receive_locked[T](channel, output);
            }
            if (result != EMPTY) {
                mutex.unlock(?channel.lock);
                complete = true;
            }
            or (has_deadline) {
                val waited: condition.WaitStatus = condition.wait_until(?channel.readable, ?channel.lock, deadline);
                mutex.unlock(?channel.lock);
                if (waited == condition.TIMED_OUT) {
                    cancel.expire(scope, time.monotonic());
                }
                or (waited == condition.WAIT_FAILED) {
                    result = INVALID;
                    complete = true;
                }
            }
            or {
                condition.wait(?channel.readable, ?channel.lock);
                mutex.unlock(?channel.lock);
            }
        }
    }

    if (!cancel.unregister(?registration)) {
        for (atomic.load(?wait.done) == 0) { os.thread_wait(?wait.done, 0); }
        mutex.lock(wait.lock);
        mutex.unlock(wait.lock);
    }
    leave[T](channel);
    ret result;
}

# close is idempotent and wakes every blocked sender and receiver
pub fun close[T](channel: *Channel[T]) bool {
    if (!enter[T](channel)) { ret false; }
    mutex.lock(?channel.lock);
    if (!channel.open) {
        mutex.unlock(?channel.lock);
        leave[T](channel);
        ret false;
    }
    channel.open = false;
    condition.broadcast(?channel.readable);
    condition.broadcast(?channel.writable);
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret true;
}

# abort transfers every queued value to output in fifo order
pub fun close_abort[T](channel: *Channel[T], output: *T, output_capacity: usize, output_len: *usize) Status {
    if (output_len == nil || !enter[T](channel)) { ret INVALID; }
    mutex.lock(?channel.lock);
    if (channel.len > output_capacity || (channel.len > 0 && output == nil)) {
        mutex.unlock(?channel.lock);
        leave[T](channel);
        ret INVALID;
    }
    var written: usize = 0;
    for (written < channel.len) {
        output[written] = channel.storage[(channel.head + written) % channel.capacity];
        written = written + 1;
    }
    channel.head = 0;
    channel.len = 0;
    channel.open = false;
    @output_len = written;
    condition.broadcast(?channel.readable);
    condition.broadcast(?channel.writable);
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret ABORTED;
}

pub fun count[T](channel: *Channel[T]) usize {
    if (!enter[T](channel)) { ret 0; }
    mutex.lock(?channel.lock);
    val result: usize = channel.len;
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret result;
}

pub fun is_closed[T](channel: *Channel[T]) bool {
    if (!enter[T](channel)) { ret true; }
    mutex.lock(?channel.lock);
    val result: bool = !channel.open;
    mutex.unlock(?channel.lock);
    leave[T](channel);
    ret result;
}

# destruction succeeds only after close, drain, and all waiter exit
pub fun destroy[T](channel: *Channel[T]) bool {
    if (channel == nil || !channel.initialized) { ret false; }
    mutex.lock(?channel.lock);
    if (channel.open || channel.len != 0 || condition.waiter_count(?channel.readable) != 0 || condition.waiter_count(?channel.writable) != 0) {
        mutex.unlock(?channel.lock);
        ret false;
    }
    var expected: i64 = 0;
    if (!atomic.cas(?channel.gate, ?expected, GATE_CLOSED)) {
        mutex.unlock(?channel.lock);
        ret false;
    }
    channel.storage = nil;
    channel.capacity = 0;
    channel.head = 0;
    channel.initialized = false;
    mutex.unlock(?channel.lock);
    ret true;
}

test "channel: immediate send receive close and abort preserve ownership" {
    var storage: [3]i64;
    var channel: Channel[i64];
    if (!make[i64](?channel, (?storage)::*i64, 3)) { ret 1; }
    if (try_send[i64](?channel, 10) != SENT || try_send[i64](?channel, 20) != SENT || try_send[i64](?channel, 30) != SENT) { ret 2; }
    if (try_send[i64](?channel, 40) != FULL) { ret 3; }
    var value: i64 = 99;
    if (try_receive[i64](?channel, ?value) != RECEIVED || value != 10) { ret 4; }
    var rejected: [3]i64;
    var rejected_len: usize = 0;
    if (close_abort[i64](?channel, (?rejected)::*i64, 3, ?rejected_len) != ABORTED) { ret 5; }
    if (rejected_len != 2 || rejected[0] != 20 || rejected[1] != 30) { ret 6; }
    if (try_send[i64](?channel, 50) != CLOSED || try_receive[i64](?channel, ?value) != CLOSED) { ret 7; }
    if (!destroy[i64](?channel)) { ret 8; }
    ret 0;
}

test "channel: deadline and prior cancellation reject without transfer" {
    var storage: [1]i64;
    var channel: Channel[i64];
    if (!make[i64](?channel, (?storage)::*i64, 1)) { ret 1; }
    if (try_send[i64](?channel, 1) != SENT) { ret 2; }
    val deadline: time.Time = time.time_add(time.monotonic(), 1000000);
    if (send_until[i64](?channel, 2, deadline) != TIMED_OUT || count[i64](?channel) != 1) { ret 3; }

    var scope: cancel.Scope;
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    if (!cancel.make_root(?scope, false, none) || !cancel.cancel(?scope)) { ret 4; }
    if (send_scoped[i64](?channel, ?scope, 3) != CANCELLED || count[i64](?channel) != 1) { ret 5; }
    if (!cancel.destroy(?scope)) { ret 6; }
    var value: i64;
    if (try_receive[i64](?channel, ?value) != RECEIVED || value != 1) { ret 7; }
    close[i64](?channel);
    if (!destroy[i64](?channel)) { ret 8; }
    ret 0;
}

rec ScopedSendContext {
    channel: *Channel[i64];
    scope:   *cancel.Scope;
    entered: *i64;
    status:  *i64;
}

fun scoped_sender(arg: *u8) {
    val context: *ScopedSendContext = arg::*ScopedSendContext;
    atomic.store(context.entered, 1);
    os.thread_wake(context.entered);
    val status: Status = send_scoped[i64](context.channel, context.scope, 2);
    atomic.store(context.status, status::i64);
}

test "channel: cancellation wakes a blocked sender without transferring its value" {
    var storage: [1]i64;
    var channel: Channel[i64];
    if (!make[i64](?channel, (?storage)::*i64, 1) || try_send[i64](?channel, 1) != SENT) { ret 1; }
    var scope: cancel.Scope;
    val none: time.Time = time.Time{sec: 0, nsec: 0};
    if (!cancel.make_root(?scope, false, none)) { ret 2; }
    var entered: i64 = 0;
    var status: i64 = INVALID::i64;
    var context: ScopedSendContext = ScopedSendContext{channel: ?channel, scope: ?scope, entered: ?entered, status: ?status};
    var sender: thread.Thread;
    thread.spawn_with(scoped_sender, (?context)::*u8, ?sender);
    if (sender.tid < 0) { ret 3; }
    for (atomic.load(?entered) == 0) { os.thread_wait(?entered, 0); }
    cancel.cancel(?scope);
    thread.join(?sender);
    if (atomic.load(?status) != CANCELLED::i64 || count[i64](?channel) != 1) { ret 4; }
    if (!cancel.destroy(?scope)) { ret 5; }
    var value: i64;
    if (try_receive[i64](?channel, ?value) != RECEIVED || value != 1) { ret 6; }
    close[i64](?channel);
    if (!destroy[i64](?channel)) { ret 7; }
    ret 0;
}

rec ProducerContext {
    channel: *Channel[i64];
    first:   i64;
    count:   usize;
    failed:  *i64;
}

fun producer(arg: *u8) {
    val context: *ProducerContext = arg::*ProducerContext;
    var i: usize = 0;
    for (i < context.count) {
        if (send[i64](context.channel, context.first + i::i64) != SENT) {
            atomic.store(context.failed, 1);
            ret;
        }
        i = i + 1;
    }
}

rec ConsumerContext {
    channel:  *Channel[i64];
    received: *i64;
    sum:      *i64;
}

fun consumer(arg: *u8) {
    val context: *ConsumerContext = arg::*ConsumerContext;
    var value: i64;
    var status: Status = receive[i64](context.channel, ?value);
    for (status == RECEIVED) {
        atomic.fetch_add(context.received, 1);
        atomic.fetch_add(context.sum, value);
        status = receive[i64](context.channel, ?value);
    }
}

test "channel: concurrent producers and consumers lose no values or wakeups" {
    var storage: [7]i64;
    var channel: Channel[i64];
    if (!make[i64](?channel, (?storage)::*i64, 7)) { ret 1; }
    var received: i64 = 0;
    var sum: i64 = 0;
    var failed: i64 = 0;
    var consumer_context: ConsumerContext = ConsumerContext{channel: ?channel, received: ?received, sum: ?sum};
    var consumers: [3]thread.Thread;
    var producers: [4]thread.Thread;
    var producer_contexts: [4]ProducerContext;
    var i: usize = 0;
    for (i < 3) {
        thread.spawn_with(consumer, (?consumer_context)::*u8, ?consumers[i]);
        if (consumers[i].tid < 0) { ret 2; }
        i = i + 1;
    }
    i = 0;
    for (i < 4) {
        producer_contexts[i] = ProducerContext{channel: ?channel, first: (i * 200)::i64, count: 200, failed: ?failed};
        thread.spawn_with(producer, (?producer_contexts[i])::*u8, ?producers[i]);
        if (producers[i].tid < 0) { ret 3; }
        i = i + 1;
    }
    i = 0;
    for (i < 4) {
        thread.join(?producers[i]);
        i = i + 1;
    }
    close[i64](?channel);
    i = 0;
    for (i < 3) {
        thread.join(?consumers[i]);
        i = i + 1;
    }
    if (atomic.load(?failed) != 0 || atomic.load(?received) != 800 || atomic.load(?sum) != 319600) { ret 4; }
    if (!destroy[i64](?channel)) { ret 5; }
    ret 0;
}
