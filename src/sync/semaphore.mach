# bounded counting semaphore

use std.sync.atomic;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

$if (capability.HAS_THREADS) {
    use std.sync.thread;
    use std.system.os;
}
$or {
    $error("std.sync.semaphore needs the threads capability (std.system.capability.HAS_THREADS)");
}

# a refused semaphore operation
# ---
# invalid:  a nil semaphore, a negative count or bound, or an initial count
#           above the bound
# overflow: a release that would exceed the bound; the count is unchanged
pub tag StateError: u8 { invalid; overflow; }

pub def Operation: err[StateError];

pub rec Semaphore {
    permits:    i64;
    limit:      i64;
    generation: i64;
    waiters:    i64;
}

# semaphores are unfair and a new caller may acquire before a woken waiter
# waits may wake spuriously and always retry permit acquisition
# failed work does not poison permits or change the configured bound
# initialization must complete before the semaphore is published
# semaphores own no target handle and may be discarded only without waiters
pub fun init(s: *Semaphore, initial: i64, limit: i64) Operation {
    if (s == nil) { ret Operation.err{StateError.invalid{}}; }
    s.permits    = 0;
    s.limit      = 0;
    s.generation = 0;
    s.waiters    = 0;
    if (initial < 0 || limit < 0 || initial > limit) { ret Operation.err{StateError.invalid{}}; }
    s.permits = initial;
    s.limit   = limit;
    ret Operation.ok{};
}

pub fun try_wait(s: *Semaphore) bool {
    for (true) {
        val current: i64 = atomic.load(?s.permits);
        if (current <= 0) { ret false; }
        var expected: i64 = current;
        if (atomic.cas(?s.permits, ?expected, current - 1)) { ret true; }
    }
    ret false;
}

pub fun wait(s: *Semaphore) {
    for (true) {
        if (try_wait(s)) { ret; }

        val observed: i64 = atomic.load(?s.generation);
        atomic.fetch_add(?s.waiters, 1);
        if (try_wait(s)) {
            atomic.fetch_sub(?s.waiters, 1);
            ret;
        }

        os.thread_wait(?s.generation, observed);
        atomic.fetch_sub(?s.waiters, 1);
    }
}

# release refuses with overflow at the bound and leaves the count unchanged
pub fun release(s: *Semaphore) Operation {
    if (s == nil) { ret Operation.err{StateError.invalid{}}; }
    for (true) {
        val current: i64 = atomic.load(?s.permits);
        if (current >= s.limit) { ret Operation.err{StateError.overflow{}}; }
        var expected: i64 = current;
        if (atomic.cas(?s.permits, ?expected, current + 1)) {
            atomic.fetch_add(?s.generation, 1);
            if (atomic.load(?s.waiters) > 0) {
                os.thread_wake(?s.generation);
            }
            ret Operation.ok{};
        }
    }
    ret Operation.err{StateError.invalid{}};
}

# this diagnostic result is stale as soon as it is returned
pub fun available(s: *Semaphore) i64 {
    ret atomic.load(?s.permits);
}

# this diagnostic result is stale as soon as it is returned
pub fun waiter_count(s: *Semaphore) i64 {
    ret atomic.load(?s.waiters);
}

rec WaitContext {
    sem:     *Semaphore;
    entered: *i64;
    passed:  *i64;
}

fun permit_worker(arg: *u8) {
    val ctx: *WaitContext = arg::*WaitContext;
    atomic.fetch_add(ctx.entered, 1);
    wait(ctx.sem);
    atomic.fetch_add(ctx.passed, 1);
}

fun done(r: Operation) bool {
    ret sel r.ok;
}

# init refuses a negative count or one above the maximum, and a release past
# the maximum is refused without changing the count
test semaphore__bounds_and_overflow_are_refused {
    var s:        Semaphore;
    val negative: Operation = init(?s, -1, 1);
    if (!sel negative.err) { ret 1; }
    if (!sel negative.err.invalid) { ret 1; }
    val above: Operation = init(?s, 2, 1);
    if (!sel above.err) { ret 2; }
    if (!sel above.err.invalid) { ret 2; }
    if (!done(init(?s, 1, 2)))                     { ret 3; }
    if (!done(release(?s)) || available(?s) != 2) { ret 4; }
    val over: Operation = release(?s);
    if (!sel over.err) { ret 5; }
    if (!sel over.err.overflow) { ret 5; }
    if (available(?s) != 2)                             { ret 6; }
    if (!try_wait(?s) || !try_wait(?s) || try_wait(?s)) { ret 7; }
    ret 0;
}

test semaphore__releases_settle_multiple_waiters {
    var s: Semaphore;
    if (!done(init(?s, 0, 3))) { ret 1; }
    var entered: i64         = 0;
    var passed:  i64         = 0;
    var ctx:     WaitContext = WaitContext{sem: ?s, entered: ?entered, passed: ?passed};
    var threads: [3]thread.Thread;
    var i:       usize       = 0;

    for (i < 3) {
        thread.spawn_with(permit_worker, (?ctx)::*u8, ?threads[i]);
        if (threads[i].tid < 0) {
            var k: usize = 0;
            for (k < i) {
                release(?s);
                k = k + 1;
            }
            k = 0;
            for (k < i) {
                thread.join(?threads[k]);
                k = k + 1;
            }
            ret 1;
        }
        i = i + 1;
    }

    for (waiter_count(?s) != 3) { atomic.spin_hint(); }
    i = 0;
    for (i < 3) {
        if (!done(release(?s))) { ret 1; }
        i = i + 1;
    }

    i = 0;
    for (i < 3) {
        thread.join(?threads[i]);
        i = i + 1;
    }
    if (atomic.load(?entered) != 3 || atomic.load(?passed) != 3) { ret 1; }
    if (available(?s) != 0 || waiter_count(?s) != 0)             { ret 1; }
    ret 0;
}
